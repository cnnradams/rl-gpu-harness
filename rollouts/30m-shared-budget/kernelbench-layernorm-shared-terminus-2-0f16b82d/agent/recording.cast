[412.597446, "o", "\u001b[?2004h> "]
[412.597538, "o", "m = sol.ModelNew((64,256,256)).cuda()\r\n\u001b[?2004l\r"]
[412.597577, "o", "\u001b[?2004h> S = m.S\r\n\u001b[?2004l\r"]
[412.597613, "o", "\u001b[?2004h> "]
