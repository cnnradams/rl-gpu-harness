[681.530022, "o", "    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[681.530066, "o", "\u001b[?2004h> "]
[681.530225, "o", "    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[681.530256, "o", "\u001b[?2004h> "]
[681.530327, "o", "    mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[681.530368, "o", "\u001b[?2004h> "]
[681.53046, "o", "    var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[681.530502, "o", "\u001b[?2004h> "]
[681.53057, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[681.530591, "o", "\u001b[?2004h> "]
[681.530672, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[681.530692, "o", "\u001b[?2004h> "]
[681.530816, "o", "    for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r"]
[681.530854, "o", "\u001b[?2004h> "]
[681.530965, "o", "        offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[681.531004, "o", "\u001b[?2004h> "]
[681.531041, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[681.531073, "o", "\u001b[?2004h> "]
[681.531111, "o", "        if EV:\r\n\u001b[?2004l\r"]
[681.531148, "o", "\u001b[?2004h> "]
[681.531363, "o", "            x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0, eviction_policy=\"evict_first\")\r\n\u001b[?2004l\r"]
[681.531402, "o", "\u001b[?2004h> "]
[681.531593, "o", "            w = tl.load(w_ptr + offs, mask=mask, other=0.0, eviction_policy=\"evict_last\")\r\n\u001b[?2004l\r"]
[681.531632, "o", "\u001b[?2004h> "]
[681.53183, "o", "            b = tl.load(b_ptr + offs, mask=mask, other=0.0, eviction_policy=\"evict_last\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.531878, "o", "> "]
[681.531964, "o", "            y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.532003, "o", "> "]
[681.532171, "o", "            tl.store(y_ptr + row * N + offs, y, mask=mask, cache_modifier=\".cs\")\r\n\u001b[?2004l\r"]
[681.532211, "o", "\u001b[?2004h> "]
[681.532248, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.532417, "o", "            x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.532454, "o", "> "]
[681.532575, "o", "            w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[681.532614, "o", "\u001b[?2004h> "]
[681.532736, "o", "            b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[681.532768, "o", "\u001b[?2004h> "]
[681.532863, "o", "            y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[681.532894, "o", "\u001b[?2004h> "]
[681.533022, "o", "            tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[681.533066, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[681.533104, "o", "\u001b[?2004h> "]
[681.533134, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.533166, "o", "> "]
[681.533204, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[681.533242, "o", "\u001b[?2004h> "]
[681.533274, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.53335, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[681.533385, "o", "\u001b[?2004h> "]
[681.533417, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.533482, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[681.533525, "o", "\u001b[?2004h> "]
[681.53359, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[681.533628, "o", "\u001b[?2004h> "]
[681.533795, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\r\n\u001b[?2004l\r"]
[681.533832, "o", "\u001b[?2004h> "]
[681.53387, "o", "        d.fill_(42)\r\n\u001b[?2004l\r"]
[681.533908, "o", "\u001b[?2004h> "]
[681.533946, "o", "        del d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.534158, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[681.534196, "o", "\u001b[?2004h> "]
[681.534264, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[681.534295, "o", "\u001b[?2004h> "]
[681.534364, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[681.534395, "o", "\u001b[?2004h> "]
[681.534474, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[681.534505, "o", "\u001b[?2004h> "]
[681.534536, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[681.534568, "o", "\u001b[?2004h> "]
[681.534615, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[681.534654, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[681.534684, "o", "> "]
[681.534779, "o", "x = torch.rand(16, 64, 256, 256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[681.534822, "o", "\u001b[?2004h> "]
[681.534862, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[681.534897, "o", "\u001b[?2004h> "]
[681.534983, "o", "w = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[681.535016, "o", "\u001b[?2004h> "]
[681.535104, "o", "b = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[681.535142, "o", "\u001b[?2004h> "]
[681.535181, "o", "TOT = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.535226, "o", "N = 64*256*256\r\n\u001b[?2004l\r"]
[681.535258, "o", "\u001b[?2004h> "]
[681.53529, "o", "B = 16\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[681.535321, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[681.535464, "o", "print(\"torch copy_:\", bench(lambda: y.copy_(x)), flush=True)\r\n\u001b[?2004l\r"]
[681.535502, "o", "\u001b[?2004h> "]
[681.535547, "o", "for ev in [False, True]:\r\n\u001b[?2004l\r"]
[681.535585, "o", "\u001b[?2004h> "]
[681.535801, "o", "    t = bench(lambda: _copy2[(2048,)](x, y, TOT, BLOCK=8192, NCHUNK=4, EV=ev, num_warps=8))\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.53584, "o", "> "]
[681.536018, "o", "    print(\"copy ev=%s: %.4f ms %.1f GB/s\" % (ev, t, 2*TOT*4/t/1e6), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.536057, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.53633, "o", "for (B1, W, EV) in [(32768, 16, False), (32768, 16, True), (16384, 8, True), (65536, 32, True), (8192, 4, True)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.53637, "o", "> "]
[681.536409, "o", "    S = (N + B1 - 1)//B1\r\n\u001b[?2004l\r"]
[681.536447, "o", "\u001b[?2004h> "]
[681.536584, "o", "    part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[681.53662, "o", "\u001b[?2004h> "]
[681.5368, "o", "    t = bench(lambda: _part[(S, B)](x, part, N, S, BLOCK=B1, EV=EV, num_warps=W))\r\n\u001b[?2004l\r"]
[681.536835, "o", "\u001b[?2004h> "]
[681.537043, "o", "    print(\"part B1=%d W=%d ev=%s: %.4f ms %.1f GB/s\" % (B1, W, EV, t, TOT*4/t/1e6), flush=True)\r\n\u001b[?2004l\r"]
[681.537082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.53712, "o", "S = 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.537153, "o", "> "]
[681.53728, "o", "part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[681.537317, "o", "\u001b[?2004h> "]
[681.537449, "o", "_part[(S, B)](x, part, N, S, BLOCK=32768, EV=True, num_warps=16)\r\n\u001b[?2004l\r"]
[681.537482, "o", "\u001b[?2004h> "]
[681.537514, "o", "SP2 = 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.537552, "o", "> "]
[681.537933, "o", "for (B2, NC, W, EV) in [(8192, 8, 8, False), (8192, 8, 8, True), (8192, 4, 8, True), (16384, 4, 16, True), (4096, 8, 4, True), (8192, 2, 8, True), (8192, 16, 8, True)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.537973, "o", "> "]
[681.538011, "o", "    chunk = B2*NC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[681.538102, "o", "    S2 = (N + chunk - 1)//chunk\r\n\u001b[?2004l\r"]
[681.538134, "o", "\u001b[?2004h> "]
[681.538405, "o", "    t = bench(lambda: _apply[(S2, B)](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=SP2, NCHUNK=NC, EV=EV, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[681.538443, "o", "> "]
[681.538726, "o", "    print(\"apply B2=%d NC=%d W=%d ev=%s grid=%d: %.4f ms %.1f GB/s\" % (B2, NC, W, EV, S2*B, t, (2*TOT+2*N)*4/t/1e6), flush=True)\r\n\u001b[?2004l\r"]
[681.53876, "o", "\u001b[?2004h> "]
[681.538808, "o", "PYEOF\r\n\u001b[?2004l\r"]
[681.540847, "o", "\u001b[?2004hroot@modal:/# "]
[681.541298, "o", "B64=$(base64 -w0 /workspace/bench3.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bash -c \"echo $B64 | base64 -d > /workspace/bench3.py\" && gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- python3 /workspace/bench3.py\r\n\u001b[?2004l\r"]
[681.66285, "o", "request ID: 1a818be00c9a4530a9bf28d474bed897\r\n"]
[683.421064, "o", "command: 8f3b81ac5af449fb952814d2b3943d95\r\n"]
[684.505234, "o", "request ID: da40fc8dffdc4bca8c50110ea9f4e00e\r\n"]
[686.674462, "o", "command: 4a13fd63e4a84704992c10bf0bbc7689\r\n"]
[688.29945, "o", "torch copy_: 0.18275199830532074\r\n"]
[688.385989, "o", "copy ev=False: 0.1943 ms 2762.6 GB/s\r\n"]
[689.165608, "o", "copy ev=True: 0.2021 ms 2656.7 GB/s\r\npart B1=32768 W=16 ev=False: 0.1005 ms 2670.7 GB/s\r\npart B1=32768 W=16 ev=True: 0.1021 ms 2628.0 GB/s\r\npart B1=16384 W=8 ev=True: 0.1028 ms 2610.0 GB/s\r\npart B1=65536 W=32 ev=True: 0.1018 ms 2636.3 GB/s\r\npart B1=8192 W=4 ev=True: 0.1024 ms 2620.6 GB/s\r\n"]
[690.650961, "o", "apply B2=8192 NC=8 W=8 ev=False grid=1024: 0.2493 ms 2288.3 GB/s\r\n"]
[690.711942, "o", "apply B2=8192 NC=8 W=8 ev=True grid=1024: 0.2647 ms 2154.7 GB/s\r\n"]
[691.496072, "o", "apply B2=8192 NC=4 W=8 ev=True grid=2048: 0.2965 ms 1923.8 GB/s\r\napply B2=16384 NC=4 W=16 ev=True grid=1024: 0.3115 ms 1831.5 GB/s\r\n"]
[692.282207, "o", "apply B2=4096 NC=8 W=4 ev=True grid=2048: 0.2609 ms 2186.4 GB/s\r\n"]
[692.355268, "o", "apply B2=8192 NC=2 W=8 ev=True grid=4096: 0.3235 ms 1763.5 GB/s\r\n"]
