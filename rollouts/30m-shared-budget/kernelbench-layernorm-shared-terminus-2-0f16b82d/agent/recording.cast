[1012.515836, "i", "cat > /workspace/solution.py <<'PYEOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_partial_kernel(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n    s = tl.sum(x, axis=0)\n    q = tl.sum(x * x, axis=0)\n    base = (row * S + pid) * 2\n    tl.store(part_ptr + base, s)\n    tl.store(part_ptr + base + 1, q)\n\n\n@triton.jit\ndef _ln_apply_kernel(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\n                     BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    pids = tl.arange(0, SP2)\n    pmask = pids < S\n    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\n    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\n    mean = tl.sum(ps, axis=0) / N\n    var = tl.sum(qs, axis=0) / "]
[1012.515905, "i", "N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    start = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + row * N + offs, y, mask=mask)\n\n\nclass ModelNew(nn.Module):\n    \"\"\"LayerNorm implemented with a split-row two-kernel Triton scheme.\"\"\"\n\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        N = 1\n        for d in self.normalized_shape:\n            N *= d\n        self.N = N\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n        self.eps = 1e-5\n        self.B1 = 32768\n        self.S = (N + self.B1 - 1) "]
[1012.51593, "i", "// self.B1\n        self.SP2 = triton.next_power_of_2(self.S)\n        self.B2 = 8192\n        self.NC = 16\n        chunk = self.B2 * self.NC\n        self.S2 = (N + chunk - 1) // chunk\n        self._parts = {}\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        N = self.N\n        B = x.numel() // N\n        S = self.S\n        device = x.device\n        part = self._parts.get(device)\n        if part is None or part.numel() < B * S * 2:\n            part = torch.empty(B * S * 2, device=device, dtype=torch.float32)\n            self._parts[device] = part\n        y = torch.empty_like(x)\n        _ln_partial_kernel[(S, B)](x, part, N, S, BLOCK=self.B1, num_warps=16)\n        _ln_apply_kernel[(self.S2, B)](x, part, self.weight, self.bias, y, N, S,\n                                       self.eps, BLOCK=self.B2, SP2=self.SP2,\n                                       NCHUNK=self.NC, num_warps=8)\n        return y\nPYEOF\nB64=$(base64 -w0 /workspace/solution.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bash -c \"echo $B64 "]
[1012.515938, "i", "| base64 -d > /workspace/solution.py\"\n"]
[1012.516084, "o", "cat > /workspace/solution.py <<'PYEOF'\r\n\u001b[?2004l\r"]
[1012.516201, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.516269, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[1012.516294, "o", "\u001b[?2004h> "]
[1012.516326, "o", "import triton\r\n\u001b[?2004l\r"]
[1012.516346, "o", "\u001b[?2004h> "]
[1012.516423, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.516446, "o", "> \r\n\u001b[?2004l\r"]
[1012.516464, "o", "\u001b[?2004h> "]
[1012.516485, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.516505, "o", "> "]
[1012.516538, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.516559, "o", "> "]
[1012.516718, "o", "def _ln_partial_kernel(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1012.516748, "o", "\u001b[?2004h> "]
[1012.516812, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1012.516834, "o", "\u001b[?2004h> "]
[1012.516899, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1012.516919, "o", "\u001b[?2004h> "]
[1012.517045, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1012.517073, "o", "\u001b[?2004h> "]
[1012.517118, "o", "    mask = offs < N\r\n\u001b[?2004l\r"]
[1012.517139, "o", "\u001b[?2004h> "]
[1012.51729, "o", "    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1012.517313, "o", "\u001b[?2004h> "]
[1012.51738, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[1012.517406, "o", "\u001b[?2004h> "]
[1012.51748, "o", "    q = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[1012.517511, "o", "\u001b[?2004h> "]
[1012.517581, "o", "    base = (row * S + pid) * 2\r\n\u001b[?2004l\r"]
[1012.517611, "o", "\u001b[?2004h> "]
[1012.517685, "o", "    tl.store(part_ptr + base, s)\r\n\u001b[?2004l\r"]
[1012.517713, "o", "\u001b[?2004h> "]
[1012.5178, "o", "    tl.store(part_ptr + base + 1, q)\r\n\u001b[?2004l\r"]
[1012.517831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1012.517856, "o", "\u001b[?2004h> "]
[1012.517883, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.517923, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1012.517941, "o", "\u001b[?2004h> "]
[1012.518126, "o", "def _ln_apply_kernel(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\r\n\u001b[?2004l\r"]
[1012.518148, "o", "\u001b[?2004h> "]
[1012.518346, "o", "                     BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1012.518376, "o", "\u001b[?2004h> "]
[1012.518433, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1012.518454, "o", "\u001b[?2004h> "]
[1012.518526, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1012.518557, "o", "\u001b[?2004h> "]
[1012.518627, "o", "    pids = tl.arange(0, SP2)\r\n\u001b[?2004l\r"]
[1012.518658, "o", "\u001b[?2004h> "]
[1012.51871, "o", "    pmask = pids < S\r\n\u001b[?2004l\r"]
[1012.518738, "o", "\u001b[?2004h> "]
[1012.518907, "o", "    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1012.518928, "o", "\u001b[?2004h> "]
[1012.519118, "o", "    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1012.519139, "o", "\u001b[?2004h> "]
[1012.519228, "o", "    mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[1012.519255, "o", "\u001b[?2004h> "]
[1012.519364, "o", "    var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1012.519391, "o", "\u001b[?2004h> "]
[1012.519479, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1012.519506, "o", "\u001b[?2004h> "]
[1012.519585, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[1012.519612, "o", "\u001b[?2004h> "]
[1012.519701, "o", "    for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r"]
[1012.51972, "o", "\u001b[?2004h> "]
[1012.519855, "o", "        offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1012.519887, "o", "\u001b[?2004h"]
[1012.520003, "o", ">         mask = offs < N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.520166, "o", "        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.520201, "o", "> "]
[1012.520319, "o", "        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.520364, "o", "> "]
[1012.520476, "o", "        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1012.520517, "o", "\u001b[?2004h> "]
[1012.520592, "o", "        y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[1012.520627, "o", "\u001b[?2004h> "]
[1012.520755, "o", "        tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[1012.520797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.520841, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.520901, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1012.520944, "o", "\u001b[?2004h> "]
[1012.521111, "o", "    \"\"\"LayerNorm implemented with a split-row two-kernel Triton scheme.\"\"\"\r\n\u001b[?2004l\r"]
[1012.521155, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.521279, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[1012.521315, "o", "\u001b[?2004h> "]
[1012.521379, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1012.521422, "o", "\u001b[?2004h> "]
[1012.521537, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[1012.521579, "o", "\u001b[?2004h> "]
[1012.521623, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.521722, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[1012.521765, "o", "\u001b[?2004h> "]
[1012.521806, "o", "            N *= d\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.52185, "o", "> "]
[1012.521885, "o", "        self.N = N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.521927, "o", "> "]
[1012.522074, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[1012.522117, "o", "\u001b[?2004h> "]
[1012.522262, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[1012.522298, "o", "\u001b[?2004h> "]
[1012.522349, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[1012.522391, "o", "\u001b[?2004h> "]
[1012.522431, "o", "        self.B1 = 32768\r\n\u001b[?2004l\r"]
[1012.522472, "o", "\u001b[?2004h> "]
[1012.522572, "o", "        self.S = (N + self.B1 - 1) // self.B1\r\n\u001b[?2004l\r"]
[1012.522608, "o", "\u001b[?2004h> "]
[1012.522737, "o", "        self.SP2 = triton.next_power_of_2(self.S)\r\n\u001b[?2004l\r"]
[1012.522773, "o", "\u001b[?2004h> "]
[1012.522818, "o", "        self.B2 = 8192\r\n\u001b[?2004l\r"]
[1012.522858, "o", "\u001b[?2004h> "]
[1012.522897, "o", "        self.NC = 16\r\n\u001b[?2004l\r"]
[1012.522936, "o", "\u001b[?2004h> "]
[1012.523011, "o", "        chunk = self.B2 * self.NC\r\n\u001b[?2004l\r"]
[1012.523045, "o", "\u001b[?2004h> "]
[1012.523138, "o", "        self.S2 = (N + chunk - 1) // chunk\r\n\u001b[?2004l\r"]
[1012.523183, "o", "\u001b[?2004h> "]
[1012.523221, "o", "        self._parts = {}\r\n\u001b[?2004l\r"]
[1012.523263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1012.523303, "o", "\u001b[?2004h> "]
[1012.523419, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.523457, "o", "> "]
[1012.523497, "o", "        N = self.N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.523536, "o", "> "]
[1012.52358, "o", "        B = x.numel() // N\r\n\u001b[?2004l\r"]
[1012.523618, "o", "\u001b[?2004h> "]
[1012.523657, "o", "        S = self.S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1012.523726, "o", "        device = x.device\r\n\u001b[?2004l\r"]
[1012.523767, "o", "\u001b[?2004h> "]
[1012.523844, "o", "        part = self._parts.get(device)\r\n\u001b[?2004l\r"]
[1012.523889, "o", "\u001b[?2004h> "]
[1012.524012, "o", "        if part is None or part.numel() < B * S * 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.524051, "o", "> "]
[1012.524214, "o", "            part = torch.empty(B * S * 2, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1012.524252, "o", "\u001b[?2004h> "]
[1012.524324, "o", "            self._parts[device] = part\r\n\u001b[?2004l\r"]
[1012.524363, "o", "\u001b[?2004h> "]
[1012.524423, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1012.524462, "o", "\u001b[?2004h> "]
[1012.524627, "o", "        _ln_partial_kernel[(S, B)](x, part, N, S, BLOCK=self.B1, num_warps=16)\r\n\u001b[?2004l\r"]
[1012.524667, "o", "\u001b[?2004h> "]
[1012.524836, "o", "        _ln_apply_kernel[(self.S2, B)](x, part, self.weight, self.bias, y, N, S,\r\n\u001b[?2004l\r"]
[1012.524875, "o", "\u001b[?2004h> "]
[1012.525046, "o", "                                       self.eps, BLOCK=self.B2, SP2=self.SP2,\r\n\u001b[?2004l\r"]
[1012.525084, "o", "\u001b[?2004h> "]
[1012.525223, "o", "                                       NCHUNK=self.NC, num_warps=8)\r\n\u001b[?2004l\r"]
[1012.525262, "o", "\u001b[?2004h> "]
[1012.525301, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[1012.52534, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[1012.527181, "o", "\u001b[?2004hroot@modal:/# "]
