[412.596733, "o", "    print(\"copy BLK=%d NC=%d W=%d grid=%d: %.4f ms -> %.1f GB/s\" % (BLK, NC, W, grid[0], t, 2*TOT*4/t/1e6), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.596763, "o", "> \r\n"]
[412.596782, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[412.596988, "o", "os.environ.update(LN_B1=\"32768\", LN_B2=\"8192\", LN_NC=\"8\", LN_W1=\"16\", LN_W2=\"8\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.597019, "o", "> "]
[412.597191, "o", "spec = importlib.util.spec_from_file_location(\"sol\", \"/workspace/solution.py\")\r\n\u001b[?2004l\r"]
[412.597225, "o", "\u001b[?2004h> "]
