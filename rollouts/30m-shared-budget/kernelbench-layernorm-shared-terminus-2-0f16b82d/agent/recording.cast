[1445.706797, "o", "total 44\r\ndrwxr-xr-x 1 root root    0 Nov  3 06:14 \u001b[0m\u001b[01;34m__pycache__\u001b[0m\r\n-rw-r--r-- 1 root root 1919 Nov  3 06:14 bench.py\r\n-rw-r--r-- 1 root root 2295 Nov  3 06:18 bench2.py\r\n-rw-r--r-- 1 root root 4546 Nov  3 06:20 bench3.py\r\n-rw-r--r-- 1 root root 2906 Nov  3 06:22 bench4.py\r\n-rw-r--r-- 1 root root 3595 Nov  3 06:25 bench5.py\r\n-rw-r--r-- 1 root root 3052 Nov  3 06:28 bench6.py\r\n-rw-r--r-- 1 root root 2948 Nov  3 06:30 bench7.py\r\n-rw-r--r-- 1 root root  766 Nov  3 06:29 result.json\r\n-rw-r--r-- 1 root root  768 Nov  3 06:32 result_final.json\r\n-rw-r--r-- 1 root root 3062 Nov  3 06:29 solution.py\r\n"]
[1445.720587, "o", "import torch\r\nimport torch.nn as nn\r\nimport triton\r\nimport triton.language as tl\r\n\r\n\r\n@triton.jit\r\ndef _ln_partial_kernel(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n    row = tl.program_id(1)\r\n    pid = tl.program_id(0)\r\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n    offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\r\n    mask = offs < N\r\n    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n    s = tl.sum(x, axis=0)\r\n    q = tl.sum(x * x, axis=0)\r\n    base = (row * S + pid) * 2\r\n    tl.store(part_ptr + base, s)\r\n    tl.store(part_ptr + base + 1, q)\r\n\r\n"]
[1445.720878, "o", "\u001b[?2004hroot@modal:/# "]
