[1178.986117, "o", "> "]
[1178.986166, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[1178.98618, "o", "\u001b[?2004h"]
[1178.986205, "o", "> "]
[1178.986226, "o", "import triton\r\n\u001b[?2004l\r"]
[1178.986245, "o", "\u001b[?2004h"]
