[876.092303, "i", "cat > /workspace/bench5.py <<'PYEOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n    s = tl.sum(x, axis=0)\n    q = tl.sum(x * x, axis=0)\n    base = (row * S + pid) * 2\n    tl.store(part_ptr + base, s)\n    tl.store(part_ptr + base + 1, q)\n\n@triton.jit\ndef _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\n           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    pids = tl.arange(0, SP2)\n    pmask = pids < S\n    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\n    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\n    mean = tl.sum(ps, axis=0) / N\n    var = tl.sum(qs, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    sta"]
[876.092347, "i", "rt = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + row * N + offs, y, mask=mask)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nx = torch.rand(16, 64, 256, 256, device=\"cuda\")\ny = torch.empty_like(x)\nw = torch.rand(64*256*256, device="]
[876.092361, "i", "\"cuda\")\nb = torch.rand(64*256*256, device=\"cuda\")\nTOT = x.numel()\nN = 64*256*256\nB = 16\n\nfor (B1, W1) in [(131072, 32), (131072, 64), (65536, 16)]:\n    S = (N + B1 - 1)//B1\n    part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n    t = bench(lambda: _part[(S, B)](x, part, N, S, BLOCK=B1, num_warps=W1))\n    print(\"part B1=%d W=%d: %.4f ms %.1f GB/s\" % (B1, W1, t, TOT*4/t/1e6), flush=True)\n\nS = 128\npart = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n_part[(S, B)](x, part, N, S, BLOCK=32768, num_warps=16)\nfor (B2, NC, W) in [(8192, 16, 8), (8192, 12, 8), (8192, 20, 8), (8192, 16, 4), (2048, 64, 4), (16384, 8, 8), (8192, 24, 8)]:\n    chunk = B2*NC\n    S2 = (N + chunk - 1)//chunk\n    t = bench(lambda: _apply[(S2, B)](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=S, NCHUNK=NC, num_warps=W))\n    print(\"apply B2=%d NC=%d W=%d grid=%d: %.4f ms\" % (B2, NC, W, S2*B, t), flush=True)\n\n# lean full path\npartbuf = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\nybuf = torch.empty_like(x)\nwf = w.view"]
[876.092374, "i", "(-1); bf = b.view(-1)\ndef lean():\n    _part[(S, B)](x, partbuf, N, S, BLOCK=32768, num_warps=16)\n    _apply[(32, B)](x, partbuf, wf, bf, ybuf, N, S, 1e-5, BLOCK=8192, SP2=S, NCHUNK=16, num_warps=8)\n    return ybuf\nt = bench(lean)\nprint(\"lean full (reused y): %.4f ms\" % t, flush=True)\ndef lean2():\n    yy = torch.empty_like(x)\n    _part[(S, B)](x, partbuf, N, S, BLOCK=32768, num_warps=16)\n    _apply[(32, B)](x, partbuf, wf, bf, yy, N, S, 1e-5, BLOCK=8192, SP2=S, NCHUNK=16, num_warps=8)\n    return yy\nt = bench(lean2)\nprint(\"lean full (fresh y): %.4f ms\" % t, flush=True)\nPYEOF\nB64=$(base64 -w0 /workspace/bench5.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bash -c \"echo $B64 | base64 -d > /workspace/bench5.py\" && gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- python3 /workspace/bench5.py\n"]
[876.092541, "o", "cat > /workspace/bench5.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.09259, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.092627, "o", "> "]
[876.092659, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.092691, "o", "> "]
[876.092753, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.092786, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[876.092825, "o", "> "]
[876.092865, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.093001, "o", "def _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.093039, "o", "> "]
[876.093086, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[876.093125, "o", "\u001b[?2004h> "]
[876.093174, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[876.093209, "o", "\u001b[?2004h> "]
[876.093318, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.093356, "o", "> "]
[876.093394, "o", "    mask = offs < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.093433, "o", "> "]
[876.09356, "o", "    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[876.093595, "o", "\u001b[?2004h> "]
[876.093648, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[876.093687, "o", "\u001b[?2004h> "]
[876.093746, "o", "    q = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[876.093784, "o", "\u001b[?2004h> "]
[876.093846, "o", "    base = (row * S + pid) * 2\r\n\u001b[?2004l\r"]
[876.093885, "o", "\u001b[?2004h> "]
[876.093951, "o", "    tl.store(part_ptr + base, s)\r\n\u001b[?2004l\r"]
[876.09399, "o", "\u001b[?2004h> "]
[876.094065, "o", "    tl.store(part_ptr + base + 1, q)\r\n\u001b[?2004l\r"]
[876.094103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[876.094137, "o", "\u001b[?2004h> "]
[876.094177, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.09433, "o", "def _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\r\n\u001b[?2004l\r"]
[876.094369, "o", "\u001b[?2004h> "]
[876.094536, "o", "           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr):\r\n\u001b[?2004l\r"]
[876.094572, "o", "\u001b[?2004h> "]
[876.094624, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[876.094662, "o", "\u001b[?2004h> "]
[876.094717, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[876.094749, "o", "\u001b[?2004h> "]
[876.094812, "o", "    pids = tl.arange(0, SP2)\r\n\u001b[?2004l\r"]
[876.09485, "o", "\u001b[?2004h> "]
[876.094892, "o", "    pmask = pids < S\r\n\u001b[?2004l\r"]
[876.094932, "o", "\u001b[?2004h> "]
[876.09509, "o", "    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[876.09513, "o", "\u001b[?2004h> "]
[876.0953, "o", "    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[876.09534, "o", "\u001b[?2004h> "]
[876.095408, "o", "    mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[876.095446, "o", "\u001b[?2004h> "]
[876.095554, "o", "    var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[876.095589, "o", "\u001b[?2004h> "]
[876.095665, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[876.0957, "o", "\u001b[?2004h> "]
[876.095771, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[876.095807, "o", "\u001b[?2004h> "]
[876.095922, "o", "    for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.095982, "o", "> "]
[876.096074, "o", "        offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[876.096113, "o", "\u001b[?2004h> "]
[876.096152, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[876.096191, "o", "\u001b[?2004h> "]
[876.096339, "o", "        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[876.096378, "o", "\u001b[?2004h> "]
[876.096505, "o", "        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[876.096545, "o", "\u001b[?2004h> "]
[876.096661, "o", "        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[876.096696, "o", "\u001b[?2004h> "]
[876.096778, "o", "        y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[876.096815, "o", "\u001b[?2004h> "]
[876.096933, "o", "        tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[876.096972, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[876.097006, "o", "> "]
[876.097044, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[876.097082, "o", "\u001b[?2004h> "]
[876.097121, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[876.097152, "o", "\u001b[?2004h> "]
[876.097192, "o", "        fn()\r\n\u001b[?2004l\r"]
[876.097227, "o", "\u001b[?2004h> "]
[876.097281, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[876.097315, "o", "\u001b[?2004h> "]
[876.097353, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.09739, "o", "> "]
[876.097425, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[876.097471, "o", "\u001b[?2004h> "]
[876.097533, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[876.097579, "o", "\u001b[?2004h> "]
[876.097736, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\r\n\u001b[?2004l\r"]
[876.09777, "o", "\u001b[?2004h> "]
[876.097809, "o", "        d.fill_(42)\r\n\u001b[?2004l\r"]
[876.097844, "o", "\u001b[?2004h> "]
[876.097879, "o", "        del d\r\n\u001b[?2004l\r"]
[876.097917, "o", "\u001b[?2004h> "]
[876.098115, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[876.098155, "o", "\u001b[?2004h> "]
[876.098225, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[876.09826, "o", "\u001b[?2004h> "]
[876.098334, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[876.098373, "o", "\u001b[?2004h> "]
[876.098449, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[876.098491, "o", "\u001b[?2004h> "]
[876.098527, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.098562, "o", "> "]
[876.098601, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[876.09864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[876.098679, "o", "\u001b[?2004h> "]
[876.098804, "o", "x = torch.rand(16, 64, 256, 256, device=\"cuda\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.098872, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.09891, "o", "> "]
[876.099005, "o", "w = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.09904, "o", "> "]
[876.099123, "o", "b = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[876.099156, "o", "\u001b[?2004h> "]
[876.09919, "o", "TOT = x.numel()\r\n\u001b[?2004l\r"]
[876.099227, "o", "\u001b[?2004h> "]
[876.099263, "o", "N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.099302, "o", "> B = 16\r\n\u001b[?2004l\r"]
[876.099336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[876.099375, "o", "> "]
[876.099508, "o", "for (B1, W1) in [(131072, 32), (131072, 64), (65536, 16)]:\r\n\u001b[?2004l\r"]
[876.099548, "o", "\u001b[?2004h> "]
[876.099587, "o", "    S = (N + B1 - 1)//B1\r\n\u001b[?2004l\r"]
[876.099625, "o", "\u001b[?2004h> "]
[876.099774, "o", "    part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[876.099808, "o", "\u001b[?2004h> "]
[876.100021, "o", "    t = bench(lambda: _part[(S, B)](x, part, N, S, BLOCK=B1, num_warps=W1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.100247, "o", "    print(\"part B1=%d W=%d: %.4f ms %.1f GB/s\" % (B1, W1, t, TOT*4/t/1e6), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[876.100293, "o", "\u001b[?2004h> "]
[876.100332, "o", "S = 128\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.100485, "o", "part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[876.100528, "o", "\u001b[?2004h> "]
[876.100662, "o", "_part[(S, B)](x, part, N, S, BLOCK=32768, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.100976, "o", "for (B2, NC, W) in [(8192, 16, 8), (8192, 12, 8), (8192, 20, 8), (8192, 16, 4), (2048, 64, 4), (16384, 8, 8), (8192, 24, 8)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.101017, "o", "> "]
[876.101056, "o", "    chunk = B2*NC\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.101146, "o", "    S2 = (N + chunk - 1)//chunk\r\n\u001b[?2004l\r"]
[876.101178, "o", "\u001b[?2004h> "]
[876.101439, "o", "    t = bench(lambda: _apply[(S2, B)](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=S, NCHUNK=NC, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.101486, "o", "> "]
[876.101695, "o", "    print(\"apply B2=%d NC=%d W=%d grid=%d: %.4f ms\" % (B2, NC, W, S2*B, t), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.101738, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.101776, "o", "# lean full path\r\n\u001b[?2004l\r"]
[876.101815, "o", "\u001b[?2004h> "]
[876.101974, "o", "partbuf = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.102052, "o", "ybuf = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[876.102092, "o", "\u001b[?2004h> "]
[876.10216, "o", "wf = w.view(-1); bf = b.view(-1)\r\n\u001b[?2004l\r"]
[876.102196, "o", "\u001b[?2004h> "]
[876.102235, "o", "def lean():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[876.102398, "o", "    _part[(S, B)](x, partbuf, N, S, BLOCK=32768, num_warps=16)\r\n\u001b[?2004l\r"]
[876.102438, "o", "\u001b[?2004h> "]
[876.102673, "o", "    _apply[(32, B)](x, partbuf, wf, bf, ybuf, N, S, 1e-5, BLOCK=8192, SP2=S, NCHUNK=16, num_warps=8)\r\n\u001b[?2004l\r"]
[876.10269, "o", "\u001b[?2004h> "]
[876.102731, "o", "    return ybuf\r\n\u001b[?2004l\r"]
[876.10277, "o", "\u001b[?2004h> "]
[876.102809, "o", "t = bench(lean)\r\n\u001b[?2004l\r"]
[876.102849, "o", "\u001b[?2004h> "]
[876.102969, "o", "print(\"lean full (reused y): %.4f ms\" % t, flush=True)\r\n\u001b[?2004l\r"]
[876.103004, "o", "\u001b[?2004h> "]
[876.103043, "o", "def lean2():\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.103088, "o", "> "]
[876.103133, "o", "    yy = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[876.103173, "o", "\u001b[?2004h> "]
[876.103325, "o", "    _part[(S, B)](x, partbuf, N, S, BLOCK=32768, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.103371, "o", "> "]
[876.103596, "o", "    _apply[(32, B)](x, partbuf, wf, bf, yy, N, S, 1e-5, BLOCK=8192, SP2=S, NCHUNK=16, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.103632, "o", "> "]
[876.103668, "o", "    return yy\r\n\u001b[?2004l\r\u001b[?2004h"]
[876.103701, "o", "> "]
[876.103733, "o", "t = bench(lean2)\r\n\u001b[?2004l\r"]
[876.103765, "o", "\u001b[?2004h> "]
[876.103898, "o", "print(\"lean full (fresh y): %.4f ms\" % t, flush=True)\r\n\u001b[?2004l\r"]
[876.103937, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[876.105564, "o", "\u001b[?2004hroot@modal:/# "]
