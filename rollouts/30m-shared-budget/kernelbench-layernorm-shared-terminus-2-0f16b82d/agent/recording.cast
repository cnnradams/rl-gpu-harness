[1178.986665, "o", "def _ln_partial_kernel(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1178.986688, "o", "> "]
[1178.986745, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1178.986765, "o", "\u001b[?2004h> "]
[1178.986837, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1178.986857, "o", "\u001b[?2004h> "]
[1178.986969, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1178.986997, "o", "\u001b[?2004h> "]
[1178.987158, "o", "    offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\r\n\u001b[?2004l\r"]
[1178.987179, "o", "\u001b[?2004h> "]
[1178.987234, "o", "    mask = offs < N\r\n\u001b[?2004l\r"]
[1178.987254, "o", "\u001b[?2004h> "]
[1178.987409, "o", "    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1178.987431, "o", "\u001b[?2004h> "]
[1178.987502, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[1178.987533, "o", "\u001b[?2004h> "]
[1178.987601, "o", "    q = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[1178.987629, "o", "\u001b[?2004h> "]
[1178.987711, "o", "    base = (row * S + pid) * 2\r\n\u001b[?2004l\r"]
[1178.987741, "o", "\u001b[?2004h> "]
[1178.987821, "o", "    tl.store(part_ptr + base, s)\r\n\u001b[?2004l\r"]
[1178.987845, "o", "\u001b[?2004h> "]
[1178.987956, "o", "    tl.store(part_ptr + base + 1, q)\r\n\u001b[?2004l\r"]
[1178.987977, "o", "\u001b[?2004h> \r\n"]
[1178.987998, "o", "\u001b[?2004l\r"]
[1178.988018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1178.988042, "o", "\u001b[?2004h> "]
[1178.988082, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1178.988103, "o", "\u001b[?2004h> "]
[1178.98827, "o", "def _ln_apply_kernel(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\r\n\u001b[?2004l\r"]
[1178.988291, "o", "\u001b[?2004h> "]
[1178.988505, "o", "                     BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1178.988529, "o", "> "]
[1178.988589, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1178.988616, "o", "\u001b[?2004h"]
[1178.988634, "o", "> "]
[1178.988689, "o", "    pid = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1178.98872, "o", "\u001b[?2004h> "]
[1178.988784, "o", "    pids = tl.arange(0, SP2)\r\n\u001b[?2004l\r"]
[1178.988815, "o", "\u001b[?2004h> "]
[1178.988862, "o", "    pmask = pids < S\r\n\u001b[?2004l\r"]
[1178.988889, "o", "\u001b[?2004h> "]
[1178.989064, "o", "    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1178.989086, "o", "\u001b[?2004h> "]
[1178.989269, "o", "    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1178.989283, "o", "\u001b[?2004h"]
[1178.989305, "o", "> "]
[1178.989376, "o", "    mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[1178.989396, "o", "\u001b[?2004h"]
[1178.989418, "o", "> "]
[1178.98952, "o", "    var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1178.989541, "o", "\u001b[?2004h> "]
[1178.98964, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1178.989661, "o", "\u001b[?2004h> "]
[1178.989745, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[1178.989776, "o", "\u001b[?2004h> "]
[1178.98986, "o", "    for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r"]
[1178.98989, "o", "\u001b[?2004h> "]
[1178.990015, "o", "        offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1178.990046, "o", "\u001b[?2004h> "]
[1178.990202, "o", "        offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\r\n\u001b[?2004l\r"]
[1178.990222, "o", "\u001b[?2004h> "]
[1178.990285, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[1178.990315, "o", "\u001b[?2004h> "]
[1178.990466, "o", "        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1178.990487, "o", "\u001b[?2004h> "]
[1178.99063, "o", "        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1178.990649, "o", "\u001b[?2004h> "]
[1178.990786, "o", "        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1178.990817, "o", "\u001b[?2004h> "]
[1178.990903, "o", "        y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[1178.990923, "o", "\u001b[?2004h> "]
[1178.991057, "o", "        tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[1178.991089, "o", "\u001b[?2004h> \r\n"]
[1178.991118, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1178.991138, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1178.991214, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1178.991244, "o", "\u001b[?2004h> "]
[1178.991411, "o", "    \"\"\"LayerNorm implemented with a split-row two-kernel Triton scheme.\"\"\"\r\n\u001b[?2004l\r"]
[1178.991431, "o", "\u001b[?2004h> \r\n"]
[1178.991453, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1178.991482, "o", "> "]
[1178.991585, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[1178.991603, "o", "\u001b[?2004h> "]
[1178.991682, "o", "        super().__init__()"]
[1178.991736, "o", "\r\n\u001b[?2004l\r"]
[1178.991764, "o", "\u001b[?2004h> "]
[1178.991921, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1178.991942, "o", "> "]
[1178.991979, "o", "        N = 1\r\n\u001b[?2004l\r"]
[1178.992003, "o", "\u001b[?2004h> "]
[1178.992101, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[1178.992123, "o", "\u001b[?2004h> "]
[1178.992174, "o", "            N *= d\r\n\u001b[?2004l\r"]
[1178.992198, "o", "\u001b[?2004h> "]
[1178.992248, "o", "        self.N = N\r\n\u001b[?2004l\r"]
[1178.992271, "o", "\u001b[?2004h> "]
[1178.992437, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[1178.992461, "o", "\u001b[?2004h> "]
[1178.992628, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[1178.992651, "o", "\u001b[?2004h> "]
[1178.992717, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[1178.992739, "o", "\u001b[?2004h> "]
[1178.992802, "o", "        self.B1 = 32768\r\n\u001b[?2004l\r"]
[1178.992823, "o", "\u001b[?2004h> "]
[1178.992936, "o", "        self.S = (N + self.B1 - 1) // self.B1\r\n\u001b[?2004l\r"]
[1178.99296, "o", "\u001b[?2004h> "]
[1178.993079, "o", "        self.SP2 = triton.next_power_of_2(self.S)\r\n\u001b[?2004l\r"]
[1178.993102, "o", "\u001b[?2004h> "]
[1178.993162, "o", "        self.B2 = 8192\r\n\u001b[?2004l\r"]
[1178.993186, "o", "\u001b[?2004h> "]
[1178.993242, "o", "        self.NC = 16\r\n\u001b[?2004l\r"]
[1178.993266, "o", "\u001b[?2004h> "]
[1178.99335, "o", "        chunk = self.B2 * self.NC\r\n\u001b[?2004l\r"]
[1178.993373, "o", "\u001b[?2004h> "]
[1178.993478, "o", "        self.S2 = (N + chunk - 1) // chunk\r\n\u001b[?2004l\r"]
[1178.993509, "o", "\u001b[?2004h> "]
[1178.993565, "o", "        self._parts = {}\r\n\u001b[?2004l\r"]
[1178.993581, "o", "\u001b[?2004h"]
[1178.993612, "o", "> \r\n\u001b[?2004l\r"]
[1178.993644, "o", "\u001b[?2004h> "]
[1178.993779, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1178.993805, "o", "> "]
[1178.993846, "o", "        N = self.N\r\n\u001b[?2004l\r"]
[1178.993868, "o", "\u001b[?2004h> "]
[1178.993938, "o", "        B = x.numel() // N\r\n\u001b[?2004l\r"]
[1178.993963, "o", "\u001b[?2004h> "]
[1178.994012, "o", "        S = self.S\r\n\u001b[?2004l\r"]
[1178.994037, "o", "\u001b[?2004h> "]
[1178.994102, "o", "        device = x.device\r\n\u001b[?2004l\r"]
[1178.994126, "o", "\u001b[?2004h> "]
[1178.994219, "o", "        part = self._parts.get(device)\r\n\u001b[?2004l\r"]
[1178.994243, "o", "\u001b[?2004h> "]
[1178.99437, "o", "        if part is None or part.numel() < B * S * 2:\r\n\u001b[?2004l\r"]
[1178.994392, "o", "\u001b[?2004h> "]
[1178.994586, "o", "            part = torch.empty(B * S * 2, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1178.994628, "o", "\u001b[?2004h> "]
[1178.99471, "o", "            self._parts[device] = part\r\n\u001b[?2004l\r"]
[1178.99474, "o", "\u001b[?2004h> "]
[1178.994813, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1178.994832, "o", "\u001b[?2004h> "]
[1178.995021, "o", "        _ln_partial_kernel[(S, B)](x, part, N, S, BLOCK=self.B1, num_warps=16)\r\n\u001b[?2004l\r"]
[1178.995046, "o", "\u001b[?2004h> "]
[1178.995233, "o", "        _ln_apply_kernel[(B, self.S2)](x, part, self.weight, self.bias, y, N, S,\r\n\u001b[?2004l\r"]
[1178.995257, "o", "\u001b[?2004h> "]
[1178.995439, "o", "                                       self.eps, BLOCK=self.B2, SP2=self.SP2,\r\n\u001b[?2004l\r"]
[1178.995459, "o", "\u001b[?2004h> "]
[1178.99563, "o", "                                       NCHUNK=self.NC, num_warps=4)\r\n\u001b[?2004l\r"]
[1178.995649, "o", "\u001b[?2004h> "]
[1178.995699, "o", "        return y\r\n\u001b[?2004l\r"]
[1178.995719, "o", "\u001b[?2004h> "]
[1178.995746, "o", "PYEOF\r\n\u001b[?2004l\r"]
[1178.997488, "o", "\u001b[?2004hroot@modal:/# "]
