[322.511585, "o", "\u001b[?2004hroot@modal:/# "]
[412.591789, "i", "cat > /workspace/bench2.py <<'PYEOF'\nimport os, importlib.util\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _copy_kernel(x_ptr, y_ptr, N, BLOCK: tl.constexpr, NCHUNK: tl.constexpr):\n    pid = tl.program_id(0)\n    start = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        x = tl.load(x_ptr + offs, mask=mask, other=0.0)\n        tl.store(y_ptr + offs, x, mask=mask)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nx = torch.rand(16, 64, 256, 256,"]
[412.591844, "i", " device=\"cuda\")\ny = torch.empty_like(x)\nTOT = x.numel()\nN = 64*256*256\nB = 16\n\nfor (BLK, NC, W) in [(8192, 8, 8), (8192, 4, 8), (16384, 4, 16), (4096, 8, 4), (8192, 16, 8), (16384, 8, 16)]:\n    chunk = BLK*NC\n    grid = ((TOT + chunk - 1)//chunk,)\n    t = bench(lambda: _copy_kernel[grid](x, y, TOT, BLOCK=BLK, NCHUNK=NC, num_warps=W))\n    print(\"copy BLK=%d NC=%d W=%d grid=%d: %.4f ms -> %.1f GB/s\" % (BLK, NC, W, grid[0], t, 2*TOT*4/t/1e6), flush=True)\n\nos.environ.update(LN_B1=\"32768\", LN_B2=\"8192\", LN_NC=\"8\", LN_W1=\"16\", LN_W2=\"8\")\nspec = importlib.util.spec_from_file_location(\"sol\", \"/workspace/solution.py\")\nsol = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(sol)\nm = sol.ModelNew((64,256,256)).cuda()\nS = m.S\npart = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n\nt = bench(lambda: sol._ln_partial_kernel[(S, B)](x, part, N, S, BLOCK=m.B1, num_warps=m.W1))\nprint(\"partial alone: %.4f ms -> %.1f GB/s\" % (t, TOT*4/t/1e6), flush=True)\nchunk = m.B2*m.NC\nS2 = (N + chunk - 1)//chunk\nt = bench("]
[412.591861, "i", "lambda: sol._ln_apply_kernel[(S2, B)](x, part, m.weight, m.bias, y, N, S, 1e-5, BLOCK=m.B2, SP2=sol._next_pow2(S), NCHUNK=m.NC, num_warps=m.W2))\nprint(\"apply alone: %.4f ms -> %.1f GB/s\" % (t, 2*TOT*4/t/1e6), flush=True)\nt = bench(lambda: m(x))\nprint(\"full: %.4f ms\" % t, flush=True)\nPYEOF\ngpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- python3 /workspace/bench2.py\n"]
