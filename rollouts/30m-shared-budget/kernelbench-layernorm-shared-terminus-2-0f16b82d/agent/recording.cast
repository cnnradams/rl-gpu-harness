[695.33445, "o", "\u001b[?2004hroot@modal:/# "]
[778.66416, "i", "cat > /workspace/bench4.py <<'PYEOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n    s = tl.sum(x, axis=0)\n    q = tl.sum(x * x, axis=0)\n    base = (row * S + pid) * 2\n    tl.store(part_ptr + base, s)\n    tl.store(part_ptr + base + 1, q)\n\n@triton.jit\ndef _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\n           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr, REV: tl.constexpr):\n    row = tl.program_id(1)\n    if REV:\n        row = tl.num_programs(1) - 1 - row\n    pid = tl.program_id(0)\n    pids = tl.arange(0, SP2)\n    pmask = pids < S\n    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\n    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\n    mean = tl.sum(ps, axis=0) / N\n    var = tl.sum"]
[778.664212, "i", "(qs, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    start = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + row * N + offs, y, mask=mask)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nx = torch.rand(16, 64, 256, 256,"]
[778.664222, "i", " device=\"cuda\")\ny = torch.empty_like(x)\nw = torch.rand(64*256*256, device=\"cuda\")\nb = torch.rand(64*256*256, device=\"cuda\")\nTOT = x.numel()\nN = 64*256*256\nB = 16\n\nfor (B1, W1) in [(32768, 16), (65536, 32)]:\n    S = (N + B1 - 1)//B1\n    part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n    tp = bench(lambda: _part[(S, B)](x, part, N, S, BLOCK=B1, num_warps=W1))\n    SP2 = triton.next_power_of_2(S)\n    for (B2, NC, W, REV) in [(8192, 16, 8, False), (8192, 16, 8, True), (8192, 32, 8, False), (8192, 16, 16, False), (16384, 8, 16, False), (4096, 32, 8, False)]:\n        chunk = B2*NC\n        S2 = (N + chunk - 1)//chunk\n        t = bench(lambda: _apply[(S2, B)](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=SP2, NCHUNK=NC, REV=REV, num_warps=W))\n        print(\"B1=%d S=%d apply B2=%d NC=%d W=%d rev=%s grid=%d: %.4f ms (part %.4f)\" % (B1, S, B2, NC, W, REV, S2*B, t, tp), flush=True)\nPYEOF\nB64=$(base64 -w0 /workspace/bench4.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bash -c \"echo $B64 | base64 -d > /workspace/b"]
[778.664326, "i", "ench4.py\" && gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- python3 /workspace/bench4.py\n"]
[778.664362, "o", "cat > /workspace/bench4.py <<'PYEOF'\r\n\u001b[?2004l\r"]
[778.664429, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.664456, "o", "> "]
[778.664487, "o", "import triton\r\n\u001b[?2004l\r"]
[778.664508, "o", "\u001b[?2004h> "]
[778.664607, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.66463, "o", "> \r\n\u001b[?2004l\r"]
[778.664649, "o", "\u001b[?2004h> "]
[778.664681, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[778.664701, "o", "\u001b[?2004h> "]
[778.664847, "o", "def _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.66486, "o", "> "]
[778.664928, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[778.664958, "o", "\u001b[?2004h> "]
[778.665017, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[778.665044, "o", "\u001b[?2004h> "]
[778.665168, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.66518, "o", "> "]
[778.665231, "o", "    mask = offs < N\r\n\u001b[?2004l\r"]
[778.665258, "o", "\u001b[?2004h> "]
[778.6654, "o", "    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[778.66543, "o", "\u001b[?2004h> "]
[778.665487, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[778.665508, "o", "\u001b[?2004h> "]
[778.665583, "o", "    q = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[778.665604, "o", "\u001b[?2004h> "]
[778.665682, "o", "    base = (row * S + pid) * 2\r\n\u001b[?2004l\r"]
[778.665699, "o", "\u001b[?2004h"]
[778.665721, "o", "> "]
[778.665787, "o", "    tl.store(part_ptr + base, s)\r\n\u001b[?2004l\r"]
[778.665808, "o", "\u001b[?2004h> "]
[778.665899, "o", "    tl.store(part_ptr + base + 1, q)\r\n\u001b[?2004l\r"]
[778.665918, "o", "\u001b[?2004h> \r\n"]
[778.665944, "o", "\u001b[?2004l\r\u001b[?2004h"]
[778.665964, "o", "> "]
[778.66599, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[778.666011, "o", "\u001b[?2004h> "]
[778.666156, "o", "def _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\r\n\u001b[?2004l\r"]
[778.666182, "o", "\u001b[?2004h> "]
[778.666394, "o", "           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr, REV: tl.constexpr):\r\n\u001b[?2004l\r"]
[778.666419, "o", "\u001b[?2004h> "]
[778.666477, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[778.666507, "o", "\u001b[?2004h> "]
[778.666527, "o", "    if REV:\r\n\u001b[?2004l\r"]
[778.666548, "o", "\u001b[?2004h> "]
[778.666651, "o", "        row = tl.num_programs(1) - 1 - row\r\n\u001b[?2004l\r"]
[778.666664, "o", "\u001b[?2004h"]
[778.666686, "o", "> "]
[778.666735, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[778.666756, "o", "\u001b[?2004h"]
[778.666782, "o", "> "]
[778.66684, "o", "    pids = tl.arange(0, SP2)\r\n\u001b[?2004l\r"]
[778.666861, "o", "\u001b[?2004h> "]
[778.666917, "o", "    pmask = pids < S\r\n\u001b[?2004l\r"]
[778.666938, "o", "\u001b[?2004h> "]
[778.667117, "o", "    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[778.667154, "o", "\u001b[?2004h"]
[778.66717, "o", "> "]
[778.66734, "o", "    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[778.667367, "o", "\u001b[?2004h> "]
[778.667444, "o", "    mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[778.66747, "o", "\u001b[?2004h> "]
[778.667581, "o", "    var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[778.667602, "o", "\u001b[?2004h> "]
[778.667691, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[778.667709, "o", "\u001b[?2004h"]
[778.667735, "o", "> "]
[778.667797, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[778.667824, "o", "\u001b[?2004h> "]
[778.667933, "o", "    for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r"]
[778.667978, "o", "\u001b[?2004h> "]
[778.668082, "o", "        offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[778.668109, "o", "\u001b[?2004h> "]
[778.668171, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[778.668201, "o", "\u001b[?2004h> "]
[778.668355, "o", "        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[778.668375, "o", "\u001b[?2004h> "]
[778.668514, "o", "        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[778.668535, "o", "\u001b[?2004h> "]
[778.668668, "o", "        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[778.668685, "o", "\u001b[?2004h> "]
[778.668782, "o", "        y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[778.668808, "o", "\u001b[?2004h> "]
[778.668934, "o", "        tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[778.66896, "o", "\u001b[?2004h> \r\n"]
[778.66898, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[778.669041, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[778.669061, "o", "\u001b[?2004h> "]
[778.669114, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[778.669141, "o", "\u001b[?2004h"]
[778.669163, "o", "> "]
[778.669179, "o", "        fn()\r\n\u001b[?2004l\r"]
[778.669196, "o", "\u001b[?2004h> "]
[778.669267, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[778.669284, "o", "\u001b[?2004h> "]
[778.669318, "o", "    ts = []\r\n\u001b[?2004l\r"]
[778.669338, "o", "\u001b[?2004h> "]
[778.669397, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[778.669423, "o", "\u001b[?2004h> "]
[778.669496, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[778.669522, "o", "\u001b[?2004h> "]
[778.669708, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\r\n\u001b[?2004l\r"]
[778.669728, "o", "\u001b[?2004h> "]
[778.669778, "o", "        d.fill_(42)\r\n\u001b[?2004l\r"]
[778.669798, "o", "\u001b[?2004h> "]
[778.669838, "o", "        del d\r\n\u001b[?2004l\r"]
[778.669858, "o", "\u001b[?2004h> "]
[778.67007, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[778.670088, "o", "\u001b[?2004h> "]
[778.670189, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[778.670212, "o", "\u001b[?2004h> "]
[778.670292, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[778.670318, "o", "\u001b[?2004h> "]
[778.670406, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[778.670423, "o", "\u001b[?2004h> "]
[778.670466, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[778.670487, "o", "\u001b[?2004h> "]
[778.670554, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[778.670576, "o", "\u001b[?2004h> \r\n"]
[778.670596, "o", "\u001b[?2004l\r\u001b[?2004h"]
[778.670622, "o", "> "]
[778.670721, "o", "x = torch.rand(16, 64, 256, 256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[778.670748, "o", "\u001b[?2004h> "]
[778.670796, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[778.670817, "o", "\u001b[?2004h> "]
[778.670919, "o", "w = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[778.670939, "o", "\u001b[?2004h> "]
[778.671036, "o", "b = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[778.671061, "o", "\u001b[?2004h> "]
[778.671099, "o", "TOT = x.numel()\r\n\u001b[?2004l\r"]
[778.671131, "o", "\u001b[?2004h> "]
[778.671174, "o", "N = 64*256*256\r\n\u001b[?2004l\r"]
[778.671195, "o", "\u001b[?2004h> "]
[778.67122, "o", "B = 16\r\n\u001b[?2004l\r"]
[778.671247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[778.671272, "o", "\u001b[?2004h> "]
[778.671376, "o", "for (B1, W1) in [(32768, 16), (65536, 32)]:\r\n\u001b[?2004l\r"]
[778.671402, "o", "\u001b[?2004h> "]
[778.67146, "o", "    S = (N + B1 - 1)//B1\r\n\u001b[?2004l\r"]
[778.671487, "o", "\u001b[?2004h> "]
[778.671643, "o", "    part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[778.671669, "o", "\u001b[?2004h> "]
[778.671841, "o", "    tp = bench(lambda: _part[(S, B)](x, part, N, S, BLOCK=B1, num_warps=W1))\r\n\u001b[?2004l\r"]
[778.671861, "o", "\u001b[?2004h> "]
[778.671961, "o", "    SP2 = triton.next_power_of_2(S)\r\n\u001b[?2004l\r"]
[778.671988, "o", "\u001b[?2004h> "]
[778.672375, "o", "    for (B2, NC, W, REV) in [(8192, 16, 8, False), (8192, 16, 8, True), (8192, 32, 8, False), (8192, 16, 16, False), (16384, 8, 16, False), (4096, 32, 8, False)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.672405, "o", "> "]
[778.672443, "o", "        chunk = B2*NC\r\n\u001b[?2004l\r"]
[778.67246, "o", "\u001b[?2004h> "]
[778.672556, "o", "        S2 = (N + chunk - 1)//chunk\r\n\u001b[?2004l\r"]
[778.672591, "o", "\u001b[?2004h> "]
[778.672875, "o", "        t = bench(lambda: _apply[(S2, B)](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=SP2, NCHUNK=NC, REV=REV, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.672901, "o", "> "]
[778.673224, "o", "        print(\"B1=%d S=%d apply B2=%d NC=%d W=%d rev=%s grid=%d: %.4f ms (part %.4f)\" % (B1, S, B2, NC, W, REV, S2*B, t, tp), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[778.67325, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[778.674838, "o", "\u001b[?2004hroot@modal:/# "]
