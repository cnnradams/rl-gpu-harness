[1370.178041, "o", "  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\",\r\n    \"excessive_speedup\": true\r\n  },\r\n  \"runtime\": 0.3,\r\n  \"runtime_stats\": {\r\n    \"mean\": 0.3,\r\n    \"std\": 0.00265,\r\n    \"min\": 0.298,\r\n    \"max\": 0.325,\r\n    \"num_trials\": 100\r\n  },\r\n  \"ref_runtime\": 8.09,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 8.09,\r\n    \"std\": 0.00495,\r\n    \"min\": 8.08,\r\n    \"max\": 8.1,\r\n    \"num_trials\": 100\r\n  },\r\n  \"solution_sha256\": \"93cb12265d9390a6c8171ce1a7b25951f7428c0c6f70821cfb3d8204b3acd52d\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 100,\r\n  \"speedup\": 26.96666666666667\r\n}\r\n"]
