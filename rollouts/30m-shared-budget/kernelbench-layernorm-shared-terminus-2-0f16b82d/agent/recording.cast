[412.598438, "o", "\u001b[?2004h> "]
[412.598786, "o", "t = bench(lambda: sol._ln_apply_kernel[(S2, B)](x, part, m.weight, m.bias, y, N, S, 1e-5, BLOCK=m.B2, SP2=sol._next_pow2(S), NCHUNK=m.NC, num_warps=m.W2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.598829, "o", "> "]
