[412.596004, "o", "for (BLK, NC, W) in [(8192, 8, 8), (8192, 4, 8), (16384, 4, 16), (4096, 8, 4), (8192, 16, 8), (16384, 8, 16)]:\r\n\u001b[?2004l\r"]
[412.596044, "o", "\u001b[?2004h> "]
[412.596088, "o", "    chunk = BLK*NC\r\n\u001b[?2004l\r"]
[412.596126, "o", "\u001b[?2004h> "]
[412.596198, "o", "    grid = ((TOT + chunk - 1)//chunk,)\r\n\u001b[?2004l\r"]
[412.596236, "o", "\u001b[?2004h> "]
[412.596428, "o", "    t = bench(lambda: _copy_kernel[grid](x, y, TOT, BLOCK=BLK, NCHUNK=NC, num_warps=W))\r\n\u001b[?2004l\r"]
