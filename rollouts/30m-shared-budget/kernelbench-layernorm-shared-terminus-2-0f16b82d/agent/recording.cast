[1108.613063, "i", "cat > /workspace/bench6.py <<'PYEOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n    s = tl.sum(x, axis=0)\n    q = tl.sum(x * x, axis=0)\n    base = (row * S + pid) * 2\n    tl.store(part_ptr + base, s)\n    tl.store(part_ptr + base + 1, q)\n\n@triton.jit\ndef _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\n           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr,\n           SWAP: tl.constexpr, HINT: tl.constexpr):\n    if SWAP:\n        row = tl.program_id(0)\n        pid = tl.program_id(1)\n    else:\n        row = tl.program_id(1)\n        pid = tl.program_id(0)\n    pids = tl.arange(0, SP2)\n    pmask = pids < S\n    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\n    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mas"]
[1108.613109, "i", "k=pmask, other=0.0)\n    mean = tl.sum(ps, axis=0) / N\n    var = tl.sum(qs, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    start = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        if HINT:\n            offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\n        mask = offs < N\n        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + row * N + offs, y, mask=mask)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); "]
[1108.613214, "i", "fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nx = torch.rand(16, 64, 256, 256, device=\"cuda\")\ny = torch.empty_like(x)\nw = torch.rand(64*256*256, device=\"cuda\")\nb = torch.rand(64*256*256, device=\"cuda\")\nN = 64*256*256\nB = 16\nS = 128\npart = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n_part[(S, B)](x, part, N, S, BLOCK=32768, num_warps=16)\n\nfor (B2, NC, W, SWAP, HINT) in [\n    (8192, 16, 8, False, False),\n    (8192, 16, 8, True, False),\n    (8192, 16, 8, False, True),\n    (8192, 16, 8, True, True),\n    (8192, 8, 8, True, True),\n    (8192, 16, 4, True, True),\n    (4096, 16, 4, True, True),\n    (4096, 16, 8, True, True),\n]:\n    chunk = B2*NC\n    S2 = (N + chunk - 1)//chunk\n    grid = (B, S2) if SWAP else (S2, B)\n    t = bench(lambda: _apply[grid](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=S, NCHUNK=NC, SWAP=SWAP, HINT=HINT, num_warps=W))\n    print(\"apply B2=%d NC=%d W=%d swap=%s hint=%s: %.4f ms\" % (B2, NC, W, SWAP, HINT,"]
[1108.613235, "i", " t), flush=True)\nPYEOF\nB64=$(base64 -w0 /workspace/bench6.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bash -c \"echo $B64 | base64 -d > /workspace/bench6.py\" && gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- python3 /workspace/bench6.py\n"]
[1108.61337, "o", "cat > /workspace/bench6.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[1108.613406, "o", "\u001b[?2004h> "]
[1108.613439, "o", "import triton\r\n\u001b[?2004l\r"]
[1108.613471, "o", "\u001b[?2004h> "]
[1108.613548, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.61358, "o", "\r\n\u001b[?2004l\r"]
[1108.613612, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1108.613642, "o", "\u001b[?2004h> "]
[1108.613801, "o", "def _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.613864, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1108.613908, "o", "\u001b[?2004h> "]
[1108.613948, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1108.613993, "o", "\u001b[?2004h> "]
[1108.614094, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.614117, "o", "> "]
[1108.614166, "o", "    mask = offs < N\r\n\u001b[?2004l\r"]
[1108.614204, "o", "\u001b[?2004h> "]
[1108.614346, "o", "    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1108.614387, "o", "\u001b[?2004h> "]
[1108.614434, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[1108.614472, "o", "\u001b[?2004h> "]
[1108.614532, "o", "    q = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[1108.614575, "o", "\u001b[?2004h> "]
[1108.614633, "o", "    base = (row * S + pid) * 2\r\n\u001b[?2004l\r"]
[1108.614671, "o", "\u001b[?2004h> "]
[1108.614739, "o", "    tl.store(part_ptr + base, s)\r\n\u001b[?2004l\r"]
[1108.614777, "o", "\u001b[?2004h> "]
[1108.614853, "o", "    tl.store(part_ptr + base + 1, q)\r\n\u001b[?2004l\r"]
[1108.61489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1108.614935, "o", "\u001b[?2004h> "]
[1108.614973, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.615116, "o", "def _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\r\n\u001b[?2004l\r"]
[1108.615155, "o", "\u001b[?2004h> "]
[1108.615321, "o", "           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr,\r\n\u001b[?2004l\r"]
[1108.615366, "o", "\u001b[?2004h> "]
[1108.615472, "o", "           SWAP: tl.constexpr, HINT: tl.constexpr):\r\n\u001b[?2004l\r"]
[1108.615513, "o", "\u001b[?2004h> "]
[1108.615552, "o", "    if SWAP:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.615587, "o", "> "]
[1108.615639, "o", "        row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1108.615678, "o", "\u001b[?2004h> "]
[1108.615741, "o", "        pid = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1108.615779, "o", "\u001b[?2004h> "]
[1108.615817, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.615933, "o", "        row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1108.615973, "o", "\u001b[?2004h> "]
[1108.616046, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1108.616085, "o", "\u001b[?2004h> "]
[1108.616143, "o", "    pids = tl.arange(0, SP2)\r\n\u001b[?2004l\r"]
[1108.616181, "o", "\u001b[?2004h> "]
[1108.61622, "o", "    pmask = pids < S\r\n\u001b[?2004l\r"]
[1108.616262, "o", "\u001b[?2004h> "]
[1108.616425, "o", "    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1108.616466, "o", "\u001b[?2004h> "]
[1108.616628, "o", "    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1108.616668, "o", "\u001b[?2004h> "]
[1108.616735, "o", "    mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[1108.616777, "o", "\u001b[?2004h> "]
[1108.616872, "o", "    var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1108.616912, "o", "\u001b[?2004h> "]
[1108.616983, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1108.617027, "o", "\u001b[?2004h> "]
[1108.617087, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[1108.617125, "o", "\u001b[?2004h> "]
[1108.617208, "o", "    for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r"]
[1108.617246, "o", "\u001b[?2004h> "]
[1108.617364, "o", "        offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1108.617404, "o", "\u001b[?2004h> "]
[1108.617447, "o", "        if HINT:\r\n\u001b[?2004l\r"]
[1108.617488, "o", "\u001b[?2004h> "]
[1108.617626, "o", "            offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\r\n\u001b[?2004l\r"]
[1108.617665, "o", "\u001b[?2004h> "]
[1108.617712, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[1108.617751, "o", "\u001b[?2004h> "]
[1108.617891, "o", "        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1108.617931, "o", "\u001b[?2004h> "]
[1108.618046, "o", "        w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1108.618084, "o", "\u001b[?2004h> "]
[1108.618202, "o", "        b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1108.618245, "o", "\u001b[?2004h> "]
[1108.618318, "o", "        y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[1108.618361, "o", "\u001b[?2004h> "]
[1108.618479, "o", "        tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[1108.618516, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1108.61855, "o", "\u001b[?2004h> "]
[1108.618589, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[1108.618628, "o", "\u001b[?2004h> "]
[1108.618667, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[1108.618711, "o", "\u001b[?2004h> "]
[1108.618743, "o", "        fn()\r\n\u001b[?2004l\r"]
[1108.618783, "o", "\u001b[?2004h> "]
[1108.618834, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1108.618873, "o", "\u001b[?2004h> "]
[1108.618912, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.618974, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1108.619013, "o", "\u001b[?2004h> "]
[1108.61908, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1108.619118, "o", "\u001b[?2004h> "]
[1108.619281, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1108.61932, "o", "\u001b[?2004h> "]
[1108.619368, "o", "        d.fill_(42)\r\n\u001b[?2004l\r"]
[1108.619405, "o", "\u001b[?2004h> "]
[1108.619442, "o", "        del d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.619671, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.619709, "o", "> "]
[1108.619775, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1108.619819, "o", "\u001b[?2004h> "]
[1108.619895, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1108.619935, "o", "\u001b[?2004h> "]
[1108.620004, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1108.620042, "o", "\u001b[?2004h> "]
[1108.62008, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.620117, "o", "> "]
[1108.620157, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1108.620195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.620231, "o", "> "]
[1108.620328, "o", "x = torch.rand(16, 64, 256, 256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1108.620378, "o", "\u001b[?2004h> "]
[1108.620417, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1108.620457, "o", "\u001b[?2004h> "]
[1108.620541, "o", "w = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1108.62058, "o", "\u001b[?2004h> "]
[1108.620666, "o", "b = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1108.620705, "o", "\u001b[?2004h> "]
[1108.620744, "o", "N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.620786, "o", "> B = 16\r\n\u001b[?2004l\r"]
[1108.620826, "o", "\u001b[?2004h> S = 128\r\n\u001b[?2004l\r"]
[1108.620865, "o", "\u001b[?2004h> "]
[1108.620996, "o", "part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1108.621033, "o", "\u001b[?2004h> "]
[1108.621152, "o", "_part[(S, B)](x, part, N, S, BLOCK=32768, num_warps=16)\r\n\u001b[?2004l\r"]
[1108.621191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1108.621235, "o", "\u001b[?2004h> "]
[1108.62129, "o", "for (B2, NC, W, SWAP, HINT) in [\r\n\u001b[?2004l\r"]
[1108.621328, "o", "\u001b[?2004h> "]
[1108.621398, "o", "    (8192, 16, 8, False, False),\r\n\u001b[?2004l\r"]
[1108.621437, "o", "\u001b[?2004h> "]
[1108.621496, "o", "    (8192, 16, 8, True, False),\r\n\u001b[?2004l\r"]
[1108.621535, "o", "\u001b[?2004h> "]
[1108.621592, "o", "    (8192, 16, 8, False, True),\r\n\u001b[?2004l\r"]
[1108.621631, "o", "\u001b[?2004h> "]
[1108.621687, "o", "    (8192, 16, 8, True, True),\r\n\u001b[?2004l\r"]
[1108.621726, "o", "\u001b[?2004h> "]
[1108.621782, "o", "    (8192, 8, 8, True, True),\r\n\u001b[?2004l\r"]
[1108.62182, "o", "\u001b[?2004h> "]
[1108.621878, "o", "    (8192, 16, 4, True, True),\r\n\u001b[?2004l\r"]
[1108.621916, "o", "\u001b[?2004h> "]
[1108.621974, "o", "    (4096, 16, 4, True, True),\r\n\u001b[?2004l\r"]
[1108.622012, "o", "\u001b[?2004h> "]
[1108.62207, "o", "    (4096, 16, 8, True, True),\r\n\u001b[?2004l\r"]
[1108.622112, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r"]
[1108.622151, "o", "\u001b[?2004h> "]
[1108.622189, "o", "    chunk = B2*NC\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.622232, "o", "> "]
[1108.622281, "o", "    S2 = (N + chunk - 1)//chunk\r\n\u001b[?2004l\r"]
[1108.62232, "o", "\u001b[?2004h> "]
[1108.622412, "o", "    grid = (B, S2) if SWAP else (S2, B)\r\n\u001b[?2004l\r"]
[1108.622452, "o", "\u001b[?2004h> "]
[1108.622741, "o", "    t = bench(lambda: _apply[grid](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=S, NCHUNK=NC, SWAP=SWAP, HINT=HINT, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.622778, "o", "> "]
[1108.623002, "o", "    print(\"apply B2=%d NC=%d W=%d swap=%s hint=%s: %.4f ms\" % (B2, NC, W, SWAP, HINT, t), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.623038, "o", "> PYEOF\r\n\u001b[?2004l\r"]
[1108.625193, "o", "\u001b[?2004hroot@modal:/# "]
