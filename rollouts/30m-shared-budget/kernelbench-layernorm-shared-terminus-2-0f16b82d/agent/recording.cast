[1178.986334, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[1178.986356, "o", "\u001b[?2004h> \r\n"]
[1178.986378, "o", "\u001b[?2004l\r\u001b[?2004h> "]
