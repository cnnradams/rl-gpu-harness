[945.591383, "o", "command: 2f475b37f1a94427b561cc6e5927eac9\r\n"]
[947.807145, "o", "part B1=65536 W=16: 0.1012 ms 2652.1 GB/s\r\npart B1=131072 W=16: 0.1016 ms 2642.1 GB/s\r\n"]
[949.285689, "o", "apply B2=8192 NC=16 W=8 grid=512: 0.2225 ms\r\n"]
[950.749238, "o", "apply B2=8192 NC=12 W=8 grid=688: 0.2574 ms\r\n"]
[952.979858, "o", "apply B2=8192 NC=20 W=8 grid=416: 0.2612 ms\r\n"]
[957.991245, "o", "apply B2=8192 NC=16 W=4 grid=512: 0.2344 ms\r\n"]
[965.310346, "o", "apply B2=2048 NC=64 W=4 grid=512: 0.2347 ms\r\n"]
