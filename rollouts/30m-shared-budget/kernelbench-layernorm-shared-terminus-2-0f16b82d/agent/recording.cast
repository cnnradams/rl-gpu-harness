[279.429701, "i", "cat > /workspace/bench.py <<'PYEOF'\nimport os, sys, importlib.util\nimport torch\nimport torch.nn as nn\n\ndef load():\n    spec = importlib.util.spec_from_file_location(\"sol\", \"/workspace/solution.py\")\n    m = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(m)\n    return m\n\ndevice = \"cuda\"\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=device)\nref_model = nn.LayerNorm((64, 256, 256)).to(device)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\nwith torch.no_grad():\n    ref = ref_model(x)\n    md, mn = bench(lambda: ref_model(x))\n "]
[279.429752, "i", "   print(\"REF median=%.4f min=%.4f ms\" % (md, mn), flush=True)\n\nconfigs = [\n    dict(LN_B1=\"16384\", LN_B2=\"8192\", LN_NC=\"4\", LN_W1=\"8\", LN_W2=\"8\"),\n    dict(LN_B1=\"8192\", LN_B2=\"8192\", LN_NC=\"4\", LN_W1=\"4\", LN_W2=\"8\"),\n    dict(LN_B1=\"32768\", LN_B2=\"8192\", LN_NC=\"8\", LN_W1=\"16\", LN_W2=\"8\"),\n    dict(LN_B1=\"16384\", LN_B2=\"16384\", LN_NC=\"2\", LN_W1=\"8\", LN_W2=\"16\"),\n    dict(LN_B1=\"16384\", LN_B2=\"4096\", LN_NC=\"4\", LN_W1=\"8\", LN_W2=\"4\"),\n    dict(LN_B1=\"16384\", LN_B2=\"8192\", LN_NC=\"2\", LN_W1=\"8\", LN_W2=\"8\"),\n]\nfor cfg in configs:\n    for k, v in cfg.items():\n        os.environ[k] = v\n    sol = load()\n    m = sol.ModelNew((64, 256, 256)).to(device)\n    with torch.no_grad():\n        out = m(x)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        diff = (ref - out).abs().max().item()\n        md, mn = bench(lambda: m(x))\n    print(cfg, \"ok=%s maxdiff=%.2e median=%.4f min=%.4f\" % (ok, diff, md, mn), flush=True)\nPYEOF\n"]
[279.429952, "o", "cat > /workspace/bench.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.430025, "o", "import os, sys, importlib.util\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.430068, "o", "> import torch\r\n\u001b[?2004l\r"]
[279.430111, "o", "\u001b[?2004h> "]
[279.430157, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[279.430202, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.430245, "o", "\u001b[?2004h> "]
[279.430285, "o", "def load():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.430482, "o", "    spec = importlib.util.spec_from_file_location(\"sol\", \"/workspace/solution.py\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.430506, "o", "> "]
[279.430624, "o", "    m = importlib.util.module_from_spec(spec)\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.430661, "o", "> "]
[279.430715, "o", "    spec.loader.exec_module(m)\r\n\u001b[?2004l\r"]
[279.430756, "o", "\u001b[?2004h> "]
[279.430797, "o", "    return m\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[279.430836, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[279.430873, "o", "device = \"cuda\"\r\n\u001b[?2004l\r"]
[279.430915, "o", "\u001b[?2004h> "]
[279.430954, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[279.430994, "o", "\u001b[?2004h> "]
[279.4311, "o", "x = torch.rand(16, 64, 256, 256, device=device)\r\n\u001b[?2004l\r"]
[279.431143, "o", "\u001b[?2004h> "]
[279.431239, "o", "ref_model = nn.LayerNorm((64, 256, 256)).to(device)\r\n\u001b[?2004l\r"]
[279.431277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.431315, "o", "\u001b[?2004h> "]
[279.431353, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[279.431391, "o", "\u001b[?2004h> "]
[279.431431, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[279.431477, "o", "\u001b[?2004h> "]
[279.431515, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[279.431553, "o", "> "]
[279.431594, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[279.431633, "o", "\u001b[?2004h> "]
[279.431671, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.431734, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[279.431776, "o", "\u001b[?2004h> "]
[279.431838, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[279.431937, "o", "\u001b[?2004h> "]
[279.432075, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.432137, "o", "        d.fill_(42)\r\n\u001b[?2004l\r"]
[279.432176, "o", "\u001b[?2004h> "]
[279.432215, "o", "        del d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.432449, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.432559, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[279.432601, "o", "\u001b[?2004h> "]
[279.43266, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[279.432699, "o", "\u001b[?2004h> "]
[279.432778, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[279.432818, "o", "\u001b[?2004h> "]
[279.432859, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[279.432944, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[279.432982, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[279.43302, "o", "\u001b[?2004h> "]
[279.433058, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[279.433101, "o", "\u001b[?2004h> "]
[279.433139, "o", "    ref = ref_model(x)\r\n\u001b[?2004l\r"]
[279.433179, "o", "\u001b[?2004h> "]
[279.433269, "o", "    md, mn = bench(lambda: ref_model(x))\r\n\u001b[?2004l\r"]
[279.433309, "o", "\u001b[?2004h> "]
[279.433447, "o", "    print(\"REF median=%.4f min=%.4f ms\" % (md, mn), flush=True)\r\n\u001b[?2004l\r"]
[279.43349, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[279.433531, "o", "> configs = [\r\n\u001b[?2004l\r"]
[279.433568, "o", "\u001b[?2004h> "]
[279.433735, "o", "    dict(LN_B1=\"16384\", LN_B2=\"8192\", LN_NC=\"4\", LN_W1=\"8\", LN_W2=\"8\"),\r\n\u001b[?2004l\r"]
[279.433774, "o", "\u001b[?2004h> "]
[279.433921, "o", "    dict(LN_B1=\"8192\", LN_B2=\"8192\", LN_NC=\"4\", LN_W1=\"4\", LN_W2=\"8\"),\r\n\u001b[?2004l\r"]
[279.433959, "o", "\u001b[?2004h> "]
[279.434114, "o", "    dict(LN_B1=\"32768\", LN_B2=\"8192\", LN_NC=\"8\", LN_W1=\"16\", LN_W2=\"8\"),\r\n\u001b[?2004l\r"]
[279.434154, "o", "\u001b[?2004h> "]
[279.43431, "o", "    dict(LN_B1=\"16384\", LN_B2=\"16384\", LN_NC=\"2\", LN_W1=\"8\", LN_W2=\"16\"),\r\n\u001b[?2004l\r"]
[279.434349, "o", "\u001b[?2004h> "]
[279.434508, "o", "    dict(LN_B1=\"16384\", LN_B2=\"4096\", LN_NC=\"4\", LN_W1=\"8\", LN_W2=\"4\"),\r\n\u001b[?2004l\r"]
[279.434547, "o", "\u001b[?2004h> "]
[279.434699, "o", "    dict(LN_B1=\"16384\", LN_B2=\"8192\", LN_NC=\"2\", LN_W1=\"8\", LN_W2=\"8\"),\r\n\u001b[?2004l\r"]
[279.434737, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[279.434776, "o", "\u001b[?2004h> "]
[279.434833, "o", "for cfg in configs:\r\n\u001b[?2004l\r"]
[279.434874, "o", "\u001b[?2004h> "]
[279.43493, "o", "    for k, v in cfg.items():\r\n\u001b[?2004l\r"]
[279.434973, "o", "\u001b[?2004h> "]
[279.435011, "o", "        os.environ[k] = v\r\n\u001b[?2004l\r"]
[279.435053, "o", "\u001b[?2004h> "]
[279.435092, "o", "    sol = load()\r\n\u001b[?2004l\r"]
[279.435131, "o", "\u001b[?2004h> "]
[279.435228, "o", "    m = sol.ModelNew((64, 256, 256)).to(device)\r\n\u001b[?2004l\r"]
[279.435267, "o", "\u001b[?2004h> "]
[279.435317, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r"]
[279.435355, "o", "\u001b[?2004h> "]
[279.435395, "o", "        out = m(x)\r\n\u001b[?2004l\r"]
[279.435433, "o", "\u001b[?2004h> "]
[279.435563, "o", "        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[279.435608, "o", "\u001b[?2004h> "]
[279.435698, "o", "        diff = (ref - out).abs().max().item()\r\n\u001b[?2004l\r"]
[279.435742, "o", "\u001b[?2004h> "]
[279.435815, "o", "        md, mn = bench(lambda: m(x))\r\n\u001b[?2004l\r"]
[279.435854, "o", "\u001b[?2004h> "]
[279.436074, "o", "    print(cfg, \"ok=%s maxdiff=%.2e median=%.4f min=%.4f\" % (ok, diff, md, mn), flush=True)\r\n\u001b[?2004l\r"]
[279.436118, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
