[1252.118648, "i", "cat > /workspace/bench7.py <<'PYEOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\n    mask = offs < N\n    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n    s = tl.sum(x, axis=0)\n    q = tl.sum(x * x, axis=0)\n    base = (row * S + pid) * 2\n    tl.store(part_ptr + base, s)\n    tl.store(part_ptr + base + 1, q)\n\n@triton.jit\ndef _apply_mr(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\n              BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr, R: tl.constexpr):\n    rg = tl.program_id(0)\n    pid = tl.program_id(1)\n    pids = tl.arange(0, SP2)\n    pmask = pids < S\n    start = pid * BLOCK * NCHUNK\n    for r in tl.static_range(R):\n        row = rg * R + r\n        ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\n        qs = tl.loa"]
[1252.118789, "i", "d(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\n        mean = tl.sum(ps, axis=0) / N\n        var = tl.sum(qs, axis=0) / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        for i in tl.static_range(NCHUNK):\n            offs = start + i * BLOCK + tl.arange(0, BLOCK)\n            offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\n            mask = offs < N\n            x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n            w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n            b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n            y = (x - mean) * rstd * w + b\n            tl.store(y_ptr + row * N + offs, y, mask=mask)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enab"]
[1252.118815, "i", "le_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nx = torch.rand(16, 64, 256, 256, device=\"cuda\")\ny = torch.empty_like(x)\nw = torch.rand(64*256*256, device=\"cuda\")\nb = torch.rand(64*256*256, device=\"cuda\")\nN = 64*256*256\nB = 16\nS = 128\npart = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n_part[(S, B)](x, part, N, S, BLOCK=32768, num_warps=16)\n\nfor (B2, NC, W, R) in [\n    (8192, 16, 4, 2),\n    (8192, 16, 4, 4),\n    (8192, 8, 4, 2),\n    (8192, 16, 8, 2),\n    (8192, 16, 8, 4),\n    (8192, 16, 16, 4),\n    (8192, 8, 4, 4),\n]:\n    chunk = B2*NC\n    S2 = (N + chunk - 1)//chunk\n    grid = (B // R, S2)\n    t = bench(lambda: _apply_mr[grid](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=S, NCHUNK=NC, R=R, num_warps=W))\n    print(\"apply_mr B2=%d NC=%d W=%d R=%d grid=%s: %.4f ms\" % (B2, NC, W, R, grid, t), flush=True)\nPYEOF\nB64=$(base64 -w0 /workspace/bench7.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bas"]
