[1252.118951, "o", "> "]
[1252.119068, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1252.119158, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.119192, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.119224, "o", "> "]
[1252.119254, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.119294, "o", "> "]
[1252.119402, "o", "def _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1252.119439, "o", "\u001b[?2004h> "]
[1252.119496, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1252.119536, "o", "\u001b[?2004h> "]
[1252.119585, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1252.119625, "o", "\u001b[?2004h> "]
[1252.119719, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1252.119754, "o", "\u001b[?2004h> "]
[1252.119919, "o", "    offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\r\n\u001b[?2004l\r"]
[1252.119961, "o", "\u001b[?2004h> "]
[1252.12, "o", "    mask = offs < N\r\n\u001b[?2004l\r"]
[1252.12004, "o", "\u001b[?2004h> "]
[1252.120164, "o", "    x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1252.120197, "o", "\u001b[?2004h> "]
[1252.120255, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[1252.120296, "o", "\u001b[?2004h> "]
[1252.120353, "o", "    q = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[1252.120404, "o", "\u001b[?2004h> "]
