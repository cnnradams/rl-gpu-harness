[681.523752, "i", "cat > /workspace/bench3.py <<'PYEOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _copy2(x_ptr, y_ptr, N, BLOCK: tl.constexpr, NCHUNK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    start = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        if EV:\n            x = tl.load(x_ptr + offs, mask=mask, other=0.0, eviction_policy=\"evict_first\")\n            tl.store(y_ptr + offs, x, mask=mask, cache_modifier=\".cs\")\n        else:\n            x = tl.load(x_ptr + offs, mask=mask, other=0.0)\n            tl.store(y_ptr + offs, x, mask=mask)\n\n@triton.jit\ndef _part(x_ptr, part_ptr, N, S, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    if EV:\n        x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0, eviction_policy=\"evict_first\")\n    else:\n        x = tl.load(x_ptr + "]
[681.523806, "i", "row * N + offs, mask=mask, other=0.0)\n    s = tl.sum(x, axis=0)\n    q = tl.sum(x * x, axis=0)\n    base = (row * S + pid) * 2\n    tl.store(part_ptr + base, s)\n    tl.store(part_ptr + base + 1, q)\n\n@triton.jit\ndef _apply(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\n           BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    pids = tl.arange(0, SP2)\n    pmask = pids < S\n    ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\n    qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\n    mean = tl.sum(ps, axis=0) / N\n    var = tl.sum(qs, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    start = pid * BLOCK * NCHUNK\n    for i in tl.static_range(NCHUNK):\n        offs = start + i * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        if EV:\n            x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0, eviction_policy=\"evict_first\")\n            w = tl.load(w_p"]
[681.523815, "i", "tr + offs, mask=mask, other=0.0, eviction_policy=\"evict_last\")\n            b = tl.load(b_ptr + offs, mask=mask, other=0.0, eviction_policy=\"evict_last\")\n            y = (x - mean) * rstd * w + b\n            tl.store(y_ptr + row * N + offs, y, mask=mask, cache_modifier=\".cs\")\n        else:\n            x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\n            w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n            b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n            y = (x - mean) * rstd * w + b\n            tl.store(y_ptr + row * N + offs, y, mask=mask)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\n        d.fill_(42)\n        del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append"]
[681.523951, "i", "(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nx = torch.rand(16, 64, 256, 256, device=\"cuda\")\ny = torch.empty_like(x)\nw = torch.rand(64*256*256, device=\"cuda\")\nb = torch.rand(64*256*256, device=\"cuda\")\nTOT = x.numel()\nN = 64*256*256\nB = 16\n\nprint(\"torch copy_:\", bench(lambda: y.copy_(x)), flush=True)\nfor ev in [False, True]:\n    t = bench(lambda: _copy2[(2048,)](x, y, TOT, BLOCK=8192, NCHUNK=4, EV=ev, num_warps=8))\n    print(\"copy ev=%s: %.4f ms %.1f GB/s\" % (ev, t, 2*TOT*4/t/1e6), flush=True)\n\nfor (B1, W, EV) in [(32768, 16, False), (32768, 16, True), (16384, 8, True), (65536, 32, True), (8192, 4, True)]:\n    S = (N + B1 - 1)//B1\n    part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n    t = bench(lambda: _part[(S, B)](x, part, N, S, BLOCK=B1, EV=EV, num_warps=W))\n    print(\"part B1=%d W=%d ev=%s: %.4f ms %.1f GB/s\" % (B1, W, EV, t, TOT*4/t/1e6), flush=True)\n\nS = 128\npart = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\n_part[(S, B)](x, part, N, S, BLOCK=32768, EV=True, num_"]
[681.524004, "o", "cat > /workspace/bench3.py <<'PYEOF'\r\n\u001b[?2004l\r"]
[681.524045, "i", "warps=16)\nSP2 = 128\nfor (B2, NC, W, EV) in [(8192, 8, 8, False), (8192, 8, 8, True), (8192, 4, 8, True), (16384, 4, 16, True), (4096, 8, 4, True), (8192, 2, 8, True), (8192, 16, 8, True)]:\n    chunk = B2*NC\n    S2 = (N + chunk - 1)//chunk\n    t = bench(lambda: _apply[(S2, B)](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=SP2, NCHUNK=NC, EV=EV, num_warps=W))\n    print(\"apply B2=%d NC=%d W=%d ev=%s grid=%d: %.4f ms %.1f GB/s\" % (B2, NC, W, EV, S2*B, t, (2*TOT+2*N)*4/t/1e6), flush=True)\nPYEOF\nB64=$(base64 -w0 /workspace/bench3.py); gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- bash -c \"echo $B64 | base64 -d > /workspace/bench3.py\" && gpu exec sb-lFPtiyJgOP1pYqCw9O4gpi -- python3 /workspace/bench3.py\n"]
