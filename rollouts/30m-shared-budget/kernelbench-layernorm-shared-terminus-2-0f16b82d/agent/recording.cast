[320.905111, "o", "{'LN_B1': '32768', 'LN_B2': '8192', 'LN_NC': '8', 'LN_W1': '16', 'LN_W2': '8'} ok=True maxdiff=3.34e-06 median=0.3414 min=0.3396\r\n{'LN_B1': '16384', 'LN_B2': '16384', 'LN_NC': '2', 'LN_W1': '8', 'LN_W2': '16'} ok=True maxdiff=3.46e-06 median=0.4503 min=0.4485\r\n{'LN_B1': '16384', 'LN_B2': '4096', 'LN_NC': '4', 'LN_W1': '8', 'LN_W2': '4'} ok=True maxdiff=3.46e-06 median=0.3942 min=0.3840\r\n"]
