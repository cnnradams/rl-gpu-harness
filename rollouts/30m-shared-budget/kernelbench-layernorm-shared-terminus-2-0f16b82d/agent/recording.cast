[1252.120499, "o", "\u001b[?2004h> "]
[1252.12056, "o", "    tl.store(part_ptr + base, s)\r\n\u001b[?2004l\r"]
[1252.120599, "o", "\u001b[?2004h> "]
[1252.120675, "o", "    tl.store(part_ptr + base + 1, q)\r\n\u001b[?2004l\r"]
[1252.120714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.120753, "o", "> "]
[1252.120792, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1252.12095, "o", "def _apply_mr(x_ptr, part_ptr, w_ptr, b_ptr, y_ptr, N, S, eps,\r\n\u001b[?2004l\r"]
[1252.12099, "o", "\u001b[?2004h> "]
[1252.121192, "o", "              BLOCK: tl.constexpr, SP2: tl.constexpr, NCHUNK: tl.constexpr, R: tl.constexpr):\r\n\u001b[?2004l\r"]
[1252.121236, "o", "\u001b[?2004h> "]
[1252.121275, "o", "    rg = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1252.121315, "o", "\u001b[?2004h> "]
[1252.121372, "o", "    pid = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1252.121413, "o", "\u001b[?2004h> "]
[1252.121469, "o", "    pids = tl.arange(0, SP2)\r\n\u001b[?2004l\r"]
[1252.121509, "o", "\u001b[?2004h> "]
[1252.121546, "o", "    pmask = pids < S\r\n\u001b[?2004l\r"]
[1252.121585, "o", "\u001b[?2004h> "]
[1252.121656, "o", "    start = pid * BLOCK * NCHUNK\r\n\u001b[?2004l\r"]
[1252.1217, "o", "\u001b[?2004h> "]
[1252.121771, "o", "    for r in tl.static_range(R):\r\n\u001b[?2004l\r"]
[1252.121788, "o", "\u001b[?2004h> "]
[1252.121858, "o", "        row = rg * R + r\r\n\u001b[?2004l\r"]
[1252.121907, "o", "\u001b[?2004h> "]
[1252.122072, "o", "        ps = tl.load(part_ptr + (row * S + pids) * 2, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1252.122113, "o", "\u001b[?2004h> "]
[1252.122286, "o", "        qs = tl.load(part_ptr + (row * S + pids) * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[1252.122326, "o", "\u001b[?2004h> "]
[1252.122397, "o", "        mean = tl.sum(ps, axis=0) / N\r\n\u001b[?2004l\r"]
[1252.122437, "o", "\u001b[?2004h> "]
[1252.122542, "o", "        var = tl.sum(qs, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1252.122584, "o", "\u001b[?2004h> "]
[1252.122664, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1252.122703, "o", "\u001b[?2004h> "]
[1252.12279, "o", "        for i in tl.static_range(NCHUNK):\r\n\u001b[?2004l\r"]
[1252.12283, "o", "\u001b[?2004h> "]
[1252.122961, "o", "            offs = start + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1252.123, "o", "\u001b[?2004h> "]
[1252.123153, "o", "            offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)\r\n\u001b[?2004l\r"]
[1252.123194, "o", "\u001b[?2004h> "]
[1252.123246, "o", "            mask = offs < N\r\n\u001b[?2004l\r"]
[1252.123286, "o", "\u001b[?2004h> "]
[1252.123438, "o", "            x = tl.load(x_ptr + row * N + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1252.123478, "o", "\u001b[?2004h> "]
[1252.123602, "o", "            w = tl.load(w_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1252.123642, "o", "\u001b[?2004h> "]
[1252.123767, "o", "            b = tl.load(b_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1252.123806, "o", "\u001b[?2004h> "]
[1252.123916, "o", "            y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.123957, "o", "> "]
[1252.124072, "o", "            tl.store(y_ptr + row * N + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[1252.124112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1252.124151, "o", "\u001b[?2004h> "]
[1252.12419, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[1252.12423, "o", "\u001b[?2004h> "]
[1252.124268, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[1252.124306, "o", "\u001b[?2004h> "]
[1252.124346, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.124383, "o", "> "]
[1252.124422, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1252.124461, "o", "\u001b[?2004h> "]
[1252.124499, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.124537, "o", "> "]
[1252.124576, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.124619, "o", "> "]
[1252.124671, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1252.124714, "o", "\u001b[?2004h> "]
[1252.124871, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1252.124914, "o", "\u001b[?2004h> "]
[1252.124955, "o", "        d.fill_(42)\r\n\u001b[?2004l\r"]
[1252.124993, "o", "\u001b[?2004h> "]
[1252.125033, "o", "        del d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1252.125264, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.125302, "o", "> "]
[1252.125371, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1252.125408, "o", "\u001b[?2004h> "]
[1252.125477, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1252.125515, "o", "\u001b[?2004h> "]
[1252.125593, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1252.125636, "o", "\u001b[?2004h> "]
[1252.12568, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.125718, "o", "> "]
[1252.125756, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.125797, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1252.12593, "o", "x = torch.rand(16, 64, 256, 256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1252.125966, "o", "\u001b[?2004h> "]
[1252.126004, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1252.126042, "o", "\u001b[?2004h> "]
[1252.126136, "o", "w = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1252.126175, "o", "\u001b[?2004h> "]
[1252.126259, "o", "b = torch.rand(64*256*256, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1252.126298, "o", "\u001b[?2004h> "]
[1252.126336, "o", "N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.126375, "o", "> B = 16\r\n\u001b[?2004l\r"]
[1252.126413, "o", "\u001b[?2004h> S = 128\r\n\u001b[?2004l\r"]
[1252.126451, "o", "\u001b[?2004h> "]
[1252.12659, "o", "part = torch.empty(B*S*2, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1252.12663, "o", "\u001b[?2004h> "]
[1252.126746, "o", "_part[(S, B)](x, part, N, S, BLOCK=32768, num_warps=16)\r\n\u001b[?2004l\r"]
[1252.126785, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1252.126824, "o", "\u001b[?2004h> "]
[1252.126863, "o", "for (B2, NC, W, R) in [\r\n\u001b[?2004l\r"]
[1252.126911, "o", "\u001b[?2004h> "]
[1252.126954, "o", "    (8192, 16, 4, 2),\r\n\u001b[?2004l\r"]
[1252.126992, "o", "\u001b[?2004h> "]
[1252.12703, "o", "    (8192, 16, 4, 4),\r\n\u001b[?2004l\r"]
[1252.127073, "o", "\u001b[?2004h> "]
[1252.127111, "o", "    (8192, 8, 4, 2),\r\n\u001b[?2004l\r"]
[1252.12715, "o", "\u001b[?2004h> "]
[1252.127189, "o", "    (8192, 16, 8, 2),\r\n\u001b[?2004l\r"]
[1252.127232, "o", "\u001b[?2004h> "]
[1252.12727, "o", "    (8192, 16, 8, 4),\r\n\u001b[?2004l\r"]
[1252.127321, "o", "\u001b[?2004h> "]
[1252.127363, "o", "    (8192, 16, 16, 4),\r\n\u001b[?2004l\r"]
[1252.127401, "o", "\u001b[?2004h> "]
[1252.127426, "o", "    (8192, 8, 4, 4),\r\n\u001b[?2004l\r"]
[1252.127455, "o", "\u001b[?2004h> "]
[1252.127485, "o", "]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1252.127536, "o", "    chunk = B2*NC\r\n\u001b[?2004l\r"]
[1252.127575, "o", "\u001b[?2004h> "]
[1252.127638, "o", "    S2 = (N + chunk - 1)//chunk\r\n\u001b[?2004l\r"]
[1252.127683, "o", "\u001b[?2004h> "]
[1252.127722, "o", "    grid = (B // R, S2)\r\n\u001b[?2004l\r"]
[1252.127768, "o", "\u001b[?2004h> "]
[1252.128042, "o", "    t = bench(lambda: _apply_mr[grid](x, part, w, b, y, N, S, 1e-5, BLOCK=B2, SP2=S, NCHUNK=NC, R=R, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1252.128087, "o", "> "]
[1252.128289, "o", "    print(\"apply_mr B2=%d NC=%d W=%d R=%d grid=%s: %.4f ms\" % (B2, NC, W, R, grid, t), flush=True)\r\n\u001b[?2004l\r"]
[1252.128329, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[1252.130338, "o", "\u001b[?2004hroot@modal:/# "]
