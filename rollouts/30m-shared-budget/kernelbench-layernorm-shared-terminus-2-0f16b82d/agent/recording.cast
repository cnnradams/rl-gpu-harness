[795.050817, "o", "B1=32768 S=128 apply B2=8192 NC=16 W=16 rev=False grid=512: 0.2494 ms (part 0.1006)\r\n"]
[795.790816, "o", "B1=32768 S=128 apply B2=16384 NC=8 W=16 rev=False grid=512: 0.2607 ms (part 0.1006)\r\n"]
