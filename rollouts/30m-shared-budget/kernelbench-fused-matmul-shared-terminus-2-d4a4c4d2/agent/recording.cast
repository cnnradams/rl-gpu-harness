[191.569111, "i", "cat > /workspace/bench.py <<'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    W = lin.weight.mul(1.5).contiguous()\n    b = lin.bias.mul(1.5).contiguous()\n\nref = F.linear(x, lin.weight, lin.bias)\nref = ref * 0.5 + ref  # reference computation\nfolded = F.linear(x, W, b)\nprint('fold diff', (ref - folded).abs().max().item())\n\n@triton.jit\ndef mm_tf32x3(A, B, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n  "]
[191.569161, "i", "  rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        b = tl.load(Bp)\n        acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\n        Ap += BK * sak\n        Bp += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\n@triton.jit\ndef mm_fp16x3(A, B, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n"]
[191.569195, "i", "    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        b = tl.load(Bp)\n        ah = a.to(tl.float16); al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = b.to(tl.float16); bl = (b - bh.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        Ap += BK * sak\n        Bp += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\ndef run_kernel(kern, x, W, b, BM, BN, BK, GROUP=8, warps=8, stages=4):\n    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    kern[grid](x, W, b, out, M, N, K,\n               x.stride(0), x.stri"]
[191.569207, "i", "de(1), W.stride(0), W.stride(1),\n               out.stride(0), out.stride(1),\n               BM=BM, BN=BN, BK=BK, GROUP=GROUP,\n               num_warps=warps, num_stages=stages)\n    return out\n\ntol = 1e-4\nfor name, kern in [('tf32x3', mm_tf32x3), ('fp16x3', mm_fp16x3)]:\n    for (BM, BN, BK, w, s) in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3),(128,256,64,8,4),(64,256,64,4,4)]:\n        try:\n            out = run_kernel(kern, x, W, b, BM, BN, BK, 8, w, s)\n            ok = torch.allclose(ref, out, atol=tol, rtol=tol)\n            md = (ref - out).abs().max().item()\n            fn = lambda: run_kernel(kern, x, W, b, BM, BN, BK, 8, w, s)\n            t = time_execution_with_cuda_event(lambda _: fn(), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\n            import numpy as np\n            print(f\"{name} BM{BM} BN{BN} BK{BK} w{w} s{s}: ok={ok} maxdiff={md:.2e} t={np.mean(t):.3f}ms\")\n        except Exception as e:\n            print(f\"{name} BM{BM} BN{BN} BK{BK} w{w} s{s}: FAIL "]
[191.569214, "i", "{e}\")\n\nfn = lambda: F.linear(x, W, b)\nt = time_execution_with_cuda_event(lambda _: fn(), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\nimport numpy as np\nprint(f\"cublas folded: {np.mean(t):.3f}ms\")\nEOF\ngpu run --timeout 280 -- python3 /workspace/bench.py 2>&1 | tail -30\n"]
[191.569307, "o", "cat > /workspace/bench.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.569538, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.569557, "o", "> "]
[191.569692, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r"]
[191.56971, "o", "\u001b[?2004h> "]
[191.569989, "o", "from kernelbench.timing import time_execution_with_cuda_event\r\n\u001b[?2004l\r"]
[191.570021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr"]
[191.570064, "o", "\u001b[?2004h> "]
[191.570145, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[191.570189, "o", "\u001b[?2004h> "]
[191.570301, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[191.570336, "o", "\u001b[?2004h> "]
[191.570481, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[191.570512, "o", "\u001b[?2004h"]
[191.570552, "o", "> "]
[191.570644, "o", "lin = torch.nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[191.570682, "o", "\u001b[?2004h> "]
[191.57072, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[191.570763, "o", "\u001b[?2004h> "]
[191.57085, "o", "    W = lin.weight.mul(1.5).contiguous()\r\n\u001b[?2004l\r"]
[191.570893, "o", "\u001b[?2004h> "]
[191.57097, "o", "    b = lin.bias.mul(1.5).contiguous()\r\n\u001b[?2004l\r"]
[191.571013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.571052, "o", "\u001b[?2004h> "]
[191.571123, "o", "ref = F.linear(x, lin.weight, lin.bias)\r\n\u001b[?2004l\r"]
[191.571162, "o", "\u001b[?2004h> "]
[191.571267, "o", "ref = ref * 0.5 + ref  # reference computation\r\n\u001b[?2004l\r"]
[191.571306, "o", "\u001b[?2004h> "]
[191.571358, "o", "folded = F.linear(x, W, b)\r\n\u001b[?2004l\r"]
[191.571396, "o", "\u001b[?2004h> "]
[191.571508, "o", "print('fold diff', (ref - folded).abs().max().item())\r\n\u001b[?2004l\r"]
[191.571547, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.571584, "o", "\u001b[?2004h> "]
[191.571623, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.571787, "o", "def mm_tf32x3(A, B, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\r\n\u001b[?2004l\r"]
[191.571825, "o", "\u001b[?2004h> "]
[191.57202, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[191.572057, "o", "\u001b[?2004h> "]
[191.572114, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[191.572156, "o", "\u001b[?2004h> "]
[191.572271, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[191.572311, "o", "\u001b[?2004h> "]
[191.572358, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[191.572393, "o", "\u001b[?2004h> "]
[191.572452, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[191.572491, "o", "\u001b[?2004h> "]
[191.572628, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[191.572668, "o", "\u001b[?2004h> "]
[191.572768, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[191.572805, "o", "\u001b[?2004h> "]
[191.572887, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[191.572925, "o", "\u001b[?2004h> "]
[191.573024, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[191.573059, "o", "\u001b[?2004h> "]
[191.573139, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[191.573184, "o", "\u001b[?2004h> "]
[191.573235, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[191.573273, "o", "\u001b[?2004h> "]
[191.573382, "o", "    Ap = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[191.57342, "o", "\u001b[?2004h> "]
[191.573527, "o", "    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r"]
[191.573565, "o", "\u001b[?2004h> "]
[191.573663, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[191.573702, "o", "\u001b[?2004h> "]
[191.573762, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[191.5738, "o", "\u001b[?2004h> "]
[191.573848, "o", "        a = tl.load(Ap)\r\n\u001b[?2004l\r"]
[191.573886, "o", "\u001b[?2004h> "]
[191.573926, "o", "        b = tl.load(Bp)\r\n\u001b[?2004l\r"]
[191.573966, "o", "\u001b[?2004h> "]
[191.574093, "o", "        acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\r\n\u001b[?2004l\r"]
[191.574132, "o", "\u001b[?2004h> "]
[191.57417, "o", "        Ap += BK * sak\r\n\u001b[?2004l\r"]
[191.574215, "o", "\u001b[?2004h> "]
[191.574267, "o", "        Bp += BK * sbk\r\n\u001b[?2004l\r"]
[191.574302, "o", "\u001b[?2004h> "]
[191.574366, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[191.574404, "o", "\u001b[?2004h> "]
[191.574465, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[191.5745, "o", "\u001b[?2004h> "]
[191.57461, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[191.57465, "o", "\u001b[?2004h> "]
[191.574688, "o", "    tl.store(Cp, acc)\r\n\u001b[?2004l\r"]
[191.574726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.574764, "o", "\u001b[?2004h> "]
[191.574802, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[191.574973, "o", "def mm_fp16x3(A, B, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\r\n\u001b[?2004l\r"]
[191.575011, "o", "\u001b[?2004h> "]
[191.575208, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[191.575247, "o", "\u001b[?2004h> "]
[191.575301, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[191.575343, "o", "\u001b[?2004h> "]
[191.575452, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[191.575491, "o", "\u001b[?2004h> "]
[191.575546, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[191.575584, "o", "\u001b[?2004h> "]
[191.575639, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[191.575683, "o", "\u001b[?2004h> "]
[191.575807, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[191.575846, "o", "\u001b[?2004h> "]
[191.575949, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[191.575986, "o", "\u001b[?2004h> "]
[191.576069, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[191.576107, "o", "\u001b[?2004h> "]
[191.576196, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[191.576235, "o", "\u001b[?2004h> "]
[191.576313, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[191.576353, "o", "\u001b[?2004h> "]
[191.576401, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[191.576434, "o", "\u001b[?2004h> "]
[191.576546, "o", "    Ap = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[191.576584, "o", "\u001b[?2004h> "]
[191.57669, "o", "    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r"]
[191.576723, "o", "\u001b[?2004h> "]
[191.576827, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[191.576863, "o", "\u001b[?2004h> "]
[191.576923, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[191.576961, "o", "\u001b[?2004h> "]
[191.577021, "o", "        a = tl.load(Ap)\r\n\u001b[?2004l\r"]
[191.577056, "o", "\u001b[?2004h> "]
[191.577101, "o", "        b = tl.load(Bp)\r\n\u001b[?2004l\r"]
[191.577139, "o", "\u001b[?2004h> "]
[191.577313, "o", "        ah = a.to(tl.float16); al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[191.577358, "o", "\u001b[?2004h> "]
[191.577506, "o", "        bh = b.to(tl.float16); bl = (b - bh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[191.577545, "o", "\u001b[?2004h> "]
[191.577613, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[191.577651, "o", "\u001b[?2004h> "]
[191.57772, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[191.57776, "o", "\u001b[?2004h> "]
[191.577826, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[191.577864, "o", "\u001b[?2004h> "]
[191.577908, "o", "        Ap += BK * sak\r\n\u001b[?2004l\r"]
[191.577945, "o", "\u001b[?2004h> "]
[191.577989, "o", "        Bp += BK * sbk\r\n\u001b[?2004l\r"]
[191.578027, "o", "\u001b[?2004h> "]
[191.578087, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[191.578125, "o", "\u001b[?2004h> "]
[191.57819, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[191.578228, "o", "\u001b[?2004h> "]
[191.578348, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[191.578387, "o", "\u001b[?2004h> "]
[191.578424, "o", "    tl.store(Cp, acc)\r\n\u001b[?2004l\r"]
[191.578464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.578501, "o", "> "]
[191.578648, "o", "def run_kernel(kern, x, W, b, BM, BN, BK, GROUP=8, warps=8, stages=4):\r\n\u001b[?2004l\r"]
[191.578686, "o", "\u001b[?2004h> "]
[191.578819, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[191.578857, "o", "\u001b[?2004h> "]
[191.578968, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[191.579006, "o", "\u001b[?2004h> "]
[191.579088, "o", "    kern[grid](x, W, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[191.579126, "o", "\u001b[?2004h> "]
[191.579276, "o", "               x.stride(0), x.stride(1), W.stride(0), W.stride(1),\r\n\u001b[?2004l\r"]
[191.579316, "o", "\u001b[?2004h> "]
[191.579406, "o", "               out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[191.579445, "o", "\u001b[?2004h> "]
[191.579548, "o", "               BM=BM, BN=BN, BK=BK, GROUP=GROUP,\r\n\u001b[?2004l\r"]
[191.579592, "o", "\u001b[?2004h> "]
[191.579693, "o", "               num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[191.579731, "o", "\u001b[?2004h> "]
[191.579769, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.579813, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[191.579852, "o", "> tol = 1e-4\r\n\u001b[?2004l\r"]
[191.579889, "o", "\u001b[?2004h> "]
[191.580026, "o", "for name, kern in [('tf32x3', mm_tf32x3), ('fp16x3', mm_fp16x3)]:\r\n\u001b[?2004l\r"]
[191.580065, "o", "\u001b[?2004h> "]
[191.580375, "o", "    for (BM, BN, BK, w, s) in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3),(128,256,64,8,4),(64,256,64,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.580398, "o", "> "]
[191.580439, "o", "        try:\r\n\u001b[?2004l\r"]
[191.580477, "o", "\u001b[?2004h> "]
[191.580614, "o", "            out = run_kernel(kern, x, W, b, BM, BN, BK, 8, w, s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.58065, "o", "> "]
[191.580774, "o", "            ok = torch.allclose(ref, out, atol=tol, rtol=tol)\r\n\u001b[?2004l\r"]
[191.580812, "o", "\u001b[?2004h> "]
[191.580919, "o", "            md = (ref - out).abs().max().item()\r\n\u001b[?2004l\r"]
[191.580957, "o", "\u001b[?2004h> "]
[191.58113, "o", "            fn = lambda: run_kernel(kern, x, W, b, BM, BN, BK, 8, w, s)\r\n\u001b[?2004l\r"]
[191.581166, "o", "\u001b[?2004h> "]
[191.581454, "o", "            t = time_execution_with_cuda_event(lambda _: fn(), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.581491, "o", "> "]
[191.581544, "o", "            import numpy as np\r\n\u001b[?2004l\r"]
[191.581583, "o", "\u001b[?2004h> "]
[191.581824, "o", "            print(f\"{name} BM{BM} BN{BN} BK{BK} w{w} s{s}: ok={ok} maxdiff={md:.2e} t={np.mean(t):.3f}ms\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.58186, "o", "> "]
[191.581922, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[191.581961, "o", "\u001b[?2004h> "]
[191.582108, "o", "            print(f\"{name} BM{BM} BN{BN} BK{BK} w{w} s{s}: FAIL {e}\")\r\n\u001b[?2004l\r"]
[191.582133, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[191.582181, "o", "\u001b[?2004h> "]
[191.58225, "o", "fn = lambda: F.linear(x, W, b)\r\n\u001b[?2004l\r"]
[191.582283, "o", "\u001b[?2004h> "]
[191.582534, "o", "t = time_execution_with_cuda_event(lambda _: fn(), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.582568, "o", "> "]
[191.582608, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[191.582647, "o", "> "]
[191.582736, "o", "print(f\"cublas folded: {np.mean(t):.3f}ms\")\r\n\u001b[?2004l\r"]
[191.582766, "o", "\u001b[?2004h> "]
[191.582804, "o", "EOF\r\n\u001b[?2004l\r"]
[191.584485, "o", "\u001b[?2004hroot@modal:/# "]
[191.584674, "o", "gpu run --timeout 280 -- python3 /workspace/bench.py 2>&1 | tail -30\r\n\u001b[?2004l\r"]
[221.573835, "o", "request ID: 3c0d5b6c16af4c94adcfbfa75358b981\r\nbox: sb-fZhFDOFPSbwVH3e6UvCxq4\r\ncommand: 051bbd180acc4ee6a5a2970458429aa5\r\nfold diff 1.2516975402832031e-05\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\ntf32x3 BM128 BN128 BK64 w8 s3: ok=True maxdiff=9.89e-06 t=5.755ms\r\ntf32x3 BM128 BN256 BK64 w8 s3: FAIL out of resource: shared memory, Required: 327680, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\ntf32x3 BM256 BN128 BK64 w8 s3: FAIL out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\ntf32x3 BM128 BN128 BK128 w8 s3: FAIL out of resource: shared memory, Required: 393216, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\ntf32x3 BM128 BN256 BK64 w8 s4: FAIL out of resource: shared memory, Required: 425984, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\ntf32x3 BM64 BN256 BK64 w4 s4: FAIL out of resource: shared memory, Required: 376832, Hardware li"]
[221.5739, "o", "mit: 232448. Reducing block sizes or `num_stages` may help.\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\nfp16x3 BM128 BN128 BK64 w8 s3: ok=True maxdiff=4.24e-05 t=3.605ms\r\nfp16x3 BM128 BN256 BK64 w8 s3: FAIL out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\nfp16x3 BM256 BN128 BK64 w8 s3: ok=True maxdiff=4.24e-05 t=3.858ms\r\nfp16x3 BM128 BN128 BK128 w8 s3: FAIL out of resource: shared memory, Required: 327680, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nfp16x3 BM128 BN256 BK64 w8 s4: FAIL out of resource: shared memory, Required: 360448, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nfp16x3 BM64 BN256 BK64 w4 s4: FAIL out of resource: shared memory, Required: 311296, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, "]
