[221.574071, "o", "\u001b[?2004hroot@modal:/# "]
[261.054646, "i", "cat > /workspace/bench2.py <<'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    W = lin.weight.mul(1.5).contiguous()\n    b = lin.bias.mul(1.5).contiguous()\nWh = W.half(); Wl = (W - Wh.float()).half()\nref = F.linear(x, lin.weight, lin.bias); ref = ref * 0.5 + ref\n\n@triton.jit\ndef mm_fp16x3_v2(A, BH, BL, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, B"]
[261.054703, "i", "M)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rn[None, :] * sbn + rk[:, None] * sbk\n    BLp = BL + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        ah = a.to(tl.float16); al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(BHp); bl = tl.load(BLp)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        Ap += BK * sak\n        BHp += BK * sbk\n        BLp += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\ndef run_v2(x, Wh, Wl, b, BM, BN, BK, GROUP=8, warps=8, stages=3):\n    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    mm_fp16x3_v2[grid](x, Wh, Wl, b, out, M, N, K,\n               x.stride(0), x.stride"]
[261.054718, "i", "(1), Wh.stride(0), Wh.stride(1),\n               out.stride(0), out.stride(1),\n               BM=BM, BN=BN, BK=BK, GROUP=GROUP,\n               num_warps=warps, num_stages=stages)\n    return out\n\ntol = 1e-4\nfor (BM,BN,BK,G,w,s) in [(128,128,64,8,8,3),(128,256,64,8,8,2),(128,256,64,8,8,3),(256,128,64,8,8,2),(128,128,64,4,8,3),(128,128,64,16,8,3),(128,128,64,8,4,3),(128,256,32,8,8,3),(128,128,32,8,8,4),(64,128,64,8,4,3)]:\n    try:\n        out = run_v2(x, Wh, Wl, b, BM, BN, BK, G, w, s)\n        ok = torch.allclose(ref, out, atol=tol, rtol=tol)\n        md = (ref - out).abs().max().item()\n        fn = lambda: run_v2(x, Wh, Wl, b, BM, BN, BK, G, w, s)\n        t = time_execution_with_cuda_event(lambda _: fn(), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\n        print(f\"v2 BM{BM} BN{BN} BK{BK} G{G} w{w} s{s}: ok={ok} maxdiff={md:.2e} t={np.mean(t):.3f}ms\")\n    except Exception as e:\n        print(f\"v2 BM{BM} BN{BN} BK{BK} G{G} w{w} s{s}: FAIL {str(e)[:80]}\")\nEOF\ngpu run --timeout 280 -- python3 /works"]
[261.054727, "i", "pace/bench2.py 2>&1 | grep -E 'v2|Error'\n"]
