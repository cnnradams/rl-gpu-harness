[641.964442, "i", "cat > /workspace/v3common.py <<'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    W = lin.weight.mul(1.5).contiguous()\n    b = lin.bias.mul(1.5).contiguous()\nWh = W.half().contiguous(); Wl = (W - Wh.float()).half().contiguous()\nref = F.linear(x, lin.weight, lin.bias); ref = ref * 0.5 + ref\n\n@triton.jit\ndef split_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < n\n    a = tl.load(X + offs, mask=mask)\n    ah = a.to(tl.float16)\n    al = (a - ah.to(tl.float32)).to(tl.float16)\n    tl.store(XH + offs, ah, mask=mask)\n    tl.store(XL + offs, al, mask=mask)\n\ndef split_x(x):\n    xh = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    xl = torch.empty(x.shape, device=x.dev"]
[641.964495, "i", "ice, dtype=torch.float16)\n    n = x.numel()\n    split_kernel[(triton.cdiv(n, 4096),)](x, xh, xl, n, BLOCK=4096)\n    return xh, xl\n\n@triton.jit\ndef mm_fp16(AH, AL, BH, BL, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AHp = AH + rm[:, None] * sam + rk[None, :] * sak\n    ALp = AL + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rn[None, :] * sbn + rk[:, None] * sbk\n    BLp = BL + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(AHp); al = tl."]
[641.964509, "i", "load(ALp)\n        bh = tl.load(BHp); bl = tl.load(BLp)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        AHp += BK * sak; ALp += BK * sak\n        BHp += BK * sbk; BLp += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\ndef run_v3(xh, xl, Wh, Wl, b, BM, BN, BK, GROUP=8, warps=8, stages=3):\n    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    mm_fp16[grid](xh, xl, Wh, Wl, b, out, M, N, K,\n               xh.stride(0), xh.stride(1), Wh.stride(0), Wh.stride(1),\n               out.stride(0), out.stride(1),\n               BM=BM, BN=BN, BK=BK, GROUP=GROUP,\n               num_warps=warps, num_stages=stages)\n    return out\n\ndef full(x, BM, BN, BK, G, w, s):\n    xh, xl = split_x(x)\n    return run_v3(xh, xl, Wh, Wl, b, BM, BN, BK, G, w, s)\nEOF\ncat > /workspace/bench4.py <<'EOF'\nimport sys\nsys.path.inse"]
[641.964724, "i", "rt(0, '/workspace')\nfrom v3common import *\ntol = 1e-4\nfor (BM,BN,BK,G,w,s) in [(128,256,32,8,8,4),(128,256,32,8,8,3),(128,256,32,8,8,5),(128,256,32,4,8,4),(128,256,32,16,8,4),(256,256,32,8,8,2),(256,256,32,8,8,3),(128,512,32,8,8,3),(128,512,64,8,8,2),(128,256,32,8,4,4),(64,256,32,8,4,4),(128,128,64,8,8,3)]:\n    try:\n        out = full(x, BM, BN, BK, G, w, s)\n        ok = torch.allclose(ref, out, atol=tol, rtol=tol)\n        md = (ref - out).abs().max().item()\n        fn = lambda: full(x, BM, BN, BK, G, w, s)\n        t = time_execution_with_cuda_event(lambda _: fn(), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\n        print(f\"v3 BM{BM} BN{BN} BK{BK} G{G} w{w} s{s}: ok={ok} maxdiff={md:.2e} t={np.mean(t):.3f}ms\")\n    except Exception as e:\n        print(f\"v3 BM{BM} BN{BN} BK{BK} G{G} w{w} s{s}: FAIL {str(e)[:60]}\")\nEOF\ngpu run --timeout 280 -- python3 /workspace/bench4.py 2>&1 | grep -E 'v3'\n"]
