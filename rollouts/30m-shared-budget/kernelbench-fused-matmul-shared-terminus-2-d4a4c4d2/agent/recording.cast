[284.993648, "o", "\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN128 BK64 G8 w8 s3: ok=True maxdiff=4.24e-05 t=2.712ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN256 BK64 G8 w8 s2: ok=True maxdiff=4.24e-05 t=3.059ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN256 BK64 G8 w8 s3: FAIL out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reduci\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM256 BN128 BK64 G8 w8 s2: ok=True maxdiff=4.24e-05 t=3.480ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN128 BK64 G4 w8 s3: ok=True maxdiff=4.24e-05 t=2.732ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN128 BK64 G16 w8 s3: ok=True maxdiff=4.24e-05 t=2.726ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN128 BK64 G8 w4 s3: ok=True maxdiff=4.24e-05 t=3.089ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN256 BK32 G8 w8 s3: ok=True maxdiff=4.22e-05 t=2.917ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM128 BN128 BK32 G8 w8 s4: ok=True maxdiff=4.22e-05 t=2.804ms\r\n\u001b[01;31m\u001b[Kv2\u001b[m\u001b[K BM64 BN128 BK64 G8 w4 s3: ok=True maxdiff=4.24e-05 t=3.435ms\r\n"]
