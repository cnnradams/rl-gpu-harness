[358.155836, "o", "\u001b[?2004h> "]
[358.156104, "o", "t = time_execution_with_cuda_event(lambda _: split_x(x), [None], num_warmup=3, num_trials=10, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.156141, "o", "> "]
[358.156218, "o", "print(f\"split alone: {np.mean(t):.3f}ms\")\r\n\u001b[?2004l\r"]
