[569.999107, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, sys\nimport triton.language as tl\n\nprint('torch', torch.__version__, 'triton', triton.__version__)\ntorch.manual_seed(42)\nM, N, K = 16384, 4096, 4096\ndev = 'cuda'\nw = torch.empty(N, K, device=dev).uniform_(-(1/K**0.5), (1/K**0.5))\nb = torch.empty(N, device=dev).uniform_(-(1/K**0.5), (1/K**0.5))\nx = torch.rand(M, K, device=dev)\ns = 1.5\nref = torch.addmm(b, x, w.t(), beta=s, alpha=s)\n\n@triton.jit\ndef k_inline(XP, WTP, BP, YP, M, N, K, s,\n             sxm, sxk, swk, swn,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GM, GM)\n    pid_m = group_id * GM + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    xptrs = XP + rm[:, None] * "]
[569.999233, "i", "sxm + rk[None, :] * sxk\n    wptrs = WTP + rk[:, None] * swk + rn[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        xv = tl.load(xptrs)\n        wv = tl.load(wptrs)\n        xh = xv.to(tl.float16); xl = (xv - xh.to(tl.float32)).to(tl.float16)\n        wh = wv.to(tl.float16); wl = (wv - wh.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        acc = tl.dot(xl, wh, acc)\n        xptrs += BK * sxk; wptrs += BK * swk\n    bv = tl.load(BP + rn).to(tl.float32)\n    acc = acc * s + bv[None, :]\n    yptrs = YP + rm[:, None] * N + rn[None, :]\n    tl.store(yptrs, acc)\n\n@triton.jit\ndef k_wsplit(XP, WHP, WLP, BP, YP, M, N, K, s,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GM, GM)\n    pid_m = group_id * GM + (pi"]
[569.999293, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[569.999317, "i", "d % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    xptrs = XP + rm[:, None] * K + rk[None, :]\n    whptrs = WHP + rk[:, None] * N + rn[None, :]\n    wlptrs = WLP + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        xv = tl.load(xptrs)\n        xh = xv.to(tl.float16); xl = (xv - xh.to(tl.float32)).to(tl.float16)\n        wh = tl.load(whptrs); wl = tl.load(wlptrs)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        acc = tl.dot(xl, wh, acc)\n        xptrs += BK; whptrs += BK * N; wlptrs += BK * N\n    bv = tl.load(BP + rn).to(tl.float32)\n    acc = acc * s + bv[None, :]\n    yptrs = YP + rm[:, None] * N + rn[None, :]\n    tl.store(yptrs, acc)\n\n@triton.jit\ndef k_xwsplit(XHP, XLP, WHP, WLP, BP, YP, M, N, K, s,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n  "]
[569.999326, "o", "\u001b[?2004h> "]
[569.999341, "i", "  grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GM, GM)\n    pid_m = group_id * GM + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    xhptrs = XHP + rm[:, None] * K + rk[None, :]\n    xlptrs = XLP + rm[:, None] * K + rk[None, :]\n    whptrs = WHP + rk[:, None] * N + rn[None, :]\n    wlptrs = WLP + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        xh = tl.load(xhptrs); xl = tl.load(xlptrs)\n        wh = tl.load(whptrs); wl = tl.load(wlptrs)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        acc = tl.dot(xl, wh, acc)\n        xhptrs += BK; xlptrs += BK; whptrs += BK * N; wlptrs += BK * N\n    bv = tl.load(BP + rn).to(tl.float32)\n    acc = acc * s + bv[None, :]\n    yptrs = YP + rm[:, None] * N + rn[None, :]\n    tl"]
[569.99936, "i", ".store(yptrs, acc)\n\n@triton.jit\ndef k_prescale(XP, XHP, XLP, M, K, BM: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    nk = tl.cdiv(K, BK)\n    pm = pid // nk; pk = pid % nk\n    rm = pm * BM + tl.arange(0, BM)\n    rk = pk * BK + tl.arange(0, BK)\n    offs = rm[:, None] * K + rk[None, :]\n    xv = tl.load(XP + offs)\n    xh = xv.to(tl.float16)\n    xl = (xv - xh.to(tl.float32)).to(tl.float16)\n    tl.store(XHP + offs, xh)\n    tl.store(XLP + offs, xl)\n\nwt = w.t().contiguous()\nwh_c = wt.half()\nwl_c = (wt - wh_c.float()).half()\nbs = (b * s).contiguous()\ny = torch.empty(M, N, device=dev)\nxh_c = torch.empty(M, K, device=dev, dtype=torch.float16)\nxl_c = torch.empty(M, K, device=dev, dtype=torch.float16)\n\ndef run_inline(BM, BN, BK, GM, nw, ns):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_inline[grid](x, wt, bs, y, M, N, K, s, x.stride(0), x.stride(1), wt.stride(0), wt.stride(1), BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\n    return y\n\ndef run_wsplit(BM, BN, BK, GM, nw, ns):\n   "]
[569.999379, "o", "import torch, triton, sys\r\n\u001b[?2004l\r"]
[569.9994, "i", " grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_wsplit[grid](x, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\n    return y\n\ndef run_xwsplit(BM, BN, BK, GM, nw, ns):\n    pgrid = ((M // 128) * (K // 64),)\n    k_prescale[pgrid](x, xh_c, xl_c, M, K, BM=128, BK=64)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_xwsplit[grid](xh_c, xl_c, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\n    return y\n\ndef check(out):\n    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n    md = (ref - out).abs().max().item()\n    return ok, md\n\ncfgs = [\n    (128, 256, 64, 8, 8, 3),\n    (128, 256, 64, 8, 8, 2),\n    (256, 128, 64, 8, 8, 3),\n    (128, 128, 64, 8, 8, 4),\n    (256, 256, 64, 8, 8, 2),\n    (128, 256, 128, 8, 8, 2),\n    (256, 128, 32, 8, 8, 4),\n]\nfor name, fn in [('inline', run_inline), ('wsplit', run_wsplit), ('xwsplit', run_xwsplit)]:\n    for c in cfgs:\n        try:\n            out = fn(*c)\n            torch.cuda.synchr"]
[569.999413, "o", "\u001b[?2004h> "]
[569.999432, "i", "onize()\n            ok, md = check(out)\n            t = triton.testing.do_bench(lambda: fn(*c), warmup=20, rep=50)\n            print(f\"{name} cfg={c} ok={ok} maxdiff={md:.2e} t={t*1000:.1f}us\", flush=True)\n        except Exception as e:\n            print(f\"{name} cfg={c} FAILED {type(e).__name__}: {str(e)[:80]}\", flush=True)\nEOF\n"]
