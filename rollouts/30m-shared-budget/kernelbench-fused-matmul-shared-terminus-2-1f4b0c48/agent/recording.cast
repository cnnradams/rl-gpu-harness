[328.576783, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    HAS_TRITON = True\nexcept Exception:\n    HAS_TRITON = False\n\nif HAS_TRITON:\n    @triton.autotune(\n        configs=[\n            triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n            triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\n            triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n            triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GM': 8}, num_warps=8, num_stages=4),\n            triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=4, num_stages=4),\n        ],\n        key=['M', 'N', 'K'],\n    )\n    @triton.jit\n    def _linear_scale_kernel(XP, WTP, BP, YP, M, N, K, s,\n                             sxm, sxk, swk, swn, sym, syn,\n                             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                             "]
[328.576938, "i", "GM: tl.constexpr):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GM * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GM, GM)\n        pid_m = group_id * GM + (pid % group_size)\n        pid_n = (pid % width) // group_size\n\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n\n        xptrs = XP + rm[:, None] * sxm + rk[None, :] * sxk\n        wptrs = WTP + rk[:, None] * swk + rn[None, :] * swn\n\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for _k in range(0, K, BK):\n            x = tl.load(xptrs)\n            w = tl.load(wptrs)\n            xh = x.to(tl.float16)\n            xl = (x - xh.to(tl.float32)).to(tl.float16)\n            wh = w.to(tl.float16)\n            wl = (w - wh.to(tl.float32)).to(tl.float16)\n            acc = tl.dot(xh, wh, acc)\n            acc = tl.dot(xh, wl, acc)\n            acc = tl.dot(xl, wh, acc)\n            xpt"]
[328.576953, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[328.577128, "i", "rs += BK * sxk\n            wptrs += BK * swk\n\n        b = tl.load(BP + rn).to(tl.float32)\n        acc = acc * s + b[None, :]\n        yptrs = YP + rm[:, None] * sym + rn[None, :] * syn\n        tl.store(yptrs, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self.alpha = 1.0 + scaling_factor\n        self._wt = None\n        self._bs = None\n        self._wdata = None\n\n    def _fallback(self, x):\n        return torch.addmm(self.matmul.bias, x, self.matmul.weight.t(),\n                           beta=self.alpha, alpha=self.alpha)\n\n    def forward(self, x):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        if (not HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 or (x.dim() != 2):\n            return self._fallback(x)\n        M, K = x.shape\n        N = w.shape[0]\n        if (M % 64) or (N "]
[328.577189, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.577232, "i", "% 64) or (K % 32) or K != w.shape[1]:\n            return self._fallback(x)\n        if (self._wt is None) or (self._wdata is not w.data) or (self._wt.device != x.device):\n            self._wt = w.data.t().contiguous()\n            self._bs = (b.data * self.alpha).contiguous()\n            self._wdata = w.data\n        x = x.contiguous()\n        y = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n        _linear_scale_kernel[grid](\n            x, self._wt, self._bs, y, M, N, K, float(self.alpha),\n            x.stride(0), x.stride(1),\n            self._wt.stride(0), self._wt.stride(1),\n            y.stride(0), y.stride(1),\n        )\n        return y\nEOF\n"]
