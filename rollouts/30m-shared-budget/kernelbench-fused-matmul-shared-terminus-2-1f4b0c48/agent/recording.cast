[866.404683, "o", "\u001b[?2004h> "]
[866.404834, "o", "            triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r"]
[866.40485, "o", "\u001b[?2004h> "]
[866.405006, "o", "            triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=2),\r\n\u001b[?2004l\r"]
[866.405022, "o", "\u001b[?2004h> "]
[866.405179, "o", "            triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=4, num_stages=4),\r\n\u001b[?2004l\r"]
[866.405195, "o", "\u001b[?2004h> "]
[866.405219, "o", "        ],\r\n\u001b[?2004l\r"]
[866.405235, "o", "\u001b[?2004h> "]
[866.40529, "o", "        key=['M', 'N', 'K'],\r\n\u001b[?2004l\r"]
[866.405311, "o", "\u001b[?2004h> "]
[866.405328, "o", "    )\r\n\u001b[?2004l\r"]
[866.405342, "o", "\u001b[?2004h> "]
[866.405372, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[866.405384, "o", "\u001b[?2004h> "]
[866.405484, "o", "    def _wsplit_kernel(XP, WHP, WLP, BP, YP, M, N, K, s,\r\n\u001b[?2004l\r"]
[866.405505, "o", "\u001b[?2004h> "]
[866.405626, "o", "                       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[866.405646, "o", "\u001b[?2004h> "]
[866.405713, "o", "                       GM: tl.constexpr):\r\n\u001b[?2004l\r"]
[866.405733, "o", "\u001b[?2004h"]
[866.405746, "o", "> "]
[866.405784, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[866.405802, "o", "\u001b[?2004h> "]
[866.405855, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[866.405867, "o", "\u001b[?2004h> "]
[866.405928, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[866.405942, "o", "\u001b[?2004h> "]
[866.405994, "o", "        width = GM * grid_n\r\n\u001b[?2004l\r"]
[866.406009, "o", "\u001b[?2004h> "]
[866.406066, "o", "        group_id = pid // width\r\n\u001b[?2004l\r"]
[866.40608, "o", "\u001b[?2004h"]
[866.406094, "o", "> "]
[866.406181, "o", "        group_size = tl.minimum(grid_m - group_id * GM, GM)\r\n\u001b[?2004l\r"]
[866.406195, "o", "\u001b[?2004h> "]
[866.406282, "o", "        pid_m = group_id * GM + (pid % group_size)\r\n\u001b[?2004l\r"]
[866.406294, "o", "\u001b[?2004h"]
[866.40631, "o", "> "]
[866.406377, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[866.406399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[866.406413, "o", "\u001b[?2004h> "]
[866.406484, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[866.406499, "o", "\u001b[?2004h> "]
[866.406572, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[866.406585, "o", "\u001b[?2004h> "]
[866.40664, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[866.406655, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[866.406668, "o", "\u001b[?2004h> "]
[866.406757, "o", "        xptrs = XP + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[866.406778, "o", "\u001b[?2004h> "]
[866.40686, "o", "        whptrs = WHP + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[866.406875, "o", "\u001b[?2004h> "]
[866.406964, "o", "        wlptrs = WLP + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[866.406977, "o", "\u001b[?2004h"]
[866.406988, "o", "> \r\n\u001b[?2004l\r"]
[866.407003, "o", "\u001b[?2004h> "]
[866.407081, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[866.407097, "o", "\u001b[?2004h> "]
[866.407157, "o", "        for _k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[866.407172, "o", "\u001b[?2004h> "]
[866.407229, "o", "            xv = tl.load(xptrs)\r\n\u001b[?2004l\r"]
[866.407244, "o", "\u001b[?2004h> "]
[866.407311, "o", "            xh = xv.to(tl.float16)\r\n\u001b[?2004l\r"]
[866.407332, "o", "\u001b[?2004h> "]
[866.407418, "o", "            xl = (xv - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[866.407434, "o", "\u001b[?2004h> "]
[866.407491, "o", "            wh = tl.load(whptrs)\r\n\u001b[?2004l\r"]
[866.407504, "o", "\u001b[?2004h"]
[866.407516, "o", "> "]
[866.407565, "o", "            wl = tl.load(wlptrs)\r\n\u001b[?2004l\r"]
[866.407576, "o", "\u001b[?2004h"]
[866.407591, "o", "> "]
[866.407645, "o", "            acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[866.407668, "o", "\u001b[?2004h> "]
[866.407725, "o", "            acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[866.407744, "o", "\u001b[?2004h"]
[866.407754, "o", "> "]
[866.407806, "o", "            acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[866.407821, "o", "\u001b[?2004h> "]
[866.407865, "o", "            xptrs += BK\r\n\u001b[?2004l\r"]
[866.407879, "o", "\u001b[?2004h> "]
[866.407932, "o", "            whptrs += BK * N\r\n\u001b[?2004l\r"]
[866.407946, "o", "\u001b[?2004h> "]
[866.407997, "o", "            wlptrs += BK * N\r\n\u001b[?2004l\r"]
[866.408019, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[866.408033, "o", "\u001b[?2004h> "]
[866.408108, "o", "        bv = tl.load(BP + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[866.408119, "o", "\u001b[?2004h"]
[866.408129, "o", "> "]
[866.408186, "o", "        acc = acc * s + bv[None, :]\r\n\u001b[?2004l\r"]
[866.408201, "o", "\u001b[?2004h> "]
[866.408287, "o", "        yptrs = YP + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[866.408306, "o", "\u001b[?2004h> "]
[866.408357, "o", "        tl.store(yptrs, acc)\r\n\u001b[?2004l\r"]
[866.408373, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[866.408388, "o", "\u001b[?2004h> "]
[866.408403, "o", "\r\n\u001b[?2004l\r"]
[866.408414, "o", "\u001b[?2004h> "]
[866.408457, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[866.408467, "o", "\u001b[?2004h"]
[866.408489, "o", "> "]
[866.408595, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[866.40861, "o", "\u001b[?2004h> "]
[866.408678, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[866.408693, "o", "\u001b[?2004h> "]
[866.408791, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[866.408803, "o", "\u001b[?2004h"]
[866.408817, "o", "> "]
[866.408883, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[866.408898, "o", "\u001b[?2004h> "]
[866.40897, "o", "        self.alpha = 1.0 + scaling_factor\r\n\u001b[?2004l\r"]
[866.408985, "o", "\u001b[?2004h> "]
[866.409029, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[866.409042, "o", "\u001b[?2004h> "]
[866.409088, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[866.409103, "o", "\u001b[?2004h> "]
[866.409147, "o", "        self._bs = None\r\n\u001b[?2004l\r"]
[866.40917, "o", "\u001b[?2004h> "]
[866.409209, "o", "        self._wkey = None\r\n\u001b[?2004l\r"]
[866.409231, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[866.409245, "o", "\u001b[?2004h> "]
[866.409293, "o", "    def _fallback(self, x):\r\n\u001b[?2004l\r"]
[866.409312, "o", "\u001b[?2004h> "]
[866.409432, "o", "        return torch.addmm(self.matmul.bias, x, self.matmul.weight.t(),\r\n\u001b[?2004l\r"]
[866.409452, "o", "\u001b[?2004h> "]
[866.409549, "o", "                           beta=self.alpha, alpha=self.alpha)\r\n\u001b[?2004l\r"]
[866.409564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[866.409581, "o", "\u001b[?2004h> "]
[866.409628, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[866.409642, "o", "\u001b[?2004h"]
[866.409655, "o", "> "]
[866.409698, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[866.409713, "o", "\u001b[?2004h> "]
[866.409764, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[866.409779, "o", "\u001b[?2004h> "]
[866.409929, "o", "        if (not HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 or x.dim() != 2:\r\n\u001b[?2004l\r"]
[866.40994, "o", "\u001b[?2004h"]
[866.409952, "o", "> "]
[866.410009, "o", "            return self._fallback(x)\r\n\u001b[?2004l\r"]
[866.410027, "o", "\u001b[?2004h> "]
[866.410066, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[866.410081, "o", "\u001b[?2004h> "]
[866.410125, "o", "        N, Kw = w.shape\r\n\u001b[?2004l\r"]
[866.410139, "o", "\u001b[?2004h> "]
[866.410233, "o", "        if Kw != K or (M % 64) or (N % 64) or (K % 32):\r\n\u001b[?2004l\r"]
[866.410247, "o", "\u001b[?2004h> "]
[866.410317, "o", "            return self._fallback(x)\r\n\u001b[?2004l\r"]
[866.410329, "o", "\u001b[?2004h"]
[866.410344, "o", "> "]
[866.410473, "o", "        key = (w.data.data_ptr(), b.data.data_ptr(), w.data.device, w.data._version)\r\n\u001b[?2004l\r"]
[866.410488, "o", "\u001b[?2004h> "]
[866.410542, "o", "        if self._wkey != key:\r\n\u001b[?2004l\r"]
[866.410554, "o", "\u001b[?2004h"]
[866.410569, "o", "> "]
[866.410629, "o", "            wt = w.data.t().contiguous()\r\n\u001b[?2004l\r"]
[866.410644, "o", "\u001b[?2004h> "]
[866.410693, "o", "            wh = wt.half()\r\n\u001b[?2004l\r"]
[866.410708, "o", "\u001b[?2004h> "]
[866.41078, "o", "            wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[866.410796, "o", "\u001b[?2004h> "]
[866.410862, "o", "            self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[866.410878, "o", "\u001b[?2004h> "]
[866.410944, "o", "            self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[866.410959, "o", "\u001b[?2004h> "]
[866.411056, "o", "            self._bs = (b.data * self.alpha).contiguous()\r\n\u001b[?2004l\r"]
[866.411071, "o", "\u001b[?2004h> "]
[866.411122, "o", "            self._wkey = key\r\n\u001b[?2004l\r"]
[866.411136, "o", "\u001b[?2004h> "]
[866.411186, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[866.411202, "o", "\u001b[?2004h> "]
[866.411321, "o", "        y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[866.411336, "o", "\u001b[?2004h> "]
[866.411477, "o", "        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r"]
[866.411499, "o", "\u001b[?2004h> "]
[866.411546, "o", "        _wsplit_kernel[grid](\r\n\u001b[?2004l\r"]
[866.411562, "o", "\u001b[?2004h> "]
[866.411691, "o", "            x, self._wh, self._wl, self._bs, y, M, N, K, float(self.alpha),\r\n\u001b[?2004l\r"]
[866.411706, "o", "\u001b[?2004h> "]
[866.411729, "o", "        )\r\n\u001b[?2004l\r"]
[866.41174, "o", "\u001b[?2004h"]
[866.411755, "o", "> "]
[866.411778, "o", "        return y\r\n\u001b[?2004l\r"]
[866.411795, "o", "\u001b[?2004h> "]
[866.411808, "o", "EOF\r\n\u001b[?2004l\r"]
[866.413378, "o", "\u001b[?2004hroot@modal:/# "]
[866.41346, "o", "gpu sync && sha256sum /workspace/solution.py\r\n\u001b[?2004l\r"]
