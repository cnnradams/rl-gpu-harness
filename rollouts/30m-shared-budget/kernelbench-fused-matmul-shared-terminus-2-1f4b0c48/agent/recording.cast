[779.451418, "o", "\u001b[?2004h> "]
[779.451568, "o", "    xl_desc = tl.make_tensor_descriptor(XLP, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[779.45159, "o", "\u001b[?2004h> "]
[779.451747, "o", "    wh_desc = tl.make_tensor_descriptor(WHP, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\r\n\u001b[?2004l\r"]
[779.451769, "o", "\u001b[?2004h> "]
[779.45192, "o", "    wl_desc = tl.make_tensor_descriptor(WLP, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\r\n\u001b[?2004l\r"]
[779.451943, "o", "\u001b[?2004h> "]
[779.45209, "o", "    y_desc = tl.make_tensor_descriptor(YP, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\r\n\u001b[?2004l\r"]
[779.452113, "o", "\u001b[?2004h> "]
[779.452154, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[779.452176, "o", "\u001b[?2004h> "]
[779.452259, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[779.452281, "o", "\u001b[?2004h> "]
[779.452318, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r"]
[779.45234, "o", "\u001b[?2004h> "]
[779.452383, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[779.452405, "o", "\u001b[?2004h> "]
[779.452493, "o", "    group_size = tl.minimum(grid_m - group_id * GM, GM)\r\n\u001b[?2004l\r"]
[779.452515, "o", "\u001b[?2004h> "]
[779.452595, "o", "    pid_m = group_id * GM + (pid % group_size)\r\n\u001b[?2004l\r"]
[779.45262, "o", "\u001b[?2004h> "]
[779.452684, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[779.452707, "o", "\u001b[?2004h> "]
[779.452743, "o", "    off_m = pid_m * BM\r\n\u001b[?2004l\r"]
[779.452765, "o", "\u001b[?2004h> "]
[779.452802, "o", "    off_n = pid_n * BN\r\n\u001b[?2004l\r"]
[779.452824, "o", "\u001b[?2004h> "]
[779.452897, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[779.452919, "o", "\u001b[?2004h> "]
[779.452966, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[779.452989, "o", "\u001b[?2004h> "]
[779.453048, "o", "        xh = xh_desc.load([off_m, k])\r\n\u001b[?2004l\r"]
[779.453071, "o", "\u001b[?2004h> "]
[779.453129, "o", "        xl = xl_desc.load([off_m, k])\r\n\u001b[?2004l\r"]
[779.453151, "o", "\u001b[?2004h> "]
[779.45321, "o", "        wh = wh_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[779.453232, "o", "\u001b[?2004h> "]
[779.453291, "o", "        wl = wl_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[779.453313, "o", "\u001b[?2004h> "]
[779.453367, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[779.453388, "o", "\u001b[?2004h> "]
[779.453441, "o", "        acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[779.453471, "o", "\u001b[?2004h> "]
[779.453516, "o", "        acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[779.453538, "o", "\u001b[?2004h> "]
[779.45359, "o", "    rn = off_n + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[779.453613, "o", "\u001b[?2004h> "]
[779.45368, "o", "    bv = tl.load(BP + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[779.453702, "o", "\u001b[?2004h> "]
[779.453752, "o", "    acc = acc * s + bv[None, :]\r\n\u001b[?2004l\r"]
[779.453773, "o", "\u001b[?2004h> "]
[779.453833, "o", "    y_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[779.453855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[779.453879, "o", "\u001b[?2004h> "]
[779.45391, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[779.453932, "o", "\u001b[?2004h> "]
[779.453979, "o", "wh_c = wt.half().contiguous()\r\n\u001b[?2004l\r"]
[779.454001, "o", "\u001b[?2004h> "]
[779.454073, "o", "wl_c = (wt - wh_c.float()).half().contiguous()\r\n\u001b[?2004l\r"]
[779.454095, "o", "\u001b[?2004h> "]
[779.454135, "o", "bs = (b * s).contiguous()\r\n\u001b[?2004l\r"]
[779.454159, "o", "\u001b[?2004h> "]
[779.454209, "o", "y = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r"]
[779.454231, "o", "\u001b[?2004h> "]
[779.45432, "o", "xh_c = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[779.454342, "o", "\u001b[?2004h> "]
[779.454433, "o", "xl_c = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[779.454455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[779.45448, "o", "> "]
[779.45453, "o", "def run_tma(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r"]
[779.454552, "o", "\u001b[?2004h> "]
[779.454612, "o", "    pgrid = ((M // 128) * (K // 64),)\r\n\u001b[?2004l\r"]
[779.454633, "o", "\u001b[?2004h> "]
[779.454729, "o", "    k_prescale[pgrid](x, xh_c, xl_c, M, K, BM=128, BK=64)\r\n\u001b[?2004l\r"]
[779.454752, "o", "\u001b[?2004h> "]
[779.454837, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[779.454859, "o", "\u001b[?2004h> "]
[779.455039, "o", "    k_tma[grid](xh_c, xl_c, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[779.455071, "o", "\u001b[?2004h> "]
[779.455095, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[779.455123, "o", "\u001b[?2004h> "]
[779.455148, "o", "def check(out):\r\n\u001b[?2004l\r"]
[779.45517, "o", "\u001b[?2004h> "]
[779.455274, "o", "    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.455343, "o", "    md = (ref - out).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.455367, "o", "> "]
[779.455391, "o", "    return ok, md\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.455417, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[779.455442, "o", "> cfgs = [\r\n\u001b[?2004l\r"]
[779.455466, "o", "\u001b[?2004h> "]
[779.455506, "o", "    (128, 256, 64, 8, 8, 2),\r\n\u001b[?2004l\r"]
[779.455529, "o", "\u001b[?2004h> "]
[779.455572, "o", "    (128, 256, 64, 8, 8, 3),\r\n\u001b[?2004l\r"]
[779.455594, "o", "\u001b[?2004h> "]
[779.455638, "o", "    (256, 128, 64, 8, 8, 3),\r\n\u001b[?2004l\r"]
[779.455662, "o", "\u001b[?2004h> "]
[779.45571, "o", "    (128, 128, 64, 8, 8, 4),\r\n\u001b[?2004l\r"]
[779.455733, "o", "\u001b[?2004h> "]
[779.455779, "o", "    (128, 128, 128, 8, 8, 3),\r\n\u001b[?2004l\r"]
[779.455801, "o", "\u001b[?2004h> "]
[779.455845, "o", "    (256, 128, 64, 8, 8, 2),\r\n\u001b[?2004l\r"]
[779.455869, "o", "\u001b[?2004h> "]
[779.455912, "o", "    (64, 256, 64, 8, 4, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.455936, "o", "> ]\r\n\u001b[?2004l\r"]
[779.455961, "o", "\u001b[?2004h> "]
[779.455987, "o", "for c in cfgs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.456011, "o", "    try:\r\n"]
[779.456038, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[779.456079, "o", "        out = run_tma(*c)\r\n\u001b[?2004l\r"]
[779.456103, "o", "\u001b[?2004h> "]
[779.45615, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[779.456175, "o", "\u001b[?2004h> "]
[779.456214, "o", "        ok, md = check(out)\r\n\u001b[?2004l\r"]
[779.456237, "o", "\u001b[?2004h> "]
[779.456354, "o", "        t = triton.testing.do_bench(lambda: run_tma(*c), warmup=20, rep=50)\r\n\u001b[?2004l\r"]
[779.456377, "o", "\u001b[?2004h> "]
[779.456507, "o", "        print(f\"tma cfg={c} ok={ok} maxdiff={md:.2e} t={t*1000:.1f}us\", flush=True)\r\n\u001b[?2004l\r"]
[779.456529, "o", "\u001b[?2004h> "]
[779.456579, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[779.456603, "o", "\u001b[?2004h> "]
[779.456736, "o", "        print(f\"tma cfg={c} FAILED {type(e).__name__}: {str(e)[:100]}\", flush=True)\r\n\u001b[?2004l\r"]
[779.456758, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[779.502754, "o", "\u001b[?2004hroot@modal:/# "]
