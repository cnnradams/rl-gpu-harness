[570.004343, "o", "\u001b[?2004h> "]
[570.004457, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\rh"]
[570.004475, "o", "\u001b[?2004h> "]
[570.00458, "o", "        acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[570.004598, "o", "\u001b[?2004h> "]
[570.004676, "o", "        acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[570.004694, "o", "\u001b[?2004h> "]
[570.004799, "o", "        xptrs += BK * sxk; wptrs += BK * swk\r\n\u001b[?2004l\r"]
[570.004822, "o", "\u001b[?2004h> "]
[570.004946, "o", "    bv = tl.load(BP + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[570.004963, "o", "> "]
[570.005069, "o", "    acc = acc * s + bv[None, :]\r\n\u001b[?2004l\r"]
[570.005088, "o", "\u001b[?2004h> "]
[570.005232, "o", "    yptrs = YP + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.005252, "o", "\u001b[?2004h> "]
[570.005317, "o", "    tl.store(yptrs, acc)\r\n\u001b[?2004l\r"]
[570.005332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[570.005352, "o", "\u001b[?2004h> "]
[570.005395, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[570.005417, "o", "\u001b[?2004h> "]
[570.00553, "o", "def k_wsplit(XP, WHP, WLP, BP, YP, M, N, K, s,\r\n\u001b[?2004l\r"]
[570.005543, "o", "\u001b[?2004h> "]
[570.005758, "o", "             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r"]
[570.005775, "o", "\u001b[?2004h> "]
[570.005847, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[570.00587, "o", "\u001b[?2004h> "]
[570.005994, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[570.006011, "o", "\u001b[?2004h> "]
[570.00609, "o", "    width = GM * grid_n\r\n\u001b[?2004l\rt"]
[570.006111, "o", "\u001b[?2004h> "]
[570.006172, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[570.006187, "o", "\u001b[?2004h> "]
[570.006327, "o", "    group_size = tl.minimum(grid_m - group_id * GM, GM)\r\n\u001b[?2004l\r"]
[570.006351, "o", "\u001b[?2004h> "]
[570.006477, "o", "    pid_m = group_id * GM + (pid % group_size)\r\n\u001b[?2004l\r"]
[570.006503, "o", "\u001b[?2004h> "]
[570.006605, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[570.006624, "o", "\u001b[?2004h> "]
[570.006711, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[570.006733, "o", "\u001b[?2004h> "]
[570.006851, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[570.006867, "o", "\u001b[?2004h> "]
[570.006953, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[570.006972, "o", "\u001b[?2004h> "]
[570.007097, "o", "    xptrs = XP + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[570.007116, "o", "\u001b[?2004h> "]
[570.007243, "o", "    whptrs = WHP + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.007262, "o", "\u001b[?2004h> "]
[570.007378, "o", "    wlptrs = WLP + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.007393, "o", "\u001b[?2004h> "]
[570.007506, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[570.007524, "o", "\u001b[?2004h> "]
[570.007578, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[570.0076, "o", "\u001b[?2004h> "]
[570.007642, "o", "        xv = tl.load(xptrs)\r\n\u001b[?2004l\r"]
[570.007664, "o", "\u001b[?2004h> "]
[570.007782, "o", "        xh = xv.to(tl.float16); xl = (xv - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[570.0078, "o", "\u001b[?2004h> "]
[570.007881, "o", "        wh = tl.load(whptrs); wl = tl.load(wlptrs)\r\n\u001b[?2004l\r"]
[570.007912, "o", "\u001b[?2004h> "]
[570.007972, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[570.00799, "o", "\u001b[?2004h"]
[570.008002, "o", "> "]
[570.008055, "o", "        acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[570.00807, "o", "\u001b[?2004h> "]
[570.008125, "o", "        acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[570.008144, "o", "\u001b[?2004h> "]
[570.008231, "o", "        xptrs += BK; whptrs += BK * N; wlptrs += BK * N\r\n\u001b[?2004l\r"]
[570.008252, "o", "\u001b[?2004h> "]
[570.008311, "o", "    bv = tl.load(BP + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[570.008333, "o", "\u001b[?2004h> "]
[570.008379, "o", "    acc = acc * s + bv[None, :]\r\n\u001b[?2004l\r"]
[570.008401, "o", "\u001b[?2004h> "]
[570.008469, "o", "    yptrs = YP + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.008487, "o", "\u001b[?2004h> "]
[570.00853, "o", "    tl.store(yptrs, acc)\r\n\u001b[?2004l\r"]
[570.00856, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[570.008572, "o", "\u001b[?2004h> "]
[570.0086, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[570.008613, "o", "\u001b[?2004h> "]
[570.008701, "o", "def k_xwsplit(XHP, XLP, WHP, WLP, BP, YP, M, N, K, s,\r\n\u001b[?2004l\r"]
[570.008722, "o", "\u001b[?2004h> "]
[570.008853, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r"]
[570.008875, "o", "\u001b[?2004h> "]
[570.008913, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[570.008927, "o", "\u001b[?2004h> "]
[570.009013, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[570.009032, "o", "\u001b[?2004h> "]
[570.009068, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r"]
[570.009089, "o", "\u001b[?2004h> "]
[570.00913, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[570.009145, "o", "\u001b[?2004h> "]
[570.009246, "o", "    group_size = tl.minimum(grid_m - group_id * GM, GM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[570.009265, "o", "> "]
[570.009334, "o", "    pid_m = group_id * GM + (pid % group_size)\r\n\u001b[?2004l\r"]
[570.009349, "o", "\u001b[?2004h> "]
[570.009413, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[570.009435, "o", "\u001b[?2004h> "]
[570.009491, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[570.009516, "o", "\u001b[?2004h> "]
[570.009576, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[570.009589, "o", "\u001b[?2004h> "]
[570.009635, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[570.009657, "o", "\u001b[?2004h> "]
[570.009727, "o", "    xhptrs = XHP + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[570.009741, "o", "\u001b[?2004h> "]
[570.009821, "o", "    xlptrs = XLP + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[570.009839, "o", "\u001b[?2004h> "]
[570.009915, "o", "    whptrs = WHP + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.009928, "o", "\u001b[?2004h> "]
[570.010007, "o", "    wlptrs = WLP + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.010029, "o", "\u001b[?2004h> "]
[570.010098, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[570.010117, "o", "\u001b[?2004h> "]
[570.010163, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[570.010184, "o", "\u001b[?2004h> "]
[570.010259, "o", "        xh = tl.load(xhptrs); xl = tl.load(xlptrs)\r\n\u001b[?2004l\r"]
[570.010279, "o", "\u001b[?2004h> "]
[570.010356, "o", "        wh = tl.load(whptrs); wl = tl.load(wlptrs)\r\n\u001b[?2004l\r"]
[570.010377, "o", "\u001b[?2004h> "]
[570.010427, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[570.010441, "o", "\u001b[?2004h> "]
[570.010502, "o", "        acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[570.010518, "o", "\u001b[?2004h> "]
[570.010571, "o", "        acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[570.010593, "o", "\u001b[?2004h> "]
[570.010699, "o", "        xhptrs += BK; xlptrs += BK; whptrs += BK * N; wlptrs += BK * N\r\n\u001b[?2004l\r"]
[570.01072, "o", "\u001b[?2004h> "]
[570.01078, "o", "    bv = tl.load(BP + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[570.010798, "o", "\u001b[?2004h> "]
[570.010847, "o", "    acc = acc * s + bv[None, :]\r\n\u001b[?2004l\r"]
[570.010868, "o", "\u001b[?2004h> "]
[570.010937, "o", "    yptrs = YP + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[570.010959, "o", "\u001b[?2004h> "]
[570.010993, "o", "    tl.store(yptrs, acc)\r\n\u001b[?2004l\r"]
[570.011009, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[570.011022, "o", "\u001b[?2004h> "]
[570.011049, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[570.01106, "o", "\u001b[?2004h> "]
[570.011178, "o", "def k_prescale(XP, XHP, XLP, M, K, BM: tl.constexpr, BK: tl.constexpr):\r\n\u001b[?2004l\r"]
[570.0112, "o", "\u001b[?2004h> "]
[570.011238, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[570.01126, "o", "\u001b[?2004h> "]
[570.011293, "o", "    nk = tl.cdiv(K, BK)\r\n\u001b[?2004l\r"]
[570.011315, "o", "\u001b[?2004h> "]
[570.011364, "o", "    pm = pid // nk; pk = pid % nk\r\n\u001b[?2004l\r"]
[570.011386, "o", "\u001b[?2004h> "]
[570.011438, "o", "    rm = pm * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[570.011454, "o", "\u001b[?2004h> "]
[570.011517, "o", "    rk = pk * BK + tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[570.01154, "o", "\u001b[?2004h> "]
[570.011598, "o", "    offs = rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[570.011619, "o", "\u001b[?2004h> "]
[570.011659, "o", "    xv = tl.load(XP + offs)\r\n\u001b[?2004l\r"]
[570.01168, "o", "\u001b[?2004h> "]
[570.011719, "o", "    xh = xv.to(tl.float16)\r\n\u001b[?2004l\r"]
[570.011732, "o", "\u001b[?2004h> "]
[570.011812, "o", "    xl = (xv - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[570.011835, "o", "\u001b[?2004h> "]
[570.011876, "o", "    tl.store(XHP + offs, xh)\r\n\u001b[?2004l\r"]
[570.011891, "o", "\u001b[?2004h> "]
[570.011939, "o", "    tl.store(XLP + offs, xl)\r\n\u001b[?2004l\r"]
[570.011952, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[570.011968, "o", "\u001b[?2004h> "]
[570.012012, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[570.01203, "o", "\u001b[?2004h> "]
[570.012056, "o", "wh_c = wt.half()\r\n\u001b[?2004l\r"]
[570.01207, "o", "\u001b[?2004h> "]
[570.012127, "o", "wl_c = (wt - wh_c.float()).half()\r\n\u001b[?2004l\r"]
[570.012149, "o", "\u001b[?2004h> "]
[570.012186, "o", "bs = (b * s).contiguous()\r\n\u001b[?2004l\r"]
[570.012201, "o", "\u001b[?2004h> "]
[570.012257, "o", "y = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r"]
[570.012279, "o", "\u001b[?2004h> "]
[570.012364, "o", "xh_c = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[570.012382, "o", "\u001b[?2004h> "]
[570.012472, "o", "xl_c = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[570.012496, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[570.012512, "o", "\u001b[?2004h> "]
[570.012588, "o", "def run_inline(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r"]
[570.012609, "o", "\u001b[?2004h> "]
[570.012695, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[570.012713, "o", "> "]
[570.012957, "o", "    k_inline[grid](x, wt, bs, y, M, N, K, s, x.stride(0), x.stride(1), wt.stride(0), wt.stride(1), BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[570.012975, "o", "> "]
[570.012986, "o", "    return y\r\n\u001b[?2004l\r"]
[570.013005, "o", "\u001b[?2004h> "]
[570.013023, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[570.013092, "o", "def run_wsplit(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r"]
[570.013108, "o", "\u001b[?2004h> "]
[570.013195, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[570.013209, "o", "\u001b[?2004h> "]
[570.013386, "o", "    k_wsplit[grid](x, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[570.013404, "o", "> "]
[570.013417, "o", "    return y\r\n\u001b[?2004l\r"]
[570.013439, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[570.013451, "o", "\u001b[?2004h> "]
[570.013527, "o", "def run_xwsplit(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r"]
[570.013547, "o", "\u001b[?2004h> "]
[570.013603, "o", "    pgrid = ((M // 128) * (K // 64),)\r\n\u001b[?2004l\r"]
[570.013617, "o", "\u001b[?2004h> "]
[570.01371, "o", "    k_prescale[pgrid](x, xh_c, xl_c, M, K, BM=128, BK=64)\r\n\u001b[?2004l\r"]
[570.013733, "o", "\u001b[?2004h> "]
[570.013812, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[570.013836, "o", "\u001b[?2004h> "]
[570.014015, "o", "    k_xwsplit[grid](xh_c, xl_c, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[570.014028, "o", "\u001b[?2004h> "]
[570.014053, "o", "    return y\r\n\u001b[?2004l\r"]
[570.014065, "o", "\u001b[?2004h> "]
[570.014076, "o", "\r\n\u001b[?2004l\r"]
[570.014087, "o", "\u001b[?2004h> "]
[570.014116, "o", "def check(out):\r\n\u001b[?2004l\r"]
[570.014129, "o", "\u001b[?2004h> "]
[570.014221, "o", "    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[570.014242, "o", "\u001b[?2004h> "]
[570.014301, "o", "    md = (ref - out).abs().max().item()\r\n\u001b[?2004l\r"]
[570.014317, "o", "\u001b[?2004h> "]
[570.014347, "o", "    return ok, md\r\n\u001b[?2004l\r"]
[570.014363, "o", "\u001b[?2004h> "]
[570.014384, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[570.0144, "o", "cfgs = [\r\n\u001b[?2004l\r"]
[570.014416, "o", "\u001b[?2004h> "]
[570.014466, "o", "    (128, 256, 64, 8, 8, 3),\r\n\u001b[?2004l\r"]
[570.014487, "o", "\u001b[?2004h> "]
[570.014533, "o", "    (128, 256, 64, 8, 8, 2),\r\n\u001b[?2004l\r"]
[570.014553, "o", "\u001b[?2004h> "]
[570.014596, "o", "    (256, 128, 64, 8, 8, 3),\r\n\u001b[?2004l\r"]
[570.014614, "o", "\u001b[?2004h> "]
[570.01466, "o", "    (128, 128, 64, 8, 8, 4),\r\n\u001b[?2004l\r"]
[570.014678, "o", "\u001b[?2004h> "]
[570.014724, "o", "    (256, 256, 64, 8, 8, 2),\r\n\u001b[?2004l\r"]
[570.014745, "o", "\u001b[?2004h> "]
[570.014789, "o", "    (128, 256, 128, 8, 8, 2),\r\n\u001b[?2004l\r"]
[570.014804, "o", "\u001b[?2004h> "]
[570.014852, "o", "    (256, 128, 32, 8, 8, 4),\r\n\u001b[?2004l\r"]
[570.014872, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[570.014886, "o", "\u001b[?2004h> "]
[570.015043, "o", "for name, fn in [('inline', run_inline), ('wsplit', run_wsplit), ('xwsplit', run_xwsplit)]:\r\n\u001b[?2004l\r"]
[570.015064, "o", "\u001b[?2004h> "]
[570.015094, "o", "    for c in cfgs:\r\n\u001b[?2004l\r"]
[570.015106, "o", "\u001b[?2004h> "]
