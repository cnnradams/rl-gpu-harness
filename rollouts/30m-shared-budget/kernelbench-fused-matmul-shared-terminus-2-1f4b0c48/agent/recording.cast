[779.448156, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\ntorch.manual_seed(42)\nM, N, K = 16384, 4096, 4096\ndev = 'cuda'\nw = torch.empty(N, K, device=dev).uniform_(-(1/K**0.5), (1/K**0.5))\nb = torch.empty(N, device=dev).uniform_(-(1/K**0.5), (1/K**0.5))\nx = torch.rand(M, K, device=dev)\ns = 1.5\nref = torch.addmm(b, x, w.t(), beta=s, alpha=s)\n\n@triton.jit\ndef k_prescale(XP, XHP, XLP, M, K, BM: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    nk = tl.cdiv(K, BK)\n    pm = pid // nk; pk = pid % nk\n    rm = pm * BM + tl.arange(0, BM)\n    rk = pk * BK + tl.arange(0, BK)\n    offs = rm[:, None] * K + rk[None, :]\n    xv = tl.load(XP + offs)\n    xh = xv.to(tl.float16)\n    xl = (xv - xh.to(tl.float32)).to(tl.float16)\n    tl.store(XHP + offs, xh)\n    tl.store(XLP + offs, xl)\n\n@triton.jit\ndef k_tma(XHP, XLP, WHP, WLP, BP, YP, M, N, K, s,\n          B"]
[779.448201, "i", "M: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    xh_desc = tl.make_tensor_descriptor(XHP, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    xl_desc = tl.make_tensor_descriptor(XLP, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    wh_desc = tl.make_tensor_descriptor(WHP, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    wl_desc = tl.make_tensor_descriptor(WLP, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    y_desc = tl.make_tensor_descriptor(YP, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GM, GM)\n    pid_m = group_id * GM + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        xh = xh_desc.load([off_m, k])\n        xl = xl_desc.load([off_m,"]
[779.448331, "i", " k])\n        wh = wh_desc.load([k, off_n])\n        wl = wl_desc.load([k, off_n])\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        acc = tl.dot(xl, wh, acc)\n    rn = off_n + tl.arange(0, BN)\n    bv = tl.load(BP + rn).to(tl.float32)\n    acc = acc * s + bv[None, :]\n    y_desc.store([off_m, off_n], acc)\n\nwt = w.t().contiguous()\nwh_c = wt.half().contiguous()\nwl_c = (wt - wh_c.float()).half().contiguous()\nbs = (b * s).contiguous()\ny = torch.empty(M, N, device=dev)\nxh_c = torch.empty(M, K, device=dev, dtype=torch.float16)\nxl_c = torch.empty(M, K, device=dev, dtype=torch.float16)\n\ndef run_tma(BM, BN, BK, GM, nw, ns):\n    pgrid = ((M // 128) * (K // 64),)\n    k_prescale[pgrid](x, xh_c, xl_c, M, K, BM=128, BK=64)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_tma[grid](xh_c, xl_c, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)\n    return y\n\ndef check(out):\n    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n    md = (ref - out).abs().m"]
[779.448344, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[779.448381, "i", "ax().item()\n    return ok, md\n\ncfgs = [\n    (128, 256, 64, 8, 8, 2),\n    (128, 256, 64, 8, 8, 3),\n    (256, 128, 64, 8, 8, 3),\n    (128, 128, 64, 8, 8, 4),\n    (128, 128, 128, 8, 8, 3),\n    (256, 128, 64, 8, 8, 2),\n    (64, 256, 64, 8, 4, 4),\n]\nfor c in cfgs:\n    try:\n        out = run_tma(*c)\n        torch.cuda.synchronize()\n        ok, md = check(out)\n        t = triton.testing.do_bench(lambda: run_tma(*c), warmup=20, rep=50)\n        print(f\"tma cfg={c} ok={ok} maxdiff={md:.2e} t={t*1000:.1f}us\", flush=True)\n    except Exception as e:\n        print(f\"tma cfg={c} FAILED {type(e).__name__}: {str(e)[:100]}\", flush=True)\nEOF\nB64=$(base64 -w0 /workspace/bench2.py); gpu exec sb-avRmQamlN1QPMHyhFtW4Da -- bash -c \"echo $B64 | base64 -d > /workspace/bench2.py && python3 /workspace/bench2.py\"\n"]
