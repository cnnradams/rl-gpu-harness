wt = w.t().contiguous()
wh_c = wt.half().contiguous()
wl_c = (wt - wh_c.float()).half().contiguous()
bs = (b * s).contiguous()
y = torch.empty(M, N, device=dev)
xh_c = torch.empty(M, K, device=dev, dtype=torch.float16)
xl_c = torch.empty(M, K, device=dev, dtype=torch.float16)

def run_tma(BM, BN, BK, GM, nw, ns):
    pgrid = ((M // 128) * (K // 64),)
    k_prescale[pgrid](x, xh_c, xl_c, M, K, BM=128, BK=64)
    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
    k_tma[grid](xh_c, xl_c, wh_c, wl_c, bs, y, M, N, K, s, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=nw, num_stages=ns)
    return y

def check(out):
    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)
    md = (ref - out).abs().max().item()
    return ok, md

cfgs = [
    (128, 256, 64, 8, 8, 2),
    (128, 256, 64, 8, 8, 3),
    (256, 128, 64, 8, 8, 3),
    (128, 128, 64, 8, 8, 4),
    (128, 128, 128, 8, 8, 3),
    (256, 128, 64, 8, 8, 2),
    (64, 256, 64, 8, 4, 4),
]
for c in cfgs:
    try:
        out = run_tma(*c)
        torch.cuda.synchronize()
        ok, md = check(out)
        t = triton.testing.do_bench(lambda: run_tma(*c), warmup=20, rep=50)
        print(f"tma cfg={c} ok={ok} maxdiff={md:.2e} t={t*1000:.1f}us", flush=True)
    except Exception as e:
        print(f"tma cfg={c} FAILED {type(e).__name__}: {str(e)[:100]}", flush=True)
