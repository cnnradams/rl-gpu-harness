[1060.97702, "o", "    t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
