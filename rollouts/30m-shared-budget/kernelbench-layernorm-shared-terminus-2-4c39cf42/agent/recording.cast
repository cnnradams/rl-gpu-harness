[583.07686, "o", "\u001b[?2004h> "]
[583.076959, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[583.077004, "o", "\u001b[?2004h> "]
[583.077121, "o", "    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\r\n\u001b[?2004l\r"]
[583.07716, "o", "\u001b[?2004h> "]
[583.077236, "o", "    mean = s/N; var = q/N - mean*mean\r\n\u001b[?2004l\r"]
[583.077276, "o", "\u001b[?2004h> "]
[583.077342, "o", "    rstd = 1.0/tl.sqrt(var+eps)\r\n\u001b[?2004l\r"]
[583.07738, "o", "\u001b[?2004h> "]
[583.077455, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[583.077494, "o", "\u001b[?2004h> "]
[583.077615, "o", "        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[583.077654, "o", "\u001b[?2004h> "]
[583.0777, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[583.077739, "o", "\u001b[?2004h> "]
[583.077789, "o", "        base = row*N+offs\r\n\u001b[?2004l\r"]
[583.077827, "o", "\u001b[?2004h> "]
[583.078017, "o", "        xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[583.078057, "o", "\u001b[?2004h> "]
[583.078168, "o", "        wv = tl.load(w_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[583.078207, "o", "\u001b[?2004h> "]
[583.078323, "o", "        bv = tl.load(b_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[583.07836, "o", "\u001b[?2004h> "]
[583.078567, "o", "        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[583.078604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[583.078642, "o", "> "]
[583.078954, "o", "for B,W in [(2048,4),(2048,8),(4096,4),(4096,8),(4096,16),(8192,8),(8192,16),(8192,32),(16384,16),(16384,32),(32768,32),(65536,32),(65536,64)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.078972, "o", "> "]
[583.079055, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.079096, "o", "> "]
[583.079319, "o", "        t = hot(lambda: _apply1[(triton.cdiv(N,B), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.07935, "o", "> "]
[583.079443, "o", "        print(f'apply1 B={B} W={W}: {t:.4f}')\r\n\u001b[?2004l\r"]
[583.07948, "o", "\u001b[?2004h> "]
[583.079538, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[583.079577, "o", "\u001b[?2004h> "]
[583.079715, "o", "        print(f'apply1 B={B} W={W}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[583.07973, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[583.079785, "o", "\u001b[?2004h> "]
[583.07984, "o", "for B,W in [(4096,8),(8192,16)]:\r\n\u001b[?2004l\r"]
[583.079884, "o", "\u001b[?2004h> "]
[583.079947, "o", "    for xe in ['','evict_first']:\r\n\u001b[?2004l\r"]
[583.079986, "o", "\u001b[?2004h> "]
[583.080071, "o", "        for oe in ['','evict_first']:\r\n\u001b[?2004l\r"]
[583.08011, "o", "\u001b[?2004h> "]
[583.080427, "o", "            t = hot(lambda: _apply2[(triton.cdiv(N,B), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, XEV=xe, OEV=oe, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.080463, "o", "> "]
