[492.639124, "o", "{\r\n  \"bytes\": 3680,\r\n  \"sha256\": \"23444e7dbf77ce34f765cd563b129ed40adcf021a3c8d3d7bf16481b73e4e7eb\"\r\n}\r\n"]
[492.656816, "o", "\u001b[?2004hroot@modal:/workspace# "]
[506.579963, "i", "gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench2.py\n"]
[506.58034, "o", "gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench2.py\r\n\u001b[?2004l\r"]
[506.699681, "o", "request ID: ffe31cf307fb411db8129209d6e9eefe\r\n"]
[507.93177, "o", "command: 329922be8cb44591bfa5671881c50193\r\n"]
[510.121004, "o", "copy B=4096 W=8: 0.2127/0.2110 ms -> 2525 GB/ms... GB/s=2524545\r\ncopy B=8192 W=16: 0.2125/0.2104 ms -> 2526 GB/ms... GB/s=2526446\r\nstats B=8192 W=16: 0.1306/0.1260 ms\r\nstats B=16384 W=16: 0.1296/0.1266 ms\r\nstats B=16384 W=32: 0.1293/0.1257 ms\r\napply B=4096 W=8: 0.3794/0.3743 ms\r\napply B=8192 W=16: 0.3812/0.3772 ms\r\nhot stats 8192/16: 0.0890675163269043\r\nhot apply 4096/8 : 0.34076030731201173\r\nhot copy 8192/16 : 0.18426176071166991\r\nhot zero acc     : 0.005111680030822754\r\ngraph cold: 0.4430/0.4414 ms\r\ngraph hot : 0.43063743591308595\r\n"]
[511.009936, "o", "\u001b[?2004hroot@modal:/workspace# "]
[583.070426, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\n\ndef hot(fn, n=50):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\n# variant 1: plain, tunable\n@triton.jit\ndef _apply1(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\n    mean = s/N; var = q/N - mean*mean\n    rstd = 1.0/tl.sqrt(var+eps)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    base = row*N+offs\n    xv = tl.load(x_ptr+base, mask=mask, other=0.)\n    wv = tl.load(w_ptr+"]
[583.070468, "i", "offs, mask=mask, other=0.)\n    bv = tl.load(b_ptr+offs, mask=mask, other=0.)\n    tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask)\n\n# variant 2: cache modifiers via extra_safe / eviction combos\n@triton.jit\ndef _apply2(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr,\n            XEV: tl.constexpr, OEV: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\n    mean = s/N; var = q/N - mean*mean\n    rstd = 1.0/tl.sqrt(var+eps)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    base = row*N+offs\n    xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy=XEV)\n    wv = tl.load(w_ptr+offs, mask=mask, other=0.)\n    bv = tl.load(b_ptr+offs, mask=mask, other=0.)\n    tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy=OEV)\n\n# variant 3: loop over multiple tiles per block\n@triton.jit\ndef _apply3(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n   "]
[583.070606, "i", " pid = tl.program_id(0); row = tl.program_id(1)\n    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\n    mean = s/N; var = q/N - mean*mean\n    rstd = 1.0/tl.sqrt(var+eps)\n    for i in tl.static_range(NLOOP):\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        base = row*N+offs\n        xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy='evict_first')\n        wv = tl.load(w_ptr+offs, mask=mask, other=0.)\n        bv = tl.load(b_ptr+offs, mask=mask, other=0.)\n        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy='evict_first')\n\nfor B,W in [(2048,4),(2048,8),(4096,4),(4096,8),(4096,16),(8192,8),(8192,16),(8192,32),(16384,16),(16384,32),(32768,32),(65536,32),(65536,64)]:\n    try:\n        t = hot(lambda: _apply1[(triton.cdiv(N,B), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, num_warps=W))\n        print(f'apply1 B={B} W={W}: {t:.4f}')\n    except Exception as ex:\n        print(f'apply1 B={B} W={W}: FAIL {type(ex).__name__}')\n\nfor B,W i"]
[583.07076, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.070836, "i", "n [(4096,8),(8192,16)]:\n    for xe in ['','evict_first']:\n        for oe in ['','evict_first']:\n            t = hot(lambda: _apply2[(triton.cdiv(N,B), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, XEV=xe, OEV=oe, num_warps=W))\n            print(f'apply2 B={B} W={W} xev={xe!r} oev={oe!r}: {t:.4f}')\n\nfor B,W,L in [(4096,8,2),(4096,8,4),(8192,16,2),(8192,16,4),(2048,4,4),(2048,4,8)]:\n    try:\n        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\n        print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\n    except Exception as ex:\n        print(f'apply3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\nEOF\ngpu push sb-ECt9w5ufzsTqZlIMce4ZU4 /workspace/bench3.py /workspace/bench3.py && gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench3.py\n"]
[583.070883, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
