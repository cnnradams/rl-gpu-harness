[755.317309, "o", "\u001b[?2004h> "]
[755.317347, "o", "        fwd()\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.317385, "o", "> "]
[755.317467, "o", "    torch.cuda.current_stream().wait_stream(s)\r\n\u001b[?2004l\r"]
[755.317506, "o", "\u001b[?2004h> "]
