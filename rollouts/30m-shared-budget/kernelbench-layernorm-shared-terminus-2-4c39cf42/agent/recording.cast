[583.075848, "o", "\u001b[?2004h> "]
[583.075952, "o", "    wv = tl.load(w_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[583.07599, "o", "\u001b[?2004h> "]
