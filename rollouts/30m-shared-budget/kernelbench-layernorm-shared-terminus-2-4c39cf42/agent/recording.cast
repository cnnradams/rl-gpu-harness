[755.317023, "o", "\u001b[?2004h> "]
[755.317169, "o", "    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r"]
[755.317219, "o", "\u001b[?2004h> "]
