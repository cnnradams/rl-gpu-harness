[583.072288, "o", "\u001b[?2004h> "]
[583.072361, "o", "    return s.elapsed_time(e)/n\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.0724, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[583.072438, "o", "> "]
[583.072475, "o", "# variant 1: plain, tunable\r\n\u001b[?2004l\r"]
[583.072513, "o", "\u001b[?2004h> "]
[583.072546, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[583.072585, "o", "\u001b[?2004h> "]
[583.072759, "o", "def _apply1(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[583.072836, "o", "\u001b[?2004h> "]
[583.072927, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[583.07296, "o", "\u001b[?2004h> "]
[583.073099, "o", "    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.073142, "o", "> "]
[583.073203, "o", "    mean = s/N; var = q/N - mean*mean\r\n\u001b[?2004l\r"]
[583.073246, "o", "\u001b[?2004h> "]
[583.073304, "o", "    rstd = 1.0/tl.sqrt(var+eps)\r\n\u001b[?2004l\r"]
[583.073343, "o", "\u001b[?2004h> "]
[583.073434, "o", "    offs = pid*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[583.073473, "o", "\u001b[?2004h> "]
[583.073511, "o", "    mask = offs < N\r\n\u001b[?2004l\r"]
[583.073536, "o", "\u001b[?2004h> "]
[583.073592, "o", "    base = row*N+offs\r\n\u001b[?2004l\r"]
[583.073631, "o", "\u001b[?2004h> "]
[583.073736, "o", "    xv = tl.load(x_ptr+base, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[583.07378, "o", "\u001b[?2004h> "]
[583.07388, "o", "    wv = tl.load(w_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[583.073919, "o", "\u001b[?2004h> "]
[583.074032, "o", "    bv = tl.load(b_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[583.074071, "o", "\u001b[?2004h> "]
[583.074194, "o", "    tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask)\r\n\u001b[?2004l\r"]
[583.074233, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[583.074271, "o", "> "]
[583.074392, "o", "# variant 2: cache modifiers via extra_safe / eviction combos\r\n\u001b[?2004l\r"]
[583.07443, "o", "\u001b[?2004h> "]
[583.074467, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[583.074667, "o", "def _apply2(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr,\r\n\u001b[?2004l\r"]
[583.074708, "o", "\u001b[?2004h> "]
[583.074811, "o", "            XEV: tl.constexpr, OEV: tl.constexpr):\r\n\u001b[?2004l\r"]
[583.07485, "o", "\u001b[?2004h> "]
[583.074958, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[583.075005, "o", "\u001b[?2004h> "]
[583.075119, "o", "    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\r\n\u001b[?2004l\r"]
[583.075157, "o", "\u001b[?2004h> "]
[583.075233, "o", "    mean = s/N; var = q/N - mean*mean\r\n\u001b[?2004l\r"]
[583.075271, "o", "\u001b[?2004h> "]
