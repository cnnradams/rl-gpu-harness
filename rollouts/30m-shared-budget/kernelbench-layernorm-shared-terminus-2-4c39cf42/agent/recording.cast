[755.315012, "o", "for B,W,L in [(1024,4,16),(1024,4,32),(2048,4,16),(2048,4,32),(4096,8,16),(4096,8,32)]:\r\n\u001b[?2004l\r"]
[755.315057, "o", "\u001b[?2004h> "]
[755.315094, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.315353, "o", "        t = hot(lambda: _stats3[(triton.cdiv(N,B*L), rows)](x, acc[0], acc[1], N, BLOCK=B, NLOOP=L, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.315387, "o", "> "]
[755.315497, "o", "        print(f'stats3 B={B} W={W} L={L}: {t:.4f}')\r\n\u001b[?2004l\r"]
