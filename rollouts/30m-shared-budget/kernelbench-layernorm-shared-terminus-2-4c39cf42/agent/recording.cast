[1229.692451, "o", "    mean = s * inv_n\r\n\u001b[?2004l\r"]
[1229.69249, "o", "\u001b[?2004h> "]
[1229.692552, "o", "    var = q * inv_n - mean * mean\r\n\u001b[?2004l\r"]
[1229.69259, "o", "\u001b[?2004h> "]
[1229.69267, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1229.692708, "o", "\u001b[?2004h> "]
[1229.692809, "o", "    base_row = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[1229.69285, "o", "\u001b[?2004h> "]
[1229.692914, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[1229.692951, "o", "\u001b[?2004h> "]
[1229.693086, "o", "        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1229.693126, "o", "\u001b[?2004h> "]
[1229.693187, "o", "        base = base_row + offs\r\n\u001b[?2004l\r"]
[1229.693225, "o", "\u001b[?2004h> "]
[1229.693366, "o", "        xv = tl.load(x_ptr + base, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1229.693404, "o", "\u001b[?2004h> "]
[1229.693475, "o", "        wv = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[1229.693514, "o", "\u001b[?2004h> "]
[1229.693584, "o", "        bv = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[1229.693624, "o", "\u001b[?2004h> "]
[1229.693842, "o", "        tl.store(o_ptr + base, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1229.693882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1229.693921, "o", "\u001b[?2004h> "]
[1229.69396, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1229.694146, "o", "def _statsD(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1229.694185, "o", "\u001b[?2004h> "]
[1229.694234, "o", "    col = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1229.694272, "o", "\u001b[?2004h> "]
[1229.694326, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1229.694366, "o", "\u001b[?2004h> "]
[1229.694438, "o", "    base_row = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[1229.694475, "o", "\u001b[?2004h> "]
[1229.69457, "o", "    s0 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1229.694607, "o", "\u001b[?2004h> "]
[1229.69471, "o", "    s1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1229.694749, "o", "\u001b[?2004h> "]
[1229.694841, "o", "    q0 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1229.694879, "o", "\u001b[?2004h> "]
[1229.694973, "o", "    q1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1229.695011, "o", "\u001b[?2004h> "]
[1229.695097, "o", "    for i in tl.static_range(NLOOP // 2):\r\n\u001b[?2004l\r"]
[1229.695136, "o", "\u001b[?2004h> "]
[1229.695282, "o", "        offs0 = (col * NLOOP + 2 * i) * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1229.69532, "o", "\u001b[?2004h> "]
[1229.695475, "o", "        offs1 = (col * NLOOP + 2 * i + 1) * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1229.695514, "o", "\u001b[?2004h> "]
[1229.695694, "o", "        v0 = tl.load(x_ptr + base_row + offs0, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1229.695732, "o", "\u001b[?2004h> "]
[1229.695895, "o", "        v1 = tl.load(x_ptr + base_row + offs1, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1229.695934, "o", "\u001b[?2004h> "]
[1229.695973, "o", "        s0 += v0\r\n\u001b[?2004l\r"]
[1229.696012, "o", "\u001b[?2004h> "]
[1229.696051, "o", "        s1 += v1\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.696088, "o", "> "]
[1229.696127, "o", "        q0 += v0 * v0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.696165, "o", "> "]
[1229.696202, "o", "        q1 += v1 * v1\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.696241, "o", "> "]
[1229.696349, "o", "    tl.atomic_add(s_ptr + row, tl.sum(s0 + s1, axis=0))\r\n\u001b[?2004l\r"]
[1229.696388, "o", "\u001b[?2004h> "]
[1229.69651, "o", "    tl.atomic_add(q_ptr + row, tl.sum(q0 + q1, axis=0))\r\n\u001b[?2004l\r"]
[1229.696548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1229.696586, "o", "\u001b[?2004h> "]
[1229.69668, "o", "print('--- persistent apply (NB*B*L=N) ---')\r\n\u001b[?2004l\r"]
[1229.696718, "o", "\u001b[?2004h> "]
[1229.697052, "o", "for NB,B,W,L in [(64,4096,8,16),(32,4096,8,32),(16,4096,8,64),(32,2048,4,64),(64,2048,4,32),(128,1024,4,32),(64,1024,4,64),(32,8192,16,16)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.697071, "o", "> "]
[1229.697122, "o", "    assert NB*B*L == N\r\n\u001b[?2004l\r"]
[1229.697161, "o", "\u001b[?2004h> "]
[1229.697411, "o", "    t = hot(lambda: _applyP[(NB, rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\r\n\u001b[?2004l\r"]
[1229.697448, "o", "\u001b[?2004h> "]
[1229.697569, "o", "    print(f'applyP NB={NB} B={B} W={W} L={L}: {t:.4f}')\r\n\u001b[?2004l\r"]
[1229.697603, "o", "\u001b[?2004h> \r\n"]
[1229.697642, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1229.697717, "o", "print('--- stats dual acc ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.697757, "o", "> "]
[1229.698031, "o", "for NB,B,W,L in [(128,4096,8,8),(64,4096,8,16),(128,2048,4,16),(256,2048,4,8),(64,2048,4,32),(128,1024,4,32),(64,1024,4,64)]:\r\n\u001b[?2004l\r"]
[1229.698069, "o", "\u001b[?2004h> "]
[1229.698108, "o", "    assert NB*B*L == N\r\n\u001b[?2004l\r"]
[1229.698148, "o", "\u001b[?2004h> "]
[1229.698361, "o", "    t = hot(lambda: _statsD[(NB, rows)](x, acc[0], acc[1], N, BLOCK=B, NLOOP=L, num_warps=W))\r\n\u001b[?2004l\r"]
[1229.698399, "o", "\u001b[?2004h> "]
[1229.698518, "o", "    print(f'statsD NB={NB} B={B} W={W} L={L}: {t:.4f}')\r\n\u001b[?2004l\r"]
[1229.698564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1229.698603, "o", "\u001b[?2004h> "]
[1229.698657, "o", "print('--- graph combos ---')\r\n\u001b[?2004l\r"]
[1229.698696, "o", "\u001b[?2004h> "]
[1229.698734, "o", "def build(SCFG, ACFG):\r\n\u001b[?2004l\r"]
[1229.698772, "o", "\u001b[?2004h> "]
[1229.698869, "o", "    SNB,SB,SW,SL = SCFG; ANB,AB,AW,AL = ACFG\r\n\u001b[?2004l\r"]
[1229.698913, "o", "\u001b[?2004h> "]
[1229.698953, "o", "    def fwd():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1229.699008, "o", "        acc.zero_()\r\n\u001b[?2004l\r"]
[1229.699047, "o", "\u001b[?2004h> "]
[1229.699238, "o", "        _statsD[(SNB, rows)](x, acc[0], acc[1], N, BLOCK=SB, NLOOP=SL, num_warps=SW)\r\n\u001b[?2004l\r"]
[1229.699275, "o", "\u001b[?2004h> "]
[1229.699495, "o", "        _applyP[(ANB, rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=AB, NLOOP=AL, num_warps=AW)\r\n\u001b[?2004l\r"]
[1229.699539, "o", "\u001b[?2004h> "]
[1229.699578, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.699617, "o", "> "]
[1229.69977, "o", "    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r"]
[1229.699815, "o", "\u001b[?2004h> "]
[1229.699865, "o", "    with torch.cuda.stream(s):\r\n\u001b[?2004l\r"]
[1229.699904, "o", "\u001b[?2004h> "]
[1229.699943, "o", "        fwd()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.699981, "o", "> "]
[1229.700065, "o", "    torch.cuda.current_stream().wait_stream(s)\r\n\u001b[?2004l\r"]
[1229.700104, "o", "\u001b[?2004h> "]
[1229.700165, "o", "    g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[1229.700203, "o", "\u001b[?2004h> "]
[1229.700263, "o", "    with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[1229.700302, "o", "\u001b[?2004h> "]
[1229.70034, "o", "        fwd()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.70038, "o", "> "]
[1229.700419, "o", "    return g\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1229.700458, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1229.700573, "o", "for SCFG in [(128,4096,8,8),(64,4096,8,16)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.700612, "o", "> "]
[1229.700746, "o", "    for ACFG in [(64,4096,8,16),(32,4096,8,32),(16,4096,8,64)]:\r\n\u001b[?2004l\r"]
[1229.700797, "o", "\u001b[?2004h> "]
[1229.700866, "o", "        g = build(SCFG, ACFG)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1229.700908, "o", "> "]
[1229.700992, "o", "        med, mn = time_cold(lambda: g.replay())\r\n\u001b[?2004l\r"]
[1229.701028, "o", "\u001b[?2004h> "]
[1229.701254, "o", "        print(f'graph S={SCFG} A={ACFG}: cold {med:.4f}/{mn:.4f} hot {hot(lambda: g.replay()):.4f}')\r\n\u001b[?2004l\r"]
[1229.70129, "o", "\u001b[?2004h> "]
[1229.701329, "o", "EOF\r\n\u001b[?2004l\r"]
[1229.706561, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1229.706893, "o", "gpu push sb-ECt9w5ufzsTqZlIMce4ZU4 /workspace/bench7b.py /workspace/bench7b.py && gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench7b.py\r\n\u001b[?2004l\r"]
[1230.772866, "o", "{\r\n  \"bytes\": 4284,\r\n  \"sha256\": \"c4411bcaf235eddd2197b79074040544f8528e027188303f142cfc9fe5953b10\"\r\n}\r\n"]
[1230.912171, "o", "request ID: 24ed49e3ae554c678e57c5ce520daff7\r\n"]
[1232.387263, "o", "command: 62e57ff15b914b8c9979310697dbf12d\r\n"]
[1259.235171, "o", "--- persistent apply (NB*B*L=N) ---\r\napplyP NB=64 B=4096 W=8 L=16: 0.2374\r\napplyP NB=32 B=4096 W=8 L=32: 0.2144\r\napplyP NB=16 B=4096 W=8 L=64: 0.2171\r\napplyP NB=32 B=2048 W=4 L=64: 0.2272\r\napplyP NB=64 B=2048 W=4 L=32: 0.2147\r\napplyP NB=128 B=1024 W=4 L=32: 0.2268\r\napplyP NB=64 B=1024 W=4 L=64: 0.2132\r\napplyP NB=32 B=8192 W=16 L=16: 0.2493\r\n--- stats dual acc ---\r\nstatsD NB=128 B=4096 W=8 L=8: 0.0959\r\nstatsD NB=64 B=4096 W=8 L=16: 0.0910\r\nstatsD NB=128 B=2048 W=4 L=16: 0.0911\r\nstatsD NB=256 B=2048 W=4 L=8: 0.0907\r\nstatsD NB=64 B=2048 W=4 L=32: 0.0920\r\nstatsD NB=128 B=1024 W=4 L=32: 0.0922\r\nstatsD NB=64 B=1024 W=4 L=64: 0.0911\r\n--- graph combos ---\r\ngraph S=(128, 4096, 8, 8) A=(64, 4096, 8, 16): cold 0.3356/0.3293 hot 0.3321\r\ngraph S=(128, 4096, 8, 8) A=(32, 4096, 8, 32): cold 0.3180/0.3159 hot 0.3128\r\ngraph S=(128, 4096, 8, 8) A=(16, 4096, 8, 64): cold 0.3224/0.3203 hot 0.3164\r\ngraph S=(64, 4096, 8, 16) A=(64, 4096, 8, 16): cold 0.3356/0.3299 hot 0.3303\r\ngraph S=(64, 4096, 8, 16) A=(32, 4096, 8, 32): cold 0.3"]
[1259.235225, "o", "167/0.3140 hot 0.3111\r\ngraph S=(64, 4096, 8, 16) A=(16, 4096, 8, 64): cold 0.3201/0.3164 hot 0.3142\r\n"]
[1260.118699, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1390.222131, "i", "cat > /workspace/bench8.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\n\ndef hot(fn, n=60):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\ndef clear_l2():\n    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\n\ndef time_cold(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.ap"]
[1390.222175, "i", "pend(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _applySR(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps,\n             BLOCK: tl.constexpr, NLOOP: tl.constexpr, R: tl.constexpr):\n    col = tl.program_id(0)\n    rowg = tl.program_id(1)\n    r0 = rowg * R\n    inv_n = 1.0 / N\n    for i in tl.static_range(NLOOP):\n        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\n        wv = tl.load(w_ptr + offs)\n        bv = tl.load(b_ptr + offs)\n        for r in tl.static_range(R):\n            row = r0 + r\n            s = tl.load(s_ptr + row)\n            q = tl.load(q_ptr + row)\n            mean = s * inv_n\n            var = q * inv_n - mean * mean\n            rstd = 1.0 / tl.sqrt(var + eps)\n            base = row.to(tl.int64) * N + offs\n            xv = tl.load(x_ptr + base, eviction_policy='evict_first')\n            tl.store(o_ptr + base, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\n\n@triton.jit\ndef _statsD(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl."]
[1390.222189, "i", "constexpr):\n    col = tl.program_id(0)\n    row = tl.program_id(1)\n    base_row = row.to(tl.int64) * N\n    s0 = tl.zeros([BLOCK], dtype=tl.float32)\n    q0 = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in tl.static_range(NLOOP):\n        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base_row + offs, eviction_policy='evict_first')\n        s0 += v\n        q0 += v * v\n    tl.atomic_add(s_ptr + row, tl.sum(s0, axis=0))\n    tl.atomic_add(q_ptr + row, tl.sum(q0, axis=0))\n\nprint('--- applySR sweep ---')\nfor B,W,L,R in [(1024,4,16,4),(1024,4,8,8),(1024,4,32,4),(2048,4,16,4),(2048,8,16,4),(1024,4,16,8),(2048,4,8,8),(4096,8,16,2),(1024,4,8,16),(2048,4,32,2),(512,4,32,4),(1024,2,16,8)]:\n    nb = N//(B*L)\n    t = hot(lambda: _applySR[(nb, rows//R)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, R=R, num_warps=W))\n    print(f'applySR B={B} W={W} L={L} R={R}: {t:.4f} (blocks={nb*rows//R})')\n\nprint('--- graph combos ---')\ndef build(SCFG, ACFG):\n    SNB,SB,SW,SL = SCFG\n    AB,AW,"]
[1390.222199, "i", "AL,R = ACFG\n    anb = N//(AB*AL)\n    def fwd():\n        acc.zero_()\n        _statsD[(SNB, rows)](x, acc[0], acc[1], N, BLOCK=SB, NLOOP=SL, num_warps=SW)\n        _applySR[(anb, rows//R)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=AB, NLOOP=AL, R=R, num_warps=AW)\n        return out\n    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\n    with torch.cuda.stream(s):\n        fwd()\n    torch.cuda.current_stream().wait_stream(s)\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        fwd()\n    return g\n\nfor SCFG in [(128,4096,8,8)]:\n    for ACFG in [(1024,4,16,4),(1024,4,8,8),(2048,4,16,4),(1024,4,16,8)]:\n        g = build(SCFG, ACFG)\n        med, mn = time_cold(lambda: g.replay())\n        print(f'graph S={SCFG} A={ACFG}: cold {med:.4f}/{mn:.4f} hot {hot(lambda: g.replay()):.4f}')\nEOF\ngpu push sb-ECt9w5ufzsTqZlIMce4ZU4 /workspace/bench8.py /workspace/bench8.py && gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench8.py\n"]
[1390.222403, "o", "cat > /workspace/bench8.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1390.222534, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1390.222675, "o", "x = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r"]
[1390.2227, "o", "\u001b[?2004h> "]
[1390.222756, "o", "N = 64*256*256; rows = 16\r\n\u001b[?2004l\r"]
[1390.222783, "o", "\u001b[?2004h> "]
[1390.222939, "o", "w = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[1390.222967, "o", "\u001b[?2004h> "]
[1390.223016, "o", "out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1390.223045, "o", "\u001b[?2004h> "]
[1390.223136, "o", "acc = torch.zeros(2, rows, device='cuda')\r\n\u001b[?2004l\r"]
[1390.223163, "o", "\u001b[?2004h> "]
[1390.223184, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1390.223248, "o", "def hot(fn, n=60):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.223279, "o", "> "]
[1390.223326, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1390.223345, "o", "\u001b[?2004h"]
[1390.223367, "o", "> "]
[1390.223432, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1390.22345, "o", "\u001b[?2004h> "]
[1390.223662, "o", "    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.223693, "o", "> "]
[1390.223713, "o", "    s.record()\r\n\u001b[?2004l\r"]
[1390.223744, "o", "\u001b[?2004h> "]
[1390.223813, "o", "    for _ in range(n): fn()\r\n\u001b[?2004l\r"]
[1390.22383, "o", "\u001b[?2004h> "]
[1390.223938, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1390.223959, "o", "\u001b[?2004h> "]
[1390.224036, "o", "    return s.elapsed_time(e)/n\r\n\u001b[?2004l\r"]
[1390.224063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1390.224093, "o", "\u001b[?2004h> "]
[1390.224132, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[1390.224162, "o", "\u001b[?2004h> "]
[1390.224376, "o", "    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\r\n\u001b[?2004l\r"]
[1390.224404, "o", "\u001b[?2004h> \r\n"]
[1390.224419, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1390.224484, "o", "def time_cold(fn, n=15):\r\n\u001b[?2004l\r"]
[1390.224504, "o", "\u001b[?2004h"]
[1390.224527, "o", "> "]
[1390.224591, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1390.224611, "o", "\u001b[?2004h> "]
[1390.224688, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1390.224714, "o", "\u001b[?2004h> "]
[1390.224742, "o", "    ts=[]\r\n\u001b[?2004l\r"]
[1390.224782, "o", "\u001b[?2004h> "]
[1390.224854, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1390.224879, "o", "\u001b[?2004h> "]
[1390.22507, "o", "        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1390.225101, "o", "\u001b[?2004h> "]
[1390.225296, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1390.225321, "o", "\u001b[?2004h> "]
[1390.225465, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1390.225486, "o", "\u001b[?2004h> "]
[1390.22558, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1390.225613, "o", "\u001b[?2004h> "]
[1390.225717, "o", "    ts.sort(); return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[1390.225737, "o", "\u001b[?2004h> \r\n"]
[1390.225769, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1390.22579, "o", "> "]
[1390.225816, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1390.225839, "o", "\u001b[?2004h> "]
[1390.225978, "o", "def _applySR(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps,\r\n\u001b[?2004l\r"]
[1390.226005, "o", "\u001b[?2004h> "]
[1390.226173, "o", "             BLOCK: tl.constexpr, NLOOP: tl.constexpr, R: tl.constexpr):\r\n\u001b[?2004l\r"]
[1390.226192, "o", "\u001b[?2004h> "]
[1390.226264, "o", "    col = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1390.22629, "o", "\u001b[?2004h> "]
[1390.226356, "o", "    rowg = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1390.226383, "o", "\u001b[?2004h> "]
[1390.226427, "o", "    r0 = rowg * R\r\n\u001b[?2004l\r"]
[1390.226456, "o", "\u001b[?2004h> "]
[1390.226501, "o", "    inv_n = 1.0 / N\r\n\u001b[?2004l\r"]
[1390.226528, "o", "\u001b[?2004h> "]
[1390.22662, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[1390.22665, "o", "\u001b[?2004h> "]
[1390.226794, "o", "        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1390.226821, "o", "\u001b[?2004h> "]
[1390.226901, "o", "        wv = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[1390.226922, "o", "\u001b[?2004h> "]
[1390.22701, "o", "        bv = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[1390.227037, "o", "\u001b[?2004h> "]
[1390.227123, "o", "        for r in tl.static_range(R):\r\n\u001b[?2004l\r"]
[1390.227149, "o", "\u001b[?2004h> "]
[1390.227209, "o", "            row = r0 + r\r\n\u001b[?2004l\r"]
[1390.22723, "o", "\u001b[?2004h> "]
[1390.227322, "o", "            s = tl.load(s_ptr + row)\r\n\u001b[?2004l\r"]
[1390.227352, "o", "\u001b[?2004h> "]
[1390.227435, "o", "            q = tl.load(q_ptr + row)\r\n\u001b[?2004l\r"]
[1390.227461, "o", "\u001b[?2004h> "]
[1390.227529, "o", "            mean = s * inv_n\r\n\u001b[?2004l\r"]
[1390.227549, "o", "\u001b[?2004h> "]
[1390.227663, "o", "            var = q * inv_n - mean * mean\r\n\u001b[?2004l\r"]
[1390.227689, "o", "\u001b[?2004h> "]
[1390.227791, "o", "            rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1390.227817, "o", "\u001b[?2004h> "]
[1390.227934, "o", "            base = row.to(tl.int64) * N + offs\r\n\u001b[?2004l\r"]
[1390.227965, "o", "\u001b[?2004h> "]
[1390.228122, "o", "            xv = tl.load(x_ptr + base, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1390.228149, "o", "\u001b[?2004h> "]
[1390.228372, "o", "            tl.store(o_ptr + base, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1390.228396, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1390.228416, "o", "\u001b[?2004h"]
[1390.228436, "o", "> "]
[1390.228456, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1390.228476, "o", "\u001b[?2004h> "]
[1390.228676, "o", "def _statsD(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1390.228705, "o", "\u001b[?2004h> "]
[1390.228778, "o", "    col = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1390.228806, "o", "\u001b[?2004h> "]
[1390.228866, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1390.228893, "o", "\u001b[?2004h> "]
[1390.228977, "o", "    base_row = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[1390.228997, "o", "\u001b[?2004h> "]
[1390.229109, "o", "    s0 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1390.229135, "o", "\u001b[?2004h> "]
[1390.229239, "o", "    q0 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1390.229266, "o", "\u001b[?2004h> "]
[1390.229352, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[1390.229379, "o", "\u001b[?2004h> "]
[1390.229523, "o", "        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1390.229553, "o", "\u001b[?2004h> "]
[1390.229731, "o", "        v = tl.load(x_ptr + base_row + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1390.229762, "o", "\u001b[?2004h> "]
[1390.229795, "o", "        s0 += v\r\n\u001b[?2004l\r"]
[1390.229822, "o", "\u001b[?2004h> "]
[1390.229871, "o", "        q0 += v * v\r\n\u001b[?2004l\r"]
[1390.229897, "o", "\u001b[?2004h> "]
[1390.230015, "o", "    tl.atomic_add(s_ptr + row, tl.sum(s0, axis=0))\r\n\u001b[?2004l\r"]
[1390.230045, "o", "\u001b[?2004h> "]
[1390.230159, "o", "    tl.atomic_add(q_ptr + row, tl.sum(q0, axis=0))\r\n\u001b[?2004l\r"]
[1390.230186, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1390.230207, "o", "\u001b[?2004h> "]
[1390.230289, "o", "print('--- applySR sweep ---')\r\n\u001b[?2004l\r"]
[1390.230318, "o", "\u001b[?2004h> "]
[1390.230742, "o", "for B,W,L,R in [(1024,4,16,4),(1024,4,8,8),(1024,4,32,4),(2048,4,16,4),(2048,8,16,4),(1024,4,16,8),(2048,4,8,8),(4096,8,16,2),(1024,4,8,16),(2048,4,32,2),(512,4,32,4),(1024,2,16,8)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.230773, "o", "> "]
[1390.230803, "o", "    nb = N//(B*L)\r\n\u001b[?2004l\r"]
[1390.23083, "o", "\u001b[?2004h> "]
[1390.231103, "o", "    t = hot(lambda: _applySR[(nb, rows//R)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, R=R, num_warps=W))\r\n\u001b[?2004l\r"]
[1390.231127, "o", "\u001b[?2004h> "]
[1390.231303, "o", "    print(f'applySR B={B} W={W} L={L} R={R}: {t:.4f} (blocks={nb*rows//R})')\r\n\u001b[?2004l\r"]
[1390.231334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1390.231356, "o", "\u001b[?2004h> "]
[1390.23142, "o", "print('--- graph combos ---')\r\n\u001b[?2004l\r"]
[1390.231441, "o", "\u001b[?2004h> "]
[1390.231497, "o", "def build(SCFG, ACFG):\r\n\u001b[?2004l\r"]
[1390.231523, "o", "\u001b[?2004h> "]
[1390.231575, "o", "    SNB,SB,SW,SL = SCFG\r\n\u001b[?2004l\r"]
[1390.231603, "o", "\u001b[?2004h> "]
[1390.231667, "o", "    AB,AW,AL,R = ACFG\r\n\u001b[?2004l\r"]
[1390.231688, "o", "\u001b[?2004h> "]
[1390.231744, "o", "    anb = N//(AB*AL)\r\n\u001b[?2004l\r"]
[1390.231771, "o", "\u001b[?2004h> "]
[1390.231807, "o", "    def fwd():\r\n\u001b[?2004l\r"]
[1390.231834, "o", "\u001b[?2004h> "]
[1390.231883, "o", "        acc.zero_()\r\n\u001b[?2004l\r"]
[1390.231909, "o", "\u001b[?2004h> "]
[1390.232115, "o", "        _statsD[(SNB, rows)](x, acc[0], acc[1], N, BLOCK=SB, NLOOP=SL, num_warps=SW)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.232144, "o", "> "]
[1390.232393, "o", "        _applySR[(anb, rows//R)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=AB, NLOOP=AL, R=R, num_warps=AW)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.232423, "o", "> "]
[1390.232458, "o", "        return out\r\n\u001b[?2004l\r"]
[1390.232485, "o", "\u001b[?2004h> "]
[1390.232665, "o", "    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.232686, "o", "> "]
[1390.232756, "o", "    with torch.cuda.stream(s):\r\n\u001b[?2004l\r"]
[1390.232787, "o", "\u001b[?2004h> "]
[1390.232826, "o", "        fwd()\r\n\u001b[?2004l\r"]
[1390.232845, "o", "\u001b[?2004h> "]
[1390.232961, "o", "    torch.cuda.current_stream().wait_stream(s)\r\n\u001b[?2004l\r"]
[1390.232983, "o", "\u001b[?2004h> "]
[1390.233062, "o", "    g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[1390.233089, "o", "\u001b[?2004h> "]
[1390.233159, "o", "    with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[1390.233179, "o", "\u001b[?2004h> "]
[1390.233221, "o", "        fwd()\r\n\u001b[?2004l\r"]
[1390.233247, "o", "\u001b[?2004h> "]
[1390.233279, "o", "    return g\r\n\u001b[?2004l\r"]
[1390.233299, "o", "\u001b[?2004h> \r\n"]
[1390.233329, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1390.233351, "o", "> "]
[1390.233405, "o", "for SCFG in [(128,4096,8,8)]:\r\n\u001b[?2004l\r"]
[1390.233432, "o", "\u001b[?2004h> "]
[1390.233604, "o", "    for ACFG in [(1024,4,16,4),(1024,4,8,8),(2048,4,16,4),(1024,4,16,8)]:\r\n\u001b[?2004l\r"]
[1390.233634, "o", "\u001b[?2004h> "]
[1390.233694, "o", "        g = build(SCFG, ACFG)\r\n\u001b[?2004l\r"]
[1390.233719, "o", "\u001b[?2004h> "]
[1390.233831, "o", "        med, mn = time_cold(lambda: g.replay())\r\n\u001b[?2004l\r"]
[1390.233857, "o", "\u001b[?2004h> "]
[1390.234091, "o", "        print(f'graph S={SCFG} A={ACFG}: cold {med:.4f}/{mn:.4f} hot {hot(lambda: g.replay()):.4f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1390.234119, "o", "> EOF\r\n\u001b[?2004l\r"]
[1390.239228, "o", "\u001b[?2004hroot@modal:/workspace# "]
