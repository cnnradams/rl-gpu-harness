[659.332085, "o", "def _apply3(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr, NLOOP: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.332127, "o", "> "]
[659.332221, "o", "            XEV: tl.constexpr, OEV: tl.constexpr):\r\n\u001b[?2004l\r"]
[659.332257, "o", "\u001b[?2004h> "]
[659.332361, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[659.332405, "o", "\u001b[?2004h> "]
[659.332516, "o", "    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\r\n\u001b[?2004l\r"]
[659.332531, "o", "\u001b[?2004h"]
[659.332556, "o", "> "]
[659.332627, "o", "    mean = s/N; var = q/N - mean*mean\r\n\u001b[?2004l\r"]
[659.332664, "o", "\u001b[?2004h> "]
[659.332728, "o", "    rstd = 1.0/tl.sqrt(var+eps)\r\n\u001b[?2004l\r"]
[659.332786, "o", "\u001b[?2004h> "]
[659.332909, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[659.333021, "o", "        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[659.333061, "o", "\u001b[?2004h"]
[659.333099, "o", ">         mask = offs < N\r\n\u001b[?2004l\r"]
[659.333132, "o", "\u001b[?2004h> "]
[659.333191, "o", "        base = row*N+offs\r\n\u001b[?2004l\r"]
[659.33323, "o", "\u001b[?2004h"]
[659.333266, "o", "> "]
[659.333385, "o", "        xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy=XEV)\r\n\u001b[?2004l\r"]
[659.333421, "o", "\u001b[?2004h> "]
[659.333536, "o", "        wv = tl.load(w_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[659.333551, "o", "\u001b[?2004h"]
[659.33359, "o", "> "]
[659.333688, "o", "        bv = tl.load(b_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[659.333726, "o", "\u001b[?2004h> "]
[659.333911, "o", "        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy=OEV)\r\n\u001b[?2004l\r"]
[659.333964, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[659.334001, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[659.334038, "o", "\u001b[?2004h> "]
[659.334292, "o", "def _copy3(x_ptr, o_ptr, TOT, BLOCK: tl.constexpr, NLOOP: tl.constexpr, XEV: tl.constexpr, OEV: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.33433, "o", "> "]
[659.334373, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[659.334411, "o", "\u001b[?2004h> "]
[659.334487, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[659.334523, "o", "\u001b[?2004h> "]
[659.334643, "o", "        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[659.334676, "o", "\u001b[?2004h"]
[659.334708, "o", "> "]
[659.334745, "o", "        mask = offs < TOT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[659.334931, "o", "        v = tl.load(x_ptr+offs, mask=mask, other=0., eviction_policy=XEV)\r\n\u001b[?2004l\r"]
[659.33498, "o", "\u001b[?2004h> "]
[659.335104, "o", "        tl.store(o_ptr+offs, v, mask=mask, eviction_policy=OEV)\r\n\u001b[?2004l\r"]
[659.335142, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[659.335179, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[659.335213, "o", "\u001b[?2004h> "]
[659.335436, "o", "def _stats3(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr, XEV: tl.constexpr):\r\n\u001b[?2004l\r"]
[659.335476, "o", "\u001b[?2004h> "]
[659.335577, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[659.335614, "o", "\u001b[?2004h> "]
[659.335708, "o", "    sacc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[659.335744, "o", "\u001b[?2004h> "]
[659.335841, "o", "    qacc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[659.335879, "o", "\u001b[?2004h> "]
[659.335951, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[659.335996, "o", "\u001b[?2004h> "]
[659.336117, "o", "        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[659.33616, "o", "\u001b[?2004h> "]
[659.336197, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[659.336235, "o", "\u001b[?2004h> "]
[659.336407, "o", "        v = tl.load(x_ptr+row*N+offs, mask=mask, other=0., eviction_policy=XEV)\r\n\u001b[?2004l\r"]
[659.336445, "o", "\u001b[?2004h> "]
[659.336481, "o", "        sacc += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.336518, "o", "> "]
[659.336559, "o", "        qacc += v*v\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.336596, "o", "> "]
[659.336686, "o", "    tl.atomic_add(s_ptr+row, tl.sum(sacc, axis=0))\r\n\u001b[?2004l\r"]
[659.336712, "o", "\u001b[?2004h> "]
[659.336849, "o", "    tl.atomic_add(q_ptr+row, tl.sum(qacc, axis=0))\r\n\u001b[?2004l\r"]
[659.336887, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[659.336969, "o", "print('--- copy3 sweep ---')\r\n\u001b[?2004l\r"]
[659.337007, "o", "\u001b[?2004h> "]
[659.337248, "o", "for B,W,L in [(2048,4,4),(2048,4,8),(2048,4,16),(4096,8,4),(4096,8,8),(1024,4,8),(1024,4,16),(8192,16,4)]:\r\n\u001b[?2004l\r"]
[659.337263, "o", "\u001b[?2004h> "]
[659.337307, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.337345, "o", "> "]
[659.337663, "o", "        t = hot(lambda: _copy3[(triton.cdiv(TOT,B*L),)](x, out, TOT, BLOCK=B, NLOOP=L, XEV='evict_first', OEV='evict_first', num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[659.337845, "o", "        print(f'copy3 B={B} W={W} L={L}: {t:.4f} ({536.9/t:.0f} GB/s eff)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.337884, "o", "> "]
[659.337928, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[659.337973, "o", "\u001b[?2004h> "]
[659.338123, "o", "        print(f'copy3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[659.338154, "o", "\u001b[?2004h> \r\n"]
[659.338194, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[659.338247, "o", "print('--- apply3 sweep ---')\r\n\u001b[?2004l\r"]
[659.338284, "o", "\u001b[?2004h> "]
[659.338609, "o", "for B,W,L in [(1024,4,8),(1024,4,16),(1024,4,32),(2048,4,8),(2048,4,16),(2048,4,32),(2048,8,8),(2048,8,16),(4096,8,8),(4096,8,16),(4096,16,8)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.338642, "o", "> "]
[659.338678, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[659.339069, "o", "        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, XEV='evict_first', OEV='evict_first', num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.339101, "o", "> "]
[659.339213, "o", "        print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.339228, "o", "> "]
[659.339295, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[659.339334, "o", "\u001b[?2004h> "]
[659.339489, "o", "        print(f'apply3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[659.339505, "o", "> \r\n\u001b[?2004l\r"]
[659.33954, "o", "\u001b[?2004h> "]
[659.339635, "o", "print('--- apply3 ev combos best cfg ---')\r\n\u001b[?2004l\r"]
[659.339672, "o", "\u001b[?2004h> "]
[659.339878, "o", "for xe,oe in [('',''),('evict_first',''),('','evict_first'),('evict_first','evict_first')]:\r\n\u001b[?2004l\r"]
[659.339916, "o", "\u001b[?2004h> "]
[659.340248, "o", "    t = hot(lambda: _apply3[(triton.cdiv(N,2048*8), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=2048, NLOOP=8, XEV=xe, OEV=oe, num_warps=4))\r\n\u001b[?2004l\r\u001b[?2004h"]
