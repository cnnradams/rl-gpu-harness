[257.076846, "o", "max diff vs eager: 7.748603820800781e-06\r\nallclose: True\r\neager LN: med 8.1259 ms  min 8.1150 ms\r\ncustom  : med 0.5004 ms  min 0.4913 ms\r\nB1=4096 W1=8 B2=4096 W2=8: med 0.4853 min 0.4788\r\nB1=4096 W1=8 B2=8192 W2=16: med 0.4860 min 0.4790\r\nB1=4096 W1=8 B2=16384 W2=16: med 0.5050 min 0.4986\r\nB1=4096 W1=8 B2=16384 W2=32: med 0.4906 min 0.4856\r\nB1=8192 W1=8 B2=4096 W2=8: med 0.4829 min 0.4767\r\nB1=8192 W1=8 B2=8192 W2=16: med 0.4853 min 0.4776\r\nB1=8192 W1=8 B2=16384 W2=16: med 0.5044 min 0.5002\r\nB1=8192 W1=8 B2=16384 W2=32: med 0.4866 min 0.4809\r\nB1=8192 W1=16 B2=4096 W2=8: med 0.4804 min 0.4748\r\nB1=8192 W1=16 B2=8192 W2=16: med 0.4821 min 0.4780\r\nB1=8192 W1=16 B2=16384 W2=16: med 0.5031 min 0.4996\r\nB1=8192 W1=16 B2=16384 W2=32: med 0.4860 min 0.4797\r\nB1=16384 W1=16 B2=4096 W2=8: med 0.4828 min 0.4778\r\nB1=16384 W1=16 B2=8192 W2=16: med 0.4846 min 0.4790\r\nB1=16384 W1=16 B2=16384 W2=16: med 0.5050 min 0.4968\r\nB1=16384 W1=16 B2=16384 W2=32: med 0.4859 min 0.4811\r\nB1=16384 W1=32 B2=4096 W2=8: med 0.4834 min 0.4798\r\nB1"]
[257.07691, "o", "=16384 W1=32 B2=8192 W2=16: med 0.4828 min 0.4767\r\nB1=16384 W1=32 B2=16384 W2=16: med 0.5011 min 0.4965\r\nB1=16384 W1=32 B2=16384 W2=32: med 0.4845 min 0.4781\r\nB1=32768 W1=32 B2=4096 W2=8: med 0.4834 min 0.4781\r\nB1=32768 W1=32 B2=8192 W2=16: med 0.4861 min 0.4790\r\nB1=32768 W1=32 B2=16384 W2=16: med 0.5046 min 0.5008\r\nB1=32768 W1=32 B2=16384 W2=32: med 0.4868 min 0.4798\r\n"]
