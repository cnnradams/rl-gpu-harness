[1229.687099, "i", "cat > /workspace/bench7b.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\n\ndef hot(fn, n=60):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\ndef clear_l2():\n    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\n\ndef time_cold(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.a"]
[1229.687149, "i", "ppend(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _applyP(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps,\n            BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n    col = tl.program_id(0)\n    row = tl.program_id(1)\n    s = tl.load(s_ptr + row)\n    q = tl.load(q_ptr + row)\n    inv_n = 1.0 / N\n    mean = s * inv_n\n    var = q * inv_n - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base_row = row.to(tl.int64) * N\n    for i in tl.static_range(NLOOP):\n        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\n        base = base_row + offs\n        xv = tl.load(x_ptr + base, eviction_policy='evict_first')\n        wv = tl.load(w_ptr + offs)\n        bv = tl.load(b_ptr + offs)\n        tl.store(o_ptr + base, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\n\n@triton.jit\ndef _statsD(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n    col = tl.program_id(0)\n    row = tl.program_id(1)\n    base_row = row.to(tl.int64) * N\n    s0 = tl.zeros([BLOCK]"]
[1229.687164, "i", ", dtype=tl.float32)\n    s1 = tl.zeros([BLOCK], dtype=tl.float32)\n    q0 = tl.zeros([BLOCK], dtype=tl.float32)\n    q1 = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in tl.static_range(NLOOP // 2):\n        offs0 = (col * NLOOP + 2 * i) * BLOCK + tl.arange(0, BLOCK)\n        offs1 = (col * NLOOP + 2 * i + 1) * BLOCK + tl.arange(0, BLOCK)\n        v0 = tl.load(x_ptr + base_row + offs0, eviction_policy='evict_first')\n        v1 = tl.load(x_ptr + base_row + offs1, eviction_policy='evict_first')\n        s0 += v0\n        s1 += v1\n        q0 += v0 * v0\n        q1 += v1 * v1\n    tl.atomic_add(s_ptr + row, tl.sum(s0 + s1, axis=0))\n    tl.atomic_add(q_ptr + row, tl.sum(q0 + q1, axis=0))\n\nprint('--- persistent apply (NB*B*L=N) ---')\nfor NB,B,W,L in [(64,4096,8,16),(32,4096,8,32),(16,4096,8,64),(32,2048,4,64),(64,2048,4,32),(128,1024,4,32),(64,1024,4,64),(32,8192,16,16)]:\n    assert NB*B*L == N\n    t = hot(lambda: _applyP[(NB, rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\n    print(f'applyP N"]
[1229.687178, "i", "B={NB} B={B} W={W} L={L}: {t:.4f}')\n\nprint('--- stats dual acc ---')\nfor NB,B,W,L in [(128,4096,8,8),(64,4096,8,16),(128,2048,4,16),(256,2048,4,8),(64,2048,4,32),(128,1024,4,32),(64,1024,4,64)]:\n    assert NB*B*L == N\n    t = hot(lambda: _statsD[(NB, rows)](x, acc[0], acc[1], N, BLOCK=B, NLOOP=L, num_warps=W))\n    print(f'statsD NB={NB} B={B} W={W} L={L}: {t:.4f}')\n\nprint('--- graph combos ---')\ndef build(SCFG, ACFG):\n    SNB,SB,SW,SL = SCFG; ANB,AB,AW,AL = ACFG\n    def fwd():\n        acc.zero_()\n        _statsD[(SNB, rows)](x, acc[0], acc[1], N, BLOCK=SB, NLOOP=SL, num_warps=SW)\n        _applyP[(ANB, rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=AB, NLOOP=AL, num_warps=AW)\n        return out\n    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\n    with torch.cuda.stream(s):\n        fwd()\n    torch.cuda.current_stream().wait_stream(s)\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        fwd()\n    return g\n\nfor SCFG in [(128,4096,8,8),(64,4096,8,16)]:\n    for ACFG in [("]
[1229.687187, "i", "64,4096,8,16),(32,4096,8,32),(16,4096,8,64)]:\n        g = build(SCFG, ACFG)\n        med, mn = time_cold(lambda: g.replay())\n        print(f'graph S={SCFG} A={ACFG}: cold {med:.4f}/{mn:.4f} hot {hot(lambda: g.replay()):.4f}')\nEOF\ngpu push sb-ECt9w5ufzsTqZlIMce4ZU4 /workspace/bench7b.py /workspace/bench7b.py && gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench7b.py\n"]
