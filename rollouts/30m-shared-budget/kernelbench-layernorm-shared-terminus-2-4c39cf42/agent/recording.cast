[398.957245, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\n\n@triton.jit\ndef _copy(x_ptr, o_ptr, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    v = tl.load(x_ptr+offs, mask=mask, eviction_policy='evict_first')\n    tl.store(o_ptr+offs, v, mask=mask, eviction_policy='evict_first')\n\nfrom solution import _ln_stats_kernel, _ln_apply_kernel\n\ndef clear_l2():\n    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\n\ndef time_cold(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n  "]
[398.957293, "i", "      s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2], ts[0]\n\nTOT = x.numel()\nfor B,W in [(4096,8),(8192,16)]:\n    med,mn = time_cold(lambda: _copy[(triton.cdiv(TOT,B),)](x, out, TOT, BLOCK=B, num_warps=W))\n    print(f'copy B={B} W={W}: {med:.4f}/{mn:.4f} ms -> {536.9/med:.0f} GB/ms... GB/s={536.9/med*1000:.0f}')\n\nfor B,W in [(8192,16),(16384,16),(16384,32)]:\n    def f():\n        acc.zero_()\n        _ln_stats_kernel[(triton.cdiv(N,B), rows)](x, acc[0], acc[1], N, BLOCK_N=B, num_warps=W)\n    med,mn = time_cold(f)\n    print(f'stats B={B} W={W}: {med:.4f}/{mn:.4f} ms')\n\nfor B,W in [(4096,8),(8192,16)]:\n    def f2():\n        _ln_apply_kernel[(triton.cdiv(N,B), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=B, num_warps=W)\n    med,mn = time_cold(f2)\n    print(f'apply B={B} W={W}: {med:.4f}/{mn:.4f} ms')\n\n# hot loop: 50 launches back to back to get pure GPU kernel times\ndef hot(fn, n=50):\n    for _ in range(3): fn()\n    torch.cu"]
[398.957303, "i", "da.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\nprint('hot stats 8192/16:', hot(lambda: _ln_stats_kernel[(triton.cdiv(N,8192), rows)](x, acc[0], acc[1], N, BLOCK_N=8192, num_warps=16)))\nprint('hot apply 4096/8 :', hot(lambda: _ln_apply_kernel[(triton.cdiv(N,4096), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=4096, num_warps=8)))\nprint('hot copy 8192/16 :', hot(lambda: _copy[(triton.cdiv(TOT,8192),)](x, out, TOT, BLOCK=8192, num_warps=16)))\nprint('hot zero acc     :', hot(lambda: acc.zero_()))\n\n# CUDA graph full forward\ndef make_graph():\n    g = torch.cuda.CUDAGraph()\n    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\n    with torch.cuda.stream(s):\n        acc.zero_()\n        _ln_stats_kernel[(triton.cdiv(N,8192), rows)](x, acc[0], acc[1], N, BLOCK_N=8192, num_warps=16)\n        _ln_apply_kernel[(triton.cdiv(N,4096),"]
[398.957472, "i", " rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=4096, num_warps=8)\n    torch.cuda.current_stream().wait_stream(s)\n    with torch.cuda.graph(g):\n        acc.zero_()\n        _ln_stats_kernel[(triton.cdiv(N,8192), rows)](x, acc[0], acc[1], N, BLOCK_N=8192, num_warps=16)\n        _ln_apply_kernel[(triton.cdiv(N,4096), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=4096, num_warps=8)\n    return g\n\ntry:\n    g = make_graph()\n    med,mn = time_cold(lambda: g.replay())\n    print(f'graph cold: {med:.4f}/{mn:.4f} ms')\n    print('graph hot :', hot(lambda: g.replay()))\nexcept Exception as ex:\n    import traceback; traceback.print_exc()\nEOF\ngpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench2.py\n"]
