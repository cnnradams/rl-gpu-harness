[1455.715569, "o", "{\r\n  \"trial\": \"deb9f68c5b1146f7963eaeeb8d2b76b7\",\r\n  \"limits\": {\r\n    \"gpu\": \"H100!\",\r\n    \"gpus_per_box\": 1,\r\n    \"max_boxes\": 1,\r\n    \"box_seconds\": 1800,\r\n    \"gpu_seconds\": 1126.4435617923737,\r\n    \"cpu\": 4.0,\r\n    \"memory\": 16384,\r\n    \"image_id\": \"im-6dLdOZewUVIcqANW1hvkHO\",\r\n    \"shared_workspace\": true,\r\n    \"run_only\": false,\r\n    \"block_network\": false,\r\n    \"idle_seconds\": null,\r\n    \"idle_probe\": \"commands\"\r\n  },\r\n  \"boxes\": [\r\n    {\r\n      \"id\": \"sb-ECt9w5ufzsTqZlIMce4ZU4\",\r\n      \"trial\": \"deb9f68c5b1146f7963eaeeb8d2b76b7\",\r\n      \"gpus\": 1,\r\n      \"requested_at\": 1793688302.3305209,\r\n      \"request_id\": \"eaadb41e04b546bc88a6601428116c01\",\r\n      \"readiness_observed\": true,\r\n      \"ready_at\": 1793688305.4790902,\r\n      \"last_available_at\": 1793689432.9249234,\r\n      \"ended_at\": 1793689433.0474687\r\n    }\r\n  ],\r\n  \"gpu_seconds_used\": 1127.5683784484863,\r\n  \"gpu_time_accounting_complete\": true\r\n}\r\n"]
