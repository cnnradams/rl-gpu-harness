[1060.96375, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\n\ndef hot(fn, n=60):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\ndef clear_l2():\n    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\n\ndef time_cold(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.ap"]
[1060.963792, "i", "pend(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2], ts[0]\n\n# persistent apply: fixed block count, each strides over its chunks\n@triton.jit\ndef _applyP(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, NBLK,\n            BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NBLK\n    col = pid % NBLK\n    s = tl.load(s_ptr + row)\n    q = tl.load(q_ptr + row)\n    inv_n = 1.0 / N\n    mean = s * inv_n\n    var = q * inv_n - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base_row = row.to(tl.int64) * N\n    for i in tl.static_range(NLOOP):\n        offs = (col * NLOOP + i) * BLOCK + tl.arange(0, BLOCK)\n        base = base_row + offs\n        xv = tl.load(x_ptr + base, eviction_policy='evict_first')\n        wv = tl.load(w_ptr + offs)\n        bv = tl.load(b_ptr + offs)\n        tl.store(o_ptr + base, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\n\n@triton.jit\ndef _statsP(x_ptr, s_ptr, q_ptr, N, NBLK, BLOCK: tl.constexpr, NLOOP: tl.constexpr, ILP: tl.constexpr):\n "]
[1060.963802, "i", "   pid = tl.program_id(0)\n    row = pid // NBLK\n    col = pid % NBLK\n    base_row = row.to(tl.int64) * N\n    sacc = tl.zeros([ILP, BLOCK], dtype=tl.float32)\n    qacc = tl.zeros([ILP, BLOCK], dtype=tl.float32)\n    for i in tl.static_range(NLOOP // ILP):\n        for j in tl.static_range(ILP):\n            offs = (col * NLOOP + i * ILP + j) * BLOCK + tl.arange(0, BLOCK)\n            v = tl.load(x_ptr + base_row + offs, eviction_policy='evict_first')\n            sacc = tl.where(tl.arange(0, ILP)[:, None] == j, sacc + v[None, :], sacc)\n            qacc = tl.where(tl.arange(0, ILP)[:, None] == j, qacc + (v * v)[None, :], qacc)\n    stot = tl.sum(tl.sum(sacc, axis=0), axis=0)\n    qtot = tl.sum(tl.sum(qacc, axis=0), axis=0)\n    tl.atomic_add(s_ptr + row, stot)\n    tl.atomic_add(q_ptr + row, qtot)\n\nprint('--- persistent apply ---')\nfor NB,B,W,L in [(128,4096,8,16),(64,4096,8,32),(256,2048,4,32),(128,2048,4,64),(256,4096,8,16),(512,1024,4,32),(256,1024,4,64),(128,8192,8,16)]:\n    try:\n        t = hot(lambda: _applyP[(NB*r"]
[1060.96381, "i", "ows,)](x, w, b, acc[0], acc[1], out, N, 1e-5, NB, BLOCK=B, NLOOP=L, num_warps=W))\n        print(f'applyP NB={NB} B={B} W={W} L={L}: {t:.4f}')\n    except Exception as ex:\n        print(f'applyP NB={NB} B={B} W={W} L={L}: FAIL {type(ex).__name__}')\n\nprint('--- simple apply 2d sweep (reference) ---')\n@triton.jit\ndef _apply3(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\n    mean = s/N; var = q/N - mean*mean\n    rstd = 1.0/tl.sqrt(var+eps)\n    for i in tl.static_range(NLOOP):\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n        base = row.to(tl.int64)*N+offs\n        xv = tl.load(x_ptr+base, eviction_policy='evict_first')\n        wv = tl.load(w_ptr+offs)\n        bv = tl.load(b_ptr+offs)\n        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, eviction_policy='evict_first')\n\nfor B,W,L in [(4096,8,16),(1024,4,64),(2048,4,32),(4096,4,16)]:\n    t = hot(lambda: _a"]
[1060.963945, "i", "pply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\n    print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\nEOF\ngpu push sb-ECt9w5ufzsTqZlIMce4ZU4 /workspace/bench6.py /workspace/bench6.py && gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench6.py\n"]
