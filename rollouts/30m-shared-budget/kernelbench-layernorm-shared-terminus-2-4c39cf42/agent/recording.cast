[1074.528309, "o", "--- persistent apply ---\r\napplyP NB=128 B=4096 W=8 L=16: FAIL AcceleratorError\r\napplyP NB=64 B=4096 W=8 L=32: FAIL RuntimeError\r\napplyP NB=256 B=2048 W=4 L=32: FAIL RuntimeError\r\napplyP NB=128 B=2048 W=4 L=64: FAIL RuntimeError\r\napplyP NB=256 B=4096 W=8 L=16: FAIL RuntimeError\r\napplyP NB=512 B=1024 W=4 L=32: FAIL RuntimeError\r\napplyP NB=256 B=1024 W=4 L=64: FAIL RuntimeError\r\napplyP NB=128 B=8192 W=8 L=16: FAIL RuntimeError\r\n--- simple apply 2d sweep (reference) ---\r\n"]
