[755.305972, "o", "\u001b[?2004h> "]
[755.306185, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[755.306221, "o", "\u001b[?2004h"]
[755.306257, "o", "> \r\n\u001b[?2004l\rz\u001b[?2004h> "]
[755.30646, "o", "x = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r"]
[755.306476, "o", "\u001b[?2004h"]
[755.306509, "o", "> "]
[755.306597, "o", "N = 64*256*256; rows = 16\r\n\u001b[?2004l\r"]
[755.306634, "o", "\u001b[?2004h> "]
[755.306893, "o", "w = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[755.306941, "o", "\u001b[?2004h> "]
[755.306979, "o", "out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[755.307005, "o", "\u001b[?2004h> "]
[755.307112, "o", "acc = torch.zeros(2, rows, device='cuda')\r\n\u001b[?2004l\r"]
[755.307147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.307184, "o", "> "]
[755.307225, "o", "def hot(fn, n=60):\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.307261, "o", "> "]
[755.307298, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[755.307333, "o", "\u001b[?2004h> "]
[755.307395, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[755.307432, "o", "\u001b[?2004h> "]
[755.307641, "o", "    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.307696, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.30777, "o", "    for _ in range(n): fn()\r\n\u001b[?2004l\r"]
[755.307808, "o", "\u001b[?2004h> "]
[755.307892, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[755.307944, "o", "\u001b[?2004h> "]
[755.308, "o", "    return s.elapsed_time(e)/n\r\n\u001b[?2004l\r"]
[755.308038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.308075, "o", "> "]
[755.308112, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.30834, "o", "    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.308374, "o", "> \r\n"]
[755.308408, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[755.308446, "o", "def time_cold(fn, n=15):\r\n\u001b[?2004l\r"]
[755.308482, "o", "\u001b[?2004h> "]
[755.308542, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[755.30858, "o", "\u001b[?2004h> "]
[755.308637, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[755.308675, "o", "\u001b[?2004h> "]
[755.308712, "o", "    ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.308794, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[755.30883, "o", "\u001b[?2004h> "]
[755.309003, "o", "        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[755.309035, "o", "\u001b[?2004h> "]
[755.309223, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[755.309258, "o", "\u001b[?2004h> "]
[755.309402, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[755.309437, "o", "\u001b[?2004h> "]
[755.309513, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[755.309552, "o", "\u001b[?2004h> "]
[755.309641, "o", "    ts.sort(); return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[755.309677, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.309716, "o", "> "]
[755.309755, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.310003, "o", "def _apply3(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\r\n\u001b[?2004l\r"]
[755.310018, "o", "\u001b[?2004h> "]
[755.310149, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[755.310196, "o", "\u001b[?2004h> "]
[755.310295, "o", "    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\r\n\u001b[?2004l\r"]
[755.310333, "o", "\u001b[?2004h> "]
[755.31041, "o", "    mean = s/N; var = q/N - mean*mean\r\n\u001b[?2004l\r"]
[755.310448, "o", "\u001b[?2004h> "]
[755.310511, "o", "    rstd = 1.0/tl.sqrt(var+eps)\r\n\u001b[?2004l\r"]
[755.310549, "o", "\u001b[?2004h> "]
[755.310624, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[755.310662, "o", "\u001b[?2004h> "]
[755.310781, "o", "        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[755.310816, "o", "\u001b[?2004h> "]
[755.310865, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[755.310911, "o", "\u001b[?2004h> "]
[755.31096, "o", "        base = row*N+offs\r\n\u001b[?2004l\r"]
[755.310998, "o", "\u001b[?2004h> "]
[755.31118, "o", "        xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[755.311221, "o", "\u001b[?2004h"]
[755.311259, "o", "> "]
[755.311333, "o", "        wv = tl.load(w_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[755.311372, "o", "\u001b[?2004h> "]
[755.311485, "o", "        bv = tl.load(b_ptr+offs, mask=mask, other=0.)\r\n\u001b[?2004l\r"]
[755.311523, "o", "\u001b[?2004h> "]
[755.311729, "o", "        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[755.311767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.311805, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[755.311833, "o", "\u001b[?2004h> "]
[755.312029, "o", "def _stats3(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\r\n\u001b[?2004l\r"]
[755.312072, "o", "\u001b[?2004h> "]
[755.312179, "o", "    pid = tl.program_id(0); row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[755.312216, "o", "\u001b[?2004h> "]
[755.312308, "o", "    sacc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[755.312346, "o", "\u001b[?2004h> "]
[755.312443, "o", "    qacc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[755.312481, "o", "\u001b[?2004h> "]
[755.312555, "o", "    for i in tl.static_range(NLOOP):\r\n\u001b[?2004l\r"]
[755.312593, "o", "\u001b[?2004h> "]
[755.312713, "o", "        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[755.312751, "o", "\u001b[?2004h> "]
[755.312805, "o", "        mask = offs < N\r\n\u001b[?2004l\r"]
[755.312841, "o", "\u001b[?2004h> "]
[755.313055, "o", "        v = tl.load(x_ptr+row*N+offs, mask=mask, other=0., eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[755.313096, "o", "\u001b[?2004h> "]
[755.313124, "o", "        sacc += v\r\n\u001b[?2004l\r"]
[755.313162, "o", "\u001b[?2004h> "]
[755.313204, "o", "        qacc += v*v\r\n\u001b[?2004l\r"]
[755.313243, "o", "\u001b[?2004h> "]
[755.313343, "o", "    tl.atomic_add(s_ptr+row, tl.sum(sacc, axis=0))\r\n\u001b[?2004l\r"]
[755.313387, "o", "\u001b[?2004h> "]
[755.313486, "o", "    tl.atomic_add(q_ptr+row, tl.sum(qacc, axis=0))\r\n\u001b[?2004l\r"]
[755.313525, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.313563, "o", "> best = None\r\n\u001b[?2004l\r"]
[755.313589, "o", "\u001b[?2004h> "]
[755.313947, "o", "for B,W,L in [(1024,4,32),(1024,4,64),(2048,4,16),(2048,4,32),(2048,4,64),(4096,8,16),(4096,8,32),(4096,8,64),(4096,4,32),(2048,2,32),(1024,2,64)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.313988, "o", "> "]
[755.314026, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.314321, "o", "        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.314351, "o", "> "]
[755.314469, "o", "        print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.314505, "o", "> "]
[755.314554, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[755.31459, "o", "\u001b[?2004h> "]
[755.314746, "o", "        print(f'apply3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.314778, "o", "> \r\n\u001b[?2004l\r"]
