[817.243763, "o", "apply3 B=1024 W=4 L=32: 0.2277\r\napply3 B=1024 W=4 L=64: 0.2090\r\napply3 B=2048 W=4 L=16: 0.2346\r\napply3 B=2048 W=4 L=32: 0.2464\r\napply3 B=2048 W=4 L=64: 0.2146\r\napply3 B=4096 W=8 L=16: 0.2220\r\napply3 B=4096 W=8 L=32: 0.2436\r\napply3 B=4096 W=8 L=64: 0.2176\r\napply3 B=4096 W=4 L=32: 0.2208\r\napply3 B=2048 W=2 L=32: 0.2218\r\napply3 B=1024 W=2 L=64: 0.2138\r\nstats3 B=1024 W=4 L=16: 0.0900\r\nstats3 B=1024 W=4 L=32: 0.0901\r\nstats3 B=2048 W=4 L=16: 0.1036\r\nstats3 B=2048 W=4 L=32: 0.0955\r\nstats3 B=4096 W=8 L=16: 0.0954\r\nstats3 B=4096 W=8 L=32: 0.0912\r\ngraph S=(4096, 8, 8) A=(4096, 8, 16): cold med 0.3221 min 0.3203; hot 0.3179\r\ngraph S=(4096, 8, 8) A=(4096, 8, 32): cold med 0.3500 min 0.3451; hot 0.3410\r\ngraph S=(4096, 8, 8) A=(1024, 4, 32): cold med 0.3269 min 0.3231; hot 0.3220\r\ngraph S=(2048, 4, 8) A=(4096, 8, 16): cold med 0.3246 min 0.3221; hot 0.3204\r\ngraph S=(2048, 4, 8) A=(4096, 8, 32): cold med 0.3518 min 0.3475; hot 0.3435\r\ngraph S=(2048, 4, 8) A=(1024, 4, 32): cold med 0.3269 min 0.3252; hot 0.3248\r\n"]
