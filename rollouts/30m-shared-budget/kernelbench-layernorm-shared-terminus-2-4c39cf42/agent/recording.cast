[223.74013, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl, torch.nn.functional as F, time\n\ndef clear_l2():\n    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda')\n    t.zero_()\n    del t\n\ndef time_fn(fn, n=20):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        clear_l2()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2], min(times)\n\nfrom solution import ModelNew, _ln_stats_kernel, _ln_apply_kernel\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nln = torch.nn.LayerNorm((64,256,256)).cuda()\nm = ModelNew((64,256,256)).cuda()\nwith torch.no_grad():\n    m.ln.weight.copy_(ln.weight); m.ln.bias.copy_(ln.bias)\n\nref = ln(x)\nout = m(x)\nprint('max diff vs eager"]
[223.740376, "i", ":', (ref-out).abs().max().item())\nprint('allclose:', torch.allclose(ref, out, atol=1e-4, rtol=1e-4))\n\nmed, mn = time_fn(lambda: ln(x))\nprint(f'eager LN: med {med:.4f} ms  min {mn:.4f} ms')\nmed, mn = time_fn(lambda: m(x))\nprint(f'custom  : med {med:.4f} ms  min {mn:.4f} ms')\n\n# sweep configs\nN = 64*256*256\nrows = 16\nw = ln.weight.view(-1); b = ln.bias.view(-1)\nfor B1, W1 in [(4096,8),(8192,8),(8192,16),(16384,16),(16384,32),(32768,32)]:\n    for B2, W2 in [(4096,8),(8192,16),(16384,16),(16384,32)]:\n        def f():\n            o = torch.empty_like(x)\n            acc = torch.zeros(2, rows, device='cuda')\n            _ln_stats_kernel[(triton.cdiv(N,B1), rows)](x, acc[0], acc[1], N, BLOCK_N=B1, num_warps=W1)\n            _ln_apply_kernel[(triton.cdiv(N,B2), rows)](x, w, b, acc[0], acc[1], o, N, 1e-5, BLOCK_N=B2, num_warps=W2)\n            return o\n        try:\n            med, mn = time_fn(f, n=10)\n            print(f'B1={B1} W1={W1} B2={B2} W2={W2}: med {med:.4f} min {mn:.4f}')\n        except Exception as ex:\n     "]
[223.740392, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[223.740402, "i", "       print(f'B1={B1} W1={W1} B2={B2} W2={W2}: FAIL {ex}')\nEOF\n"]
