[398.963147, "o", "\u001b[?2004h> "]
[398.963182, "o", "    def f2():\r\n\u001b[?2004l\r"]
[398.963214, "o", "\u001b[?2004h> "]
[398.963481, "o", "        _ln_apply_kernel[(triton.cdiv(N,B), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=B, num_warps=W)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[398.963569, "o", "    med,mn = time_cold(f2)\r\n\u001b[?2004l\r"]
[398.963582, "o", "\u001b[?2004h> "]
[398.963751, "o", "    print(f'apply B={B} W={W}: {med:.4f}/{mn:.4f} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.96378, "o", "> \r\n\u001b[?2004l\r"]
[398.963796, "o", "\u001b[?2004h> "]
[398.963951, "o", "# hot loop: 50 launches back to back to get pure GPU kernel times\r\n\u001b[?2004l\r"]
[398.963978, "o", "\u001b[?2004h> "]
[398.964021, "o", "def hot(fn, n=50):\r\n\u001b[?2004l\r"]
[398.964053, "o", "\u001b[?2004h> "]
[398.964122, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[398.964149, "o", "\u001b[?2004h> "]
[398.964217, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[398.964245, "o", "\u001b[?2004h> "]
[398.964436, "o", "    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[398.964457, "o", "\u001b[?2004h> "]
[398.964503, "o", "    s.record()\r\n\u001b[?2004l\r"]
[398.964523, "o", "\u001b[?2004h> "]
[398.964596, "o", "    for _ in range(n): fn()\r\n\u001b[?2004l\r"]
[398.964629, "o", "\u001b[?2004h> "]
[398.964718, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[398.96474, "o", "\u001b[?2004h> "]
[398.964836, "o", "    return s.elapsed_time(e)/n\r\n\u001b[?2004l\r"]
[398.964865, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[398.964889, "o", "\u001b[?2004h> "]
[398.965218, "o", "print('hot stats 8192/16:', hot(lambda: _ln_stats_kernel[(triton.cdiv(N,8192), rows)](x, acc[0], acc[1], N, BLOCK_N=8192, num_warps=16)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.965243, "o", "> "]
[398.965594, "o", "print('hot apply 4096/8 :', hot(lambda: _ln_apply_kernel[(triton.cdiv(N,4096), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=4096, num_warps=8)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.965621, "o", "> "]
[398.96588, "o", "print('hot copy 8192/16 :', hot(lambda: _copy[(triton.cdiv(TOT,8192),)](x, out, TOT, BLOCK=8192, num_warps=16)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.965902, "o", "> "]
[398.966032, "o", "print('hot zero acc     :', hot(lambda: acc.zero_()))\r\n\u001b[?2004l\r"]
[398.966054, "o", "\u001b[?2004h> \r\n"]
[398.966075, "o", "\u001b[?2004l\r\u001b[?2004h"]
[398.966104, "o", "> "]
[398.966166, "o", "# CUDA graph full forward\r\n\u001b[?2004l\r"]
[398.966198, "o", "\u001b[?2004h> "]
[398.966233, "o", "def make_graph():\r\n\u001b[?2004l\r"]
[398.966254, "o", "\u001b[?2004h> "]
[398.966344, "o", "    g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.966367, "o", "> "]
[398.966546, "o", "    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.96657, "o", "> "]
[398.966638, "o", "    with torch.cuda.stream(s):\r\n\u001b[?2004l\r"]
[398.966659, "o", "\u001b[?2004h> "]
[398.966713, "o", "        acc.zero_()\r\n\u001b[?2004l\r"]
[398.96674, "o", "\u001b[?2004h> "]
[398.966985, "o", "        _ln_stats_kernel[(triton.cdiv(N,8192), rows)](x, acc[0], acc[1], N, BLOCK_N=8192, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.96701, "o", "> "]
[398.967294, "o", "        _ln_apply_kernel[(triton.cdiv(N,4096), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=4096, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.967324, "o", "> "]
[398.967431, "o", "    torch.cuda.current_stream().wait_stream(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.967455, "o", "> "]
[398.967521, "o", "    with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[398.967548, "o", "\u001b[?2004h> "]
[398.967596, "o", "        acc.zero_()\r\n\u001b[?2004l\r"]
[398.967623, "o", "\u001b[?2004h> "]
[398.967868, "o", "        _ln_stats_kernel[(triton.cdiv(N,8192), rows)](x, acc[0], acc[1], N, BLOCK_N=8192, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.967897, "o", "> "]
[398.968174, "o", "        _ln_apply_kernel[(triton.cdiv(N,4096), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK_N=4096, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.968204, "o", "> "]
[398.968228, "o", "    return g\r\n\u001b[?2004l\r"]
[398.96825, "o", "\u001b[?2004h> \r\n"]
[398.968273, "o", "\u001b[?2004l\r\u001b[?2004h"]
[398.96829, "o", "> "]
[398.968305, "o", "try:\r\n\u001b[?2004l\r"]
[398.968332, "o", "\u001b[?2004h> "]
[398.968385, "o", "    g = make_graph()\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.968409, "o", "> "]
[398.968515, "o", "    med,mn = time_cold(lambda: g.replay())\r\n\u001b[?2004l\r\u001b[?2004h"]
[398.968545, "o", "> "]
[398.968649, "o", "    print(f'graph cold: {med:.4f}/{mn:.4f} ms')\r\n\u001b[?2004l\r"]
[398.96868, "o", "\u001b[?2004h> "]
[398.968804, "o", "    print('graph hot :', hot(lambda: g.replay()))\r\n\u001b[?2004l\r"]
[398.968825, "o", "\u001b[?2004h> "]
[398.968885, "o", "except Exception as ex:\r\n\u001b[?2004l\r"]
[398.968918, "o", "\u001b[?2004h> "]
[398.969023, "o", "    import traceback; traceback.print_exc()\r\n\u001b[?2004l\r"]
[398.969044, "o", "\u001b[?2004h> "]
[398.969066, "o", "EOF\r\n\u001b[?2004l\r"]
