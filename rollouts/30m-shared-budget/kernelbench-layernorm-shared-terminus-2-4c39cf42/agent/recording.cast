[583.080636, "o", "> \r\n"]
[583.080665, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[583.080882, "o", "for B,W,L in [(4096,8,2),(4096,8,4),(8192,16,2),(8192,16,4),(2048,4,4),(2048,4,8)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.080923, "o", ">     try:\r\n\u001b[?2004l\r"]
[583.080961, "o", "\u001b[?2004h> "]
[583.081268, "o", "        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.081305, "o", "> "]
[583.081406, "o", "        print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\r\n\u001b[?2004l\r"]
[583.081445, "o", "\u001b[?2004h> "]
[583.081501, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[583.081539, "o", "\u001b[?2004h> "]
[583.081696, "o", "        print(f'apply3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[583.081732, "o", "> EOF\r\n\u001b[?2004l\r"]
