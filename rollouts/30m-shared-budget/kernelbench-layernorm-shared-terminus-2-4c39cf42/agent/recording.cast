[584.085789, "o", "{\r\n  \"bytes\": 3718,\r\n  \"sha256\": \"9a2d68575ec50cc45419e684fe50deb42e8a3cad45fd042d96f80071c885cdcf\"\r\n}\r\n"]
[584.221731, "o", "request ID: 2fb2e15060b0444784492c0240afb39a\r\n"]
[585.509073, "o", "command: 70719a1585e24991a0148073fc76d10e\r\n"]
[591.308249, "o", "apply1 B=2048 W=4: 0.3495\r\napply1 B=2048 W=8: 0.3488\r\napply1 B=4096 W=4: 0.3512\r\napply1 B=4096 W=8: 0.3497\r\napply1 B=4096 W=16: 0.3480\r\napply1 B=8192 W=8: 0.3499\r\napply1 B=8192 W=16: 0.3503\r\napply1 B=8192 W=32: 0.3487\r\napply1 B=16384 W=16: 0.3499\r\napply1 B=16384 W=32: 0.3501\r\napply1 B=32768 W=32: 0.3605\r\napply1 B=65536 W=32: 0.6914\r\napply1 B=65536 W=64: FAIL OutOfResources\r\napply2 B=4096 W=8 xev='' oev='': 0.3499\r\napply2 B=4096 W=8 xev='' oev='evict_first': 0.3502\r\napply2 B=4096 W=8 xev='evict_first' oev='': 0.3489\r\napply2 B=4096 W=8 xev='evict_first' oev='evict_first': 0.3408\r\napply2 B=8192 W=16 xev='' oev='': 0.3505\r\napply2 B=8192 W=16 xev='' oev='evict_first': 0.3499\r\napply2 B=8192 W=16 xev='evict_first' oev='': 0.3493\r\napply2 B=8192 W=16 xev='evict_first' oev='evict_first': 0.3400\r\napply3 B=4096 W=8 L=2: 0.3286\r\napply3 B=4096 W=8 L=4: 0.3048\r\napply3 B=8192 W=16 L=2: 0.3394\r\napply3 B=8192 W=16 L=4: 0.2979\r\napply3 B=2048 W=4 L=4: 0.2964\r\napply3 B=2048 W=4 L=8: 0.2605\r\n"]
[592.17623, "o", "\u001b[?2004hroot@modal:/workspace# "]
[659.329509, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\nTOT = x.numel()\n\ndef hot(fn, n=50):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\n@triton.jit\ndef _apply3(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr, NLOOP: tl.constexpr,\n            XEV: tl.constexpr, OEV: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\n    mean = s/N; var = q/N - mean*mean\n    rstd = 1.0/tl.sqrt(var+eps)\n    for i in tl.static_range(NLOOP):\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n     "]
[659.329558, "i", "   mask = offs < N\n        base = row*N+offs\n        xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy=XEV)\n        wv = tl.load(w_ptr+offs, mask=mask, other=0.)\n        bv = tl.load(b_ptr+offs, mask=mask, other=0.)\n        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy=OEV)\n\n@triton.jit\ndef _copy3(x_ptr, o_ptr, TOT, BLOCK: tl.constexpr, NLOOP: tl.constexpr, XEV: tl.constexpr, OEV: tl.constexpr):\n    pid = tl.program_id(0)\n    for i in tl.static_range(NLOOP):\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n        mask = offs < TOT\n        v = tl.load(x_ptr+offs, mask=mask, other=0., eviction_policy=XEV)\n        tl.store(o_ptr+offs, v, mask=mask, eviction_policy=OEV)\n\n@triton.jit\ndef _stats3(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr, XEV: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    sacc = tl.zeros([BLOCK], dtype=tl.float32)\n    qacc = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in tl.static_range(NLOOP):\n        off"]
[659.329569, "i", "s = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        v = tl.load(x_ptr+row*N+offs, mask=mask, other=0., eviction_policy=XEV)\n        sacc += v\n        qacc += v*v\n    tl.atomic_add(s_ptr+row, tl.sum(sacc, axis=0))\n    tl.atomic_add(q_ptr+row, tl.sum(qacc, axis=0))\n\nprint('--- copy3 sweep ---')\nfor B,W,L in [(2048,4,4),(2048,4,8),(2048,4,16),(4096,8,4),(4096,8,8),(1024,4,8),(1024,4,16),(8192,16,4)]:\n    try:\n        t = hot(lambda: _copy3[(triton.cdiv(TOT,B*L),)](x, out, TOT, BLOCK=B, NLOOP=L, XEV='evict_first', OEV='evict_first', num_warps=W))\n        print(f'copy3 B={B} W={W} L={L}: {t:.4f} ({536.9/t:.0f} GB/s eff)')\n    except Exception as ex:\n        print(f'copy3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\n\nprint('--- apply3 sweep ---')\nfor B,W,L in [(1024,4,8),(1024,4,16),(1024,4,32),(2048,4,8),(2048,4,16),(2048,4,32),(2048,8,8),(2048,8,16),(4096,8,8),(4096,8,16),(4096,16,8)]:\n    try:\n        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, "]
[659.329578, "i", "1e-5, BLOCK=B, NLOOP=L, XEV='evict_first', OEV='evict_first', num_warps=W))\n        print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\n    except Exception as ex:\n        print(f'apply3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\n\nprint('--- apply3 ev combos best cfg ---')\nfor xe,oe in [('',''),('evict_first',''),('','evict_first'),('evict_first','evict_first')]:\n    t = hot(lambda: _apply3[(triton.cdiv(N,2048*8), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=2048, NLOOP=8, XEV=xe, OEV=oe, num_warps=4))\n    print(f'apply3 B=2048 W=4 L=8 xev={xe!r} oev={oe!r}: {t:.4f}')\n\nprint('--- stats3 sweep ---')\nfor B,W,L in [(1024,4,8),(2048,4,4),(2048,4,8),(2048,4,16),(4096,8,4),(4096,8,8),(8192,16,4)]:\n    try:\n        t = hot(lambda: _stats3[(triton.cdiv(N,B*L), rows)](x, acc[0], acc[1], N, BLOCK=B, NLOOP=L, XEV='evict_first', num_warps=W))\n        print(f'stats3 B={B} W={W} L={L}: {t:.4f}')\n    except Exception as ex:\n        print(f'stats3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\nEOF\ngpu push sb-ECt9w5ufzsTqZl"]
[659.329585, "i", "IMce4ZU4 /workspace/bench4.py /workspace/bench4.py && gpu exec sb-ECt9w5ufzsTqZlIMce4ZU4 -- python3 /workspace/bench4.py\n"]
