[675.255388, "o", "--- copy3 sweep ---\r\ncopy3 B=2048 W=4 L=4: 0.1909 (2813 GB/s eff)\r\ncopy3 B=2048 W=4 L=8: 0.1930 (2781 GB/s eff)\r\ncopy3 B=2048 W=4 L=16: 0.1944 (2762 GB/s eff)\r\ncopy3 B=4096 W=8 L=4: 0.1901 (2824 GB/s eff)\r\ncopy3 B=4096 W=8 L=8: 0.1912 (2809 GB/s eff)\r\ncopy3 B=1024 W=4 L=8: 0.1915 (2804 GB/s eff)\r\ncopy3 B=1024 W=4 L=16: 0.1946 (2759 GB/s eff)\r\ncopy3 B=8192 W=16 L=4: 0.1882 (2852 GB/s eff)\r\n--- apply3 sweep ---\r\napply3 B=1024 W=4 L=8: 0.2885\r\napply3 B=1024 W=4 L=16: 0.2637\r\napply3 B=1024 W=4 L=32: 0.2278\r\napply3 B=2048 W=4 L=8: 0.2603\r\napply3 B=2048 W=4 L=16: 0.2352\r\napply3 B=2048 W=4 L=32: 0.2464\r\napply3 B=2048 W=8 L=8: 0.3021\r\napply3 B=2048 W=8 L=16: 0.2606\r\napply3 B=4096 W=8 L=8: 0.2643\r\napply3 B=4096 W=8 L=16: 0.2220\r\napply3 B=4096 W=16 L=8: 0.2999\r\n--- apply3 ev combos best cfg ---\r\napply3 B=2048 W=4 L=8 xev='' oev='': 0.2826\r\napply3 B=2048 W=4 L=8 xev='evict_first' oev='': 0.2738\r\napply3 B=2048 W=4 L=8 xev='' oev='evict_first': 0.2753\r\napply3 B=2048 W=4 L=8 xev='evict_first' oev='evict_first': 0.2601\r\n---"]
[675.25544, "o", " stats3 sweep ---\r\nstats3 B=1024 W=4 L=8: 0.0919\r\nstats3 B=2048 W=4 L=4: 0.0922\r\nstats3 B=2048 W=4 L=8: 0.0927\r\nstats3 B=2048 W=4 L=16: 0.1040\r\nstats3 B=4096 W=8 L=4: 0.0932\r\nstats3 B=4096 W=8 L=8: 0.0913\r\nstats3 B=8192 W=16 L=4: 0.0968\r\n"]
[676.077394, "o", "\u001b[?2004hroot@modal:/workspace# "]
[755.305185, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256; rows = 16\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nout = torch.empty_like(x)\nacc = torch.zeros(2, rows, device='cuda')\n\ndef hot(fn, n=60):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\ndef clear_l2():\n    t = torch.empty(256*1024*1024//4, dtype=torch.float32, device='cuda'); t.zero_(); del t\n\ndef time_cold(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); clear_l2(); torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.ap"]
[755.305326, "i", "pend(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _apply3(x_ptr, w_ptr, b_ptr, s_ptr, q_ptr, o_ptr, N, eps, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    s = tl.load(s_ptr + row); q = tl.load(q_ptr + row)\n    mean = s/N; var = q/N - mean*mean\n    rstd = 1.0/tl.sqrt(var+eps)\n    for i in tl.static_range(NLOOP):\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        base = row*N+offs\n        xv = tl.load(x_ptr+base, mask=mask, other=0., eviction_policy='evict_first')\n        wv = tl.load(w_ptr+offs, mask=mask, other=0.)\n        bv = tl.load(b_ptr+offs, mask=mask, other=0.)\n        tl.store(o_ptr+base, (xv-mean)*rstd*wv+bv, mask=mask, eviction_policy='evict_first')\n\n@triton.jit\ndef _stats3(x_ptr, s_ptr, q_ptr, N, BLOCK: tl.constexpr, NLOOP: tl.constexpr):\n    pid = tl.program_id(0); row = tl.program_id(1)\n    sacc = tl.zeros([BLOCK], dtype=tl.float32)\n    qacc = tl.zeros([BLOCK], dtype=tl.floa"]
[755.305353, "i", "t32)\n    for i in tl.static_range(NLOOP):\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\n        mask = offs < N\n        v = tl.load(x_ptr+row*N+offs, mask=mask, other=0., eviction_policy='evict_first')\n        sacc += v\n        qacc += v*v\n    tl.atomic_add(s_ptr+row, tl.sum(sacc, axis=0))\n    tl.atomic_add(q_ptr+row, tl.sum(qacc, axis=0))\n\nbest = None\nfor B,W,L in [(1024,4,32),(1024,4,64),(2048,4,16),(2048,4,32),(2048,4,64),(4096,8,16),(4096,8,32),(4096,8,64),(4096,4,32),(2048,2,32),(1024,2,64)]:\n    try:\n        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\n        print(f'apply3 B={B} W={W} L={L}: {t:.4f}')\n    except Exception as ex:\n        print(f'apply3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\n\nfor B,W,L in [(1024,4,16),(1024,4,32),(2048,4,16),(2048,4,32),(4096,8,16),(4096,8,32)]:\n    try:\n        t = hot(lambda: _stats3[(triton.cdiv(N,B*L), rows)](x, acc[0], acc[1], N, BLOCK=B, NLOOP=L, num_warps=W))\n        p"]
[755.305439, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\rt32)\r\n    for i in tl.static_range(NLOOP):\r\n        offs = (pid*NLOOP+i)*BLOCK + tl.arange(0, BLOCK)\r\n        mask = offs < N\r\n        v = tl.load(x_ptr+row*N+offs, mask=mask, other=0., eviction_policy='evict_first')\r\n      "]
[755.305503, "i", "rint(f'stats3 B={B} W={W} L={L}: {t:.4f}')\n    except Exception as ex:\n        print(f'stats3 B={B} W={W} L={L}: FAIL {type(ex).__name__}')\n\n# full pipeline graph test with chosen configs\ndef build(SCFG=(4096,8,8), ACFG=(4096,8,16)):\n    SB,SW,SL = SCFG; AB,AW,AL = ACFG\n    def fwd():\n        acc.zero_()\n        _stats3[(triton.cdiv(N,SB*SL), rows)](x, acc[0], acc[1], N, BLOCK=SB, NLOOP=SL, num_warps=SW)\n        _apply3[(triton.cdiv(N,AB*AL), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=AB, NLOOP=AL, num_warps=AW)\n        return out\n    s = torch.cuda.Stream(); s.wait_stream(torch.cuda.current_stream())\n    with torch.cuda.stream(s):\n        fwd()\n    torch.cuda.current_stream().wait_stream(s)\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        fwd()\n    return g\n\nfor SCFG in [(4096,8,8),(2048,4,8)]:\n    for ACFG in [(4096,8,16),(4096,8,32),(1024,4,32)]:\n        g = build(SCFG, ACFG)\n        med, mn = time_cold(lambda: g.replay())\n        print(f'graph S={SCFG} A={ACFG}: cold med {med:"]
[755.305548, "o", "  sacc += v\r\n        qacc += v*v\r\n    tl.atomic_add(s_ptr+row, tl.sum(sacc, axis=0))\r\n    tl.atomic_add(q_ptr+row, tl.sum(qacc, axis=0))\r\n\r\nbest = None\r\nfor B,W,L in [(1024,4,32),(1024,4,64),(2048,4,16),(2048,4,32),(2048,4,64),(4096,8,16),(4096,8,32),(4096,8,64),(4096,4,32),(2048,2,32),(1024,2,64)]:\r\n    try:\r\n        t = hot(lambda: _apply3[(triton.cdiv(N,B*L), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=B, NLOOP=L, num_warps=W))\r\n      "]
