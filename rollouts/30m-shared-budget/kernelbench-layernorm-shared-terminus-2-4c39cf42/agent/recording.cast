[755.315976, "o", "\u001b[?2004h> "]
[755.316077, "o", "def build(SCFG=(4096,8,8), ACFG=(4096,8,16)):\r\n\u001b[?2004l\r"]
[755.316116, "o", "\u001b[?2004h> "]
[755.316191, "o", "    SB,SW,SL = SCFG; AB,AW,AL = ACFG\r\n\u001b[?2004l\r"]
[755.316221, "o", "\u001b[?2004h> "]
[755.316259, "o", "    def fwd():\r\n\u001b[?2004l\r"]
[755.316296, "o", "\u001b[?2004h> "]
[755.316334, "o", "        acc.zero_()\r\n\u001b[?2004l\r"]
[755.316369, "o", "\u001b[?2004h> "]
[755.31659, "o", "        _stats3[(triton.cdiv(N,SB*SL), rows)](x, acc[0], acc[1], N, BLOCK=SB, NLOOP=SL, num_warps=SW)\r\n\u001b[?2004l\r"]
[755.316634, "o", "\u001b[?2004h> "]
[755.316921, "o", "        _apply3[(triton.cdiv(N,AB*AL), rows)](x, w, b, acc[0], acc[1], out, N, 1e-5, BLOCK=AB, NLOOP=AL, num_warps=AW)\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.316956, "o", "> "]
