[464.252354, "o", "\u001b[?2004h> "]
[464.252477, "o", "        x = tl.extract_slice(xs, [t, 0], [1, BLOCK], [1, 1])\r\n\u001b[?2004l\r"]
[464.252516, "o", "\u001b[?2004h> "]
[464.25258, "o", "        x = tl.reshape(x, (BLOCK,))\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.25262, "o", "> "]
[464.252662, "o", "        if AFFINE:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.252772, "o", "            w = tl.load(W + t * BLOCK + cols0)\r\n\u001b[?2004l\r"]
[464.25281, "o", "\u001b[?2004h> "]
[464.252909, "o", "            b = tl.load(B + t * BLOCK + cols0)\r\n\u001b[?2004l\r"]
[464.252949, "o", "\u001b[?2004h> "]
[464.253022, "o", "            y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[464.25306, "o", "\u001b[?2004h> "]
[464.253099, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.25318, "o", "            y = (x - mean) * rstd\r\n\u001b[?2004l\r"]
[464.253219, "o", "\u001b[?2004h> "]
[464.253314, "o", "        tl.store(Y + base + t * BLOCK + cols0, y)\r\n\u001b[?2004l\r"]
[464.253334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[464.253376, "o", "\u001b[?2004h> "]
[464.25346, "o", "def make_fused(SPLITS, TILES, BLOCK, affine):\r\n\u001b[?2004l\r"]
[464.253475, "o", "\u001b[?2004h> "]
[464.253529, "o", "    N = 64*256*256\r\n\u001b[?2004l\rK\u001b[?2004h"]
[464.253569, "o", "> "]
[464.253607, "o", "    def f(x, w, b, eps):\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.253647, "o", "> "]
[464.253699, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r"]
[464.253739, "o", "\u001b[?2004h> "]
[464.253875, "o", "        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.254047, "o", "        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[464.254081, "o", "\u001b[?2004h> "]
[464.254138, "o", "        CNT = torch.zeros(M, device=x.device, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[464.254178, "o", "\u001b[?2004h> "]
[464.254218, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.254253, "o", "        grid = (SPLITS, M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.254394, "o", "        _fused[grid](x, Y, S1, S2, CNT, w, b, N, 1.0/N, eps, SPLITS=SPLITS, TILES=TILES, BLOCK=BLOCK, AFFINE=affine, num_warps=8)\r\n\u001b[?2004l\r"]
[464.254435, "o", "\u001b[?2004h>         return Y\r\n\u001b[?2004l\r"]
[464.254476, "o", "\u001b[?2004h>     return f\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.254515, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[464.25456, "o", "\u001b[?2004h> "]
[464.254613, "o", "def _stats(X, S1, S2, N, TILES: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[464.254654, "o", "\u001b[?2004h>     row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[464.254678, "o", "\u001b[?2004h> "]
[464.254715, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[464.254753, "o", "\u001b[?2004h> "]
[464.254793, "o", "    base = row * N + pid * (TILES * BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.254846, "o", "    acc1 = tl.zeros((BLOCK,), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[464.254885, "o", "\u001b[?2004h> "]
[464.254927, "o", "    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[464.254967, "o", "\u001b[?2004h>     for t in range(TILES):\r\n\u001b[?2004l\r"]
[464.255002, "o", "\u001b[?2004h> "]
[464.25505, "o", "        cols = t * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[464.255092, "o", "\u001b[?2004h> "]
[464.255126, "o", "        x = tl.load(X + base + cols)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255167, "o", "        acc1 += x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255205, "o", "        acc2 += x * x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255257, "o", "    tl.atomic_add(S1 + row, tl.sum(acc1, axis=0))\r\n\u001b[?2004l\r"]
[464.255298, "o", "\u001b[?2004h> "]
[464.255333, "o", "    tl.atomic_add(S2 + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[464.255369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255409, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255532, "o", "def _apply(X, Y, S1, S2, W, B, N, inv_N, eps, TILES: tl.constexpr, BLOCK: tl.constexpr, AFFINE: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.255573, "o", ">     row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[464.255612, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[464.255647, "o", "\u001b[?2004h> "]
[464.255694, "o", "    s1 = tl.load(S1 + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255734, "o", "    s2 = tl.load(S2 + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255773, "o", "    mean = s1 * inv_N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255838, "o", "    rstd = 1.0 / tl.sqrt(s2 * inv_N - mean * mean + eps)\r\n\u001b[?2004l\r"]
[464.255877, "o", "\u001b[?2004h> "]
[464.255929, "o", "    base = row * N + pid * (TILES * BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.255951, "o", "    for t in range(TILES):\r\n\u001b[?2004l\r"]
[464.255995, "o", "\u001b[?2004h> "]
[464.25603, "o", "        cols = t * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.256072, "o", "        x = tl.load(X + base + cols)\r\n\u001b[?2004l\r"]
[464.256111, "o", "\u001b[?2004h> "]
[464.256151, "o", "        if AFFINE:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.25619, "o", "            w = tl.load(W + cols)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.256229, "o", "            b = tl.load(B + cols)\r\n\u001b[?2004l\r"]
[464.256269, "o", "\u001b[?2004h> "]
[464.25631, "o", "            y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.256342, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.25638, "o", "            y = (x - mean) * rstd\r\n\u001b[?2004l\r"]
[464.256414, "o", "\u001b[?2004h> "]
[464.256454, "o", "        tl.store(Y + base + cols, y)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[464.256494, "o", "\u001b[?2004h> "]
[464.256532, "o", "def make_two(SPLITS, TILES, BLOCK, affine):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.256571, "o", "    N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.256609, "o", "    def f(x, w, b, eps):\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.256648, "o", ">         M = x.numel() // N\r\n\u001b[?2004l\r"]
[464.256689, "o", "\u001b[?2004h> "]
[464.256742, "o", "        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[464.256781, "o", "\u001b[?2004h> "]
[464.25683, "o", "        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[464.256868, "o", "\u001b[?2004h> "]
[464.256907, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.256944, "o", "        grid = (SPLITS, M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257025, "o", "        _stats[grid](x, S1, S2, N, TILES=TILES, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[464.257066, "o", "\u001b[?2004h> "]
[464.257157, "o", "        _apply[grid](x, Y, S1, S2, w, b, N, 1.0/N, eps, TILES=TILES, BLOCK=BLOCK, AFFINE=affine, num_warps=8)\r\n\u001b[?2004l\r"]
[464.257195, "o", "\u001b[?2004h>         return Y\r\n\u001b[?2004l\r"]
[464.257235, "o", "\u001b[?2004h>     return f\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[464.257275, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[464.25731, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257351, "o", "    dev = torch.device('cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257392, "o", "    torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257432, "o", "    N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257484, "o", "    ln = nn.LayerNorm((64,256,256)).to(dev)\r\n\u001b[?2004l\r"]
[464.257524, "o", "\u001b[?2004h> "]
[464.257567, "o", "    x = torch.rand(16, 64, 256, 256, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257608, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257648, "o", "        ref = ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.2577, "o", "    w = ln.weight.detach().clone()\r\n\u001b[?2004l\r"]
[464.257739, "o", "\u001b[?2004h> "]
[464.257778, "o", "    b = ln.bias.detach().clone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257818, "o", "    eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.257904, "o", "    times = time_execution_with_cuda_event(ln, [x], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[464.257942, "o", "\u001b[?2004h> "]
[464.257983, "o", "    print('REF mean ms:', np.mean(times[1:]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.258119, "o", "    for SPLITS, TILES, BLOCK in [(1024,4,1024),(2048,2,1024),(1024,2,2048),(512,2,4096),(512,4,2048),(2048,4,512)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.258163, "o", ">         for affine in (True, False):\r\n\u001b[?2004l\r"]
[464.258181, "o", "\u001b[?2004h> "]
[464.258245, "o", "            f = make_two(SPLITS, TILES, BLOCK, affine)\r\n\u001b[?2004l\r"]
[464.258286, "o", "\u001b[?2004h> "]
[464.258321, "o", "            with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.258359, "o", "                out = f(x, w, b, eps)\r\n\u001b[?2004l\r"]
[464.258397, "o", "\u001b[?2004h> "]
[464.258443, "o", "            ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[464.258482, "o", "\u001b[?2004h> "]
[464.258533, "o", "            md = (ref-out).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.258581, "o", "            g = lambda xx: f(xx, w, b, eps)\r\n\u001b[?2004l\r"]
[464.25862, "o", "\u001b[?2004h> "]
[464.258709, "o", "            times = time_execution_with_cuda_event(g, [x], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[464.258749, "o", "\u001b[?2004h> "]
[464.258855, "o", "            print(f'TWO S={SPLITS} T={TILES} B={BLOCK} aff={affine} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\r\n\u001b[?2004l\r"]
[464.258894, "o", "\u001b[?2004h> "]
[464.258967, "o", "    for SPLITS, TILES, BLOCK in [(128,8,4096),(256,8,2048),(128,4,8192)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.259012, "o", "        for affine in (False, True):\r\n\u001b[?2004l\r"]
[464.259051, "o", "\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[464.259094, "o", "\u001b[?2004h> "]
[464.259128, "o", "                f = make_fused(SPLITS, TILES, BLOCK, affine)\r\n\u001b[?2004l\r"]
[464.259147, "o", "\u001b[?2004h> "]
[464.259192, "o", "                with torch.no_grad():\r\n\u001b[?2004l\r"]
[464.25923, "o", "\u001b[?2004h> "]
[464.259269, "o", "                    out = f(x, w, b, eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.25932, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[464.259358, "o", "\u001b[?2004h> "]
[464.259409, "o", "                ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[464.259448, "o", "\u001b[?2004h> "]
[464.259488, "o", "                md = (ref-out).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.259507, "o", "> "]
[464.259551, "o", "                g = lambda xx: f(xx, w, b, eps)\r\n\u001b[?2004l\r"]
[464.25959, "o", "\u001b[?2004h> "]
[464.259684, "o", "                times = time_execution_with_cuda_event(g, [x], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[464.259702, "o", "\u001b[?2004h> "]
[464.259835, "o", "                print(f'FUSED S={SPLITS} T={TILES} B={BLOCK} aff={affine} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\r\n\u001b[?2004l\r"]
[464.259876, "o", "\u001b[?2004h> "]
[464.259916, "o", "            except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.260031, "o", "                print(f'FUSED S={SPLITS} T={TILES} B={BLOCK} aff={affine} FAILED: {type(e).__name__}: {str(e)[:200]}')\r\n\u001b[?2004l\r"]
[464.260071, "o", "\u001b[?2004h> "]
[464.26011, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[464.260149, "o", "\u001b[?2004l\r\u001b[?2004h> main()\r\n\u001b[?2004l\r"]
[464.260188, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[464.261941, "o", "\u001b[?2004hroot@modal:/# "]
