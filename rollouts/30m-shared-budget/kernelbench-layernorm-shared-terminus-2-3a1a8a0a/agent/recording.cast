[703.133979, "i", "cat > /workspace/proto3.py << 'EOF'\nimport torch, torch.nn as nn\nimport triton, triton.language as tl\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _fused(X, Y, S1, S2, CNT, N, inv_N, eps, SPLITS: tl.constexpr, TILES: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    base = row * N + pid * (TILES * BLOCK)\n    cols0 = tl.arange(0, BLOCK)\n    s1 = 0.0\n    s2 = 0.0\n    for t in tl.static_range(TILES):\n        x = tl.load(X + base + t * BLOCK + cols0)\n        s1 += tl.sum(x, axis=0)\n        s2 += tl.sum(x * x, axis=0)\n    tl.atomic_add(S1 + row, s1)\n    tl.atomic_add(S2 + row, s2)\n    tl.debug_barrier()\n    tl.atomic_add(CNT + row, 1)\n    cnt = 0\n    while cnt < SPLITS:\n        cnt = tl.atomic_add(CNT + row, 0)\n    t1 = tl.load(S1 + row)\n    t2 = tl.load(S2 + row)\n    mean = t1 * inv_N\n    rstd = 1.0 / tl.sqrt(t2 * inv_N - mean * mean + eps)\n    for t in tl.static_range(TILES):\n        x = tl.load(X + base + t * BLOCK "]
[703.134035, "i", "+ cols0)\n        y = (x - mean) * rstd\n        tl.store(Y + base + t * BLOCK + cols0, y)\n\ndef make_fused(SPLITS, TILES, BLOCK):\n    N = 64*256*256\n    def f(x):\n        M = x.numel() // N\n        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        CNT = torch.zeros(M, device=x.device, dtype=torch.int32)\n        Y = torch.empty_like(x)\n        _fused[(SPLITS, M)](x, Y, S1, S2, CNT, N, 1.0/N, 1e-5, SPLITS=SPLITS, TILES=TILES, BLOCK=BLOCK, num_warps=8)\n        return Y\n    return f\n\ndef main():\n    dev = torch.device('cuda')\n    torch.manual_seed(0)\n    N = 64*256*256\n    ln = nn.LayerNorm((64,256,256)).to(dev)\n    x = torch.rand(16, 64, 256, 256, device=dev)\n    with torch.no_grad():\n        ref = ln(x)\n    for SPLITS, TILES, BLOCK in [(128,8,4096),(256,8,2048),(64,8,8192),(128,16,2048),(256,16,1024),(64,16,4096),(512,8,1024),(256,4,4096)]:\n        f = make_fused(SPLITS, TILES, BLOCK)\n        with torch.no_grad():\n            out = "]
[703.134042, "i", "f(x)\n        torch.cuda.synchronize()\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        md = (ref-out).abs().max().item()\n        times = time_execution_with_cuda_event(f, [x], num_trials=20, verbose=False, device=dev)\n        print(f'FUSED S={SPLITS} T={TILES} B={BLOCK} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\n\nmain()\nEOF\ngpu push sb-k7igaa0IBHyQvtPdEKTi9A /workspace/proto3.py /workspace/proto3.py && gpu exec sb-k7igaa0IBHyQvtPdEKTi9A -- bash -c 'timeout 300 python3 /workspace/proto3.py > /tmp/p3.log 2>&1; grep -E \"FUSED|Error|error\" /tmp/p3.log | head -30'\n"]
[703.134171, "o", "cat > /workspace/proto3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.134294, "o", "import torch, torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.13436, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.134402, "o", "from kernelbench.timing import time_execution_with_cuda_event\r\n\u001b[?2004l\r"]
[703.134444, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.134484, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.134602, "o", "def _fused(X, Y, S1, S2, CNT, N, inv_N, eps, SPLITS: tl.constexpr, TILES: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[703.134646, "o", "\u001b[?2004h> "]
[703.134687, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.13472, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.134782, "o", "    base = row * N + pid * (TILES * BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.134832, "o", ">     cols0 = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[703.134872, "o", "\u001b[?2004h>     s1 = 0.0\r\n\u001b[?2004l\r"]
[703.134912, "o", "\u001b[?2004h>     s2 = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.134951, "o", "> "]
[703.13499, "o", "    for t in tl.static_range(TILES):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135029, "o", "        x = tl.load(X + base + t * BLOCK + cols0)\r\n\u001b[?2004l\r"]
[703.135068, "o", "\u001b[?2004h> "]
[703.135107, "o", "        s1 += tl.sum(x, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135144, "o", "        s2 += tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.135184, "o", "> "]
[703.135222, "o", "    tl.atomic_add(S1 + row, s1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135261, "o", "    tl.atomic_add(S2 + row, s2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135299, "o", "    tl.debug_barrier()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135338, "o", "    tl.atomic_add(CNT + row, 1)\r\n\u001b[?2004l\r"]
[703.135377, "o", "\u001b[?2004h>     cnt = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135418, "o", "    while cnt < SPLITS:\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.135456, "o", "> "]
[703.135497, "o", "        cnt = tl.atomic_add(CNT + row, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135535, "o", "    t1 = tl.load(S1 + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135573, "o", "    t2 = tl.load(S2 + row)\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.135612, "o", ">     mean = t1 * inv_N\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.135654, "o", "> "]
[703.135693, "o", "    rstd = 1.0 / tl.sqrt(t2 * inv_N - mean * mean + eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.135732, "o", "> "]
[703.13577, "o", "    for t in tl.static_range(TILES):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135821, "o", "        x = tl.load(X + base + t * BLOCK + cols0)\r\n\u001b[?2004l\r"]
[703.135859, "o", "\u001b[?2004h> "]
[703.135898, "o", "        y = (x - mean) * rstd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.135963, "o", "        tl.store(Y + base + t * BLOCK + cols0, y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136003, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136041, "o", "def make_fused(SPLITS, TILES, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.13608, "o", "    N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136119, "o", "    def f(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136159, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.136199, "o", "> "]
[703.136251, "o", "        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136348, "o", "        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136427, "o", "        CNT = torch.zeros(M, device=x.device, dtype=torch.int32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.136468, "o", "> "]
[703.136507, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136621, "o", "        _fused[(SPLITS, M)](x, Y, S1, S2, CNT, N, 1.0/N, 1e-5, SPLITS=SPLITS, TILES=TILES, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[703.136636, "o", "\u001b[?2004h> "]
[703.136679, "o", "        return Y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136718, "o", "    return f\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.136736, "o", "def main():\r\n\u001b[?2004l\r"]
[703.136782, "o", "\u001b[?2004h>     dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[703.136831, "o", "\u001b[?2004h>     torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[703.136871, "o", "\u001b[?2004h>     N = 64*256*256\r\n\u001b[?2004l\r"]
[703.136909, "o", "\u001b[?2004h> "]
[703.136949, "o", "    ln = nn.LayerNorm((64,256,256)).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.137007, "o", "    x = torch.rand(16, 64, 256, 256, device=dev)\r\n\u001b[?2004l\r"]
[703.137048, "o", "\u001b[?2004h>     with torch.no_grad():\r\n\u001b[?2004l\r"]
[703.137086, "o", "\u001b[?2004h> "]
[703.137127, "o", "        ref = ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.137277, "o", "    for SPLITS, TILES, BLOCK in [(128,8,4096),(256,8,2048),(64,8,8192),(128,16,2048),(256,16,1024),(64,16,4096),(512,8,1024),(256,4,4096)]:\r\n\u001b[?2004l\r"]
[703.137322, "o", "\u001b[?2004h> "]
[703.137364, "o", "        f = make_fused(SPLITS, TILES, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.137403, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.137442, "o", ">             out = f(x)\r\n\u001b[?2004l\r"]
[703.137481, "o", "\u001b[?2004h> "]
[703.137519, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.137577, "o", "        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[703.137616, "o", "\u001b[?2004h> "]
[703.137655, "o", "        md = (ref-out).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.13776, "o", "        times = time_execution_with_cuda_event(f, [x], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[703.1378, "o", "\u001b[?2004h> "]
[703.137914, "o", "        print(f'FUSED S={SPLITS} T={TILES} B={BLOCK} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[703.137957, "o", "\u001b[?2004h> main()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.13799, "o", "EOF\r\n\u001b[?2004l\r"]
