[211.161069, "o", "            print(f'SPLITS={SPLITS} TILES={TILES} BLOCK={BLOCK} affine={affine} ok={ok} maxdiff={md:.2e} mean_ms={np.mean(times[1:]):.4f}')\r\n\u001b[?2004l\r"]
