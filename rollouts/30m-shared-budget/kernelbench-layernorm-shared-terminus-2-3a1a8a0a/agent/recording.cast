[211.159287, "o", "    print('torch', torch.__version__, 'triton', triton.__version__)\r\n\u001b[?2004l\r"]
[211.15935, "o", "\u001b[?2004h> "]
[211.159398, "o", "    print('device', torch.cuda.get_device_name(0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
