[640.57171, "o", "  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\",\r\n    \"excessive_speedup\": true\r\n  },\r\n  \"runtime\": 0.286,\r\n  \"runtime_stats\": {\r\n    \"mean\": 0.286,\r\n    \"std\": 0.00217,\r\n    \"min\": 0.285,\r\n    \"max\": 0.295,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 8.09,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 8.09,\r\n    \"std\": 0.00355,\r\n    \"min\": 8.08,\r\n    \"max\": 8.09,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"d531c5166a9fa8ea8fda4ae9c473a1ab8069ec3370ac2211eaab0879ea4621df\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 28.28671328671329\r\n}\r\n"]
