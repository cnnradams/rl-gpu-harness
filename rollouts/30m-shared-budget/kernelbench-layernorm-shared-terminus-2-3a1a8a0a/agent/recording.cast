[211.15579, "i", "cat > /workspace/proto.py << 'EOF'\nimport torch, torch.nn as nn, torch.nn.functional as F\nimport triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _stats(X, S1, S2, N, TILES: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    base = row * N + pid * (TILES * BLOCK)\n    acc1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for t in range(TILES):\n        cols = t * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + base + cols)\n        acc1 += x\n        acc2 += x * x\n    tl.atomic_add(S1 + row, tl.sum(acc1, axis=0))\n    tl.atomic_add(S2 + row, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(X, Y, S1, S2, W, B, N, inv_N, eps, TILES: tl.constexpr, BLOCK: tl.constexpr, AFFINE: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    s1 = tl.load(S1 + row)\n    s2 = tl.load(S2 + row)\n    mean = s1 * inv_N\n    rstd = 1.0 / tl.sqrt(s2 * inv_N - mean * mean + eps)"]
[211.155844, "i", "\n    base = row * N + pid * (TILES * BLOCK)\n    for t in range(TILES):\n        cols = t * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + base + cols)\n        if AFFINE:\n            w = tl.load(W + cols)\n            b = tl.load(B + cols)\n            y = (x - mean) * rstd * w + b\n        else:\n            y = (x - mean) * rstd\n        tl.store(Y + base + cols, y)\n\ndef make_variant(SPLITS, TILES, BLOCK, affine):\n    def f(x, w, b, eps):\n        shape = x.shape\n        N = 1\n        for s in shape[-3:]: N *= s\n        M = x.numel() // N\n        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        Y = torch.empty_like(x)\n        grid = (SPLITS, M)\n        _stats[grid](x, S1, S2, N, TILES=TILES, BLOCK=BLOCK, num_warps=BLOCK//256*2)\n        _apply[grid](x, Y, S1, S2, w, b, N, 1.0/N, eps, TILES=TILES, BLOCK=BLOCK, AFFINE=affine, num_warps=BLOCK//256*2)\n        return Y\n    return f\n\ndef main():\n    print('torch', torch.__version__, 't"]
[211.155857, "i", "riton', triton.__version__)\n    print('device', torch.cuda.get_device_name(0))\n    dev = torch.device('cuda')\n    torch.manual_seed(0)\n    N = 64*256*256\n    ln = nn.LayerNorm((64,256,256)).to(dev)\n    x = torch.rand(16, 64, 256, 256, device=dev)\n    with torch.no_grad():\n        ref = ln(x)\n    w = ln.weight.detach().clone()\n    b = ln.bias.detach().clone()\n    eps = 1e-5\n    # time reference\n    times = time_execution_with_cuda_event(ln, [x], num_trials=20, verbose=False, device=dev)\n    import numpy as np\n    print('REF mean ms:', np.mean(times[1:]))\n    for (SPLITS, TILES, BLOCK, nw) in [(512,8,4096,None),(256,8,2048,None),(1024,4,2048,None),(256,16,2048,None)]:\n        for affine in (True, False):\n            f = make_variant(SPLITS, TILES, BLOCK, affine)\n            with torch.no_grad():\n                out = f(x, w, b, eps)\n            ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n            md = (ref-out).abs().max().item()\n            g = lambda xx: f(xx, w, b, eps)\n            times = time_ex"]
[211.156014, "i", "ecution_with_cuda_event(g, [x], num_trials=20, verbose=False, device=dev)\n            print(f'SPLITS={SPLITS} TILES={TILES} BLOCK={BLOCK} affine={affine} ok={ok} maxdiff={md:.2e} mean_ms={np.mean(times[1:]):.4f}')\n\nmain()\nEOF\nls -la /workspace/\n"]
