[130.842853, "o", "151:def load_custom_model_with_tempfile(model_custom_src, entry_point=\"ModelNew\"):\r\n152-    \"\"\"\r\n153-    Writes the provided Python code string to a temporary .py file,\r\n154-    dynamically imports the module so we can access the modified model class.\r\n155-\r\n156-    Returns both a Model class and the temporary file. The temporary file must be\r\n157-    deleted manually be the caller.\r\n158-\r\n159-    This is a hack that is needed for triton code as compile / exec do not play well\r\n160-    with the @triton.jit decorator.\r\n161-    \"\"\"\r\n162-\r\n163-    # Create a temporary named file with a .py extension\r\n164-    with tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".py\", delete=False) as tmp_file:\r\n165-        # Write the code string into the file\r\n166-        tmp_file.write(model_custom_src)\r\n167-        # Capture the path to the file\r\n168-        tempfile_path = tmp_file.name\r\n169-        temp_file = tmp_file\r\n170-\r\n171-    # Create a module specification pointing to our temp file\r\n172-    spec = importlib.util.spec_"]
[130.842891, "o", "from_file_location(\"temp_module\", tempfile_path)\r\n173-    # Create a new module based on that spec\r\n174-    temp_module = importlib.util.module_from_spec(spec)\r\n175-    # Execute the code in the module's namespace\r\n176-    spec.loader.exec_module(temp_module)\r\n177-\r\n178-    ModelNew = getattr(temp_module, entry_point)\r\n179-\r\n180-    # Return the object (class, function, etc.) that was defined in the code\r\n181-    return ModelNew, temp_file\r\n182-\r\n183-\r\n184-def load_custom_model(\r\n185-    model_custom_src: str, context: dict, build_directory: str = None\r\n186-) -> nn.Module:\r\n187-    \"\"\"\r\n188-    Load class from custom NN.module pytorch code\r\n189-    this is the code output by LLM with calls to custom cuda kernels\r\n190-    \"\"\"\r\n191-    if build_directory:\r\n--\r\n370:def _process_input_tensor(input, device, backend=\"cuda\", precision=torch.float32):\r\n371-    \"\"\"\r\n372-    Helper function to move tensors to the correct device and apply backend-specific dtype casting.\r\n373-    \r\n374-    Args:\r\n375-        input: Input"]
[130.842982, "o", " tensor or non-tensor value\r\n376-        device: Target CUDA device\r\n377-        backend: Backend type (e.g., 'cuda', 'triton', 'cute')\r\n378-        precision: torch.dtype \r\n379-    Returns:\r\n380-        Processed tensor on correct device with correct dtype, or original value if not a tensor\r\n381-    \"\"\"\r\n382-\r\n383-    # sometimes things like init inputs are floats (like in the case of labels / targets, classification losses, etc.) \r\n384-    if not isinstance(input, torch.Tensor):\r\n385-        return input\r\n386-    \r\n387-    # cast to the desired percision dtype for activations\r\n388-    input_tensor = input.to(dtype=precision)\r\n389-    \r\n390-    # Default for all other backends and float types\r\n391-    return input_tensor.to(device=device)\r\n392-\r\n393-\r\n394-def eval_kernel_against_ref(\r\n395-    original_model_src: str,\r\n396-    custom_model_src: str,\r\n397-    seed_num: int = 42,\r\n398-    num_correct_trials: int = 1,\r\n399-    num_perf_trials: int = 10,\r\n400-    measure_performance: bool = False,\r\n401-    timing"]
[130.843034, "o", "_method: str = \"cuda_event\", # see timing.py\r\n402-    verbose: bool = False,\r\n403-    build_dir: os.PathLike = None,\r\n404-    device: Union[torch.device, int] = (\r\n405-        torch.cuda.current_device() if torch.cuda.is_available() else None\r\n406-    ),  # have to run on GPU\r\n407-    backend: str = \"cuda\",  # can be 'cuda', 'triton', 'tilelang', or 'cute'\r\n408-    precision: torch.dtype = torch.float32,\r\n409-\r\n410-    # Guard against potential reward hacking [optional but ongoing enhancement]\r\n--\r\n495:    init_inputs = [_process_input_tensor(x, device, backend, precision) for x in init_inputs]\r\n496-    \r\n497-    with torch.no_grad():\r\n498-        set_seed(seed_num)  # set seed for reproducible weights\r\n499-        original_model = Model(*init_inputs)\r\n500-        assert hasattr(original_model, \"forward\")\r\n"]
