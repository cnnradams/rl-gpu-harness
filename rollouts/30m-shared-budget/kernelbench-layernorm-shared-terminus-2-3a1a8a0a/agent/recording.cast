[620.493847, "o", "        self._identity_affine = None\r\n\u001b[?2004l\r"]
[620.493875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.493926, "o", "    def _check_identity_affine(self):\r\n\u001b[?2004l\r"]
[620.493956, "o", "\u001b[?2004h> "]
[620.493988, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.494021, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r"]
[620.494051, "o", "\u001b[?2004h> "]
[620.494142, "o", "        ident = (w is None) or (bool((w == 1).all().item()) and bool((b == 0).all().item()))\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.494169, "o", "> "]
[620.494199, "o", "        if not ident:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.494247, "o", "            w2 = w.detach().contiguous()\r\n\u001b[?2004l\r"]
[620.494275, "o", "\u001b[?2004h> "]
[620.494313, "o", "            b2 = b.detach().contiguous()\r\n\u001b[?2004l\r"]
[620.494341, "o", "\u001b[?2004h> "]
[620.494368, "o", "            self._w = w2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.494406, "o", "            self._b = b2\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.494431, "o", "> "]
[620.494458, "o", "        self._identity_affine = ident\r\n\u001b[?2004l\r"]
[620.494485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[620.49451, "o", "> "]
[620.494572, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.494602, "o", ">         ln = self.ln\r\n\u001b[?2004l\r"]
[620.494629, "o", "\u001b[?2004h> "]
[620.49468, "o", "        normalized_shape = ln.normalized_shape\r\n\u001b[?2004l\r"]
[620.494708, "o", "\u001b[?2004h> "]
[620.494746, "o", "        k = len(normalized_shape)\r\n\u001b[?2004l\r"]
[620.494775, "o", "\u001b[?2004h>         N = 1\r\n\u001b[?2004l\r"]
[620.494803, "o", "\u001b[?2004h> "]
[620.494837, "o", "        for s in normalized_shape:\r\n\u001b[?2004l\r"]
[620.494866, "o", "\u001b[?2004h> "]
[620.494895, "o", "            N *= s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.495034, "o", "        if x.shape[-k:] != tuple(normalized_shape) or not x.is_cuda or x.dtype != torch.float32 or not x.is_contiguous():\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.495068, "o", "> "]
[620.495096, "o", "            return ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.495121, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r"]
[620.49515, "o", "\u001b[?2004h> "]
[620.49519, "o", "        if self._identity_affine is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.49522, "o", "> "]
[620.495254, "o", "            self._check_identity_affine()\r\n\u001b[?2004l\r"]
[620.495281, "o", "\u001b[?2004h> "]
[620.49532, "o", "        affine = not self._identity_affine\r\n\u001b[?2004l\r"]
[620.495349, "o", "\u001b[?2004h> "]
[620.495378, "o", "        eps = ln.eps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.495402, "o", "        dev = x.device\r\n\u001b[?2004l\r"]
[620.495429, "o", "\u001b[?2004h> "]
[620.495512, "o", "        # Fast path: split-row multi-block kernels when N decomposes nicely.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.495563, "o", "        cfg = self._pick_config(N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.495593, "o", "> "]
[620.495624, "o", "        if cfg is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.495672, "o", "            SPLITS, TILES, BLOCK = cfg\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.495703, "o", "> "]
[620.495768, "o", "            S1 = torch.zeros(M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.495797, "o", "> "]
[620.495856, "o", "            S2 = torch.zeros(M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.495885, "o", "> "]
[620.495909, "o", "            Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[620.495937, "o", "\u001b[?2004h> "]
[620.495965, "o", "            grid = (SPLITS, M)\r\n\u001b[?2004l\r"]
[620.495994, "o", "\u001b[?2004h> "]
[620.496024, "o", "            nw = 8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.496127, "o", "            _ln_stats_kernel[grid](x, S1, S2, N, TILES=TILES, BLOCK=BLOCK, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.496158, "o", "> "]
[620.496226, "o", "            w = self._w if affine else x  # dummy ptr when not affine\r\n\u001b[?2004l\r\u001b[?2004h> "]
[620.496283, "o", "            b = self._b if affine else x\r\n\u001b[?2004l\r"]
[620.496307, "o", "\u001b[?2004h> "]
[620.496378, "o", "            _ln_apply_kernel[grid](x, Y, S1, S2, w, b, N, 1.0 / N, eps,\r\n\u001b[?2004l\r"]
[620.496404, "o", "\u001b[?2004h> "]
[620.4965, "o", "                                   TILES=TILES, BLOCK=BLOCK, AFFINE=affine, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.49653, "o", ">             return Y\r\n\u001b[?2004l\r"]
[620.496555, "o", "\u001b[?2004h> "]
[620.496607, "o", "        # Masked fallback: one program per row.\r\n\u001b[?2004l\r"]
[620.496632, "o", "\u001b[?2004h> "]
[620.496697, "o", "        BLOCK = 4096 if N >= 4096 else triton.next_power_of_2(N)\r\n\u001b[?2004l\r"]
[620.496735, "o", "\u001b[?2004h> "]
[620.496788, "o", "        S1 = torch.empty(M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[620.496817, "o", "\u001b[?2004h> "]
[620.496871, "o", "        S2 = torch.empty(M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[620.496897, "o", "\u001b[?2004h> "]
[620.496926, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[620.496955, "o", "\u001b[?2004h> "]
[620.49702, "o", "        _ln_stats_masked[(M,)](x, S1, S2, N, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[620.497046, "o", "\u001b[?2004h> "]
[620.497078, "o", "        w = self._w if affine else x\r\n\u001b[?2004l\r"]
[620.497109, "o", "\u001b[?2004h> "]
[620.49714, "o", "        b = self._b if affine else x\r\n\u001b[?2004l\r"]
[620.497169, "o", "\u001b[?2004h> "]
[620.497233, "o", "        _ln_apply_masked[(M,)](x, Y, S1, S2, w, b, N, 1.0 / N, eps,\r\n\u001b[?2004l\r"]
[620.497263, "o", "\u001b[?2004h> "]
[620.497329, "o", "                               BLOCK=BLOCK, AFFINE=affine, num_warps=8)\r\n\u001b[?2004l\r"]
[620.497359, "o", "\u001b[?2004h>         return Y\r\n\u001b[?2004l\r"]
[620.497389, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[620.497417, "o", "\u001b[?2004h>     @staticmethod\r\n\u001b[?2004l\r"]
[620.497444, "o", "\u001b[?2004h> "]
[620.49747, "o", "    def _pick_config(N):\r\n\u001b[?2004l\r"]
[620.4975, "o", "\u001b[?2004h> "]
[620.497621, "o", "        for SPLITS, TILES, BLOCK in [(512, 4, 2048), (512, 2, 4096), (256, 4, 4096), (256, 8, 2048), (128, 8, 4096)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[620.497651, "o", "> "]
[620.497685, "o", "            if SPLITS * TILES * BLOCK == N:\r\n\u001b[?2004l\r"]
[620.497716, "o", "\u001b[?2004h> "]
[620.497763, "o", "                return (SPLITS, TILES, BLOCK)\r\n\u001b[?2004l\r"]
[620.497795, "o", "\u001b[?2004h>         return None\r\n\u001b[?2004l\r"]
[620.497822, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[620.499581, "o", "\u001b[?2004hroot@modal:/# "]
