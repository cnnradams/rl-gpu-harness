[714.079669, "o", "FUSED S=128 T=8 B=4096 ok=True md=4.53e-06 ms=0.2960\r\nFUSED S=256 T=8 B=2048 ok=True md=6.44e-06 ms=0.2950\r\nFUSED S=64 T=8 B=8192 ok=True md=4.77e-06 ms=0.2927\r\nFUSED S=128 T=16 B=2048 ok=True md=4.65e-06 ms=0.3072\r\nFUSED S=256 T=16 B=1024 ok=True md=5.13e-06 ms=0.3579\r\nFUSED S=64 T=16 B=4096 ok=True md=4.29e-06 ms=0.2966\r\nFUSED S=512 T=8 B=1024 ok=True md=5.25e-06 ms=0.3078\r\nFUSED S=256 T=4 B=4096 ok=True md=6.91e-06 ms=0.2979\r\n"]
[714.222914, "o", "\u001b[?2004hroot@modal:/# "]
[778.886511, "i", "cat > /workspace/proto4.py << 'EOF'\nimport torch, torch.nn as nn\nimport triton, triton.language as tl\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _copy(X, Y, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n\n    tl.store(Y + offs, tl.load(X + offs, mask=m), mask=m)\n\n@triton.jit\ndef _stats(X, S1, S2, N, TILES: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    base = row * N + pid * (TILES * BLOCK)\n    acc1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for t in range(TILES):\n        cols = t * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + base + cols)\n        acc1 += x\n        acc2 += x * x\n    tl.atomic_add(S1 + row, tl.sum(acc1, axis=0))\n    tl.atomic_add(S2 + row, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(X, Y, S1, S2, N, inv_N, eps, TILES: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.progra"]
[778.886577, "i", "m_id(1)\n    pid = tl.program_id(0)\n    s1 = tl.load(S1 + row)\n    s2 = tl.load(S2 + row)\n    mean = s1 * inv_N\n    rstd = 1.0 / tl.sqrt(s2 * inv_N - mean * mean + eps)\n    base = row * N + pid * (TILES * BLOCK)\n    for t in range(TILES):\n        cols = t * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + base + cols)\n        y = (x - mean) * rstd\n        tl.store(Y + base + cols, y)\n\ndef main():\n    dev = torch.device('cuda')\n    torch.manual_seed(0)\n    N = 64*256*256\n    M = 16\n    x = torch.rand(M, 64, 256, 256, device=dev)\n    Y = torch.empty_like(x)\n    n = x.numel()\n    # copy bandwidth test\n    def cp(xx):\n        _copy[(triton.cdiv(n, 8192),)](xx, Y, n, BLOCK=8192, num_warps=8)\n        return Y\n    times = time_execution_with_cuda_event(cp, [x], num_trials=20, verbose=False, device=dev)\n    t = np.mean(times[1:]); print(f'COPY 67MB ms={t:.4f} -> {2*n*4/t/1e9:.2f} GB/s')\n    # empty_like cost\n    def alloc(xx):\n        return torch.empty_like(xx)\n    times = time_execution_with_cuda_event(alloc, [x]"]
[778.886695, "i", ", num_trials=20, verbose=False, device=dev)\n    print(f'EMPTY_LIKE ms={np.mean(times[1:]):.4f}')\n    # full two-kernel for reference split by kernel\n    S1 = torch.zeros(M, device=dev); S2 = torch.zeros(M, device=dev)\n    for SPLITS,TILES,BLOCK,nw in [(512,4,2048,8),(512,4,2048,16),(512,4,2048,4),(256,4,4096,16),(512,2,4096,16)]:\n        def stats(xx):\n            _stats[(SPLITS,M)](xx, S1, S2, N, TILES=TILES, BLOCK=BLOCK, num_warps=nw)\n            return S1\n        def app(xx):\n            _apply[(SPLITS,M)](xx, Y, S1, S2, N, 1.0/N, 1e-5, TILES=TILES, BLOCK=BLOCK, num_warps=nw)\n            return Y\n        ts = time_execution_with_cuda_event(stats, [x], num_trials=20, verbose=False, device=dev)\n        ta = time_execution_with_cuda_event(app, [x], num_trials=20, verbose=False, device=dev)\n        print(f'S={SPLITS} T={TILES} B={BLOCK} nw={nw} stats_ms={np.mean(ts[1:]):.4f} apply_ms={np.mean(ta[1:]):.4f}')\n\nmain()\nEOF\ngpu push sb-k7igaa0IBHyQvtPdEKTi9A /workspace/proto4.py /workspace/proto4.py && gpu exec sb-"]
