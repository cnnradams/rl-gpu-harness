[211.160332, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[211.160372, "o", "        for affine in (True, False):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.160437, "o", "            f = make_variant(SPLITS, TILES, BLOCK, affine)\r\n\u001b[?2004l\r"]
