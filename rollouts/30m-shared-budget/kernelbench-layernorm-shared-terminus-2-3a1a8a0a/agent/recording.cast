[464.248375, "i", "cat > /workspace/proto2.py << 'EOF'\nimport torch, torch.nn as nn, torch.nn.functional as F\nimport triton, triton.language as tl\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _fused(X, Y, S1, S2, CNT, W, B, N, inv_N, eps, SPLITS: tl.constexpr, TILES: tl.constexpr, BLOCK: tl.constexpr, AFFINE: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    base = row * N + pid * (TILES * BLOCK)\n    cols0 = tl.arange(0, BLOCK)\n    acc1 = tl.zeros((TILES, BLOCK), dtype=tl.float32)\n    acc2 = tl.zeros((TILES, BLOCK), dtype=tl.float32)\n    xs = tl.zeros((TILES, BLOCK), dtype=tl.float32)\n    for t in tl.static_range(TILES):\n        x = tl.load(X + base + t * BLOCK + cols0)\n        xs = tl.where((tl.arange(0, TILES) == t)[:, None], x[None, :], xs)\n        acc1 = tl.where((tl.arange(0, TILES) == t)[:, None], x[None, :], acc1)\n        acc2 = tl.where((tl.arange(0, TILES) == t)[:, None], (x * x)[None, :], acc2)\n    s1 = tl.sum(acc1)\n    s2 = tl.sum(acc2)\n    t"]
[464.248431, "i", "l.atomic_add(S1 + row, s1)\n    tl.atomic_add(S2 + row, s2)\n    tl.debug_barrier()\n    old = tl.atomic_add(CNT + row, 1)\n    # spin until all splits done\n    while tl.atomic_add(CNT + row, 0) < SPLITS:\n        pass\n    t1 = tl.load(S1 + row)\n    t2 = tl.load(S2 + row)\n    mean = t1 * inv_N\n    rstd = 1.0 / tl.sqrt(t2 * inv_N - mean * mean + eps)\n    for t in tl.static_range(TILES):\n        x = tl.extract_slice(xs, [t, 0], [1, BLOCK], [1, 1])\n        x = tl.reshape(x, (BLOCK,))\n        if AFFINE:\n            w = tl.load(W + t * BLOCK + cols0)\n            b = tl.load(B + t * BLOCK + cols0)\n            y = (x - mean) * rstd * w + b\n        else:\n            y = (x - mean) * rstd\n        tl.store(Y + base + t * BLOCK + cols0, y)\n\ndef make_fused(SPLITS, TILES, BLOCK, affine):\n    N = 64*256*256\n    def f(x, w, b, eps):\n        M = x.numel() // N\n        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        CNT = torch.zeros(M, device=x.de"]
[464.248438, "i", "vice, dtype=torch.int32)\n        Y = torch.empty_like(x)\n        grid = (SPLITS, M)\n        _fused[grid](x, Y, S1, S2, CNT, w, b, N, 1.0/N, eps, SPLITS=SPLITS, TILES=TILES, BLOCK=BLOCK, AFFINE=affine, num_warps=8)\n        return Y\n    return f\n\n@triton.jit\ndef _stats(X, S1, S2, N, TILES: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    base = row * N + pid * (TILES * BLOCK)\n    acc1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for t in range(TILES):\n        cols = t * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + base + cols)\n        acc1 += x\n        acc2 += x * x\n    tl.atomic_add(S1 + row, tl.sum(acc1, axis=0))\n    tl.atomic_add(S2 + row, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(X, Y, S1, S2, W, B, N, inv_N, eps, TILES: tl.constexpr, BLOCK: tl.constexpr, AFFINE: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    s1 = tl.load(S1 + row)\n    s2 = tl.load(S2 + row)\n    mean = s1 * inv_N\n "]
[464.248579, "i", "   rstd = 1.0 / tl.sqrt(s2 * inv_N - mean * mean + eps)\n    base = row * N + pid * (TILES * BLOCK)\n    for t in range(TILES):\n        cols = t * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + base + cols)\n        if AFFINE:\n            w = tl.load(W + cols)\n            b = tl.load(B + cols)\n            y = (x - mean) * rstd * w + b\n        else:\n            y = (x - mean) * rstd\n        tl.store(Y + base + cols, y)\n\ndef make_two(SPLITS, TILES, BLOCK, affine):\n    N = 64*256*256\n    def f(x, w, b, eps):\n        M = x.numel() // N\n        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        Y = torch.empty_like(x)\n        grid = (SPLITS, M)\n        _stats[grid](x, S1, S2, N, TILES=TILES, BLOCK=BLOCK, num_warps=8)\n        _apply[grid](x, Y, S1, S2, w, b, N, 1.0/N, eps, TILES=TILES, BLOCK=BLOCK, AFFINE=affine, num_warps=8)\n        return Y\n    return f\n\ndef main():\n    dev = torch.device('cuda')\n    torch.manual_seed(0)\n    N = 64"]
[464.248596, "o", "cat > /workspace/proto2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.24864, "i", "*256*256\n    ln = nn.LayerNorm((64,256,256)).to(dev)\n    x = torch.rand(16, 64, 256, 256, device=dev)\n    with torch.no_grad():\n        ref = ln(x)\n    w = ln.weight.detach().clone()\n    b = ln.bias.detach().clone()\n    eps = 1e-5\n    times = time_execution_with_cuda_event(ln, [x], num_trials=20, verbose=False, device=dev)\n    print('REF mean ms:', np.mean(times[1:]))\n    for SPLITS, TILES, BLOCK in [(1024,4,1024),(2048,2,1024),(1024,2,2048),(512,2,4096),(512,4,2048),(2048,4,512)]:\n        for affine in (True, False):\n            f = make_two(SPLITS, TILES, BLOCK, affine)\n            with torch.no_grad():\n                out = f(x, w, b, eps)\n            ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n            md = (ref-out).abs().max().item()\n            g = lambda xx: f(xx, w, b, eps)\n            times = time_execution_with_cuda_event(g, [x], num_trials=20, verbose=False, device=dev)\n            print(f'TWO S={SPLITS} T={TILES} B={BLOCK} aff={affine} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\n"]
[464.248653, "o", "import torch, torch.nn as nn, torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.248718, "i", "    for SPLITS, TILES, BLOCK in [(128,8,4096),(256,8,2048),(128,4,8192)]:\n        for affine in (False, True):\n            try:\n                f = make_fused(SPLITS, TILES, BLOCK, affine)\n                with torch.no_grad():\n                    out = f(x, w, b, eps)\n                torch.cuda.synchronize()\n                ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n                md = (ref-out).abs().max().item()\n                g = lambda xx: f(xx, w, b, eps)\n                times = time_execution_with_cuda_event(g, [x], num_trials=20, verbose=False, device=dev)\n                print(f'FUSED S={SPLITS} T={TILES} B={BLOCK} aff={affine} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\n            except Exception as e:\n                print(f'FUSED S={SPLITS} T={TILES} B={BLOCK} aff={affine} FAILED: {type(e).__name__}: {str(e)[:200]}')\n                torch.cuda.synchronize()\n\nmain()\nEOF\ngpu push sb-k7igaa0IBHyQvtPdEKTi9A /workspace/proto2.py /workspace/proto2.py\n"]
