[856.045651, "i", "cat > /workspace/proto5.py << 'EOF'\nimport torch, torch.nn as nn\nimport triton, triton.language as tl\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _fused_reg(X, Y, S1, S2, CNT, N, inv_N, eps, SPLITS: tl.constexpr, TILES: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    base = row * N + pid * (TILES * BLOCK)\n    cols0 = tl.arange(0, BLOCK)\n    x0 = tl.load(X + base + 0 * BLOCK + cols0)\n    x1 = tl.load(X + base + 1 * BLOCK + cols0)\n    x2 = tl.load(X + base + 2 * BLOCK + cols0)\n    x3 = tl.load(X + base + 3 * BLOCK + cols0)\n    s1 = tl.sum(x0, 0) + tl.sum(x1, 0) + tl.sum(x2, 0) + tl.sum(x3, 0)\n    s2 = tl.sum(x0*x0, 0) + tl.sum(x1*x1, 0) + tl.sum(x2*x2, 0) + tl.sum(x3*x3, 0)\n    tl.atomic_add(S1 + row, s1)\n    tl.atomic_add(S2 + row, s2)\n    tl.debug_barrier()\n    tl.atomic_add(CNT + row, 1)\n    cnt = 0\n    while cnt < SPLITS:\n        cnt = tl.atomic_add(CNT + row, 0)\n    t1 = tl.load(S1 + row)\n    t2 = tl.load(S2"]
[856.045704, "i", " + row)\n    mean = t1 * inv_N\n    rstd = 1.0 / tl.sqrt(t2 * inv_N - mean * mean + eps)\n    tl.store(Y + base + 0 * BLOCK + cols0, (x0 - mean) * rstd)\n    tl.store(Y + base + 1 * BLOCK + cols0, (x1 - mean) * rstd)\n    tl.store(Y + base + 2 * BLOCK + cols0, (x2 - mean) * rstd)\n    tl.store(Y + base + 3 * BLOCK + cols0, (x3 - mean) * rstd)\n\ndef make_fused(SPLITS, TILES, BLOCK, nw):\n    N = 64*256*256\n    def f(x):\n        M = x.numel() // N\n        S1 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        S2 = torch.zeros(M, device=x.device, dtype=torch.float32)\n        CNT = torch.zeros(M, device=x.device, dtype=torch.int32)\n        Y = torch.empty_like(x)\n        _fused_reg[(SPLITS, M)](x, Y, S1, S2, CNT, N, 1.0/N, 1e-5, SPLITS=SPLITS, TILES=TILES, BLOCK=BLOCK, num_warps=nw)\n        return Y\n    return f\n\ndef main():\n    dev = torch.device('cuda')\n    torch.manual_seed(0)\n    N = 64*256*256\n    ln = nn.LayerNorm((64,256,256)).to(dev)\n    x = torch.rand(16, 64, 256, 256, device=dev)\n    with torch.no_gr"]
[856.045717, "i", "ad():\n        ref = ln(x)\n    for SPLITS, TILES, BLOCK, nw in [(512,4,2048,8),(1024,4,1024,8),(512,4,2048,16),(2048,4,512,8),(1024,4,1024,4),(4096,4,256,4)]:\n        f = make_fused(SPLITS, TILES, BLOCK, nw)\n        with torch.no_grad():\n            out = f(x)\n        torch.cuda.synchronize()\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        md = (ref-out).abs().max().item()\n        times = time_execution_with_cuda_event(f, [x], num_trials=20, verbose=False, device=dev)\n        print(f'FUSEDREG S={SPLITS} T={TILES} B={BLOCK} nw={nw} ok={ok} md={md:.2e} ms={np.mean(times[1:]):.4f}')\n\nmain()\nEOF\ngpu push sb-k7igaa0IBHyQvtPdEKTi9A /workspace/proto5.py /workspace/proto5.py && gpu exec sb-k7igaa0IBHyQvtPdEKTi9A -- bash -c 'timeout 300 python3 /workspace/proto5.py > /tmp/p5.log 2>&1; grep -E \"FUSEDREG|rror\" /tmp/p5.log | head -20'\n"]
