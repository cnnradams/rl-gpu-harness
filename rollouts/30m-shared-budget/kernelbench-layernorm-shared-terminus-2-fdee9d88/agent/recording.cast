[1277.900077, "i", "gpu exec sb-AVMTuQ7afCz75bOybMnBqs -- bash -c 'cat > /workspace/bench7.py << \"PYEOF\"\nimport torch, triton\nimport triton.language as tl\n\n@triton.jit\ndef _stats_v3(X, PSUM, PSQ, N,\n              CHUNK: tl.constexpr, BLOCK: tl.constexpr, NSUB: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    acc = tl.zeros([NSUB, BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([NSUB, BLOCK], dtype=tl.float32)\n    ii = tl.arange(0, BLOCK)\n    for off in tl.static_range(0, CHUNK, NSUB * BLOCK):\n        for s in tl.static_range(0, NSUB):\n            x = tl.load(X + base + off + s * BLOCK + ii, eviction_policy=\"evict_first\")\n            a = tl.reshape(acc, [NSUB, BLOCK])\n            acc += tl.broadcast_to(x[None, :], [NSUB, BLOCK]) * (tl.arange(0, NSUB)[:, None] == s)\n            acc2 += tl.broadcast_to(x * x, [NSUB, BLOCK]) * (tl.arange(0, NSUB)[:, None] == s)\n    nchunk = tl.num_programs(1)\n    pid = row * nchunk + chunk\n    tl.store(PSUM + pid, tl.sum(tl.sum(acc, axis=0))"]
[1277.900123, "i", ")\n    tl.store(PSQ + pid, tl.sum(tl.sum(acc2, axis=0)))\n\n@triton.jit\ndef _stats_v4(X, PSUM, PSQ, N,\n              CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    # two independent accumulator pairs for ILP\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    a1 = tl.zeros([BLOCK], dtype=tl.float32)\n    a2 = tl.zeros([BLOCK], dtype=tl.float32)\n    b1 = tl.zeros([BLOCK], dtype=tl.float32)\n    b2 = tl.zeros([BLOCK], dtype=tl.float32)\n    ii = tl.arange(0, BLOCK)\n    for off in tl.static_range(0, CHUNK, 2 * BLOCK):\n        x1 = tl.load(X + base + off + ii, eviction_policy=\"evict_first\")\n        x2 = tl.load(X + base + off + BLOCK + ii, eviction_policy=\"evict_first\")\n        a1 += x1\n        b1 += x1 * x1\n        a2 += x2\n        b2 += x2 * x2\n    nchunk = tl.num_programs(1)\n    pid = row * nchunk + chunk\n    tl.store(PSUM + pid, tl.sum(a1 + a2))\n    tl.store(PSQ + pid, tl.sum(b1 + b2))\n\ndev = \"cuda\"\nN = 64 * 256 * 256\nrows = 16\nx = torch.rand(rows, N, device=dev)\n\ndef loop"]
[1277.900129, "i", "bench(fn, iters=400):\n    fn()\n    torch.cuda.synchronize()\n    s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters):\n        fn()\n    e.record()\n    torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nprint(\"== v4 dual accum ==\")\nfor CHUNK in [16384, 32768]:\n    NC = N // CHUNK\n    ps1 = torch.empty(rows * NC, device=dev)\n    ps2 = torch.empty(rows * NC, device=dev)\n    for BLOCK in [1024, 2048, 4096]:\n        for NW in [8, 16, 32]:\n            if NW * 32 > BLOCK: continue\n            def f():\n                _stats_v4[(rows, NC)](x, ps1, ps2, N, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n            t = loopbench(f)\n            print(f\"CHUNK={CHUNK} BLOCK={BLOCK} NW={NW}: {t:.4f} ms ({256e-3/t:.2f} TB/s)\")\nPYEOF\npython3 /workspace/bench7.py'\n"]
