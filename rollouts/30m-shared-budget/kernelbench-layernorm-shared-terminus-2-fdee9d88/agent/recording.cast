[569.843554, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, itertools\nimport triton.language as tl\n\n@triton.jit\ndef _stats_kernel(X, PSUM, PSQ, N,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    nchunk = tl.num_programs(1)\n    pid = row * nchunk + chunk\n    tl.store(PSUM + pid, tl.sum(acc))\n    tl.store(PSQ + pid, tl.sum(acc2))\n\n@triton.jit\ndef _apply_kernel(X, W, B, Y, PSUM, PSQ, N, eps,\n                  NCHUNK: tl.constexpr, NPOW: tl.constexpr,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    offs = tl.arange(0, NPOW)\n    mask = offs < NCHUNK\n    ps = tl.load(PSUM + row * NCHUNK + offs, mask=mask, o"]
[569.843627, "i", "ther=0.0)\n    ps2 = tl.load(PSQ + row * NCHUNK + offs, mask=mask, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(ps2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    xbase = row * N + chunk * CHUNK\n    wbase = chunk * CHUNK\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        x = tl.load(X + xbase + idx)\n        w = tl.load(W + wbase + idx)\n        b = tl.load(B + wbase + idx)\n        y = (x - mean) * rstd * w + b\n        tl.store(Y + xbase + idx, y)\n\ndev = 'cuda'\nN = 64 * 256 * 256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\ncache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.float32, device=dev)\n\ndef bench(fn, n=30):\n    for _ in range(10):\n        fn()\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n        cache.zero_()\n        torch.cuda.synchronize()\n        s.record()\n      "]
[569.843633, "i", "  fn()\n        e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2]\n\nbest = None\nfor CHUNK in [8192, 16384, 32768]:\n    NCHUNK = N // CHUNK\n    NPOW = triton.next_power_of_2(NCHUNK)\n    psum = torch.empty(rows * NCHUNK, device=dev)\n    psq = torch.empty(rows * NCHUNK, device=dev)\n    for BLOCK in [1024, 2048, 4096, 8192]:\n        if BLOCK > CHUNK:\n            continue\n        for nw in [4, 8, 16, 32]:\n            if nw * 32 > BLOCK:\n                continue\n            def run():\n                _stats_kernel[(rows, NCHUNK)](x, psum, psq, N, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=nw)\n                _apply_kernel[(rows, NCHUNK)](x, w, b, y, psum, psq, N, 1e-5, NCHUNK=NCHUNK, NPOW=NPOW, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=nw)\n            try:\n                t = bench(run)\n            except Exception as ex:\n                print(CHUNK, BLOCK, nw, 'fail', str(ex)[:60])\n                continue\n            tag = f'CHUNK={CHUNK} BLOCK={"]
[569.843638, "i", "BLOCK} warps={nw}'\n            print(f'{tag}: {t:.4f} ms')\n            if best is None or t < best[0]:\n                best = (t, tag)\nprint('BEST:', best)\nEOF\ngpu exec sb-AVMTuQ7afCz75bOybMnBqs -- python3 /workspace/tune.py\n"]
