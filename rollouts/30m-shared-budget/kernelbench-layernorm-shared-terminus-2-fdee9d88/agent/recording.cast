[1216.059194, "o", "== stats ==\r\nCHUNK=16384 BLOCK=2048 NW=8 EV=0: 0.0889 ms (2.88 TB/s)\r\nCHUNK=16384 BLOCK=2048 NW=8 EV=1: 0.0881 ms (2.91 TB/s)\r\nCHUNK=16384 BLOCK=2048 NW=16 EV=0: 0.0885 ms (2.89 TB/s)\r\nCHUNK=16384 BLOCK=2048 NW=16 EV=1: 0.0877 ms (2.92 TB/s)\r\nCHUNK=16384 BLOCK=2048 NW=32 EV=0: 0.0882 ms (2.90 TB/s)\r\nCHUNK=16384 BLOCK=2048 NW=32 EV=1: 0.0875 ms (2.92 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=8 EV=0: 0.0894 ms (2.86 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=8 EV=1: 0.0886 ms (2.89 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=16 EV=0: 0.0890 ms (2.88 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=16 EV=1: 0.0881 ms (2.90 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=32 EV=0: 0.0883 ms (2.90 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=32 EV=1: 0.0873 ms (2.93 TB/s)\r\nCHUNK=16384 BLOCK=8192 NW=8 EV=0: 0.0896 ms (2.86 TB/s)\r\nCHUNK=16384 BLOCK=8192 NW=8 EV=1: 0.0887 ms (2.88 TB/s)\r\nCHUNK=16384 BLOCK=8192 NW=16 EV=0: 0.0890 ms (2.88 TB/s)\r\nCHUNK=16384 BLOCK=8192 NW=16 EV=1: 0.0881 ms (2.91 TB/s)\r\nCHUNK=16384 BLOCK=8192 NW=32 EV=0: 0.0883 ms (2.90 TB/s)\r\nCHUNK=16384 BLOCK=8192 NW=32 EV"]
[1216.059252, "o", "=1: 0.0874 ms (2.93 TB/s)\r\nCHUNK=32768 BLOCK=2048 NW=8 EV=0: 0.0897 ms (2.85 TB/s)\r\nCHUNK=32768 BLOCK=2048 NW=8 EV=1: 0.0888 ms (2.88 TB/s)\r\nCHUNK=32768 BLOCK=2048 NW=16 EV=0: 0.0889 ms (2.88 TB/s)\r\nCHUNK=32768 BLOCK=2048 NW=16 EV=1: 0.0881 ms (2.91 TB/s)\r\nCHUNK=32768 BLOCK=2048 NW=32 EV=0: 0.0886 ms (2.89 TB/s)\r\nCHUNK=32768 BLOCK=2048 NW=32 EV=1: 0.0878 ms (2.91 TB/s)\r\nCHUNK=32768 BLOCK=4096 NW=8 EV=0: 0.0896 ms (2.86 TB/s)\r\nCHUNK=32768 BLOCK=4096 NW=8 EV=1: 0.0889 ms (2.88 TB/s)\r\nCHUNK=32768 BLOCK=4096 NW=16 EV=0: 0.0888 ms (2.88 TB/s)\r\nCHUNK=32768 BLOCK=4096 NW=16 EV=1: 0.0881 ms (2.90 TB/s)\r\nCHUNK=32768 BLOCK=4096 NW=32 EV=0: 0.0901 ms (2.84 TB/s)\r\nCHUNK=32768 BLOCK=4096 NW=32 EV=1: 0.0901 ms (2.84 TB/s)\r\nCHUNK=32768 BLOCK=8192 NW=8 EV=0: 0.0905 ms (2.83 TB/s)\r\nCHUNK=32768 BLOCK=8192 NW=8 EV=1: 0.0898 ms (2.85 TB/s)\r\nCHUNK=32768 BLOCK=8192 NW=16 EV=0: 0.0898 ms (2.85 TB/s)\r\nCHUNK=32768 BLOCK=8192 NW=16 EV=1: 0.0890 ms (2.88 TB/s)\r\nCHUNK=32768 BLOCK=8192 NW=32 EV=0: 0.0890 ms (2.88 TB/s)\r\nCHUNK=32768 BLOCK"]
[1216.059262, "o", "=8192 NW=32 EV=1: 0.0882 ms (2.90 TB/s)\r\n== apply ==\r\nCHUNK=16384 BLOCK=4096 NW=16 EV=0: 0.1985 ms (5.16 TB/s)\r\nCHUNK=16384 BLOCK=4096 NW=16 EV=1: 0.1976 ms (5.18 TB/s)\r\n"]
