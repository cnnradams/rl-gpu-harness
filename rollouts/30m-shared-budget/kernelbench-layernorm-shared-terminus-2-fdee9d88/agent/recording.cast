[735.280619, "i", "gpu exec sb-AVMTuQ7afCz75bOybMnBqs -- bash -c 'cat > /workspace/bench3.py << \"PYEOF\"\nimport torch, triton, sys\nsys.path.insert(0, \"/workspace\")\nfrom solution import ModelNew, _stats_kernel, _apply_kernel\n\ndev = \"cuda\"\nN = 64 * 256 * 256\nrows = 16\nm = ModelNew((64, 256, 256)).to(dev)\nx = torch.rand(rows, N, device=dev)\nCHUNK, BLOCK, NW = 16384, 4096, 16\nNCHUNK = N // CHUNK\npsum = torch.empty(rows * NCHUNK, device=dev)\npsq = torch.empty(rows * NCHUNK, device=dev)\ny = torch.empty_like(x)\nw, b = m.ln.weight, m.ln.bias\n\ndef direct():\n    _stats_kernel[(rows, NCHUNK)](x, psum, psq, N, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n    _apply_kernel[(rows, NCHUNK)](x, w, b, y, psum, psq, N, 1e-5, NCHUNK=NCHUNK, NPOW=NCHUNK, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n\n# GPU-only throughput: many iters between events\ndef loopbench(fn, iters=300):\n    fn()\n    torch.cuda.synchronize()\n    s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters):\n        fn()\n    e.record()\n    torch.cuda.syn"]
[735.28069, "i", "chronize()\n    return s.elapsed_time(e) / iters\n\nprint(f\"direct GPU-loop: {loopbench(direct):.4f} ms\")\n\ng = torch.cuda.CUDAGraph()\ns0 = torch.cuda.Stream()\ns0.wait_stream(torch.cuda.current_stream())\nwith torch.cuda.stream(s0):\n    for _ in range(3):\n        direct()\ntorch.cuda.current_stream().wait_stream(s0)\ntorch.cuda.synchronize()\nwith torch.cuda.graph(g):\n    direct()\ng.replay()\ntorch.cuda.synchronize()\nprint(f\"graph  GPU-loop: {loopbench(lambda: g.replay()):.4f} ms\")\n\n# single kernel timing\nimport triton.language as tl\n@triton.jit\ndef _row_kernel(X, Y, N, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    base = row * N\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.static_range(0, N, BLOCK):\n        xx = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += xx\n        acc2 += xx * xx\n    mean = tl.sum(acc) / N\n    var = tl.sum(acc2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + 1e-5)\n    for off in tl.static_range(0, N, BLOCK):"]
[735.280698, "i", "\n        idx = off + tl.arange(0, BLOCK)\n        xx = tl.load(X + base + idx)\n        tl.store(Y + base + idx, (xx - mean) * rstd)\n\ndef rowk():\n    _row_kernel[(rows,)](x, y, N, BLOCK=8192, num_warps=32)\nrowk()\ntorch.cuda.synchronize()\nprint(f\"single-row-kernel GPU-loop: {loopbench(rowk):.4f} ms\")\n\n# theoretical: pure copy d2d\nsrc = torch.empty(64 * 1024 * 1024, device=dev)\ndst = torch.empty_like(src)\ndef cp():\n    dst.copy_(src)\nprint(f\"copy 512MB GPU-loop: {loopbench(cp, 100):.4f} ms\")\nPYEOF\npython3 /workspace/bench3.py'\n"]
