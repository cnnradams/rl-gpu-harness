[662.681289, "o", "                print(CHUNK, BLOCK, nw, \"fail\", str(ex)[:60])\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.681301, "o", "> "]
[662.681327, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.68141, "o", "            tag = f\"CHUNK={CHUNK} BLOCK={BLOCK} warps={nw}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.681443, "o", "            print(f\"{tag}: {t:.4f} ms\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.681487, "o", "            if best is None or t < best[0]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[662.681503, "o", "> "]
[662.681531, "o", "                best = (t, tag)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[662.681557, "o", "print(\"BEST:\", best)\r\n\u001b[?2004l\r"]
[662.68158, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r\u001b[?2004h> "]
