[1205.454812, "i", "gpu exec sb-AVMTuQ7afCz75bOybMnBqs -- bash -c 'cat > /workspace/bench6.py << \"PYEOF\"\nimport torch, triton\nimport triton.language as tl\n\n@triton.jit\ndef _stats_v2(X, PSUM, PSQ, N,\n              CHUNK: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    if EV == 1:\n        for off in tl.static_range(0, CHUNK, BLOCK):\n            x = tl.load(X + base + off + tl.arange(0, BLOCK), eviction_policy=\"evict_first\")\n            acc += x\n            acc2 += x * x\n    else:\n        for off in tl.static_range(0, CHUNK, BLOCK):\n            x = tl.load(X + base + off + tl.arange(0, BLOCK))\n            acc += x\n            acc2 += x * x\n    nchunk = tl.num_programs(1)\n    pid = row * nchunk + chunk\n    tl.store(PSUM + pid, tl.sum(acc))\n    tl.store(PSQ + pid, tl.sum(acc2))\n\n@triton.jit\ndef _apply_v2(X, W, B, Y, PSUM, PSQ, N, eps,\n        "]
[1205.454855, "i", "      NCHUNK: tl.constexpr, NPOW: tl.constexpr,\n              CHUNK: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    offs = tl.arange(0, NPOW)\n    mask = offs < NCHUNK\n    ps = tl.load(PSUM + row * NCHUNK + offs, mask=mask, other=0.0)\n    ps2 = tl.load(PSQ + row * NCHUNK + offs, mask=mask, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(ps2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    xbase = row * N + chunk * CHUNK\n    wbase = chunk * CHUNK\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        if EV == 1:\n            x = tl.load(X + xbase + idx, eviction_policy=\"evict_first\")\n            w = tl.load(W + wbase + idx, eviction_policy=\"evict_first\")\n            b = tl.load(B + wbase + idx, eviction_policy=\"evict_first\")\n            y = (x - mean) * rstd * w + b\n            tl.store(Y + xbase + idx, y, eviction_policy=\"evict_first\")\n        else:\n            x = tl.load(X + xbase + idx"]
[1205.454861, "i", ")\n            w = tl.load(W + wbase + idx)\n            b = tl.load(B + wbase + idx)\n            y = (x - mean) * rstd * w + b\n            tl.store(Y + xbase + idx, y)\n\ndev = \"cuda\"\nN = 64 * 256 * 256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\n\ndef loopbench(fn, iters=400):\n    fn()\n    torch.cuda.synchronize()\n    s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters):\n        fn()\n    e.record()\n    torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nNCHUNK = 256\nNPOW = 256\npsum = torch.rand(rows * NCHUNK, device=dev)\npsq = torch.rand(rows * NCHUNK, device=dev) + 10\n\nprint(\"== stats ==\")\nfor CHUNK in [16384, 32768]:\n    NC = N // CHUNK\n    ps1 = torch.empty(rows * NC, device=dev)\n    ps2 = torch.empty(rows * NC, device=dev)\n    for BLOCK in [2048, 4096, 8192]:\n        for NW in [8, 16, 32]:\n            if NW * 32 > BLOCK: continue\n            for EV in [0, 1]:\n            "]
[1205.45487, "i", "    def f():\n                    _stats_v2[(rows, NC)](x, ps1, ps2, N, CHUNK=CHUNK, BLOCK=BLOCK, EV=EV, num_warps=NW)\n                t = loopbench(f)\n                print(f\"CHUNK={CHUNK} BLOCK={BLOCK} NW={NW} EV={EV}: {t:.4f} ms ({256e-3/t:.2f} TB/s)\")\nprint(\"== apply ==\")\nfor CHUNK in [16384]:\n    for BLOCK in [4096]:\n        for NW in [16]:\n            for EV in [0, 1]:\n                def f():\n                    _apply_v2[(rows, N//CHUNK)](x, w, b, y, psum, psq, N, 1e-5, NCHUNK=NCHUNK, NPOW=NPOW, CHUNK=CHUNK, BLOCK=BLOCK, EV=EV, num_warps=NW)\n                t = loopbench(f)\n                print(f\"CHUNK={CHUNK} BLOCK={BLOCK} NW={NW} EV={EV}: {t:.4f} ms ({1024e-3/t:.2f} TB/s)\")\nPYEOF\npython3 /workspace/bench6.py'\n"]
