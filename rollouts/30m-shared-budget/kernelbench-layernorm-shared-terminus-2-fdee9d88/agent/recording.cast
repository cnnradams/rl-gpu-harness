[197.573363, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time\nimport torch.nn.functional as F\nfrom solution import ModelNew\n\ntorch.manual_seed(0)\ndev = 'cuda'\nm = ModelNew((64, 256, 256)).to(dev)\nx = torch.rand(16, 64, 256, 256, device=dev)\nref = F.layer_norm(x, (64, 256, 256), m.ln.weight, m.ln.bias, 1e-5)\nout = m(x)\nprint('max diff', (out - ref).abs().max().item())\n\ndef bench(fn, n=50):\n    for _ in range(10):\n        fn()\n    torch.cuda.synchronize()\n    evs = [(torch.cuda.Event(True), torch.cuda.Event(True)) for _ in range(n)]\n    cache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.float32, device=dev)\n    times = []\n    for s, e in evs:\n        cache.zero_()\n        torch.cuda.synchronize()\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2], times[0]\n\nmed, mn = bench(lambda: m(x))\nprint(f'custom: med {med:.4f} ms  min {mn:.4f} ms')\nmed, mn = bench(lambda: F.layer_norm(x, (64,256,256), m.l"]
[197.573853, "i", "n.weight, m.ln.bias, 1e-5))\nprint(f'eager : med {med:.4f} ms  min {mn:.4f} ms')\nEOF\necho done\n"]
