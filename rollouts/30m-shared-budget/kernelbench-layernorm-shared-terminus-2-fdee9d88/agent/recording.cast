[196.985669, "i", "mkdir -p /workspace && cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _stats_kernel(X, PSUM, PSQ, N, NCHUNK,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    pid = row * NCHUNK + chunk\n    tl.store(PSUM + pid, tl.sum(acc))\n    tl.store(PSQ + pid, tl.sum(acc2))\n\n\n@triton.jit\ndef _apply_kernel(X, W, B, Y, PSUM, PSQ, N, eps,\n                  NCHUNK: tl.constexpr, NPOW: tl.constexpr,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    offs = tl.arange(0, NPOW)\n    mask = offs < NCHUNK\n    ps = tl.load(PSUM + row * NCHUN"]
[196.98659, "o", "mkdir -p /workspace && cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[196.987042, "i", "K + offs, mask=mask, other=0.0)\n    ps2 = tl.load(PSQ + row * NCHUNK + offs, mask=mask, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(ps2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    xbase = row * N + chunk * CHUNK\n    wbase = chunk * CHUNK\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        x = tl.load(X + xbase + idx)\n        w = tl.load(W + wbase + idx)\n        b = tl.load(B + wbase + idx)\n        y = (x - mean) * rstd * w + b\n        tl.store(Y + xbase + idx, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\n        self._N = 1\n        for s in self.normalized_shape:\n            self._N *= s\n        self._partials = {}\n\n    def _get_partials(self, rows, device):\n        key = (rows, device)\n        buf = self._partials.get(key)\n        if buf is None:\n            n"]
[196.987057, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def _stats_kernel(X, PSUM, PSQ, N, NCHUNK,\r\n\u001b[?2004l\r\u001b[?2004h>                   CHUNK: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     chunk = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h>     base = row * N + chunk * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h>     acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h>     acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.987098, "i", "chunk = self._N // 16384\n            buf = (torch.empty(rows * nchunk, device=device, dtype=torch.float32),\n                   torch.empty(rows * nchunk, device=device, dtype=torch.float32))\n            self._partials[key] = buf\n        return buf\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not x.is_cuda:\n            return self.ln(x)\n        x = x.contiguous()\n        N = self._N\n        rows = x.numel() // N\n        CHUNK = 16384\n        BLOCK = 4096\n        NCHUNK = N // CHUNK\n        y = torch.empty_like(x)\n        psum, psq = self._get_partials(rows, x.device)\n        w = self.ln.weight\n        b = self.ln.bias\n        grid = (rows, NCHUNK)\n        _stats_kernel[grid](x, psum, psq, N, NCHUNK,\n                            CHUNK=CHUNK, BLOCK=BLOCK, num_warps=8)\n        _apply_kernel[grid](x, w, b, y, psum, psq, N, self.ln.eps,\n                            NCHUNK=NCHUNK, NPOW=triton.next_power_of_2(NCHUNK),\n                            CHUNK=CHUNK, BLOCK=BLOCK, num_warps=8)\n        retu"]
[196.987316, "o", "    for off in tl.static_range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h>         x = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r\u001b[?2004h>         acc += x\r\n\u001b[?2004l\r\u001b[?2004h>         acc2 += x * x\r\n\u001b[?2004l\r\u001b[?2004h>     pid = row * NCHUNK + chunk\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(PSUM + pid, tl.sum(acc))\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(PSQ + pid, tl.sum(acc2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.987372, "i", "rn y\nEOF\necho done\n"]
