[1133.528168, "i", "gpu exec sb-AVMTuQ7afCz75bOybMnBqs -- bash -c 'cat > /workspace/bench5.py << \"PYEOF\"\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\n@triton.jit\ndef _stats_kernel(X, PSUM, PSQ, N,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    nchunk = tl.num_programs(1)\n    pid = row * nchunk + chunk\n    tl.store(PSUM + pid, tl.sum(acc))\n    tl.store(PSQ + pid, tl.sum(acc2))\n\n@triton.jit\ndef _apply_kernel(X, W, B, Y, PSUM, PSQ, N, eps,\n                  NCHUNK: tl.constexpr, NPOW: tl.constexpr,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    offs = tl.arange(0, NPOW)\n    mask ="]
[1133.528215, "i", " offs < NCHUNK\n    ps = tl.load(PSUM + row * NCHUNK + offs, mask=mask, other=0.0)\n    ps2 = tl.load(PSQ + row * NCHUNK + offs, mask=mask, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(ps2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    xbase = row * N + chunk * CHUNK\n    wbase = chunk * CHUNK\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        x = tl.load(X + xbase + idx)\n        w = tl.load(W + wbase + idx)\n        b = tl.load(B + wbase + idx)\n        y = (x - mean) * rstd * w + b\n        tl.store(Y + xbase + idx, y)\n\ndev = \"cuda\"\nN = 64 * 256 * 256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\n\ndef loopbench(fn, iters=300):\n    fn()\n    torch.cuda.synchronize()\n    s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters):\n        fn()\n    e.record()\n    torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# stats o"]
[1133.528233, "i", "nly with various chunk sizes\nfor CHUNK, BLOCK, NW in [(16384, 4096, 16), (65536, 8192, 32), (65536, 4096, 16), (131072, 8192, 32), (262144, 8192, 32)]:\n    NCHUNK = N // CHUNK\n    psum = torch.empty(rows * NCHUNK, device=dev)\n    psq = torch.empty(rows * NCHUNK, device=dev)\n    def s_only():\n        _stats_kernel[(rows, NCHUNK)](x, psum, psq, N, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n    print(f\"stats CHUNK={CHUNK} BLOCK={BLOCK} NW={NW} blocks={rows*NCHUNK}: {loopbench(s_only):.4f} ms\")\n\n# apply only\nNCHUNK = 256\nNPOW = 256\npsum = torch.rand(rows * NCHUNK, device=dev)\npsq = torch.rand(rows * NCHUNK, device=dev) + 10\nfor CHUNK, BLOCK, NW in [(16384, 4096, 16), (65536, 8192, 32), (262144, 8192, 32)]:\n    ACHUNK = N // CHUNK\n    def a_only():\n        _apply_kernel[(rows, ACHUNK)](x, w, b, y, psum, psq, N, 1e-5, NCHUNK=NCHUNK, NPOW=NPOW, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n    print(f\"apply CHUNK={CHUNK} BLOCK={BLOCK} NW={NW} blocks={rows*ACHUNK}: {loopbench(a_only):.4f} ms\")\nPYEOF\npython3 /workspace/bench5."]
[1133.528254, "i", "py'\n"]
