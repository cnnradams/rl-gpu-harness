[871.856408, "i", "gpu exec sb-AVMTuQ7afCz75bOybMnBqs -- bash -c 'cat > /workspace/bench4.py << \"PYEOF\"\nimport torch, triton\nimport triton.language as tl\n\n@triton.jit\ndef _fused_kernel(X, W, B, Y, PSUM, PSQ, CNT, N, eps,\n                  NCHUNK: tl.constexpr, NPOW: tl.constexpr,\n                  TOTAL: tl.constexpr,\n                  CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    base = row * N + chunk * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        xx = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += xx\n        acc2 += xx * xx\n    tl.store(PSUM + row * NCHUNK + chunk, tl.sum(acc))\n    tl.store(PSQ + row * NCHUNK + chunk, tl.sum(acc2))\n    tl.debug_barrier()\n    tl.atomic_add(CNT, 1)\n    cnt = tl.atomic_add(CNT, 0)\n    while cnt < TOTAL:\n        cnt = tl.atomic_add(CNT, 0)\n    offs = tl.arange(0, NPOW)\n    mask = offs < NCHUNK\n    ps = tl.load(PSUM +"]
[871.856456, "i", " row * NCHUNK + offs, mask=mask, other=0.0)\n    ps2 = tl.load(PSQ + row * NCHUNK + offs, mask=mask, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(ps2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    xbase = row * N + chunk * CHUNK\n    wbase = chunk * CHUNK\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        xx = tl.load(X + xbase + idx)\n        ww = tl.load(W + wbase + idx)\n        bb = tl.load(B + wbase + idx)\n        tl.store(Y + xbase + idx, (xx - mean) * rstd * ww + bb)\n\ndev = \"cuda\"\nN = 64 * 256 * 256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\ncache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.float32, device=dev)\n\ndef loopbench(fn, iters=300):\n    fn()\n    torch.cuda.synchronize()\n    s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters):\n        fn()\n    e.record()\n    torch.cuda.synchronize()\n    return s.ela"]
[871.856462, "i", "psed_time(e) / iters\n\ndef coldbench(fn, n=30):\n    for _ in range(10):\n        fn()\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        s, e = torch.cuda.Event(True), torch.cuda.Event(True)\n        cache.zero_()\n        torch.cuda.synchronize()\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2]\n\nimport torch.nn.functional as F\nfor CHUNK, BLOCK, NW in [(16384, 4096, 16), (8192, 4096, 16), (32768, 4096, 16), (16384, 8192, 32)]:\n    NCHUNK = N // CHUNK\n    NPOW = triton.next_power_of_2(NCHUNK)\n    TOTAL = rows * NCHUNK\n    psum = torch.empty(rows * NCHUNK, device=dev)\n    psq = torch.empty(rows * NCHUNK, device=dev)\n    cnt = torch.zeros(1, dtype=torch.int32, device=dev)\n    def run():\n        cnt.zero_()\n        _fused_kernel[(rows, NCHUNK)](x, w, b, y, psum, psq, cnt, N, 1e-5,\n            NCHUNK=NCHUNK, NPOW=NPOW, TOTAL=TOTAL, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n "]
[871.856473, "i", "   run()\n    torch.cuda.synchronize()\n    ref = F.layer_norm(x, (N,), w, b, 1e-5)\n    md = (y - ref).abs().max().item()\n    t1 = loopbench(run)\n    t2 = coldbench(run)\n    print(f\"CHUNK={CHUNK} BLOCK={BLOCK} NW={NW}: loop {t1:.4f} cold {t2:.4f} diff {md:.2e}\")\nPYEOF\npython3 /workspace/bench4.py'\n"]
