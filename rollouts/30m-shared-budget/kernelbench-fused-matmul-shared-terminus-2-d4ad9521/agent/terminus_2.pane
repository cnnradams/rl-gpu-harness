[?2004l[?2004h>         linear = nn.Linear(in_features, out_features)
[?2004l[?2004h>         scale = 1.0 + float(scaling_factor)
[?2004l[?2004h>         with torch.no_grad():
[?2004l[?2004h>             w = (linear.weight * scale).contiguous()
[?2004l[?2004h>             b = (linear.bias * scale).contiguous()
[?2004l[?2004h>         # Registered as buffers so .to(device=..., dtype=...) moves them.
[?2004l[?2004h>         self.register_buffer("scaled_weight", w)
[?2004l[?2004h>         self.register_buffer("scaled_bias", b)
[?2004l[?2004h> 
