[?2004l, mask=m_mask[:, None] & n_mask[None, :])


class ModelNew(nn.Module):
    """
    Optimized reference model: out = (1 + scaling) * (x @ W^T + b)

    The (1 + scaling) factor is folded into precomputed weights/bias.
    The GEMM runs on fp16 tensor cores with error compensation
    (Ootomo-style split): each fp32 operand is split as hi + lo fp16,
    and out ~= xh@Wh + xh@Wl + xl@Wh accumulated in fp32.
    """

    def __init__(self, in_features, out_features, scaling_factor):
        super(ModelNew, self).__init__()
        linear = nn.Linear(in_features, out_features)
        scale = 1.0 + float(scaling_factor)
        with torch.no_grad():
            w = (linear.weight * scale).contiguous()
            b = (linear.bias * scale).contiguous()
            wh = w.half()
            wl = (w - wh.float()).half()
        self.register_buffer("w_hi", wh.contiguous())
        self.register_buffer("w_lo", wl.contiguous())
        self.register_buffer("bias", b)
        self.out_features = out_features
        self.in_features = in_features

    def forward(self, x):
        w_hi = self.w_hi
        bias = self.bias
        if x.device != w_hi.device or x.dtype != torch.float32:
            return torch.addmm(
                bias.to(x.dtype), x, (w_hi.float() + self.w_lo.float()).t().to(x.dtype)
            )

        M, K = x.shape
        N = self.out_features

        out = torch.empty((M, N), device=x.device, dtype=torch.float32)

        BLOCK_M = 128
        BLOCK_N = 128
        BLOCK_K = 64
        grid = (triton.cdiv(M, BLOCK_M), triton.cdiv(N, BLOCK_N))
        _split_gemm_kernel[grid](
            x, w_hi, self.w_lo, bias, out,
            M, N, K,
            x.stride(0), x.stride(1),
            w_hi.stride(0), w_hi.stride(1),
            out.stride(0), out.stride(1),
            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K,
            EVEN_K=(K % BLOCK_K == 0),
            num_warps=8, num_stages=3,
        )
        return out
