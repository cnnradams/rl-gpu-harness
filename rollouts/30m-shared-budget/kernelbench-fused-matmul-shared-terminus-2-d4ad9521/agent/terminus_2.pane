[?2004l[?2004h>         self.register_buffer("w_hi_i16", wh.contiguous().view(torch.int16))
[?2004l[?2004h>         self.register_buffer("w_lo_i16", wl.contiguous().view(torch.int16))
[?2004l[?2004h>         self.register_buffer("bias", b)
