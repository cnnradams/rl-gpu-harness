[304.143193, "o", "\u001b[?2004h> "]
[304.143283, "o", "                bias.to(x.dtype), x, (w_hi.float() + self.w_lo.float()).t().to(x.dtype)\r\n\u001b[?2004l\r"]
[304.14331, "o", "\u001b[?2004h> "]
[304.143337, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[304.143366, "o", "\u001b[?2004h> "]
[304.14339, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.14342, "o", "        N = self.out_features\r\n\u001b[?2004l\r"]
[304.143447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[304.143471, "o", ">         xh = x.half()\r\n\u001b[?2004l\r"]
[304.1435, "o", "\u001b[?2004h> "]
[304.143539, "o", "        xl = (x - xh.float()).half()\r\n\u001b[?2004l\r"]
[304.143567, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[304.143595, "o", "> "]
[304.143648, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[304.143677, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.143709, "o", "        BLOCK_M = 128\r\n\u001b[?2004l\r"]
[304.143736, "o", "\u001b[?2004h> "]
[304.143763, "o", "        BLOCK_N = 128\r\n\u001b[?2004l\r\u001b[?2004h> "]
