[304.141228, "o", "\u001b[?2004h> "]
[304.141289, "o", "    Optimized reference model: out = (1 + scaling) * (x @ W^T + b)\r\n\u001b[?2004l\r"]
[304.141312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[304.141337, "o", "> "]
[304.141397, "o", "    The (1 + scaling) factor is folded into precomputed weights/bias.\r\n\u001b[?2004l\r"]
[304.141422, "o", "\u001b[?2004h> "]
[304.141481, "o", "    The GEMM runs on fp16 tensor cores with error compensation\r\n\u001b[?2004l\r"]
[304.141505, "o", "\u001b[?2004h> "]
[304.141572, "o", "    (Ootomo-style split): each fp32 operand is split as hi + lo fp16,\r\n\u001b[?2004l\r"]
[304.141598, "o", "\u001b[?2004h> "]
[304.141651, "o", "    and out ~= xh@Wh + xh@Wl + xl@Wh accumulated in fp32.\r\n\u001b[?2004l\r"]
[304.141675, "o", "\u001b[?2004h> "]
[304.14174, "o", "    Relative error ~1e-6, far inside the 1e-4 evaluation tolerance.\r\n\u001b[?2004l\r"]
[304.141762, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[304.141787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[304.141815, "o", "> "]
[304.141871, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[304.141895, "o", "\u001b[?2004h> "]
[304.141932, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[304.141957, "o", "\u001b[?2004h> "]
[304.142006, "o", "        linear = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[304.14203, "o", "\u001b[?2004h> "]
[304.142071, "o", "        scale = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r"]
[304.142099, "o", "\u001b[?2004h> "]
[304.142127, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[304.142152, "o", "\u001b[?2004h> "]
