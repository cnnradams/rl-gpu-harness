[304.143819, "o", "\u001b[?2004h> "]
[304.143879, "o", "        grid = (triton.cdiv(M, BLOCK_M), triton.cdiv(N, BLOCK_N))\r\n\u001b[?2004l\r"]
[304.143904, "o", "\u001b[?2004h> "]
[304.143933, "o", "        _split_gemm_kernel[grid](\r\n\u001b[?2004l\r"]
[304.143957, "o", "\u001b[?2004h> "]
[304.144004, "o", "            x, xh, xl, w_hi, self.w_lo, bias, out,\r\n\u001b[?2004l\r"]
[304.144028, "o", "\u001b[?2004h> "]
[304.144048, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.144073, "o", "> "]
[304.144101, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[304.144125, "o", "\u001b[?2004h> "]
[304.144161, "o", "            xh.stride(0), xh.stride(1),\r\n\u001b[?2004l\r"]
[304.144185, "o", "\u001b[?2004h> "]
[304.144221, "o", "            xl.stride(0), xl.stride(1),\r\n\u001b[?2004l\r"]
[304.144245, "o", "\u001b[?2004h> "]
[304.144289, "o", "            w_hi.stride(0), w_hi.stride(1),\r\n\u001b[?2004l\r"]
[304.14431, "o", "\u001b[?2004h> "]
[304.144354, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[304.144379, "o", "\u001b[?2004h> "]
[304.144438, "o", "            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K,\r\n\u001b[?2004l\r"]
[304.144466, "o", "\u001b[?2004h> "]
[304.144498, "o", "            EVEN_K=(K % BLOCK_K == 0),\r\n\u001b[?2004l\r"]
[304.144521, "o", "\u001b[?2004h> "]
[304.144562, "o", "            num_warps=8, num_stages=4,\r\n\u001b[?2004l\r"]
[304.144586, "o", "\u001b[?2004h> "]
[304.144609, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.144637, "o", "        return out\r\n\u001b[?2004l\r"]
[304.144662, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
