[782.054259, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[782.054318, "o", "from reference import Model, get_init_inputs\r\n\u001b[?2004l\r\u001b[?2004h"]
[782.054345, "o", "> "]
