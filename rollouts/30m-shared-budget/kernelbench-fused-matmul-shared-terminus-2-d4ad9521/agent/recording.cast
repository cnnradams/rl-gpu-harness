[304.142884, "o", "        w_hi = self.w_hi\r\n\u001b[?2004l\r"]
[304.142911, "o", "\u001b[?2004h> "]
[304.142932, "o", "        bias = self.bias\r\n\u001b[?2004l\r"]
[304.142959, "o", "\u001b[?2004h> "]
[304.143019, "o", "        if x.device != w_hi.device or x.dtype != torch.float32:\r\n\u001b[?2004l\r"]
