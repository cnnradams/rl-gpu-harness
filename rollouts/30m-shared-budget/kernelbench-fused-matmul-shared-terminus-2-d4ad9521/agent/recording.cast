[633.959123, "o", "> "]
[633.959148, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[633.959185, "o", "        w_hi = self.w_hi\r\n\u001b[?2004l\r"]
[633.959213, "o", "\u001b[?2004h> "]
[633.959237, "o", "        bias = self.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[633.959313, "o", "        if x.device != w_hi.device or x.dtype != torch.float32:\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.959341, "o", "> "]
[633.959374, "o", "            return torch.addmm(\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.9594, "o", "> "]
[633.959479, "o", "                bias.to(x.dtype), x, (w_hi.float() + self.w_lo.float()).t().to(x.dtype)\r\n\u001b[?2004l\r"]
[633.959509, "o", "\u001b[?2004h> "]
[633.959537, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[633.959565, "o", ">         M, K = x.shape\r\n"]
[633.959594, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[633.959624, "o", "        N = self.out_features\r\n\u001b[?2004l\r"]
[633.959648, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
