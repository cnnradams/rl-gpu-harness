[782.055025, "o", "> "]
[782.055095, "o", "    (256,128,64,8,3,8),(256,128,64,8,3,4),(256,128,64,8,4,8),(256,128,32,8,3,8),\r\n\u001b[?2004l\r"]
[782.055125, "o", "\u001b[?2004h> "]
