[964.063446, "o", "request ID: f373327ae8e84029afb048a999113267\r\n"]
[970.032601, "o", "box: sb-KwB7P2OgLHZNzTY6Z3LIcA\r\ncommand: fb8a029ef08a4a418f5cf1af95980fe3\r\n"]
[980.817236, "o", "BM256 BN128 BK32 w8 s3 g8: 2.618 ms maxdiff 4.27e-05 ok=True\r\nBM256 BN128 BK32 w8 s4 g8: 2.634 ms maxdiff 4.27e-05 ok=True\r\nBM256 BN128 BK32 w8 s5 g8: FAIL OutOfResources\r\nBM256 BN128 BK32 w8 s6 g8: FAIL OutOfResources\r\nBM128 BN128 BK32 w8 s5 g8: 2.873 ms maxdiff 4.27e-05 ok=True\r\nBM128 BN128 BK32 w8 s6 g8: 2.883 ms maxdiff 4.27e-05 ok=True\r\nBM128 BN128 BK32 w8 s8 g8: FAIL OutOfResources\r\nBM256 BN128 BK64 w8 s3 g4: FAIL OutOfResources\r\nBM256 BN128 BK64 w8 s3 g16: FAIL OutOfResources\r\nBM128 BN128 BK64 w8 s3 g4: 2.622 ms maxdiff 4.27e-05 ok=True\r\nBM256 BN64 BK64 w8 s3 g8: FAIL OutOfResources\r\nBM64 BN128 BK64 w8 s3 g8: 12.873 ms maxdiff 4.27e-05 ok=True\r\nBM128 BN64 BK64 w8 s3 g8: 3.227 ms maxdiff 4.27e-05 ok=True\r\nBM64 BN256 BK64 w8 s3 g8: 12.839 ms maxdiff 4.27e-05 ok=True\r\n"]
[985.169203, "o", "\u001b[?2004hroot@modal:/# "]
[1049.795389, "i", "python3 - << 'PYEOF'\nimport base64\ncode = r'''\nimport sys\nsys.path.insert(0, \"/opt/task\")\nimport torch, triton\nimport triton.language as tl\n\ndef timeit(fn, n=10):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize(); ts.append(s.elapsed_time(e))\n    return min(ts)\n\nM, K, N = 16384, 4096, 4096\nxh = torch.randn(M, K, device=\"cuda\").half()\nwh = (torch.randn(N, K, device=\"cuda\")*0.01).half()\nwht = wh.t().contiguous()\nprint(\"cublas fp16 mm 137GF:\", timeit(lambda: torch.mm(xh, wht)), \"ms\")\n\n@triton.jit\ndef _gemm_dual(\n    xh_ptr, xl_ptr, wh_ptr, wl_ptr, b_ptr, out_ptr,\n    M, N, K,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group"]
[1049.79544, "i", "_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    m_mask = offs_m < M\n    n_mask = offs_n < N\n    xh_ptrs = xh_ptr + offs_m[:, None] * K + offs_k[None, :]\n    xl_ptrs = xl_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_n[:, None] * K + offs_k[None, :]\n    wl_ptrs = wl_ptr + offs_n[:, None] * K + offs_k[None, :]\n    acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k0 in range(0, K, BLOCK_K):\n        a = tl.load(xh_ptrs, mask=m_mask[:, None], other=0.0)\n        c = tl.load(xl_ptrs, mask=m_mask[:, None], other=0.0)\n        d = tl.load(wh_ptrs, mask=n_mask[:, None], other=0.0)\n        "]
[1049.795587, "i", "f = tl.load(wl_ptrs, mask=n_mask[:, None], other=0.0)\n        acc1 = tl.dot(a, tl.trans(d), acc1)\n        acc2 = tl.dot(a, tl.trans(f), acc2)\n        acc2 = tl.dot(c, tl.trans(d), acc2)\n        xh_ptrs += BLOCK_K\n        xl_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K\n        wl_ptrs += BLOCK_K\n    acc = acc1 + acc2\n    bias = tl.load(b_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\n\nfrom reference import Model, get_init_inputs\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).cuda().eval()\nx = torch.rand(M, K, device=\"cuda\")\nwith torch.no_grad():\n    o_ref = ref(x)\nw = (ref.matmul.weight * 1.5).contiguous()\nb = (ref.matmul.bias * 1.5).contiguous()\nwh2 = w.half().contiguous(); wl2 = (w - wh2.float()).half().contiguous()\nxh2 = x.half(); xl2 = (x - xh2.float()).half()\n\ncfgs = [(128,128,64,8,3,8),(128,128,64,8,4,8),(128,128,32,8,4,8),(64,128,64,8"]
[1049.795598, "o", "python3 - << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.79564, "i", ",4,8),(128,64,64,8,4,8)]\nfor (bm,bn,bk,warps,stages,gm) in cfgs:\n    out = torch.empty((M,N), device=\"cuda\", dtype=torch.float32)\n    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\n    def run():\n        _gemm_dual[grid](xh2, xl2, wh2, wl2, b, out, M, N, K,\n            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=warps, num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        md = (out - o_ref).abs().max().item()\n        ok = torch.allclose(out, o_ref, atol=1e-4, rtol=1e-4)\n        t = timeit(run)\n        print(\"DUAL BM%d BN%d BK%d w%d s%d g%d: %.3f ms maxdiff %.2e ok=%s\" % (bm,bn,bk,warps,stages,gm,t,md,ok))\n    except Exception as ex:\n        print(\"DUAL BM%d BN%d BK%d w%d s%d g%d: FAIL %s\" % (bm,bn,bk,warps,stages,gm,type(ex).__name__))\n'''\nopen(\"/workspace/sweep5.py\",\"w\").write(code)\nprint(\"written\", len(code))\nPYEOF\n"]
