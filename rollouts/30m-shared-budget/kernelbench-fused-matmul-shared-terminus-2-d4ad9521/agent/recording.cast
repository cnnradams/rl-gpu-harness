[310.650535, "i", "cat > /workspace/test_local.py << 'EOF'\nimport sys, time\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nimport torch\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).cuda().eval()\ntorch.manual_seed(42)\nnew = ModelNew(*get_init_inputs()).cuda().eval()\n\nfor t in range(3):\n    torch.manual_seed(1000 + t)\n    x = torch.rand(16384, 4096, device='cuda')\n    with torch.no_grad():\n        o1 = ref(x)\n        o2 = new(x)\n    md = (o1 - o2).abs().max().item()\n    ok = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\n    print(f'trial {t}: max_diff={md:.3e} allclose={ok}')\n\n# timing\nwith torch.no_grad():\n    for m, name in ((ref, 'ref'), (new, 'new')):\n        x = torch.rand(16384, 4096, device='cuda')\n        for _ in range(5):\n            m(x)\n        torch.cuda.synchronize()\n        times = []\n        for _ in range(20):\n            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=Tru"]
[310.650666, "i", "e)\n            s.record(); m(x); e.record()\n            torch.cuda.synchronize()\n            times.append(s.elapsed_time(e))\n        times.sort()\n        print(name, 'mean ms:', sum(times)/len(times), 'min:', times[0])\nEOF\n"]
