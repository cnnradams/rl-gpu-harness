[1049.796778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.796807, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1049.796829, "o", "\u001b[?2004h> "]
[1049.796855, "o", "def _gemm_dual(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.796918, "o", "    xh_ptr, xl_ptr, wh_ptr, wl_ptr, b_ptr, out_ptr,\r\n\u001b[?2004l\r"]
[1049.796947, "o", "\u001b[?2004h> "]
[1049.796968, "o", "    M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.79705, "o", "    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[1049.79708, "o", "\u001b[?2004h> "]
[1049.797108, "o", "    GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r"]
[1049.797132, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.797163, "o", "> "]
[1049.797186, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.797228, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1049.797253, "o", "\u001b[?2004h> "]
[1049.797289, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1049.797316, "o", "\u001b[?2004h> "]
[1049.797355, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[1049.797378, "o", "\u001b[?2004h> "]
[1049.797422, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1049.797453, "o", "\u001b[?2004h> "]
[1049.797487, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[1049.797513, "o", "\u001b[?2004h> "]
[1049.797573, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.79766, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1049.79769, "o", "\u001b[?2004h> "]
[1049.797743, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.79777, "o", "> "]
[1049.797824, "o", "    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[1049.797855, "o", "\u001b[?2004h> "]
[1049.797903, "o", "    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1049.797931, "o", "\u001b[?2004h> "]
[1049.797992, "o", "    offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.79802, "o", "    m_mask = offs_m < M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.798049, "o", "    n_mask = offs_n < N\r\n\u001b[?2004l\r"]
[1049.798078, "o", "\u001b[?2004h> "]
[1049.79813, "o", "    xh_ptrs = xh_ptr + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1049.798152, "o", "\u001b[?2004h> "]
[1049.798218, "o", "    xl_ptrs = xl_ptr + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1049.798245, "o", "\u001b[?2004h> "]
[1049.798318, "o", "    wh_ptrs = wh_ptr + offs_n[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1049.798346, "o", "\u001b[?2004h> "]
[1049.798409, "o", "    wl_ptrs = wl_ptr + offs_n[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.798435, "o", "> "]
[1049.798485, "o", "    acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1049.798513, "o", "\u001b[?2004h> "]
[1049.798571, "o", "    acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1049.798599, "o", "\u001b[?2004h> "]
[1049.798622, "o", "    for k0 in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r"]
[1049.798643, "o", "\u001b[?2004h> "]
[1049.798707, "o", "        a = tl.load(xh_ptrs, mask=m_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[1049.798734, "o", "\u001b[?2004h> "]
[1049.798798, "o", "        c = tl.load(xl_ptrs, mask=m_mask[:, None], other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.798873, "o", "        d = tl.load(wh_ptrs, mask=n_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[1049.798902, "o", "\u001b[?2004h> "]
[1049.798963, "o", "        f = tl.load(wl_ptrs, mask=n_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[1049.798989, "o", "\u001b[?2004h> "]
[1049.799027, "o", "        acc1 = tl.dot(a, tl.trans(d), acc1)\r\n\u001b[?2004l\r"]
[1049.799051, "o", "\u001b[?2004h> "]
[1049.799088, "o", "        acc2 = tl.dot(a, tl.trans(f), acc2)\r\n\u001b[?2004l\r"]
[1049.799116, "o", "\u001b[?2004h> "]
[1049.799161, "o", "        acc2 = tl.dot(c, tl.trans(d), acc2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.799186, "o", "> "]
[1049.799211, "o", "        xh_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.799239, "o", "> "]
[1049.799266, "o", "        xl_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.799297, "o", "        wh_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[1049.799325, "o", "\u001b[?2004h> "]
[1049.799353, "o", "        wl_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.79938, "o", "> "]
[1049.799408, "o", "    acc = acc1 + acc2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.799489, "o", "    bias = tl.load(b_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[1049.799517, "o", "\u001b[?2004h> "]
[1049.799545, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.79957, "o", "> "]
[1049.799625, "o", "    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1049.79965, "o", "\u001b[?2004h> "]
[1049.799716, "o", "    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r"]
[1049.799755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.799809, "o", "from reference import Model, get_init_inputs\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.799837, "o", "> "]
[1049.799864, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.799913, "o", "ref = Model(*get_init_inputs()).cuda().eval()\r\n\u001b[?2004l\r"]
[1049.799941, "o", "\u001b[?2004h> "]
[1049.799977, "o", "x = torch.rand(M, K, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1049.800005, "o", "\u001b[?2004h> "]
[1049.800033, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.80006, "o", "    o_ref = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.800087, "o", "> "]
[1049.800114, "o", "w = (ref.matmul.weight * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[1049.800142, "o", "\u001b[?2004h> "]
[1049.800171, "o", "b = (ref.matmul.bias * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[1049.800198, "o", "\u001b[?2004h> "]
[1049.800271, "o", "wh2 = w.half().contiguous(); wl2 = (w - wh2.float()).half().contiguous()\r\n\u001b[?2004l\r"]
[1049.800298, "o", "\u001b[?2004h> "]
[1049.800334, "o", "xh2 = x.half(); xl2 = (x - xh2.float()).half()\r\n\u001b[?2004l\r"]
[1049.80036, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.800483, "o", "cfgs = [(128,128,64,8,3,8),(128,128,64,8,4,8),(128,128,32,8,4,8),(64,128,64,8,4,8),(128,64,64,8,4,8)]\r\n\u001b[?2004l\r"]
[1049.800512, "o", "\u001b[?2004h> "]
[1049.80054, "o", "for (bm,bn,bk,warps,stages,gm) in cfgs:\r\n\u001b[?2004l\r"]
[1049.800567, "o", "\u001b[?2004h> "]
[1049.800631, "o", "    out = torch.empty((M,N), device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1049.800659, "o", "\u001b[?2004h> "]
[1049.800702, "o", "    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\r\n\u001b[?2004l\r"]
[1049.80073, "o", "\u001b[?2004h> "]
[1049.800756, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.800821, "o", "        _gemm_dual[grid](xh2, xl2, wh2, wl2, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[1049.800843, "o", "\u001b[?2004h> "]
[1049.800944, "o", "            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[1049.80097, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.800996, "o", "> "]
[1049.801023, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1049.80105, "o", "\u001b[?2004h> "]
[1049.80109, "o", "        md = (out - o_ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1049.801118, "o", "\u001b[?2004h> "]
[1049.80118, "o", "        ok = torch.allclose(out, o_ref, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.801205, "o", "> "]
[1049.80123, "o", "        t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.801364, "o", "        print(\"DUAL BM%d BN%d BK%d w%d s%d g%d: %.3f ms maxdiff %.2e ok=%s\" % (bm,bn,bk,warps,stages,gm,t,md,ok))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.801393, "o", "> "]
[1049.80142, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.801544, "o", "        print(\"DUAL BM%d BN%d BK%d w%d s%d g%d: FAIL %s\" % (bm,bn,bk,warps,stages,gm,type(ex).__name__))\r\n\u001b[?2004l\r"]
[1049.801572, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h"]
[1049.8016, "o", "> "]
[1049.801633, "o", "open(\"/workspace/sweep5.py\",\"w\").write(code)\r\n\u001b[?2004l\r"]
[1049.80166, "o", "\u001b[?2004h> "]
[1049.801686, "o", "print(\"written\", len(code))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1049.801712, "o", "PYEOF\r\n\u001b[?2004l\r"]
[1049.840107, "o", "written 3807\r\n"]
[1049.842663, "o", "\u001b[?2004hroot@modal:/# "]
[1051.79583, "i", "gpu sync && gpu run -- python3 /workspace/sweep5.py\n"]
[1051.796041, "o", "gpu sync && gpu run -- python3 /workspace/sweep5.py\r\n\u001b[?2004l\r"]
