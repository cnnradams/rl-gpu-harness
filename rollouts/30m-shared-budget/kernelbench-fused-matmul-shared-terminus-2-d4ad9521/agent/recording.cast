[877.845629, "o", "\u001b[?2004h> "]
[877.845649, "o", "        times=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[877.845686, "o", "        for _ in range(10):\r\n\u001b[?2004l\r"]
[877.845711, "o", "\u001b[?2004h> "]
[877.845798, "o", "            s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[877.845823, "o", "\u001b[?2004h> "]
[877.845887, "o", "            s.record(); run(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[877.845912, "o", "\u001b[?2004h> "]
[877.845951, "o", "            times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[877.845975, "o", "\u001b[?2004h> "]
