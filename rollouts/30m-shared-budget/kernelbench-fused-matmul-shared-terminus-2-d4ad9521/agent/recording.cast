[877.843119, "o", "ref = Model(*get_init_inputs()).cuda().eval()\r\n\u001b[?2004l\r"]
[877.843145, "o", "\u001b[?2004h> "]
[877.84317, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
