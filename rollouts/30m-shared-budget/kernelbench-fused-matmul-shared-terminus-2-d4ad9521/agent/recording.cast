[633.957602, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.957628, "o", "> "]
[633.9577, "o", "    Optimized reference model: out = (1 + scaling) * (x @ W^T + b)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[633.957733, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[633.957803, "o", "    The (1 + scaling) factor is folded into precomputed weights/bias.\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.957827, "o", "> "]
[633.957889, "o", "    The GEMM runs on fp16 tensor cores with error compensation\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.957918, "o", "> "]
[633.95798, "o", "    (Ootomo-style split): each fp32 operand is split as hi + lo fp16,\r\n\u001b[?2004l\r"]
[633.958009, "o", "\u001b[?2004h> "]
[633.958061, "o", "    and out ~= xh@Wh + xh@Wl + xl@Wh accumulated in fp32.\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.95809, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[633.958112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[633.95814, "o", "> "]
[633.958199, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[633.958223, "o", "\u001b[?2004h> "]
[633.958264, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.958294, "o", "> "]
[633.958339, "o", "        linear = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[633.958382, "o", "\u001b[?2004h> "]
[633.95841, "o", "        scale = 1.0 + float(scaling_factor)\r\n"]
[633.958434, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[633.958467, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[633.958496, "o", "\u001b[?2004h> "]
[633.958547, "o", "            w = (linear.weight * scale).contiguous()\r\n\u001b[?2004l\r"]
[633.958577, "o", "\u001b[?2004h> "]
[633.958622, "o", "            b = (linear.bias * scale).contiguous()\r\n\u001b[?2004l\r"]
[633.958647, "o", "\u001b[?2004h> "]
[633.958675, "o", "            wh = w.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.958704, "o", "> "]
[633.958728, "o", "            wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.958757, "o", "> "]
[633.958801, "o", "        self.register_buffer(\"w_hi\", wh.contiguous())\r\n\u001b[?2004l\r"]
[633.95883, "o", "\u001b[?2004h> "]
[633.958877, "o", "        self.register_buffer(\"w_lo\", wl.contiguous())\r\n\u001b[?2004l\r"]
[633.958902, "o", "\u001b[?2004h> "]
