[92.071163, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\n\nclass ModelNew(nn.Module):\n    \"\"\"\n    Optimized version of the reference model.\n\n    Reference: x -> Linear(x) -> clone -> *scaling -> +original\n    Mathematically: out = (1 + scaling) * (x @ W^T + b)\n    We fold the scale into precomputed weights/bias, so the forward is a\n    single GEMM (addmm). TF32 is enabled locally for the matmul only.\n    \"\"\"\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        linear = nn.Linear(in_features, out_features)\n        scale = 1.0 + float(scaling_factor)\n        with torch.no_grad():\n            w = (linear.weight * scale).contiguous()\n            b = (linear.bias * scale).contiguous()\n        # Registered as buffers so .to(device=..., dtype=...) moves them.\n        self.register_buffer(\"scaled_weight\", w)\n        self.register_buffer(\"scaled_bias\", b)\n\n    def forward(self, x):\n        prev = torch.backe"]
[92.071217, "i", "nds.cuda.matmul.allow_tf32\n        torch.backends.cuda.matmul.allow_tf32 = True\n        try:\n            out = F.linear(x, self.scaled_weight, self.scaled_bias)\n        finally:\n            torch.backends.cuda.matmul.allow_tf32 = prev\n        return out\nEOF\n"]
