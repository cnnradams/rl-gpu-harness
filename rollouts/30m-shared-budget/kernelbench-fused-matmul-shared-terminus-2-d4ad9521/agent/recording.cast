[961.373374, "o", "    wl_ptrs = wl_ptr + offs_n[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[961.37342, "o", "\u001b[?2004h> "]
[961.373459, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[961.3735, "o", "\u001b[?2004h> "]
[961.373541, "o", "    for k0 in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.373595, "o", "        xh = tl.load(xh_ptrs, mask=m_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[961.373635, "o", "\u001b[?2004h> "]
[961.373677, "o", "        xl = tl.load(xl_ptrs, mask=m_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[961.373718, "o", "\u001b[?2004h> "]
[961.373766, "o", "        wh = tl.load(wh_ptrs, mask=n_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[961.373806, "o", "\u001b[?2004h> "]
[961.373849, "o", "        wl = tl.load(wl_ptrs, mask=n_mask[:, None], other=0.0)\r\n\u001b[?2004l\r"]
[961.373891, "o", "\u001b[?2004h>         wht = tl.trans(wh)\r\n\u001b[?2004l\r"]
[961.373935, "o", "\u001b[?2004h> "]
[961.373977, "o", "        wlt = tl.trans(wl)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374, "o", "        acc = tl.dot(xh, wlt, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[961.374043, "o", ">         acc = tl.dot(xl, wht, acc)\r\n\u001b[?2004l\r"]
[961.374062, "o", "\u001b[?2004h> "]
[961.374105, "o", "        acc = tl.dot(xh, wht, acc)\r\n\u001b[?2004l\r"]
[961.374148, "o", "\u001b[?2004h>         xh_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[961.374187, "o", "\u001b[?2004h> "]
[961.374229, "o", "        xl_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374269, "o", "        wh_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374309, "o", "        wl_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.37438, "o", "    bias = tl.load(b_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[961.374405, "o", "\u001b[?2004h> "]
[961.374439, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[961.374479, "o", "\u001b[?2004h> "]
[961.374519, "o", "    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[961.374557, "o", "\u001b[?2004h> "]
[961.374611, "o", "    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r"]
[961.374651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374691, "o", "from reference import Model, get_init_inputs\r\n\u001b[?2004l\r"]
[961.374729, "o", "\u001b[?2004h> "]
[961.374768, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374808, "o", "ref = Model(*get_init_inputs()).cuda().eval()\r\n\u001b[?2004l\r\u001b[?2004h"]
[961.374847, "o", "> "]
[961.374884, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374924, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.374963, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[961.375002, "o", ">     o_ref = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[961.375041, "o", "> "]
[961.375079, "o", "w = (ref.matmul.weight * 1.5).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.375118, "o", "b = (ref.matmul.bias * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[961.375162, "o", "\u001b[?2004h> "]
[961.375211, "o", "wh = w.half().contiguous(); wl = (w - wh.float()).half().contiguous()\r\n\u001b[?2004l\r"]
[961.375251, "o", "\u001b[?2004h> "]
[961.375298, "o", "xh_buf = torch.empty((M, K), device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[961.375337, "o", "\u001b[?2004h> "]
[961.375389, "o", "xl_buf = torch.empty((M, K), device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[961.375431, "o", "\u001b[?2004h> "]
[961.375463, "o", "grid_prep = (triton.cdiv(M*K, 16384),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.37555, "o", "_split_kernel[grid_prep](x, xh_buf, xl_buf, M*K, BLOCK=16384, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[961.37559, "o", "> torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[961.375632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> configs = [\r\n\u001b[?2004l\r"]
[961.375651, "o", "\u001b[?2004h> "]
[961.375746, "o", "    (256,128,32,8,3,8),(256,128,32,8,4,8),(256,128,32,8,5,8),(256,128,32,8,6,8),\r\n\u001b[?2004l\r"]
[961.375759, "o", "\u001b[?2004h> "]
[961.375829, "o", "    (128,128,32,8,5,8),(128,128,32,8,6,8),(128,128,32,8,8,8),\r\n\u001b[?2004l\r"]
[961.37587, "o", "\u001b[?2004h> "]
[961.37591, "o", "    (256,128,64,8,3,4),(256,128,64,8,3,16),(128,128,64,8,3,4),\r\n\u001b[?2004l\r"]
[961.375947, "o", "\u001b[?2004h> "]
[961.376011, "o", "    (256,64,64,8,3,8),(64,128,64,8,3,8),(128,64,64,8,3,8),(64,256,64,8,3,8),\r\n\u001b[?2004l\r"]
[961.376051, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.376095, "o", "for (bm,bn,bk,warps,stages,gm) in configs:\r\n\u001b[?2004l\r"]
[961.376134, "o", "\u001b[?2004h> "]
[961.376181, "o", "    out = torch.empty((M,N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[961.376221, "o", "\u001b[?2004h> "]
[961.37626, "o", "    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.376299, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.376369, "o", "        _gemm4[grid](xh_buf, xl_buf, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[961.376414, "o", "\u001b[?2004h> "]
[961.376505, "o", "            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, ORDER=0, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[961.376546, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.376593, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[961.376634, "o", "\u001b[?2004h> "]
[961.376673, "o", "        md = (out - o_ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.376743, "o", "        ok = torch.allclose(out, o_ref, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[961.376781, "o", "\u001b[?2004h> "]
[961.37682, "o", "        for _ in range(3): run()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.37686, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.3769, "o", "        times=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.376941, "o", "        for _ in range(10):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.377045, "o", "            s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[961.377084, "o", "> "]
[961.377131, "o", "            s.record(); run(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[961.37717, "o", "\u001b[?2004h> "]
[961.377209, "o", "            times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[961.377329, "o", "        print(f'BM{bm} BN{bn} BK{bk} w{warps} s{stages} g{gm}: {min(times):.3f} ms maxdiff {md:.2e} ok={ok}')\r\n\u001b[?2004l\r"]
[961.377344, "o", "\u001b[?2004h"]
[961.377378, "o", ">     except Exception as ex:\r\n\u001b[?2004l\r"]
[961.377425, "o", "\u001b[?2004h> "]
[961.377506, "o", "        print(f'BM{bm} BN{bn} BK{bk} w{warps} s{stages} g{gm}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[961.377546, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[961.404408, "o", "\u001b[?2004hroot@modal:/# "]
[961.670418, "i", "gpu sync && gpu run -- python3 /workspace/sweep4.py\n"]
[961.670608, "o", "gpu sync && gpu run -- python3 /workspace/sweep4.py\r\n\u001b[?2004l\r"]
