[877.838744, "i", "cat > /workspace/sweep3.py << 'EOF'\nimport sys\nsys.path.insert(0, '/opt/task')\nimport torch, triton\nimport triton.language as tl\n\n@triton.jit\ndef _split_kernel(x_ptr, xh_ptr, xl_ptr, M, K, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < M * K\n    xf = tl.load(x_ptr + offs, mask=mask, other=0.0)\n    xh = xf.to(tl.float16)\n    xl = (xf - xh.to(tl.float32)).to(tl.float16)\n    tl.store(xh_ptr + offs, xh, mask=mask)\n    tl.store(xl_ptr + offs, xl, mask=mask)\n\n@triton.jit\ndef _gemm4(\n    xh_ptr, xl_ptr, wh_ptr, wl_ptr, b_ptr, out_ptr,\n    M, N, K,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % "]
[877.838812, "i", "num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    m_mask = offs_m < M\n    n_mask = offs_n < N\n    xh_ptrs = xh_ptr + offs_m[:, None] * K + offs_k[None, :]\n    xl_ptrs = xl_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_n[:, None] * K + offs_k[None, :]\n    wl_ptrs = wl_ptr + offs_n[:, None] * K + offs_k[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k0 in range(0, K, BLOCK_K):\n        xh = tl.load(xh_ptrs, mask=m_mask[:, None], other=0.0)\n        xl = tl.load(xl_ptrs, mask=m_mask[:, None], other=0.0)\n        wh = tl.load(wh_ptrs, mask=n_mask[:, None], other=0.0)\n        wl = tl.load(wl_ptrs, mask=n_mask[:, None], other=0.0)\n        acc = tl.dot(xh, tl.trans(wl), acc)\n        acc = tl.dot(xl, tl.trans(wh), acc)\n        acc = tl.dot(xh, tl.trans(wh), acc)\n        xh_ptrs += BLOCK_K\n"]
[877.83882, "i", "        xl_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K\n        wl_ptrs += BLOCK_K\n    bias = tl.load(b_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\n\nfrom reference import Model, get_init_inputs\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).cuda().eval()\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nwith torch.no_grad():\n    o_ref = ref(x)\nw = (ref.matmul.weight * 1.5).contiguous()\nb = (ref.matmul.bias * 1.5).contiguous()\nwh = w.half().contiguous(); wl = (w - wh.float()).half().contiguous()\nxh_buf = torch.empty((M, K), device='cuda', dtype=torch.float16)\nxl_buf = torch.empty((M, K), device='cuda', dtype=torch.float16)\n\ndef prep():\n    grid = (triton.cdiv(M*K, 8192),)\n    _split_kernel[grid](x, xh_buf, xl_buf, M, K, BLOCK=8192, num_warps=8)\n\nconfigs = [\n    (128,128,64,8,3,8),(128,128,64,8,4,8),(256,128,64,8,3,8),(128,25"]
[877.838974, "i", "6,64,8,3,8),\n    (128,128,128,8,3,8),(256,128,32,8,4,8),(128,256,32,8,4,8),(128,128,64,8,5,8),\n    (64,256,64,4,4,8),(128,64,64,4,4,8),(256,64,64,8,4,8),(64,128,64,4,4,8),\n]\nprep(); torch.cuda.synchronize()\n# time prep alone\nfor _ in range(3): prep()\ntorch.cuda.synchronize()\ntt=[]\nfor _ in range(10):\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record(); prep(); e.record(); torch.cuda.synchronize(); tt.append(s.elapsed_time(e))\nprint(f'prep: {min(tt):.3f} ms')\n\nfor (bm,bn,bk,warps,stages,gm) in configs:\n    out = torch.empty((M,N), device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\n    def run():\n        _gemm4[grid](xh_buf, xl_buf, wh, wl, b, out, M, N, K,\n            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=warps, num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        md = (out - o_ref).abs().max().item()\n        ok = torch.allclose(out, o_ref, atol=1e-4, rtol=1e-4)\n        for _ in range(3):"]
[877.838987, "o", "cat > /workspace/sweep3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[877.839029, "i", " run()\n        torch.cuda.synchronize()\n        times=[]\n        for _ in range(10):\n            s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n            s.record(); run(); e.record(); torch.cuda.synchronize()\n            times.append(s.elapsed_time(e))\n        print(f'BM{bm} BN{bn} BK{bk} w{warps} s{stages} g{gm}: {min(times):.3f} ms maxdiff {md:.2e} ok={ok}')\n    except Exception as ex:\n        print(f'BM{bm} BN{bn} BK{bk} w{warps} s{stages} g{gm}: FAIL {type(ex).__name__}')\nEOF\n"]
