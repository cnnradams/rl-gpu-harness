[1455.811631, "o", "    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.811679, "o", "    GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r"]
[1455.811723, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.811812, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\r\n\r\n\u001b[?2004h"]
[1455.811851, "o", "> "]
[1455.811915, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1455.811956, "o", "\u001b[?2004h> "]
[1455.812023, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\rf"]
[1455.812063, "o", "\u001b[?2004h> "]
[1455.812142, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[1455.812181, "o", "\u001b[?2004h> "]
[1455.812248, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1455.812289, "o", "\u001b[?2004h> "]
[1455.812329, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[1455.81237, "o", "\u001b[?2004h> "]
[1455.812506, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[1455.812548, "o", "\u001b[?2004h> "]
[1455.812683, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1455.812724, "o", "\u001b[?2004h> "]
[1455.812825, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1455.812867, "o", "\u001b[?2004h> "]
[1455.812968, "o", "    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[1455.813011, "o", "\u001b[?2004h> "]
[1455.813111, "o", "    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1455.813151, "o", "\u001b[?2004h> "]
[1455.813223, "o", "    offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[1455.813247, "o", "\u001b[?2004h> "]
[1455.813368, "o", "    a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1455.813404, "o", "\u001b[?2004h> "]
[1455.813528, "o", "    b_ptrs = b_ptr + offs_n[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1455.813567, "o", "\u001b[?2004h> "]
[1455.813674, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1455.813692, "o", "\u001b[?2004h> "]
[1455.813768, "o", "    for k0 in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r"]
[1455.813802, "o", "\u001b[?2004h> "]
[1455.813869, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\rc\u001b[?2004h"]
[1455.813909, "o", "> "]
[1455.813952, "o", "        b = tl.load(b_ptrs)\r\n\u001b[?2004l\r"]
[1455.813977, "o", "\u001b[?2004h> "]
[1455.814075, "o", "        acc = tl.dot(a, tl.trans(b), acc)\r\n\u001b[?2004l\r"]
[1455.814114, "o", "\u001b[?2004h> "]
[1455.814157, "o", "        a_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[1455.814198, "o", "\u001b[?2004h> "]
[1455.814239, "o", "        b_ptrs += BLOCK_K"]
[1455.814281, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.814421, "o", "    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1455.81444, "o", "\u001b[?2004h> "]
[1455.814495, "o", "    tl.store(out_ptrs, acc.to(tl.float16))\r\n\u001b[?2004l\r"]
[1455.814535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.814575, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.814614, "o", "> "]
[1455.814654, "o", "a16 = torch.randn(M, K, device=\"cuda\").half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.814714, "o", "b16 = (torch.randn(N, K, device=\"cuda\")*0.01).half()\r\n\u001b[?2004l\r"]
[1455.814753, "o", "\u001b[?2004h> "]
[1455.814797, "o", "out16 = torch.empty(M, N, device=\"cuda\", dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.814835, "o", "> "]
[1455.814945, "o", "for (bm,bn,bk,warps,stages) in [(128,128,64,8,4),(256,128,64,8,3),(128,256,64,8,3),(128,128,128,8,3),(256,128,128,8,2)]:\r\n\u001b[?2004l\r"]
[1455.814986, "o", "\u001b[?2004h> "]
[1455.815025, "o", "    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.815066, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.815231, "o", "        _gemm_plain[grid](a16, b16, out16, M, N, K, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h>     try:"]
[1455.815272, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.815312, "o", "        t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.815421, "o", "        print(\"PLAIN BM%d BN%d BK%d w%d s%d: %.3f ms (%.0f TF)\" % (bm,bn,bk,warps,stages,t,2*M*N*K/t/1e9))\r\n\u001b[?2004l\r"]
[1455.815462, "o", "\u001b[?2004h>     except Exception as ex:\r\n\u001b[?2004l\r"]
[1455.815502, "o", "\u001b[?2004h> "]
[1455.815597, "o", "        print(\"PLAIN BM%d BN%d BK%d w%d s%d: FAIL %s\" % (bm,bn,bk,warps,stages,type(ex).__name__))\r\n\u001b[?2004l\r"]
[1455.815637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.815727, "o", "# concat-K approach: A3 = [xh|xl|xh] (M,3K), W3=[Wl|Wh|Wh] (N,3K), single gemm K3=12288\r\n\u001b[?2004l\r"]
[1455.815768, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.81581, "o", "> "]
[1455.815851, "o", "def _build_a3(x_ptr, a3_ptr, M, K, K3, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.815892, "o", ">     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1455.815932, "o", "\u001b[?2004h>     n = M * K\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.815965, "o", "> "]
[1455.816014, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816054, "o", "    mask = offs < n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816113, "o", "    xf = tl.load(x_ptr + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[1455.816153, "o", "\u001b[?2004h>     xh = xf.to(tl.float16)\r\n\u001b[?2004l\r"]
[1455.816192, "o", "\u001b[?2004h> "]
[1455.816232, "o", "    xl = (xf - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.816251, "o", "> "]
[1455.816289, "o", "    tl.store(a3_ptr + offs, xh, mask=mask)\r\n\u001b[?2004l\r"]
[1455.816329, "o", "\u001b[?2004h> "]
[1455.816369, "o", "    tl.store(a3_ptr + n + offs, xl, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816425, "o", "    tl.store(a3_ptr + 2 * n + offs, xh, mask=mask)\r\n\u001b[?2004l\r"]
[1455.816464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816512, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816551, "o", "def _gemm_concat(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816589, "o", "    a3_ptr, w3_ptr, b_ptr, out_ptr, M, N, K3,\r\n\u001b[?2004l\r"]
[1455.816628, "o", "\u001b[?2004h> "]
[1455.816689, "o", "    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[1455.81673, "o", "\u001b[?2004h>     GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r"]
[1455.816769, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816809, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1455.816849, "o", "\u001b[?2004h> "]
[1455.816889, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.816931, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1455.816972, "o", "\u001b[?2004h> "]
[1455.81701, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.817063, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.817102, "o", "> "]
[1455.817142, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.817194, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[1455.817234, "o", "\u001b[?2004h> "]
[1455.817281, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1455.817321, "o", "\u001b[?2004h> "]
[1455.817356, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1455.817397, "o", "\u001b[?2004h> "]
[1455.817434, "o", "    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.817474, "o", "> "]
[1455.817513, "o", "    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.817559, "o", "> "]
[1455.817601, "o", "    offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.817655, "o", "    a_ptrs = a3_ptr + offs_m[:, None] * K3 + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1455.817697, "o", "\u001b[?2004h> "]
[1455.81774, "o", "    b_ptrs = w3_ptr + offs_n[:, None] * K3 + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1455.817781, "o", "\u001b[?2004h> "]
[1455.817816, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1455.817856, "o", "\u001b[?2004h> "]
[1455.817898, "o", "    for k0 in range(0, K3, BLOCK_K):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.81794, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.817985, "o", "        b = tl.load(b_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.818027, "o", "> "]
[1455.818066, "o", "        acc = tl.dot(a, tl.trans(b), acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818105, "o", "        a_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.81815, "o", "        b_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818198, "o", "    bias = tl.load(b_ptr + offs_n).to(tl.float32)\r\n\u001b[?2004l\r"]
[1455.818241, "o", "\u001b[?2004h> "]
[1455.818281, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818339, "o", "    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.818358, "o", "> "]
[1455.818409, "o", "    tl.store(out_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818466, "o", "from reference import Model, get_init_inputs\r\n\u001b[?2004l\r"]
[1455.818509, "o", "\u001b[?2004h> torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[1455.818549, "o", "\u001b[?2004h> "]
[1455.81859, "o", "ref = Model(*get_init_inputs()).cuda().eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818629, "o", "x = torch.rand(M, K, device=\"cuda\")\r\n\u001b[?2004l\r"]
[1455.818668, "o", "\u001b[?2004h> "]
[1455.818708, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818747, "o", "    o_ref = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818787, "o", "w = (ref.matmul.weight * 1.5).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818841, "o", "b = (ref.matmul.bias * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[1455.818876, "o", "\u001b[?2004h> "]
[1455.818924, "o", "wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.818987, "o", "W3 = torch.cat([wl, wh, wh], dim=1).contiguous()  # (N, 3K)\r\n\u001b[?2004l\r"]
[1455.819015, "o", "\u001b[?2004h> K3 = 3 * K\r\n\u001b[?2004l\r"]
[1455.819055, "o", "\u001b[?2004h"]
[1455.819097, "o", "> A3 = torch.empty(M, K3, device=\"cuda\", dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1455.81914, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.81918, "o", "def prep3():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.819257, "o", "    _build_a3[(triton.cdiv(M*K, 8192),)](x, A3, M, K, K3, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r"]
[1455.819299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.819342, "o", "prep3(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.81939, "o", "print(\"prep3:\", timeit(prep3), \"ms\")\r\n\u001b[?2004l\r"]
[1455.819431, "o", "\u001b[?2004h> "]
[1455.819539, "o", "for (bm,bn,bk,warps,stages) in [(128,128,64,8,4),(256,128,64,8,3),(128,256,64,8,3),(256,128,64,8,4),(128,128,64,8,3)]:\r\n\u001b[?2004l\r"]
[1455.819582, "o", "\u001b[?2004h> "]
[1455.819624, "o", "    out = torch.empty(M, N, device=\"cuda\", dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1455.819659, "o", "\u001b[?2004h> "]
[1455.8197, "o", "    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.819721, "o", ">     def run():\r\n\u001b[?2004l\r"]
[1455.81977, "o", "\u001b[?2004h> "]
[1455.819904, "o", "        _gemm_concat[grid](A3, W3, b, out, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1455.819923, "o", ">     try:\r\n\u001b[?2004l\r"]
[1455.81994, "o", "\u001b[?2004h> "]
[1455.819986, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1455.820029, "o", "\u001b[?2004h> "]
[1455.820064, "o", "        md = (out - o_ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.820133, "o", "        ok = torch.allclose(out, o_ref, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1455.820175, "o", "\u001b[?2004h>         t = timeit(run)\r\n\u001b[?2004l\r"]
[1455.820215, "o", "\u001b[?2004h> "]
[1455.820319, "o", "        print(\"CAT BM%d BN%d BK%d w%d s%d: %.3f ms maxdiff %.2e ok=%s\" % (bm,bn,bk,warps,stages,t,md,ok))\r\n\u001b[?2004l\r"]
[1455.820363, "o", "\u001b[?2004h>     except Exception as ex:\r\n\u001b[?2004l\r"]
[1455.820404, "o", "\u001b[?2004h> "]
[1455.820499, "o", "        print(\"CAT BM%d BN%d BK%d w%d s%d: FAIL %s\" % (bm,bn,bk,warps,stages,type(ex).__name__))\r\n\u001b[?2004l\r"]
[1455.820543, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1455.820582, "o", "open(\"/workspace/sweep7.py\",\"w\").write(code)\r\n\u001b[?2004l\r"]
[1455.820621, "o", "\u001b[?2004h> print(\"written\")\r\n\u001b[?2004l\r"]
[1455.82066, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[1455.858915, "o", "written\r\n"]
[1455.860811, "o", "\u001b[?2004hroot@modal:/# "]
[1457.807965, "i", "gpu sync && gpu run -- python3 /workspace/sweep7.py\n"]
[1457.808138, "o", "gpu sync && gpu run -- python3 /workspace/sweep7.py\r\n\u001b[?2004l\r"]
[1460.824561, "o", "{\r\n  \"box\": null,\r\n  \"committed\": [\r\n    \"agent\"\r\n  ],\r\n  \"reloaded\": [\r\n    \"agent\"\r\n  ]\r\n}\r\n"]
