[633.956825, "o", "\u001b[?2004h> "]
[633.956861, "o", "        acc = tl.dot(xl, tl.trans(wh), acc)\r\n\u001b[?2004l\r"]
[633.956891, "o", "\u001b[?2004h> "]
[633.956928, "o", "        acc = tl.dot(xh, tl.trans(wh), acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[633.956956, "o", "> "]
