[877.844049, "o", "    (128,128,64,8,3,8),(128,128,64,8,4,8),(256,128,64,8,3,8),(128,256,64,8,3,8),\r\n\u001b[?2004l\r"]
[877.844078, "o", "\u001b[?2004h> "]
[877.844153, "o", "    (128,128,128,8,3,8),(256,128,32,8,4,8),(128,256,32,8,4,8),(128,128,64,8,5,8),\r\n\u001b[?2004l\r"]
[877.84418, "o", "\u001b[?2004h> "]
[877.844253, "o", "    (64,256,64,4,4,8),(128,64,64,4,4,8),(256,64,64,8,4,8),(64,128,64,4,4,8),\r\n\u001b[?2004l\r"]
[877.844278, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[877.844302, "o", "> "]
[877.844326, "o", "prep(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[877.844351, "o", "\u001b[?2004h> "]
[877.84439, "o", "# time prep alone\r\n\u001b[?2004l\r\u001b[?2004h> "]
[877.84442, "o", "for _ in range(3): prep()\r\n\u001b[?2004l\r"]
