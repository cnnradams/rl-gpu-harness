[877.845161, "o", "\u001b[?2004h> "]
[877.845255, "o", "            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[877.84528, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[877.845305, "o", "\u001b[?2004h> "]
