[749.624768, "o", "\u001b[?2004h> "]
[749.624859, "o", "        print(f'tma_split bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms maxdiff={md:.2e}')\r\n\u001b[?2004l\r"]
