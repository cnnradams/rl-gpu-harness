[642.511861, "i", "warps=warps, num_stages=stages)\n    return f, out\n\n\n# correctness check for variant a\nf, out = run_a(128, 128, 64, 8, 3)\nf()\ntorch.cuda.synchronize()\nref = torch.nn.functional.linear(x, w, b)\nref = ref * 0.5 + ref\nprint('maxdiff kern_a:', (out - ref).abs().max().item())\n\nfor (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3),(64,128,128,4,4)]:\n    try:\n        f, _ = run_a(bm, bn, bk, wp, st)\n        t = do_bench(f)\n        print(f'kern_a bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'kern_a bm={bm} bn={bn} bk={bk} w={wp} s={st}: FAIL {ex}')\n\nfor (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3)]:\n    try:\n        f, _ = run_fast(bm, bn, bk, wp, st, True)\n        t = do_bench(f)\n        print(f'kern_fast split bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'kern_fast split bm={bm} bn={bn} bk={bk} w={wp} s={st}: "]
[642.51194, "o", "      AH_ptr += BLOCK_K * sak\r\n         \u001b[?2004h> "]
