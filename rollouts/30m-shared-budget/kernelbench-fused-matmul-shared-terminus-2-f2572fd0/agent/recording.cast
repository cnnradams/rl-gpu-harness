[642.521876, "o", "> xh = x.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521922, "o", "xl = (x - xh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.521962, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.522023, "o", "def run_fast(bm, bn, bk, warps, stages, split):\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522062, "o", "> "]
[642.5221, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[642.522141, "o", "\u001b[?2004h> "]
[642.52218, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[642.52222, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522259, "o", "> "]
[642.52232, "o", "        kern_fast[grid](xh, xl, wh, wl, out, M, N, K, x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522362, "o", "> "]
[642.522427, "o", "                        wh.stride(1), wh.stride(0), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522466, "o", "> "]
[642.522534, "o", "                        BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, SPLIT=split,\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522574, "o", "> "]
[642.522615, "o", "                        num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522654, "o", ">     return f, out\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522693, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.522732, "o", "# correctness check for variant a\r\n\u001b[?2004l\r"]
[642.522778, "o", "\u001b[?2004h> "]
[642.522819, "o", "f, out = run_a(128, 128, 64, 8, 3)\r\n\u001b[?2004l\r\u001b[?2004h> f()\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.522859, "o", "> torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[642.522897, "o", "\u001b[?2004h> "]
[642.522937, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.522976, "o", "ref = ref * 0.5 + ref\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.523045, "o", "print('maxdiff kern_a:', (out - ref).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.523084, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.523223, "o", "for (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3),(64,128,128,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.523264, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.523303, "o", "        f, _ = run_a(bm, bn, bk, wp, st)\r\n\u001b[?2004l\r"]
