[931.997827, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.997848, "o", "> "]
[931.997924, "o", "    \"\"\"Linear + scale + residual implemented as (1+s) * (Wx + b) using a\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.997951, "o", "> "]
[931.998019, "o", "    Markidis-style split-fp16 tensor-core GEMM with fp32 accumulation.\"\"\"\r\n\u001b[?2004l\r"]
[931.998044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[931.998066, "o", "> "]
[931.998124, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[931.998148, "o", "\u001b[?2004h> "]
[931.998186, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[931.99821, "o", "\u001b[?2004h> "]
[931.998265, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[931.998288, "o", "\u001b[?2004h> "]
[931.998331, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[931.998355, "o", "\u001b[?2004h> "]
[931.998403, "o", "        self._scale1p = float(1.0 + scaling_factor)\r\n\u001b[?2004l\r"]
[931.998427, "o", "\u001b[?2004h> "]
[931.998452, "o", "        self._key = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.998477, "o", "> "]
[931.998501, "o", "        self._wh = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[931.998534, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[931.998555, "o", "\u001b[?2004h> "]
[931.99858, "o", "        self._bias = None\r\n\u001b[?2004l\r"]
[931.998604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[931.998628, "o", "> "]
[931.998652, "o", "    def _prepare(self, w, b):\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.998676, "o", "> "]
[931.998766, "o", "        key = (w.data_ptr(), w.device, w._version, b.data_ptr() if b is not None else None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.998792, "o", "> "]
[931.998814, "o", "        if self._key == key:\r\n\u001b[?2004l\r"]
[931.998837, "o", "\u001b[?2004h> "]
[931.99886, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[931.998894, "o", "        wd = w.detach()\r\n\u001b[?2004l\r"]
[931.998917, "o", "\u001b[?2004h> "]
[931.998952, "o", "        w16 = wd.to(torch.float16)\r\n\u001b[?2004l\r"]
[931.998973, "o", "\u001b[?2004h> "]
[931.999037, "o", "        wl16 = (wd - w16.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[931.999062, "o", "\u001b[?2004h> "]
[931.999091, "o", "        self._wh = w16.contiguous()\r\n\u001b[?2004l\r"]
[931.999111, "o", "\u001b[?2004h> "]
[931.999149, "o", "        self._wl = wl16.contiguous()\r\n\u001b[?2004l\r"]
[931.999173, "o", "\u001b[?2004h> "]
[931.999197, "o", "        if b is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.999222, "o", "> "]
[931.999281, "o", "            self._bias = (b.detach() * self._scale1p).contiguous()\r\n\u001b[?2004l\r"]
[931.999301, "o", "\u001b[?2004h> "]
[931.999326, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[931.999424, "o", "            self._bias = torch.zeros(wd.shape[0], device=wd.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[931.999449, "o", "\u001b[?2004h> "]
[931.999472, "o", "        self._key = key\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.999496, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[931.999532, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[931.999552, "o", "\u001b[?2004h> "]
[931.999583, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[931.999604, "o", "\u001b[?2004h> "]
[931.999631, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[931.999652, "o", "\u001b[?2004h> "]
[931.999746, "o", "        if (not _HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 or x.dim() != 2:\r\n\u001b[?2004l\r"]
[931.999771, "o", "\u001b[?2004h> "]
[931.9998, "o", "            y = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[931.999824, "o", "\u001b[?2004h> "]
[931.999869, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[931.999899, "o", "\u001b[?2004h> "]
[931.999923, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[931.999951, "o", "> "]
[931.999975, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.000017, "o", "        BM, BN, BK = 128, 128, 64\r\n\u001b[?2004l\r"]
[932.000041, "o", "\u001b[?2004h> "]
[932.000099, "o", "        if (M % BM) != 0 or (N % BN) != 0 or (K % BK) != 0:\r\n\u001b[?2004l\r"]
[932.000121, "o", "\u001b[?2004h> "]
[932.000156, "o", "            y = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[932.00018, "o", "\u001b[?2004h> "]
[932.000224, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[932.000247, "o", "\u001b[?2004h> "]
[932.000271, "o", "        self._prepare(w, b)\r\n\u001b[?2004l\r"]
[932.000295, "o", "\u001b[?2004h> "]
[932.000319, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[932.000343, "o", "\u001b[?2004h> "]
[932.00041, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[932.000432, "o", "\u001b[?2004h> "]
[932.000457, "o", "        wh = self._wh\r\n\u001b[?2004l\r\u001b[?2004h"]
[932.000479, "o", "> "]
[932.000502, "o", "        wl = self._wl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[932.000571, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[932.000598, "o", "\u001b[?2004h> "]
[932.000625, "o", "        _split_gemm_kernel[grid](\r\n\u001b[?2004l\r"]
[932.000648, "o", "\u001b[?2004h> "]
[932.000686, "o", "            x, wh, wl, self._bias, out,\r\n\u001b[?2004l\r"]
[932.00071, "o", "\u001b[?2004h> "]
[932.000733, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[932.000757, "o", "> "]
[932.000784, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[932.000808, "o", "\u001b[?2004h> "]
[932.000844, "o", "            wh.stride(1), wh.stride(0),\r\n\u001b[?2004l\r"]
[932.000868, "o", "\u001b[?2004h> "]
[932.000908, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[932.000936, "o", "\u001b[?2004h> "]
[932.000961, "o", "            self._scale1p,\r\n\u001b[?2004l\r"]
[932.000984, "o", "\u001b[?2004h> "]
[932.001042, "o", "            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8,\r\n\u001b[?2004l\r"]
[932.001065, "o", "\u001b[?2004h> "]
[932.001102, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[932.001126, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[932.00115, "o", "\u001b[?2004h> "]
[932.001171, "o", "        return out\r\n\u001b[?2004l\r"]
[932.001194, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[932.003225, "o", "\u001b[?2004hroot@modal:/# "]
