[749.622975, "o", "\u001b[?2004h> "]
[749.623019, "o", "def run_tma_split(bm, bn, bk, warps, stages):\r\n\u001b[?2004l\r"]
[749.623046, "o", "\u001b[?2004h> "]
[749.623099, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[749.623119, "o", "\u001b[?2004h> "]
[749.62318, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.623204, "o", ">     def f():\r\n\u001b[?2004l\r"]
[749.623229, "o", "\u001b[?2004h> "]
[749.6233, "o", "        kern_tma_split[grid](x, wh, wl, bias, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[749.623322, "o", "\u001b[?2004h> "]
[749.623401, "o", "                             BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.62348, "o", "                             num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[749.623506, "o", "\u001b[?2004h> "]
