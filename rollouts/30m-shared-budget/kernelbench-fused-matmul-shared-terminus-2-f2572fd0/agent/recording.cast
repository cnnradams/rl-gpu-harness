[642.517669, "o", "> "]
[642.51772, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[642.517768, "o", "\u001b[?2004h> "]
[642.517808, "o", "        A_ptr += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.517848, "o", "> "]
[642.517899, "o", "        BH_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[642.517941, "o", "\u001b[?2004h> "]
[642.517996, "o", "        BL_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518037, "o", "> "]
[642.518092, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518131, "o", "> "]
[642.518196, "o", "    acc = acc * scale + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518235, "o", "> "]
[642.51833, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518365, "o", ">     tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[642.518404, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[642.518438, "o", "\u001b[?2004h> "]
[642.51848, "o", "def run_a(bm, bn, bk, warps, stages):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.518551, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518592, "o", "> "]
[642.518633, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.518673, "o", "    def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.518765, "o", "        kern_a[grid](x, wh, wl, bias, out, M, N, K, x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518801, "o", "> "]
[642.518876, "o", "                     wh.stride(1), wh.stride(0), out.stride(0), out.stride(1), scale,\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.518916, "o", "> "]
