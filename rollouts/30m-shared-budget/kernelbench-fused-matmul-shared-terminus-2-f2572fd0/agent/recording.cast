[642.516157, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.516198, "o", "> "]
[642.516238, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[642.516283, "o", "\u001b[?2004h> "]
[642.516385, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.516427, "o", "> "]
[642.516535, "o", "    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.516576, "o", "> "]
[642.516684, "o", "    BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[642.516724, "o", "\u001b[?2004h> "]
[642.516833, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.516875, "o", "> "]
[642.516959, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[642.517, "o", "\u001b[?2004h> "]
[642.517039, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[642.517081, "o", "\u001b[?2004h> "]
[642.51713, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[642.517174, "o", "\u001b[?2004h> "]
[642.517263, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.517304, "o", "> "]
[642.517348, "o", "        bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.517388, "o", "> "]
