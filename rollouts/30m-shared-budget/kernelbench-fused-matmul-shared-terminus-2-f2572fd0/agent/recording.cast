[749.614264, "i", "\n                            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                            num_warps=warps, num_stages=stages)\n    return f, out\n\n\ndef run_tma_split(bm, bn, bk, warps, stages):\n    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n    def f():\n        kern_tma_split[grid](x, wh, wl, bias, out, M, N, K, scale,\n                             BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                             num_warps=warps, num_stages=stages)\n    return f, out\n\n\nref = torch.nn.functional.linear(x, w, b)\nref = ref * 0.5 + ref\n\nfor (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3),(128,256,128,8,3)]:\n    try:\n        f, out = run_tma_pure(bm, bn, bk, wp, st)\n        t = do_bench(f)\n        print(f'tma_pure bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'tma_pure bm={bm} bn={bn} bk={bk} w={wp} s={st}: FAIL {t"]
