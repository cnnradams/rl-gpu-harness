[642.519194, "o", "# variant 2: pure fp16 single dot (upper bound, wrong result)\r\n\u001b[?2004l\r"]
[642.519237, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.519318, "o", "def kern_fast(AH, AL, BH, BL, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[642.51936, "o", "\u001b[?2004h> "]
[642.519474, "o", "              BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[642.519517, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[642.519557, "o", "\u001b[?2004h> "]
[642.519598, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.519641, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.519683, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.519724, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.519766, "o", "> "]
[642.51982, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.51986, "o", "> "]
[642.519909, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.519964, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.520003, "o", "> "]
[642.520044, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.520099, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[642.520139, "o", "\u001b[?2004h> "]
[642.520179, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.520231, "o", "    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[642.520271, "o", "\u001b[?2004h> "]
[642.520313, "o", "    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.520353, "o", "> "]
[642.520393, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.520434, "o", ">     if SPLIT:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.520509, "o", "        AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[642.520549, "o", "\u001b[?2004h> "]
[642.520589, "o", "        BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[642.520627, "o", "\u001b[?2004h> "]
[642.520668, "o", "        for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.520709, "o", "> "]
[642.520749, "o", "            ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.520794, "o", "            al = tl.load(AL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.520834, "o", "            bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.520872, "o", "> "]
[642.520912, "o", "            bl = tl.load(BL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.520951, "o", "            acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521005, "o", "            acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.521046, "o", "> "]
[642.521086, "o", "            acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521126, "o", "            AH_ptr += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521176, "o", "            AL_ptr += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.521218, "o", "> "]
[642.521258, "o", "            BH_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521297, "o", "            BL_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521336, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521391, "o", "        for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.521431, "o", "> "]
[642.52147, "o", "            ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521513, "o", "            bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521554, "o", "            acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.521595, "o", "> "]
[642.521634, "o", "            AH_ptr += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521674, "o", "            BH_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[642.521745, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[642.521792, "o", "\u001b[?2004h>     tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
