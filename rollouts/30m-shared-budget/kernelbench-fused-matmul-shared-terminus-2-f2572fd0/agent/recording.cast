[852.597435, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * 0.02\nb = torch.randn(N, device='cuda') * 0.02\nscale = 1.5\nwh = w.half()\nwl = (w - wh.float()).half()\nbias = (b * scale).contiguous()\nxh = x.half()\n\ndef do_bench(fn, warmup=10, rep=30):\n    for _ in range(warmup):\n        fn()\n    torch.cuda.synchronize()\n    times = []\n    cache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.float32, device='cuda')\n    for _ in range(rep):\n        cache.zero_()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True)\n        e = torch.cuda.Event(enable_timing=True)\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    import statistics\n    return statistics.mean(times)\n\n\n@triton.jit\ndef kern_ws_pure(AH, BH, C, M, N, K, scale,\n                 BLOCK_M: tl.constexp"]
[852.597504, "i", "r, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, WS: tl.constexpr):\n    a_desc = tl.make_tensor_descriptor(AH, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\n    b_desc = tl.make_tensor_descriptor(BH, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in tl.range(0, tl.cdiv(K, BLOCK_K), warp_specialize=WS):\n        a = a_desc.load([off_m, k * BLOCK_K])\n        bt = b_desc.load([off_n, k * BLOCK_K])\n        acc = tl.dot(a, bt.T, acc)\n   "]
[852.597669, "i", " c_desc.store([off_m, off_n], (acc * scale).to(tl.float32))\n\n\n@triton.jit\ndef kern_ws_split(A, BH, BL, Bias, C, M, N, K, scale,\n                  BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, WS: tl.constexpr):\n    a_desc = tl.make_tensor_descriptor(A, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\n    bh_desc = tl.make_tensor_descriptor(BH, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\n    bl_desc = tl.make_tensor_descriptor(BL, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n ="]
[852.597729, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.597774, "i", " pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in tl.range(0, tl.cdiv(K, BLOCK_K), warp_specialize=WS):\n        a = a_desc.load([off_m, k * BLOCK_K])\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = bh_desc.load([off_n, k * BLOCK_K])\n        bl = bl_desc.load([off_n, k * BLOCK_K])\n        acc = tl.dot(ah, bh.T, acc)\n        acc2 = tl.dot(al, bh.T, acc2)\n        acc2 = tl.dot(ah, bl.T, acc2)\n    acc = acc + acc2\n    bias = tl.load(Bias + off_n + tl.arange(0, BLOCK_N))\n    acc = acc * scale + bias[None, :]\n    c_desc.store([off_m, off_n], acc.to(tl.float32))\n\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\n\ntriton.set_allocator(alloc_fn)\n\n\ndef run_pure(bm, bn, bk, warps, stages, ws):\n    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n    def f():\n       "]
[852.597799, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.597832, "i", " kern_ws_pure[grid](xh, wh, out, M, N, K, scale,\n                           BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, WS=ws,\n                           num_warps=warps, num_stages=stages)\n    return f, out\n\n\ndef run_split(bm, bn, bk, warps, stages, ws):\n    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n    def f():\n        kern_ws_split[grid](x, wh, wl, bias, out, M, N, K, scale,\n                            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, WS=ws,\n                            num_warps=warps, num_stages=stages)\n    return f, out\n\n\nref = torch.nn.functional.linear(x, w, b)\nref = ref * 0.5 + ref\n\nfor ws in [True, False]:\n    for (bm, bn, bk, wp, st) in [(128,128,64,4,3),(128,256,64,4,3),(128,256,64,8,3),(128,128,64,8,3)]:\n        try:\n            f, out = run_pure(bm, bn, bk, wp, st, ws)\n            t = do_bench(f)\n            print(f'ws={ws} pure bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms')\n        except Exception as e"]
[852.597877, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.597908, "i", "x:\n            print(f'ws={ws} pure bm={bm} bn={bn} bk={bk} w={wp} s={st}: FAIL {type(ex).__name__} {str(ex)[:60]}')\n\nfor ws in [True, False]:\n    for (bm, bn, bk, wp, st) in [(128,128,64,4,3),(128,128,64,8,3),(128,64,64,4,3),(64,128,64,4,3),(128,128,32,4,3)]:\n        try:\n            f, out = run_split(bm, bn, bk, wp, st, ws)\n            f()\n            torch.cuda.synchronize()\n            md = (out - ref).abs().max().item()\n            t = do_bench(f)\n            print(f'ws={ws} split bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms maxdiff={md:.2e}')\n        except Exception as ex:\n            print(f'ws={ws} split bm={bm} bn={bn} bk={bk} w={wp} s={st}: FAIL {type(ex).__name__} {str(ex)[:60]}')\nEOF\n"]
[852.597927, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.598004, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[852.598032, "o", "\u001b[?2004h> "]
[852.598139, "o", "w = torch.randn(N, K, device='cuda') * 0.02\r\n\u001b[?2004l\r"]
[852.598171, "o", "\u001b[?2004h> "]
[852.598279, "o", "b = torch.randn(N, device='cuda') * 0.02\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.598307, "o", "> "]
[852.59833, "o", "scale = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.598373, "o", "wh = w.half()\r\n\u001b[?2004l\r"]
[852.598395, "o", "\u001b[?2004h> "]
[852.598476, "o", "wl = (w - wh.float()).half()\r\n\u001b[?2004l\r"]
[852.598504, "o", "\u001b[?2004h> "]
[852.598567, "o", "bias = (b * scale).contiguous()\r\n\u001b[?2004l\r"]
[852.598591, "o", "\u001b[?2004h> "]
[852.598614, "o", "xh = x.half()\r\n\u001b[?2004l\r"]
[852.598635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[852.598662, "o", "c\u001b[?2004h> "]
[852.598778, "o", "def do_bench(fn, warmup=10, rep=30):\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.598803, "o", "> "]
[852.59887, "o", "    for _ in range(warmup):\r\n\u001b[?2004l\r"]
[852.598896, "o", "\u001b[?2004h> "]
[852.598916, "o", "        fn()\r\n"]
[852.598941, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[852.59902, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[852.599046, "o", "\u001b[?2004h> "]
[852.599079, "o", "    times = []\r\n"]
[852.599142, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[852.599321, "o", "    cache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[852.599344, "o", "\u001b[?2004h> "]
[852.599397, "o", "    for _ in range(rep):\r\n\u001b[?2004l\r"]
[852.599419, "o", "\u001b[?2004h> "]
[852.599483, "o", "        cache.zero_()\r\n\u001b[?2004l\r"]
[852.599503, "o", "\u001b[?2004h> "]
[852.599585, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[852.599607, "o", "\u001b[?2004h> "]
[852.599727, "o", "        s = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[852.599754, "o", "\u001b[?2004h> "]
[852.599869, "o", "        e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[852.59991, "o", "\u001b[?2004h> "]
[852.599937, "o", "        s.record()\r\n\u001b[?2004l\r"]
[852.599946, "o", "\u001b[?2004h"]
[852.599954, "o", "> "]
[852.60004, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.600121, "o", "        e.record()\r\n\u001b[?2004l\r12\u001b[?2004h> "]
[852.600163, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.60027, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[852.600286, "o", "\u001b[?2004h> "]
[852.600343, "o", "    import statistics\r\n\u001b[?2004l\r"]
[852.600383, "o", "\u001b[?2004h> "]
[852.600449, "o", "    return statistics.mean(times)\r\n\u001b[?2004l\r"]
[852.60049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h> \r\n\u001b[?2004l\r"]
[852.600531, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[852.600594, "o", "\u001b[?2004h> "]
[852.600666, "o", "def kern_ws_pure(AH, BH, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[852.600681, "o", "\u001b[?2004h> "]
[852.600987, "o", "                 BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.601032, "o", "> "]
[852.601257, "o", "    a_desc = tl.make_tensor_descriptor(AH, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r"]
[852.601276, "o", "\u001b[?2004h> "]
[852.60152, "o", "    b_desc = tl.make_tensor_descriptor(BH, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.601534, "o", "> "]
[852.601785, "o", "    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.6018, "o", "> "]
[852.601874, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.601904, "o", "> "]
[852.601969, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[852.601982, "o", "\u001b[?2004h> "]
[852.602094, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.602173, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[852.602194, "o", "\u001b[?2004h> "]
[852.602269, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[852.602291, "o", "\u001b[?2004h> "]
[852.602443, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[852.602466, "o", "\u001b[?2004h"]
[852.602491, "o", "> "]
[852.602599, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.602625, "o", "> "]
[852.602705, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[852.60273, "o", "\u001b[?2004h> "]
[852.60276, "o", "    off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.602786, "o", "> "]
[852.602812, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.602884, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[852.60291, "o", "\u001b[?2004h> "]
[852.602973, "o", "    for k in tl.range(0, tl.cdiv(K, BLOCK_K), warp_specialize=WS):\r\n\u001b[?2004l\r"]
[852.603001, "o", "\u001b[?2004h> "]
[852.603042, "o", "        a = a_desc.load([off_m, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[852.603073, "o", "\u001b[?2004h> "]
[852.603115, "o", "        bt = b_desc.load([off_n, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[852.603138, "o", "\u001b[?2004h> "]
[852.603171, "o", "        acc = tl.dot(a, bt.T, acc)\r\n\u001b[?2004l\r"]
[852.603193, "o", "\u001b[?2004h> "]
[852.603255, "o", "    c_desc.store([off_m, off_n], (acc * scale).to(tl.float32))\r\n\u001b[?2004l\r"]
[852.60328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[852.603302, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.603327, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.603351, "o", "> "]
[852.603398, "o", "def kern_ws_split(A, BH, BL, Bias, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[852.603428, "o", "\u001b[?2004h> "]
[852.603551, "o", "                  BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[852.603578, "o", "\u001b[?2004h> "]
[852.603677, "o", "    a_desc = tl.make_tensor_descriptor(A, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r"]
[852.603702, "o", "\u001b[?2004h> "]
[852.603806, "o", "    bh_desc = tl.make_tensor_descriptor(BH, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\r\n\u001b[?2004l\r"]
[852.603831, "o", "\u001b[?2004h> "]
[852.603947, "o", "    bl_desc = tl.make_tensor_descriptor(BL, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\r\n\u001b[?2004l\r\u001b[?2004h"]
[852.60397, "o", "> "]
[852.604073, "o", "    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\r\n\u001b[?2004l\r"]
[852.604098, "o", "\u001b[?2004h> "]
[852.604122, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[852.604146, "o", "\u001b[?2004h> "]
[852.604174, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[852.604198, "o", "\u001b[?2004h> "]
[852.604226, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[852.604249, "o", "\u001b[?2004h> "]
[852.604274, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[852.604297, "o", "\u001b[?2004h> "]
[852.604322, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[852.604346, "o", "\u001b[?2004h> "]
[852.604408, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[852.604432, "o", "\u001b[?2004h> "]
[852.60448, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[852.604501, "o", "\u001b[?2004h> "]
[852.604541, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[852.604565, "o", "\u001b[?2004h> "]
[852.604589, "o", "    off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[852.604613, "o", "\u001b[?2004h> "]
[852.604636, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[852.60466, "o", "\u001b[?2004h> "]
[852.604712, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[852.604733, "o", "\u001b[?2004h> "]
[852.60479, "o", "    acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[852.604814, "o", "\u001b[?2004h> "]
[852.604879, "o", "    for k in tl.range(0, tl.cdiv(K, BLOCK_K), warp_specialize=WS):\r\n\u001b[?2004l\r"]
[852.604903, "o", "\u001b[?2004h> "]
[852.604945, "o", "        a = a_desc.load([off_m, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[852.604968, "o", "\u001b[?2004h> "]
[852.604994, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[852.605018, "o", "\u001b[?2004h> "]
[852.605071, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[852.605095, "o", "\u001b[?2004h> "]
[852.605139, "o", "        bh = bh_desc.load([off_n, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[852.605163, "o", "\u001b[?2004h> "]
[852.605208, "o", "        bl = bl_desc.load([off_n, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[852.605232, "o", "\u001b[?2004h> "]
[852.605264, "o", "        acc = tl.dot(ah, bh.T, acc)\r\n\u001b[?2004l\r"]
[852.605288, "o", "\u001b[?2004h> "]
[852.605322, "o", "        acc2 = tl.dot(al, bh.T, acc2)\r\n\u001b[?2004l\r"]
[852.605345, "o", "\u001b[?2004h> "]
[852.605379, "o", "        acc2 = tl.dot(ah, bl.T, acc2)\r\n\u001b[?2004l\r"]
[852.605403, "o", "\u001b[?2004h> "]
[852.605427, "o", "    acc = acc + acc2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.605497, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BLOCK_N))\r\n\u001b[?2004l\r"]
[852.60552, "o", "\u001b[?2004h> "]
[852.605556, "o", "    acc = acc * scale + bias[None, :]\r\n\u001b[?2004l\r"]
[852.60558, "o", "\u001b[?2004h> "]
[852.60563, "o", "    c_desc.store([off_m, off_n], acc.to(tl.float32))\r\n\u001b[?2004l\r"]
[852.605651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[852.605675, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[852.605699, "o", "> "]
[852.605729, "o", "def alloc_fn(size, alignment, stream):\r\n\u001b[?2004l\r"]
[852.605753, "o", "\u001b[?2004h> "]
[852.605812, "o", "    return torch.empty(size, device='cuda', dtype=torch.int8)\r\n\u001b[?2004l\r"]
[852.605836, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[852.605859, "o", "> "]
[852.605882, "o", "triton.set_allocator(alloc_fn)\r\n\u001b[?2004l\r"]
[852.605906, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[852.60593, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[852.605979, "o", "def run_pure(bm, bn, bk, warps, stages, ws):\r\n\u001b[?2004l\r"]
[852.606003, "o", "\u001b[?2004h> "]
[852.60607, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n"]
[852.606091, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[852.606163, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.606184, "o", "    def f():\r\n\u001b[?2004l\r"]
[852.606208, "o", "\u001b[?2004h> "]
[852.606261, "o", "        kern_ws_pure[grid](xh, wh, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[852.606285, "o", "\u001b[?2004h> "]
[852.606363, "o", "                           BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, WS=ws,\r\n\u001b[?2004l\r"]
[852.606385, "o", "\u001b[?2004h> "]
[852.606447, "o", "                           num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[852.606473, "o", "\u001b[?2004h> "]
[852.606496, "o", "    return f, out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[852.606517, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[852.606538, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.606601, "o", "def run_split(bm, bn, bk, warps, stages, ws):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.606687, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[852.606758, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[852.606784, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r"]
[852.606804, "o", "\u001b[?2004h> "]
[852.606875, "o", "        kern_ws_split[grid](x, wh, wl, bias, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[852.6069, "o", "\u001b[?2004h> "]
