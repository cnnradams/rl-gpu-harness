[749.624326, "o", "\u001b[?2004h> "]
[749.62445, "o", "for (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,2),(256,128,64,8,2),(128,64,64,8,3),(64,128,64,4,3)]:\r\n\u001b[?2004l\r"]
