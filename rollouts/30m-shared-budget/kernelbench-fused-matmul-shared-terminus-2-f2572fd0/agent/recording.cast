[366.699471, "o", "            triton.Config({'BLOCK_M': 64, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.699599, "o", "            triton.Config({'BLOCK_M': 128, 'BLOCK_N': 64, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=4, num_stages=4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.699615, "o", "> "]
[366.699738, "o", "            triton.Config({'BLOCK_M': 256, 'BLOCK_N': 64, 'BLOCK_K': 32, 'GROUP_M': 8}, num_warps=4, num_stages=4),\r\n\u001b[?2004l\r"]
[366.699754, "o", "\u001b[?2004h> "]
[366.699791, "o", "        ],\r\n\u001b[?2004l\r"]
[366.699834, "o", "\u001b[?2004h>         key=['M', 'N', 'K'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.699876, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h>     @triton.jit\r\n\u001b[?2004l\r"]
[366.699921, "o", "\u001b[?2004h> "]
[366.69996, "o", "    def _split_gemm_kernel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700003, "o", "        A, BH, BL, Bias, C,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700043, "o", "        M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700088, "o", "        sam, sak,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700125, "o", "        sbk, sbn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700166, "o", "        scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h>         scale,\r\n\u001b[?2004l\r"]
[366.700205, "o", "\u001b[?2004h> "]
[366.70027, "o", "        BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[366.700315, "o", "\u001b[?2004h> "]
[366.700356, "o", "        GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h>     ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700398, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.700435, "o", "> "]
[366.700475, "o", "        grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70052, "o", "        grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70056, "o", "        width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[366.7006, "o", "\u001b[?2004h> "]
[366.700641, "o", "        group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700708, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[366.700753, "o", "\u001b[?2004h> "]
[366.700792, "o", "        pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[366.70083, "o", "\u001b[?2004h> "]
[366.70087, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.70091, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.700954, "o", "        rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[366.700993, "o", "\u001b[?2004h> "]
[366.701031, "o", "        rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.701069, "o", "> "]
[366.701108, "o", "        rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.701179, "o", "        A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[366.701216, "o", "\u001b[?2004h> "]
[366.701255, "o", "        BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[366.701295, "o", "\u001b[?2004h> "]
[366.70134, "o", "        BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[366.701377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.701443, "o", "        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[366.701481, "o", "\u001b[?2004h> "]
[366.701529, "o", "        acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[366.701567, "o", "\u001b[?2004h> "]
[366.701606, "o", "        for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.701646, "o", "            a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[366.701685, "o", "\u001b[?2004h> "]
[366.701722, "o", "            ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70179, "o", "            al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[366.70183, "o", "\u001b[?2004h> "]
[366.701869, "o", "            bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.701907, "o", "            bl = tl.load(BL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.701946, "o", "            acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[366.701984, "o", "\u001b[?2004h> "]
[366.702023, "o", "            acc2 = tl.dot(al, bh, acc2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.702068, "o", "            acc2 = tl.dot(ah, bl, acc2)\r\n\u001b[?2004l\r"]
[366.702107, "o", "\u001b[?2004h> "]
[366.702146, "o", "            A_ptr += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.702183, "o", "            BH_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[366.702222, "o", "\u001b[?2004h> "]
[366.702267, "o", "            BL_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[366.702305, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.702342, "o", "        acc = (acc + acc2) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70238, "o", "        bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.702416, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[366.702453, "o", "\u001b[?2004h> "]
[366.702492, "o", "        C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[366.702531, "o", "\u001b[?2004h> "]
[366.702573, "o", "        tl.store(C_ptr, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[366.702613, "o", "\u001b[?2004h> "]
[366.702644, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.702719, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[366.702764, "o", "\u001b[?2004h> "]
[366.702782, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[366.702828, "o", "\u001b[?2004h> "]
[366.702866, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.702905, "o", "> "]
[366.702942, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.702997, "o", "        self._scale1p = float(1.0 + scaling_factor)\r\n\u001b[?2004l\r"]
[366.703035, "o", "\u001b[?2004h>         self._key = None\r\n\u001b[?2004l\r"]
[366.703074, "o", "\u001b[?2004h> "]
[366.703092, "o", "        self._wh = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70313, "o", "        self._wl = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.703168, "o", ">         self._bias = None\r\n\u001b[?2004l\r"]
[366.703207, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703246, "o", "    def _prepare(self, w, b):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703351, "o", "        key = (w.data_ptr(), w.device, w._version, b.data_ptr() if b is not None else None)\r\n\u001b[?2004l\r"]
[366.70339, "o", "\u001b[?2004h> "]
[366.703429, "o", "        if self._key == key:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703467, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703505, "o", "        wd = w.detach()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703543, "o", "        w16 = wd.to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703617, "o", "        wl16 = (wd - w16.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[366.703655, "o", "\u001b[?2004h>         self._wh = w16\r\n\u001b[?2004l\r"]
[366.703693, "o", "\u001b[?2004h> "]
[366.703737, "o", "        self._wl = wl16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703777, "o", "        if b is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703843, "o", "            self._bias = (b.detach() * self._scale1p).contiguous()\r\n\u001b[?2004l\r"]
[366.703884, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.703993, "o", "            self._bias = torch.zeros(wd.shape[0], device=wd.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[366.704032, "o", "\u001b[?2004h>         self._key = key\r\n\u001b[?2004l\r"]
[366.704072, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.704111, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70415, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[366.704189, "o", "\u001b[?2004h> "]
[366.704229, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.704313, "o", "        if (not _HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 or x.dim() != 2:\r\n\u001b[?2004l\r"]
[366.704353, "o", "\u001b[?2004h> "]
[366.704393, "o", "            y = F.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.704434, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.704475, "o", ">         M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[366.704516, "o", ">         N = w.shape[0]\r\n\u001b[?2004l\r"]
[366.704556, "o", "\u001b[?2004h> "]
[366.704595, "o", "        if (M % 64) != 0 or (N % 64) != 0 or (K % 32) != 0:\r\n\u001b[?2004l\r"]
[366.70464, "o", "\u001b[?2004h> "]
[366.704684, "o", "            y = F.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.704729, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.704769, "o", "        self._prepare(w, b)\r\n\u001b[?2004l\r"]
[366.704808, "o", "\u001b[?2004h>         x = x.contiguous()\r\n\u001b[?2004l\r"]
[366.704844, "o", "\u001b[?2004h> "]
[366.704904, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[366.704941, "o", "\u001b[?2004h>         wh = self._wh\r\n\u001b[?2004l\r"]
[366.70498, "o", "\u001b[?2004h> "]
[366.705017, "o", "        wl = self._wl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.705106, "o", "        grid = lambda META: (triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),)\r\n\u001b[?2004l\r"]
[366.705146, "o", "\u001b[?2004h> "]
[366.705183, "o", "        _split_gemm_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70522, "o", "            x, wh, wl, self._bias, out,\r\n\u001b[?2004l\r"]
[366.705253, "o", "\u001b[?2004h> "]
[366.705292, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.705343, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[366.705381, "o", "\u001b[?2004h> "]
[366.705416, "o", "            wh.stride(1), wh.stride(0),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.705463, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[366.705501, "o", "\u001b[?2004h> "]
[366.705519, "o", "            self._scale1p,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.70556, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[366.705607, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[366.707127, "o", "\u001b[?2004hroot@modal:/# "]
