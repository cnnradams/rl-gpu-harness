[749.614366, "i", "ype(ex).__name__} {str(ex)[:80]}')\n\nfor (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,2),(256,128,64,8,2),(128,64,64,8,3),(64,128,64,4,3)]:\n    try:\n        f, out = run_tma_split(bm, bn, bk, wp, st)\n        f()\n        torch.cuda.synchronize()\n        md = (out - ref).abs().max().item()\n        t = do_bench(f)\n        print(f'tma_split bm={bm} bn={bn} bk={bk} w={wp} s={st}: {t:.3f} ms maxdiff={md:.2e}')\n    except Exception as ex:\n        print(f'tma_split bm={bm} bn={bn} bk={bk} w={wp} s={st}: FAIL {type(ex).__name__} {str(ex)[:80]}')\nEOF\n"]
