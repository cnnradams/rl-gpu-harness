[749.623612, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[749.623638, "o", "\u001b[?2004h> "]
[749.623662, "o", "ref = ref * 0.5 + ref\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.623692, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.623833, "o", "for (bm, bn, bk, wp, st) in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3),(128,256,128,8,3)]:\r\n\u001b[?2004l\r"]
[749.623858, "o", "\u001b[?2004h>     try:\r\n"]
