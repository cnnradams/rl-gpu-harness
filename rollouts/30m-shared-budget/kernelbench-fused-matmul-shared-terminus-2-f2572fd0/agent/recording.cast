[867.998543, "o", "ws=True pure bm=128 bn=128 bk=64 w=4 s=3: 1.134 ms\r\nws=True pure bm=128 bn=256 bk=64 w=4 s=3: FAIL OutOfResources out of resource: shared memory, Required: 279000, Hardware l\r\nws=True pure bm=128 bn=256 bk=64 w=8 s=3: 1.028 ms\r\nws=True pure bm=128 bn=128 bk=64 w=8 s=3: 1.102 ms\r\nws=False pure bm=128 bn=128 bk=64 w=4 s=3: 1.009 ms\r\nws=False pure bm=128 bn=256 bk=64 w=4 s=3: 4.364 ms\r\nws=False pure bm=128 bn=256 bk=64 w=8 s=3: 1.029 ms\r\nws=False pure bm=128 bn=128 bk=64 w=8 s=3: 1.099 ms\r\nws=True split bm=128 bn=128 bk=64 w=4 s=3: FAIL OutOfResources out of resource: shared memory, Required: 262712, Hardware l\r\nws=True split bm=128 bn=128 bk=64 w=8 s=3: 3.180 ms maxdiff=4.82e-05\r\nws=True split bm=128 bn=64 bk=64 w=4 s=3: 4.053 ms maxdiff=nan\r\nws=True split bm=64 bn=128 bk=64 w=4 s=3: 5.530 ms maxdiff=nan\r\nws=True split bm=128 bn=128 bk=32 w=4 s=3: 3.359 ms maxdiff=4.82e-05\r\nws=False split bm=128 bn=128 bk=64 w=4 s=3: 8.909 ms maxdiff=4.82e-05\r\nws=False split bm=128 bn=128 bk=64 w=8 s=3: 3.242 ms maxdiff=4.82e-0"]
