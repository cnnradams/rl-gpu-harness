[749.620253, "o", "    bh_desc = tl.make_tensor_descriptor(BH, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.620369, "o", "    bl_desc = tl.make_tensor_descriptor(BL, shape=[N, K], strides=[K, 1], block_shape=[BLOCK_N, BLOCK_K])\r\n\u001b[?2004l\r"]
[749.620394, "o", "\u001b[?2004h> "]
[749.620495, "o", "    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\r\n\u001b[?2004l\r"]
[749.620521, "o", "\u001b[?2004h> "]
[749.620541, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[749.620571, "o", "\u001b[?2004h> "]
[749.620596, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[749.620625, "o", "\u001b[?2004h> "]
[749.620648, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[749.620673, "o", "\u001b[?2004h> "]
[749.620708, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.620733, "o", "> "]
[749.620761, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[749.620787, "o", "\u001b[?2004h> "]
[749.62085, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.620917, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[749.620947, "o", "\u001b[?2004h> "]
[749.620982, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[749.621007, "o", "\u001b[?2004h> "]
[749.621033, "o", "    off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.621058, "o", "> "]
[749.621081, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.621105, "o", "> "]
[749.621163, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.621236, "o", "    acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[749.621257, "o", "\u001b[?2004h> "]
[749.621299, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[749.621325, "o", "\u001b[?2004h> "]
[749.621365, "o", "        a = a_desc.load([off_m, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[749.621389, "o", "\u001b[?2004h> "]
[749.62141, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[749.621435, "o", "\u001b[?2004h> "]
[749.621485, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[749.621511, "o", "\u001b[?2004h> "]
[749.62156, "o", "        bh = bh_desc.load([off_n, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[749.621585, "o", "\u001b[?2004h> "]
[749.621634, "o", "        bl = bl_desc.load([off_n, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[749.621657, "o", "\u001b[?2004h> "]
[749.621685, "o", "        acc = tl.dot(ah, bh.T, acc)\r\n\u001b[?2004l\r"]
[749.621711, "o", "\u001b[?2004h> "]
[749.621743, "o", "        acc2 = tl.dot(al, bh.T, acc2)\r\n\u001b[?2004l\r"]
[749.621768, "o", "\u001b[?2004h> "]
[749.621801, "o", "        acc2 = tl.dot(ah, bl.T, acc2)\r\n\u001b[?2004l\r"]
[749.621826, "o", "\u001b[?2004h> "]
[749.62185, "o", "    acc = acc + acc2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.621918, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BLOCK_N))\r\n\u001b[?2004l\r"]
[749.621948, "o", "\u001b[?2004h> "]
[749.621989, "o", "    acc = acc * scale + bias[None, :]\r\n\u001b[?2004l\r"]
[749.622019, "o", "\u001b[?2004h> "]
[749.622058, "o", "    c_desc.store([off_m, off_n], acc.to(tl.float32))\r\n\u001b[?2004l\r"]
[749.622082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.622111, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.622154, "o", "def alloc_fn(size, alignment, stream):\r\n\u001b[?2004l\r"]
[749.622175, "o", "\u001b[?2004h> "]
[749.622239, "o", "    return torch.empty(size, device='cuda', dtype=torch.int8)\r\n\u001b[?2004l\r"]
[749.622265, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.62231, "o", "triton.set_allocator(alloc_fn)\r\n\u001b[?2004l\r"]
[749.622334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[749.622356, "o", "\u001b[?2004h> "]
[749.622415, "o", "def run_tma_pure(bm, bn, bk, warps, stages):\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.622443, "o", "> "]
[749.622501, "o", "    out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[749.622527, "o", "\u001b[?2004h> "]
[749.622582, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[749.622611, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r"]
[749.622636, "o", "\u001b[?2004h> "]
[749.622686, "o", "        kern_tma_pure[grid](xh, wh, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[749.622711, "o", "\u001b[?2004h> "]
[749.622789, "o", "                            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\r\n\u001b[?2004l\r"]
[749.622811, "o", "\u001b[?2004h> "]
[749.622871, "o", "                            num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[749.622896, "o", "\u001b[?2004h> "]
[749.622919, "o", "    return f, out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
