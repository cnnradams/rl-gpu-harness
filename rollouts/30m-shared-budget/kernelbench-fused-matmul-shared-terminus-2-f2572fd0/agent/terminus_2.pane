[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     """Linear + scale + residual implemented as (1+s) * (Wx + b) using a
[?2004l[?2004h>     Markidis-style split-fp16 tensor-core GEMM with fp32 accumulation."""
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super(ModelNew, self).__init__()
