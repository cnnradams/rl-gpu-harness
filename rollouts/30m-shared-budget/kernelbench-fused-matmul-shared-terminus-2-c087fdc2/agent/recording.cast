[1311.619495, "o", "\u001b[?2004h> "]
[1311.619567, "o", "                ah_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[1311.619604, "o", "\u001b[?2004h> "]
[1311.619676, "o", "                al_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[1311.619717, "o", "\u001b[?2004h> "]
[1311.619857, "o", "            bias = tl.load(BIAS + rn, mask=n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1311.619895, "o", "\u001b[?2004h> "]
[1311.619977, "o", "            acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1311.620016, "o", "\u001b[?2004h> "]
[1311.620142, "o", "            y_ptrs = Y + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1311.62018, "o", "\u001b[?2004h> "]
[1311.620337, "o", "            tl.store(y_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r"]
[1311.620375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1311.620412, "o", "> "]
[1311.620495, "o", "        def _split_gemm(x, wh, wl, bias):\r\n\u001b[?2004l\r"]
[1311.620533, "o", "\u001b[?2004h> "]
[1311.620582, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[1311.62062, "o", "\u001b[?2004h> "]
[1311.620678, "o", "            N = wh.shape[0]\r\n\u001b[?2004l\r"]
[1311.620716, "o", "\u001b[?2004h> "]
[1311.620891, "o", "            y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1311.620929, "o", "> "]
[1311.621145, "o", "            grid = lambda meta: (triton.cdiv(M, meta[\"BLOCK_M\"]) * triton.cdiv(N, meta[\"BLOCK_N\"]),)\r\n\u001b[?2004l\r"]
[1311.621183, "o", "\u001b[?2004h> "]
[1311.621386, "o", "            _gemm_fp16x3[grid](x, wh, wl, bias, y, M, N, K, BLOCK_K=64, EVEN_K=(K % 64 == 0))\r\n\u001b[?2004l\r"]
[1311.621426, "o", "\u001b[?2004h> "]
[1311.62146, "o", "            return y\r\n\u001b[?2004l\r"]
[1311.621497, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1311.621535, "o", "\u001b[?2004h> "]
[1311.621633, "o", "        globals()[\"_split_gemm\"] = _split_gemm\r\n\u001b[?2004l\r"]
[1311.621671, "o", "\u001b[?2004h> "]
[1311.62174, "o", "        _kernel_ready[0] = True\r\n\u001b[?2004l\r"]
[1311.621777, "o", "\u001b[?2004h> "]
[1311.621815, "o", "        return True\r\n\u001b[?2004l\r"]
[1311.621854, "o", "\u001b[?2004h> "]
[1311.621891, "o", "    except Exception:\r\n\u001b[?2004l\r"]
[1311.621928, "o", "\u001b[?2004h> "]
[1311.621964, "o", "        return False\r\n\u001b[?2004l\r"]
[1311.622002, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1311.622039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1311.622076, "o", "\u001b[?2004h> "]
[1311.622128, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1311.622165, "o", "\u001b[?2004h> "]
[1311.622313, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1311.62235, "o", "\u001b[?2004h> "]
[1311.622431, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[1311.62247, "o", "\u001b[?2004h> "]
[1311.622595, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1311.622633, "o", "\u001b[?2004h> "]
[1311.622734, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1311.622772, "o", "\u001b[?2004h> "]
[1311.622818, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[1311.622855, "o", "\u001b[?2004h> "]
[1311.622903, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[1311.622941, "o", "\u001b[?2004h> "]
[1311.622993, "o", "        self._bias = None\r\n\u001b[?2004l\r"]
[1311.623031, "o", "\u001b[?2004h> "]
[1311.623068, "o", "        self._K = -1\r\n\u001b[?2004l\r"]
[1311.623107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1311.623145, "o", "\u001b[?2004h> "]
[1311.623182, "o", "    @torch.no_grad()\r\n\u001b[?2004l\r"]
[1311.62322, "o", "\u001b[?2004h> "]
[1311.623268, "o", "    def _prepare(self):\r\n\u001b[?2004l\r"]
[1311.623304, "o", "\u001b[?2004h> "]
[1311.623367, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[1311.623405, "o", "\u001b[?2004h> "]
[1311.623463, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[1311.623501, "o", "\u001b[?2004h> "]
[1311.623638, "o", "        if w.device.type != \"cuda\" or w.dtype != torch.float32:\r\n\u001b[?2004l\r"]
[1311.623676, "o", "\u001b[?2004h> "]
[1311.623713, "o", "            return\r\n\u001b[?2004l\r"]
[1311.623758, "o", "\u001b[?2004h> "]
[1311.623859, "o", "        factor = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[1311.623903, "o", "\u001b[?2004h> "]
[1311.623952, "o", "        w_full = w * factor\r\n\u001b[?2004l\r"]
[1311.624004, "o", "\u001b[?2004h> "]
[1311.624082, "o", "        wh = w_full.to(torch.float16)\r\n\u001b[?2004l\r"]
[1311.624119, "o", "\u001b[?2004h> "]
[1311.624252, "o", "        wl = (w_full - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[1311.62429, "o", "\u001b[?2004h> "]
[1311.624443, "o", "        if not (torch.isfinite(wh).all() and torch.isfinite(wl).all()):\r\n\u001b[?2004l\r"]
[1311.624482, "o", "\u001b[?2004h> "]
[1311.624519, "o", "            return\r\n\u001b[?2004l\r"]
[1311.624557, "o", "\u001b[?2004h> "]
[1311.624594, "o", "        if b is None:\r\n\u001b[?2004l\r"]
[1311.624631, "o", "\u001b[?2004h> "]
[1311.624815, "o", "            bias = torch.zeros(w.shape[0], device=w.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1311.624856, "o", "\u001b[?2004h> "]
[1311.624894, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1311.625018, "o", "            bias = (b * factor).to(torch.float32)\r\n\u001b[?2004l\r"]
[1311.625056, "o", "\u001b[?2004h> "]
[1311.625127, "o", "        self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[1311.625165, "o", "\u001b[?2004h> "]
[1311.625235, "o", "        self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[1311.625277, "o", "\u001b[?2004h> "]
[1311.625355, "o", "        self._bias = bias.contiguous()\r\n\u001b[?2004l\r"]
[1311.625392, "o", "\u001b[?2004h> "]
[1311.62545, "o", "        self._K = w.shape[1]\r\n\u001b[?2004l\r"]
[1311.625488, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1311.625525, "o", "\u001b[?2004h> "]
[1311.625584, "o", "    def _forward_ref(self, x):\r\n\u001b[?2004l\r"]
[1311.625622, "o", "\u001b[?2004h> "]
[1311.625759, "o", "        y = F.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r"]
[1311.625798, "o", "\u001b[?2004h> "]
[1311.625879, "o", "        original_x = y.clone().detach()\r\n\u001b[?2004l\r"]
[1311.625916, "o", "\u001b[?2004h> "]
[1311.62599, "o", "        y = y * self.scaling_factor\r\n\u001b[?2004l\r"]
[1311.626028, "o", "\u001b[?2004h> "]
[1311.626081, "o", "        y = y + original_x\r\n\u001b[?2004l\r"]
[1311.626118, "o", "\u001b[?2004h> "]
[1311.626155, "o", "        return y\r\n\u001b[?2004l\r"]
[1311.626194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1311.626231, "o", "> "]
[1311.626273, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1311.62631, "o", "\u001b[?2004h> "]
[1311.626348, "o", "        if (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1311.62645, "o", "            isinstance(x, torch.Tensor)\r\n\u001b[?2004l\r"]
[1311.626488, "o", "\u001b[?2004h> "]
[1311.626542, "o", "            and x.is_cuda\r\n\u001b[?2004l\r"]
[1311.626579, "o", "\u001b[?2004h> "]
[1311.626665, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1311.626699, "o", "\u001b[?2004h> "]
[1311.626767, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[1311.626809, "o", "\u001b[?2004h> "]
[1311.626896, "o", "            and not torch.is_grad_enabled()\r\n\u001b[?2004l\r"]
[1311.626933, "o", "\u001b[?2004h> "]
[1311.62697, "o", "        ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1311.62702, "o", "            try:\r\n\u001b[?2004l\r"]
[1311.627058, "o", "\u001b[?2004h> "]
[1311.627141, "o", "                if not _kernel_ready[0]:\r\n\u001b[?2004l\r"]
[1311.627179, "o", "\u001b[?2004h> "]
[1311.627254, "o", "                    _ensure_kernel()\r\n\u001b[?2004l\r"]
[1311.627291, "o", "\u001b[?2004h> "]
[1311.627368, "o", "                if _kernel_ready[0]:\r\n\u001b[?2004l\r"]
[1311.627406, "o", "\u001b[?2004h> "]
[1311.62756, "o", "                    if self._wh is None or self._wh.device != x.device:\r\n\u001b[?2004l\r"]
[1311.627598, "o", "\u001b[?2004h> "]
[1311.627679, "o", "                        self._prepare()\r\n\u001b[?2004l\r"]
[1311.627715, "o", "\u001b[?2004h> "]
[1311.627876, "o", "                    if self._wh is not None and x.shape[1] == self._K:\r\n\u001b[?2004l\r"]
[1311.627915, "o", "\u001b[?2004h> "]
[1311.628031, "o", "                        if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[1311.628052, "o", "\u001b[?2004h> "]
[1311.628166, "o", "                            x = x.contiguous()\r\n\u001b[?2004l\r"]
[1311.628204, "o", "\u001b[?2004h> "]
[1311.62837, "o", "                        return _split_gemm(x, self._wh, self._wl, self._bias)\r\n\u001b[?2004l\r"]
[1311.628407, "o", "\u001b[?2004h> "]
[1311.628467, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[1311.628505, "o", "\u001b[?2004h> "]
[1311.628542, "o", "                pass\r\n\u001b[?2004l\r"]
[1311.62858, "o", "\u001b[?2004h> "]
[1311.628658, "o", "        return self._forward_ref(x)\r\n\u001b[?2004l\r"]
[1311.628695, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1311.630207, "o", "\u001b[?2004hroot@modal:/# "]
