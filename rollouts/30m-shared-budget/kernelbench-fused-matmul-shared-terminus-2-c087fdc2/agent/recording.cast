[612.566921, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx32 = torch.rand(M, K, device=\"cuda\")\nw32 = (torch.rand(N, K, device=\"cuda\") * 2 - 1) / K ** 0.5 * 1.5\nb32 = torch.rand(N, device=\"cuda\") * 0.02\n\nxh = x32.half()\nxl = (x32 - xh.float()).half()\nwh = w32.half()\nwl = (w32 - wh.float()).half()\nbh = b32.half()\nbl = (b32 - bh.float()).half()\n\ndef bench(f, iters=15):\n    for _ in range(5):\n        f()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    dummy = torch.empty(32 * 1024 * 1024, dtype=torch.int64, device=\"cuda\")\n    times = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s.record(); f(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2]\n\nt = bench(lambda: torch.matmul(xh, wh.t()))\nprint(f\"fp16 cublas matmul only: {t:.3f} ms\")\n\ndef hybrid():\n    m1 = torch.addmm(bh, xh, wh.t())\n    m2 = torch."]
[612.566972, "i", "addmm(bl, xl, wh.t())\n    m3 = torch.mm(xh, wl.t())\n    return m1.float() + m2.float() + m3.float()\n\nt = bench(hybrid)\nprint(f\"hybrid cublas 3mm fp16-out: {t:.3f} ms\")\n\nwith torch.no_grad():\n    ref = x32 @ w32.t() + b32\n    out = hybrid()\n    diff = (ref - out).abs()\n    thresh = 1e-4 + 1e-4 * ref.abs()\n    ratio = diff / thresh\n    viol = (diff > thresh).sum().item()\n    print(f\"hybrid err: max={diff.max().item():.3e} mean={diff.mean().item():.3e} viol={viol} ratio_max={ratio.max().item():.3f} ratio_99999={torch.quantile(ratio.flatten()[:1000000].float(), 0.999).item():.3f}\")\n    # distribution of near-threshold\n    q = torch.quantile(ratio.flatten(), torch.tensor([0.5, 0.9, 0.99, 0.999, 0.9999], device='cuda'))\n    print('ratio quantiles 50/90/99/99.9/99.99:', [f'{v:.4f}' for v in q.tolist()])\n    # variant: drop m3 (wl term) - 2mm only\n    out2 = torch.addmm(bh, xh, wh.t()).float() + torch.addmm(bl, xl, wh.t()).float()\n    diff2 = (ref - out2).abs()\n    viol2 = (diff2 > thresh).sum().item()\n    print(f\"hy"]
[612.566993, "i", "brid2mm err: max={diff2.max().item():.3e} viol={viol2}\")\nEOF\n"]
