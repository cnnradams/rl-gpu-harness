[980.49347, "i", "cat > /workspace/repro.py << 'EOF'\nimport os\nos.environ['TORCH_USE_CUDA_DSA'] = '1'\nimport torch, sys, traceback\nsys.path.insert(0, '/workspace')\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solmod', '/workspace/solution.py')\nsolmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(solmod)\nModelNew = solmod.ModelNew\n\ntorch.manual_seed(42)\nmn = ModelNew(4096, 4096, 0.5)\nmn = mn.to(device='cuda', dtype=torch.float32)\nx = torch.rand(16384, 4096, device='cuda')\nwith torch.no_grad():\n    try:\n        # bypass wrapper: call internals directly to surface exception\n        mn._prepare()\n        print('prepared:', mn._wh is not None, mn._wh.device if mn._wh is not None else None)\n        y = solmod._split_gemm(x, mn._wh, mn._wl, mn._bias)\n        torch.cuda.synchronize()\n        print('split_gemm OK', y.shape, y.dtype, float(y.abs().mean()))\n    except Exception:\n        traceback.print_exc()\n    # also test full forward path\n    try:\n        y2 = mn(x)\n        torch.cuda.synchron"]
[980.493523, "i", "ize()\n        print('forward OK; fast_ok=', mn._fast_ok)\n    except Exception:\n        traceback.print_exc()\nEOF\ngpu run --cwd /workspace -- python3 /workspace/repro.py\n"]
