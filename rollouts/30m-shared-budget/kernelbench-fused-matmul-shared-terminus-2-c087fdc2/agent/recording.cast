[1350.121999, "o", "\u001b[?2004h> "]
[1350.12209, "o", "    x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[1350.122129, "o", "\u001b[?2004h> "]
[1350.122255, "o", "    yref = ref(x); yref = yref * 0.5 + yref.clone().detach()\r\n\u001b[?2004l\r"]
