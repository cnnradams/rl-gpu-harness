[1350.120385, "i", "cat > /workspace/smoke.py << 'EOF'\nimport os, sys, torch, importlib.util, traceback\nsys.path.insert(0, '/workspace')\nspec = importlib.util.spec_from_file_location('solmod', '/workspace/solution.py')\nsolmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(solmod)\ntorch.manual_seed(42)\nref = torch.nn.Linear(4096, 4096).cuda()\nmn = solmod.ModelNew(4096, 4096, 0.5).cuda()\nwith torch.no_grad():\n    mn.matmul.weight.copy_(ref.weight); mn.matmul.bias.copy_(ref.bias)\n    x = torch.rand(16384, 4096, device='cuda')\n    yref = ref(x); yref = yref * 0.5 + yref.clone().detach()\n    y = mn(x)\n    torch.cuda.synchronize()\n    print('allclose:', torch.allclose(yref, y, atol=1e-4, rtol=1e-4), 'kernel_ready:', solmod._kernel_ready[0])\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    for _ in range(5): mn(x)\n    torch.cuda.synchronize(); s.record()\n    for _ in range(10): mn(x)\n    e.record(); torch.cuda.synchronize()\n    print('avg ms:', s.elapsed_time(e) / 10)\nEOF\ngpu run --cwd /workspace -- pytho"]
[1350.120449, "i", "n3 /workspace/smoke.py\n"]
