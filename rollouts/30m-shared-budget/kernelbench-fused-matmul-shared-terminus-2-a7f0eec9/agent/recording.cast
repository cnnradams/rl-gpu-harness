[421.306135, "o", "> "]
[421.306345, "o", "        print('bf16x3 max diff', db.max().item(), 'mean', db.mean().item(), 'allclose', torch.allclose(ref, ob, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r\u001b[?2004h"]
[421.306374, "o", "> "]
[421.306406, "o", "        def bf16x3_full():\r\n\u001b[?2004l\r"]
[421.306437, "o", "\u001b[?2004h> "]
[421.306558, "o", "            xh = x.to(torch.bfloat16); xl = (x - xh.float()).to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[421.306603, "o", "\u001b[?2004h> "]
[421.306645, "o", "            o = smm(xl, wb_hi, bs)\r\n\u001b[?2004l\r"]
