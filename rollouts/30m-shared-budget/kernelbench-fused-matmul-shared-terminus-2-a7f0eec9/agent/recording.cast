[875.434731, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[875.434757, "o", "\u001b[?2004h> "]
[875.434801, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[875.434827, "o", "\u001b[?2004h> "]
[875.434872, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[875.434897, "o", "\u001b[?2004h> "]
[875.43494, "o", "        width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[875.434966, "o", "\u001b[?2004h> "]
[875.43501, "o", "        group_id = pid // width\r\n\u001b[?2004l\r"]
[875.435036, "o", "\u001b[?2004h> "]
[875.435131, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[875.435179, "o", "\u001b[?2004h> "]
[875.435243, "o", "        pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[875.435282, "o", "\u001b[?2004h> "]
[875.435334, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[875.435367, "o", "\u001b[?2004h> "]
[875.435421, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[875.435448, "o", "\u001b[?2004h> "]
[875.435508, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[875.435534, "o", "\u001b[?2004h> "]
[875.435574, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[875.4356, "o", "\u001b[?2004h> "]
[875.435684, "o", "        xh_ptrs = xh_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[875.43571, "o", "\u001b[?2004h> "]
[875.435793, "o", "        xl_ptrs = xl_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[875.435818, "o", "\u001b[?2004h> "]
[875.435902, "o", "        wh_ptrs = wh_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[875.435929, "o", "\u001b[?2004h> "]
[875.436011, "o", "        wl_ptrs = wl_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[875.436036, "o", "\u001b[?2004h> "]
[875.43611, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[875.436137, "o", "\u001b[?2004h> "]
[875.436189, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[875.436214, "o", "\u001b[?2004h> "]
[875.436261, "o", "            xh = tl.load(xh_ptrs)\r\n\u001b[?2004l\r"]
[875.436296, "o", "\u001b[?2004h> "]
[875.436334, "o", "            xl = tl.load(xl_ptrs)\r\n\u001b[?2004l\r"]
[875.43636, "o", "\u001b[?2004h> "]
[875.436407, "o", "            wh = tl.load(wh_ptrs)\r\n\u001b[?2004l\r"]
[875.436433, "o", "\u001b[?2004h> "]
[875.436478, "o", "            wl = tl.load(wl_ptrs)\r\n\u001b[?2004l\r"]
[875.436503, "o", "\u001b[?2004h> "]
[875.43655, "o", "            acc += tl.dot(xh, wh)\r\n\u001b[?2004l\r"]
[875.436576, "o", "\u001b[?2004h> "]
[875.436623, "o", "            acc += tl.dot(xh, wl)\r\n\u001b[?2004l\r"]
[875.436657, "o", "\u001b[?2004h> "]
[875.436697, "o", "            acc += tl.dot(xl, wh)\r\n\u001b[?2004l\r"]
[875.43673, "o", "\u001b[?2004h> "]
[875.436755, "o", "            xh_ptrs += BK\r\n\u001b[?2004l\r"]
[875.436782, "o", "\u001b[?2004h> "]
[875.43682, "o", "            xl_ptrs += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[875.436846, "o", "> "]
[875.436893, "o", "            wh_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[875.436947, "o", "            wl_ptrs += BK * N\r\n\u001b[?2004l\r"]
[875.436973, "o", "\u001b[?2004h> "]
[875.437026, "o", "        bias = tl.load(bias_ptr + rn)\r\n\u001b[?2004l\r"]
[875.437052, "o", "\u001b[?2004h> "]
[875.437098, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[875.437123, "o", "\u001b[?2004h> "]
[875.437214, "o", "        out_ptrs = out_ptr + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[875.43724, "o", "\u001b[?2004h> "]
[875.437282, "o", "        tl.store(out_ptrs, acc)\r\n\u001b[?2004l\r"]
[875.437307, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[875.437333, "o", "> "]
[875.43736, "o", "    _KERNEL_OK = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[875.437391, "o", "> "]
[875.437419, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[875.43746, "o", "    _KERNEL_OK = False\r\n\u001b[?2004l\r"]
[875.437485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[875.437511, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[875.437558, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[875.437583, "o", "> "]
[875.437708, "o", "    \"\"\"Linear + scaling + residual, computed as (1+s) * (x @ W^T + b) using a\r\n\u001b[?2004l\r"]
[875.437735, "o", "\u001b[?2004h> "]
[875.437848, "o", "    3-way fp16 split (hi/lo) GEMM with fp32 accumulation, which emulates fp32\r\n\u001b[?2004l\r"]
[875.437874, "o", "\u001b[?2004h> "]
[875.437951, "o", "    matmul accuracy at tensor-core speed on H100.\"\"\"\r\n\u001b[?2004l\r"]
[875.437977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[875.438094, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[875.43812, "o", "\u001b[?2004h> "]
[875.438182, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[875.438208, "o", "\u001b[?2004h> "]
[875.438294, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[875.43832, "o", "\u001b[?2004h> "]
[875.438385, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[875.438411, "o", "\u001b[?2004h> "]
[875.438453, "o", "        self._prepared = False\r\n\u001b[?2004l\r"]
[875.438479, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[875.438504, "o", "> "]
[875.438542, "o", "    def _prepare(self, device):\r\n\u001b[?2004l\r"]
[875.438567, "o", "\u001b[?2004h> "]
[875.438616, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[875.438642, "o", "\u001b[?2004h> "]
[875.43871, "o", "            s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[875.438735, "o", "\u001b[?2004h> "]
[875.438869, "o", "            w = (self.matmul.weight.detach().to(device=device, dtype=torch.float32) * s)\r\n\u001b[?2004l\r"]
[875.438902, "o", "\u001b[?2004h> "]
[875.439025, "o", "            b = (self.matmul.bias.detach().to(device=device, dtype=torch.float32) * s)\r\n\u001b[?2004l\r"]
[875.43905, "o", "\u001b[?2004h> "]
[875.439115, "o", "            wt = w.t().contiguous()  # K x N\r\n\u001b[?2004l\r"]
[875.439141, "o", "\u001b[?2004h> "]
[875.439206, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[875.439231, "o", "> "]
[875.439308, "o", "            wl = (wt - wh.float()).to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[875.439334, "o", "> "]
[875.439386, "o", "            self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[875.439411, "o", "\u001b[?2004h> "]
[875.439466, "o", "            self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[875.439493, "o", "\u001b[?2004h> "]
[875.439549, "o", "            self._bias = b.contiguous()\r\n\u001b[?2004l\r"]
[875.439575, "o", "\u001b[?2004h> "]
[875.439615, "o", "        self._prepared = True\r\n\u001b[?2004l\r"]
[875.439641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[875.439705, "o", "    def _forward_triton(self, x):\r\n\u001b[?2004l\r"]
[875.43973, "o", "\u001b[?2004h> "]
[875.439821, "o", "        if not self._prepared or self._wh.device != x.device:\r\n\u001b[?2004l\r"]
[875.439847, "o", "\u001b[?2004h> "]
[875.439897, "o", "            self._prepare(x.device)\r\n\u001b[?2004l\r"]
[875.439922, "o", "\u001b[?2004h> "]
[875.439949, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[875.439975, "o", "\u001b[?2004h> "]
[875.440019, "o", "        N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[875.440044, "o", "\u001b[?2004h> "]
[875.44007, "o", "        n = x.numel()\r\n\u001b[?2004l\r"]
[875.440095, "o", "\u001b[?2004h> "]
[875.440136, "o", "        xc = x.contiguous()\r\n\u001b[?2004l\r"]
[875.440166, "o", "\u001b[?2004h> "]
[875.440275, "o", "        xh = torch.empty(xc.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[875.4403, "o", "\u001b[?2004h> "]
[875.440408, "o", "        xl = torch.empty(xc.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[875.440434, "o", "\u001b[?2004h> "]
[875.440461, "o", "        BLOCK = 4096\r\n\u001b[?2004l\r"]
[875.440486, "o", "\u001b[?2004h> "]
[875.440612, "o", "        _split_kernel[(triton.cdiv(n, BLOCK),)](xc, xh, xl, n, BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[875.440638, "o", "\u001b[?2004h> "]
[875.440742, "o", "        out = torch.empty(M, N, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[875.440768, "o", "\u001b[?2004h> "]
[875.440828, "o", "        BM, BN, BK, GROUP = 128, 128, 32, 8\r\n\u001b[?2004l\r"]
[875.440854, "o", "\u001b[?2004h> "]
[875.440938, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[875.440964, "o", "\u001b[?2004h> "]
[875.441073, "o", "        _f16x3_kernel[grid](xh, xl, self._wh, self._wl, self._bias, out,\r\n\u001b[?2004l\r"]
[875.441099, "o", "\u001b[?2004h> "]
[875.441186, "o", "                            M, N, K, BM, BN, BK, GROUP,\r\n\u001b[?2004l\r"]
[875.441212, "o", "\u001b[?2004h> "]
[875.441292, "o", "                            num_warps=4, num_stages=3)\r\n\u001b[?2004l\r"]
[875.441317, "o", "\u001b[?2004h> "]
[875.441343, "o", "        return out\r\n\u001b[?2004l\r"]
[875.441369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[875.441421, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[875.441447, "o", "\u001b[?2004h> "]
[875.441527, "o", "        if not x.is_cuda or x.dtype != torch.float32:\r\n\u001b[?2004l\r"]
[875.441552, "o", "\u001b[?2004h> "]
[875.441595, "o", "            y = self.matmul(x)\r\n\u001b[?2004l\r"]
[875.441621, "o", "\u001b[?2004h> "]
[875.441688, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[875.441713, "o", "\u001b[?2004h> "]
[875.441787, "o", "        if _KERNEL_OK and (x.shape[-1] % 32 == 0):\r\n\u001b[?2004l\r"]
[875.441813, "o", "\u001b[?2004h> "]
[875.441839, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[875.441864, "o", "> "]
[875.441927, "o", "                return self._forward_triton(x)\r\n\u001b[?2004l\r"]
[875.441955, "o", "\u001b[?2004h> "]
[875.441994, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[875.442019, "o", "\u001b[?2004h> "]
[875.442045, "o", "                pass\r\n\u001b[?2004l\r"]
[875.44207, "o", "\u001b[?2004h> "]
[875.442127, "o", "        # fallback: eager composition\r\n\u001b[?2004l\r"]
[875.442158, "o", "\u001b[?2004h> "]
[875.442198, "o", "        y = self.matmul(x)\r\n\u001b[?2004l\r"]
[875.442224, "o", "\u001b[?2004h> "]
[875.442288, "o", "        return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[875.442314, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[875.443581, "o", "\u001b[?2004hroot@modal:/# "]
[875.443719, "o", "ls -la /workspace/solution.py\r\n\u001b[?2004l\r"]
[875.44575, "o", "-rw-r--r-- 1 root root 4438 Nov  2 20:56 /workspace/solution.py\r\n"]
[875.445931, "o", "\u001b[?2004hroot@modal:/# "]
