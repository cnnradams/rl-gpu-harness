[779.217677, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[779.217702, "o", "\u001b[?2004h> "]
[779.217777, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[779.217804, "o", "\u001b[?2004h> "]
[779.217863, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[779.21789, "o", "\u001b[?2004h> "]
[779.217947, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[779.217973, "o", "\u001b[?2004h> "]
[779.218031, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[779.218058, "o", "\u001b[?2004h> "]
[779.218093, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[779.218119, "o", "\u001b[?2004h> "]
[779.218199, "o", "    xh_ptrs = xh_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[779.218225, "o", "\u001b[?2004h> "]
[779.218306, "o", "    xl_ptrs = xl_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[779.218333, "o", "\u001b[?2004h> "]
[779.218412, "o", "    wh_ptrs = wh_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[779.218442, "o", "\u001b[?2004h> "]
[779.218523, "o", "    wl_ptrs = wl_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[779.218549, "o", "\u001b[?2004h> "]
[779.218631, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[779.218658, "o", "\u001b[?2004h> "]
[779.218695, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[779.218729, "o", "\u001b[?2004h> "]
[779.218817, "o", "        xh = tl.load(xh_ptrs); xl = tl.load(xl_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.2189, "o", "        wh = tl.load(wh_ptrs); wl = tl.load(wl_ptrs)\r\n\u001b[?2004l\r"]
[779.218926, "o", "\u001b[?2004h> "]
[779.21897, "o", "        acc += tl.dot(xh, wh)\r\n\u001b[?2004l\r"]
[779.218997, "o", "\u001b[?2004h> "]
[779.219039, "o", "        acc += tl.dot(xh, wl)\r\n\u001b[?2004l\r"]
[779.219065, "o", "\u001b[?2004h> "]
[779.219109, "o", "        acc += tl.dot(xl, wh)\r\n\u001b[?2004l\r"]
[779.219135, "o", "\u001b[?2004h> "]
[779.21925, "o", "        xh_ptrs += BK; xl_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\r\n\u001b[?2004l\r"]
[779.219276, "o", "\u001b[?2004h> "]
[779.219325, "o", "    bias = tl.load(bias_ptr + rn)\r\n\u001b[?2004l\r"]
[779.219351, "o", "\u001b[?2004h> "]
[779.219394, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[779.21942, "o", "\u001b[?2004h> "]
[779.219504, "o", "    out_ptrs = out_ptr + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[779.219534, "o", "\u001b[?2004h> "]
[779.219574, "o", "    tl.store(out_ptrs, acc)\r\n\u001b[?2004l\r"]
[779.2196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[779.219628, "o", "\u001b[?2004h> "]
[779.219707, "o", "def run(x, wh, wl, bias, BM, BN, BK, G, warps, stages):\r\n\u001b[?2004l\r"]
[779.219733, "o", "\u001b[?2004h> "]
[779.219785, "o", "    M, K = x.shape; N = wh.shape[1]\r\n\u001b[?2004l\r"]
[779.21981, "o", "\u001b[?2004h> "]
[779.219851, "o", "    xh, xl = fused_split(x)\r\n\u001b[?2004l\r"]
[779.219877, "o", "\u001b[?2004h> "]
[779.219978, "o", "    out = torch.empty(M, N, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[779.220005, "o", "\u001b[?2004h> "]
[779.220086, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[779.220111, "o", "\u001b[?2004h> "]
[779.220225, "o", "    f16x3_kernel[grid](xh, xl, wh, wl, bias, out, M, N, K, BM, BN, BK, G,\r\n\u001b[?2004l\r"]
[779.220251, "o", "\u001b[?2004h> "]
[779.220339, "o", "                       num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[779.220365, "o", "\u001b[?2004h> "]
[779.220392, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.220419, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.220464, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[779.22049, "o", "\u001b[?2004h> "]
[779.220542, "o", "    ref = torch.addmm(bs, x, wt)\r\n\u001b[?2004l\r"]
[779.220569, "o", "\u001b[?2004h> "]
[779.220614, "o", "    wh = wt.to(DT).contiguous()\r\n\u001b[?2004l\r"]
[779.220642, "o", "\u001b[?2004h> "]
[779.220711, "o", "    wl = (wt - wh.float()).to(DT).contiguous()\r\n\u001b[?2004l\r"]
[779.220737, "o", "\u001b[?2004h> "]
[779.220973, "o", "    cfgs = [(128,128,32,8,4,3),(128,256,32,8,8,3),(128,128,32,8,8,3),(128,128,32,4,4,3),(128,256,32,8,4,3),(64,256,32,8,4,3),(128,128,32,16,4,3)]\r\n\u001b[?2004l\r"]
[779.220988, "o", "\u001b[?2004h> "]
[779.22102, "o", "    for c in cfgs:\r\n\u001b[?2004l\r"]
[779.221053, "o", "\u001b[?2004h> "]
[779.221079, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.221148, "o", "            o = run(x, wh, wl, bs, *c)\r\n\u001b[?2004l\r"]
[779.221174, "o", "\u001b[?2004h> "]
[779.221272, "o", "            ok = torch.allclose(ref, o, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[779.221299, "o", "\u001b[?2004h> "]
[779.22136, "o", "            md = (o-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[779.221386, "o", "\u001b[?2004h> "]
[779.221468, "o", "            t = timeit(lambda: run(x, wh, wl, bs, *c))\r\n\u001b[?2004l\r"]
[779.221495, "o", "\u001b[?2004h> "]
[779.221621, "o", "            print(f'fp16 cfg {c}: {t:.3f} ms allclose {ok} maxdiff {md:.2e}')\r\n\u001b[?2004l\r"]
[779.221646, "o", "\u001b[?2004h> "]
[779.22169, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[779.221715, "o", "\u001b[?2004h> "]
[779.221802, "o", "            print(f'fp16 cfg {c}: FAIL {str(ex)[:80]}')\r\n\u001b[?2004l\r"]
[779.221831, "o", "\u001b[?2004h> "]
[779.221903, "o", "    # multi-input accuracy check for best cfg\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.221931, "o", "> "]
[779.221958, "o", "    c = (128,128,32,8,4,3)\r\n\u001b[?2004l\r"]
[779.221986, "o", "\u001b[?2004h> "]
[779.222016, "o", "    worst = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.222122, "o", "    for i in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.22215, "o", "        xi = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[779.222224, "o", "        ri = torch.addmm(bs, xi, wt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.222253, "o", "> "]
[779.222302, "o", "        oi = run(xi, wh, wl, bs, *c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.222329, "o", "> "]
[779.222365, "o", "        di = (oi-ri).abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.222392, "o", "> "]
[779.222475, "o", "        rel = (di / (1e-4 + 1e-4*ri.abs())).max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.222502, "o", "> "]
[779.222548, "o", "        worst = max(worst, rel)\r\n\u001b[?2004l\r"]
[779.222574, "o", "\u001b[?2004h> "]
[779.222717, "o", "        print(f'trial {i}: maxdiff {di.max().item():.2e} worst_ratio_to_tol {rel:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[779.222751, "o", "> "]
[779.222809, "o", "    print('worst ratio (must be <1):', worst)\r\n\u001b[?2004l\r"]
[779.222835, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
