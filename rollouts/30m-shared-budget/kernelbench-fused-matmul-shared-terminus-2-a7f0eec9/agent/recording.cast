[704.831172, "o", "fused split: 0.210 ms\r\ncfg (128, 128, 32, 8, 4, 4): 3.330 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 128, 32, 8, 4, 5): 2.981 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 128, 32, 8, 8, 4): 3.095 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 128, 32, 8, 4, 3): 2.669 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 256, 32, 8, 8, 3): 2.670 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 256, 32, 8, 8, 4): 2.682 ms allclose True maxdiff 7.13e-05\r\ncfg (256, 128, 32, 8, 8, 3): 2.906 ms allclose True maxdiff 7.13e-05\r\ncfg (256, 128, 32, 8, 8, 4): 2.888 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 128, 64, 8, 8, 2): 3.989 ms allclose True maxdiff 7.15e-05\r\ncfg (128, 128, 64, 8, 4, 2): 4.263 ms allclose True maxdiff 7.15e-05\r\ncfg (64, 256, 32, 8, 4, 5): 3.130 ms allclose True maxdiff 7.13e-05\r\ncfg (256, 64, 32, 8, 4, 5): 3.685 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 64, 32, 8, 4, 5): 4.020 ms allclose True maxdiff 7.13e-05\r\ncfg (64, 128, 32, 8, 4, 5): 3.726 ms allclose True maxdiff 7.13e-05\r\ncfg (128, 256, 64, 8, 8, "]
