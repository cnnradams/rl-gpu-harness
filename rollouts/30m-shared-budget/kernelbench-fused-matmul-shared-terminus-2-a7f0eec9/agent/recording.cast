[421.305293, "o", "\u001b[?2004h> "]
[421.305435, "o", "            o.addmm_(xb_hi, wb_lo)  # hmm fp32 addmm with bf16 mats? no - use smm without bias\r\n\u001b[?2004l\r"]
[421.305467, "o", "\u001b[?2004h> "]
[421.305497, "o", "            return o\r\n\u001b[?2004l\r\u001b[?2004h"]
[421.305528, "o", "> "]
[421.305619, "o", "        # accumulation across calls: use torch add on fp32 outputs\r\n\u001b[?2004l\r"]
[421.305648, "o", "\u001b[?2004h> "]
[421.305678, "o", "        def bf16x3b():\r\n\u001b[?2004l\r"]
[421.305708, "o", "\u001b[?2004h> "]
[421.305758, "o", "            o = smm(xb_lo, wb_hi, bs)\r\n\u001b[?2004l\r"]
[421.305789, "o", "\u001b[?2004h> "]
