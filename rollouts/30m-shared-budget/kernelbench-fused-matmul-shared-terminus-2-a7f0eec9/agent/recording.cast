[779.21725, "o", "                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[779.217276, "o", "\u001b[?2004h> "]
[779.217314, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[779.21734, "o", "\u001b[?2004h> "]
[779.21742, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
