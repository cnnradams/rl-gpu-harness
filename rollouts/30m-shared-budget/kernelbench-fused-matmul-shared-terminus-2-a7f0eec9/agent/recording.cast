[504.410695, "i", "cat > /workspace/bench3.py <<'EOF'\nimport torch, time\ntorch.manual_seed(42)\ndev='cuda'\nM,K,N=16384,4096,4096\nx=torch.rand(M,K,device=dev)\nw=(torch.randn(N,K,device=dev)/64)\nb=torch.randn(N,device=dev)/64\nws=(w*1.5).contiguous(); bs=(b*1.5).contiguous()\nwt=ws.t().contiguous()\n\ndef timeit(fn,n=30):\n    for _ in range(8): fn()\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(True); en=torch.cuda.Event(True); ts=[]\n    for _ in range(n):\n        st.record(); fn(); en.record(); torch.cuda.synchronize(); ts.append(st.elapsed_time(en))\n    ts.sort(); return ts[len(ts)//2]\n\ndef mask(t):\n    return (t.view(torch.int32) & -8192).view(torch.float32)\n\nwith torch.no_grad():\n    ref = torch.addmm(bs, x, wt)\n    w_hi = mask(wt); w_lo = mask(wt - w_hi)\n\n    torch.backends.cuda.matmul.allow_tf32 = True\n\n    # breakdown\n    xh = mask(x); xl = mask(x - xh)\n    t_g1 = timeit(lambda: torch.mm(xl, w_hi))\n    print(f'single tf32 mm (static inputs): {t_g1:.3f} ms')\n    t_split = timeit(lambda: (mask(x), mask(x - mask(x))))\n    p"]
[504.410744, "i", "rint(f'split ops: {t_split:.3f} ms')\n\n    # variant: compute out=hi*hi first, then adds\n    def v2():\n        xh = mask(x); xl = mask(x - xh)\n        out = torch.mm(xh, w_hi)\n        out.addmm_(xh, w_lo)\n        out.addmm_(xl, w_hi)\n        out.add_(bs)\n        return out\n    print('v2 allclose', torch.allclose(ref, v2(), atol=1e-4, rtol=1e-4), (v2()-ref).abs().max().item())\n    print(f'v2: {timeit(v2):.3f} ms')\n\n    # compiled version\n    def fwd(x):\n        xh = (x.view(torch.int32) & -8192).view(torch.float32)\n        xl = ((x - xh).view(torch.int32) & -8192).view(torch.float32)\n        out = torch.addmm(bs, xl, w_hi)\n        out.addmm_(xh, w_lo)\n        out.addmm_(xh, w_hi)\n        return out\n    cf = torch.compile(fwd, mode='max-autotune-no-cudagraphs', dynamic=False)\n    oc = cf(x)\n    print('compiled allclose', torch.allclose(ref, oc, atol=1e-4, rtol=1e-4), (oc-ref).abs().max().item())\n    print(f'compiled: {timeit(lambda: cf(x)):.3f} ms')\n    torch.backends.cuda.matmul.allow_tf32 = False\nEOF\ngpu push "]
[504.410757, "i", "sb-cky4Mr0u8AdYiBoDxCGdhU /workspace/bench3.py /workspace/bench3.py\n"]
