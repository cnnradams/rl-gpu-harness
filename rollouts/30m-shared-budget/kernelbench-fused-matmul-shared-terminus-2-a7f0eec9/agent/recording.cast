[177.562328, "i", "cat > /workspace/solution.py <<'EOF'\nimport torch\nimport torch.nn as nn\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._split = False\n\n    def _prepare(self):\n        # fold (x*s + x) = (1+s)*x into the linear weights and split into\n        # hi/lo TF32 components for 3xTF32 emulation of FP32 matmul\n        device = self.matmul.weight.device\n        if device.type != \"cuda\":\n            return\n        with torch.no_grad():\n            s = 1.0 + float(self.scaling_factor)\n            w = (self.matmul.weight * s).contiguous()\n            b = (self.matmul.bias * s).contiguous()\n            self._w_hi = w.to(torch.bfloat16)\n            self._w_lo = (w - self._w_hi.float()).to(torch.bfloat16)\n            self._bias = b\n        self._split = True\n\n    def forward(self, x):\n        if not x.is_cuda:\n            y"]
[177.562376, "i", " = self.matmul(x)\n            return y * self.scaling_factor + y\n        if not self._split or self._w_hi.device != x.device:\n            self._prepare()\n        if x.dtype != torch.float32:\n            return torch.addmm(self._bias.to(x.dtype), x, self._w_hi.to(x.dtype).t())\n        prev = torch.backends.cuda.matmul.allow_tf32\n        torch.backends.cuda.matmul.allow_tf32 = True\n        try:\n            x_hi = x.to(torch.bfloat16)\n            x_lo = (x - x_hi.float()).to(torch.bfloat16)\n            wt_hi = self._w_hi.t()\n            wt_lo = self._w_lo.t()\n            out = torch.addmm(self._bias, x_lo, wt_hi)\n            out.addmm_(x_hi, wt_lo)\n            out.addmm_(x_hi, wt_hi)\n        finally:\n            torch.backends.cuda.matmul.allow_tf32 = prev\n        return out\nEOF\ncat > /workspace/bench.py <<'EOF'\nimport sys, time\nimport torch\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(42"]
[177.562389, "i", ")\ndev = 'cuda'\ninit = get_init_inputs()\nref = Model(*init).to(dev)\nnew = ModelNew(*init).to(dev)\nx = get_inputs()[0].to(dev)\n\nwith torch.no_grad():\n    out_ref = ref(x)\n    out_new = new(x)\n    diff = (out_ref - out_new).abs()\n    print('max diff', diff.max().item(), 'mean diff', diff.mean().item())\n    ok = torch.allclose(out_ref, out_new, atol=1e-4, rtol=1e-4)\n    print('allclose', ok)\n\n    def bench(m, n=30):\n        for _ in range(5):\n            m(x)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        ts = []\n        for _ in range(n):\n            s.record(); m(x); e.record()\n            torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n        ts.sort()\n        return ts[len(ts)//2], sum(ts)/len(ts)\n\n    r_med, r_mean = bench(ref)\n    n_med, n_mean = bench(new)\n    print(f'ref  med {r_med:.3f} ms mean {r_mean:.3f} ms')\n    print(f'new  med {n_med:.3f} ms mean {n_mean:.3f} ms')\n    print(f'speedup {r_med/n_med:.2f}x')\n    # also check re"]
[177.562401, "i", "ference timing unaffected after our forward (flag restore)\n    r_med2, _ = bench(ref)\n    print(f'ref after med {r_med2:.3f} ms')\nEOF\nls /workspace\n"]
