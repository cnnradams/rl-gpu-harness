[682.755605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[682.755636, "o", "\u001b[?2004h> "]
[682.755715, "o", "def run(x, wh, wl, bias, BM, BN, BK, G, warps, stages):\r\n\u001b[?2004l\r"]
[682.755747, "o", "\u001b[?2004h> "]
[682.755795, "o", "    M, K = x.shape; N = wh.shape[1]\r\n\u001b[?2004l\r"]
