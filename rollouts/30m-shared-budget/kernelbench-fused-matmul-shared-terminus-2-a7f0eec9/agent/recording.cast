[682.749764, "i", "cat > /workspace/bench5.py <<'EOF'\nimport torch, triton, triton.language as tl\ntorch.manual_seed(42)\ndev='cuda'\nM,K,N=16384,4096,4096\nx=torch.rand(M,K,device=dev)\nw=(torch.randn(N,K,device=dev)/64)\nb=torch.randn(N,device=dev)/64\nws=(w*1.5).contiguous(); bs=(b*1.5).contiguous()\nwt=ws.t().contiguous()\n\ndef timeit(fn,n=30):\n    for _ in range(8): fn()\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(True); en=torch.cuda.Event(True); ts=[]\n    for _ in range(n):\n        st.record(); fn(); en.record(); torch.cuda.synchronize(); ts.append(st.elapsed_time(en))\n    ts.sort(); return ts[len(ts)//2]\n\n@triton.jit\ndef split_kernel(x_ptr, xh_ptr, xl_ptr, n_elem, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n_elem\n    x = tl.load(x_ptr + offs, mask=m)\n    xh = x.to(tl.bfloat16)\n    xl = (x - xh.to(tl.float32)).to(tl.bfloat16)\n    tl.store(xh_ptr + offs, xh, mask=m)\n    tl.store(xl_ptr + offs, xl, mask=m)\n\ndef fused_split(x):\n    n = x.numel()\n    xh = torc"]
[682.749814, "i", "h.empty(x.shape, device=x.device, dtype=torch.bfloat16)\n    xl = torch.empty(x.shape, device=x.device, dtype=torch.bfloat16)\n    BLOCK = 4096\n    split_kernel[(triton.cdiv(n, BLOCK),)](x, xh, xl, n, BLOCK, num_warps=8)\n    return xh, xl\n\n@triton.jit\ndef bf16x3_kernel(xh_ptr, xl_ptr, wh_ptr, wl_ptr, bias_ptr, out_ptr,\n                  M, N, K,\n                  BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    xh_ptrs = xh_ptr + rm[:, None] * K + rk[None, :]\n    xl_ptrs = xl_ptr + rm[:, None] * K + rk[None, :]\n    wh_ptrs = wh_ptr + rk[:, None] * N + rn[None, :]\n    wl_ptrs = wl_ptr + rk[:, None]"]
[682.749827, "i", " * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        xh = tl.load(xh_ptrs); xl = tl.load(xl_ptrs)\n        wh = tl.load(wh_ptrs); wl = tl.load(wl_ptrs)\n        acc += tl.dot(xh, wh)\n        acc += tl.dot(xh, wl)\n        acc += tl.dot(xl, wh)\n        xh_ptrs += BK; xl_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\n    bias = tl.load(bias_ptr + rn)\n    acc = acc + bias[None, :]\n    out_ptrs = out_ptr + rm[:, None] * N + rn[None, :]\n    tl.store(out_ptrs, acc)\n\ndef run(x, wh, wl, bias, BM, BN, BK, G, warps, stages):\n    M, K = x.shape; N = wh.shape[1]\n    xh, xl = fused_split(x)\n    out = torch.empty(M, N, device=x.device, dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    bf16x3_kernel[grid](xh, xl, wh, wl, bias, out, M, N, K, BM, BN, BK, G,\n                        num_warps=warps, num_stages=stages)\n    return out\n\nwith torch.no_grad():\n    ref = torch.addmm(bs, x, wt)\n    wh = wt.to(torch.bfloat16).contiguous()\n    wl = (wt - wh.f"]
[682.749836, "i", "loat()).to(torch.bfloat16).contiguous()\n    # check fused split alone\n    t_sp = timeit(lambda: fused_split(x))\n    print(f'fused split: {t_sp:.3f} ms')\n    cfgs = [\n        (128,128,32,8,4,4),(128,128,32,8,4,5),(128,128,32,8,8,4),(128,128,32,8,4,3),\n        (128,256,32,8,8,3),(128,256,32,8,8,4),(256,128,32,8,8,3),(256,128,32,8,8,4),\n        (128,128,64,8,8,2),(128,128,64,8,4,2),(64,256,32,8,4,5),(256,64,32,8,4,5),\n        (128,64,32,8,4,5),(64,128,32,8,4,5),(128,256,64,8,8,2),(256,128,64,8,8,2),\n    ]\n    best = None\n    for c in cfgs:\n        try:\n            o = run(x, wh, wl, bs, *c)\n            ok = torch.allclose(ref, o, atol=1e-4, rtol=1e-4)\n            md = (o-ref).abs().max().item()\n            t = timeit(lambda: run(x, wh, wl, bs, *c))\n            print(f'cfg {c}: {t:.3f} ms allclose {ok} maxdiff {md:.2e}')\n            if ok and (best is None or t < best[0]):\n                best = (t, c)\n        except Exception as ex:\n            print(f'cfg {c}: FAIL {str(ex)[:80]}')\n    print('BEST', best)\nEOF\ng"]
[682.749977, "i", "pu push sb-cky4Mr0u8AdYiBoDxCGdhU /workspace/bench5.py /workspace/bench5.py\n"]
