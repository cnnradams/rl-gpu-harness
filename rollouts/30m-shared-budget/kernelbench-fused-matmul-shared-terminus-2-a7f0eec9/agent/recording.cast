[991.640911, "i", "python3 -c \"\nimport ast; ast.parse(open('/workspace/solution.py').read()); print('syntax ok')\nimport sys; sys.path.insert(0,'/workspace')\nimport torch\nfrom solution import ModelNew\nm = ModelNew(64, 32, 0.5)\nx = torch.rand(8, 64)\ny = m(x)\nref = torch.nn.Linear(64,32)\nprint('cpu forward ok', y.shape)\n\"\n"]
[991.641089, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
[991.641133, "o", "\u001b[?2004h> "]
[991.641259, "o", "import ast; ast.parse(open('/workspace/solution.py').read()); print('syntax ok')\r\n\u001b[?2004l\r\u001b[?2004h"]
[991.641275, "o", "> "]
[991.641363, "o", "import sys; sys.path.insert(0,'/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[991.64141, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[991.641453, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[991.641487, "o", "\u001b[?2004h> "]
[991.641521, "o", "m = ModelNew(64, 32, 0.5)\r\n\u001b[?2004l\r"]
[991.641565, "o", "\u001b[?2004h> "]
[991.641598, "o", "x = torch.rand(8, 64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[991.641631, "o", "y = m(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[991.641693, "o", "ref = torch.nn.Linear(64,32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[991.641728, "o", "> "]
[991.641773, "o", "print('cpu forward ok', y.shape)\r\n\u001b[?2004l\r"]
[991.641804, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
[991.651765, "o", "syntax ok\r\n"]
[992.626394, "o", "cpu forward ok torch.Size([8, 32])\r\n"]
[992.825596, "o", "\u001b[?2004hroot@modal:/# "]
[1028.570104, "i", "cat /workspace/solution.py\n"]
[1028.570267, "o", "cat /workspace/solution.py\r\n\u001b[?2004l\r"]
[1028.571174, "o", "import torch\r\nimport torch.nn as nn\r\n\r\n\r\nclass ModelNew(nn.Module):\r\n    def __init__(self, in_features, out_features, scaling_factor):\r\n        super(ModelNew, self).__init__()\r\n        self.matmul = nn.Linear(in_features, out_features)\r\n        self.scaling_factor = scaling_factor\r\n        self._split = False\r\n\r\n    def _prepare(self):\r\n        # fold (x*s + x) = (1+s)*x into the linear weights and split into\r\n        # hi/lo TF32 components for 3xTF32 emulation of FP32 matmul\r\n        device = self.matmul.weight.device\r\n        if device.type != \"cuda\":\r\n            return\r\n        with torch.no_grad():\r\n            s = 1.0 + float(self.scaling_factor)\r\n            w = (self.matmul.weight * s).contiguous()\r\n            b = (self.matmul.bias * s).contiguous()\r\n            self._w_hi = w.to(torch.bfloat16)\r\n            self._w_lo = (w - self._w_hi.float()).to(torch.bfloat16)\r\n            self._bias = b\r\n        self._split = True\r\n\r\n    def forward(self, x):\r\n        if not x.is_cuda:\r\n            y = self.m"]
[1028.571192, "o", "atmul(x)\r\n            return y * self.scaling_factor + y\r\n        if not self._split or self._w_hi.device != x.device:\r\n            self._prepare()\r\n        if x.dtype != torch.float32:\r\n            return torch.addmm(self._bias.to(x.dtype), x, self._w_hi.to(x.dtype).t())\r\n        prev = torch.backends.cuda.matmul.allow_tf32\r\n        torch.backends.cuda.matmul.allow_tf32 = True\r\n        try:\r\n            x_hi = x.to(torch.bfloat16)\r\n            x_lo = (x - x_hi.float()).to(torch.bfloat16)\r\n            wt_hi = self._w_hi.t()\r\n            wt_lo = self._w_lo.t()\r\n            out = torch.addmm(self._bias, x_lo, wt_hi)\r\n            out.addmm_(x_hi, wt_lo)\r\n            out.addmm_(x_hi, wt_hi)\r\n        finally:\r\n            torch.backends.cuda.matmul.allow_tf32 = prev\r\n        return out\r\n"]
[1028.571419, "o", "\u001b[?2004hroot@modal:/# "]
