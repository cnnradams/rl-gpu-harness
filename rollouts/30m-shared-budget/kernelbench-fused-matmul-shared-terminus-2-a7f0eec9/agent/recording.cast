[875.432517, "i", "cat > /workspace/solution.py <<'EOF'\nimport torch\nimport torch.nn as nn\n\n_KERNEL_OK = False\ntry:\n    import triton\n    import triton.language as tl\n\n    @triton.jit\n    def _split_kernel(x_ptr, xh_ptr, xl_ptr, n_elem, BLOCK: tl.constexpr):\n        pid = tl.program_id(0)\n        offs = pid * BLOCK + tl.arange(0, BLOCK)\n        m = offs < n_elem\n        x = tl.load(x_ptr + offs, mask=m)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        tl.store(xh_ptr + offs, xh, mask=m)\n        tl.store(xl_ptr + offs, xl, mask=m)\n\n    @triton.jit\n    def _f16x3_kernel(xh_ptr, xl_ptr, wh_ptr, wl_ptr, bias_ptr, out_ptr,\n                      M, N, K,\n                      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                      GROUP: tl.constexpr):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GROUP * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n "]
[875.432567, "i", "       pid_m = group_id * GROUP + (pid % group_size)\n        pid_n = (pid % width) // group_size\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n        xh_ptrs = xh_ptr + rm[:, None] * K + rk[None, :]\n        xl_ptrs = xl_ptr + rm[:, None] * K + rk[None, :]\n        wh_ptrs = wh_ptr + rk[:, None] * N + rn[None, :]\n        wl_ptrs = wl_ptr + rk[:, None] * N + rn[None, :]\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            xh = tl.load(xh_ptrs)\n            xl = tl.load(xl_ptrs)\n            wh = tl.load(wh_ptrs)\n            wl = tl.load(wl_ptrs)\n            acc += tl.dot(xh, wh)\n            acc += tl.dot(xh, wl)\n            acc += tl.dot(xl, wh)\n            xh_ptrs += BK\n            xl_ptrs += BK\n            wh_ptrs += BK * N\n            wl_ptrs += BK * N\n        bias = tl.load(bias_ptr + rn)\n        acc = acc + bias[None, :]\n        out_ptrs = out_ptr + rm[:, None] * N + rn[None, :]\n        tl.store("]
[875.432575, "i", "out_ptrs, acc)\n\n    _KERNEL_OK = True\nexcept Exception:\n    _KERNEL_OK = False\n\n\nclass ModelNew(nn.Module):\n    \"\"\"Linear + scaling + residual, computed as (1+s) * (x @ W^T + b) using a\n    3-way fp16 split (hi/lo) GEMM with fp32 accumulation, which emulates fp32\n    matmul accuracy at tensor-core speed on H100.\"\"\"\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._prepared = False\n\n    def _prepare(self, device):\n        with torch.no_grad():\n            s = 1.0 + float(self.scaling_factor)\n            w = (self.matmul.weight.detach().to(device=device, dtype=torch.float32) * s)\n            b = (self.matmul.bias.detach().to(device=device, dtype=torch.float32) * s)\n            wt = w.t().contiguous()  # K x N\n            wh = wt.to(torch.float16)\n            wl = (wt - wh.float()).to(torch.float16)\n            self._wh = wh.contiguous()\n"]
[875.432724, "i", "            self._wl = wl.contiguous()\n            self._bias = b.contiguous()\n        self._prepared = True\n\n    def _forward_triton(self, x):\n        if not self._prepared or self._wh.device != x.device:\n            self._prepare(x.device)\n        M, K = x.shape\n        N = self._wh.shape[1]\n        n = x.numel()\n        xc = x.contiguous()\n        xh = torch.empty(xc.shape, device=x.device, dtype=torch.float16)\n        xl = torch.empty(xc.shape, device=x.device, dtype=torch.float16)\n        BLOCK = 4096\n        _split_kernel[(triton.cdiv(n, BLOCK),)](xc, xh, xl, n, BLOCK, num_warps=8)\n        out = torch.empty(M, N, device=x.device, dtype=torch.float32)\n        BM, BN, BK, GROUP = 128, 128, 32, 8\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        _f16x3_kernel[grid](xh, xl, self._wh, self._wl, self._bias, out,\n                            M, N, K, BM, BN, BK, GROUP,\n                            num_warps=4, num_stages=3)\n        return out\n\n    def forward(self, x):\n        if not x.is_cuda or"]
[875.432738, "o", "cat > /workspace/solution.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[875.432776, "i", " x.dtype != torch.float32:\n            y = self.matmul(x)\n            return y * self.scaling_factor + y\n        if _KERNEL_OK and (x.shape[-1] % 32 == 0):\n            try:\n                return self._forward_triton(x)\n            except Exception:\n                pass\n        # fallback: eager composition\n        y = self.matmul(x)\n        return y * self.scaling_factor + y\nEOF\nls -la /workspace/solution.py\n"]
