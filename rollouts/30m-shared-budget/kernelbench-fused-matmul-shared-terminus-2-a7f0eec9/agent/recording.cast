[682.755082, "o", "\u001b[?2004h> "]
[682.755114, "o", "        acc += tl.dot(xl, wh)\r\n\u001b[?2004l\r"]
[682.755145, "o", "\u001b[?2004h> "]
[682.75526, "o", "        xh_ptrs += BK; xl_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\r\n\u001b[?2004l\r"]
[682.75529, "o", "\u001b[?2004h> "]
[682.755336, "o", "    bias = tl.load(bias_ptr + rn)\r\n\u001b[?2004l\r"]
[682.755352, "o", "\u001b[?2004h> "]
[682.755407, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[682.755436, "o", "\u001b[?2004h> "]
[682.755515, "o", "    out_ptrs = out_ptr + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[682.755545, "o", "\u001b[?2004h> "]
