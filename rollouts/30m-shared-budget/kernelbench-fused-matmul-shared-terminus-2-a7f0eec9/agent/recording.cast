[682.752853, "o", "\u001b[?2004h> "]
[682.752892, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[682.753012, "o", "def bf16x3_kernel(xh_ptr, xl_ptr, wh_ptr, wl_ptr, bias_ptr, out_ptr,\r\n\u001b[?2004l\r"]
[682.753028, "o", "\u001b[?2004h> "]
[682.753078, "o", "                  M, N, K,\r\n\u001b[?2004l\r"]
[682.753109, "o", "\u001b[?2004h> "]
[682.753248, "o", "                  BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[682.75328, "o", "\u001b[?2004h> "]
[682.753314, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[682.753343, "o", "\u001b[?2004h> "]
[682.753419, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[682.753452, "o", "\u001b[?2004h> "]
[682.753484, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[682.753515, "o", "\u001b[?2004h> "]
[682.753546, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[682.753578, "o", "\u001b[?2004h> "]
[682.75367, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[682.753702, "o", "\u001b[?2004h> "]
[682.75377, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[682.7538, "o", "\u001b[?2004h> "]
[682.753857, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[682.753896, "o", "\u001b[?2004h> "]
[682.753948, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[682.753982, "o", "\u001b[?2004h> "]
[682.754032, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[682.754063, "o", "\u001b[?2004h> "]
[682.754097, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[682.754128, "o", "\u001b[?2004h> "]
[682.754202, "o", "    xh_ptrs = xh_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[682.75423, "o", "\u001b[?2004h> "]
[682.754309, "o", "    xl_ptrs = xl_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[682.75434, "o", "\u001b[?2004h> "]
[682.754415, "o", "    wh_ptrs = wh_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[682.754446, "o", "\u001b[?2004h> "]
[682.754521, "o", "    wl_ptrs = wl_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[682.754552, "o", "\u001b[?2004h> "]
[682.754627, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[682.754659, "o", "\u001b[?2004h> "]
[682.75469, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[682.754722, "o", "\u001b[?2004h> "]
[682.754801, "o", "        xh = tl.load(xh_ptrs); xl = tl.load(xl_ptrs)\r\n\u001b[?2004l\r"]
