[890.933628, "o", "python3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report.json\r\n\u001b[?2004l\r"]
[893.054223, "o", "Traceback (most recent call last):\r\n  File \"/opt/task/evaluate.py\", line 68, in <module>\r\n    main()\r\n  File \"/opt/task/evaluate.py\", line 54, in main\r\n    report = evaluate(args.solution, correct_trials=args.correct_trials, perf_trials=args.perf_trials)\r\n  File \"/opt/task/evaluate.py\", line 15, in evaluate\r\n    result = eval_kernel_against_ref(\r\n  File \"/usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\", line 430, in eval_kernel_against_ref\r\n    assert torch.cuda.is_available(), \"CUDA is not available, cannot run Eval\"\r\nAssertionError: CUDA is not available, cannot run Eval\r\n"]
