[421.306966, "o", "\u001b[?2004h> "]
[421.307103, "o", "        print(f'bf16x3 full fwd: {t_bf16x3:.3f} ms  speedup vs fp32 {t_fp32/t_bf16x3:.2f}x')\r\n\u001b[?2004l\r"]
[421.307134, "o", "\u001b[?2004h> "]
