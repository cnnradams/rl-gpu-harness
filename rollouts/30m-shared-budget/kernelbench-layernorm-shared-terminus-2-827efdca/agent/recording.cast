[691.15987, "i", "cat > /workspace/tune.py << 'EOF'\nimport sys, torch, triton, itertools\nsys.path.insert(0, '/workspace')\nimport solution\nfrom solution import _ln_partial_kernel, _ln_apply_kernel\n\ndev = torch.device('cuda:0')\nx = torch.rand(16, 64, 256, 256, device=dev)\nN, R = 16, 64*256*256\nw = torch.randn(R, device=dev)\nb = torch.randn(R, device=dev)\ny = torch.empty_like(x)\n\ndef bench(fn, iters=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# separate timing\nfor C in [64, 128, 256]:\n    BLOCK = R // C\n    for nw in [4, 8, 16]:\n        parts = torch.empty(N*C*2, device=dev, dtype=torch.float32)\n        t1 = bench(lambda: _ln_partial_kernel[(N*C,)](x, parts, R, C=C, BLOCK=BLOCK, num_warps=nw))\n        t2 = bench(lambda: _ln_apply_kernel[(N*C,)](x, y, parts, w, b, R, 1e-5, 1.0/R, C=C, BLOCK=BLOCK, NW=1,"]
[691.159917, "i", " num_warps=nw))\n        print(f'C={C} nw={nw}: partial {t1*1000:.1f} us, apply {t2*1000:.1f} us, total {(t1+t2)*1000:.1f} us')\n\n# end-to-end e2e with per-call overhead\nfor C in [64, 128, 256]:\n    BLOCK = R // C\n    def e2e():\n        parts = torch.empty(N*C*2, device=dev, dtype=torch.float32)\n        _ln_partial_kernel[(N*C,)](x, parts, R, C=C, BLOCK=BLOCK, num_warps=8)\n        _ln_apply_kernel[(N*C,)](x, y, parts, w, b, R, 1e-5, 1.0/R, C=C, BLOCK=BLOCK, NW=1, num_warps=8)\n    t = bench(e2e)\n    print(f'E2E C={C}: {t*1000:.1f} us')\nEOF\ngpu push sb-z6e12UCnnEi03BPPjIjkJs /workspace/tune.py /workspace/tune.py\n"]
