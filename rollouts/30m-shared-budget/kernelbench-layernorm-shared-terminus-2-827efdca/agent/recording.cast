[691.163077, "o", "> "]
[691.16335, "o", "        t2 = bench(lambda: _ln_apply_kernel[(N*C,)](x, y, parts, w, b, R, 1e-5, 1.0/R, C=C, BLOCK=BLOCK, NW=1, num_warps=nw))\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.163388, "o", "> "]
[691.163636, "o", "        print(f'C={C} nw={nw}: partial {t1*1000:.1f} us, apply {t2*1000:.1f} us, total {(t1+t2)*1000:.1f} us')\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.163675, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[691.163711, "o", "> "]
[691.163783, "o", "# end-to-end e2e with per-call overhead\r\n\u001b[?2004l\r"]
[691.163818, "o", "\u001b[?2004h> "]
[691.163865, "o", "for C in [64, 128, 256]:\r\n\u001b[?2004l\r"]
[691.163896, "o", "\u001b[?2004h> "]
[691.163934, "o", "    BLOCK = R // C\r\n\u001b[?2004l\r"]
[691.163966, "o", "\u001b[?2004h> "]
[691.164005, "o", "    def e2e():\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.164042, "o", "> "]
[691.164179, "o", "        parts = torch.empty(N*C*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.16422, "o", "> "]
[691.164383, "o", "        _ln_partial_kernel[(N*C,)](x, parts, R, C=C, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.16442, "o", "> "]
[691.16466, "o", "        _ln_apply_kernel[(N*C,)](x, y, parts, w, b, R, 1e-5, 1.0/R, C=C, BLOCK=BLOCK, NW=1, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[691.164703, "o", "> "]
[691.164742, "o", "    t = bench(e2e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[691.164848, "o", "    print(f'E2E C={C}: {t*1000:.1f} us')\r\n\u001b[?2004l\r"]
