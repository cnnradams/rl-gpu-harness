[451.342011, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch, torch.nn as nn\nsys.path.insert(0, '/workspace')\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndev = torch.device('cuda:0')\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\nshape = (64, 256, 256)\n\nref = nn.LayerNorm(shape).to(dev)\nwith torch.no_grad():\n    ref.weight.copy_(torch.randn(shape, device=dev))\n    ref.bias.copy_(torch.randn(shape, device=dev))\n\nfrom solution import ModelNew\nnew = ModelNew(shape).to(dev)\nnew.ln.weight.data.copy_(ref.weight.data)\nnew.ln.bias.data.copy_(ref.bias.data)\n\nwith torch.no_grad():\n    y_ref = ref(x)\n    y_new = new(x)\n    y64 = torch.layer_norm(x.double(), shape, ref.weight.double(), ref.bias.double(), ref.eps)\n\nd_new = (y_new.double() - y64).abs().max().item()\nd_ref = (y_ref.double() - y64).abs().max().item()\nprint('max abs err vs fp64: new %.3e ref %.3e' % (d_new, d_ref))\nprint('allclose(1e-4):', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\n\nfor name, m in [('ref', ref), ('new', n"]
[451.342202, "i", "ew)]:\n    ts = time_execution_with_cuda_event(m, [x], num_trials=30, verbose=False, device=dev)\n    import numpy as np\n    print(name, 'mean %.4f ms  min %.4f ms' % (np.mean(ts), np.min(ts)))\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/bench.py').read()); print('syntax ok')\"\n"]
