[60.307515, "o", "    except (TypeError, OverflowError) as e:\r\n        print(f\"[WARNING] Metadata is not JSON serializable, error: {str(e)}\")\r\n        # Convert non-serializable values to strings\r\n        metadata = {\r\n            \"eval_0\": {\r\n                k: (\r\n                    str(v)\r\n                    if not isinstance(\r\n                        v, (dict, list, str, int, float, bool, type(None))\r\n                    )\r\n"]
[60.307536, "o", "                    else v\r\n                )\r\n                for k, v in metadata[\"eval_0\"].items()\r\n            }\r\n        }\r\n        print(\r\n"]
[60.307557, "o", "            f\"[WARNING] Metadata now converted to string: {metadata} to be JSON serializable\"\r\n        )\r\n\r\n    return metadata\r\n\r\n\r\n"]
[60.307578, "o", "def check_metadata_serializable_all_types(metadata: dict):\r\n    \"\"\"\r\n    Ensure metadata is JSON serializable,\r\n    if not, convert non-serializable values to strings recursively\r\n    \"\"\"\r\n\r\n    def convert_to_serializable(obj):\r\n"]
[60.307598, "o", "        if isinstance(obj, dict):\r\n            return {k: convert_to_serializable(v) for k, v in obj.items()}\r\n        elif isinstance(obj, (list, tuple)):\r\n            return [convert_to_serializable(v) for v in obj]\r\n"]
[60.307619, "o", "        elif isinstance(obj, (str, int, float, bool, type(None))):\r\n            return obj\r\n        else:\r\n            return str(obj)\r\n\r\n    try:\r\n"]
[60.307639, "o", "        json.dumps(metadata)\r\n        return metadata\r\n    except (TypeError, OverflowError) as e:\r\n        print(f\"[WARNING] Metadata is not JSON serializable, error: {str(e)}\")\r\n        # Convert non-serializable values to strings recursively\r\n"]
[60.307659, "o", "        converted_metadata = convert_to_serializable(metadata)\r\n        print(\r\n            f\"[WARNING] Metadata now converted to be JSON serializable: {converted_metadata}\"\r\n        )\r\n        return converted_metadata\r\n\r\n\r\n"]
