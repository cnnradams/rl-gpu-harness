[1168.12737, "o", "[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\nfused SPLIT=16 BLOCK=4096 w=8 st=4 ok=True maxdiff=2.98e-06 mean=326.0us min=320.4us\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\nfused SPLIT=16 BLOCK=8192 w=8 st=4 ok=True maxdiff=2.98e-06 mean=345.1us min=342.3us\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\nfused SPLIT=32 BLOCK=4096 w=8 st=4 ok=True maxdiff=2.98e-06 mean=366.4us min=359.9us\r\n"]
