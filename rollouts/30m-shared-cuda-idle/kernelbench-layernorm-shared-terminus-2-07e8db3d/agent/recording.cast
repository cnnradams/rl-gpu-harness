[1112.394283, "o", "False\r\n[]\r\n['__all__', '__builtins__', '__cached__', '__doc__', '__file__', '__loader__', '__name__', '__package__', '__path__', '__spec__', 'cuda', 'hip', 'is_pkg', 'module', 'module_finder', 'module_from_spec', 'module_name', 'modules', 'pkgutil', 'spec']\r\n"]
[1113.258599, "o", "\u001b[?2004hroot@modal:/# "]
[1159.591202, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl, statistics\nfrom kernelbench.timing import time_execution_with_cuda_event as timeit\ndevice='cuda'\nROWS, N = 16, 64*256*256\nx0 = torch.rand(ROWS, 64, 256, 256, device=device)\nln = nn.LayerNorm((64, 256, 256)).cuda()\nref = ln(x0)\n\n@triton.jit\ndef _ln_fused(X, Y, W, B, S, CNT, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row * N + part * COUNT\n    acc = tl.zeros((BLOCK,), tl.float32)\n    acc2 = tl.zeros((BLOCK,), tl.float32)\n    for off in range(0, COUNT, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    tl.store(S + row * SPLIT * 2 + part * 2 + 0, tl.sum(acc))\n    tl.store(S + row * SPLIT * 2 + part * 2 + 1, tl.sum(acc2))\n    tl.debug_barrier()\n    # release: bump row counter\n    tl.atomic_add(CNT + row, 1, sem='release', scope='gpu')\n "]
[1159.591248, "i", "   # acquire spin until all parts of this row done\n    c = tl.atomic_add(CNT + row, 0, sem='acquire', scope='gpu')\n    while c < SPLIT:\n        c = tl.atomic_add(CNT + row, 0, sem='acquire', scope='gpu')\n    idx = tl.arange(0, SPLIT)\n    s = tl.load(S + row * SPLIT * 2 + idx * 2)\n    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for off in range(0, COUNT, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        j = part * COUNT + off + tl.arange(0, BLOCK)\n        x = tl.load(X + i)\n        w = tl.load(W + j)\n        b = tl.load(B + j)\n        tl.store(Y + i, (x - mean) * rstd * w + b)\n\ndef make_fused(SPLIT, BLOCK, warps, stages):\n    COUNT = N // SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    CNT = torch.zeros(ROWS, device=device, dtype=torch.int32)\n    W = ln.weight.detach().reshape(-1); Bc = ln.bias.detach().reshape(-1)\n    Y = torch.empty(ROWS*N, device=device)\n"]
[1159.591368, "i", "    def fn(x):\n        CNT.zero_()\n        _ln_fused[(ROWS*SPLIT,)](x.reshape(-1), Y, W, Bc, S, CNT, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n        return Y.view(ROWS,64,256,256)\n    return fn\n\nfor (s,b,w,st) in [(16,4096,8,4),(16,8192,8,4),(32,4096,8,4)]:\n    try:\n        fn = make_fused(s,b,w,st)\n        out = fn(x0)\n        torch.cuda.synchronize()\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        md = (ref-out).abs().max().item()\n        t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\n        print(f'fused SPLIT={s} BLOCK={b} w={w} st={st} ok={ok} maxdiff={md:.2e} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n    except Exception as e:\n        print(f'fused SPLIT={s} BLOCK={b} w={w} st={st} FAIL {e}')\nEOF\ngpu push sb-oUB1FrQaiH1QtQdiBuzw9n /workspace/bench7.py /tmp/bench7.py && gpu exec sb-oUB1FrQaiH1QtQdiBuzw9n -- timeout 120 python3 /tmp/bench7.py\n"]
