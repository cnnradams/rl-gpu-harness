[179.092349, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event as timeit\n\ndevice = 'cuda'\nROWS, N = 16, 64*256*256\nx0 = torch.rand(ROWS, 64, 256, 256, device=device)\nln = nn.LayerNorm((64, 256, 256)).cuda()\n\n@triton.jit\ndef _partials(X, S, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row * N + part * COUNT\n    acc = tl.zeros((BLOCK,), tl.float32)\n    acc2 = tl.zeros((BLOCK,), tl.float32)\n    for off in range(0, COUNT, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    tl.store(S + row * SPLIT * 2 + part * 2 + 0, tl.sum(acc))\n    tl.store(S + row * SPLIT * 2 + part * 2 + 1, tl.sum(acc2))\n\n@triton.jit\ndef _normalize(X, Y, W, B, S, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n  "]
[179.092469, "i", "  row = pid // SPLIT\n    part = pid % SPLIT\n    idx = tl.arange(0, SPLIT)\n    s = tl.load(S + row * SPLIT * 2 + idx * 2)\n    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + part * COUNT\n    for off in range(0, COUNT, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        j = part * COUNT + off + tl.arange(0, BLOCK)\n        x = tl.load(X + i)\n        w = tl.load(W + j)\n        b = tl.load(B + j)\n        tl.store(Y + i, (x - mean) * rstd * w + b)\n\ndef make_triton(SPLIT, BLOCK, warps):\n    COUNT = N // SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    W = ln.weight.detach().reshape(-1)\n    B = ln.bias.detach().reshape(-1)\n    X = x0.reshape(-1)\n    Y = torch.empty_like(X)\n    def fn(x):\n        Xv = x.reshape(-1)\n        _partials[(ROWS*SPLIT,)](Xv, S, N, COUNT, BLOCK, SPLIT, num_warps=warps)\n        _normalize[(ROWS*SPLIT,)](Xv, Y, W, B, S, 1e-5, N, COU"]
[179.0925, "i", "NT, BLOCK, SPLIT, num_warps=warps)\n        return Y.view(ROWS, 64, 256, 256)\n    return fn\n\nref = ln(x0)\nprint('eager:', timeit(ln, [x0], num_trials=20, verbose=False, device=device))\ncomp = torch.compile(ln)\ncomp(x0)\nprint('compile:', timeit(comp, [x0], num_trials=20, verbose=False, device=device))\n\nfor SPLIT in (8, 16, 32, 64):\n    for BLOCK in (2048, 4096, 8192):\n        if BLOCK > N // SPLIT: continue\n        for warps in (4, 8):\n            try:\n                fn = make_triton(SPLIT, BLOCK, warps)\n                out = fn(x0)\n                ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n                md = (ref-out).abs().max().item()\n                t = timeit(fn, [x0], num_trials=20, verbose=False, device=device)\n                import statistics\n                print(f'SPLIT={SPLIT} BLOCK={BLOCK} warps={warps} ok={ok} maxdiff={md:.2e} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n            except Exception as e:\n                print(f'SPLIT={SPLIT} BLOCK={BLOCK} warps={warp"]
