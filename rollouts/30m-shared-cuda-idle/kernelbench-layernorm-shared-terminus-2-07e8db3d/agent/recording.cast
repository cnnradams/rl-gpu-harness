[313.215731, "o", "\u001b[?2004hroot@modal:/# "]
[376.851202, "i", "sed -n '/def clear_l2_cache/,/^def /p' /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py | head -40\n"]
[376.851603, "o", "sed -n '/def clear_l2_cache/,/^def /p' /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py | head -40\r\n\u001b[?2004l\r"]
[376.853656, "o", "def clear_l2_cache(device: torch.device | str = \"cuda\"):\r\n    \"\"\"\r\n    Clear L2 Cache line by thrashing with a large tensor\r\n    Acknowledge GPU mode reference kernel repo:\r\n    https://github.com/gpu-mode/reference-kernels/commit/7c15075a39286e88939d99d3f3a60be88b8e6223#diff-3a30a71cbf8db2badd224f4d92f9a2546925a5b522632a31d353526b7a5f3338R158-R163\r\n    \"\"\"\r\n    # don't reserve space for persisting lines\r\n    # cp.cuda.runtime.cudaDeviceSetLimit(cp.cuda.runtime.cudaLimitPersistingL2CacheSize, 0)\r\n    \r\n    # Thrash L2 cache by creating a larger dummy tensor, effectively flushing the cache\r\n    # 32 * 1024 * 1024 * 8B = 256MB \r\n    # NOTE: we can make this more adaptive based on device\r\n    # L2 cache sizes: A100=40MB, H100=50MB, H200=90MB, RTX4090=72MB, L40S=48MB, Blackwell≈192MB → overwrite >200MB to fully thrash L2\r\n    dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\r\n    # write to tensor with inplace fill\r\n    dummy.fill_(42) \r\n    del dummy\r\n\r\ndef clear_l2_cache_triton(cache=N"]
[376.853702, "o", "one, device: str = \"cuda\"):\r\n"]
[376.85381, "o", "\u001b[?2004hroot@modal:/# "]
[386.007438, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl, statistics\nfrom kernelbench.timing import time_execution_with_cuda_event, clear_l2_cache\n\ndevice = 'cuda'\nROWS, N = 16, 64*256*256\nx0 = torch.rand(ROWS, 64, 256, 256, device=device)\nx0f = x0.reshape(-1)\nln = nn.LayerNorm((64, 256, 256)).cuda()\nref = ln(x0)\n\ndef timeit_clean(fn, args, trials=10):\n    with torch.cuda.device(device):\n        for _ in range(3):\n            fn(*args); torch.cuda.synchronize()\n        ts = []\n        buf = torch.empty(60*1024*1024, dtype=torch.int64, device=device)  # 480MB read-only flush\n        for _ in range(trials):\n            torch.cuda.synchronize()\n            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n            _ = buf.sum()  # clean L2 flush (no dirty lines)\n            torch.cuda.synchronize()\n            s.record(); fn(*args); e.record(); torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n        return ts\n\n# pure cop"]
[386.007495, "i", "y calibration\nY = torch.empty_like(x0f)\ndef fn_copy(x): Y.copy_(x.reshape(-1))\nfor name, tf in [('clearL2', lambda f,a: time_execution_with_cuda_event(f,a,num_trials=10,verbose=False,device=device)), ('cleanL2', timeit_clean)]:\n    t = tf(fn_copy, [x0])\n    print(f'copy {name}: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n\n@triton.jit\ndef _partials(X, S, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row * N + part * COUNT\n    acc = tl.zeros((BLOCK,), tl.float32)\n    acc2 = tl.zeros((BLOCK,), tl.float32)\n    for off in range(0, COUNT, BLOCK):\n        xx = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += xx\n        acc2 += xx * xx\n    tl.store(S + row * SPLIT * 2 + part * 2 + 0, tl.sum(acc))\n    tl.store(S + row * SPLIT * 2 + part * 2 + 1, tl.sum(acc2))\n\n@triton.jit\ndef _normalize(X, Y, W, B, S, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT:"]
[386.00751, "i", " tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    idx = tl.arange(0, SPLIT)\n    s = tl.load(S + row * SPLIT * 2 + idx * 2)\n    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + part * COUNT\n    for off in range(0, COUNT, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        j = part * COUNT + off + tl.arange(0, BLOCK)\n        xx = tl.load(X + i)\n        w = tl.load(W + j)\n        b = tl.load(B + j)\n        tl.store(Y + i, (xx - mean) * rstd * w + b)\n\ndef bench(which, SPLIT, BLOCK, warps, stages):\n    COUNT = N // SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    W = ln.weight.detach().reshape(-1); Bc = ln.bias.detach().reshape(-1)\n    Yt = torch.empty(ROWS*N, device=device)\n    if which == 'partials':\n        def fn(x): _partials[(ROWS*SPLIT,)](x.reshape(-1), S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_sta"]
[386.00764, "i", "ges=stages)\n    elif which == 'norm':\n        def fn(x): _normalize[(ROWS*SPLIT,)](x.reshape(-1), Yt, W, Bc, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n    else:\n        def fn(x):\n            _partials[(ROWS*SPLIT,)](x.reshape(-1), S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n            _normalize[(ROWS*SPLIT,)](x.reshape(-1), Yt, W, Bc, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n            return Yt.view(ROWS,64,256,256)\n    out = fn(x0)\n    ok = True\n    if which == 'pair': ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n    t1 = time_execution_with_cuda_event(fn, [x0], num_trials=10, verbose=False, device=device)\n    t2 = timeit_clean(fn, [x0])\n    print(f'{which} SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} ok={ok} clear: mean={statistics.mean(t1)*1000:.1f} min={min(t1)*1000:.1f} | clean: mean={statistics.mean(t2)*1000:.1f} min={min(t2)*1000:.1f}')\n\nfor cfg in [(16,4096,8,5),(16,8192,8,4),(32,4096,8,4),(32,8192,8,3),(64,4096"]
[386.0077, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.007734, "i", ",8,3),(32,2048,4,4),(64,2048,4,4)]:\n    bench('partials', *cfg)\nfor cfg in [(16,4096,8,5),(16,8192,8,4),(32,4096,8,4),(32,8192,8,3),(32,2048,4,4),(16,4096,8,3),(8,8192,8,4)]:\n    bench('norm', *cfg)\nfor cfg in [(16,4096,8,4),(16,8192,8,4),(32,4096,8,4),(32,8192,8,3)]:\n    bench('pair', *cfg)\nEOF\ngpu push sb-zuX5GyVbLIrwQ8P1hIQiwS /workspace/bench3.py /tmp/bench3.py && gpu exec sb-zuX5GyVbLIrwQ8P1hIQiwS -- python3 /tmp/bench3.py\n"]
[386.007755, "o", "> "]
[386.008124, "o", "import torch, torch.nn as nn, triton, triton.language as tl, statistics\r\n\u001b[?2004l\r"]
[386.008151, "o", "\u001b[?2004h> "]
[386.008479, "o", "from kernelbench.timing import time_execution_with_cuda_event, clear_l2_cache\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.008518, "o", "> \r\n\u001b[?2004l\r'\u001b[?2004h"]
[386.008545, "o", "> "]
[386.00858, "o", "device = 'cuda'\r\n\u001b[?2004l\rr"]
[386.008605, "o", "\u001b[?2004h> "]
[386.008703, "o", "ROWS, N = 16, 64*256*256\r\n\u001b[?2004l\r"]
[386.008729, "o", "\u001b[?2004h> "]
[386.008936, "o", "x0 = torch.rand(ROWS, 64, 256, 256, device=device)\r\n\u001b[?2004l\r"]
[386.008969, "o", "\u001b[?2004h> "]
[386.009068, "o", "x0f = x0.reshape(-1)\r\n\u001b[?2004l\r"]
[386.009093, "o", "\u001b[?2004h> "]
[386.009274, "o", "ln = nn.LayerNorm((64, 256, 256)).cuda()\r\n\u001b[?2004l\r"]
[386.0093, "o", "\u001b[?2004h> "]
[386.009357, "o", "ref = ln(x0)\r\n\u001b[?2004l\r"]
[386.009381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r/"]
[386.009419, "o", "\u001b[?2004h"]
[386.009441, "o", "> "]
[386.009551, "o", "def timeit_clean(fn, args, trials=10):\r\n\u001b[?2004l\rI"]
[386.009576, "o", "\u001b[?2004h> "]
[386.009726, "o", "    with torch.cuda.device(device):\r\n\u001b[?2004l\r"]
[386.009752, "o", "\u001b[?2004h"]
[386.009774, "o", "> "]
[386.00983, "o", "        for _ in range(3):\r\n\u001b[?2004l\r"]
[386.009854, "o", "\u001b[?2004h> "]
[386.009971, "o", "            fn(*args); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[386.010001, "o", "\u001b[?2004h> "]
[386.010024, "o", "        ts = []\r\n\u001b[?2004l\r"]
[386.010046, "o", "\u001b[?2004h"]
[386.010072, "o", "> "]
[386.010293, "o", "        buf = torch.empty(60*1024*1024, dtype=torch.int64, device=device)  # 480MB read-only flush\r\n\u001b[?2004l\r"]
[386.010336, "o", "\u001b[?2004h> "]
[386.010429, "o", "        for _ in range(trials):\r\n\u001b[?2004l\r"]
[386.010451, "o", "\u001b[?2004h> "]
[386.010542, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[386.010567, "o", "\u001b[?2004h> "]
[386.010793, "o", "            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[386.010819, "o", "\u001b[?2004h> "]
[386.010962, "o", "            _ = buf.sum()  # clean L2 flush (no dirty lines)\r\n\u001b[?2004l\r"]
[386.010987, "o", "\u001b[?2004h> "]
[386.011075, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[386.011103, "o", "\u001b[?2004h> "]
[386.011266, "o", "            s.record(); fn(*args); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[386.011289, "o", "\u001b[?2004h> "]
[386.011391, "o", "            ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[386.011423, "o", "\u001b[?2004h> "]
[386.011468, "o", "        return ts\r\n\u001b[?2004l\r"]
[386.011499, "o", "\u001b[?2004h> \r\n"]
[386.011528, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[386.01159, "o", "# pure copy calibration\r\n\u001b[?2004l\r"]
[386.01161, "o", "\u001b[?2004h> "]
[386.011672, "o", "Y = torch.empty_like(x0f)\r\n\u001b[?2004l\r"]
[386.011692, "o", "\u001b[?2004h> "]
[386.01179, "o", "def fn_copy(x): Y.copy_(x.reshape(-1))\r\n\u001b[?2004l\r"]
[386.01182, "o", "\u001b[?2004h> "]
[386.012165, "o", "for name, tf in [('clearL2', lambda f,a: time_execution_with_cuda_event(f,a,num_trials=10,verbose=False,device=device)), ('cleanL2', timeit_clean)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.012251, "o", "    t = tf(fn_copy, [x0])\r\n\u001b[?2004l\r"]
[386.012281, "o", "\u001b[?2004h> "]
[386.012486, "o", "    print(f'copy {name}: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.012515, "o", "> \r\n\u001b[?2004l\r"]
[386.012546, "o", "\u001b[?2004h> "]
[386.012567, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[386.012594, "o", "\u001b[?2004h> "]
[386.012819, "o", "def _partials(X, S, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[386.012849, "o", "\u001b[?2004h> "]
[386.012908, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[386.01293, "o", "\u001b[?2004h> "]
[386.012985, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[386.013005, "o", "\u001b[?2004h> "]
[386.01306, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r"]
[386.013084, "o", "\u001b[?2004h> "]
[386.013176, "o", "    base = row * N + part * COUNT\r\n\u001b[?2004l\r"]
[386.013194, "o", "\u001b[?2004h> "]
[386.013291, "o", "    acc = tl.zeros((BLOCK,), tl.float32)\r\n\u001b[?2004l\r"]
[386.013321, "o", "\u001b[?2004h> "]
[386.01342, "o", "    acc2 = tl.zeros((BLOCK,), tl.float32)\r\n\u001b[?2004l\r"]
[386.01344, "o", "\u001b[?2004h> "]
[386.013534, "o", "    for off in range(0, COUNT, BLOCK):\r\n\u001b[?2004l\r"]
[386.013562, "o", "\u001b[?2004h> "]
[386.013692, "o", "        xx = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[386.01372, "o", "\u001b[?2004h> "]
[386.01376, "o", "        acc += xx\r\n\u001b[?2004l\r"]
[386.013781, "o", "\u001b[?2004h> "]
[386.01384, "o", "        acc2 += xx * xx\r\n\u001b[?2004l\r"]
[386.013867, "o", "\u001b[?2004h> "]
[386.014006, "o", "    tl.store(S + row * SPLIT * 2 + part * 2 + 0, tl.sum(acc))\r\n\u001b[?2004l\r"]
[386.014027, "o", "\u001b[?2004h> "]
[386.014173, "o", "    tl.store(S + row * SPLIT * 2 + part * 2 + 1, tl.sum(acc2))\r\n\u001b[?2004l\r"]
[386.014195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[386.014219, "o", "\u001b[?2004h> "]
[386.014259, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[386.014286, "o", "\u001b[?2004h> "]
[386.014562, "o", "def _normalize(X, Y, W, B, S, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.014591, "o", "> "]
[386.01464, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[386.014662, "o", "\u001b[?2004h> "]
[386.014718, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[386.014739, "o", "\u001b[?2004h> "]
[386.014797, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r"]
[386.014827, "o", "\u001b[?2004h> "]
[386.014891, "o", "    idx = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[386.01491, "o", "\u001b[?2004h> "]
[386.015026, "o", "    s = tl.load(S + row * SPLIT * 2 + idx * 2)\r\n\u001b[?2004l\r"]
[386.015054, "o", "\u001b[?2004h> "]
[386.015165, "o", "    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\r\n\u001b[?2004l\r"]
[386.015186, "o", "\u001b[?2004h> "]
[386.015248, "o", "    mean = tl.sum(s) / N\r\n\u001b[?2004l\r"]
[386.015269, "o", "\u001b[?2004h> "]
[386.015363, "o", "    var = tl.sum(s2) / N - mean * mean\r\n\u001b[?2004l\r"]
[386.015387, "o", "\u001b[?2004h> "]
[386.015478, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[386.015498, "o", "\u001b[?2004h> "]
[386.015581, "o", "    base = row * N + part * COUNT\r\n\u001b[?2004l\r"]
[386.015607, "o", "\u001b[?2004h> "]
[386.015702, "o", "    for off in range(0, COUNT, BLOCK):\r\n\u001b[?2004l\r"]
[386.015729, "o", "\u001b[?2004h> "]
[386.015829, "o", "        i = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[386.01586, "o", "\u001b[?2004h> "]
[386.015986, "o", "        j = part * COUNT + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[386.016007, "o", "\u001b[?2004h> "]
[386.01608, "o", "        xx = tl.load(X + i)\r\n\u001b[?2004l\r"]
[386.016101, "o", "\u001b[?2004h> "]
[386.016168, "o", "        w = tl.load(W + j)\r\n\u001b[?2004l\r"]
[386.016188, "o", "\u001b[?2004h> "]
[386.016279, "o", "        b = tl.load(B + j)\r\n\u001b[?2004l\r"]
[386.016304, "o", "\u001b[?2004h> "]
[386.016439, "o", "        tl.store(Y + i, (xx - mean) * rstd * w + b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.01646, "o", "> \r\n\u001b[?2004l\r"]
[386.016481, "o", "\u001b[?2004h> "]
[386.016587, "o", "def bench(which, SPLIT, BLOCK, warps, stages):\r\n\u001b[?2004l\r"]
[386.016605, "o", "\u001b[?2004h> "]
[386.016665, "o", "    COUNT = N // SPLIT\r\n\u001b[?2004l\r"]
[386.016684, "o", "\u001b[?2004h> "]
[386.016861, "o", "    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[386.016884, "o", "\u001b[?2004h> "]
[386.017054, "o", "    W = ln.weight.detach().reshape(-1); Bc = ln.bias.detach().reshape(-1)\r\n\u001b[?2004l\r"]
[386.017085, "o", "\u001b[?2004h> "]
[386.017179, "o", "    Yt = torch.empty(ROWS*N, device=device)\r\n\u001b[?2004l\r"]
[386.017199, "o", "\u001b[?2004h> "]
[386.01727, "o", "    if which == 'partials':\r\n\u001b[?2004l\r"]
[386.017291, "o", "\u001b[?2004h> "]
[386.017584, "o", "        def fn(x): _partials[(ROWS*SPLIT,)](x.reshape(-1), S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.017613, "o", "> "]
[386.017661, "o", "    elif which == 'norm':\r\n\u001b[?2004l\r"]
[386.017681, "o", "\u001b[?2004h> "]
[386.018007, "o", "        def fn(x): _normalize[(ROWS*SPLIT,)](x.reshape(-1), Yt, W, Bc, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.018037, "o", "> "]
[386.018059, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.018077, "o", "> "]
[386.018122, "o", "        def fn(x):\r\n\u001b[?2004l\r"]
[386.018142, "o", "\u001b[?2004h> "]
[386.018425, "o", "            _partials[(ROWS*SPLIT,)](x.reshape(-1), S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.018453, "o", "> "]
[386.018748, "o", "            _normalize[(ROWS*SPLIT,)](x.reshape(-1), Yt, W, Bc, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.018776, "o", "> "]
[386.018874, "o", "            return Yt.view(ROWS,64,256,256)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.018899, "o", "> "]
[386.018935, "o", "    out = fn(x0)\r\n\u001b[?2004l\r"]
[386.018964, "o", "\u001b[?2004h> "]
[386.018991, "o", "    ok = True\r\n\u001b[?2004l\r"]
[386.019012, "o", "\u001b[?2004h> "]
[386.019204, "o", "    if which == 'pair': ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.019233, "o", "> "]
[386.01946, "o", "    t1 = time_execution_with_cuda_event(fn, [x0], num_trials=10, verbose=False, device=device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.019483, "o", "> "]
[386.019558, "o", "    t2 = timeit_clean(fn, [x0])\r\n\u001b[?2004l\r"]
[386.019587, "o", "\u001b[?2004h> "]
[386.020073, "o", "    print(f'{which} SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} ok={ok} clear: mean={statistics.mean(t1)*1000:.1f} min={min(t1)*1000:.1f} | clean: mean={statistics.mean(t2)*1000:.1f} min={min(t2)*1000:.1f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.02011, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[386.020401, "o", "for cfg in [(16,4096,8,5),(16,8192,8,4),(32,4096,8,4),(32,8192,8,3),(64,4096,8,3),(32,2048,4,4),(64,2048,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.020424, "o", "> "]
[386.02048, "o", "    bench('partials', *cfg)\r\n\u001b[?2004l\r"]
[386.020511, "o", "\u001b[?2004h> "]
[386.020763, "o", "for cfg in [(16,4096,8,5),(16,8192,8,4),(32,4096,8,4),(32,8192,8,3),(32,2048,4,4),(16,4096,8,3),(8,8192,8,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.020777, "o", "> "]
[386.02084, "o", "    bench('norm', *cfg)\r\n\u001b[?2004l\r"]
[386.02087, "o", "\u001b[?2004h> "]
[386.021026, "o", "for cfg in [(16,4096,8,4),(16,8192,8,4),(32,4096,8,4),(32,8192,8,3)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[386.021055, "o", "> "]
[386.0211, "o", "    bench('pair', *cfg)\r\n\u001b[?2004l\r"]
[386.021121, "o", "\u001b[?2004h> "]
[386.021152, "o", "EOF\r\n\u001b[?2004l\r"]
