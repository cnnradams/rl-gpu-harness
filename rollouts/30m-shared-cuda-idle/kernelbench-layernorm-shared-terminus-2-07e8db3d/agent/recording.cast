[395.861242, "o", "\u001b[?2004hroot@modal:/# "]
[485.543052, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl, statistics\nfrom kernelbench.timing import time_execution_with_cuda_event as timeit\nimport pynvml\npynvml.nvmlInit()\nh = pynvml.nvmlDeviceGetHandleByIndex(0)\nprint('clocks SM/MEM (MHz):', pynvml.nvmlDeviceGetClockInfo(h,0), pynvml.nvmlDeviceGetClockInfo(h,1))\nprint('max clocks SM/MEM:', pynvml.nvmlDeviceGetMaxClockInfo(h,0), pynvml.nvmlDeviceGetMaxClockInfo(h,1))\n\ndevice='cuda'\n# sustained bandwidth with large copy\ng1 = torch.rand(256*1024*1024, device=device)  # 1GB\ng2 = torch.empty_like(g1)\ndef bigcopy(): g2.copy_(g1)\nfor _ in range(3): bigcopy()\nt = timeit(lambda x: bigcopy(), [0], num_trials=5, verbose=False, device=device)\nprint(f'1GB copy: mean={statistics.mean(t):.3f}ms -> {2*1.073741824/statistics.mean(t)*1000:.0f} GB/s')\nprint('clocks during:', pynvml.nvmlDeviceGetClockInfo(h,0), pynvml.nvmlDeviceGetClockInfo(h,1))\n\nROWS, N = 16, 64*256*256\nx0 = torch.rand(ROWS, 64, 256, 256, device=device)\n\n@triton.jit\ndef"]
[485.543101, "i", " _copy(X, Y, TOT: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    NUM = tl.num_programs(0)\n    for base in range(pid*BLOCK, TOT, NUM*BLOCK):\n        i = base + tl.arange(0, BLOCK)\n        if EV:\n            v = tl.load(X+i, eviction_policy='evict_first')\n            tl.store(Y+i, v)\n        else:\n            tl.store(Y+i, tl.load(X+i))\n\ndef bench_copy(BLOCK, warps, stages, ev, grid_mult):\n    TOT = ROWS*N\n    grid = 132*grid_mult\n    Y = torch.empty(TOT, device=device)\n    def fn(x):\n        _copy[(grid,)](x.reshape(-1), Y, TOT, BLOCK, ev, num_warps=warps, num_stages=stages)\n        return Y\n    fn(x0)\n    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\n    print(f'triton-copy BLOCK={BLOCK} w={warps} st={stages} ev={ev} grid={grid}: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us -> {2*0.067108864/statistics.mean(t)*1000:.0f} GB/s')\n\nfor cfg in [(4096,8,4,False,4),(4096,8,4,True,4),(8192,8,4,True,4),(4096,8,4,True,2),(2048,4,4,True,4),(4096,8"]
[485.543111, "i", ",4,True,8),(16384,16,3,True,4),(4096,8,8,True,4)]:\n    bench_copy(*cfg)\n\n@triton.jit\ndef _normalize2(X, Y, W, B, S, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    idx = tl.arange(0, SPLIT)\n    s = tl.load(S + row * SPLIT * 2 + idx * 2)\n    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + part * COUNT\n    for off in range(0, COUNT, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        j = part * COUNT + off + tl.arange(0, BLOCK)\n        if EV:\n            xx = tl.load(X + i, eviction_policy='evict_first')\n            w = tl.load(W + j)\n            b = tl.load(B + j)\n            tl.store(Y + i, (xx - mean) * rstd * w + b, cache_modifier='.cs')\n        else:\n            xx = tl.load(X + i)\n            w = tl.load(W + j)\n            b = tl.load(B + j)\n     "]
[485.543124, "i", "       tl.store(Y + i, (xx - mean) * rstd * w + b)\n\ndef bench_norm(SPLIT, BLOCK, warps, stages, ev):\n    COUNT = N // SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    Wt = torch.rand(N, device=device); Bt = torch.rand(N, device=device)\n    Yt = torch.empty(ROWS*N, device=device)\n    def fn(x):\n        _normalize2[(ROWS*SPLIT,)](x.reshape(-1), Yt, Wt, Bt, S, 1e-5, N, COUNT, BLOCK, SPLIT, ev, num_warps=warps, num_stages=stages)\n    fn(x0)\n    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\n    print(f'norm2 SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} ev={ev}: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n\nfor cfg in [(16,4096,8,4,False),(16,4096,8,4,True),(16,8192,8,4,True),(32,4096,8,4,True),(64,2048,4,4,True),(16,2048,4,4,True),(64,4096,8,3,True)]:\n    bench_norm(*cfg)\nEOF\ngpu push sb-zuX5GyVbLIrwQ8P1hIQiwS /workspace/bench4.py /tmp/bench4.py && gpu exec sb-zuX5GyVbLIrwQ8P1hIQiwS -- python3 /tmp/bench4.py\n"]
