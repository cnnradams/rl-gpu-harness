[967.276075, "o", "\u001b[?2004h> "]
[967.276192, "o", "        tl.store(Y + i, (x - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[967.276247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[967.276287, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
