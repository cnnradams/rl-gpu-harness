[967.277318, "o", "\u001b[?2004h> "]
[967.277438, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[967.277475, "o", "> "]
