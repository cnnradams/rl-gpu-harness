[967.274834, "o", "\u001b[?2004h> "]
[967.274934, "o", "    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\r\n\u001b[?2004l\r"]
[967.274971, "o", "\u001b[?2004h> "]
[967.27502, "o", "    mean = tl.sum(s) / N\r\n\u001b[?2004l\r"]
[967.275058, "o", "\u001b[?2004h> "]
[967.275141, "o", "    var = tl.sum(s2) / N - mean * mean\r\n\u001b[?2004l\r"]
[967.275178, "o", "\u001b[?2004h> "]
[967.275254, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[967.275292, "o", "\u001b[?2004h> "]
[967.275362, "o", "    base = row * N + part * COUNT\r\n\u001b[?2004l\r"]
[967.2754, "o", "\u001b[?2004h> "]
