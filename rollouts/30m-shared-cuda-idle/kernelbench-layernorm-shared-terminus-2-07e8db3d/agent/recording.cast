[304.523376, "o", "\u001b[?2004h> "]
[304.523648, "o", "        _normalize[(ROWS*SPLIT,)](Xv, Y, W, B, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[304.52367, "o", "\u001b[?2004h> "]
[304.523785, "o", "        return Y.view(ROWS, 64, 256, 256)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.523812, "o", "> "]
[304.523844, "o", "    out = fn(x0)\r\n\u001b[?2004l\r"]
[304.523872, "o", "\u001b[?2004h> "]
[304.524009, "o", "    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.524033, "o", "> "]
[304.52419, "o", "    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\r\n\u001b[?2004l\r"]
[304.524229, "o", "\u001b[?2004h> "]
[304.524566, "o", "    print(f'pair SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} ok={ok} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.524591, "o", "> \r\n\u001b[?2004l\r"]
[304.524612, "o", "\u001b[?2004h> "]
[304.524712, "o", "# separate kernel timing: partials only\r\n\u001b[?2004l\r"]
[304.524739, "o", "\u001b[?2004h> "]
[304.524862, "o", "def run_partial_only(SPLIT, BLOCK, warps, stages):\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.524893, "o", "> "]
[304.524935, "o", "    COUNT = N // SPLIT\r\n\u001b[?2004l\r"]
[304.524963, "o", "\u001b[?2004h> "]
[304.525135, "o", "    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[304.525158, "o", "\u001b[?2004h> "]
[304.525202, "o", "    def fn(x):\r\n\u001b[?2004l\r"]
[304.52523, "o", "\u001b[?2004h> "]
[304.525504, "o", "        _partials[(ROWS*SPLIT,)](x.reshape(-1), S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.525541, "o", "    fn(x0)\r\n\u001b[?2004l\r"]
[304.525568, "o", "\u001b[?2004h> "]
[304.525739, "o", "    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.525766, "o", "> "]
[304.526082, "o", "    print(f'partials-only SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.526108, "o", "> \r\n\u001b[?2004l\r"]
[304.526133, "o", "\u001b[?2004h> "]
[304.526262, "o", "def run_norm_only(SPLIT, BLOCK, warps, stages):\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.526285, "o", "> "]
[304.526335, "o", "    COUNT = N // SPLIT\r\n\u001b[?2004l\r"]
[304.526354, "o", "\u001b[?2004h> "]
[304.526533, "o", "    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[304.526562, "o", "\u001b[?2004h> "]
[304.526727, "o", "    W = ln.weight.detach().reshape(-1); B = ln.bias.detach().reshape(-1)\r\n\u001b[?2004l\r"]
[304.526748, "o", "\u001b[?2004h> "]
[304.526854, "o", "    Y = torch.empty(ROWS*N, device=device)\r\n\u001b[?2004l\r"]
[304.526875, "o", "\u001b[?2004h> "]
[304.526919, "o", "    def fn(x):\r\n\u001b[?2004l\r"]
[304.52694, "o", "\u001b[?2004h> "]
[304.527247, "o", "        _normalize[(ROWS*SPLIT,)](x.reshape(-1), Y, W, B, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[304.527277, "o", "\u001b[?2004h> "]
[304.527308, "o", "    fn(x0)\r\n\u001b[?2004l\r"]
[304.527339, "o", "\u001b[?2004h> "]
[304.527497, "o", "    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.527527, "o", "> "]
[304.527827, "o", "    print(f'norm-only SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.527856, "o", "> \r\n\u001b[?2004l\r"]
[304.527873, "o", "\u001b[?2004h> "]
[304.528193, "o", "for (s,b,w,st) in [(16,4096,8,3),(16,4096,8,5),(16,4096,8,8),(16,8192,8,5),(16,16384,16,4),(32,4096,8,5),(32,8192,8,4),(16,4096,4,5)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.528236, "o", "> "]
[304.528312, "o", "    run_partial_only(s,b,w,st)\r\n\u001b[?2004l\r"]
[304.528334, "o", "\u001b[?2004h> "]
[304.528557, "o", "for (s,b,w,st) in [(16,4096,8,3),(16,4096,8,5),(16,8192,8,5),(16,16384,16,4),(32,4096,8,5)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.528585, "o", "> "]
[304.528645, "o", "    run_norm_only(s,b,w,st)\r\n\u001b[?2004l\r"]
[304.528675, "o", "\u001b[?2004h> "]
[304.52889, "o", "for (s,b,w,st) in [(16,4096,8,5),(16,8192,8,5),(16,4096,8,8),(32,4096,8,5),(16,16384,16,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.528918, "o", "> "]
[304.528964, "o", "    run_pair(s,b,w,st)\r\n\u001b[?2004l\r"]
[304.528988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[304.529015, "o", "\u001b[?2004h> "]
[304.5291, "o", "# var_mean + normalize approach\r\n\u001b[?2004l\r"]
[304.529121, "o", "\u001b[?2004h> "]
[304.529159, "o", "def fn_vm(x):\r\n\u001b[?2004l\r"]
[304.52918, "o", "\u001b[?2004h> "]
[304.52926, "o", "    xf = x.reshape(ROWS, N)\r\n\u001b[?2004l\r"]
[304.52929, "o", "\u001b[?2004h> "]
[304.529459, "o", "    var, mean = torch.var_mean(xf, dim=-1, unbiased=False, keepdim=True)\r\n\u001b[?2004l\r"]
[304.52948, "o", "\u001b[?2004h> "]
[304.529563, "o", "    rstd = torch.rsqrt(var + 1e-5)\r\n\u001b[?2004l\r"]
[304.529585, "o", "\u001b[?2004h> "]
[304.529765, "o", "    return ((xf - mean) * rstd * ln.weight + ln.bias).view(ROWS,64,256,256)\r\n\u001b[?2004l\r"]
[304.529794, "o", "\u001b[?2004h> "]
[304.529832, "o", "out = fn_vm(x0)\r\n\u001b[?2004l\r"]
[304.52986, "o", "\u001b[?2004h> "]
[304.530097, "o", "print('var_mean ok:', torch.allclose(ref, out, atol=1e-4, rtol=1e-4), (ref-out).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.530125, "o", "> "]
[304.530291, "o", "t = timeit(fn_vm, [x0], num_trials=10, verbose=False, device=device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[304.53032, "o", "> "]
[304.530505, "o", "print(f'var_mean full: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\r\n\u001b[?2004l\r"]
[304.530526, "o", "\u001b[?2004h> "]
[304.530579, "o", "def fn_vm_only(x):\r\n\u001b[?2004l\r"]
[304.530606, "o", "\u001b[?2004h> "]
[304.530764, "o", "    return torch.var_mean(x.reshape(ROWS,N), dim=-1, unbiased=False)\r\n\u001b[?2004l\r"]
[304.530795, "o", "\u001b[?2004h> "]
[304.530961, "o", "t = timeit(fn_vm_only, [x0], num_trials=10, verbose=False, device=device)\r\n\u001b[?2004l\r"]
[304.53098, "o", "\u001b[?2004h> "]
[304.531187, "o", "print(f'var_mean only: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\r\n\u001b[?2004l\r"]
[304.531214, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
