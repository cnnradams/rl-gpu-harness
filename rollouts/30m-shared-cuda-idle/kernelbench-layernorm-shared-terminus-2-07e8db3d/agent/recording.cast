[967.27774, "o", "\u001b[?2004h> "]
[967.277953, "o", "        if (not x.is_contiguous()) or x.dtype != torch.float32 or (N % (SPLIT * BLOCK)) != 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[967.277995, "o", "> "]
[967.278042, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[967.27808, "o", "\u001b[?2004h> "]
