[304.515307, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl, statistics\nfrom kernelbench.timing import time_execution_with_cuda_event as timeit\n\ndevice = 'cuda'\nROWS, N = 16, 64*256*256\nx0 = torch.rand(ROWS, 64, 256, 256, device=device)\nln = nn.LayerNorm((64, 256, 256)).cuda()\nref = ln(x0)\n\n@triton.jit\ndef _partials(X, S, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row * N + part * COUNT\n    acc = tl.zeros((BLOCK,), tl.float32)\n    acc2 = tl.zeros((BLOCK,), tl.float32)\n    for off in range(0, COUNT, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    tl.store(S + row * SPLIT * 2 + part * 2 + 0, tl.sum(acc))\n    tl.store(S + row * SPLIT * 2 + part * 2 + 1, tl.sum(acc2))\n\n@triton.jit\ndef _normalize(X, Y, W, B, S, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n   "]
[304.515356, "i", " pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    idx = tl.arange(0, SPLIT)\n    s = tl.load(S + row * SPLIT * 2 + idx * 2)\n    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + part * COUNT\n    for off in range(0, COUNT, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        j = part * COUNT + off + tl.arange(0, BLOCK)\n        x = tl.load(X + i)\n        w = tl.load(W + j)\n        b = tl.load(B + j)\n        tl.store(Y + i, (x - mean) * rstd * w + b)\n\ndef run_pair(SPLIT, BLOCK, warps, stages, measure):\n    COUNT = N // SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    W = ln.weight.detach().reshape(-1); B = ln.bias.detach().reshape(-1)\n    Y = torch.empty(ROWS*N, device=device)\n    def fn(x):\n        Xv = x.reshape(-1)\n        _partials[(ROWS*SPLIT,)](Xv, S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n        _norma"]
[304.51537, "i", "lize[(ROWS*SPLIT,)](Xv, Y, W, B, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n        return Y.view(ROWS, 64, 256, 256)\n    out = fn(x0)\n    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\n    print(f'pair SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} ok={ok} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n\n# separate kernel timing: partials only\ndef run_partial_only(SPLIT, BLOCK, warps, stages):\n    COUNT = N // SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    def fn(x):\n        _partials[(ROWS*SPLIT,)](x.reshape(-1), S, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n    fn(x0)\n    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\n    print(f'partials-only SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n\ndef run_norm_only(SPLIT, BLOCK, warps, stages):\n    COUNT = N /"]
[304.51538, "i", "/ SPLIT\n    S = torch.zeros(ROWS * SPLIT * 2, device=device, dtype=torch.float32)\n    W = ln.weight.detach().reshape(-1); B = ln.bias.detach().reshape(-1)\n    Y = torch.empty(ROWS*N, device=device)\n    def fn(x):\n        _normalize[(ROWS*SPLIT,)](x.reshape(-1), Y, W, B, S, 1e-5, N, COUNT, BLOCK, SPLIT, num_warps=warps, num_stages=stages)\n    fn(x0)\n    t = timeit(fn, [x0], num_trials=10, verbose=False, device=device)\n    print(f'norm-only SPLIT={SPLIT} BLOCK={BLOCK} w={warps} st={stages} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n\nfor (s,b,w,st) in [(16,4096,8,3),(16,4096,8,5),(16,4096,8,8),(16,8192,8,5),(16,16384,16,4),(32,4096,8,5),(32,8192,8,4),(16,4096,4,5)]:\n    run_partial_only(s,b,w,st)\nfor (s,b,w,st) in [(16,4096,8,3),(16,4096,8,5),(16,8192,8,5),(16,16384,16,4),(32,4096,8,5)]:\n    run_norm_only(s,b,w,st)\nfor (s,b,w,st) in [(16,4096,8,5),(16,8192,8,5),(16,4096,8,8),(32,4096,8,5),(16,16384,16,4)]:\n    run_pair(s,b,w,st)\n\n# var_mean + normalize approach\ndef fn_vm(x):\n    xf = x.reshap"]
[304.515484, "i", "e(ROWS, N)\n    var, mean = torch.var_mean(xf, dim=-1, unbiased=False, keepdim=True)\n    rstd = torch.rsqrt(var + 1e-5)\n    return ((xf - mean) * rstd * ln.weight + ln.bias).view(ROWS,64,256,256)\nout = fn_vm(x0)\nprint('var_mean ok:', torch.allclose(ref, out, atol=1e-4, rtol=1e-4), (ref-out).abs().max().item())\nt = timeit(fn_vm, [x0], num_trials=10, verbose=False, device=device)\nprint(f'var_mean full: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\ndef fn_vm_only(x):\n    return torch.var_mean(x.reshape(ROWS,N), dim=-1, unbiased=False)\nt = timeit(fn_vm_only, [x0], num_trials=10, verbose=False, device=device)\nprint(f'var_mean only: mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\nEOF\ngpu push sb-zuX5GyVbLIrwQ8P1hIQiwS /workspace/bench2.py /tmp/bench2.py && gpu exec sb-zuX5GyVbLIrwQ8P1hIQiwS -- python3 /tmp/bench2.py\n"]
