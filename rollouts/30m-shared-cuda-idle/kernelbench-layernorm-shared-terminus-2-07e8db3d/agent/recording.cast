[1228.837827, "i", "cat > /workspace/bench8.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl, statistics\nfrom kernelbench.timing import time_execution_with_cuda_event as timeit\ndevice='cuda'\nROWS, N = 16, 64*256*256\nx0 = torch.rand(ROWS, 64, 256, 256, device=device)\nln = nn.LayerNorm((64, 256, 256)).cuda()\nref = ln(x0)\n\n@triton.jit\ndef _p(X, S, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row * N + part * COUNT\n    acc = tl.zeros((BLOCK,), tl.float32)\n    acc2 = tl.zeros((BLOCK,), tl.float32)\n    for off in range(0, COUNT, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    tl.store(S + row * SPLIT * 2 + part * 2 + 0, tl.sum(acc))\n    tl.store(S + row * SPLIT * 2 + part * 2 + 1, tl.sum(acc2))\n\n@triton.jit\ndef _nm(X, Y, W, B, S, eps, N: tl.constexpr, COUNT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr, EVX: tl.constexpr, ST"]
[1228.837878, "i", "CS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    idx = tl.arange(0, SPLIT)\n    s = tl.load(S + row * SPLIT * 2 + idx * 2)\n    s2 = tl.load(S + row * SPLIT * 2 + idx * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + part * COUNT\n    for off in range(0, COUNT, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        j = part * COUNT + off + tl.arange(0, BLOCK)\n        if EVX:\n            x = tl.load(X + i, eviction_policy='evict_first')\n        else:\n            x = tl.load(X + i)\n        w = tl.load(W + j)\n        b = tl.load(B + j)\n        r = (x - mean) * rstd * w + b\n        if STCS:\n            tl.store(Y + i, r, cache_modifier='.cs')\n        else:\n            tl.store(Y + i, r)\n\ndef make_pair(SP, BP, WP, STP, SN, BN, WN, STN, evx, stcs):\n    CP, CN = N//SP, N//SN\n    S = torch.zeros(ROWS * max(SP,SN) * 2, device=device, dtype=torch.float32)\n    W = ln.weight.detach().reshape(-"]
[1228.838027, "i", "1); Bc = ln.bias.detach().reshape(-1)\n    Y = torch.empty(ROWS*N, device=device)\n    def fn(x):\n        xf = x.reshape(-1)\n        _p[(ROWS*SP,)](xf, S, N, CP, BP, SP, num_warps=WP, num_stages=STP)\n        _nm[(ROWS*SN,)](xf, Y, W, Bc, S, 1e-5, N, CN, BN, SN, evx, stcs, num_warps=WN, num_stages=STN)\n        return Y.view(ROWS,64,256,256)\n    return fn\n\nconfigs = [\n (16,4096,8,4, 16,4096,8,4,False,False),\n (16,4096,8,4, 16,4096,8,4,True,False),\n (16,4096,8,4, 16,4096,8,4,False,True),\n (16,4096,8,4, 16,4096,8,4,True,True),\n (16,8192,8,4, 16,4096,8,3,True,False),\n (16,4096,8,3, 16,4096,8,3,False,False),\n (32,4096,8,4, 16,4096,8,4,False,False),\n (16,4096,8,4, 32,4096,8,4,False,False),\n (16,4096,8,4, 16,4096,16,4,False,False),\n (16,4096,8,4, 16,8192,16,3,False,False),\n (16,16384,16,4, 16,4096,8,4,False,False),\n]\nfor cfg in configs:\n    try:\n        fn = make_pair(*cfg)\n        out = fn(x0)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        t = timeit(fn, [x0], num_trials=20, verbose=False, device="]
[1228.838103, "o", "cat > /workspace/bench8.py << 'EOF'\r\n\u001b[?2004l\r"]
[1228.838143, "i", "device)\n        print(f'{cfg} ok={ok} mean={statistics.mean(t)*1000:.1f}us min={min(t)*1000:.1f}us')\n    except Exception as e:\n        print(f'{cfg} FAIL {e}')\nEOF\ngpu push sb-oUB1FrQaiH1QtQdiBuzw9n /workspace/bench8.py /tmp/bench8.py && gpu exec sb-oUB1FrQaiH1QtQdiBuzw9n -- timeout 180 python3 /tmp/bench8.py\n"]
