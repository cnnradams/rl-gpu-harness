[967.274301, "o", "\u001b[?2004h> "]
[967.274373, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[967.27441, "o", "\u001b[?2004h> "]
[967.274457, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
