[641.482649, "o", "K=1: total mean=196.4us min=188.2us  per-copy=196.4us\r\nK=2: total mean=376.6us min=374.8us  per-copy=188.3us\r\nK=4: total mean=752.7us min=748.3us  per-copy=188.2us\r\nK=8: total mean=1506.9us min=1503.8us  per-copy=188.4us\r\nK=16: total mean=3016.5us min=3010.0us  per-copy=188.5us\r\ncopy right after on-stream fill: mean=189.2us min=188.3us\r\ncopy after fill + sync gap: mean=204.5us min=203.0us\r\n256MB fill alone: mean=88.8us min=86.9us -> 3023 GB/s\r\n"]
[642.414219, "o", "\u001b[?2004hroot@modal:/# "]
[763.55484, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton, triton.language as tl, statistics\nfrom kernelbench.timing import clear_l2_cache\ndevice='cuda'\n\n@triton.jit\ndef _sum(X, OUT, TOT: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    NUM = tl.num_programs(0)\n    acc = tl.zeros((BLOCK,), tl.float32)\n    for base in range(pid*BLOCK, TOT, NUM*BLOCK):\n        acc += tl.load(X + base + tl.arange(0, BLOCK))\n    tl.store(OUT + pid, tl.sum(acc))\n\n@triton.jit\ndef _copy(X, Y, TOT: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    NUM = tl.num_programs(0)\n    for base in range(pid*BLOCK, TOT, NUM*BLOCK):\n        i = base + tl.arange(0, BLOCK)\n        tl.store(Y+i, tl.load(X+i))\n\nout = torch.zeros(528, device=device)\n\ndef sweep():\n    for mb in (16, 32, 64, 128, 256, 512, 1024):\n        n = mb*1024*1024//4\n        x = torch.rand(n, device=device)\n        y = torch.empty(n, device=device)\n        def c(): _copy[(528,)](x, y, n, 4096, num_warps=8, num_stages=4)\n        def s(): _sum[(52"]
[763.554889, "i", "8,)](x, out, n, 4096, num_warps=8, num_stages=4)\n        for f in (c, s):\n            for _ in range(3): f()\n            torch.cuda.synchronize()\n        def timed(fn):\n            ts=[]\n            for _ in range(8):\n                torch.cuda.synchronize()\n                clear_l2_cache(device)\n                a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n                a.record(); fn(); b.record(); torch.cuda.synchronize()\n                ts.append(a.elapsed_time(b)*1000)\n            return statistics.mean(ts)\n        tc, ts_ = timed(c), timed(s)\n        gb = mb/1024\n        print(f'{mb}MB: copy {tc:.1f}us ({2*gb/tc*1e6:.0f} GB/s)  read-only {ts_:.1f}us ({gb/ts_*1e6:.0f} GB/s)')\n        del x, y\n        torch.cuda.empty_cache()\n\nsweep()\n\n# ramp test: 5 consecutive reads of same 256MB buffer, event timed individually, continuous stream\nn = 256*1024*1024//4\nx = torch.rand(n, device=device)\nfor _ in range(3): _sum[(528,)](x, out, n, 4096, num_warps=8, num_stages=4)\ntorch.cuda"]
[763.554914, "i", ".synchronize()\nclear_l2_cache(device)\nevs = [(torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)) for _ in range(6)]\nevs[0][0].record()\nfor k in range(5):\n    _sum[(528,)](x, out, n, 4096, num_warps=8, num_stages=4)\n    evs[k][1].record()\n    evs[k+1][0].record()\ntorch.cuda.synchronize()\nfor k in range(5):\n    print(f'read pass {k}: {evs[k][0].elapsed_time(evs[k][1])*1000:.1f}us')\nEOF\ngpu push sb-zuX5GyVbLIrwQ8P1hIQiwS /workspace/bench6.py /tmp/bench6.py && gpu exec sb-zuX5GyVbLIrwQ8P1hIQiwS -- python3 /tmp/bench6.py\n"]
