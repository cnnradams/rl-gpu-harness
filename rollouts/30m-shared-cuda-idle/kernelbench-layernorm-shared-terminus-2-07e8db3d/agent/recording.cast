[967.275517, "o", "\u001b[?2004h> "]
[967.275612, "o", "        i = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[967.275656, "o", "\u001b[?2004h> "]
[967.275768, "o", "        j = part * COUNT + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[967.275806, "o", "\u001b[?2004h> "]
[967.27586, "o", "        x = tl.load(X + i)\r\n\u001b[?2004l\r"]
[967.275897, "o", "\u001b[?2004h> "]
[967.275952, "o", "        w = tl.load(W + j)\r\n\u001b[?2004l\r"]
[967.275989, "o", "\u001b[?2004h> "]
