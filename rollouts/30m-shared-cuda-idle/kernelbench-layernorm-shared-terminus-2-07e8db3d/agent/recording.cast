[634.527127, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl, statistics\nfrom kernelbench.timing import clear_l2_cache\ndevice='cuda'\nROWS, N = 16, 64*256*256\nTOT = ROWS*N\nx0 = torch.rand(TOT, device=device)\nY = torch.empty(TOT, device=device)\ndummy = torch.empty((32,1024,1024), dtype=torch.int64, device=device)\n\n@triton.jit\ndef _copy(X, Y, TOT: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    NUM = tl.num_programs(0)\n    for base in range(pid*BLOCK, TOT, NUM*BLOCK):\n        i = base + tl.arange(0, BLOCK)\n        tl.store(Y+i, tl.load(X+i))\n\ndef copyk(): _copy[(528,)](x0, Y, TOT, 4096, num_warps=8, num_stages=4)\nfor _ in range(5): copyk()\ntorch.cuda.synchronize()\n\ndef timed(fn, clear=True):\n    ts=[]\n    for _ in range(10):\n        torch.cuda.synchronize()\n        if clear: clear_l2_cache(device)\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_ti"]
[634.52721, "i", "me(e)*1000)\n    return statistics.mean(ts), min(ts)\n\nfor K in (1,2,4,8,16):\n    def fn():\n        for _ in range(K): copyk()\n    m, mn = timed(fn)\n    print(f'K={K}: total mean={m:.1f}us min={mn:.1f}us  per-copy={m/K:.1f}us')\n\n# on-stream: fill then copy without sync (GPU continuously busy)\ndef cont():\n    ts=[]\n    for _ in range(10):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); copyk(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e)*1000)\n    return statistics.mean(ts), min(ts)\nm, mn = cont()\nprint(f'copy right after on-stream fill: mean={m:.1f}us min={mn:.1f}us')\n\n# fill, then sync (idle gap), then timed copy\ndef gap():\n    ts=[]\n    for _ in range(10):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); copyk(); e.record"]
[634.527228, "i", "(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e)*1000)\n    return statistics.mean(ts), min(ts)\nm, mn = gap()\nprint(f'copy after fill + sync gap: mean={m:.1f}us min={mn:.1f}us')\n\n# how long does the fill itself take (event-timed on stream)?\ndef filltime():\n    ts=[]\n    for _ in range(10):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); dummy.fill_(42); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e)*1000)\n    return statistics.mean(ts), min(ts)\nm, mn = filltime()\nprint(f'256MB fill alone: mean={m:.1f}us min={mn:.1f}us -> {0.268435456/m*1e6:.0f} GB/s')\nEOF\ngpu push sb-zuX5GyVbLIrwQ8P1hIQiwS /workspace/bench5.py /tmp/bench5.py && gpu exec sb-zuX5GyVbLIrwQ8P1hIQiwS -- python3 /tmp/bench5.py\n"]
