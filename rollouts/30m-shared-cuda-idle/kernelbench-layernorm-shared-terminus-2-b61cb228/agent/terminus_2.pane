[?2004l[?2004h> import torch
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> from kernelbench.timing import time_execution_with_cuda_event
[?2004l[?2004h> 
[?2004l[?2004h> B, F, D1, D2 = 16, 64, 256, 256
[?2004l[?2004h> NS = F * D1 * D2
[?2004l[?2004h> R = B
[?2004l[?2004h> 
[?2004l[?2004h> def timeit(fn, args, n=15):
[?2004l[?2004h>     t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)
[?2004l[?2004h>     return float(np.mean(t))
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _copy(X, Y, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     tl.store(Y + offs, tl.load(X + offs))
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>     row = pid // S
[?2004l[?2004h>     part = pid % S
[?2004l[?2004h>     base = row * NS_
[?2004l[?2004h>     offs = part * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     if EV:
[?2004l[?2004h>         xv = tl.load(X + base + offs, eviction_policy="evict_last")
[?2004l[?2004h>     else:
[?2004l[?2004h>         xv = tl.load(X + base + offs)
[?2004l[?2004h>     tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))
[?2004l[?2004h>     tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _p2b(X, W, Bv, Y, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>     row = pid // S
[?2004l[?2004h>     part = pid % S
[?2004l[?2004h>     base = row * NS_
[?2004l[?2004h>     poffs = row * S * 2 + tl.arange(0, S) * 2
[?2004l[?2004h>     ps1 = tl.load(PS + poffs)
[?2004l[?2004h>     ps2 = tl.load(PS + poffs + 1)
[?2004l[?2004h>     total = tl.sum(ps1, axis=0)
[?2004l[?2004h>     total2 = tl.sum(ps2, axis=0)
[?2004l[?2004h>     mean = total / NS_
[?2004l[?2004h>     var = total2 / NS_ - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + 1e-5)
[?2004l[?2004h>     offs = part * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     if EV:
[?2004l[?2004h>         xv = tl.load(X + base + offs)
[?2004l[?2004h>         wv = tl.load(W + offs, eviction_policy="evict_last")
[?2004l[?2004h>         bv = tl.load(Bv + offs, eviction_policy="evict_last")
[?2004l[?2004h>         tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv, eviction_policy="evict_first")
[?2004l[?2004h>     else:
[?2004l[?2004h>         xv = tl.load(X + base + offs)
[?2004l[?2004h>         wv = tl.load(W + offs)
[?2004l[?2004h>         bv = tl.load(Bv + offs)
[?2004l[?2004h>         tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     torch.manual_seed(0)
[?2004l[?2004h>     dev = "cuda"
[?2004l[?2004h>     x = torch.rand(B, F, D1, D2, device=dev)
[?2004l[?2004h>     ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)
[?2004l[?2004h>     w = ln.weight.detach().contiguous().view(-1)
[?2004l[?2004h>     b = ln.bias.detach().contiguous().view(-1)
[?2004l[?2004h>     ref = ln(x)
[?2004l[?2004h>     y = torch.empty_like(x)
[?2004l[?2004h> 
[?2004l[?2004h>     # correctness of scheme
[?2004l[?2004h>     S = 512; BLOCK = NS // S
[?2004l[?2004h>     ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)
[?2004l[?2004h>     _p1[(R * S,)](x, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=16, EV=False)
[?2004l[?2004h>     _p2b[(R * S,)](x, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=8, EV=False)
[?2004l[?2004h>     print("max diff p2b:", (y - ref).abs().max().item())
[?2004l[?2004h> 
[?2004l[?2004h>     print("--- triton copy sweep ---")
[?2004l[?2004h>     for CB in [4096, 8192, 16384]:
[?2004l[?2004h>         for nw in [4, 8]:
[?2004l[?2004h>             t = timeit(lambda inp: _copy[(inp.numel() // CB,)](inp, y, BLOCK=CB, num_warps=nw), [x], n=10)
[?2004l[?2004h>             print(f"{t:.4f} ms  copy BLOCK={CB} nw={nw}")
[?2004l[?2004h> 
[?2004l[?2004h>     print("--- p2b sweep (standalone) ---")
[?2004l[?2004h>     for S in [256, 512, 1024]:
[?2004l[?2004h>         BLOCK = NS // S
[?2004l[?2004h>         for nw in [4, 8, 16]:
[?2004l[?2004h>             t = timeit(lambda inp: _p2b[(R * S,)](inp, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw, EV=False), [x], n=10)
[?2004l[?2004h>             print(f"{t:.4f} ms  p2b S={S} BLOCK={BLOCK} nw={nw}")
[?2004l[?2004h> 
[?2004l[?2004h>     print("--- grouped two-kernel ---")
[?2004l[?2004h>     for G in [1, 2, 4, 8]:
[?2004l[?2004h>         rpg = R // G
[?2004l[?2004h>         for S in [256, 512]:
[?2004l[?2004h>             BLOCK = NS // S
[?2004l[?2004h>             for nw1, nw2 in [(16, 8), (16, 16)]:
[?2004l[?2004h>                 for EV in [False, True]:
[?2004l[?2004h>                     psb = torch.empty(R * S * 2, dtype=torch.float32, device=dev)
[?2004l[?2004h>                     def run(inp, G=G, rpg=rpg, S=S, BLOCK=BLOCK, nw1=nw1, nw2=nw2, EV=EV, psb=psb):
[?2004l[?2004h>                         yy = torch.empty_like(inp)
[?2004l[?2004h>                         for g in range(G):
[?2004l[?2004h>                             xg = inp[g * rpg:(g + 1) * rpg]
[?2004l[?2004h>                             psg = psb[g * rpg * S * 2:(g + 1) * rpg * S * 2]
[?2004l[?2004h>                             _p1[(rpg * S,)](xg, psg, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw1, EV=EV)
[?2004l[?2004h>                             _p2b[(rpg * S,)](xg, w, b, yy[g * rpg:(g + 1) * rpg], psg, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw2, EV=EV)
[?2004l[?2004h>                         return yy
[?2004l[?2004h>                     t = timeit(run, [x], n=10)
[?2004l[?2004h>                     print(f"{t:.4f} ms  grouped G={G} S={S} nw1={nw1} nw2={nw2} EV={EV}")
[?2004l[?2004h> 
