[?2004l[?2004h>         pid = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>         base = pid * NS_
[?2004l[?2004h>         s = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>         ss = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>         for part in range(0, NS_ // BLOCK):
[?2004l[?2004h>             offs = part * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>             xv = tl.load(X + base + offs)
