[?2004l[?2004h> import torch
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> from kernelbench.timing import time_execution_with_cuda_event
[?2004l[?2004h> 
[?2004l[?2004h> B, F, D1, D2 = 16, 64, 256, 256
[?2004l[?2004h> NS = F * D1 * D2
[?2004l[?2004h> R = B
[?2004l[?2004h> 
[?2004l[?2004h> def timeit(fn, args, n=20):
[?2004l[?2004h>     t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)
[?2004l[?2004h>     return float(np.mean(t))
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _null(X):
[?2004l[?2004h>     pass
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>     row = pid // S
[?2004l[?2004h>     part = pid % S
[?2004l[?2004h>     base = row * NS_
[?2004l[?2004h>     offs = part * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     xv = tl.load(X + base + offs, eviction_policy="evict_first")
[?2004l[?2004h>     tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))
[?2004l[?2004h>     tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _p2(X, W, Bv, Y, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, RPC: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>     row = pid // RPC
[?2004l[?2004h>     rc = pid % RPC
[?2004l[?2004h>     base = row * NS_
[?2004l[?2004h>     poffs = row * S * 2 + tl.arange(0, S) * 2
[?2004l[?2004h>     ps1 = tl.load(PS + poffs)
[?2004l[?2004h>     ps2 = tl.load(PS + poffs + 1)
[?2004l[?2004h>     total = tl.sum(ps1, axis=0)
[?2004l[?2004h>     total2 = tl.sum(ps2, axis=0)
[?2004l[?2004h>     mean = total / NS_
[?2004l[?2004h>     var = total2 / NS_ - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + 1e-5)
[?2004l[?2004h>     for part in range(rc, S, RPC):
[?2004l[?2004h>         offs = part * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>         xv = tl.load(X + base + offs, eviction_policy="evict_first")
[?2004l[?2004h>         wv = tl.load(W + offs)
[?2004l[?2004h>         bv = tl.load(Bv + offs)
[?2004l[?2004h>         tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv, eviction_policy="evict_first")
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     torch.manual_seed(0)
[?2004l[?2004h>     dev = "cuda"
[?2004l[?2004h>     x = torch.rand(B, F, D1, D2, device=dev)
[?2004l[?2004h>     ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)
[?2004l[?2004h>     w = ln.weight.detach().contiguous().view(-1)
[?2004l[?2004h>     b = ln.bias.detach().contiguous().view(-1)
[?2004l[?2004h>     ref = ln(x)
[?2004l[?2004h>     y = torch.empty_like(x)
[?2004l[?2004h> 
[?2004l[?2004h>     t_null = timeit(lambda inp: _null[(1,)](inp), [x])
[?2004l[?2004h>     print(f"null kernel: {t_null:.4f} ms")
[?2004l[?2004h>     t_clone = timeit(lambda inp: inp.clone(), [x])
[?2004l[?2004h>     print(f"clone:       {t_clone:.4f} ms")
[?2004l[?2004h>     t_copy = timeit(lambda inp: y.copy_(inp), [x])
[?2004l[?2004h>     print(f"copy_:       {t_copy:.4f} ms")
[?2004l[?2004h> 
[?2004l[?2004h>     print("--- p1 only ---")
[?2004l[?2004h>     for S in [64, 128, 256, 512]:
[?2004l[?2004h>         BLOCK = NS // S
[?2004l[?2004h>         for nw in [4, 8, 16]:
[?2004l[?2004h>             ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)
[?2004l[?2004h>             t = timeit(lambda inp: _p1[(R * S,)](inp, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw), [x], n=10)
[?2004l[?2004h>             print(f"{t:.4f} ms  p1 S={S} BLOCK={BLOCK} nw={nw}")
[?2004l[?2004h> 
[?2004l[?2004h>     print("--- p2 only (S=128 partials) ---")
[?2004l[?2004h>     S = 128
[?2004l[?2004h>     ps = torch.rand(R * S * 2, dtype=torch.float32, device=dev)
[?2004l[?2004h>     for RPC in [4, 8, 16]:
[?2004l[?2004h>         for nw in [8, 16, 32]:
[?2004l[?2004h>             t = timeit(lambda inp: _p2[(R * RPC,)](inp, w, b, y, ps, NS_=NS, S=S, BLOCK=NS // S, RPC=RPC, num_warps=nw), [x], n=10)
[?2004l[?2004h>             print(f"{t:.4f} ms  p2 RPC={RPC} nw={nw}")
[?2004l[?2004h> 
[?2004l[?2004h>     print("--- two kernel refined ---")
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for S in [128, 256, 512]:
[?2004l[?2004h>         BLOCK = NS // S
[?2004l[?2004h>         for RPC in [2, 4, 8]:
[?2004l[?2004h>             for nw1 in [4, 8, 16]:
[?2004l[?2004h>                 for nw2 in [8, 16, 32]:
