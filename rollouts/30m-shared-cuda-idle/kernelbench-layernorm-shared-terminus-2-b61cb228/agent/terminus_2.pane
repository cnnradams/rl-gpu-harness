[?2004l[?2004h>         var = total2 / NS_ - mean * mean
[?2004l[?2004h>         rstd = 1.0 / tl.sqrt(var + 1e-5)
[?2004l[?2004h>         for part in range(0, NS_ // BLOCK):
[?2004l[?2004h>             offs = part * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>             xv = tl.load(X + base + offs)
