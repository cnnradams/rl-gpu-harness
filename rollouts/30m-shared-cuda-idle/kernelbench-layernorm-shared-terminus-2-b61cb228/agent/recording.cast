[81.537753, "o", "\u001b[32m\u001b[K502\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Ktime_execution_with_nsight_python(\r\n\u001b[32m\u001b[K548\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kwrapped_kernel():\r\n\u001b[32m\u001b[K579\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kfetch_baseline_time(\r\n\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kget_timing_stats(elapsed_times: list[float], device: torch.device = None) -> dict:\r\n"]
