[516.187374, "o", "    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\r\n\u001b[?2004l\r"]
[516.187416, "o", "\u001b[?2004h"]
[516.187453, "o", "> "]
[516.187534, "o", "    w = ln.weight.detach().contiguous().view(-1)\r\n\u001b[?2004l\r"]
[516.187572, "o", "\u001b[?2004h> "]
