[374.25657, "o", "\u001b[?2004h> "]
[374.256809, "o", "                        best.append((t, f\"two S={S} RPC={RPC} BLOCK={BLOCK} nw1={nw1} nw2={nw2}\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
