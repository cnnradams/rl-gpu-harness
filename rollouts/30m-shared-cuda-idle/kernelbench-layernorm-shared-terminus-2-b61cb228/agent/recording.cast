[923.452659, "o", "    ref = ln(x)\r\n\u001b[?2004l\r"]
[923.452685, "o", "\u001b[?2004h> "]
[923.452751, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[923.45277, "o", "\u001b[?2004h"]
[923.452792, "o", "> "]
[923.452919, "o", "    mr = torch.empty(R * 2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[923.452946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[923.452972, "o", "\u001b[?2004h> "]
[923.453045, "o", "    S = 512; BLOCK = NS // S\r\n\u001b[?2004l\r"]
[923.453063, "o", "\u001b[?2004h> "]
[923.453221, "o", "    ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[923.453239, "o", "\u001b[?2004h> "]
[923.453431, "o", "    _p1[(R * S,)](x, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=16, EV=False)\r\n\u001b[?2004l\r"]
[923.453457, "o", "\u001b[?2004h> "]
[923.453567, "o", "    _mid[(R,)](ps, mr, NS_=NS, S=S, num_warps=4)\r\n\u001b[?2004l\r"]
[923.453593, "o", "\u001b[?2004h> "]
[923.453768, "o", "    _p2c[(R * 8,)](x, w, b, y, mr, NS_=NS, BLOCK=32768, RPC=8, num_warps=16)\r\n\u001b[?2004l\r"]
[923.453795, "o", "\u001b[?2004h> "]
[923.453937, "o", "    print(\"max diff 3-kernel:\", (y - ref).abs().max().item())\r\n\u001b[?2004l\r"]
[923.453965, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[923.453986, "o", "\u001b[?2004h> "]
[923.454038, "o", "    results = []\r\n\u001b[?2004l\r"]
[923.454064, "o", "\u001b[?2004h> "]
[923.454139, "o", "    for S in [256, 512, 1024]:\r\n\u001b[?2004l\r"]
[923.45416, "o", "\u001b[?2004h> "]
[923.454225, "o", "        BLOCK1 = NS // S\r\n\u001b[?2004l\r"]
[923.454251, "o", "\u001b[?2004h> "]
[923.454345, "o", "        for EV in [False, True]:\r\n\u001b[?2004l\r"]
[923.454371, "o", "\u001b[?2004h> "]
[923.454448, "o", "            for RPC in [4, 8, 16]:\r\n\u001b[?2004l\r"]
[923.454466, "o", "\u001b[?2004h> "]
[923.454587, "o", "                for B2 in [16384, 32768, 65536]:\r\n\u001b[?2004l\r"]
[923.454613, "o", "\u001b[?2004h> "]
[923.454715, "o", "                    for nw2 in [8, 16, 32]:\r\n\u001b[?2004l\r"]
[923.454736, "o", "\u001b[?2004h> "]
[923.45495, "o", "                        def run(inp, S=S, BLOCK1=BLOCK1, EV=EV, RPC=RPC, B2=B2, nw2=nw2):\r\n\u001b[?2004l\r"]
[923.454977, "o", "\u001b[?2004h> "]
[923.455117, "o", "                            yy = torch.empty_like(inp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[923.455144, "o", "> "]
[923.455369, "o", "                            psb = torch.empty(R * S * 2, dtype=torch.float32, device=inp.device)\r\n\u001b[?2004l\r"]
[923.455392, "o", "\u001b[?2004h> "]
[923.455618, "o", "                            _p1[(R * S,)](inp, psb, NS_=NS, S=S, BLOCK=BLOCK1, num_warps=16, EV=EV)\r\n\u001b[?2004l\r"]
[923.455644, "o", "\u001b[?2004h> "]
[923.455814, "o", "                            _mid[(R,)](psb, mr, NS_=NS, S=S, num_warps=4)\r\n\u001b[?2004l\r"]
[923.455841, "o", "\u001b[?2004h> "]
[923.456103, "o", "                            _p2c[(R * RPC,)](inp, w, b, yy, mr, NS_=NS, BLOCK=B2, RPC=RPC, num_warps=nw2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[923.45613, "o", "> "]
[923.456212, "o", "                            return yy\r\n\u001b[?2004l\r"]
[923.456237, "o", "\u001b[?2004h> "]
[923.456362, "o", "                        t = timeit(run, [x], n=10)\r\n\u001b[?2004l\r"]
[923.456387, "o", "\u001b[?2004h> "]
[923.456602, "o", "                        results.append((t, f\"S={S} EV={EV} RPC={RPC} B2={B2} nw2={nw2}\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[923.456616, "o", "> "]
[923.456667, "o", "    results.sort()\r\n\u001b[?2004l\r"]
[923.456688, "o", "\u001b[?2004h> "]
[923.456781, "o", "    for t, name in results[:12]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[923.456802, "o", "> "]
[923.456899, "o", "        print(f\"{t:.4f} ms  {name}\")\r\n\u001b[?2004l\r"]
[923.456925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[923.456947, "o", "\u001b[?2004h> "]
[923.456968, "o", "main()\r\n\u001b[?2004l\r"]
[923.456995, "o", "\u001b[?2004h> "]
[923.457015, "o", "EOF\r\n\u001b[?2004l\r"]
