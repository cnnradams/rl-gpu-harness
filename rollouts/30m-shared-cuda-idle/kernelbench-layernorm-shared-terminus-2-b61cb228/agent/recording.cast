[516.181425, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch\nimport numpy as np\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=20):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\n@triton.jit\ndef _null(X):\n    pass\n\n@triton.jit\ndef _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // S\n    part = pid % S\n    base = row * NS_\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xv = tl.load(X + base + offs, eviction_policy=\"evict_first\")\n    tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\n    tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))\n\n@triton.jit\ndef _p2(X, W, Bv, Y, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, RPC: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // RPC\n    rc = pid % RPC\n "]
[516.181475, "i", "   base = row * NS_\n    poffs = row * S * 2 + tl.arange(0, S) * 2\n    ps1 = tl.load(PS + poffs)\n    ps2 = tl.load(PS + poffs + 1)\n    total = tl.sum(ps1, axis=0)\n    total2 = tl.sum(ps2, axis=0)\n    mean = total / NS_\n    var = total2 / NS_ - mean * mean\n    rstd = 1.0 / tl.sqrt(var + 1e-5)\n    for part in range(rc, S, RPC):\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xv = tl.load(X + base + offs, eviction_policy=\"evict_first\")\n        wv = tl.load(W + offs)\n        bv = tl.load(Bv + offs)\n        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv, eviction_policy=\"evict_first\")\n\ndef main():\n    torch.manual_seed(0)\n    dev = \"cuda\"\n    x = torch.rand(B, F, D1, D2, device=dev)\n    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\n    w = ln.weight.detach().contiguous().view(-1)\n    b = ln.bias.detach().contiguous().view(-1)\n    ref = ln(x)\n    y = torch.empty_like(x)\n\n    t_null = timeit(lambda inp: _null[(1,)](inp), [x])\n    print(f\"null kernel: {t_null:.4f} ms\")\n    t_clone = timeit(lambda inp:"]
[516.181641, "i", " inp.clone(), [x])\n    print(f\"clone:       {t_clone:.4f} ms\")\n    t_copy = timeit(lambda inp: y.copy_(inp), [x])\n    print(f\"copy_:       {t_copy:.4f} ms\")\n\n    print(\"--- p1 only ---\")\n    for S in [64, 128, 256, 512]:\n        BLOCK = NS // S\n        for nw in [4, 8, 16]:\n            ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n            t = timeit(lambda inp: _p1[(R * S,)](inp, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw), [x], n=10)\n            print(f\"{t:.4f} ms  p1 S={S} BLOCK={BLOCK} nw={nw}\")\n\n    print(\"--- p2 only (S=128 partials) ---\")\n    S = 128\n    ps = torch.rand(R * S * 2, dtype=torch.float32, device=dev)\n    for RPC in [4, 8, 16]:\n        for nw in [8, 16, 32]:\n            t = timeit(lambda inp: _p2[(R * RPC,)](inp, w, b, y, ps, NS_=NS, S=S, BLOCK=NS // S, RPC=RPC, num_warps=nw), [x], n=10)\n            print(f\"{t:.4f} ms  p2 RPC={RPC} nw={nw}\")\n\n    print(\"--- two kernel refined ---\")\n    results = []\n    for S in [128, 256, 512]:\n        BLOCK = NS // S\n        for RPC in [2"]
[516.181683, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[516.181721, "i", ", 4, 8]:\n            for nw1 in [4, 8, 16]:\n                for nw2 in [8, 16, 32]:\n                    psb = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n                    def run(inp, S=S, BLOCK=BLOCK, RPC=RPC, nw1=nw1, nw2=nw2, psb=psb):\n                        yy = torch.empty_like(inp)\n                        _p1[(R * S,)](inp, psb, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw1)\n                        _p2[(R * RPC,)](inp, w, b, yy, psb, NS_=NS, S=S, BLOCK=BLOCK, RPC=RPC, num_warps=nw2)\n                        return yy\n                    t = timeit(run, [x], n=10)\n                    results.append((t, f\"S={S} RPC={RPC} nw1={nw1} nw2={nw2}\"))\n    results.sort()\n    for t, name in results[:10]:\n        print(f\"{t:.4f} ms  {name}\")\n\nmain()\nEOF\n"]
