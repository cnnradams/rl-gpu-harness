[1205.153878, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch\nimport numpy as np\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=20):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\n@triton.jit\ndef _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // S\n    part = pid % S\n    base = row * NS_\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xv = tl.load(X + base + offs)\n    tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\n    tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))\n\n@triton.jit\ndef _mid(PS, MR, NS_: tl.constexpr, S: tl.constexpr):\n    row = tl.program_id(0).to(tl.int64)\n    poffs = row * S * 2 + tl.arange(0, S) * 2\n    ps1 = tl.load(PS + poffs)\n    ps2 = tl.load(PS + poffs + 1)\n    total = tl.sum(ps1, axis=0)\n    total2 = t"]
[1205.153929, "i", "l.sum(ps2, axis=0)\n    mean = total / NS_\n    var = total2 / NS_ - mean * mean\n    rstd = 1.0 / tl.sqrt(var + 1e-5)\n    tl.store(MR + row * 2 + 0, mean)\n    tl.store(MR + row * 2 + 1, rstd)\n\n@triton.jit\ndef _p2(X, W, Bv, Y, MR, NS_: tl.constexpr, BLOCK: tl.constexpr, RPC: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // RPC\n    rc = pid % RPC\n    base = row * NS_\n    mean = tl.load(MR + row * 2 + 0)\n    rstd = tl.load(MR + row * 2 + 1)\n    S: tl.constexpr = NS_ // BLOCK\n    for part in range(rc, S, RPC):\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xv = tl.load(X + base + offs)\n        wv = tl.load(W + offs)\n        bv = tl.load(Bv + offs)\n        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\n\ndef main():\n    torch.manual_seed(0)\n    dev = \"cuda\"\n    x = torch.rand(B, F, D1, D2, device=dev)\n    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\n    w = ln.weight.detach().reshape(-1).contiguous()\n    b = ln.bias.detach().reshape(-1).contiguous()\n    ref = ln(x)\n    y = t"]
[1205.15406, "i", "orch.empty_like(x)\n    mr = torch.empty(R * 2, dtype=torch.float32, device=dev)\n    results = []\n    for S in [512, 1024, 2048]:\n        BLOCK1 = NS // S\n        psb = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n        for nw1 in [8, 16]:\n            for RPC in [8, 16, 32]:\n                for B2 in [8192, 16384]:\n                    for nw2 in [8, 16]:\n                        def run(inp, S=S, BLOCK1=BLOCK1, nw1=nw1, RPC=RPC, B2=B2, nw2=nw2, psb=psb):\n                            yy = torch.empty_like(inp)\n                            _p1[(R * S,)](inp, psb, NS_=NS, S=S, BLOCK=BLOCK1, num_warps=nw1)\n                            _mid[(R,)](psb, mr, NS_=NS, S=S, num_warps=4)\n                            _p2[(R * RPC,)](inp, w, b, yy, mr, NS_=NS, BLOCK=B2, RPC=RPC, num_warps=nw2)\n                            return yy\n                        t = timeit(run, [x], n=15)\n                        results.append((t, f\"S={S} nw1={nw1} RPC={RPC} B2={B2} nw2={nw2}\"))\n    results.sort()\n    for t, name in results"]
[1205.154106, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r"]
[1205.154142, "i", "[:10]:\n        print(f\"{t:.4f} ms  {name}\")\n\nmain()\nEOF\ngpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/bench5.py /root/bench5.py && gpu exec sb-bUyk9HFBFjwJ288Lk0vN15 -- bash -c 'python3 /root/bench5.py 2>&1 | grep -v Profiling | tail -12'\n"]
