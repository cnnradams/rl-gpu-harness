[1188.279335, "o", "[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.3501 ms  cuda S=256 rpc=64 diff=3.46e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.3759 ms  cuda S=256 rpc=128 diff=3.46e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.4078 ms  cuda S=256 rpc=256 diff=3.46e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.3476 ms  cuda S=512 rpc=64 diff=3.70e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.3737 ms  cuda S=512 rpc=128 diff=3.70e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.4061 ms  cuda S=512 rpc=256 diff=3.70e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.3461 ms  cuda S=1024 rpc=64 diff=3.34e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.3700 ms  cuda S=1024 rpc=128 diff=3.34e-06\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n0.4047 m"]
