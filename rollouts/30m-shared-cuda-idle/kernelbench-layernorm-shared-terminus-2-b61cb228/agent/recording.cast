[316.744683, "o", "def build_compile_cache(\r\n    custom_model_src: str,\r\n    verbose: bool = False,\r\n    build_dir: os.PathLike = None,\r\n) -> tuple[bool, str, str]:\r\n    \"\"\"\r\n    Try to build the compiled cuda code for sample and store in the cache directory\r\n    Should be able to run on CPUs to do this massively in parallel\r\n\r\n    Don't limit ninja to set default number of workers, let it use all the cpu cores possible\r\n    # try do this with a subprocess\r\n    NOTE: currently stdout_buffer does not capture all the compiler warning and failure messages\r\n    Returns:\r\n        tuple[bool, str]: whether compilation is successful, stdout content as string\r\n    \"\"\"\r\n    context = {}\r\n    stdout_buffer = StringIO()\r\n\r\n    if verbose:\r\n"]
[316.744713, "o", "        print(\"[Compilation] Pre-compile custom cuda binaries\")\r\n\r\n    try:\r\n        os.environ[\"TORCH_USE_CUDA_DSA\"] = \"1\"  # compile with device side assertion\r\n        # sys.stdout.flush()\r\n\r\n        # Capture stdout during compilation\r\n"]
[316.744755, "o", "        with redirect_stdout(stdout_buffer), redirect_stderr(stdout_buffer):\r\n            load_custom_model(custom_model_src, context, build_dir)\r\n            # sys.stdout.flush()\r\n\r\n        if verbose:\r\n            print(f\"[Compilation] Compilation Successful, saved cache at: {build_dir}\")\r\n    except Exception as e:\r\n        print(\r\n"]
[316.744784, "o", "            f\"[Compilation] Failed to compile custom CUDA kernel. Unable to cache, \\nError: {e}\"\r\n        )\r\n        return False, stdout_buffer.getvalue(), str(e)\r\n\r\n    return True, stdout_buffer.getvalue(), None\r\n\r\n\r\ndef build_compile_cache_with_capturing(\r\n"]
[316.745003, "o", "\u001b[?2004hroot@modal:/# "]
[374.242796, "i", "mkdir -p /workspace && cat > /workspace/bench.py << 'EOF'\nimport torch\nimport numpy as np\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=20):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\ndef main():\n    torch.manual_seed(0)\n    dev = \"cuda\"\n    x = torch.rand(B, F, D1, D2, device=dev)\n    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\n    w = ln.weight.detach().contiguous().view(-1)\n    b = ln.bias.detach().contiguous().view(-1)\n    ref = ln(x)\n\n    t_eager = timeit(lambda inp: ln(inp), [x])\n    print(f\"eager LayerNorm: {t_eager:.4f} ms\")\n\n    t_fl = timeit(lambda inp: torch.nn.functional.layer_norm(inp, (F,D1,D2), ln.weight, ln.bias, 1e-5), [x])\n    print(f\"F.layer_norm:    {t_fl:.4f} ms\")\n\n    @triton.jit\n    def _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):\n       "]
[374.242951, "i", " pid = tl.program_id(0).to(tl.int64)\n        row = pid // S\n        part = pid % S\n        base = row * NS_\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xv = tl.load(X + base + offs)\n        tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\n        tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))\n\n    @triton.jit\n    def _p2(X, W, Bv, Y, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, RPC: tl.constexpr):\n        pid = tl.program_id(0).to(tl.int64)\n        row = pid // RPC\n        rc = pid % RPC\n        base = row * NS_\n        poffs = row * S * 2 + tl.arange(0, S) * 2\n        ps1 = tl.load(PS + poffs)\n        ps2 = tl.load(PS + poffs + 1)\n        total = tl.sum(ps1, axis=0)\n        total2 = tl.sum(ps2, axis=0)\n        mean = total / NS_\n        var = total2 / NS_ - mean * mean\n        rstd = 1.0 / tl.sqrt(var + 1e-5)\n        for part in range(rc, S, RPC):\n            offs = part * BLOCK + tl.arange(0, BLOCK)\n            xv = tl.load(X + base + offs)\n            wv = tl.load(W + offs)"]
[374.243001, "i", "\n            bv = tl.load(Bv + offs)\n            tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\n\n    @triton.jit\n    def _onepass(X, W, Bv, Y, NS_: tl.constexpr, BLOCK: tl.constexpr):\n        pid = tl.program_id(0).to(tl.int64)\n        base = pid * NS_\n        s = tl.zeros([BLOCK], dtype=tl.float32)\n        ss = tl.zeros([BLOCK], dtype=tl.float32)\n        for part in range(0, NS_ // BLOCK):\n            offs = part * BLOCK + tl.arange(0, BLOCK)\n            xv = tl.load(X + base + offs)\n            s += xv\n            ss += xv * xv\n        total = tl.sum(s, axis=0)\n        total2 = tl.sum(ss, axis=0)\n        mean = total / NS_\n        var = total2 / NS_ - mean * mean\n        rstd = 1.0 / tl.sqrt(var + 1e-5)\n        for part in range(0, NS_ // BLOCK):\n            offs = part * BLOCK + tl.arange(0, BLOCK)\n            xv = tl.load(X + base + offs)\n            wv = tl.load(W + offs)\n            bv = tl.load(Bv + offs)\n            tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\n\n    def run_two(x, S"]
[374.243022, "i", ", RPC, BLOCK, nw1, nw2):\n        y = torch.empty_like(x)\n        ps = torch.empty(R * S * 2, dtype=torch.float32, device=x.device)\n        _p1[(R * S,)](x, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw1)\n        _p2[(R * RPC,)](x, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, RPC=RPC, num_warps=nw2)\n        return y\n\n    def run_one(x, BLOCK, nw):\n        y = torch.empty_like(x)\n        _onepass[(R,)](x, w, b, y, NS_=NS, BLOCK=BLOCK, num_warps=nw)\n        return y\n\n    y = run_two(x, 64, 1, 65536, 16, 16)\n    print(\"two-kernel max diff:\", (y - ref).abs().max().item())\n    y1 = run_one(x, 16384, 32)\n    print(\"onepass max diff:\", (y1 - ref).abs().max().item())\n\n    best = []\n    for S in [32, 64, 128]:\n        BLOCK = NS // S\n        for RPC in [1, 2, 4, 8]:\n            for nw1 in [8, 16, 32]:\n                for nw2 in [8, 16, 32]:\n                    try:\n                        t = timeit(lambda inp: run_two(inp, S, RPC, BLOCK, nw1, nw2), [x], n=10)\n                        best.append((t, f\"two S={S} RPC={RPC} BLOCK="]
[374.243038, "i", "{BLOCK} nw1={nw1} nw2={nw2}\"))\n                    except Exception as e:\n                        print(\"fail\", S, RPC, BLOCK, nw1, nw2, e)\n    for BLOCK in [8192, 16384, 32768]:\n        for nw in [16, 32]:\n            t = timeit(lambda inp: run_one(inp, BLOCK, nw), [x], n=10)\n            best.append((t, f\"one BLOCK={BLOCK} nw={nw}\"))\n    best.sort()\n    for t, name in best[:15]:\n        print(f\"{t:.4f} ms  {name}\")\n    print(f\"speedup best vs eager: {t_eager/best[0][0]:.2f}x\")\n\nmain()\nEOF\n"]
