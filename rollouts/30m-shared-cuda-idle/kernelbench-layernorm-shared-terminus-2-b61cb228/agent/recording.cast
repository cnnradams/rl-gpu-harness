[1343.325088, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch\nimport numpy as np\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=20):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\n@triton.jit\ndef _fused(X, W, Bv, Y, PS, CNT, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, R_: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // S\n    part = pid % S\n    base = row * NS_\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xv = tl.load(X + base + offs)\n    tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\n    tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))\n    tl.debug_barrier()\n    cnt = tl.atomic_add(CNT + row, 1)\n    while cnt < S - 1:\n        cnt = tl.atomic_add(CNT + row, 0)\n    poffs = row * S * 2 + tl.arange(0, S) * 2\n    ps1 = tl.load(PS + poffs, volatile=True)\n    ps2 = "]
[1343.325133, "i", "tl.load(PS + poffs + 1, volatile=True)\n    total = tl.sum(ps1, axis=0)\n    total2 = tl.sum(ps2, axis=0)\n    mean = total / NS_\n    var = total2 / NS_ - mean * mean\n    rstd = 1.0 / tl.sqrt(var + 1e-5)\n    wv = tl.load(W + offs)\n    bv = tl.load(Bv + offs)\n    tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\n\ndef main():\n    torch.manual_seed(0)\n    dev = \"cuda\"\n    x = torch.rand(B, F, D1, D2, device=dev)\n    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\n    w = ln.weight.detach().reshape(-1).contiguous()\n    b = ln.bias.detach().reshape(-1).contiguous()\n    ref = ln(x)\n    y = torch.empty_like(x)\n    for S in [32, 64]:\n        BLOCK = NS // S\n        ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n        for nw in [8, 16, 32]:\n            def run(inp, S=S, BLOCK=BLOCK, nw=nw, ps=ps):\n                cnt = torch.zeros(R, dtype=torch.int32, device=inp.device)\n                yy = torch.empty_like(inp)\n                _fused[(R * S,)](inp, w, b, yy, ps, cnt, NS_=NS, S=S, BLOCK=BLOCK, R_=R, n"]
[1343.325288, "i", "um_warps=nw)\n                return yy\n            yy = run(x)\n            diff = (yy - ref).abs().max().item()\n            t = timeit(run, [x], n=15)\n            print(f\"{t:.4f} ms  fused S={S} BLOCK={BLOCK} nw={nw} diff={diff:.2e}\")\n\nmain()\nEOF\ngpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/bench6.py /root/bench6.py && gpu exec sb-bUyk9HFBFjwJ288Lk0vN15 -- bash -c 'timeout 240 python3 /root/bench6.py 2>&1 | grep -v Profiling | tail -10'\n"]
