[1108.600991, "i", "mkdir -p /workspace/extsrc && cat > /workspace/extsrc/ln_cuda.cu << 'EOF'\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n\n#define THREADS 256\n\n__global__ void stats_kernel(const float4* __restrict__ x, float2* __restrict__ ps, long ns4, int S) {\n    int pid = blockIdx.x;\n    int row = pid / S;\n    int part = pid % S;\n    long chunk = ns4 / S;\n    const float4* xp = x + (long)row * ns4 + (long)part * chunk;\n    float s = 0.f, ss = 0.f;\n    for (long i = threadIdx.x; i < chunk; i += THREADS) {\n        float4 v = xp[i];\n        s += v.x + v.y + v.z + v.w;\n        ss += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n    __shared__ float sh[THREADS * 2];\n    sh[threadIdx.x] = s;\n    sh[threadIdx.x + THREADS] = ss;\n    __syncthreads();\n    for (int o = THREADS/2; o > 0; o >>= 1) {\n        if (threadIdx.x < o) {\n            sh[threadIdx.x] += sh[threadIdx.x + o];\n            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\n        }\n        __syncthreads();\n    }\n    if (threadIdx.x == 0) {\n        "]
[1108.601039, "i", "ps[pid * 2] = sh[0];\n        ps[pid * 2 + 1] = sh[THREADS];\n    }\n}\n\n__global__ void norm_kernel(const float4* __restrict__ x, const float4* __restrict__ w, const float4* __restrict__ b,\n                            float4* __restrict__ y, const float2* __restrict__ mr, long ns4, int rpc, int S) {\n    int pid = blockIdx.x;\n    int row = pid / rpc;\n    int rc = pid % rpc;\n    float2 m = mr[row];\n    float mean = m.x, rstd = m.y;\n    long base = (long)row * ns4;\n    for (long i = (long)rc * (ns4 / S / 4) + threadIdx.x + (long)blockIdx.y * THREADS; ; ) { break; }\n    long chunk = ns4 / rpc;\n    const float4* xp = x + base + (long)rc * chunk;\n    const float4* wp = w + (long)rc * chunk;\n    const float4* bp = b + (long)rc * chunk;\n    float4* yp = y + base + (long)rc * chunk;\n    for (long i = threadIdx.x; i < chunk; i += THREADS) {\n        float4 v = xp[i];\n        float4 wv = wp[i];\n        float4 bv = bp[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * w"]
[1108.601053, "i", "v.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        yp[i] = o;\n    }\n}\n\n__global__ void mid_kernel(const float2* __restrict__ ps, float2* __restrict__ mr, float invns, int S) {\n    int row = blockIdx.x;\n    const float2* p = ps + row * S * 2 / 2;  // ps is float2 per partial? careful\n    float s = 0.f, ss = 0.f;\n    for (int i = threadIdx.x; i < S; i += THREADS) {\n        float2 v = ps[row * S + i];\n        s += v.x;\n        ss += v.y;\n    }\n    __shared__ float sh[THREADS * 2];\n    sh[threadIdx.x] = s;\n    sh[threadIdx.x + THREADS] = ss;\n    __syncthreads();\n    for (int o = THREADS/2; o > 0; o >>= 1) {\n        if (threadIdx.x < o) {\n            sh[threadIdx.x] += sh[threadIdx.x + o];\n            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\n        }\n        __syncthreads();\n    }\n    if (threadIdx.x == 0) {\n        float total = sh[0];\n        float total2 = sh[THREADS];\n        float mean = total * invns;\n        float var = t"]
[1108.601182, "i", "otal2 * invns - mean * mean;\n        mr[row] = make_float2(mean, rsqrtf(var + 1e-5f));\n    }\n}\n\nstd::vector<torch::Tensor> ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc) {\n    auto y = torch::empty_like(x);\n    long ns4 = ns / 4;\n    auto stream = at::cuda::getCurrentCUDAStream();\n    stats_kernel<<<rows * S, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (float2*)ps.data_ptr<float>(), ns4, (int)S);\n    mid_kernel<<<rows, THREADS, 0, stream>>>((const float2*)ps.data_ptr<float>(), (float2*)mr.data_ptr<float>(), 1.0f / (float)ns, (int)S);\n    norm_kernel<<<rows * rpc, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (const float4*)w.data_ptr<float>(), (const float4*)b.data_ptr<float>(), (float4*)y.data_ptr<float>(), (const float2*)mr.data_ptr<float>(), ns4, (int)rpc, (int)S);\n    return {y};\n}\nEOF\ncat > /workspace/extsrc/ln_ext.cpp << 'EOF'\n#include <torch/extension.h>\nstd::vector<torch::Tens"]
[1108.601219, "i", "or> ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc);\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def(\"ln_forward\", &ln_forward); }\nEOF\nls /workspace/extsrc\n"]
