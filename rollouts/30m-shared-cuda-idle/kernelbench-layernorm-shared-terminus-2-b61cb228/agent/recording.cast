[923.445639, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch\nimport numpy as np\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=20):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\n@triton.jit\ndef _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // S\n    part = pid % S\n    base = row * NS_\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    if EV:\n        xv = tl.load(X + base + offs, eviction_policy=\"evict_last\")\n    else:\n        xv = tl.load(X + base + offs)\n    tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\n    tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))\n\n@triton.jit\ndef _mid(PS, MR, NS_: tl.constexpr, S: tl.constexpr):\n    row = tl.program_id(0).to(tl.int64)\n    poffs = row * S * 2 + tl.arange(0, S) * 2"]
[923.445692, "i", "\n    ps1 = tl.load(PS + poffs)\n    ps2 = tl.load(PS + poffs + 1)\n    total = tl.sum(ps1, axis=0)\n    total2 = tl.sum(ps2, axis=0)\n    mean = total / NS_\n    var = total2 / NS_ - mean * mean\n    rstd = 1.0 / tl.sqrt(var + 1e-5)\n    tl.store(MR + row * 2 + 0, mean)\n    tl.store(MR + row * 2 + 1, rstd)\n\n@triton.jit\ndef _p2c(X, W, Bv, Y, MR, NS_: tl.constexpr, BLOCK: tl.constexpr, RPC: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // RPC\n    rc = pid % RPC\n    base = row * NS_\n    mean = tl.load(MR + row * 2 + 0)\n    rstd = tl.load(MR + row * 2 + 1)\n    S: tl.constexpr = NS_ // BLOCK\n    for part in range(rc, S, RPC):\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xv = tl.load(X + base + offs)\n        wv = tl.load(W + offs)\n        bv = tl.load(Bv + offs)\n        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\n\ndef main():\n    torch.manual_seed(0)\n    dev = \"cuda\"\n    x = torch.rand(B, F, D1, D2, device=dev)\n    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\n    w = ln.weig"]
[923.445708, "i", "ht.detach().contiguous().view(-1)\n    b = ln.bias.detach().contiguous().view(-1)\n    ref = ln(x)\n    y = torch.empty_like(x)\n    mr = torch.empty(R * 2, dtype=torch.float32, device=dev)\n\n    S = 512; BLOCK = NS // S\n    ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n    _p1[(R * S,)](x, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=16, EV=False)\n    _mid[(R,)](ps, mr, NS_=NS, S=S, num_warps=4)\n    _p2c[(R * 8,)](x, w, b, y, mr, NS_=NS, BLOCK=32768, RPC=8, num_warps=16)\n    print(\"max diff 3-kernel:\", (y - ref).abs().max().item())\n\n    results = []\n    for S in [256, 512, 1024]:\n        BLOCK1 = NS // S\n        for EV in [False, True]:\n            for RPC in [4, 8, 16]:\n                for B2 in [16384, 32768, 65536]:\n                    for nw2 in [8, 16, 32]:\n                        def run(inp, S=S, BLOCK1=BLOCK1, EV=EV, RPC=RPC, B2=B2, nw2=nw2):\n                            yy = torch.empty_like(inp)\n                            psb = torch.empty(R * S * 2, dtype=torch.float32, device=inp.device)\n   "]
[923.445848, "i", "                         _p1[(R * S,)](inp, psb, NS_=NS, S=S, BLOCK=BLOCK1, num_warps=16, EV=EV)\n                            _mid[(R,)](psb, mr, NS_=NS, S=S, num_warps=4)\n                            _p2c[(R * RPC,)](inp, w, b, yy, mr, NS_=NS, BLOCK=B2, RPC=RPC, num_warps=nw2)\n                            return yy\n                        t = timeit(run, [x], n=10)\n                        results.append((t, f\"S={S} EV={EV} RPC={RPC} B2={B2} nw2={nw2}\"))\n    results.sort()\n    for t, name in results[:12]:\n        print(f\"{t:.4f} ms  {name}\")\n\nmain()\nEOF\n"]
