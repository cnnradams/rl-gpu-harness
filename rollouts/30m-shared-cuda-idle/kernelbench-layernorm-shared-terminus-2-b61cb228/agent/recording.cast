[1126.0879, "o", "    for (int o = THREADS/2; o > 0; o >>= 1) {\r\n\u001b[?2004l\r"]
[1126.087927, "o", "\u001b[?2004h> "]
[1126.088056, "o", "        if (threadIdx.x < o) {\r\n\u001b[?2004l\rR"]
[1126.088093, "o", "\u001b[?2004h> "]
[1126.088286, "o", "            sh[threadIdx.x] += sh[threadIdx.x + o];\r\n\u001b[?2004l\r"]
[1126.088316, "o", "\u001b[?2004h> "]
[1126.088601, "o", "            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\r\n\u001b[?2004l\r"]
[1126.088641, "o", "\u001b[?2004h"]
[1126.088679, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.088717, "o", "> "]
[1126.08879, "o", "        __syncthreads();\r\n\u001b[?2004l\r"]
[1126.088827, "o", "\u001b[?2004h> "]
[1126.088865, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1126.089157, "o", "    if (threadIdx.x == 0) ps[pid] = make_float2(sh[0], sh[THREADS]);\r\n\u001b[?2004l\r"]
[1126.0892, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1126.089242, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h> "]
[1126.089687, "o", "__global__ void mid_kernel(const float2* __restrict__ ps, float2* __restrict__ mr, float invns, int S) {\r\n\u001b[?2004l\r"]
[1126.089729, "o", "\u001b[?2004h"]
[1126.089767, "o", "> "]
[1126.089816, "o", "    int row = blockIdx.x;\r\n\u001b[?2004l\r"]
[1126.089859, "o", "\u001b[?2004h> "]
[1126.089961, "o", "    float s = 0.f, ss = 0.f;\r\n\u001b[?2004l\r"]
[1126.089998, "o", "\u001b[?2004h"]
[1126.090033, "o", "> "]
[1126.090189, "o", "    for (int i = threadIdx.x; i < S; i += THREADS) {\r\n\u001b[?2004l\r"]
[1126.090222, "o", "\u001b[?2004h"]
[1126.090263, "o", "> "]
[1126.090318, "o", "        float2 v = ps[(long)row * S + i];\r\n\u001b[?2004l\r"]
[1126.090357, "o", "\u001b[?2004h> "]
[1126.090393, "o", "        s += v.x;\r\n\u001b[?2004l\r"]
[1126.090431, "o", "\u001b[?2004h> "]
[1126.090469, "o", "        ss += v.y;\r\n\u001b[?2004l\r"]
[1126.090507, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1126.090544, "o", "\u001b[?2004h> "]
[1126.09062, "o", "    __shared__ float sh[THREADS * 2];\r\n\u001b[?2004l\r"]
[1126.090658, "o", "\u001b[?2004h> "]
[1126.090704, "o", "    sh[threadIdx.x] = s;\r\n\u001b[?2004l\r"]
[1126.090741, "o", "\u001b[?2004h> "]
[1126.090812, "o", "    sh[threadIdx.x + THREADS] = ss;\r\n\u001b[?2004l\r"]
[1126.090855, "o", "\u001b[?2004h> "]
[1126.090892, "o", "    __syncthreads();\r\n\u001b[?2004l\r"]
[1126.090929, "o", "\u001b[?2004h> "]
[1126.091041, "o", "    for (int o = THREADS/2; o > 0; o >>= 1) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.091077, "o", "> "]
[1126.091132, "o", "        if (threadIdx.x < o) {\r\n\u001b[?2004l\r"]
[1126.09117, "o", "\u001b[?2004h> "]
[1126.091277, "o", "            sh[threadIdx.x] += sh[threadIdx.x + o];\r\n\u001b[?2004l\r"]
[1126.091314, "o", "\u001b[?2004h> "]
[1126.09147, "o", "            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\r\n\u001b[?2004l\r"]
[1126.091505, "o", "\u001b[?2004h> "]
[1126.091545, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1126.091601, "o", "        __syncthreads();\r\n\u001b[?2004l\r"]
[1126.091639, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1126.091676, "o", "\u001b[?2004h> "]
[1126.091734, "o", "    if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[1126.091772, "o", "\u001b[?2004h> "]
[1126.091828, "o", "        float total = sh[0];\r\n\u001b[?2004l\r"]
[1126.091865, "o", "\u001b[?2004h> "]
[1126.091935, "o", "        float total2 = sh[THREADS];\r\n\u001b[?2004l\r"]
[1126.09198, "o", "\u001b[?2004h> "]
[1126.092051, "o", "        float mean = total * invns;\r\n\u001b[?2004l\r"]
[1126.092089, "o", "\u001b[?2004h> "]
[1126.092191, "o", "        float var = total2 * invns - mean * mean;\r\n\u001b[?2004l\r"]
[1126.092228, "o", "\u001b[?2004h> "]
[1126.092351, "o", "        mr[row] = make_float2(mean, rsqrtf(var + 1e-5f));\r\n\u001b[?2004l\r"]
[1126.092389, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1126.092427, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1126.092461, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1126.0925, "o", "\u001b[?2004h> "]
[1126.092751, "o", "__global__ void norm_kernel(const float4* __restrict__ x, const float4* __restrict__ w, const float4* __restrict__ b,\r\n\u001b[?2004l\r"]
[1126.092787, "o", "\u001b[?2004h> "]
[1126.093017, "o", "                            float4* __restrict__ y, const float2* __restrict__ mr, long ns4, int rpc) {\r\n\u001b[?2004l\r"]
[1126.093058, "o", "\u001b[?2004h> "]
[1126.093096, "o", "    int pid = blockIdx.x;\r\n\u001b[?2004l\r"]
[1126.093134, "o", "\u001b[?2004h> "]
[1126.09318, "o", "    int row = pid / rpc;\r\n\u001b[?2004l\r"]
[1126.093218, "o", "\u001b[?2004h> "]
[1126.093257, "o", "    int rc = pid % rpc;\r\n\u001b[?2004l\r"]
[1126.093294, "o", "\u001b[?2004h> "]
[1126.093345, "o", "    float2 m = mr[row];\r\n\u001b[?2004l\r"]
[1126.093382, "o", "\u001b[?2004h> "]
[1126.09345, "o", "    float mean = m.x, rstd = m.y;\r\n\u001b[?2004l\r"]
[1126.093489, "o", "\u001b[?2004h> "]
[1126.093553, "o", "    long base = (long)row * ns4;\r\n\u001b[?2004l\r"]
[1126.093597, "o", "\u001b[?2004h> "]
[1126.093644, "o", "    long chunk = ns4 / rpc;\r\n\u001b[?2004l\r"]
[1126.093681, "o", "\u001b[?2004h> "]
[1126.093765, "o", "    long off = base + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1126.093805, "o", "\u001b[?2004h> "]
[1126.093861, "o", "    const float4* xp = x + off;\r\n\u001b[?2004l\r"]
[1126.093899, "o", "\u001b[?2004h> "]
[1126.093999, "o", "    const float4* wp = w + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1126.094037, "o", "\u001b[?2004h> "]
[1126.094126, "o", "    const float4* bp = b + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1126.094161, "o", "\u001b[?2004h> "]
[1126.094212, "o", "    float4* yp = y + off;\r\n\u001b[?2004l\r"]
[1126.09425, "o", "\u001b[?2004h> "]
[1126.09437, "o", "    for (long i = threadIdx.x; i < chunk; i += THREADS) {\r\n\u001b[?2004l\r"]
[1126.094413, "o", "\u001b[?2004h> "]
[1126.094453, "o", "        float4 v = xp[i];\r\n\u001b[?2004l\r"]
[1126.094491, "o", "\u001b[?2004h> "]
[1126.094548, "o", "        float4 wv = wp[i];\r\n\u001b[?2004l\r"]
[1126.094586, "o", "\u001b[?2004h> "]
[1126.094637, "o", "        float4 bv = bp[i];\r\n\u001b[?2004l\r"]
[1126.094675, "o", "\u001b[?2004h> "]
[1126.094712, "o", "        float4 o;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.094749, "o", "> "]
[1126.094842, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1126.094881, "o", "\u001b[?2004h> "]
[1126.094998, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1126.095039, "o", "\u001b[?2004h> "]
[1126.095136, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1126.095174, "o", "\u001b[?2004h> "]
[1126.095273, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1126.095311, "o", "\u001b[?2004h> "]
[1126.095348, "o", "        yp[i] = o;\r\n\u001b[?2004l\r"]
[1126.095386, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1126.095424, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1126.095459, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1126.095498, "o", "\u001b[?2004h> "]
[1126.095846, "o", "torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc) {\r\n\u001b[?2004l\r"]
[1126.095889, "o", "\u001b[?2004h> "]
[1126.09595, "o", "    auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[1126.095988, "o", "\u001b[?2004h> "]
[1126.096026, "o", "    long ns4 = ns / 4;\r\n\u001b[?2004l\r"]
[1126.096063, "o", "\u001b[?2004h> "]
[1126.096169, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1126.096192, "o", "\u001b[?2004h> "]
[1126.096495, "o", "    stats_kernel<<<rows * S, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (float2*)ps.data_ptr<float>(), ns4, (int)S);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.096517, "o", "> "]
[1126.096837, "o", "    mid_kernel<<<rows, THREADS, 0, stream>>>((const float2*)ps.data_ptr<float>(), (float2*)mr.data_ptr<float>(), 1.0f / (float)ns, (int)S);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.096869, "o", "> "]
[1126.097418, "o", "    norm_kernel<<<rows * rpc, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (const float4*)w.data_ptr<float>(), (const float4*)b.data_ptr<float>(), (float4*)y.data_ptr<float>(), (const float2*)mr.data_ptr<float>(), ns4, (int)rpc);\r\n\u001b[?2004l\r"]
[1126.097454, "o", "\u001b[?2004h> "]
[1126.097493, "o", "    return y;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1126.097531, "o", "\u001b[?2004h> "]
[1126.09757, "o", "EOF\r\n\u001b[?2004l\r"]
[1126.099092, "o", "\u001b[?2004hroot@modal:/# "]
[1126.099195, "o", "cat > /workspace/extsrc/ln_ext.cpp << 'EOF'\r\n\u001b[?2004l\r"]
[1126.09924, "o", "\u001b[?2004h> "]
[1126.099279, "o", "#include <torch/extension.h>\r\n\u001b[?2004l\r"]
[1126.099319, "o", "\u001b[?2004h> "]
[1126.099669, "o", "torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc);\r\n\u001b[?2004l\r"]
[1126.099713, "o", "\u001b[?2004h> "]
[1126.099869, "o", "PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def(\"ln_forward\", &ln_forward); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.099903, "o", "> EOF\r\n\u001b[?2004l\r"]
[1126.101138, "o", "\u001b[?2004hroot@modal:/# "]
[1126.101251, "o", "cat > /workspace/extsrc/build_bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[1126.101294, "o", "\u001b[?2004h> "]
[1126.101341, "o", "import torch, numpy as np\r\n\u001b[?2004l\r"]
[1126.10138, "o", "\u001b[?2004h> "]
[1126.101465, "o", "from torch.utils.cpp_extension import load\r\n\u001b[?2004l\r"]
[1126.101505, "o", "\u001b[?2004h> "]
[1126.101642, "o", "from kernelbench.timing import time_execution_with_cuda_event\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.101686, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1126.102005, "o", "ext = load(name=\"ln_ext\", sources=[\"/root/extsrc/ln_ext.cpp\", \"/root/extsrc/ln_cuda.cu\"], extra_cuda_cflags=[\"-O3\"], verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.102039, "o", "> \r\n\u001b[?2004l\r"]
[1126.102079, "o", "\u001b[?2004h> "]
[1126.102124, "o", "B, F, D1, D2 = 16, 64, 256, 256\r\n\u001b[?2004l\r"]
[1126.10216, "o", "\u001b[?2004h> "]
[1126.102194, "o", "NS = F * D1 * D2\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.102231, "o", "> R = B\r\n\u001b[?2004l\r"]
[1126.102265, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1126.102302, "o", "\u001b[?2004h> "]
[1126.102356, "o", "def timeit(fn, args, n=20):\r\n\u001b[?2004l\r"]
[1126.102393, "o", "\u001b[?2004h> "]
[1126.102618, "o", "    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.102654, "o", "> "]
[1126.102708, "o", "    return float(np.mean(t))\r\n\u001b[?2004l\r"]
[1126.102745, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.102782, "o", "> "]
[1126.10282, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.102856, "o", "> dev = \"cuda\"\r\n\u001b[?2004l\r"]
[1126.102893, "o", "\u001b[?2004h> "]
[1126.103001, "o", "x = torch.rand(B, F, D1, D2, device=dev)\r\n\u001b[?2004l\r"]
[1126.103042, "o", "\u001b[?2004h> "]
[1126.10313, "o", "ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\r\n\u001b[?2004l\r"]
[1126.103172, "o", "\u001b[?2004h> "]
[1126.103259, "o", "w = ln.weight.detach().reshape(-1).contiguous()\r\n\u001b[?2004l\r"]
[1126.103297, "o", "\u001b[?2004h> "]
[1126.103389, "o", "b = ln.bias.detach().reshape(-1).contiguous()\r\n\u001b[?2004l\r"]
[1126.103426, "o", "\u001b[?2004h> "]
[1126.103464, "o", "ref = ln(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1126.103501, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1126.103576, "o", "for S in [256, 512, 1024]:\r\n\u001b[?2004l\r"]
[1126.103613, "o", "\u001b[?2004h> "]
[1126.103671, "o", "    for rpc in [64, 128, 256]:\r\n\u001b[?2004l\r"]
[1126.103708, "o", "\u001b[?2004h> "]
[1126.103854, "o", "        ps = torch.empty(R * S, 2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[1126.103889, "o", "\u001b[?2004h> "]
[1126.104031, "o", "        mr = torch.empty(R, 2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[1126.104066, "o", "\u001b[?2004h> "]
[1126.104192, "o", "        y = ext.ln_forward(x, w, b, ps, mr, R, NS, S, rpc)\r\n\u001b[?2004l\r"]
[1126.10423, "o", "\u001b[?2004h> "]
[1126.10432, "o", "        diff = (y - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1126.104358, "o", "\u001b[?2004h> "]
[1126.104558, "o", "        t = timeit(lambda inp: ext.ln_forward(inp, w, b, ps, mr, R, NS, S, rpc), [x], n=10)\r\n\u001b[?2004l\r"]
[1126.104596, "o", "\u001b[?2004h> "]
[1126.104741, "o", "        print(f\"{t:.4f} ms  cuda S={S} rpc={rpc} diff={diff:.2e}\")\r\n\u001b[?2004l\r"]
[1126.104779, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1126.106096, "o", "\u001b[?2004hroot@modal:/# "]
[1126.10631, "o", "gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc /root/extsrc 2>/dev/null || true\r\n\u001b[?2004l\r"]
[1126.240687, "o", "\u001b[?2004hroot@modal:/# "]
[1126.584576, "i", "gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc/ln_cuda.cu /root/extsrc/ln_cuda.cu; gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc/ln_ext.cpp /root/extsrc/ln_ext.cpp; gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc/build_bench.py /root/extsrc/build_bench.py\n"]
[1126.585336, "o", "gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc/ln_cuda.cu /root/extsrc/ln_cuda.cu; gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc/ln_ext.cpp /root/extsrc/ln_ext.cpp; gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc/build_bench.py /root/extsrc/build_bench.py\r\n\u001b[?2004l\r"]
