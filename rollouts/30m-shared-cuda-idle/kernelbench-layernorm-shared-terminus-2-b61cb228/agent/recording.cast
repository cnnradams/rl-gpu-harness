[516.189325, "o", "\u001b[?2004h> "]
[516.189562, "o", "            t = timeit(lambda inp: _p1[(R * S,)](inp, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw), [x], n=10)\r\n\u001b[?2004l\r"]
[516.189593, "o", "\u001b[?2004h> "]
