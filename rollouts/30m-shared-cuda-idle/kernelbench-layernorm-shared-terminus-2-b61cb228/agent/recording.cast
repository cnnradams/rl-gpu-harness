[716.026409, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch\nimport numpy as np\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=15):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\n@triton.jit\ndef _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // S\n    part = pid % S\n    base = row * NS_\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    if EV:\n        xv = tl.load(X + base + offs, eviction_policy=\"evict_last\")\n    else:\n        xv = tl.load(X + base + offs)\n    tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\n    tl.store(PS + pid * 2 + 1,"]
[716.026459, "i", " tl.sum(xv * xv, axis=0))\n\n@triton.jit\ndef _p2b(X, W, Bv, Y, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = pid // S\n    part = pid % S\n    base = row * NS_\n    poffs = row * S * 2 + tl.arange(0, S) * 2\n    ps1 = tl.load(PS + poffs)\n    ps2 = tl.load(PS + poffs + 1)\n    total = tl.sum(ps1, axis=0)\n    total2 = tl.sum(ps2, axis=0)\n    mean = total / NS_\n    var = total2 / NS_ - mean * mean\n    rstd = 1.0 / tl.sqrt(var + 1e-5)\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    if EV:\n        xv = tl.load(X + base + offs)\n        wv = tl.load(W + offs, eviction_policy=\"evict_last\")\n        bv = tl.load(Bv + offs, eviction_policy=\"evict_last\")\n        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv, eviction_policy=\"evict_first\")\n    else:\n        xv = tl.load(X + base + offs)\n        wv = tl.load(W + offs)\n        bv = tl.load(Bv + offs)\n        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\n\ndef main():\n    torch.m"]
[716.026606, "i", "anual_seed(0)\n    dev = \"cuda\"\n    x = torch.rand(B, F, D1, D2, device=dev)\n    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\n    w = ln.weight.detach().contiguous().view(-1)\n    b = ln.bias.detach().contiguous().view(-1)\n    ref = ln(x)\n    y = torch.empty_like(x)\n\n    # correctness of scheme\n    S = 512; BLOCK = NS // S\n    ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n    _p1[(R * S,)](x, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=16, EV=False)\n    _p2b[(R * S,)](x, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=8, EV=False)\n    print(\"max diff p2b:\", (y - ref).abs().max().item())\n\n    print(\"--- triton copy sweep ---\")\n    for CB in [4096, 8192, 16384]:\n        for nw in [4, 8]:\n            t = timeit(lambda inp: _copy[(inp.numel() // CB,)](inp, y, BLOCK=CB, num_warps=nw), [x], n=10)\n            print(f\"{t:.4f} ms  copy BLOCK={CB} nw={nw}\")\n\n    print(\"--- p2b sweep (standalone) ---\")\n    for S in [256, 512, 1024]:\n        BLOCK = NS // S\n        for nw in [4, 8, 16]:\n            t = timeit(l"]
[716.026627, "i", "ambda inp: _p2b[(R * S,)](inp, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw, EV=False), [x], n=10)\n            print(f\"{t:.4f} ms  p2b S={S} BLOCK={BLOCK} nw={nw}\")\n\n    print(\"--- grouped two-kernel ---\")\n    for G in [1, 2, 4, 8]:\n        rpg = R // G\n        for S in [256, 512]:\n            BLOCK = NS // S\n            for nw1, nw2 in [(16, 8), (16, 16)]:\n                for EV in [False, True]:\n                    psb = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\n                    def run(inp, G=G, rpg=rpg, S=S, BLOCK=BLOCK, nw1=nw1, nw2=nw2, EV=EV, psb=psb):\n                        yy = torch.empty_like(inp)\n                        for g in range(G):\n                            xg = inp[g * rpg:(g + 1) * rpg]\n                            psg = psb[g * rpg * S * 2:(g + 1) * rpg * S * 2]\n                            _p1[(rpg * S,)](xg, psg, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw1, EV=EV)\n                            _p2b[(rpg * S,)](xg, w, b, yy[g * rpg:(g + 1) * rpg], psg, NS_=NS, S=S, BL"]
[716.026641, "i", "OCK=BLOCK, num_warps=nw2, EV=EV)\n                        return yy\n                    t = timeit(run, [x], n=10)\n                    print(f\"{t:.4f} ms  grouped G={G} S={S} nw1={nw1} nw2={nw2} EV={EV}\")\n\nmain()\nEOF\n"]
