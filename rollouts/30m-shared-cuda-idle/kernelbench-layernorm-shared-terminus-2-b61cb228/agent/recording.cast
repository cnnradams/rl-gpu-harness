[716.027978, "o", "def timeit(fn, args, n=15):\r\n\u001b[?2004l\r"]
[716.027999, "o", "\u001b[?2004h> "]
[716.028243, "o", "    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.028267, "o", "> "]
[716.028326, "o", "    return float(np.mean(t))\r\n\u001b[?2004l\r"]
[716.028348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[716.028367, "o", "\u001b[?2004h"]
[716.028387, "o", "> "]
[716.028406, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[716.028425, "o", "\u001b[?2004h"]
[716.028445, "o", "> "]
[716.028547, "o", "def _copy(X, Y, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.028576, "o", "> "]
[716.028651, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[716.028682, "o", "\u001b[?2004h> "]
[716.02878, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[716.0288, "o", "\u001b[?2004h> "]
[716.028899, "o", "    tl.store(Y + offs, tl.load(X + offs))\r\n\u001b[?2004l\r"]
[716.028919, "o", "\u001b[?2004h> "]
[716.028938, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.028964, "o", "> "]
[716.028994, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[716.029013, "o", "\u001b[?2004h> "]
[716.029226, "o", "def _p1(X, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.029255, "o", "> "]
[716.029343, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.029364, "o", "> "]
[716.029414, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[716.029434, "o", "\u001b[?2004h> "]
[716.029484, "o", "    part = pid % S\r\n\u001b[?2004l\r"]
[716.029511, "o", "\u001b[?2004h> "]
[716.029567, "o", "    base = row * NS_\r\n\u001b[?2004l\r"]
[716.029587, "o", "\u001b[?2004h> "]
[716.029701, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[716.029721, "o", "\u001b[?2004h> "]
[716.029755, "o", "    if EV:\r\n\u001b[?2004l\r"]
[716.029775, "o", "\u001b[?2004h> "]
[716.029938, "o", "        xv = tl.load(X + base + offs, eviction_policy=\"evict_last\")\r\n\u001b[?2004l\r"]
[716.029958, "o", "\u001b[?2004h> "]
[716.029991, "o", "    else:\r\n\u001b[?2004l\r"]
[716.030012, "o", "\u001b[?2004h> "]
[716.030108, "o", "        xv = tl.load(X + base + offs)\r\n\u001b[?2004l\r"]
[716.030129, "o", "\u001b[?2004h> "]
[716.030256, "o", "    tl.store(PS + pid * 2 + 0, tl.sum(xv, axis=0))\r\n\u001b[?2004l\r"]
[716.030277, "o", "\u001b[?2004h> "]
[716.030416, "o", "    tl.store(PS + pid * 2 + 1, tl.sum(xv * xv, axis=0))\r\n\u001b[?2004l\r"]
[716.030437, "o", "\u001b[?2004h> \r\n"]
[716.030456, "o", "\u001b[?2004l\r\u001b[?2004h"]
[716.030476, "o", "> "]
[716.030513, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[716.030533, "o", "\u001b[?2004h> "]
[716.030779, "o", "def _p2b(X, W, Bv, Y, PS, NS_: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.030806, "o", "> "]
[716.030893, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[716.030923, "o", "\u001b[?2004h> "]
[716.030962, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[716.030996, "o", "\u001b[?2004h> "]
[716.031047, "o", "    part = pid % S\r\n\u001b[?2004l\r"]
[716.031067, "o", "\u001b[?2004h> "]
[716.031121, "o", "    base = row * NS_\r\n\u001b[?2004l\r"]
[716.031142, "o", "\u001b[?2004h> "]
[716.03125, "o", "    poffs = row * S * 2 + tl.arange(0, S) * 2\r\n\u001b[?2004l\r"]
[716.03127, "o", "\u001b[?2004h> "]
[716.031344, "o", "    ps1 = tl.load(PS + poffs)\r\n\u001b[?2004l\r"]
[716.031365, "o", "\u001b[?2004h> "]
[716.031448, "o", "    ps2 = tl.load(PS + poffs + 1)\r\n\u001b[?2004l\r"]
[716.031469, "o", "\u001b[?2004h> "]
[716.031554, "o", "    total = tl.sum(ps1, axis=0)\r\n\u001b[?2004l\r"]
[716.031585, "o", "\u001b[?2004h> "]
[716.031654, "o", "    total2 = tl.sum(ps2, axis=0)\r\n\u001b[?2004l\r"]
[716.031686, "o", "\u001b[?2004h> "]
[716.031734, "o", "    mean = total / NS_\r\n\u001b[?2004l\r"]
[716.031755, "o", "\u001b[?2004h> "]
[716.031844, "o", "    var = total2 / NS_ - mean * mean\r\n\u001b[?2004l\r"]
[716.031864, "o", "\u001b[?2004h> "]
[716.031954, "o", "    rstd = 1.0 / tl.sqrt(var + 1e-5)\r\n\u001b[?2004l\r"]
[716.031981, "o", "\u001b[?2004h> "]
[716.032084, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[716.032104, "o", "\u001b[?2004h> "]
[716.032136, "o", "    if EV:\r\n\u001b[?2004l\r"]
[716.032167, "o", "\u001b[?2004h> "]
[716.032249, "o", "        xv = tl.load(X + base + offs)\r\n\u001b[?2004l\r"]
[716.032269, "o", "\u001b[?2004h> "]
[716.032413, "o", "        wv = tl.load(W + offs, eviction_policy=\"evict_last\")\r\n\u001b[?2004l\r"]
[716.032439, "o", "\u001b[?2004h> "]
[716.03258, "o", "        bv = tl.load(Bv + offs, eviction_policy=\"evict_last\")\r\n\u001b[?2004l\r"]
[716.0326, "o", "\u001b[?2004h> "]
[716.032822, "o", "        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv, eviction_policy=\"evict_first\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.032843, "o", "> "]
[716.032862, "o", "    else:\r\n\u001b[?2004l\r"]
[716.032882, "o", "\u001b[?2004h> "]
[716.032976, "o", "        xv = tl.load(X + base + offs)\r\n\u001b[?2004l\r"]
[716.033006, "o", "\u001b[?2004h> "]
[716.033073, "o", "        wv = tl.load(W + offs)\r\n\u001b[?2004l\r"]
[716.033097, "o", "\u001b[?2004h> "]
[716.033176, "o", "        bv = tl.load(Bv + offs)\r\n\u001b[?2004l\r"]
[716.033197, "o", "\u001b[?2004h> "]
[716.033348, "o", "        tl.store(Y + base + offs, (xv - mean) * rstd * wv + bv)\r\n\u001b[?2004l\r"]
[716.033376, "o", "\u001b[?2004h> \r\n"]
[716.033396, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[716.033432, "o", "def main():\r\n\u001b[?2004l\r"]
[716.033453, "o", "\u001b[?2004h> "]
[716.033523, "o", "    torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[716.033544, "o", "\u001b[?2004h> "]
[716.033581, "o", "    dev = \"cuda\"\r\n\u001b[?2004l\r"]
[716.033601, "o", "\u001b[?2004h> "]
[716.033707, "o", "    x = torch.rand(B, F, D1, D2, device=dev)\r\n\u001b[?2004l\r"]
[716.033727, "o", "\u001b[?2004h> "]
[716.033834, "o", "    ln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\r\n\u001b[?2004l\r"]
[716.033854, "o", "\u001b[?2004h> "]
[716.033965, "o", "    w = ln.weight.detach().contiguous().view(-1)\r\n\u001b[?2004l\r"]
[716.033986, "o", "\u001b[?2004h> "]
[716.034091, "o", "    b = ln.bias.detach().contiguous().view(-1)\r\n\u001b[?2004l\r"]
[716.034113, "o", "\u001b[?2004h> "]
[716.034153, "o", "    ref = ln(x)\r\n\u001b[?2004l\r"]
[716.034173, "o", "\u001b[?2004h> "]
[716.034239, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[716.034259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[716.034278, "o", "\u001b[?2004h"]
[716.034298, "o", "> "]
[716.034352, "o", "    # correctness of scheme\r\n\u001b[?2004l\r"]
[716.034372, "o", "\u001b[?2004h> "]
[716.034441, "o", "    S = 512; BLOCK = NS // S\r\n\u001b[?2004l\r"]
[716.034461, "o", "\u001b[?2004h> "]
[716.034613, "o", "    ps = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[716.034633, "o", "\u001b[?2004h> "]
[716.034798, "o", "    _p1[(R * S,)](x, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=16, EV=False)\r\n\u001b[?2004l\r"]
[716.034818, "o", "\u001b[?2004h> "]
[716.035019, "o", "    _p2b[(R * S,)](x, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=8, EV=False)\r\n\u001b[?2004l\r"]
[716.035041, "o", "\u001b[?2004h> "]
[716.035163, "o", "    print(\"max diff p2b:\", (y - ref).abs().max().item())\r\n\u001b[?2004l\r"]
[716.035183, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[716.035203, "o", "\u001b[?2004h"]
[716.035222, "o", "> "]
[716.0353, "o", "    print(\"--- triton copy sweep ---\")\r\n\u001b[?2004l\r"]
[716.03532, "o", "\u001b[?2004h> "]
[716.035401, "o", "    for CB in [4096, 8192, 16384]:\r\n\u001b[?2004l\r"]
[716.035421, "o", "\u001b[?2004h> "]
[716.035484, "o", "        for nw in [4, 8]:\r\n\u001b[?2004l\r"]
[716.03551, "o", "\u001b[?2004h> "]
[716.035755, "o", "            t = timeit(lambda inp: _copy[(inp.numel() // CB,)](inp, y, BLOCK=CB, num_warps=nw), [x], n=10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.035783, "o", "> "]
[716.035899, "o", "            print(f\"{t:.4f} ms  copy BLOCK={CB} nw={nw}\")\r\n\u001b[?2004l\r"]
[716.035928, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[716.035948, "o", "\u001b[?2004h> "]
[716.036042, "o", "    print(\"--- p2b sweep (standalone) ---\")\r\n\u001b[?2004l\r"]
[716.036064, "o", "\u001b[?2004h> "]
[716.036136, "o", "    for S in [256, 512, 1024]:\r\n\u001b[?2004l\r"]
[716.036157, "o", "\u001b[?2004h> "]
[716.036216, "o", "        BLOCK = NS // S\r\n\u001b[?2004l\r"]
[716.036236, "o", "\u001b[?2004h> "]
[716.036305, "o", "        for nw in [4, 8, 16]:\r\n\u001b[?2004l\r"]
[716.036325, "o", "\u001b[?2004h> "]
[716.036623, "o", "            t = timeit(lambda inp: _p2b[(R * S,)](inp, w, b, y, ps, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw, EV=False), [x], n=10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.036652, "o", "> "]
[716.03679, "o", "            print(f\"{t:.4f} ms  p2b S={S} BLOCK={BLOCK} nw={nw}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[716.036813, "o", "> \r\n\u001b[?2004l\r"]
[716.036832, "o", "\u001b[?2004h> "]
[716.036921, "o", "    print(\"--- grouped two-kernel ---\")\r\n\u001b[?2004l\r"]
[716.036941, "o", "\u001b[?2004h> "]
[716.037005, "o", "    for G in [1, 2, 4, 8]:\r\n\u001b[?2004l\r"]
[716.037026, "o", "\u001b[?2004h> "]
[716.037077, "o", "        rpg = R // G\r\n\u001b[?2004l\r"]
[716.037097, "o", "\u001b[?2004h> "]
[716.037165, "o", "        for S in [256, 512]:\r\n\u001b[?2004l\r"]
[716.037186, "o", "\u001b[?2004h> "]
[716.037252, "o", "            BLOCK = NS // S\r\n\u001b[?2004l\r"]
[716.037271, "o", "\u001b[?2004h> "]
[716.037382, "o", "            for nw1, nw2 in [(16, 8), (16, 16)]:\r\n\u001b[?2004l\r"]
[716.037402, "o", "\u001b[?2004h> "]
[716.037502, "o", "                for EV in [False, True]:\r\n\u001b[?2004l\r"]
[716.037522, "o", "\u001b[?2004h> "]
[716.037709, "o", "                    psb = torch.empty(R * S * 2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[716.037729, "o", "\u001b[?2004h> "]
[716.037947, "o", "                    def run(inp, G=G, rpg=rpg, S=S, BLOCK=BLOCK, nw1=nw1, nw2=nw2, EV=EV, psb=psb):\r\n\u001b[?2004l\r"]
[716.037971, "o", "\u001b[?2004h> "]
[716.038081, "o", "                        yy = torch.empty_like(inp)\r\n\u001b[?2004l\r"]
[716.038102, "o", "\u001b[?2004h> "]
[716.038196, "o", "                        for g in range(G):\r\n\u001b[?2004l\r"]
[716.038217, "o", "\u001b[?2004h> "]
[716.03835, "o", "                            xg = inp[g * rpg:(g + 1) * rpg]\r\n\u001b[?2004l\r"]
[716.038373, "o", "\u001b[?2004h> "]
[716.038549, "o", "                            psg = psb[g * rpg * S * 2:(g + 1) * rpg * S * 2]\r\n\u001b[?2004l\r"]
[716.03858, "o", "\u001b[?2004h> "]
[716.038794, "o", "                            _p1[(rpg * S,)](xg, psg, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw1, EV=EV)\r\n\u001b[?2004l\r"]
[716.038814, "o", "\u001b[?2004h> "]
[716.039124, "o", "                            _p2b[(rpg * S,)](xg, w, b, yy[g * rpg:(g + 1) * rpg], psg, NS_=NS, S=S, BLOCK=BLOCK, num_warps=nw2, EV=EV)\r\n\u001b[?2004l\r"]
[716.039155, "o", "\u001b[?2004h> "]
[716.03922, "o", "                        return yy\r\n\u001b[?2004l\r"]
[716.039241, "o", "\u001b[?2004h> "]
[716.039349, "o", "                    t = timeit(run, [x], n=10)\r\n\u001b[?2004l\r"]
[716.039369, "o", "\u001b[?2004h> "]
[716.039587, "o", "                    print(f\"{t:.4f} ms  grouped G={G} S={S} nw1={nw1} nw2={nw2} EV={EV}\")\r\n\u001b[?2004l\r"]
[716.039613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[716.039632, "o", "\u001b[?2004h> "]
[716.039652, "o", "main()\r\n\u001b[?2004l\r"]
[716.039672, "o", "\u001b[?2004h> "]
[716.039703, "o", "EOF\r\n\u001b[?2004l\r"]
[716.041704, "o", "\u001b[?2004hroot@modal:/# "]
[716.467621, "i", "which ninja; gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/bench3.py /root/bench3.py && gpu exec sb-bUyk9HFBFjwJ288Lk0vN15 -- bash -c 'python3 /root/bench3.py > /root/bench3.out 2>&1; grep -v Profiling /root/bench3.out'\n"]
[716.468311, "o", "which ninja; gpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/bench3.py /root/bench3.py && gpu exec sb-bUyk9HFBFjwJ288Lk0vN15 -- bash -c 'python3 /root/bench3.py > /root/bench3.out 2>&1; grep -v Profiling /root/bench3.out'\r\n\u001b[?2004l\r"]
[716.469569, "o", "/usr/local/bin/ninja\r\n"]
[718.43948, "o", "{\r\n  \"bytes\": 4272,\r\n  \"sha256\": \"af98ecebe96f43dd3869fda54ecf4bef9eafcb70a76f763e02194842f265015b\"\r\n}\r\n"]
[718.575891, "o", "request ID: 857790629a0c48699f2c34c1c4f544fb\r\n"]
