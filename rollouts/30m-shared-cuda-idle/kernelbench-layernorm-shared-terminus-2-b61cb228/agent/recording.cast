[1281.110058, "o", "  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\",\r\n    \"excessive_speedup\": true\r\n  },\r\n  \"runtime\": 0.303,\r\n  \"runtime_stats\": {\r\n    \"mean\": 0.303,\r\n    \"std\": 0.00157,\r\n    \"min\": 0.299,\r\n    \"max\": 0.308,\r\n    \"num_trials\": 100\r\n  },\r\n  \"ref_runtime\": 8.08,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 8.08,\r\n    \"std\": 0.00557,\r\n    \"min\": 8.07,\r\n    \"max\": 8.1,\r\n    \"num_trials\": 100\r\n  },\r\n  \"solution_sha256\": \"af59cde5a75c87e3f6c538620cce8afba37b680baa16b95844ca781d5b9b1c7b\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 100,\r\n  \"speedup\": 26.666666666666668\r\n}\r\n"]
