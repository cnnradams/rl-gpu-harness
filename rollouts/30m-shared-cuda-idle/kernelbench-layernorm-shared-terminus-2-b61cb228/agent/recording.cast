[374.255148, "o", "    y = run_two(x, 64, 1, 65536, 16, 16)\r\n\u001b[?2004l\r"]
[374.255175, "o", "\u001b[?2004h> "]
[374.255318, "o", "    print(\"two-kernel max diff:\", (y - ref).abs().max().item())\r\n\u001b[?2004l\r"]
[374.255344, "o", "\u001b[?2004h> "]
[374.255417, "o", "    y1 = run_one(x, 16384, 32)\r\n\u001b[?2004l\r"]
[374.255443, "o", "\u001b[?2004h> "]
[374.255585, "o", "    print(\"onepass max diff:\", (y1 - ref).abs().max().item())\r\n\u001b[?2004l\r"]
[374.25562, "o", "\u001b[?2004h> \r\n"]
