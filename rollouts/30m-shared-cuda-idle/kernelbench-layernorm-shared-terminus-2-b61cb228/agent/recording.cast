[780.15851, "o", "max diff p2b: 3.4570693969726562e-06\r\n--- triton copy sweep ---\r\n0.1868 ms  copy BLOCK=4096 nw=4\r\n0.1855 ms  copy BLOCK=4096 nw=8\r\n0.1871 ms  copy BLOCK=8192 nw=4\r\n0.1862 ms  copy BLOCK=8192 nw=8\r\n0.1866 ms  copy BLOCK=16384 nw=4\r\n0.1864 ms  copy BLOCK=16384 nw=8\r\n--- p2b sweep (standalone) ---\r\n0.3577 ms  p2b S=256 BLOCK=16384 nw=4\r\n0.3574 ms  p2b S=256 BLOCK=16384 nw=8\r\n0.3573 ms  p2b S=256 BLOCK=16384 nw=16\r\n0.3566 ms  p2b S=512 BLOCK=8192 nw=4\r\n0.3566 ms  p2b S=512 BLOCK=8192 nw=8\r\n0.3555 ms  p2b S=512 BLOCK=8192 nw=16\r\n0.3571 ms  p2b S=1024 BLOCK=4096 nw=4\r\n0.3563 ms  p2b S=1024 BLOCK=4096 nw=8\r\n0.3555 ms  p2b S=1024 BLOCK=4096 nw=16\r\n--- grouped two-kernel ---\r\n0.4484 ms  grouped G=1 S=256 nw1=16 nw2=8 EV=False\r\n0.4469 ms  grouped G=1 S=256 nw1=16 nw2=8 EV=True\r\n0.4288 ms  grouped G=1 S=256 nw1=16 nw2=16 EV=False\r\n0.4468 ms  grouped G=1 S=256 nw1=16 nw2=16 EV=True\r\n0.4272 ms  grouped G=1 S=512 nw1=16 nw2=8 EV=False\r\n0.4455 ms  grouped G=1 S=512 nw1=16 nw2=8 EV=True\r\n"]
