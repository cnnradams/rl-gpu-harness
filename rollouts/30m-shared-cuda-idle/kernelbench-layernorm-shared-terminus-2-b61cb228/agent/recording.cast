[994.573151, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[994.573186, "o", "\u001b[?2004h> "]
[994.573335, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[994.573372, "o", "\u001b[?2004h> "]
[994.573417, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[994.573455, "o", "\u001b[?2004h> "]
[994.573583, "o", "        # pick split so each partial block is ~8192 elements\r\n\u001b[?2004l\r"]
[994.573621, "o", "\u001b[?2004h> "]
[994.573682, "o", "        s = max(1, ns // 8192)\r\n\u001b[?2004l\r"]
[994.573721, "o", "\u001b[?2004h> "]
[994.573756, "o", "        self.S = s\r\n\u001b[?2004l\r"]
[994.573791, "o", "\u001b[?2004h> "]
[994.573835, "o", "        self.ps = None\r\n\u001b[?2004l\r"]
[994.573876, "o", "\u001b[?2004h> "]
[994.573922, "o", "        self.mr = None\r\n\u001b[?2004l\r"]
[994.573961, "o", "\u001b[?2004h> "]
[994.57401, "o", "        self.wflat = None\r\n\u001b[?2004l\r"]
[994.574048, "o", "\u001b[?2004h> "]
[994.574098, "o", "        self.bflat = None\r\n\u001b[?2004l\r"]
[994.574136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[994.57417, "o", "\u001b[?2004h> "]
[994.574218, "o", "    def _ensure(self, x):\r\n\u001b[?2004l\r"]
[994.574256, "o", "\u001b[?2004h> "]
[994.57433, "o", "        rows = x.numel() // self.ns\r\n\u001b[?2004l\r"]
[994.574368, "o", "\u001b[?2004h> "]
[994.574588, "o", "        if self.ps is None or self.ps.shape[0] != rows * self.S * 2 or self.ps.device != x.device:\r\n\u001b[?2004l\r"]
[994.57463, "o", "\u001b[?2004h> "]
[994.574818, "o", "            self.ps = torch.empty(rows * self.S * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r"]
[994.574854, "o", "\u001b[?2004h> "]
[994.575063, "o", "            self.mr = torch.empty(rows * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r"]
[994.575103, "o", "\u001b[?2004h> "]
[994.575233, "o", "        if self.wflat is None or self.wflat.device != x.device:\r\n\u001b[?2004l\r"]
[994.575267, "o", "\u001b[?2004h> "]
[994.575424, "o", "            self.wflat = self.weight.detach().reshape(-1).contiguous()\r\n\u001b[?2004l\r"]
[994.575462, "o", "\u001b[?2004h> "]
[994.575611, "o", "            self.bflat = self.bias.detach().reshape(-1).contiguous()\r\n\u001b[?2004l\r"]
[994.575649, "o", "\u001b[?2004h> "]
[994.575692, "o", "        return rows\r\n\u001b[?2004l\r"]
[994.57573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[994.575768, "o", "\u001b[?2004h> "]
[994.575903, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[994.575941, "o", "> "]
[994.575995, "o", "        orig_shape = x.shape\r\n\u001b[?2004l\r"]
[994.576034, "o", "\u001b[?2004h> "]
[994.576087, "o", "        xc = x.contiguous()\r\n\u001b[?2004l\r"]
[994.576134, "o", "\u001b[?2004h> "]
[994.576185, "o", "        rows = self._ensure(xc)\r\n\u001b[?2004l\r"]
[994.576223, "o", "\u001b[?2004h> "]
[994.576261, "o", "        S = self.S\r\n\u001b[?2004l\r\u001b[?2004h"]
[994.576295, "o", "> "]
[994.576334, "o", "        NS_ = self.ns\r\n\u001b[?2004l\r"]
[994.576372, "o", "\u001b[?2004h> "]
[994.576411, "o", "        BLOCK = NS_ // S\r\n\u001b[?2004l\r"]
[994.576448, "o", "\u001b[?2004h> "]
[994.576535, "o", "        y = torch.empty_like(xc)\r\n\u001b[?2004l\r"]
[994.57657, "o", "\u001b[?2004h> "]
[994.576763, "o", "        _ln_p1[(rows * S,)](xc, self.ps, NS_=NS_, S=S, BLOCK=BLOCK, num_warps=16)\r\n\u001b[?2004l\r"]
[994.576808, "o", "\u001b[?2004h> "]
[994.576966, "o", "        _ln_mid[(rows,)](self.ps, self.mr, NS_=NS_, S=S, num_warps=4)\r\n\u001b[?2004l\r"]
[994.577006, "o", "\u001b[?2004h> "]
[994.577044, "o", "        RPC = 8\r\n\u001b[?2004l\r"]
[994.577079, "o", "\u001b[?2004h> "]
[994.577195, "o", "        B2 = 16384 if NS_ % 16384 == 0 else BLOCK\r\n\u001b[?2004l\r"]
[994.57723, "o", "\u001b[?2004h> "]
[994.577505, "o", "        _ln_p2[(rows * RPC,)](xc, self.wflat, self.bflat, y, self.mr, NS_=NS_, BLOCK=B2, RPC=RPC, num_warps=16)\r\n\u001b[?2004l\r"]
[994.577546, "o", "\u001b[?2004h"]
[994.577583, "o", "> "]
[994.577617, "o", "        return y.view(orig_shape)\r\n\u001b[?2004l\r"]
[994.577655, "o", "\u001b[?2004h> "]
[994.577692, "o", "EOF\r\n\u001b[?2004l\r"]
[994.579901, "o", "\u001b[?2004hroot@modal:/# "]
