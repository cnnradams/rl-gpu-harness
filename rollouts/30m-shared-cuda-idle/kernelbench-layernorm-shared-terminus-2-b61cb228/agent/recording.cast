[374.255693, "o", "    best = []\r\n\u001b[?2004l\r"]
[374.255719, "o", "\u001b[?2004h> "]
[374.255786, "o", "    for S in [32, 64, 128]:\r\n\u001b[?2004l\r"]
[374.255812, "o", "\u001b[?2004h> "]
