[1108.606002, "o", "\u001b[?2004h> "]
[1108.606069, "o", "    long base = (long)row * ns4;\r\n\u001b[?2004l\r"]
[1108.606106, "o", "\u001b[?2004h> "]
[1108.606333, "o", "    for (long i = (long)rc * (ns4 / S / 4) + threadIdx.x + (long)blockIdx.y * THREADS; ; ) { break; }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.606367, "o", "> "]
[1108.60642, "o", "    long chunk = ns4 / rpc;\r\n\u001b[?2004l\r"]
[1108.606452, "o", "\u001b[?2004h> "]
[1108.606565, "o", "    const float4* xp = x + base + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1108.606599, "o", "\u001b[?2004h> "]
[1108.606692, "o", "    const float4* wp = w + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1108.60673, "o", "\u001b[?2004h> "]
[1108.606824, "o", "    const float4* bp = b + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1108.606863, "o", "\u001b[?2004h> "]
[1108.606956, "o", "    float4* yp = y + base + (long)rc * chunk;\r\n\u001b[?2004l\r"]
[1108.607006, "o", "\u001b[?2004h> "]
[1108.607126, "o", "    for (long i = threadIdx.x; i < chunk; i += THREADS) {\r\n\u001b[?2004l\r"]
[1108.607148, "o", "\u001b[?2004h> "]
[1108.60721, "o", "        float4 v = xp[i];\r\n\u001b[?2004l\r"]
[1108.607247, "o", "\u001b[?2004h> "]
[1108.607298, "o", "        float4 wv = wp[i];\r\n\u001b[?2004l\r"]
[1108.607336, "o", "\u001b[?2004h> "]
[1108.607386, "o", "        float4 bv = bp[i];\r\n\u001b[?2004l\r"]
[1108.60742, "o", "\u001b[?2004h> "]
[1108.607457, "o", "        float4 o;\r\n\u001b[?2004l\r"]
[1108.607493, "o", "\u001b[?2004h> "]
[1108.607592, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1108.607626, "o", "\u001b[?2004h> "]
[1108.607729, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1108.607767, "o", "\u001b[?2004h> "]
[1108.607875, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1108.607915, "o", "\u001b[?2004h> "]
[1108.608011, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1108.608049, "o", "\u001b[?2004h> "]
[1108.608083, "o", "        yp[i] = o;\r\n\u001b[?2004l\r"]
[1108.60812, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1108.608157, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1108.608194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1108.60823, "o", "\u001b[?2004h> "]
[1108.60845, "o", "__global__ void mid_kernel(const float2* __restrict__ ps, float2* __restrict__ mr, float invns, int S) {\r\n\u001b[?2004l\r"]
[1108.608485, "o", "\u001b[?2004h> "]
[1108.608532, "o", "    int row = blockIdx.x;\r\n\u001b[?2004l\r"]
[1108.608565, "o", "\u001b[?2004h> "]
[1108.608739, "o", "    const float2* p = ps + row * S * 2 / 2;  // ps is float2 per partial? careful\r\n\u001b[?2004l\r"]
[1108.608782, "o", "\u001b[?2004h> "]
[1108.608844, "o", "    float s = 0.f, ss = 0.f;\r\n\u001b[?2004l\r"]
[1108.608881, "o", "\u001b[?2004h> "]
[1108.608986, "o", "    for (int i = threadIdx.x; i < S; i += THREADS) {\r\n\u001b[?2004l\r"]
[1108.609023, "o", "\u001b[?2004h> "]
[1108.609089, "o", "        float2 v = ps[row * S + i];\r\n\u001b[?2004l\r"]
[1108.609126, "o", "\u001b[?2004h> "]
[1108.609159, "o", "        s += v.x;\r\n\u001b[?2004l\r"]
[1108.609193, "o", "\u001b[?2004h> "]
[1108.609236, "o", "        ss += v.y;\r\n\u001b[?2004l\r"]
[1108.609269, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1108.609306, "o", "\u001b[?2004h> "]
[1108.609398, "o", "    __shared__ float sh[THREADS * 2];\r\n\u001b[?2004l\r"]
[1108.609435, "o", "\u001b[?2004h> "]
[1108.609478, "o", "    sh[threadIdx.x] = s;\r\n\u001b[?2004l\r"]
[1108.609514, "o", "\u001b[?2004h> "]
[1108.609586, "o", "    sh[threadIdx.x + THREADS] = ss;\r\n\u001b[?2004l\r"]
[1108.609622, "o", "\u001b[?2004h> "]
[1108.609656, "o", "    __syncthreads();\r\n\u001b[?2004l\r"]
[1108.609692, "o", "\u001b[?2004h> "]
[1108.609792, "o", "    for (int o = THREADS/2; o > 0; o >>= 1) {\r\n\u001b[?2004l\r"]
[1108.609836, "o", "\u001b[?2004h> "]
[1108.609896, "o", "        if (threadIdx.x < o) {\r\n\u001b[?2004l\r"]
[1108.609935, "o", "\u001b[?2004h> "]
[1108.61004, "o", "            sh[threadIdx.x] += sh[threadIdx.x + o];\r\n\u001b[?2004l\r"]
[1108.610077, "o", "\u001b[?2004h> "]
[1108.610229, "o", "            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\r\n\u001b[?2004l\r"]
[1108.610266, "o", "\u001b[?2004h> "]
[1108.610299, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.610366, "o", "        __syncthreads();\r\n\u001b[?2004l\r"]
[1108.610399, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1108.610437, "o", "\u001b[?2004h> "]
[1108.610499, "o", "    if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[1108.610535, "o", "\u001b[?2004h> "]
[1108.610593, "o", "        float total = sh[0];\r\n\u001b[?2004l\r"]
[1108.610626, "o", "\u001b[?2004h> "]
[1108.610701, "o", "        float total2 = sh[THREADS];\r\n\u001b[?2004l\r"]
[1108.610738, "o", "\u001b[?2004h> "]
[1108.610817, "o", "        float mean = total * invns;\r\n\u001b[?2004l\r"]
[1108.610859, "o", "\u001b[?2004h> "]
[1108.610957, "o", "        float var = total2 * invns - mean * mean;\r\n\u001b[?2004l\r"]
[1108.611006, "o", "\u001b[?2004h> "]
[1108.611126, "o", "        mr[row] = make_float2(mean, rsqrtf(var + 1e-5f));\r\n\u001b[?2004l\r"]
[1108.611163, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1108.6112, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1108.611234, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1108.61127, "o", "\u001b[?2004h> "]
[1108.611655, "o", "std::vector<torch::Tensor> ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.611686, "o", "> "]
[1108.611755, "o", "    auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[1108.611792, "o", "\u001b[?2004h> "]
[1108.611841, "o", "    long ns4 = ns / 4;\r\n\u001b[?2004l\r"]
[1108.611875, "o", "\u001b[?2004h> "]
[1108.611983, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1108.61202, "o", "\u001b[?2004h> "]
[1108.612307, "o", "    stats_kernel<<<rows * S, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (float2*)ps.data_ptr<float>(), ns4, (int)S);\r\n\u001b[?2004l\r"]
[1108.612329, "o", "\u001b[?2004h> "]
[1108.612651, "o", "    mid_kernel<<<rows, THREADS, 0, stream>>>((const float2*)ps.data_ptr<float>(), (float2*)mr.data_ptr<float>(), 1.0f / (float)ns, (int)S);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.612687, "o", "> "]
[1108.613235, "o", "    norm_kernel<<<rows * rpc, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (const float4*)w.data_ptr<float>(), (const float4*)b.data_ptr<float>(), (float4*)y.data_ptr<float>(), (const float2*)mr.data_ptr<float>(), ns4, (int)rpc, (int)S);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.613279, "o", "> "]
[1108.613316, "o", "    return {y};\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1108.613356, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1108.695542, "o", "\u001b[?2004hroot@modal:/# "]
[1108.695588, "o", "cat > /workspace/extsrc/ln_ext.cpp << 'EOF'\r\n\u001b[?2004l\r"]
[1108.695601, "o", "\u001b[?2004h> "]
[1108.695723, "o", "#include <torch/extension.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1108.696126, "o", "std::vector<torch::Tensor> ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.696165, "o", "> "]
[1108.696337, "o", "PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def(\"ln_forward\", &ln_forward); }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1108.696381, "o", "> EOF\r\n\u001b[?2004l\r"]
[1108.697599, "o", "\u001b[?2004hroot@modal:/# "]
[1108.697654, "o", "ls /workspace/extsrc\r\n\u001b[?2004l\r"]
[1108.699484, "o", "ln_cuda.cu  ln_ext.cpp\r\n"]
[1108.699663, "o", "\u001b[?2004hroot@modal:/# "]
[1126.084076, "i", "cat > /workspace/extsrc/ln_cuda.cu << 'EOF'\n#include <torch/extension.h>\n#include <ATen/cuda/CUDAContext.h>\n#include <cuda_runtime.h>\n\n#define THREADS 256\n\n__global__ void stats_kernel(const float4* __restrict__ x, float2* __restrict__ ps, long ns4, int S) {\n    int pid = blockIdx.x;\n    int row = pid / S;\n    int part = pid % S;\n    long chunk = ns4 / S;\n    const float4* xp = x + (long)row * ns4 + (long)part * chunk;\n    float s = 0.f, ss = 0.f;\n    for (long i = threadIdx.x; i < chunk; i += THREADS) {\n        float4 v = xp[i];\n        s += v.x + v.y + v.z + v.w;\n        ss += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n    __shared__ float sh[THREADS * 2];\n    sh[threadIdx.x] = s;\n    sh[threadIdx.x + THREADS] = ss;\n    __syncthreads();\n    for (int o = THREADS/2; o > 0; o >>= 1) {\n        if (threadIdx.x < o) {\n            sh[threadIdx.x] += sh[threadIdx.x + o];\n            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\n        }\n        __syncthreads();\n    }\n    if (threadIdx.x == 0) ps[pi"]
[1126.084135, "i", "d] = make_float2(sh[0], sh[THREADS]);\n}\n\n__global__ void mid_kernel(const float2* __restrict__ ps, float2* __restrict__ mr, float invns, int S) {\n    int row = blockIdx.x;\n    float s = 0.f, ss = 0.f;\n    for (int i = threadIdx.x; i < S; i += THREADS) {\n        float2 v = ps[(long)row * S + i];\n        s += v.x;\n        ss += v.y;\n    }\n    __shared__ float sh[THREADS * 2];\n    sh[threadIdx.x] = s;\n    sh[threadIdx.x + THREADS] = ss;\n    __syncthreads();\n    for (int o = THREADS/2; o > 0; o >>= 1) {\n        if (threadIdx.x < o) {\n            sh[threadIdx.x] += sh[threadIdx.x + o];\n            sh[threadIdx.x + THREADS] += sh[threadIdx.x + THREADS + o];\n        }\n        __syncthreads();\n    }\n    if (threadIdx.x == 0) {\n        float total = sh[0];\n        float total2 = sh[THREADS];\n        float mean = total * invns;\n        float var = total2 * invns - mean * mean;\n        mr[row] = make_float2(mean, rsqrtf(var + 1e-5f));\n    }\n}\n\n__global__ void norm_kernel(const float4* __restrict__ x, const float4* __res"]
[1126.084144, "i", "trict__ w, const float4* __restrict__ b,\n                            float4* __restrict__ y, const float2* __restrict__ mr, long ns4, int rpc) {\n    int pid = blockIdx.x;\n    int row = pid / rpc;\n    int rc = pid % rpc;\n    float2 m = mr[row];\n    float mean = m.x, rstd = m.y;\n    long base = (long)row * ns4;\n    long chunk = ns4 / rpc;\n    long off = base + (long)rc * chunk;\n    const float4* xp = x + off;\n    const float4* wp = w + (long)rc * chunk;\n    const float4* bp = b + (long)rc * chunk;\n    float4* yp = y + off;\n    for (long i = threadIdx.x; i < chunk; i += THREADS) {\n        float4 v = xp[i];\n        float4 wv = wp[i];\n        float4 bv = bp[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        yp[i] = o;\n    }\n}\n\ntorch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64"]
[1126.084282, "i", "_t rows, int64_t ns, int64_t S, int64_t rpc) {\n    auto y = torch::empty_like(x);\n    long ns4 = ns / 4;\n    auto stream = at::cuda::getCurrentCUDAStream();\n    stats_kernel<<<rows * S, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (float2*)ps.data_ptr<float>(), ns4, (int)S);\n    mid_kernel<<<rows, THREADS, 0, stream>>>((const float2*)ps.data_ptr<float>(), (float2*)mr.data_ptr<float>(), 1.0f / (float)ns, (int)S);\n    norm_kernel<<<rows * rpc, THREADS, 0, stream>>>((const float4*)x.data_ptr<float>(), (const float4*)w.data_ptr<float>(), (const float4*)b.data_ptr<float>(), (float4*)y.data_ptr<float>(), (const float2*)mr.data_ptr<float>(), ns4, (int)rpc);\n    return y;\n}\nEOF\ncat > /workspace/extsrc/ln_ext.cpp << 'EOF'\n#include <torch/extension.h>\ntorch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor mr, int64_t rows, int64_t ns, int64_t S, int64_t rpc);\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) { m.def(\"ln_forward\", &ln_forward); }\nEOF\ncat > /worksp"]
[1126.084306, "o", "cat > /workspace/extsrc/ln_cuda.cu << 'EOF'\r\n\u001b[?2004l\r"]
[1126.08436, "i", "ace/extsrc/build_bench.py << 'EOF'\nimport torch, numpy as np\nfrom torch.utils.cpp_extension import load\nfrom kernelbench.timing import time_execution_with_cuda_event\n\next = load(name=\"ln_ext\", sources=[\"/root/extsrc/ln_ext.cpp\", \"/root/extsrc/ln_cuda.cu\"], extra_cuda_cflags=[\"-O3\"], verbose=False)\n\nB, F, D1, D2 = 16, 64, 256, 256\nNS = F * D1 * D2\nR = B\n\ndef timeit(fn, args, n=20):\n    t = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=n, verbose=False, device=0)\n    return float(np.mean(t))\n\ntorch.manual_seed(0)\ndev = \"cuda\"\nx = torch.rand(B, F, D1, D2, device=dev)\nln = torch.nn.LayerNorm((F, D1, D2)).to(dev)\nw = ln.weight.detach().reshape(-1).contiguous()\nb = ln.bias.detach().reshape(-1).contiguous()\nref = ln(x)\n\nfor S in [256, 512, 1024]:\n    for rpc in [64, 128, 256]:\n        ps = torch.empty(R * S, 2, dtype=torch.float32, device=dev)\n        mr = torch.empty(R, 2, dtype=torch.float32, device=dev)\n        y = ext.ln_forward(x, w, b, ps, mr, R, NS, S, rpc)\n        diff = (y - ref).abs().m"]
[1126.084375, "o", "\u001b[?2004h> "]
[1126.084415, "i", "ax().item()\n        t = timeit(lambda inp: ext.ln_forward(inp, w, b, ps, mr, R, NS, S, rpc), [x], n=10)\n        print(f\"{t:.4f} ms  cuda S={S} rpc={rpc} diff={diff:.2e}\")\nEOF\ngpu push sb-bUyk9HFBFjwJ288Lk0vN15 /workspace/extsrc /root/extsrc 2>/dev/null || true\n"]
