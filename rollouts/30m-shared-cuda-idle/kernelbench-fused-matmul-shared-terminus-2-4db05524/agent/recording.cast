[536.495832, "i", "cat > /workspace/dev/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef mm3(X, WH, WL, BIAS, Y, M, N, K,\n        sxm, sxk, swk, swn, sym, syn,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Xp = X + rm[:, None] * sxm + rk[None, :] * sxk\n    WHp = WH + rk[:, None] * swk + rn[None, :] * swn\n    WLp = WL + rk[:, None] * swk + rn[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Xp)\n        ah = a.to(tl.bfloat16)\n        al = (a - ah.to(tl.float32)).to(tl.bfloat16)\n        bh = tl.load(WHp)"]
[536.495961, "i", "\n        bl = tl.load(WLp)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        Xp += BK * sxk\n        WHp += BK * swk\n        WLp += BK * swk\n    bias = tl.load(BIAS + rn)\n    y = 1.5 * acc + 1.5 * bias[None, :]\n    Yp = Y + rm[:, None] * sym + rn[None, :] * syn\n    tl.store(Yp, y)\n\ntorch.manual_seed(0)\nM=N=K=4096; B=16384\ndevice='cuda'\nx = torch.rand(B, K, device=device)\nlin = torch.nn.Linear(K, N).to(device)\nW = lin.weight.data; b = lin.bias.data\nWt = W.t().contiguous()\nWt_hi = Wt.bfloat16()\nWt_lo = (Wt - Wt_hi.float()).bfloat16()\nbias15 = b\nY = torch.empty(B, N, device=device, dtype=torch.float32)\n\ndef run(BM, BN, BK, GM, nw, ns):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    mm3[grid](x, Wt_hi, Wt_lo, bias15, Y, B, N, K,\n              x.stride(0), x.stride(1), Wt_hi.stride(0), Wt_hi.stride(1), Y.stride(0), Y.stride(1),\n              BM, BN, BK, GM, num_warps=nw, num_stages=ns)\n    return Y\n\ndef bench(fn, n=30):\n    for _ in range(10): f"]
[536.495974, "i", "n()\n    torch.cuda.synchronize()\n    e0=torch.cuda.Event(True); e1=torch.cuda.Event(True); ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        e0.record(); fn(); e1.record(); torch.cuda.synchronize()\n        ts.append(e0.elapsed_time(e1))\n    ts.sort(); return ts[len(ts)//2], min(ts)\n\n# accuracy check once\nref64 = (x.double() @ W.double().t() + b.double()) * 1.5\nrun(128,128,64,8,8,3)\ntorch.cuda.synchronize()\nd = (Y.double() - ref64).abs()\nprint('max abs err vs fp64:', d.max().item(), 'mean:', d.mean().item())\nreffp32 = (torch.nn.functional.linear(x, W, b))\nreffp32 = reffp32*0.5 + reffp32\ndd = (Y - reffp32).abs()\ntol = 1e-4 + 1e-4*reffp32.abs()\nprint('max err vs fp32 ref:', dd.max().item(), 'allclose pass:', bool((dd<=tol).all().item()))\n\nfor (BM,BN,BK,GM,nw,ns) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,32,8,8,4),(64,256,64,8,4,4),(128,64,64,8,4,4)]:\n    try:\n        t = bench(lambda: run(BM,BN,BK,GM,nw,ns))\n        print((BM,BN,BK,GM,nw,ns), t)\n"]
[536.496237, "i", "    except Exception as e:\n        print((BM,BN,BK,GM,nw,ns), 'FAIL', str(e)[:80])\nEOF\ngpu push sb-YjAmMJlm3oeViqAIfSlHFm /workspace/dev/bench2.py /workspace/bench2.py\n"]
