[1241.079554, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079666, "o", "def mm3v2(XH, XL, WH, WL, BIAS, Y, M, N, K, sxm, sxk, swk, swn, sym, syn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079802, "o", "        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079859, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.079912, "o", "> "]
[1241.079961, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
