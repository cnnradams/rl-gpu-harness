[799.476805, "o", "mm1[grid](xh, wh, Y, B, N, K, xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1), Y.stride(0), Y.stride(1), BM, BN, BK, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r\u001b[?2004h"]
