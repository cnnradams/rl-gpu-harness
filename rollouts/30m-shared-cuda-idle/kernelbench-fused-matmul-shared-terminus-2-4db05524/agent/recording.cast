[1241.082672, "o", "\u001b[?2004h> "]
[1241.082908, "o", "    mm3v2[grid](xh2, xl2, wh, wl, b, Y, B, N, K, xh2.stride(0), xh2.stride(1), wh.stride(0), wh.stride(1), Y.stride(0), Y.stride(1), BM, BN, BK, GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.082978, "o", "    return Y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
