[536.498837, "o", "\u001b[?2004h> "]
[536.498874, "o", "    tl.store(Yp, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.498906, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.498944, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.498979, "o", "M=N=K=4096; B=16384\r\n\u001b[?2004l\r"]
[536.499016, "o", "\u001b[?2004h> "]
[536.499048, "o", "device='cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.499087, "o", "x = torch.rand(B, K, device=device)\r\n\u001b[?2004l\r"]
[536.499118, "o", "\u001b[?2004h> "]
[536.49916, "o", "lin = torch.nn.Linear(K, N).to(device)\r\n\u001b[?2004l\r"]
[536.499191, "o", "\u001b[?2004h> "]
[536.499233, "o", "W = lin.weight.data; b = lin.bias.data\r\n\u001b[?2004l\r"]
[536.499267, "o", "\u001b[?2004h> "]
[536.499295, "o", "Wt = W.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.499327, "o", "> "]
[536.499364, "o", "Wt_hi = Wt.bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.499416, "o", "Wt_lo = (Wt - Wt_hi.float()).bfloat16()\r\n\u001b[?2004l\r"]
[536.499447, "o", "\u001b[?2004h> bias15 = b\r\n\u001b[?2004l\r"]
[536.49948, "o", "\u001b[?2004h> "]
[536.499549, "o", "Y = torch.empty(B, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[536.499583, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[536.49962, "o", "\u001b[?2004h> "]
[536.499651, "o", "def run(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.49969, "o", "> "]
[536.499744, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[536.499781, "o", "\u001b[?2004h> "]
[536.499833, "o", "    mm3[grid](x, Wt_hi, Wt_lo, bias15, Y, B, N, K,\r\n\u001b[?2004l\r"]
[536.49987, "o", "\u001b[?2004h> "]
[536.500027, "o", "              x.stride(0), x.stride(1), Wt_hi.stride(0), Wt_hi.stride(1), Y.stride(0), Y.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.500101, "o", "              BM, BN, BK, GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[536.500141, "o", "\u001b[?2004h>     return Y\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.500181, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.500228, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.500285, "o", "    for _ in range(10): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.500314, "o", "> "]
[536.500348, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.500445, "o", "    e0=torch.cuda.Event(True); e1=torch.cuda.Event(True); ts=[]\r\n\u001b[?2004l\r"]
[536.500478, "o", "\u001b[?2004h> "]
[536.500509, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.500565, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[536.500596, "o", "\u001b[?2004h> "]
[536.500679, "o", "        e0.record(); fn(); e1.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[536.500713, "o", "\u001b[?2004h> "]
[536.500752, "o", "        ts.append(e0.elapsed_time(e1))\r\n\u001b[?2004l\r"]
[536.500784, "o", "\u001b[?2004h> "]
[536.500845, "o", "    ts.sort(); return ts[len(ts)//2], min(ts)\r\n\u001b[?2004l\r"]
[536.500878, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[536.500911, "o", "\u001b[?2004h> "]
[536.500943, "o", "# accuracy check once\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.501017, "o", "ref64 = (x.double() @ W.double().t() + b.double()) * 1.5\r\n\u001b[?2004l\r"]
[536.501043, "o", "\u001b[?2004h> "]
[536.501068, "o", "run(128,128,64,8,8,3)\r\n\u001b[?2004l\r"]
[536.501106, "o", "\u001b[?2004h> "]
[536.501137, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.501179, "o", "d = (Y.double() - ref64).abs()\r\n\u001b[?2004l\r"]
[536.501215, "o", "\u001b[?2004h> "]
[536.501292, "o", "print('max abs err vs fp64:', d.max().item(), 'mean:', d.mean().item())\r\n\u001b[?2004l\r"]
[536.501329, "o", "\u001b[?2004h> "]
[536.501374, "o", "reffp32 = (torch.nn.functional.linear(x, W, b))\r\n\u001b[?2004l\r"]
[536.501411, "o", "\u001b[?2004h> "]
[536.501442, "o", "reffp32 = reffp32*0.5 + reffp32\r\n\u001b[?2004l\r"]
[536.501475, "o", "\u001b[?2004h> "]
[536.501505, "o", "dd = (Y - reffp32).abs()\r\n\u001b[?2004l\r"]
[536.501543, "o", "\u001b[?2004h> "]
[536.501575, "o", "tol = 1e-4 + 1e-4*reffp32.abs()\r\n\u001b[?2004l\r"]
[536.50161, "o", "\u001b[?2004h> "]
[536.501735, "o", "print('max err vs fp32 ref:', dd.max().item(), 'allclose pass:', bool((dd<=tol).all().item()))\r\n\u001b[?2004l\r"]
[536.501768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[536.501991, "o", "for (BM,BN,BK,GM,nw,ns) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,32,8,8,4),(64,256,64,8,4,4),(128,64,64,8,4,4)]:\r\n\u001b[?2004l\r"]
[536.502032, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[536.502064, "o", "\u001b[?2004h> "]
[536.502119, "o", "        t = bench(lambda: run(BM,BN,BK,GM,nw,ns))\r\n\u001b[?2004l\r"]
[536.50215, "o", "\u001b[?2004h> "]
[536.502195, "o", "        print((BM,BN,BK,GM,nw,ns), t)\r\n\u001b[?2004l\r"]
[536.502227, "o", "\u001b[?2004h> "]
[536.502262, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[536.502292, "o", "> "]
[536.502349, "o", "        print((BM,BN,BK,GM,nw,ns), 'FAIL', str(e)[:80])\r\n\u001b[?2004l\r"]
[536.502386, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[536.504261, "o", "\u001b[?2004hroot@modal:/# "]
