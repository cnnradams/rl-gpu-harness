[1241.080234, "o", "> "]
[1241.080283, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.080346, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1241.080396, "o", "\u001b[?2004h> "]
[1241.08049, "o", "    rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.080554, "o", "> "]
[1241.080612, "o", "    XHp = XH + rm[:,None]*sxm + rk[None,:]*sxk\r\n\u001b[?2004l\r\u001b[?2004h> "]
