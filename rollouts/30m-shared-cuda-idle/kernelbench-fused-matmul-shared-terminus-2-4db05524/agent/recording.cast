[1163.762009, "o", "\u001b[?2004h> except Exception:\r\n\u001b[?2004l\r"]
[1163.762062, "o", "\u001b[?2004h> "]
[1163.762108, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.762154, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.762205, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.76228, "o", "    def _mm3_kernel(X, WH, WL, BIAS, Y, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.762311, "o", "> "]
[1163.762367, "o", "                    sxm, sxk, swk, swn, sym, syn,\r\n\u001b[?2004l\r"]
[1163.762418, "o", "\u001b[?2004h> "]
[1163.762499, "o", "                    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.762552, "o", "> "]
[1163.762608, "o", "                    GROUP_M: tl.constexpr, SCALE: tl.constexpr):\r\n\u001b[?2004l\r"]
[1163.76266, "o", "\u001b[?2004h> "]
[1163.762713, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.762764, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.762828, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.762885, "o", "> "]
[1163.762938, "o", "        width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.76299, "o", "        group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.763098, "o", "        group_size = min(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.763156, "o", "> "]
[1163.763208, "o", "        pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.763273, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1163.763327, "o", "\u001b[?2004h> "]
[1163.76338, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.763431, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1163.763476, "o", "\u001b[?2004h> "]
[1163.76353, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.763595, "o", "        Xp = X + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[1163.763649, "o", "\u001b[?2004h> "]
[1163.763703, "o", "        WHp = WH + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.763751, "o", "> "]
[1163.763808, "o", "        WLp = WL + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.763897, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1163.763944, "o", "\u001b[?2004h> "]
[1163.763997, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.764049, "o", "            a = tl.load(Xp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.764095, "o", "            ah = a.to(tl.bfloat16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.764146, "o", "> "]
[1163.76421, "o", "            al = (a - ah.to(tl.float32)).to(tl.bfloat16)\r\n\u001b[?2004l\r"]
[1163.764263, "o", "\u001b[?2004h>             bh = tl.load(WHp)\r\n\u001b[?2004l\r"]
[1163.764316, "o", "\u001b[?2004h> "]
[1163.764367, "o", "            bl = tl.load(WLp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.764414, "o", "            acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[1163.764467, "o", "\u001b[?2004h> "]
[1163.764519, "o", "            acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.76457, "o", "            acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[1163.764621, "o", "\u001b[?2004h> "]
[1163.764672, "o", "            Xp += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.764724, "o", "            WHp += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.764778, "o", "            WLp += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.764829, "o", "        bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[1163.764882, "o", "\u001b[?2004h> "]
[1163.764928, "o", "        y = SCALE * acc + SCALE * bias[None, :]\r\n\u001b[?2004l\r"]
[1163.76498, "o", "\u001b[?2004h> "]
[1163.765026, "o", "        Yp = Y + rm[:, None] * sym + rn[None, :] * syn\r\n\u001b[?2004l\r"]
[1163.765074, "o", "\u001b[?2004h>         tl.store(Yp, y)\r\n\u001b[?2004l\r"]
[1163.765126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.765177, "o", "> class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1163.765231, "o", "\u001b[?2004h> "]
[1163.765302, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1163.765348, "o", "\u001b[?2004h> "]
[1163.7654, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.76549, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1163.765542, "o", "\u001b[?2004h> "]
[1163.765594, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.765638, "o", "        self._split_cache = None\r\n\u001b[?2004l\r"]
[1163.765691, "o", "\u001b[?2004h>         self._ok = None\r\n\u001b[?2004l\r"]
[1163.765737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.765789, "o", "    def _get_split(self, device):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.765842, "o", ">         c = self._split_cache\r\n\u001b[?2004l\r"]
[1163.765904, "o", "\u001b[?2004h> "]
[1163.76597, "o", "        if c is not None and c[0].device == device:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.766023, "o", ">             return c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.766087, "o", "        W = self.matmul.weight.data\r\n\u001b[?2004l\r"]
[1163.766141, "o", "\u001b[?2004h> "]
[1163.766195, "o", "        Wt = W.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.766243, "o", "        wh = Wt.bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.766304, "o", "        wl = (Wt - wh.float()).bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.766358, "o", "> "]
[1163.766412, "o", "        b = self.matmul.bias.data.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.766465, "o", "        self._split_cache = (wh, wl, b)\r\n\u001b[?2004l\r"]
[1163.766518, "o", "\u001b[?2004h> "]
[1163.766573, "o", "        return self._split_cache\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.766632, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.766685, "o", "> "]
[1163.766766, "o", "        if _HAS_TRITON and x.is_cuda and x.dtype == torch.float32 and x.dim() == 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.76682, "o", ">             try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.766879, "o", "> "]
[1163.76693, "o", "                if self._ok is False:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.767022, "o", "                    raise RuntimeError(\"triton path disabled\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.767076, "o", ">                 M, K = x.shape\r\n\u001b[?2004l\r"]
[1163.767128, "o", "\u001b[?2004h> "]
[1163.767181, "o", "                N = self.matmul.weight.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.767234, "o", "> "]
[1163.767285, "o", "                if K % 32 == 0 and M % 128 == 0 and N % 128 == 0:\r\n\u001b[?2004l\r"]
[1163.76733, "o", "\u001b[?2004h> "]
[1163.767391, "o", "                    wh, wl, b = self._get_split(x.device)\r\n\u001b[?2004l\r"]
[1163.767443, "o", "\u001b[?2004h> "]
[1163.767526, "o", "                    Y = torch.empty(M, N, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1163.767579, "o", "\u001b[?2004h> "]
[1163.767625, "o", "                    BM, BN, BK, GM = 128, 128, 32, 64\r\n\u001b[?2004l\r"]
[1163.767675, "o", "\u001b[?2004h> "]
[1163.767749, "o", "                    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.767801, "o", "> "]
[1163.767852, "o", "                    _mm3_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.767923, "o", "                        x, wh, wl, b, Y, M, N, K,\r\n\u001b[?2004l\r"]
[1163.767971, "o", "\u001b[?2004h> "]
[1163.768024, "o", "                        x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.768104, "o", "                        wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r"]
[1163.768156, "o", "\u001b[?2004h> "]
[1163.768208, "o", "                        Y.stride(0), Y.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.768271, "o", "                        BM, BN, BK, GM,\r\n\u001b[?2004l\r"]
[1163.768326, "o", "\u001b[?2004h> "]
[1163.768381, "o", "                        float(self.scaling_factor) + 1.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.76846, "o", "                        num_warps=8, num_stages=4,\r\n\u001b[?2004l\r"]
[1163.768512, "o", "\u001b[?2004h>                     )\r\n\u001b[?2004l\r"]
[1163.768565, "o", "\u001b[?2004h> "]
[1163.768619, "o", "                    self._ok = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.76867, "o", "                    return Y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.768722, "o", "            except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.768773, "o", "                self._ok = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[1163.768823, "o", ">         m = self.matmul(x)\r\n\u001b[?2004l\r"]
[1163.768883, "o", "\u001b[?2004h> "]
[1163.768937, "o", "        return m * self.scaling_factor + m\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1163.768982, "o", "EOF\r\n\u001b[?2004l\r"]
