[901.836755, "o", "bf16x3 fused err vs fp64: 4.287446933881611e-05\r\nerr vs fp32 ref: 4.553794860839844e-05 pass: True\r\n(128, 128, 32, 8, 4) (3.188800096511841, 2.9585280418395996)\r\n(128, 128, 32, 8, 5) (3.729856014251709, 3.469343900680542)\r\n(128, 128, 64, 8, 3) (3.639359951019287, 3.2541439533233643)\r\n(256, 128, 32, 8, 3) (3.204864025115967, 3.1423680782318115)\r\n(128, 128, 32, 4, 4) (3.396480083465576, 3.338848114013672)\r\n(256, 64, 64, 8, 3) (4.802048206329346, 4.179135799407959)\r\n(64, 128, 64, 4, 4) (4.406688213348389, 4.102975845336914)\r\n"]
