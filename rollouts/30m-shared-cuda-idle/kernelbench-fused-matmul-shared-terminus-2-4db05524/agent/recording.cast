[392.127916, "i", "mkdir -p /workspace/dev && cat > /workspace/dev/bench1.py << 'EOF'\nimport torch, time\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM=N=K=4096; B=16384\nx = torch.rand(B, K, device='cuda')\nlin = torch.nn.Linear(K, N).cuda()\nW = lin.weight.data; b = lin.bias.data\nsf = 0.5\n\ndef bench(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    e0=torch.cuda.Event(True); e1=torch.cuda.Event(True)\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        e0.record(); fn(); e1.record()\n        torch.cuda.synchronize()\n        ts.append(e0.elapsed_time(e1))\n    ts.sort()\n    return ts[len(ts)//2], min(ts)\n\ndef ref():\n    y = lin(x)\n    ox = y.clone().detach()\n    return y*sf + ox\n\nprint('ref        :', bench(ref))\nprint('fp32 mm    :', bench(lambda: torch.mm(x, W.t())))\nprint('fp32 lin   :', bench(lambda: torch.nn.functional.linear(x, W, b)))\nxb = x.bfloat16(); Wb = W.bfloat16()\nprint('bf16 mm    :', bench(lambda: torch.mm(xb, Wb.t())))\nbb = b.bfloat16()\nprint('bf16 lin"]
[392.127968, "i", "   :', bench(lambda: torch.nn.functional.linear(xb, Wb, bb)))\nprint('fp16 mm    :', bench(lambda: torch.mm(x.half(), W.half().t())))\nEOF\ngpu push sb-YjAmMJlm3oeViqAIfSlHFm /workspace/dev/bench1.py /workspace/bench1.py\n"]
