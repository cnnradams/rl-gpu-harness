[1309.455801, "o", "    WLp = WL + rk[:,None]*swk + rn[None,:]*swn\r\n\u001b[?2004l\r\u001b[?2004h"]
[1309.455836, "o", "> "]
[1309.455895, "o", "    acc = tl.zeros((BM,BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1309.455929, "o", "> "]
[1309.455969, "o", "    for k in range(0,K,BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.456005, "o", "        a = tl.load(Xp)\r\n\u001b[?2004l\r"]
[1309.456042, "o", "\u001b[?2004h> "]
[1309.456076, "o", "        ah = a.to(tl.bfloat16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1309.456113, "o", "> "]
[1309.456156, "o", "        al = (a - ah.to(tl.float32)).to(tl.bfloat16)\r\n\u001b[?2004l\r"]
[1309.45619, "o", "\u001b[?2004h> "]
[1309.456244, "o", "        bh = tl.load(WHp); bl = tl.load(WLp)\r\n\u001b[?2004l\r"]
[1309.456279, "o", "\u001b[?2004h> "]
[1309.456317, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[1309.456355, "o", "\u001b[?2004h> "]
[1309.456409, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[1309.456444, "o", "\u001b[?2004h> "]
[1309.456497, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.456573, "o", "        Xp += BK*sxk; WHp += BK*swk; WLp += BK*swk\r\n\u001b[?2004l\r"]
[1309.456607, "o", "\u001b[?2004h> "]
[1309.45664, "o", "    bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[1309.456678, "o", "\u001b[?2004h> "]
[1309.456717, "o", "    y = 1.5*acc + 1.5*bias[None,:]\r\n\u001b[?2004l\r"]
[1309.456747, "o", "\u001b[?2004h> "]
[1309.456785, "o", "    Yp = Y + rm[:,None]*sym + rn[None,:]*syn\r\n\u001b[?2004l\r"]
[1309.456819, "o", "\u001b[?2004h> "]
[1309.456852, "o", "    tl.store(Yp, y)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1309.45689, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1309.456927, "o", "Y=torch.empty(B,N,device='cuda')\r\n\u001b[?2004l\r"]
[1309.456961, "o", "\u001b[?2004h> "]
[1309.456995, "o", "def run(BM,BN,BK,GM,nw,ns):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1309.457029, "o", "> "]
[1309.457074, "o", "    grid=(triton.cdiv(B,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1309.457108, "o", "\u001b[?2004h> "]
[1309.457344, "o", "    mm3[grid](x, wh, wl, b, Y, B, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), Y.stride(0), Y.stride(1), BM, BN, BK, GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1309.457379, "o", "> "]
[1309.457421, "o", "    return Y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.45745, "o", "def bench(fn, n=50):\r\n\u001b[?2004l\r"]
[1309.457479, "o", "\u001b[?2004h> "]
[1309.457506, "o", "    for _ in range(10): fn()\r\n\u001b[?2004l\r"]
[1309.457533, "o", "\u001b[?2004h> "]
[1309.45757, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1309.457601, "o", "\u001b[?2004h> "]
[1309.457675, "o", "    e0=torch.cuda.Event(True); e1=torch.cuda.Event(True); ts=[]\r\n\u001b[?2004l\r"]
[1309.457708, "o", "\u001b[?2004h> "]
[1309.457741, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.457873, "o", "        torch.cuda.synchronize(); e0.record(); fn(); e1.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1309.457905, "o", "\u001b[?2004h> "]
[1309.457954, "o", "        ts.append(e0.elapsed_time(e1))\r\n\u001b[?2004l\r"]
[1309.457988, "o", "\u001b[?2004h> "]
[1309.458035, "o", "    ts.sort(); return ts[len(ts)//2], min(ts)\r\n\u001b[?2004l\r"]
[1309.458067, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1309.458099, "o", "> "]
[1309.45841, "o", "for cfg in [(128,128,32,64,8,4),(256,128,32,8,8,4),(256,128,32,8,8,3),(256,128,32,64,8,4),(256,64,32,8,8,4),(128,128,32,128,8,4),(64,128,32,64,4,4),(256,128,32,8,4,4),(128,128,32,64,8,3),(128,128,32,64,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.458445, "o", "    BM,BN,BK,GM,nw,ns=cfg\r\n\u001b[?2004l\r"]
[1309.458479, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.458549, "o", "        t=bench(lambda: run(BM,BN,BK,GM,nw,ns))\r\n\u001b[?2004l\r"]
[1309.45858, "o", "\u001b[?2004h> "]
[1309.458644, "o", "        run(BM,BN,BK,GM,nw,ns); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1309.458681, "o", "\u001b[?2004h> "]
[1309.458743, "o", "        ok=bool((((Y-reffp32).abs())<=tol).all().item())\r\n\u001b[?2004l\r"]
[1309.458775, "o", "\u001b[?2004h> "]
[1309.458843, "o", "        print(cfg, t, 'pass' if ok else 'WRONG', flush=True)\r\n\u001b[?2004l\r"]
[1309.458878, "o", "\u001b[?2004h> "]
[1309.458911, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1309.45899, "o", "        print(cfg, 'FAIL', str(e)[:60], flush=True)\r\n\u001b[?2004l\r"]
