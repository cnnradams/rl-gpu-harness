[1241.078464, "i", "cat > /workspace/dev/dbg5.py << 'EOF'\nimport torch, triton, triton.language as tl\ntorch.manual_seed(0)\nB,K,N=16384,4096,4096\nx=torch.rand(B,K,device='cuda')\nlin = torch.nn.Linear(K,N).cuda()\nW=lin.weight.data; b=lin.bias.data\nWt=W.t().contiguous()\nwh=Wt.bfloat16(); wl=(Wt-wh.float()).bfloat16()\nreffp32 = torch.nn.functional.linear(x, W, b)\nreffp32 = reffp32*0.5 + reffp32\ntol=1e-4+1e-4*reffp32.abs()\n\n@triton.jit\ndef mm3v2(XH, XL, WH, WL, BIAS, Y, M, N, K, sxm, sxk, swk, swn, sym, syn,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = min(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)\n    XHp = XH + rm[:,None]*sxm + rk[None,:]*sxk\n    XLp = XL + rm[:,Non"]
[1241.078527, "i", "e]*sxm + rk[None,:]*sxk\n    WHp = WH + rk[:,None]*swk + rn[None,:]*swn\n    WLp = WL + rk[:,None]*swk + rn[None,:]*swn\n    acc = tl.zeros((BM,BN), dtype=tl.float32)\n    for k in range(0,K,BK):\n        ah = tl.load(XHp); al = tl.load(XLp)\n        bh = tl.load(WHp); bl = tl.load(WLp)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        XHp += BK*sxk; XLp += BK*sxk; WHp += BK*swk; WLp += BK*swk\n    bias = tl.load(BIAS + rn)\n    y = 1.5*acc + 1.5*bias[None,:]\n    Yp = Y + rm[:,None]*sym + rn[None,:]*syn\n    tl.store(Yp, y)\n\ndef split_x(x):\n    xh = x.bfloat16()\n    xl = (x - xh.float()).bfloat16()\n    return xh, xl\n\nxh, xl = split_x(x)\nY=torch.empty(B,N,device='cuda')\n\ndef run(BM,BN,BK,GM,nw,ns,with_split=True):\n    if with_split:\n        xh2, xl2 = split_x(x)\n    else:\n        xh2, xl2 = xh, xl\n    grid=(triton.cdiv(B,BM)*triton.cdiv(N,BN),)\n    mm3v2[grid](xh2, xl2, wh, wl, b, Y, B, N, K, xh2.stride(0), xh2.stride(1), wh.stride(0), wh.stride(1), Y.stride(0"]
[1241.078738, "i", "), Y.stride(1), BM, BN, BK, GM, num_warps=nw, num_stages=ns)\n    return Y\n\nrun(128,128,32,64,8,4)\ntorch.cuda.synchronize()\ndd=(Y-reffp32).abs()\nprint('v2 err vs fp32 ref:', dd.max().item(), 'pass:', bool((dd<=tol).all().item()))\n\ndef bench(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    e0=torch.cuda.Event(True); e1=torch.cuda.Event(True); ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); e0.record(); fn(); e1.record(); torch.cuda.synchronize()\n        ts.append(e0.elapsed_time(e1))\n    ts.sort(); return ts[len(ts)//2], min(ts)\n\nprint('split pass alone:', bench(lambda: split_x(x)))\nfor cfg in [(128,128,32,64,8,4),(256,128,32,8,8,4),(256,128,64,8,8,3),(128,256,32,8,8,4),(128,128,64,64,8,4),(256,128,32,16,8,4),(256,256,32,8,8,3)]:\n    BM,BN,BK,GM,nw,ns=cfg\n    for ws in (True, False):\n        try:\n            print(cfg, 'incl_split' if ws else 'kernel_only', bench(lambda: run(BM,BN,BK,GM,nw,ns,ws)))\n        except Exception as e:\n            print(cfg, ws, 'FAIL', str(e)[:6"]
[1241.078769, "o", "cat > /workspace/dev/dbg5.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.078835, "i", "0])\nEOF\ngpu push sb-XBj6QwXjnFkyRmTRHyaqbI /workspace/dev/dbg5.py /workspace/dbg5.py && gpu exec sb-XBj6QwXjnFkyRmTRHyaqbI -- python3 /workspace/dbg5.py\n"]
[1241.078861, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.078912, "o", "B,K,N=16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.078969, "o", "x=torch.rand(B,K,device='cuda')\r\n\u001b[?2004l\r"]
[1241.079017, "o", "\u001b[?2004h> "]
[1241.079065, "o", "lin = torch.nn.Linear(K,N).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079111, "o", "W=lin.weight.data; b=lin.bias.data\r\n\u001b[?2004l\r\u001b[?2004h"]
[1241.079169, "o", "> Wt=W.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079259, "o", "wh=Wt.bfloat16(); wl=(Wt-wh.float()).bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079345, "o", "reffp32 = torch.nn.functional.linear(x, W, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1241.079392, "o", "reffp32 = reffp32*0.5 + reffp32\r\n\u001b[?2004l\r"]
