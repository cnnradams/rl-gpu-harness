[963.987535, "i", "cat > /workspace/dev/dbg3.py << 'EOF'\nimport torch, triton, triton.language as tl\ntorch.manual_seed(0)\nB,K,N=16384,4096,4096\nx=torch.rand(B,K,device='cuda')\nlin = torch.nn.Linear(K,N).cuda()\nW=lin.weight.data; b=lin.bias.data\nWt=W.t().contiguous()\nwh=Wt.bfloat16(); wl=(Wt-wh.float()).bfloat16()\n\n@triton.jit\ndef mm3(X, WH, WL, BIAS, Y, M, N, K, sxm, sxk, swk, swn, sym, syn,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = min(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // (group_size)\n    rm = pid_m*BM + tl.arange(0,BM)\n    rn = pid_n*BN + tl.arange(0,BN)\n    rk = tl.arange(0,BK)\n    Xp = X + rm[:,None]*sxm + rk[None,:]*sxk\n    WHp = WH + rk[:,None]*swk + rn[None,:]*swn\n    WLp = WL + rk[:,None]*swk + rn[None,:]*swn\n    acc = tl.zeros((BM,BN), dtype"]
[963.987759, "i", "=tl.float32)\n    for k in range(0,K,BK):\n        a = tl.load(Xp)\n        ah = a.to(tl.bfloat16)\n        al = (a - ah.to(tl.float32)).to(tl.bfloat16)\n        bh = tl.load(WHp); bl = tl.load(WLp)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        Xp += BK*sxk; WHp += BK*swk; WLp += BK*swk\n    bias = tl.load(BIAS + rn)\n    y = 1.5*acc + 1.5*bias[None,:]\n    Yp = Y + rm[:,None]*sym + rn[None,:]*syn\n    tl.store(Yp, y)\n\ndef run(Y, BM=128, BN=128, BK=32, GM=8, nw=8, ns=4):\n    grid=(triton.cdiv(B,BM)*triton.cdiv(N,BN),)\n    mm3[grid](x, wh, wl, b, Y, B, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), Y.stride(0), Y.stride(1), BM, BN, BK, GM, num_warps=nw, num_stages=ns)\n    return Y\n\nY=torch.empty(B,N,device='cuda')\nrun(Y)\ntorch.cuda.synchronize()\nref64 = (x.double() @ Wt.double() + b.double())*1.5\nprint('err vs fp64:', (Y.double()-ref64).abs().max().item())\nreffp32 = torch.nn.functional.linear(x, W, b)\nreffp32 = reffp32*0.5 + reffp32\ndd=(Y-reff"]
[963.987851, "o", "cat > /workspace/dev/dbg3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.987931, "i", "p32).abs(); tol=1e-4+1e-4*reffp32.abs()\nprint('err vs fp32 ref:', dd.max().item(), 'pass:', bool((dd<=tol).all().item()))\n\ndef bench(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    e0=torch.cuda.Event(True); e1=torch.cuda.Event(True); ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize(); e0.record(); fn(); e1.record(); torch.cuda.synchronize()\n        ts.append(e0.elapsed_time(e1))\n    ts.sort(); return ts[len(ts)//2], min(ts)\n\nY2=torch.empty(B,N,device='cuda')\nfor cfg in [(128,128,32,8,8,4),(128,128,32,16,8,4),(128,128,32,32,8,4),(128,128,64,8,8,3),(128,128,64,16,8,3),(128,256,32,8,8,3),(256,128,32,8,8,3),(128,128,32,64,8,4)]:\n    BM,BN,BK,GM,nw,ns = cfg\n    try:\n        t = bench(lambda: run(Y2,BM,BN,BK,GM,nw,ns))\n        run(Y2,BM,BN,BK,GM,nw,ns); torch.cuda.synchronize()\n        ok = bool((((Y2-reffp32).abs())<=tol).all().item())\n        print(cfg, t, 'pass' if ok else 'WRONG')\n    except Exception as e:\n        print(cfg, 'FAIL', str(e)[:60])\nEOF\ngpu push sb-XBj6QwXjnFky"]
