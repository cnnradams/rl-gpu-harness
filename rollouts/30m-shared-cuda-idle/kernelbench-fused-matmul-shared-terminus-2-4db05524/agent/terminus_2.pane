[?2004l[?2004h>     WLp = WL + rk[:, None] * swk + rn[None, :] * swn
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, K, BK):
[?2004l[?2004h>         a = tl.load(Xp)
[?2004l[?2004h>         ah = a.to(tl.bfloat16)
[?2004l[?2004h>         al = (a - ah.to(tl.float32)).to(tl.bfloat16)
[?2004l[?2004h>         bh = tl.load(WHp)
[?2004l[?2004h>         bl = tl.load(WLp)
[?2004l[?2004h>         acc = tl.dot(ah, bh, acc)
[?2004l[?2004h>         acc = tl.dot(al, bh, acc)
[?2004l[?2004h>         acc = tl.dot(ah, bl, acc)
[?2004l[?2004h>         Xp += BK * sxk
[?2004l[?2004h>         WHp += BK * swk
[?2004l[?2004h>         WLp += BK * swk
[?2004l[?2004h>     bias = tl.load(BIAS + rn)
[?2004l[?2004h>     y = 1.5 * acc + 1.5 * bias[None, :]
[?2004l[?2004h>     Yp = Y + rm[:, None] * sym + rn[None, :] * syn
[?2004l[?2004h>     tl.store(Yp, y)
