) -> KernelExecResult:
    """
    run the model and check correctness,
[?2004hroot@modal:/# cat /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py
[?2004limport torch
import json
import numpy as np
import time
from typing import Any, Optional, Union
