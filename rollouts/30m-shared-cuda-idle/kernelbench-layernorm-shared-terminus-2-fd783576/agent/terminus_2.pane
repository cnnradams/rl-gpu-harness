[?2004hroot@modal:/# cat > /tmp/bench2.py << 'EOF'
[?2004lages=3)

# capture graph
g = torch.cuda.CUDAGraph()
run_eager()
torch.cuda.synchronize()
with torch.cuda.graph(g):
    run_eager()

def clear_l2():
    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')
    d.fill_(42)
    del d

def bench(fn, n=20):
    for _ in range(3): fn()
    torch.cuda.synchronize()
    times=[]
    for i in range(n+1):
        torch.cuda.synchronize()
        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)
        clear_l2()
        s.record(); fn(); e.record()
        torch.cuda.synchronize()
        if i>=1: times.append(s.elapsed_time(e))
    return statistics.mean(times), min(times)

print('eager 2-kernel:', bench(run_eager))
print('graph replay :', bench(lambda: g.replay()))
# also graph replay with input copy (simulating fresh input into static buffer)
xin = torch.rand(R, N, device='cuda')
def run_copy_graph():
    xf.copy_(xin.view(-1))
    g.replay()
print('copy+graph   :', bench(run_copy_graph))
