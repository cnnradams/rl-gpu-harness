[341.596328, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[341.596359, "o", "\u001b[?2004h> "]
[341.59639, "o", "    row = pid // SPLITS\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.596415, "o", "> "]
[341.596434, "o", "    split = pid % SPLITS\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.596462, "o", "> "]
[341.59649, "o", "    offs = tl.arange(0, SPLITS)\r\n\u001b[?2004l\r"]
[341.596516, "o", "\u001b[?2004h> "]
[341.596574, "o", "    ps = tl.load(acc_ptr + (offs * R + row) * 2 + 0)\r\n\u001b[?2004l\r"]
[341.596603, "o", "\u001b[?2004h> "]
[341.596655, "o", "    pss = tl.load(acc_ptr + (offs * R + row) * 2 + 1)\r\n\u001b[?2004l\r"]
[341.596681, "o", "\u001b[?2004h> "]
[341.596708, "o", "    mean = tl.sum(ps) / N\r\n\u001b[?2004l\r"]
[341.59674, "o", "\u001b[?2004h> "]
[341.596777, "o", "    var = tl.sum(pss) / N - mean * mean\r\n\u001b[?2004l\r"]
[341.596807, "o", "\u001b[?2004h> "]
[341.596848, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[341.596881, "o", "\u001b[?2004h> "]
[341.596926, "o", "    base = row * N + split * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.596956, "o", "> "]
[341.596983, "o", "    wbase = split * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.597025, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r"]
[341.597054, "o", "\u001b[?2004h> "]
[341.597106, "o", "        idx = i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.597134, "o", "> "]
[341.597176, "o", "        v = tl.load(x_ptr + base + idx)\r\n\u001b[?2004l\r"]
[341.597203, "o", "\u001b[?2004h> "]
[341.597244, "o", "        ww = tl.load(w_ptr + wbase + idx)\r\n\u001b[?2004l\r"]
[341.597269, "o", "\u001b[?2004h> "]
[341.597312, "o", "        bb = tl.load(b_ptr + wbase + idx)\r\n\u001b[?2004l\r"]
[341.597338, "o", "\u001b[?2004h> "]
[341.597415, "o", "        tl.store(y_ptr + base + idx, (v - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.597442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.59747, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[341.597496, "o", "\u001b[?2004h> "]
[341.597564, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[341.597589, "o", "\u001b[?2004h> "]
[341.597615, "o", "    d.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.597645, "o", "    del d\r\n\u001b[?2004l\r"]
[341.59767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.597696, "o", "> "]
[341.597722, "o", "def bench(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.597764, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[341.597792, "o", "\u001b[?2004h> "]
[341.597817, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[341.597845, "o", "\u001b[?2004h> "]
[341.597875, "o", "    times=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.597904, "o", "    for i in range(n+1):\r\n\u001b[?2004l\r"]
[341.597934, "o", "\u001b[?2004h> "]
[341.59796, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[341.597986, "o", "\u001b[?2004h> "]
[341.59808, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[341.598115, "o", "\u001b[?2004h> "]
[341.598143, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.598191, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[341.598221, "o", "\u001b[?2004h> "]
[341.598247, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[341.598276, "o", "\u001b[?2004h> "]
[341.598325, "o", "        if i>=1: times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[341.598355, "o", "\u001b[?2004h> "]
[341.598386, "o", "    return statistics.mean(times)\r\n\u001b[?2004l\r"]
[341.598416, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[341.598446, "o", "> "]
[341.598489, "o", "ref = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\r\n\u001b[?2004l\r"]
[341.598515, "o", "\u001b[?2004h> "]
[341.598609, "o", "print('native LN:', bench(lambda: torch.nn.functional.layer_norm(x, (N,), w, b, eps)))\r\n\u001b[?2004l\r"]
[341.598642, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.59867, "o", "xf = x.view(-1)\r\n\u001b[?2004l\r"]
[341.598695, "o", "\u001b[?2004h> results=[]\r\n\u001b[?2004l\r"]
[341.598722, "o", "\u001b[?2004h> "]
[341.598761, "o", "for variant in ['atomic','part']:\r\n\u001b[?2004l\r"]
[341.598789, "o", "\u001b[?2004h> "]
[341.598823, "o", "    for SPLITS in [8,16,32,64,128]:\r\n\u001b[?2004l\r"]
[341.598848, "o", "\u001b[?2004h> "]
[341.598889, "o", "        for BLOCK in [4096,8192,16384]:\r\n\u001b[?2004l\r"]
[341.598916, "o", "\u001b[?2004h> "]
[341.598959, "o", "            if SPLITS*BLOCK > N: continue\r\n\u001b[?2004l\r"]
[341.598988, "o", "\u001b[?2004h> "]
[341.599023, "o", "            ITERS = N//(SPLITS*BLOCK)\r\n\u001b[?2004l\r"]
[341.599049, "o", "\u001b[?2004h> "]
[341.599077, "o", "            for warps in [4,8]:\r\n\u001b[?2004l\r"]
[341.599108, "o", "\u001b[?2004h> "]
[341.59915, "o", "                for stages in [3,4]:\r\n\u001b[?2004l\r"]
[341.599178, "o", "\u001b[?2004h> "]
[341.599239, "o", "                    y = torch.empty_like(x); yf = y.view(-1)\r\n\u001b[?2004l\r"]
[341.599265, "o", "\u001b[?2004h> "]
[341.599307, "o", "                    if variant=='atomic':\r\n\u001b[?2004l\r"]
[341.599334, "o", "\u001b[?2004h> "]
[341.599369, "o", "                        def fn():\r\n\u001b[?2004l\r"]
[341.599397, "o", "\u001b[?2004h> "]
[341.599462, "o", "                            acc = torch.zeros(R*2, device='cuda')\r\n\u001b[?2004l\r"]
[341.599493, "o", "\u001b[?2004h> "]
[341.599649, "o", "                            _stats_atomic[(R*SPLITS,)](xf, acc, N, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.599684, "o", "> "]
[341.599846, "o", "                            _apply_atomic[(R*SPLITS,)](xf, w, b, acc, yf, N, eps, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages) \r"]
[341.599881, "o", "\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.599918, "o", "                    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.600008, "o", "                        acc = torch.empty(SPLITS*R*2, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.600036, "o", "> "]
[341.600061, "o", "                        def fn():\r\n\u001b[?2004l\r"]
[341.600088, "o", "\u001b[?2004h> "]
[341.60025, "o", "                            _stats_part[(R*SPLITS,)](xf, acc, N, R, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.600279, "o", "> "]
[341.600442, "o", "                            _apply_part[(R*SPLITS,)](xf, w, b, acc, yf, N, R, eps, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[341.600474, "o", "> "]
[341.600518, "o", "                    fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[341.600547, "o", "\u001b[?2004h> "]
[341.600601, "o", "                    err = (y - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[341.600628, "o", "\u001b[?2004h> "]
[341.600661, "o", "                    t = bench(fn)\r\n\u001b[?2004l\r"]
[341.60069, "o", "\u001b[?2004h> "]
[341.60078, "o", "                    results.append((t, variant, SPLITS, BLOCK, ITERS, warps, stages, err))\r\n\u001b[?2004l\r"]
[341.60081, "o", "\u001b[?2004h> "]
[341.600944, "o", "                    print(f'{variant} S={SPLITS} B={BLOCK} I={ITERS} w={warps} st={stages}: {t:.4f} ms err={err:.2e}')\r\n\u001b[?2004l\r"]
[341.600992, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.601021, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.601051, "o", "print('\\nTOP 10:')\r\n\u001b[?2004l\r"]
[341.601082, "o", "\u001b[?2004h> "]
[341.601114, "o", "for r in results[:10]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.60114, "o", "    print(r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.60117, "o", "EOF\r\n\u001b[?2004l\r"]
