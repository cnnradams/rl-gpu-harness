[770.478631, "o", "request ID: 0696a8db30414eb3a84d41d2b5b332c5\r\ncommand: 7b3af1e52c854a46a244d7b188b4e611\r\neager 2-kernel: (0.300660802423954, 0.298880010843277)\r\ngraph replay : (0.29920160472393037, 0.2968960106372833)\r\ncopy+graph   : (0.47806400060653687, 0.4744639992713928)\r\n"]
