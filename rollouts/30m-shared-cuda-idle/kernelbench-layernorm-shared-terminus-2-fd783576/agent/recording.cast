[205.278474, "o", "\u001b[?2004h> "]
[205.278501, "o", "            self.N *= d\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.278528, "o", "> "]
[205.278559, "o", "        self.SPLITS = 32\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.278598, "o", "        self.BLOCK = 8192\r\n\u001b[?2004l\r"]
[205.278624, "o", "\u001b[?2004h> "]
[205.278691, "o", "        self.ITERS = max(1, self.N // (self.SPLITS * self.BLOCK))\r\n\u001b[?2004l\r"]
[205.278723, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.278793, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
