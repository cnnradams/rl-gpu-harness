[341.590386, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, statistics, itertools\nimport triton.language as tl\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nR = B\nx = torch.rand(R, N, device='cuda')\nw = torch.rand(N, device='cuda')\nb = torch.rand(N, device='cuda')\neps = 1e-5\n\n@triton.jit\ndef _stats_atomic(x_ptr, acc_ptr, N, BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    base = row * N + split * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + offs)\n        s += v\n        ss += v * v\n    tl.atomic_add(acc_ptr + row * 2 + 0, tl.sum(s))\n    tl.atomic_add(acc_ptr + row * 2 + 1, tl.sum(ss))\n\n@triton.jit\ndef _apply_atomic(x_ptr, w_ptr, b_ptr, acc_ptr, y_ptr, N, eps,\n                  BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program"]
[341.590584, "i", "_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    mean = tl.load(acc_ptr + row * 2 + 0) / N\n    var = tl.load(acc_ptr + row * 2 + 1) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + split * (BLOCK * ITERS)\n    wbase = split * (BLOCK * ITERS)\n    for i in range(ITERS):\n        idx = i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        ww = tl.load(w_ptr + wbase + idx)\n        bb = tl.load(b_ptr + wbase + idx)\n        tl.store(y_ptr + base + idx, (v - mean) * rstd * ww + bb)\n\n@triton.jit\ndef _stats_part(x_ptr, acc_ptr, N, R, BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    base = row * N + split * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + offs)\n        s += v\n        ss += v * v\n    tl."]
[341.590616, "o", "cat > /workspace/tune.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.590651, "i", "store(acc_ptr + (split * R + row) * 2 + 0, tl.sum(s))\n    tl.store(acc_ptr + (split * R + row) * 2 + 1, tl.sum(ss))\n\n@triton.jit\ndef _apply_part(x_ptr, w_ptr, b_ptr, acc_ptr, y_ptr, N, R, eps,\n                BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    offs = tl.arange(0, SPLITS)\n    ps = tl.load(acc_ptr + (offs * R + row) * 2 + 0)\n    pss = tl.load(acc_ptr + (offs * R + row) * 2 + 1)\n    mean = tl.sum(ps) / N\n    var = tl.sum(pss) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + split * (BLOCK * ITERS)\n    wbase = split * (BLOCK * ITERS)\n    for i in range(ITERS):\n        idx = i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        ww = tl.load(w_ptr + wbase + idx)\n        bb = tl.load(b_ptr + wbase + idx)\n        tl.store(y_ptr + base + idx, (v - mean) * rstd * ww + bb)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n  "]
[341.59066, "o", "import torch, triton, statistics, itertools\r\n\u001b[?2004l\r\u001b[?2004h> "]
[341.590692, "i", "  d.fill_(42)\n    del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    times=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        if i>=1: times.append(s.elapsed_time(e))\n    return statistics.mean(times)\n\nref = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\nprint('native LN:', bench(lambda: torch.nn.functional.layer_norm(x, (N,), w, b, eps)))\n\nxf = x.view(-1)\nresults=[]\nfor variant in ['atomic','part']:\n    for SPLITS in [8,16,32,64,128]:\n        for BLOCK in [4096,8192,16384]:\n            if SPLITS*BLOCK > N: continue\n            ITERS = N//(SPLITS*BLOCK)\n            for warps in [4,8]:\n                for stages in [3,4]:\n                    y = torch.empty_like(x); yf = y.view(-1)\n                    if variant=='atomic':\n                        def fn():\n                      "]
[341.590717, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[341.590737, "i", "      acc = torch.zeros(R*2, device='cuda')\n                            _stats_atomic[(R*SPLITS,)](xf, acc, N, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\n                            _apply_atomic[(R*SPLITS,)](xf, w, b, acc, yf, N, eps, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\n                    else:\n                        acc = torch.empty(SPLITS*R*2, device='cuda')\n                        def fn():\n                            _stats_part[(R*SPLITS,)](xf, acc, N, R, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\n                            _apply_part[(R*SPLITS,)](xf, w, b, acc, yf, N, R, eps, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\n                    fn(); torch.cuda.synchronize()\n                    err = (y - ref).abs().max().item()\n                    t = bench(fn)\n                    results.append((t, variant, SPLITS, BLOCK, ITERS, warps, stages, err))\n            "]
[341.590748, "o", "\u001b[?2004h> "]
[341.590776, "i", "        print(f'{variant} S={SPLITS} B={BLOCK} I={ITERS} w={warps} st={stages}: {t:.4f} ms err={err:.2e}')\n\nresults.sort()\nprint('\\nTOP 10:')\nfor r in results[:10]:\n    print(r)\nEOF\n"]
