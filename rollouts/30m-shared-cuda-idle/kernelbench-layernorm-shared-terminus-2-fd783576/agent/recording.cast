[555.412602, "o", "-06\r\npart S=128 B=16384 I=2 w=4 st=4: 1.7470 ms err=2.98e-06\r\npart S=128 B=16384 I=2 w=8 st=3: 0.4005 ms err=3.22e-06\r\npart S=128 B=16384 I=2 w=8 st=4: 0.3980 ms err=3.22e-06\r\n\r\nTOP 10:\r\n(0.299619197845459, 'part', 16, 8192, 32, 4, 3, 3.337860107421875e-06)\r\n(0.3009407967329025, 'part', 16, 8192, 32, 4, 4, 3.337860107421875e-06)\r\n(0.3010704040527344, 'part', 32, 4096, 32, 8, 4, 3.0994415283203125e-06)\r\n(0.3015199974179268, 'part', 32, 4096, 32, 8, 3, 3.0994415283203125e-06)\r\n(0.3024959981441498, 'atomic', 16, 8192, 32, 4, 3, 3.2186508178710938e-06)\r\n(0.3042528048157692, 'atomic', 16, 8192, 32, 4, 4, 3.0994415283203125e-06)\r\n(0.30674719959497454, 'atomic', 32, 4096, 32, 4, 3, 3.6954879760742188e-06)\r\n(0.3070688009262085, 'atomic', 32, 4096, 32, 4, 4, 3.2186508178710938e-06)\r\n(0.30963039845228196, 'part', 16, 16384, 16, 8, 4, 3.337860107421875e-06)\r\n(0.31054559648036956, 'part', 16, 16384, 16, 8, 3, 3.337860107421875e-06)\r\n"]
