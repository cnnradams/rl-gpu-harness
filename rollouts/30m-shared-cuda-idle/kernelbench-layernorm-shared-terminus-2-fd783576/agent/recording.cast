[205.27931, "o", "\u001b[?2004h> "]
[205.279382, "o", "        acc = torch.zeros(R * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[205.27941, "o", "\u001b[?2004h> "]
[205.279452, "o", "        grid = (R * self.SPLITS,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.279552, "o", "        _stats_kernel[grid](xf, acc, N, BLOCK=self.BLOCK, ITERS=self.ITERS,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.279633, "o", "                            SPLITS=self.SPLITS, num_warps=8)\r\n\u001b[?2004l\r"]
[205.279656, "o", "\u001b[?2004h> "]
