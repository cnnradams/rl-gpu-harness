[687.875799, "i", "cat > /tmp/bench2.py << 'EOF'\nimport torch, triton, statistics\nimport triton.language as tl\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nR = B\nx = torch.rand(R, N, device='cuda')\nw = torch.rand(N, device='cuda')\nb = torch.rand(N, device='cuda')\neps = 1e-5\nSPLITS, BLOCK, ITERS = 16, 8192, 32\n\n@triton.jit\ndef _stats_kernel(x_ptr, acc_ptr, N, R, BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    base = row * N + split * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + offs)\n        s += v\n        ss += v * v\n    tl.store(acc_ptr + (split * R + row) * 2 + 0, tl.sum(s))\n    tl.store(acc_ptr + (split * R + row) * 2 + 1, tl.sum(ss))\n\n@triton.jit\ndef _apply_kernel(x_ptr, w_ptr, b_ptr, acc_ptr, y_ptr, N, R, eps, BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.const"]
[687.875855, "i", "expr):\n    pid = tl.program_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    offs = tl.arange(0, SPLITS)\n    ps = tl.load(acc_ptr + (offs * R + row) * 2 + 0)\n    pss = tl.load(acc_ptr + (offs * R + row) * 2 + 1)\n    mean = tl.sum(ps) / N\n    var = tl.sum(pss) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + split * (BLOCK * ITERS)\n    wbase = split * (BLOCK * ITERS)\n    for i in range(ITERS):\n        idx = i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        ww = tl.load(w_ptr + wbase + idx)\n        bb = tl.load(b_ptr + wbase + idx)\n        tl.store(y_ptr + base + idx, (v - mean) * rstd * ww + bb)\n\nxf = x.view(-1)\ny = torch.empty_like(x); yf = y.view(-1)\nacc = torch.empty(SPLITS*R*2, device='cuda')\n\ndef run_eager():\n    _stats_kernel[(R*SPLITS,)](xf, acc, N, R, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=4, num_stages=3)\n    _apply_kernel[(R*SPLITS,)](xf, w, b, acc, yf, N, R, eps, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=4, num_st"]
[687.87599, "i", "ages=3)\n\n# capture graph\ng = torch.cuda.CUDAGraph()\nrun_eager()\ntorch.cuda.synchronize()\nwith torch.cuda.graph(g):\n    run_eager()\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    times=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        if i>=1: times.append(s.elapsed_time(e))\n    return statistics.mean(times), min(times)\n\nprint('eager 2-kernel:', bench(run_eager))\nprint('graph replay :', bench(lambda: g.replay()))\n# also graph replay with input copy (simulating fresh input into static buffer)\nxin = torch.rand(R, N, device='cuda')\ndef run_copy_graph():\n    xf.copy_(xin.view(-1))\n    g.replay()\nprint('copy+graph   :', bench(run_copy_graph))\nEOF\ngpu exec sb-3122TEpsJe8BwG4lfRQ"]
