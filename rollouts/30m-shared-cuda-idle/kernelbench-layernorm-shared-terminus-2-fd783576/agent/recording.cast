[841.818207, "i", "cat > /tmp/tune2.py << 'EOF'\nimport torch, triton, statistics\nimport triton.language as tl\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nR = B\nx = torch.rand(R, N, device='cuda')\nw = torch.rand(N, device='cuda')\nb = torch.rand(N, device='cuda')\neps = 1e-5\n\n@triton.jit\ndef _stats(x_ptr, acc_ptr, N, R, BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLITS\n    split = pid % SPLITS\n    base = row * N + split * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + offs)\n        s += v\n        ss += v * v\n    tl.store(acc_ptr + (split * R + row) * 2 + 0, tl.sum(s))\n    tl.store(acc_ptr + (split * R + row) * 2 + 1, tl.sum(ss))\n\n@triton.jit\ndef _apply(x_ptr, w_ptr, b_ptr, acc_ptr, y_ptr, N, R, eps, BLOCK: tl.constexpr, ITERS: tl.constexpr, SPLITS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S"]
[841.818262, "i", "PLITS\n    split = pid % SPLITS\n    offs = tl.arange(0, SPLITS)\n    ps = tl.load(acc_ptr + (offs * R + row) * 2 + 0)\n    pss = tl.load(acc_ptr + (offs * R + row) * 2 + 1)\n    mean = tl.sum(ps) / N\n    var = tl.sum(pss) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + split * (BLOCK * ITERS)\n    wbase = split * (BLOCK * ITERS)\n    for i in range(ITERS):\n        idx = i * BLOCK + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        ww = tl.load(w_ptr + wbase + idx)\n        bb = tl.load(b_ptr + wbase + idx)\n        tl.store(y_ptr + base + idx, (v - mean) * rstd * ww + bb)\n\nref = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\nxf = x.view(-1)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    d.fill_(42); del d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_tim"]
[841.818269, "i", "ing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        if i>=1: ts.append(s.elapsed_time(e))\n    return statistics.mean(ts)\n\nres=[]\nfor SPLITS in [12,16,20,24,32]:\n    for BLOCK in [8192,16384]:\n        if SPLITS*BLOCK > N: continue\n        ITERS = N//(SPLITS*BLOCK)\n        for warps in [4,8]:\n            for stages in [2,3,4]:\n                y = torch.empty_like(x); yf = y.view(-1)\n                acc = torch.empty(SPLITS*R*2, device='cuda')\n                def fn():\n                    _stats[(R*SPLITS,)](xf, acc, N, R, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\n                    _apply[(R*SPLITS,)](xf, w, b, acc, yf, N, R, eps, BLOCK=BLOCK, ITERS=ITERS, SPLITS=SPLITS, num_warps=warps, num_stages=stages)\n                fn(); torch.cuda.synchronize()\n                err=(y-ref).abs().max().item()\n                t=bench(fn)\n                res.append((t,SPLITS,BLOCK,ITERS,warps,stages,err))\n                print(f'S={SP"]
[841.818352, "i", "LITS} B={BLOCK} I={ITERS} w={warps} st={stages}: {t:.4f} ms err={err:.1e}')\nres.sort()\nprint('TOP5:')\nfor r in res[:5]: print(r)\nEOF\nbase64 -w0 /tmp/tune2.py > /tmp/tune2.b64 && gpu exec sb-3122TEpsJe8BwG4lfRQOl7 -- bash -c \"echo $(cat /tmp/tune2.b64) | base64 -d > /tmp/tune2.py && echo OK\"\n"]
