[1492.127878, "o", "\u001b[?2004h> "]
[1492.12809, "o", "outref = torch.nn.functional.layer_norm(x, (F,D1,D2), w.view(F,D1,D2), b.view(F,D1,D2), 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h"]
