[1632.936689, "o", "\u001b[?2004h> "]
[1632.936777, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[1632.936811, "o", "\u001b[?2004h> "]
[1632.936867, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1632.936905, "o", "\u001b[?2004h> "]
[1632.936993, "o", "    offs = pid*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1632.937031, "o", "\u001b[?2004h> "]
[1632.937069, "o", "    m = offs < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.937106, "o", "> "]
[1632.937209, "o", "    xv = tl.load(X + row*N + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1632.937242, "o", "\u001b[?2004h> "]
[1632.937305, "o", "    npg = tl.num_programs(0)\r\n\u001b[?2004l\r"]
[1632.937339, "o", "\u001b[?2004h> "]
[1632.937437, "o", "    tl.store(P1 + row*npg + pid, tl.sum(xv))\r\n\u001b[?2004l\r"]
[1632.937468, "o", "\u001b[?2004h> "]
[1632.937575, "o", "    tl.store(P2 + row*npg + pid, tl.sum(xv*xv))\r\n\u001b[?2004l\r"]
[1632.937607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1632.937648, "o", "\u001b[?2004h> "]
[1632.937686, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1632.937904, "o", "def norm_kernel(X, P1, P2, Y, W, B, N, NP, NP2: tl.constexpr, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.937946, "o", "> "]
[1632.938016, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[1632.938051, "o", "\u001b[?2004h> "]
[1632.938107, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1632.938145, "o", "\u001b[?2004h> "]
[1632.938201, "o", "    idx = tl.arange(0, NP2)\r\n\u001b[?2004l\r"]
[1632.938233, "o", "\u001b[?2004h> "]
[1632.938274, "o", "    pm = idx < NP\r\n\u001b[?2004l\r"]
[1632.938306, "o", "\u001b[?2004h> "]
[1632.938452, "o", "    s1 = tl.sum(tl.load(P1 + row*NP + idx, mask=pm, other=0.0))\r\n\u001b[?2004l\r"]
[1632.938486, "o", "\u001b[?2004h> "]
[1632.938619, "o", "    s2 = tl.sum(tl.load(P2 + row*NP + idx, mask=pm, other=0.0))\r\n\u001b[?2004l\r"]
[1632.938657, "o", "\u001b[?2004h> "]
[1632.938694, "o", "    mean = s1/N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.938743, "o", "> "]
[1632.938782, "o", "    var = s2/N - mean*mean\r\n\u001b[?2004l\r"]
[1632.938814, "o", "\u001b[?2004h> "]
[1632.93889, "o", "    rstd = 1.0/tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1632.938923, "o", "\u001b[?2004h> "]
[1632.939016, "o", "    offs = pid*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1632.939054, "o", "\u001b[?2004h> "]
[1632.939089, "o", "    m = offs < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.939126, "o", "> "]
[1632.939165, "o", "    xo = row*N + offs\r\n\u001b[?2004l\r"]
[1632.939203, "o", "\u001b[?2004h> "]
[1632.939293, "o", "    xv = tl.load(X + xo, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1632.939331, "o", "\u001b[?2004h> "]
[1632.93944, "o", "    wv = tl.load(W + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1632.939481, "o", "\u001b[?2004h> "]
[1632.939575, "o", "    bv = tl.load(B + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1632.939607, "o", "\u001b[?2004h> "]
[1632.93973, "o", "    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\r\n\u001b[?2004l\r"]
[1632.939768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.939807, "o", "> "]
[1632.939894, "o", "def tri_ln(x2, w, b, nparts, BLOCK, warps=32):\r\n\u001b[?2004l\r"]
[1632.939932, "o", "\u001b[?2004h> "]
[1632.939969, "o", "    B_, N_ = x2.shape\r\n\u001b[?2004l\r"]
[1632.940012, "o", "\u001b[?2004h> "]
[1632.940117, "o", "    P1 = torch.empty(B_, nparts, device=x2.device)\r\n\u001b[?2004l\r"]
[1632.940151, "o", "\u001b[?2004h> "]
[1632.940261, "o", "    P2 = torch.empty(B_, nparts, device=x2.device)\r\n\u001b[?2004l\r"]
[1632.940299, "o", "\u001b[?2004h> "]
[1632.940357, "o", "    Y = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[1632.940395, "o", "\u001b[?2004h> "]
[1632.940474, "o", "    NP2 = 1 << (nparts-1).bit_length()\r\n\u001b[?2004l\r"]
[1632.940512, "o", "\u001b[?2004h> "]
[1632.940675, "o", "    part_kernel[(nparts, B_)](x2, P1, P2, N_, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[1632.940713, "o", "\u001b[?2004h> "]
[1632.940973, "o", "    norm_kernel[(nparts, B_)](x2, P1, P2, Y, w, b, N_, nparts, NP2=NP2, eps=1e-5, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.941015, "o", "> "]
[1632.941056, "o", "    return Y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1632.941087, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1632.941185, "o", "for nparts, BLOCK in ((128,32768),(264,16384)):\r\n\u001b[?2004l\r"]
[1632.941216, "o", "\u001b[?2004h> "]
[1632.941278, "o", "    for warps in (8,16,32):\r\n\u001b[?2004l\r"]
[1632.941311, "o", "\u001b[?2004h> "]
[1632.941463, "o", "        t = timeit(lambda: tri_ln(x2, w, b, nparts, BLOCK, warps))\r\n\u001b[?2004l\r"]
[1632.941504, "o", "\u001b[?2004h> "]
[1632.941685, "o", "        print(f'tri nparts={nparts} BLOCK={BLOCK} warps={warps} t={t:.4f}', flush=True)\r\n\u001b[?2004l\r"]
[1632.941726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.941765, "o", "> "]
[1632.941792, "o", "# separate timings\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.94183, "o", "> "]
[1632.941998, "o", "P1 = torch.empty(B,128, device='cuda'); P2 = torch.empty(B,128, device='cuda')\r\n\u001b[?2004l\r"]
[1632.942033, "o", "\u001b[?2004h> "]
[1632.942216, "o", "t1 = timeit(lambda: part_kernel[(128,B)](x2, P1, P2, N, BLOCK=32768, num_warps=16))\r\n\u001b[?2004l\r"]
[1632.942255, "o", "\u001b[?2004h> "]
[1632.942352, "o", "print('part only 128/32768/16w:', t1, flush=True)\r\n\u001b[?2004l\r"]
[1632.942384, "o", "\u001b[?2004h> "]
[1632.942657, "o", "t2 = timeit(lambda: norm_kernel[(128,B)](x2, P1, P2, y2, w, b, N, 128, NP2=128, eps=1e-5, BLOCK=32768, num_warps=16))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.94268, "o", "> "]
[1632.9428, "o", "print('norm only 128/32768/16w:', t2, flush=True)\r\n\u001b[?2004l\r"]
[1632.942842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.94288, "o", "> "]
[1632.94293, "o", "# fused spin-barrier single pass\r\n\u001b[?2004l\r"]
[1632.94297, "o", "\u001b[?2004h> "]
[1632.943007, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1632.943198, "o", "def fused_kernel(X, Y, W, B, S1, S2, CNT, N, NP, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.943238, "o", "> "]
[1632.943308, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[1632.943346, "o", "\u001b[?2004h> "]
[1632.943399, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1632.943443, "o", "\u001b[?2004h> "]
[1632.943538, "o", "    offs = pid*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1632.943576, "o", "\u001b[?2004h> "]
[1632.943614, "o", "    m = offs < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.943645, "o", "> "]
[1632.943676, "o", "    xo = row*N + offs\r\n\u001b[?2004l\r"]
[1632.943712, "o", "\u001b[?2004h> "]
[1632.943894, "o", "    xv = tl.load(X + xo, mask=m, other=0.0, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[1632.943933, "o", "\u001b[?2004h> "]
[1632.944042, "o", "    tl.atomic_add(S1 + row, tl.sum(xv), sem='acq_rel')\r\n\u001b[?2004l\r"]
[1632.944081, "o", "\u001b[?2004h> "]
[1632.944202, "o", "    tl.atomic_add(S2 + row, tl.sum(xv*xv), sem='acq_rel')\r\n\u001b[?2004l\r"]
[1632.944245, "o", "\u001b[?2004h> "]
[1632.944338, "o", "    tl.atomic_add(CNT + row, 1, sem='acq_rel')\r\n\u001b[?2004l\r"]
[1632.944391, "o", "\u001b[?2004h>     c = 0\r\n\u001b[?2004l\r"]
[1632.944428, "o", "\u001b[?2004h> "]
[1632.94448, "o", "    while c < NP:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1632.944613, "o", "        c = tl.atomic_add(CNT + row, 0, sem='acq_rel')\r\n\u001b[?2004l\r"]
[1632.944644, "o", "\u001b[?2004h> "]
[1632.944768, "o", "    s1 = tl.atomic_add(S1 + row, 0.0, sem='acq_rel')\r\n\u001b[?2004l\r"]
[1632.944806, "o", "\u001b[?2004h> "]
[1632.944915, "o", "    s2 = tl.atomic_add(S2 + row, 0.0, sem='acq_rel')\r\n\u001b[?2004l\r"]
[1632.944949, "o", "\u001b[?2004h> "]
[1632.944984, "o", "    mean = s1/N\r\n\u001b[?2004l\r"]
[1632.945022, "o", "\u001b[?2004h> "]
[1632.945071, "o", "    var = s2/N - mean*mean\r\n\u001b[?2004l\r"]
[1632.945113, "o", "\u001b[?2004h> "]
[1632.945175, "o", "    rstd = 1.0/tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1632.945214, "o", "\u001b[?2004h> "]
[1632.945309, "o", "    wv = tl.load(W + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1632.945348, "o", "\u001b[?2004h> "]
[1632.945442, "o", "    bv = tl.load(B + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1632.945476, "o", "\u001b[?2004h> "]
[1632.945593, "o", "    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\r\n\u001b[?2004l\r"]
[1632.945626, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.945658, "o", "> "]
[1632.945765, "o", "def fused_ln(x2, w, b, nparts, BLOCK, warps=16):\r\n\u001b[?2004l\r"]
[1632.945802, "o", "\u001b[?2004h> "]
[1632.94584, "o", "    B_, N_ = x2.shape\r\n\u001b[?2004l\r"]
[1632.945873, "o", "\u001b[?2004h> "]
[1632.945972, "o", "    S1 = torch.zeros(B_, device=x2.device)\r\n\u001b[?2004l\r"]
[1632.946007, "o", "\u001b[?2004h> "]
[1632.946101, "o", "    S2 = torch.zeros(B_, device=x2.device)\r\n\u001b[?2004l\r"]
[1632.94614, "o", "\u001b[?2004h> "]
[1632.946275, "o", "    CNT = torch.zeros(B_, device=x2.device, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[1632.946309, "o", "\u001b[?2004h> "]
[1632.94637, "o", "    Y = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[1632.946404, "o", "\u001b[?2004h> "]
[1632.946643, "o", "    fused_kernel[(nparts, B_)](x2, Y, w, b, S1, S2, CNT, N_, nparts, 1e-5, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[1632.946667, "o", "\u001b[?2004h> "]
[1632.94671, "o", "    return Y\r\n\u001b[?2004l\r"]
[1632.946742, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.94678, "o", "> "]
[1632.946981, "o", "outref = torch.nn.functional.layer_norm(x, (F,D1,D2), w.view(F,D1,D2), b.view(F,D1,D2), 1e-5)\r\n\u001b[?2004l\r"]
[1632.947022, "o", "\u001b[?2004h> "]
[1632.947094, "o", "Y = fused_ln(x2, w, b, 132, 32768, 16)\r\n\u001b[?2004l\r"]
[1632.947133, "o", "\u001b[?2004h> "]
[1632.947304, "o", "print('fused maxdiff', (Y.view_as(x)-outref).abs().max().item(), flush=True)\r\n\u001b[?2004l\r"]
[1632.947336, "o", "\u001b[?2004h> "]
[1632.947481, "o", "for nparts, BLOCK in ((132,32768),(128,32768),(264,16384)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1632.94752, "o", "> "]
[1632.947555, "o", "    for warps in (8,16):\r\n\u001b[?2004l\r"]
[1632.947584, "o", "\u001b[?2004h> "]
[1632.947757, "o", "        t = timeit(lambda: fused_ln(x2, w, b, nparts, BLOCK, warps))\r\n\u001b[?2004l\r"]
[1632.947791, "o", "\u001b[?2004h> "]
[1632.947995, "o", "        print(f'fused nparts={nparts} BLOCK={BLOCK} warps={warps} t={t:.4f}', flush=True)\r\n\u001b[?2004l\r"]
[1632.948029, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1632.949761, "o", "\u001b[?2004hroot@modal:/# "]
[1633.241604, "i", "gpu run -- python3 /workspace/bench2.py\n"]
[1633.241859, "o", "gpu run -- python3 /workspace/bench2.py\r\n\u001b[?2004l\r"]
[1633.360712, "o", "request ID: 96f22fdb4b0d4f93939837b599006c4f\r\n"]
[1639.203365, "o", "box: sb-cuJYQOzRGKmcpeVIEzbD1Y\r\ncommand: d81f5eb93e0b417da110a3eaee257fef\r\n"]
[1641.444307, "o", "copy nparts=128 BLOCK=32768 warps=16 t=0.1935\r\ncopy nparts=128 BLOCK=32768 warps=32 t=0.1951\r\ncopy nparts=264 BLOCK=16384 warps=16 t=0.1938\r\ncopy nparts=264 BLOCK=16384 warps=32 t=0.1947\r\n"]
[1642.3492, "o", "tri nparts=128 BLOCK=32768 warps=8 t=1.7534\r\n"]
[1643.234186, "o", "tri nparts=128 BLOCK=32768 warps=16 t=0.5517\r\ntri nparts=128 BLOCK=32768 warps=32 t=0.4684\r\ntri nparts=264 BLOCK=16384 warps=8 t=0.4632\r\n"]
[1643.3011, "o", "tri nparts=264 BLOCK=16384 warps=16 t=0.4695\r\n"]
[1644.058134, "o", "tri nparts=264 BLOCK=16384 warps=32 t=0.4639\r\npart only 128/32768/16w: 0.09990400075912476\r\nnorm only 128/32768/16w: 0.4551999866962433\r\nfused maxdiff 3.933906555175781e-06\r\n"]
[1644.832547, "o", "fused nparts=132 BLOCK=32768 warps=8 t=0.6613\r\nfused nparts=132 BLOCK=32768 warps=16 t=0.5904\r\nfused nparts=128 BLOCK=32768 warps=8 t=0.6578\r\n"]
[1645.590048, "o", "fused nparts=128 BLOCK=32768 warps=16 t=0.5881\r\n"]
[1714.216625, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl, torch.nn as nn\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nx = torch.rand(B,F,D1,D2, device='cuda')\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nx2 = x.view(B,N)\ny2 = torch.empty_like(x2)\n\ndef timeit(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef part_kernel(X, P1, P2, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    m = offs < N\n    xv = tl.load(X + row*N + offs, mask=m, other=0.0)\n    npg = tl.num_programs(0)\n    tl.store(P1 + row*npg + pid, tl.sum(xv))\n    tl.store(P2 + row*npg + pid, tl.sum(xv*xv))\n\n@triton.jit\ndef stat"]
[1714.216685, "i", "s_kernel(P1, P2, M, R, N, eps, NP2: tl.constexpr):\n    row = tl.program_id(0)\n    idx = tl.arange(0, NP2)\n    NP = tl.num_programs(0) # unused\n    pm = idx < tl.num_programs(0)\n    s1 = tl.sum(tl.load(P1 + row*NP2 + idx, mask=pm, other=0.0))\n    s2 = tl.sum(tl.load(P2 + row*NP2 + idx, mask=pm, other=0.0))\n    mean = s1/N\n    var = s2/N - mean*mean\n    tl.store(M + row, mean)\n    tl.store(R + row, 1.0/tl.sqrt(var+eps))\n\n@triton.jit\ndef norm_kernel2(X, M, R, Y, W, B, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    m = offs < N\n    xo = row*N + offs\n    xv = tl.load(X + xo, mask=m, other=0.0)\n    wv = tl.load(W + offs, mask=m, other=0.0)\n    bv = tl.load(B + offs, mask=m, other=0.0)\n    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\n\ndef tri_ln3(x2, w, b, nparts, PBLOCK, NBLOCK, pwarps=32, nwarps=8):\n    B_, N_ = x2.shape\n    P1 = torch.empty(B_, nparts, device=x2.d"]
[1714.21684, "o", "cat > /workspace/bench3.py << 'EOF'\r\nimport torch, triton, triton.language as tl, torch.nn as nn\r\n\r\nB,F,D1,D2 = 16,64,256,256\r\nN = F*D1*D2\r\nx = torch.rand(B,F,D1,D2, device='cuda')\r\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\r\nx2 = x.view(B,N)\r\ny2 = torch.empty_like(x2)\r\n\r\ndef timeit(fn, n=30):\r\n    for _ in range(10): fn()\r\n    torch.cuda.synchronize()\r\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\r\n    ts=[]\r\n    for _ in range(n):\r\n        torch.cuda.synchronize()\r\n        s.record(); fn(); e.record()\r\n        torch.cuda.synchronize()\r\n        ts.append(s.elapsed_time(e))\r\n    ts.sort()\r\n    return ts[len(ts)//2]\r\n\r\n@triton.jit\r\ndef part_kernel(X, P1, P2, N, BLOCK: tl.constexpr):\r\n    pid = tl.program_i"]
[1714.216882, "i", "evice)\n    P2 = torch.empty(B_, nparts, device=x2.device)\n    M = torch.empty(B_, device=x2.device)\n    R = torch.empty(B_, device=x2.device)\n    Y = torch.empty_like(x2)\n    NP2 = 1 << (nparts-1).bit_length()\n    part_kernel[(nparts, B_)](x2, P1, P2, N_, BLOCK=PBLOCK, num_warps=pwarps)\n    stats_kernel[(B_,)](P1, P2, M, R, N_, 1e-5, NP2=NP2, num_warps=1)\n    ngrid = (N_ + NBLOCK - 1)//NBLOCK\n    norm_kernel2[(ngrid, B_)](x2, M, R, Y, w, b, N_, BLOCK=NBLOCK, num_warps=nwarps)\n    return Y\n\noutref = torch.nn.functional.layer_norm(x, (F,D1,D2), w.view(F,D1,D2), b.view(F,D1,D2), 1e-5)\nY = tri_ln3(x2, w, b, 128, 32768, 8192)\nprint('maxdiff', (Y.view_as(x)-outref).abs().max().item(), flush=True)\n\nfor nparts,PBLOCK in ((128,32768),(264,16384)):\n    for NBLOCK in (4096, 8192, 16384, 32768):\n        for nwarps in (4, 8, 16):\n            t = timeit(lambda: tri_ln3(x2, w, b, nparts, PBLOCK, NBLOCK, 32, nwarps))\n            print(f'nparts={nparts} PB={PBLOCK} NB={NBLOCK} nw={nwarps} t={t:.4f}', flush=True)\nEOF\n"]
