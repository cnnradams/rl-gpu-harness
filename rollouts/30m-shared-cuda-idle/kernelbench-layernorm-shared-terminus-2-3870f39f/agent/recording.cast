[1492.126001, "o", "> "]
[1492.12608, "o", "    xv = tl.load(X + xo, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1492.126118, "o", "\u001b[?2004h> "]
[1492.126213, "o", "    wv = tl.load(W + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1492.126249, "o", "\u001b[?2004h> "]
[1492.126345, "o", "    bv = tl.load(B + offs, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[1492.126384, "o", "\u001b[?2004h> "]
[1492.126493, "o", "    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\r\n\u001b[?2004l\r"]
[1492.126536, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1492.126575, "o", "> "]
[1492.12666, "o", "def tri_ln(x2, w, b, nparts, BLOCK, warps=32):\r\n\u001b[?2004l\r"]
[1492.126695, "o", "\u001b[?2004h> "]
[1492.126741, "o", "    B_, N_ = x2.shape\r\n\u001b[?2004l\r"]
[1492.126779, "o", "\u001b[?2004h> "]
