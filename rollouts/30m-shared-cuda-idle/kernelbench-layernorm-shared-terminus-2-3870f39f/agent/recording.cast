[1632.930509, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl, torch.nn as nn\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nx = torch.rand(B,F,D1,D2, device='cuda')\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nx2 = x.view(B,N)\ny2 = torch.empty_like(x2)\n\ndef timeit(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef copy_kernel(X, Y, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    m = offs < N\n    xo = row*N + offs\n    xv = tl.load(X + xo, mask=m, other=0.0)\n    tl.store(Y + xo, xv, mask=m)\n\nfor nparts in (128, 264):\n    for warps in (16, 32):\n        BLOCK = 32768 if nparts<=128 else 16384\n "]
[1632.930562, "i", "       t = timeit(lambda: copy_kernel[(nparts,B)](x2, y2, N, BLOCK=BLOCK, num_warps=warps))\n        print(f'copy nparts={nparts} BLOCK={BLOCK} warps={warps} t={t:.4f}', flush=True)\n\n@triton.jit\ndef part_kernel(X, P1, P2, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    m = offs < N\n    xv = tl.load(X + row*N + offs, mask=m, other=0.0)\n    npg = tl.num_programs(0)\n    tl.store(P1 + row*npg + pid, tl.sum(xv))\n    tl.store(P2 + row*npg + pid, tl.sum(xv*xv))\n\n@triton.jit\ndef norm_kernel(X, P1, P2, Y, W, B, N, NP, NP2: tl.constexpr, eps, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    idx = tl.arange(0, NP2)\n    pm = idx < NP\n    s1 = tl.sum(tl.load(P1 + row*NP + idx, mask=pm, other=0.0))\n    s2 = tl.sum(tl.load(P2 + row*NP + idx, mask=pm, other=0.0))\n    mean = s1/N\n    var = s2/N - mean*mean\n    rstd = 1.0/tl.sqrt(var + eps)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    m = offs"]
[1632.930572, "i", " < N\n    xo = row*N + offs\n    xv = tl.load(X + xo, mask=m, other=0.0)\n    wv = tl.load(W + offs, mask=m, other=0.0)\n    bv = tl.load(B + offs, mask=m, other=0.0)\n    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\n\ndef tri_ln(x2, w, b, nparts, BLOCK, warps=32):\n    B_, N_ = x2.shape\n    P1 = torch.empty(B_, nparts, device=x2.device)\n    P2 = torch.empty(B_, nparts, device=x2.device)\n    Y = torch.empty_like(x2)\n    NP2 = 1 << (nparts-1).bit_length()\n    part_kernel[(nparts, B_)](x2, P1, P2, N_, BLOCK=BLOCK, num_warps=warps)\n    norm_kernel[(nparts, B_)](x2, P1, P2, Y, w, b, N_, nparts, NP2=NP2, eps=1e-5, BLOCK=BLOCK, num_warps=warps)\n    return Y\n\nfor nparts, BLOCK in ((128,32768),(264,16384)):\n    for warps in (8,16,32):\n        t = timeit(lambda: tri_ln(x2, w, b, nparts, BLOCK, warps))\n        print(f'tri nparts={nparts} BLOCK={BLOCK} warps={warps} t={t:.4f}', flush=True)\n\n# separate timings\nP1 = torch.empty(B,128, device='cuda'); P2 = torch.empty(B,128, device='cuda')\nt1 = timeit(lambda: part_kernel[(128"]
[1632.930586, "i", ",B)](x2, P1, P2, N, BLOCK=32768, num_warps=16))\nprint('part only 128/32768/16w:', t1, flush=True)\nt2 = timeit(lambda: norm_kernel[(128,B)](x2, P1, P2, y2, w, b, N, 128, NP2=128, eps=1e-5, BLOCK=32768, num_warps=16))\nprint('norm only 128/32768/16w:', t2, flush=True)\n\n# fused spin-barrier single pass\n@triton.jit\ndef fused_kernel(X, Y, W, B, S1, S2, CNT, N, NP, eps, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    m = offs < N\n    xo = row*N + offs\n    xv = tl.load(X + xo, mask=m, other=0.0, eviction_policy='evict_last')\n    tl.atomic_add(S1 + row, tl.sum(xv), sem='acq_rel')\n    tl.atomic_add(S2 + row, tl.sum(xv*xv), sem='acq_rel')\n    tl.atomic_add(CNT + row, 1, sem='acq_rel')\n    c = 0\n    while c < NP:\n        c = tl.atomic_add(CNT + row, 0, sem='acq_rel')\n    s1 = tl.atomic_add(S1 + row, 0.0, sem='acq_rel')\n    s2 = tl.atomic_add(S2 + row, 0.0, sem='acq_rel')\n    mean = s1/N\n    var = s2/N - mean*mean\n    rstd = 1.0/tl.sqr"]
[1632.930735, "i", "t(var + eps)\n    wv = tl.load(W + offs, mask=m, other=0.0)\n    bv = tl.load(B + offs, mask=m, other=0.0)\n    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\n\ndef fused_ln(x2, w, b, nparts, BLOCK, warps=16):\n    B_, N_ = x2.shape\n    S1 = torch.zeros(B_, device=x2.device)\n    S2 = torch.zeros(B_, device=x2.device)\n    CNT = torch.zeros(B_, device=x2.device, dtype=torch.int32)\n    Y = torch.empty_like(x2)\n    fused_kernel[(nparts, B_)](x2, Y, w, b, S1, S2, CNT, N_, nparts, 1e-5, BLOCK=BLOCK, num_warps=warps)\n    return Y\n\noutref = torch.nn.functional.layer_norm(x, (F,D1,D2), w.view(F,D1,D2), b.view(F,D1,D2), 1e-5)\nY = fused_ln(x2, w, b, 132, 32768, 16)\nprint('fused maxdiff', (Y.view_as(x)-outref).abs().max().item(), flush=True)\nfor nparts, BLOCK in ((132,32768),(128,32768),(264,16384)):\n    for warps in (8,16):\n        t = timeit(lambda: fused_ln(x2, w, b, nparts, BLOCK, warps))\n        print(f'fused nparts={nparts} BLOCK={BLOCK} warps={warps} t={t:.4f}', flush=True)\nEOF\n"]
