[1492.127493, "o", "\u001b[?2004h> "]
[1492.127771, "o", "    norm_kernel[(nparts, B_)](x2, P1, P2, Y, w, b, N_, nparts, NP2=NP2, eps=1e-5, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
