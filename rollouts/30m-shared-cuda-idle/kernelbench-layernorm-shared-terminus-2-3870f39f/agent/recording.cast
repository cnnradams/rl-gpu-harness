[1422.941454, "i", "python3 - << 'EOF'\nimport re\ns = open('/workspace/bench.py').read()\ns = s.replace(\"    offs = pid*BLOCK + tl.arange(0, BLOCK)\\n    xv = tl.load(X + row*N + offs)\\n    npg\",\n\"    offs = pid*BLOCK + tl.arange(0, BLOCK)\\n    m = offs < N\\n    xv = tl.load(X + row*N + offs, mask=m, other=0.0)\\n    npg\")\ns = s.replace(\"    offs = pid*BLOCK + tl.arange(0, BLOCK)\\n    xo = row*N + offs\\n    xv = tl.load(X + xo)\\n    wv = tl.load(W + offs)\\n    bv = tl.load(B + offs)\\n    tl.store(Y + xo, (xv-mean)*rstd*wv + bv)\",\n\"    offs = pid*BLOCK + tl.arange(0, BLOCK)\\n    m = offs < N\\n    xo = row*N + offs\\n    xv = tl.load(X + xo, mask=m, other=0.0)\\n    wv = tl.load(W + offs, mask=m, other=0.0)\\n    bv = tl.load(B + offs, mask=m, other=0.0)\\n    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)\")\nopen('/workspace/bench.py','w').write(s)\nEOF\n"]
