[317.27616, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl, torch.nn as nn\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nx = torch.rand(B,F,D1,D2, device='cuda')\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\nx2 = x.view(B,N)\n\ndef timeit(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nref = nn.LayerNorm((F,D1,D2)).cuda()\nprint('native', timeit(lambda: ref(x)))\n\n@triton.jit\ndef part_kernel(X, P1, P2, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    xv = tl.load(X + row*N + offs)\n    npg = tl.num_programs(0)\n    tl.store(P1 + row*npg + pid, tl.sum(xv))\n    tl.store(P2 + row*npg + pid, tl.sum(xv*xv))\n\n@trit"]
[317.276206, "i", "on.jit\ndef norm_kernel(X, P1, P2, Y, W, B, N, NP: tl.constexpr, eps, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    row = tl.program_id(1)\n    idx = tl.arange(0, NP)\n    s1 = tl.sum(tl.load(P1 + row*NP + idx))\n    s2 = tl.sum(tl.load(P2 + row*NP + idx))\n    mean = s1/N\n    var = s2/N - mean*mean\n    rstd = 1.0/tl.sqrt(var + eps)\n    offs = pid*BLOCK + tl.arange(0, BLOCK)\n    xo = row*N + offs\n    xv = tl.load(X + xo)\n    wv = tl.load(W + offs)\n    bv = tl.load(B + offs)\n    tl.store(Y + xo, (xv-mean)*rstd*wv + bv)\n\ndef tri_ln(x2, w, b, nparts, BLOCK):\n    B_, N_ = x2.shape\n    P1 = torch.empty(B_, nparts, device=x2.device)\n    P2 = torch.empty(B_, nparts, device=x2.device)\n    Y = torch.empty_like(x2)\n    part_kernel[(nparts, B_)](x2, P1, P2, N_, BLOCK=BLOCK, num_warps=32)\n    norm_kernel[(nparts, B_)](x2, P1, P2, Y, w, b, N_, NP=nparts, eps=1e-5, BLOCK=BLOCK, num_warps=32)\n    return Y\n\noutref = torch.nn.functional.layer_norm(x, (F,D1,D2), w, b, 1e-5)\nY = tri_ln(x2, w, b, 66, 65536)\nprint("]
[317.276342, "i", "'maxdiff', (Y.view_as(x)-outref).abs().max().item())\n\nfor nparts in (33, 66, 132, 264):\n    for BLOCK in (16384, 32768, 65536):\n        if nparts*BLOCK < N: continue\n        t = timeit(lambda: tri_ln(x2, w, b, nparts, BLOCK))\n        print(f'nparts={nparts} BLOCK={BLOCK} t={t:.4f} ms')\nEOF\n"]
