[1354.432956, "o", "\u001b[?2004h> "]
[1354.43302, "o", "    idx = tl.arange(0, NP2)\r\n\u001b[?2004l\r"]
[1354.433042, "o", "\u001b[?2004h> "]
[1354.433091, "o", "    pm = idx < NP\r\n\u001b[?2004l\r"]
[1354.433113, "o", "\u001b[?2004h"]
[1354.433133, "o", "> "]
[1354.433263, "o", "    s1 = tl.sum(tl.load(P1 + row*NP + idx, mask=pm, other=0.0))\r\n\u001b[?2004l\r"]
[1354.433287, "o", "\u001b[?2004h> "]
[1354.433438, "o", "    s2 = tl.sum(tl.load(P2 + row*NP + idx, mask=pm, other=0.0))\r\n\u001b[?2004l\r"]
[1354.433459, "o", "\u001b[?2004h> "]
[1354.433502, "o", "    mean = s1/N\r\n\u001b[?2004l\r"]
[1354.433533, "o", "\u001b[?2004h> "]
[1354.433591, "o", "    var = s2/N - mean*mean\r\n\u001b[?2004l\r"]
[1354.43361, "o", "\u001b[?2004h> "]
[1354.433693, "o", "    rstd = 1.0/tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1354.433723, "o", "\u001b[?2004h> "]
[1354.433818, "o", "    offs = pid*BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1354.433849, "o", "\u001b[?2004h> "]
[1354.433894, "o", "    xo = row*N + offs\r\n\u001b[?2004l\r"]
[1354.433915, "o", "\u001b[?2004h> "]
[1354.433978, "o", "    xv = tl.load(X + xo)\r\n\u001b[?2004l\r"]
[1354.433997, "o", "\u001b[?2004h> "]
[1354.434062, "o", "    wv = tl.load(W + offs)\r\n\u001b[?2004l\r"]
[1354.434093, "o", "\u001b[?2004h> "]
[1354.434148, "o", "    bv = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[1354.434166, "o", "\u001b[?2004h> "]
[1354.434291, "o", "    tl.store(Y + xo, (xv-mean)*rstd*wv + bv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1354.434319, "o", "\u001b[?2004h> "]
[1354.434345, "o", "import math\r\n\u001b[?2004l\r"]
[1354.434377, "o", "\u001b[?2004h> "]
[1354.434491, "o", "def tri_ln(x2, w, b, nparts, BLOCK, warps=32):\r\n\u001b[?2004l\r"]
[1354.434512, "o", "\u001b[?2004h> "]
[1354.434567, "o", "    B_, N_ = x2.shape\r\n\u001b[?2004l\r"]
[1354.434584, "o", "\u001b[?2004h"]
[1354.434605, "o", "> "]
[1354.434711, "o", "    P1 = torch.empty(B_, nparts, device=x2.device)\r\n\u001b[?2004l\r"]
[1354.434731, "o", "\u001b[?2004h> "]
[1354.43485, "o", "    P2 = torch.empty(B_, nparts, device=x2.device)\r\n\u001b[?2004l\r"]
[1354.43488, "o", "\u001b[?2004h> "]
[1354.434942, "o", "    Y = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[1354.434958, "o", "\u001b[?2004h"]
[1354.434976, "o", "> "]
[1354.435058, "o", "    NP2 = 1 << (nparts-1).bit_length()\r\n\u001b[?2004l\r"]
[1354.43509, "o", "\u001b[?2004h> "]
[1354.435254, "o", "    part_kernel[(nparts, B_)](x2, P1, P2, N_, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[1354.435275, "o", "\u001b[?2004h> "]
[1354.435561, "o", "    norm_kernel[(nparts, B_)](x2, P1, P2, Y, w, b, N_, nparts, NP2=NP2, eps=1e-5, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1354.43559, "o", "> "]
[1354.435616, "o", "    return Y\r\n\u001b[?2004l\r"]
[1354.435648, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1354.435673, "o", "\u001b[?2004h> "]
[1354.435883, "o", "outref = torch.nn.functional.layer_norm(x, (F,D1,D2), w.view(F,D1,D2), b.view(F,D1,D2), 1e-5)\r\n\u001b[?2004l\r"]
[1354.435906, "o", "\u001b[?2004h> "]
[1354.43598, "o", "Y = tri_ln(x2, w, b, 66, 65536)\r\n\u001b[?2004l\r"]
[1354.436, "o", "\u001b[?2004h> "]
[1354.43614, "o", "print('maxdiff', (Y.view_as(x)-outref).abs().max().item())\r\n\u001b[?2004l\r"]
[1354.436161, "o", "\u001b[?2004h> \r\n"]
[1354.436181, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1354.436201, "o", "> "]
[1354.436291, "o", "for nparts in (32, 66, 128, 264, 512):\r\n\u001b[?2004l\r"]
[1354.436312, "o", "\u001b[?2004h> "]
[1354.436434, "o", "    for BLOCK in (8192, 16384, 32768, 65536):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1354.436462, "o", "> "]
[1354.436538, "o", "        if nparts*BLOCK < N: continue\r\n\u001b[?2004l\r"]
[1354.436568, "o", "\u001b[?2004h> "]
[1354.436706, "o", "        t = timeit(lambda: tri_ln(x2, w, b, nparts, BLOCK))\r\n\u001b[?2004l\r"]
[1354.436736, "o", "\u001b[?2004h> "]
[1354.436901, "o", "        print(f'nparts={nparts} BLOCK={BLOCK} t={t:.4f} ms', flush=True)\r\n\u001b[?2004l\r"]
[1354.436922, "o", "\u001b[?2004h> "]
[1354.436941, "o", "EOF\r\n\u001b[?2004l\r"]
