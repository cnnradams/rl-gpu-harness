[1492.128811, "o", "\u001b[?2004h> "]
[1492.128943, "o", "        t = timeit(lambda: tri_ln(x2, w, b, nparts, BLOCK))\r\n\u001b[?2004l\r"]
[1492.128983, "o", "\u001b[?2004h> "]
