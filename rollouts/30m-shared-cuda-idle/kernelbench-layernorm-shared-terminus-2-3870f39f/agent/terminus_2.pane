import torch, triton, triton.language as tl, torch.nn as nn

B,F,D1,D2 = 16,64,256,256
N = F*D1*D2
x = torch.rand(B,F,D1,D2, device='cuda')
w = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')
x2 = x.view(B,N)
y2 = torch.empty_like(x2)

def timeit(fn, n=30):
    for _ in range(10): fn()
    torch.cuda.synchronize()
    s=torch.cuda.Event(True); e=torch.cuda.Event(True)
    ts=[]
    for _ in range(n):
        torch.cuda.synchronize()
        s.record(); fn(); e.record()
        torch.cuda.synchronize()
        ts.append(s.elapsed_time(e))
    ts.sort()
    return ts[len(ts)//2]

@triton.jit
def part_kernel(X, P1, P2, N, BLOCK: tl.constexpr):
    pid = tl.program_id(0).to(tl.int64)
    row = tl.program_id(1)
    offs = pid*BLOCK + tl.arange(0, BLOCK)
    m = offs < N
    xv = tl.load(X + row*N + offs, mask=m, other=0.0)
    npg = tl.num_programs(0)
    tl.store(P1 + row*npg + pid, tl.sum(xv))
    tl.store(P2 + row*npg + pid, tl.sum(xv*xv))

@triton.jit
def stats_kernel(P1, P2, M, R, N, eps, NP2: tl.constexpr):
    row = tl.program_id(0)
    idx = tl.arange(0, NP2)
    NP = tl.num_programs(0) # unused
    pm = idx < tl.num_programs(0)
    s1 = tl.sum(tl.load(P1 + row*NP2 + idx, mask=pm, other=0.0))
    s2 = tl.sum(tl.load(P2 + row*NP2 + idx, mask=pm, other=0.0))
    mean = s1/N
    var = s2/N - mean*mean
    tl.store(M + row, mean)
    tl.store(R + row, 1.0/tl.sqrt(var+eps))

@triton.jit
def norm_kernel2(X, M, R, Y, W, B, N, BLOCK: tl.constexpr):
    pid = tl.program_id(0).to(tl.int64)
    row = tl.program_id(1)
    mean = tl.load(M + row)
    rstd = tl.load(R + row)
    offs = pid*BLOCK + tl.arange(0, BLOCK)
    m = offs < N
    xo = row*N + offs
    xv = tl.load(X + xo, mask=m, other=0.0)
    wv = tl.load(W + offs, mask=m, other=0.0)
    bv = tl.load(B + offs, mask=m, other=0.0)
    tl.store(Y + xo, (xv-mean)*rstd*wv + bv, mask=m)

def tri_ln3(x2, w, b, nparts, PBLOCK, NBLOCK, pwarps=32, nwarps=8):
    B_, N_ = x2.shape
    P1 = torch.empty(B_, nparts, device=x2.device)
    P2 = torch.empty(B_, nparts, device=x2.device)
    M = torch.empty(B_, device=x2.device)
    R = torch.empty(B_, device=x2.device)
    Y = torch.empty_like(x2)
    NP2 = 1 << (nparts-1).bit_length()
    part_kernel[(nparts, B_)](x2, P1, P2, N_, BLOCK=PBLOCK, num_warps=pwarps)
    stats_kernel[(B_,)](P1, P2, M, R, N_, 1e-5, NP2=NP2, num_warps=1)
    ngrid = (N_ + NBLOCK - 1)//NBLOCK
    norm_kernel2[(ngrid, B_)](x2, M, R, Y, w, b, N_, BLOCK=NBLOCK, num_warps=nwarps)
    return Y

outref = torch.nn.functional.layer_norm(x, (F,D1,D2), w.view(F,D1,D2), b.view(F,D1,D2), 1e-5)
Y = tri_ln3(x2, w, b, 128, 32768, 8192)
print('maxdiff', (Y.view_as(x)-outref).abs().max().item(), flush=True)

for nparts,PBLOCK in ((128,32768),(264,16384)):
    for NBLOCK in (4096, 8192, 16384, 32768):
        for nwarps in (4, 8, 16):
            t = timeit(lambda: tri_ln3(x2, w, b, nparts, PBLOCK, NBLOCK, 32, nwarps))
            print(f'nparts={nparts} PB={PBLOCK} NB={NBLOCK} nw={nwarps} t={t:.4f}', flush=True)
