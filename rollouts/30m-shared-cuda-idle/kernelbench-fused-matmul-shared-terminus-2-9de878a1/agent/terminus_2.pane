[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.matmul = nn.Linear(in_features, out_features)
[?2004l[?2004h>         self.scaling_factor = scaling_factor
[?2004l[?2004h> 
[?2004l[?2004h>     def _prepare(self, w, b):
[?2004l[?2004h>         key = (w.data_ptr(), b.data_ptr(), w.device)
[?2004l[?2004h>         ent = getattr(self, '_prep', None)
[?2004l[?2004h>         if ent is not None and ent[0] == key:
[?2004l[?2004h>             return ent[1], ent[2], ent[3]
[?2004l[?2004h>         s = self.scaling_factor + 1.0
[?2004l[?2004h>         wt = (w * s).t().contiguous()
[?2004l[?2004h>         bh = wt.half()
[?2004l[?2004h>         bl = (wt - bh.float()).half()
[?2004l[?2004h>         bias = (b * s).contiguous()
