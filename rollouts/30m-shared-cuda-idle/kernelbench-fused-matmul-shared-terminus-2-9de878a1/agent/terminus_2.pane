[?2004l[?2004h> import torch, triton, triton.language as tl, itertools
[?2004ly(M, N, device='cuda', dtype=torch.float32)
results = []

def bench(fn, tag):
    fn(); torch.cuda.synchronize()
    err = (out - ref).abs().max().item()
    ts = []
    e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)
    for _ in range(15):
        torch.cuda.synchronize()
        e1.record(); fn(); e2.record(); torch.cuda.synchronize()
        ts.append(e1.elapsed_time(e2))
    ts.sort()
    med = ts[len(ts)//2]
    print(f'{med:.3f}ms {tag} err={err:.2e}')
    results.append((med, tag))

for BM, BN, BK, G, wps, st in itertools.product([64,128],[64,128,256],[32,64],[4,8],[4,8],[3,4,6]):
    if BM*BN*BK == 0: continue
    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)
    try:
        fn = lambda: k1[grid](x, bh, bl, bias, out, M, N, K,
            x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),
            out.stride(0), out.stride(1), BM, BN, BK, G, num_warps=wps, num_stages=st)
        bench(fn, f'k1 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}')
    except Exception as ex:
        print(f'FAIL k1 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}: {type(ex).__name__}')

