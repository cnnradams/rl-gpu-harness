class ModelNew(nn.Module):
    def __init__(self, in_features, out_features, scaling_factor):
        super().__init__()
        self.matmul = nn.Linear(in_features, out_features)
        self.scaling_factor = scaling_factor

    def _prepare(self):
        w = self.matmul.weight
        b = self.matmul.bias
        key = (w.data_ptr(), b.data_ptr())
        ent = getattr(self, '_prep', None)
        if ent is not None and ent[0] == key:
            return ent[1], ent[2], ent[3], ent[4], ent[5]
        s = self.scaling_factor + 1.0
        wt = (w * s).t().contiguous()
        bh, bl = _split_fp16(wt)
        bias = (b * s).contiguous()
        self._prep = (key, bh, bl, bias, wt, None)
        return bh, bl, bias, wt, None

    def forward(self, x):
        w = self.matmul.weight
        b = self.matmul.bias
        s = self.scaling_factor + 1.0
        if not x.is_cuda:
            return (x @ w.t() + b) * s
        M, K = x.shape
        N = w.shape[0]
        bh, bl, bias, wt, _ = self._prepare()
        xh = x.half()
        xl = (x - xh.float()).half()
        xh = xh.contiguous()
        xl = xl.contiguous()
        out = torch.empty((M, N), device=x.device, dtype=torch.float32)
        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)
        _mm3_kernel[grid](
            xh, xl, bh, bl, out,
            M, N, K,
            xh.stride(0), xh.stride(1),
            bh.stride(0), bh.stride(1),
            out.stride(0), out.stride(1),
        )
        out += bias
        return out
