[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.autotune(
[?2004l[?2004h>     configs=[
[?2004l[?2004h>         triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=4),
[?2004l[?2004h>         triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=4),
[?2004l[?2004h>         triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=4),
[?2004l[?2004h>         triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP': 8}, num_warps=4, num_stages=4),
[?2004l[?2004h>         triton.Config({'BM': 256, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=3),
[?2004l[?2004h>         triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP': 8}, num_warps=8, num_stages=4),
[?2004l[?2004h>     ],
[?2004l[?2004h>     key=['M', 'N', 'K'],
[?2004l[?2004h> )
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _mm3f_kernel(
[?2004l[?2004h>     A, BH, BL, BIAS, C,
[?2004l[?2004h>     M, N, K,
[?2004l[?2004h>     sam, sak, sbn, sbk, scm, scn,
[?2004l[?2004h>     BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,
[?2004l[?2004h> ):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GROUP * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)
[?2004l[?2004h>     pid_m = group_id * GROUP + ((pid % width) % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h> 
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     rn = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     rk = tl.arange(0, BK)
[?2004l[?2004h> 
[?2004l[?2004h>     a_ptr = A + rm[:, None] * sam + rk[None, :] * sak
[?2004l[?2004h>     bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk
[?2004l[?2004h>     bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk
[?2004l[?2004h> 
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, K, BK):
