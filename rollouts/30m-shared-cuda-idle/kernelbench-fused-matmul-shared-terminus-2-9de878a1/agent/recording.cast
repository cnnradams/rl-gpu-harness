[586.059832, "i", "cat > /workspace/diag.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nw = torch.randn(N, K, device='cuda') * (K ** -0.5)\nb = torch.randn(N, device='cuda') * (K ** -0.5)\nx = torch.rand(M, K, device='cuda')\ns = 1.5\nref = (torch.nn.functional.linear(x, w, b)) * s\nwt = (w * s).t().contiguous()\nbias = b * s\nxh = x.half(); xl = (x - xh.float()).half()\nbh = wt.half(); bl = (wt - bh.float()).half()\nemu = (xh.float() @ bh.float() + xh.float() @ bl.float() + xl.float() @ bh.float()) + bias\nd = (ref - emu).abs()\nprint('emulation: max', d.max().item(), 'avg', d.mean().item())\n# half-precision single dot error (no split)\nemu1 = (xh.float() @ bh.float()) + bias\nd1 = (ref - emu1).abs()\nprint('hi-only: max', d1.max().item(), 'avg', d1.mean().item())\n# now the triton kernel\nfrom solution import _mm3_kernel\nimport triton\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\ngrid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n_mm3"]
[586.06, "i", "_kernel[grid](xh.contiguous(), xl.contiguous(), bh, bl, out, M, N, K,\n    xh.stride(0), xh.stride(1), bh.stride(0), bh.stride(1), out.stride(0), out.stride(1))\nd2 = (emu - bias - out).abs()\nprint('kernel vs emu(nobias): max', d2.max().item(), 'avg', d2.mean().item())\nd3 = (ref - (out + bias)).abs()\nprint('kernel+bias vs ref: max', d3.max().item(), 'avg', d3.mean().item())\nEOF\n"]
[586.060163, "o", "cat > /workspace/diag.py << 'EOF'\r\n\u001b[?2004l\r_kernel[grid](xh.contiguous(), xl.contiguous(), bh, bl, out, M, N, K,\r\n    xh.stride(0), xh.stride(1), bh.stride(0), bh.stride(1), out.stride(0), out.stride(1))\r\nd2 = (emu - bias - out).abs()\r\nprint('kernel vs emu(nobias): max', d2.max().item(), 'avg', d2.mean().item())\r\nd3 = (ref - (out + bias)).abs()\r\nprint('kernel+bias vs ref: max', d3.max().item(), 'avg', d3.mean().item())\r\nEOF\r\n\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
