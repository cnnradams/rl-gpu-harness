[1400.216635, "o", "    a_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1400.216661, "o", "\u001b[?2004h> "]
[1400.216792, "o", "    bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r"]
[1400.216818, "o", "\u001b[?2004h> "]
[1400.216964, "o", "    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r"]
[1400.216991, "o", "\u001b[?2004h> "]
[1400.217041, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1400.21707, "o", "\u001b[?2004h> "]
[1400.2171, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1400.217129, "o", "\u001b[?2004h> "]
[1400.217154, "o", "        a = tl.load(a_ptr)\r\n\u001b[?2004l\r"]
[1400.217177, "o", "\u001b[?2004h> "]
[1400.217214, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1400.217242, "o", "\u001b[?2004h> "]
[1400.217298, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1400.217326, "o", "\u001b[?2004h> "]
[1400.217356, "o", "        bh = tl.load(bh_ptr)\r\n\u001b[?2004l\r"]
[1400.217384, "o", "\u001b[?2004h> "]
[1400.217414, "o", "        bl = tl.load(bl_ptr)\r\n\u001b[?2004l\r"]
[1400.217444, "o", "\u001b[?2004h> "]
[1400.217476, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.217504, "o", "> "]
[1400.217531, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[1400.217557, "o", "\u001b[?2004h> "]
[1400.217619, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.217648, "o", "> "]
[1400.217705, "o", "        a_ptr += BK * sak; bh_ptr += BK * sbk; bl_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[1400.21773, "o", "\u001b[?2004h> "]
[1400.217759, "o", "    bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[1400.217782, "o", "\u001b[?2004h> "]
[1400.217814, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1400.217838, "o", "\u001b[?2004h> "]
[1400.217904, "o", "    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\r\n\u001b[?2004l\r"]
[1400.217935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.217963, "o", "> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.218052, "o", "def k2(AH, AL, BH, BL, BIAS, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\r\n\u001b[?2004l\r"]
[1400.218077, "o", "\u001b[?2004h> "]
[1400.218167, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1400.218196, "o", "\u001b[?2004h> "]
[1400.218219, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1400.218242, "o", "\u001b[?2004h> "]
[1400.218296, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.218324, "o", "> "]
[1400.218352, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.21839, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1400.218417, "o", "\u001b[?2004h> "]
[1400.218477, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[1400.2185, "o", "\u001b[?2004h> "]
[1400.218564, "o", "    pid_m = group_id * GROUP + ((pid % width) % group_size)\r\n\u001b[?2004l\r"]
[1400.218597, "o", "\u001b[?2004h> "]
[1400.218624, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1400.218655, "o", "\u001b[?2004h> "]
[1400.218689, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1400.218714, "o", "\u001b[?2004h> "]
[1400.218754, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.218783, "o", "> "]
[1400.218812, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.218876, "o", "    ah_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.218904, "o", "> "]
[1400.218953, "o", "    al_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.218982, "o", "> "]
[1400.219031, "o", "    bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.219061, "o", "> "]
[1400.219116, "o", "    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.219143, "o", "> "]
[1400.219184, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1400.219209, "o", "\u001b[?2004h> "]
[1400.219236, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1400.219261, "o", "\u001b[?2004h> "]
[1400.219315, "o", "        ah = tl.load(ah_ptr); al = tl.load(al_ptr)\r\n\u001b[?2004l\r"]
[1400.219344, "o", "\u001b[?2004h> "]
[1400.219389, "o", "        bh = tl.load(bh_ptr); bl = tl.load(bl_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.219416, "o", "> "]
[1400.219445, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[1400.219473, "o", "\u001b[?2004h> "]
[1400.219504, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[1400.219533, "o", "\u001b[?2004h> "]
[1400.219564, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[1400.219592, "o", "\u001b[?2004h> "]
[1400.219677, "o", "        ah_ptr += BK * sak; al_ptr += BK * sak; bh_ptr += BK * sbk; bl_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[1400.219706, "o", "\u001b[?2004h> "]
[1400.21973, "o", "    bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[1400.219757, "o", "\u001b[?2004h> "]
[1400.219786, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1400.219815, "o", "\u001b[?2004h> "]
[1400.219872, "o", "    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\r\n\u001b[?2004l\r"]
[1400.219901, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.219929, "o", "> "]
[1400.219953, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.219986, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[1400.220015, "o", "\u001b[?2004h> "]
[1400.220047, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[1400.220077, "o", "\u001b[?2004h> "]
[1400.220129, "o", "w = torch.randn(N, K, device='cuda') * K**-0.5\r\n\u001b[?2004l\r"]
[1400.220157, "o", "\u001b[?2004h> "]
[1400.220201, "o", "b = torch.randn(N, device='cuda') * K**-0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.220225, "o", "> s = 1.5\r\n\u001b[?2004l\r"]
[1400.220251, "o", "\u001b[?2004h> "]
[1400.2203, "o", "ref = torch.nn.functional.linear(x, w, b) * s\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.220327, "o", "> "]
[1400.220351, "o", "wt = (w * s).t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.220376, "o", "> "]
[1400.220423, "o", "bh = wt.half(); bl = (wt - bh.float()).half()\r\n\u001b[?2004l\r"]
[1400.220447, "o", "\u001b[?2004h> "]
[1400.220494, "o", "xh = x.half(); xl = (x - xh.float()).half()\r\n\u001b[?2004l\r"]
[1400.220518, "o", "\u001b[?2004h> "]
[1400.220561, "o", "xh = xh.contiguous(); xl = xl.contiguous()\r\n\u001b[?2004l\r"]
[1400.220585, "o", "\u001b[?2004h> "]
[1400.220613, "o", "bias = (b * s).contiguous()\r\n\u001b[?2004l\r"]
[1400.220637, "o", "\u001b[?2004h> "]
[1400.220699, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1400.220723, "o", "\u001b[?2004h> "]
[1400.220748, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1400.220772, "o", "\u001b[?2004h> "]
[1400.220801, "o", "def bench(fn, tag):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.220826, "o", "> "]
[1400.220854, "o", "    fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1400.220878, "o", "\u001b[?2004h> "]
[1400.220917, "o", "    err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1400.220941, "o", "\u001b[?2004h> "]
[1400.22097, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.221038, "o", "    e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.221064, "o", "> "]
[1400.221092, "o", "    for _ in range(15):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.221116, "o", "> "]
[1400.221145, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1400.221173, "o", "\u001b[?2004h> "]
[1400.221236, "o", "        e1.record(); fn(); e2.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1400.221265, "o", "\u001b[?2004h> "]
[1400.221301, "o", "        ts.append(e1.elapsed_time(e2))\r\n\u001b[?2004l\r"]
[1400.22133, "o", "\u001b[?2004h> "]
[1400.221354, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.221384, "o", "    med = ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1400.221408, "o", "\u001b[?2004h> "]
[1400.221456, "o", "    print(f'{med:.3f}ms {tag} err={err:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.221484, "o", "> "]
[1400.221508, "o", "    results.append((med, tag))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.221537, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.221643, "o", "for BM, BN, BK, G, wps, st in itertools.product([64,128],[64,128,256],[32,64],[4,8],[4,8],[3,4,6]):\r\n\u001b[?2004l\r"]
[1400.221668, "o", "\u001b[?2004h> "]
[1400.221704, "o", "    if BM*BN*BK == 0: continue\r\n\u001b[?2004l\r"]
[1400.221734, "o", "\u001b[?2004h> "]
[1400.221785, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1400.221808, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1400.221837, "o", "\u001b[?2004h> "]
[1400.221897, "o", "        fn = lambda: k1[grid](x, bh, bl, bias, out, M, N, K,\r\n\u001b[?2004l\r"]
[1400.22192, "o", "\u001b[?2004h> "]
[1400.221991, "o", "            x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),\r\n\u001b[?2004l\r"]
[1400.222014, "o", "\u001b[?2004h> "]
[1400.222107, "o", "            out.stride(0), out.stride(1), BM, BN, BK, G, num_warps=wps, num_stages=st)\r\n\u001b[?2004l\r"]
[1400.222133, "o", "\u001b[?2004h> "]
[1400.222201, "o", "        bench(fn, f'k1 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}')\r\n\u001b[?2004l\r"]
[1400.222225, "o", "\u001b[?2004h> "]
[1400.222255, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1400.222278, "o", "\u001b[?2004h> "]
[1400.222375, "o", "        print(f'FAIL k1 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}: {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[1400.222399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1400.222422, "o", "\u001b[?2004h> "]
[1400.222521, "o", "for BM, BN, BK, G, wps, st in itertools.product([64,128],[128,256],[32,64],[8],[4,8],[3,4]):\r\n\u001b[?2004l\r"]
[1400.222547, "o", "\u001b[?2004h> "]
[1400.222592, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1400.222619, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1400.222643, "o", "\u001b[?2004h> "]
[1400.222716, "o", "        fn = lambda: k2[grid](xh, xl, bh, bl, bias, out, M, N, K,\r\n\u001b[?2004l\r"]
[1400.222745, "o", "\u001b[?2004h> "]
[1400.222809, "o", "            xh.stride(0), xh.stride(1), bh.stride(1), bh.stride(0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.222837, "o", "> "]
[1400.222918, "o", "            out.stride(0), out.stride(1), BM, BN, BK, G, num_warps=wps, num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.222946, "o", "> "]
[1400.223009, "o", "        bench(fn, f'k2 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}')\r\n\u001b[?2004l\r"]
[1400.223037, "o", "\u001b[?2004h> "]
[1400.223066, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1400.223097, "o", "\u001b[?2004h> "]
[1400.22319, "o", "        print(f'FAIL k2 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}: {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[1400.22322, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.223248, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1400.223273, "o", "> "]
[1400.223297, "o", "print('BEST:', results[:8])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1400.223322, "o", "EOF\r\n\u001b[?2004l\r"]
[1400.267108, "o", "\u001b[?2004hroot@modal:/# gpu sync && gpu refresh sb-kxeUzouFK4eb7AaeXmrmP2 && gpu exec sb-kxeUzouFK4eb7AaeXmrmP2 -- python3 /workspace/sweep2.py 2>&1 | tail -12\r\n\u001b[?2004l\r"]
