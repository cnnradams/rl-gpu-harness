[474.879671, "i", "python3 - << 'EOF'\nimport re\nsrc = open('/workspace/solution.py').read()\nold = \"\"\"    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\"\"\"\nnew = \"\"\"    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + ((pid % width) % group_size)\n    pid_n = (pid % width) // group_size\n\"\"\"\nassert old in src\nsrc = src.replace(old, new)\nopen('/workspace/solution.py','w').write(src)\nprint(\"patched\")\nEOF\n"]
