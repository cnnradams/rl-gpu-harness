[734.08755, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 3.82,\r\n  \"runtime_stats\": {\r\n    \"mean\": 3.82,\r\n    \"std\": 0.00157,\r\n    \"min\": 3.81,\r\n    \"max\": 3.82,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0373,\r\n    \"min\": 11.3,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"8dca5a0261507498b5c1eaf20c939e987be214bfbac19a1408942fb2edadda4e\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 2.9581151832460737\r\n}\r\n"]
