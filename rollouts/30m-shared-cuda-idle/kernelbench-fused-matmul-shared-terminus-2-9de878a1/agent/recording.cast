[936.175229, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, triton, triton.language as tl, itertools, time\n\n@triton.jit\ndef k1(A, BH, BL, BIAS, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr, SEP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + ((pid % width) % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk\n    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n       "]
[936.175276, "i", " a = tl.load(a_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptr)\n        bl = tl.load(bl_ptr)\n        if SEP:\n            acc = tl.dot(ah, bh, acc)\n            acc2 = tl.dot(ah, bl, acc2)\n            acc3 = tl.dot(al, bh, acc3)\n        else:\n            acc = tl.dot(ah, bh, acc)\n            acc = tl.dot(ah, bl, acc)\n            acc = tl.dot(al, bh, acc)\n        a_ptr += BK * sak; bh_ptr += BK * sbk; bl_ptr += BK * sbk\n    acc = acc + acc2 + acc3\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\ntorch.manual_seed(0)\nM = N = K = 16384, 4096, 4096\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * K**-0.5\nb = torch.randn(N, device='cuda') * K**-0.5\ns = 1.5\nref = torch.nn.functional.linear(x, w, b) * s\nwt = (w * s).t().contiguous()\nbh = wt.half(); bl = (wt - bh.float()).half()\nbias = (b * s).contiguous()\nout = torch.empty(M, N"]
[936.175502, "i", ", device='cuda', dtype=torch.float32)\nresults = []\nfor BM, BN, BK, G, wps, st, sep in itertools.product(\n    [64,128,256],[128,256],[32,64,128],[8],[4,8],[3,4,5],[True,False]):\n    if BM*BN > 256*256: continue\n    if BK > 64 and st > 3: continue\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: k1[grid](x, bh, bl, bias, out, M, N, K,\n            x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),\n            out.stride(0), out.stride(1), BM, BN, BK, G, sep, num_warps=wps, num_stages=st)\n        fn()\n        torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        ts = []\n        e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)\n        for _ in range(10):\n            torch.cuda.synchronize()\n            e1.record(); fn(); e2.record(); torch.cuda.synchronize()\n            ts.append(e1.elapsed_time(e2))\n        ts.sort()\n        med = ts[len(ts)//2]\n        results.append((med, BM, BN, BK, wps, st, sep, err))\n        print(f'{med:.3f}ms BM={BM} BN={BN} "]
[936.175554, "o", "cat > /workspace/sweep.py << 'EOF'\r\n\u001b[?2004l\r"]
[936.175596, "i", "BK={BK} warps={wps} stages={st} sep={sep} err={err:.2e}')\n    except Exception as ex:\n        print(f'FAIL BM={BM} BN={BN} BK={BK} warps={wps} stages={st} sep={sep}: {type(ex).__name__}')\nresults.sort()\nprint('BEST:', results[:5])\nEOF\ngpu sync && gpu refresh sb-kxeUzouFK4eb7AaeXmrmP2 && gpu exec sb-kxeUzouFK4eb7AaeXmrmP2 -- python3 /workspace/sweep.py 2>&1 | tail -30\n"]
