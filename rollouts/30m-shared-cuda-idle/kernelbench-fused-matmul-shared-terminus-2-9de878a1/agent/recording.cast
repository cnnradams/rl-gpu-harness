[1362.821891, "o", "3, False, 7.534027099609375e-05), (2.5385279655456543, 256, 128, 32, 8, 4, False, 7.534027099609375e-05), (2.5494399070739746, 256, 128, 32, 8, 3, False, 7.534027099609375e-05), (2.557919979095459, 256, 128, 32, 8, 5, False, 7.534027099609375e-05), (2.5637118816375732, 128, 128, 32, 8, 5, True, 3.528594970703125e-05)]\r\n\u001b[?2004hroot@modal:/# "]
[1400.214253, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch, triton, triton.language as tl, itertools\n\n@triton.jit\ndef k1(A, BH, BL, BIAS, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + ((pid % width) % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk\n    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(a_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.lo"]
[1400.214417, "i", "ad(bh_ptr)\n        bl = tl.load(bl_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        a_ptr += BK * sak; bh_ptr += BK * sbk; bl_ptr += BK * sbk\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\n@triton.jit\ndef k2(AH, AL, BH, BL, BIAS, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + ((pid % width) % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    ah_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\n    al_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptr = BH"]
[1400.214448, "o", "cat > /workspace/sweep2.py << 'EOF'\r\n\u001b[?2004l\r"]
[1400.214482, "i", " + rn[None, :] * sbn + rk[:, None] * sbk\n    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(ah_ptr); al = tl.load(al_ptr)\n        bh = tl.load(bh_ptr); bl = tl.load(bl_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        ah_ptr += BK * sak; al_ptr += BK * sak; bh_ptr += BK * sbk; bl_ptr += BK * sbk\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * K**-0.5\nb = torch.randn(N, device='cuda') * K**-0.5\ns = 1.5\nref = torch.nn.functional.linear(x, w, b) * s\nwt = (w * s).t().contiguous()\nbh = wt.half(); bl = (wt - bh.float()).half()\nxh = x.half(); xl = (x - xh.float()).half()\nxh = xh.contiguous(); xl = xl.contiguous()\nbias = (b * s).contiguous()\nout = torch.empt"]
[1400.214506, "o", "\u001b[?2004h> "]
[1400.21453, "i", "y(M, N, device='cuda', dtype=torch.float32)\nresults = []\n\ndef bench(fn, tag):\n    fn(); torch.cuda.synchronize()\n    err = (out - ref).abs().max().item()\n    ts = []\n    e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)\n    for _ in range(15):\n        torch.cuda.synchronize()\n        e1.record(); fn(); e2.record(); torch.cuda.synchronize()\n        ts.append(e1.elapsed_time(e2))\n    ts.sort()\n    med = ts[len(ts)//2]\n    print(f'{med:.3f}ms {tag} err={err:.2e}')\n    results.append((med, tag))\n\nfor BM, BN, BK, G, wps, st in itertools.product([64,128],[64,128,256],[32,64],[4,8],[4,8],[3,4,6]):\n    if BM*BN*BK == 0: continue\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: k1[grid](x, bh, bl, bias, out, M, N, K,\n            x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),\n            out.stride(0), out.stride(1), BM, BN, BK, G, num_warps=wps, num_stages=st)\n        bench(fn, f'k1 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}')\n    except Exception as ex:\n        print(f'FA"]
[1400.21455, "o", "import torch, triton, triton.language as tl, itertools\r\n\u001b[?2004l\ry(M, N, device='cuda', dtype=torch.float32)\r\nresults = []"]
[1400.214578, "i", "IL k1 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}: {type(ex).__name__}')\n\nfor BM, BN, BK, G, wps, st in itertools.product([64,128],[128,256],[32,64],[8],[4,8],[3,4]):\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: k2[grid](xh, xl, bh, bl, bias, out, M, N, K,\n            xh.stride(0), xh.stride(1), bh.stride(1), bh.stride(0),\n            out.stride(0), out.stride(1), BM, BN, BK, G, num_warps=wps, num_stages=st)\n        bench(fn, f'k2 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}')\n    except Exception as ex:\n        print(f'FAIL k2 BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}: {type(ex).__name__}')\n\nresults.sort()\nprint('BEST:', results[:8])\nEOF\ngpu sync && gpu refresh sb-kxeUzouFK4eb7AaeXmrmP2 && gpu exec sb-kxeUzouFK4eb7AaeXmrmP2 -- python3 /workspace/sweep2.py 2>&1 | tail -12\n"]
