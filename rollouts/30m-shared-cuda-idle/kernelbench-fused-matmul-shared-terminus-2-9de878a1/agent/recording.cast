[207.081451, "o", "> "]
[207.081499, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[207.081524, "o", "\u001b[?2004h> "]
[207.081565, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[207.081593, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[207.081624, "o", "> "]
[207.081652, "o", "    def _prepare(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.081685, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[207.081709, "o", "\u001b[?2004h> "]
[207.081735, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.081764, "o", "> "]
[207.081801, "o", "        key = (w.data_ptr(), b.data_ptr())\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.081829, "o", "> "]
[207.081863, "o", "        ent = getattr(self, '_prep', None)\r\n\u001b[?2004l\r"]
[207.081888, "o", "\u001b[?2004h> "]
[207.081931, "o", "        if ent is not None and ent[0] == key:\r\n\u001b[?2004l\r"]
[207.081959, "o", "\u001b[?2004h> "]
[207.082016, "o", "            return ent[1], ent[2], ent[3], ent[4], ent[5]\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.082041, "o", "> "]
[207.082073, "o", "        s = self.scaling_factor + 1.0\r\n\u001b[?2004l\r"]
[207.082102, "o", "\u001b[?2004h> "]
[207.082141, "o", "        wt = (w * s).t().contiguous()\r\n\u001b[?2004l\r"]
[207.082165, "o", "\u001b[?2004h> "]
[207.082193, "o", "        bh, bl = _split_fp16(wt)\r\n\u001b[?2004l\r"]
[207.082217, "o", "\u001b[?2004h> "]
[207.082254, "o", "        bias = (b * s).contiguous()\r\n\u001b[?2004l\r"]
[207.08228, "o", "\u001b[?2004h> "]
[207.082326, "o", "        self._prep = (key, bh, bl, bias, wt, None)\r\n\u001b[?2004l\r"]
[207.082356, "o", "\u001b[?2004h> "]
[207.082387, "o", "        return bh, bl, bias, wt, None\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.082412, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.082453, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.082481, "o", "> "]
[207.082505, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.082533, "o", "> "]
[207.082557, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.082586, "o", "> "]
[207.082609, "o", "        s = self.scaling_factor + 1.0\r\n\u001b[?2004l\r"]
[207.082641, "o", "\u001b[?2004h> "]
[207.082669, "o", "        if not x.is_cuda:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.082721, "o", "            return (x @ w.t() + b) * s\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.08275, "o", "> "]
[207.082774, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.082806, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r"]
[207.082831, "o", "\u001b[?2004h> "]
[207.082876, "o", "        bh, bl, bias, wt, _ = self._prepare()\r\n\u001b[?2004l\r"]
[207.082905, "o", "\u001b[?2004h> "]
[207.082936, "o", "        xh = x.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.082979, "o", "        xl = (x - xh.float()).half()\r\n\u001b[?2004l\r"]
[207.083008, "o", "\u001b[?2004h> "]
[207.083045, "o", "        xh = xh.contiguous()\r\n\u001b[?2004l\r"]
[207.083068, "o", "\u001b[?2004h> "]
[207.083093, "o", "        xl = xl.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.083119, "o", "> "]
[207.083186, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[207.083214, "o", "\u001b[?2004h> "]
[207.083301, "o", "        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[207.08333, "o", "> "]
[207.083359, "o", "        _mm3_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.083399, "o", "            xh, xl, bh, bl, out,\r\n\u001b[?2004l\r"]
[207.083425, "o", "\u001b[?2004h> "]
[207.08345, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.083502, "o", "            xh.stride(0), xh.stride(1),\r\n\u001b[?2004l\r"]
[207.083531, "o", "\u001b[?2004h> "]
[207.083556, "o", "            bh.stride(0), bh.stride(1),\r\n\u001b[?2004l\r"]
[207.083582, "o", "\u001b[?2004h> "]
[207.083628, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[207.083654, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[207.083678, "o", "\u001b[?2004h> "]
[207.083707, "o", "        out += bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[207.083736, "o", "        return out\r\n\u001b[?2004l\r"]
[207.083765, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[207.114526, "o", "\u001b[?2004hroot@modal:/# "]
