[476.881394, "i", "cat > /workspace/test_local.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\ntorch.manual_seed(42)\nclass Ref(torch.nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.matmul = torch.nn.Linear(4096, 4096)\n        self.scaling_factor = 0.5\n    def forward(self, x):\n        x = self.matmul(x)\n        orig = x.clone().detach()\n        return x*self.scaling_factor + orig\nref = Ref().cuda()\nnew = ModelNew(4096, 4096, 0.5).cuda()\nnew.matmul.weight.data.copy_(ref.matmul.weight.data)\nnew.matmul.bias.data.copy_(ref.matmul.bias.data)\nfor i in range(3):\n    x = torch.rand(16384, 4096, device='cuda')\n    with torch.no_grad():\n        a = ref(x)\n        b = new(x)\n    d = (a-b).abs()\n    print('max', d.max().item(), 'avg', d.mean().item())\n# timing\nimport time\nfor name, m in [('ref', ref), ('new', new)]:\n    for _ in range(5): m(x)\n    torch.cuda.synchronize()\n    ev1, ev2 = torch.cuda.Event(True), torch.cuda.Event(True)\n    ts=[]\n    for _ in range(20):\n "]
[476.881563, "i", "       torch.cuda.synchronize()\n        ev1.record(); m(x); ev2.record()\n        torch.cuda.synchronize()\n        ts.append(ev1.elapsed_time(ev2))\n    ts.sort()\n    print(name, 'ms median', ts[len(ts)//2], 'min', ts[0])\nEOF\n"]
