[1601.085179, "i", "cat > /workspace/sweep3.py << 'EOF'\nimport torch, triton, triton.language as tl, itertools\nexec(open('/workspace/sweep2.py').read().split('torch.manual_seed')[0])\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * K**-0.5\nb = torch.randn(N, device='cuda') * K**-0.5\ns = 1.5\nref = torch.nn.functional.linear(x, w, b) * s\nwt = (w * s).t().contiguous()\nbh = wt.half(); bl = (wt - bh.float()).half()\nbias = (b * s).contiguous()\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nresults = []\nfor BM, BN, BK, G, wps, st in [\n    (128,128,32,8,8,3),\n    (64,256,32,8,8,3), (64,256,32,8,4,3), (64,256,64,8,8,3),\n    (128,64,32,8,8,3), (128,64,32,8,4,3),\n    (128,128,32,16,8,3), (128,128,32,8,8,2),\n    (64,128,32,8,4,3), (64,128,64,8,4,4),\n    (128,128,64,8,8,3), (256,64,32,8,8,3),\n    (128,256,32,8,8,3), (128,128,128,8,8,3),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: k1[grid](x, bh, bl, bias, out, M, N, "]
[1601.08522, "i", "K,\n            x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),\n            out.stride(0), out.stride(1), BM, BN, BK, G, num_warps=wps, num_stages=st)\n        fn(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        ts = []\n        e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)\n        for _ in range(15):\n            torch.cuda.synchronize()\n            e1.record(); fn(); e2.record(); torch.cuda.synchronize()\n            ts.append(e1.elapsed_time(e2))\n        ts.sort()\n        med = ts[len(ts)//2]\n        results.append((med, (BM,BN,BK,G,wps,st)))\n        print(f'{med:.3f}ms BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st} err={err:.2e}')\n    except Exception as ex:\n        print(f'FAIL BM={BM} BN={BN} BK={BK} G={G} w={wps} s={st}: {type(ex).__name__}')\nresults.sort()\nprint('BEST:', results[:5])\nEOF\ngpu sync && gpu refresh sb-kxeUzouFK4eb7AaeXmrmP2 && gpu exec sb-kxeUzouFK4eb7AaeXmrmP2 -- python3 /workspace/sweep3.py 2>&1 | tail -20\n"]
