[797.225887, "i", "cat > /workspace/solution2.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP': 8}, num_warps=4, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP': 8}, num_warps=8, num_stages=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _mm3f_kernel(\n    A, BH, BL, BIAS, C,\n    M, N, K,\n    sam, sak, sbn, sbk, scm, scn,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, B"]
[797.22593, "i", "N)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + ((pid % width) % group_size)\n    pid_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n\n    a_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk\n    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\n\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(a_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptr)\n        bl = tl.load(bl_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        a_ptr += BK * sak\n        bh_ptr += BK * sbk\n        bl_ptr += BK * sbk\n\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    c_ptr = C + rm[:, None] * scm + rn[None,"]
[797.225955, "i", " :] * scn\n    tl.store(c_ptr, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n\n    def _prepare(self, w, b):\n        key = (w.data_ptr(), b.data_ptr(), w.device)\n        ent = getattr(self, '_prep', None)\n        if ent is not None and ent[0] == key:\n            return ent[1], ent[2], ent[3]\n        s = self.scaling_factor + 1.0\n        wt = (w * s).t().contiguous()\n        bh = wt.half()\n        bl = (wt - bh.float()).half()\n        bias = (b * s).contiguous()\n        self._prep = (key, bh, bl, bias)\n        return bh, bl, bias\n\n    def forward(self, x):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        s = self.scaling_factor + 1.0\n        if not x.is_cuda:\n            return (x @ w.t() + b) * s\n        if x.dtype != torch.float32:\n            return (x @ w.t() + b) * s\n        M, K = x.shape\n        N = w.sh"]
[797.22597, "i", "ape[0]\n        bh, bl, bias = self._prepare(w, b)\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n        _mm3f_kernel[grid](\n            x, bh, bl, bias, out,\n            M, N, K,\n            x.stride(0), x.stride(1),\n            bh.stride(1), bh.stride(0),\n            out.stride(0), out.stride(1),\n        )\n        return out\nEOF\ncp /workspace/solution.py /workspace/solution_v1.py\ncp /workspace/solution2.py /workspace/solution.py\n"]
