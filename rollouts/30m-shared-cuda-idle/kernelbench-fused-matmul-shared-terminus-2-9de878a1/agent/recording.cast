[1761.37483, "i", "cat > /workspace/sweep4.py << 'EOF'\nimport torch, triton, triton.language as tl, sys\nsys.path.insert(0, '/workspace')\nimport triton.language as tl\n\n@triton.jit\ndef k3(A, BH, BL, BIAS, C, M, N, K, sam, sak, sbn, sbk, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + ((pid % width) % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptr = BH + rn[None, :] * sbn + rk[:, None] * sbk\n    bl_ptr = BL + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(a_p"]
[1761.375017, "i", "tr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptr)\n        bl = tl.load(bl_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc2 = tl.dot(ah, bl, acc2)\n        acc2 = tl.dot(al, bh, acc2)\n        a_ptr += BK * sak; bh_ptr += BK * sbk; bl_ptr += BK * sbk\n    acc = acc + acc2\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * K**-0.5\nb = torch.randn(N, device='cuda') * K**-0.5\ns = 1.5\nref = torch.nn.functional.linear(x, w, b) * s\nwt = (w * s).t().contiguous()\nbh = wt.half(); bl = (wt - bh.float()).half()\nbias = (b * s).contiguous()\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nfor G in (8, 16):\n    grid = (triton.cdiv(M,128)*triton.cdiv(N,128),)\n    fn = lambda: k3[grid](x, bh, bl, bias, out, M, N, K,\n        x.stride(0), x.stride(1), bh.stride("]
[1761.375096, "o", "cat > /workspace/sweep4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.375129, "i", "1), bh.stride(0),\n        out.stride(0), out.stride(1), 128, 128, 32, G, num_warps=8, num_stages=3)\n    fn(); torch.cuda.synchronize()\n    err = (out - ref).abs().max().item()\n    # worst-case allclose margin: err / (atol + rtol*|ref|)\n    ratio = ((out - ref).abs() / (1e-4 + 1e-4 * ref.abs())).max().item()\n    ts = []\n    e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)\n    for _ in range(15):\n        torch.cuda.synchronize()\n        e1.record(); fn(); e2.record(); torch.cuda.synchronize()\n        ts.append(e1.elapsed_time(e2))\n    ts.sort()\n    print(f'G={G} med={ts[len(ts)//2]:.3f}ms err={err:.2e} closeratio={ratio:.3f}')\n# multi-seed error check for the current solution kernel (single acc)\nfrom kern_mod import k1\nworst = 0.0\nfor seed in range(10):\n    torch.manual_seed(seed)\n    x = torch.rand(M, K, device='cuda')\n    w = torch.randn(N, K, device='cuda') * K**-0.5\n    b = torch.randn(N, device='cuda') * K**-0.5\n    ref = torch.nn.functional.linear(x, w, b) * s\n    wt = (w * s).t().contiguous()\n    "]
[1761.37514, "o", "import torch, triton, triton.language as tl, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.37518, "i", "bh = wt.half(); bl = (wt - bh.float()).half()\n    bias = (b * s).contiguous()\n    grid = (triton.cdiv(M,128)*triton.cdiv(N,128),)\n    k1[grid](x, bh, bl, bias, out, M, N, K,\n        x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),\n        out.stride(0), out.stride(1), 128, 128, 32, 8, num_warps=8, num_stages=3)\n    torch.cuda.synchronize()\n    r = ((out - ref).abs() / (1e-4 + 1e-4 * ref.abs())).max().item()\n    worst = max(worst, r)\n    print(f'seed {seed}: closeratio={r:.3f}')\nprint('worst ratio single-acc:', worst)\nEOF\ngpu sync && gpu refresh sb-kxeUzouFK4eb7AaeXmrmP2 && gpu exec sb-kxeUzouFK4eb7AaeXmrmP2 -- python3 /workspace/sweep4.py 2>&1 | tail -16\n"]
