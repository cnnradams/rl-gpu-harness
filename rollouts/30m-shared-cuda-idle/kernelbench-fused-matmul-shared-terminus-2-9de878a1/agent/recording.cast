[936.178439, "o", "M = N = K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[936.178468, "o", "\u001b[?2004h> "]
[936.178492, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[936.178511, "o", "\u001b[?2004h> "]
[936.178555, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[936.178584, "o", "\u001b[?2004h> "]
[936.178625, "o", "w = torch.randn(N, K, device='cuda') * K**-0.5\r\n\u001b[?2004l\r"]
[936.178654, "o", "\u001b[?2004h> "]
[936.17869, "o", "b = torch.randn(N, device='cuda') * K**-0.5\r\n\u001b[?2004l\r"]
[936.178716, "o", "\u001b[?2004h> s = 1.5\r\n\u001b[?2004l\r"]
[936.178743, "o", "\u001b[?2004h> "]
[936.178794, "o", "ref = torch.nn.functional.linear(x, w, b) * s\r\n\u001b[?2004l\r"]
[936.178819, "o", "\u001b[?2004h> "]
[936.17885, "o", "wt = (w * s).t().contiguous()\r\n\u001b[?2004l\r"]
[936.178879, "o", "\u001b[?2004h> "]
[936.178922, "o", "bh = wt.half(); bl = (wt - bh.float()).half()\r\n\u001b[?2004l\r"]
[936.178949, "o", "\u001b[?2004h> "]
[936.178977, "o", "bias = (b * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[936.179006, "o", "> "]
[936.179051, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[936.179079, "o", "\u001b[?2004h> "]
[936.179105, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.179164, "o", "for BM, BN, BK, G, wps, st, sep in itertools.product(\r\n\u001b[?2004l\r"]
[936.179188, "o", "\u001b[?2004h> "]
[936.179262, "o", "    [64,128,256],[128,256],[32,64,128],[8],[4,8],[3,4,5],[True,False]):\r\n\u001b[?2004l\r"]
[936.179293, "o", "\u001b[?2004h> "]
[936.179319, "o", "    if BM*BN > 256*256: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[936.179348, "o", "> "]
[936.179376, "o", "    if BK > 64 and st > 3: continue\r\n\u001b[?2004l\r"]
[936.1794, "o", "\u001b[?2004h> "]
[936.179452, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[936.179476, "o", "\u001b[?2004h> "]
[936.179504, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.179567, "o", "        fn = lambda: k1[grid](x, bh, bl, bias, out, M, N, K,\r\n\u001b[?2004l\r"]
[936.179592, "o", "\u001b[?2004h> "]
[936.179659, "o", "            x.stride(0), x.stride(1), bh.stride(1), bh.stride(0),\r\n\u001b[?2004l\r"]
[936.179687, "o", "\u001b[?2004h> "]
[936.179783, "o", "            out.stride(0), out.stride(1), BM, BN, BK, G, sep, num_warps=wps, num_stages=st)\r\n\u001b[?2004l\r"]
[936.179813, "o", "\u001b[?2004h> "]
[936.179837, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.179876, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[936.179905, "o", "\u001b[?2004h> "]
[936.179942, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[936.179966, "o", "\u001b[?2004h> "]
[936.179991, "o", "        ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[936.180018, "o", "> "]
[936.180077, "o", "        e1, e2 = torch.cuda.Event(True), torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[936.1801, "o", "\u001b[?2004h> "]
[936.180129, "o", "        for _ in range(10):\r\n\u001b[?2004l\r"]
[936.180154, "o", "\u001b[?2004h> "]
[936.180193, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[936.180219, "o", "\u001b[?2004h> "]
[936.180291, "o", "            e1.record(); fn(); e2.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[936.180316, "o", "\u001b[?2004h> "]
[936.180359, "o", "            ts.append(e1.elapsed_time(e2))\r\n\u001b[?2004l\r"]
[936.180384, "o", "\u001b[?2004h> "]
[936.180404, "o", "        ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[936.180428, "o", "> "]
[936.180457, "o", "        med = ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[936.180481, "o", "\u001b[?2004h> "]
[936.180543, "o", "        results.append((med, BM, BN, BK, wps, st, sep, err))\r\n\u001b[?2004l\r"]
[936.180573, "o", "\u001b[?2004h> "]
[936.180675, "o", "        print(f'{med:.3f}ms BM={BM} BN={BN} BK={BK} warps={wps} stages={st} sep={sep} err={err:.2e}')\r\n\u001b[?2004l\r"]
[936.180688, "o", "\u001b[?2004h> "]
[936.180731, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[936.180757, "o", "\u001b[?2004h> "]
[936.180863, "o", "        print(f'FAIL BM={BM} BN={BN} BK={BK} warps={wps} stages={st} sep={sep}: {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[936.180894, "o", "\u001b[?2004h> "]
[936.180917, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[936.180951, "o", "print('BEST:', results[:5])\r\n\u001b[?2004l\r"]
[936.180979, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[936.204811, "o", "\u001b[?2004hroot@modal:/# "]
