[56.234435, "o", "\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef eval_kernel_against_ref\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    original_model_src: str,\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    custom_model_src: str,\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    seed_num: int = 42,\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: int = 1,\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_perf_trials: int = 10,\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    measure_performance: bool = False,\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    timing_method: str = \"cuda_event\", # see timing.py\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    verbose: bool = False,\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    build_dir: os.PathLike = None,\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: Union[torch.device, int] = (\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.cuda.current_device() if torch.cuda.is_available() else None\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ),  # have to run on GPU"]
[56.234461, "o", "\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str = \"cuda\",  # can be 'cuda', 'triton', 'tilelang', or 'cute'\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype = torch.float32,\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Guard against potential reward hacking [optional but ongoing enhancement]\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    check_for_excessive_speedup: bool = True,\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    excessive_speedup_threshold: float = 10, # flag if the kernel is more than <excessive_speedup_threshold>x faster than the reference\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K) -> KernelExecResult:\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Evaluate the custom kernel against the original model\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    NOTE: we are thinking about refactor this to be more modularized \r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    and we can add more checks as our other ongiong PRs are working on\r\n\u001b[32m\u001b[K419"]
[56.234511, "o", "\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: number of trials to initialize different random inputs; correctness pass only if all trials pass\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_perf_trials: run the evalutation many times to take the average\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: GPU (cuda) device to run the evalutation on\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str, one of 'cuda', 'triton', 'tilelang', or 'cute'\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype for computation (note: tilelang only supports fp16)\r\n\u001b[32m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    timing_method: str, method to time kernel, see timing.py for more details \r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ONGOING EFFORT to refactor and modularize this, and adding more tests for eval.\r\n\u001b[32m\u001b[K428\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K429\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # TODO: check device is busy"]
[56.234569, "o", "\r\n\u001b[32m\u001b[K430\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    assert torch.cuda.is_available(), \"CUDA is not available, cannot run Eval\"\r\n\u001b[32m\u001b[K431\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K432\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Backend-GPU vendor validation\r\n\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    from .utils import get_gpu_vendor\r\n\u001b[32m\u001b[K434\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    vendor = get_gpu_vendor(device)\r\n\u001b[32m\u001b[K435\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend_lower = backend.lower()\r\n\u001b[32m\u001b[K436\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # HIP is AMD-only\r\n\u001b[32m\u001b[K437\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if backend_lower == \"hip\" and vendor != \"amd\":\r\n\u001b[32m\u001b[K438\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        raise ValueError(f\"HIP backend requires AMD GPU, got {vendor}\")\r\n\u001b[32m\u001b[K439\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # cuda/cute/thunderkittens are NVIDIA-only (triton/tilelang work on both)\r\n\u001b[32m\u001b[K440\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if backend_lower in [\"cuda\", \"cute\", \"thunderkittens\"] and vendor == \"amd\":\r\n\u001b[32m\u001b[K441\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        raise ValueError(f\"{backend} backend requires NVIDIA GPU, got AMD\")\r\n\u001b[32m\u001b[K442\u001b[m\u001b[K"]
[56.234624, "o", "\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K443\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if backend_lower == \"tilelang\":\r\n\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        assert precision == torch.float16 or precision == torch.bfloat16, \"TileLang only supports fp16 or bfloat16\"\r\n\u001b[32m\u001b[K445\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K446\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    torch.set_printoptions(\r\n\u001b[32m\u001b[K447\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        precision=4,  # Decimal places\r\n\u001b[32m\u001b[K448\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        threshold=10,  # Total number of elements before truncating\r\n\u001b[32m\u001b[K449\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        edgeitems=3,  # Number of elements at beginning and end of dimensions\r\n\u001b[32m\u001b[K450\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        linewidth=80,  # Maximum width before wrapping\r\n\u001b[32m\u001b[K451\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    )\r\n\u001b[32m\u001b[K452\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K453\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # set CUDA device\r\n\u001b[32m\u001b[K454\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    torch.cuda.set_device(device)\r\n\u001b[32m\u001b[K455\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K456\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Backends that use tempfile approach and nee"]
[56.234669, "o", "d CUDA_VISIBLE_DEVICES\r\n\u001b[32m\u001b[K457\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # TileLang, Triton, and CuTe all use tempfile for proper module loading\r\n\u001b[32m\u001b[K458\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    uses_tempfile = backend.lower() in [\"triton\", \"tilelang\", \"cute\"]\r\n\u001b[32m\u001b[K459\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K460\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    metadata = {}  # for storing result metadata\r\n\u001b[32m\u001b[K461\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    metadata[\"hardware\"] = torch.cuda.get_device_name(device=device)\r\n\u001b[32m\u001b[K462\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    metadata[\"device\"] = str(device)  # for debugging\r\n\u001b[32m\u001b[K463\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K464\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if uses_tempfile:\r\n\u001b[32m\u001b[K465\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # need to set env var for triton/cute code to guarantee no wrong device shenanigans\r\n\u001b[32m\u001b[K466\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if isinstance(device, int):\r\n\u001b[32m\u001b[K467\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            device_num = device\r\n\u001b[32m\u001b[K468\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        elif isinstance(device, torch.device):\r\n\u001b[32m\u001b[K469\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            assert "]
[56.234714, "o", "(\r\n\u001b[32m\u001b[K470\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                device.type == \"cuda\"\r\n\u001b[32m\u001b[K471\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            ), \"CUDA is not availible on device, cannot run Eval\"\r\n\u001b[32m\u001b[K472\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            device_num = device.index\r\n\u001b[32m\u001b[K473\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else:\r\n\u001b[32m\u001b[K474\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            raise ValueError(\r\n\u001b[32m\u001b[K475\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                f\"device must be an int or torch.device, got {type(device)}\"\r\n\u001b[32m\u001b[K476\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            )\r\n\u001b[32m\u001b[K477\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # NVIDIA uses CUDA_VISIBLE_DEVICES, AMD uses HIP_VISIBLE_DEVICES\r\n\u001b[32m\u001b[K478\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if vendor == \"amd\":\r\n\u001b[32m\u001b[K479\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            os.environ[\"HIP_VISIBLE_DEVICES\"] = str(device_num)\r\n\u001b[32m\u001b[K480\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        else:\r\n\u001b[32m\u001b[K481\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            os.environ[\"CUDA_VISIBLE_DEVICES\"] = str(device_num)\r\n\u001b[32m\u001b[K482\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    context = {}\r\n\u001b[32m\u001b[K483\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K484\u001b[m\u001b[K\u001b[3"]
[56.234756, "o", "6m\u001b[K-\u001b[m\u001b[K    if verbose:\r\n\u001b[32m\u001b[K485\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        print(f\"[Eval] Start Evalulation! on device: {device}\")\r\n\u001b[32m\u001b[K486\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        print(\"[Eval] Loading Original Model\")\r\n\u001b[32m\u001b[K487\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K488\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Model, get_init_inputs, get_inputs = load_original_model_and_inputs(\r\n\u001b[32m\u001b[K489\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        original_model_src, context\r\n\u001b[32m\u001b[K490\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    )\r\n\u001b[32m\u001b[K491\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    set_seed(seed_num)  # set seed for reproducible input\r\n\u001b[32m\u001b[K492\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    init_inputs = get_init_inputs()\r\n\u001b[32m\u001b[K493\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K494\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Convert inputs to appropriate dtypes for GPU computation\r\n\u001b[32m\u001b[K495\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    init_inputs = [_process_input_tensor(x, device, backend, precision) for x in init_inputs]\r\n\u001b[32m\u001b[K496\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K497\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    with torch.no_grad():\r\n\u001b[32m\u001b[K498\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        set_seed(see"]
