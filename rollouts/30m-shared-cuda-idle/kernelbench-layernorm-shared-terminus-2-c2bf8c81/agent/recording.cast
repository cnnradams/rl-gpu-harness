[1094.447042, "o", "> "]
[1094.447127, "o", "            _spin7[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, NS=ns, num_warps=warps)\r\n\u001b[?2004l\r"]
