[596.649059, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _spin(X, Y, W, B, FSUM, CNT, N, eps,\n          S: tl.constexpr, CHUNK: tl.constexpr, WAIT: tl.constexpr, CG: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    c = tl.atomic_add(CNT + row, 1, sem=\"release\")\n    if WAIT:\n        if CG:\n            while c < S:\n                c = tl.load(CNT + row, cache_modifier=\".cg\", volatile=True)\n        else:\n            while c < S:\n                c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n    total = tl.atomic_add(FSUM + 2 * row, 0.0, sem=\"acquire\")\n    totsq = tl.atomic_add(FSUM + 2 * row "]
[596.649242, "i", "+ 1, 0.0, sem=\"acquire\")\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\ndef run(x, y, fsum, cnt, N, eps, S, warps, WAIT=True, CG=False):\n    M = x.numel() // N\n    CHUNK = N // S\n    _spin[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=CHUNK, WAIT=WAIT, CG=CG, num_warps=warps)\n    return y\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\nx = torch.rand(shape, device=dev)\nw = torch.ones(nshape, device=dev)\nb = torch.zeros(nshape, device=dev)\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\n\nwith torch.no_grad():\n    ref = F.layer_norm(x, nshape, w, b, eps)\n    f = timing.get_timing_function('cuda_event')\n    y = torch.empty_like(x)\n\n    for (S, warps, CG) in [(128, 32, False), (128, 32, True), (128, 16, True), (64, 16, True), (64, 32, True), (256, 32, True), (128, 8, True), (256, 16, True), (64, 8, True)]:\n        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n        cnt ="]
[596.649263, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.649279, "i", " torch.zeros(M, device=dev, dtype=torch.int32)\n        out = run(x, y, fsum, cnt, N, eps, S, warps, True, CG)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        def fn(a):\n            fsum.zero_(); cnt.zero_()\n            return run(a, y, fsum, cnt, N, eps, S, warps, True, CG)\n        t = f(fn, [x], num_trials=30, verbose=False, device=dev)\n        st = timing.get_timing_stats(t)\n        print(f'spin S={S} w={warps} CG={CG}: ok={ok} mean={st[\"mean\"]} ms')\n\n    # no-wait ceiling (incorrect, timing only)\n    for (S, warps) in [(128, 32), (128, 16)]:\n        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n        def fn(a):\n            fsum.zero_(); cnt.zero_()\n            return run(a, y, fsum, cnt, N, eps, S, warps, False, False)\n        t = f(fn, [x], num_trials=30, verbose=False, device=dev)\n        st = timing.get_timing_stats(t)\n        print(f'nowait S={S} w={warps}: mean={st[\"mean\"]} ms')\n\n    # torch.compile comparis"]
[596.649292, "o", "import torch, sys\r\n\u001b[?2004l\r"]
[596.649405, "i", "on\n    ln = torch.nn.LayerNorm(nshape).to(dev)\n    cln = torch.compile(ln, mode='max-autotune-no-cudagraphs')\n    for _ in range(5):\n        cln(x)\n    t = f(lambda a: cln(a), [x], num_trials=30, verbose=False, device=dev)\n    print('torch.compile mean:', timing.get_timing_stats(t)['mean'], 'ms')\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/bench3.py /workspace/bench3.py\n"]
[596.64942, "o", "\u001b[?2004h> sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> import triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.649471, "o", "from kernelbench import timing\r\n\u001b[?2004l\r"]
[596.649494, "o", "\u001b[?2004h"]
[596.649543, "o", "> import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.649606, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.649655, "o", "def _spin(X, Y, W, B, FSUM, CNT, N, eps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.649701, "o", "> "]
[596.649765, "o", "          S: tl.constexpr, CHUNK: tl.constexpr, WAIT: tl.constexpr, CG: tl.constexpr):\r\n\u001b[?2004l\r"]
[596.649809, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[596.649851, "o", "\u001b[?2004h>     row = pid // S\r\n\u001b[?2004l\r"]
[596.649889, "o", "\u001b[?2004h>     sid = pid % S\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.64993, "o", "> "]
[596.649961, "o", "    offs = sid * CHUNK + tl.arange(0, CHUNK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.650005, "o", "> "]
[596.650047, "o", "    x = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.650089, "o", "    s = tl.sum(x, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.650107, "o", "    sq = tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[596.650147, "o", "\u001b[?2004h> "]
[596.650187, "o", "    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\r\n\u001b[?2004l\r"]
[596.650206, "o", "\u001b[?2004h> "]
[596.650272, "o", "    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.650315, "o", "> "]
[596.650355, "o", "    c = tl.atomic_add(CNT + row, 1, sem=\"release\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.650394, "o", "    if WAIT:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.650435, "o", "        if CG:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.650523, "o", "            while c < S:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.650567, "o", "                c = tl.load(CNT + row, cache_modifier=\".cg\", volatile=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.650601, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.650641, "o", ">             while c < S:\r\n\u001b[?2004l\r"]
[596.650683, "o", "\u001b[?2004h> "]
[596.650724, "o", "                c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\r\n\u001b[?2004l\r"]
[596.650766, "o", "\u001b[?2004h> "]
[596.650812, "o", "    total = tl.atomic_add(FSUM + 2 * row, 0.0, sem=\"acquire\")\r\n\u001b[?2004l\r"]
[596.650852, "o", "\u001b[?2004h> "]
[596.650901, "o", "    totsq = tl.atomic_add(FSUM + 2 * row + 1, 0.0, sem=\"acquire\")\r\n\u001b[?2004l\r"]
[596.650941, "o", "\u001b[?2004h>     mean = total / N\r\n\u001b[?2004l\r"]
[596.65098, "o", "\u001b[?2004h> "]
[596.651018, "o", "    var = totsq / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.651057, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[596.651077, "o", "\u001b[?2004h> "]
[596.651111, "o", "    y = (x - mean) * rstd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.651159, "o", "    tl.store(Y + row * N + offs, y)\r\n\u001b[?2004l\r"]
[596.651198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.651264, "o", "def run(x, y, fsum, cnt, N, eps, S, warps, WAIT=True, CG=False):\r\n\u001b[?2004l\r"]
[596.651305, "o", "\u001b[?2004h>     M = x.numel() // N\r\n\u001b[?2004l\r"]
[596.651343, "o", "\u001b[?2004h>     CHUNK = N // S\r\n\u001b[?2004l\r"]
[596.651382, "o", "\u001b[?2004h> "]
[596.651467, "o", "    _spin[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=CHUNK, WAIT=WAIT, CG=CG, num_warps=warps)\r\n\u001b[?2004l\r"]
[596.651511, "o", "\u001b[?2004h>     return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.651551, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> dev = 'cuda'\r\n\u001b[?2004l\r"]
[596.651569, "o", "\u001b[?2004h> "]
[596.6516, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[596.651639, "o", "\u001b[?2004h> shape = (16, 64, 256, 256)\r\n\u001b[?2004l\r"]
[596.651679, "o", "\u001b[?2004h> "]
[596.65172, "o", "nshape = shape[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.651757, "o", "x = torch.rand(shape, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.651797, "o", "w = torch.ones(nshape, device=dev)\r\n\u001b[?2004l\r"]
[596.651834, "o", "\u001b[?2004h> "]
[596.651854, "o", "b = torch.zeros(nshape, device=dev)\r\n\u001b[?2004l\r"]
[596.651896, "o", "\u001b[?2004h> "]
[596.651937, "o", "eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> N = 64 * 256 * 256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.651956, "o", "M = 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.651995, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.652035, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.652088, "o", "    ref = F.layer_norm(x, nshape, w, b, eps)\r\n\u001b[?2004l\r"]
[596.652127, "o", "\u001b[?2004h> "]
[596.652167, "o", "    f = timing.get_timing_function('cuda_event')\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.652205, "o", ">     y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[596.652246, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.65243, "o", "    for (S, warps, CG) in [(128, 32, False), (128, 32, True), (128, 16, True), (64, 16, True), (64, 32, True), (256, 32, True), (128, 8, True), (256, 16, True), (64, 8, True)]:\r\n\u001b[?2004l\r"]
[596.652446, "o", "\u001b[?2004h> "]
[596.652524, "o", "        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[596.652563, "o", "\u001b[?2004h> "]
[596.652602, "o", "        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[596.652621, "o", "\u001b[?2004h> "]
[596.652688, "o", "        out = run(x, y, fsum, cnt, N, eps, S, warps, True, CG)\r\n\u001b[?2004l\r"]
[596.652706, "o", "\u001b[?2004h> "]
[596.652769, "o", "        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[596.652803, "o", "\u001b[?2004h>         def fn(a):\r\n\u001b[?2004l\r"]
[596.652835, "o", "\u001b[?2004h> "]
[596.652867, "o", "            fsum.zero_(); cnt.zero_()\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.652906, "o", "> "]
[596.652952, "o", "            return run(a, y, fsum, cnt, N, eps, S, warps, True, CG)\r\n\u001b[?2004l\r"]
[596.652992, "o", "\u001b[?2004h> "]
[596.653043, "o", "        t = f(fn, [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.653083, "o", "> "]
[596.653123, "o", "        st = timing.get_timing_stats(t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.653212, "o", "        print(f'spin S={S} w={warps} CG={CG}: ok={ok} mean={st[\"mean\"]} ms')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[596.653252, "o", "\u001b[?2004h> "]
[596.653292, "o", "    # no-wait ceiling (incorrect, timing only)\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.653331, "o", "> "]
[596.653366, "o", "    for (S, warps) in [(128, 32), (128, 16)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.653448, "o", "        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.653537, "o", "        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[596.653569, "o", "\u001b[?2004h>         def fn(a):\r\n\u001b[?2004l\r"]
[596.653606, "o", "\u001b[?2004h> "]
[596.653644, "o", "            fsum.zero_(); cnt.zero_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.653724, "o", "            return run(a, y, fsum, cnt, N, eps, S, warps, False, False)\r\n\u001b[?2004l\r"]
[596.653761, "o", "\u001b[?2004h> "]
[596.65381, "o", "        t = f(fn, [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[596.653848, "o", "\u001b[?2004h> "]
[596.653886, "o", "        st = timing.get_timing_stats(t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.653953, "o", "        print(f'nowait S={S} w={warps}: mean={st[\"mean\"]} ms')\r\n\u001b[?2004l\r"]
[596.65399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.654029, "o", "    # torch.compile comparison\r\n\u001b[?2004l\r\u001b[?2004h"]
[596.654067, "o", "> "]
[596.654104, "o", "    ln = torch.nn.LayerNorm(nshape).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[596.654168, "o", "    cln = torch.compile(ln, mode='max-autotune-no-cudagraphs')\r\n\u001b[?2004l\r"]
[596.654207, "o", "\u001b[?2004h>     for _ in range(5):\r\n\u001b[?2004l\r"]
[596.654245, "o", "\u001b[?2004h>         cln(x)\r\n\u001b[?2004l\r"]
[596.654285, "o", "\u001b[?2004h> "]
[596.65434, "o", "    t = f(lambda a: cln(a), [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[596.654379, "o", "\u001b[?2004h> "]
[596.65444, "o", "    print('torch.compile mean:', timing.get_timing_stats(t)['mean'], 'ms')\r\n\u001b[?2004l\r"]
[596.654482, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
