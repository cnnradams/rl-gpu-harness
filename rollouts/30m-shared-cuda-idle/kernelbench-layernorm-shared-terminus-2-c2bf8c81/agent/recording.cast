[1162.168579, "o", "> N = 64 * 256 * 256\r\n\u001b[?2004l\r"]
[1162.168605, "o", "\u001b[?2004h> M = 16\r\n\u001b[?2004l\r"]
[1162.168632, "o", "\u001b[?2004h> "]
[1162.168658, "o", "w = torch.ones(nshape, device=dev)\r\n\u001b[?2004l\r"]
[1162.168685, "o", "\u001b[?2004h> "]
[1162.168713, "o", "b = torch.zeros(nshape, device=dev)\r\n\u001b[?2004l\r"]
[1162.168739, "o", "\u001b[?2004h> "]
[1162.168766, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1162.168793, "o", "> "]
[1162.168829, "o", "    f = timing.get_timing_function('cuda_event')\r\n\u001b[?2004l\r"]
[1162.168856, "o", "\u001b[?2004h> "]
[1162.168886, "o", "    y = torch.empty(shape, device=dev)\r\n\u001b[?2004l\r"]
[1162.168913, "o", "\u001b[?2004h> "]
[1162.168995, "o", "    for (S, warps) in [(128, 32), (256, 16), (128, 16), (512, 16), (256, 32)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1162.169018, "o", "> "]
[1162.169046, "o", "        bad = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1162.169072, "o", "        worst = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1162.169098, "o", "> "]
[1162.169125, "o", "        for rep in range(1000):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1162.169147, "o", "> "]
[1162.169197, "o", "            x = torch.rand(shape, device=dev) * (1 + rep % 7)\r\n\u001b[?2004l\r"]
[1162.169223, "o", "\u001b[?2004h> "]
[1162.16927, "o", "            ref = F.layer_norm(x, nshape, w, b, eps)\r\n\u001b[?2004l\r"]
[1162.169297, "o", "\u001b[?2004h> "]
[1162.169363, "o", "            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1162.169389, "o", "\u001b[?2004h> "]
[1162.169452, "o", "            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[1162.169492, "o", "\u001b[?2004h> "]
[1162.169579, "o", "            _spin8[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\r\n\u001b[?2004l\r"]
[1162.169607, "o", "\u001b[?2004h> "]
[1162.169645, "o", "            d = (ref - y).abs().max().item()\r\n\u001b[?2004l\r"]
[1162.169671, "o", "\u001b[?2004h> "]
[1162.16971, "o", "            rel = d / ref.abs().max().item()\r\n\u001b[?2004l\r"]
[1162.169737, "o", "\u001b[?2004h> "]
[1162.169766, "o", "            worst = max(worst, rel)\r\n\u001b[?2004l\r"]
[1162.169793, "o", "\u001b[?2004h> "]
[1162.169852, "o", "            if not torch.allclose(ref, y, atol=1e-4, rtol=1e-4):\r\n\u001b[?2004l\r"]
[1162.169879, "o", "\u001b[?2004h> "]
[1162.169905, "o", "                bad += 1\r\n\u001b[?2004l\r"]
[1162.169931, "o", "\u001b[?2004h> "]
[1162.16996, "o", "        x = torch.rand(shape, device=dev)\r\n\u001b[?2004l\r"]
[1162.169987, "o", "\u001b[?2004h> "]
[1162.170048, "o", "        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1162.170075, "o", "\u001b[?2004h> "]
[1162.170129, "o", "        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[1162.170157, "o", "\u001b[?2004h> "]
[1162.170183, "o", "        def fn(a):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1162.170226, "o", "            fsum.zero_(); cnt.zero_()\r\n\u001b[?2004l\r"]
[1162.170253, "o", "\u001b[?2004h> "]
[1162.170337, "o", "            _spin8[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\r\n\u001b[?2004l\r"]
[1162.170364, "o", "\u001b[?2004h> "]
[1162.170432, "o", "        t = f(fn, [x], num_trials=50, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[1162.17046, "o", "\u001b[?2004h> "]
[1162.170499, "o", "        st = timing.get_timing_stats(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1162.170526, "o", "> "]
[1162.170617, "o", "        print(f'S={S} w={warps}: bad={bad}/1000 worst_rel={worst:.2e} mean={st[\"mean\"]} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1162.170645, "o", "> EOF\r\n\u001b[?2004l\r"]
[1162.172134, "o", "\u001b[?2004hroot@modal:/# "]
