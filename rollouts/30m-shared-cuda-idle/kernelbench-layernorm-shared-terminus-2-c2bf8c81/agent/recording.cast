[810.921089, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _spin2(X, Y, FSUM, CNT, N, eps,\n           S: tl.constexpr, CHUNK: tl.constexpr, MODE: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    c = tl.atomic_add(CNT + row, 1, sem=\"release\")\n    if MODE == 0:  # pure atomic acquire poll (baseline safe)\n        while c < S:\n            c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n    if MODE == 1:  # cg poll then nothing\n        while c < S:\n            c = tl.load(CNT + row, cache_modifier=\".cg\")\n    if MODE == 2:  # cg poll then acquire read of CNT\n        while c < S:\n            c = tl."]
[810.921148, "i", "load(CNT + row, cache_modifier=\".cg\")\n        c2 = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n    if MODE == 3:  # acquire atomic poll, only warp-uniform: poll via scalar load .cv\n        while c < S:\n            c = tl.load(CNT + row, cache_modifier=\".cv\")\n    total = tl.atomic_add(FSUM + 2 * row, 0.0, sem=\"acquire\")\n    totsq = tl.atomic_add(FSUM + 2 * row + 1, 0.0, sem=\"acquire\")\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\nx = torch.rand(shape, device=dev)\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\nwith torch.no_grad():\n    ref = F.layer_norm(x, nshape, torch.ones(nshape, device=dev), torch.zeros(nshape, device=dev), eps)\n    f = timing.get_timing_function('cuda_event')\n    y = torch.empty_like(x)\n    for (S, warps, mode) in [(128, 32, 0), (128, 32, 1), (128, 32, 2), (128, 32, 3), (256, 16, 2), (256, 16, 0), (256, 16, 3)]:\n "]
[810.921259, "i", "       bad = 0\n        worst = 0.0\n        for rep in range(10):\n            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n            _spin2[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, MODE=mode, num_warps=warps)\n            d = (ref - y).abs().max().item()\n            worst = max(worst, d)\n            if d > 1e-4:\n                bad += 1\n        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n        def fn(a):\n            fsum.zero_(); cnt.zero_()\n            _spin2[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, MODE=mode, num_warps=warps)\n        t = f(fn, [x], num_trials=30, verbose=False, device=dev)\n        st = timing.get_timing_stats(t)\n        print(f'S={S} w={warps} mode={mode}: bad={bad}/10 worst={worst:.2e} mean={st[\"mean\"]} ms')\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/bench4.py /workspace/bench4.py && gpu exec sb-8zRwUedIS"]
