[1492.834033, "i", "cat > /workspace/bench9.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _spin9(X, Y, FSUM, CNT, N, eps,\n           S: tl.constexpr, CHUNK: tl.constexpr, MODE: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    c = tl.atomic_add(CNT + row, 1, sem=\"release\")\n    if MODE == 0:  # safe: pure atomic acquire poll\n        while c < S:\n            c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n    if MODE == 1:  # two-phase: cheap cg spin then safe acquire confirm\n        while c < S:\n            c = tl.load(CNT + row, cache_modifier=\".cg\")\n        c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n        while c < S"]
[1492.834085, "i", ":\n            c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n    total = tl.atomic_add(FSUM + 2 * row, 0.0, sem=\"acquire\")\n    totsq = tl.atomic_add(FSUM + 2 * row + 1, 0.0, sem=\"acquire\")\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\nw = torch.ones(nshape, device=dev)\nb = torch.zeros(nshape, device=dev)\nwith torch.no_grad():\n    f = timing.get_timing_function('cuda_event')\n    y = torch.empty(shape, device=dev)\n    for mode in [0, 1]:\n        for (S, warps) in [(128, 32), (128, 16), (256, 16), (256, 32), (512, 32), (64, 32)]:\n            bad = 0\n            worst = 0.0\n            for rep in range(1000):\n                x = torch.rand(shape, device=dev) * (1 + rep % 7)\n                ref = F.layer_norm(x, nshape, w, b, eps)\n                fsum = torch.zeros(2 * M, device=dev, dtype=to"]
[1492.8341, "i", "rch.float32)\n                cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n                _spin9[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, MODE=mode, num_warps=warps)\n                d = (ref - y).abs().max().item()\n                worst = max(worst, d)\n                if not torch.allclose(ref, y, atol=1e-4, rtol=1e-4):\n                    bad += 1\n            x = torch.rand(shape, device=dev)\n            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n            def fn(a):\n                fsum.zero_(); cnt.zero_()\n                _spin9[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, MODE=mode, num_warps=warps)\n            t = f(fn, [x], num_trials=50, verbose=False, device=dev)\n            st = timing.get_timing_stats(t)\n            print(f'mode={mode} S={S} w={warps}: bad={bad}/1000 worst={worst:.2e} mean={st[\"mean\"]} ms')\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/bench9.py /workspace/bench9.py && "]
[1492.83424, "i", "gpu exec sb-8zRwUedIScafc4d6DtsERm -- python3 /workspace/bench9.py\n"]
