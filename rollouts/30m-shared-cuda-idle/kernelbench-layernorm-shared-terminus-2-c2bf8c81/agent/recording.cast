[1358.611182, "i", "cat > /workspace/dbg.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nimport torch.nn.functional as F\nfrom bench8 import _spin8\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\nS = 128\nx = torch.rand(shape, device=dev)\ny = torch.zeros(shape, device=dev)\nref = F.layer_norm(x, nshape, torch.ones(nshape, device=dev), torch.zeros(nshape, device=dev), eps)\nfsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\ncnt = torch.zeros(M, device=dev, dtype=torch.int32)\n_spin8[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=32)\ntorch.cuda.synchronize()\nprint('fsum', fsum[:4])\nprint('cnt', cnt[:4])\nprint('y[0,0,0,:4]', y[0,0,0,:4])\nprint('ref[0,0,0,:4]', ref[0,0,0,:4])\nprint('y mean row0', y[0].mean().item(), 'expected', ref[0].mean().item())\nprint('isnan', torch.isnan(y).any().item())\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/dbg.py /workspace/dbg.py && gpu exec sb-8zRwUedISca"]
