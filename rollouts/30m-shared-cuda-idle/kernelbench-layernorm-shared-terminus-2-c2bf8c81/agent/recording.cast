[822.604898, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=128 w=32 mode=0: bad=0/10 worst=4.89e-06 mean=0.254 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=128 w=32 mode=1: bad=6/10 worst=1.02e+01 mean=0.197 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=128 w=32 mode=2: bad=6/10 worst=1.79e+01 mean=0.199 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=128 w=32 mode=3: bad=7/10 worst=1.79e+01 mean=0.198 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=256 w=16 mode=2: bad=4/10 worst=1.79e+01 mean=0.193 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=256 w=16 mode=0: bad=0/10 worst=7.03e-06 mean=0.255 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\nS=256 w=16 mode=3: bad=8/10 worst=1.79e+01 mean=0.193 ms\r\n"]
[823.935658, "o", "\u001b[?2004hroot@modal:/# "]
[913.215693, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _spin4(X, Y, FSUM, CNT, N, eps,\n           S: tl.constexpr, CHUNK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    c = tl.atomic_add(CNT + row, 1, sem=\"release\")\n    while c < S:\n        c = tl.load(CNT + row, cache_modifier=\".cg\")\n    # acquire read of CNT, address depends on poll result -> cannot hoist above loop\n    c3 = tl.atomic_add(CNT + row + tl.minimum(c, 0), 0, sem=\"acquire\")\n    # FSUM reads depend on c3 -> cannot hoist above the acquire\n    total = tl.atomic_add(FSUM + 2 * row + tl.minimum(c3, 0), 0.0, sem=\"acquire\")\n    "]
[913.215881, "i", "totsq = tl.atomic_add(FSUM + 2 * row + 1 + tl.minimum(c3, 0), 0.0, sem=\"acquire\")\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\nx = torch.rand(shape, device=dev)\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\nwith torch.no_grad():\n    ref = F.layer_norm(x, nshape, torch.ones(nshape, device=dev), torch.zeros(nshape, device=dev), eps)\n    f = timing.get_timing_function('cuda_event')\n    y = torch.empty_like(x)\n    for (S, warps) in [(128, 32), (128, 16), (256, 16), (256, 32), (64, 16), (512, 16), (128, 8)]:\n        bad = 0\n        worst = 0.0\n        for rep in range(200):\n            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n            _spin4[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\n            d = (ref - y).abs().max().item"]
[913.215895, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r"]
[913.215941, "i", "()\n            worst = max(worst, d)\n            if d > 1e-4:\n                bad += 1\n        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n        def fn(a):\n            fsum.zero_(); cnt.zero_()\n            _spin4[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\n        t = f(fn, [x], num_trials=50, verbose=False, device=dev)\n        st = timing.get_timing_stats(t)\n        print(f'S={S} w={warps}: bad={bad}/200 worst={worst:.2e} mean={st[\"mean\"]} ms')\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/bench5.py /workspace/bench5.py && gpu exec sb-8zRwUedIScafc4d6DtsERm -- python3 /workspace/bench5.py\n"]
[913.215975, "o", "totsq = tl.atomic_add(FSUM + 2 * row + 1 + tl.minimum(c3, 0), 0.0, sem=\"acquire\")\r\n    mean = total / N\r\n    var = totsq / N - mean * mean\r\n    rstd = 1.0 / tl.sqrt(var + eps)\r\n    y = (x - mean) * rstd\r\n    tl.store(Y + row * N + offs, y)\r\n\r\ndev = 'cuda'\r\ntorch.manual_seed(42)\r\nshape = (16, 64, 256, 256)\r\nnshape = shape[1:]\r\nx = torch.rand(shape, device=dev)\r\neps = 1e-5\r\nN = 64 * 256 * 256\r\nM = 16\r\nwith torch.no_grad():\r\n    ref = F.layer_norm(x, nshape, torch.ones(nshape, device=dev), torch.zeros(nshape, device=dev), eps)\r\n    f = timing.get_timing_function('cuda_event')\r\n    y = torch.empty_like(x)\r\n    for (S, warps) in [(128, 32), (128, 16),"]
[913.215997, "o", " (256, 16), (256, 32), (64, 16), (512, 16), (128, 8)]:\r\n        bad = 0\r\n        worst = 0.0\r\n        for rep in range(200):\r\n            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\r\n            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\r\n            _spi"]
[913.216063, "o", "n4[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\r\n            d = (ref - y).abs().max().item()\r\n            worst = max(worst, d)\r\n            if d > 1e-4:\r\n                bad += 1\r\n        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\r\n        cnt = tor"]
[913.216107, "o", "ch.zeros(M, device=dev, dtype=torch.int32)\r\n        def fn(a):\r\n            fsum.zero_(); cnt.zero_()\r\n            _spin4[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\r\n        t = "]
[913.216134, "o", "f(fn, [x], num_trials=50, verbose=False, device=dev)\r\n        st = timing.get_timing_stats(t)\r\n  "]
[913.21615, "o", "      print(f'S="]
[913.216158, "o", "{S} w="]
[913.216166, "o", "{warps}: bad={bad}/200 worst={worst:.2e} mean={st[\"mean\"]} ms')\r\nEOF\r\ngpu push sb-8zRwUedISca"]
