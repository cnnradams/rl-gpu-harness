[1094.443251, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _spin7(X, Y, FSUM, CNT, N, eps,\n           S: tl.constexpr, CHUNK: tl.constexpr, NS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    c = tl.atomic_add(CNT + row, 1, sem=\"release\")\n    while c < S:\n        tl.inline_asm_elementwise(\"nanosleep.u32 $1; mov.u32 $0, 0;\", \"=r,r\", [NS], dtype=tl.int32, is_pure=False, pack=1)\n        c = tl.atomic_add(CNT + row, 0, sem=\"acquire\")\n    total = tl.atomic_add(FSUM + 2 * row, 0.0, sem=\"acquire\")\n    totsq = tl.atomic_add(FSUM + 2 * row + 1, 0.0, sem=\"acquire\")\n    mean = total / N\n    var = tots"]
[1094.443298, "i", "q / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\nx = torch.rand(shape, device=dev)\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\nwith torch.no_grad():\n    ref = F.layer_norm(x, nshape, torch.ones(nshape, device=dev), torch.zeros(nshape, device=dev), eps)\n    f = timing.get_timing_function('cuda_event')\n    y = torch.empty_like(x)\n    for (S, warps, ns) in [(128, 32, 0), (128, 32, 128), (128, 32, 512), (256, 16, 256), (256, 16, 512), (512, 8, 256), (256, 8, 256), (128, 16, 256), (512, 16, 256)]:\n        bad = 0\n        worst = 0.0\n        for rep in range(200):\n            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n            _spin7[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, NS=ns, num_warps=warps)\n            d = (ref - y).abs().max().item()\n            worst = max(worst, d)\n    "]
[1094.443408, "i", "        if d > 1e-4:\n                bad += 1\n        fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n        cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n        def fn(a):\n            fsum.zero_(); cnt.zero_()\n            _spin7[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, NS=ns, num_warps=warps)\n        t = f(fn, [x], num_trials=50, verbose=False, device=dev)\n        st = timing.get_timing_stats(t)\n        print(f'S={S} w={warps} ns={ns}: bad={bad}/200 worst={worst:.2e} mean={st[\"mean\"]} ms')\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/bench7.py /workspace/bench7.py && gpu exec sb-8zRwUedIScafc4d6DtsERm -- python3 /workspace/bench7.py\n"]
[1094.443418, "o", "cat > /workspace/bench7.py << 'EOF'\r\n\u001b[?2004l\r"]
