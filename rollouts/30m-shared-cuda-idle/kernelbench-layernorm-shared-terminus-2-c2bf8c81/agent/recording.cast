[330.767458, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _partial(X, FSUM, N, S: tl.constexpr, CHUNK: tl.constexpr, VEC: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    base = X + row * N + sid * CHUNK\n    s = 0.0\n    sq = 0.0\n    for i in tl.static_range(0, CHUNK, VEC):\n        x = tl.load(base + i + tl.arange(0, VEC))\n        s += tl.sum(x, axis=0)\n        sq += tl.sum(x * x, axis=0)\n    tl.store(FSUM + (row * 2) * S + sid, s)\n    tl.store(FSUM + (row * 2 + 1) * S + sid, sq)\n\n@triton.jit\ndef _normalize(X, Y, W, B, FSUM, N, eps, S: tl.constexpr, CHUNK: tl.constexpr, VEC: tl.constexpr, AFF: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs_s = tl.arange(0, S)\n    s = tl.load(FSUM + (row * 2) * S + offs_s)\n    sq = tl.load(FSUM + (row * 2 + 1) * S + offs_s)\n    total = tl.sum(s, axis=0)\n    tot"]
[330.76752, "i", "sq = tl.sum(sq, axis=0)\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base_x = X + row * N + sid * CHUNK\n    base_y = Y + row * N + sid * CHUNK\n    for i in tl.static_range(0, CHUNK, VEC):\n        o = i + tl.arange(0, VEC)\n        x = tl.load(base_x + o)\n        if AFF:\n            w = tl.load(W + sid * CHUNK + o)\n            b = tl.load(B + sid * CHUNK + o)\n            y = (x - mean) * rstd * w + b\n        else:\n            y = (x - mean) * rstd\n        tl.store(base_y + o, y)\n\ndef ln2k(x, w, b, eps, S, VEC, warps):\n    N = w.numel()\n    M = x.numel() // N\n    CHUNK = N // S\n    y = torch.empty_like(x)\n    fsum = torch.empty(2 * M * S, device=x.device, dtype=torch.float32)\n    _partial[(M * S,)](x, fsum, N, S=S, CHUNK=CHUNK, VEC=VEC, num_warps=warps)\n    _normalize[(M * S,)](x, y, w, b, fsum, N, eps, S=S, CHUNK=CHUNK, VEC=VEC, AFF=True, num_warps=warps)\n    return y\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\nx = torch.ran"]
[330.767617, "i", "d(shape, device=dev)\nw = torch.ones(nshape, device=dev)\nb = torch.zeros(nshape, device=dev)\neps = 1e-5\n\nwith torch.no_grad():\n    ref = F.layer_norm(x, nshape, w, b, eps)\n    f = timing.get_timing_function('cuda_event')\n\n    # roofline: pure copy\n    y = torch.empty_like(x)\n    t = f(lambda a: y.copy_(a), [x], num_trials=30, verbose=False, device=dev)\n    print('copy ms:', timing.get_timing_stats(t)['mean'])\n\n    for (S, VEC, warps) in [(64, 8192, 8), (128, 8192, 8), (128, 8192, 16), (128, 4096, 4), (256, 8192, 8), (128, 16384, 16), (64, 4096, 4), (256, 4096, 8), (512, 8192, 8)]:\n        out = ln2k(x, w, b, eps, S, VEC, warps)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        diff = (ref - out).abs().max().item()\n        t = f(lambda a: ln2k(a, w, b, eps, S, VEC, warps), [x], num_trials=30, verbose=False, device=dev)\n        st = timing.get_timing_stats(t)\n        print(f'S={S} VEC={VEC} w={warps}: ok={ok} diff={diff:.2e} mean={st[\"mean\"]} ms')\nEOF\ngpu exec sb-8zRwUedIScafc4d6DtsERm -- pytho"]
[330.7677, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r"]
[330.767739, "i", "n3 /workspace/bench2.py\n"]
[330.767764, "o", "\u001b[?2004h> sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[330.76779, "o", "\u001b[?2004h> "]
[330.767828, "o", "import triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.767856, "o", "> "]
[330.767881, "o", "from kernelbench import timing\r\n\u001b[?2004l\r"]
[330.767907, "o", "\u001b[?2004h> "]
[330.767931, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r"]
[330.767955, "o", "\u001b[?2004h> \r\n"]
[330.767977, "o", "\u001b[?2004l\r\u001b[?2004h"]
[330.767997, "o", "> "]
[330.768021, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.768123, "o", "def _partial(X, FSUM, N, S: tl.constexpr, CHUNK: tl.constexpr, VEC: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.768154, "o", "> "]
[330.768175, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.768214, "o", "    row = pid // S\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.76824, "o", ">     sid = pid % S\r\n\u001b[?2004l\r"]
[330.768265, "o", "\u001b[?2004h> "]
[330.768308, "o", "    base = X + row * N + sid * CHUNK\r\n\u001b[?2004l\r"]
[330.768334, "o", "\u001b[?2004h> "]
[330.768359, "o", "    s = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.768385, "o", "    sq = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.768408, "o", "> "]
[330.768447, "o", "    for i in tl.static_range(0, CHUNK, VEC):\r\n\u001b[?2004l\r"]
[330.768469, "o", "\u001b[?2004h> "]
[330.768522, "o", "        x = tl.load(base + i + tl.arange(0, VEC))\r\n\u001b[?2004l\r"]
[330.768551, "o", "\u001b[?2004h> "]
[330.76858, "o", "        s += tl.sum(x, axis=0)\r\n\u001b[?2004l\r"]
[330.768607, "o", "\u001b[?2004h> "]
[330.768642, "o", "        sq += tl.sum(x * x, axis=0)\r\n\u001b[?2004l\r"]
[330.768667, "o", "\u001b[?2004h> "]
[330.768719, "o", "    tl.store(FSUM + (row * 2) * S + sid, s)\r\n\u001b[?2004l\r"]
[330.768744, "o", "\u001b[?2004h> "]
[330.768794, "o", "    tl.store(FSUM + (row * 2 + 1) * S + sid, sq)\r\n\u001b[?2004l\r"]
[330.768822, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.768853, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.768996, "o", "def _normalize(X, Y, W, B, FSUM, N, eps, S: tl.constexpr, CHUNK: tl.constexpr, VEC: tl.constexpr, AFF: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.769042, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[330.769063, "o", "\u001b[?2004h> "]
[330.769089, "o", "    row = pid // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.769116, "o", "    sid = pid % S\r\n\u001b[?2004l\r"]
[330.769141, "o", "\u001b[?2004h> "]
[330.769172, "o", "    offs_s = tl.arange(0, S)\r\n\u001b[?2004l\r"]
[330.769197, "o", "\u001b[?2004h> "]
[330.769246, "o", "    s = tl.load(FSUM + (row * 2) * S + offs_s)\r\n\u001b[?2004l\r"]
[330.76927, "o", "\u001b[?2004h> "]
[330.769322, "o", "    sq = tl.load(FSUM + (row * 2 + 1) * S + offs_s)\r\n\u001b[?2004l\r"]
[330.769344, "o", "\u001b[?2004h> "]
[330.769377, "o", "    total = tl.sum(s, axis=0)\r\n\u001b[?2004l\r"]
[330.769402, "o", "\u001b[?2004h> "]
[330.769435, "o", "    totsq = tl.sum(sq, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.769458, "o", "> "]
[330.769493, "o", "    mean = total / N\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.769528, "o", "> "]
[330.769555, "o", "    var = totsq / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.769673, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h>     base_x = X + row * N + sid * CHUNK\r\n\u001b[?2004l\r"]
[330.769697, "o", "\u001b[?2004h> "]
[330.769753, "o", "    base_y = Y + row * N + sid * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.769792, "o", "    for i in tl.static_range(0, CHUNK, VEC):\r\n\u001b[?2004l\r"]
[330.769831, "o", "\u001b[?2004h> "]
[330.769868, "o", "        o = i + tl.arange(0, VEC)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.769903, "o", "        x = tl.load(base_x + o)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.769941, "o", ">         if AFF:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.77, "o", "            w = tl.load(W + sid * CHUNK + o)\r\n\u001b[?2004l\r"]
[330.770017, "o", "\u001b[?2004h> "]
[330.770077, "o", "            b = tl.load(B + sid * CHUNK + o)\r\n\u001b[?2004l\r"]
[330.770116, "o", "\u001b[?2004h> "]
[330.770155, "o", "            y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770194, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770233, "o", "            y = (x - mean) * rstd\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.770271, "o", "> "]
[330.77031, "o", "        tl.store(base_y + o, y)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[330.77035, "o", "> "]
[330.770389, "o", "def ln2k(x, w, b, eps, S, VEC, warps):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770428, "o", "    N = w.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770468, "o", "    M = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770508, "o", "    CHUNK = N // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770546, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770632, "o", "    fsum = torch.empty(2 * M * S, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.770648, "o", "> "]
[330.770743, "o", "    _partial[(M * S,)](x, fsum, N, S=S, CHUNK=CHUNK, VEC=VEC, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.77088, "o", "    _normalize[(M * S,)](x, y, w, b, fsum, N, eps, S=S, CHUNK=CHUNK, VEC=VEC, AFF=True, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.77092, "o", "    return y\r\n\u001b[?2004l\r"]
[330.77096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.770998, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771036, "o", "shape = (16, 64, 256, 256)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.771078, "o", "> nshape = shape[1:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.771121, "o", "> x = torch.rand(shape, device=dev)\r\n"]
[330.771163, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[330.771202, "o", "w = torch.ones(nshape, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771239, "o", "b = torch.zeros(nshape, device=dev)\r\n\u001b[?2004l\r"]
[330.771277, "o", "\u001b[?2004h> eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.771315, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771353, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771402, "o", "    ref = F.layer_norm(x, nshape, w, b, eps)\r\n\u001b[?2004l\r"]
[330.771441, "o", "\u001b[?2004h> "]
[330.77148, "o", "    f = timing.get_timing_function('cuda_event')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[330.77152, "o", "\u001b[?2004h> "]
[330.771559, "o", "    # roofline: pure copy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771606, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771691, "o", "    t = f(lambda a: y.copy_(a), [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.771731, "o", "> "]
[330.771768, "o", "    print('copy ms:', timing.get_timing_stats(t)['mean'])\r\n\u001b[?2004l\r"]
[330.771807, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.771991, "o", "    for (S, VEC, warps) in [(64, 8192, 8), (128, 8192, 8), (128, 8192, 16), (128, 4096, 4), (256, 8192, 8), (128, 16384, 16), (64, 4096, 4), (256, 4096, 8), (512, 8192, 8)]:\r\n\u001b[?2004l\r"]
[330.772034, "o", "\u001b[?2004h> "]
[330.772073, "o", "        out = ln2k(x, w, b, eps, S, VEC, warps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.772148, "o", "        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[330.772187, "o", "\u001b[?2004h> "]
[330.772227, "o", "        diff = (ref - out).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.772346, "o", "        t = f(lambda a: ln2k(a, w, b, eps, S, VEC, warps), [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[330.772382, "o", "\u001b[?2004h> "]
[330.772422, "o", "        st = timing.get_timing_stats(t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.77253, "o", "        print(f'S={S} VEC={VEC} w={warps}: ok={ok} diff={diff:.2e} mean={st[\"mean\"]} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.772569, "o", "> EOF\r\n\u001b[?2004l\r"]
