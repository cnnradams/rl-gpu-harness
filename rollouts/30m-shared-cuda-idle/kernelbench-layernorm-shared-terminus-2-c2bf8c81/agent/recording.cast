[982.148156, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom kernelbench import timing\nimport torch.nn.functional as F\n\n@triton.jit\ndef _poll_val(ptr, wid):\n    v = tl.zeros((), dtype=tl.int32) + 1000000000\n    v = tl.where(wid == 0, tl.atomic_add(ptr, 0, sem=\"acquire\"), v)\n    return tl.minimum(v, 1000000000)\n\n@triton.jit\ndef _spin5(X, Y, FSUM, CNT, N, eps,\n           S: tl.constexpr, CHUNK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    tl.atomic_add(CNT + row, 1, sem=\"release\")\n    wid = tl.program_id(1) * 0 + tl.arange(0, 1)[0] * 0\n    c = _poll_val(CNT + row, wid)\n    while c < S:\n        c = _poll_val(CNT + row, wid)\n    total = tl.atomic_add(FSUM + 2 * row, "]
[982.148204, "i", "0.0, sem=\"acquire\")\n    totsq = tl.atomic_add(FSUM + 2 * row + 1, 0.0, sem=\"acquire\")\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\n@triton.jit\ndef _acq_ld(ptr):\n    return tl.inline_asm_elementwise(\n        \"ld.acquire.gpu.global.b32 $0, [$1];\",\n        \"=r,l\",\n        [ptr],\n        dtype=tl.int32,\n        is_pure=False,\n        pack=1,\n    )\n\n@triton.jit\ndef _spin6(X, Y, FSUM, CNT, N, eps,\n           S: tl.constexpr, CHUNK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    sid = pid % S\n    offs = sid * CHUNK + tl.arange(0, CHUNK)\n    x = tl.load(X + row * N + offs)\n    s = tl.sum(x, axis=0)\n    sq = tl.sum(x * x, axis=0)\n    tl.atomic_add(FSUM + 2 * row, s, sem=\"release\")\n    tl.atomic_add(FSUM + 2 * row + 1, sq, sem=\"release\")\n    tl.atomic_add(CNT + row, 1, sem=\"release\")\n    c = _acq_ld(CNT + row)\n    while c < S:\n        c = _acq_ld(CNT + row)\n    total = tl.atomic_add(FSUM + 2 * "]
[982.148211, "i", "row, 0.0, sem=\"acquire\")\n    totsq = tl.atomic_add(FSUM + 2 * row + 1, 0.0, sem=\"acquire\")\n    mean = total / N\n    var = totsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    y = (x - mean) * rstd\n    tl.store(Y + row * N + offs, y)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nshape = (16, 64, 256, 256)\nnshape = shape[1:]\nx = torch.rand(shape, device=dev)\neps = 1e-5\nN = 64 * 256 * 256\nM = 16\nwith torch.no_grad():\n    ref = F.layer_norm(x, nshape, torch.ones(nshape, device=dev), torch.zeros(nshape, device=dev), eps)\n    f = timing.get_timing_function('cuda_event')\n    y = torch.empty_like(x)\n    for (name, kern) in [('1warp', _spin5), ('ptx', _spin6)]:\n        for (S, warps) in [(128, 32), (256, 16), (128, 16)]:\n            bad = 0\n            worst = 0.0\n            for rep in range(200):\n                fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n                cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n                kern[(M * S,)](x, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_"]
[982.148226, "i", "warps=warps)\n                d = (ref - y).abs().max().item()\n                worst = max(worst, d)\n                if d > 1e-4:\n                    bad += 1\n            fsum = torch.zeros(2 * M, device=dev, dtype=torch.float32)\n            cnt = torch.zeros(M, device=dev, dtype=torch.int32)\n            def fn(a):\n                fsum.zero_(); cnt.zero_()\n                kern[(M * S,)](a, y, fsum, cnt, N, eps, S=S, CHUNK=N // S, num_warps=warps)\n            t = f(fn, [x], num_trials=50, verbose=False, device=dev)\n            st = timing.get_timing_stats(t)\n            print(f'{name} S={S} w={warps}: bad={bad}/200 worst={worst:.2e} mean={st[\"mean\"]} ms')\nEOF\ngpu push sb-8zRwUedIScafc4d6DtsERm /workspace/bench6.py /workspace/bench6.py && gpu exec sb-8zRwUedIScafc4d6DtsERm -- python3 /workspace/bench6.py\n"]
