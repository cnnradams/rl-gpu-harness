[?2004ls[?2004h> @triton.jit
[?2004l[?2004h> def _split3_kernel(X, H, M, L, n_elements, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)
