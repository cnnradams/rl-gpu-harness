[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _mm_split_kernel(
[?2004l[?2004h>     AH, AM, AL, BH, BM_, BL, BIAS, C,
[?2004l[?2004h>     M, N, K,
[?2004l[?2004h>     sam, sak, sbk, sbn, scm, scn,
