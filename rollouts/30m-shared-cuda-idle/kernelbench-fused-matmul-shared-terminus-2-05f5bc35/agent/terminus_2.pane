[?2004l[?2004h> import torch, sys
[?2004l[?2004h> sys.path.insert(0, '/workspace')
[?2004l[?2004h> from solution import ModelNew
[?2004l[?2004h> 
[?2004l[?2004h> torch.manual_seed(42)
[?2004l[?2004h> batch, inf, outf, sf = 16384, 4096, 4096, 0.5
[?2004l[?2004h> ref = torch.nn.Linear(inf, outf).cuda()
[?2004l[?2004h> with torch.no_grad():
[?2004l[?2004h>     W = ref.weight.clone(); b = ref.bias.clone()
[?2004l[?2004h> 
[?2004l[?2004h> def ref_fn(x):
[?2004l[?2004h>     y = torch.nn.functional.linear(x, W, b)
[?2004l[?2004h>     return y * sf + y
[?2004l[?2004h> 
[?2004l[?2004h> torch.manual_seed(42)
[?2004l[?2004h> m = ModelNew(inf, outf, sf).cuda()
[?2004l[?2004h> assert torch.equal(m.matmul.weight, W), 'weights differ!'
[?2004l[?2004h> 
[?2004l[?2004h> for ndot in (3, 6):
[?2004l[?2004h>     m.ndot = ndot
[?2004l[?2004h>     worst = 0.0; worst_ratio = 0.0
[?2004l[?2004h>     for t in range(5):
[?2004l[?2004h>         torch.manual_seed(200 + t)
[?2004l[?2004h>         x = torch.rand(batch, inf, device='cuda')
[?2004l[?2004h>         with torch.no_grad():
[?2004l[?2004h>             y = ref_fn(x)
[?2004l[?2004h>             y2 = m(x).clone()
[?2004l[?2004h>         err = (y - y2).abs()
[?2004l[?2004h>         bound = 1e-4 + 1e-4 * y.abs()
[?2004l[?2004h>         ratio = (err / bound).max().item()
[?2004l[?2004h>         worst = max(worst, err.max().item()); worst_ratio = max(worst_ratio, ratio)
[?2004l[?2004h>     print(f'NDOT={ndot}: worst max_err={worst:.3e} worst err/bound={worst_ratio:.3f} (must be < 1)')
[?2004l[?2004h> 
