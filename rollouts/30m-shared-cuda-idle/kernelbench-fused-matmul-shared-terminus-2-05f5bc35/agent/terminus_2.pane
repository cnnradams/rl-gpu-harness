[?2004l[?2004h>         ah_ptrs += BK * sak
[?2004l[?2004h>         am_ptrs += BK * sak
[?2004l[?2004h>         al_ptrs += BK * sak
[?2004l[?2004h>         bh_ptrs += BK * sbk
[?2004l[?2004h>         bm_ptrs += BK * sbk
[?2004l[?2004h>         bl_ptrs += BK * sbk
[?2004l[?2004h> 
[?2004l[?2004h>     bias = tl.load(BIAS + rn, mask=rn < N, other=0.0).to(tl.float32)
[?2004l[?2004h>     acc = acc + bias[None, :]
