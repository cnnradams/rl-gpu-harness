[1633.577922, "o", "A = torch.rand(16384, 8192, device='cuda').half()\r\n\u001b[?2004l\r"]
[1633.577964, "o", "\u001b[?2004h> "]
[1633.578004, "o", "B = torch.randn(8192, 4096, device='cuda').half() * 1e-3\r\n\u001b[?2004l\r"]
[1633.578045, "o", "\u001b[?2004h> "]
[1633.578086, "o", "bias = torch.randn(4096, device='cuda') * 0.03\r\n\u001b[?2004l\r\u001b[?2004h"]
[1633.578127, "o", "> "]
[1633.578185, "o", "out = torch.empty(16384, 4096, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1633.578227, "o", "> "]
[1633.578267, "o", "grid = (triton.cdiv(16384,128)*triton.cdiv(4096,256),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1633.578333, "o", "mm2[grid](A, B, bias, out, 16384, 4096, 4096,\r\n\u001b[?2004l\r"]
[1633.578374, "o", "\u001b[?2004h> "]
[1633.578423, "o", "          A.stride(0), A.stride(1), B.stride(0), B.stride(1),\r\n\u001b[?2004l\r"]
[1633.578465, "o", "\u001b[?2004h> "]
