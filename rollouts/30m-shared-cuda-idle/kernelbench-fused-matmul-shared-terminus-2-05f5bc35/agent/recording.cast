[748.95036, "o", "\r\nNDOT=6: worst max_err=4.768e-05 worst err/bound=0.244 (must be < 1)\r\nref: 11.160 ms (best 11.072)\r\nNDOT=3: 2.479 ms (best 2.472) speedup 4.50x\r\nNDOT=6: 4.709 ms (best 4.689) speedup 2.37x\r\n"]
[750.036053, "o", "\u001b[?2004hroot@modal:/# "]
[869.516813, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, sys, itertools\nimport triton, triton.language as tl\nprint('torch', torch.__version__, 'triton', triton.__version__)\nprint(torch.cuda.get_device_name(0))\n\nbatch, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(batch, K, device=dev)\nxh = torch.empty((batch, K), device=dev, dtype=torch.float16)\nxm = torch.empty_like(xh); xl = torch.empty_like(xh)\nwh = torch.randn(K, N, device=dev).half() * 0.008\nwm = torch.randn_like(wh) * 1e-4\nwl = torch.randn_like(wh) * 1e-6\nbias = torch.randn(N, device=dev) * 0.03\nout = torch.empty((batch, N), device=dev, dtype=torch.float32)\n\nfrom solution import _split3_kernel\nn = x.numel()\n\ndef timeit(fn, n_iter=20):\n    scratch = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n_iter):\n        torch.cuda.synchronize(); scratch.uniform_(); torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event("]
[869.51686, "i", "enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nt_split = timeit(lambda: _split3_kernel[(triton.cdiv(n, 4096),)](x, xh, xm, xl, n, BLOCK=4096, num_warps=8))\nprint(f'split3 kernel: {t_split:.3f} ms')\n\n@triton.jit\ndef mm3(AH, AM, BH, BM_, BIAS, C, M, N, K,\n        sam, sak, sbk, sbn, scm, scn,\n        GROUP_M: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM); rn = pid_n * BN + tl.arange(0, BN); rk = tl.arange(0, BK)\n    ah_ptrs = AH + (rm[:, None] % M) * sam + rk[None, :] * sak\n    am_ptrs = AM + (rm[:, None] % M) * sam + rk[None, :] * sak\n    bh_ptrs = BH"]
[869.516869, "i", " + rk[:, None] * sbk + (rn[None, :] % N) * sbn\n    bm_ptrs = BM_ + rk[:, None] * sbk + (rn[None, :] % N) * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        ah = tl.load(ah_ptrs); bh = tl.load(bh_ptrs)\n        am = tl.load(am_ptrs); bm = tl.load(bm_ptrs)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bm, acc)\n        acc = tl.dot(am, bh, acc)\n        ah_ptrs += BK * sak; am_ptrs += BK * sak; bh_ptrs += BK * sbk; bm_ptrs += BK * sbk\n    bias = tl.load(BIAS + rn, mask=rn < N, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc, mask=(rm[:, None] < M) & (rn[None, :] < N))\n\n@triton.jit\ndef mm1(A, B, BIAS, C, M, N, K,\n        sam, sak, sbk, sbn, scm, scn,\n        GROUP_M: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // widt"]
[869.517001, "i", "h\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM); rn = pid_n * BN + tl.arange(0, BN); rk = tl.arange(0, BK)\n    a_ptrs = A + (rm[:, None] % M) * sam + rk[None, :] * sak\n    b_ptrs = B + rk[:, None] * sbk + (rn[None, :] % N) * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs); b = tl.load(b_ptrs)\n        acc = tl.dot(a, b, acc)\n        a_ptrs += BK * sak; b_ptrs += BK * sbk\n    bias = tl.load(BIAS + rn, mask=rn < N, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc, mask=(rm[:, None] < M) & (rn[None, :] < N))\n\nconfigs = []\nfor (bm, bn, bk) in [(128,128,64),(128,256,64),(256,128,64),(128,128,128),(128,256,32),(64,256,64),(256,64,64),(128,64,128),(256,256,32)]:\n    for w in (4, 8):\n        for st in (2,3,4,5):\n   "]
[869.517014, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[869.517101, "i", "         configs.append((bm,bn,bk,8,w,st))\n\nprint('--- mm3 (3 dots) ---')\nbest = None\nfor (bm,bn,bk,gm,w,st) in configs:\n    try:\n        grid = (triton.cdiv(batch,bm)*triton.cdiv(N,bn),)\n        fn = lambda: mm3[grid](xh, xm, wh, wm, bias, out, batch, N, K,\n              xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1),\n              out.stride(0), out.stride(1), GROUP_M=gm, BM=bm, BN=bn, BK=bk,\n              num_warps=w, num_stages=st)\n        t = timeit(fn, 10)\n        print(f'BM{bm} BN{bn} BK{bk} w{w} s{st}: {t:.3f} ms')\n        if best is None or t < best[0]: best = (t, (bm,bn,bk,gm,w,st))\n    except Exception as ex:\n        print(f'BM{bm} BN{bn} BK{bk} w{w} s{st}: FAIL {type(ex).__name__}')\nprint('best mm3:', best)\nEOF\ngpu sync\n"]
