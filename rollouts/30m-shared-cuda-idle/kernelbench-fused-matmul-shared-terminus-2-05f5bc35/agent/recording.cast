[512.388922, "o", "\u001b[?2004h> "]
[512.389016, "o", "        worst = max(worst, err.max().item()); worst_ratio = max(worst_ratio, ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.389136, "o", "    print(f'NDOT={ndot}: worst max_err={worst:.3e} worst err/bound={worst_ratio:.3f} (must be < 1)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.389149, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[512.389181, "o", "> "]
[512.389205, "o", "def timeit(fn, x, n=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.38931, "o", "    scratch = torch.empty(256 * 1024 * 1024 // 4, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.389339, "o", "> "]
[512.389366, "o", "    for _ in range(5): fn(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.38939, "o", "> "]
[512.389414, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.389442, "o", "    ts = []\r\n\u001b[?2004l\r"]
[512.389466, "o", "\u001b[?2004h> "]
[512.389493, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.38954, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[512.389568, "o", "\u001b[?2004h> "]
[512.389596, "o", "        scratch.uniform_()\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.38962, "o", "> "]
[512.389644, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.389668, "o", "> "]
[512.389761, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.389787, "o", "> "]
[512.389813, "o", "        s.record(); fn(x); e.record()\r\n\u001b[?2004l\r"]
[512.389838, "o", "\u001b[?2004h> "]
[512.389875, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[512.389906, "o", "\u001b[?2004h> "]
