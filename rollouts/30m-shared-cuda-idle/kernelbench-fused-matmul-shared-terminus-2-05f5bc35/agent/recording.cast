[1329.797689, "o", ".b8 0                                   // End Of Children Mark\r\n.b8 0                                   // End Of Children Mark\r\n\t}\r\n\t.section\t.debug_macinfo\t{\t}\r\n\r\n================================================================\r\nplease share the reproducer above with Triton project.\r\n\r\nNDOT=2 (drop ah.bm): worst err/bound over 10 seeds = 5.485 (must be <1)\r\nsplit2: 0.206 ms, split3: 0.254 ms\r\n"]
[1329.798154, "o", "\u001b[?2004hroot@modal:/# "]
[1384.914057, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\n\nbatch, K, N = 16384, 4096, 4096\ndev = 'cuda'\n\n@triton.jit\ndef mm2(A, B, BIAS, C, M, N, K,\n        sam, sak, sbk, sbn, scm, scn,\n        GROUP_M: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM); rn = pid_n * BN + tl.arange(0, BN); rk = tl.arange(0, BK)\n    a_ptrs = A + (rm[:, None] % M) * sam + rk[None, :] * sak\n    am_ptrs = A + (rm[:, None] % M) * sam + (K + rk[None, :]) * sak\n    b_ptrs = B + rk[:, None] * sbk + (rn[None, :] % N) * sbn\n    bm_ptrs = B + (K + rk[:, None]) * sbk + (rn[None, :] % N) * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0"]
[1384.914109, "i", ", tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs)\n        am = tl.load(am_ptrs)\n        b = tl.load(b_ptrs)\n        bm = tl.load(bm_ptrs)\n        bc = tl.join(b, bm, can_reorder=True)\n        acc = tl.dot(a, bc, acc)\n        acc = tl.dot(am, b, acc)\n        a_ptrs += BK * sak; am_ptrs += BK * sak\n        b_ptrs += BK * sbk; bm_ptrs += BK * sbk\n    bias = tl.load(BIAS + rn, mask=rn < N, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc, mask=(rm[:, None] < M) & (rn[None, :] < N))\n\ndef timeit(fn, n_iter=20):\n    scratch = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n_iter):\n        torch.cuda.synchronize(); scratch.uniform_(); torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.el"]
[1384.914116, "i", "apsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nxh = torch.rand(batch, K, device=dev).half()\nWh = torch.randn(N, K, device=dev).half() * 0.008\n# torch mm fp16 out vs fp32 out\nout16 = torch.empty(batch, N, device=dev, dtype=torch.float16)\nt16 = timeit(lambda: torch.mm(xh, Wh.t(), out=out16))\nt32 = timeit(lambda: torch.mm(xh, Wh.t()))\nprint(f'torch mm fp16out: {t16:.3f} ms, fp32out: {t32:.3f} ms')\n\nA = torch.cat([xh, (torch.rand(batch, K, device=dev).half() * 1e-3)], dim=1).contiguous()\nB = torch.cat([Wh.t().contiguous(), (torch.randn(K, N, device=dev).half() * 1e-4)], dim=0).contiguous()\nbias = torch.randn(N, device=dev) * 0.03\nout = torch.empty(batch, N, device=dev, dtype=torch.float32)\n\nfor (bm,bn,bk,gm,w,st) in [(128,256,32,8,8,3),(128,256,64,8,8,3),(128,256,64,8,8,2),(128,128,64,8,8,3),(256,128,32,8,8,3),(128,256,32,8,8,4),(256,256,32,8,8,3),(128,128,32,8,4,4)]:\n    try:\n        grid = (triton.cdiv(batch,bm)*triton.cdiv(N,bn),)\n        fn = lambda: mm2[grid](A, B, bias, out, batch, N, K,\n             "]
[1384.914238, "i", " A.stride(0), A.stride(1), B.stride(0), B.stride(1),\n              out.stride(0), out.stride(1), GROUP_M=gm, BM=bm, BN=bn, BK=bk,\n              num_warps=w, num_stages=st)\n        t = timeit(fn, 10)\n        print(f'mm2 BM{bm} BN{bn} BK{bk} w{w} s{st}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'mm2 BM{bm} BN{bn} BK{bk} w{w} s{st}: FAIL {type(ex).__name__}')\nEOF\ngpu sync && gpu stop sb-Fq7T6uilEoEu8rQBVHiXIt && gpu run --detach -- sleep 3600\n"]
