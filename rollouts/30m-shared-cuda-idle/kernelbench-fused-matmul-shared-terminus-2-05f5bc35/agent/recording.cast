[1633.578564, "o", "\u001b[?2004h> "]
[1633.578605, "o", "          num_warps=8, num_stages=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1633.578645, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1633.578741, "o", "# correctness vs reference: A[:, :K] @ B[:K] + A[:, K:] @ B[:K] + A[:, :K] @ B[K:]\r\n\u001b[?2004l\r"]
[1633.578757, "o", "\u001b[?2004h> "]
[1633.578799, "o", "K = 4096\r\n\u001b[?2004l\r"]
[1633.578841, "o", "\u001b[?2004h> "]
[1633.578927, "o", "ref = A[:, :K].float() @ B[:K].float() + A[:, K:].float() @ B[:K].float() + A[:, :K].float() @ B[K:].float() + bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[1633.57897, "o", "> "]
[1633.579011, "o", "print('mm2 ok, err:', (ref - out).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1633.57903, "o", "EOF\r\n\u001b[?2004l\r"]
