[1633.577134, "o", "        bc = tl.permute(bc, (0, 2, 1))\r\n\u001b[?2004l\r"]
[1633.577176, "o", "\u001b[?2004h> "]
[1633.577219, "o", "        bc = tl.reshape(bc, (BK, 2 * BN))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1633.577263, "o", "        acc = tl.dot(a, bc, acc)\r\n\u001b[?2004l\r"]
[1633.57731, "o", "\u001b[?2004h> "]
[1633.577329, "o", "        acc = tl.dot(am, b, acc)\r\n\u001b[?2004l\r"]
[1633.57737, "o", "\u001b[?2004h> "]
[1633.577413, "o", "        a_ptrs += BK * sak; am_ptrs += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
