[1633.575062, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef mm2(A, B, BIAS, C, M, N, K,\n        sam, sak, sbk, sbn, scm, scn,\n        GROUP_M: tl.constexpr, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM); rn = pid_n * BN + tl.arange(0, BN); rk = tl.arange(0, BK)\n    a_ptrs = A + (rm[:, None] % M) * sam + rk[None, :] * sak\n    am_ptrs = A + (rm[:, None] % M) * sam + (K + rk[None, :]) * sak\n    b_ptrs = B + rk[:, None] * sbk + (rn[None, :] % N) * sbn\n    bm_ptrs = B + (K + rk[:, None]) * sbk + (rn[None, :] % N) * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs"]
[1633.575113, "i", ")\n        am = tl.load(am_ptrs)\n        b = tl.load(b_ptrs)\n        bm = tl.load(bm_ptrs)\n        bc = tl.join(b, bm)\n        bc = tl.permute(bc, (0, 2, 1))\n        bc = tl.reshape(bc, (BK, 2 * BN))\n        acc = tl.dot(a, bc, acc)\n        acc = tl.dot(am, b, acc)\n        a_ptrs += BK * sak; am_ptrs += BK * sak\n        b_ptrs += BK * sbk; bm_ptrs += BK * sbk\n    bias = tl.load(BIAS + rn, mask=rn < N, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc, mask=(rm[:, None] < M) & (rn[None, :] < N))\n\nA = torch.rand(16384, 8192, device='cuda').half()\nB = torch.randn(8192, 4096, device='cuda').half() * 1e-3\nbias = torch.randn(4096, device='cuda') * 0.03\nout = torch.empty(16384, 4096, device='cuda', dtype=torch.float32)\ngrid = (triton.cdiv(16384,128)*triton.cdiv(4096,256),)\nmm2[grid](A, B, bias, out, 16384, 4096, 4096,\n          A.stride(0), A.stride(1), B.stride(0), B.stride(1),\n          out.stride(0), out.stride(1), GROUP_M=8, BM="]
[1633.575123, "i", "128, BN=256, BK=32,\n          num_warps=8, num_stages=3)\ntorch.cuda.synchronize()\n# correctness vs reference: A[:, :K] @ B[:K] + A[:, K:] @ B[:K] + A[:, :K] @ B[K:]\nK = 4096\nref = A[:, :K].float() @ B[:K].float() + A[:, K:].float() @ B[:K].float() + A[:, :K].float() @ B[K:].float() + bias\nprint('mm2 ok, err:', (ref - out).abs().max().item())\nEOF\ngpu sync; gpu stop sb-baxHOO6eINtHK7C24xT4L6; gpu run --detach -- sleep 3600\n"]
