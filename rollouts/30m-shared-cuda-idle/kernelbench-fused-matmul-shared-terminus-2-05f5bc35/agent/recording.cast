[869.524167, "o", "\u001b[?2004h> "]
[869.524207, "o", "    for w in (4, 8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.524251, "o", "        for st in (2,3,4,5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.524323, "o", "            configs.append((bm,bn,bk,8,w,st))\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.524367, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.524411, "o", "print('--- mm3 (3 dots) ---')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.524453, "o", "best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.524495, "o", "for (bm,bn,bk,gm,w,st) in configs:\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[869.524536, "o", "\u001b[?2004h> "]
[869.524578, "o", "        grid = (triton.cdiv(batch,bm)*triton.cdiv(N,bn),)\r\n\u001b[?2004l\r"]
[869.52462, "o", "\u001b[?2004h> "]
[869.524682, "o", "        fn = lambda: mm3[grid](xh, xm, wh, wm, bias, out, batch, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.524724, "o", "> "]
[869.52478, "o", "              xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.524829, "o", "> "]
[869.524883, "o", "              out.stride(0), out.stride(1), GROUP_M=gm, BM=bm, BN=bn, BK=bk,\r\n\u001b[?2004l\r"]
[869.524903, "o", "\u001b[?2004h> "]
[869.524957, "o", "              num_warps=w, num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.525001, "o", ">         t = timeit(fn, 10)\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.525043, "o", "> "]
[869.525086, "o", "        print(f'BM{bm} BN{bn} BK{bk} w{w} s{st}: {t:.3f} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.525127, "o", "> "]
[869.525182, "o", "        if best is None or t < best[0]: best = (t, (bm,bn,bk,gm,w,st))\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.525223, "o", ">     except Exception as ex:\r\n\u001b[?2004l\r"]
[869.525263, "o", "\u001b[?2004h> "]
[869.525334, "o", "        print(f'BM{bm} BN{bn} BK{bk} w{w} s{st}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.525376, "o", "> print('best mm3:', best)\r\n\u001b[?2004l\r"]
[869.525417, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[869.563743, "o", "\u001b[?2004hroot@modal:/# gpu sync\r\n\u001b[?2004l\r"]
