[1633.576871, "o", "\u001b[?2004h> "]
[1633.576921, "o", "        am = tl.load(am_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1633.57696, "o", "        b = tl.load(b_ptrs)\r\n\u001b[?2004l\r"]
[1633.577003, "o", "\u001b[?2004h> "]
