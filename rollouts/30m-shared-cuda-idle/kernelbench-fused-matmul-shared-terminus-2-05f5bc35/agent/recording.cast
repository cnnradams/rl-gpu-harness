[386.877705, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\nbatch, inf, outf, sf = 16384, 4096, 4096, 0.5\n\nref = torch.nn.Linear(inf, outf).cuda()\nwith torch.no_grad():\n    W = ref.weight.clone(); b = ref.bias.clone()\n\ndef ref_fn(x):\n    y = torch.nn.functional.linear(x, W, b)\n    return y * sf + y\n\ntorch.manual_seed(42)\nm = ModelNew(inf, outf, sf).cuda()\nassert torch.equal(m.matmul.weight, W), 'weights differ!'\n\nmaxerr = 0.0\nfor t in range(5):\n    torch.manual_seed(100 + t)\n    x = torch.rand(batch, inf, device='cuda')\n    with torch.no_grad():\n        y = ref_fn(x)\n        y2 = m(x)\n    err = (y - y2).abs().max().item()\n    tol = 1e-4 + 1e-4 * y.abs().max().item()\n    print(f'trial {t}: max_err={err:.3e} max|y|={y.abs().max().item():.2f} ok={err < tol}')\n    maxerr = max(maxerr, err)\n\n# timing\ndef timeit(fn, x, n=30):\n    scratch = torch.empty(256 * 1024 * 1024 // 4, device='cuda', dtype=torch.float32)\n    for _ in range(3)"]
[386.877755, "i", ": fn(x)\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        scratch.uniform_()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(x); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], min(ts)\n\nwith torch.no_grad():\n    x = torch.rand(batch, inf, device='cuda')\n    m_ref, b_ref = timeit(ref_fn, x)\n    m_new, b_new = timeit(lambda t: m(t), x)\n    xf = x.half()\n    Wh = (W * 1.5).half()\n    m_h, b_h = timeit(lambda t: torch.mm(t, Wh.t()), xf)\nprint(f'ref: {m_ref:.3f} ms (best {b_ref:.3f})')\nprint(f'new: {m_new:.3f} ms (best {b_new:.3f})  speedup {m_ref/m_new:.2f}x')\nprint(f'pure fp16 mm: {m_h:.3f} ms (best {b_h:.3f})')\nEOF\ngpu sync\n"]
