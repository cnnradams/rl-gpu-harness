[1483.861886, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\nexec(open('/workspace/bench4.py').read().split('def timeit')[0].replace(\"exec(open('/workspace/bench4.py'\", ''))\nA = torch.rand(16384, 8192, device='cuda').half()\nB = torch.randn(8192, 4096, device='cuda').half() * 1e-3\nbias = torch.randn(4096, device='cuda') * 0.03\nout = torch.empty(16384, 4096, device='cuda', dtype=torch.float32)\ngrid = (triton.cdiv(16384,128)*triton.cdiv(4096,256),)\nmm2[grid](A, B, bias, out, 16384, 4096, 4096,\n          A.stride(0), A.stride(1), B.stride(0), B.stride(1),\n          out.stride(0), out.stride(1), GROUP_M=8, BM=128, BN=256, BK=32,\n          num_warps=8, num_stages=3)\ntorch.cuda.synchronize()\nprint('mm2 ok')\nEOF\ngpu sync && gpu exec sb-1FtyAeUR0by5ItW5QLb8kz -- python3 /workspace/bench5.py 2>&1 | grep -v '^ \\|^\\.\\|^\\t\\|b8\\|b64\\|b32' | tail -30\n"]
