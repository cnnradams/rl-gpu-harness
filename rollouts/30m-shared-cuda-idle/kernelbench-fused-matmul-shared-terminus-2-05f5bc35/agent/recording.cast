[1384.917851, "o", "\u001b[?2004h> "]
[1384.917925, "o", "out16 = torch.empty(batch, N, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1384.917948, "o", "\u001b[?2004h> "]
[1384.918001, "o", "t16 = timeit(lambda: torch.mm(xh, Wh.t(), out=out16))\r\n\u001b[?2004l\r"]
[1384.918024, "o", "\u001b[?2004h> "]
[1384.918064, "o", "t32 = timeit(lambda: torch.mm(xh, Wh.t()))\r\n\u001b[?2004l\r"]
[1384.918087, "o", "\u001b[?2004h> "]
[1384.918149, "o", "print(f'torch mm fp16out: {t16:.3f} ms, fp32out: {t32:.3f} ms')\r\n\u001b[?2004l\r"]
[1384.918178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1384.918202, "o", "> "]
[1384.918279, "o", "A = torch.cat([xh, (torch.rand(batch, K, device=dev).half() * 1e-3)], dim=1).contiguous()\r\n\u001b[?2004l\r"]
[1384.918303, "o", "\u001b[?2004h> "]
[1384.918406, "o", "B = torch.cat([Wh.t().contiguous(), (torch.randn(K, N, device=dev).half() * 1e-4)], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[1384.918431, "o", "\u001b[?2004h> "]
[1384.918468, "o", "bias = torch.randn(N, device=dev) * 0.03\r\n\u001b[?2004l\r"]
[1384.918496, "o", "\u001b[?2004h> "]
[1384.918554, "o", "out = torch.empty(batch, N, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1384.918582, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1384.918606, "o", "> "]
[1384.918787, "o", "for (bm,bn,bk,gm,w,st) in [(128,256,32,8,8,3),(128,256,64,8,8,3),(128,256,64,8,8,2),(128,128,64,8,8,3),(256,128,32,8,8,3),(128,256,32,8,8,4),(256,256,32,8,8,3),(128,128,32,8,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1384.918816, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1384.91884, "o", "> "]
[1384.918893, "o", "        grid = (triton.cdiv(batch,bm)*triton.cdiv(N,bn),)\r\n\u001b[?2004l\r"]
[1384.918921, "o", "\u001b[?2004h> "]
[1384.918975, "o", "        fn = lambda: mm2[grid](A, B, bias, out, batch, N, K,\r\n\u001b[?2004l\r"]
[1384.919001, "o", "\u001b[?2004h> "]
[1384.919062, "o", "              A.stride(0), A.stride(1), B.stride(0), B.stride(1),\r\n\u001b[?2004l\r"]
[1384.919089, "o", "\u001b[?2004h> "]
[1384.919161, "o", "              out.stride(0), out.stride(1), GROUP_M=gm, BM=bm, BN=bn, BK=bk,\r\n\u001b[?2004l\r"]
[1384.919189, "o", "\u001b[?2004h> "]
[1384.919226, "o", "              num_warps=w, num_stages=st)\r\n\u001b[?2004l\r"]
[1384.919255, "o", "\u001b[?2004h> "]
[1384.919278, "o", "        t = timeit(fn, 10)\r\n\u001b[?2004l\r"]
[1384.919302, "o", "\u001b[?2004h> "]
[1384.919365, "o", "        print(f'mm2 BM{bm} BN{bn} BK{bk} w{w} s{st}: {t:.3f} ms')\r\n\u001b[?2004l\r"]
[1384.919389, "o", "\u001b[?2004h> "]
[1384.919416, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1384.919441, "o", "\u001b[?2004h> "]
[1384.919517, "o", "        print(f'mm2 BM{bm} BN{bn} BK{bk} w{w} s{st}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[1384.919545, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
