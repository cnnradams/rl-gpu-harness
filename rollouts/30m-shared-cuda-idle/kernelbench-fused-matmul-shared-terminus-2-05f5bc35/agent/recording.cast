[512.388243, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[512.388274, "o", "> "]
[512.388301, "o", "for ndot in (3, 6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[512.38833, "o", "    m.ndot = ndot\r\n\u001b[?2004l\r"]
[512.388354, "o", "\u001b[?2004h> "]
[512.388378, "o", "    worst = 0.0; worst_ratio = 0.0\r\n\u001b[?2004l\r"]
[512.388402, "o", "\u001b[?2004h> "]
[512.388426, "o", "    for t in range(5):\r\n\u001b[?2004l\r\u001b[?2004h"]
[512.38845, "o", "> "]
