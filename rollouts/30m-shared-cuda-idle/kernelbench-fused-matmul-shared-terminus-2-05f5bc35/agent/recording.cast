[1193.80867, "o", "\r\nBM128 BN256 BK32 w8 s3: 2.342 ms\r\nBM128 BN256 BK32 w8 s4: 2.494 ms\r\nBM128 BN256 BK32 w8 s5: FAIL OutOfResources\r\nBM64 BN256 BK64 w4 s2: 4.148 ms\r\nBM64 BN256 BK64 w4 s3: FAIL OutOfResources\r\nBM64 BN256 BK64 w4 s4: FAIL OutOfResources\r\nBM64 BN256 BK64 w4 s5: FAIL OutOfResources\r\nBM64 BN256 BK64 w8 s2: 14.103 ms\r\nBM64 BN256 BK64 w8 s3: FAIL OutOfResources\r\nBM64 BN256 BK64 w8 s4: FAIL OutOfResources\r\nBM64 BN256 BK64 w8 s5: FAIL OutOfResources\r\nBM256 BN64 BK64 w4 s2: 4.575 ms\r\nBM256 BN64 BK64 w4 s3: FAIL OutOfResources\r\nBM256 BN64 BK64 w4 s4: FAIL OutOfResources\r\nBM256 BN64 BK64 w4 s5: FAIL OutOfResources\r\nBM256 BN64 BK64 w8 s2: 4.432 ms\r\nBM256 BN64 BK64 w8 s3: FAIL OutOfResources\r\nBM256 BN64 BK64 w8 s4: FAIL OutOfResources\r\nBM256 BN64 BK64 w8 s5: FAIL OutOfResources\r\nBM128 BN64 BK128 w4 s2: 5.276 ms\r\nBM128 BN64 BK128 w4 s3: FAIL OutOfResources\r\nBM128 BN64 BK128 w4 s4: FAIL OutOfResources\r\nBM128 BN64 BK128 w4 s5: FAIL OutOfResources\r\nBM128 BN64 BK128 w8 s2: 5.261 ms\r\nBM128 BN64 BK128 w8 s3: FAIL OutOfResources\r\n"]
