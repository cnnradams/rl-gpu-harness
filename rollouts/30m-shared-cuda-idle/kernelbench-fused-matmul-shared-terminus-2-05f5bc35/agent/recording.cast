[1768.496186, "o", "> "]
[1768.496223, "o", "    l = r2.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1768.496274, "o", "    tl.store(H + offs, h, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1768.496353, "o", ">     tl.store(M + offs, m, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1768.496451, "o", "    tl.store(L + offs, l, mask=mask)\"\"\", \"\"\"    tl.store(H + offs, h, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1768.496499, "o", "    tl.store(M + offs, m, mask=mask)\"\"\")\r\n\u001b[?2004l\r"]
[1768.496541, "o", "\u001b[?2004h> "]
[1768.496704, "o", "src = src.replace(\"def _split3_kernel(X, H, M, L, n_elements, BLOCK: tl.constexpr):\", \"def _split2_kernel(X, H, M, n_elements, BLOCK: tl.constexpr):\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1768.496789, "o", "src = src.replace(\"\"\"        self._xm = torch.empty_like(self._xh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1768.496832, "o", "> "]
[1768.496918, "o", "        self._xl = torch.empty_like(self._xh)\"\"\", \"\"\"        self._xm = torch.empty_like(self._xh)\"\"\")\r\n\u001b[?2004l\r"]
[1768.49698, "o", "\u001b[?2004h> "]
[1768.497184, "o", "src = src.replace(\"_split3_kernel[(triton.cdiv(n, 4096),)](x, self._xh, self._xm, self._xl, n, BLOCK=4096, num_warps=8)\", \"_split2_kernel[(triton.cdiv(n, 4096),)](x, self._xh, self._xm, n, BLOCK=4096, num_warps=8)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1768.497202, "o", "> "]
[1768.497257, "o", "open('/workspace/solution.py','w').write(src)\r\n\u001b[?2004l\r\u001b[?2004h"]
