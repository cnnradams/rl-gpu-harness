[1633.57625, "o", "    rm = pid_m * BM + tl.arange(0, BM); rn = pid_n * BN + tl.arange(0, BN); rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1633.576314, "o", "> "]
