[1735.012912, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1735.012954, "o", "\u001b[?2004h> "]
[1735.012995, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.01305, "o", "        w = self.matmul.weight.detach()\r\n\u001b[?2004l\r"]
[1735.013084, "o", "\u001b[?2004h> "]
[1735.013127, "o", "        b = self.matmul.bias.detach()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.013168, "o", "        s = float(scaling_factor) + 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.013208, "o", "> "]
[1735.013248, "o", "        ws = (w.double() * s).float()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.013288, "o", "        bs = (b.double() * s).float()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.013322, "o", "> "]
[1735.013376, "o", "        self.register_buffer(\"ws_full\", ws.clone(), persistent=False)\r\n\u001b[?2004l\r"]
[1735.013418, "o", "\u001b[?2004h> "]
[1735.013478, "o", "        self.register_buffer(\"bias_full\", bs.clone(), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.013518, "o", "> "]
[1735.013559, "o", "        self.in_features = in_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.013594, "o", "        self.out_features = out_features\r\n\u001b[?2004l\r"]
[1735.013627, "o", "\u001b[?2004h> "]
[1735.013667, "o", "        self._ready = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.013713, "o", ">     def _refresh(self, device):\r\n\u001b[?2004l\r"]
[1735.013754, "o", "\u001b[?2004h> "]
[1735.013838, "o", "        self._xh = torch.empty((16384, self.in_features), device=device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1735.01386, "o", "\u001b[?2004h> "]
[1735.0139, "o", "        self._xm = torch.empty_like(self._xh)\r\n\u001b[?2004l\r"]
[1735.013941, "o", "\u001b[?2004h> "]
[1735.013983, "o", "        self._xl = torch.empty_like(self._xh)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014036, "o", "        wt = self.ws_full.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.014077, "o", ">         wh = wt.half()\r\n\u001b[?2004l\r"]
[1735.014116, "o", "\u001b[?2004h> "]
[1735.014155, "o", "        wm = (wt - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014195, "o", "        self._wh = wh.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.01423, "o", "> "]
[1735.014272, "o", "        self._wm = wm.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014318, "o", "        self._bias = self.bias_full.to(device)\r\n\u001b[?2004l\r"]
[1735.014357, "o", "\u001b[?2004h> "]
[1735.014442, "o", "        self._out = torch.empty((16384, self.out_features), device=device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.014483, "o", ">         self._ready = True\r\n\u001b[?2004l\r"]
[1735.014525, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014565, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.01463, "o", "        if not self._ready or self._xh.device != x.device:\r\n\u001b[?2004l\r"]
[1735.014669, "o", "\u001b[?2004h> "]
[1735.014722, "o", "            self._refresh(x.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014761, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014798, "o", "        N = self.out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014839, "o", "        n = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.014969, "o", "        _split3_kernel[(triton.cdiv(n, 4096),)](x, self._xh, self._xm, self._xl, n, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.014986, "o", "> "]
[1735.015036, "o", "        BM, BN, BK, GROUP_M = 128, 256, 32, 8\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.015076, "o", "> "]
[1735.015118, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.015158, "o", ">         _mm3_kernel[grid](\r\n\u001b[?2004l\r"]
[1735.015199, "o", "\u001b[?2004h> "]
[1735.015262, "o", "            self._xh, self._xm, self._wh, self._wm, self._bias, self._out,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.015303, "o", ">             M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.015343, "o", "> "]
[1735.015383, "o", "            self._xh.stride(0), self._xh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.015448, "o", "            self._wh.stride(0), self._wh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.015489, "o", "> "]
[1735.015529, "o", "            self._out.stride(0), self._out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1735.015596, "o", "            GROUP_M=GROUP_M, BM=BM, BN=BN, BK=BK,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1735.015637, "o", "> "]
[1735.015681, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[1735.015721, "o", "\u001b[?2004h> "]
[1735.015763, "o", "        return self._out\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1735.030336, "o", "\u001b[?2004hroot@modal:/# "]
[1735.030473, "o", "python3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[1735.045614, "o", "ok\r\n"]
[1735.048362, "o", "\u001b[?2004hroot@modal:/# "]
[1735.508806, "i", "gpu sync; gpu stop sb-0JqfR2a3eSRSR1HHjmcj8A; gpu run --detach -- sleep 3600\n"]
