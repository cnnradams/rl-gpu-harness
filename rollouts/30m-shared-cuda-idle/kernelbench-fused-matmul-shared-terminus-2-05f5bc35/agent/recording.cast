[1278.534183, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew, _split3_kernel\n\n@triton.jit\ndef _split2_kernel(X, H, M, n_elements, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < n_elements\n    x = tl.load(X + offs, mask=mask)\n    h = x.to(tl.float16)\n    r1 = x - h.to(tl.float32)\n    m = r1.to(tl.float16)\n    tl.store(H + offs, h, mask=mask)\n    tl.store(M + offs, m, mask=mask)\n\nbatch, inf, outf, sf = 16384, 4096, 4096, 0.5\ntorch.manual_seed(42)\nref = torch.nn.Linear(inf, outf).cuda()\nwith torch.no_grad():\n    W = ref.weight.clone(); b = ref.bias.clone()\n\ndef ref_fn(x):\n    y = torch.nn.functional.linear(x, W, b)\n    return y * sf + y\n\ntorch.manual_seed(42)\nm = ModelNew(inf, outf, sf).cuda()\n\n# NDOT=2 = dots ah.bh + am.bh (drop ah.bm): emulate by zeroing wm\nm._refresh(x.device if False else torch.device('cuda'))\nwm_saved = m._w_parts[1].clone()\nm._w_parts"]
[1278.534232, "i", " = (m._w_parts[0], torch.zeros_like(wm_saved), m._w_parts[2])\nm.ndot = 3  # 3 dots but one is zero => equals NDOT=2 result\n\nworst = 0.0\nfor t in range(10):\n    torch.manual_seed(300 + t)\n    x = torch.rand(batch, inf, device='cuda')\n    with torch.no_grad():\n        y = ref_fn(x)\n        y2 = m(x).clone()\n    err = (y - y2).abs()\n    bound = 1e-4 + 1e-4 * y.abs()\n    ratio = (err / bound).max().item()\n    worst = max(worst, ratio)\nprint(f'NDOT=2 (drop ah.bm): worst err/bound over 10 seeds = {worst:.3f} (must be <1)')\n\nm._w_parts = (m._w_parts[0], wm_saved, m._w_parts[2])\n\ndef timeit(fn, n_iter=30):\n    scratch = torch.empty(256*1024*1024//4, device='cuda', dtype=torch.float32)\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n_iter):\n        torch.cuda.synchronize(); scratch.uniform_(); torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        "]
[1278.534242, "i", "ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nx = torch.rand(batch, inf, device='cuda')\nn = x.numel()\nxh, xm, xl = m._x_parts\nt2 = timeit(lambda: _split2_kernel[(triton.cdiv(n, 4096),)](x, xh, xm, n, BLOCK=4096, num_warps=8))\nt3 = timeit(lambda: _split3_kernel[(triton.cdiv(n, 4096),)](x, xh, xm, xl, n, BLOCK=4096, num_warps=8))\nprint(f'split2: {t2:.3f} ms, split3: {t3:.3f} ms')\n\n# mm with only 2 dots using best config\nfrom bench2 import mm3  # reuse jit fn\nEOF\necho written\n"]
