[1223.422813, "i", "cat > /workspace/exp8.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\nB, IN, OUT = 16384, 4096, 4096\ndev = 'cuda'\n\ndef bench(fn, n=100):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\n@triton.jit\ndef split_gemm_tma(X1, X2, W1, W2, Bias, C, M, N, K,\n                   BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    x1_desc = tl.make_tensor_descriptor(X1, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    x2_desc = tl.make_tensor_descriptor(X2, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    w1_desc = tl.make_tensor_descriptor(W1, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    w2_desc = tl.make_tensor_descriptor(W2, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, "]
[1223.422868, "i", "BN])\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    om = pid_m * BM\n    on = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        ok = k * BK\n        a1 = x1_desc.load([om, ok])\n        a2 = x2_desc.load([om, ok])\n        b1 = w1_desc.load([ok, on])\n        b2 = w2_desc.load([ok, on])\n        acc = tl.dot(a1, b1, acc)\n        acc = tl.dot(a1, b2, acc)\n        acc = tl.dot(a2, b1, acc)\n    rn = on + tl.arange(0, BN)\n    bias = tl.load(Bias + rn).to(tl.float32)\n    c = acc * 1.5 + bias\n    c_desc.store([om, on], c)\n\ndef run_tma(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\n    M, K = x1.shape\n    N = wt1.shape[1]"]
[1223.422874, "i", "\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    split_gemm_tma[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\n                         BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\n    return out\n\ntorch.manual_seed(0)\nx = torch.rand(B, IN, device=dev)\nlin = torch.nn.Linear(IN, OUT).to(dev)\nW = lin.weight.detach().clone(); b = lin.bias.detach().clone()\n\ndef ref(xv):\n    y = torch.nn.functional.linear(xv, W, b)\n    o = y.clone()\n    return y * 0.5 + o\n\nwt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\nb15 = (b * 1.5).contiguous()\noutbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\nx1b = torch.empty(B, IN, device=dev, dtype=torch.half)\nx2b = torch.empty(B, IN, device=dev, dtype=torch.half)\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\nr = ref(x)\nx1b.copy_(x); x2b.copy_(x - x1b.float())\n\nresults = []\nfor cfg in [(128,256,32,8,8,3),(128,256,64,8,8,3),("]
[1223.422885, "i", "256,128,32,8,8,4),(128,256,64,8,8,4),(256,256,32,8,8,3),(128,256,64,8,8,2),(256,128,64,8,8,3)]:\n    try:\n        run_tma(x1b, x2b, wt1, wt2, b15, outbuf, *cfg)\n        torch.cuda.synchronize()\n        ok = torch.allclose(outbuf, r, atol=1e-4, rtol=1e-4)\n        err = (outbuf - r).abs().max().item()\n        t = bench(lambda: run_tma(x1b, x2b, wt1, wt2, b15, outbuf, *cfg))\n        print(f'tma cfg {cfg}: {t:.3f} ms allclose {ok} err {err:.2e}', flush=True)\n        results.append((t, cfg))\n    except Exception as ex:\n        print(f'tma cfg {cfg}: failed {str(ex)[:100]}', flush=True)\nif results:\n    results.sort()\n    print('BEST TMA', results[0], flush=True)\nEOF\n"]
