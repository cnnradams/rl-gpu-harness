[113.766732, "o", "\u001b[32m\u001b[K727\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef run_and_check_correctness\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K728\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    original_model_instance: nn.Module,\r\n\u001b[32m\u001b[K729\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    new_model_instance: nn.Module,\r\n\u001b[32m\u001b[K730\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    get_inputs_fn: callable,\r\n\u001b[32m\u001b[K731\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    metadata: dict,\r\n\u001b[32m\u001b[K732\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: int,\r\n\u001b[32m\u001b[K733\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    verbose: bool =False,\r\n\u001b[32m\u001b[K734\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    seed: int =42,\r\n\u001b[32m\u001b[K735\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: Optional[torch.device] =None,\r\n\u001b[32m\u001b[K736\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str =\"cuda\",\r\n\u001b[32m\u001b[K737\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype =torch.float32,\r\n\u001b[32m\u001b[K738\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K) -> KernelExecResult:\r\n\u001b[32m\u001b[K739\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n"]
[113.766756, "o", "\u001b[32m\u001b[K740\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    run the model and check correctness,\r\n\u001b[32m\u001b[K741\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    assume model already loaded and compiled (loaded and compiled in the caller)\r\n\u001b[32m\u001b[K742\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    this is all on GPU, requiring cuda device and transfer .cuda()\r\n\u001b[32m\u001b[K743\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K744\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: run the evalutation multiple times with (ideally) different random inputs to ensure correctness\r\n\u001b[32m\u001b[K745\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: backend type for handling dtype conversions\r\n\u001b[32m\u001b[K746\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype\r\n\u001b[32m\u001b[K747\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K748\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    pass_count = 0\r\n\u001b[32m\u001b[K749\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[113.766843, "o", "\r\n\u001b[32m\u001b[K750\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Generate num_correct_trials seeds deterministically from the initial seed\r\n\u001b[32m\u001b[K751\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    torch.manual_seed(seed)\r\n\u001b[32m\u001b[K752\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    correctness_trial_seeds = [\r\n\u001b[32m\u001b[K753\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(num_correct_trials)\r\n\u001b[32m\u001b[K754\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ]\r\n\u001b[32m\u001b[K755\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K756\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    with torch.no_grad():\r\n\u001b[32m\u001b[K757\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K758\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for trial in range(num_correct_trials):\r\n\u001b[32m\u001b[K759\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K760\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            trial_seed = correctness_trial_seeds[trial]\r\n\u001b[32m\u001b[K761\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if verbose:\r\n\u001b[32m\u001b[K762\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                print(f\"[Eval] Generating Random Input with seed {trial_seed}\")\r\n\u001b[32m\u001b[K763\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K764\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            set_seed(trial_seed)\r\n\u001b[32m\u001b[K765\u001b[m\u001b[K\u001b[36m\u001b[K-"]
[113.766864, "o", "\u001b[m\u001b[K            inputs = get_inputs_fn()\r\n\u001b[32m\u001b[K766\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # Convert inputs to appropriate dtypes for GPU computation\r\n\u001b[32m\u001b[K767\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            inputs = [_process_input_tensor(x, device, backend, precision) for x in inputs]\r\n\u001b[32m\u001b[K768\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K769\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            set_seed(trial_seed)\r\n\u001b[32m\u001b[K770\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K771\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            model = original_model_instance.to(device=device, dtype=precision)\r\n\u001b[32m\u001b[K772\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K773\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            set_seed(trial_seed)\r\n\u001b[32m\u001b[K774\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K     \r\n\u001b[32m\u001b[K775\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            model_new = new_model_instance.to(device=device, dtype=precision)\r\n\u001b[32m\u001b[K776\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K777\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            output = model(*inputs)\r\n\u001b[32m\u001b[K778\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            torch.cuda.synchronize(device=device)\r\n\u001b[32m\u001b[K779\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # ensure all GPU oper"]
[113.766937, "o", "ations are completed before checking results\r\n\u001b[32m\u001b[K780\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K781\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            try:\r\n\u001b[32m\u001b[K782\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                output_new = model_new(*inputs)\r\n\u001b[32m\u001b[K783\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                torch.cuda.synchronize(device=device)\r\n\u001b[32m\u001b[K784\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if output.shape != output_new.shape:\r\n\u001b[32m\u001b[K785\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    metadata = register_and_format_exception(\r\n\u001b[32m\u001b[K786\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        \"correctness_issue\",\r\n\u001b[32m\u001b[K787\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        f\"Output shape mismatch: Expected {output.shape}, got {output_new.shape}\",\r\n\u001b[32m\u001b[K788\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        metadata,\r\n\u001b[32m\u001b[K789\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    )\r\n\u001b[32m\u001b[K790\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    metadata[\"correctness_issue_name\"] = \"correctness_issue\"\r\n\u001b[32m\u001b[K791\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    if verbose:\r\n\u001b[32m\u001b[K792\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K      "]
[113.766999, "o", "                  print(\r\n\u001b[32m\u001b[K793\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                            f\"[FAIL] trial {trial}: Output shape mismatch: Expected {output.shape}, got {output_new.shape}\"\r\n\u001b[32m\u001b[K794\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        )\r\n\u001b[32m\u001b[K795\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    return KernelExecResult(\r\n\u001b[32m\u001b[K796\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        compiled=True, correctness=False, metadata=metadata\r\n\u001b[32m\u001b[K797\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    )\r\n\u001b[32m\u001b[K798\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K799\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                # in torchbench, they use both precisions for atol and rtol\r\n\u001b[32m\u001b[K800\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                # kernelbench v0 and v0.1 uses fp32, atol = rtol = 1e-02\r\n\u001b[32m\u001b[K801\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                # now we will return the tolerance from get_tolerance_for_precision\r\n\u001b[32m\u001b[K802\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                tolerance = get_tolerance_for_precision(precision)\r\n\u001b[32m\u001b[K803\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                # check output value diffe"]
[113.767024, "o", "rence\r\n\u001b[32m\u001b[K804\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if not torch.allclose(\r\n\u001b[32m\u001b[K805\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    output, output_new, atol=tolerance, rtol=tolerance\r\n\u001b[32m\u001b[K806\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                ):  # fail\r\n\u001b[32m\u001b[K807\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    max_diff = torch.max(torch.abs(output - output_new)).item()\r\n\u001b[32m\u001b[K808\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    avg_diff = torch.mean(torch.abs(output - output_new)).item()\r\n\u001b[32m\u001b[K809\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    metadata.setdefault(\"max_difference\", []).append(f\"{max_diff:.6f}\")\r\n\u001b[32m\u001b[K810\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    metadata.setdefault(\"avg_difference\", []).append(f\"{avg_diff:.6f}\")\r\n\u001b[32m\u001b[K811\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    metadata[\"correctness_issue\"] = \"Output mismatch\"\r\n\u001b[32m\u001b[K812\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    if verbose:\r\n\u001b[32m\u001b[K813\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        print(f\"[FAIL] trial {trial}: Output mismatch\")\r\n\u001b[32m\u001b[K814\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K       "]
[113.767049, "o", "         else:  # pass\r\n\u001b[32m\u001b[K815\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    pass_count += 1\r\n\u001b[32m\u001b[K816\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    if verbose:\r\n\u001b[32m\u001b[K817\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                        print(f\"[PASS] trial {trial}: New Model matches Model\")\r\n"]
