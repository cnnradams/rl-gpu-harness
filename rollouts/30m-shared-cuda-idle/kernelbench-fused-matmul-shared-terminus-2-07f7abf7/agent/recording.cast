[503.528268, "o", "{BK} G{G} w{w} s{st}: {t:.3f} ms, maxerr {err:.2e}, allclose {ok}', flush=True)\r\n    except Exception as ex:\r\n        print(f'cfg BM{BM} BN{BN} BK{BK}: failed"]
[503.528296, "o", " {ex}', flush=True)\r\nEOF\r\n"]
