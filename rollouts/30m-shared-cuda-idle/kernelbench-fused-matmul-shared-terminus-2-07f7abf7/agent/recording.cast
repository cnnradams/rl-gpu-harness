[679.962658, "i", "cat > /workspace/exp3.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\nB, IN, OUT = 16384, 4096, 4096\ndev = 'cuda'\n\ndef bench(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\n@triton.jit\ndef split_gemm(X1, X2, W1, W2, Bias, C, M, N, K,\n               sxm, sxk, swk, swn, scm, scn,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * B"]
[679.962706, "i", "N + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A1 = X1 + rm[:, None] * sxm + rk[None, :] * sxk\n    A2 = X2 + rm[:, None] * sxm + rk[None, :] * sxk\n    B1 = W1 + rk[:, None] * swk + rn[None, :] * swn\n    B2 = W2 + rk[:, None] * swk + rn[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a1 = tl.load(A1)\n        a2 = tl.load(A2)\n        b1 = tl.load(B1)\n        b2 = tl.load(B2)\n        acc = tl.dot(a1, b1, acc)\n        acc = tl.dot(a1, b2, acc)\n        acc = tl.dot(a2, b1, acc)\n        A1 += BK * sxk\n        A2 += BK * sxk\n        B1 += BK * swk\n        B2 += BK * swk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    c = acc * 1.5 + bias\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, c)\n\ndef run_split(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\n    M, K = x1.shape\n    N = wt1.shape[1]\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    split_gemm[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\n                 "]
[679.962726, "i", "    x1.stride(0), x1.stride(1), wt1.stride(0), wt1.stride(1),\n                     out.stride(0), out.stride(1),\n                     BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\n    return out\n\ntorch.manual_seed(0)\nx = torch.rand(B, IN, device=dev)\nlin = torch.nn.Linear(IN, OUT).to(dev)\nW = lin.weight.detach().clone(); b = lin.bias.detach().clone()\n\ndef ref(xv):\n    y = torch.nn.functional.linear(xv, W, b)\n    o = y.clone()\n    return y * 0.5 + o\n\nwt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\nb15 = (b * 1.5).contiguous()\noutbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\nx1b = torch.empty(B, IN, device=dev, dtype=torch.half)\nx2b = torch.empty(B, IN, device=dev, dtype=torch.half)\n\ndef full(xv):\n    torch.copy(x1b, xv)\n    torch.sub(xv, x1b, out=x2b)  # float? need float intermediate\n    return outbuf\n# x2 computation: xv - x1.float() in fp16 out: does sub support mixed? no. Use float tmp.\nftmp = torch.empty(B, IN, device=dev, dtype=to"]
[679.962875, "i", "rch.float32)\n\ndef split_only(xv):\n    torch.copy(x1b, xv)\n    torch.sub(xv, x1b, out=ftmp)\n    torch.copy(x2b, ftmp)\n\ndef kernel_only():\n    run_split(x1b, x2b, wt1, wt2, b15, outbuf, BEST[0], BEST[1], BEST[2], BEST[3], BEST[4], BEST[5])\n\nconfigs = [(128,128,64,8,4,2),(128,256,64,8,8,2),(256,128,64,8,8,2),(128,256,32,8,8,3),(256,128,32,8,8,3),(128,128,32,8,4,3),(256,256,32,8,8,2),(128,256,64,4,8,2),(256,128,64,4,8,2),(256,256,64,8,8,2),(128,512,32,8,8,2),(64,256,32,8,4,3),(128,256,32,4,8,4),(256,256,32,4,8,3)]\nr = ref(x)\ntorch.copy(x1b, x); torch.sub(x, x1b, out=ftmp); torch.copy(x2b, ftmp)\nresults = []\nfor cfg in configs:\n    BM, BN, BK, G, w, st = cfg\n    try:\n        run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg)\n        torch.cuda.synchronize()\n        ok = torch.allclose(outbuf, r, atol=1e-4, rtol=1e-4)\n        t = bench(lambda: run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg))\n        print(f'cfg {cfg}: {t:.3f} ms allclose {ok}', flush=True)\n        results.append((t, cfg))\n    except Exception as ex:"]
[679.962895, "o", "cat > /workspace/exp3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.962965, "i", "\n        print(f'cfg {cfg}: failed {str(ex)[:80]}', flush=True)\nresults.sort()\nBEST = results[0][1]\nprint('BEST', BEST, results[0][0], flush=True)\nprint('split overhead ms:', bench(lambda: split_only(x)), flush=True)\nprint('kernel only ms:', bench(kernel_only), flush=True)\n\n# robustness: 20 random trials\nfails = 0\nmaxerr = 0.0\nfor i in range(20):\n    torch.manual_seed(1000 + i)\n    xv = torch.rand(B, IN, device=dev)\n    rv = ref(xv)\n    torch.copy(x1b, xv); torch.sub(xv, x1b, out=ftmp); torch.copy(x2b, ftmp)\n    run_split(x1b, x2b, wt1, wt2, b15, outbuf, *BEST)\n    torch.cuda.synchronize()\n    err = (outbuf - rv).abs().max().item()\n    maxerr = max(maxerr, err)\n    if not torch.allclose(outbuf, rv, atol=1e-4, rtol=1e-4):\n        fails += 1\nprint(f'robustness: fails={fails}/20 maxerr={maxerr:.3e}', flush=True)\nEOF\n"]
[679.963001, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.963052, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[679.963089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ru\u001b[?2004h"]
[679.96312, "o", "> "]
[679.963193, "o", "B, IN, OUT = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.963241, "o", "> dev = 'cuda'\r\n"]
[679.963285, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[679.963325, "o", "> "]
[679.96336, "o", "def bench(fn, n=50):\r\n\u001b[?2004l\r"]
[679.963403, "o", "\u001b[?2004h> "]
[679.963451, "o", "    for _ in range(10): fn()\r\n\u001b[?2004l\r"]
[679.96349, "o", "\u001b[?2004h> "]
[679.963567, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[679.963606, "o", "\u001b[?2004h> "]
[679.963763, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.963807, "o", "> "]
[679.963849, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.963931, "o", "    for _ in range(n): fn()\r\n\u001b[?2004l\r"]
[679.963978, "o", "\u001b[?2004h> "]
[679.964072, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[679.964112, "o", "\u001b[?2004h> "]
[679.964203, "o", "    return s.elapsed_time(e)/n\r\n\u001b[?2004l\r"]
[679.964246, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r=\u001b[?2004h> "]
[679.964282, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[679.964324, "o", "\u001b[?2004h> "]
[679.964441, "o", "def split_gemm(X1, X2, W1, W2, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[679.964483, "o", "\u001b[?2004h> "]
[679.964561, "o", "               sxm, sxk, swk, swn, scm, scn,\r\n\u001b[?2004l\r"]
[679.964607, "o", "\u001b[?2004h> "]
[679.964839, "o", "               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.964886, "o", "> "]
[679.964921, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[679.964966, "o", "\u001b[?2004h> "]
[679.96506, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[679.965073, "o", "\u001b[?2004h> "]
[679.965162, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[679.965204, "o", "\u001b[?2004h> "]
[679.965277, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[679.965319, "o", "\u001b[?2004h> "]
[679.965406, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[679.96545, "o", "\u001b[?2004h> "]
[679.965515, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[679.965559, "o", "\u001b[?2004h> "]
[679.96565, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[679.965693, "o", "\u001b[?2004h> "]
[679.965746, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[679.96579, "o", "\u001b[?2004h> "]
[679.965826, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[679.965866, "o", "\u001b[?2004h> "]
[679.965909, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.965957, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[679.966002, "o", "\u001b[?2004h> "]
[679.966042, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.966084, "o", "    A1 = X1 + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[679.966124, "o", "\u001b[?2004h> "]
[679.966164, "o", "    A2 = X2 + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[679.966202, "o", "\u001b[?2004h> "]
[679.966242, "o", "    B1 = W1 + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[679.966281, "o", "\u001b[?2004h> "]
[679.966321, "o", "    B2 = W2 + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[679.96636, "o", "\u001b[?2004h> "]
[679.9664, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.966441, "o", "> "]
[679.966474, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.966515, "o", ">         a1 = tl.load(A1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.966555, "o", ">         a2 = tl.load(A2)\r\n\u001b[?2004l\r"]
[679.966594, "o", "\u001b[?2004h> "]
[679.966635, "o", "        b1 = tl.load(B1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.966676, "o", "        b2 = tl.load(B2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.966716, "o", "        acc = tl.dot(a1, b1, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.966756, "o", "> "]
[679.966796, "o", "        acc = tl.dot(a1, b2, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.966836, "o", "        acc = tl.dot(a2, b1, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.966877, "o", "        A1 += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.966916, "o", ">         A2 += BK * sxk\r\n\u001b[?2004l\r"]
[679.966963, "o", "\u001b[?2004h> "]
[679.967004, "o", "        B1 += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.967044, "o", "        B2 += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.967087, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[679.967127, "o", "\u001b[?2004h>     c = acc * 1.5 + bias\r\n\u001b[?2004l\r"]
[679.967167, "o", "\u001b[?2004h> "]
[679.967214, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[679.967255, "o", "\u001b[?2004h>     tl.store(Cp, c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.967295, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.967378, "o", "def run_split(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\r\n\u001b[?2004l\r"]
[679.967422, "o", "\u001b[?2004h>     M, K = x1.shape\r\n\u001b[?2004l\r"]
[679.967463, "o", "\u001b[?2004h>     N = wt1.shape[1]\r\n\u001b[?2004l\r"]
[679.967501, "o", "\u001b[?2004h> "]
[679.967546, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[679.967584, "o", "\u001b[?2004h> "]
[679.967633, "o", "    split_gemm[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\r\n\u001b[?2004l\r"]
[679.967674, "o", "\u001b[?2004h> "]
[679.96774, "o", "                     x1.stride(0), x1.stride(1), wt1.stride(0), wt1.stride(1),\r\n\u001b[?2004l\r"]
[679.967781, "o", "\u001b[?2004h> "]
[679.967821, "o", "                     out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[679.967862, "o", "\u001b[?2004h> "]
[679.967937, "o", "                     BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[679.967963, "o", "\u001b[?2004h> "]
[679.968005, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968048, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.968088, "o", "> "]
[679.968133, "o", "x = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968174, "o", "lin = torch.nn.Linear(IN, OUT).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968256, "o", "W = lin.weight.detach().clone(); b = lin.bias.detach().clone()\r\n\u001b[?2004l\r"]
[679.968297, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968338, "o", "def ref(xv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.96838, "o", "    y = torch.nn.functional.linear(xv, W, b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.968399, "o", "> "]
[679.968441, "o", "    o = y.clone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968482, "o", "    return y * 0.5 + o\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[679.968523, "o", "\u001b[?2004h> "]
[679.968596, "o", "wt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\r\n\u001b[?2004l\r"]
[679.968636, "o", "\u001b[?2004h> "]
[679.968677, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968741, "o", "outbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.968782, "o", "> "]
[679.968822, "o", "x1b = torch.empty(B, IN, device=dev, dtype=torch.half)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968897, "o", "x2b = torch.empty(B, IN, device=dev, dtype=torch.half)\r\n\u001b[?2004l\r"]
[679.968937, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.968981, "o", "def full(xv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969035, "o", "    torch.copy(x1b, xv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969113, "o", "    torch.sub(xv, x1b, out=x2b)  # float? need float intermediate\r\n\u001b[?2004l\r"]
[679.969157, "o", "\u001b[?2004h>     return outbuf\r\n\u001b[?2004l\r"]
[679.969196, "o", "\u001b[?2004h> "]
[679.969277, "o", "# x2 computation: xv - x1.float() in fp16 out: does sub support mixed? no. Use float tmp.\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.969317, "o", "> "]
[679.969359, "o", "ftmp = torch.empty(B, IN, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[679.969403, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969446, "o", "def split_only(xv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969489, "o", "    torch.copy(x1b, xv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969529, "o", "    torch.sub(xv, x1b, out=ftmp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969571, "o", "    torch.copy(x2b, ftmp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969611, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969649, "o", "def kernel_only():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.969758, "o", "    run_split(x1b, x2b, wt1, wt2, b15, outbuf, BEST[0], BEST[1], BEST[2], BEST[3], BEST[4], BEST[5])\r\n\u001b[?2004l\r"]
[679.969774, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[679.96981, "o", "\u001b[?2004h> "]
[679.97011, "o", "configs = [(128,128,64,8,4,2),(128,256,64,8,8,2),(256,128,64,8,8,2),(128,256,32,8,8,3),(256,128,32,8,8,3),(128,128,32,8,4,3),(256,256,32,8,8,2),(128,256,64,4,8,2),(256,128,64,4,8,2),(256,256,64,8,8,2),(128,512,32,8,8,2),(64,256,32,8,4,3),(128,256,32,4,8,4),(256,256,32,4,8,3)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.970162, "o", "r = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.970233, "o", "torch.copy(x1b, x); torch.sub(x, x1b, out=ftmp); torch.copy(x2b, ftmp)\r\n\u001b[?2004l\r"]
[679.970282, "o", "\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.970323, "o", "for cfg in configs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.970374, "o", "    BM, BN, BK, G, w, st = cfg\r\n\u001b[?2004l\r"]
[679.970412, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.97049, "o", "        run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg)\r\n\u001b[?2004l\r"]
[679.970531, "o", "\u001b[?2004h> "]
[679.970571, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.970638, "o", "        ok = torch.allclose(outbuf, r, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[679.970658, "o", "\u001b[?2004h> "]
[679.970746, "o", "        t = bench(lambda: run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg))\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.970786, "o", "> "]
[679.970834, "o", "        print(f'cfg {cfg}: {t:.3f} ms allclose {ok}', flush=True)\r\n\u001b[?2004l\r"]
[679.970874, "o", "\u001b[?2004h> "]
[679.970902, "o", "        results.append((t, cfg))\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.970922, "o", "> "]
[679.970964, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.971005, "o", "> "]
[679.971049, "o", "        print(f'cfg {cfg}: failed {str(ex)[:80]}', flush=True)\r\n\u001b[?2004l\r"]
[679.971093, "o", "\u001b[?2004h> results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.971134, "o", "BEST = results[0][1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.971153, "o", "> "]
[679.971209, "o", "print('BEST', BEST, results[0][0], flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.971251, "o", "> "]
[679.971303, "o", "print('split overhead ms:', bench(lambda: split_only(x)), flush=True)\r\n\u001b[?2004l\r"]
[679.971345, "o", "\u001b[?2004h> "]
[679.971384, "o", "print('kernel only ms:', bench(kernel_only), flush=True)\r\n\u001b[?2004l\r"]
[679.971424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.971464, "o", "# robustness: 20 random trials\r\n\u001b[?2004l\r"]
[679.971506, "o", "\u001b[?2004h> fails = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.971545, "o", "maxerr = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.971585, "o", "for i in range(20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.971626, "o", "    torch.manual_seed(1000 + i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[679.971683, "o", "    xv = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r"]
[679.971726, "o", "\u001b[?2004h>     rv = ref(xv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[679.971766, "o", "> "]
[679.971827, "o", "    torch.copy(x1b, xv); torch.sub(xv, x1b, out=ftmp); torch.copy(x2b, ftmp)\r\n\u001b[?2004l\r"]
[679.971869, "o", "\u001b[?2004h> "]
