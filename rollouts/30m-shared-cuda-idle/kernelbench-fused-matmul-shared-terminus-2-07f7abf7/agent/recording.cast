[203.903998, "o", "\u001b[?2004hroot@modal:/# "]
[215.079407, "i", "cat > /workspace/exp1.py << 'EOF'\nimport torch, time\nimport triton\nimport triton.language as tl\n\ntorch.backends.cuda.matmul.allow_tf32 = False\n\nB, IN, OUT = 16384, 4096, 4096\ndev = 'cuda'\n\ndef bench(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\nx = torch.rand(B, IN, device=dev)\nlin = torch.nn.Linear(IN, OUT).to(dev)\nW = lin.weight.detach().clone(); b = lin.bias.detach().clone()\n\n# reference\ndef ref():\n    y = torch.nn.functional.linear(x, W, b)\n    o = y.clone()\n    return y*0.5 + o\n\nr = ref()\nprint('ref ms:', bench(ref))\n\n# plain fp32 mm\ndef mm32():\n    return torch.addmm(b, x, W.t())\nprint('addmm fp32 ms:', bench(mm32))\n\n# mixed dtype test\ntry:\n    xh = x.half(); Wh = W.t().half()\n    out = torch.empty(B, OUT, device=dev, dtype=torch.float32)\n    torch.mm(xh, Wh, out=out)\n    print('mixed mm works, dtype:', out.d"]
[215.079462, "i", "type)\n    def mm_mixed():\n        return torch.mm(xh, Wh, out=out)\n    print('mixed mm ms:', bench(mm_mixed))\n    err = (out - x.double() @ W.t().double()).abs().max().item()\n    print('mixed mm err vs fp64:', err)\nexcept Exception as ex:\n    print('mixed mm failed:', ex)\n\n# addmm mixed\ntry:\n    y2 = torch.addmm(b, xh, Wh)\n    print('addmm mixed dtype:', y2.dtype)\nexcept Exception as ex:\n    print('addmm mixed failed:', ex)\n\n# fp16 split with fp32 accumulate via mixed mm (x1w1 + x1w2 + x2w1) * 1.5 + b*1.5\nx1 = x.half(); x2 = (x - x1.float()).half()\nw1 = W.half(); w2 = (W - w1.float()).half()\nWt1 = w1.t().contiguous(); Wt2 = w2.t().contiguous()\noutbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\ntmp = torch.empty(B, OUT, device=dev, dtype=torch.float32)\n\ndef split_mm():\n    torch.mm(x1, Wt1, out=outbuf)\n    torch.mm(x1, Wt2, out=tmp)\n    outbuf.add_(tmp)\n    torch.mm(x2, Wt1, out=tmp)\n    outbuf.add_(tmp)\n    outbuf.add_(b)\n    outbuf.mul_(1.5)\n    return outbuf\n\ns = split_mm()\nprint('split ms:', ben"]
[215.079582, "i", "ch(split_mm))\nerr = (s - r).abs()\nrel = err / (r.abs() + 1e-6)\nprint('split max abs err:', err.max().item(), 'allclose(1e-4):', torch.allclose(s, r, atol=1e-4, rtol=1e-4))\n\n# how close is the fp32 ref itself to fp64 ground truth (context)\ngt = (x.double() @ W.t().double() + b.double()) * 1.5\nprint('ref err vs fp64:', (r - gt.float()).abs().max().item())\nprint('split err vs fp64:', (s - gt.float()).abs().max().item())\nEOF\n"]
