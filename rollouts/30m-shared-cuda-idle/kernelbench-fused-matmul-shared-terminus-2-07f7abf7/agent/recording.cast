[822.99974, "i", "cat > /workspace/exp4.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\nB, IN, OUT = 16384, 4096, 4096\ndev = 'cuda'\n\ndef bench(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\n@triton.jit\ndef split_gemm_fused(X, W1, W2, Bias, C, M, N, K,\n                     sxm, sxk, swk, swn, scm, scn,\n                     BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    r"]
[822.999791, "i", "n = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = X + rm[:, None] * sxm + rk[None, :] * sxk\n    B1 = W1 + rk[:, None] * swk + rn[None, :] * swn\n    B2 = W2 + rk[:, None] * swk + rn[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(Ap)\n        a1 = a.to(tl.float16)\n        a2 = (a - a1.to(tl.float32)).to(tl.float16)\n        b1 = tl.load(B1)\n        b2 = tl.load(B2)\n        acc = tl.dot(a1, b1, acc)\n        acc = tl.dot(a1, b2, acc)\n        acc = tl.dot(a2, b1, acc)\n        Ap += BK * sxk\n        B1 += BK * swk\n        B2 += BK * swk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    c = acc * 1.5 + bias\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, c)\n\ndef run_fused(x, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\n    M, K = x.shape\n    N = wt1.shape[1]\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    split_gemm_fused[grid](x, wt1, wt2, b15, out, M, N, K,\n                           x."]
[822.999807, "i", "stride(0), x.stride(1), wt1.stride(0), wt1.stride(1),\n                           out.stride(0), out.stride(1),\n                           BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\n    return out\n\ntorch.manual_seed(0)\nx = torch.rand(B, IN, device=dev)\nlin = torch.nn.Linear(IN, OUT).to(dev)\nW = lin.weight.detach().clone(); b = lin.bias.detach().clone()\n\ndef ref(xv):\n    y = torch.nn.functional.linear(xv, W, b)\n    o = y.clone()\n    return y * 0.5 + o\n\nwt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\nb15 = (b * 1.5).contiguous()\noutbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\nr = ref(x)\n\nresults = []\nfor cfg in [(128,256,32,8,8,3),(128,256,32,8,8,2),(128,128,32,8,4,3),(128,256,64,8,8,2),(128,256,32,16,8,3),(128,256,32,4,8,3),(64,256,32,8,4,3),(128,64,32,8,4,4),(128,128,32,8,4,4),(128,128,32,8,8,3),(256,128,32,8,8,3),(128,512,32,8,8,3)]:\n    try:\n        run_fused(x, wt1, wt2, b15, outbuf, *cfg)\n        torch.cuda.synchronize()\n       "]
[822.999827, "i", " ok = torch.allclose(outbuf, r, atol=1e-4, rtol=1e-4)\n        err = (outbuf - r).abs().max().item()\n        t = bench(lambda: run_fused(x, wt1, wt2, b15, outbuf, *cfg))\n        print(f'fused cfg {cfg}: {t:.3f} ms allclose {ok} err {err:.2e}', flush=True)\n        results.append((t, cfg))\n    except Exception as ex:\n        print(f'fused cfg {cfg}: failed {str(ex)[:90]}', flush=True)\nresults.sort()\nt, BEST = results[0]\nprint('BEST fused', BEST, t, flush=True)\n\nfails = 0\nmaxerr = 0.0\nfor i in range(20):\n    torch.manual_seed(2000 + i)\n    xv = torch.rand(B, IN, device=dev)\n    rv = ref(xv)\n    run_fused(xv, wt1, wt2, b15, outbuf, *BEST)\n    torch.cuda.synchronize()\n    err = (outbuf - rv).abs().max().item()\n    maxerr = max(maxerr, err)\n    if not torch.allclose(outbuf, rv, atol=1e-4, rtol=1e-4):\n        fails += 1\nprint(f'robustness fused: fails={fails}/20 maxerr={maxerr:.3e}', flush=True)\nEOF\n"]
