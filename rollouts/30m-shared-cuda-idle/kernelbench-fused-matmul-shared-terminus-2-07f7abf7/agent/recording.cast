[1064.19498, "o", "\u001b[?2004h> "]
[1064.195019, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1064.195047, "o", "\u001b[?2004h> "]
[1064.195078, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[1064.195106, "o", "\u001b[?2004h> "]
[1064.195129, "o", "        a1 = tl.load(A1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.195157, "o", "> "]
[1064.195185, "o", "        a2 = tl.load(A2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.195212, "o", "        b1 = tl.load(B1)\r\n\u001b[?2004l\r"]
[1064.195239, "o", "\u001b[?2004h> "]
[1064.195269, "o", "        b2 = tl.load(B2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.195298, "o", "> "]
[1064.195326, "o", "        acc = tl.dot(a1, b1, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.195353, "o", "> "]
[1064.195381, "o", "        acc = tl.dot(a1, b2, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.195408, "o", "> "]
[1064.195436, "o", "        acc = tl.dot(a2, b1, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.19546, "o", ">         A1 += BK * sxk\r\n\u001b[?2004l\r"]
[1064.195478, "o", "\u001b[?2004h> "]
[1064.195506, "o", "        A2 += BK * sxk\r\n\u001b[?2004l\r"]
[1064.195534, "o", "\u001b[?2004h> "]
[1064.195561, "o", "        B1 += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.195589, "o", "> "]
[1064.195612, "o", "        B2 += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.195655, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[1064.195682, "o", "\u001b[?2004h> "]
[1064.195709, "o", "    c = acc * 1.5 + bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.195736, "o", "> "]
[1064.19577, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1064.195798, "o", "\u001b[?2004h> "]
[1064.195826, "o", "    tl.store(Cp, c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1064.195855, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1064.195926, "o", "def run_split(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\r\n\u001b[?2004l\r"]
[1064.195954, "o", "\u001b[?2004h> "]
[1064.195981, "o", "    M, K = x1.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.196007, "o", "    N = wt1.shape[1]\r\n\u001b[?2004l\r"]
[1064.19603, "o", "\u001b[?2004h> "]
[1064.196079, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1064.196107, "o", "\u001b[?2004h> "]
[1064.196158, "o", "    split_gemm[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\r\n\u001b[?2004l\r"]
[1064.196185, "o", "\u001b[?2004h> "]
[1064.196259, "o", "                     x1.stride(0), x1.stride(1), wt1.stride(0), wt1.stride(1),\r\n\u001b[?2004l\r"]
[1064.19629, "o", "\u001b[?2004h> "]
[1064.196335, "o", "                     out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[1064.196363, "o", "\u001b[?2004h> "]
[1064.196448, "o", "                     BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[1064.196478, "o", "\u001b[?2004h> "]
[1064.196505, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1064.196532, "o", "\u001b[?2004h> "]
[1064.19656, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.196591, "o", "x = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r"]
[1064.196619, "o", "\u001b[?2004h> "]
[1064.19665, "o", "lin = torch.nn.Linear(IN, OUT).to(dev)\r\n\u001b[?2004l\r"]
[1064.196679, "o", "\u001b[?2004h> "]
[1064.196734, "o", "W = lin.weight.detach().clone(); b = lin.bias.detach().clone()\r\n\u001b[?2004l\r"]
[1064.196762, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.19679, "o", "> def ref(xv):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.196817, "o", "> "]
[1064.196845, "o", "    y = torch.nn.functional.linear(xv, W, b)\r\n\u001b[?2004l\r"]
[1064.196872, "o", "\u001b[?2004h> "]
[1064.1969, "o", "    o = y.clone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.196927, "o", "    return y * 0.5 + o\r\n\u001b[?2004l\r"]
[1064.196956, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.197059, "o", "wt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\r\n\u001b[?2004l\r"]
[1064.197088, "o", "\u001b[?2004h> "]
[1064.197115, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[1064.197138, "o", "\u001b[?2004h> "]
[1064.197196, "o", "outbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1064.197223, "o", "\u001b[?2004h> "]
[1064.197274, "o", "x1b = torch.empty(B, IN, device=dev, dtype=torch.half)\r\n\u001b[?2004l\r"]
[1064.197298, "o", "\u001b[?2004h> "]
[1064.197351, "o", "x2b = torch.empty(B, IN, device=dev, dtype=torch.half)\r\n\u001b[?2004l\r"]
[1064.197378, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.197405, "o", "> numel = x.numel()\r\n\u001b[?2004l\r"]
[1064.197429, "o", "\u001b[?2004h> "]
[1064.197464, "o", "def triton_split(xv, BLK=8192, warps=8):\r\n\u001b[?2004l\r"]
[1064.197492, "o", "\u001b[?2004h> "]
[1064.197522, "o", "    grid = (triton.cdiv(numel, BLK),)\r\n\u001b[?2004l\r"]
[1064.197549, "o", "\u001b[?2004h> "]
[1064.197613, "o", "    split_kernel[grid](xv, x1b, x2b, numel, BLK=BLK, num_warps=warps)\r\n\u001b[?2004l\r"]
[1064.197641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.197669, "o", "> r = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.197692, "o", "> "]
[1064.197744, "o", "for BLK, w in [(4096,4),(8192,8),(16384,8),(2048,4),(16384,16)]:\r\n\u001b[?2004l\r"]
[1064.197771, "o", "\u001b[?2004h> "]
[1064.197799, "o", "    triton_split(x, BLK, w)\r\n\u001b[?2004l\r"]
[1064.197827, "o", "\u001b[?2004h> "]
[1064.197854, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.197881, "o", "> "]
[1064.197941, "o", "    assert torch.equal(x1b.float() + x2b.float(), x1b.float() + x2b.float())\r\n\u001b[?2004l\r"]
[1064.197969, "o", "\u001b[?2004h> "]
[1064.198009, "o", "    t = bench(lambda: triton_split(x, BLK, w))\r\n\u001b[?2004l\r"]
[1064.198038, "o", "\u001b[?2004h> "]
[1064.198095, "o", "    print(f'triton split BLK{BLK} w{w}: {t:.4f} ms', flush=True)\r\n\u001b[?2004l\r"]
[1064.198122, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.198149, "o", "> "]
[1064.198181, "o", "split_only = lambda xv: triton_split(xv, 8192, 8)\r\n\u001b[?2004l\r"]
[1064.198209, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.198236, "o", "> results = []\r\n\u001b[?2004l\r"]
[1064.198267, "o", "\u001b[?2004h> "]
[1064.198478, "o", "for cfg in [(256,128,32,8,8,4),(128,256,32,8,8,4),(256,128,32,8,8,3),(128,256,32,8,8,3),(256,128,32,16,8,4),(256,128,32,4,8,4),(128,256,64,8,8,2),(256,64,32,8,8,4),(256,128,64,8,8,3),(128,128,32,8,8,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.198509, "o", ">     try:\r\n\u001b[?2004l\r"]
[1064.198539, "o", "\u001b[?2004h> "]
[1064.198579, "o", "        run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg)\r\n\u001b[?2004l\r"]
[1064.198607, "o", "\u001b[?2004h> "]
[1064.198635, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1064.198662, "o", "\u001b[?2004h> "]
[1064.198716, "o", "        ok = torch.allclose(outbuf, r, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1064.198744, "o", "\u001b[?2004h> "]
[1064.198814, "o", "        t = bench(lambda: run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg))\r\n\u001b[?2004l\r"]
[1064.198838, "o", "\u001b[?2004h> "]
[1064.198902, "o", "        print(f'cfg {cfg}: {t:.3f} ms allclose {ok}', flush=True)\r\n\u001b[?2004l\r"]
[1064.198927, "o", "\u001b[?2004h> "]
[1064.198956, "o", "        results.append((t, cfg))\r\n\u001b[?2004l\r"]
[1064.198983, "o", "\u001b[?2004h> "]
[1064.199011, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1064.199038, "o", "\u001b[?2004h> "]
[1064.199092, "o", "        print(f'cfg {cfg}: failed {str(ex)[:90]}', flush=True)\r\n\u001b[?2004l\r"]
[1064.19912, "o", "\u001b[?2004h> "]
[1064.199148, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.199175, "o", "t, BEST = results[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.199199, "o", "> "]
[1064.199228, "o", "print('BEST', BEST, t, flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.199256, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.199288, "o", "def full(xv):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.199312, "o", ">     split_only(xv)\r\n\u001b[?2004l\r"]
[1064.199336, "o", "\u001b[?2004h> "]
[1064.199389, "o", "    run_split(x1b, x2b, wt1, wt2, b15, outbuf, *BEST)\r\n\u001b[?2004l\r"]
[1064.199416, "o", "\u001b[?2004h> "]
[1064.199444, "o", "    return outbuf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.199501, "o", "print('full ms:', bench(lambda: full(x)), flush=True)\r\n\u001b[?2004l\r"]
[1064.199528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.199555, "o", "> fails = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.199583, "o", "> maxerr = 0.0\r\n\u001b[?2004l\r"]
[1064.199611, "o", "\u001b[?2004h> "]
[1064.199638, "o", "for i in range(30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.199668, "o", "    torch.manual_seed(5000 + i)\r\n\u001b[?2004l\r"]
[1064.199692, "o", "\u001b[?2004h> "]
[1064.199726, "o", "    xv = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r"]
[1064.19975, "o", "\u001b[?2004h> "]
[1064.19977, "o", "    rv = ref(xv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1064.199799, "o", ">     full(xv)\r\n\u001b[?2004l\r"]
[1064.199824, "o", "\u001b[?2004h> "]
[1064.199849, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.199903, "o", "    err = (outbuf - rv).abs().max().item()\r\n\u001b[?2004l\r"]
[1064.199931, "o", "\u001b[?2004h> "]
[1064.199958, "o", "    maxerr = max(maxerr, err)\r\n\u001b[?2004l\r"]
[1064.199982, "o", "\u001b[?2004h> "]
[1064.200036, "o", "    if not torch.allclose(outbuf, rv, atol=1e-4, rtol=1e-4):\r\n\u001b[?2004l\r"]
[1064.200062, "o", "\u001b[?2004h> "]
[1064.200089, "o", "        fails += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1064.200169, "o", "print(f'robustness: fails={fails}/30 maxerr={maxerr:.3e}', flush=True)\r\n\u001b[?2004l\r"]
