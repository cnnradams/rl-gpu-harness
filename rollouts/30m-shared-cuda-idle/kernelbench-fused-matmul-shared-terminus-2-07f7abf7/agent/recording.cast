[1223.426373, "o", "> "]
[1223.426434, "o", "def run_tma(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\r\n\u001b[?2004l\r"]
[1223.426462, "o", "\u001b[?2004h> "]
[1223.426491, "o", "    M, K = x1.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1223.42652, "o", "    N = wt1.shape[1]\r\n\u001b[?2004l\r"]
[1223.426544, "o", "\u001b[?2004h> "]
[1223.4266, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1223.426625, "o", "\u001b[?2004h> "]
[1223.426689, "o", "    split_gemm_tma[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\r\n\u001b[?2004l\r"]
[1223.426714, "o", "\u001b[?2004h> "]
[1223.426815, "o", "                         BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[1223.426841, "o", "\u001b[?2004h> "]
[1223.42687, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1223.426898, "o", "\u001b[?2004h> "]
[1223.426923, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1223.42695, "o", "> "]
[1223.426975, "o", "x = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r"]
[1223.42701, "o", "\u001b[?2004h> "]
[1223.427047, "o", "lin = torch.nn.Linear(IN, OUT).to(dev)\r\n\u001b[?2004l\r"]
