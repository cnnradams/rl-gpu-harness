[215.082196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.082305, "o", "# fp16 split with fp32 accumulate via mixed mm (x1w1 + x1w2 + x2w1) * 1.5 + b*1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.082339, "o", "> "]
[215.082372, "o", "x1 = x.half(); x2 = (x - x1.float()).half()\r\n\u001b[?2004l\r"]
[215.082399, "o", "\u001b[?2004h> "]
[215.08243, "o", "w1 = W.half(); w2 = (W - w1.float()).half()\r\n\u001b[?2004l\r"]
[215.082456, "o", "\u001b[?2004h> "]
[215.082504, "o", "Wt1 = w1.t().contiguous(); Wt2 = w2.t().contiguous()\r\n\u001b[?2004l\r"]
[215.082534, "o", "\u001b[?2004h> "]
[215.082588, "o", "outbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[215.082613, "o", "\u001b[?2004h> "]
[215.082668, "o", "tmp = torch.empty(B, OUT, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[215.082697, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.082722, "o", "> def split_mm():\r\n\u001b[?2004l\r"]
[215.082747, "o", "\u001b[?2004h> "]
[215.082782, "o", "    torch.mm(x1, Wt1, out=outbuf)\r\n\u001b[?2004l\r"]
[215.082807, "o", "\u001b[?2004h> "]
[215.082834, "o", "    torch.mm(x1, Wt2, out=tmp)\r\n\u001b[?2004l\r"]
[215.08286, "o", "\u001b[?2004h> "]
[215.082885, "o", "    outbuf.add_(tmp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.082924, "o", "    torch.mm(x2, Wt1, out=tmp)\r\n\u001b[?2004l\r"]
[215.082952, "o", "\u001b[?2004h> "]
[215.082976, "o", "    outbuf.add_(tmp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.083005, "o", "    outbuf.add_(b)\r\n\u001b[?2004l\r"]
[215.08303, "o", "\u001b[?2004h> "]
[215.083052, "o", "    outbuf.mul_(1.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.083078, "o", "    return outbuf\r\n\u001b[?2004l\r"]
[215.08309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[215.083114, "o", "\u001b[?2004h> "]
[215.083139, "o", "s = split_mm()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.083181, "o", "print('split ms:', bench(split_mm))\r\n\u001b[?2004l\r"]
[215.083206, "o", "\u001b[?2004h> "]
[215.083227, "o", "err = (s - r).abs()\r\n\u001b[?2004l\r"]
[215.083249, "o", "\u001b[?2004h> "]
[215.083274, "o", "rel = err / (r.abs() + 1e-6)\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.0833, "o", "> "]
[215.083398, "o", "print('split max abs err:', err.max().item(), 'allclose(1e-4):', torch.allclose(s, r, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r"]
[215.083422, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[215.08345, "o", "> "]
[215.083502, "o", "# how close is the fp32 ref itself to fp64 ground truth (context)\r\n\u001b[?2004l\r"]
[215.083531, "o", "\u001b[?2004h> "]
[215.083577, "o", "gt = (x.double() @ W.t().double() + b.double()) * 1.5\r\n\u001b[?2004l\r"]
[215.083602, "o", "\u001b[?2004h> "]
[215.083663, "o", "print('ref err vs fp64:', (r - gt.float()).abs().max().item())\r\n\u001b[?2004l\r"]
[215.083686, "o", "\u001b[?2004h> "]
[215.083752, "o", "print('split err vs fp64:', (s - gt.float()).abs().max().item())\r\n\u001b[?2004l\r"]
