[1515.654849, "i", "sed '/^class ModelNew/,$d' /workspace/solution.py > /workspace/exp9.py && cat >> /workspace/exp9.py << 'EOF'\nB, IN, OUT = 16384, 4096, 4096\ndev='cuda'\ndef bench(fn, n=100):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\ntorch.manual_seed(0)\nx = torch.rand(B, IN, device=dev)\nlin = torch.nn.Linear(IN, OUT).to(dev)\nW = lin.weight.detach().clone(); b = lin.bias.detach().clone()\nwt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\nb15 = (b*1.5).contiguous()\noutbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\nx1b = torch.empty(B, IN, device=dev, dtype=torch.half)\nx2b = torch.empty(B, IN, device=dev, dtype=torch.half)\nx1b.copy_(x); x2b.copy_(x - x1b.float())\nnumel = x.numel()\ndef full(BM,BN,BK,G,w,st):\n    _split_kernel[(triton.cdiv(numel,8192),)](x, x1b, x2b, numel, BLK=8192, num_warps=8)\n    grid "]
[1515.6549, "i", "= (triton.cdiv(B,BM)*triton.cdiv(OUT,BN),)\n    _split_gemm_tma[grid](x1b, x2b, wt1, wt2, b15, outbuf, B, OUT, IN, BM=BM, BN=BN, BK=BK, GROUP=G, num_warps=w, num_stages=st)\nfor cfg in [(128,256,32,8,8,3),(128,256,32,16,8,3),(128,256,32,4,8,3),(128,256,32,1,8,3),(128,256,32,32,8,3),(64,256,32,8,4,3),(128,128,32,8,8,3),(256,128,32,8,8,4)]:\n    try:\n        full(*cfg); torch.cuda.synchronize()\n        t = bench(lambda: full(*cfg))\n        print(f'full cfg {cfg}: {t:.3f} ms', flush=True)\n    except Exception as ex:\n        print(f'cfg {cfg}: failed {str(ex)[:80]}', flush=True)\nEOF\n"]
