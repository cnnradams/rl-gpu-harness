[215.081342, "o", "\u001b[?2004h> "]
[215.081374, "o", "    torch.mm(xh, Wh, out=out)\r\n\u001b[?2004l\r"]
[215.081407, "o", "\u001b[?2004h> "]
[215.081439, "o", "    print('mixed mm works, dtype:', out.dtype)\r\n\u001b[?2004l\r"]
[215.081469, "o", "\u001b[?2004h> "]
[215.0815, "o", "    def mm_mixed():\r\n\u001b[?2004l\r\u001b[?2004h"]
[215.081526, "o", "> "]
[215.081556, "o", "        return torch.mm(xh, Wh, out=out)\r\n\u001b[?2004l\r"]
[215.081581, "o", "\u001b[?2004h> "]
[215.081614, "o", "    print('mixed mm ms:', bench(mm_mixed))\r\n\u001b[?2004l\r"]
[215.08164, "o", "\u001b[?2004h> "]
[215.081706, "o", "    err = (out - x.double() @ W.t().double()).abs().max().item()\r\n\u001b[?2004l\r"]
[215.081716, "o", "\u001b[?2004h> "]
[215.081773, "o", "    print('mixed mm err vs fp64:', err)\r\n\u001b[?2004l\r"]
[215.081803, "o", "\u001b[?2004h> "]
[215.08183, "o", "except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[215.081874, "o", "    print('mixed mm failed:', ex)\r\n\u001b[?2004l\r"]
[215.081897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[215.081923, "o", "\u001b[?2004h> # addmm mixed\r\n\u001b[?2004l\r"]
[215.081949, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[215.081971, "o", "\u001b[?2004h> "]
[215.081995, "o", "    y2 = torch.addmm(b, xh, Wh)\r\n\u001b[?2004l\r"]
[215.082016, "o", "\u001b[?2004h> "]
