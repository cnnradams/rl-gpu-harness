[1299.262281, "o", "        if (x.dtype != torch.float32 or not x.is_cuda or M % 128 != 0 or N % 256 != 0 or K % 32 != 0):\r\n\u001b[?2004l\r"]
[1299.262311, "o", "\u001b[?2004h> "]
[1299.262338, "o", "            y = self.matmul(x)\r\n\u001b[?2004l\r"]
[1299.262361, "o", "\u001b[?2004h> "]
[1299.262411, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[1299.262438, "o", "\u001b[?2004h> "]
[1299.262529, "o", "        if self._prep is None or self._prep[0] != x.device or self._prep[1] != x.shape:\r\n\u001b[?2004l\r"]
[1299.262553, "o", "\u001b[?2004h> "]
[1299.262579, "o", "            self._prepare(x)\r\n\u001b[?2004l\r"]
[1299.262605, "o", "\u001b[?2004h> "]
[1299.262673, "o", "        dev, _, wt1, wt2, b_scaled, x1, x2, out = self._prep\r\n\u001b[?2004l\r"]
[1299.262701, "o", "\u001b[?2004h> "]
[1299.262726, "o", "        xc = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1299.262757, "o", "> "]
[1299.262782, "o", "        numel = xc.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1299.262906, "o", "        _split_kernel[(triton.cdiv(numel, 8192),)](xc, x1, x2, numel, BLK=8192, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1299.262986, "o", "        grid = (triton.cdiv(M, 128) * triton.cdiv(N, 256),)\r\n\u001b[?2004l\r"]
[1299.263013, "o", "\u001b[?2004h> "]
[1299.263087, "o", "        _split_gemm_tma[grid](x1, x2, wt1, wt2, b_scaled, out, M, N, K,\r\n\u001b[?2004l\r"]
[1299.26312, "o", "\u001b[?2004h> "]
[1299.263208, "o", "                              BM=128, BN=256, BK=32, GROUP=8, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r"]
[1299.263241, "o", "\u001b[?2004h> "]
[1299.263267, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1299.263287, "o", "EOF\r\n\u001b[?2004l\r"]
[1299.264993, "o", "\u001b[?2004hroot@modal:/# "]
