[1223.428431, "o", "\u001b[?2004h> "]
[1223.428484, "o", "        run_tma(x1b, x2b, wt1, wt2, b15, outbuf, *cfg)\r\n\u001b[?2004l\r"]
[1223.428516, "o", "\u001b[?2004h> "]
