[503.530085, "o", "> "]
[503.53013, "o", "    A1 = X1 + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[503.530159, "o", "\u001b[?2004h> "]
[503.530201, "o", "    A2 = X2 + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[503.530224, "o", "\u001b[?2004h> "]
[503.530283, "o", "    B1 = W1 + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[503.530308, "o", "\u001b[?2004h> "]
[503.530353, "o", "    B2 = W2 + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[503.530377, "o", "\u001b[?2004h> "]
[503.530421, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[503.530449, "o", "\u001b[?2004h> "]
[503.530479, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[503.530503, "o", "\u001b[?2004h> "]
[503.530531, "o", "        a1 = tl.load(A1)\r\n\u001b[?2004l\r"]
[503.53056, "o", "\u001b[?2004h> "]
[503.530584, "o", "        a2 = tl.load(A2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.530622, "o", "        b1 = tl.load(B1)\r\n\u001b[?2004l\r"]
[503.530649, "o", "\u001b[?2004h> "]
[503.530673, "o", "        b2 = tl.load(B2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.530701, "o", "> "]
[503.530729, "o", "        acc = tl.dot(a1, b1, acc)\r\n\u001b[?2004l\r"]
[503.530757, "o", "\u001b[?2004h> "]
[503.530783, "o", "        acc = tl.dot(a1, b2, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.530807, "o", "> "]
[503.530835, "o", "        acc = tl.dot(a2, b1, acc)\r\n\u001b[?2004l\r"]
[503.530863, "o", "\u001b[?2004h> "]
[503.53089, "o", "        A1 += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.530914, "o", "> "]
[503.530943, "o", "        A2 += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.530977, "o", "        B1 += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.531008, "o", "        B2 += BK * swk\r\n\u001b[?2004l\r"]
[503.531032, "o", "\u001b[?2004h> "]
[503.531071, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[503.531098, "o", "\u001b[?2004h> "]
[503.531126, "o", "    c = acc * 1.5 + bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.531149, "o", "> "]
[503.531185, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[503.53121, "o", "\u001b[?2004h> "]
[503.531236, "o", "    tl.store(Cp, c)\r\n\u001b[?2004l\r"]
[503.531264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[503.531291, "o", "> "]
[503.531364, "o", "def run_split(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\r\n\u001b[?2004l\r"]
[503.531389, "o", "\u001b[?2004h> "]
[503.531418, "o", "    M, K = x1.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.531445, "o", "    N = wt1.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.531469, "o", "> "]
[503.531509, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[503.531536, "o", "\u001b[?2004h> "]
[503.531597, "o", "    split_gemm[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.531695, "o", "                     x1.stride(0), x1.stride(1), wt1.stride(0), wt1.stride(1),\r\n\u001b[?2004l\r"]
[503.53172, "o", "\u001b[?2004h> "]
[503.531775, "o", "                     out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[503.531804, "o", "\u001b[?2004h> "]
[503.531896, "o", "                     BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[503.531921, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r"]
[503.531946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[503.53197, "o", "\u001b[?2004h> "]
[503.532001, "o", "x = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.532029, "o", "> "]
[503.532057, "o", "lin = torch.nn.Linear(IN, OUT).to(dev)\r\n\u001b[?2004l\r"]
[503.532086, "o", "\u001b[?2004h> "]
[503.532152, "o", "W = lin.weight.detach().clone(); b = lin.bias.detach().clone()\r\n\u001b[?2004l\r"]
[503.532174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[503.532196, "o", "\u001b[?2004h> "]
[503.532223, "o", "def ref():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.532277, "o", "    y = torch.nn.functional.linear(x, W, b)\r\n\u001b[?2004l\r"]
[503.532306, "o", "\u001b[?2004h> "]
[503.532331, "o", "    o = y.clone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.532357, "o", "    return y * 0.5 + o\r\n\u001b[?2004l\r"]
[503.532383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.532408, "o", "r = ref()\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.532437, "o", "> "]
[503.532462, "o", "print('ref ms:', bench(ref), flush=True)\r\n"]
[503.532487, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.532548, "o", "x1 = x.half(); x2 = (x - x1.float()).half()\r\n\u001b[?2004l\r"]
[503.532573, "o", "\u001b[?2004h> "]
[503.532662, "o", "wt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.53271, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[503.532735, "o", "\u001b[?2004h> "]
[503.532792, "o", "outbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[503.532819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[503.532842, "o", "\u001b[?2004h> "]
[503.532868, "o", "# pure fp16 mm rate reference\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.532896, "o", "> def fp16mm():\r\n\u001b[?2004l\r"]
[503.532923, "o", "\u001b[?2004h> "]
[503.53295, "o", "    return torch.mm(x1, wt1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.532978, "o", "> "]
[503.533007, "o", "print('fp16 mm ms:', bench(fp16mm), flush=True)\r\n\u001b[?2004l\r"]
[503.533033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[503.533052, "o", "> "]
[503.533247, "o", "for (BM, BN, BK, G, w, st) in [(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,64,8,4,4),(256,256,64,8,8,2),(128,256,32,8,8,4),(256,128,32,8,8,4),(64,256,64,8,4,4),(128,64,64,8,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.533279, "o", ">     try:"]
[503.533305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[503.533378, "o", "        o = run_split(x1, x2, wt1, wt2, b15, outbuf, BM, BN, BK, G, w, st)\r\n\u001b[?2004l\r"]
[503.533407, "o", "\u001b[?2004h> "]
[503.533462, "o", "        ok = torch.allclose(o, r, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[503.533487, "o", "> "]
[503.533518, "o", "        err = (o - r).abs().max().item()\r\n\u001b[?2004l\r"]
[503.533546, "o", "\u001b[?2004h> "]
[503.533638, "o", "        t = bench(lambda: run_split(x1, x2, wt1, wt2, b15, outbuf, BM, BN, BK, G, w, st))\r\n\u001b[?2004l\r"]
[503.533667, "o", "\u001b[?2004h> "]
[503.533774, "o", "        print(f'cfg BM{BM} BN{BN} BK{BK} G{G} w{w} s{st}: {t:.3f} ms, maxerr {err:.2e}, allclose {ok}', flush=True)\r\n\u001b[?2004l\r"]
[503.533801, "o", "\u001b[?2004h> "]
[503.533828, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[503.533853, "o", "\u001b[?2004h> "]
[503.533919, "o", "        print(f'cfg BM{BM} BN{BN} BK{BK}: failed {ex}', flush=True)\r\n\u001b[?2004l\r"]
[503.533947, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
