[902.736004, "o", "cfg (128, 256, 32, 16, 8, 4): 2.669 ms allclose True\r\ncfg (128, 256, 32, 4, 8, 4): 2.671 ms allclose True\r\n"]
[902.837587, "o", "cfg (256, 128, 32, 8, 8, 4): 2.642 ms allclose True\r\ncfg (128, 256, 64, 8, 8, 3): failed out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block s\r\n"]
[906.155442, "o", "cfg (128, 256, 32, 8, 4, 4): 25.248 ms allclose True\r\n"]
[906.255079, "o", "cfg (128, 128, 32, 8, 4, 4): 3.319 ms allclose True\r\n"]
[909.590465, "o", "cfg (256, 256, 32, 8, 8, 3): 28.935 ms allclose True\r\ncfg (128, 256, 32, 8, 8, 3): 2.654 ms allclose True\r\nBEST (256, 128, 32, 8, 8, 4) 2.6416876220703127\r\nfull ms: 3.139312744140625\r\n"]
