[1223.428221, "o", "\u001b[?2004h> "]
[1223.428371, "o", "for cfg in [(128,256,32,8,8,3),(128,256,64,8,8,3),(256,128,32,8,8,4),(128,256,64,8,8,4),(256,256,32,8,8,3),(128,256,64,8,8,2),(256,128,64,8,8,3)]:\r\n\u001b[?2004l\r"]
