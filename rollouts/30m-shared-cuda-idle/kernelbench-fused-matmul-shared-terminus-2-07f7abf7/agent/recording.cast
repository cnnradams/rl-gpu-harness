[823.004903, "o", "for cfg in [(128,256,32,8,8,3),(128,256,32,8,8,2),(128,128,32,8,4,3),(128,256,64,8,8,2),(128,256,32,16,8,3),(128,256,32,4,8,3),(64,256,32,8,4,3),(128,64,32,8,4,4),(128,128,32,8,4,4),(128,128,32,8,8,3),(256,128,32,8,8,3),(128,512,32,8,8,3)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
