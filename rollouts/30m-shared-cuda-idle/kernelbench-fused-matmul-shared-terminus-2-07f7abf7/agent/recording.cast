[895.059559, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[895.059591, "o", "\u001b[?2004h> "]
[895.059623, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[895.059645, "o", "\u001b[?2004h> "]
[895.05968, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[895.059704, "o", "\u001b[?2004h> "]
[895.059731, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[895.059745, "o", "\u001b[?2004h> "]
[895.059802, "o", "    A1 = X1 + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[895.059824, "o", "\u001b[?2004h> "]
[895.059874, "o", "    A2 = X2 + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[895.059901, "o", "\u001b[?2004h> "]
[895.059946, "o", "    B1 = W1 + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[895.059973, "o", "\u001b[?2004h> "]
[895.060018, "o", "    B2 = W2 + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[895.060045, "o", "\u001b[?2004h> "]
[895.060085, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[895.060112, "o", "\u001b[?2004h> "]
[895.060144, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[895.060172, "o", "\u001b[?2004h> "]
[895.060199, "o", "        a1 = tl.load(A1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.060226, "o", "> "]
[895.060253, "o", "        a2 = tl.load(A2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.06028, "o", "        b1 = tl.load(B1)\r\n\u001b[?2004l\r"]
[895.060302, "o", "\u001b[?2004h> "]
[895.06033, "o", "        b2 = tl.load(B2)\r\n\u001b[?2004l\r"]
[895.060357, "o", "\u001b[?2004h> "]
[895.060381, "o", "        acc = tl.dot(a1, b1, acc)\r\n\u001b[?2004l\r"]
[895.060405, "o", "\u001b[?2004h> "]
[895.060432, "o", "        acc = tl.dot(a1, b2, acc)\r\n\u001b[?2004l\r"]
[895.06046, "o", "\u001b[?2004h> "]
[895.060486, "o", "        acc = tl.dot(a2, b1, acc)\r\n\u001b[?2004l\r"]
[895.060509, "o", "\u001b[?2004h> "]
[895.060536, "o", "        A1 += BK * sxk\r\n\u001b[?2004l\r"]
[895.060559, "o", "\u001b[?2004h> "]
[895.060583, "o", "        A2 += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.060609, "o", "> "]
[895.060636, "o", "        B1 += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.060663, "o", "        B2 += BK * swk\r\n\u001b[?2004l\r"]
[895.060691, "o", "\u001b[?2004h> "]
[895.060725, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[895.060752, "o", "\u001b[?2004h> "]
[895.060779, "o", "    c = acc * 1.5 + bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.060807, "o", "> "]
[895.060839, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[895.060866, "o", "\u001b[?2004h> "]
[895.060894, "o", "    tl.store(Cp, c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[895.06093, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[895.060994, "o", "def run_split(x1, x2, wt1, wt2, b15, out, BM, BN, BK, GROUP, warps, stages):\r\n\u001b[?2004l\r"]
[895.061023, "o", "\u001b[?2004h> "]
[895.061055, "o", "    M, K = x1.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.061083, "o", ">     N = wt1.shape[1]\r\n\u001b[?2004l\r"]
[895.061111, "o", "\u001b[?2004h> "]
[895.061161, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[895.061184, "o", "\u001b[?2004h> "]
[895.06124, "o", "    split_gemm[grid](x1, x2, wt1, wt2, b15, out, M, N, K,\r\n\u001b[?2004l\r"]
[895.061267, "o", "\u001b[?2004h> "]
[895.061344, "o", "                     x1.stride(0), x1.stride(1), wt1.stride(0), wt1.stride(1),\r\n\u001b[?2004l\r"]
[895.061371, "o", "\u001b[?2004h> "]
[895.061415, "o", "                     out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[895.061447, "o", "\u001b[?2004h> "]
[895.061528, "o", "                     BM=BM, BN=BN, BK=BK, GROUP=GROUP, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[895.061555, "o", "\u001b[?2004h> "]
[895.061585, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[895.061613, "o", "\u001b[?2004h> "]
[895.061639, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.06167, "o", "x = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r"]
[895.061697, "o", "\u001b[?2004h> "]
[895.06173, "o", "lin = torch.nn.Linear(IN, OUT).to(dev)\r\n\u001b[?2004l\r"]
[895.061756, "o", "\u001b[?2004h> "]
[895.061814, "o", "W = lin.weight.detach().clone(); b = lin.bias.detach().clone()\r\n\u001b[?2004l\r"]
[895.061841, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.061868, "o", "> def ref(xv):\r\n\u001b[?2004l\r"]
[895.061894, "o", "\u001b[?2004h> "]
[895.06193, "o", "    y = torch.nn.functional.linear(xv, W, b)\r\n\u001b[?2004l\r"]
[895.061957, "o", "\u001b[?2004h> "]
[895.061984, "o", "    o = y.clone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.062011, "o", "    return y * 0.5 + o\r\n\u001b[?2004l\r"]
[895.062039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.062131, "o", "wt1 = W.half().t().contiguous(); wt2 = (W - W.half().float()).half().t().contiguous()\r\n\u001b[?2004l\r"]
[895.062154, "o", "\u001b[?2004h> "]
[895.062181, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[895.062209, "o", "\u001b[?2004h> "]
[895.062263, "o", "outbuf = torch.empty(B, OUT, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[895.062291, "o", "\u001b[?2004h> "]
[895.062338, "o", "x1b = torch.empty(B, IN, device=dev, dtype=torch.half)\r\n\u001b[?2004l\r"]
[895.062366, "o", "\u001b[?2004h> "]
[895.062414, "o", "x2b = torch.empty(B, IN, device=dev, dtype=torch.half)\r\n\u001b[?2004l\r"]
[895.062441, "o", "\u001b[?2004h> "]
[895.062493, "o", "ftmp = torch.empty(B, IN, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[895.062515, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.062543, "o", "> "]
[895.062568, "o", "def split_only(xv):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.062596, "o", "    x1b.copy_(xv)\r\n\u001b[?2004l\r"]
[895.06262, "o", "\u001b[?2004h> "]
[895.062648, "o", "    torch.sub(xv, x1b, out=ftmp)\r\n\u001b[?2004l\r"]
[895.062675, "o", "\u001b[?2004h> "]
[895.062701, "o", "    x2b.copy_(ftmp)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[895.062728, "o", "\u001b[?2004h> r = ref(x)\r\n\u001b[?2004l\r"]
[895.062755, "o", "\u001b[?2004h> "]
[895.062783, "o", "split_only(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.06284, "o", "print('split ms:', bench(lambda: split_only(x)), flush=True)\r\n\u001b[?2004l\r"]
[895.062867, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.062894, "o", "> results = []\r\n\u001b[?2004l\r"]
[895.062921, "o", "\u001b[?2004h> "]
[895.063131, "o", "for cfg in [(128,256,32,8,8,4),(128,256,32,8,8,5),(128,256,32,16,8,4),(128,256,32,4,8,4),(256,128,32,8,8,4),(128,256,64,8,8,3),(128,256,32,8,4,4),(128,128,32,8,4,4),(256,256,32,8,8,3),(128,256,32,8,8,3)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.063156, "o", "> "]
[895.063179, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.063231, "o", "        run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg)\r\n\u001b[?2004l\r"]
[895.063259, "o", "\u001b[?2004h> "]
[895.063286, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[895.063314, "o", "\u001b[?2004h> "]
[895.063366, "o", "        ok = torch.allclose(outbuf, r, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[895.063394, "o", "\u001b[?2004h> "]
[895.063464, "o", "        t = bench(lambda: run_split(x1b, x2b, wt1, wt2, b15, outbuf, *cfg))\r\n\u001b[?2004l\r"]
[895.063492, "o", "\u001b[?2004h> "]
[895.06355, "o", "        print(f'cfg {cfg}: {t:.3f} ms allclose {ok}', flush=True)\r\n\u001b[?2004l\r"]
[895.063584, "o", "\u001b[?2004h> "]
[895.06361, "o", "        results.append((t, cfg))\r\n\u001b[?2004l\r"]
[895.063638, "o", "\u001b[?2004h> "]
[895.063666, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.06369, "o", "> "]
[895.063738, "o", "        print(f'cfg {cfg}: failed {str(ex)[:90]}', flush=True)\r\n\u001b[?2004l\r"]
[895.063765, "o", "\u001b[?2004h> "]
[895.063792, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.06382, "o", "t, BEST = results[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.063847, "o", "> "]
[895.063874, "o", "print('BEST', BEST, t, flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.063899, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.063919, "o", "def full(xv):\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.063947, "o", "> "]
[895.063975, "o", "    split_only(xv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.064023, "o", "    run_split(x1b, x2b, wt1, wt2, b15, outbuf, *BEST)\r\n\u001b[?2004l\r"]
[895.064047, "o", "\u001b[?2004h> "]
[895.064065, "o", "    return outbuf\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.064093, "o", "> "]
[895.064135, "o", "print('full ms:', bench(lambda: full(x)), flush=True)\r\n\u001b[?2004l\r"]
[895.064162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.06419, "o", "> fails = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.064216, "o", "maxerr = 0.0\r\n\u001b[?2004l\r"]
[895.064243, "o", "\u001b[?2004h> "]
[895.06427, "o", "for i in range(30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.064299, "o", "    torch.manual_seed(3000 + i)\r\n\u001b[?2004l\r"]
[895.064325, "o", "\u001b[?2004h> "]
[895.064359, "o", "    xv = torch.rand(B, IN, device=dev)\r\n\u001b[?2004l\r"]
[895.064387, "o", "\u001b[?2004h> "]
[895.06441, "o", "    rv = ref(xv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.064429, "o", "    full(xv)\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.064457, "o", "> "]
[895.064485, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.064512, "o", "> "]
[895.064539, "o", "    err = (outbuf - rv).abs().max().item()\r\n\u001b[?2004l\r"]
[895.06456, "o", "\u001b[?2004h> "]
[895.064593, "o", "    maxerr = max(maxerr, err)\r\n\u001b[?2004l\r"]
[895.064614, "o", "\u001b[?2004h> "]
[895.064675, "o", "    if not torch.allclose(outbuf, rv, atol=1e-4, rtol=1e-4):\r\n\u001b[?2004l\r"]
[895.064702, "o", "\u001b[?2004h> "]
[895.064727, "o", "        fails += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.064807, "o", "print(f'robustness: fails={fails}/30 maxerr={maxerr:.3e}', flush=True)\r\n\u001b[?2004l\r"]
[895.064835, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[895.066735, "o", "\u001b[?2004hroot@modal:/# "]
[895.557494, "i", "gpu push sb-rgu7vVM6WyhRvht6Ze80E4 /workspace/exp5.py /workspace/exp5.py && gpu exec sb-rgu7vVM6WyhRvht6Ze80E4 -- python3 /workspace/exp5.py\n"]
[895.55777, "o", "gpu push sb-rgu7vVM6WyhRvht6Ze80E4 /workspace/exp5.py /workspace/exp5.py && gpu exec sb-rgu7vVM6WyhRvht6Ze80E4 -- python3 /workspace/exp5.py\r\n\u001b[?2004l\r"]
