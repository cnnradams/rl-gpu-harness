[1401.290804, "o", "> "]
[1401.290928, "o", "        kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.290963, "o", "> "]
[1401.290994, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1401.291026, "o", "> "]
