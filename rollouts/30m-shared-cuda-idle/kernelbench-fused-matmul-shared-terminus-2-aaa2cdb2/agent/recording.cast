[1612.648563, "i", "cat > /workspace/tune3.py << 'EOF'\nimport os\nimport torch, triton, triton.language as tl, itertools, numpy as np\n\n@triton.jit\ndef kk(a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr, M, N, K,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GM * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GM\n    group_size_m = min(num_pid_m - first_pid_m, GM)\n    pid_m = first_pid_m + (pid % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]\n    bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]\n    bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(a_ptrs)\n        ah = a.to(tl.float16)\n        al = (a "]
[1612.648745, "i", "- ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptrs)\n        bl = tl.load(bl_ptrs)\n        acc = tl.dot(al, bh, acc=acc)\n        acc = tl.dot(ah, bl, acc=acc)\n        acc = tl.dot(ah, bh, acc=acc)\n        a_ptrs += BK\n        bh_ptrs += BK * N\n        bl_ptrs += BK * N\n    bias = tl.load(bias_ptr + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nlin = torch.nn.Linear(4096, 4096).to(dev)\nB = (lin.weight.detach().t().contiguous() * 1.5).contiguous()\nBh = B.half(); Bl = (B - Bh.float()).half()\nbias = (lin.bias.detach() * 1.5).contiguous()\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(43)\nx = torch.rand(M, K, device=dev)\nref = torch.nn.functional.linear(x, lin.weight, lin.bias) * 1.5\ncache = torch.empty(256*1024*1024, dtype=torch.int8, device=dev)\nout = torch.empty(M, N, device=dev)\nresults = []\nfor (BM, BN, BK, GM, w, s) in itertools.product([64,128,256],[64,128,256],[32,64,128],[4,8,16,32],[4,8],[3]):\n    "]
[1612.648795, "o", "cat > /workspace/tune3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1612.648843, "i", "smem = (BM*BK*4 + 2*BK*BN*2) * s\n    if smem > 200000 or BM*BN > 256*128: continue\n    try:\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        bad = False\n        for rep in range(3):\n            kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)\n            torch.cuda.synchronize()\n            if torch.isnan(out).any().item() or not torch.allclose(ref, out, atol=1e-4, rtol=1e-4):\n                bad = True; break\n        if bad:\n            print(BM,BN,BK,GM,w,s,'BAD')\n            continue\n        ts = []\n        for _ in range(10):\n            torch.cuda.synchronize()\n            st = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\n            cache.zero_()\n            st.record(); kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s); en.record()\n            torch.cuda.synchronize()\n            ts.append(st.elapsed_time(en))\n        t = float(np.mean(ts))\n        results.appen"]
[1612.648874, "o", "> import os\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.648916, "i", "d((t, (BM,BN,BK,GM,w,s)))\n        print(BM,BN,BK,GM,w,s, f'{t:.3f}')\n    except Exception as e:\n        pass\nresults.sort()\nprint('TOP5:', results[:5])\nEOF\ngpu push $B /workspace/tune3.py /workspace/tune3.py && gpu exec $B -- bash -c 'python3 /workspace/tune3.py > /workspace/tune3.log 2>&1; tail -5 /workspace/tune3.log'\n"]
