[1401.286301, "i", "cat > /workspace/repro3.py << 'EOF'\nimport os\nos.environ['TORCH_USE_CUDA_DSA'] = '1'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef kk(a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr, M, N, K,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GM * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GM\n    group_size_m = min(num_pid_m - first_pid_m, GM)\n    pid_m = first_pid_m + (pid % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]\n    bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]\n    bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(a_ptrs)\n        ah = a.to(tl.float16)\n"]
[1401.286472, "i", "        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptrs)\n        bl = tl.load(bl_ptrs)\n        acc = tl.dot(al, bh, acc=acc)\n        acc = tl.dot(ah, bl, acc=acc)\n        acc = tl.dot(ah, bh, acc=acc)\n        a_ptrs += BK\n        bh_ptrs += BK * N\n        bl_ptrs += BK * N\n    bias = tl.load(bias_ptr + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\n\ndev = 'cuda'\ntorch.manual_seed(42)\nlin = torch.nn.Linear(4096, 4096).to(dev)\nalpha = 1.5\nB = (lin.weight.detach().t().contiguous() * alpha).contiguous()\nBh = B.half(); Bl = (B - Bh.float()).half()\nbias = (lin.bias.detach() * alpha).contiguous()\nM = N = K = 16384, 4096, 4096\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(43)\nx = torch.rand(M, K, device=dev)\nref = torch.nn.functional.linear(x, lin.weight, lin.bias) * 1.5\n\nfor (BM, BN, BK, GM, w, s) in [\n    (128,128,32,16,8,4), (128,128,32,4,8,4), (128,128,32,8,8,4),\n    (256,128,32,8,8,3), (128,256,32,8,8,3),\n]:\n    out = torch.empty"]
[1401.287413, "o", "cat > /workspace/repro3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> os.environ['TORCH_USE_CUDA_DSA'] = '1'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def kk(a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h>        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h>     num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h>     num_pid_in_group = GM * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h>     group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r\u001b[?2004h>     first_pid_m = group_id * GM\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1401.287506, "i", "(M, N, device=dev)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    for rep in range(5):\n        kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)\n        torch.cuda.synchronize()\n        n_nan = torch.isnan(out).sum().item()\n        md = (ref - out).abs().max().item()\n        print(f'cfg {BM},{BN},{BK},{GM},w{w},s{s} rep{rep}: nan={n_nan} maxdiff={md:.2e}')\nEOF\ngpu push $B /workspace/repro3.py /workspace/repro3.py && gpu exec $B -- python3 /workspace/repro3.py\n"]
