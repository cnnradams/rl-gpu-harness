[1612.652158, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[1612.652189, "o", "> "]
[1612.65222, "o", "torch.manual_seed(43)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.652272, "o", "x = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r"]
[1612.652304, "o", "\u001b[?2004h> "]
[1612.652385, "o", "ref = torch.nn.functional.linear(x, lin.weight, lin.bias) * 1.5\r\n\u001b[?2004l\r"]
[1612.652417, "o", "\u001b[?2004h> "]
[1612.652488, "o", "cache = torch.empty(256*1024*1024, dtype=torch.int8, device=dev)\r\n\u001b[?2004l\r"]
[1612.65252, "o", "\u001b[?2004h> "]
[1612.652557, "o", "out = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r"]
[1612.652588, "o", "\u001b[?2004h> "]
[1612.65262, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.652766, "o", "for (BM, BN, BK, GM, w, s) in itertools.product([64,128,256],[64,128,256],[32,64,128],[4,8,16,32],[4,8],[3]):\r\n\u001b[?2004l\r"]
[1612.652804, "o", "\u001b[?2004h> "]
[1612.652835, "o", "    smem = (BM*BK*4 + 2*BK*BN*2) * s\r\n\u001b[?2004l\r"]
[1612.652867, "o", "\u001b[?2004h> "]
[1612.652922, "o", "    if smem > 200000 or BM*BN > 256*128: continue\r\n\u001b[?2004l\r"]
[1612.652953, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1612.652985, "o", "\u001b[?2004h> "]
[1612.653056, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1612.653087, "o", "\u001b[?2004h> "]
[1612.653118, "o", "        bad = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.653164, "o", "        for rep in range(3):\r\n\u001b[?2004l\r"]
[1612.653196, "o", "\u001b[?2004h> "]
[1612.653335, "o", "            kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[1612.653368, "o", "\u001b[?2004h> "]
[1612.653407, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1612.653439, "o", "\u001b[?2004h> "]
[1612.653559, "o", "            if torch.isnan(out).any().item() or not torch.allclose(ref, out, atol=1e-4, rtol=1e-4):\r\n\u001b[?2004l\r"]
[1612.653592, "o", "\u001b[?2004h> "]
[1612.653633, "o", "                bad = True; break\r\n\u001b[?2004l\r"]
[1612.653666, "o", "\u001b[?2004h> "]
[1612.653697, "o", "        if bad:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.653748, "o", "            print(BM,BN,BK,GM,w,s,'BAD')\r\n\u001b[?2004l\r"]
[1612.65378, "o", "\u001b[?2004h> "]
[1612.653811, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[1612.653842, "o", ">         ts = []\r\n\u001b[?2004l\r"]
[1612.653873, "o", "\u001b[?2004h> "]
[1612.653905, "o", "        for _ in range(10):\r\n\u001b[?2004l\r"]
[1612.653936, "o", "\u001b[?2004h> "]
[1612.653968, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1612.654, "o", "\u001b[?2004h> "]
[1612.654125, "o", "            st = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1612.654161, "o", "\u001b[?2004h> "]
[1612.654193, "o", "            cache.zero_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.654384, "o", "            st.record(); kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s); en.record()\r\n\u001b[?2004l\r"]
[1612.654413, "o", "\u001b[?2004h> "]
[1612.654454, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1612.654486, "o", "\u001b[?2004h> "]
[1612.654533, "o", "            ts.append(st.elapsed_time(en))\r\n\u001b[?2004l\r"]
[1612.654565, "o", "\u001b[?2004h> "]
[1612.654597, "o", "        t = float(np.mean(ts))\r\n\u001b[?2004l\r"]
[1612.654628, "o", "\u001b[?2004h> "]
[1612.654679, "o", "        results.append((t, (BM,BN,BK,GM,w,s)))\r\n\u001b[?2004l\r"]
[1612.654712, "o", "\u001b[?2004h> "]
[1612.654756, "o", "        print(BM,BN,BK,GM,w,s, f'{t:.3f}')\r\n"]
[1612.654787, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1612.654825, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[1612.654862, "o", "\u001b[?2004h> "]
[1612.654899, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.654931, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1612.654969, "o", "print('TOP5:', results[:5])\r\n\u001b[?2004l\r"]
[1612.655, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1612.656878, "o", "\u001b[?2004hroot@modal:/# "]
