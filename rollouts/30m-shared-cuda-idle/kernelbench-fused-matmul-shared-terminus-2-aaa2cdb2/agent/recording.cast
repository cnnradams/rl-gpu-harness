[1117.602529, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": false,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"max_difference\": [\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\"\r\n    ],\r\n    \"avg_difference\": [\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\"\r\n    ],\r\n    \"correctness_issue\": \"Output mismatch\",\r\n    \"correctness_trials\": \"(0 / 5)\"\r\n  },\r\n  \"runtime\": -1.0,\r\n  \"runtime_stats\": {},\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0162,\r\n    \"min\": 11.3,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"f1dfc045918f7bed93d923d22ef6a0b512ead79a72dcb3b16a9e011f2c7aa78a\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 0.0\r\n}\r\n"]
