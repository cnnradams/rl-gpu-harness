[1410.141726, "o", "cfg 128,128,32,16,w8,s4 rep0: nan=5632 maxdiff=nan\r\ncfg 128,128,32,16,w8,s4 rep1: nan=6272 maxdiff=nan\r\ncfg 128,128,32,16,w8,s4 rep2: nan=6912 maxdiff=nan\r\ncfg 128,128,32,16,w8,s4 rep3: nan=4352 maxdiff=nan\r\ncfg 128,128,32,16,w8,s4 rep4: nan=5120 maxdiff=nan\r\ncfg 128,128,32,4,w8,s4 rep0: nan=7424 maxdiff=nan\r\ncfg 128,128,32,4,w8,s4 rep1: nan=7168 maxdiff=nan\r\ncfg 128,128,32,4,w8,s4 rep2: nan=5120 maxdiff=nan\r\ncfg 128,128,32,4,w8,s4 rep3: nan=5120 maxdiff=nan\r\ncfg 128,128,32,4,w8,s4 rep4: nan=5376 maxdiff=nan\r\ncfg 128,128,32,8,w8,s4 rep0: nan=3968 maxdiff=nan\r\ncfg 128,128,32,8,w8,s4 rep1: nan=7424 maxdiff=nan\r\ncfg 128,128,32,8,w8,s4 rep2: nan=5760 maxdiff=nan\r\ncfg 128,128,32,8,w8,s4 rep3: nan=5504 maxdiff=nan\r\ncfg 128,128,32,8,w8,s4 rep4: nan=6400 maxdiff=nan\r\ncfg 256,128,32,8,w8,s3 rep0: nan=0 maxdiff=4.32e-05\r\ncfg 256,128,32,8,w8,s3 rep1: nan=0 maxdiff=4.32e-05\r\ncfg 256,128,32,8,w8,s3 rep2: nan=0 maxdiff=4.32e-05\r\ncfg 256,128,32,8,w8,s3 rep3: nan=0 maxdiff=4.32e-05\r\ncfg 256,128,32,8,w8,s3 rep4: nan=0 maxdiff"]
[1410.141801, "o", "=4.32e-05\r\ncfg 128,256,32,8,w8,s3 rep0: nan=0 maxdiff=4.32e-05\r\ncfg 128,256,32,8,w8,s3 rep1: nan=0 maxdiff=4.32e-05\r\ncfg 128,256,32,8,w8,s3 rep2: nan=0 maxdiff=4.32e-05\r\ncfg 128,256,32,8,w8,s3 rep3: nan=0 maxdiff=4.32e-05\r\ncfg 128,256,32,8,w8,s3 rep4: nan=0 maxdiff=4.32e-05\r\n"]
