[888.568944, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch, triton, triton.language as tl, itertools, numpy as np\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\n@triton.jit\ndef k_tma(a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr, WS: tl.constexpr):\n    a_desc = tl.make_tensor_descriptor(a_ptr, [M, K], [K, 1], [BM, BK])\n    bh_desc = tl.make_tensor_descriptor(bh_ptr, [K, N], [N, 1], [BK, BN])\n    bl_desc = tl.make_tensor_descriptor(bl_ptr, [K, N], [N, 1], [BK, BN])\n    c_desc = tl.make_tensor_descriptor(c_ptr, [M, N], [N, 1], [BM, BN])\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GM * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GM\n    group_size_m = min(num_pid_m - first_pid_m, GM)\n    pid_m = first_pid_m + (pid % group_size_m)\n    pid_n = (pid % num_pid"]
[888.569, "i", "_in_group) // group_size_m\n    rn = pid_n * BN + tl.arange(0, BN)\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in tl.range(0, K, BK, warp_specialize=WS):\n        a = a_desc.load([pid_m * BM, k])\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = bh_desc.load([k, pid_n * BN])\n        bl = bl_desc.load([k, pid_n * BN])\n        acc = tl.dot(ah, bh, acc=acc)\n        acc = tl.dot(ah, bl, acc=acc)\n        acc = tl.dot(al, bh, acc=acc)\n    bias = tl.load(bias_ptr + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_desc.store([pid_m * BM, pid_n * BN], acc)\n\nM, N, K = 16384, 4096, 4096\ndev = 'cuda'\ntorch.manual_seed(0)\na = torch.rand(M, K, device=dev)\nB = (torch.rand(K, N, device=dev) * 2 - 1) * (1.5/64.0)\nBh = B.half(); Bl = (B - Bh.float()).half()\nbias = torch.rand(N, device=dev) * 0.02\nout = torch.empty(M, N, device=dev)\ncache = torch.empty(256*1024*1024, dtype=torch.int8, device=dev)\nref = a @ B + bias\n\ndef run(BM, BN, BK, GM, w, s, WS):\n    grid = (trit"]
[888.569173, "i", "on.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_tma[grid](a, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, WS=WS, num_warps=w, num_stages=s)\n\nresults = []\nfor (BM, BN, BK, GM, w, s, WS) in [\n    (128,128,32,16,8,4,False), (128,128,32,16,8,4,True),\n    (128,128,64,16,8,3,False), (128,128,64,16,8,3,True),\n    (128,128,64,16,8,4,True), (128,256,64,8,8,3,True),\n    (256,128,64,8,8,3,True), (128,128,64,8,8,3,True),\n    (128,256,64,8,8,4,True), (256,128,64,8,8,4,True),\n    (128,128,32,8,8,4,True), (64,128,64,8,4,4,True),\n    (128,64,64,16,4,4,True), (128,128,128,16,8,3,True),\n]:\n    try:\n        run(BM,BN,BK,GM,w,s,WS)\n        torch.cuda.synchronize()\n        md = (ref-out).abs().max().item()\n        if not torch.allclose(ref, out, atol=1e-4, rtol=1e-4):\n            print(BM,BN,BK,GM,w,s,WS,'WRONG', md); continue\n        ts = []\n        for _ in range(15):\n            torch.cuda.synchronize()\n            st = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\n            cache.zer"]
[888.569242, "o", "cat > /workspace/tune2.py << 'EOF'\r\n\u001b[?2004l\r"]
[888.569301, "i", "o_()\n            st.record(); run(BM,BN,BK,GM,w,s,WS); en.record()\n            torch.cuda.synchronize()\n            ts.append(st.elapsed_time(en))\n        t = float(np.mean(ts))\n        results.append((t, (BM,BN,BK,GM,w,s,WS)))\n        print(BM,BN,BK,GM,w,s,WS, f'{t:.3f} ms maxdiff {md:.2e}')\n    except Exception as e:\n        print(BM,BN,BK,GM,w,s,WS,'ERR', str(e)[:100])\nresults.sort()\nprint('TOP5:', results[:5])\nEOF\n"]
