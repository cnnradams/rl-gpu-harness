[1033.902808, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\n_HAS_TRITON = False\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\ndef _cfgs():\n    return [\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GM': 16}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GM': 4}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GM': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GM': 8}, num_warps=8, num_stages=3),\n    ]\n\n\nif _HAS_TRITON:\n    @triton.autotune(configs=_cfgs(), key=['M', 'N', 'K'])\n    @triton.jit\n    def _mm_fp16x3_kernel(\n        a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr,\n        M, N, K,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr,\n    ):\n        pid = tl.program_id(0)\n      "]
[1033.902872, "i", "  num_pid_m = tl.cdiv(M, BM)\n        num_pid_n = tl.cdiv(N, BN)\n        num_pid_in_group = GM * num_pid_n\n        group_id = pid // num_pid_in_group\n        first_pid_m = group_id * GM\n        group_size_m = min(num_pid_m - first_pid_m, GM)\n        pid_m = first_pid_m + (pid % group_size_m)\n        pid_n = (pid % num_pid_in_group) // group_size_m\n\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n        a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]\n        bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]\n        bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for _ in range(0, K, BK):\n            a = tl.load(a_ptrs)\n            ah = a.to(tl.float16)\n            al = (a - ah.to(tl.float32)).to(tl.float16)\n            bh = tl.load(bh_ptrs)\n            bl = tl.load(bl_ptrs)\n            acc = tl.dot(al, bh, acc=acc)\n            acc = tl.dot(ah, bl, acc=acc)\n            acc = tl.dot(ah, b"]
[1033.902889, "i", "h, acc=acc)\n            a_ptrs += BK\n            bh_ptrs += BK * N\n            bl_ptrs += BK * N\n        bias = tl.load(bias_ptr + rn).to(tl.float32)\n        acc = acc + bias[None, :]\n        tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\n\n\ndef _triton_mm(a, bh, bl, bias, M, N, K):\n    out = torch.empty((M, N), device=a.device, dtype=torch.float32)\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    _mm_fp16x3_kernel[grid](a, bh, bl, bias, out, M, N, K)\n    return out\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._key = None\n\n    def _prepare(self, x):\n        with torch.no_grad():\n            alpha = 1.0 + float(self.scaling_factor)\n            B = (self.matmul.weight.detach().t().contiguous() * alpha).contiguous()\n            self._Bh = B.half()\n            self._Bl = (B - sel"]
[1033.903064, "i", "f._Bh.float()).half()\n            self._biasv = (self.matmul.bias.detach() * alpha).contiguous()\n            self._B32 = B\n        self._key = (x.device, x.dtype)\n\n    def forward(self, x):\n        if self._key != (x.device, x.dtype):\n            self._prepare(x)\n        M, K = x.shape\n        N = self._Bh.shape[1]\n        if (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32\n                and x.is_contiguous()\n                and M % 128 == 0 and N % 128 == 0 and K % 32 == 0):\n            return _triton_mm(x, self._Bh, self._Bl, self._biasv, M, N, K)\n        return torch.addmm(self._biasv, x, self._B32)\nEOF\n"]
