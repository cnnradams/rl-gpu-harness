[1251.622105, "i", "cat > /workspace/repro2.py << 'EOF'\nimport os\nos.environ['TORCH_USE_CUDA_DSA'] = '1'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom kernelbench.eval import (load_original_model_and_inputs, load_custom_model_with_tempfile,\n    set_seed, _process_input_tensor)\n\nref_src = open('/opt/task/reference.py').read()\ncand_src = open('/workspace/solution.py').read()\ndevice = torch.device('cuda:0')\ncontext = {}\nModel, get_init_inputs, get_inputs = load_original_model_and_inputs(ref_src, context)\nset_seed(42)\ninit_inputs = get_init_inputs()\ninit_inputs = [x.to(device) if torch.is_tensor(x) else x for x in init_inputs]\nwith torch.no_grad():\n    set_seed(42)\n    original_model = Model(*init_inputs)\nModelNew, tmp = load_custom_model_with_tempfile(cand_src, entry_point='ModelNew')\nwith torch.no_grad():\n    set_seed(42)\n    custom_model = ModelNew(*init_inputs)\n    original_model = original_model.to(device)\n    custom_model = custom_model.to(device)\n    set_seed(42)\n    inputs = get_inputs()\n    x = inputs[0].to(device"]
[1251.622159, "i", ")\n    o = original_model(x)\n    n = custom_model(x)\n    nan_mask = torch.isnan(n)\n    print('nan count:', nan_mask.sum().item(), 'of', n.numel())\n    rows = nan_mask.any(dim=1).nonzero().flatten()\n    cols = nan_mask.any(dim=0).nonzero().flatten()\n    print('nan rows:', rows[:10].tolist(), '... total', len(rows))\n    print('nan cols:', cols[:10].tolist(), '... total', len(cols))\n    # also direct addmm check\n    m = custom_model\n    out2 = torch.addmm(m._biasv, x, m._B32)\n    print('addmm maxdiff:', (o - out2).abs().max().item())\n    # inspect prepared weights\n    print('Bh nan?', torch.isnan(m._Bh).any().item(), 'Bl nan?', torch.isnan(m._Bl).any().item())\n    print('weight nan?', torch.isnan(m.matmul.weight).any().item())\nEOF\n"]
