[1033.906135, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1033.906186, "o", "\u001b[?2004h>         rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.906266, "o", "        a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[1033.906319, "o", "\u001b[?2004h> "]
[1033.906366, "o", "        bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1033.906442, "o", "\u001b[?2004h> "]
[1033.906494, "o", "        bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.906582, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.906631, "o", "> "]
[1033.906683, "o", "        for _ in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.906732, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.906794, "o", "            ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1033.906845, "o", "\u001b[?2004h> "]
[1033.906897, "o", "            al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1033.906949, "o", "\u001b[?2004h> "]
[1033.906998, "o", "            bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.907047, "o", "            bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r"]
[1033.907096, "o", "\u001b[?2004h> "]
[1033.907147, "o", "            acc = tl.dot(al, bh, acc=acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.907211, "o", "            acc = tl.dot(ah, bl, acc=acc)\r\n\u001b[?2004l\r"]
[1033.907261, "o", "\u001b[?2004h> "]
[1033.907311, "o", "            acc = tl.dot(ah, bh, acc=acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.907362, "o", "            a_ptrs += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.907421, "o", "> "]
[1033.90747, "o", "            bh_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.907518, "o", "            bl_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.907604, "o", "        bias = tl.load(bias_ptr + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[1033.907653, "o", "\u001b[?2004h> "]
[1033.907703, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.907783, "o", "        tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[1033.907832, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.907881, "o", "> "]
[1033.907936, "o", "def _triton_mm(a, bh, bl, bias, M, N, K):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.908029, "o", "    out = torch.empty((M, N), device=a.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1033.90808, "o", "\u001b[?2004h> "]
[1033.908167, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[1033.908219, "o", "\u001b[?2004h> "]
[1033.908271, "o", "    _mm_fp16x3_kernel[grid](a, bh, bl, bias, out, M, N, K)\r\n\u001b[?2004l\r"]
[1033.908322, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r"]
[1033.908374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.908434, "o", "> class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1033.908486, "o", "\u001b[?2004h> "]
[1033.908556, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1033.908606, "o", "\u001b[?2004h> "]
[1033.908658, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.908724, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1033.908775, "o", "\u001b[?2004h> "]
[1033.908832, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.908882, "o", "        self._key = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.908932, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.908984, "o", "    def _prepare(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.909036, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.909089, "o", "> "]
[1033.909139, "o", "            alpha = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.909268, "o", "            B = (self.matmul.weight.detach().t().contiguous() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[1033.90932, "o", "\u001b[?2004h> "]
[1033.90937, "o", "            self._Bh = B.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.909443, "o", "            self._Bl = (B - self._Bh.float()).half()\r\n\u001b[?2004l\r"]
[1033.909495, "o", "\u001b[?2004h> "]
[1033.909578, "o", "            self._biasv = (self.matmul.bias.detach() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[1033.909629, "o", "\u001b[?2004h> "]
[1033.909696, "o", "            self._B32 = B\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.909746, "o", "        self._key = (x.device, x.dtype)\r\n\u001b[?2004l\r"]
[1033.909796, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.909845, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.909928, "o", "        if self._key != (x.device, x.dtype):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.909977, "o", "> "]
[1033.910026, "o", "            self._prepare(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.910076, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.910125, "o", "        N = self._Bh.shape[1]\r\n\u001b[?2004l\r"]
[1033.91018, "o", "\u001b[?2004h> "]
[1033.910241, "o", "        if (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1033.910291, "o", "\u001b[?2004h> "]
[1033.91034, "o", "                and x.is_contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1033.910446, "o", "                and M % 128 == 0 and N % 128 == 0 and K % 32 == 0):\r\n\u001b[?2004l\r"]
[1033.910501, "o", "\u001b[?2004h> "]
[1033.910585, "o", "            return _triton_mm(x, self._Bh, self._Bl, self._biasv, M, N, K)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1033.910636, "o", "> "]
[1033.910685, "o", "        return torch.addmm(self._biasv, x, self._B32)\r\n\u001b[?2004l\r"]
[1033.910736, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1033.912694, "o", "\u001b[?2004hroot@modal:/# "]
