[1174.444738, "i", "cat > /workspace/repro.py << 'EOF'\nimport os\nos.environ['TORCH_USE_CUDA_DSA'] = '1'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom kernelbench.eval import (load_original_model_and_inputs, load_custom_model_with_tempfile,\n    set_seed, _process_input_tensor)\n\nref_src = open('/opt/task/reference.py').read()\ncand_src = open('/workspace/solution.py').read()\ndevice = torch.device('cuda:0')\nprecision = torch.float32\ncontext = {}\nModel, get_init_inputs, get_inputs = load_original_model_and_inputs(ref_src, context)\nset_seed(42)\ninit_inputs = get_init_inputs()\ninit_inputs = [_process_input_tensor(x, device, 'triton', precision) for x in init_inputs]\nwith torch.no_grad():\n    set_seed(42)\n    original_model = Model(*init_inputs)\nModelNew, tmp = load_custom_model_with_tempfile(cand_src, entry_point='ModelNew')\nwith torch.no_grad():\n    set_seed(42)\n    custom_model = ModelNew(*init_inputs)\n    original_model = original_model.to(device=device, dtype=precision)\n    custom_model = custom_model.to(device=device, dt"]
[1174.444938, "i", "ype=precision)\ntorch.cuda.synchronize()\nfor t in range(3):\n    set_seed(42 + t)\n    inputs = get_inputs()\n    inputs = [_process_input_tensor(x, device, 'triton', precision) for x in inputs]\n    with torch.no_grad():\n        o = original_model(*inputs)\n        n = custom_model(*inputs)\n    print('trial', t, 'ref nan?', torch.isnan(o).any().item(), 'new nan?', torch.isnan(n).any().item(),\n          'maxdiff', (o - n).abs().max().item(), 'allclose', torch.allclose(o, n, atol=1e-4, rtol=1e-4))\nEOF\n"]
[1174.445027, "o", "cat > /workspace/repro.py << 'EOF'\r\n\u001b[?2004l\r"]
