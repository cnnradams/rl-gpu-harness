[464.999164, "o", "        a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr,\r\n\u001b[?2004l\r"]
[464.999197, "o", "\u001b[?2004h> "]
[464.999229, "o", "        M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[464.999391, "o", "        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h>     ):\r\n\u001b[?2004l\r"]
[464.999454, "o", "\u001b[?2004h>         pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.99949, "o", "> "]
[464.999524, "o", "        num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.999575, "o", "> "]
[464.999616, "o", "        num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.99965, "o", "> "]
[464.9997, "o", "        num_pid_in_group = GM * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[464.999727, "o", "> "]
[464.999776, "o", "        group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[464.999809, "o", "\u001b[?2004h> "]
[464.999846, "o", "        first_pid_m = group_id * GM\r\n\u001b[?2004l\r"]
[464.999879, "o", "\u001b[?2004h> "]
[464.999944, "o", "        group_size_m = min(num_pid_m - first_pid_m, GM)\r\n\u001b[?2004l\r"]
[464.999981, "o", "\u001b[?2004h> "]
[465.000037, "o", "        pid_m = first_pid_m + (pid % group_size_m)\r\n\u001b[?2004l\r"]
[465.000075, "o", "\u001b[?2004h> "]
[465.000133, "o", "        pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[465.000166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[465.000199, "o", "> "]
[465.000242, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[465.000274, "o", "\u001b[?2004h> "]
[465.000337, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.000389, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[465.000422, "o", "\u001b[?2004h> "]
[465.000498, "o", "        a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.000532, "o", "> "]
[465.000594, "o", "        bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[465.000633, "o", "\u001b[?2004h> "]
[465.000703, "o", "        bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[465.000785, "o", "\u001b[?2004h> "]
[465.000824, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.00087, "o", "        for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[465.000902, "o", "\u001b[?2004h> "]
[465.000938, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[465.00097, "o", "\u001b[?2004h> "]
[465.001014, "o", "            ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[465.001046, "o", "\u001b[?2004h> "]
[465.001119, "o", "            al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.001153, "o", "> "]
[465.001185, "o", "            bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.001218, "o", "> "]
[465.001251, "o", "            bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r"]
[465.001284, "o", "\u001b[?2004h> "]
[465.001329, "o", "            acc = tl.dot(ah, bh, acc=acc)\r\n\u001b[?2004l\r"]
[465.001361, "o", "\u001b[?2004h> "]
[465.001418, "o", "            acc = tl.dot(ah, bl, acc=acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.001451, "o", "> "]
[465.001497, "o", "            acc = tl.dot(al, bh, acc=acc)\r\n\u001b[?2004l\r"]
[465.001529, "o", "\u001b[?2004h> "]
[465.001561, "o", "            a_ptrs += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.00163, "o", "            bh_ptrs += BK * N\r\n\u001b[?2004l\r"]
[465.001666, "o", "\u001b[?2004h> "]
[465.001702, "o", "            bl_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.001782, "o", "        bias = tl.load(bias_ptr + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[465.001816, "o", "\u001b[?2004h> "]
[465.001847, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[465.001879, "o", "\u001b[?2004h> "]
[465.001966, "o", "        tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.002001, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[465.002039, "o", "\u001b[?2004h> "]
[465.002087, "o", "def _triton_mm(a, bh, bl, bias, M, N, K):\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.00212, "o", "> "]
[465.002205, "o", "    out = torch.empty((M, N), device=a.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.002239, "o", "> "]
[465.002336, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[465.002369, "o", "\u001b[?2004h> "]
[465.002441, "o", "    _mm_fp16x3_kernel[grid](a, bh, bl, bias, out, M, N, K)\r\n\u001b[?2004l\r"]
[465.002515, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[465.00255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[465.002587, "o", "\u001b[?2004h> "]
[465.002609, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.002647, "o", "> "]
[465.002718, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[465.002752, "o", "\u001b[?2004h> "]
[465.002788, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.00288, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[465.002913, "o", "\u001b[?2004h> "]
[465.002995, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.003029, "o", "        self._key = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[465.003062, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[465.003096, "o", "    def _prepare(self, x):\r\n\u001b[?2004l\r"]
[465.003129, "o", "\u001b[?2004h> "]
[465.003165, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.003198, "o", "> "]
[465.003254, "o", "            alpha = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[465.003288, "o", "\u001b[?2004h> "]
[465.003388, "o", "            B = (self.matmul.weight.detach().t().contiguous() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[465.003425, "o", "\u001b[?2004h> "]
[465.003457, "o", "            self._Bh = B.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.003489, "o", "> "]
[465.003556, "o", "            self._Bl = (B - self._Bh.float()).half()\r\n\u001b[?2004l\r"]
[465.00359, "o", "\u001b[?2004h> "]
[465.003685, "o", "            self._biasv = (self.matmul.bias.detach() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[465.003717, "o", "\u001b[?2004h> "]
[465.00375, "o", "            self._B32 = B\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.003783, "o", "> "]
[465.003814, "o", "        self._key = (x.device, x.dtype)\r\n\u001b[?2004l\r"]
[465.003849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[465.003882, "o", "> "]
[465.003915, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.003983, "o", "        if self._key != (x.device, x.dtype):\r\n\u001b[?2004l\r"]
[465.004016, "o", "\u001b[?2004h> "]
[465.004049, "o", "            self._prepare(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.004081, "o", "> "]
[465.004114, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[465.00416, "o", "        N = self._Bh.shape[1]\r\n\u001b[?2004l\r"]
[465.004193, "o", "\u001b[?2004h> "]
[465.004284, "o", "        if (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32\r\n\u001b[?2004l\r\u001b[?2004h"]
[465.00432, "o", "> "]
[465.004362, "o", "                and x.is_contiguous()\r\n\u001b[?2004l\r"]
[465.004397, "o", "\u001b[?2004h> "]
[465.00448, "o", "                and M % 128 == 0 and N % 128 == 0 and K % 32 == 0):\r\n\u001b[?2004l\r"]
[465.004513, "o", "\u001b[?2004h> "]
[465.004616, "o", "            return _triton_mm(x, self._Bh, self._Bl, self._biasv, M, N, K)\r\n\u001b[?2004l\r"]
[465.00465, "o", "\u001b[?2004h> "]
[465.004715, "o", "        return torch.addmm(self._biasv, x, self._B32)\r\n\u001b[?2004l\r"]
[465.004748, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
