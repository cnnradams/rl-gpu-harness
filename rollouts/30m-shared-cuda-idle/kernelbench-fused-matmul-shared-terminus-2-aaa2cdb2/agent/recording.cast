[486.436183, "o", "trial 0: max_abs=4.363e-05 mean_abs=5.865e-06 allclose=True\r\ntrial 1: max_abs=4.387e-05 mean_abs=5.865e-06 allclose=True\r\ntrial 2: max_abs=4.292e-05 mean_abs=5.865e-06 allclose=True\r\ntrial 3: max_abs=4.435e-05 mean_abs=5.865e-06 allclose=True\r\ntrial 4: max_abs=4.578e-05 mean_abs=5.864e-06 allclose=True\r\nCORRECT\r\nref=11.405 ms  new=2.706 ms  speedup=4.21x\r\ntf32 allclose: False 0.0007386691868305206\r\ntf32 addmm fused: 1.698 ms -> speedup 6.71x\r\n"]
[486.62772, "o", "/usr/local/lib/python3.10/dist-packages/torch/backends/__init__.py:46: UserWarning: Please use the new API settings to control TF32 behavior, such as torch.backends.cudnn.conv.fp32_precision = 'tf32' or torch.backends.cuda.matmul.fp32_precision = 'ieee'. Old settings, e.g, torch.backends.cuda.matmul.allow_tf32 = True, torch.backends.cudnn.allow_tf32 = True, allowTF32CuDNN() and allowTF32CuBLAS() will be deprecated after Pytorch 2.9. Please see https://pytorch.org/docs/main/notes/cuda.html#tensorfloat-32-tf32-on-ampere-and-later-devices (Triggered internally at /pytorch/aten/src/ATen/Context.cpp:80.)\r\n  self.setter(val)\r\n"]
[487.599641, "o", "\u001b[?2004hroot@modal:/# "]
[555.049875, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, triton.language as tl, itertools, numpy as np\n\n@triton.jit\ndef k_fp16x3(a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GM * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GM\n    group_size_m = min(num_pid_m - first_pid_m, GM)\n    pid_m = first_pid_m + (pid % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]\n    bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]\n    bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(a_ptrs)\n        ah = a.to(tl.float16)\n        al = (a"]
[555.050166, "i", " - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptrs)\n        bl = tl.load(bl_ptrs)\n        acc = tl.dot(ah, bh, acc=acc)\n        acc = tl.dot(ah, bl, acc=acc)\n        acc = tl.dot(al, bh, acc=acc)\n        a_ptrs += BK\n        bh_ptrs += BK * N\n        bl_ptrs += BK * N\n    bias = tl.load(bias_ptr + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\n\nM = N = K = 16384, 4096, 4096\nM, N, K = 16384, 4096, 4096\ndev = 'cuda'\ntorch.manual_seed(0)\na = torch.rand(M, K, device=dev) * 2 - 1\nB = (torch.rand(K, N, device=dev) * 2 - 1) * 1.5\nBh = B.half(); Bl = (B - Bh.float()).half()\nbias = torch.rand(N, device=dev)\nout = torch.empty(M, N, device=dev)\ncache = torch.empty(256*1024*1024, dtype=torch.int8, device=dev)\n\nref = a @ B + bias\n\ndef run(BM, BN, BK, GM, w, s):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_fp16x3[grid](a, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)\n\nresults = []\nfor (BM, BN, BK, G"]
[555.050189, "o", "cat > /workspace/tune.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.050253, "i", "M, w, s) in itertools.product([64,128,256],[64,128,256],[32,64,128],[4,8,16],[4,8],[3,4,5]):\n    if BM*BN >= 256*256: continue\n    smem = (BM*BK*4 + 2*BK*BN*2) * s\n    if smem > 220000: continue\n    try:\n        run(BM,BN,BK,GM,w,s)\n        torch.cuda.synchronize()\n        if not torch.allclose(ref, out, atol=1e-4, rtol=1e-4):\n            print(BM,BN,BK,GM,w,s,'WRONG', (ref-out).abs().max().item()); continue\n        ts = []\n        for _ in range(10):\n            torch.cuda.synchronize()\n            st = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\n            cache.zero_()\n            st.record(); run(BM,BN,BK,GM,w,s); en.record()\n            torch.cuda.synchronize()\n            ts.append(st.elapsed_time(en))\n        t = float(np.mean(ts))\n        results.append((t, (BM,BN,BK,GM,w,s)))\n        print(BM,BN,BK,GM,w,s, f'{t:.3f} ms')\n    except Exception as e:\n        pass\nresults.sort()\nprint('TOP5:', results[:5])\nEOF\n"]
