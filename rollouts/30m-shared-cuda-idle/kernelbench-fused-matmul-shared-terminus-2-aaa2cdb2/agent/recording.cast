[262.312308, "o", "request ID: 254a2f058c664fc8854dcd76bc05ac4c\r\n"]
[267.956338, "o", "box: sb-OyGGUvkX891ltleqCeuZm2\r\ncommand: 70c09dedb07540f09112a40c321835ee\r\n{\r\n  \"id\": \"70c09dedb07540f09112a40c321835ee\",\r\n  \"trial\": \"113b9b8fe56643b98217273e4b640c46\",\r\n  \"box\": \"sb-OyGGUvkX891ltleqCeuZm2\",\r\n  \"state\": \"running\"\r\n}\r\n"]
[267.98847, "o", "\u001b[?2004hroot@modal:/# "]
[279.077651, "i", "gpu exec sb-OyGGUvkX891ltleqCeuZm2 -- python3 -c 'import torch, triton; print(torch.__version__, triton.__version__, torch.cuda.get_device_name(0))'\n"]
[279.078147, "o", "gpu exec sb-OyGGUvkX891ltleqCeuZm2 -- python3 -c 'import torch, triton; print(torch.__version__, triton.__version__, torch.cuda.get_device_name(0))'\r\n\u001b[?2004l\r"]
[279.270686, "o", "request ID: 01c30166c56e45729174655bf196f935\r\n"]
[281.393854, "o", "command: 4547e870463e4b6e866d9b50f01552eb\r\n"]
[284.076281, "o", "2.9.0+cu128 3.5.0 NVIDIA H100 80GB HBM3\r\n"]
[285.328145, "o", "\u001b[?2004hroot@modal:/# "]
[322.680538, "i", "cat > /workspace/test_prec.py << 'EOF'\nimport torch, sys, time\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\nclass Ref(torch.nn.Module):\n    def __init__(self, i, o, s):\n        super().__init__()\n        self.matmul = torch.nn.Linear(i, o)\n        self.scaling_factor = s\n    def forward(self, x):\n        x = self.matmul(x)\n        orig = x.clone().detach()\n        return x * self.scaling_factor + orig\n\ndev = 'cuda'\ntorch.manual_seed(42)\nref = Ref(4096, 4096, 0.5).to(dev)\ntorch.manual_seed(42)\nnew = ModelNew(4096, 4096, 0.5).to(dev)\n\nok = True\nfor t in range(5):\n    torch.manual_seed(42 + t)\n    x = torch.rand(16384, 4096, device=dev)\n    with torch.no_grad():\n        a = ref(x)\n        b = new(x)\n    d = (a - b).abs()\n    rel = d / (a.abs() + 1e-6)\n    passed = torch.allclose(a, b, atol=1e-4, rtol=1e-4)\n    ok &= passed\n    print(f'trial {t}: max_abs={d.max().item():.3e} mean_abs={d.mean().item():.3e} allclose={passed}')\nprint('CORRECT' if ok else 'INCORRECT')\n\n# timing like evaluator\ndef b"]
[322.680735, "i", "ench(fn, x, n=20):\n    for _ in range(3):\n        fn(x); torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    cache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.int8, device=dev)\n    times = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        cache.zero_()\n        s.record(); fn(x); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    import numpy as np\n    return np.mean(times)\n\nwith torch.no_grad():\n    x = torch.rand(16384, 4096, device=dev)\n    t_ref = bench(ref, x)\n    t_new = bench(new, x)\n    print(f'ref={t_ref:.3f} ms  new={t_new:.3f} ms  speedup={t_ref/t_new:.2f}x')\n\n# info: tf32 accuracy\nwith torch.no_grad():\n    a = ref(x)\n    with torch.backends.cuda.matmul.flags(allow_tf32=True) if hasattr(torch.backends.cuda.matmul, 'flags') else torch.no_grad():\n        pass\ntorch.backends.cuda.matmul.allow_tf32 = True\ntorch.backends.cudnn.allow_tf32 = True\nwith "]
[322.680801, "i", "torch.no_grad():\n    x32 = x\n    y = torch.nn.functional.linear(x32, ref.matmul.weight, ref.matmul.bias) * 1.5\n    print('tf32 allclose:', torch.allclose(a, y, atol=1e-4, rtol=1e-4), (a-y).abs().max().item())\n    w = ref.matmul.weight.t().contiguous() * 1.5\n    b = ref.matmul.bias * 1.5\n    t_addmm = bench(lambda v: torch.addmm(b, v, w), x)\n    print(f'tf32 addmm fused: {t_addmm:.3f} ms -> speedup {t_ref/t_addmm:.2f}x')\nEOF\n"]
[322.680856, "o", "cat > /workspace/test_prec.py << 'EOF'\r\n\u001b[?2004l\r"]
[322.680901, "o", "torch.no_grad():\r\n    x32 = x\r\n    y = torch.nn.functional.linear(x32, ref.matmul.weight, ref.matmul.bias) * 1.5\r\n    print('tf32 allclose:', torch.allclose(a, y, atol=1e-4, rtol=1e-4), (a-y).abs().max().item())\r\n    w = ref.matmul.weight.t().contiguous() * 1.5\r\n    b = ref.matmul.bias * 1.5\r\n    t_addmm = bench(lambda v: torch.addmm(b, v, w), x)\r\n    print(f'tf32 addmm fused: {t_addmm:.3f} ms -> speedup {t_ref/t_addmm:.2f}x')\r\nEOF\r\n\u001b[?2004h> "]
[322.680944, "o", "import torch, sys, time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681016, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681078, "o", "from solution import ModelNew\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.68113, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.68119, "o", "class Ref(torch.nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681242, "o", "    def __init__(self, i, o, s):\r\n\u001b[?2004l\r"]
[322.681292, "o", "\u001b[?2004h> "]
[322.68134, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681398, "o", "        self.matmul = torch.nn.Linear(i, o)\r\n\u001b[?2004l\r"]
[322.681445, "o", "\u001b[?2004h> "]
[322.681492, "o", "        self.scaling_factor = s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681538, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681583, "o", "        x = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.681633, "o", "> "]
[322.68168, "o", "        orig = x.clone().detach()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681742, "o", "        return x * self.scaling_factor + orig\r\n\u001b[?2004l\r"]
[322.681789, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681838, "o", "dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.681884, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.68194, "o", "ref = Ref(4096, 4096, 0.5).to(dev)\r\n\u001b[?2004l\r"]
[322.68199, "o", "\u001b[?2004h> "]
[322.682038, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682085, "o", "new = ModelNew(4096, 4096, 0.5).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.682132, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682189, "o", "ok = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682239, "o", "for t in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682288, "o", "    torch.manual_seed(42 + t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.68236, "o", "    x = torch.rand(16384, 4096, device=dev)\r\n\u001b[?2004l\r"]
[322.682408, "o", "\u001b[?2004h> "]
[322.682456, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682503, "o", "        a = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682549, "o", "        b = new(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.682596, "o", ">     d = (a - b).abs()\r\n\u001b[?2004l\r"]
[322.682644, "o", "\u001b[?2004h> "]
[322.682708, "o", "    rel = d / (a.abs() + 1e-6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.682774, "o", "    passed = torch.allclose(a, b, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[322.682824, "o", "\u001b[?2004h>     ok &= passed\r\n\u001b[?2004l\r"]
[322.682871, "o", "\u001b[?2004h> "]
[322.683004, "o", "    print(f'trial {t}: max_abs={d.max().item():.3e} mean_abs={d.mean().item():.3e} allclose={passed}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.683062, "o", "> "]
[322.68311, "o", "print('CORRECT' if ok else 'INCORRECT')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.683165, "o", "# timing like evaluator\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.683212, "o", "> def bench(fn, x, n=20):\r\n\u001b[?2004l\r"]
[322.683258, "o", "\u001b[?2004h> "]
[322.683306, "o", "    for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.683361, "o", "        fn(x); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.683414, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.683466, "o", "> "]
[322.683533, "o", "    cache = torch.empty(256 * 1024 * 1024 // 4, dtype=torch.int8, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.683609, "o", ">     times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.683656, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.683701, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[322.683749, "o", "\u001b[?2004h> "]
[322.683848, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[322.683894, "o", "\u001b[?2004h> "]
[322.683942, "o", "        cache.zero_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.683988, "o", "        s.record(); fn(x); e.record()\r\n\u001b[?2004l\r"]
[322.684035, "o", "\u001b[?2004h> "]
[322.684081, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.684134, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[322.684189, "o", "\u001b[?2004h>     import numpy as np\r\n\u001b[?2004l\r"]
[322.684236, "o", "\u001b[?2004h> "]
[322.684283, "o", "    return np.mean(times)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.684331, "o", "\u001b[?2004h> "]
[322.684379, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.684441, "o", "    x = torch.rand(16384, 4096, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.684489, "o", ">     t_ref = bench(ref, x)\r\n\u001b[?2004l\r"]
[322.684536, "o", "\u001b[?2004h> "]
[322.684582, "o", "    t_new = bench(new, x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.684697, "o", "    print(f'ref={t_ref:.3f} ms  new={t_new:.3f} ms  speedup={t_ref/t_new:.2f}x')\r\n\u001b[?2004l\r"]
[322.684747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.684796, "o", "\u001b[?2004h> # info: tf32 accuracy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.684842, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.68489, "o", ">     a = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.684936, "o", "> "]
[322.685098, "o", "    with torch.backends.cuda.matmul.flags(allow_tf32=True) if hasattr(torch.backends.cuda.matmul, 'flags') else torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.685158, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.685225, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[322.685272, "o", "\u001b[?2004h> "]
[322.68532, "o", "torch.backends.cudnn.allow_tf32 = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.685369, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.685416, "o", ">     x32 = x\r\n\u001b[?2004l\r\u001b[?2004h"]
[322.685462, "o", "> "]
[322.685544, "o", "    y = torch.nn.functional.linear(x32, ref.matmul.weight, ref.matmul.bias) * 1.5\r\n\u001b[?2004l\r"]
[322.685593, "o", "\u001b[?2004h> "]
[322.685701, "o", "    print('tf32 allclose:', torch.allclose(a, y, atol=1e-4, rtol=1e-4), (a-y).abs().max().item())\r\n\u001b[?2004l\r"]
[322.685748, "o", "\u001b[?2004h> "]
[322.685795, "o", "    w = ref.matmul.weight.t().contiguous() * 1.5\r\n\u001b[?2004l\r"]
[322.685839, "o", "\u001b[?2004h> "]
[322.685885, "o", "    b = ref.matmul.bias * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[322.685966, "o", "    t_addmm = bench(lambda v: torch.addmm(b, v, w), x)\r\n\u001b[?2004l\r"]
[322.686013, "o", "\u001b[?2004h> "]
[322.686105, "o", "    print(f'tf32 addmm fused: {t_addmm:.3f} ms -> speedup {t_ref/t_addmm:.2f}x')\r\n\u001b[?2004l\r"]
