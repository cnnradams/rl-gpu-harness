[1467.672989, "o", "    grid = (triton.cdiv(M, 256) * triton.cdiv(N, 128),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.673039, "o", "    _mm_fp16x3_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h"]
[1467.673088, "o", "> "]
[1467.673144, "o", "        a, bh, bl, bias, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.673222, "o", "        BM=256, BN=128, BK=32, GM=8, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r"]
[1467.67328, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r"]
[1467.673336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.673394, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1467.673443, "o", "\u001b[?2004h> "]
[1467.673494, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1467.673544, "o", "\u001b[?2004h>         super().__init__()\r\n\u001b[?2004l\r"]
[1467.673593, "o", "\u001b[?2004h> "]
[1467.673655, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1467.673706, "o", "\u001b[?2004h> "]
[1467.673762, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[1467.673819, "o", ">         self._key = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1467.673893, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.673959, "o", "    def _prepare(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674007, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674067, "o", "            alpha = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[1467.674115, "o", "\u001b[?2004h> "]
[1467.674203, "o", "            B = (self.matmul.weight.detach().t().contiguous() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[1467.674259, "o", "\u001b[?2004h> "]
[1467.674314, "o", "            self._Bh = B.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674379, "o", "            self._Bl = (B - self._Bh.float()).half()\r\n\u001b[?2004l\r"]
[1467.674428, "o", "\u001b[?2004h> "]
[1467.674511, "o", "            self._biasv = (self.matmul.bias.detach() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[1467.674562, "o", "\u001b[?2004h> "]
[1467.674612, "o", "            self._B32 = B\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674662, "o", "        self._key = (x.device, x.dtype)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1467.674711, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674762, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674841, "o", "        if self._key != (x.device, x.dtype):\r\n\u001b[?2004l\r"]
[1467.67489, "o", "\u001b[?2004h> "]
[1467.674941, "o", "            self._prepare(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.674991, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.67504, "o", "        N = self._Bh.shape[1]\r\n\u001b[?2004l\r"]
[1467.67509, "o", "\u001b[?2004h> "]
[1467.675155, "o", "        if (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1467.675205, "o", "\u001b[?2004h> "]
[1467.675254, "o", "                and x.is_contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1467.67536, "o", "                and M % 256 == 0 and N % 128 == 0 and K % 32 == 0):\r\n\u001b[?2004l\r"]
[1467.67541, "o", "\u001b[?2004h> "]
[1467.675486, "o", "            return _triton_mm(x, self._Bh, self._Bl, self._biasv, M, N, K)\r\n\u001b[?2004l\r"]
[1467.675534, "o", "\u001b[?2004h> "]
[1467.675588, "o", "        return torch.addmm(self._biasv, x, self._B32)\r\n\u001b[?2004l\r"]
[1467.675637, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
