[555.052026, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[555.052059, "o", "\u001b[?2004h> "]
[555.052094, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[555.052128, "o", "\u001b[?2004h> "]
[555.052163, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[555.052197, "o", "\u001b[?2004h> "]
[555.052262, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[555.052295, "o", "\u001b[?2004h> "]
[555.052334, "o", "        bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r"]
[555.052362, "o", "\u001b[?2004h> "]
[555.052407, "o", "        bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r"]
[555.052437, "o", "\u001b[?2004h> "]
[555.052488, "o", "        acc = tl.dot(ah, bh, acc=acc)\r\n\u001b[?2004l\r"]
[555.052522, "o", "\u001b[?2004h> "]
[555.052569, "o", "        acc = tl.dot(ah, bl, acc=acc)\r\n\u001b[?2004l\r"]
[555.052608, "o", "\u001b[?2004h> "]
[555.05265, "o", "        acc = tl.dot(al, bh, acc=acc)\r\n\u001b[?2004l\r"]
[555.052683, "o", "\u001b[?2004h> "]
[555.052717, "o", "        a_ptrs += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.052751, "o", "> "]
[555.052784, "o", "        bh_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.052817, "o", "> "]
[555.052849, "o", "        bl_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.052893, "o", "> "]
[555.052958, "o", "    bias = tl.load(bias_ptr + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.053006, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053043, "o", "> "]
[555.053115, "o", "    tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053147, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.053204, "o", "M = N = K = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053238, "o", "> "]
[555.053271, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053303, "o", "> dev = 'cuda'\r\n\u001b[?2004l\r"]
[555.053336, "o", "\u001b[?2004h> "]
[555.05337, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.053438, "o", "a = torch.rand(M, K, device=dev) * 2 - 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053474, "o", "> "]
[555.053523, "o", "B = (torch.rand(K, N, device=dev) * 2 - 1) * 1.5\r\n\u001b[?2004l\r"]
[555.053557, "o", "\u001b[?2004h> "]
[555.053605, "o", "Bh = B.half(); Bl = (B - Bh.float()).half()\r\n\u001b[?2004l\r"]
[555.053638, "o", "\u001b[?2004h> "]
[555.053666, "o", "bias = torch.rand(N, device=dev)\r\n\u001b[?2004l\r"]
[555.053702, "o", "\u001b[?2004h> "]
[555.053742, "o", "out = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r"]
[555.053776, "o", "\u001b[?2004h> "]
[555.053856, "o", "cache = torch.empty(256*1024*1024, dtype=torch.int8, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053899, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.053933, "o", "ref = a @ B + bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.053966, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.05402, "o", "def run(BM, BN, BK, GM, w, s):\r\n\u001b[?2004l\r"]
[555.054054, "o", "\u001b[?2004h> "]
[555.054122, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[555.05416, "o", "\u001b[?2004h> "]
[555.054297, "o", "    k_fp16x3[grid](a, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.054328, "o", "> \r\n\u001b[?2004l\r"]
[555.054362, "o", "\u001b[?2004h> results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.054397, "o", "> "]
[555.054533, "o", "for (BM, BN, BK, GM, w, s) in itertools.product([64,128,256],[64,128,256],[32,64,128],[4,8,16],[4,8],[3,4,5]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.054576, "o", "> "]
[555.054612, "o", "    if BM*BN >= 256*256: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.054671, "o", "    smem = (BM*BK*4 + 2*BK*BN*2) * s\r\n\u001b[?2004l\r"]
[555.054709, "o", "\u001b[?2004h> "]
[555.05474, "o", "    if smem > 220000: continue\r\n\u001b[?2004l\r"]
[555.054774, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[555.054807, "o", "\u001b[?2004h> "]
[555.054843, "o", "        run(BM,BN,BK,GM,w,s)\r\n\u001b[?2004l\r"]
[555.054875, "o", "\u001b[?2004h> "]
[555.055022, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.055057, "o", "        if not torch.allclose(ref, out, atol=1e-4, rtol=1e-4):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.055175, "o", "            print(BM,BN,BK,GM,w,s,'WRONG', (ref-out).abs().max().item()); continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.05521, "o", "> "]
[555.05524, "o", "        ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.055289, "o", "        for _ in range(10):\r\n\u001b[?2004l\r"]
[555.055327, "o", "\u001b[?2004h> "]
[555.055368, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[555.055402, "o", "\u001b[?2004h> "]
[555.055528, "o", "            st = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[555.055566, "o", "\u001b[?2004h> "]
[555.055599, "o", "            cache.zero_()\r\n\u001b[?2004l\r"]
[555.055627, "o", "\u001b[?2004h> "]
[555.055708, "o", "            st.record(); run(BM,BN,BK,GM,w,s); en.record()\r\n\u001b[?2004l\r"]
[555.055737, "o", "\u001b[?2004h> "]
[555.055788, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[555.05582, "o", "\u001b[?2004h> "]
[555.055875, "o", "            ts.append(st.elapsed_time(en))\r\n\u001b[?2004l\r"]
[555.055917, "o", "\u001b[?2004h> "]
[555.055962, "o", "        t = float(np.mean(ts))\r\n\u001b[?2004l\r"]
[555.055995, "o", "\u001b[?2004h> "]
[555.056055, "o", "        results.append((t, (BM,BN,BK,GM,w,s)))\r\n\u001b[?2004l\r"]
[555.056094, "o", "\u001b[?2004h> "]
[555.056149, "o", "        print(BM,BN,BK,GM,w,s, f'{t:.3f} ms')\r\n\u001b[?2004l\r"]
[555.056179, "o", "\u001b[?2004h> "]
[555.056217, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[555.056252, "o", "\u001b[?2004h> "]
[555.056281, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[555.056314, "o", "results.sort()\r\n\u001b[?2004l\r"]
[555.056353, "o", "\u001b[?2004h> "]
[555.056396, "o", "print('TOP5:', results[:5])\r\n\u001b[?2004l\r\u001b[?2004h"]
[555.056415, "o", "> "]
[555.05648, "o", "EOF\r\n\u001b[?2004l\r"]
