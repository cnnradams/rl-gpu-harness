[?2004l[?2004h> import os
[?2004l[?2004h> import torch, triton, triton.language as tl, itertools, numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def kk(a_ptr, bh_ptr, bl_ptr, bias_ptr, c_ptr, M, N, K,
[?2004l[?2004h>        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     num_pid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     num_pid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     num_pid_in_group = GM * num_pid_n
[?2004l[?2004h>     group_id = pid // num_pid_in_group
[?2004l[?2004h>     first_pid_m = group_id * GM
[?2004l[?2004h>     group_size_m = min(num_pid_m - first_pid_m, GM)
[?2004l[?2004h>     pid_m = first_pid_m + (pid % group_size_m)
[?2004l[?2004h>     pid_n = (pid % num_pid_in_group) // group_size_m
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     rn = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     rk = tl.arange(0, BK)
[?2004l[?2004h>     a_ptrs = a_ptr + rm[:, None] * K + rk[None, :]
[?2004l[?2004h>     bh_ptrs = bh_ptr + rk[:, None] * N + rn[None, :]
[?2004l[?2004h>     bl_ptrs = bl_ptr + rk[:, None] * N + rn[None, :]
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for _ in range(0, K, BK):
[?2004l[?2004h>         a = tl.load(a_ptrs)
[?2004l[?2004h>         ah = a.to(tl.float16)
[?2004l[?2004h>         al = (a - ah.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>         bh = tl.load(bh_ptrs)
[?2004l[?2004h>         bl = tl.load(bl_ptrs)
[?2004l[?2004h>         acc = tl.dot(al, bh, acc=acc)
[?2004l[?2004h>         acc = tl.dot(ah, bl, acc=acc)
[?2004l[?2004h>         acc = tl.dot(ah, bh, acc=acc)
[?2004l[?2004h>         a_ptrs += BK
[?2004l[?2004h>         bh_ptrs += BK * N
[?2004l[?2004h>         bl_ptrs += BK * N
[?2004l[?2004h>     bias = tl.load(bias_ptr + rn).to(tl.float32)
[?2004l[?2004h>     acc = acc + bias[None, :]
[?2004l[?2004h>     tl.store(c_ptr + rm[:, None] * N + rn[None, :], acc)
[?2004l[?2004h> 
[?2004l[?2004h> dev = 'cuda'
[?2004l[?2004h> torch.manual_seed(42)
[?2004l[?2004h> lin = torch.nn.Linear(4096, 4096).to(dev)
[?2004l[?2004h> B = (lin.weight.detach().t().contiguous() * 1.5).contiguous()
[?2004l[?2004h> Bh = B.half(); Bl = (B - Bh.float()).half()
[?2004l[?2004h> bias = (lin.bias.detach() * 1.5).contiguous()
[?2004l[?2004h> M, N, K = 16384, 4096, 4096
[?2004l[?2004h> torch.manual_seed(43)
[?2004l[?2004h> x = torch.rand(M, K, device=dev)
[?2004l[?2004h> ref = torch.nn.functional.linear(x, lin.weight, lin.bias) * 1.5
[?2004l[?2004h> cache = torch.empty(256*1024*1024, dtype=torch.int8, device=dev)
[?2004l[?2004h> out = torch.empty(M, N, device=dev)
[?2004l[?2004h> results = []
[?2004l[?2004h> for (BM, BN, BK, GM, w, s) in itertools.product([64,128,256],[64,128,256],[32,64,128],[4,8,16,32],[4,8],[3]):
[?2004l[?2004h>     smem = (BM*BK*4 + 2*BK*BN*2) * s
[?2004l[?2004h>     if smem > 200000 or BM*BN > 256*128: continue
[?2004l[?2004h>     try:
[?2004l[?2004h>         grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
[?2004l[?2004h>         bad = False
[?2004l[?2004h>         for rep in range(3):
[?2004l[?2004h>             kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s)
[?2004l[?2004h>             torch.cuda.synchronize()
[?2004l[?2004h>             if torch.isnan(out).any().item() or not torch.allclose(ref, out, atol=1e-4, rtol=1e-4):
[?2004l[?2004h>                 bad = True; break
[?2004l[?2004h>         if bad:
[?2004l[?2004h>             print(BM,BN,BK,GM,w,s,'BAD')
[?2004l[?2004h>             continue
[?2004l[?2004h>         ts = []
[?2004l[?2004h>         for _ in range(10):
[?2004l[?2004h>             torch.cuda.synchronize()
[?2004l[?2004h>             st = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>             cache.zero_()
[?2004l[?2004h>             st.record(); kk[grid](x, Bh, Bl, bias, out, M, N, K, BM=BM, BN=BN, BK=BK, GM=GM, num_warps=w, num_stages=s); en.record()
[?2004l[?2004h>             torch.cuda.synchronize()
[?2004l[?2004h>             ts.append(st.elapsed_time(en))
[?2004l[?2004h>         t = float(np.mean(ts))
[?2004l[?2004h>         results.append((t, (BM,BN,BK,GM,w,s)))
[?2004l[?2004h>         print(BM,BN,BK,GM,w,s, f'{t:.3f}')
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         pass
[?2004l[?2004h> results.sort()
[?2004l[?2004h> print('TOP5:', results[:5])
