[1264.678651, "i", "sed -n 220,300p /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\n"]
[1264.678907, "o", "sed -n 220,300p /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\r\n\u001b[?2004l\r"]
[1264.680175, "o", "        kernel_fn: Function to time\r\n        args: Arguments to pass to kernel_fn\r\n        num_warmup: Number of warmup iterations before timing\r\n        num_trials: Number of timing trials to run\r\n        discard_first: Number of first trials to discard, for consistency with host_time, set to 0 to disable\r\n        verbose: Whether to print per-trial timing info\r\n        device: CUDA device to use, defaults to current device\r\n\r\n    Returns:\r\n        List of elapsed times in milliseconds (length = num_trials)\r\n    \"\"\"\r\n    if device is None:\r\n        if verbose:\r\n            print(f\"Using current device: {torch.cuda.current_device()}\")\r\n        device = torch.cuda.current_device()\r\n\r\n"]
[1264.680251, "o", "    with torch.cuda.device(device):\r\n        \r\n        # Warm ups\r\n        for _ in range(num_warmup):\r\n            kernel_fn(*args)\r\n            torch.cuda.synchronize(device=device)\r\n        \r\n        # note this only release PyTorch’s CUDA caching allocator, not necessarily clearing device's L2 cache\r\n        torch.cuda.empty_cache()\r\n        \r\n        print(f\"[Profiling] Using device: {device} {torch.cuda.get_device_name(device)}, warm up {num_warmup}, trials {num_trials}\"\r\n        )\r\n\r\n        elapsed_times: list[float] = [] # in ms\r\n\r\n        # Timing trials\r\n        for trial in range(num_trials + discard_first):\r\n            torch.cuda.synchronize(device=device) # block on all streams\r\n\r\n            # create event marker default is not interprocess\r\n            start_event = torch.cuda.Event(enable_timing=True)\r\n            end_event = torch.cuda.Event(enable_timing=True)\r\n            \r\n            clear_l2_cache(device=device) # measuring cold cache performance\r\n"]
[1264.680305, "o", "\r\n            # note cuda events mark event on current stream\r\n            start_event.record()\r\n            _ = kernel_fn(*args)\r\n            end_event.record() \r\n\r\n            # waits for all streams on that device\r\n"]
[1264.680352, "o", "            # though it is important to note the events only record time between on current stream\r\n            # TODO: find ways to check hacks by launching work on additional stream\r\n            torch.cuda.synchronize(device=device)\r\n\r\n            # Calculate the elapsed time in milliseconds\r\n            elapsed_time_ms = start_event.elapsed_time(end_event)\r\n            \r\n            if trial >= discard_first:\r\n                if verbose:\r\n                    logical_idx = trial - discard_first + 1\r\n                    print(f\"Trial {logical_idx}: {elapsed_time_ms:.3g} ms\")\r\n                elapsed_times.append(elapsed_time_ms)\r\n\r\n\r\n    return elapsed_times\r\n\r\n\r\ndef time_execution_with_do_bench_interface(\r\n    kernel_fn: callable,\r\n    args: list[Any],\r\n    # Not used, as triton do_bench handles adaptive trials\r\n    num_warmup: int = 3, \r\n    num_trials: int = 10,\r\n    discard_first: int = 1, # not used here\r\n    verbose: bool = True,\r\n    device: torch.device | None = None) -> list[float]:\r\n    \"\"\"\r\n    Wr"]
[1264.680371, "o", "apper around Triton's do_bench for kernel timing.\r\n\r\n    Uses Triton's adaptive benchmarking with fixed time budgets (warmup=25ms, rep=100ms) [Triton do_bench default].\r\n    The number of trials is determined automatically based on kernel runtime.\r\n\r\n    Note: num_warmup, num_trials, discard_first are ignored - included only for \r\n    API compatibility with other timing functions.\r\n"]
[1264.680587, "o", "\u001b[?2004hroot@modal:/# "]
[1274.483446, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda', dtype=torch.float32)\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    w = (lin.weight * 1.5).contiguous()\n    b = (lin.bias * 1.5).contiguous()\nw1 = w.half(); w2 = (w - w1.float()).half()\nw1t = w1.t().contiguous(); w2t = w2.t().contiguous()\nx1 = x.half().contiguous(); x2 = (x - x1.float()).half().contiguous()\n\n@triton.jit\ndef gemm_tma(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    a1d = tl.make_tensor_descriptor(x1p, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    a2d = tl.make_tensor_descriptor(x2p, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    b1d = tl.make_tensor_descriptor(w1p, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    b2d = tl.make_tensor_descriptor(w2p, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    od = tl"]
[1274.483505, "i", ".make_tensor_descriptor(op, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM\n    on = pid_n * BN\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        va1 = a1d.load([om, k * BK])\n        va2 = a2d.load([om, k * BK])\n        vb1 = b1d.load([k * BK, on])\n        vb2 = b2d.load([k * BK, on])\n        a1 = tl.dot(va1, vb1, a1)\n        a2 = tl.dot(va2, vb1, a2)\n        a3 = tl.dot(va1, vb2, a3)\n    acc = a1 + a2 + a3\n    rn = on + tl.arange(0, BN)\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    od.store([om, on], acc)\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cud"]
[1274.483523, "i", "a', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\ndef timeit(fn, iters=30):\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nref = torch.nn.functional.linear(x, w, b)\n\nfor (BM, BN, BK, warps, stages, grp) in [\n    (128,128,64,8,4,8), (128,128,64,8,3,8), (128,128,64,8,4,16),\n    (128,128,128,8,3,8), (128,128,128,8,2,8),\n    (128,256,64,8,3,8), (256,128,64,8,3,8), (128,256,64,8,2,8),\n    (256,256,64,8,2,8), (128,128,256,8,2,8),\n    (64,128,128,8,3,8), (128,64,128,8,3,8),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        gemm_tma[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        t = timeit("]
[1274.483536, "i", "run)\n        tf = 3*2*M*N*K/t/1e9\n        print(f\"TMA BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\n    except Exception as ex:\n        print(f\"TMA BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:70]}\")\nEOF\nB64=$(base64 -w0 /workspace/bench6.py); gpu exec sb-bjV8oAqlifn4KdhgfSZIhn -- bash -c \"echo $B64 | base64 -d > /tmp/bench6.py && python3 /tmp/bench6.py\" 2>&1 | tail -14\n"]
