[821.715012, "o", "> "]
[821.715156, "o", "x = torch.rand(M, K, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.715273, "o", "lin = torch.nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[821.71531, "o", "\u001b[?2004h> "]
[821.715367, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[821.715398, "o", "\u001b[?2004h> "]
[821.715499, "o", "    w = (lin.weight * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[821.715526, "o", "\u001b[?2004h> "]
[821.715617, "o", "    b = (lin.bias * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[821.715649, "o", "\u001b[?2004h> "]
[821.715779, "o", "w1 = w.half(); w2 = (w - w1.float()).half()\r\n\u001b[?2004l\r"]
[821.715809, "o", "\u001b[?2004h> "]
[821.715946, "o", "w1t = w1.t().contiguous(); w2t = w2.t().contiguous()\r\n\u001b[?2004l\r"]
[821.715983, "o", "\u001b[?2004h> "]
[821.716197, "o", "x1 = x.half().contiguous(); x2 = (x - x1.float()).half().contiguous()\r\n\u001b[?2004l\r"]
[821.71621, "o", "\u001b[?2004h"]
[821.71625, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.716281, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[821.71631, "o", "\u001b[?2004h> "]
[821.716526, "o", "def _sched(pid, grid_m, grid_n, BM: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[821.716558, "o", "\u001b[?2004h> "]
[821.716611, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[821.716642, "o", "\u001b[?2004h> "]
[821.716709, "o", "    gid = pid // width\r\n\u001b[?2004l\r "]
[821.716748, "o", "\u001b[?2004h> "]
[821.716894, "o", "    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[821.716926, "o", "\u001b[?2004h> "]
[821.717047, "o", "    pid_m = gid * GROUP + (pid % gsize)\r\n\u001b[?2004l\r"]
[821.717082, "o", "\u001b[?2004h> "]
[821.717175, "o", "    pid_n = (pid % width) // gsize\r\n\u001b[?2004l\ra"]
[821.717212, "o", "\u001b[?2004h> "]
[821.717263, "o", "    return pid_m, pid_n\r\n\u001b[?2004l\r"]
[821.717295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rB\u001b[?2004h> "]
[821.717337, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[821.717362, "o", "\u001b[?2004h> "]
[821.717511, "o", "def gemmA(x1p, x2p, w1p, w2p, bp, op, M, N, K,\r\n\u001b[?2004l\r"]
[821.717541, "o", "\u001b[?2004h> "]
[821.717785, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[821.717823, "o", "\u001b[?2004h> "]
[821.717873, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r$"]
[821.717909, "o", "\u001b[?2004h> "]
[821.71803, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[821.718059, "o", "\u001b[?2004h> "]
[821.718187, "o", "    pid_m, pid_n = _sched(pid, grid_m, grid_n, BM, GROUP)\r\n\u001b[?2004l\r"]
[821.718223, "o", "\u001b[?2004h> "]
[821.718252, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n"]
[821.718283, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[821.718337, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[821.718368, "o", "\u001b[?2004h> "]
[821.718395, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[821.718421, "o", "\u001b[?2004h> "]
[821.718461, "o", "    x1p += rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[821.718496, "o", "\u001b[?2004h> "]
[821.718534, "o", "    x2p += rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[821.718565, "o", "\u001b[?2004h> "]
[821.718607, "o", "    w1p += rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[821.718642, "o", "\u001b[?2004h> "]
[821.718681, "o", "    w2p += rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[821.718715, "o", "\u001b[?2004h> "]
[821.718768, "o", "    a1 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[821.718802, "o", "\u001b[?2004h> "]
[821.718855, "o", "    a2 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[821.718886, "o", "\u001b[?2004h> "]
[821.718931, "o", "    a3 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[821.718967, "o", "\u001b[?2004h> "]
[821.719003, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[821.719039, "o", "\u001b[?2004h> "]
[821.719084, "o", "        va1 = tl.load(x1p); va2 = tl.load(x2p)\r\n\u001b[?2004l\r"]
[821.719121, "o", "\u001b[?2004h> "]
[821.719178, "o", "        vb1 = tl.load(w1p); vb2 = tl.load(w2p)\r\n\u001b[?2004l\r"]
[821.719214, "o", "\u001b[?2004h> "]
[821.719249, "o", "        a1 = tl.dot(va1, vb1, a1)\r\n\u001b[?2004l\r"]
[821.719285, "o", "\u001b[?2004h> "]
[821.719316, "o", "        a2 = tl.dot(va2, vb1, a2)\r\n\u001b[?2004l\r"]
[821.719354, "o", "\u001b[?2004h> "]
[821.719396, "o", "        a3 = tl.dot(va1, vb2, a3)\r\n\u001b[?2004l\r"]
[821.719428, "o", "\u001b[?2004h> "]
[821.719491, "o", "        x1p += BK; x2p += BK; w1p += BK * N; w2p += BK * N\r\n\u001b[?2004l\r"]
[821.719523, "o", "\u001b[?2004h> "]
[821.719557, "o", "    acc = a1 + a2 + a3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.7196, "o", "    bias = tl.load(bp + rn)\r\n\u001b[?2004l\r"]
[821.719631, "o", "\u001b[?2004h> "]
[821.719661, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[821.719697, "o", "\u001b[?2004h> "]
[821.719757, "o", "    tl.store(op + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[821.719795, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.719826, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.719863, "o", "> "]
[821.719904, "o", "def gemmB(x1p, x2p, w1p, w2p, bp, op, M, N, K,\r\n\u001b[?2004l\r"]
[821.719935, "o", "\u001b[?2004h> "]
[821.720033, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[821.720071, "o", "\u001b[?2004h> "]
[821.720106, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.720137, "o", "> "]
[821.720182, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[821.720218, "o", "\u001b[?2004h> "]
[821.720279, "o", "    pid_m, pid_n = _sched(pid, grid_m, grid_n, BM, GROUP)\r\n\u001b[?2004l\r"]
[821.72031, "o", "\u001b[?2004h> "]
[821.72035, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[821.72038, "o", "\u001b[?2004h> "]
[821.72042, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[821.720455, "o", "\u001b[?2004h> "]
[821.72049, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.720526, "o", "> "]
[821.720558, "o", "    a1b = x1p + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[821.720595, "o", "\u001b[?2004h> "]
[821.720638, "o", "    a2b = x2p + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[821.72067, "o", "\u001b[?2004h> "]
[821.720718, "o", "    b1b = w1p + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[821.72076, "o", "\u001b[?2004h> "]
[821.720805, "o", "    b2b = w2p + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[821.720839, "o", "\u001b[?2004h> "]
[821.720887, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[821.720917, "o", "\u001b[?2004h> "]
[821.720958, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[821.72099, "o", "\u001b[?2004h> "]
[821.721021, "o", "        va1 = tl.load(a1b)\r\n\u001b[?2004l\r"]
[821.721057, "o", "\u001b[?2004h> "]
[821.721088, "o", "        vb1 = tl.load(b1b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.721124, "o", "> "]
[821.721159, "o", "        acc = tl.dot(va1, vb1, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.721201, "o", "        va2 = tl.load(a2b)\r\n\u001b[?2004l\r"]
[821.721233, "o", "\u001b[?2004h> "]
[821.721269, "o", "        acc = tl.dot(va2, vb1, acc)\r\n\u001b[?2004l\r"]
[821.721299, "o", "\u001b[?2004h> "]
[821.72133, "o", "        vb2 = tl.load(b2b)\r\n\u001b[?2004l\r"]
[821.721362, "o", "\u001b[?2004h> "]
[821.721406, "o", "        acc = tl.dot(va1, vb2, acc)\r\n\u001b[?2004l\r"]
[821.721436, "o", "\u001b[?2004h> "]
[821.721508, "o", "        a1b += BK; a2b += BK; b1b += BK * N; b2b += BK * N\r\n\u001b[?2004l\r"]
[821.721541, "o", "\u001b[?2004h> "]
[821.72158, "o", "    bias = tl.load(bp + rn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.721611, "o", "> "]
[821.721641, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.721673, "o", "> "]
[821.721735, "o", "    tl.store(op + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[821.721766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.721805, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r"]
[821.721837, "o", "\u001b[?2004h> "]
[821.7219, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[821.721931, "o", "\u001b[?2004h> "]
[821.721968, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[821.722002, "o", "\u001b[?2004h> "]
[821.722033, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.72207, "o", ">     s.record()\r\n\u001b[?2004l\r"]
[821.722102, "o", "\u001b[?2004h> "]
[821.722135, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r"]
[821.722166, "o", "\u001b[?2004h> "]
[821.722208, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[821.722239, "o", "\u001b[?2004h> "]
[821.722277, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r"]
[821.722312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[821.722347, "o", "> "]
[821.722393, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[821.722425, "o", "\u001b[?2004h> "]
[821.722482, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[821.722517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.722559, "o", "print('--- variant A (3 acc) ---')\r\n\u001b[?2004l\r"]
[821.72259, "o", "\u001b[?2004h> "]
[821.722645, "o", "for (BM, BN, BK, warps, stages, grp) in [\r\n\u001b[?2004l\r"]
[821.722677, "o", "\u001b[?2004h> "]
[821.722753, "o", "    (128,128,32,8,5,8), (128,128,32,8,5,4), (128,128,32,8,5,16),\r\n\u001b[?2004l\r"]
[821.72279, "o", "\u001b[?2004h> "]
[821.722831, "o", "    (128,128,64,8,3,8), (128,128,32,8,6,8),\r\n\u001b[?2004l\r"]
[821.72287, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.722906, "o", "> "]
[821.722941, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[821.722978, "o", "\u001b[?2004h> "]
[821.723009, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.723157, "o", "        gemmA[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.723188, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.723224, "o", "> "]
[821.723256, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[821.723287, "o", "\u001b[?2004h> "]
[821.723351, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.723386, "o", "> "]
[821.72342, "o", "        t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.723458, "o", "        tf = 3*2*M*N*K/t/1e9\r\n\u001b[?2004l\r"]
[821.723494, "o", "\u001b[?2004h> "]
[821.723646, "o", "        print(f\"A BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.723683, "o", "> "]
[821.72372, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[821.723757, "o", "> "]
[821.723856, "o", "        print(f\"A BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:60]}\")\r\n\u001b[?2004l\r"]
[821.723885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[821.723922, "o", "\u001b[?2004h> "]
[821.723969, "o", "print('--- variant B (1 acc, 3 dots in loop) ---')\r\n\u001b[?2004l\r"]
[821.723999, "o", "\u001b[?2004h> "]
[821.724046, "o", "for (BM, BN, BK, warps, stages, grp) in [\r\n\u001b[?2004l\r"]
[821.724076, "o", "\u001b[?2004h> "]
[821.724149, "o", "    (128,128,64,8,3,8), (128,128,64,8,4,8), (128,128,64,8,2,8),\r\n\u001b[?2004l\r"]
[821.72418, "o", "\u001b[?2004h> "]
[821.724252, "o", "    (128,128,32,8,4,8), (128,128,32,8,6,8), (128,128,32,8,5,8),\r\n\u001b[?2004l\r"]
[821.724288, "o", "\u001b[?2004h> "]
[821.724354, "o", "    (256,128,64,8,3,8), (128,256,64,8,3,8), (128,256,64,8,2,8),\r\n\u001b[?2004l\r"]
[821.724385, "o", "\u001b[?2004h> "]
[821.724433, "o", "    (256,256,32,8,2,8), (128,128,128,8,2,8),\r\n\u001b[?2004l\r"]
[821.72447, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.724545, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[821.724576, "o", "\u001b[?2004h> "]
[821.724608, "o", "    def run():\r\n\u001b[?2004l\r"]
[821.724638, "o", "\u001b[?2004h> "]
[821.724761, "o", "        gemmB[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.724802, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.724862, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[821.724897, "o", "\u001b[?2004h> "]
[821.72494, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[821.724975, "o", "\u001b[?2004h> "]
[821.725006, "o", "        t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[821.725053, "o", "        tf = 3*2*M*N*K/t/1e9\r\n\u001b[?2004l\r"]
[821.72509, "o", "\u001b[?2004h> "]
[821.725218, "o", "        print(f\"B BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\r\n\u001b[?2004l\r"]
[821.725255, "o", "\u001b[?2004h> "]
[821.725291, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[821.725348, "o", "\u001b[?2004h> "]
[821.725421, "o", "        print(f\"B BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:60]}\")\r\n\u001b[?2004l\r"]
[821.725454, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[821.72736, "o", "\u001b[?2004hroot@modal:/# "]
[821.727606, "o", "B64=$(base64 -w0 /workspace/bench4.py); gpu exec sb-bjV8oAqlifn4KdhgfSZIhn -- bash -c \"echo $B64 | base64 -d > /tmp/bench4.py && python3 /tmp/bench4.py\" 2>&1 | tail -20\r\n\u001b[?2004l\r"]
[836.068056, "o", "request ID: b53c992062f945bda8163bea283ec867\r\ncommand: 505c8156726140bfb8c0385b956750e7\r\n--- variant A (3 acc) ---\r\nA BM=128 BN=128 BK=32 w=8 s=5 g=8: 2.509 ms (657 TF) err=2.10e-05\r\nA BM=128 BN=128 BK=32 w=8 s=5 g=4: 2.606 ms (633 TF) err=2.10e-05\r\nA BM=128 BN=128 BK=32 w=8 s=5 g=16: 2.504 ms (659 TF) err=2.10e-05\r\nA BM=128 BN=128 BK=64 w=8 s=3 g=8: 2.582 ms (639 TF) err=2.10e-05\r\nA BM=128 BN=128 BK=32 w=8 s=6 g=8: 2.602 ms (634 TF) err=2.10e-05\r\n--- variant B (1 acc, 3 dots in loop) ---\r\nB BM=128 BN=128 BK=64 w=8 s=3 g=8: 2.692 ms (613 TF) err=4.67e-05\r\nB BM=128 BN=128 BK=64 w=8 s=4 g=8: FAIL out of resource: shared memory, Required: 262144, Hardware l\r\nB BM=128 BN=128 BK=64 w=8 s=2 g=8: 3.820 ms (432 TF) err=4.67e-05\r\nB BM=128 BN=128 BK=32 w=8 s=4 g=8: 2.925 ms (564 TF) err=4.65e-05\r\nB BM=128 BN=128 BK=32 w=8 s=6 g=8: 2.829 ms (583 TF) err=4.65e-05\r\nB BM=128 BN=128 BK=32 w=8 s=5 g=8: 2.884 ms (572 TF) err=4.65e-05\r\nB BM=256 BN=128 BK=64 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 294912, Ha"]
[836.068229, "o", "rdware l\r\nB BM=128 BN=256 BK=64 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 294912, Hardware l\r\nB BM=128 BN=256 BK=64 w=8 s=2 g=8: 2.882 ms (572 TF) err=4.67e-05\r\nB BM=256 BN=256 BK=32 w=8 s=2 g=8: 28.354 ms (58 TF) err=4.65e-05\r\nB BM=128 BN=128 BK=128 w=8 s=2 g=8: FAIL out of resource: shared memory, Required: 262144, Hardware l\r\n\u001b[?2004hroot@modal:/# "]
[930.739061, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda', dtype=torch.float32)\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    w = (lin.weight * 1.5).contiguous()\n    b = (lin.bias * 1.5).contiguous()\nw1 = w.half(); w2 = (w - w1.float()).half()\nw1t = w1.t().contiguous(); w2t = w2.t().contiguous()\nx1 = x.half().contiguous(); x2 = (x - x1.float()).half().contiguous()\n\n@triton.jit\ndef _sched(pid, grid_m, grid_n, GROUP: tl.constexpr):\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    return pid_m, pid_n\n\n@triton.jit\ndef gemmC(xp, w1p, w2p, bp, op, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    pid_m, pid_n = _sched(pid, grid_m, grid_n, "]
[930.739117, "i", "GROUP)\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    xp += rm[:, None] * K + rk[None, :]\n    w1p += rk[:, None] * N + rn[None, :]\n    w2p += rk[:, None] * N + rn[None, :]\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        v = tl.load(xp)\n        va1 = v.to(tl.float16)\n        va2 = (v - va1.to(tl.float32)).to(tl.float16)\n        vb1 = tl.load(w1p); vb2 = tl.load(w2p)\n        a1 = tl.dot(va1, vb1, a1)\n        a2 = tl.dot(va2, vb1, a2)\n        a3 = tl.dot(va1, vb2, a3)\n        xp += BK; w1p += BK * N; w2p += BK * N\n    acc = a1 + a2 + a3\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\n@triton.jit\ndef gemmA(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n "]
[930.739128, "i", "   grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    pid_m, pid_n = _sched(pid, grid_m, grid_n, GROUP)\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    x1p += rm[:, None] * K + rk[None, :]\n    x2p += rm[:, None] * K + rk[None, :]\n    w1p += rk[:, None] * N + rn[None, :]\n    w2p += rk[:, None] * N + rn[None, :]\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        va1 = tl.load(x1p); va2 = tl.load(x2p)\n        vb1 = tl.load(w1p); vb2 = tl.load(w2p)\n        a1 = tl.dot(va1, vb1, a1)\n        a2 = tl.dot(va2, vb1, a2)\n        a3 = tl.dot(va1, vb2, a3)\n        x1p += BK; x2p += BK; w1p += BK * N; w2p += BK * N\n    acc = a1 + a2 + a3\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\n@triton.jit\ndef splitk(x_ptr, x1_ptr, x2_ptr, n, BLOCK: tl.constexpr):\n    pid = t"]
[930.73928, "i", "l.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < n\n    v = tl.load(x_ptr + offs, mask=mask, other=0.0)\n    v1 = v.to(tl.float16)\n    v2 = (v - v1.to(tl.float32)).to(tl.float16)\n    tl.store(x1_ptr + offs, v1, mask=mask)\n    tl.store(x2_ptr + offs, v2, mask=mask)\n\ndef timeit(fn, iters=30):\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nref = torch.nn.functional.linear(x, w, b)\n\nprint('--- variant C (fused split, 3 acc) ---')\nfor (BM, BN, BK, warps, stages, grp) in [\n    (128,128,32,8,5,16), (128,128,32,8,4,16), (128,128,32,8,5,8),\n    (128,128,64,8,3,8), (128,128,64,8,2,16), (64,128,32,8,5,16),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        gemmC[grid](x,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,"]
[930.739306, "i", "num_warps=warps,num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        t = timeit(run)\n        tf = 3*2*M*N*K/t/1e9\n        print(f\"C BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\n    except Exception as ex:\n        print(f\"C BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:60]}\")\n\nprint('--- variant A total (split + gemm) ---')\nn = x.numel()\nfor (BM, BN, BK, warps, stages, grp) in [(128,128,32,8,5,16), (128,128,32,8,5,8)]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        splitk[(triton.cdiv(n, 4096),)](x.reshape(-1), x1.reshape(-1), x2.reshape(-1), n, BLOCK=4096, num_warps=8)\n        gemmA[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\n    run(); torch.cuda.synchronize()\n    err = (out - ref).abs().max().item()\n    t = timeit(run)\n    print(f\"A total BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {"]
