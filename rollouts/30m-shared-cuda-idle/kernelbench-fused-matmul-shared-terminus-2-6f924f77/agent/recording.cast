[273.183097, "o", "request ID: c92da3624dc14e15b6c52978422c2fa1\r\ncommand: 68501dc93397425fbd934dd69cf4f737\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 3.03,\r\n  \"runtime_stats\": {\r\n    \"mean\": 3.03,\r\n    \"std\": 0.657,\r\n    \"min\": 2.8,\r\n    \"max\": 5.86,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0333,\r\n    \"min\": 11.4,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"d0e769a6b667bfbf8eb600a771689fe4570a842c5499a4bb87181a99a61497fa\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\""]
[273.18317, "o", ": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 3.7623762376237626\r\n}\r\n"]
[273.18331, "o", "\u001b[?2004hroot@modal:/# "]
[355.070229, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda', dtype=torch.float32)\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    w = (lin.weight * 1.5).contiguous()\n    b = (lin.bias * 1.5).contiguous()\nw1 = w.half(); w2 = (w - w1.float()).half()\nw1t = w1.t().contiguous(); w2t = w2.t().contiguous()\nx1 = x.half(); x2 = (x - x1.float()).half()\n\n@triton.jit\ndef gemm3_nn(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n             GROUP: tl.constexpr, NACC: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    x1p += rm[:,"]
[355.070282, "i", " None] * K + rk[None, :]\n    x2p += rm[:, None] * K + rk[None, :]\n    w1p += rk[:, None] * N + rn[None, :]\n    w2p += rk[:, None] * N + rn[None, :]\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        va1 = tl.load(x1p); va2 = tl.load(x2p)\n        vb1 = tl.load(w1p); vb2 = tl.load(w2p)\n        a1 = tl.dot(va1, vb1, a1)\n        if NACC == 3:\n            a2 = tl.dot(va2, vb1, a2)\n            a3 = tl.dot(va1, vb2, a3)\n        else:\n            a2 = tl.dot(va2, vb1, a2)\n            a2 = tl.dot(va1, vb2, a2)\n        x1p += BK; x2p += BK; w1p += BK * N; w2p += BK * N\n    if NACC == 3:\n        acc = a1 + a2 + a3\n    else:\n        acc = a1 + a2\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\ndef timeit(fn, iters=30):\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    for _ in range(5): fn()\n    torch.cuda.synchr"]
[355.070291, "i", "onize()\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nref = torch.nn.functional.linear(x, w, b)\n\nresults = []\nfor (BM, BN, BK, warps, stages, nacc) in [\n    (128,128,64,8,3,3), (128,128,64,8,3,2),\n    (128,256,64,8,3,3), (128,256,64,8,3,2),\n    (256,128,64,8,3,2),\n    (128,128,128,8,3,2),\n    (128,256,128,8,3,2),\n    (256,256,64,8,3,2),\n    (128,128,64,4,4,2),\n    (64,256,64,4,4,2),\n    (128,64,64,4,4,2),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        gemm3_nn[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=8,NACC=nacc,num_warps=warps,num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        t = timeit(run)\n        results.append((t, BM, BN, BK, warps, stages, nacc, err))\n        print(f\"BM={BM} BN={BN} BK={BK} w={warps} s={stages} nacc={nacc}: {t:.3f} ms  err={err:.2e}\")\n "]
[355.070311, "i", "   except Exception as ex:\n        print(f\"BM={BM} BN={BN} BK={BK} w={warps} s={stages} nacc={nacc}: FAIL {ex}\")\n\n# reference torch fp32 linear time\nt2 = timeit(lambda: torch.nn.functional.linear(x, w, b))\nprint(f\"torch fp32 linear: {t2:.3f} ms\")\n# split kernel timing\nsys_split = torch.empty_like(x, dtype=torch.float16)\nsys_split2 = torch.empty_like(x, dtype=torch.float16)\nimport solution as sol\nn_el = x.numel()\ndef splitrun():\n    sol._split_fp16_kernel[(triton.cdiv(n_el, 4096),)](x.reshape(-1), sys_split.reshape(-1), sys_split2.reshape(-1), n_el, BLOCK=4096, num_warps=8)\nprint(f\"split kernel: {timeit(splitrun):.3f} ms\")\nEOF\n"]
[355.070532, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.070608, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.07066, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.070698, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.070745, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[355.070781, "o", "\u001b[?2004h> "]
[355.07086, "o", "x = torch.rand(M, K, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.070902, "o", "> "]
[355.070942, "o", "lin = torch.nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.070982, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[355.071017, "o", "\u001b[?2004h> "]
[355.071059, "o", "    w = (lin.weight * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[355.071098, "o", "\u001b[?2004h> "]
[355.07115, "o", "    b = (lin.bias * 1.5).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.071187, "o", "> "]
[355.071221, "o", "w1 = w.half(); w2 = (w - w1.float()).half()\r\n\u001b[?2004l\r"]
[355.071256, "o", "\u001b[?2004h> "]
[355.071337, "o", "w1t = w1.t().contiguous(); w2t = w2.t().contiguous()\r\n\u001b[?2004l\r"]
[355.071489, "o", "\u001b[?2004h> x1 = x.half(); x2 = (x - x1.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.071515, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.071589, "o", "> "]
[355.07161, "o", "def gemm3_nn(x1p, x2p, w1p, w2p, bp, op, M, N, K,\r\n\u001b[?2004l\r"]
[355.071657, "o", "\u001b[?2004h> "]
[355.071723, "o", "             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[355.071774, "o", "\u001b[?2004h> "]
[355.071832, "o", "             GROUP: tl.constexpr, NACC: tl.constexpr):\r\n\u001b[?2004l\r"]
[355.071853, "o", "\u001b[?2004h> "]
[355.071919, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[355.071953, "o", "\u001b[?2004h> "]
[355.071999, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[355.072046, "o", "\u001b[?2004h> "]
[355.072078, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.072111, "o", "    gid = pid // width\r\n\u001b[?2004l\r"]
[355.072143, "o", "\u001b[?2004h> "]
[355.072226, "o", "    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[355.072263, "o", "\u001b[?2004h"]
[355.072296, "o", "> "]
[355.07233, "o", "    pid_m = gid * GROUP + (pid % gsize)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.072396, "o", "    pid_n = (pid % width) // gsize\r\n\u001b[?2004l\r"]
[355.07243, "o", "\u001b[?2004h> "]
[355.072476, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[355.072523, "o", "\u001b[?2004h> "]
[355.072565, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.072612, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[355.072649, "o", "\u001b[?2004h> "]
[355.072691, "o", "    x1p += rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[355.072725, "o", "\u001b[?2004h> "]
[355.072775, "o", "    x2p += rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[355.072812, "o", "\u001b[?2004h> "]
[355.072847, "o", "    w1p += rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[355.072879, "o", "\u001b[?2004h> "]
[355.072932, "o", "    w2p += rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[355.072966, "o", "\u001b[?2004h> "]
[355.073016, "o", "    a1 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[355.073049, "o", "\u001b[?2004h> "]
[355.073101, "o", "    a2 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[355.073136, "o", "\u001b[?2004h> "]
[355.073297, "o", "    a3 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.073321, "o", "> "]
[355.07337, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[355.073405, "o", "\u001b[?2004h> "]
[355.073455, "o", "        va1 = tl.load(x1p); va2 = tl.load(x2p)\r\n\u001b[?2004l\r"]
[355.073488, "o", "\u001b[?2004h> "]
[355.073539, "o", "        vb1 = tl.load(w1p); vb2 = tl.load(w2p)\r\n\u001b[?2004l\r"]
[355.073572, "o", "\u001b[?2004h> "]
[355.073608, "o", "        a1 = tl.dot(va1, vb1, a1)\r\n\u001b[?2004l\r"]
[355.073638, "o", "\u001b[?2004h> "]
[355.073671, "o", "        if NACC == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.073736, "o", "            a2 = tl.dot(va2, vb1, a2)\r\n\u001b[?2004l\r"]
[355.073771, "o", "\u001b[?2004h> "]
[355.073804, "o", "            a3 = tl.dot(va1, vb2, a3)\r\n\u001b[?2004l\r"]
[355.073838, "o", "\u001b[?2004h> "]
[355.07387, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.073919, "o", "            a2 = tl.dot(va2, vb1, a2)\r\n\u001b[?2004l\r"]
[355.073954, "o", "\u001b[?2004h> "]
[355.073987, "o", "            a2 = tl.dot(va1, vb2, a2)\r\n\u001b[?2004l\r"]
[355.07402, "o", "\u001b[?2004h> "]
[355.074089, "o", "        x1p += BK; x2p += BK; w1p += BK * N; w2p += BK * N\r\n\u001b[?2004l\r"]
[355.074124, "o", "\u001b[?2004h> "]
[355.074158, "o", "    if NACC == 3:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.07419, "o", "        acc = a1 + a2 + a3\r\n\u001b[?2004l\r"]
[355.074266, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.074347, "o", "        acc = a1 + a2\r\n\u001b[?2004l\r\u001b[?2004h>     bias = tl.load(bp + rn)\r\n\u001b[?2004l\r"]
[355.074399, "o", "\u001b[?2004h> "]
[355.074449, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.074497, "o", "    tl.store(op + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[355.074546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[355.074593, "o", "\u001b[?2004h> "]
[355.074641, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.074706, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[355.074755, "o", "\u001b[?2004h>     for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[355.074803, "o", "\u001b[?2004h> "]
[355.074849, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.074895, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.074944, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.074991, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[355.075038, "o", "\u001b[?2004h> "]
[355.075085, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[355.075135, "o", "\u001b[?2004h> "]
[355.075183, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[355.075232, "o", "\u001b[?2004h> "]
[355.075279, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.075339, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> results = []\r\n\u001b[?2004l\r"]
[355.075392, "o", "\u001b[?2004h> "]
[355.075448, "o", "for (BM, BN, BK, warps, stages, nacc) in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.075514, "o", "    (128,128,64,8,3,3), (128,128,64,8,3,2),\r\n\u001b[?2004l\r"]
[355.075562, "o", "\u001b[?2004h> "]
[355.075613, "o", "    (128,256,64,8,3,3), (128,256,64,8,3,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.07566, "o", "    (256,128,64,8,3,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.075708, "o", "    (128,128,128,8,3,2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.075756, "o", ">     (128,256,128,8,3,2),\r\n\u001b[?2004l\r"]
[355.075802, "o", "\u001b[?2004h> "]
[355.07585, "o", "    (256,256,64,8,3,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.075898, "o", "    (128,128,64,4,4,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.075945, "o", "    (64,256,64,4,4,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.075993, "o", "    (128,64,64,4,4,2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.076038, "o", "> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.076107, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[355.076154, "o", "\u001b[?2004h>     def run():\r\n\u001b[?2004l\r"]
[355.076202, "o", "\u001b[?2004h> "]
[355.076349, "o", "        gemm3_nn[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=8,NACC=nacc,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.0764, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.076458, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[355.076505, "o", "\u001b[?2004h> "]
[355.076554, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.0766, "o", ">         t = timeit(run)\r\n\u001b[?2004l\r"]
[355.076645, "o", "\u001b[?2004h> "]
[355.076714, "o", "        results.append((t, BM, BN, BK, warps, stages, nacc, err))\r\n\u001b[?2004l\r"]
[355.076762, "o", "\u001b[?2004h> "]
[355.076878, "o", "        print(f\"BM={BM} BN={BN} BK={BK} w={warps} s={stages} nacc={nacc}: {t:.3f} ms  err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.076929, "o", ">     except Exception as ex:\r\n\u001b[?2004l\r"]
[355.076975, "o", "\u001b[?2004h> "]
[355.077069, "o", "        print(f\"BM={BM} BN={BN} BK={BK} w={warps} s={stages} nacc={nacc}: FAIL {ex}\")\r\n\u001b[?2004l\r"]
[355.077135, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.07719, "o", "# reference torch fp32 linear time\r\n\u001b[?2004l\r"]
[355.077237, "o", "\u001b[?2004h> "]
[355.077286, "o", "t2 = timeit(lambda: torch.nn.functional.linear(x, w, b))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.077334, "o", "print(f\"torch fp32 linear: {t2:.3f} ms\")\r\n\u001b[?2004l\r"]
[355.077389, "o", "\u001b[?2004h> # split kernel timing\r\n\u001b[?2004l\r"]
[355.077437, "o", "\u001b[?2004h> "]
[355.077485, "o", "sys_split = torch.empty_like(x, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[355.077542, "o", "\u001b[?2004h> "]
[355.07759, "o", "sys_split2 = torch.empty_like(x, dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.077637, "o", "> import solution as sol\r\n\u001b[?2004l\r"]
[355.077682, "o", "\u001b[?2004h> n_el = x.numel()\r\n\u001b[?2004l\r"]
[355.077729, "o", "\u001b[?2004h> def splitrun():\r\n\u001b[?2004l\r"]
[355.077777, "o", "\u001b[?2004h> "]
[355.07796, "o", "    sol._split_fp16_kernel[(triton.cdiv(n_el, 4096),)](x.reshape(-1), sys_split.reshape(-1), sys_split2.reshape(-1), n_el, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[355.078007, "o", "> "]
[355.078073, "o", "print(f\"split kernel: {timeit(splitrun):.3f} ms\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[355.078122, "o", "EOF\r\n\u001b[?2004l\r"]
[355.080018, "o", "\u001b[?2004hroot@modal:/# "]
