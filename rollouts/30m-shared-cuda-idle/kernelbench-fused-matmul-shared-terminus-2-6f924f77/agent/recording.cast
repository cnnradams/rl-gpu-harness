[930.74812, "o", "    tl.store(x2_ptr + offs, v2, mask=mask)\r\n\u001b[?2004l\r"]
[930.748166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.748211, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.748304, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[930.748359, "o", "\u001b[?2004h>     for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[930.748404, "o", "\u001b[?2004h> "]
[930.74845, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.748495, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.748544, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.748616, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[930.748662, "o", "\u001b[?2004h> "]
[930.748708, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[930.748752, "o", "\u001b[?2004h> "]
[930.748813, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[930.748863, "o", "\u001b[?2004h> "]
[930.748909, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[930.748954, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[930.749008, "o", "print('--- variant C (fused split, 3 acc) ---')\r\n\u001b[?2004l\r"]
[930.749053, "o", "\u001b[?2004h> "]
[930.749099, "o", "for (BM, BN, BK, warps, stages, grp) in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.749189, "o", "    (128,128,32,8,5,16), (128,128,32,8,4,16), (128,128,32,8,5,8),\r\n\u001b[?2004l\r"]
[930.749235, "o", "\u001b[?2004h> "]
[930.749294, "o", "    (128,128,64,8,3,8), (128,128,64,8,2,16), (64,128,32,8,5,16),\r\n\u001b[?2004l\r"]
[930.749341, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.74942, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[930.749465, "o", "\u001b[?2004h>     def run():\r\n\u001b[?2004l\r"]
[930.74951, "o", "\u001b[?2004h> "]
[930.749634, "o", "        gemmC[grid](x,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r"]
[930.749686, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.749754, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.749799, "o", "> "]
[930.749851, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.749897, "o", ">         t = timeit(run)\r\n\u001b[?2004l\r"]
[930.749943, "o", "\u001b[?2004h> "]
[930.749988, "o", "        tf = 3*2*M*N*K/t/1e9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.750144, "o", "        print(f\"C BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.750199, "o", ">     except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.750244, "o", "> "]
[930.750335, "o", "        print(f\"C BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:60]}\")\r\n\u001b[?2004l\r"]
[930.750382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.750456, "o", "print('--- variant A total (split + gemm) ---')\r\n\u001b[?2004l\r"]
[930.750506, "o", "\u001b[?2004h> n = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.75063, "o", "for (BM, BN, BK, warps, stages, grp) in [(128,128,32,8,5,16), (128,128,32,8,5,8)]:\r\n\u001b[?2004l\r"]
[930.750676, "o", "\u001b[?2004h> "]
[930.750722, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.750772, "o", ">     def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.750948, "o", "        splitk[(triton.cdiv(n, 4096),)](x.reshape(-1), x1.reshape(-1), x2.reshape(-1), n, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.750994, "o", "> "]
[930.751112, "o", "        gemmA[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r"]
[930.751162, "o", "\u001b[?2004h> "]
[930.751208, "o", "    run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.751254, "o", "    err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[930.751299, "o", "\u001b[?2004h>     t = timeit(run)\r\n\u001b[?2004l\r"]
[930.751355, "o", "\u001b[?2004h> "]
[930.751464, "o", "    print(f\"A total BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms err={err:.2e}\")\r\n\u001b[?2004l\r"]
[930.751519, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[930.753461, "o", "\u001b[?2004hroot@modal:/# "]
[930.753602, "o", "B64=$(base64 -w0 /workspace/bench5.py); gpu exec sb-bjV8oAqlifn4KdhgfSZIhn -- bash -c \"echo $B64 | base64 -d > /tmp/bench5.py && python3 /tmp/bench5.py\" 2>&1 | tail -12\r\n\u001b[?2004l\r"]
[940.513517, "o", "request ID: 7c735e84839a445c8dc383ebe26bc7ff\r\ncommand: 75f29937543847ff8d374037850912e3\r\n--- variant C (fused split, 3 acc) ---\r\nC BM=128 BN=128 BK=32 w=8 s=5 g=16: 2.644 ms (624 TF) err=2.10e-05\r\nC BM=128 BN=128 BK=32 w=8 s=4 g=16: 2.915 ms (566 TF) err=2.10e-05\r\nC BM=128 BN=128 BK=32 w=8 s=5 g=8: 2.781 ms (593 TF) err=2.10e-05\r\nC BM=128 BN=128 BK=64 w=8 s=3 g=8: 3.563 ms (463 TF) err=2.10e-05\r\nC BM=128 BN=128 BK=64 w=8 s=2 g=16: 4.441 ms (371 TF) err=2.10e-05\r\nC BM=64 BN=128 BK=32 w=8 s=5 g=16: 3.743 ms (441 TF) err=3.01e+00\r\n--- variant A total (split + gemm) ---\r\nA total BM=128 BN=128 BK=32 w=8 s=5 g=16: 2.593 ms err=2.10e-05\r\nA total BM=128 BN=128 BK=32 w=8 s=5 g=8: 2.657 ms err=2.10e-05\r\n"]
[940.513725, "o", "\u001b[?2004hroot@modal:/# "]
[1004.769976, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _split_fp16_kernel(x_ptr, x1_ptr, x2_ptr, n_elements, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < n_elements\n    v = tl.load(x_ptr + offs, mask=mask, other=0.0)\n    v1 = v.to(tl.float16)\n    v2 = (v - v1.to(tl.float32)).to(tl.float16)\n    tl.store(x1_ptr + offs, v1, mask=mask)\n    tl.store(x2_ptr + offs, v2, mask=mask)\n\n\n@triton.jit\ndef _split_gemm_kernel(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n                       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                       GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn"]
[1004.770029, "i", " = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    m_mask = rm < M\n    n_mask = rn < N\n    x1p += rm[:, None] * K + rk[None, :]\n    x2p += rm[:, None] * K + rk[None, :]\n    w1p += rk[:, None] * N + rn[None, :]\n    w2p += rk[:, None] * N + rn[None, :]\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        k_mask = rk[None, :] < K - k * BK\n        va1 = tl.load(x1p, mask=m_mask[:, None] & k_mask, other=0.0)\n        va2 = tl.load(x2p, mask=m_mask[:, None] & k_mask, other=0.0)\n        vb1 = tl.load(w1p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\n        vb2 = tl.load(w2p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\n        a1 = tl.dot(va1, vb1, a1)\n        a2 = tl.dot(va2, vb1, a2)\n        a3 = tl.dot(va1, vb2, a3)\n        x1p += BK\n        x2p += BK\n        w1p += BK * N\n        w2p += BK * "]
[1004.770045, "i", "N\n    acc = a1 + a2 + a3\n    bias = tl.load(bp + rn, mask=n_mask, other=0.0)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc, mask=m_mask[:, None] & n_mask[None, :])\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._prepared = False\n\n    def _prepare(self):\n        with torch.no_grad():\n            s = 1.0 + float(self.scaling_factor)\n            w = (self.matmul.weight.detach().float() * s).contiguous()\n            b = (self.matmul.bias.detach().float() * s).contiguous()\n            w1 = w.half()\n            w2 = (w - w1.float()).half()\n            # store transposed: (K, N) layout for the GEMM kernel\n            self._w1t = w1.t().contiguous()\n            self._w2t = w2.t().contiguous()\n            self._bias = b\n        self._prepared = True\n\n    def forward(self, x):\n  "]
[1004.770071, "i", "      if x.device.type != \"cuda\":\n            y = self.matmul(x)\n            return y * self.scaling_factor + y\n        if not self._prepared:\n            self._prepare()\n        x = x.contiguous()\n        M, K = x.shape\n        N = self._w1t.shape[1]\n        n_el = x.numel()\n        x1 = torch.empty_like(x, dtype=torch.float16)\n        x2 = torch.empty_like(x, dtype=torch.float16)\n        _split_fp16_kernel[(triton.cdiv(n_el, 4096),)](\n            x.reshape(-1), x1.reshape(-1), x2.reshape(-1), n_el,\n            BLOCK=4096, num_warps=8\n        )\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        BM, BN, BK, GROUP = 128, 128, 32, 16\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        _split_gemm_kernel[grid](\n            x1, x2, self._w1t, self._w2t, self._bias, out,\n            M, N, K,\n            BM=BM, BN=BN, BK=BK, GROUP=GROUP,\n            num_warps=8, num_stages=5,\n        )\n        return out\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/solution.py')."]
[1004.77008, "i", "read()); print('ok')\"\n"]
[1004.770303, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r"]
