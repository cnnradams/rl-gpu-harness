[779.24129, "o", "request ID: 0b879fa8a454466dbf81c71921cccf09\r\ncommand: 0f4c828df1454133badc472b1236dc61\r\nBM=128 BN=128 BK=64 w=8 s=3: 2.509 ms (657 TF) err=2.10e-05\r\nBM=128 BN=128 BK=64 w=8 s=2: 3.524 ms (468 TF) err=2.10e-05\r\nBM=128 BN=128 BK=64 w=4 s=3: 21.156 ms (78 TF) err=2.10e-05\r\nBM=128 BN=128 BK=32 w=8 s=4: 2.570 ms (642 TF) err=2.10e-05\r\nBM=128 BN=128 BK=32 w=4 s=4: 25.416 ms (65 TF) err=2.10e-05\r\nBM=128 BN=128 BK=32 w=8 s=5: 2.433 ms (678 TF) err=2.10e-05\r\nBM=64 BN=128 BK=64 w=4 s=4: 3.117 ms (529 TF) err=2.10e-05\r\nBM=64 BN=128 BK=32 w=4 s=5: 2.637 ms (625 TF) err=2.10e-05\r\nBM=128 BN=256 BK=32 w=8 s=3: 71.880 ms (23 TF) err=2.10e-05\r\nBM=128 BN=256 BK=32 w=8 s=2: 71.631 ms (23 TF) err=2.10e-05\r\nBM=256 BN=128 BK=32 w=8 s=3: 63.184 ms (26 TF) err=2.10e-05\r\nBM=64 BN=256 BK=64 w=8 s=2: 4.080 ms (404 TF) err=2.10e-05\r\nBM=64 BN=256 BK=32 w=8 s=3: 2.579 ms (639 TF) err=2.10e-05\r\nBM=64 BN=256 BK=32 w=4 s=3: 40.243 ms (41 TF) err=2.10e-05\r\nBM=64 BN=64 BK=64 w=4 s=4: 3.583 ms (460 TF) err=2.10e-05\r\nBM=256 BN=64 BK=32 w=4 s=4:"]
[779.241379, "o", " 37.067 ms (44 TF) err=2.10e-05\r\nsplit BLOCK=2048: 0.182 ms\r\nsplit BLOCK=4096: 0.183 ms\r\nsplit BLOCK=8192: 0.183 ms\r\n\u001b[?2004hroot@modal:/# "]
[821.714262, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda', dtype=torch.float32)\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    w = (lin.weight * 1.5).contiguous()\n    b = (lin.bias * 1.5).contiguous()\nw1 = w.half(); w2 = (w - w1.float()).half()\nw1t = w1.t().contiguous(); w2t = w2.t().contiguous()\nx1 = x.half().contiguous(); x2 = (x - x1.float()).half().contiguous()\n\n@triton.jit\ndef _sched(pid, grid_m, grid_n, BM: tl.constexpr, GROUP: tl.constexpr):\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    return pid_m, pid_n\n\n@triton.jit\ndef gemmA(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    pid_m, pid_n = _sch"]
[821.714334, "i", "ed(pid, grid_m, grid_n, BM, GROUP)\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    x1p += rm[:, None] * K + rk[None, :]\n    x2p += rm[:, None] * K + rk[None, :]\n    w1p += rk[:, None] * N + rn[None, :]\n    w2p += rk[:, None] * N + rn[None, :]\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        va1 = tl.load(x1p); va2 = tl.load(x2p)\n        vb1 = tl.load(w1p); vb2 = tl.load(w2p)\n        a1 = tl.dot(va1, vb1, a1)\n        a2 = tl.dot(va2, vb1, a2)\n        a3 = tl.dot(va1, vb2, a3)\n        x1p += BK; x2p += BK; w1p += BK * N; w2p += BK * N\n    acc = a1 + a2 + a3\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\n@triton.jit\ndef gemmB(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid "]
[821.714345, "i", "= tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    pid_m, pid_n = _sched(pid, grid_m, grid_n, BM, GROUP)\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a1b = x1p + rm[:, None] * K + rk[None, :]\n    a2b = x2p + rm[:, None] * K + rk[None, :]\n    b1b = w1p + rk[:, None] * N + rn[None, :]\n    b2b = w2p + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        va1 = tl.load(a1b)\n        vb1 = tl.load(b1b)\n        acc = tl.dot(va1, vb1, acc)\n        va2 = tl.load(a2b)\n        acc = tl.dot(va2, vb1, acc)\n        vb2 = tl.load(b2b)\n        acc = tl.dot(va1, vb2, acc)\n        a1b += BK; a2b += BK; b1b += BK * N; b2b += BK * N\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\ndef timeit(fn, iters=30):\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    for _ in range(5): fn()\n    torch.cuda.sync"]
[821.714464, "i", "hronize()\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nref = torch.nn.functional.linear(x, w, b)\n\nprint('--- variant A (3 acc) ---')\nfor (BM, BN, BK, warps, stages, grp) in [\n    (128,128,32,8,5,8), (128,128,32,8,5,4), (128,128,32,8,5,16),\n    (128,128,64,8,3,8), (128,128,32,8,6,8),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        gemmA[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        t = timeit(run)\n        tf = 3*2*M*N*K/t/1e9\n        print(f\"A BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\n    except Exception as ex:\n        print(f\"A BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:60]}\")\n\nprint('--- variant B (1 acc, 3 dots in"]
[821.714539, "i", " loop) ---')\nfor (BM, BN, BK, warps, stages, grp) in [\n    (128,128,64,8,3,8), (128,128,64,8,4,8), (128,128,64,8,2,8),\n    (128,128,32,8,4,8), (128,128,32,8,6,8), (128,128,32,8,5,8),\n    (256,128,64,8,3,8), (128,256,64,8,3,8), (128,256,64,8,2,8),\n    (256,256,32,8,2,8), (128,128,128,8,2,8),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        gemmB[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        t = timeit(run)\n        tf = 3*2*M*N*K/t/1e9\n        print(f\"B BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\n    except Exception as ex:\n        print(f\"B BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:60]}\")\nEOF\nB64=$(base64 -w0 /workspace/bench4.py); gpu exec sb-bjV8oAqlifn4KdhgfSZIhn -- bash -c \"echo $B64 | base64 -d > /tmp/bench4.py && python3 /tmp/bench4.py\" 2>&1 | tail -20\n"]
[821.714581, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r"]
[821.714617, "o", "\u001b[?2004h> "]
[821.714738, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[821.714768, "o", "\u001b[?2004h"]
[821.714799, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
