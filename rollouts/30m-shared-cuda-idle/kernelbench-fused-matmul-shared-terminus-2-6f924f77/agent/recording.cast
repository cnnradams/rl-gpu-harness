[1448.50401, "o", "def timeit_cold(fn, iters=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1448.504047, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1448.504085, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
