[1448.504378, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h>         dummy.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1448.504455, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1448.504508, "o", "        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[1448.504558, "o", "\u001b[?2004h> "]
[1448.504608, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1448.504658, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1448.504706, "o", "> "]
[1448.504756, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h>     ts.sort()\r\n\u001b[?2004l\r"]
[1448.504805, "o", "\u001b[?2004h> "]
[1448.504856, "o", "    return sum(ts)/len(ts), ts[0], ts[-1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1448.504906, "o", "\u001b[?2004l\r\u001b[?2004h> n = x.numel()\r\n\u001b[?2004l\r"]
