[180.49535, "o", "{\r\n  \"trial\": \"a8102332b5e84aaa82855b967f2e8715\",\r\n  \"limits\": {\r\n    \"gpu\": \"H100!\",\r\n    \"gpus_per_box\": 1,\r\n    \"max_boxes\": 1,\r\n    \"box_seconds\": 1800,\r\n    \"gpu_seconds\": null,\r\n    \"cpu\": 4.0,\r\n    \"memory\": 16384,\r\n    \"image_id\": \"im-zZcxEsichdX7AeUSTbxEuy\",\r\n    \"shared_workspace\": true,\r\n    \"block_network\": false,\r\n    \"idle_seconds\": 300,\r\n    \"idle_probe\": \"cuda\"\r\n  },\r\n  \"boxes\": [],\r\n  \"gpu_seconds_used\": 0,\r\n  \"gpu_time_accounting_complete\": true\r\n}\r\n"]
