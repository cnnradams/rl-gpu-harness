[1274.488298, "o", "\u001b[?2004h> "]
[1274.488348, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1274.488396, "o", "\u001b[?2004h> "]
[1274.488447, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1274.488496, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1274.488546, "o", "for (BM, BN, BK, warps, stages, grp) in [\r\n\u001b[?2004l\r\u001b[?2004h"]
[1274.488595, "o", "> "]
[1274.488654, "o", "    (128,128,64,8,4,8), (128,128,64,8,3,8), (128,128,64,8,4,16),\r\n\u001b[?2004l\r"]
[1274.488703, "o", "\u001b[?2004h> "]
[1274.488752, "o", "    (128,128,128,8,3,8), (128,128,128,8,2,8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1274.488851, "o", "    (128,256,64,8,3,8), (256,128,64,8,3,8), (128,256,64,8,2,8),\r\n\u001b[?2004l\r"]
[1274.488881, "o", "\u001b[?2004h> "]
[1274.48893, "o", "    (256,256,64,8,2,8), (128,128,256,8,2,8),\r\n\u001b[?2004l\r"]
[1274.488979, "o", "\u001b[?2004h> "]
[1274.489029, "o", "    (64,128,128,8,3,8), (128,64,128,8,3,8),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1274.489079, "o", "> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1274.489146, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1274.489197, "o", "\u001b[?2004h>     def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1274.489244, "o", "> "]
[1274.489365, "o", "        gemm_tma[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=grp,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r"]
[1274.489418, "o", "\u001b[?2004h> "]
[1274.489474, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h>         run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1274.489522, "o", "\u001b[?2004h> "]
[1274.489573, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1274.48962, "o", "        t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1274.489684, "o", ">         tf = 3*2*M*N*K/t/1e9\r\n\u001b[?2004l\r\u001b[?2004h"]
[1274.489731, "o", "> "]
[1274.48986, "o", "        print(f\"TMA BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\r\n\u001b[?2004l\r"]
[1274.489911, "o", "\u001b[?2004h>     except Exception as ex:\r\n\u001b[?2004l\r"]
[1274.489963, "o", "\u001b[?2004h> "]
[1274.490076, "o", "        print(f\"TMA BM={BM} BN={BN} BK={BK} w={warps} s={stages} g={grp}: FAIL {str(ex)[:70]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1274.490141, "o", "> EOF\r\n\u001b[?2004l\r"]
[1274.491864, "o", "\u001b[?2004hroot@modal:/# "]
[1274.492101, "o", "B64=$(base64 -w0 /workspace/bench6.py); gpu exec sb-bjV8oAqlifn4KdhgfSZIhn -- bash -c \"echo $B64 | base64 -d > /tmp/bench6.py && python3 /tmp/bench6.py\" 2>&1 | tail -14\r\n\u001b[?2004l\r"]
[1292.233115, "o", "request ID: fde95a6a5af54c30821f15d93496fb10\r\ncommand: ab57757f819d45099f2418af76102823\r\nTMA BM=128 BN=128 BK=64 w=8 s=4 g=8: FAIL out of resource: shared memory, Required: 262176, Hardware limit: 2324\r\nTMA BM=128 BN=128 BK=64 w=8 s=3 g=8: 2.463 ms (670 TF) err=2.10e-05\r\nTMA BM=128 BN=128 BK=64 w=8 s=4 g=16: FAIL out of resource: shared memory, Required: 262176, Hardware limit: 2324\r\nTMA BM=128 BN=128 BK=128 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 393240, Hardware limit: 2324\r\nTMA BM=128 BN=128 BK=128 w=8 s=2 g=8: FAIL out of resource: shared memory, Required: 262160, Hardware limit: 2324\r\nTMA BM=128 BN=256 BK=64 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 294936, Hardware limit: 2324\r\nTMA BM=256 BN=128 BK=64 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 294936, Hardware limit: 2324\r\nTMA BM=128 BN=256 BK=64 w=8 s=2 g=8: 35.718 ms (46 TF) err=2.10e-05\r\nTMA BM=256 BN=256 BK=64 w=8 s=2 g=8: FAIL out of resource: shared memory, Required: 262160, Hardware limit: 23"]
[1292.2333, "o", "24\r\nTMA BM=128 BN=128 BK=256 w=8 s=2 g=8: FAIL out of resource: shared memory, Required: 524304, Hardware limit: 2324\r\nTMA BM=64 BN=128 BK=128 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 294936, Hardware limit: 2324\r\nTMA BM=128 BN=64 BK=128 w=8 s=3 g=8: FAIL out of resource: shared memory, Required: 294936, Hardware limit: 2324\r\n"]
[1292.233345, "o", "\u001b[?2004hroot@modal:/# "]
[1373.169509, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _split_fp16_kernel(x_ptr, x1_ptr, x2_ptr, n_elements, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < n_elements\n    v = tl.load(x_ptr + offs, mask=mask, other=0.0)\n    v1 = v.to(tl.float16)\n    v2 = (v - v1.to(tl.float32)).to(tl.float16)\n    tl.store(x1_ptr + offs, v1, mask=mask)\n    tl.store(x2_ptr + offs, v2, mask=mask)\n\n\n@triton.jit\ndef _split_gemm_kernel(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n                       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                       GROUP: tl.constexpr, EVEN: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    rm = pid_m * BM + tl."]
[1373.169569, "i", "arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    x1p += rm[:, None] * K + rk[None, :]\n    x2p += rm[:, None] * K + rk[None, :]\n    w1p += rk[:, None] * N + rn[None, :]\n    w2p += rk[:, None] * N + rn[None, :]\n    a1 = tl.zeros((BM, BN), dtype=tl.float32)\n    a2 = tl.zeros((BM, BN), dtype=tl.float32)\n    a3 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        if EVEN:\n            va1 = tl.load(x1p)\n            va2 = tl.load(x2p)\n            vb1 = tl.load(w1p)\n            vb2 = tl.load(w2p)\n        else:\n            k_mask = rk[None, :] < K - k * BK\n            kb_mask = (rk[:, None] < K - k * BK) & (rn[None, :] < N)\n            va1 = tl.load(x1p, mask=(rm[:, None] < M) & k_mask, other=0.0)\n            va2 = tl.load(x2p, mask=(rm[:, None] < M) & k_mask, other=0.0)\n            vb1 = tl.load(w1p, mask=kb_mask, other=0.0)\n            vb2 = tl.load(w2p, mask=kb_mask, other=0.0)\n        a1 = tl.dot(va1, vb1, a1)\n        a2 = tl.dot(va2, vb1, a2)\n    "]
[1373.169587, "i", "    a3 = tl.dot(va1, vb2, a3)\n        x1p += BK\n        x2p += BK\n        w1p += BK * N\n        w2p += BK * N\n    acc = a1 + a2 + a3\n    if EVEN:\n        bias = tl.load(bp + rn)\n        acc = acc + bias[None, :]\n        tl.store(op + rm[:, None] * N + rn[None, :], acc)\n    else:\n        n_mask = rn < N\n        bias = tl.load(bp + rn, mask=n_mask, other=0.0)\n        acc = acc + bias[None, :]\n        tl.store(op + rm[:, None] * N + rn[None, :], acc,\n                 mask=(rm[:, None] < M) & n_mask[None, :])\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._prepared = False\n\n    def _prepare(self):\n        with torch.no_grad():\n            s = 1.0 + float(self.scaling_factor)\n            w = (self.matmul.weight.detach().float() * s).contiguous()\n            b = (self.matmul.bias.detach().float() * s).contiguous"]
[1373.169598, "i", "()\n            w1 = w.half()\n            w2 = (w - w1.float()).half()\n            self._w1t = w1.t().contiguous()\n            self._w2t = w2.t().contiguous()\n            self._bias = b\n        self._prepared = True\n\n    def forward(self, x):\n        if not x.is_cuda:\n            y = self.matmul(x)\n            return y * self.scaling_factor + y\n        if not self._prepared:\n            self._prepare()\n        M, K = x.shape\n        N = self._w1t.shape[1]\n        n_el = M * K\n        x1 = torch.empty((M, K), device=x.device, dtype=torch.float16)\n        x2 = torch.empty((M, K), device=x.device, dtype=torch.float16)\n        _split_fp16_kernel[(triton.cdiv(n_el, 4096),)](\n            x, x1, x2, n_el, BLOCK=4096, num_warps=8\n        )\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        even = (M % 128 == 0) and (N % 128 == 0) and (K % 32 == 0)\n        grid = (triton.cdiv(M, 128) * triton.cdiv(N, 128),)\n        _split_gemm_kernel[grid](\n            x1, x2, self._w1t, self._w2t, self._bi"]
[1373.169607, "i", "as, out,\n            M, N, K,\n            BM=128, BN=128, BK=32, GROUP=16, EVEN=even,\n            num_warps=8, num_stages=5,\n        )\n        return out\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\n"]
