[1004.772928, "o", "\u001b[?2004h> "]
[1004.772973, "o", "    a3 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.773017, "o", "> "]
[1004.773061, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.773105, "o", "        k_mask = rk[None, :] < K - k * BK\r\n\u001b[?2004l\r"]
[1004.773156, "o", "\u001b[?2004h> "]
[1004.773222, "o", "        va1 = tl.load(x1p, mask=m_mask[:, None] & k_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1004.773267, "o", "\u001b[?2004h> "]
[1004.77333, "o", "        va2 = tl.load(x2p, mask=m_mask[:, None] & k_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1004.773375, "o", "\u001b[?2004h> "]
[1004.773527, "o", "        vb1 = tl.load(w1p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.773676, "o", "        vb2 = tl.load(w2p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\r\n\u001b[?2004l\r"]
[1004.773722, "o", "\u001b[?2004h> "]
[1004.773774, "o", "        a1 = tl.dot(va1, vb1, a1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.773817, "o", "        a2 = tl.dot(va2, vb1, a2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.77387, "o", "        a3 = tl.dot(va1, vb2, a3)\r\n\u001b[?2004l\r"]
[1004.773957, "o", "\u001b[?2004h>         x1p += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774002, "o", "        x2p += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774046, "o", "        w1p += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774091, "o", "        w2p += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774139, "o", "    acc = a1 + a2 + a3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774197, "o", "    bias = tl.load(bp + rn, mask=n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1004.774241, "o", "\u001b[?2004h> "]
[1004.774286, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774399, "o", "    tl.store(op + rm[:, None] * N + rn[None, :], acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r"]
[1004.774453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.774496, "o", "> class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1004.774547, "o", "\u001b[?2004h> "]
[1004.774615, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1004.774664, "o", "\u001b[?2004h> "]
[1004.774708, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774789, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1004.774835, "o", "\u001b[?2004h> "]
[1004.77488, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.774938, "o", "        self._prepared = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.774983, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.775028, "o", "    def _prepare(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.775079, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.775144, "o", "            s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[1004.775192, "o", "\u001b[?2004h> "]
[1004.775256, "o", "            w = (self.matmul.weight.detach().float() * s).contiguous()\r\n\u001b[?2004l\r"]
[1004.775301, "o", "\u001b[?2004h> "]
[1004.775375, "o", "            b = (self.matmul.bias.detach().float() * s).contiguous()\r\n\u001b[?2004l\r"]
[1004.77542, "o", "\u001b[?2004h>             w1 = w.half()\r\n\u001b[?2004l\r"]
[1004.775463, "o", "\u001b[?2004h> "]
[1004.775507, "o", "            w2 = (w - w1.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.775557, "o", "> "]
[1004.775601, "o", "            # store transposed: (K, N) layout for the GEMM kernel\r\n\u001b[?2004l\r"]
[1004.775646, "o", "\u001b[?2004h> "]
[1004.775697, "o", "            self._w1t = w1.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.775742, "o", "> "]
[1004.775786, "o", "            self._w2t = w2.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.775841, "o", "            self._bias = b\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.775899, "o", ">         self._prepared = True\r\n\u001b[?2004l\r"]
[1004.775942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.775987, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.776037, "o", "> "]
[1004.776082, "o", "        if x.device.type != \"cuda\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.776125, "o", "            y = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.776192, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[1004.776237, "o", "\u001b[?2004h> "]
[1004.77628, "o", "        if not self._prepared:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.776325, "o", "            self._prepare()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.77637, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.776413, "o", ">         M, K = x.shape\r\n\u001b[?2004l\r"]
[1004.776457, "o", "\u001b[?2004h> "]
[1004.776501, "o", "        N = self._w1t.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.776546, "o", "        n_el = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.776617, "o", "        x1 = torch.empty_like(x, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1004.776668, "o", "\u001b[?2004h> "]
[1004.776714, "o", "        x2 = torch.empty_like(x, dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.776758, "o", "> "]
[1004.776809, "o", "        _split_fp16_kernel[(triton.cdiv(n_el, 4096),)](\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.776853, "o", "> "]
[1004.776913, "o", "            x.reshape(-1), x1.reshape(-1), x2.reshape(-1), n_el,\r\n\u001b[?2004l\r"]
[1004.776958, "o", "\u001b[?2004h> "]
[1004.777001, "o", "            BLOCK=4096, num_warps=8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.777046, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.777128, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1004.777173, "o", "\u001b[?2004h> "]
[1004.777216, "o", "        BM, BN, BK, GROUP = 128, 128, 32, 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.777261, "o", "> "]
[1004.777319, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1004.777364, "o", "\u001b[?2004h> "]
[1004.777408, "o", "        _split_gemm_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.777478, "o", "            x1, x2, self._w1t, self._w2t, self._bias, out,\r\n\u001b[?2004l\r"]
[1004.777521, "o", "\u001b[?2004h>             M, N, K,\r\n\u001b[?2004l\r"]
[1004.777573, "o", "\u001b[?2004h> "]
[1004.777617, "o", "            BM=BM, BN=BN, BK=BK, GROUP=GROUP,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.777662, "o", "> "]
[1004.777706, "o", "            num_warps=8, num_stages=5,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[1004.777752, "o", "\u001b[?2004h>         return out\r\n\u001b[?2004l\r"]
[1004.777805, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1004.779847, "o", "\u001b[?2004hroot@modal:/# "]
[1004.779966, "o", "python3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[1004.799043, "o", "ok\r\n"]
[1004.802517, "o", "\u001b[?2004hroot@modal:/# "]
[1013.853497, "i", "python3 - << 'EOF'\nsrc = open('/workspace/solution.py').read()\nold = \"        vb1 = tl.load(w1p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\\n        vb2 = tl.load(w2p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\\n\"\nnew = \"        kb_mask = (rk[:, None] < K - k * BK) & n_mask[None, :]\\n        vb1 = tl.load(w1p, mask=kb_mask, other=0.0)\\n        vb2 = tl.load(w2p, mask=kb_mask, other=0.0)\\n\"\nassert old in src\nsrc = src.replace(old, new)\nopen('/workspace/solution.py','w').write(src)\nimport ast; ast.parse(src); print('patched ok')\nEOF\n"]
[1013.853778, "o", "python3 - << 'EOF'\r\n"]
[1013.853835, "o", "\u001b[?2004l\r"]
[1013.85387, "o", "\u001b[?2004h> "]
[1013.853954, "o", "src = open('/workspace/solution.py').read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1013.854278, "o", "old = \"        vb1 = tl.load(w1p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\\n        vb2 = tl.load(w2p, mask=n_mask[None, :] & k_mask.T if False else k_mask & (rk[:, None] < K), other=0.0)\\n\"\r\n\u001b[?2004l\r"]
[1013.854308, "o", "\u001b[?2004h> "]
[1013.854535, "o", "new = \"        kb_mask = (rk[:, None] < K - k * BK) & n_mask[None, :]\\n        vb1 = tl.load(w1p, mask=kb_mask, other=0.0)\\n        vb2 = tl.load(w2p, mask=kb_mask, other=0.0)\\n\"\r\n\u001b[?2004l\r"]
[1013.854566, "o", "\u001b[?2004h> "]
[1013.854594, "o", "assert old in src\r\n\u001b[?2004l\r"]
[1013.854625, "o", "\u001b[?2004h> "]
[1013.854659, "o", "src = src.replace(old, new)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1013.854692, "o", "> "]
[1013.854731, "o", "open('/workspace/solution.py','w').write(src)\r\n\u001b[?2004l\r"]
[1013.854759, "o", "\u001b[?2004h> "]
[1013.854818, "o", "import ast; ast.parse(src); print('patched ok')\r\n\u001b[?2004l\r"]
[1013.854847, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1013.874512, "o", "patched ok\r\n"]
