[518.979527, "o", "request ID: bb3686cca7aa4dd59f7e2e6baf9dd4da\r\ncommand: 51a89bc96ac444dca778a827881a6e2e\r\nBM=128 BN=128 BK=64 w=8 s=3 nacc=3: 2.379 ms  err=2.10e-05\r\nBM=128 BN=128 BK=64 w=8 s=3 nacc=2: 2.445 ms  err=2.10e-05\r\nBM=128 BN=256 BK=64 w=8 s=3 nacc=3: FAIL out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=128 BN=256 BK=64 w=8 s=3 nacc=2: FAIL out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=256 BN=128 BK=64 w=8 s=3 nacc=2: FAIL out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=128 BN=128 BK=128 w=8 s=3 nacc=2: FAIL out of resource: shared memory, Required: 393216, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=128 BN=256 BK=128 w=8 s=3 nacc=2: FAIL out of resource: shared memory, Required: 589824, Hardware limit: 232448. Reducing block sizes or `num_stages` may help."]
[518.979602, "o", "\r\nBM=256 BN=256 BK=64 w=8 s=3 nacc=2: FAIL out of resource: shared memory, Required: 393216, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=128 BN=128 BK=64 w=4 s=4 nacc=2: FAIL out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=64 BN=256 BK=64 w=4 s=4 nacc=2: FAIL out of resource: shared memory, Required: 327680, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nBM=128 BN=64 BK=64 w=4 s=4 nacc=2: 3.178 ms  err=2.10e-05\r\ntorch fp32 linear: 10.884 ms\r\nTraceback (most recent call last):\r\n  File \"/tmp/bench.py\", line 96, in <module>\r\n    import solution as sol\r\nModuleNotFoundError: No module named 'solution'\r\n"]
[518.979749, "o", "\u001b[?2004hroot@modal:/# "]
[608.05252, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda', dtype=torch.float32)\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    w = (lin.weight * 1.5).contiguous()\n    b = (lin.bias * 1.5).contiguous()\nw1 = w.half(); w2 = (w - w1.float()).half()\nw1t = w1.t().contiguous(); w2t = w2.t().contiguous()\nx1 = x.half().contiguous(); x2 = (x - x1.float()).half().contiguous()\n\n@triton.jit\ndef gemm_seg(x1p, x2p, w1p, w2p, bp, op, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n             GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a1b ="]
[608.05258, "i", " x1p + rm[:, None] * K + rk[None, :]\n    a2b = x2p + rm[:, None] * K + rk[None, :]\n    b1b = w1p + rk[:, None] * N + rn[None, :]\n    b2b = w2p + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for seg in tl.static_range(3):\n        for k in range(0, tl.cdiv(K, BK)):\n            if seg == 1:\n                va = tl.load(a2b)\n            else:\n                va = tl.load(a1b)\n            if seg == 2:\n                vb = tl.load(b2b)\n            else:\n                vb = tl.load(b1b)\n            acc = tl.dot(va, vb, acc)\n            a1b += BK; a2b += BK; b1b += BK * N; b2b += BK * N\n        a1b -= K; a2b -= K\n    bias = tl.load(bp + rn)\n    acc = acc + bias[None, :]\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\n@triton.jit\ndef gemm_plain(ap, bp, op, M, N, K3,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n               GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n"]
[608.052598, "i", "\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\n    pid_m = gid * GROUP + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    aptr = ap + rm[:, None] * K3 + rk[None, :]\n    bptr = bp + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K3, BK)):\n        va = tl.load(aptr); vb = tl.load(bptr)\n        acc = tl.dot(va, vb, acc)\n        aptr += BK; bptr += BK * N\n    tl.store(op + rm[:, None] * N + rn[None, :], acc)\n\ndef timeit(fn, iters=30):\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\nouth = torch.empty(M, N, device='cuda', dtype=torch.float16)\nref = torch.nn.functional.lin"]
[608.052619, "i", "ear(x, w, b)\n\nfor (BM, BN, BK, warps, stages) in [\n    (128,128,64,8,3), (128,128,64,8,4),\n    (128,256,64,8,3), (256,128,64,8,3),\n    (128,256,64,8,2), (128,128,128,8,2),\n    (128,256,128,8,2), (256,256,64,8,2),\n    (64,256,64,4,4), (128,64,64,4,4),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        gemm_seg[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=8,num_warps=warps,num_stages=stages)\n    try:\n        run(); torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        t = timeit(run)\n        tf = 3*2*M*N*K/t/1e9\n        print(f\"seg BM={BM} BN={BN} BK={BK} w={warps} s={stages}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\n    except Exception as ex:\n        print(f\"seg BM={BM} BN={BN} BK={BK} w={warps} s={stages}: FAIL {str(ex)[:80]}\")\n\n# packed plain gemm upper bound (fp16 out)\nAp = torch.cat([x1, x2, x1], dim=1).contiguous()\nBp = torch.cat([w1t, w1t, w2t], dim=0).contiguous()\nfor (BM, BN, BK, warps, stages) in [(128,128,64,8,3),(128,256,64,8,3),(128,128,6"]
[608.052627, "i", "4,8,4)]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def runp():\n        gemm_plain[grid](Ap,Bp,outh,M,N,3*K,BM=BM,BN=BN,BK=BK,GROUP=8,num_warps=warps,num_stages=stages)\n    try:\n        runp(); torch.cuda.synchronize()\n        t = timeit(runp)\n        tf = 2*M*N*3*K/t/1e9\n        print(f\"plain BM={BM} BN={BN} BK={BK} w={warps} s={stages}: {t:.3f} ms ({tf:.0f} TF)\")\n    except Exception as ex:\n        print(f\"plain BM={BM} BN={BN} BK={BK} w={warps} s={stages}: FAIL {str(ex)[:80]}\")\nEOF\n"]
[608.053042, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.053106, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[608.053159, "o", "\u001b[?2004h> "]
[608.053203, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r(A\u001b[?2004h"]
[608.053243, "o", "> "]
[608.053307, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[608.05334, "o", "\u001b[?2004h> "]
[608.053513, "o", "x = torch.rand(M, K, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[608.053542, "o", "\u001b[?2004h> "]
[608.053657, "o", "lin = torch.nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.053733, "o", "with torch.no_grad():\r\n"]
[608.053785, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[608.05388, "o", "    w = (lin.weight * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[608.053931, "o", "\u001b[?2004h> "]
[608.054016, "o", "    b = (lin.bias * 1.5).contiguous()\r\n"]
[608.054064, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[608.054176, "o", "w1 = w.half(); w2 = (w - w1.float()).half()\r\n\u001b[?2004l\r"]
[608.054227, "o", "\u001b[?2004h> "]
[608.054348, "o", "w1t = w1.t().contiguous(); w2t = w2.t().contiguous()\r\n\u001b[?2004l\r"]
[608.054399, "o", "\u001b[?2004h> "]
[608.05461, "o", "x1 = x.half().contiguous(); x2 = (x - x1.float()).half().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.054666, "o", "> \r\n\u001b[?2004l\r[\u001b[?2004h> @triton.jit"]
[608.054715, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.054774, "o", "def gemm_seg(x1p, x2p, w1p, w2p, bp, op, M, N, K,\r\n\u001b[?2004l\r"]
[608.054822, "o", "\u001b[?2004h> "]
[608.054897, "o", "             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.054945, "o", "> "]
[608.05499, "o", "             GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.055041, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.055123, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[608.055171, "o", "\u001b[?2004h> "]
[608.05522, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.055268, "o", "    gid = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.05536, "o", "    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.055431, "o", "    pid_m = gid * GROUP + (pid % gsize)\r\n\u001b[?2004l\r"]
[608.055481, "o", "\u001b[?2004h> "]
[608.05553, "o", "    pid_n = (pid % width) // gsize"]
[608.055589, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.055631, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[608.055672, "o", "\u001b[?2004h> "]
[608.055712, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[608.055753, "o", "\u001b[?2004h> "]
[608.055801, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.055857, "o", "    a1b = x1p + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[608.055905, "o", "\u001b[?2004h> "]
[608.055956, "o", "    a2b = x2p + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056031, "o", "    b1b = w1p + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[608.056078, "o", "\u001b[?2004h> "]
[608.056128, "o", "    b2b = w2p + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.056176, "o", "> "]
[608.056224, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056272, "o", "    for seg in tl.static_range(3):\r\n\u001b[?2004l\r"]
[608.05632, "o", "\u001b[?2004h> "]
[608.056365, "o", "        for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056415, "o", "            if seg == 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.056464, "o", "> "]
[608.05651, "o", "                va = tl.load(a2b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056565, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056614, "o", "                va = tl.load(a1b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056663, "o", "            if seg == 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.056711, "o", "> "]
[608.056762, "o", "                vb = tl.load(b2b)\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r"]
[608.056812, "o", "\u001b[?2004h> "]
[608.056862, "o", "                vb = tl.load(b1b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.056911, "o", "            acc = tl.dot(va, vb, acc)\r\n\u001b[?2004l\r"]
[608.05696, "o", "\u001b[?2004h> "]
[608.057019, "o", "            a1b += BK; a2b += BK; b1b += BK * N; b2b += BK * N\r\n\u001b[?2004l\r"]
[608.057071, "o", "\u001b[?2004h>         a1b -= K; a2b -= K\r\n\u001b[?2004l\r"]
[608.057118, "o", "\u001b[?2004h> "]
[608.057167, "o", "    bias = tl.load(bp + rn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057216, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057294, "o", "    tl.store(op + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[608.057344, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057393, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057441, "o", "def gemm_plain(ap, bp, op, M, N, K3,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057542, "o", "               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[608.057598, "o", "\u001b[?2004h> "]
[608.057648, "o", "               GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057697, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057778, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[608.057825, "o", "\u001b[?2004h> "]
[608.057871, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057919, "o", "    gid = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.057993, "o", "    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.058043, "o", "> "]
[608.058087, "o", "    pid_m = gid * GROUP + (pid % gsize)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.058149, "o", "    pid_n = (pid % width) // gsize\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.058198, "o", "> "]
[608.058249, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.058298, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.058349, "o", ">     rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[608.058399, "o", "\u001b[?2004h> "]
[608.058449, "o", "    aptr = ap + rm[:, None] * K3 + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.058472, "o", "> "]
[608.058531, "o", "    bptr = bp + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.058591, "o", "> "]
[608.05864, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.058701, "o", "    for k in range(0, tl.cdiv(K3, BK)):\r\n\u001b[?2004l\r"]
[608.058754, "o", "\u001b[?2004h> "]
[608.058806, "o", "        va = tl.load(aptr); vb = tl.load(bptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.058856, "o", "        acc = tl.dot(va, vb, acc)\r\n\u001b[?2004l\r"]
[608.058906, "o", "\u001b[?2004h> "]
[608.058957, "o", "        aptr += BK; bptr += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.059028, "o", "    tl.store(op + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[608.059077, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.059128, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.059209, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[608.059259, "o", "\u001b[?2004h>     for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[608.059308, "o", "\u001b[?2004h> "]
[608.059367, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.059417, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.059467, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.059517, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[608.059576, "o", "\u001b[?2004h> "]
[608.059627, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[608.059677, "o", "\u001b[?2004h> "]
[608.059724, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[608.059775, "o", "\u001b[?2004h> "]
[608.059832, "o", "outh = torch.empty(M, N, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[608.059881, "o", "\u001b[?2004h> "]
[608.05993, "o", "ref = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[608.059979, "o", "\u001b[?2004h> "]
[608.060028, "o", "for (BM, BN, BK, warps, stages) in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.060092, "o", "    (128,128,64,8,3), (128,128,64,8,4),\r\n\u001b[?2004l\r"]
[608.060142, "o", "\u001b[?2004h> "]
[608.060193, "o", "    (128,256,64,8,3), (256,128,64,8,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.060243, "o", "    (128,256,64,8,2), (128,128,128,8,2),\r\n\u001b[?2004l\r"]
[608.060292, "o", "\u001b[?2004h> "]
[608.06034, "o", "    (128,256,128,8,2), (256,256,64,8,2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.060404, "o", "    (64,256,64,4,4), (128,64,64,4,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.060453, "o", "> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.060517, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[608.060587, "o", "\u001b[?2004h>     def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.060736, "o", "        gemm_seg[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=8,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r"]
[608.060788, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.060848, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[608.060899, "o", "\u001b[?2004h> "]
[608.060951, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.061002, "o", "        t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.061054, "o", "        tf = 3*2*M*N*K/t/1e9\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.061104, "o", "> "]
[608.061216, "o", "        print(f\"seg BM={BM} BN={BN} BK={BK} w={warps} s={stages}: {t:.3f} ms ({tf:.0f} TF) err={err:.2e}\")\r\n\u001b[?2004l\r"]
[608.061268, "o", "\u001b[?2004h>     except Exception as ex:\r\n\u001b[?2004l\r"]
[608.061319, "o", "\u001b[?2004h> "]
[608.061417, "o", "        print(f\"seg BM={BM} BN={BN} BK={BK} w={warps} s={stages}: FAIL {str(ex)[:80]}\")\r\n\u001b[?2004l\r"]
[608.061469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.061527, "o", "# packed plain gemm upper bound (fp16 out)\r\n\u001b[?2004l\r"]
[608.061583, "o", "\u001b[?2004h> "]
[608.061634, "o", "Ap = torch.cat([x1, x2, x1], dim=1).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.061714, "o", "Bp = torch.cat([w1t, w1t, w2t], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[608.061767, "o", "\u001b[?2004h> "]
[608.061857, "o", "for (BM, BN, BK, warps, stages) in [(128,128,64,8,3),(128,256,64,8,3),(128,128,64,8,4)]:\r\n\u001b[?2004l\r"]
[608.061907, "o", "\u001b[?2004h> "]
[608.061957, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.06201, "o", "    def runp():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.062152, "o", "        gemm_plain[grid](Ap,Bp,outh,M,N,3*K,BM=BM,BN=BN,BK=BK,GROUP=8,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r"]
[608.062205, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.062269, "o", "        runp(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[608.06232, "o", "\u001b[?2004h>         t = timeit(runp)\r\n\u001b[?2004l\r"]
[608.062369, "o", "\u001b[?2004h> "]
[608.062417, "o", "        tf = 2*M*N*3*K/t/1e9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.062546, "o", "        print(f\"plain BM={BM} BN={BN} BK={BK} w={warps} s={stages}: {t:.3f} ms ({tf:.0f} TF)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.062604, "o", ">     except Exception as ex:\r\n\u001b[?2004l\r"]
[608.062654, "o", "\u001b[?2004h> "]
