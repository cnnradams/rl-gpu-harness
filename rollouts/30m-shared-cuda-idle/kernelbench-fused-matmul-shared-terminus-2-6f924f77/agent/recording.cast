[1004.771187, "o", "    tl.store(x2_ptr + offs, v2, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.771241, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1004.771286, "o", "\u001b[?2004h> "]
[1004.771372, "o", "def _split_gemm_kernel(x1p, x2p, w1p, w2p, bp, op, M, N, K,\r\n\u001b[?2004l\r"]
[1004.771429, "o", "\u001b[?2004h> "]
[1004.771499, "o", "                       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[1004.771531, "o", "\u001b[?2004h> "]
[1004.771574, "o", "                       GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1004.771626, "o", "\u001b[?2004h> "]
[1004.771671, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.771726, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1004.771772, "o", "\u001b[?2004h>     grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.771819, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.771872, "o", ">     gid = pid // width\r\n\u001b[?2004l\r\u001b[?2004h"]
[1004.771926, "o", "> "]
[1004.771971, "o", "    gsize = tl.minimum(grid_m - gid * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[1004.772021, "o", "\u001b[?2004h> "]
[1004.772074, "o", "    pid_m = gid * GROUP + (pid % gsize)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.77212, "o", "    pid_n = (pid % width) // gsize\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.772177, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1004.772223, "o", "\u001b[?2004h> "]
[1004.772268, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.77232, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.772365, "o", "    m_mask = rm < M\r\n\u001b[?2004l\r\u001b[?2004h> "]
