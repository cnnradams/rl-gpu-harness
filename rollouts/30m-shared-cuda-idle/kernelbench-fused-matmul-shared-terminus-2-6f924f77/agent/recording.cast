[1156.443313, "o", "\u001b[?2004h> "]
[1156.443472, "o", "        x1p += BK\r\n\u001b[?2004l\r\u001b[?2004h>         x2p += BK\r\n\u001b[?2004l\r\u001b[?2004h>         w1p += BK * N\r\n\u001b[?2004l\r\u001b[?2004h"]
