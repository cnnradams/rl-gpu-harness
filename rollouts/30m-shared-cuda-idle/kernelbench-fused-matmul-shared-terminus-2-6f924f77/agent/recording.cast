[930.739897, "i", "t:.3f} ms err={err:.2e}\")\nEOF\nB64=$(base64 -w0 /workspace/bench5.py); gpu exec sb-bjV8oAqlifn4KdhgfSZIhn -- bash -c \"echo $B64 | base64 -d > /tmp/bench5.py && python3 /tmp/bench5.py\" 2>&1 | tail -12\n"]
