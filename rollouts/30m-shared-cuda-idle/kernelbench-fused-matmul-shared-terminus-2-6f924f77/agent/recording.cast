[1373.174694, "o", "> "]
[1373.174741, "o", "        tl.store(op + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r"]
[1373.174787, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
