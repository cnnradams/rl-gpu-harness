[1373.17497, "o", "\u001b[?2004h> "]
[1373.175017, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.175099, "o", "        tl.store(op + rm[:, None] * N + rn[None, :], acc,\r\n\u001b[?2004l\r"]
[1373.175143, "o", "\u001b[?2004h> "]
[1373.175225, "o", "                 mask=(rm[:, None] < M) & n_mask[None, :])\r\n\u001b[?2004l\r"]
[1373.17527, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1373.175316, "o", "\u001b[?2004h> "]
[1373.17537, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1373.175417, "o", "> "]
[1373.175483, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1373.175529, "o", "\u001b[?2004h> "]
[1373.175578, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.175665, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1373.175722, "o", "\u001b[?2004h> "]
[1373.175769, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.175816, "o", "        self._prepared = False\r\n\u001b[?2004l\r"]
[1373.175863, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.175909, "o", "    def _prepare(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.175956, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[1373.176004, "o", "\u001b[?2004h> "]
[1373.176055, "o", "            s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.176159, "o", "            w = (self.matmul.weight.detach().float() * s).contiguous()\r\n\u001b[?2004l\r"]
[1373.17622, "o", "\u001b[?2004h> "]
[1373.176279, "o", "            b = (self.matmul.bias.detach().float() * s).contiguous()\r\n\u001b[?2004l\r"]
[1373.176323, "o", "\u001b[?2004h> "]
[1373.17637, "o", "            w1 = w.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.176417, "o", "            w2 = (w - w1.float()).half()\r\n\u001b[?2004l\r"]
[1373.176463, "o", "\u001b[?2004h> "]
[1373.176519, "o", "            self._w1t = w1.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1373.176567, "o", "> "]
[1373.176618, "o", "            self._w2t = w2.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.176664, "o", "            self._bias = b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.176709, "o", "        self._prepared = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1373.176754, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1373.1768, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.176848, "o", "        if not x.is_cuda:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1373.176894, "o", "> "]
[1373.176939, "o", "            y = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.176986, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[1373.177033, "o", "\u001b[?2004h> "]
[1373.177074, "o", "        if not self._prepared:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.177122, "o", "            self._prepare()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1373.177169, "o", ">         M, K = x.shape\r\n\u001b[?2004l\r"]
[1373.177222, "o", "\u001b[?2004h> "]
[1373.177269, "o", "        N = self._w1t.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.177316, "o", "        n_el = M * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.177423, "o", "        x1 = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1373.177469, "o", "\u001b[?2004h> "]
[1373.177546, "o", "        x2 = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1373.177593, "o", "\u001b[?2004h> "]
[1373.177641, "o", "        _split_fp16_kernel[(triton.cdiv(n_el, 4096),)](\r\n\u001b[?2004l\r"]
[1373.177685, "o", "\u001b[?2004h> "]
[1373.17773, "o", "            x, x1, x2, n_el, BLOCK=4096, num_warps=8\r\n\u001b[?2004l\r"]
[1373.177777, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[1373.177824, "o", "\u001b[?2004h> "]
[1373.17789, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1373.177938, "o", "\u001b[?2004h> "]
[1373.178007, "o", "        even = (M % 128 == 0) and (N % 128 == 0) and (K % 32 == 0)\r\n\u001b[?2004l\r"]
[1373.178054, "o", "\u001b[?2004h> "]
[1373.178107, "o", "        grid = (triton.cdiv(M, 128) * triton.cdiv(N, 128),)\r\n\u001b[?2004l\r"]
[1373.178152, "o", "\u001b[?2004h> "]
[1373.1782, "o", "        _split_gemm_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.17828, "o", "            x1, x2, self._w1t, self._w2t, self._bias, out,\r\n\u001b[?2004l\r"]
[1373.178324, "o", "\u001b[?2004h> "]
[1373.178371, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.178446, "o", "            BM=128, BN=128, BK=32, GROUP=16, EVEN=even,\r\n\u001b[?2004l\r"]
[1373.178493, "o", "\u001b[?2004h> "]
[1373.17854, "o", "            num_warps=8, num_stages=5,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1373.178608, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n\u001b[?2004l\r"]
[1373.178654, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1373.180451, "o", "\u001b[?2004hroot@modal:/# "]
