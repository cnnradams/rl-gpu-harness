[748.878548, "o", "> "]
[748.878663, "o", "        gemm3[grid](x1,x2,w1t,w2t,b,out,M,N,K,BM=BM,BN=BN,BK=BK,GROUP=8,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[748.87872, "o", "> "]
