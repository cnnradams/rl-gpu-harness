[211.505824, "o", "\u001b[?2004h> "]
[211.505861, "o", "        w2_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[211.505899, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[211.505934, "o", "    acc = acc1 + acc2 + acc3\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.505971, "o", "> "]
[211.506017, "o", "    bias = tl.load(bias_ptr + rn, mask=n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[211.506054, "o", "\u001b[?2004h> "]
[211.506089, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[211.506119, "o", "\u001b[?2004h> "]
[211.506174, "o", "    out_ptrs = out_ptr + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[211.506209, "o", "\u001b[?2004h> "]
[211.506299, "o", "    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r"]
[211.506342, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[211.506378, "o", "\u001b[?2004h> "]
[211.506416, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.506506, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[211.506541, "o", "\u001b[?2004h> "]
[211.506582, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[211.506618, "o", "\u001b[?2004h> "]
[211.506683, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[211.506714, "o", "\u001b[?2004h> "]
[211.50677, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.506804, "o", "> "]
[211.506839, "o", "        self._prepared = False\r\n\u001b[?2004l\r"]
[211.506876, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.506912, "o", "    def _prepare(self):\r\n\u001b[?2004l\r"]
[211.506948, "o", "\u001b[?2004h> "]
[211.50698, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.507015, "o", "> "]
[211.507059, "o", "            s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[211.507094, "o", "\u001b[?2004h> "]
[211.507176, "o", "            w = (self.matmul.weight.detach().float() * s).contiguous()\r\n\u001b[?2004l\r"]
[211.507206, "o", "\u001b[?2004h> "]
[211.507298, "o", "            b = (self.matmul.bias.detach().float() * s).contiguous()\r\n\u001b[?2004l\r"]
[211.507338, "o", "\u001b[?2004h> "]
[211.507374, "o", "            w1 = w.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.50741, "o", "> "]
[211.507447, "o", "            w2 = (w - w1.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.507488, "o", "> "]
[211.507524, "o", "            self._w1 = w1.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.50756, "o", "> "]
[211.507595, "o", "            self._w2 = w2.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.50763, "o", "> "]
[211.507666, "o", "            self._bias = b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.507702, "o", "        self._prepared = True\r\n\u001b[?2004l\r"]
[211.507737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[211.507774, "o", "> "]
[211.507809, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.507845, "o", "        if x.device.type != \"cuda\":\r\n\u001b[?2004l\r"]
[211.507881, "o", "\u001b[?2004h> "]
[211.507916, "o", "            y = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.507949, "o", "> "]
[211.507992, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[211.508027, "o", "\u001b[?2004h> "]
[211.508062, "o", "        if not self._prepared:\r\n\u001b[?2004l\r"]
[211.508098, "o", "\u001b[?2004h> "]
[211.508135, "o", "            self._prepare()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.508172, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[211.508204, "o", "\u001b[?2004h> "]
[211.508245, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.508292, "o", "        N = self._w1.shape[0]\r\n\u001b[?2004l\r"]
[211.508329, "o", "\u001b[?2004h> "]
[211.508365, "o", "        xf = x.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.508403, "o", "> "]
[211.508439, "o", "        n_el = xf.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.508497, "o", "        x1 = torch.empty_like(x, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[211.508533, "o", "\u001b[?2004h> "]
[211.508595, "o", "        x2 = torch.empty_like(x, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[211.508637, "o", "\u001b[?2004h> "]
[211.508673, "o", "        BLOCK = 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.508739, "o", "        _split_fp16_kernel[(triton.cdiv(n_el, BLOCK),)](\r\n\u001b[?2004l\r"]
[211.508776, "o", "\u001b[?2004h> "]
[211.508867, "o", "            xf, x1.reshape(-1), x2.reshape(-1), n_el, BLOCK=BLOCK, num_warps=8\r\n\u001b[?2004l\r"]
[211.508904, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[211.50894, "o", "\u001b[?2004h> "]
[211.50902, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[211.509057, "o", "\u001b[?2004h> "]
[211.509089, "o", "        BM, BN, BK = 128, 128, 64\r\n\u001b[?2004l\r"]
[211.509116, "o", "\u001b[?2004h> "]
[211.509192, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.509325, "o", ">         _split_gemm_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.509366, "o", "            x1, x2, self._w1, self._w2, self._bias, out,\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.5094, "o", "> "]
[211.509429, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[211.509506, "o", "            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8,\r\n\u001b[?2004l\r"]
[211.509543, "o", "\u001b[?2004h> "]
[211.509584, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[211.50962, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[211.509657, "o", "\u001b[?2004h> "]
[211.509694, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
