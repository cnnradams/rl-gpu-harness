[1004.772622, "o", "    w1p += rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1004.772666, "o", "\u001b[?2004h> "]
[1004.77271, "o", "    w2p += rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1004.772781, "o", "    a1 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
