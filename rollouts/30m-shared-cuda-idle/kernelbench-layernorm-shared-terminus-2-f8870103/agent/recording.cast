[687.43433, "i", "d_time(e))\n    return sum(ts)/len(ts), min(ts)\n\nprint('max_grid(1024):', ext.max_grid(1024), 'max_grid(512):', ext.max_grid(512), 'max_grid(256):', ext.max_grid(256))\nfor S, thr in [(8,1024),(16,512),(16,1024),(4,1024),(8,512),(32,512),(32,256),(64,256)]:\n    if 16*S > ext.max_grid(thr):\n        print(f'S={S} thr={thr}: grid too big ({16*S} > {ext.max_grid(thr)})')\n        continue\n    try:\n        y = ext.ln_forward(x, w, b, 1e-5, S, thr)\n        torch.cuda.synchronize()\n        err = (y-ref).abs().max().item()\n        mean, mn = time_fn(lambda: ext.ln_forward(x, w, b, 1e-5, S, thr))\n        print(f'S={S} thr={thr}: {mean:.4f}/{mn:.4f} err={err:.2e}')\n    except Exception as ex:\n        print(f'S={S} thr={thr}: fail {str(ex)[:100]}')\nEOF\n"]
