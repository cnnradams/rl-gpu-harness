[521.464888, "o", "def time_fn(fn, trials=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.464943, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[521.464985, "o", "\u001b[?2004h>     ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.465024, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r"]
[521.465064, "o", "\u001b[?2004h> "]
[521.465098, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.465201, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[521.465242, "o", "\u001b[?2004h> "]
[521.465328, "o", "        clear_l2(); s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[521.465376, "o", "\u001b[?2004h> "]
[521.465416, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.465456, "o", "    return sum(ts)/len(ts), min(ts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[521.465496, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[521.465536, "o", "\u001b[?2004h> "]
[521.465593, "o", "def red2(X, P, M, CHUNK, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r"]
[521.465635, "o", "\u001b[?2004h> "]
[521.465673, "o", "    row = tl.program_id(0); chunk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[521.465713, "o", "\u001b[?2004h> "]
[521.465751, "o", "    base = row*M + chunk*CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.465828, "o", "    acc = tl.zeros([BLOCK], tl.float32); acc2 = tl.zeros([BLOCK], tl.float32)\r\n\u001b[?2004l\r"]
[521.465868, "o", "\u001b[?2004h> "]
[521.465901, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.465951, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[521.465991, "o", "\u001b[?2004h>         if EV:\r\n\u001b[?2004l\r"]
[521.466029, "o", "\u001b[?2004h> "]
[521.46609, "o", "            xx = tl.load(X + base + idx, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[521.46613, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.466187, "o", "            xx = tl.load(X + base + idx)\r\n\u001b[?2004l\r"]
[521.466225, "o", "\u001b[?2004h> "]
[521.466265, "o", "        acc += xx; acc2 += xx*xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.466311, "o", "    S = tl.num_programs(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.466369, "o", "    tl.store(P + row*2*S + chunk, tl.sum(acc))\r\n\u001b[?2004l\r"]
[521.466409, "o", "\u001b[?2004h> "]
[521.46645, "o", "    tl.store(P + row*2*S + S + chunk, tl.sum(acc2))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.466489, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.466528, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.466622, "o", "def nrm2(X, W, B, P, Y, M, CHUNK, eps, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r"]
[521.466664, "o", "\u001b[?2004h> "]
[521.466703, "o", "    row = tl.program_id(0); chunk = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.46675, "o", "    offs = tl.arange(0, S)\r\n\u001b[?2004l\r\u001b[?2004h"]
[521.46679, "o", "> "]
[521.466868, "o", "    s = tl.sum(tl.load(P + row*2*S + offs)); s2 = tl.sum(tl.load(P + row*2*S + S + offs))\r\n\u001b[?2004l\r"]
[521.466908, "o", "\u001b[?2004h> "]
[521.466965, "o", "    mean = s/M; var = s2/M - mean*mean; rstd = 1.0/tl.sqrt(var+eps)\r\n\u001b[?2004l\r"]
[521.467004, "o", "\u001b[?2004h> "]
[521.467046, "o", "    bx = row*M + chunk*CHUNK; bw = chunk*CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.4671, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[521.46714, "o", "\u001b[?2004h> "]
[521.467178, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.467217, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.467303, "o", "            xx = tl.load(X + bx + idx, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[521.467347, "o", "\u001b[?2004h> "]
[521.467386, "o", "            ww = tl.load(W + bw + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.467427, "o", "            bb = tl.load(B + bw + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.467538, "o", "            tl.store(Y + bx + idx, (xx-mean)*rstd*ww+bb, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[521.467555, "o", "\u001b[?2004h> "]
[521.467584, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[521.467639, "o", "> "]
[521.467699, "o", "            xx = tl.load(X + bx + idx); ww = tl.load(W + bw + idx); bb = tl.load(B + bw + idx)\r\n\u001b[?2004l\r"]
[521.467738, "o", "\u001b[?2004h> "]
[521.467777, "o", "            tl.store(Y + bx + idx, (xx-mean)*rstd*ww+bb)\r\n\u001b[?2004l\r"]
[521.467819, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.467975, "o", "for chunk, block, nw in [(16384, 8192, 16), (16384, 4096, 8), (8192, 4096, 16), (8192, 2048, 8), (4096, 2048, 8), (4096, 4096, 16)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[521.468017, "o", ">     S = M//chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468098, "o", "    P = torch.empty(rows*2*S, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[521.46814, "o", "\u001b[?2004h> "]
[521.468187, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468234, "o", "    for ev in [False, True]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468275, "o", "        def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468341, "o", "            red2[(rows,S)](x,P,M,chunk,BLOCK=block,num_warps=nw,EV=ev)\r\n\u001b[?2004l\r"]
[521.468381, "o", "\u001b[?2004h> "]
[521.468452, "o", "            nrm2[(rows,S)](x,w,b,P,y,M,chunk,1e-5,S=S,BLOCK=block,num_warps=nw,EV=ev)\r\n\u001b[?2004l\r"]
[521.468494, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468553, "o", "            fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[521.468593, "o", "> "]
[521.468631, "o", "            err=(y-ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468674, "o", "            mean,mn=time_fn(fn)\r\n\u001b[?2004l\r"]
[521.468714, "o", "\u001b[?2004h> "]
[521.468804, "o", "            print(f\"chunk={chunk} block={block} nw={nw} ev={ev}: {mean:.4f}/{mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r"]
[521.468845, "o", "\u001b[?2004h> "]
[521.468885, "o", "        except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[521.468939, "o", "            print(chunk,block,nw,ev,'fail',str(ex)[:80])\r\n\u001b[?2004l\r"]
[521.46898, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[521.505161, "o", "\u001b[?2004hroot@modal:/# "]
