[521.463905, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch\nimport triton, triton.language as tl\n\ntorch.cuda.set_device(0)\nx = torch.rand(16, 64, 256, 256, device='cuda')\nM = 64*256*256; rows = 16\nw = torch.ones(M, device='cuda'); b = torch.zeros(M, device='cuda')\nref = torch.nn.functional.layer_norm(x, (64,256,256), w.view(64,256,256), b.view(64,256,256), 1e-5)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef time_fn(fn, trials=20):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2(); s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef red2(X, P, M, CHUNK, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0); chunk = tl.program_id(1)\n    base = row*M + chunk*CHUNK\n    acc = tl."]
[521.46396, "i", "zeros([BLOCK], tl.float32); acc2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        if EV:\n            xx = tl.load(X + base + idx, eviction_policy='evict_first')\n        else:\n            xx = tl.load(X + base + idx)\n        acc += xx; acc2 += xx*xx\n    S = tl.num_programs(1)\n    tl.store(P + row*2*S + chunk, tl.sum(acc))\n    tl.store(P + row*2*S + S + chunk, tl.sum(acc2))\n\n@triton.jit\ndef nrm2(X, W, B, P, Y, M, CHUNK, eps, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0); chunk = tl.program_id(1)\n    offs = tl.arange(0, S)\n    s = tl.sum(tl.load(P + row*2*S + offs)); s2 = tl.sum(tl.load(P + row*2*S + S + offs))\n    mean = s/M; var = s2/M - mean*mean; rstd = 1.0/tl.sqrt(var+eps)\n    bx = row*M + chunk*CHUNK; bw = chunk*CHUNK\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        if EV:\n            xx = tl.load(X + bx + idx, eviction_policy='evict_first')\n            ww = tl.l"]
[521.463968, "i", "oad(W + bw + idx)\n            bb = tl.load(B + bw + idx)\n            tl.store(Y + bx + idx, (xx-mean)*rstd*ww+bb, eviction_policy='evict_first')\n        else:\n            xx = tl.load(X + bx + idx); ww = tl.load(W + bw + idx); bb = tl.load(B + bw + idx)\n            tl.store(Y + bx + idx, (xx-mean)*rstd*ww+bb)\n\nfor chunk, block, nw in [(16384, 8192, 16), (16384, 4096, 8), (8192, 4096, 16), (8192, 2048, 8), (4096, 2048, 8), (4096, 4096, 16)]:\n    S = M//chunk\n    P = torch.empty(rows*2*S, dtype=torch.float32, device='cuda')\n    y = torch.empty_like(x)\n    for ev in [False, True]:\n        def fn():\n            red2[(rows,S)](x,P,M,chunk,BLOCK=block,num_warps=nw,EV=ev)\n            nrm2[(rows,S)](x,w,b,P,y,M,chunk,1e-5,S=S,BLOCK=block,num_warps=nw,EV=ev)\n        try:\n            fn(); torch.cuda.synchronize()\n            err=(y-ref).abs().max().item()\n            mean,mn=time_fn(fn)\n            print(f\"chunk={chunk} block={block} nw={nw} ev={ev}: {mean:.4f}/{mn:.4f} err={err:.2e}\")\n        except Exception as ex:\n"]
[521.463978, "i", "            print(chunk,block,nw,ev,'fail',str(ex)[:80])\nEOF\n"]
