[607.915256, "o", "    int S = gridDim.x / rows;\r\n\u001b[?2004l\r"]
[607.915281, "o", "\u001b[?2004h> "]
[607.915351, "o", "    int row = blockIdx.x / S;\r\n\u001b[?2004l\r"]
[607.915378, "o", "\u001b[?2004h> "]
[607.915442, "o", "    int slice = blockIdx.x % S;\r\n\u001b[?2004l\r(\u001b[?2004h"]
[607.915468, "o", "> "]
[607.915499, "o", "    int per = M4 / S;\r\n\u001b[?2004l\r"]
[607.915528, "o", "\u001b[?2004h> "]
[607.915683, "o", "    const float4* xr = x4 + (long)row * M4 + (long)slice * per;\r\n\u001b[?2004l\r"]
[607.915711, "o", "\u001b[?2004h> "]
[607.915779, "o", "    float s = 0.f, s2 = 0.f;\r\n\u001b[?2004l\r"]
[607.915804, "o", "\u001b[?2004h> "]
[607.915936, "o", "    for (int i = threadIdx.x; i < per; i += blockDim.x) {\r\n\u001b[?2004l\r"]
[607.915965, "o", "\u001b[?2004h> "]
[607.916008, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r"]
[607.916034, "o", "\u001b[?2004h> "]
[607.916105, "o", "        s += v.x + v.y + v.z + v.w;\r\n\u001b[?2004l\r"]
[607.916131, "o", "\u001b[?2004h> "]
[607.916259, "o", "        s2 += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\r\n\u001b[?2004l\r"]
[607.916287, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r "]
[607.916314, "o", "\u001b[?2004h> "]
[607.916406, "o", "    __shared__ float sh[32], sh2[32];\r\n\u001b[?2004l\r"]
[607.916434, "o", "\u001b[?2004h> "]
[607.916528, "o", "    for (int o = 16; o > 0; o >>= 1) {\r\n\u001b[?2004l\r\r\n"]
[607.916551, "o", "\u001b[?2004h> "]
[607.916689, "o", "        s += __shfl_down_sync(0xffffffffu, s, o);\r\n\u001b[?2004l\r\r\n"]
[607.916715, "o", "\u001b[?2004h> "]
[607.916839, "o", "        s2 += __shfl_down_sync(0xffffffffu, s2, o);\r\n\u001b[?2004l\r"]
[607.916867, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r4 "]
[607.916889, "o", "\u001b[?2004h> "]
[607.91711, "o", "    if ((threadIdx.x & 31) == 0) { sh[threadIdx.x >> 5] = s; sh2[threadIdx.x >> 5] = s2; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.917181, "o", "    __syncthreads();\r\n\u001b[?2004l\r"]
[607.917204, "o", "\u001b[?2004h> "]
[607.917274, "o", "    if (threadIdx.x < 32) {\r\n\u001b[?2004l\rru"]
[607.9173, "o", "\u001b[?2004h> "]
[607.917472, "o", "        s = (threadIdx.x < (blockDim.x >> 5)) ? sh[threadIdx.x] : 0.f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.917502, "o", "        s2 = (threadIdx.x < (blockDim.x >> 5)) ? sh2[threadIdx.x] : 0.f;\r\n\u001b[?2004l\r"]
[607.917526, "o", "\u001b[?2004h> "]
[607.917569, "o", "        for (int o = 16; o > 0; o >>= 1) {\r\n\u001b[?2004l\r"]
[607.917601, "o", "\u001b[?2004h> "]
[607.917656, "o", "            s += __shfl_down_sync(0xffffffffu, s, o);\r\n\u001b[?2004l\r"]
[607.917684, "o", "\u001b[?2004h> "]
[607.917736, "o", "            s2 += __shfl_down_sync(0xffffffffu, s2, o);\r\n\u001b[?2004l\r"]
[607.917765, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[607.91779, "o", "\u001b[?2004h> "]
[607.917828, "o", "        if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[607.917856, "o", "\u001b[?2004h> "]
[607.917891, "o", "            partials[blockIdx.x] = s;\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.917918, "o", "> "]
[607.91796, "o", "            partials[gridDim.x + blockIdx.x] = s2;\r\n\u001b[?2004l\r"]
[607.917986, "o", "\u001b[?2004h> "]
[607.918002, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.918028, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.918059, "o", "    grid.sync();\r\n\u001b[?2004l\r"]
[607.918085, "o", "\u001b[?2004h> "]
[607.918132, "o", "    if (blockIdx.x < DEV_LIMIT && threadIdx.x < 32) {\r\n\u001b[?2004l\r"]
[607.918158, "o", "\u001b[?2004h> "]
[607.918193, "o", "        float a = 0.f, a2 = 0.f;\r\n\u001b[?2004l\r"]
[607.918218, "o", "\u001b[?2004h> "]
[607.918268, "o", "        for (int k = threadIdx.x; k < S; k += 32) {\r\n\u001b[?2004l\r"]
[607.918295, "o", "\u001b[?2004h> "]
[607.918329, "o", "            a += partials[row * S + k];\r\n\u001b[?2004l\r"]
[607.91836, "o", "\u001b[?2004h> "]
[607.918413, "o", "            a2 += partials[gridDim.x + row * S + k];\r\n\u001b[?2004l\r"]
[607.918443, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[607.918467, "o", "\u001b[?2004h> "]
[607.918509, "o", "        for (int o = 16; o > 0; o >>= 1) {\r\n\u001b[?2004l\r"]
[607.918536, "o", "\u001b[?2004h> "]
[607.918586, "o", "            a += __shfl_down_sync(0xffffffffu, a, o);\r\n\u001b[?2004l\r"]
[607.918611, "o", "\u001b[?2004h> "]
[607.918663, "o", "            a2 += __shfl_down_sync(0xffffffffu, a2, o);\r\n\u001b[?2004l\r"]
[607.918689, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[607.918701, "o", "\u001b[?2004h> "]
[607.918744, "o", "        if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[607.918767, "o", "\u001b[?2004h> "]
[607.918813, "o", "            float mean = a / (float)(M4 * 4);\r\n\u001b[?2004l\r"]
[607.918845, "o", "\u001b[?2004h> "]
[607.918897, "o", "            float var = a2 / (float)(M4 * 4) - mean * mean;\r\n\u001b[?2004l\r"]
[607.91892, "o", "\u001b[?2004h> "]
[607.918952, "o", "            sh[threadIdx.x] = mean;\r\n\u001b[?2004l\r"]
[607.918978, "o", "\u001b[?2004h> "]
[607.919023, "o", "            sh2[threadIdx.x] = rsqrtf(var + eps);\r\n\u001b[?2004l\r"]
[607.919048, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[607.919069, "o", "\u001b[?2004h> "]
[607.919091, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.919149, "o", "    if (blockIdx.x >= DEV_LIMIT) { __syncthreads(); }\r\n\u001b[?2004l\r"]
[607.919188, "o", "\u001b[?2004h> "]
[607.919217, "o", "    cg::this_grid().sync();\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.919244, "o", "> "]
[607.919265, "o", "    float mean = sh[0], rstd = sh2[0];\r\n\u001b[?2004l\r"]
[607.919286, "o", "\u001b[?2004h> "]
[607.919336, "o", "    const float4* wr = w4 + (long)slice * per;\r\n\u001b[?2004l\r"]
[607.919362, "o", "\u001b[?2004h> "]
[607.919406, "o", "    const float4* br = b4 + (long)slice * per;\r\n\u001b[?2004l\r"]
[607.91943, "o", "\u001b[?2004h> "]
[607.919488, "o", "    float4* yr = y4 + (long)row * M4 + (long)slice * per;\r\n\u001b[?2004l\r"]
[607.919509, "o", "\u001b[?2004h> "]
[607.919568, "o", "    for (int i = threadIdx.x; i < per; i += blockDim.x) {\r\n\u001b[?2004l\r"]
[607.919597, "o", "\u001b[?2004h> "]
[607.919621, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.919647, "o", "> "]
[607.919677, "o", "        float4 wv = wr[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.919708, "o", "        float4 bv = br[i];\r\n\u001b[?2004l\r"]
[607.919732, "o", "\u001b[?2004h> "]
[607.919758, "o", "        float4 r;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.919813, "o", "        r.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[607.919839, "o", "\u001b[?2004h> "]
[607.919885, "o", "        r.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[607.919912, "o", "\u001b[?2004h> "]
[607.919954, "o", "        r.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[607.919979, "o", "\u001b[?2004h> "]
[607.920024, "o", "        r.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[607.92005, "o", "\u001b[?2004h> "]
[607.920074, "o", "        yr[i] = r;\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.920103, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.920121, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.920147, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[607.920178, "o", "> "]
[607.920286, "o", "torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, int64_t S, int64_t threads) {\r\n\u001b[?2004l\r"]
[607.920315, "o", "\u001b[?2004h> "]
[607.920341, "o", "    int64_t M = w.numel();\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.920365, "o", "> "]
[607.920398, "o", "    int64_t rows = x.numel() / M;\r\n\u001b[?2004l\r"]
[607.920423, "o", "\u001b[?2004h> "]
[607.920452, "o", "    auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[607.920476, "o", "\u001b[?2004h> "]
[607.920501, "o", "    int grid = (int)(rows * S);\r\n\u001b[?2004l\r"]
[607.920525, "o", "\u001b[?2004h> "]
[607.920579, "o", "    auto partials = torch::empty({2 * grid}, x.options());\r\n\u001b[?2004l\r"]
[607.920605, "o", "\u001b[?2004h> "]
[607.920626, "o", "    int M4 = (int)(M / 4);\r\n\u001b[?2004l\r"]
[607.92065, "o", "\u001b[?2004h> "]
[607.920727, "o", "    const float4* x4 = reinterpret_cast<const float4*>(x.data_ptr<float>());\r\n\u001b[?2004l\r"]
[607.920753, "o", "\u001b[?2004h> "]
[607.920827, "o", "    const float4* w4 = reinterpret_cast<const float4*>(w.data_ptr<float>());\r\n\u001b[?2004l\r"]
[607.920852, "o", "\u001b[?2004h> "]
[607.920925, "o", "    const float4* b4 = reinterpret_cast<const float4*>(b.data_ptr<float>());\r\n\u001b[?2004l\r"]
[607.920949, "o", "\u001b[?2004h> "]
[607.92101, "o", "    float4* y4 = reinterpret_cast<float4*>(y.data_ptr<float>());\r\n\u001b[?2004l\r"]
[607.921036, "o", "\u001b[?2004h> "]
[607.921073, "o", "    float* p = partials.data_ptr<float>();\r\n\u001b[?2004l\r"]
[607.921097, "o", "\u001b[?2004h> "]
[607.921123, "o", "    float epsf = (float)eps;\r\n\u001b[?2004l\r"]
[607.921147, "o", "\u001b[?2004h> "]
[607.921272, "o", "    void* args[] = {(void*)&x4, (void*)&w4, (void*)&b4, (void*)&y4, (void*)&p, (void*)&M4, (void*)&rows, (void*)&epsf};\r\n\u001b[?2004l\r"]
[607.921297, "o", "\u001b[?2004h> "]
[607.921328, "o", "    int rowsi = (int)rows;\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.921352, "o", "> "]
[607.921471, "o", "    void* args2[] = {(void*)&x4, (void*)&w4, (void*)&b4, (void*)&y4, (void*)&p, (void*)&M4, (void*)&rowsi, (void*)&epsf};\r\n\u001b[?2004l\r"]
[607.921496, "o", "\u001b[?2004h> "]
[607.921616, "o", "    cudaError_t err = cudaLaunchCooperativeKernel((void*)ln_coop_kernel, dim3(grid), dim3((int)threads), args2, 0, 0);\r\n\u001b[?2004l\r"]
[607.92164, "o", "\u001b[?2004h> "]
[607.921724, "o", "    TORCH_CHECK(err == cudaSuccess, \"coop launch failed: \", cudaGetErrorString(err));\r\n\u001b[?2004l\r"]
[607.921748, "o", "\u001b[?2004h> "]
[607.921769, "o", "    return y;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.921795, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[607.92182, "o", "\u001b[?2004h> "]
[607.921846, "o", "int max_grid(int64_t threads) {\r\n\u001b[?2004l\r"]
[607.921872, "o", "\u001b[?2004h> "]
[607.921921, "o", "    static int dev = -1, numSM = 0, maxB = 0;\r\n\u001b[?2004l\r"]
[607.921947, "o", "\u001b[?2004h> "]
[607.92197, "o", "    if (dev < 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.92201, "o", "        cudaGetDevice(&dev);\r\n\u001b[?2004l\r"]
[607.92204, "o", "\u001b[?2004h> "]
[607.922112, "o", "        cudaDeviceGetAttribute(&numSM, cudaDevAttrMultiProcessorCount, dev);\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.922135, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.922153, "o", "> "]
[607.92218, "o", "    int mb = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.922291, "o", "    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&mb, (void*)ln_coop_kernel, (int)threads, 0);\r\n\u001b[?2004l\r"]
[607.922316, "o", "\u001b[?2004h> "]
[607.922336, "o", "    return numSM * mb;\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.922357, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.922379, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.922407, "o", "int run_check() {\r\n\u001b[?2004l\r"]
[607.922436, "o", "\u001b[?2004h> "]
[607.92252, "o", "    auto opts = torch::TensorOptions().dtype(torch::kFloat32).device(torch::kCUDA);\r\n\u001b[?2004l\r"]
[607.922546, "o", "\u001b[?2004h> "]
[607.922589, "o", "    auto x = torch::rand({16, 64, 256, 256}, opts);\r\n\u001b[?2004l\r"]
[607.922614, "o", "\u001b[?2004h> "]
[607.922665, "o", "    auto w = torch::rand({64, 256, 256}, opts);\r\n\u001b[?2004l\r"]
[607.922688, "o", "\u001b[?2004h> "]
[607.92274, "o", "    auto b = torch::rand({64, 256, 256}, opts);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.922912, "o", "    auto ref = torch::nn::functional::layer_norm(x, torch::nn::functional::LayerNormFuncOptions({64, 256, 256}).weight(w).bias(b).eps(1e-5));\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.92294, "o", "> "]
[607.922969, "o", "    int mb = max_grid(1024);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[607.923033, "o", "    printf(\"max blocks @1024 threads: %d\\n\", mb);\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.923059, "o", "> "]
[607.923131, "o", "    auto y = ln_forward(x, w.reshape({-1}), b.reshape({-1}), 1e-5, 128, 1024);\r\n\u001b[?2004l\r"]
[607.923158, "o", "\u001b[?2004h> "]
[607.923215, "o", "    auto d = (y - ref).abs().max().item<float>();\r\n\u001b[?2004l\r"]
[607.923241, "o", "\u001b[?2004h> "]
[607.923264, "o", "    printf(\"max diff coop: %g\\n\", d);\r\n\u001b[?2004l\r"]
[607.923291, "o", "\u001b[?2004h> "]
[607.923323, "o", "    return d < 1e-4 ? 0 : 1;\r\n\u001b[?2004l\r"]
[607.923348, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[607.923372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[607.923398, "o", "\u001b[?2004h> "]
[607.923434, "o", "PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\r\n\u001b[?2004l\r"]
[607.92346, "o", "\u001b[?2004h> "]
[607.923503, "o", "    m.def(\"ln_forward\", &ln_forward);\r\n\u001b[?2004l\r"]
[607.923527, "o", "\u001b[?2004h> "]
[607.923551, "o", "    m.def(\"max_grid\", &max_grid);\r\n\u001b[?2004l\r"]
[607.923575, "o", "\u001b[?2004h> "]
[607.92362, "o", "    m.def(\"run_check\", &run_check);\r\n\u001b[?2004l\r"]
[607.923642, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[607.923671, "o", "> EOF\r\n\u001b[?2004l\r"]
[607.954922, "o", "\u001b[?2004hroot@modal:/# "]
[608.414232, "i", "cat > /workspace/coop_test/build_run.py << 'EOF'\nimport torch, time\nfrom torch.utils.cpp_extension import load\nt0 = time.time()\next = load(name='coop_ext', sources=['/workspace/coop_test/coop_ext.cu'],\n           extra_cuda_cflags=['-O3', '--use_fast_math', '-gencode=arch=compute_90,code=sm_90'],\n           build_directory='/workspace/coop_test/build', verbose=True)\nprint('build ok in', time.time()-t0, 's')\nprint('max_grid:', ext.max_grid(1024))\nrc = ext.run_check()\nprint('check rc:', rc)\nEOF\n"]
[608.414416, "o", "cat > /workspace/coop_test/build_run.py << 'EOF'\r\n\u001b[?2004l\r"]
[608.41447, "o", "\u001b[?2004h> "]
[608.4145, "o", "import torch, time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.414557, "o", "from torch.utils.cpp_extension import load\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.414587, "o", "> t0 = time.time()\r\n\u001b[?2004l\r"]
[608.414611, "o", "\u001b[?2004h> "]
[608.414687, "o", "ext = load(name='coop_ext', sources=['/workspace/coop_test/coop_ext.cu'],\r\n\u001b[?2004l\r"]
[608.414709, "o", "\u001b[?2004h> "]
[608.414808, "o", "           extra_cuda_cflags=['-O3', '--use_fast_math', '-gencode=arch=compute_90,code=sm_90'],\r\n\u001b[?2004l\r"]
[608.414836, "o", "\u001b[?2004h> "]
[608.414896, "o", "           build_directory='/workspace/coop_test/build', verbose=True)\r\n\u001b[?2004l\r"]
[608.414922, "o", "\u001b[?2004h> "]
[608.414961, "o", "print('build ok in', time.time()-t0, 's')\r\n\u001b[?2004l\r"]
[608.414985, "o", "\u001b[?2004h> "]
