[55.668206, "o", "201:def time_execution_with_cuda_event(\r\n202-    kernel_fn: callable,\r\n203-    args: list[Any],\r\n204-    num_warmup: int = 3,\r\n205-    num_trials: int = 10,\r\n206-    discard_first: int = 1, # set to 0 to disable\r\n207-    verbose: bool = True,\r\n208-    device: torch.device = None,\r\n209-) -> list[float]:\r\n210-    \"\"\"\r\n211-    Time a CUDA kernel function over multiple trials using torch.cuda.event\r\n212-    The first version of KernelBench used this for evaluation.\r\n213-    We care about cold cache performance here.\r\n214-\r\n215-    Note: this version does not guard against adverserial cuda streams yet.\r\n216-    It assumes computation is done on the current stream for current device. \r\n217-    Stay tuned for future PRs. \r\n218-\r\n219-    Args:\r\n220-        kernel_fn: Function to time\r\n221-        args: Arguments to pass to kernel_fn\r\n222-        num_warmup: Number of warmup iterations before timing\r\n223-        num_trials: Number of timing trials to run\r\n224-        discard_first: Number of first trials to discard, f"]
[55.668275, "o", "or consistency with host_time, set to 0 to disable\r\n225-        verbose: Whether to print per-trial timing info\r\n226-        device: CUDA device to use, defaults to current device\r\n227-\r\n228-    Returns:\r\n229-        List of elapsed times in milliseconds (length = num_trials)\r\n230-    \"\"\"\r\n231-    if device is None:\r\n232-        if verbose:\r\n233-            print(f\"Using current device: {torch.cuda.current_device()}\")\r\n234-        device = torch.cuda.current_device()\r\n235-\r\n236-    with torch.cuda.device(device):\r\n237-        \r\n238-        # Warm ups\r\n239-        for _ in range(num_warmup):\r\n240-            kernel_fn(*args)\r\n241-            torch.cuda.synchronize(device=device)\r\n242-        \r\n243-        # note this only release PyTorch’s CUDA caching allocator, not necessarily clearing device's L2 cache\r\n244-        torch.cuda.empty_cache()\r\n245-        \r\n246-        print(f\"[Profiling] Using device: {device} {torch.cuda.get_device_name(device)}, warm up {num_warmup}, trials {num_trials}\"\r\n247-        )\r\n2"]
[55.668312, "o", "48-\r\n249-        elapsed_times: list[float] = [] # in ms\r\n250-\r\n251-        # Timing trials\r\n252-        for trial in range(num_trials + discard_first):\r\n253-            torch.cuda.synchronize(device=device) # block on all streams\r\n254-\r\n255-            # create event marker default is not interprocess\r\n256-            start_event = torch.cuda.Event(enable_timing=True)\r\n257-            end_event = torch.cuda.Event(enable_timing=True)\r\n258-            \r\n259-            clear_l2_cache(device=device) # measuring cold cache performance\r\n260-\r\n261-            # note cuda events mark event on current stream\r\n262-            start_event.record()\r\n263-            _ = kernel_fn(*args)\r\n264-            end_event.record() \r\n265-\r\n266-            # waits for all streams on that device\r\n267-            # though it is important to note the events only record time between on current stream\r\n268-            # TODO: find ways to check hacks by launching work on additional stream\r\n269-            torch.cuda.synchronize(device="]
[55.668338, "o", "device)\r\n270-\r\n271-            # Calculate the elapsed time in milliseconds\r\n272-            elapsed_time_ms = start_event.elapsed_time(end_event)\r\n273-            \r\n274-            if trial >= discard_first:\r\n275-                if verbose:\r\n276-                    logical_idx = trial - discard_first + 1\r\n277-                    print(f\"Trial {logical_idx}: {elapsed_time_ms:.3g} ms\")\r\n278-                elapsed_times.append(elapsed_time_ms)\r\n279-\r\n280-\r\n281-    return elapsed_times\r\n282-\r\n283-\r\n284-def time_execution_with_do_bench_interface(\r\n285-    kernel_fn: callable,\r\n286-    args: list[Any],\r\n287-    # Not used, as triton do_bench handles adaptive trials\r\n288-    num_warmup: int = 3, \r\n289-    num_trials: int = 10,\r\n290-    discard_first: int = 1, # not used here\r\n291-    verbose: bool = True,\r\n"]
