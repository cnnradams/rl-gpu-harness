[607.913464, "i", "mkdir -p /workspace/coop_test && cat > /workspace/coop_test/coop_ext.cu << 'EOF'\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <cooperative_groups.h>\nnamespace cg = cooperative_groups;\n\n#ifndef DEV_LIMIT\n#define DEV_LIMIT 16\n#endif\n\n__global__ void __launch_bounds__(1024, 1) ln_coop_kernel(\n    const float4* __restrict__ x4,\n    const float4* __restrict__ w4,\n    const float4* __restrict__ b4,\n    float4* __restrict__ y4,\n    float* __restrict__ partials,\n    int M4, int rows, float eps)\n{\n    cg::grid_group grid = cg::this_grid();\n    int S = gridDim.x / rows;\n    int row = blockIdx.x / S;\n    int slice = blockIdx.x % S;\n    int per = M4 / S;\n    const float4* xr = x4 + (long)row * M4 + (long)slice * per;\n    float s = 0.f, s2 = 0.f;\n    for (int i = threadIdx.x; i < per; i += blockDim.x) {\n        float4 v = xr[i];\n        s += v.x + v.y + v.z + v.w;\n        s2 += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n    __shared__ float sh[32], sh2[32];\n    for (int o = 16; o > 0; o >>= 1) {\n     "]
[607.913517, "i", "   s += __shfl_down_sync(0xffffffffu, s, o);\n        s2 += __shfl_down_sync(0xffffffffu, s2, o);\n    }\n    if ((threadIdx.x & 31) == 0) { sh[threadIdx.x >> 5] = s; sh2[threadIdx.x >> 5] = s2; }\n    __syncthreads();\n    if (threadIdx.x < 32) {\n        s = (threadIdx.x < (blockDim.x >> 5)) ? sh[threadIdx.x] : 0.f;\n        s2 = (threadIdx.x < (blockDim.x >> 5)) ? sh2[threadIdx.x] : 0.f;\n        for (int o = 16; o > 0; o >>= 1) {\n            s += __shfl_down_sync(0xffffffffu, s, o);\n            s2 += __shfl_down_sync(0xffffffffu, s2, o);\n        }\n        if (threadIdx.x == 0) {\n            partials[blockIdx.x] = s;\n            partials[gridDim.x + blockIdx.x] = s2;\n        }\n    }\n    grid.sync();\n    if (blockIdx.x < DEV_LIMIT && threadIdx.x < 32) {\n        float a = 0.f, a2 = 0.f;\n        for (int k = threadIdx.x; k < S; k += 32) {\n            a += partials[row * S + k];\n            a2 += partials[gridDim.x + row * S + k];\n        }\n        for (int o = 16; o > 0; o >>= 1) {\n            a += __shfl_down_sync(0"]
[607.913618, "i", "xffffffffu, a, o);\n            a2 += __shfl_down_sync(0xffffffffu, a2, o);\n        }\n        if (threadIdx.x == 0) {\n            float mean = a / (float)(M4 * 4);\n            float var = a2 / (float)(M4 * 4) - mean * mean;\n            sh[threadIdx.x] = mean;\n            sh2[threadIdx.x] = rsqrtf(var + eps);\n        }\n    }\n    if (blockIdx.x >= DEV_LIMIT) { __syncthreads(); }\n    cg::this_grid().sync();\n    float mean = sh[0], rstd = sh2[0];\n    const float4* wr = w4 + (long)slice * per;\n    const float4* br = b4 + (long)slice * per;\n    float4* yr = y4 + (long)row * M4 + (long)slice * per;\n    for (int i = threadIdx.x; i < per; i += blockDim.x) {\n        float4 v = xr[i];\n        float4 wv = wr[i];\n        float4 bv = br[i];\n        float4 r;\n        r.x = (v.x - mean) * rstd * wv.x + bv.x;\n        r.y = (v.y - mean) * rstd * wv.y + bv.y;\n        r.z = (v.z - mean) * rstd * wv.z + bv.z;\n        r.w = (v.w - mean) * rstd * wv.w + bv.w;\n        yr[i] = r;\n    }\n}\n\ntorch::Tensor ln_forward(torch::Tensor x, torc"]
[607.913666, "i", "h::Tensor w, torch::Tensor b, double eps, int64_t S, int64_t threads) {\n    int64_t M = w.numel();\n    int64_t rows = x.numel() / M;\n    auto y = torch::empty_like(x);\n    int grid = (int)(rows * S);\n    auto partials = torch::empty({2 * grid}, x.options());\n    int M4 = (int)(M / 4);\n    const float4* x4 = reinterpret_cast<const float4*>(x.data_ptr<float>());\n    const float4* w4 = reinterpret_cast<const float4*>(w.data_ptr<float>());\n    const float4* b4 = reinterpret_cast<const float4*>(b.data_ptr<float>());\n    float4* y4 = reinterpret_cast<float4*>(y.data_ptr<float>());\n    float* p = partials.data_ptr<float>();\n    float epsf = (float)eps;\n    void* args[] = {(void*)&x4, (void*)&w4, (void*)&b4, (void*)&y4, (void*)&p, (void*)&M4, (void*)&rows, (void*)&epsf};\n    int rowsi = (int)rows;\n    void* args2[] = {(void*)&x4, (void*)&w4, (void*)&b4, (void*)&y4, (void*)&p, (void*)&M4, (void*)&rowsi, (void*)&epsf};\n    cudaError_t err = cudaLaunchCooperativeKernel((void*)ln_coop_kernel, dim3(grid), dim3((int)thread"]
[607.913693, "o", "mkdir -p /workspace/coop_test && cat > /workspace/coop_test/coop_ext.cu << 'EOF'\r\n\u001b[?2004l\r"]
[607.913723, "i", "s), args2, 0, 0);\n    TORCH_CHECK(err == cudaSuccess, \"coop launch failed: \", cudaGetErrorString(err));\n    return y;\n}\n\nint max_grid(int64_t threads) {\n    static int dev = -1, numSM = 0, maxB = 0;\n    if (dev < 0) {\n        cudaGetDevice(&dev);\n        cudaDeviceGetAttribute(&numSM, cudaDevAttrMultiProcessorCount, dev);\n    }\n    int mb = 0;\n    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&mb, (void*)ln_coop_kernel, (int)threads, 0);\n    return numSM * mb;\n}\n\nint run_check() {\n    auto opts = torch::TensorOptions().dtype(torch::kFloat32).device(torch::kCUDA);\n    auto x = torch::rand({16, 64, 256, 256}, opts);\n    auto w = torch::rand({64, 256, 256}, opts);\n    auto b = torch::rand({64, 256, 256}, opts);\n    auto ref = torch::nn::functional::layer_norm(x, torch::nn::functional::LayerNormFuncOptions({64, 256, 256}).weight(w).bias(b).eps(1e-5));\n    int mb = max_grid(1024);\n    printf(\"max blocks @1024 threads: %d\\n\", mb);\n    auto y = ln_forward(x, w.reshape({-1}), b.reshape({-1}), 1e-5, 128, 1024);\n    au"]
[607.913746, "o", "\u001b[?2004h> "]
[607.913773, "i", "to d = (y - ref).abs().max().item<float>();\n    printf(\"max diff coop: %g\\n\", d);\n    return d < 1e-4 ? 0 : 1;\n}\n\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n    m.def(\"ln_forward\", &ln_forward);\n    m.def(\"max_grid\", &max_grid);\n    m.def(\"run_check\", &run_check);\n}\nEOF\n"]
