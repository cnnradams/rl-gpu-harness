[416.069915, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_reduce_kernel, _ln_norm_kernel, ModelNew\n\ntorch.cuda.set_device(0)\nx = torch.rand(16, 64, 256, 256, device='cuda')\nmodel = ModelNew((64, 256, 256)).cuda()\nref = torch.nn.functional.layer_norm(x, (64, 256, 256), model.weight, model.bias, 1e-5)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef time_fn(fn, trials=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    times = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return sum(times) / len(times), min(times)\n\nM = 64 * 256 * 256\nrows = 16\nw = model.weight.contiguous(); b = model.bias.contiguous()\nfor chunk in [16384, 32768, 65536]:\n    "]
[416.070078, "i", "S = M // chunk\n    P = torch.empty(rows * 2 * S, dtype=torch.float32, device='cuda')\n    y = torch.empty_like(x)\n    for block in [2048, 4096, 8192, 16384]:\n        if block > chunk: continue\n        for nw in [4, 8, 16]:\n            def fn():\n                _ln_reduce_kernel[(rows, S)](x, P, M, chunk, BLOCK=block, num_warps=nw)\n                _ln_norm_kernel[(rows, S)](x, w, b, P, y, M, chunk, 1e-5, S=S, BLOCK=block, num_warps=nw)\n            try:\n                fn(); torch.cuda.synchronize()\n                err = (y - ref).abs().max().item()\n                mean, mn = time_fn(fn)\n                def red():\n                    _ln_reduce_kernel[(rows, S)](x, P, M, chunk, BLOCK=block, num_warps=nw)\n                def nrm():\n                    _ln_norm_kernel[(rows, S)](x, w, b, P, y, M, chunk, 1e-5, S=S, BLOCK=block, num_warps=nw)\n                mr, _ = time_fn(red)\n                mnrm, _ = time_fn(nrm)\n                print(f\"chunk={chunk} block={block} nw={nw}: total={mean:.4f}/{mn:.4f} red={mr:.4f} "]
[416.070098, "o", "cat > /workspace/tune.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[416.070114, "i", "nrm={mnrm:.4f} err={err:.2e}\")\n            except Exception as ex:\n                print(chunk, block, nw, \"fail\", str(ex)[:80])\nEOF\n"]
[416.07012, "o", "> "]
