[876.962613, "o", "\u001b[?2004hroot@modal:/workspace# "]
[885.563693, "i", "gpu exec sb-LWVR0LH9LaHjlcVMDex3zK -- timeout 170 python3 -u /workspace/bench2.py\n"]
[885.563932, "o", "gpu exec sb-LWVR0LH9LaHjlcVMDex3zK -- timeout 170 python3 -u /workspace/bench2.py\r\n\u001b[?2004l\r"]
