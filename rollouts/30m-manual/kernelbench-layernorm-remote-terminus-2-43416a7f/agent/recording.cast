[1151.833287, "i", "cat > /workspace/bench4.py << 'EOF'\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ntorch.cuda.init()\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64 * 256 * 256\nrows = 16\neps = 1e-5\nw = torch.ones(N, device='cuda')\nb = torch.zeros(N, device='cuda')\nref = F.layer_norm(x, (64, 256, 256), w.view(64, 256, 256), b.view(64, 256, 256), eps)\n\n\n@triton.jit\ndef _stats_u2(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    a1 = tl.zeros([BLOCK], dtype=tl.float32)\n    a2 = tl.zeros([BLOCK], dtype=tl.float32)\n    q1 = tl.zeros([BLOCK], dtype=tl.float32)\n    q2 = tl.zeros([BLOCK], dtype=tl.float32)\n    ar = tl.arange(0, BLOCK)\n    for off in range(0, CHUNK, 2 * BLOCK):\n        t1 = tl.load(X + base + off + ar)\n        t2 = tl.load(X + base + off + BLOCK + ar)\n        a1 += t1\n        a2 += t2\n        q1 += t1 * t1\n        q2 += t2 * t2\n    tl.ato"]
[1151.833463, "i", "mic_add(S + row, tl.sum(a1 + a2, axis=0))\n    tl.atomic_add(Q + row, tl.sum(q1 + q2, axis=0))\n\n\n@triton.jit\ndef _stats_u1(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    a1 = tl.zeros([BLOCK], dtype=tl.float32)\n    q1 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        t1 = tl.load(X + base + off + tl.arange(0, BLOCK))\n        a1 += t1\n        q1 += t1 * t1\n    tl.atomic_add(S + row, tl.sum(a1, axis=0))\n    tl.atomic_add(Q + row, tl.sum(q1, axis=0))\n\n\n@triton.jit\ndef _apply_v2(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr, XEV: tl.constexpr, WBEV: tl.constexpr, YEV: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    mean = tl.load(S + row) * inv_N\n    var = tl.load(Q + row) * inv_N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLO"]
[1151.833482, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r"]
[1151.83355, "i", "CK)\n        t = tl.load(X + base + idx, eviction_policy=XEV)\n        ww = tl.load(W + idx, eviction_policy=WBEV)\n        bb = tl.load(B + idx, eviction_policy=WBEV)\n        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb, eviction_policy=YEV)\n\n\ndef timeit(fn, trials=20):\n    for _ in range(3):\n        fn()\n        torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True)\n        e = torch.cuda.Event(enable_timing=True)\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n        d.fill_(42)\n        del d\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return float(np.mean(ts)), float(np.min(ts))\n\n\ndef f_two(statskern, SCH, SBL, SWP, ACH, ABL, AWP, XEV='', WBEV='', YEV=''):\n    schunk = N // SCH\n    achunk = N // ACH\n    def fn():\n        y = torch.empty_like(x)\n        s = torch.zeros((2, r"]
[1151.833594, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[1151.833632, "i", "ows), device='cuda')\n        statskern[(rows, SCH)](x, s[0], s[1], N, schunk, BLOCK=SBL, num_warps=SWP)\n        _apply_v2[(rows, ACH)](x, y, s[0], s[1], w, b, N, achunk, 1.0 / N, eps, BLOCK=ABL, XEV=XEV, WBEV=WBEV, YEV=YEV, num_warps=AWP)\n        return y\n    return fn\n\n\ncands = [\n    ('A u2-128/4096/4 + ap64/8192/8/wbevl', f_two(_stats_u2, 128, 4096, 4, 64, 8192, 8, '', 'evict_last', '')),\n    ('B u2-128/4096/4 + ap128/4096/4', f_two(_stats_u2, 128, 4096, 4, 128, 4096, 4, '', '', '')),\n    ('C u1-64/8192/8 + ap64/8192/8', f_two(_stats_u1, 64, 8192, 8, 64, 8192, 8, '', '', '')),\n    ('D u1-64/8192/8 + ap64/8192/8/wbevl', f_two(_stats_u1, 64, 8192, 8, 64, 8192, 8, '', 'evict_last', '')),\n    ('E u2-128/4096/4 + ap256/4096/4/efl', f_two(_stats_u2, 128, 4096, 4, 256, 4096, 4, 'evict_first', 'evict_last', 'evict_first')),\n]\nfor name, fn in cands:\n    y = fn()\n    torch.cuda.synchronize()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    m, mn = timeit(fn)\n    print(f\"{name}: ok={ok} mean={m:.4f} min={mn:."]
