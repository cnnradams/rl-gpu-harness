[1151.833702, "i", "4f}\")\n\n# torch.compile baseline\ndef ln_fn(x):\n    return F.layer_norm(x, (64, 256, 256), w.view(64, 256, 256), b.view(64, 256, 256), eps)\ncln = torch.compile(ln_fn, mode='max-autotune-no-cudagraphs')\ntry:\n    y = cln(x)\n    torch.cuda.synchronize()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    m, mn = timeit(lambda: cln(x))\n    print(f\"torch.compile: ok={ok} mean={m:.4f} min={mn:.4f}\")\nexcept Exception as ex:\n    print('torch.compile failed:', ex)\nEOF\npython3 -m py_compile /workspace/bench4.py && echo OK\n"]
