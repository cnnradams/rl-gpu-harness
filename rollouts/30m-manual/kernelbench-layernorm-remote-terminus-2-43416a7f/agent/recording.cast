[1087.402718, "o", "== stats variants ==\r\nstats u1 CH=64 BL=8192 W=8 ST=1: mean=0.1068 min=0.1043 GB/s=2575\r\nstats u2 CH=64 BL=8192 W=8 ST=1: mean=0.1057 min=0.1033 GB/s=2598\r\nstats u2 CH=128 BL=4096 W=4 ST=1: mean=0.1042 min=0.1015 GB/s=2645\r\nstats u2 CH=128 BL=8192 W=8 ST=1: mean=0.1045 min=0.1033 GB/s=2600\r\nstats u4 CH=64 BL=8192 W=8 ST=1: mean=1.2930 min=1.2890 GB/s=208\r\nstats u4 CH=128 BL=4096 W=4 ST=1: mean=1.2937 min=1.2763 GB/s=210\r\nstats u4 CH=128 BL=8192 W=8 ST=1: mean=1.5804 min=1.5568 GB/s=172\r\nstats u4 CH=256 BL=4096 W=4 ST=1: mean=1.5494 min=1.5286 GB/s=176\r\nstats u1 CH=64 BL=8192 W=8 ST=4: mean=0.1074 min=0.1052 GB/s=2553\r\nstats u1 CH=128 BL=4096 W=4 ST=4: mean=0.1108 min=0.1040 GB/s=2581\r\n== apply variants ==\r\napply CH=128 BL=4096 W=4 XEV= WBEV= YEV=: mean=0.2032 min=0.1953\r\napply CH=128 BL=4096 W=4 XEV=evict_first WBEV=evict_last YEV=evict_first: mean=0.2008 min=0.1987\r\napply CH=128 BL=4096 W=4 XEV=evict_first WBEV=evict_last YEV=: mean=0.2059 min=0.1969\r\napply CH=64 BL=8192 W=8 XEV=evict_first WBEV=evict_last Y"]
[1087.402783, "o", "EV=evict_first: mean=0.1957 min=0.1932\r\napply CH=64 BL=8192 W=8 XEV= WBEV=evict_last YEV=: mean=0.1932 min=0.1915\r\napply CH=256 BL=4096 W=4 XEV=evict_first WBEV=evict_last YEV=evict_first: mean=0.1933 min=0.1929\r\napply CH=64 BL=8192 W=8 XEV=evict_first WBEV=evict_last YEV=evict_last: mean=0.2023 min=0.1930\r\n"]
