[413.537421, "i", "cat > /workspace/bench.py << 'EOF'\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ntorch.cuda.init()\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64 * 256 * 256\nrows = 16\neps = 1e-5\nw = torch.ones(N, device='cuda')\nb = torch.zeros(N, device='cuda')\nref = F.layer_norm(x, (64, 256, 256), w.view(64, 256, 256), b.view(64, 256, 256), eps)\n\n\n@triton.jit\ndef _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        t = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += t\n        acc2 += t * t\n    tl.atomic_add(S + row, tl.sum(acc, axis=0))\n    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\n\n\n@triton.jit\ndef _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr):\n    row ="]
[413.537634, "i", " tl.program_id(0)\n    ch = tl.program_id(1)\n    mean = tl.load(S + row) * inv_N\n    var = tl.load(Q + row) * inv_N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        t = tl.load(X + base + idx)\n        ww = tl.load(W + idx)\n        bb = tl.load(B + idx)\n        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb)\n\n\n@triton.jit\ndef _fused_kernel(X, Y, S, Q, C, W, B, N, CHUNK, NCHUNK, inv_N, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        t = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += t\n        acc2 += t * t\n    tl.atomic_add(S + row, tl.sum(acc, axis=0))\n    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\n    tl.atomic_add(C + row, 1)\n    cnt = tl.atomi"]
[413.537679, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.537746, "i", "c_add(C + row, 0)\n    while cnt < NCHUNK:\n        cnt = tl.atomic_add(C + row, 0)\n    mean = tl.atomic_add(S + row, 0.0) * inv_N\n    var = tl.atomic_add(Q + row, 0.0) * inv_N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        t = tl.load(X + base + idx)\n        ww = tl.load(W + idx)\n        bb = tl.load(B + idx)\n        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb)\n\n\ndef make_two(CHUNKS, BLOCK, warps):\n    chunk = N // CHUNKS\n    def fn():\n        y = torch.empty_like(x)\n        stats = torch.zeros((2, rows), device='cuda', dtype=torch.float32)\n        _stats_kernel[(rows, CHUNKS)](x, stats[0], stats[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\n        _apply_kernel[(rows, CHUNKS)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, num_warps=warps)\n        return y\n    return fn\n\n\ndef make_fused(CHUNKS, BLOCK, warps):\n    chunk = N // CHUNKS\n    def fn():\n        y = torch.empty_like(x)\n        buf ="]
[413.537768, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.537817, "i", " torch.zeros(3 * rows, device='cuda', dtype=torch.float32)\n        S = buf[:rows]\n        Q = buf[rows:2 * rows]\n        C = buf[2 * rows:].view(torch.int32)\n        _fused_kernel[(rows, CHUNKS)](x, y, S, Q, C, w, b, N, chunk, CHUNKS, 1.0 / N, eps, BLOCK=BLOCK, num_warps=warps)\n        return y\n    return fn\n\n\ndef check(fn):\n    y = fn()\n    torch.cuda.synchronize()\n    md = (y - ref).abs().max().item()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    return ok, md\n\n\ndef timeit(fn, trials=20):\n    for _ in range(3):\n        fn()\n        torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True)\n        e = torch.cuda.Event(enable_timing=True)\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n        d.fill_(42)\n        del d\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return float"]
[413.537836, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.537891, "i", "(np.mean(ts)), float(np.min(ts))\n\n\nconfigs_two = [(16, 16384, 8), (32, 16384, 8), (64, 16384, 8), (64, 8192, 8), (128, 8192, 8), (64, 32768, 16), (32, 32768, 16), (128, 4096, 4), (256, 4096, 4)]\nfor CH, BL, WP in configs_two:\n    fn = make_two(CH, BL, WP)\n    ok, md = check(fn)\n    m, mn = timeit(fn)\n    print(f\"two CH={CH} BLOCK={BL} warps={WP}: ok={ok} maxdiff={md:.2e} mean={m:.4f} min={mn:.4f}\")\n\nconfigs_fused = [(32, 1024, 4), (32, 2048, 8), (64, 1024, 4), (64, 2048, 4), (16, 1024, 4), (128, 1024, 4), (64, 2048, 8)]\nfor CH, BL, WP in configs_fused:\n    fn = make_fused(CH, BL, WP)\n    ok, md = check(fn)\n    m, mn = timeit(fn)\n    print(f\"fused CH={CH} BLOCK={BL} warps={WP}: ok={ok} maxdiff={md:.2e} mean={m:.4f} min={mn:.4f}\")\n\n# occupancy info for fused kernel\nfor key, kern in _fused_kernel.device_caches[0][0].items() if hasattr(_fused_kernel, 'device_caches') else []:\n    pass\ntry:\n    caches = _fused_kernel.cache\n    for dev, entries in caches.items():\n        for k, v in entries.items():\n            pri"]
[413.537911, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.537947, "i", "nt('fused compiled:', v.n_regs, 'regs', v.n_spills, 'spills')\nexcept Exception as ex:\n    print('cache introspect fail', ex)\nEOF\npython3 -m py_compile /workspace/bench.py && echo OK\n"]
[413.537989, "o", "torch.cuda.init()\r\n\u001b[?2004l\r6\u001b[?2004h> "]
[413.538125, "o", "x = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[413.538173, "o", "\u001b[?2004h> "]
[413.538214, "o", "N = 64 * 256 * 256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.538264, "o", "rows = 16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.538311, "o", "eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.538357, "o", "> "]
[413.538441, "o", "w = torch.ones(N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.538482, "o", "> "]
[413.538545, "o", "b = torch.zeros(N, device='cuda')\r\n\u001b[?2004l\r"]
[413.538587, "o", "\u001b[?2004h> "]
[413.538797, "o", "ref = F.layer_norm(x, (64, 256, 256), w.view(64, 256, 256), b.view(64, 256, 256), eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.538843, "o", "\r\n\u001b[?2004l\r,\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.538883, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[413.538924, "o", "\u001b[?2004h> "]
[413.539047, "o", "def _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[413.539089, "o", "\u001b[?2004h> "]
[413.539128, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[413.539168, "o", "\u001b[?2004h> "]
[413.539209, "o", "    ch = tl.program_id(1)\r\n"]
[413.53925, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[413.539347, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[413.539394, "o", "\u001b[?2004h> "]
[413.53949, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[413.539531, "o", "\u001b[?2004h> "]
[413.539636, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[413.539679, "o", "\u001b[?2004h> "]
[413.53976, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[413.5398, "o", "\u001b[?2004h> "]
[413.539922, "o", "        t = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[413.539963, "o", "\u001b[?2004h> "]
[413.540003, "o", "        acc += t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.540063, "o", "        acc2 += t * t\r\n\u001b[?2004l\r"]
[413.540103, "o", "\u001b[?2004h> "]
[413.540209, "o", "    tl.atomic_add(S + row, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[413.540251, "o", "\u001b[?2004h> "]
[413.540342, "o", "    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[413.540382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[413.540422, "o", "r\u001b[?2004h> "]
[413.540461, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.540689, "o", "def _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.540765, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[413.540802, "o", "\u001b[?2004h> "]
[413.54086, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r"]
[413.540901, "o", "\u001b[?2004h> "]
[413.540963, "o", "    mean = tl.load(S + row) * inv_N\r\n\u001b[?2004l\r"]
[413.541004, "o", "\u001b[?2004h> "]
[413.541112, "o", "    var = tl.load(Q + row) * inv_N - mean * mean\r\n\u001b[?2004l\r"]
[413.541128, "o", "\u001b[?2004h> "]
[413.541222, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[413.541265, "o", "\u001b[?2004h> "]
[413.541319, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[413.541423, "o", "\u001b[?2004h> "]
[413.541472, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[413.541512, "o", "\u001b[?2004h> "]
[413.541555, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.541595, "o", "        t = tl.load(X + base + idx)\r\n\u001b[?2004l\r"]
[413.541616, "o", "\u001b[?2004h> "]
[413.541664, "o", "        ww = tl.load(W + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.541707, "o", "        bb = tl.load(B + idx)\r\n\u001b[?2004l\r"]
[413.541747, "o", "\u001b[?2004h> "]
[413.541796, "o", "        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.541839, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.541883, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.541978, "o", "def _fused_kernel(X, Y, S, Q, C, W, B, N, CHUNK, NCHUNK, inv_N, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[413.542013, "o", "\u001b[?2004h> "]
[413.542053, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.542093, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.542138, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[413.542177, "o", "\u001b[?2004h> "]
[413.542218, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.542273, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[413.542313, "o", "\u001b[?2004h> "]
[413.542351, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.542413, "o", "        t = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[413.542454, "o", "\u001b[?2004h>         acc += t\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.542493, "o", ">         acc2 += t * t\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.542538, "o", "> "]
[413.542578, "o", "    tl.atomic_add(S + row, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.542637, "o", "    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[413.542676, "o", "\u001b[?2004h> "]
[413.542716, "o", "    tl.atomic_add(C + row, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.542755, "o", "    cnt = tl.atomic_add(C + row, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.542794, "o", ">     while cnt < NCHUNK:\r\n\u001b[?2004l\r"]
[413.542829, "o", "\u001b[?2004h> "]
[413.542863, "o", "        cnt = tl.atomic_add(C + row, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.542903, "o", "> "]
[413.542942, "o", "    mean = tl.atomic_add(S + row, 0.0) * inv_N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543007, "o", "    var = tl.atomic_add(Q + row, 0.0) * inv_N - mean * mean\r\n\u001b[?2004l\r"]
[413.543047, "o", "\u001b[?2004h> "]
[413.543086, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543126, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[413.543166, "o", "\u001b[?2004h> "]
[413.543205, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543244, "o", "        t = tl.load(X + base + idx)\r\n\u001b[?2004l\r"]
[413.543284, "o", "\u001b[?2004h> "]
[413.543321, "o", "        ww = tl.load(W + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543362, "o", "        bb = tl.load(B + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543448, "o", "        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543489, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543538, "o", "def make_two(CHUNKS, BLOCK, warps):\r\n\u001b[?2004l\r"]
[413.543578, "o", "\u001b[?2004h>     chunk = N // CHUNKS\r\n\u001b[?2004l\r"]
[413.543617, "o", "\u001b[?2004h>     def fn():\r\n\u001b[?2004l\r"]
[413.543657, "o", "\u001b[?2004h> "]
[413.543696, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.543767, "o", "        stats = torch.zeros((2, rows), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[413.543808, "o", "\u001b[?2004h> "]
[413.543902, "o", "        _stats_kernel[(rows, CHUNKS)](x, stats[0], stats[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[413.543945, "o", "\u001b[?2004h> "]
[413.544054, "o", "        _apply_kernel[(rows, CHUNKS)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[413.544096, "o", "\u001b[?2004h> "]
[413.544136, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544176, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[413.544216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544259, "o", "def make_fused(CHUNKS, BLOCK, warps):\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.5443, "o", ">     chunk = N // CHUNKS\r\n\u001b[?2004l\r"]
[413.544338, "o", "\u001b[?2004h>     def fn():\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.544377, "o", "> "]
[413.544417, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544481, "o", "        buf = torch.zeros(3 * rows, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[413.544527, "o", "\u001b[?2004h> "]
[413.544568, "o", "        S = buf[:rows]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544608, "o", "        Q = buf[rows:2 * rows]\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.544648, "o", "> "]
[413.544688, "o", "        C = buf[2 * rows:].view(torch.int32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544829, "o", "        _fused_kernel[(rows, CHUNKS)](x, y, S, Q, C, w, b, N, chunk, CHUNKS, 1.0 / N, eps, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544873, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544914, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[413.544954, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.544995, "o", "def check(fn):\r\n\u001b[?2004l\r\u001b[?2004h>     y = fn()\r\n\u001b[?2004l\r"]
[413.545036, "o", "\u001b[?2004h> "]
[413.545077, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.545116, "o", "    md = (y - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[413.545155, "o", "\u001b[?2004h> "]
[413.545197, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.545237, "o", ">     return ok, md\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.545278, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.545316, "o", "def timeit(fn, trials=20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.545356, "o", ">     for _ in range(3):\r\n\u001b[?2004l\r"]
[413.545398, "o", "\u001b[?2004h>         fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.545438, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[413.545475, "o", "\u001b[?2004h> "]
[413.545522, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.545563, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.545604, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.54565, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.545691, "o", "> "]
[413.545731, "o", "        s = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.54579, "o", "        e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[413.545833, "o", "\u001b[?2004h> "]
[413.545889, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[413.54593, "o", "\u001b[?2004h>         d.fill_(42)\r\n\u001b[?2004l\r"]
[413.545969, "o", "\u001b[?2004h>         del d\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.54601, "o", ">         s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.54605, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546089, "o", "        e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.54613, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.546171, "o", "> "]
[413.546212, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546262, "o", "    return float(np.mean(ts)), float(np.min(ts))\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.54631, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546494, "o", "configs_two = [(16, 16384, 8), (32, 16384, 8), (64, 16384, 8), (64, 8192, 8), (128, 8192, 8), (64, 32768, 16), (32, 32768, 16), (128, 4096, 4), (256, 4096, 4)]\r\n\u001b[?2004l\r"]
[413.546549, "o", "\u001b[?2004h> for CH, BL, WP in configs_two:\r\n\u001b[?2004l\r"]
[413.546592, "o", "\u001b[?2004h> "]
[413.546633, "o", "    fn = make_two(CH, BL, WP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546674, "o", "    ok, md = check(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546715, "o", "    m, mn = timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546819, "o", "    print(f\"two CH={CH} BLOCK={BL} warps={WP}: ok={ok} maxdiff={md:.2e} mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r"]
[413.546865, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.546993, "o", "configs_fused = [(32, 1024, 4), (32, 2048, 8), (64, 1024, 4), (64, 2048, 4), (16, 1024, 4), (128, 1024, 4), (64, 2048, 8)]\r\n\u001b[?2004l\r"]
[413.547036, "o", "\u001b[?2004h> "]
[413.547076, "o", "for CH, BL, WP in configs_fused:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547115, "o", "    fn = make_fused(CH, BL, WP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547155, "o", "    ok, md = check(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547194, "o", "    m, mn = timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[413.547235, "o", "> "]
[413.547318, "o", "    print(f\"fused CH={CH} BLOCK={BL} warps={WP}: ok={ok} maxdiff={md:.2e} mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r"]
[413.547364, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547405, "o", "# occupancy info for fused kernel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547535, "o", "for key, kern in _fused_kernel.device_caches[0][0].items() if hasattr(_fused_kernel, 'device_caches') else []:\r\n\u001b[?2004l\r"]
[413.547577, "o", "\u001b[?2004h>     pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547617, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547659, "o", "    caches = _fused_kernel.cache\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.5477, "o", "    for dev, entries in caches.items():\r\n\u001b[?2004l\r"]
[413.547742, "o", "\u001b[?2004h> "]
[413.547783, "o", "        for k, v in entries.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.547864, "o", "            print('fused compiled:', v.n_regs, 'regs', v.n_spills, 'spills')\r\n\u001b[?2004l\r"]
[413.547905, "o", "\u001b[?2004h> except Exception as ex:\r\n\u001b[?2004l\r"]
[413.547948, "o", "\u001b[?2004h> "]
[413.547988, "o", "    print('cache introspect fail', ex)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[413.548029, "o", "EOF\r\n\u001b[?2004l\r"]
[413.549364, "o", "\u001b[?2004hroot@modal:/workspace# "]
[413.549447, "o", "python3 -m py_compile /workspace/bench.py && echo OK\r\n\u001b[?2004l\r"]
