[874.564239, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[874.564261, "o", "> "]
[874.564287, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.564309, "o", "> "]
[874.564456, "o", "def _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[874.564479, "o", "\u001b[?2004h> "]
[874.564542, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[874.564565, "o", "\u001b[?2004h> "]
[874.564629, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r"]
[874.564651, "o", "\u001b[?2004h> "]
[874.564759, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[874.564782, "o", "\u001b[?2004h> "]
[874.564901, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[874.564926, "o", "\u001b[?2004h> "]
[874.565037, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[874.565059, "o", "\u001b[?2004h> "]
[874.565155, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[874.565187, "o", "\u001b[?2004h> "]
[874.565338, "o", "        t = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[874.565362, "o", "\u001b[?2004h> "]
[874.565407, "o", "        acc += t\r\n\u001b[?2004l\r"]
[874.565434, "o", "\u001b[?2004h> "]
[874.565486, "o", "        acc2 += t * t\r\n\u001b[?2004l\r"]
[874.565508, "o", "\u001b[?2004h> "]
[874.565635, "o", "    tl.atomic_add(S + row, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[874.565672, "o", "\u001b[?2004h> "]
[874.565799, "o", "    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[874.565828, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[874.56585, "o", "> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[874.565871, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[874.565896, "o", "\u001b[?2004h> "]
[874.566045, "o", "def _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr, LEV: tl.constexpr, SEV: tl.constexpr, CM: tl.constexpr):\r\n\u001b[?2004l\r"]
[874.56607, "o", "\u001b[?2004h> "]
[874.566093, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[874.566118, "o", "\u001b[?2004h> "]
[874.566149, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r"]
[874.566172, "o", "\u001b[?2004h> "]
[874.566217, "o", "    mean = tl.load(S + row) * inv_N\r\n\u001b[?2004l\r"]
[874.566248, "o", "\u001b[?2004h> "]
[874.566291, "o", "    var = tl.load(Q + row) * inv_N - mean * mean\r\n\u001b[?2004l\r"]
[874.566318, "o", "\u001b[?2004h> "]
[874.566353, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[874.566377, "o", "\u001b[?2004h> "]
[874.566427, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.566448, "o", "> "]
[874.566487, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[874.566509, "o", "\u001b[?2004h> "]
[874.566551, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[874.566573, "o", "\u001b[?2004h> "]
[874.566599, "o", "        if CM:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.566675, "o", "            t = tl.load(X + base + idx, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[874.566696, "o", "\u001b[?2004h> "]
[874.566718, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.56674, "o", "> "]
[874.566798, "o", "            t = tl.load(X + base + idx, eviction_policy=LEV)\r\n\u001b[?2004l\r"]
[874.56682, "o", "\u001b[?2004h> "]
[874.566852, "o", "        ww = tl.load(W + idx)\r\n\u001b[?2004l\r"]
[874.566875, "o", "\u001b[?2004h> "]
[874.566909, "o", "        bb = tl.load(B + idx)\r\n\u001b[?2004l\r"]
[874.56693, "o", "\u001b[?2004h> "]
[874.567019, "o", "        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb, eviction_policy=SEV)\r\n\u001b[?2004l\r"]
[874.567042, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[874.567071, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.567114, "o", "def f_copy(BLOCK=8192, warps=8):\r\n\u001b[?2004l\r"]
[874.567136, "o", "\u001b[?2004h> "]
[874.567168, "o", "    grid = (x.numel() // BLOCK,)\r\n\u001b[?2004l\r"]
[874.567194, "o", "\u001b[?2004h> "]
[874.567227, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.567254, "o", ">     def fn():\r\n\u001b[?2004l\r"]
[874.567276, "o", "\u001b[?2004h> "]
[874.567368, "o", "        _copy_kernel[grid](x, y, x.numel(), BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[874.567393, "o", "\u001b[?2004h> "]
[874.567421, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.567447, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.567471, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[874.567494, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.567527, "o", "def f_torch_copy():\r\n\u001b[?2004l\r"]
[874.567551, "o", "\u001b[?2004h> "]
[874.567582, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[874.567604, "o", "\u001b[?2004h> "]
[874.567629, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.567659, "o", "        y.copy_(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.567681, "o", "> "]
[874.567702, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.567723, "o", ">     return fn\r\n\u001b[?2004l\r"]
[874.567745, "o", "\u001b[?2004h> \r\n"]
[874.567768, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[874.567791, "o", "\u001b[?2004h> "]
[874.567827, "o", "def f_stats(CH, BLOCK, warps):\r\n\u001b[?2004l\r"]
[874.567849, "o", "\u001b[?2004h> "]
[874.567872, "o", "    chunk = N // CH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.567897, "o", "    def fn():\r\n\u001b[?2004l\r"]
[874.56792, "o", "\u001b[?2004h> "]
[874.567974, "o", "        s = torch.zeros((2, rows), device='cuda')\r\n\u001b[?2004l\r"]
[874.568005, "o", "\u001b[?2004h> "]
[874.56809, "o", "        _stats_kernel[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[874.568115, "o", "\u001b[?2004h> "]
[874.568136, "o", "        return s\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.56816, "o", "> "]
[874.568187, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[874.56821, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[874.568232, "o", "\u001b[?2004h> "]
[874.568298, "o", "def f_apply(CH, BLOCK, warps, LEV='', SEV='', CM=False):\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.568329, "o", ">     chunk = N // CH\r\n\u001b[?2004l\r"]
[874.568362, "o", "\u001b[?2004h> "]
[874.568384, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.568423, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[874.568446, "o", "\u001b[?2004h> "]
[874.568607, "o", "        _apply_kernel[(rows, CH)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, LEV=LEV, SEV=SEV, CM=CM, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.568641, "o", ">         return y\r\n\u001b[?2004l\r"]
[874.568664, "o", "\u001b[?2004h>     return fn\r\n\u001b[?2004l\r"]
[874.568687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[874.56871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[874.568742, "o", "\u001b[?2004h> "]
[874.568768, "o", "def timeit(fn, trials=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.568805, "o", "    for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.568829, "o", ">         fn()\r\n\u001b[?2004l\r"]
[874.568852, "o", "\u001b[?2004h> "]
[874.568893, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[874.568917, "o", "\u001b[?2004h> "]
[874.56894, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r"]
[874.568972, "o", "\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r"]
[874.568997, "o", "\u001b[?2004h> "]
[874.569031, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569056, "o", "> "]
[874.569082, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[874.569105, "o", "\u001b[?2004h> "]
[874.569165, "o", "        s = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569197, "o", "> "]
[874.569244, "o", "        e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[874.569269, "o", "\u001b[?2004h> "]
[874.569344, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[874.569377, "o", "\u001b[?2004h>         d.fill_(42)\r\n\u001b[?2004l\r"]
[874.569399, "o", "\u001b[?2004h> "]
[874.56942, "o", "        del d\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569442, "o", "> "]
[874.569467, "o", "        s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.569494, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.56952, "o", "> "]
[874.569544, "o", "        e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.569591, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[874.569615, "o", "\u001b[?2004h> "]
[874.569664, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569685, "o", "> "]
[874.569731, "o", "    return float(np.mean(ts)), float(np.min(ts))\r\n\u001b[?2004l\r"]
[874.569755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569778, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569802, "o", "> "]
[874.569824, "o", "m, mn = timeit(f_copy())\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569844, "o", "> "]
[874.569937, "o", "print(f\"triton copy: mean={m:.4f} min={mn:.4f} -> GB/s={2*x.numel()*4/mn/1e6:.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.569961, "o", "> "]
[874.57001, "o", "for BL, WP in [(4096, 4), (16384, 8), (8192, 4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.570039, "o", "> "]
[874.570062, "o", "    m, mn = timeit(f_copy(BL, WP))\r\n\u001b[?2004l\r"]
[874.570085, "o", "\u001b[?2004h> "]
[874.570207, "o", "    print(f\"triton copy BL={BL} W={WP}: mean={m:.4f} min={mn:.4f} GB/s={2*x.numel()*4/mn/1e6:.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.570233, "o", "> "]
[874.570256, "o", "m, mn = timeit(f_torch_copy())\r\n\u001b[?2004l\r"]
[874.570279, "o", "\u001b[?2004h> "]
[874.570369, "o", "print(f\"torch copy_: mean={m:.4f} min={mn:.4f} GB/s={2*x.numel()*4/mn/1e6:.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.570393, "o", "> "]
[874.570436, "o", "m, mn = timeit(lambda: torch.empty_like(x))\r\n\u001b[?2004l\r"]
[874.570462, "o", "\u001b[?2004h> "]
[874.570516, "o", "print(f\"empty_like only: mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.570541, "o", "> "]
[874.570606, "o", "for CH, BL, WP in [(64, 8192, 8), (128, 4096, 4), (128, 8192, 8)]:\r\n\u001b[?2004l\r"]
[874.570634, "o", "\u001b[?2004h> "]
[874.57067, "o", "    m, mn = timeit(f_stats(CH, BL, WP))\r\n\u001b[?2004l\r"]
[874.570694, "o", "\u001b[?2004h> "]
[874.570765, "o", "    print(f\"stats CH={CH} BL={BL} W={WP}: mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.570788, "o", "> "]
[874.570946, "o", "for LEV, SEV, CM in [('', '', False), ('evict_first', 'evict_first', False), ('', 'evict_first', False), ('', '', True), ('evict_first', '', False)]:\r\n\u001b[?2004l\r"]
[874.570971, "o", "\u001b[?2004h> "]
[874.571034, "o", "    m, mn = timeit(f_apply(128, 4096, 4, LEV, SEV, CM))\r\n\u001b[?2004l\r"]
[874.571062, "o", "\u001b[?2004h> "]
[874.571136, "o", "    print(f\"apply LEV={LEV} SEV={SEV} CM={CM}: mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r"]
[874.571159, "o", "\u001b[?2004h> "]
[874.571228, "o", "# best two-kernel combos again + with evictions in apply\r\n\u001b[?2004l\r"]
[874.571261, "o", "\u001b[?2004h> "]
[874.571298, "o", "def f_two(CH, BLOCK, warps, LEV='', SEV=''):\r\n\u001b[?2004l\r"]
[874.57132, "o", "\u001b[?2004h> "]
[874.571346, "o", "    chunk = N // CH\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.571368, "o", "> "]
[874.57139, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.57144, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.571464, "o", "> "]
[874.57151, "o", "        s = torch.zeros((2, rows), device='cuda')\r\n\u001b[?2004l\r"]
[874.571543, "o", "\u001b[?2004h> "]
[874.571629, "o", "        _stats_kernel[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r"]
[874.571662, "o", "\u001b[?2004h> "]
[874.571799, "o", "        _apply_kernel[(rows, CH)](x, y, s[0], s[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, LEV=LEV, SEV=SEV, CM=False, num_warps=warps)\r\n\u001b[?2004l\r"]
[874.571834, "o", "\u001b[?2004h>         return y\r\n\u001b[?2004l\r"]
[874.571856, "o", "\u001b[?2004h> "]
[874.571878, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.571903, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[874.572085, "o", "for CH, BL, WP, LEV, SEV in [(128, 4096, 4, '', ''), (128, 4096, 4, '', 'evict_first'), (64, 8192, 8, '', ''), (64, 8192, 8, 'evict_first', 'evict_first')]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.572122, "o", "> "]
[874.572149, "o", "    fn = f_two(CH, BL, WP, LEV, SEV)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.572176, "o", ">     y = fn()\r\n\u001b[?2004l\r"]
[874.572201, "o", "\u001b[?2004h> "]
[874.572235, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[874.572268, "o", "\u001b[?2004h> "]
[874.572315, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[874.572347, "o", "\u001b[?2004h> "]
[874.57237, "o", "    m, mn = timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.572392, "o", "> "]
[874.572496, "o", "    print(f\"two CH={CH} BL={BL} W={WP} LEV={LEV} SEV={SEV}: ok={ok} mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[874.572527, "o", "> EOF\r\n\u001b[?2004l\r"]
[874.573697, "o", "\u001b[?2004hroot@modal:/workspace# "]
[874.573758, "o", "python3 -m py_compile /workspace/bench2.py && echo OK\r\n\u001b[?2004l\r"]
[874.601633, "o", "OK\r\n\u001b[?2004hroot@modal:/workspace# "]
[875.560284, "i", "gpu push sb-LWVR0LH9LaHjlcVMDex3zK /workspace/bench2.py /workspace/bench2.py\n"]
[875.560511, "o", "gpu push sb-LWVR0LH9LaHjlcVMDex3zK /workspace/bench2.py /workspace/bench2.py\r\n\u001b[?2004l\r"]
