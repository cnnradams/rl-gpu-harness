[1078.774921, "o", "def f_apply(CH, BLOCK, warps, XEV='', WBEV='', YEV=''):\r\n\u001b[?2004l\r"]
[1078.774947, "o", "\u001b[?2004h> "]
[1078.774972, "o", "    chunk = N // CH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.774999, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.775051, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1078.775073, "o", "\u001b[?2004h> "]
[1078.775229, "o", "        _apply_v2[(rows, CH)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, XEV=XEV, WBEV=WBEV, YEV=YEV, num_warps=warps)\r\n\u001b[?2004l\r"]
[1078.775254, "o", "\u001b[?2004h> "]
[1078.775275, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.7753, "o", "    return fn\r\n\u001b[?2004l\r"]
[1078.775323, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.775349, "o", "> "]
[1078.775384, "o", "for CH, BL, WP, XEV, WBEV, YEV in [\r\n\u001b[?2004l\r"]
[1078.775408, "o", "\u001b[?2004h> "]
[1078.775441, "o", "    (128, 4096, 4, '', '', ''),\r\n\u001b[?2004l\r"]
[1078.775467, "o", "\u001b[?2004h> "]
[1078.775535, "o", "    (128, 4096, 4, 'evict_first', 'evict_last', 'evict_first'),\r\n\u001b[?2004l\r"]
[1078.775558, "o", "\u001b[?2004h> "]
[1078.775625, "o", "    (128, 4096, 4, 'evict_first', 'evict_last', ''),\r\n\u001b[?2004l\r"]
[1078.775652, "o", "\u001b[?2004h> "]
[1078.775722, "o", "    (64, 8192, 8, 'evict_first', 'evict_last', 'evict_first'),\r\n\u001b[?2004l\r"]
[1078.775749, "o", "\u001b[?2004h> "]
[1078.775787, "o", "    (64, 8192, 8, '', 'evict_last', ''),\r\n\u001b[?2004l\r"]
[1078.775811, "o", "\u001b[?2004h> "]
[1078.77588, "o", "    (256, 4096, 4, 'evict_first', 'evict_last', 'evict_first'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.775907, "o", "> "]
[1078.775968, "o", "    (64, 8192, 8, 'evict_first', 'evict_last', 'evict_last'),\r\n\u001b[?2004l\r"]
