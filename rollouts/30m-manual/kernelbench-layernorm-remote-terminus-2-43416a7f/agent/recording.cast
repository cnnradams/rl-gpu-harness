[1078.764489, "o", "rows = 16\r\n\u001b[?2004l\r\u001b[?2004h> eps = 1e-5\r\n\u001b[?2004l\r1, 64, 8192, "]
[1078.764532, "o", "\u001b[?2004h> "]
[1078.764616, "o", "w = torch.ones(N, device='cuda')\r\n\u001b[?2004l\r"]
[1078.764631, "o", "\u001b[?2004h> "]
[1078.764732, "o", "b = torch.zeros(N, device='cuda')\r\n\u001b[?2004l\r"]
[1078.764765, "o", "\u001b[?2004h> "]
[1078.764882, "o", "stats = torch.full((2, rows), 0.5, device='cuda')\r\n\u001b[?2004l\r"]
[1078.764915, "o", "\u001b[?2004h> "]
[1078.765129, "o", "ref = F.layer_norm(x, (64, 256, 256), w.view(64, 256, 256), b.view(64, 256, 256), eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.765146, "o", "> \r\n\u001b[?2004l\r\r\n"]
[1078.765222, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1078.765268, "o", "\u001b[?2004h> "]
[1078.76539, "o", "def _stats_u2(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1078.765416, "o", "\u001b[?2004h> "]
[1078.765499, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1078.765527, "o", "\u001b[?2004h> "]
[1078.765585, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1078.765607, "o", "\u001b[?2004h> "]
[1078.76573, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[1078.765755, "o", "\u001b[?2004h> "]
[1078.765865, "o", "    a1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.765893, "o", "\u001b[?2004h> "]
[1078.766003, "o", "    a2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.766032, "o", "\u001b[?2004h> "]
[1078.766134, "o", "    q1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.766164, "o", "\u001b[?2004h> "]
[1078.766266, "o", "    q2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.766294, "o", "\u001b[?2004h> "]
[1078.766362, "o", "    ar = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1078.766386, "o", "\u001b[?2004h> "]
[1078.766518, "o", "    for off in range(0, CHUNK, 2 * BLOCK):\r\n\u001b[?2004l\r"]
[1078.76655, "o", "\u001b[?2004h> "]
[1078.766649, "o", "        t1 = tl.load(X + base + off + ar)\r\n\u001b[?2004l\r"]
[1078.766675, "o", "\u001b[?2004h> "]
[1078.766818, "o", "        t2 = tl.load(X + base + off + BLOCK + ar)\r\n\u001b[?2004l\r"]
[1078.766849, "o", "\u001b[?2004h> "]
[1078.7669, "o", "        a1 += t1\r\n\u001b[?2004l\r"]
[1078.766923, "o", "\u001b[?2004h> "]
[1078.76698, "o", "        a2 += t2\r\n\u001b[?2004l\r,"]
[1078.767008, "o", "\u001b[?2004h> "]
[1078.767055, "o", "        q1 += t1 * t1\r\n\u001b[?2004l\r"]
[1078.767081, "o", "\u001b[?2004h> "]
[1078.767127, "o", "        q2 += t2 * t2\r\n\u001b[?2004l\r"]
[1078.76715, "o", "\u001b[?2004h> "]
[1078.76728, "o", "    tl.atomic_add(S + row, tl.sum(a1 + a2, axis=0))\r\n\u001b[?2004l\r"]
[1078.767309, "o", "\u001b[?2004h> "]
[1078.767439, "o", "    tl.atomic_add(Q + row, tl.sum(q1 + q2, axis=0))\r\n\u001b[?2004l\r"]
[1078.767464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n"]
[1078.767489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1078.767516, "o", "\u001b[?2004h> "]
[1078.767561, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1078.767589, "o", "\u001b[?2004h> "]
[1078.767739, "o", "def _stats_u4(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1078.767763, "o", "\u001b[?2004h> "]
[1078.767833, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r,"]
[1078.767855, "o", "\u001b[?2004h> "]
[1078.767926, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\rt"]
[1078.767951, "o", "\u001b[?2004h> "]
[1078.768068, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[1078.76809, "o", "\u001b[?2004h> "]
[1078.768207, "o", "    a1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.76823, "o", "\u001b[?2004h> "]
[1078.768333, "o", "    a2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.768359, "o", "\u001b[?2004h> "]
[1078.768457, "o", "    a3 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.768479, "o", "\u001b[?2004h> "]
[1078.768582, "o", "    a4 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\rs"]
[1078.76861, "o", "\u001b[?2004h> "]
[1078.768717, "o", "    q1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.768744, "o", "\u001b[?2004h> "]
[1078.768845, "o", "    q2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.768872, "o", "\u001b[?2004h> "]
[1078.768975, "o", "    q3 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.769001, "o", "\u001b[?2004h> "]
[1078.769107, "o", "    q4 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.769135, "o", "\u001b[?2004h> "]
[1078.769196, "o", "    ar = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1078.769217, "o", "\u001b[?2004h> "]
[1078.769316, "o", "    for off in range(0, CHUNK, 4 * BLOCK):\r\n\u001b[?2004l\r"]
[1078.769341, "o", "\u001b[?2004h> "]
[1078.769392, "o", "        t1 = tl.load(X + base + off + ar)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.769415, "o", "> "]
[1078.769465, "o", "        t2 = tl.load(X + base + off + BLOCK + ar)\r\n\u001b[?2004l\r"]
[1078.769491, "o", "\u001b[?2004h> "]
[1078.769548, "o", "        t3 = tl.load(X + base + off + 2 * BLOCK + ar)\r\n\u001b[?2004l\r"]
[1078.769573, "o", "\u001b[?2004h> "]
[1078.769625, "o", "        t4 = tl.load(X + base + off + 3 * BLOCK + ar)\r\n\u001b[?2004l\r"]
[1078.769661, "o", "\u001b[?2004h> "]
[1078.769692, "o", "        a1 += t1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.769717, "o", "        a2 += t2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.769752, "o", "        a3 += t3\r\n\u001b[?2004l\r"]
[1078.769775, "o", "\u001b[?2004h> "]
[1078.7698, "o", "        a4 += t4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.769838, "o", "        q1 += t1 * t1\r\n\u001b[?2004l\r"]
[1078.769865, "o", "\u001b[?2004h> "]
[1078.76989, "o", "        q2 += t2 * t2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.769929, "o", "        q3 += t3 * t3\r\n\u001b[?2004l\r"]
[1078.769953, "o", "\u001b[?2004h> "]
[1078.769979, "o", "        q4 += t4 * t4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.77006, "o", "    tl.atomic_add(S + row, tl.sum(a1 + a2 + a3 + a4, axis=0))\r\n\u001b[?2004l\r"]
[1078.770085, "o", "\u001b[?2004h> "]
[1078.77015, "o", "    tl.atomic_add(Q + row, tl.sum(q1 + q2 + q3 + q4, axis=0))\r\n\u001b[?2004l\r"]
[1078.770175, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1078.7702, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.770233, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.770254, "o", "> "]
[1078.770311, "o", "def _stats_u1(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1078.770337, "o", "\u001b[?2004h> "]
[1078.770361, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1078.770385, "o", "\u001b[?2004h> "]
[1078.770415, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1078.77044, "o", "\u001b[?2004h> "]
[1078.770486, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[1078.770512, "o", "\u001b[?2004h> "]
[1078.770559, "o", "    a1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.770585, "o", "\u001b[?2004h> "]
[1078.770626, "o", "    q1 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1078.770651, "o", "\u001b[?2004h> "]
[1078.770698, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[1078.770724, "o", "\u001b[?2004h> "]
[1078.770781, "o", "        t1 = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1078.770808, "o", "\u001b[?2004h> "]
[1078.770834, "o", "        a1 += t1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.770866, "o", "        q1 += t1 * t1\r\n\u001b[?2004l\r"]
[1078.770892, "o", "\u001b[?2004h> "]
[1078.770936, "o", "    tl.atomic_add(S + row, tl.sum(a1, axis=0))\r\n\u001b[?2004l\r"]
[1078.770962, "o", "\u001b[?2004h> "]
[1078.771008, "o", "    tl.atomic_add(Q + row, tl.sum(q1, axis=0))\r\n\u001b[?2004l\r"]
[1078.771034, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1078.771059, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1078.771084, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1078.771108, "o", "\u001b[?2004h> "]
[1078.771255, "o", "def _apply_v2(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr, XEV: tl.constexpr, WBEV: tl.constexpr, YEV: tl.constexpr):\r\n\u001b[?2004l\r"]
[1078.771287, "o", "\u001b[?2004h> "]
[1078.771313, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.77135, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1078.771376, "o", "\u001b[?2004h> "]
[1078.771412, "o", "    mean = tl.load(S + row) * inv_N\r\n\u001b[?2004l\r"]
[1078.771437, "o", "\u001b[?2004h> "]
[1078.771487, "o", "    var = tl.load(Q + row) * inv_N - mean * mean\r\n\u001b[?2004l\r"]
[1078.771513, "o", "\u001b[?2004h> "]
[1078.771548, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1078.771574, "o", "\u001b[?2004h> "]
[1078.771617, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[1078.771643, "o", "\u001b[?2004h> "]
[1078.771687, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.771716, "o", "> "]
[1078.77175, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1078.771774, "o", "\u001b[?2004h> "]
[1078.771837, "o", "        t = tl.load(X + base + idx, eviction_policy=XEV)\r\n\u001b[?2004l\r"]
[1078.771869, "o", "\u001b[?2004h> "]
[1078.771921, "o", "        ww = tl.load(W + idx, eviction_policy=WBEV)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.771996, "o", "        bb = tl.load(B + idx, eviction_policy=WBEV)\r\n\u001b[?2004l\r"]
[1078.772023, "o", "\u001b[?2004h> "]
[1078.772105, "o", "        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb, eviction_policy=YEV)\r\n\u001b[?2004l\r"]
[1078.772134, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.77216, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.77221, "o", "def timeit(fn, trials=20):\r\n\u001b[?2004l\r"]
[1078.772231, "o", "\u001b[?2004h> "]
[1078.772264, "o", "    for _ in range(3):\r\n\u001b[?2004l\r"]
[1078.772292, "o", "\u001b[?2004h>         fn()\r\n\u001b[?2004l\r"]
[1078.772319, "o", "\u001b[?2004h> "]
[1078.772354, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1078.772387, "o", "\u001b[?2004h> "]
[1078.772416, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.772448, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.772497, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.772551, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1078.772573, "o", "\u001b[?2004h> "]
[1078.772623, "o", "        s = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1078.772648, "o", "\u001b[?2004h> "]
[1078.772712, "o", "        e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.77281, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1078.772833, "o", "\u001b[?2004h> "]
[1078.772861, "o", "        d.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.772888, "o", "        del d\r\n\u001b[?2004l\r"]
[1078.772914, "o", "\u001b[?2004h> "]
[1078.772944, "o", "        s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.772968, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.773005, "o", "        e.record()\r\n\u001b[?2004l\r"]
[1078.773034, "o", "\u001b[?2004h> "]
[1078.773068, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.77313, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1078.773161, "o", "\u001b[?2004h> "]
[1078.773207, "o", "    return float(np.mean(ts)), float(np.min(ts))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.773232, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.773259, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.773315, "o", "def f_stats(kern, CH, BLOCK, warps, stages=1):\r\n\u001b[?2004l\r"]
[1078.773345, "o", "\u001b[?2004h> "]
[1078.773371, "o", "    chunk = N // CH\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.773396, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.773466, "o", "        s = torch.zeros((2, rows), device='cuda')\r\n\u001b[?2004l\r"]
[1078.773494, "o", "\u001b[?2004h> "]
[1078.773609, "o", "        kern[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.773654, "o", "        return s\r\n\u001b[?2004l\r\u001b[?2004h"]
[1078.773684, "o", ">     return fn\r\n\u001b[?2004l\r"]
[1078.773712, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1078.773735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1078.773758, "o", "\u001b[?2004h> "]
[1078.773792, "o", "print('== stats variants ==')\r\n\u001b[?2004l\r"]
[1078.773817, "o", "\u001b[?2004h> "]
[1078.773854, "o", "for name, kern, CH, BL, WP, ST in [\r\n\u001b[?2004l\r"]
[1078.773882, "o", "\u001b[?2004h> "]
[1078.77392, "o", "    ('u1', _stats_u1, 64, 8192, 8, 1),\r\n\u001b[?2004l\r"]
[1078.773947, "o", "\u001b[?2004h> "]
[1078.773981, "o", "    ('u2', _stats_u2, 64, 8192, 8, 1),\r\n\u001b[?2004l\r"]
[1078.774004, "o", "\u001b[?2004h> "]
[1078.774045, "o", "    ('u2', _stats_u2, 128, 4096, 4, 1),\r\n\u001b[?2004l\r"]
[1078.774068, "o", "\u001b[?2004h> "]
[1078.774106, "o", "    ('u2', _stats_u2, 128, 8192, 8, 1),\r\n\u001b[?2004l\r"]
[1078.77413, "o", "\u001b[?2004h> "]
[1078.77417, "o", "    ('u4', _stats_u4, 64, 8192, 8, 1),\r\n\u001b[?2004l\r"]
[1078.774192, "o", "\u001b[?2004h> "]
[1078.774232, "o", "    ('u4', _stats_u4, 128, 4096, 4, 1),\r\n\u001b[?2004l\r"]
[1078.774256, "o", "\u001b[?2004h> "]
[1078.774304, "o", "    ('u4', _stats_u4, 128, 8192, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1078.774365, "o", "    ('u4', _stats_u4, 256, 4096, 4, 1),\r\n\u001b[?2004l\r"]
[1078.774399, "o", "\u001b[?2004h> "]
[1078.774436, "o", "    ('u1', _stats_u1, 64, 8192, 8, 4),\r\n\u001b[?2004l\r"]
[1078.774467, "o", "\u001b[?2004h> "]
[1078.774508, "o", "    ('u1', _stats_u1, 128, 4096, 4, 4),\r\n\u001b[?2004l\r"]
