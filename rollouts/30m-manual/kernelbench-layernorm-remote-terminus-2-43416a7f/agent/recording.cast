[140.149725, "o", "rows), device=x.device, dtype=torch.float32)\r\n        S = stats[0]\r\n        Q = stats[1]\r\n        w = self.weight.detach().view(-1)\r\n        b = self.bias.de"]
[140.149764, "o", "tach().view(-1)\r\n        _stats_kernel[(rows, self.CHUNKS)](x, S, Q, N, chunk, BLOCK=self.BLOCK, num_warps=8)\r\n        _apply_kern"]
[140.149797, "o", "el[(rows, self.CHUNKS)](x, y, S, Q, w, b, N, chunk, 1.0 / N, self.eps, BLOCK=self.BLOCK, n"]
[140.149827, "o", "um_warps=8)\r\n   "]
[140.149857, "o", "     return y\r\nEOF\r\n"]
[140.149885, "o", "\u001b[?2004h"]
[140.149913, "o", "> "]
[140.149946, "o", "import torch\r\n\u001b[?2004l\r"]
[140.149979, "o", "\u001b[?2004h> "]
[140.150005, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.150031, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.15006, "o", "> "]
[140.15009, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.150121, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[140.150156, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[140.150193, "o", "\u001b[?2004h> "]
[140.150256, "o", "def _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.150305, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.15035, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.150383, "o", "> "]
[140.150419, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.150446, "o", "> "]
[140.150488, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[140.150519, "o", "\u001b[?2004h> "]
[140.150558, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[140.150587, "o", "\u001b[?2004h> "]
[140.150619, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.15065, "o", "> "]
[140.150705, "o", "        x = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.150739, "o", ">         acc += x\r\n\u001b[?2004l\r"]
[140.150761, "o", "\u001b[?2004h> "]
[140.150788, "o", "        acc2 += x * x\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.150814, "o", "> "]
[140.150856, "o", "    tl.atomic_add(S + row, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.150888, "o", "> "]
[140.150927, "o", "    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[140.150953, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[140.150976, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.151001, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.151027, "o", "> "]
[140.151117, "o", "def _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.151158, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[140.151191, "o", "\u001b[?2004h> "]
[140.151218, "o", "    ch = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.151246, "o", "> "]
[140.151273, "o", "    mean = tl.load(S + row) * inv_N\r\n\u001b[?2004l\r"]
[140.151307, "o", "\u001b[?2004h> "]
[140.151358, "o", "    var = tl.load(Q + row) * inv_N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.151384, "o", "> "]
[140.151417, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.151446, "o", "> "]
[140.151484, "o", "    base = row.to(tl.int64) * N + ch * CHUNK\r\n\u001b[?2004l\r"]
[140.151511, "o", "\u001b[?2004h> "]
[140.151548, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[140.151575, "o", "\u001b[?2004h> "]
[140.15161, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[140.151642, "o", "\u001b[?2004h> "]
[140.15167, "o", "        x = tl.load(X + base + idx)\r\n\u001b[?2004l\r"]
[140.151697, "o", "\u001b[?2004h> "]
[140.151724, "o", "        w = tl.load(W + idx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.15175, "o", "> "]
[140.151778, "o", "        b = tl.load(B + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.151857, "o", "        tl.store(Y + base + idx, (x - mean) * rstd * w + b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.151892, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.151926, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.151953, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.151981, "o", "> "]
[140.15202, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[140.152048, "o", "\u001b[?2004h> "]
[140.152075, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.15215, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[140.152191, "o", "\u001b[?2004h>         self.N = 1\r\n\u001b[?2004l\r"]
[140.152219, "o", "\u001b[?2004h> "]
[140.152261, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[140.152289, "o", "\u001b[?2004h> "]
[140.152317, "o", "            self.N *= s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.15235, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[140.152379, "o", "\u001b[?2004h> "]
[140.152448, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.152475, "o", "> "]
[140.152541, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.152569, "o", "> "]
[140.152601, "o", "        self.CHUNKS = 64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.152638, "o", "        self.BLOCK = 16384\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.152663, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.15274, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.15279, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.152826, "o", "        N = self.N\r\n\u001b[?2004l\r"]
[140.152857, "o", "\u001b[?2004h> "]
[140.152883, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r"]
[140.152912, "o", "\u001b[?2004h> "]
[140.152947, "o", "        chunk = N // self.CHUNKS\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.152974, "o", "> "]
[140.153, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.153026, "o", "> "]
[140.153102, "o", "        stats = torch.zeros((2, rows), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.153135, "o", ">         S = stats[0]\r\n\u001b[?2004l\r"]
[140.153169, "o", "\u001b[?2004h> "]
[140.153202, "o", "        Q = stats[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.153254, "o", "        w = self.weight.detach().view(-1)\r\n\u001b[?2004l\r"]
[140.153282, "o", "\u001b[?2004h> "]
[140.153316, "o", "        b = self.bias.detach().view(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.153341, "o", "> "]
[140.153438, "o", "        _stats_kernel[(rows, self.CHUNKS)](x, S, Q, N, chunk, BLOCK=self.BLOCK, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[140.15347, "o", "> "]
[140.153603, "o", "        _apply_kernel[(rows, self.CHUNKS)](x, y, S, Q, w, b, N, chunk, 1.0 / N, self.eps, BLOCK=self.BLOCK, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.153646, "o", "        return y\r\n\u001b[?2004l\r"]
[140.153672, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
