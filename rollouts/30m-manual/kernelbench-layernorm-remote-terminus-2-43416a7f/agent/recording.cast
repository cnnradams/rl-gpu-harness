[1078.77477, "o", "    print(f\"stats {name} CH={CH} BL={BL} W={WP} ST={ST}: mean={m:.4f} min={mn:.4f} GB/s={x.numel()*4/mn/1e6:.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
