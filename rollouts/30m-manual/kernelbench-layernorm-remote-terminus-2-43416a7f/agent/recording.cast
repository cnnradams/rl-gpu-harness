[874.561172, "i", "cat > /workspace/bench2.py << 'EOF'\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ntorch.cuda.init()\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64 * 256 * 256\nrows = 16\neps = 1e-5\nw = torch.ones(N, device='cuda')\nb = torch.zeros(N, device='cuda')\nstats = torch.rand((2, rows), device='cuda') * 0 + 0.5\nref = F.layer_norm(x, (64, 256, 256), w.view(64, 256, 256), b.view(64, 256, 256), eps)\n\n\n@triton.jit\ndef _copy_kernel(X, Y, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid.to(tl.int64) * BLOCK\n    idx = tl.arange(0, BLOCK)\n    t = tl.load(X + base + idx)\n    tl.store(Y + base + idx, t)\n\n\n@triton.jit\ndef _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        t = tl.load(X "]
[874.561331, "i", "+ base + off + tl.arange(0, BLOCK))\n        acc += t\n        acc2 += t * t\n    tl.atomic_add(S + row, tl.sum(acc, axis=0))\n    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\n\n\n@triton.jit\ndef _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr, LEV: tl.constexpr, SEV: tl.constexpr, CM: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    mean = tl.load(S + row) * inv_N\n    var = tl.load(Q + row) * inv_N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        if CM:\n            t = tl.load(X + base + idx, cache_modifier='.cs')\n        else:\n            t = tl.load(X + base + idx, eviction_policy=LEV)\n        ww = tl.load(W + idx)\n        bb = tl.load(B + idx)\n        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb, eviction_policy=SEV)\n\n\ndef f_copy(BLOCK=8192, warps=8):\n    grid = (x.numel() // BLOCK,)\n    y = torch.empty_like(x)\n    def fn():"]
[874.561376, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r+ base + off + tl.arange(0, BLOCK))\r\n        acc += t\r\n        acc2 += t * t\r\n    tl.atomic_add(S + row, tl.sum(acc, axis=0))\r\n    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\r\n\r\n\r\n@triton.jit\r\ndef _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps"]
[874.561407, "i", "\n        _copy_kernel[grid](x, y, x.numel(), BLOCK=BLOCK, num_warps=warps)\n        return y\n    return fn\n\n\ndef f_torch_copy():\n    y = torch.empty_like(x)\n    def fn():\n        y.copy_(x)\n        return y\n    return fn\n\n\ndef f_stats(CH, BLOCK, warps):\n    chunk = N // CH\n    def fn():\n        s = torch.zeros((2, rows), device='cuda')\n        _stats_kernel[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\n        return s\n    return fn\n\n\ndef f_apply(CH, BLOCK, warps, LEV='', SEV='', CM=False):\n    chunk = N // CH\n    def fn():\n        y = torch.empty_like(x)\n        _apply_kernel[(rows, CH)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, LEV=LEV, SEV=SEV, CM=CM, num_warps=warps)\n        return y\n    return fn\n\n\ndef timeit(fn, trials=20):\n    for _ in range(3):\n        fn()\n        torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True)\n        e = torch"]
[874.561472, "o", ", BLOCK: tl.constexpr, LEV: tl.constexpr, SEV: tl.constexpr, CM: tl.constexpr):\r\n    row = tl.program_id(0)\r\n    ch = tl.program_id(1)\r\n    mean = tl.load(S + row) * inv_N\r\n    var = tl.load(Q + row) * inv_N - mean * mean\r\n    rstd = 1.0 / tl.sqrt(var + eps)\r\n    base = row.to(tl.int64) * N + ch * CHUNK\r\n    for off in range(0, CHUNK, BLOCK):\r\n        idx = off + tl.arange(0, BLOCK)\r\n        if CM:\r\n            t = tl.load(X + base + idx, cache_modifier='.cs')\r\n        else:\r\n            t = tl.load(X + base + idx, eviction_policy=LEV)\r\n        ww = tl.load(W + idx)\r\n        bb = tl.load(B + idx)\r\n        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb, eviction_policy=SEV)\r\n\r\n\r\ndef f_copy(BLOCK=8192, warps=8):\r\n    grid = (x.numel() // BLOCK,)\r\n    y = torch.empty_like(x)\r\n    def fn():\r\n        _copy_kernel[grid](x, y, x.numel(), BLOCK=BLOCK, num_warps=warps)\r\n        return y\r\n    return fn\r\n\r\n\r\ndef f_torch_copy():\r\n    y = torch.empty_like(x)\r\n    def fn():\r\n        y.copy_(x)\r\n        return y\r\n    "]
[874.561499, "i", ".cuda.Event(enable_timing=True)\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n        d.fill_(42)\n        del d\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return float(np.mean(ts)), float(np.min(ts))\n\n\nm, mn = timeit(f_copy())\nprint(f\"triton copy: mean={m:.4f} min={mn:.4f} -> GB/s={2*x.numel()*4/mn/1e6:.0f}\")\nfor BL, WP in [(4096, 4), (16384, 8), (8192, 4)]:\n    m, mn = timeit(f_copy(BL, WP))\n    print(f\"triton copy BL={BL} W={WP}: mean={m:.4f} min={mn:.4f} GB/s={2*x.numel()*4/mn/1e6:.0f}\")\nm, mn = timeit(f_torch_copy())\nprint(f\"torch copy_: mean={m:.4f} min={mn:.4f} GB/s={2*x.numel()*4/mn/1e6:.0f}\")\nm, mn = timeit(lambda: torch.empty_like(x))\nprint(f\"empty_like only: mean={m:.4f} min={mn:.4f}\")\nfor CH, BL, WP in [(64, 8192, 8), (128, 4096, 4), (128, 8192, 8)]:\n    m, mn = timeit(f_stats(CH, BL, WP))\n    print(f\"stats CH={CH} BL={BL} W={WP}: mean={m:.4f} min={mn:.4f}\")\nfor LEV, SEV, CM in [('', '', "]
[874.56152, "o", "return fn\r\n\r\n\r\ndef f_stats(CH, BLOCK, warps):\r\n    chunk = N // CH\r\n    def fn():\r\n        s = torch.zeros((2, rows), device='cuda')\r\n        _stats_kernel[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\r\n        return s\r\n    return fn\r\n\r\n\r\ndef f_apply(CH, BLOCK, warps, LEV='', SEV='', CM=False):\r\n    chunk = N // CH\r\n    def fn():\r\n        y = torch.empty_like(x)\r\n        _apply_kernel[(rows, CH)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, LEV=LEV, SEV=SEV, CM=CM, num_warps=warps)\r\n        return y\r\n    return fn\r\n\r\n\r\ndef timeit(fn, trials=20):\r\n    for _ in range(3):\r\n        fn()\r\n        torch.cuda.synchronize()\r\n    torch.cuda.empty_cache()"]
[874.561547, "i", "False), ('evict_first', 'evict_first', False), ('', 'evict_first', False), ('', '', True), ('evict_first', '', False)]:\n    m, mn = timeit(f_apply(128, 4096, 4, LEV, SEV, CM))\n    print(f\"apply LEV={LEV} SEV={SEV} CM={CM}: mean={m:.4f} min={mn:.4f}\")\n# best two-kernel combos again + with evictions in apply\ndef f_two(CH, BLOCK, warps, LEV='', SEV=''):\n    chunk = N // CH\n    def fn():\n        y = torch.empty_like(x)\n        s = torch.zeros((2, rows), device='cuda')\n        _stats_kernel[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps)\n        _apply_kernel[(rows, CH)](x, y, s[0], s[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, LEV=LEV, SEV=SEV, CM=False, num_warps=warps)\n        return y\n    return fn\n\nfor CH, BL, WP, LEV, SEV in [(128, 4096, 4, '', ''), (128, 4096, 4, '', 'evict_first'), (64, 8192, 8, '', ''), (64, 8192, 8, 'evict_first', 'evict_first')]:\n    fn = f_two(CH, BL, WP, LEV, SEV)\n    y = fn()\n    torch.cuda.synchronize()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    "]
