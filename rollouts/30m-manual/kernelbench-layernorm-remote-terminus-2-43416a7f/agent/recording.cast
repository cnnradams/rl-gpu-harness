[140.149262, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        x = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc += x\n        acc2 += x * x\n    tl.atomic_add(S + row, tl.sum(acc, axis=0))\n    tl.atomic_add(Q + row, tl.sum(acc2, axis=0))\n\n\n@triton.jit\ndef _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    ch = tl.program_id(1)\n    mean = tl.load(S + row) * inv_N\n    var = tl.load(Q + row) * inv_N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + ch * CHUNK\n    for off in range(0, CHUNK, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        x = tl.load"]
[140.149423, "i", "(X + base + idx)\n        w = tl.load(W + idx)\n        b = tl.load(B + idx)\n        tl.store(Y + base + idx, (x - mean) * rstd * w + b)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.N = 1\n        for s in self.normalized_shape:\n            self.N *= s\n        self.eps = 1e-5\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n        self.CHUNKS = 64\n        self.BLOCK = 16384\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        x = x.contiguous()\n        N = self.N\n        rows = x.numel() // N\n        chunk = N // self.CHUNKS\n        y = torch.empty_like(x)\n        stats = torch.zeros((2, rows), device=x.device, dtype=torch.float32)\n        S = stats[0]\n        Q = stats[1]\n        w = self.weight.detach().view(-1)\n        b = self.bias.detach().view(-1)\n        _stats_kernel[(rows, se"]
