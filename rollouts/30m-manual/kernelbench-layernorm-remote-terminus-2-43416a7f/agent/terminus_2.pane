[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _stats_kernel(X, S, Q, N, CHUNK, BLOCK: tl.constexpr):
[?2004l[?2004h>     row = tl.program_id(0)
[?2004l[?2004h>     ch = tl.program_id(1)
[?2004l[?2004h>     base = row.to(tl.int64) * N + ch * CHUNK
[?2004l[?2004h>     a1 = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     a2 = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     q1 = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     q2 = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     ar = tl.arange(0, BLOCK)
[?2004l[?2004h>     for off in range(0, CHUNK, 2 * BLOCK):
[?2004l[?2004h>         t1 = tl.load(X + base + off + ar)
[?2004l[?2004h>         t2 = tl.load(X + base + off + BLOCK + ar)
[?2004l[?2004h>         a1 += t1
[?2004l[?2004h>         a2 += t2
[?2004l[?2004h>         q1 += t1 * t1
[?2004l[?2004h>         q2 += t2 * t2
[?2004l[?2004h>     tl.atomic_add(S + row, tl.sum(a1 + a2, axis=0))
[?2004l[?2004h>     tl.atomic_add(Q + row, tl.sum(q1 + q2, axis=0))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr):
[?2004l[?2004h>     row = tl.program_id(0)
[?2004l[?2004h>     ch = tl.program_id(1)
[?2004l[?2004h>     mean = tl.load(S + row) * inv_N
[?2004l[?2004h>     var = tl.load(Q + row) * inv_N - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     base = row.to(tl.int64) * N + ch * CHUNK
[?2004l[?2004h>     for off in range(0, CHUNK, BLOCK):
[?2004l[?2004h>         idx = off + tl.arange(0, BLOCK)
[?2004l[?2004h>         t = tl.load(X + base + idx)
[?2004l[?2004h>         ww = tl.load(W + idx, eviction_policy="evict_last")
[?2004l[?2004h>         bb = tl.load(B + idx, eviction_policy="evict_last")
[?2004l[?2004h>         tl.store(Y + base + idx, (t - mean) * rstd * ww + bb)
