class ModelNew(nn.Module):
    def __init__(self, normalized_shape: tuple):
        super().__init__()
        self.normalized_shape = tuple(normalized_shape)
        self.N = 1
        for s in self.normalized_shape:
            self.N *= s
        self.eps = 1e-5
        self.weight = nn.Parameter(torch.ones(self.normalized_shape))
        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))
        self.CHUNKS = 64
        self.BLOCK = 16384

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        x = x.contiguous()
        N = self.N
        rows = x.numel() // N
        chunk = N // self.CHUNKS
        y = torch.empty_like(x)
        stats = torch.zeros((2, rows), device=x.device, dtype=torch.float32)
        S = stats[0]
        Q = stats[1]
        w = self.weight.detach().view(-1)
        b = self.bias.detach().view(-1)
        _stats_kernel[(rows, self.CHUNKS)](x, S, Q, N, chunk, BLOCK=self.BLOCK, num_warps=8)
        _apply_kernel[(rows, self.CHUNKS)](x, y, S, Q, w, b, N, chunk, 1.0 / N, self.eps, BLOCK=self.BLOCK, num_warps=8)
        return y
