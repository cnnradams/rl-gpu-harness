        q1 += t1 * t1
        q2 += t2 * t2
        q3 += t3 * t3
        q4 += t4 * t4
    tl.atomic_add(S + row, tl.sum(a1 + a2 + a3 + a4, axis=0))
    tl.atomic_add(Q + row, tl.sum(q1 + q2 + q3 + q4, axis=0))


