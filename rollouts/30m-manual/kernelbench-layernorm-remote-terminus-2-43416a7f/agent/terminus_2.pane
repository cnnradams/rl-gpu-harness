@triton.jit
def _apply_kernel(X, Y, S, Q, W, B, N, CHUNK, inv_N, eps, BLOCK: tl.constexpr, LEV: tl.constexpr, SEV: tl.constexpr, CM: tl.constexpr):
    row = tl.program_id(0)
    ch = tl.program_id(1)
    mean = tl.load(S + row) * inv_N
    var = tl.load(Q + row) * inv_N - mean * mean
    rstd = 1.0 / tl.sqrt(var + eps)
    base = row.to(tl.int64) * N + ch * CHUNK
    for off in range(0, CHUNK, BLOCK):
        idx = off + tl.arange(0, BLOCK)
        if CM:
            t = tl.load(X + base + idx, cache_modifier='.cs')
        else:
            t = tl.load(X + base + idx, eviction_policy=LEV)
        ww = tl.load(W + idx)
        bb = tl.load(B + idx)
        tl.store(Y + base + idx, (t - mean) * rstd * ww + bb, eviction_policy=SEV)


def f_copy(BLOCK=8192, warps=8):
    grid = (x.numel() // BLOCK,)
    y = torch.empty_like(x)
    def fn():
        _copy_kernel[grid](x, y, x.numel(), BLOCK=BLOCK, num_warps=warps)
        return y
    return fn


def f_torch_copy():
    y = torch.empty_like(x)
    def fn():
        y.copy_(x)
        return y
    return fn


def f_stats(CH, BLOCK, warps):
    chunk = N // CH
    def fn():
        s = torch.zeros((2, rows), device='cuda')
        _stats_kernel[(rows, CH)](x, s[0], s[1], N, chunk, BLOCK=BLOCK, num_warps=warps)
        return s
    return fn


def f_apply(CH, BLOCK, warps, LEV='', SEV='', CM=False):
    chunk = N // CH
    def fn():
        y = torch.empty_like(x)
        _apply_kernel[(rows, CH)](x, y, stats[0], stats[1], w, b, N, chunk, 1.0 / N, eps, BLOCK=BLOCK, LEV=LEV, SEV=SEV, CM=CM, num_warps=warps)
        return y
    return fn


def timeit(fn, trials=20):
    for _ in range(3):
        fn()
        torch.cuda.synchronize()
    torch.cuda.empty_cache()
    ts = []
    for _ in range(trials):
        torch.cuda.synchronize()
        s = torch.cuda.Event(enable_timing=True)
        e = torch.cuda.Event(enable_timing=True)
        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')
        d.fill_(42)
        del d
        s.record()
        fn()
        e.record()
        torch.cuda.synchronize()
        ts.append(s.elapsed_time(e))
    return float(np.mean(ts)), float(np.min(ts))


m, mn = timeit(f_copy())
print(f"triton copy: mean={m:.4f} min={mn:.4f} -> GB/s={2*x.numel()*4/mn/1e6:.0f}")
for BL, WP in [(4096, 4), (16384, 8), (8192, 4)]:
    m, mn = timeit(f_copy(BL, WP))
    print(f"triton copy BL={BL} W={WP}: mean={m:.4f} min={mn:.4f} GB/s={2*x.numel()*4/mn/1e6:.0f}")
m, mn = timeit(f_torch_copy())
print(f"torch copy_: mean={m:.4f} min={mn:.4f} GB/s={2*x.numel()*4/mn/1e6:.0f}")
m, mn = timeit(lambda: torch.empty_like(x))
print(f"empty_like only: mean={m:.4f} min={mn:.4f}")
for CH, BL, WP in [(64, 8192, 8), (128, 4096, 4), (128, 8192, 8)]:
    m, mn = timeit(f_stats(CH, BL, WP))
    print(f"stats CH={CH} BL={BL} W={WP}: mean={m:.4f} min={mn:.4f}")
