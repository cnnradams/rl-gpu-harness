[664.376321, "i", "cat > /workspace/dbg3.py << 'EOF'\nimport torch, ctypes\nsys_path_hack = None\nfrom torch.utils.cpp_extension import load_inline\nsrc = open('/workspace/solution.py').read()\ncuda_src = src.split('_cuda_src = r\"\"\"')[1].split('\"\"\"')[0]\ncuda_src = cuda_src.replace('torch::Tensor ln_forward(', 'torch::Tensor ln_forward_hidden(')\ndbg_fn = r\"\"\"\nstd::vector<torch::Tensor> ln_dbg(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps) {\n  auto y = torch::empty_like(x);\n  long D = weight.numel();\n  long B = x.numel() / D;\n  int nb1 = 128, nb2 = 64;\n  auto partials = torch::empty({B * nb1 * 2}, x.options());\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  dim3 g1(nb1, (unsigned)B), b1(32, 4);\n  row_partials<<<g1, b1, 0, stream>>>(x.data_ptr<float>(), partials.data_ptr<float>(), D, nb1);\n  cudaError_t err1 = cudaGetLastError();\n  printf(\"k1 launch err: %s\\n\", cudaGetErrorString(err1));\n  cudaError_t serr = cudaDeviceSynchronize();\n  printf(\"k1 sync err: %s\\n\", cudaGetErrorString(serr));\n  dim3 g2"]
[664.376371, "i", "(nb2, (unsigned)B), b2(32, 4);\n  ln_apply<<<g2, b2, 0, stream>>>(x.data_ptr<float>(), weight.data_ptr<float>(), bias.data_ptr<float>(),\n                                  y.data_ptr<float>(), partials.data_ptr<float>(), D, nb1, (float)eps);\n  cudaError_t err2 = cudaGetLastError();\n  printf(\"k2 launch err: %s\\n\", cudaGetErrorString(err2));\n  return {y, partials};\n}\n\"\"\"\ncuda_src += dbg_fn\ncpp = \"std::vector<torch::Tensor> ln_dbg(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps);\"\next = load_inline(name='ln_dbg2', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln_dbg'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nw = torch.ones(64,256,256, device='cuda')\nb = torch.zeros(64,256,256, device='cuda')\ny, p = ext.ln_dbg(x, w, b, 1e-5)\ntorch.cuda.synchronize()\nB, n1 = 16, 128\nps = p.view(B, 2, n1)\nprint('ps sample', ps[0,0,:8])\nprint('ps abs max', ps.abs().max().item())\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/db"]
[664.376384, "i", "g3.py /workspace/dbg3.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 300 -- python3 /workspace/dbg3.py\n"]
