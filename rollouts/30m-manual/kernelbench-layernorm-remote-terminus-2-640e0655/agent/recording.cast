[1483.779831, "i", ") {\n      float4 v = xr[i];\n      float4 wv = w[i];\n      float4 bv = b[i];\n      float4 o;\n      o.x = (v.x - mean) * rstd * wv.x + bv.x;\n      o.y = (v.y - mean) * rstd * wv.y + bv.y;\n      o.z = (v.z - mean) * rstd * wv.z + bv.z;\n      o.w = (v.w - mean) * rstd * wv.w + bv.w;\n      yr[i] = o;\n    }\n  } else {\n    for (int i = n4 - 1 - (blockIdx.x * blockDim.x + threadIdx.x); i >= 0; i -= nblocks * blockDim.x) {\n      float4 v = xr[i];\n      float4 wv = w[i];\n      float4 bv = b[i];\n      float4 o;\n      o.x = (v.x - mean) * rstd * wv.x + bv.x;\n      o.y = (v.y - mean) * rstd * wv.y + bv.y;\n      o.z = (v.z - mean) * rstd * wv.z + bv.z;\n      o.w = (v.w - mean) * rstd * wv.w + bv.w;\n      yr[i] = o;\n    }\n  }\n}\n\ntorch::Tensor ln4(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long rev) {\n  auto y = torch::empty_like(x);\n  long D = w.numel();\n  long B = x.numel() / D;\n  int n4 = (int)(D / 4);\n  auto partials = torch::empty({B * nb1 * 2}, x.options());\n  cudaStream_t stream"]
[1483.779837, "i", " = c10::cuda::getCurrentCUDAStream();\n  dim3 g1((unsigned)nb1, (unsigned)B), b1(256);\n  k1<<<g1, b1, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, (int)rev);\n  dim3 g2((unsigned)nb2, (unsigned)B), b2(256);\n  k2<<<g2, b2, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()),\n      reinterpret_cast<const float4*>(w.data_ptr<float>()), reinterpret_cast<const float4*>(b.data_ptr<float>()),\n      reinterpret_cast<float4*>(y.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, (float)eps, (int)rev);\n  return y;\n}\n\"\"\"\ncpp = \"torch::Tensor ln4(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long rev);\"\next = load_inline(name='ln_rev1', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln4'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nw = torch.ones(64,256,256, device='cuda')\nb = torch.zeros(64,256,256, device='cuda')\nyr = t"]
[1483.779871, "i", "orch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nfor rev in [0,1]:\n    for nb1, nb2 in [(128,64),(256,64),(512,128),(1024,128)]:\n        y = ext.ln4(x,w,b,1e-5,nb1,nb2,rev)\n        ok = torch.allclose(y, yr, atol=1e-4, rtol=1e-4)\n        t = bench(lambda: ext.ln4(x,w,b,1e-5,nb1,nb2,rev))\n        print(f'rev={rev} nb1={nb1} nb2={nb2}: {t:.4f}ms ok={ok}')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof7.py /workspace/prof7.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace"]
