[808.225166, "i", "cat > /workspace/prof.py << 'EOF'\nimport sys, torch, itertools\nsys.path.insert(0, '/opt/task')\nfrom torch.utils.cpp_extension import load_inline\nsrc = open('/workspace/solution.py').read()\ncuda_src = src.split('_cuda_src = r\"\"\"')[1].split('\"\"\"')[0]\ncuda_src = cuda_src.replace('torch::Tensor ln_forward(', 'torch::Tensor ln_forward_hidden(')\nprobe = r\"\"\"\ntorch::Tensor ln_cfg(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps,\n                     long nb1, long nb2, long wy1, long wy2) {\n  auto y = torch::empty_like(x);\n  long D = weight.numel();\n  long B = x.numel() / D;\n  auto partials = torch::empty({B * nb1 * 2}, x.options());\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  dim3 g1((unsigned)nb1, (unsigned)B), b1(32, (unsigned)wy1);\n  row_partials<<<g1, b1, 0, stream>>>(x.data_ptr<float>(), partials.data_ptr<float>(), D, (int)nb1);\n  dim3 g2((unsigned)nb2, (unsigned)B), b2(32, (unsigned)wy2);\n  ln_apply<<<g2, b2, 0, stream>>>(x.data_ptr<float>(), weight.data_ptr<float>(), bia"]
[808.225225, "i", "s.data_ptr<float>(),\n                                  y.data_ptr<float>(), partials.data_ptr<float>(), D, (int)nb1, (float)eps);\n  return y;\n}\n\"\"\"\ncuda_src += probe\ncpp = \"torch::Tensor ln_cfg(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps, long nb1, long nb2, long wy1, long wy2);\"\next = load_inline(name='ln_probe', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln_cfg'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nw = torch.ones(64,256,256, device='cuda')\nb = torch.zeros(64,256,256, device='cuda')\nyr = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(0)\n    return d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n      "]
[808.225238, "i", "  dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nresults=[]\nfor nb1, wy1 in [(64,4),(128,4),(128,8),(256,4),(256,8),(512,4),(512,8),(1024,8)]:\n    for nb2, wy2 in [(32,4),(64,4),(64,8),(128,4),(128,8),(256,8)]:\n        y = ext.ln_cfg(x,w,b,1e-5,nb1,nb2,wy1,wy2)\n        ok = torch.allclose(y, yr, atol=1e-4, rtol=1e-4)\n        t = bench(lambda: ext.ln_cfg(x,w,b,1e-5,nb1,nb2,wy1,wy2))\n        results.append((t, nb1, nb2, wy1, wy2, ok))\nresults.sort()\nfor r in results[:12]:\n    print(f't={r[0]:.4f}ms nb1={r[1]} nb2={r[2]} wy1={r[3]} wy2={r[4]} ok={r[5]}')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof.py /workspace/prof.py\n"]
