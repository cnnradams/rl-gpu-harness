[733.594544, "i", "python3 - << 'EOF'\nsrc = open('/workspace/solution.py').read()\nold = \"\"\"    if (lane == 0) {\\n      partials[(long)row * nblocks + blockIdx.x] = a;\\n      partials[(long)row * nblocks + nblocks + blockIdx.x] = b;\\n    }\"\"\"\nnew = \"\"\"    if (lane == 0) {\\n      partials[(long)row * 2 * nblocks + blockIdx.x] = a;\\n      partials[(long)row * 2 * nblocks + nblocks + blockIdx.x] = b;\\n    }\"\"\"\nassert old in src, 'k1 pattern'\nsrc = src.replace(old, new)\nold2 = \"\"\"    s += partials[(long)row * nblocks + i];\\n    q += partials[(long)row * nblocks + nblocks + i];\"\"\"\nnew2 = \"\"\"    s += partials[(long)row * 2 * nblocks + i];\\n    q += partials[(long)row * 2 * nblocks + nblocks + i];\"\"\"\nassert old2 in src, 'k2 pattern'\nsrc = src.replace(old2, new2)\nsrc = src.replace('fused_ln_v2', 'fused_ln_v3')\nopen('/workspace/solution.py','w').write(src)\nprint('patched')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/solution.py /workspace/solution.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 300 -- python3 /workspace/bench.py"]
