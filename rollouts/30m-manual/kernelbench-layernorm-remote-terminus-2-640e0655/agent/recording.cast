[1330.90753, "o", "  // block covers contiguous chunk: blockIdx.x of NBX blocks\r\n\u001b[?2004l\r="]
[1330.907564, "o", "\u001b[?2004h> "]
[1330.907709, "o", "  // chunk size = NTHREADS*NREG float4 = 2048 float4\r\n\u001b[?2004l\r"]
[1330.907734, "o", "\u001b[?2004h> "]
[1330.907918, "o", "  const int base = blockIdx.x * NTHREADS * NREG + threadIdx.x;\r\n\u001b[?2004l\r"]
[1330.907943, "o", "\u001b[?2004h> "]
[1330.908007, "o", "  float s = 0.f, q = 0.f;\r\n\u001b[?2004l\r"]
[1330.908031, "o", "\u001b[?2004h> "]
[1330.908076, "o", "  #pragma unroll\r\n\u001b[?2004l\r"]
[1330.9081, "o", "\u001b[?2004h> "]
[1330.9082, "o", "  for (int r = 0; r < NREG; ++r) {\r\n\u001b[?2004l\r"]
[1330.908225, "o", "\u001b[?2004h> "]
[1330.908327, "o", "    int i = base + r * NTHREADS;\r\n\u001b[?2004l\r"]
[1330.908353, "o", "\u001b[?2004h> "]
[1330.908545, "o", "    vals[r] = (i < n4) ? xr[i] : make_float4(0.f,0.f,0.f,0.f);\r\n\u001b[?2004l\r"]
[1330.90857, "o", "\u001b[?2004h> "]
[1330.908726, "o", "    s += vals[r].x + vals[r].y + vals[r].z + vals[r].w;\r\n\u001b[?2004l\r"]
[1330.908751, "o", "\u001b[?2004h> "]
[1330.909072, "o", "    q += vals[r].x*vals[r].x + vals[r].y*vals[r].y + vals[r].z*vals[r].z + vals[r].w*vals[r].w;\r\n\u001b[?2004l\r"]
[1330.909098, "o", "\u001b[?2004h> "]
[1330.909125, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.909241, "o", "  s = warp_sum(s); q = warp_sum(q);\r\n\u001b[?2004l\r"]
[1330.909267, "o", "\u001b[?2004h> "]
[1330.909355, "o", "  __shared__ float sh[2][32];\r\n\u001b[?2004l\r"]
[1330.909382, "o", "\u001b[?2004h> "]
[1330.909556, "o", "  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\r\n\u001b[?2004l\r"]
[1330.909581, "o", "\u001b[?2004h> "]
[1330.90966, "o", "  int nw = NTHREADS >> 5;\r\n\u001b[?2004l\r"]
[1330.909686, "o", "\u001b[?2004h> "]
[1330.90985, "o", "  if (lane == 0) { sh[0][warp] = s; sh[1][warp] = q; }\r\n\u001b[?2004l\r"]
[1330.909865, "o", "\u001b[?2004h> "]
[1330.90994, "o", "  __syncthreads();\r\n\u001b[?2004l\r"]
[1330.909966, "o", "\u001b[?2004h> "]
[1330.909988, "o", "  if (warp == 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1330.91002, "o", "> "]
[1330.910076, "o", "    float a = lane < nw ? sh[0][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1330.910106, "o", "\u001b[?2004h> "]
[1330.910169, "o", "    float bb = lane < nw ? sh[1][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1330.910194, "o", "\u001b[?2004h> "]
[1330.910253, "o", "    a = warp_sum(a); bb = warp_sum(bb);\r\n\u001b[?2004l\r"]
[1330.910278, "o", "\u001b[?2004h> "]
[1330.910309, "o", "    if (lane == 0) {\r\n\u001b[?2004l\r"]
[1330.910334, "o", "\u001b[?2004h> "]
[1330.910416, "o", "      partials[(long)row * 2 * NBX + blockIdx.x] = a;\r\n\u001b[?2004l\r"]
[1330.91044, "o", "\u001b[?2004h> "]
[1330.910539, "o", "      partials[(long)row * 2 * NBX + NBX + blockIdx.x] = bb;\r\n\u001b[?2004l\r"]
[1330.910564, "o", "\u001b[?2004h> "]
[1330.910588, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.910614, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.910638, "o", "  grid.sync();\r\n\u001b[?2004l\r"]
[1330.910665, "o", "\u001b[?2004h> "]
[1330.910761, "o", "  // reduce partials for this row: all blocks compute (cheap)\r\n\u001b[?2004l\r"]
[1330.910785, "o", "\u001b[?2004h> "]
[1330.910826, "o", "  float ss = 0.f, qq = 0.f;\r\n\u001b[?2004l\r"]
[1330.910851, "o", "\u001b[?2004h> "]
[1330.910933, "o", "  for (int i = threadIdx.x; i < NBX; i += NTHREADS) {\r\n\u001b[?2004l\r"]
[1330.910956, "o", "\u001b[?2004h> "]
[1330.911026, "o", "    ss += partials[(long)row * 2 * NBX + i];\r\n\u001b[?2004l\r"]
[1330.911051, "o", "\u001b[?2004h> "]
[1330.911128, "o", "    qq += partials[(long)row * 2 * NBX + NBX + i];\r\n\u001b[?2004l\r"]
[1330.911156, "o", "\u001b[?2004h> "]
[1330.911185, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.911241, "o", "  ss = warp_sum(ss); qq = warp_sum(qq);\r\n\u001b[?2004l\r"]
[1330.911266, "o", "\u001b[?2004h> "]
[1330.911312, "o", "  __shared__ float sh2[2][32];\r\n\u001b[?2004l\r"]
[1330.911336, "o", "\u001b[?2004h> "]
[1330.911391, "o", "  __shared__ float sh_mean, sh_rstd;\r\n\u001b[?2004l\r"]
[1330.911416, "o", "\u001b[?2004h> "]
[1330.91151, "o", "  if (lane == 0) { sh2[0][warp] = ss; sh2[1][warp] = qq; }\r\n\u001b[?2004l\r"]
[1330.911535, "o", "\u001b[?2004h> "]
[1330.911567, "o", "  __syncthreads();\r\n\u001b[?2004l\r"]
[1330.911593, "o", "\u001b[?2004h> "]
[1330.911618, "o", "  if (warp == 0) {\r\n\u001b[?2004l\r"]
[1330.911642, "o", "\u001b[?2004h> "]
[1330.911714, "o", "    float a = lane < nw ? sh2[0][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1330.911738, "o", "\u001b[?2004h> "]
[1330.911809, "o", "    float bb = lane < nw ? sh2[1][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1330.911836, "o", "\u001b[?2004h> "]
[1330.911895, "o", "    a = warp_sum(a); bb = warp_sum(bb);\r\n\u001b[?2004l\r"]
[1330.91192, "o", "\u001b[?2004h> "]
[1330.91195, "o", "    if (lane == 0) {\r\n\u001b[?2004l\r"]
[1330.911975, "o", "\u001b[?2004h> "]
[1330.912035, "o", "      float mean = a / (float)(n4 * 4);\r\n\u001b[?2004l\r"]
[1330.91206, "o", "\u001b[?2004h> "]
[1330.912141, "o", "      float var = bb / (float)(n4 * 4) - mean * mean;\r\n\u001b[?2004l\r"]
[1330.912167, "o", "\u001b[?2004h> "]
[1330.912199, "o", "      sh_mean = mean;\r\n\u001b[?2004l\r"]
[1330.912222, "o", "\u001b[?2004h> "]
[1330.912275, "o", "      sh_rstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r"]
[1330.912291, "o", "\u001b[?2004h> "]
[1330.91232, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.912346, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.912385, "o", "  __syncthreads();\r\n\u001b[?2004l\r"]
[1330.91241, "o", "\u001b[?2004h> "]
[1330.91248, "o", "  const float mean = sh_mean, rstd = sh_rstd;\r\n\u001b[?2004l\r"]
[1330.912497, "o", "\u001b[?2004h> "]
[1330.912537, "o", "  #pragma unroll\r\n\u001b[?2004l\r"]
[1330.91256, "o", "\u001b[?2004h> "]
[1330.912614, "o", "  for (int r = 0; r < NREG; ++r) {\r\n\u001b[?2004l\r"]
[1330.91264, "o", "\u001b[?2004h> "]
[1330.912688, "o", "    int i = base + r * NTHREADS;\r\n\u001b[?2004l\r"]
[1330.912714, "o", "\u001b[?2004h> "]
[1330.912738, "o", "    if (i < n4) {\r\n\u001b[?2004l\r"]
[1330.912763, "o", "\u001b[?2004h> "]
[1330.9128, "o", "      float4 wv = w[i];\r\n\u001b[?2004l\r"]
[1330.912825, "o", "\u001b[?2004h> "]
[1330.912859, "o", "      float4 bv = b[i];\r\n\u001b[?2004l\r"]
[1330.912884, "o", "\u001b[?2004h> "]
[1330.912909, "o", "      float4 o;\r\n\u001b[?2004l\r"]
[1330.912933, "o", "\u001b[?2004h> "]
[1330.913015, "o", "      o.x = (vals[r].x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1330.913039, "o", "\u001b[?2004h> "]
[1330.91312, "o", "      o.y = (vals[r].y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1330.913145, "o", "\u001b[?2004h> "]
[1330.913225, "o", "      o.z = (vals[r].z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1330.913251, "o", "\u001b[?2004h> "]
[1330.913332, "o", "      o.w = (vals[r].w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1330.913357, "o", "\u001b[?2004h> "]
[1330.913384, "o", "      yr[i] = o;\r\n\u001b[?2004l\r"]
[1330.9134, "o", "\u001b[?2004h> "]
[1330.913433, "o", "    }\r\n\u001b[?2004l\r"]
[1330.913458, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.913481, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1330.91352, "o", "\u001b[?2004h> "]
[1330.913647, "o", "torch::Tensor ln3(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps) {\r\n\u001b[?2004l\r"]
[1330.913672, "o", "\u001b[?2004h> "]
[1330.913723, "o", "  auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[1330.913748, "o", "\u001b[?2004h> "]
[1330.913779, "o", "  long D = w.numel();\r\n\u001b[?2004l\r"]
[1330.913804, "o", "\u001b[?2004h> "]
[1330.913841, "o", "  long B = x.numel() / D;\r\n\u001b[?2004l\r"]
[1330.913877, "o", "\u001b[?2004h> "]
[1330.913908, "o", "  int n4 = (int)(D / 4);\r\n\u001b[?2004l\r"]
[1330.91393, "o", "\u001b[?2004h> "]
[1330.914032, "o", "  auto partials = torch::empty({B * NBX * 2}, x.options());\r\n\u001b[?2004l\r"]
[1330.914057, "o", "\u001b[?2004h> "]
[1330.914126, "o", "  auto stats = torch::empty({1}, x.options());\r\n\u001b[?2004l\r"]
[1330.914151, "o", "\u001b[?2004h> "]
[1330.914242, "o", "  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1330.914267, "o", "\u001b[?2004h> "]
[1330.91433, "o", "  dim3 g(NBX, (unsigned)B), bt(NTHREADS);\r\n\u001b[?2004l\r"]
[1330.914355, "o", "\u001b[?2004h> "]
[1330.914546, "o", "  void* args[] = {(void*)&x, (void*)&w, (void*)&b, (void*)&y, (void*)&partials, (void*)&stats, (void*)&n4, (void*)&eps};\r\n\u001b[?2004l\r"]
[1330.914562, "o", "\u001b[?2004h> "]
[1330.914694, "o", "  const float4* xp = reinterpret_cast<const float4*>(x.data_ptr<float>());\r\n\u001b[?2004l\r\u001b[?2004h"]
[1330.914721, "o", "> "]
[1330.914829, "o", "  const float4* wp = reinterpret_cast<const float4*>(w.data_ptr<float>());\r\n\u001b[?2004l\r"]
[1330.914857, "o", "\u001b[?2004h> "]
[1330.914969, "o", "  const float4* bp = reinterpret_cast<const float4*>(b.data_ptr<float>());\r\n\u001b[?2004l\r"]
[1330.914998, "o", "\u001b[?2004h> "]
[1330.91509, "o", "  float4* yp = reinterpret_cast<float4*>(y.data_ptr<float>());\r\n\u001b[?2004l\r"]
[1330.915122, "o", "\u001b[?2004h> "]
[1330.915177, "o", "  float* pp = partials.data_ptr<float>();\r\n\u001b[?2004l\r"]
[1330.915204, "o", "\u001b[?2004h> "]
[1330.915262, "o", "  float* sp = stats.data_ptr<float>();\r\n\u001b[?2004l\r"]
[1330.915287, "o", "\u001b[?2004h> "]
[1330.915326, "o", "  float epsf = (float)eps;\r\n\u001b[?2004l\r"]
[1330.915351, "o", "\u001b[?2004h> "]
[1330.915545, "o", "  void* kargs[] = {(void*)&xp, (void*)&wp, (void*)&bp, (void*)&yp, (void*)&pp, (void*)&sp, (void*)&n4, (void*)&epsf};\r\n\u001b[?2004l\r"]
[1330.915561, "o", "\u001b[?2004h> "]
[1330.915721, "o", "  cudaError_t err = cudaLaunchCooperativeKernel((void*)ln_coop, g, bt, kargs, 0, stream.stream());\r\n\u001b[?2004l\r"]
[1330.915751, "o", "\u001b[?2004h> "]
[1330.915838, "o", "  TORCH_CHECK(err == cudaSuccess, cudaGetErrorString(err));\r\n\u001b[?2004l\r"]
[1330.915863, "o", "\u001b[?2004h> "]
[1330.915889, "o", "  return y;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1330.915922, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.915947, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.91609, "o", "cpp = \"torch::Tensor ln3(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps);\"\r\n\u001b[?2004l\r"]
[1330.916116, "o", "\u001b[?2004h> "]
[1330.916387, "o", "ext = load_inline(name='ln_coop1', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln3'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1330.916413, "o", "> "]
[1330.916474, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1330.9165, "o", "\u001b[?2004h> "]
[1330.916569, "o", "w = torch.ones(64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1330.916595, "o", "\u001b[?2004h> "]
[1330.916659, "o", "b = torch.zeros(64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1330.916685, "o", "\u001b[?2004h> "]
[1330.916783, "o", "yr = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\r\n\u001b[?2004l\r"]
[1330.916808, "o", "\u001b[?2004h> "]
[1330.916847, "o", "y = ext.ln3(x, w, b, 1e-5)\r\n\u001b[?2004l\r"]
[1330.916873, "o", "\u001b[?2004h> "]
[1330.916909, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1330.916934, "o", "\u001b[?2004h> "]
[1330.91707, "o", "print('ok', torch.allclose(y, yr, atol=1e-4, rtol=1e-4), (y-yr).abs().max().item())\r\n\u001b[?2004l\r"]
[1330.917096, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1330.917121, "o", "\u001b[?2004h> "]
[1330.917145, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.917303, "o", "    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\r\n\u001b[?2004l\r"]
[1330.917328, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1330.917353, "o", "> "]
[1330.917379, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[1330.917403, "o", "\u001b[?2004h> "]
[1330.917488, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1330.917527, "o", "\u001b[?2004h> "]
[1330.917552, "o", "    ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1330.917587, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1330.917612, "o", "\u001b[?2004h> "]
[1330.917662, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1330.917684, "o", "\u001b[?2004h> "]
[1330.917821, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1330.917836, "o", "\u001b[?2004h> "]
[1330.917883, "o", "        dummy=clear_l2()\r\n\u001b[?2004l\r"]
[1330.917908, "o", "\u001b[?2004h> "]
[1330.918015, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1330.91804, "o", "\u001b[?2004h> "]
[1330.918093, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1330.918118, "o", "\u001b[?2004h> "]
[1330.918144, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1330.918169, "o", "> "]
[1330.918199, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1330.918224, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1330.918249, "o", "\u001b[?2004h> "]
[1330.918307, "o", "t = bench(lambda: ext.ln3(x, w, b, 1e-5))\r\n\u001b[?2004l\r"]
[1330.918333, "o", "\u001b[?2004h> "]
[1330.91839, "o", "print(f'coop single-pass: {t:.4f}ms')\r\n\u001b[?2004l\r"]
[1330.918421, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1330.919514, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1330.919786, "o", "gpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof6.py /workspace/prof6.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof6.py\r\n\u001b[?2004l\r"]
[1331.98439, "o", "{\r\n  \"bytes\": 5790,\r\n  \"sha256\": \"be13dcc1b16e9de464e50abac352b2c96a026965e214d672dc9cc85a16323fdd\"\r\n}\r\n"]
