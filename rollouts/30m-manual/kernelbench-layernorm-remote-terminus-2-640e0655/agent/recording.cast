[887.401103, "i", "cat > /workspace/prof2.py << 'EOF'\nimport torch\nfrom torch.utils.cpp_extension import load_inline\ncuda_src = r\"\"\"\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n\n__global__ void copy_kernel(const float* __restrict__ x, const float* __restrict__ w,\n                            const float* __restrict__ b, float* __restrict__ y, long n4, long nw4) {\n  long i0 = (long)blockIdx.x * blockDim.x + threadIdx.x;\n  long stride = (long)gridDim.x * blockDim.x;\n  for (long i = i0; i < n4; i += stride) {\n    const float4* xr = reinterpret_cast<const float4*>(x);\n    float4 v = xr[i];\n    reinterpret_cast<float4*>(y)[i] = v;\n  }\n  for (long i = i0; i < nw4; i += stride) {\n    const float4* wr = reinterpret_cast<const float4*>(w);\n    const float4* br = reinterpret_cast<const float4*>(b);\n    float4 wv = wr[i];\n    float4 bv = br[i];\n    reinterpret_cast<float4*>(y)[i % (n4 > 0 ? n4 : 1)] = make_float4(wv.x+bv.x, wv.y+bv.y, wv.z+bv.z, wv.w+bv.w);\n  }\n}\n\nvoid run_copy(torch::Tensor x, t"]
[887.401153, "i", "orch::Tensor w, torch::Tensor b, torch::Tensor y, long blocks, long threads) {\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  long n4 = x.numel() / 4;\n  long nw4 = w.numel() / 4;\n  copy_kernel<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(x.data_ptr<float>(), w.data_ptr<float>(), b.data_ptr<float>(), y.data_ptr<float>(), n4, nw4);\n}\n\"\"\"\ncpp = \"void run_copy(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor y, long blocks, long threads);\"\next = load_inline(name='ln_copy', cpp_sources=cpp, cuda_sources=cuda_src, functions=['run_copy'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nw = torch.ones(64,256,256, device='cuda')\nb = torch.zeros(64,256,256, device='cuda')\ny = torch.empty_like(x)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(0)\n    return d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range("]
[887.401255, "i", "n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n# 64+16+16 MB read, 64MB write => 160MB (but writes to y twice for w/b part, ignore)\nfor blocks, threads in [(1024,128),(1024,256),(2048,256),(4096,256),(2048,512),(8192,256),(132*8,256),(132*16,256)]:\n    t = bench(lambda: ext.run_copy(x,w,b,y,blocks,threads))\n    gbps = 160e6 / (t*1e-3) / 1e9\n    print(f'copy blocks={blocks} threads={threads}: {t:.4f}ms -> {gbps:.0f} GB/s')\n\n# also bench a single empty kernel launch + event overhead\nimport time\nt0=bench(lambda: None)\nprint('noop python lambda event time:', t0)\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof2.py /workspace/prof2.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof2.py\n"]
