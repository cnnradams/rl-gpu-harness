[1330.902717, "i", "this_grid();\n  const int row = blockIdx.y;\n  const float4* xr = x + (long)row * n4;\n  float4* yr = y + (long)row * n4;\n  float4 vals[NREG];\n  // block covers contiguous chunk: blockIdx.x of NBX blocks\n  // chunk size = NTHREADS*NREG float4 = 2048 float4\n  const int base = blockIdx.x * NTHREADS * NREG + threadIdx.x;\n  float s = 0.f, q = 0.f;\n  #pragma unroll\n  for (int r = 0; r < NREG; ++r) {\n    int i = base + r * NTHREADS;\n    vals[r] = (i < n4) ? xr[i] : make_float4(0.f,0.f,0.f,0.f);\n    s += vals[r].x + vals[r].y + vals[r].z + vals[r].w;\n    q += vals[r].x*vals[r].x + vals[r].y*vals[r].y + vals[r].z*vals[r].z + vals[r].w*vals[r].w;\n  }\n  s = warp_sum(s); q = warp_sum(q);\n  __shared__ float sh[2][32];\n  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\n  int nw = NTHREADS >> 5;\n  if (lane == 0) { sh[0][warp] = s; sh[1][warp] = q; }\n  __syncthreads();\n  if (warp == 0) {\n    float a = lane < nw ? sh[0][lane] : 0.f;\n    float bb = lane < nw ? sh[1][lane] : 0.f;\n    a = warp_sum(a); bb = warp_sum(bb);\n    i"]
[1330.902727, "i", "f (lane == 0) {\n      partials[(long)row * 2 * NBX + blockIdx.x] = a;\n      partials[(long)row * 2 * NBX + NBX + blockIdx.x] = bb;\n    }\n  }\n  grid.sync();\n  // reduce partials for this row: all blocks compute (cheap)\n  float ss = 0.f, qq = 0.f;\n  for (int i = threadIdx.x; i < NBX; i += NTHREADS) {\n    ss += partials[(long)row * 2 * NBX + i];\n    qq += partials[(long)row * 2 * NBX + NBX + i];\n  }\n  ss = warp_sum(ss); qq = warp_sum(qq);\n  __shared__ float sh2[2][32];\n  __shared__ float sh_mean, sh_rstd;\n  if (lane == 0) { sh2[0][warp] = ss; sh2[1][warp] = qq; }\n  __syncthreads();\n  if (warp == 0) {\n    float a = lane < nw ? sh2[0][lane] : 0.f;\n    float bb = lane < nw ? sh2[1][lane] : 0.f;\n    a = warp_sum(a); bb = warp_sum(bb);\n    if (lane == 0) {\n      float mean = a / (float)(n4 * 4);\n      float var = bb / (float)(n4 * 4) - mean * mean;\n      sh_mean = mean;\n      sh_rstd = rsqrtf(var + eps);\n    }\n  }\n  __syncthreads();\n  const float mean = sh_mean, rstd = sh_rstd;\n  #pragma unroll\n  for (int r = 0; r < "]
[1330.902752, "i", "NREG; ++r) {\n    int i = base + r * NTHREADS;\n    if (i < n4) {\n      float4 wv = w[i];\n      float4 bv = b[i];\n      float4 o;\n      o.x = (vals[r].x - mean) * rstd * wv.x + bv.x;\n      o.y = (vals[r].y - mean) * rstd * wv.y + bv.y;\n      o.z = (vals[r].z - mean) * rstd * wv.z + bv.z;\n      o.w = (vals[r].w - mean) * rstd * wv.w + bv.w;\n      yr[i] = o;\n    }\n  }\n}\n\ntorch::Tensor ln3(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps) {\n  auto y = torch::empty_like(x);\n  long D = w.numel();\n  long B = x.numel() / D;\n  int n4 = (int)(D / 4);\n  auto partials = torch::empty({B * NBX * 2}, x.options());\n  auto stats = torch::empty({1}, x.options());\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  dim3 g(NBX, (unsigned)B), bt(NTHREADS);\n  void* args[] = {(void*)&x, (void*)&w, (void*)&b, (void*)&y, (void*)&partials, (void*)&stats, (void*)&n4, (void*)&eps};\n  const float4* xp = reinterpret_cast<const float4*>(x.data_ptr<float>());\n  const float4* wp = reinterpret_cast<const float4*>(w.data_p"]
[1330.902894, "i", "tr<float>());\n  const float4* bp = reinterpret_cast<const float4*>(b.data_ptr<float>());\n  float4* yp = reinterpret_cast<float4*>(y.data_ptr<float>());\n  float* pp = partials.data_ptr<float>();\n  float* sp = stats.data_ptr<float>();\n  float epsf = (float)eps;\n  void* kargs[] = {(void*)&xp, (void*)&wp, (void*)&bp, (void*)&yp, (void*)&pp, (void*)&sp, (void*)&n4, (void*)&epsf};\n  cudaError_t err = cudaLaunchCooperativeKernel((void*)ln_coop, g, bt, kargs, 0, stream.stream());\n  TORCH_CHECK(err == cudaSuccess, cudaGetErrorString(err));\n  return y;\n}\n\"\"\"\ncpp = \"torch::Tensor ln3(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps);\"\next = load_inline(name='ln_coop1', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln3'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nw = torch.ones(64,256,256, device='cuda')\nb = torch.zeros(64,256,256, device='cuda')\nyr = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\ny = ext.ln3(x, w,"]
