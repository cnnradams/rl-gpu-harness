[296.105024, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load_inline\n\n_cuda_src = r\"\"\"\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n\n#define FULL_MASK 0xffffffffu\n\n__inline__ __device__ float warp_sum(float v) {\n  v += __shfl_xor_sync(FULL_MASK, v, 16);\n  v += __shfl_xor_sync(FULL_MASK, v, 8);\n  v += __shfl_xor_sync(FULL_MASK, v, 4);\n  v += __shfl_xor_sync(FULL_MASK, v, 2);\n  v += __shfl_xor_sync(FULL_MASK, v, 1);\n  return v;\n}\n\n__global__ void row_partials(const float* __restrict__ x, float* __restrict__ partials,\n                             long D, int nblocks) {\n  const int row = blockIdx.y;\n  const float4* xr = reinterpret_cast<const float4*>(x + (long)row * D);\n  const long n4 = D >> 2;\n  float s = 0.f, sq = 0.f;\n  for (long i = (long)blockIdx.x * blockDim.y + threadIdx.y; i < n4; i += (long)gridDim.x * blockDim.y) {\n    float4 v = xr[i];\n    s += v.x + v.y + v.z + v.w;\n    sq += v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w;\n  }\n  s = warp"]
[296.10583, "i", "_sum(s); sq = warp_sum(sq);\n  __shared__ float sh_s[32];\n  __shared__ float sh_q[32];\n  const int lane = threadIdx.x, warp = threadIdx.y;\n  const int nw = blockDim.y;\n  if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\n  __syncthreads();\n  if (warp == 0) {\n    float a = (lane < nw) ? sh_s[lane] : 0.f;\n    float b = (lane < nw) ? sh_q[lane] : 0.f;\n    a = warp_sum(a); b = warp_sum(b);\n    if (lane == 0) {\n      partials[(long)row * nblocks + blockIdx.x] = a;\n      partials[(long)row * nblocks + nblocks + blockIdx.x] = b;\n    }\n  }\n}\n\n__global__ void ln_apply(const float* __restrict__ x, const float* __restrict__ w,\n                         const float* __restrict__ b, float* __restrict__ y,\n                         const float* __restrict__ partials, long D, int nblocks,\n                         float eps) {\n  const int row = blockIdx.y;\n  float s = 0.f, q = 0.f;\n  for (int i = threadIdx.x + threadIdx.y * blockDim.x; i < nblocks; i += blockDim.x * blockDim.y) {\n    s += partials[(long)row * nblocks + i];\n   "]
[296.10585, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> from torch.utils.cpp_extension import load_inline\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> _cuda_src = r\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> #include <torch/extension.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.106038, "i", " q += partials[(long)row * nblocks + nblocks + i];\n  }\n  s = warp_sum(s); q = warp_sum(q);\n  __shared__ float sh_s[32];\n  __shared__ float sh_q[32];\n  __shared__ float sh_mean, sh_rstd;\n  const int lane = threadIdx.x, warp = threadIdx.y;\n  const int nw = blockDim.y;\n  if (lane == 0) { sh_s[warp] = s; sh_q[warp] = q; }\n  __syncthreads();\n  if (warp == 0) {\n    float a = (lane < nw) ? sh_s[lane] : 0.f;\n    float bb = (lane < nw) ? sh_q[lane] : 0.f;\n    a = warp_sum(a); bb = warp_sum(bb);\n    if (lane == 0) {\n      float mean = a / (float)D;\n      float var = bb / (float)D - mean * mean;\n      sh_mean = mean;\n      sh_rstd = rsqrtf(var + eps);\n    }\n  }\n  __syncthreads();\n  const float mean = sh_mean, rstd = sh_rstd;\n  const long n4 = D >> 2;\n  const float4* xr = reinterpret_cast<const float4*>(x + (long)row * D);\n  float4* yr = reinterpret_cast<float4*>(y + (long)row * D);\n  const float4* wr = reinterpret_cast<const float4*>(w);\n  const float4* br = reinterpret_cast<const float4*>(b);\n  for (long i = (long)bloc"]
[296.106302, "o", "#include <cuda_runtime.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #define FULL_MASK 0xffffffffu\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> __inline__ __device__ float warp_sum(float v) {\r\n\u001b[?2004l\r\u001b[?2004h>   v += __shfl_xor_sync(FULL_MASK, v, 16);\r\n\u001b[?2004l\r\u001b[?2004h>   v += __shfl_xor_sync(FULL_MASK, v, 8);\r\n\u001b[?2004l\r\u001b[?2004h>   v += __shfl_xor_sync(FULL_MASK, v, 4);\r\n\u001b[?2004l\r\u001b[?2004h>   v += __shfl_xor_sync(FULL_MASK, v, 2);\r\n\u001b[?2004l\r\u001b[?2004h>   v += __shfl_xor_sync(FULL_MASK, v, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.106411, "i", "kIdx.x * blockDim.y + threadIdx.y; i < n4; i += (long)gridDim.x * blockDim.y) {\n    float4 v = xr[i];\n    float4 wv = wr[i];\n    float4 bv = br[i];\n    float4 o;\n    o.x = (v.x - mean) * rstd * wv.x + bv.x;\n    o.y = (v.y - mean) * rstd * wv.y + bv.y;\n    o.z = (v.z - mean) * rstd * wv.z + bv.z;\n    o.w = (v.w - mean) * rstd * wv.w + bv.w;\n    yr[i] = o;\n  }\n}\n\ntorch::Tensor ln_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps) {\n  TORCH_CHECK(x.is_cuda() && x.dtype() == torch::kFloat32);\n  TORCH_CHECK(x.is_contiguous() && weight.is_contiguous() && bias.is_contiguous());\n  auto y = torch::empty_like(x);\n  long D = weight.numel();\n  TORCH_CHECK((D & 3) == 0);\n  long B = x.numel() / D;\n  int nb1 = 128, nb2 = 64;\n  auto partials = torch::empty({B * nb1 * 2}, x.options());\n  cudaStream_t stream = at::cuda::getCurrentCUDAStream();\n  dim3 g1(nb1, (unsigned)B), b1(32, 4);\n  row_partials<<<g1, b1, 0, stream>>>(x.data_ptr<float>(), partials.data_ptr<float>(), D, nb1);\n  dim3 g2(nb2, (unsign"]
[296.106432, "o", "  return v;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.106445, "i", "ed)B), b2(32, 4);\n  ln_apply<<<g2, b2, 0, stream>>>(x.data_ptr<float>(), weight.data_ptr<float>(), bias.data_ptr<float>(),\n                                  y.data_ptr<float>(), partials.data_ptr<float>(), D, nb1, (float)eps);\n  return y;\n}\n\"\"\"\n\n_cpp_src = \"torch::Tensor ln_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps);\"\n\n_ext = None\n_ext_err = None\ntry:\n    _ext = load_inline(\n        name=\"fused_ln_v1\",\n        cpp_sources=_cpp_src,\n        cuda_sources=_cuda_src,\n        functions=[\"ln_forward\"],\n        extra_cuda_cflags=[\"-O3\", \"--use_fast_math\", \"-std=c++17\"],\n        extra_cflags=[\"-O3\"],\n        verbose=False,\n    )\nexcept Exception as e:  # pragma: no cover\n    _ext_err = e\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))"]
[296.106452, "i", "\n        self.eps = 1e-5\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if _ext is not None and x.is_cuda and x.dtype == torch.float32 and x.is_contiguous():\n            return _ext.ln_forward(x, self.weight, self.bias, self.eps)\n        return torch.nn.functional.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\nEOF\nls -la /workspace/\n"]
