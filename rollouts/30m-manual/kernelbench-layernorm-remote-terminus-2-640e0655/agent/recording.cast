[1138.518285, "i", "cat > /workspace/prof4.py << 'EOF'\nimport torch\nfrom torch.utils.cpp_extension import load_inline\ncuda_src = r\"\"\"\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n\n__global__ void pure_copy(const float4* __restrict__ x, float4* __restrict__ y, int n4) {\n  int i = blockIdx.x * blockDim.x + threadIdx.x;\n  int stride = gridDim.x * blockDim.x;\n  for (; i < n4; i += stride) y[i] = x[i];\n}\n\n__global__ void pure_copy4(const float4* __restrict__ x, float4* __restrict__ y, int n4) {\n  // each thread copies 4 float4s, contiguous blocks like torch elementwise\n  int base = (blockIdx.x * blockDim.x + threadIdx.x) * 4;\n  if (base + 3 < n4) {\n    float4 a = x[base], b = x[base+1], c = x[base+2], d = x[base+3];\n    y[base] = a; y[base+1] = b; y[base+2] = c; y[base+3] = d;\n  } else {\n    for (int i = base; i < n4; ++i) y[i] = x[i];\n  }\n}\n\nvoid run_pure(torch::Tensor x, torch::Tensor y, long blocks, long threads, long mode) {\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  in"]
[1138.518332, "i", "t n4 = (int)(x.numel() / 4);\n  if (mode == 0)\n    pure_copy<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), reinterpret_cast<float4*>(y.data_ptr<float>()), n4);\n  else\n    pure_copy4<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), reinterpret_cast<float4*>(y.data_ptr<float>()), n4);\n}\n\"\"\"\ncpp = \"void run_pure(torch::Tensor x, torch::Tensor y, long blocks, long threads, long mode);\"\next = load_inline(name='ln_pure', cpp_sources=cpp, cuda_sources=cuda_src, functions=['run_pure'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\ny = torch.empty_like(x)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(ena"]
[1138.51835, "i", "ble_timing=True); e=torch.cuda.Event(enable_timing=True)\n        dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nfor mode in [0,1]:\n    for blocks,threads in [(1024,256),(2048,256),(4096,256),(8192,256),(16384,256),(4096,512),(32768,128)]:\n        t = bench(lambda: ext.run_pure(x,y,blocks,threads,mode))\n        print(f'mode={mode} blocks={blocks} threads={threads}: {t:.4f}ms -> {2*0.0671/(t*1e-3):.0f} GB/s')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof4.py /workspace/prof4.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof4.py\n"]
