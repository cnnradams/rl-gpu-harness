[1483.785979, "o", "      partials[(long)row * 2 * nb + blockIdx.x] = a;\r\n\u001b[?2004l\r"]
[1483.786011, "o", "\u001b[?2004h> "]
[1483.786137, "o", "      partials[(long)row * 2 * nb + nb + blockIdx.x] = b;\r\n\u001b[?2004l\r"]
[1483.786175, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1483.786208, "o", "\u001b[?2004h> "]
[1483.786241, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[1483.786273, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.7863, "o", "> "]
[1483.786491, "o", "__global__ void k2(const float4* __restrict__ x, const float4* __restrict__ w,\r\n\u001b[?2004l\r"]
[1483.786518, "o", "\u001b[?2004h> "]
[1483.786689, "o", "                   const float4* __restrict__ b, float4* __restrict__ y,\r\n\u001b[?2004l\r"]
[1483.786721, "o", "\u001b[?2004h> "]
[1483.786925, "o", "                   const float* __restrict__ partials, int n4, int nb, float eps, int rev) {\r\n\u001b[?2004l\r"]
[1483.786958, "o", "\u001b[?2004h> "]
[1483.787033, "o", "  const int row = blockIdx.y;\r\n\u001b[?2004l\r"]
[1483.787059, "o", "\u001b[?2004h> "]
[1483.787121, "o", "  float s = 0.f, q = 0.f;\r\n\u001b[?2004l\r"]
[1483.787148, "o", "\u001b[?2004h> "]
[1483.787251, "o", "  for (int i = threadIdx.x; i < nb; i += blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.787283, "o", "> "]
[1483.787333, "o", "    s += partials[(long)row * 2 * nb + i];\r\n\u001b[?2004l\r"]
[1483.787363, "o", "\u001b[?2004h> "]
[1483.787429, "o", "    q += partials[(long)row * 2 * nb + nb + i];\r\n\u001b[?2004l\r"]
[1483.787462, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.78753, "o", "  s = warp_sum(s); q = warp_sum(q);\r\n\u001b[?2004l\r"]
[1483.787555, "o", "\u001b[?2004h> "]
[1483.787596, "o", "  __shared__ float sh[2][32];\r\n\u001b[?2004l\r"]
[1483.787623, "o", "\u001b[?2004h> "]
[1483.787674, "o", "  __shared__ float sh_mean, sh_rstd;\r\n\u001b[?2004l\r"]
[1483.7877, "o", "\u001b[?2004h> "]
[1483.787783, "o", "  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\r\n\u001b[?2004l\r"]
[1483.787815, "o", "\u001b[?2004h> "]
[1483.78785, "o", "  int nw = blockDim.x >> 5;\r\n\u001b[?2004l\r"]
[1483.787877, "o", "\u001b[?2004h> "]
[1483.787961, "o", "  if (lane == 0) { sh[0][warp] = s; sh[1][warp] = q; }\r\n\u001b[?2004l\r"]
[1483.787992, "o", "\u001b[?2004h> "]
[1483.788014, "o", "  __syncthreads();\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.78804, "o", "> "]
[1483.788063, "o", "  if (warp == 0) {\r\n\u001b[?2004l\r"]
[1483.788089, "o", "\u001b[?2004h> "]
[1483.788155, "o", "    float a = lane < nw ? sh[0][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1483.788192, "o", "\u001b[?2004h> "]
[1483.788256, "o", "    float bb = lane < nw ? sh[1][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1483.788286, "o", "\u001b[?2004h> "]
[1483.788342, "o", "    a = warp_sum(a); bb = warp_sum(bb);\r\n\u001b[?2004l\r"]
[1483.788377, "o", "\u001b[?2004h> "]
[1483.788401, "o", "    if (lane == 0) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.788435, "o", "> "]
[1483.788484, "o", "      float mean = a / (float)(n4 * 4);\r\n\u001b[?2004l\r"]
[1483.788514, "o", "\u001b[?2004h> "]
[1483.788592, "o", "      float var = bb / (float)(n4 * 4) - mean * mean;\r\n\u001b[?2004l\r"]
[1483.788623, "o", "\u001b[?2004h> "]
[1483.788656, "o", "      sh_mean = mean;\r\n\u001b[?2004l\r"]
[1483.788688, "o", "\u001b[?2004h> "]
[1483.788731, "o", "      sh_rstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r"]
[1483.788761, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1483.788791, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[1483.788822, "o", "\u001b[?2004h> "]
[1483.788855, "o", "  __syncthreads();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.788939, "o", "  const float mean = sh_mean, rstd = sh_rstd;\r\n\u001b[?2004l\r"]
[1483.788969, "o", "\u001b[?2004h> "]
[1483.789026, "o", "  const float4* xr = x + (long)row * n4;\r\n\u001b[?2004l\r"]
[1483.789057, "o", "\u001b[?2004h> "]
[1483.789104, "o", "  float4* yr = y + (long)row * n4;\r\n\u001b[?2004l\r"]
[1483.78916, "o", "\u001b[?2004h> "]
[1483.789196, "o", "  const int nblocks = gridDim.x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.78923, "o", "  if (!rev) {\r\n\u001b[?2004l\r"]
[1483.789262, "o", "\u001b[?2004h> "]
[1483.7894, "o", "    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n4; i += nblocks * blockDim.x) {\r\n\u001b[?2004l\r"]
[1483.789433, "o", "\u001b[?2004h> "]
[1483.789467, "o", "      float4 v = xr[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.789515, "o", "      float4 wv = w[i];\r\n\u001b[?2004l\r"]
[1483.789546, "o", "\u001b[?2004h> "]
[1483.78958, "o", "      float4 bv = b[i];\r\n\u001b[?2004l\r"]
[1483.789612, "o", "\u001b[?2004h> "]
[1483.789644, "o", "      float4 o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.789715, "o", "      o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1483.789749, "o", "\u001b[?2004h> "]
[1483.789813, "o", "      o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1483.789843, "o", "\u001b[?2004h> "]
[1483.789911, "o", "      o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1483.789943, "o", "\u001b[?2004h> "]
[1483.790018, "o", "      o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1483.790047, "o", "\u001b[?2004h> "]
[1483.790079, "o", "      yr[i] = o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.790111, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.790137, "o", "  } else {\r\n\u001b[?2004l\r"]
[1483.790173, "o", "\u001b[?2004h> "]
[1483.790337, "o", "    for (int i = n4 - 1 - (blockIdx.x * blockDim.x + threadIdx.x); i >= 0; i -= nblocks * blockDim.x) {\r\n\u001b[?2004l\r"]
[1483.790369, "o", "\u001b[?2004h> "]
[1483.790402, "o", "      float4 v = xr[i];\r\n\u001b[?2004l\r"]
[1483.790432, "o", "\u001b[?2004h> "]
[1483.790458, "o", "      float4 wv = w[i];\r\n\u001b[?2004l\r"]
[1483.790488, "o", "\u001b[?2004h> "]
[1483.790519, "o", "      float4 bv = b[i];\r\n\u001b[?2004l\r"]
[1483.790548, "o", "\u001b[?2004h> "]
[1483.790578, "o", "      float4 o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.790659, "o", "      o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1483.790689, "o", "\u001b[?2004h> "]
[1483.790758, "o", "      o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1483.790788, "o", "\u001b[?2004h> "]
[1483.790855, "o", "      o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1483.790886, "o", "\u001b[?2004h> "]
[1483.790951, "o", "      o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1483.790981, "o", "\u001b[?2004h> "]
[1483.791004, "o", "      yr[i] = o;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.791036, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.791071, "o", ">   }\r\n\u001b[?2004l\r"]
[1483.791098, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1483.791127, "o", "\u001b[?2004h> "]
[1483.791303, "o", "torch::Tensor ln4(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long rev) {\r\n\u001b[?2004l\r"]
[1483.791337, "o", "\u001b[?2004h> "]
[1483.791379, "o", "  auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[1483.791409, "o", "\u001b[?2004h> "]
[1483.791443, "o", "  long D = w.numel();\r\n\u001b[?2004l\r"]
[1483.79147, "o", "\u001b[?2004h> "]
[1483.791502, "o", "  long B = x.numel() / D;\r\n\u001b[?2004l\r"]
[1483.791532, "o", "\u001b[?2004h> "]
[1483.791564, "o", "  int n4 = (int)(D / 4);\r\n\u001b[?2004l\r"]
[1483.791594, "o", "\u001b[?2004h> "]
[1483.791684, "o", "  auto partials = torch::empty({B * nb1 * 2}, x.options());\r\n\u001b[?2004l\r"]
[1483.791713, "o", "\u001b[?2004h> "]
[1483.7918, "o", "  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1483.79183, "o", "\u001b[?2004h> "]
[1483.791898, "o", "  dim3 g1((unsigned)nb1, (unsigned)B), b1(256);\r\n\u001b[?2004l\r"]
[1483.791928, "o", "\u001b[?2004h> "]
[1483.79214, "o", "  k1<<<g1, b1, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, (int)rev);\r\n\u001b[?2004l\r"]
[1483.792171, "o", "\u001b[?2004h> "]
[1483.792241, "o", "  dim3 g2((unsigned)nb2, (unsigned)B), b2(256);\r\n\u001b[?2004l\r"]
[1483.792271, "o", "\u001b[?2004h> "]
[1483.792395, "o", "  k2<<<g2, b2, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1483.792426, "o", "\u001b[?2004h> "]
[1483.792606, "o", "      reinterpret_cast<const float4*>(w.data_ptr<float>()), reinterpret_cast<const float4*>(b.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1483.792635, "o", "\u001b[?2004h> "]
[1483.792817, "o", "      reinterpret_cast<float4*>(y.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, (float)eps, (int)rev);\r\n\u001b[?2004l\r"]
[1483.792848, "o", "\u001b[?2004h> "]
[1483.79288, "o", "  return y;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1483.792913, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.792945, "o", "> "]
[1483.793126, "o", "cpp = \"torch::Tensor ln4(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long rev);\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.793158, "o", "> "]
[1483.793421, "o", "ext = load_inline(name='ln_rev1', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln4'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.793454, "o", "> "]
[1483.793507, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1483.793537, "o", "\u001b[?2004h> "]
[1483.793598, "o", "w = torch.ones(64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1483.793627, "o", "\u001b[?2004h> "]
[1483.793686, "o", "b = torch.zeros(64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1483.793717, "o", "\u001b[?2004h> "]
[1483.793814, "o", "yr = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\r\n\u001b[?2004l\r"]
[1483.793845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.793876, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[1483.793908, "o", "\u001b[?2004h> "]
[1483.794064, "o", "    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\r\n\u001b[?2004l\r\u001b[?2004h"]
[1483.794075, "o", "> \r\n\u001b[?2004l\r"]
[1483.794104, "o", "\u001b[?2004h> "]
[1483.794136, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[1483.794173, "o", "\u001b[?2004h> "]
[1483.794246, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1483.794263, "o", "\u001b[?2004h> "]
[1483.7943, "o", "    ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.794339, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1483.794371, "o", "\u001b[?2004h> "]
[1483.794417, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1483.794447, "o", "\u001b[?2004h> "]
[1483.794576, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1483.794606, "o", "\u001b[?2004h> "]
[1483.794638, "o", "        dummy=clear_l2()\r\n\u001b[?2004l\r"]
[1483.794661, "o", "\u001b[?2004h> "]
[1483.79476, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1483.79479, "o", "\u001b[?2004h> "]
[1483.794841, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1483.794871, "o", "\u001b[?2004h> "]
[1483.794903, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.794942, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1483.794974, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1483.795009, "o", "\u001b[?2004h> "]
[1483.795041, "o", "for rev in [0,1]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1483.795136, "o", "    for nb1, nb2 in [(128,64),(256,64),(512,128),(1024,128)]:\r\n\u001b[?2004l\r"]
[1483.795175, "o", "\u001b[?2004h> "]
[1483.795239, "o", "        y = ext.ln4(x,w,b,1e-5,nb1,nb2,rev)\r\n\u001b[?2004l\r"]
[1483.795269, "o", "\u001b[?2004h> "]
[1483.795352, "o", "        ok = torch.allclose(y, yr, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1483.795377, "o", "\u001b[?2004h> "]
[1483.795468, "o", "        t = bench(lambda: ext.ln4(x,w,b,1e-5,nb1,nb2,rev))\r\n\u001b[?2004l\r"]
[1483.795495, "o", "\u001b[?2004h> "]
[1483.795599, "o", "        print(f'rev={rev} nb1={nb1} nb2={nb2}: {t:.4f}ms ok={ok}')\r\n\u001b[?2004l\r"]
[1483.795628, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1483.796797, "o", "\u001b[?2004hroot@modal:/workspace# "]
