[296.111175, "o", "\u001b[?2004h> "]
[296.11123, "o", "      sh_rstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r"]
[296.111378, "o", "\u001b[?2004h> "]
[296.1114, "o", "    }\r\n\u001b[?2004l\r"]
[296.11142, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[296.111437, "o", "\u001b[?2004h> "]
[296.111471, "o", "  __syncthreads();\r\n\u001b[?2004l\r"]
[296.111487, "o", "\u001b[?2004h> "]
[296.111564, "o", "  const float mean = sh_mean, rstd = sh_rstd;\r\n\u001b[?2004l\r"]
[296.111577, "o", "\u001b[?2004h> "]
[296.111624, "o", "  const long n4 = D >> 2;\r\n\u001b[?2004l\r"]
[296.111636, "o", "\u001b[?2004h> "]
[296.111762, "o", "  const float4* xr = reinterpret_cast<const float4*>(x + (long)row * D);\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.111782, "o", "> "]
[296.111879, "o", "  float4* yr = reinterpret_cast<float4*>(y + (long)row * D);\r\n\u001b[?2004l\r"]
[296.111896, "o", "\u001b[?2004h> "]
[296.111988, "o", "  const float4* wr = reinterpret_cast<const float4*>(w);\r\n\u001b[?2004l\r"]
[296.112001, "o", "\u001b[?2004h> "]
[296.112097, "o", "  const float4* br = reinterpret_cast<const float4*>(b);\r\n\u001b[?2004l\r"]
[296.112108, "o", "\u001b[?2004h> "]
[296.112287, "o", "  for (long i = (long)blockIdx.x * blockDim.y + threadIdx.y; i < n4; i += (long)gridDim.x * blockDim.y) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.1123, "o", "> "]
[296.112337, "o", "    float4 v = xr[i];\r\n\u001b[?2004l\r"]
[296.112357, "o", "\u001b[?2004h> "]
[296.112393, "o", "    float4 wv = wr[i];\r\n\u001b[?2004l\r"]
[296.112413, "o", "\u001b[?2004h> "]
[296.112448, "o", "    float4 bv = br[i];\r\n\u001b[?2004l\r"]
[296.112461, "o", "\u001b[?2004h> "]
[296.112489, "o", "    float4 o;\r\n\u001b[?2004l\r"]
[296.112505, "o", "\u001b[?2004h> "]
[296.112579, "o", "    o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[296.112598, "o", "\u001b[?2004h> "]
[296.11267, "o", "    o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[296.112692, "o", "\u001b[?2004h> "]
[296.112758, "o", "    o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[296.112781, "o", "\u001b[?2004h> "]
[296.112853, "o", "    o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[296.112872, "o", "\u001b[?2004h> "]
[296.112895, "o", "    yr[i] = o;\r\n\u001b[?2004l\r"]
[296.112909, "o", "\u001b[?2004h> "]
[296.112931, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[296.112952, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.112968, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[296.112983, "o", "> "]
[296.113139, "o", "torch::Tensor ln_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps) {\r\n\u001b[?2004l\r"]
[296.11316, "o", "\u001b[?2004h> "]
[296.113254, "o", "  TORCH_CHECK(x.is_cuda() && x.dtype() == torch::kFloat32);\r\n\u001b[?2004l\r"]
[296.113274, "o", "\u001b[?2004h> "]
[296.113406, "o", "  TORCH_CHECK(x.is_contiguous() && weight.is_contiguous() && bias.is_contiguous());\r\n\u001b[?2004l\r"]
[296.113424, "o", "\u001b[?2004h> "]
[296.113477, "o", "  auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[296.113532, "o", "\u001b[?2004h> "]
[296.113544, "o", "  long D = weight.numel();\r\n\u001b[?2004l\r"]
[296.113561, "o", "\u001b[?2004h> "]
[296.113607, "o", "  TORCH_CHECK((D & 3) == 0);\r\n\u001b[?2004l\r"]
[296.113626, "o", "\u001b[?2004h> "]
[296.113667, "o", "  long B = x.numel() / D;\r\n\u001b[?2004l\r"]
[296.113686, "o", "\u001b[?2004h> "]
[296.113729, "o", "  int nb1 = 128, nb2 = 64;\r\n\u001b[?2004l\r"]
[296.113749, "o", "\u001b[?2004h> "]
[296.113846, "o", "  auto partials = torch::empty({B * nb1 * 2}, x.options());\r\n\u001b[?2004l\r"]
[296.113869, "o", "\u001b[?2004h> "]
[296.11397, "o", "  cudaStream_t stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.113988, "o", "> "]
[296.114048, "o", "  dim3 g1(nb1, (unsigned)B), b1(32, 4);\r\n\u001b[?2004l\r"]
[296.114067, "o", "\u001b[?2004h> "]
[296.114217, "o", "  row_partials<<<g1, b1, 0, stream>>>(x.data_ptr<float>(), partials.data_ptr<float>(), D, nb1);\r\n\u001b[?2004l\r"]
[296.11423, "o", "\u001b[?2004h> "]
[296.114298, "o", "  dim3 g2(nb2, (unsigned)B), b2(32, 4);\r\n\u001b[?2004l\r"]
[296.114317, "o", "\u001b[?2004h> "]
[296.11448, "o", "  ln_apply<<<g2, b2, 0, stream>>>(x.data_ptr<float>(), weight.data_ptr<float>(), bias.data_ptr<float>(),\r\n\u001b[?2004l\r"]
[296.114493, "o", "\u001b[?2004h> "]
[296.114663, "o", "                                  y.data_ptr<float>(), partials.data_ptr<float>(), D, nb1, (float)eps);\r\n\u001b[?2004l\r"]
[296.114683, "o", "\u001b[?2004h> "]
[296.114697, "o", "  return y;\r\n\u001b[?2004l\r"]
[296.114721, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[296.114739, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[296.11476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[296.114781, "o", "\u001b[?2004h> "]
[296.114962, "o", "_cpp_src = \"torch::Tensor ln_forward(torch::Tensor x, torch::Tensor weight, torch::Tensor bias, double eps);\"\r\n\u001b[?2004l\r"]
[296.114981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[296.114996, "o", "\u001b[?2004h> "]
[296.115017, "o", "_ext = None\r\n\u001b[?2004l\r"]
[296.115031, "o", "\u001b[?2004h> "]
[296.115061, "o", "_ext_err = None\r\n\u001b[?2004l\r"]
[296.115073, "o", "\u001b[?2004h> "]
[296.115096, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.115108, "o", "> "]
[296.115146, "o", "    _ext = load_inline(\r\n\u001b[?2004l\r"]
[296.115165, "o", "\u001b[?2004h> "]
[296.115207, "o", "        name=\"fused_ln_v1\",\r\n\u001b[?2004l\r"]
[296.115225, "o", "\u001b[?2004h> "]
[296.115271, "o", "        cpp_sources=_cpp_src,\r\n\u001b[?2004l\r"]
[296.115291, "o", "\u001b[?2004h> "]
[296.11534, "o", "        cuda_sources=_cuda_src,\r\n\u001b[?2004l\r"]
[296.11536, "o", "\u001b[?2004h> "]
[296.115413, "o", "        functions=[\"ln_forward\"],\r\n\u001b[?2004l\r"]
[296.115433, "o", "\u001b[?2004h> "]
[296.11554, "o", "        extra_cuda_cflags=[\"-O3\", \"--use_fast_math\", \"-std=c++17\"],\r\n\u001b[?2004l\r"]
[296.115553, "o", "\u001b[?2004h> "]
[296.115605, "o", "        extra_cflags=[\"-O3\"],\r\n\u001b[?2004l\r"]
[296.115625, "o", "\u001b[?2004h> "]
[296.115659, "o", "        verbose=False,\r\n\u001b[?2004l\r"]
[296.115679, "o", "\u001b[?2004h> "]
[296.115693, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[296.115708, "o", "> "]
[296.11578, "o", "except Exception as e:  # pragma: no cover\r\n\u001b[?2004l\r"]
[296.1158, "o", "\u001b[?2004h> "]
[296.115825, "o", "    _ext_err = e\r\n\u001b[?2004l\r"]
[296.11584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[296.115862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[296.115877, "o", "\u001b[?2004h> "]
[296.115922, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[296.115942, "o", "\u001b[?2004h> "]
[296.116018, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[296.116035, "o", "\u001b[?2004h> "]
[296.116079, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[296.116097, "o", "\u001b[?2004h> "]
[296.116186, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[296.116205, "o", "\u001b[?2004h> "]
[296.116314, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[296.116334, "o", "\u001b[?2004h> "]
[296.116441, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[296.116462, "o", "\u001b[?2004h> "]
[296.116498, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[296.116519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[296.116534, "o", "> "]
[296.116622, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[296.116643, "o", "\u001b[?2004h> "]
[296.116794, "o", "        if _ext is not None and x.is_cuda and x.dtype == torch.float32 and x.is_contiguous():\r\n\u001b[?2004l\r"]
[296.116814, "o", "\u001b[?2004h> "]
[296.116926, "o", "            return _ext.ln_forward(x, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[296.116944, "o", "\u001b[?2004h> "]
[296.117119, "o", "        return torch.nn.functional.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[296.117134, "o", "\u001b[?2004h> "]
[296.117148, "o", "EOF\r\n\u001b[?2004l\r"]
[296.118649, "o", "\u001b[?2004hroot@modal:/workspace# "]
[296.118686, "o", "ls -la /workspace/\r\n\u001b[?2004l\r"]
[296.120344, "o", "total 16\r\n"]
[296.120367, "o", "drwxr-xr-x  2 root root 4096 Nov  3 05:16 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 20 root root 4096 Nov  3 05:11 \u001b[01;34m..\u001b[0m\r\n-rw-r--r--  1 root root 5436 Nov  3 05:16 solution.py\r\n"]
[296.120559, "o", "\u001b[?2004hroot@modal:/workspace# "]
[296.437356, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch, time\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew, _ext_err\n\ntorch.manual_seed(0)\ndev = 'cuda'\nref = Model(*get_init_inputs()).to(dev)\nnew = ModelNew(*get_init_inputs()).to(dev)\nprint('ext_err:', _ext_err)\n\nx = get_inputs()[0].to(dev)\nwith torch.no_grad():\n    o1 = ref(x)\n    o2 = new(x)\nprint('max diff:', (o1 - o2).abs().max().item())\nprint('allclose:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4))\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\n    d.fill_(0)\n    return d\n\ndef bench(m, n=50):\n    with torch.no_grad():\n        for _ in range(5):\n            m(x); torch.cuda.synchronize()\n        times = []\n        for _ in range(n):\n            torch.cuda.synchronize()\n            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n            dummy = clear_l2()\n            s.record"]
[296.437416, "i", "()\n            m(x)\n            e.record()\n            torch.cuda.synchronize()\n            times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2], sum(times)/len(times), times[0]\n\nfor name, m in [('ref', ref), ('new', new)]:\n    med, mean, mn = bench(m)\n    print(f'{name}: median={med:.4f}ms mean={mean:.4f}ms min={mn:.4f}ms')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/solution.py /workspace/solution.py\n"]
