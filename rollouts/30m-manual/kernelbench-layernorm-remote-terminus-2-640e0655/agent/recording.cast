[1486.057065, "o", "{\r\n  \"bytes\": 5957,\r\n  \"sha256\": \"ee0d24716beeb7133f9b99c7390b063fdc0053ef4f39c22f207b84679d929085\"\r\n}\r\n"]
[1486.166217, "o", "request ID: f641febae0264dc4b8a44f0c88700ffc\r\n"]
[1487.915237, "o", "command: e530ad141e7c4575a6fd25772df25513\r\n"]
[1535.850449, "o", "rev=0 nb1=128 nb2=64: 0.3197ms ok=True\r\nrev=0 nb1=256 nb2=64: 0.3177ms ok=True\r\nrev=0 nb1=512 nb2=128: 0.3519ms ok=True\r\nrev=0 nb1=1024 nb2=128: 0.3523ms ok=True\r\nrev=1 nb1=128 nb2=64: 0.3204ms ok=True\r\nrev=1 nb1=256 nb2=64: 0.3200ms ok=True\r\nrev=1 nb1=512 nb2=128: 0.3507ms ok=True\r\nrev=1 nb1=1024 nb2=128: 0.3530ms ok=True\r\n"]
