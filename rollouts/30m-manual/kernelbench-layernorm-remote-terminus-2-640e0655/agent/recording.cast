[1665.921566, "i", "cat > /workspace/prof9.py << 'EOF'\nimport torch\nfrom torch.utils.cpp_extension import load_inline\ncuda_src = r\"\"\"\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n\n#define FULL_MASK 0xffffffffu\n__inline__ __device__ float warp_sum(float v) {\n  v += __shfl_xor_sync(FULL_MASK, v, 16);\n  v += __shfl_xor_sync(FULL_MASK, v, 8);\n  v += __shfl_xor_sync(FULL_MASK, v, 4);\n  v += __shfl_xor_sync(FULL_MASK, v, 2);\n  v += __shfl_xor_sync(FULL_MASK, v, 1);\n  return v;\n}\n\n// read-only reduce over whole tensor, contiguous chunks per block\n__global__ void reduce_ro(const float4* __restrict__ x, float* __restrict__ out, int n4) {\n  float s = 0.f;\n  int chunk = (n4 + gridDim.x - 1) / gridDim.x;\n  int beg = blockIdx.x * chunk;\n  int end = min(beg + chunk, n4);\n  for (int i = beg + threadIdx.x; i < end; i += blockDim.x) {\n    float4 v = x[i];\n    s += v.x + v.y + v.z + v.w;\n  }\n  s = warp_sum(s);\n  __shared__ float sh[32];\n  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\n  if (lane ="]
[1665.92162, "i", "= 0) sh[warp] = s;\n  __syncthreads();\n  if (warp == 0) {\n    float a = lane < (blockDim.x >> 5) ? sh[lane] : 0.f;\n    a = warp_sum(a);\n    if (lane == 0) out[blockIdx.x] = a;\n  }\n}\n\n// read-only strided (like k1)\n__global__ void reduce_strided(const float4* __restrict__ x, float* __restrict__ out, int n4) {\n  float s = 0.f;\n  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n4; i += gridDim.x * blockDim.x) {\n    float4 v = x[i];\n    s += v.x + v.y + v.z + v.w;\n  }\n  s = warp_sum(s);\n  __shared__ float sh[32];\n  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\n  if (lane == 0) sh[warp] = s;\n  __syncthreads();\n  if (warp == 0) {\n    float a = lane < (blockDim.x >> 5) ? sh[lane] : 0.f;\n    a = warp_sum(a);\n    if (lane == 0) out[blockIdx.x] = a;\n  }\n}\n\n// write-only kernel\n__global__ void write_only(float4* __restrict__ y, int n4) {\n  float4 v = make_float4(1.f, 2.f, 3.f, 4.f);\n  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n4; i += gridDim.x * blockDim.x) {\n    y[i] = v;\n  }\n}\n\nvoid run_r"]
[1665.921632, "i", "educe(torch::Tensor x, torch::Tensor out, long blocks, long threads, long mode) {\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  int n4 = (int)(x.numel() / 4);\n  if (mode == 0)\n    reduce_ro<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), out.data_ptr<float>(), n4);\n  else if (mode == 1)\n    reduce_strided<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), out.data_ptr<float>(), n4);\n  else\n    write_only<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<float4*>(x.data_ptr<float>()), n4);\n}\n\"\"\"\ncpp = \"void run_reduce(torch::Tensor x, torch::Tensor out, long blocks, long threads, long mode);\"\next = load_inline(name='ln_red', cpp_sources=cpp, cuda_sources=cuda_src, functions=['run_reduce'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nout = torch.empty(65536, device='cuda')\n\ndef clear_l2():\n    "]
[1665.92164, "i", "d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nfor mode,name in [(0,'read-chunked'),(1,'read-strided'),(2,'write-only')]:\n    for blocks in [1056, 2048, 4096, 8192]:\n        t = bench(lambda: ext.run_reduce(x,out,blocks,256,mode))\n        print(f'{name} blocks={blocks}: {t:.4f}ms -> {0.0671/(t*1e-3):.0f} GB/s')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof9.py /workspace/prof9.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof9.py\n"]
