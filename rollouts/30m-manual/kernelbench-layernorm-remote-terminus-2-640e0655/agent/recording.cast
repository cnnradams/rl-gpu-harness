[1067.328493, "i", "   s += v.x + v.y + v.z + v.w;\n      q += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n  }\n  s = warp_sum(s); q = warp_sum(q);\n  __shared__ float sh[2][32];\n  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\n  int nw = blockDim.x >> 5;\n  if (lane == 0) { sh[0][warp] = s; sh[1][warp] = q; }\n  __syncthreads();\n  if (warp == 0) {\n    float a = lane < nw ? sh[0][lane] : 0.f;\n    float b = lane < nw ? sh[1][lane] : 0.f;\n    a = warp_sum(a); b = warp_sum(b);\n    if (lane == 0) {\n      partials[(long)row * 2 * nb + blockIdx.x] = a;\n      partials[(long)row * 2 * nb + nb + blockIdx.x] = b;\n    }\n  }\n}\n\n// kernel2: elementwise style like torch copy, int indexing, ILP via unroll\n__global__ void k2(const float4* __restrict__ x, const float4* __restrict__ w,\n                   const float4* __restrict__ b, float4* __restrict__ y,\n                   const float* __restrict__ partials, int n4, int nb, float eps) {\n  const int row = blockIdx.y;\n  float s = 0.f, q = 0.f;\n  for (int i = threadIdx.x; i < nb; i += blockDim"]
[1067.328501, "i", ".x) {\n    s += partials[(long)row * 2 * nb + i];\n    q += partials[(long)row * 2 * nb + nb + i];\n  }\n  s = warp_sum(s); q = warp_sum(q);\n  __shared__ float sh[2][32];\n  __shared__ float sh_mean, sh_rstd;\n  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\n  int nw = blockDim.x >> 5;\n  if (lane == 0) { sh[0][warp] = s; sh[1][warp] = q; }\n  __syncthreads();\n  if (warp == 0) {\n    float a = lane < nw ? sh[0][lane] : 0.f;\n    float bb = lane < nw ? sh[1][lane] : 0.f;\n    a = warp_sum(a); bb = warp_sum(bb);\n    if (lane == 0) {\n      float mean = a / (float)(n4 * 4);\n      float var = bb / (float)(n4 * 4) - mean * mean;\n      sh_mean = mean;\n      sh_rstd = rsqrtf(var + eps);\n    }\n  }\n  __syncthreads();\n  const float mean = sh_mean, rstd = sh_rstd;\n  const float4* xr = x + (long)row * n4;\n  float4* yr = y + (long)row * n4;\n  const int chunks = (n4 + blockDim.x - 1) / blockDim.x;\n  const int cpb = (chunks + gridDim.x - 1) / gridDim.x;\n  const int base = blockIdx.x * cpb;\n  #pragma unroll 4\n  for (int c = 0; c "]
[1067.328606, "i", "< cpb; ++c) {\n    int i = (base + c) * blockDim.x + threadIdx.x;\n    if (i < n4) {\n      float4 v = xr[i];\n      float4 wv = w[i];\n      float4 bv = b[i];\n      float4 o;\n      o.x = (v.x - mean) * rstd * wv.x + bv.x;\n      o.y = (v.y - mean) * rstd * wv.y + bv.y;\n      o.z = (v.z - mean) * rstd * wv.z + bv.z;\n      o.w = (v.w - mean) * rstd * wv.w + bv.w;\n      yr[i] = o;\n    }\n  }\n}\n\ntorch::Tensor ln2(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long t1, long t2) {\n  auto y = torch::empty_like(x);\n  long D = w.numel();\n  long B = x.numel() / D;\n  int n4 = (int)(D / 4);\n  auto partials = torch::empty({B * nb1 * 2}, x.options());\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  int chunks1 = (n4 + (int)t1 - 1) / (int)t1;\n  int cpb1 = (chunks1 + (int)nb1 - 1) / (int)nb1;\n  dim3 g1((unsigned)nb1, (unsigned)B), b1((unsigned)t1);\n  k1<<<g1, b1, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, cpb1);\n  dim"]
