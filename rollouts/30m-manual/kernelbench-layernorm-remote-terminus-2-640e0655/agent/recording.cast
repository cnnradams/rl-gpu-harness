[1184.912121, "o", "mode=0 blocks=1024 threads=256: 0.1940ms -> 692 GB/s\r\nmode=0 blocks=2048 threads=256: 0.1930ms -> 695 GB/s\r\nmode=0 blocks=4096 threads=256: 0.1908ms -> 703 GB/s\r\nmode=0 blocks=8192 threads=256: 0.1891ms -> 710 GB/s\r\nmode=0 blocks=16384 threads=256: 0.1868ms -> 718 GB/s\r\nmode=0 blocks=4096 threads=512: 0.1888ms -> 711 GB/s\r\nmode=0 blocks=32768 threads=128: 0.1869ms -> 718 GB/s\r\nmode=1 blocks=1024 threads=256: 0.0231ms -> 5809 GB/s\r\nmode=1 blocks=2048 threads=256: 0.0400ms -> 3352 GB/s\r\nmode=1 blocks=4096 threads=256: 0.0714ms -> 1880 GB/s\r\nmode=1 blocks=8192 threads=256: 0.1318ms -> 1018 GB/s\r\nmode=1 blocks=16384 threads=256: 0.2512ms -> 534 GB/s\r\nmode=1 blocks=4096 threads=512: 0.1369ms -> 981 GB/s\r\nmode=1 blocks=32768 threads=128: 0.2467ms -> 544 GB/s\r\n"]
