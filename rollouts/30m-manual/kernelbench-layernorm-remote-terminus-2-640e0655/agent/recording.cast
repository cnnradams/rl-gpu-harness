[1212.923512, "i", "cat > /workspace/prof5.py << 'EOF'\nimport torch\nfrom torch.utils.cpp_extension import load_inline\ncuda_src = r\"\"\"\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <c10/cuda/CUDAStream.h>\n\n__global__ void pure_copy(const float4* __restrict__ x, float4* __restrict__ y, int n4) {\n  int i = blockIdx.x * blockDim.x + threadIdx.x;\n  int stride = gridDim.x * blockDim.x;\n  for (; i < n4; i += stride) y[i] = x[i];\n}\nvoid run_pure(torch::Tensor x, torch::Tensor y, long blocks, long threads) {\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  int n4 = (int)(x.numel() / 4);\n  pure_copy<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), reinterpret_cast<float4*>(y.data_ptr<float>()), n4);\n}\nvoid run_memcpy(torch::Tensor x, torch::Tensor y) {\n  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\n  cudaMemcpyAsync(y.data_ptr<float>(), x.data_ptr<float>(), x.numel()*4, cudaMemcpyDeviceToDevice, stream);\n}\n\"\"\"\ncpp = \"void run_pure(torch::Ten"]
[1212.923562, "i", "sor x, torch::Tensor y, long blocks, long threads);\\nvoid run_memcpy(torch::Tensor x, torch::Tensor y);\"\next = load_inline(name='ln_pure2', cpp_sources=cpp, cuda_sources=cuda_src, functions=['run_pure','run_memcpy'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\ny = torch.empty_like(x)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\n\ndef bench(fn, n=30, clear=True):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        if clear: dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nGB = 2*0.0671\nprint('torch copy_       :', bench(lambda: y.copy_(x)), 'ms')\nprint('memcpy D2D        :', bench(lambda: ext.run_memcpy(x,y"]
[1212.923576, "i", ")), 'ms')\nprint('pure 16384x256    :', bench(lambda: ext.run_pure(x,y,16384,256)), 'ms')\nprint('pure 8192x256     :', bench(lambda: ext.run_pure(x,y,8192,256)), 'ms')\nprint('pure 16384x256 hot:', bench(lambda: ext.run_pure(x,y,16384,256), clear=False), 'ms')\nprint('pure 8192x256  hot:', bench(lambda: ext.run_pure(x,y,8192,256), clear=False), 'ms')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof5.py /workspace/prof5.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof5.py\n"]
