[1724.244194, "o", "read-chunked blocks=1056: 0.1033ms -> 650 GB/s\r\nread-chunked blocks=2048: 0.1029ms -> 652 GB/s\r\nread-chunked blocks=4096: 0.1018ms -> 659 GB/s\r\nread-chunked blocks=8192: 0.1006ms -> 667 GB/s\r\nread-strided blocks=1056: 0.1015ms -> 661 GB/s\r\nread-strided blocks=2048: 0.1014ms -> 662 GB/s\r\nread-strided blocks=4096: 0.1003ms -> 669 GB/s\r\nread-strided blocks=8192: 0.0997ms -> 673 GB/s\r\nwrite-only blocks=1056: 0.0893ms -> 751 GB/s\r\nwrite-only blocks=2048: 0.0908ms -> 739 GB/s\r\nwrite-only blocks=4096: 0.0879ms -> 764 GB/s\r\nwrite-only blocks=8192: 0.0871ms -> 771 GB/s\r\n"]
