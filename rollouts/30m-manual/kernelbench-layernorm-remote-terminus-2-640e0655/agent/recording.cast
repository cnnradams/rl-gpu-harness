[1665.925914, "o", "    float a = lane < (blockDim.x >> 5) ? sh[lane] : 0.f;\r\n\u001b[?2004l\r"]
[1665.92595, "o", "\u001b[?2004h> "]
[1665.925977, "o", "    a = warp_sum(a);\r\n\u001b[?2004l\r"]
[1665.92601, "o", "\u001b[?2004h> "]
[1665.926069, "o", "    if (lane == 0) out[blockIdx.x] = a;\r\n\u001b[?2004l\r"]
[1665.926094, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[1665.926121, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1665.926147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.926174, "o", "> "]
[1665.926202, "o", "// write-only kernel\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.92623, "o", "> "]
[1665.92632, "o", "__global__ void write_only(float4* __restrict__ y, int n4) {\r\n\u001b[?2004l\r"]
[1665.926344, "o", "\u001b[?2004h> "]
[1665.926418, "o", "  float4 v = make_float4(1.f, 2.f, 3.f, 4.f);\r\n\u001b[?2004l\r"]
[1665.926441, "o", "\u001b[?2004h> "]
[1665.926598, "o", "  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n4; i += gridDim.x * blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.926627, "o", "> "]
[1665.926653, "o", "    y[i] = v;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.92668, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1665.926705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1665.926729, "o", "\u001b[?2004h> "]
[1665.926883, "o", "void run_reduce(torch::Tensor x, torch::Tensor out, long blocks, long threads, long mode) {\r\n\u001b[?2004l\r"]
[1665.926908, "o", "\u001b[?2004h> "]
[1665.927003, "o", "  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1665.927042, "o", "\u001b[?2004h> "]
[1665.927074, "o", "  int n4 = (int)(x.numel() / 4);\r\n\u001b[?2004l\r"]
[1665.927108, "o", "\u001b[?2004h> "]
[1665.92713, "o", "  if (mode == 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.927163, "o", "> "]
[1665.927404, "o", "    reduce_ro<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), out.data_ptr<float>(), n4);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.927435, "o", "> "]
[1665.927468, "o", "  else if (mode == 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.927736, "o", "    reduce_strided<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), out.data_ptr<float>(), n4);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.927777, "o", ">   else\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.92781, "o", "> "]
[1665.927989, "o", "    write_only<<<(unsigned)blocks, (unsigned)threads, 0, stream>>>(reinterpret_cast<float4*>(x.data_ptr<float>()), n4);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.928025, "o", "}\r\n\u001b[?2004l\r"]
[1665.928057, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.928226, "o", "cpp = \"void run_reduce(torch::Tensor x, torch::Tensor out, long blocks, long threads, long mode);\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.928261, "o", "> "]
[1665.928532, "o", "ext = load_inline(name='ln_red', cpp_sources=cpp, cuda_sources=cuda_src, functions=['run_reduce'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.92857, "o", "> "]
[1665.928623, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1665.928653, "o", "\u001b[?2004h> "]
[1665.928716, "o", "out = torch.empty(65536, device='cuda')\r\n\u001b[?2004l\r"]
[1665.92875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.928789, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[1665.928822, "o", "\u001b[?2004h> "]
[1665.928973, "o", "    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\r\n\u001b[?2004l\r\u001b[?2004h"]
[1665.929003, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.929051, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[1665.929079, "o", "\u001b[?2004h> "]
[1665.929162, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1665.929194, "o", "\u001b[?2004h> "]
[1665.929229, "o", "    ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.929261, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1665.929292, "o", "\u001b[?2004h> "]
[1665.929337, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1665.929368, "o", "\u001b[?2004h> "]
[1665.929501, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1665.929532, "o", "\u001b[?2004h> "]
[1665.929565, "o", "        dummy=clear_l2()\r\n\u001b[?2004l\r"]
[1665.929598, "o", "\u001b[?2004h> "]
[1665.929691, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1665.929722, "o", "\u001b[?2004h> "]
[1665.929782, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1665.929814, "o", "\u001b[?2004h> "]
[1665.929847, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.929896, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1665.929934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1665.930067, "o", "for mode,name in [(0,'read-chunked'),(1,'read-strided'),(2,'write-only')]:\r\n\u001b[?2004l\r"]
[1665.9301, "o", "\u001b[?2004h> "]
[1665.93016, "o", "    for blocks in [1056, 2048, 4096, 8192]:\r\n\u001b[?2004l\r"]
[1665.930191, "o", "\u001b[?2004h> "]
[1665.93029, "o", "        t = bench(lambda: ext.run_reduce(x,out,blocks,256,mode))\r\n\u001b[?2004l\r"]
[1665.930321, "o", "\u001b[?2004h> "]
[1665.930448, "o", "        print(f'{name} blocks={blocks}: {t:.4f}ms -> {0.0671/(t*1e-3):.0f} GB/s')\r\n\u001b[?2004l\r"]
[1665.930479, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
