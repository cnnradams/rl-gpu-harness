[986.717382, "i", "cat > /workspace/bw.py << 'EOF'\nimport torch, time\na = torch.empty(512*1024*1024, dtype=torch.float32, device='cuda')  # 2GB\nb = torch.empty_like(a)\nfor _ in range(3): b.copy_(a)\ntorch.cuda.synchronize()\ns=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\ns.record()\nfor _ in range(10): b.copy_(a)\ne.record(); torch.cuda.synchronize()\nt = s.elapsed_time(e)/10\nprint(f'2GB copy: {t:.3f}ms -> {2*2.147/(t*1e-3):.0f} GB/s (r+w)')\n# small 64MB copy (cold-ish)\nx = torch.empty(16*1024*1024, dtype=torch.float32, device='cuda')  # 64MB\ny = torch.empty_like(x)\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(0)\n    return d\nfor _ in range(3): y.copy_(x)\ntorch.cuda.synchronize()\nts=[]\nfor _ in range(30):\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    dummy = clear_l2()\n    s.record(); y.copy_(x); e.record(); torch.cuda.synchronize()\n    ts.append(s.elapsed_time(e))\nts.sort()\nt ="]
[986.717429, "i", " ts[len(ts)//2]\nprint(f'64MB copy coldL2: {t:.4f}ms -> {2*0.0671/(t*1e-3):.0f} GB/s (r+w)')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/bw.py /workspace/bw.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 200 -- python3 /workspace/bw.py\n"]
