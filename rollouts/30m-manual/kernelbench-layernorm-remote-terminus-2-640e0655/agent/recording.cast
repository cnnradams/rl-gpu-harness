[1748.877371, "i", "cat > /workspace/prof10.py << 'EOF'\nimport torch\nfrom torch.utils.cpp_extension import load_inline\nsrc = open('/workspace/prof9.py').read()\ncuda_src = src.split('cuda_src = r\"\"\"')[1].split('\"\"\"')[0]\ncpp = \"void run_reduce(torch::Tensor x, torch::Tensor out, long blocks, long threads, long mode);\"\next = load_inline(name='ln_red', cpp_sources=cpp, cuda_sources=cuda_src, functions=['run_reduce'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\nx = torch.rand(16,64,256,256, device='cuda')\nout = torch.empty(65536, device='cuda')\nthrash = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\nsink = torch.zeros(1, device='cuda')\n\ndef bench(fn, clear, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts."]
[1748.877415, "i", "sort()\n    return ts[len(ts)//2]\n\nrd = lambda: ext.run_reduce(x,out,8192,256,1)\nprint('after dirty fill :', bench(rd, lambda: thrash.fill_(0)))\nprint('after clean read :', bench(rd, lambda: torch.sum(thrash, out=sink)))\nprint('after nothing    :', bench(rd, lambda: None))\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof10.py /workspace/prof10.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof10.py\n"]
