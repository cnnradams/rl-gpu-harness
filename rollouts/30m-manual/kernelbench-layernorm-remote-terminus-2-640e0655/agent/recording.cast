[1330.902944, "i", " b, 1e-5)\ntorch.cuda.synchronize()\nprint('ok', torch.allclose(y, yr, atol=1e-4, rtol=1e-4), (y-yr).abs().max().item())\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\n\ndef bench(fn, n=30):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nt = bench(lambda: ext.ln3(x, w, b, 1e-5))\nprint(f'coop single-pass: {t:.4f}ms')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof6.py /workspace/prof6.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python3 /workspace/prof6.py\n"]
