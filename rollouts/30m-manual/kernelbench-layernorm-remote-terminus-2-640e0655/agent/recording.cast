[1067.334757, "o", "      partials[(long)row * 2 * nb + nb + blockIdx.x] = b;\r\n\u001b[?2004l\r"]
[1067.334778, "o", "\u001b[?2004h> "]
[1067.334794, "o", "    }\r\n\u001b[?2004l\r"]
[1067.334815, "o", "\u001b[?2004h> "]
[1067.334834, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.334854, "o", "> }\r\n\u001b[?2004l\r"]
[1067.334869, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1067.334889, "o", "e\u001b[?2004h> "]
[1067.33517, "o", "// kernel2: elementwise style like torch copy, int indexing, ILP via unroll\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1067.335454, "o", "__global__ void k2(const float4* __restrict__ x, const float4* __restrict__ w,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.335477, "o", "> "]
[1067.335706, "o", "                   const float4* __restrict__ b, float4* __restrict__ y,\r\n\u001b[?2004l\r"]
[1067.335721, "o", "\u001b[?2004h> "]
[1067.335998, "o", "                   const float* __restrict__ partials, int n4, int nb, float eps) {\r\n\u001b[?2004l\r"]
[1067.336014, "o", "\u001b[?2004h> "]
[1067.336113, "o", "  const int row = blockIdx.y;\r\n\u001b[?2004l\r"]
[1067.336131, "o", "\u001b[?2004h> "]
[1067.336215, "o", "  float s = 0.f, q = 0.f;\r\n\u001b[?2004l\r"]
[1067.336231, "o", "\u001b[?2004h> "]
[1067.336409, "o", "  for (int i = threadIdx.x; i < nb; i += blockDim.x) {\r\n\u001b[?2004l\r"]
[1067.336426, "o", "\u001b[?2004h> "]
[1067.336523, "o", "    s += partials[(long)row * 2 * nb + i];\r\n\u001b[?2004l\r"]
[1067.336544, "o", "\u001b[?2004h> "]
[1067.33662, "o", "    q += partials[(long)row * 2 * nb + nb + i];\r\n\u001b[?2004l\r"]
[1067.336641, "o", "\u001b[?2004h> "]
[1067.33666, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1067.336725, "o", "  s = warp_sum(s); q = warp_sum(q);\r\n\u001b[?2004l\r"]
[1067.336746, "o", "\u001b[?2004h> "]
[1067.336794, "o", "  __shared__ float sh[2][32];\r\n\u001b[?2004l\r"]
[1067.33681, "o", "\u001b[?2004h> "]
[1067.336874, "o", "  __shared__ float sh_mean, sh_rstd;\r\n\u001b[?2004l\r"]
[1067.33689, "o", "\u001b[?2004h> "]
[1067.336984, "o", "  int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;\r\n\u001b[?2004l\r"]
[1067.336997, "o", "\u001b[?2004h> "]
[1067.337049, "o", "  int nw = blockDim.x >> 5;\r\n\u001b[?2004l\r"]
[1067.337064, "o", "\u001b[?2004h> "]
[1067.337161, "o", "  if (lane == 0) { sh[0][warp] = s; sh[1][warp] = q; }\r\n\u001b[?2004l\r"]
[1067.337177, "o", "\u001b[?2004h> "]
[1067.337212, "o", "  __syncthreads();\r\n\u001b[?2004l\r"]
[1067.337233, "o", "\u001b[?2004h> "]
[1067.337264, "o", "  if (warp == 0) {\r\n\u001b[?2004l\r"]
[1067.33728, "o", "\u001b[?2004h> "]
[1067.337356, "o", "    float a = lane < nw ? sh[0][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1067.337374, "o", "\u001b[?2004h> "]
[1067.33745, "o", "    float bb = lane < nw ? sh[1][lane] : 0.f;\r\n\u001b[?2004l\r"]
[1067.337465, "o", "\u001b[?2004h> "]
[1067.337534, "o", "    a = warp_sum(a); bb = warp_sum(bb);\r\n\u001b[?2004l\r"]
[1067.33755, "o", "\u001b[?2004h> "]
[1067.337589, "o", "    if (lane == 0) {\r\n\u001b[?2004l\r"]
[1067.337605, "o", "\u001b[?2004h> "]
[1067.337674, "o", "      float mean = a / (float)(n4 * 4);\r\n\u001b[?2004l\r"]
[1067.337693, "o", "\u001b[?2004h> "]
[1067.337781, "o", "      float var = bb / (float)(n4 * 4) - mean * mean;\r\n\u001b[?2004l\r"]
[1067.337797, "o", "\u001b[?2004h> "]
[1067.337838, "o", "      sh_mean = mean;\r\n\u001b[?2004l\r"]
[1067.337857, "o", "\u001b[?2004h> "]
[1067.337914, "o", "      sh_rstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r"]
[1067.33794, "o", "\u001b[?2004h> "]
[1067.337955, "o", "    }\r\n\u001b[?2004l\r"]
[1067.33797, "o", "\u001b[?2004h> "]
[1067.337988, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.33801, "o", "> "]
[1067.338035, "o", "  __syncthreads();\r\n\u001b[?2004l\r"]
[1067.338051, "o", "\u001b[?2004h> "]
[1067.338134, "o", "  const float mean = sh_mean, rstd = sh_rstd;\r\n\u001b[?2004l\r"]
[1067.33815, "o", "\u001b[?2004h> "]
[1067.338221, "o", "  const float4* xr = x + (long)row * n4;\r\n\u001b[?2004l\r"]
[1067.338236, "o", "\u001b[?2004h> "]
[1067.338297, "o", "  float4* yr = y + (long)row * n4;\r\n\u001b[?2004l\r"]
[1067.33831, "o", "\u001b[?2004h> "]
[1067.338411, "o", "  const int chunks = (n4 + blockDim.x - 1) / blockDim.x;\r\n\u001b[?2004l\r"]
[1067.338427, "o", "\u001b[?2004h> "]
[1067.338519, "o", "  const int cpb = (chunks + gridDim.x - 1) / gridDim.x;\r\n\u001b[?2004l\r"]
[1067.338534, "o", "\u001b[?2004h> "]
[1067.338597, "o", "  const int base = blockIdx.x * cpb;\r\n\u001b[?2004l\r"]
[1067.338613, "o", "\u001b[?2004h> "]
[1067.338648, "o", "  #pragma unroll 4\r\n\u001b[?2004l\r"]
[1067.33867, "o", "\u001b[?2004h> "]
[1067.338725, "o", "  for (int c = 0; c < cpb; ++c) {\r\n\u001b[?2004l\r"]
[1067.33874, "o", "\u001b[?2004h> "]
[1067.338827, "o", "    int i = (base + c) * blockDim.x + threadIdx.x;\r\n\u001b[?2004l\r"]
[1067.338842, "o", "\u001b[?2004h> "]
[1067.338877, "o", "    if (i < n4) {\r\n\u001b[?2004l\r"]
[1067.33889, "o", "\u001b[?2004h> "]
[1067.338936, "o", "      float4 v = xr[i];\r\n\u001b[?2004l\r"]
[1067.33895, "o", "\u001b[?2004h> "]
[1067.338995, "o", "      float4 wv = w[i];\r\n\u001b[?2004l\r"]
[1067.339013, "o", "\u001b[?2004h> "]
[1067.339055, "o", "      float4 bv = b[i];\r\n\u001b[?2004l\r"]
[1067.339069, "o", "\u001b[?2004h> "]
[1067.339107, "o", "      float4 o;\r\n\u001b[?2004l\r"]
[1067.339123, "o", "\u001b[?2004h> "]
[1067.339202, "o", "      o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1067.339217, "o", "\u001b[?2004h> "]
[1067.339297, "o", "      o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1067.339313, "o", "\u001b[?2004h> "]
[1067.339392, "o", "      o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1067.339405, "o", "\u001b[?2004h> "]
[1067.339488, "o", "      o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1067.339503, "o", "\u001b[?2004h> "]
[1067.339536, "o", "      yr[i] = o;\r\n\u001b[?2004l\r"]
[1067.339556, "o", "\u001b[?2004h> "]
[1067.33957, "o", "    }\r\n\u001b[?2004l\r"]
[1067.339585, "o", "\u001b[?2004h> "]
[1067.339601, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.339619, "o", "> }\r\n\u001b[?2004l\r"]
[1067.339634, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1067.33965, "o", "\u001b[?2004h"]
[1067.339665, "o", "> "]
[1067.339861, "o", "torch::Tensor ln2(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long t1, long t2) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.339879, "o", "> "]
[1067.339929, "o", "  auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[1067.339949, "o", "\u001b[?2004h> "]
[1067.339985, "o", "  long D = w.numel();\r\n\u001b[?2004l\r"]
[1067.340005, "o", "\u001b[?2004h> "]
[1067.340048, "o", "  long B = x.numel() / D;\r\n\u001b[?2004l\r"]
[1067.340067, "o", "\u001b[?2004h> "]
[1067.340115, "o", "  int n4 = (int)(D / 4);\r\n\u001b[?2004l\r"]
[1067.340134, "o", "\u001b[?2004h> "]
[1067.340231, "o", "  auto partials = torch::empty({B * nb1 * 2}, x.options());\r\n\u001b[?2004l\r"]
[1067.340245, "o", "\u001b[?2004h> "]
[1067.340346, "o", "  cudaStream_t stream = c10::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1067.340365, "o", "\u001b[?2004h> "]
[1067.34044, "o", "  int chunks1 = (n4 + (int)t1 - 1) / (int)t1;\r\n\u001b[?2004l\r"]
[1067.340455, "o", "\u001b[?2004h> "]
[1067.34054, "o", "  int cpb1 = (chunks1 + (int)nb1 - 1) / (int)nb1;\r\n\u001b[?2004l\r"]
[1067.340554, "o", "\u001b[?2004h> "]
[1067.340653, "o", "  dim3 g1((unsigned)nb1, (unsigned)B), b1((unsigned)t1);\r\n\u001b[?2004l\r"]
[1067.340668, "o", "\u001b[?2004h> "]
[1067.340884, "o", "  k1<<<g1, b1, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, cpb1);\r\n\u001b[?2004l\r"]
[1067.3409, "o", "\u001b[?2004h> "]
[1067.340995, "o", "  dim3 g2((unsigned)nb2, (unsigned)B), b2((unsigned)t2);\r\n\u001b[?2004l\r"]
[1067.34101, "o", "\u001b[?2004h> "]
[1067.341153, "o", "  k2<<<g2, b2, 0, stream>>>(reinterpret_cast<const float4*>(x.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1067.34117, "o", "\u001b[?2004h> "]
[1067.341352, "o", "      reinterpret_cast<const float4*>(w.data_ptr<float>()), reinterpret_cast<const float4*>(b.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1067.341371, "o", "\u001b[?2004h> "]
[1067.341545, "o", "      reinterpret_cast<float4*>(y.data_ptr<float>()), partials.data_ptr<float>(), n4, (int)nb1, (float)eps);\r\n\u001b[?2004l\r"]
[1067.34156, "o", "\u001b[?2004h> "]
[1067.341586, "o", "  return y;\r\n\u001b[?2004l\r"]
[1067.341599, "o", "\u001b[?2004h> "]
[1067.341614, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.34163, "o", "> "]
[1067.341643, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.341665, "o", "> "]
[1067.34186, "o", "cpp = \"torch::Tensor ln2(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, long nb1, long nb2, long t1, long t2);\"\r\n\u001b[?2004l\r"]
[1067.341874, "o", "\u001b[?2004h> "]
[1067.342176, "o", "ext = load_inline(name='ln_v4probe', cpp_sources=cpp, cuda_sources=cuda_src, functions=['ln2'], extra_cuda_cflags=['-O3','--use_fast_math','-std=c++17'], verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1067.342261, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1067.342279, "o", "\u001b[?2004h> "]
[1067.342351, "o", "w = torch.ones(64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1067.342366, "o", "\u001b[?2004h> "]
[1067.342439, "o", "b = torch.zeros(64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1067.342454, "o", "\u001b[?2004h> "]
[1067.342566, "o", "yr = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\r\n\u001b[?2004l\r"]
[1067.342578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1067.342601, "o", "\u001b[?2004h> "]
[1067.342633, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[1067.342654, "o", "\u001b[?2004h> "]
[1067.342811, "o", "    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda'); d.fill_(0); return d\r\n\u001b[?2004l\r\u001b[?2004h"]
[1067.342827, "o", "> \r\n\u001b[?2004l\r"]
[1067.342842, "o", "\u001b[?2004h> "]
[1067.342882, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[1067.342897, "o", "\u001b[?2004h> "]
[1067.342989, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1067.343003, "o", "\u001b[?2004h> "]
[1067.343026, "o", "    ts=[]\r\n\u001b[?2004l\r"]
[1067.34304, "o", "\u001b[?2004h> "]
[1067.343084, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1067.343102, "o", "\u001b[?2004h> "]
[1067.343162, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1067.34318, "o", "\u001b[?2004h> "]
[1067.343324, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1067.343339, "o", "\u001b[?2004h> "]
[1067.343383, "o", "        dummy=clear_l2()\r\n\u001b[?2004l\r"]
[1067.343397, "o", "\u001b[?2004h> "]
[1067.343503, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1067.343518, "o", "\u001b[?2004h> "]
[1067.343583, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1067.343603, "o", "\u001b[?2004h> "]
[1067.343626, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[1067.343641, "o", "\u001b[?2004h> "]
[1067.343689, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1067.343703, "o", "\u001b[?2004h> \r\n"]
[1067.343718, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1067.343732, "o", "> "]
[1067.343746, "o", "res=[]\r\n\u001b[?2004l\r"]
[1067.34376, "o", "\u001b[?2004h> "]
[1067.343875, "o", "for nb1,t1 in [(256,256),(512,256),(1024,256),(512,512),(1024,512)]:\r\n\u001b[?2004l\r"]
[1067.343889, "o", "\u001b[?2004h> "]
[1067.344026, "o", "    for nb2,t2 in [(128,256),(256,256),(512,256),(256,512),(512,512),(1024,256)]:\r\n\u001b[?2004l\r"]
[1067.34404, "o", "\u001b[?2004h> "]
[1067.344126, "o", "        y = ext.ln2(x,w,b,1e-5,nb1,nb2,t1,t2)\r\n\u001b[?2004l\r"]
[1067.344141, "o", "\u001b[?2004h> "]
[1067.344239, "o", "        ok = torch.allclose(y, yr, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1067.344254, "o", "\u001b[?2004h> "]
[1067.344323, "o", "        md = (y-yr).abs().max().item()\r\n\u001b[?2004l\r"]
[1067.344337, "o", "\u001b[?2004h> "]
[1067.34444, "o", "        t = bench(lambda: ext.ln2(x,w,b,1e-5,nb1,nb2,t1,t2))\r\n\u001b[?2004l\r"]
[1067.34446, "o", "\u001b[?2004h> "]
[1067.344531, "o", "        res.append((t,nb1,nb2,t1,t2,ok,md))\r\n\u001b[?2004l\r"]
[1067.344545, "o", "\u001b[?2004h> "]
[1067.34457, "o", "res.sort()\r\n\u001b[?2004l\r"]
[1067.344584, "o", "\u001b[?2004h> "]
[1067.344622, "o", "for r in res[:10]:\r\n\u001b[?2004l\r"]
[1067.344636, "o", "\u001b[?2004h> "]
[1067.344801, "o", "    print(f't={r[0]:.4f}ms nb1={r[1]} nb2={r[2]} t1={r[3]} t2={r[4]} ok={r[5]} maxdiff={r[6]:.2e}')\r\n\u001b[?2004l\r"]
[1067.344818, "o", "\u001b[?2004h> "]
[1067.344839, "o", "EOF\r\n\u001b[?2004l\r"]
[1067.345731, "o", "\u001b[?2004hroot@modal:/workspace# "]
