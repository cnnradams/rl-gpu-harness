[1067.328697, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1067.328717, "i", "n(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        dummy=clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nres=[]\nfor nb1,t1 in [(256,256),(512,256),(1024,256),(512,512),(1024,512)]:\n    for nb2,t2 in [(128,256),(256,256),(512,256),(256,512),(512,512),(1024,256)]:\n        y = ext.ln2(x,w,b,1e-5,nb1,nb2,t1,t2)\n        ok = torch.allclose(y, yr, atol=1e-4, rtol=1e-4)\n        md = (y-yr).abs().max().item()\n        t = bench(lambda: ext.ln2(x,w,b,1e-5,nb1,nb2,t1,t2))\n        res.append((t,nb1,nb2,t1,t2,ok,md))\nres.sort()\nfor r in res[:10]:\n    print(f't={r[0]:.4f}ms nb1={r[1]} nb2={r[2]} t1={r[3]} t2={r[4]} ok={r[5]} maxdiff={r[6]:.2e}')\nEOF\ngpu push sb-hAtZWLe3Il0aB8AUAFLlPb /workspace/prof3.py /workspace/prof3.py && gpu exec sb-hAtZWLe3Il0aB8AUAFLlPb --timeout 400 -- python"]
