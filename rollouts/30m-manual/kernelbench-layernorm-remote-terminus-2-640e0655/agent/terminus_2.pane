[?2004l:[?2004h> // single-pass cooperative LN: each row handled by NBX blocks, NREG float4 per thread
[?2004l[?2004h> #define NBX 128
[?2004ll[?2004h> #define NTHREADS 256
[?2004ls[?2004h> #define NREG 8
[?2004lr[?2004h> 
[?2004lc[?2004h> __global__ void ln_coop(const float4* __restrict__ x, const float4* __restrict__ w,
[?2004l[?2004h>                         const float4* __restrict__ b, float4* __restrict__ y,
[?2004l[?2004h>                         float* __restrict__ partials, float* __restrict__ stats,
[?2004lr[?2004h>                         int n4, float eps) {
