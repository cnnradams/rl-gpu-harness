[?2004l[?2004h>     C_ptr = C + rm[:, None] * scm + rn[None, :] * scn
[?2004l[?2004h>     tl.store(C_ptr, acc)
[?2004l[?2004h> 
[?2004l[?2004h> def run_k2(BM, BN, BK, GROUP, nw, ns):
[?2004l[?2004h>     y = torch.empty(M, N, device=device, dtype=torch.float32)
[?2004l[?2004h>     grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
[?2004l[?2004h>     def run():
