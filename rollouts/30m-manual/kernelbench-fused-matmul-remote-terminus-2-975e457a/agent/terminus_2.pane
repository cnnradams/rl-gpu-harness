[?2004l[?2004h>     s.record()
[?2004l[?2004h>     for _ in range(n):
[?2004l[?2004h>         fn()
[?2004l[?2004h>     e.record(); torch.cuda.synchronize()
[?2004l[?2004h>     return s.elapsed_time(e) / n
[?2004l[?2004h> 
[?2004l[?2004h> w15 = (w * 1.5).contiguous()
[?2004l[?2004h> bias15 = (b * 1.5).contiguous()
[?2004l[?2004h> w_hi = w15.half(); w_lo = (w15 - w_hi.float()).half()
[?2004l[?2004h> wt_hi = w_hi.t().contiguous(); wt_lo = w_lo.t().contiguous()
[?2004l[?2004h> M, K = x.shape
[?2004l[?2004h> N = O
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def k2(A, BH, BL, Bias, C, M, N, K,
[?2004l[?2004h>        sam, sak, scm, scn,
[?2004l[?2004h>        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):
