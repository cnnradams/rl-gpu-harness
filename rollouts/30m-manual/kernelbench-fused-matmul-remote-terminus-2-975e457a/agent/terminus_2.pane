[?2004l[?2004h>     num_pid_in_group = GROUP * num_pid_n
[?2004l[?2004h>     group_id = pid // num_pid_in_group
[?2004l[?2004h>     first_pid_m = group_id * GROUP
[?2004l[?2004h>     group_size_m = min(num_pid_m - first_pid_m, GROUP)
[?2004l[?2004h>     pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)
[?2004l[?2004h>     pid_n = (pid % num_pid_in_group) // group_size_m
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
