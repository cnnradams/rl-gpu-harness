[1196.698452, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1196.698491, "o", "\u001b[?2004h> "]
[1196.698591, "o", "    BH_ptr = BH + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1196.698628, "o", "\u001b[?2004h> "]
