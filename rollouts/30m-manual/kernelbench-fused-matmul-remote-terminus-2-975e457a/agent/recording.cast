[962.508494, "o", "\u001b[?2004h"]
[962.508515, "o", "> "]
[962.508589, "o", "    (128, 256, 64, 8, 8, 2, True),\r\n\u001b[?2004l\r"]
[962.50862, "o", "\u001b[?2004h> "]
[962.5087, "o", "    (128, 256, 64, 8, 8, 2, False),\r\n\u001b[?2004l\r"]
[962.508724, "o", "\u001b[?2004h> "]
