[770.276292, "o", "lin = torch.nn.Linear(I, O).to(device)\r\n\u001b[?2004l\r"]
[770.276316, "o", "\u001b[?2004h> "]
[770.276464, "o", "w, b = lin.weight.detach().clone(), lin.bias.detach().clone()\r\n\u001b[?2004l\r"]
[770.276499, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.276525, "o", "\u001b[?2004h> "]
[770.276632, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[770.276664, "o", "\u001b[?2004h> "]
[770.276765, "o", "ref32 = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[770.276815, "o", "\u001b[?2004h> "]
[770.276876, "o", "ref = ref32 * 0.5 + ref32\r\n\u001b[?2004l\r"]
[770.276901, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.276916, "o", "\u001b[?2004h"]
[770.27694, "o", "> "]
[770.276981, "o", "def check(name, y):\r\n\u001b[?2004l\r"]
[770.277005, "o", "\u001b[?2004h> "]
[770.277083, "o", "    diff = (y - ref).abs()\r\n\u001b[?2004l\r"]
[770.277107, "o", "\u001b[?2004h> "]
[770.277199, "o", "    denom = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[770.277224, "o", "\u001b[?2004h> "]
[770.27732, "o", "    frac = (diff / denom).max().item()\r\n\u001b[?2004l\r"]
[770.277344, "o", "\u001b[?2004h> "]
[770.277472, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[770.277497, "o", "\u001b[?2004h> "]
[770.277631, "o", "    print(f\"{name}: frac_of_tol={frac:.4f} pass={ok}\")\r\n\u001b[?2004l\r"]
[770.277656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.277682, "o", "\u001b[?2004h> "]
[770.277748, "o", "def timeit(fn, n=200):\r\n\u001b[?2004l\r"]
[770.277773, "o", "\u001b[?2004h> "]
[770.277834, "o", "    for _ in range(20):\r\n\u001b[?2004l\r"]
[770.277866, "o", "\u001b[?2004h> "]
[770.27789, "o", "        fn()\r\n\u001b[?2004l\r"]
[770.277917, "o", "\u001b[?2004h> "]
[770.277995, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[770.278027, "o", "\u001b[?2004h> "]
[770.278169, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[770.278194, "o", "\u001b[?2004h> "]
[770.278236, "o", "    s.record()\r\n\u001b[?2004l\r"]
[770.278261, "o", "\u001b[?2004h> "]
[770.278322, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[770.278358, "o", "\u001b[?2004h> "]
[770.278405, "o", "        fn()\r\n\u001b[?2004l\r"]
[770.278423, "o", "\u001b[?2004h> "]
[770.278523, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[770.27854, "o", "\u001b[?2004h> "]
[770.278625, "o", "    return s.elapsed_time(e) / n\r\n\u001b[?2004l\r"]
[770.278652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.278674, "o", "\u001b[?2004h> "]
[770.278745, "o", "w15 = (w * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[770.278776, "o", "\u001b[?2004h> "]
[770.278836, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[770.278863, "o", "\u001b[?2004h> "]
[770.278903, "o", "w_hi = w15.half()\r\n\u001b[?2004l\r"]
[770.27893, "o", "\u001b[?2004h> "]
[770.27901, "o", "w_lo = (w15 - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[770.279041, "o", "\u001b[?2004h> "]
[770.279112, "o", "wt_hi = w_hi.t().contiguous()\r\n\u001b[?2004l\r"]
[770.279137, "o", "\u001b[?2004h> "]
[770.279212, "o", "wt_lo = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[770.279239, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.279265, "o", "\u001b[?2004h> "]
[770.279292, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[770.279323, "o", "\u001b[?2004h> "]
[770.2794, "o", "def k2(A, BH, BL, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[770.279431, "o", "\u001b[?2004h> "]
[770.27949, "o", "       sam, sak, scm, scn,\r\n\u001b[?2004l\r"]
[770.279518, "o", "\u001b[?2004h> "]
[770.279711, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.27974, "o", "> "]
[770.279789, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[770.279817, "o", "\u001b[?2004h> "]
[770.279885, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[770.279912, "o", "\u001b[?2004h> "]
[770.279982, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[770.279999, "o", "\u001b[?2004h> "]
[770.280107, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[770.280134, "o", "\u001b[?2004h> "]
[770.280222, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[770.280249, "o", "\u001b[?2004h> "]
[770.280327, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[770.28036, "o", "\u001b[?2004h> "]
[770.280477, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[770.280509, "o", "\u001b[?2004h> "]
[770.280656, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[770.280674, "o", "\u001b[?2004h> "]
[770.280818, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.280843, "o", "> "]
[770.280926, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[770.280953, "o", "\u001b[?2004h> "]
[770.281047, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[770.281079, "o", "\u001b[?2004h> "]
[770.281131, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[770.281158, "o", "\u001b[?2004h> "]
[770.281287, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[770.281315, "o", "\u001b[?2004h> "]
[770.281422, "o", "    BH_ptr = BH + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[770.281452, "o", "\u001b[?2004h> "]
[770.281558, "o", "    BL_ptr = BL + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[770.281585, "o", "\u001b[?2004h> "]
[770.28169, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[770.281717, "o", "\u001b[?2004h> "]
[770.281806, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[770.281832, "o", "\u001b[?2004h> "]
[770.281893, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[770.281923, "o", "\u001b[?2004h> "]
[770.281985, "o", "        bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[770.282007, "o", "\u001b[?2004h> "]
[770.282083, "o", "        bl = tl.load(BL_ptr)\r\n\u001b[?2004l\r"]
[770.28211, "o", "\u001b[?2004h> "]
[770.282182, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[770.282208, "o", "\u001b[?2004h> "]
[770.282334, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[770.282356, "o", "\u001b[?2004h> "]
[770.282443, "o", "        acc = tl.dot(a_hi, bh, acc)\r\n\u001b[?2004l\r"]
[770.282472, "o", "\u001b[?2004h> "]
[770.28255, "o", "        acc = tl.dot(a_hi, bl, acc)\r\n\u001b[?2004l\r"]
[770.28258, "o", "\u001b[?2004h> "]
[770.282658, "o", "        acc = tl.dot(a_lo, bh, acc)\r\n\u001b[?2004l\r"]
[770.282685, "o", "\u001b[?2004h> "]
[770.282743, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[770.28277, "o", "\u001b[?2004h> "]
[770.282825, "o", "        BH_ptr += BK * N\r\n\u001b[?2004l\r"]
[770.282853, "o", "\u001b[?2004h> "]
[770.282908, "o", "        BL_ptr += BK * N\r\n\u001b[?2004l\r"]
[770.282938, "o", "\u001b[?2004h> "]
[770.283002, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[770.283029, "o", "\u001b[?2004h> "]
[770.283102, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[770.283133, "o", "\u001b[?2004h> "]
[770.283249, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[770.283277, "o", "\u001b[?2004h> "]
[770.283333, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[770.283359, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.283376, "o", "\u001b[?2004h> "]
[770.283473, "o", "def run_k2(BM, BN, BK, GROUP, nw, ns):\r\n\u001b[?2004l\r"]
[770.2835, "o", "\u001b[?2004h> "]
[770.283542, "o", "    M, K = x.shape\r\n\u001b[?2004l\r"]
[770.283569, "o", "\u001b[?2004h> "]
[770.2836, "o", "    N = O\r\n\u001b[?2004l\r"]
[770.283623, "o", "\u001b[?2004h> "]
[770.283766, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[770.283793, "o", "\u001b[?2004h> "]
[770.283926, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[770.283957, "o", "\u001b[?2004h> "]
[770.283986, "o", "    def run():\r\n\u001b[?2004l\r"]
[770.284022, "o", "\u001b[?2004h> "]
[770.28414, "o", "        k2[grid](x, wt_hi, wt_lo, b15, y, M, N, K,\r\n\u001b[?2004l\r"]
[770.284169, "o", "\u001b[?2004h> "]
[770.284325, "o", "                 x.stride(0), x.stride(1), y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[770.284353, "o", "\u001b[?2004h> "]
[770.284504, "o", "                 BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[770.28453, "o", "\u001b[?2004h> "]
[770.284572, "o", "        return y\r\n\u001b[?2004l\r"]
[770.284599, "o", "\u001b[?2004h> "]
[770.284636, "o", "    return run\r\n\u001b[?2004l\r"]
[770.284664, "o", "\u001b[?2004h> \r\n"]
[770.284682, "o", "\u001b[?2004l\r\u001b[?2004h"]
[770.284703, "o", "> "]
[770.284728, "o", "configs = [\r\n\u001b[?2004l\r"]
[770.284749, "o", "\u001b[?2004h> "]
[770.284832, "o", "    (256,128,32,8,8,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.28486, "o", "> "]
[770.284911, "o", "    (256,128,32,8,8,5),\r\n\u001b[?2004l\r"]
[770.284931, "o", "\u001b[?2004h> "]
[770.284995, "o", "    (256,128,64,8,8,2),\r\n\u001b[?2004l\r"]
[770.285028, "o", "\u001b[?2004h> "]
[770.285087, "o", "    (128,128,32,8,4,5),\r\n\u001b[?2004l\r"]
[770.285118, "o", "\u001b[?2004h> "]
[770.285171, "o", "    (128,128,64,8,4,4),\r\n\u001b[?2004l\r"]
[770.285197, "o", "\u001b[?2004h> "]
[770.285258, "o", "    (128,128,128,8,8,2),\r\n\u001b[?2004l\r"]
[770.285284, "o", "\u001b[?2004h> "]
[770.285346, "o", "    (256,128,128,8,8,2),\r\n\u001b[?2004l\r"]
[770.285373, "o", "\u001b[?2004h> "]
[770.285428, "o", "    (128,64,64,8,4,5),\r\n\u001b[?2004l\r"]
[770.285455, "o", "\u001b[?2004h> "]
[770.28551, "o", "    (64,128,64,8,4,5),\r\n\u001b[?2004l\r"]
[770.285537, "o", "\u001b[?2004h> "]
[770.285592, "o", "    (256,64,32,4,4,5),\r\n\u001b[?2004l\r"]
[770.285617, "o", "\u001b[?2004h> "]
[770.285639, "o", "]\r\n\u001b[?2004l\r"]
[770.285655, "o", "\u001b[?2004h> "]
[770.285737, "o", "for (BM,BN,BK,G,nw,ns) in configs:\r\n\u001b[?2004l\r"]
[770.285768, "o", "\u001b[?2004h> "]
[770.285789, "o", "    try:\r\n\u001b[?2004l\r"]
[770.285807, "o", "\u001b[?2004h> "]
[770.285906, "o", "        run = run_k2(BM,BN,BK,G,nw,ns)\r\n\u001b[?2004l\r"]
[770.285933, "o", "\u001b[?2004h> "]
[770.285977, "o", "        y = run()\r\n\u001b[?2004l\r"]
[770.286004, "o", "\u001b[?2004h> "]
[770.286128, "o", "        check(f'K2 {BM}x{BN}x{BK} w{nw} s{ns}', y)\r\n\u001b[?2004l\r"]
[770.286154, "o", "\u001b[?2004h> "]
[770.286254, "o", "        print(f'  ms: {timeit(run):.4f}')\r\n\u001b[?2004l\r"]
[770.286281, "o", "\u001b[?2004h> "]
[770.286348, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[770.286375, "o", "\u001b[?2004h> "]
[770.286536, "o", "        print(f'K2 {BM},{BN},{BK},{nw},{ns} failed: {str(e)[:80]}')\r\n\u001b[?2004l\r"]
[770.286563, "o", "\u001b[?2004h> "]
[770.286586, "o", "EOF\r\n\u001b[?2004l\r"]
[770.287841, "o", "\u001b[?2004hroot@modal:/workspace# "]
[770.576442, "i", "gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench5.py /workspace/bench5.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench5.py\n"]
[770.576982, "o", "gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench5.py /workspace/bench5.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench5.py\r\n\u001b[?2004l\r"]
[774.263076, "o", "{\r\n  \"bytes\": 3389,\r\n  \"sha256\": \"3ee4fcb3f1068abf19b68b93eb651aa902067253bbcdb0623be3e32649974c74\"\r\n}\r\n"]
[774.40097, "o", "request ID: cfd2873c565e4df992535af3be5d1dba\r\n"]
[778.276003, "o", "command: ec9ea0ba4ee440f5a3011ce139c73846\r\n"]
[792.463267, "o", "K2 256x128x32 w8 s4: frac_of_tol=0.2220 pass=True\r\n  ms: 2.7241\r\nK2 256x128x32 w8 s5: frac_of_tol=0.2220 pass=True\r\n  ms: 2.7703\r\nK2 256x128x64 w8 s2: frac_of_tol=0.2229 pass=True\r\n  ms: 3.4997\r\nK2 128x128x32 w4 s5: frac_of_tol=0.2220 pass=True\r\n  ms: 4.3016\r\nK2 128x128x64 w4 s4: frac_of_tol=0.2229 pass=True\r\n  ms: 3.4393\r\nK2 128x128x128 w8 s2: frac_of_tol=0.2268 pass=True\r\n  ms: 3.7725\r\nK2 256,128,128,8,2 failed: out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reduci\r\nK2 128x64x64 w4 s5: frac_of_tol=0.2229 pass=True\r\n  ms: 4.0060\r\nK2 64x128x64 w4 s5: frac_of_tol=0.2229 pass=True\r\n  ms: 3.4937\r\nK2 256x64x32 w4 s5: frac_of_tol=0.2220 pass=True\r\n  ms: 3.7401\r\n"]
[793.29088, "o", "\u001b[?2004hroot@modal:/workspace# "]
[836.087177, "i", "gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 -c \"import triton, torch; print('triton', triton.__version__); print('torch', torch.__version__); import triton.language as tl; print('desc', hasattr(tl, 'make_tensor_descriptor')); print('ws', 'warp_specialize' in tl.range.__init__.__code__.co_varnames if hasattr(tl.range,'__init__') else 'n/a')\"\n"]
[836.088063, "o", "gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 -c \"import triton, torch; print('triton', triton.__version__); print('torch', torch.__version__); import triton.language as tl; print('desc', hasattr(tl, 'make_tensor_descriptor')); print('ws', 'warp_specialize' in tl.range.__init__.__code__.co_varnames if hasattr(tl.range,'__init__') else 'n/a')\"\r\n\u001b[?2004l\r"]
[836.207612, "o", "request ID: f2194b5495724e71b7d7e044a01fa140\r\n"]
[838.400267, "o", "command: dcc8d8d1b8d046c380623ed8ad2c417f\r\n"]
[839.276867, "o", "triton 3.5.0\r\ntorch 2.9.0+cu128\r\ndesc True\r\nws True\r\n"]
