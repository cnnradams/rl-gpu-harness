[1040.168386, "o", "\u001b[?2004h> "]
[1040.168489, "o", "            bb = b_desc.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1040.168509, "o", "\u001b[?2004h> "]
[1040.168657, "o", "            acc = tl.dot(a, bb, acc, input_precision='tf32x3')\r\n\u001b[?2004l\r"]
[1040.168677, "o", "\u001b[?2004h> "]
[1040.168847, "o", "        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
