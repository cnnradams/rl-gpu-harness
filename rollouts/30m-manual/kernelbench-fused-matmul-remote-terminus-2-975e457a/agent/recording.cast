[1040.170647, "o", "\u001b[?2004h> "]
[1040.170671, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1040.171159, "o", "for (BM, BN, BK, G, nw, ns, ws) in [(128,256,64,8,8,2,True),(128,256,64,8,8,3,True),(256,128,64,8,8,2,True),(128,128,64,8,8,3,True),(128,256,64,8,8,2,False),(128,256,64,8,4,2,True),(64,256,64,8,4,3,True)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1040.171189, "o", "> "]
[1040.171207, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1040.171227, "o", "> "]
