[1040.159101, "o", "        GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1040.159129, "o", "\u001b[?2004h> "]
[1040.159255, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1040.159276, "o", "\u001b[?2004h> "]
[1040.15941, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1040.159431, "o", "\u001b[?2004h> "]
[1040.159557, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1040.159577, "o", "\u001b[?2004h> "]
[1040.159695, "o", "    k_tiles = tl.cdiv(K, BK)\r\n\u001b[?2004l\r"]
[1040.159716, "o", "\u001b[?2004h> "]
[1040.15988, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r"]
[1040.1599, "o", "\u001b[?2004h"]
[1040.159919, "o", "> "]
[1040.160286, "o", "    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\r\n\u001b[?2004l\r"]
[1040.160311, "o", "\u001b[?2004h> "]
[1040.160493, "o", "        num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1040.160518, "o", "\u001b[?2004h> "]
[1040.160716, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[1040.160745, "o", "\u001b[?2004h> "]
[1040.16092, "o", "        first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[1040.16094, "o", "\u001b[?2004h> "]
[1040.16118, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[1040.161203, "o", "\u001b[?2004h> "]
[1040.161364, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[1040.161387, "o", "\u001b[?2004h> "]
[1040.161527, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1040.161547, "o", "\u001b[?2004h> "]
[1040.161616, "o", "        offs_am = pid_m * BM\r\n\u001b[?2004l\r"]
[1040.161635, "o", "\u001b[?2004h> "]
[1040.161706, "o", "        offs_bn = pid_n * BN\r\n\u001b[?2004l\r"]
[1040.161727, "o", "\u001b[?2004h> "]
[1040.161853, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1040.161874, "o", "\u001b[?2004h> "]
[1040.161954, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[1040.161974, "o", "\u001b[?2004h> "]
[1040.162046, "o", "            offs_k = ki * BK\r\n\u001b[?2004l\r"]
[1040.162067, "o", "\u001b[?2004h> "]
[1040.162201, "o", "            a_hi = ah_desc.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[1040.162232, "o", "\u001b[?2004h> "]
