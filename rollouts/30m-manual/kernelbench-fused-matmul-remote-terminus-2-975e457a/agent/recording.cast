[280.349365, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\ntorch.backends.cuda.matmul.allow_tf32 = False\nref32 = torch.nn.functional.linear(x, w, b)\nref = ref32 * 0.5 + ref32\n\ndef check(name, y):\n    diff = (y - ref).abs()\n    denom = 1e-4 + 1e-4 * ref.abs()\n    frac = (diff / denom).max().item()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.4f} pass={ok}\")\n\ndef timeit(fn, n=100):\n    for _ in range(10):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\nw15 = w * 1.5\nb15 = b * 1.5\n\n# tf32x3 decomposition\ntorch.backends.cuda.matmul.allow_tf32 = True\nimport torch.backe"]
[280.349442, "i", "nds.cuda.matmul as M\nprint('fp32_precision API:', getattr(M, 'fp32_precision', 'n/a'))\n\nx_tf = x  # will be rounded internally\n# split into hi/lo in tf32 representation: tf32 has 19 bits total; hi = round-to-tf32(x)\n# emulate: hi = (x viewed as tf32). In torch, we can round to tf32 by truncating mantissa to 10 bits.\ndef to_tf32(t):\n    i = t.view(torch.int32)\n    mask = ~((1 << 13) - 1)\n    hi_i = (i + (1 << 12)) & mask  # round-to-nearest-ish\n    hi = hi_i.view(torch.float32)\n    return hi\n\nx_hi = to_tf32(x)\nx_lo = x - x_hi\nw_hi = to_tf32(w15)\nw_lo = w15 - w_hi\nwt_hi = w_hi.t().contiguous()\nwt_lo = w_lo.t().contiguous()\nwt15 = w15.t().contiguous()\n\ndef tf32x3():\n    y = torch.mm(x_hi, wt_hi)\n    y = torch.addmm(y, x_hi, wt_lo)\n    y = torch.addmm(y, x_lo, wt_hi)\n    return y + b15\n\ny = tf32x3()\ncheck('tf32x3', y)\nprint('tf32x3 ms:', timeit(tf32x3))\n\ndef tf32single():\n    return torch.addmm(b15, x, wt15)\ncheck('tf32 single', tf32single())\nprint('tf32 single ms:', timeit(tf32single))\ntorch.backends.cuda.matmul"]
[280.349577, "i", ".allow_tf32 = False\nEOF\n"]
