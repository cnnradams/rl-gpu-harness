[342.138292, "o", "sed -i '/import torch.backends.cuda.matmul as M/d; /fp32_precision API/d' /workspace/bench2.py && gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench2.py /workspace/bench2.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench2.py\r\n\u001b[?2004l\r"]
[344.341085, "o", "{\r\n  \"bytes\": 1927,\r\n  \"sha256\": \"a342b0e8c30481fd675b341b334d651ead0e73d9cab57cd75965cff9ebd1de2d\"\r\n}\r\n"]
[344.484505, "o", "request ID: 221ffcd5b5474bfe82c93c2ee9e4c214\r\n"]
[347.864853, "o", "command: 7332804cf2044f1bba5f117daf871269\r\n"]
[349.435601, "o", "tf32x3: max_diff=3.028e-05 frac_of_tol=0.1429 pass=True\r\ntf32x3 ms: 5.94582275390625\r\ntf32 single: max_diff=7.837e-04 frac_of_tol=6.9721 pass=False\r\ntf32 single ms: 1.7692668151855468\r\n"]
[350.270311, "o", "\u001b[?2004hroot@modal:/workspace# "]
[488.720858, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\ntorch.backends.cuda.matmul.allow_tf32 = False\nref32 = torch.nn.functional.linear(x, w, b)\nref = ref32 * 0.5 + ref32\n\ndef check(name, y):\n    diff = (y - ref).abs()\n    denom = 1e-4 + 1e-4 * ref.abs()\n    frac = (diff / denom).max().item()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.4f} pass={ok}\")\n\ndef timeit(fn, n=100):\n    for _ in range(10):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\nw15 = (w * 1.5).contiguous()\nb15 = (b * 1.5).contiguous()\n\ntorch.backend"]
[488.720986, "i", "s.cuda.matmul.allow_fp16_reduced_precision_reduction = False\nw_hi = w15.half()\nw_lo = (w15 - w_hi.float()).half()\nwt_hi = w_hi.t().contiguous()\nwt_lo = w_lo.t().contiguous()\n\ndef fp16x3():\n    x_hi = x.half()\n    x_lo = (x - x_hi.float()).half()\n    y = torch.mm(x_hi, wt_hi)\n    y = torch.addmm(y, x_hi, wt_lo)\n    y = torch.addmm(y, x_lo, wt_hi)\n    return y + b15\n\ncheck('fp16x3 torch', fp16x3())\nprint('fp16x3 torch ms:', timeit(fp16x3))\n\n@triton.jit\ndef fp16x3_kernel(A, Bm, Bias, C, M, N, K,\n                  sam, sak, sbk, sbn, scm, scn,\n                  BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                  GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) //"]
[488.721018, "i", " group_size_m\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = Bm + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(A_ptr)\n        bb = tl.load(B_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = bb.to(tl.float16)\n        b_lo = (bb - b_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        A_ptr += BK * sak\n        B_ptr += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef triton_fp16x3(BM=128, BN=128, BK=64, GROUP=8, nw=8, ns=3):\n    M, K = x.shape\n    N = O\n    y = torch.empty(M, N, device=device, dtype=torch.float32)\n    grid = (trito"]
[488.721046, "i", "n.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def run():\n        fp16x3_kernel[grid](x, w15.t(), b15, y, M, N, K,\n                            x.stride(0), x.stride(1), w15.t().stride(0), w15.t().stride(1),\n                            y.stride(0), y.stride(1),\n                            BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\n        return y\n    return run\n\nfor (BM, BN, BK, nw, ns) in [(128,128,64,8,3), (128,256,64,8,3), (256,128,64,8,3), (128,128,32,4,4)]:\n    try:\n        run = triton_fp16x3(BM, BN, BK, 8, nw, ns)\n        y = run()\n        check(f'triton {BM}x{BN}x{BK} w{nw} s{ns}', y)\n        print(f'  ms:', timeit(run))\n    except Exception as e:\n        print(f'config {BM},{BN},{BK},{nw},{ns} failed: {e}')\nEOF\n"]
