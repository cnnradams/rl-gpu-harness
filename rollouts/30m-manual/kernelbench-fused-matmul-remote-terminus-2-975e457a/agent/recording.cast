[882.172098, "o", "import torch\r\n\u001b[?2004l\r"]
[882.172123, "o", "\u001b[?2004h> "]
[882.172163, "o", "import triton\r\n\u001b[?2004l\r"]
[882.172188, "o", "\u001b[?2004h> "]
[882.17226, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[882.172296, "o", "\u001b[?2004h> "]
[882.17232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[882.172391, "o", "B, I, O = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[882.172414, "o", "\u001b[?2004h> "]
[882.172455, "o", "device = 'cuda'\r\n\u001b[?2004l\r"]
[882.172478, "o", "\u001b[?2004h> "]
[882.172541, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[882.172565, "o", "\u001b[?2004h> "]
[882.172656, "o", "x = torch.rand(B, I, device=device)\r\n\u001b[?2004l\r"]
[882.172682, "o", "\u001b[?2004h> "]
[882.172811, "o", "lin = torch.nn.Linear(I, O).to(device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[882.172982, "o", "w, b = lin.weight.detach().clone(), lin.bias.detach().clone()\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.173009, "o", "> \r\n\u001b[?2004l\r"]
[882.173033, "o", "\u001b[?2004h> "]
[882.173137, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[882.173161, "o", "\u001b[?2004h> "]
[882.17327, "o", "ref32 = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[882.173293, "o", "\u001b[?2004h> "]
[882.173366, "o", "ref = ref32 * 0.5 + ref32\r\n\u001b[?2004l\r"]
[882.17339, "o", "\u001b[?2004h> \r\n"]
[882.173414, "o", "\u001b[?2004l\r\u001b[?2004h"]
[882.173437, "o", "> "]
[882.173484, "o", "def check(name, y):\r\n\u001b[?2004l\r"]
[882.173508, "o", "\u001b[?2004h> "]
[882.173579, "o", "    diff = (y - ref).abs()\r\n\u001b[?2004l\r"]
[882.173604, "o", "\u001b[?2004h> "]
[882.173694, "o", "    denom = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[882.173717, "o", "\u001b[?2004h> "]
[882.17382, "o", "    frac = (diff / denom).max().item()\r\n\u001b[?2004l\r"]
[882.173844, "o", "\u001b[?2004h> "]
[882.173978, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[882.174002, "o", "\u001b[?2004h> "]
[882.174139, "o", "    print(f\"{name}: frac_of_tol={frac:.4f} pass={ok}\")\r\n\u001b[?2004l\r"]
[882.174174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[882.174197, "o", "\u001b[?2004h> "]
[882.174257, "o", "def timeit(fn, n=200):\r\n\u001b[?2004l\r"]
[882.174281, "o", "\u001b[?2004h> "]
[882.174345, "o", "    for _ in range(20):\r\n\u001b[?2004l\r"]
[882.174369, "o", "\u001b[?2004h> "]
[882.174407, "o", "        fn()\r\n\u001b[?2004l\r"]
[882.174431, "o", "\u001b[?2004h> "]
[882.174509, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[882.174533, "o", "\u001b[?2004h> "]
[882.174678, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[882.174702, "o", "\u001b[?2004h> "]
[882.17474, "o", "    s.record()\r\n\u001b[?2004l\r"]
[882.174787, "o", "\u001b[?2004h> "]
[882.174853, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[882.174873, "o", "\u001b[?2004h> "]
[882.174914, "o", "        fn()\r\n\u001b[?2004l\r"]
[882.174933, "o", "\u001b[?2004h> "]
[882.175046, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[882.175078, "o", "\u001b[?2004h> "]
[882.175149, "o", "    return s.elapsed_time(e) / n\r\n\u001b[?2004l\r"]
[882.175182, "o", "\u001b[?2004h> \r\n"]
[882.175212, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[882.17528, "o", "w15 = (w * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[882.175301, "o", "\u001b[?2004h> "]
[882.175384, "o", "bias15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[882.175404, "o", "\u001b[?2004h> "]
[882.175455, "o", "w_hi = w15.half()\r\n\u001b[?2004l\r"]
[882.175485, "o", "\u001b[?2004h> "]
[882.175565, "o", "w_lo = (w15 - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[882.175586, "o", "\u001b[?2004h> "]
[882.175687, "o", "wt_hi = w_hi.t().contiguous()  # (K, N)\r\n\u001b[?2004l\r"]
[882.175708, "o", "\u001b[?2004h> "]
[882.175786, "o", "wt_lo = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[882.175806, "o", "\u001b[?2004h> "]
[882.175882, "o", "x_hi = x.half().contiguous()\r\n\u001b[?2004l\r"]
[882.175903, "o", "\u001b[?2004h> "]
[882.176022, "o", "x_lo = (x - x_hi.float()).half().contiguous()\r\n\u001b[?2004l\r"]
[882.176043, "o", "\u001b[?2004h> "]
[882.176087, "o", "M, K = x.shape\r\n\u001b[?2004l\r"]
[882.176117, "o", "\u001b[?2004h> "]
[882.176143, "o", "N = O\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.176163, "o", "> "]
[882.176348, "o", "# pack along K: A_pack (M, 2K) = [x_hi | x_lo]; B_pack (2K, N) = [wt_hi ; wt_lo]\r\n\u001b[?2004l\r"]
[882.17637, "o", "\u001b[?2004h> "]
[882.176494, "o", "A_pack = torch.cat([x_hi, x_lo], dim=1).contiguous()\r\n\u001b[?2004l\r"]
[882.176514, "o", "\u001b[?2004h> "]
[882.176648, "o", "B_pack = torch.cat([wt_hi, wt_lo], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[882.176669, "o", "\u001b[?2004h> \r\n"]
[882.176689, "o", "\u001b[?2004l\r\u001b[?2004h"]
[882.176709, "o", "> "]
[882.176735, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[882.176781, "o", "\u001b[?2004h> "]
[882.176914, "o", "def kpersist(a_desc, b_desc, bias_ptr, c_desc, M, N, K,\r\n\u001b[?2004l\r"]
[882.176935, "o", "\u001b[?2004h> "]
[882.177098, "o", "             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[882.177119, "o", "\u001b[?2004h> "]
[882.177299, "o", "             GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[882.177319, "o", "\u001b[?2004h> "]
[882.177403, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[882.177423, "o", "\u001b[?2004h> "]
[882.177504, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[882.177534, "o", "\u001b[?2004h> "]
[882.177614, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[882.177644, "o", "\u001b[?2004h> "]
[882.17771, "o", "    k_tiles = tl.cdiv(K, BK)\r\n\u001b[?2004l\r"]
[882.17774, "o", "\u001b[?2004h> "]
[882.177826, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r"]
[882.177847, "o", "\u001b[?2004h> "]
[882.178087, "o", "    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.17811, "o", "> "]
[882.178209, "o", "        num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[882.178229, "o", "\u001b[?2004h> "]
[882.178354, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.178375, "o", "> "]
[882.178461, "o", "        first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[882.178492, "o", "\u001b[?2004h> "]
[882.178624, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[882.178644, "o", "\u001b[?2004h> "]
[882.178779, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[882.178799, "o", "\u001b[?2004h> "]
[882.178946, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[882.178967, "o", "\u001b[?2004h> "]
[882.17905, "o", "        offs_am = pid_m * BM\r\n\u001b[?2004l\r"]
[882.179082, "o", "\u001b[?2004h> "]
[882.179146, "o", "        offs_bn = pid_n * BN\r\n\u001b[?2004l\r"]
[882.179167, "o", "\u001b[?2004h> "]
[882.179292, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[882.179312, "o", "\u001b[?2004h> "]
[882.179401, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[882.179422, "o", "\u001b[?2004h> "]
[882.179496, "o", "            offs_k = ki * BK\r\n\u001b[?2004l\r"]
[882.179526, "o", "\u001b[?2004h> "]
[882.179639, "o", "            a_hi = a_desc.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[882.179661, "o", "\u001b[?2004h> "]
[882.179791, "o", "            a_lo = a_desc.load([offs_am, offs_k + K])\r\n\u001b[?2004l\r"]
[882.179811, "o", "\u001b[?2004h> "]
[882.179932, "o", "            b_hi = b_desc.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[882.179953, "o", "\u001b[?2004h> "]
[882.18009, "o", "            b_lo = b_desc.load([offs_k + K, offs_bn])\r\n\u001b[?2004l\r"]
[882.180119, "o", "\u001b[?2004h> "]
[882.180215, "o", "            acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[882.180246, "o", "\u001b[?2004h> "]
[882.180339, "o", "            acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[882.18036, "o", "\u001b[?2004h> "]
[882.180464, "o", "            acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[882.180496, "o", "\u001b[?2004h> "]
[882.180633, "o", "        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[882.180663, "o", "\u001b[?2004h> "]
[882.180743, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[882.180763, "o", "\u001b[?2004h"]
[882.180803, "o", "> "]
[882.180897, "o", "        c_desc.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[882.180918, "o", "\u001b[?2004h> \r\n"]
[882.180945, "o", "\u001b[?2004l\r\u001b[?2004h"]
[882.180978, "o", "> "]
[882.181132, "o", "NUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.181164, "o", "> "]
[882.181207, "o", "print('SMs:', NUM_SMS)\r\n\u001b[?2004l\r"]
[882.181237, "o", "\u001b[?2004h> \r\n"]
[882.181253, "o", "\u001b[?2004l\r\u001b[?2004h"]
[882.181282, "o", "> "]
[882.181383, "o", "def run_persist(BM, BN, BK, GROUP, nw, ns, ws):\r\n\u001b[?2004l\r"]
[882.181409, "o", "\u001b[?2004h> "]
[882.181554, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[882.181584, "o", "\u001b[?2004h> "]
[882.181796, "o", "    a_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(A_pack, [BM, BK])\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.181826, "o", "> "]
[882.182031, "o", "    b_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(B_pack, [BK, BN])\r\n\u001b[?2004l\r"]
[882.182052, "o", "\u001b[?2004h> "]
[882.182255, "o", "    c_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(y, [BM, BN])\r\n\u001b[?2004l\r"]
[882.182285, "o", "\u001b[?2004h> "]
[882.182437, "o", "    grid = (min(NUM_SMS, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r"]
[882.182458, "o", "\u001b[?2004h> "]
[882.182498, "o", "    def run():\r\n\u001b[?2004l\r"]
[882.182528, "o", "\u001b[?2004h> "]
[882.18268, "o", "        kpersist[grid](a_desc, b_desc, bias15, c_desc, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.182711, "o", "> "]
[882.182892, "o", "                       BM, BN, BK, GROUP, NUM_SMS, ws, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[882.182912, "o", "\u001b[?2004h> "]
[882.182961, "o", "        return y\r\n\u001b[?2004l\r"]
[882.182987, "o", "\u001b[?2004h> "]
[882.183031, "o", "    return run\r\n\u001b[?2004l\r"]
[882.183051, "o", "\u001b[?2004h> \r\n"]
[882.183068, "o", "\u001b[?2004l\r"]
[882.183097, "o", "\u001b[?2004h> "]
[882.183126, "o", "configs = [\r\n\u001b[?2004l\r"]
[882.183155, "o", "\u001b[?2004h> "]
[882.183237, "o", "    (128, 256, 64, 8, 8, 3, True),\r\n\u001b[?2004l\r"]
[882.183257, "o", "\u001b[?2004h> "]
[882.183345, "o", "    (128, 256, 64, 8, 8, 3, False),\r\n\u001b[?2004l\r"]
[882.183375, "o", "\u001b[?2004h> "]
[882.183455, "o", "    (256, 128, 64, 8, 8, 3, True),\r\n\u001b[?2004l\r"]
[882.183475, "o", "\u001b[?2004h> "]
[882.183564, "o", "    (128, 256, 64, 8, 8, 4, True),\r\n\u001b[?2004l\r"]
[882.183584, "o", "\u001b[?2004h> "]
[882.183673, "o", "    (128, 128, 64, 8, 8, 4, True),\r\n\u001b[?2004l\r"]
[882.183693, "o", "\u001b[?2004h> "]
[882.183784, "o", "    (256, 256, 64, 8, 8, 2, True),\r\n\u001b[?2004l\r"]
[882.183806, "o", "\u001b[?2004h> "]
[882.183893, "o", "    (128, 256, 128, 8, 8, 2, True),\r\n\u001b[?2004l\r"]
[882.183913, "o", "\u001b[?2004h> "]
[882.183933, "o", "]\r\n\u001b[?2004l\r"]
[882.183953, "o", "\u001b[?2004h> "]
[882.18407, "o", "for (BM, BN, BK, G, nw, ns, ws) in configs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[882.184101, "o", "> "]
[882.184117, "o", "    try:\r\n\u001b[?2004l\r"]
[882.184136, "o", "\u001b[?2004h> "]
[882.184264, "o", "        run = run_persist(BM, BN, BK, G, nw, ns, ws)\r\n\u001b[?2004l\r"]
[882.184293, "o", "\u001b[?2004h> "]
[882.184339, "o", "        y = run()\r\n\u001b[?2004l\r"]
[882.18437, "o", "\u001b[?2004h> "]
[882.184508, "o", "        check(f'P {BM}x{BN}x{BK} w{nw} s{ns} ws{int(ws)}', y)\r\n\u001b[?2004l\r"]
[882.184538, "o", "\u001b[?2004h> "]
[882.184637, "o", "        print(f'  ms: {timeit(run):.4f}')\r\n\u001b[?2004l\r"]
[882.184657, "o", "\u001b[?2004h> "]
[882.184731, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[882.184751, "o", "\u001b[?2004h> "]
[882.184945, "o", "        print(f'P {BM},{BN},{BK},{nw},{ns},{ws} failed: {str(e)[:120]}')\r\n\u001b[?2004l\r"]
[882.184966, "o", "\u001b[?2004h> "]
[882.18499, "o", "EOF\r\n\u001b[?2004l\r"]
[882.186315, "o", "\u001b[?2004hroot@modal:/workspace# "]
[882.471432, "i", "gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench6.py /workspace/bench6.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench6.py\n"]
[882.471934, "o", "gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench6.py /workspace/bench6.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench6.py\r\n\u001b[?2004l\r"]
