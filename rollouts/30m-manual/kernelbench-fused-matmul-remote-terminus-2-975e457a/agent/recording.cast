[82.679064, "o", "\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef eval_kernel_against_ref\u001b[m\u001b[K(\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    original_model_src: str,\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    custom_model_src: str,\r\n\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    seed_num: int = 42,\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: int = 1,\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_perf_trials: int = 10,\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    measure_performance: bool = False,\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    timing_method: str = \"cuda_event\", # see timing.py\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    verbose: bool = False,\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    build_dir: os.PathLike = None,\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: Union[torch.device, int] = (\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.cuda.current_device() if torch.cuda.is_available() else None\r\n"]
[82.679111, "o", "\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ),  # have to run on GPU\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str = \"cuda\",  # can be 'cuda', 'triton', 'tilelang', or 'cute'\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype = torch.float32,\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Guard against potential reward hacking [optional but ongoing enhancement]\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    check_for_excessive_speedup: bool = True,\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    excessive_speedup_threshold: float = 10, # flag if the kernel is more than <excessive_speedup_threshold>x faster than the reference\r\n\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K) -> KernelExecResult:\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Evaluate the custom kernel against the original model\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    NOTE: we are thinking about refactor this to be more modularized \r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    and we can add more"]
[82.679143, "o", " checks as our other ongiong PRs are working on\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: number of trials to initialize different random inputs; correctness pass only if all trials pass\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_perf_trials: run the evalutation many times to take the average\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: GPU (cuda) device to run the evalutation on\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str, one of 'cuda', 'triton', 'tilelang', or 'cute'\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype for computation (note: tilelang only supports fp16)\r\n"]
