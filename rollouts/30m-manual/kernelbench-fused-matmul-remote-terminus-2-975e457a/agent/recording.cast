[165.731448, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch\n\ntorch.backends.cuda.matmul.allow_tf32 = False\ntorch.backends.cudnn.allow_tf32 = False\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\nref32 = (torch.nn.functional.linear(x, w, b))\nref = ref32 * 0.5 + ref32  # reference output (fp32)\n\n\ndef check(name, y):\n    diff = (y - ref).abs()\n    denom = 1e-4 + 1e-4 * ref.abs()\n    frac = (diff / denom).max().item()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.3f} pass={ok}\")\n\n\ndef timeit(fn, n=100):\n    for _ in range(10):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\n\n# ref timing\ndef ref_fn():\n    y = torch.nn"]
[165.7315, "i", ".functional.linear(x, w, b)\n    c = y.clone().detach()\n    return y * 0.5 + c\n\nw15 = w * 1.5\nb15 = b * 1.5\n\ndef folded():\n    return torch.nn.functional.linear(x, w15, b15)\n\ncheck('folded fp32', folded())\nprint('ref  ms:', timeit(ref_fn))\nprint('fold ms:', timeit(folded))\nprint('speedup:', timeit(ref_fn)/timeit(folded))\n\n# bf16x3 attempt\nx_hi = x.bfloat16(); x_lo = (x - x_hi.float()).bfloat16()\nw_hi = w15.bfloat16(); w_lo = (w15 - w_hi.float()).bfloat16()\n\ndef bf16x3():\n    y = torch.mm(x_hi, w_hi.t())\n    y = torch.addmm(y, x_hi, w_lo.t())\n    y = torch.addmm(y, x_lo, w_hi.t())\n    return y + b15\n\ny3 = bf16x3()\ncheck('bf16x3', y3)\nprint('bf16x3 ms:', timeit(bf16x3))\n\n# tf32 single\ntorch.backends.cuda.matmul.allow_tf32 = True\nyt = torch.nn.functional.linear(x, w15, b15)\ncheck('tf32', yt)\nprint('tf32 ms:', timeit(folded))\ntorch.backends.cuda.matmul.allow_tf32 = False\nEOF\n"]
