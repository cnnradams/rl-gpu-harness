[1343.962222, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(10 / 10)\"\r\n  },\r\n  \"runtime\": 2.71,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.71,\r\n    \"std\": 0.0926,\r\n    \"min\": 2.49,\r\n    \"max\": 2.8,\r\n    \"num_trials\": 100\r\n  },\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0436,\r\n    \"min\": 11.3,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 100\r\n  },\r\n  \"solution_sha256\": \"d859f425674e77d5753e9483cd6f33a5516cb9aa7e5ecd6998df288239815d95\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 10,\r\n  \"perf_trials\": 100,\r\n  \"speedup\": 4.169741697416974\r\n}\r\n"]
