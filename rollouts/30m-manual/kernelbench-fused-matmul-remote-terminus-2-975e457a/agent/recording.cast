[895.236311, "o", "SMs: 132\r\nP 128,256,64,8,3,True failed: out of resource: shared memory, Required: 427032, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nP 128,256,64,8,3,False failed: out of resource: shared memory, Required: 427032, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nP 256,128,64,8,3,True failed: out of resource: shared memory, Required: 426008, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nP 128,256,64,8,4,True failed: out of resource: shared memory, Required: 525344, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nP 128,128,64,8,4,True failed: out of resource: shared memory, Required: 327712, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nP 256,256,64,8,2,True failed: out of resource: shared memory, Required: 525328, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nP 128,256,128,8,2,True failed: out of resource: shared memory, Required: 525328, Hardware limit: 2324"]
[895.236377, "o", "48. Reducing block sizes or `num_stages` may help.\r\n"]
[896.088586, "o", "\u001b[?2004hroot@modal:/workspace# "]
[962.497693, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\ntorch.backends.cuda.matmul.allow_tf32 = False\nref32 = torch.nn.functional.linear(x, w, b)\nref = ref32 * 0.5 + ref32\n\ndef check(name, y):\n    diff = (y - ref).abs()\n    denom = 1e-4 + 1e-4 * ref.abs()\n    frac = (diff / denom).max().item()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: frac_of_tol={frac:.4f} pass={ok}\")\n\ndef timeit(fn, n=200):\n    for _ in range(20):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\nw15 = (w * 1.5).contiguous()\nbias15 = (b * 1."]
[962.49774, "i", "5).contiguous()\nw_hi = w15.half()\nw_lo = (w15 - w_hi.float()).half()\nwt_hi = w_hi.t().contiguous()  # (K, N)\nwt_lo = w_lo.t().contiguous()\nM, K = x.shape\nN = O\n\n@triton.jit\ndef kpersist(a_desc, bh_desc, bl_desc, bias_ptr, c_desc, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n             GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\n    start_pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    k_tiles = tl.cdiv(K, BK)\n    num_tiles = num_pid_m * num_pid_n\n    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\n        num_pid_in_group = GROUP * num_pid_n\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GROUP\n        group_size_m = min(num_pid_m - first_pid_m, GROUP)\n        pid_m = first_pid_m + (tile_id % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        offs_am = pid_m * BM\n        offs_bn = pid_n * BN\n        acc = tl.zeros"]
[962.497753, "i", "((BM, BN), dtype=tl.float32)\n        for ki in range(k_tiles):\n            offs_k = ki * BK\n            a = a_desc.load([offs_am, offs_k])\n            b_hi = bh_desc.load([offs_k, offs_bn])\n            b_lo = bl_desc.load([offs_k, offs_bn])\n            a_hi = a.to(tl.float16)\n            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n            acc = tl.dot(a_hi, b_hi, acc)\n            acc = tl.dot(a_hi, b_lo, acc)\n            acc = tl.dot(a_lo, b_hi, acc)\n        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\n        acc = acc + bias[None, :]\n        c_desc.store([offs_am, offs_bn], acc)\n\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\n\ndef run_persist(BM, BN, BK, GROUP, nw, ns, ws):\n    y = torch.empty(M, N, device=device, dtype=torch.float32)\n    a_desc = TensorDescriptor.from_tensor(x, [BM, BK])\n    bh_desc = TensorDescriptor.from_tensor(wt_hi, [BK, BN])\n    bl_desc = TensorDescriptor.from_tensor(wt_lo, [BK, BN])\n    c_desc = TensorDescriptor.from_tensor(y, [BM, BN])\n    grid "]
[962.497863, "i", "= (min(NUM_SMS, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\n    def run():\n        kpersist[grid](a_desc, bh_desc, bl_desc, bias15, c_desc, M, N, K,\n                       BM, BN, BK, GROUP, NUM_SMS, ws, num_warps=nw, num_stages=ns)\n        return y\n    return run\n\nconfigs = [\n    (128, 256, 64, 8, 8, 2, True),\n    (128, 256, 64, 8, 8, 2, False),\n    (256, 128, 64, 8, 8, 2, True),\n    (128, 256, 32, 8, 8, 3, True),\n    (128, 128, 64, 8, 8, 3, True),\n    (256, 128, 32, 8, 8, 3, True),\n    (128, 128, 64, 8, 4, 3, True),\n    (128, 128, 32, 8, 4, 4, True),\n]\nfor (BM, BN, BK, G, nw, ns, ws) in configs:\n    try:\n        run = run_persist(BM, BN, BK, G, nw, ns, ws)\n        y = run()\n        check(f'P {BM}x{BN}x{BK} w{nw} s{ns} ws{int(ws)}', y)\n        print(f'  ms: {timeit(run):.4f}')\n    except Exception as e:\n        print(f'P {BM},{BN},{BK},{nw},{ns},{ws} failed: {str(e)[:100]}')\nEOF\n"]
