[1040.165769, "o", "\u001b[?2004h> "]
[1040.165911, "o", "        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[1040.165931, "o", "\u001b[?2004h> "]
[1040.166097, "o", "        GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1040.166122, "o", "\u001b[?2004h> "]
[1040.166198, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1040.166217, "o", "\u001b[?2004h> "]
[1040.166294, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1040.166313, "o", "\u001b[?2004h> "]
[1040.16639, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1040.16641, "o", "\u001b[?2004h> "]
[1040.166482, "o", "    k_tiles = tl.cdiv(K, BK)\r\n\u001b[?2004l\r"]
[1040.166501, "o", "\u001b[?2004h> "]
[1040.166594, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r"]
[1040.166615, "o", "\u001b[?2004h> "]
[1040.166836, "o", "    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\r\n\u001b[?2004l\r"]
[1040.166863, "o", "\u001b[?2004h"]
[1040.166882, "o", "> "]
[1040.16697, "o", "        num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1040.166995, "o", "\u001b[?2004h> "]
[1040.16711, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[1040.167129, "o", "\u001b[?2004h> "]
[1040.167221, "o", "        first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[1040.167246, "o", "\u001b[?2004h> "]
[1040.16738, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[1040.167409, "o", "\u001b[?2004h> "]
[1040.16753, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[1040.167551, "o", "\u001b[?2004h> "]
[1040.167693, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1040.16772, "o", "\u001b[?2004h> "]
[1040.167784, "o", "        offs_am = pid_m * BM\r\n\u001b[?2004l\r"]
[1040.167805, "o", "\u001b[?2004h> "]
