[1040.171427, "o", "\u001b[?2004h> "]
[1040.171575, "o", "        check(f'K16 {BM}x{BN}x{BK} w{nw} s{ns} ws{int(ws)}', y)\r\n\u001b[?2004l\r"]
[1040.171597, "o", "\u001b[?2004h> "]
[1040.171693, "o", "        print(f'  ms: {timeit(run):.4f}')\r\n\u001b[?2004l\r"]
