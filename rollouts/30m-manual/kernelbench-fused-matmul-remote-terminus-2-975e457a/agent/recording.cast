[1243.236394, "o", "256x128x32 G8 w8 s4: pass=True\r\n  ms: 2.7957\r\n256x128x32 G4 w8 s4: pass=True\r\n  ms: 2.8374\r\n256x128x32 G16 w8 s4: pass=True\r\n  ms: 2.8181\r\n256x128x32 G8 w8 s3: pass=True\r\n  ms: 2.7910\r\n256x128x32 G8 w8 s5: pass=True\r\n  ms: 2.7831\r\n256x128x32 G8 w4 s4: pass=True\r\n  ms: 18.9211\r\n256x128x64 G8 w8 s3: pass=True\r\n  ms: 2.8213\r\n192,128,32,8,8,4 failed: at 13:22:\r\n       sam, sak, scm, scn,\r\n       BM: tl.constexpr, BN: tl.constexpr, \r\n128x256x32 G8 w8 s4: pass=True\r\n  ms: 3.0969\r\n128x256x32 G8 w8 s3: pass=True\r\n  ms: 2.9372\r\n256x64x32 G8 w4 s4: pass=True\r\n  ms: 3.8552\r\n256x128x32 G32 w8 s4: pass=True\r\n  ms: 2.8975\r\n128x128x32 G8 w4 s6: pass=True\r\n  ms: 4.3033\r\n256x256x32 G8 w8 s2: pass=True\r\n  ms: 42.6486\r\nBEST: (2.7831404622395834, (256, 128, 32, 8, 8, 5))\r\n"]
[1244.159788, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1266.229278, "i", "cat > /workspace/bench10.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\ntorch.backends.cuda.matmul.allow_tf32 = False\nref32 = torch.nn.functional.linear(x, w, b)\nref = ref32 * 0.5 + ref32\n\ndef check(name, y):\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: pass={ok}\")\n\ndef timeit(fn, n=300):\n    for _ in range(30):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\nw15 = (w * 1.5).contiguous()\nbias15 = (b * 1.5).contiguous()\nw_hi = w15.half(); w_lo = (w15 - w_hi.float()).half()\nwt_hi = w_hi.t().contiguous(); wt_lo = w_lo.t().contig"]
[1266.229325, "i", "uous()\nx_hi = x.half().contiguous(); x_lo = (x - x_hi.float()).half().contiguous()\nM, K = x.shape\nN = O\n\n@triton.jit\ndef k16(ah_desc, al_desc, bh_desc, bl_desc, bias_ptr, c_desc, M, N, K,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n        GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\n    start_pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    k_tiles = tl.cdiv(K, BK)\n    num_tiles = num_pid_m * num_pid_n\n    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\n        num_pid_in_group = GROUP * num_pid_n\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GROUP\n        group_size_m = min(num_pid_m - first_pid_m, GROUP)\n        pid_m = first_pid_m + (tile_id % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        offs_am = pid_m * BM\n        offs_bn = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for ki in range(k_tiles)"]
[1266.229339, "i", ":\n            offs_k = ki * BK\n            a_hi = ah_desc.load([offs_am, offs_k])\n            a_lo = al_desc.load([offs_am, offs_k])\n            b_hi = bh_desc.load([offs_k, offs_bn])\n            b_lo = bl_desc.load([offs_k, offs_bn])\n            acc = tl.dot(a_hi, b_hi, acc)\n            acc = tl.dot(a_hi, b_lo, acc)\n            acc = tl.dot(a_lo, b_hi, acc)\n        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\n        acc = acc + bias[None, :]\n        c_desc.store([offs_am, offs_bn], acc)\n\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\n\ndef run16(BM, BN, BK, GROUP, nw, ns, ws):\n    y = torch.empty(M, N, device=device, dtype=torch.float32)\n    ah = TensorDescriptor.from_tensor(x_hi, [BM, BK])\n    al = TensorDescriptor.from_tensor(x_lo, [BM, BK])\n    bh = TensorDescriptor.from_tensor(wt_hi, [BK, BN])\n    bl = TensorDescriptor.from_tensor(wt_lo, [BK, BN])\n    c = TensorDescriptor.from_tensor(y, [BM, BN])\n    grid = (min(NUM_SMS, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\n    def run"]
[1266.229354, "i", "():\n        k16[grid](ah, al, bh, bl, bias15, c, M, N, K,\n                  BM, BN, BK, GROUP, NUM_SMS, ws, num_warps=nw, num_stages=ns)\n        return y\n    return run\n\nfor (BM,BN,BK,G,nw,ns,ws) in [\n    (128,256,32,8,8,3,True),\n    (128,256,32,8,8,3,False),\n    (128,256,32,8,8,4,True),\n    (256,128,32,8,8,3,True),\n    (128,256,32,8,4,3,True),\n    (128,128,32,8,8,4,True),\n    (256,256,32,8,8,2,True),\n    (128,128,64,8,8,3,True),\n]:\n    try:\n        run = run16(BM,BN,BK,G,nw,ns,ws)\n        y = run()\n        check(f'K16 {BM}x{BN}x{BK} G{G} w{nw} s{ns} ws{int(ws)}', y)\n        print(f'  ms: {timeit(run):.4f}')\n    except Exception as e:\n        print(f'K16 {BM},{BN},{BK},{G},{nw},{ns},{ws} failed: {str(e)[:90]}')\nEOF\n"]
