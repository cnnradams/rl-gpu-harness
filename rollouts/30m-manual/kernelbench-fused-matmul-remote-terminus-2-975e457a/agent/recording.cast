[488.721131, "o", "3_kernel[grid](x, w15.t(), b15, y, M, N, K,\r\n                            x.stride(0), x.stride(1), w15.t().stride(0), w15.t().stride(1),\r\n                            y.stride(0), y.st"]
[488.721155, "o", "ride(1),\r\n                            BM, BN, BK, GROUP, num_warps=nw, num_stages"]
[488.721176, "o", "=ns)\r\n        return y\r\n    retur"]
