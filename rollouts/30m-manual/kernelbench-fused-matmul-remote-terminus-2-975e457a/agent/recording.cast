[1040.168963, "o", "\u001b[?2004h> "]
[1040.169074, "o", "        c_desc.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[1040.169095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1040.169125, "o", "\u001b[?2004h> "]
[1040.169189, "o", "wtt = w15.t().contiguous()\r\n\u001b[?2004l\r"]
[1040.169209, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1040.169228, "o", "\u001b[?2004h> "]
[1040.169336, "o", "def runtf(BM, BN, BK, GROUP, nw, ns, ws):\r\n\u001b[?2004l\r"]
[1040.169355, "o", "\u001b[?2004h> "]
[1040.1695, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1040.169529, "o", "\u001b[?2004h> "]
[1040.16964, "o", "    a = TensorDescriptor.from_tensor(x, [BM, BK])\r\n\u001b[?2004l\r"]
[1040.16967, "o", "\u001b[?2004h> "]
[1040.169787, "o", "    bb = TensorDescriptor.from_tensor(wtt, [BK, BN])\r\n\u001b[?2004l\r"]
[1040.169816, "o", "\u001b[?2004h> "]
[1040.169931, "o", "    c = TensorDescriptor.from_tensor(y, [BM, BN])\r\n\u001b[?2004l\r"]
[1040.169951, "o", "\u001b[?2004h> "]
[1040.17011, "o", "    grid = (min(NUM_SMS, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r"]
[1040.17013, "o", "\u001b[?2004h> "]
[1040.17017, "o", "    def run():\r\n\u001b[?2004l\r"]
[1040.17019, "o", "\u001b[?2004h> "]
[1040.170297, "o", "        ktf[grid](a, bb, bias15, c, M, N, K,\r\n\u001b[?2004l\r"]
[1040.170317, "o", "\u001b[?2004h> "]
[1040.170501, "o", "                  BM, BN, BK, GROUP, NUM_SMS, ws, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1040.170532, "o", "\u001b[?2004h> "]
[1040.170566, "o", "        return y\r\n\u001b[?2004l\r"]
[1040.170586, "o", "\u001b[?2004h> "]
