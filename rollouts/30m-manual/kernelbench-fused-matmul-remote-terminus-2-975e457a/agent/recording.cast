[1040.162662, "o", "\u001b[?2004h> "]
[1040.162757, "o", "            acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[1040.162777, "o", "\u001b[?2004h> "]
[1040.162888, "o", "            acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[1040.162918, "o", "\u001b[?2004h> "]
[1040.163012, "o", "            acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[1040.163032, "o", "\u001b[?2004h> "]
[1040.163182, "o", "        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[1040.163211, "o", "\u001b[?2004h> "]
[1040.16329, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1040.16331, "o", "\u001b[?2004h> "]
[1040.163424, "o", "        c_desc.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[1040.163445, "o", "\u001b[?2004h> \r\n"]
[1040.163471, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1040.163488, "o", "> "]
[1040.163642, "o", "NUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r"]
[1040.163662, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1040.163681, "o", "\u001b[?2004h> "]
[1040.163785, "o", "def run16(BM, BN, BK, GROUP, nw, ns, ws):\r\n\u001b[?2004l\r"]
[1040.163815, "o", "\u001b[?2004h> "]
[1040.163958, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1040.163978, "o", "\u001b[?2004h> "]
[1040.164105, "o", "    ah = TensorDescriptor.from_tensor(x_hi, [BM, BK])\r\n\u001b[?2004l\r"]
[1040.164137, "o", "\u001b[?2004h> "]
[1040.164253, "o", "    al = TensorDescriptor.from_tensor(x_lo, [BM, BK])\r\n\u001b[?2004l\r"]
[1040.164274, "o", "\u001b[?2004h> "]
[1040.164403, "o", "    bh = TensorDescriptor.from_tensor(wt_hi, [BK, BN])\r\n\u001b[?2004l\r"]
[1040.164433, "o", "\u001b[?2004h> "]
[1040.164553, "o", "    bl = TensorDescriptor.from_tensor(wt_lo, [BK, BN])\r\n\u001b[?2004l\r"]
[1040.164577, "o", "\u001b[?2004h> "]
[1040.164693, "o", "    c = TensorDescriptor.from_tensor(y, [BM, BN])\r\n\u001b[?2004l\r"]
[1040.164723, "o", "\u001b[?2004h> "]
[1040.1649, "o", "    grid = (min(NUM_SMS, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1040.164921, "o", "> "]
[1040.164951, "o", "    def run():\r\n\u001b[?2004l\r"]
[1040.164971, "o", "\u001b[?2004h> "]
[1040.165098, "o", "        k16[grid](ah, al, bh, bl, bias15, c, M, N, K,\r\n\u001b[?2004l\r"]
[1040.165118, "o", "\u001b[?2004h> "]
[1040.165305, "o", "                  BM, BN, BK, GROUP, NUM_SMS, ws, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1040.165335, "o", "\u001b[?2004h> "]
[1040.165367, "o", "        return y\r\n\u001b[?2004l\r"]
[1040.165386, "o", "\u001b[?2004h> "]
[1040.165427, "o", "    return run\r\n\u001b[?2004l\r"]
