[488.72319, "o", "\u001b[?2004h> "]
[488.72331, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[488.723341, "o", "\u001b[?2004h> "]
[488.723548, "o", "    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.4f} pass={ok}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[488.723581, "o", "> \r\n\u001b[?2004l\r"]
[488.723604, "o", "\u001b[?2004h> "]
[488.723655, "o", "def timeit(fn, n=100):\r\n\u001b[?2004l\r"]
[488.723673, "o", "\u001b[?2004h> "]
[488.72374, "o", "    for _ in range(10):\r\n\u001b[?2004l\r"]
[488.723759, "o", "\u001b[?2004h> "]
[488.723809, "o", "        fn()\r\n\u001b[?2004l\r"]
[488.723836, "o", "\u001b[?2004h> "]
[488.723907, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[488.723926, "o", "\u001b[?2004h> "]
[488.72407, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[488.724097, "o", "\u001b[?2004h> "]
[488.724157, "o", "    s.record()\r\n\u001b[?2004l\r"]
[488.724184, "o", "\u001b[?2004h> "]
[488.72424, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[488.724267, "o", "\u001b[?2004h> "]
[488.724303, "o", "        fn()\r\n\u001b[?2004l\r"]
[488.724333, "o", "\u001b[?2004h> "]
[488.724427, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[488.724454, "o", "\u001b[?2004h> "]
[488.724532, "o", "    return s.elapsed_time(e) / n\r\n\u001b[?2004l\r"]
[488.724559, "o", "\u001b[?2004h> \r\n"]
[488.724586, "o", "\u001b[?2004l\r\u001b[?2004h"]
[488.724613, "o", "> "]
[488.724674, "o", "w15 = (w * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[488.724704, "o", "\u001b[?2004h> "]
[488.724765, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[488.72479, "o", "\u001b[?2004h"]
[488.724806, "o", "> \r\n\u001b[?2004l\r"]
[488.724829, "o", "\u001b[?2004h> "]
[488.725015, "o", "torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = False\r\n\u001b[?2004l\r"]
[488.725036, "o", "\u001b[?2004h> "]
[488.725081, "o", "w_hi = w15.half()\r\n\u001b[?2004l\r"]
[488.725108, "o", "\u001b[?2004h> "]
[488.72521, "o", "w_lo = (w15 - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[488.725241, "o", "\u001b[?2004h> "]
[488.725308, "o", "wt_hi = w_hi.t().contiguous()\r\n\u001b[?2004l\r"]
[488.725326, "o", "\u001b[?2004h> "]
[488.725406, "o", "wt_lo = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[488.725434, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[488.725461, "o", "\u001b[?2004h> "]
[488.725499, "o", "def fp16x3():\r\n\u001b[?2004l\r"]
[488.725521, "o", "\u001b[?2004h> "]
[488.725581, "o", "    x_hi = x.half()\r\n\u001b[?2004l\r"]
[488.725609, "o", "\u001b[?2004h> "]
[488.725695, "o", "    x_lo = (x - x_hi.float()).half()\r\n\u001b[?2004l\r"]
[488.725722, "o", "\u001b[?2004h> "]
[488.725797, "o", "    y = torch.mm(x_hi, wt_hi)\r\n\u001b[?2004l\r"]
[488.725821, "o", "\u001b[?2004h> "]
[488.725913, "o", "    y = torch.addmm(y, x_hi, wt_lo)\r\n\u001b[?2004l\r"]
[488.72594, "o", "\u001b[?2004h> "]
[488.726024, "o", "    y = torch.addmm(y, x_lo, wt_hi)\r\n\u001b[?2004l\r"]
[488.726051, "o", "\u001b[?2004h> "]
[488.726097, "o", "    return y + b15\r\n\u001b[?2004l\r"]
[488.726116, "o", "\u001b[?2004h> \r\n"]
[488.726146, "o", "\u001b[?2004l\r\u001b[?2004h"]
[488.726169, "o", "> "]
[488.72624, "o", "check('fp16x3 torch', fp16x3())\r\n\u001b[?2004l\r"]
[488.726267, "o", "\u001b[?2004h> "]
[488.726366, "o", "print('fp16x3 torch ms:', timeit(fp16x3))\r\n\u001b[?2004l\r"]
[488.726384, "o", "\u001b[?2004h> \r\n"]
[488.72641, "o", "\u001b[?2004l\r\u001b[?2004h"]
[488.726426, "o", "> "]
[488.726459, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[488.726486, "o", "\u001b[?2004h> "]
[488.726585, "o", "def fp16x3_kernel(A, Bm, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[488.726607, "o", "\u001b[?2004h> "]
[488.726724, "o", "                  sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[488.726741, "o", "\u001b[?2004h> "]
[488.726915, "o", "                  BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[488.726946, "o", "\u001b[?2004h> "]
[488.727036, "o", "                  GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[488.727067, "o", "\u001b[?2004h> "]
[488.727131, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[488.727158, "o", "\u001b[?2004h> "]
[488.727232, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[488.727254, "o", "\u001b[?2004h> "]
[488.727334, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[488.727361, "o", "\u001b[?2004h> "]
[488.727456, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[488.727486, "o", "\u001b[?2004h> "]
[488.727574, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[488.7276, "o", "\u001b[?2004h> "]
[488.727683, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[488.72771, "o", "\u001b[?2004h> "]
[488.727836, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[488.727863, "o", "\u001b[?2004h> "]
[488.72802, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[488.728048, "o", "\u001b[?2004h> "]
[488.728181, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[488.728211, "o", "\u001b[?2004h> \r\n"]
[488.728234, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[488.728337, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[488.728364, "o", "\u001b[?2004h> "]
[488.728454, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[488.728486, "o", "\u001b[?2004h> "]
[488.728542, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[488.728572, "o", "\u001b[?2004h> "]
[488.728693, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[488.728724, "o", "\u001b[?2004h> "]
[488.728865, "o", "    B_ptr = Bm + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[488.728886, "o", "> "]
[488.728992, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[488.729019, "o", "\u001b[?2004h> "]
[488.72911, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[488.729136, "o", "\u001b[?2004h> "]
[488.729207, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[488.729227, "o", "\u001b[?2004h> "]
[488.7293, "o", "        bb = tl.load(B_ptr)\r\n\u001b[?2004l\r"]
[488.729327, "o", "\u001b[?2004h> "]
[488.729402, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[488.729429, "o", "\u001b[?2004h> "]
[488.729558, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[488.729585, "o", "\u001b[?2004h> "]
[488.729662, "o", "        b_hi = bb.to(tl.float16)\r\n\u001b[?2004l\r"]
[488.729692, "o", "\u001b[?2004h> "]
[488.729819, "o", "        b_lo = (bb - b_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[488.729846, "o", "\u001b[?2004h> "]
[488.729934, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[488.729961, "o", "\u001b[?2004h> "]
[488.73005, "o", "        acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[488.730079, "o", "\u001b[?2004h> "]
[488.730171, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[488.73019, "o", "\u001b[?2004h> "]
[488.730259, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[488.730286, "o", "\u001b[?2004h> "]
[488.730347, "o", "        B_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[488.730377, "o", "\u001b[?2004h> "]
[488.730445, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[488.730472, "o", "\u001b[?2004h> "]
[488.730542, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[488.730569, "o", "\u001b[?2004h> "]
[488.730693, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[488.730721, "o", "\u001b[?2004h> "]
[488.730779, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[488.730797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[488.730827, "o", "\u001b[?2004h> "]
[488.730982, "o", "def triton_fp16x3(BM=128, BN=128, BK=64, GROUP=8, nw=8, ns=3):\r\n\u001b[?2004l\r"]
[488.73101, "o", "\u001b[?2004h> "]
[488.731055, "o", "    M, K = x.shape\r\n\u001b[?2004l\r"]
[488.731082, "o", "\u001b[?2004h> "]
[488.731108, "o", "    N = O\r\n\u001b[?2004l\r"]
[488.731146, "o", "\u001b[?2004h> "]
[488.731284, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[488.731302, "o", "\u001b[?2004h> "]
[488.731436, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[488.731457, "o", "\u001b[?2004h> "]
[488.731499, "o", "    def run():\r\n\u001b[?2004l\r"]
[488.731527, "o", "\u001b[?2004h> "]
[488.731658, "o", "        fp16x3_kernel[grid](x, w15.t(), b15, y, M, N, K,\r\n\u001b[?2004l\r"]
[488.731685, "o", "\u001b[?2004h> "]
[488.7319, "o", "                            x.stride(0), x.stride(1), w15.t().stride(0), w15.t().stride(1),\r\n\u001b[?2004l\r"]
[488.731926, "o", "\u001b[?2004h> "]
[488.732051, "o", "                            y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[488.732073, "o", "\u001b[?2004h> "]
[488.732252, "o", "                            BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[488.73228, "o", "\u001b[?2004h> "]
[488.732321, "o", "        return y\r\n\u001b[?2004l\r"]
[488.732348, "o", "\u001b[?2004h> "]
[488.732385, "o", "    return run\r\n\u001b[?2004l\r"]
[488.732412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[488.732435, "o", "\u001b[?2004h> "]
[488.732685, "o", "for (BM, BN, BK, nw, ns) in [(128,128,64,8,3), (128,256,64,8,3), (256,128,64,8,3), (128,128,32,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[488.732709, "o", "> "]
[488.732729, "o", "    try:\r\n\u001b[?2004l\r"]
[488.732758, "o", "\u001b[?2004h> "]
[488.73289, "o", "        run = triton_fp16x3(BM, BN, BK, 8, nw, ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[488.732919, "o", "> "]
[488.732956, "o", "        y = run()\r\n\u001b[?2004l\r"]
[488.732986, "o", "\u001b[?2004h> "]
[488.733113, "o", "        check(f'triton {BM}x{BN}x{BK} w{nw} s{ns}', y)\r\n\u001b[?2004l\r"]
[488.733142, "o", "\u001b[?2004h> "]
[488.733233, "o", "        print(f'  ms:', timeit(run))\r\n\u001b[?2004l\r"]
[488.733264, "o", "\u001b[?2004h> "]
[488.733327, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[488.733353, "o", "\u001b[?2004h> "]
[488.733507, "o", "        print(f'config {BM},{BN},{BK},{nw},{ns} failed: {e}')\r\n\u001b[?2004l\r"]
[488.733534, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[488.734645, "o", "\u001b[?2004hroot@modal:/workspace# "]
[488.955994, "i", "gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench3.py /workspace/bench3.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench3.py\n"]
[488.956519, "o", "gpu push sb-9dAeRgZGBAU8Zb7zDJsKdq /workspace/bench3.py /workspace/bench3.py && gpu exec sb-9dAeRgZGBAU8Zb7zDJsKdq -- python3 /workspace/bench3.py\r\n\u001b[?2004l\r"]
[491.913886, "o", "{\r\n  \"bytes\": 3761,\r\n  \"sha256\": \"b696dc934dbab6b83eac62e2398a7057f58311fe3380ebfd8bf8d2d4ef5b4452\"\r\n}\r\n"]
[492.052592, "o", "request ID: a1484dd5fbe246da975a43d3586521e6\r\n"]
[494.113714, "o", "command: 2e73fd31851a47898960de0f8c48302c\r\n"]
[500.759078, "o", "fp16x3 torch: max_diff=1.269e-03 frac_of_tol=5.6996 pass=False\r\nfp16x3 torch ms: 3.4040093994140626\r\ntriton 128x128x64 w8 s3: max_diff=4.244e-05 frac_of_tol=0.2229 pass=True\r\n  ms: 3.7383218383789063\r\nconfig 128,256,64,8,3 failed: out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\ntriton 256x128x64 w8 s3: max_diff=4.244e-05 frac_of_tol=0.2229 pass=True\r\n  ms: 3.923731384277344\r\ntriton 128x128x32 w4 s4: max_diff=4.220e-05 frac_of_tol=0.2220 pass=True\r\n  ms: 3.5872064208984376\r\n"]
[501.630916, "o", "\u001b[?2004hroot@modal:/workspace# "]
[642.876466, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\ntorch.backends.cuda.matmul.allow_tf32 = False\nref32 = torch.nn.functional.linear(x, w, b)\nref = ref32 * 0.5 + ref32\n\ndef check(name, y):\n    diff = (y - ref).abs()\n    denom = 1e-4 + 1e-4 * ref.abs()\n    frac = (diff / denom).max().item()\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.4f} pass={ok}\")\n\ndef timeit(fn, n=200):\n    for _ in range(20):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\nw15 = (w * 1.5).contiguous()\nb15 = (b * 1.5).contiguous()\nw_hi = w15.hal"]
[642.876534, "i", "f()\nw_lo = (w15 - w_hi.float()).half()\nwt_hi = w_hi.t().contiguous()  # (K, N)\nwt_lo = w_lo.t().contiguous()\n\n# K2: pre-split fp16 weights, in-kernel split of A (fp32 loads)\n@triton.jit\ndef k2(A, BH, BL, Bias, C, M, N, K,\n       sam, sak, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k i"]
[642.876543, "i", "n range(0, tl.cdiv(K, BK)):\n        a = tl.load(A_ptr)\n        bh = tl.load(BH_ptr)\n        bl = tl.load(BL_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, bh, acc)\n        acc = tl.dot(a_hi, bl, acc)\n        acc = tl.dot(a_lo, bh, acc)\n        A_ptr += BK * sak\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\n# K3: fully pre-split fp16 inputs\n@triton.jit\ndef k3(AH, AL, BH, BL, Bias, C, M, N, K,\n       scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) %"]
[642.876552, "i", " group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * K + rk[None, :]\n    AL_ptr = AL + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        ah = tl.load(AH_ptr)\n        al = tl.load(AL_ptr)\n        bh = tl.load(BH_ptr)\n        bl = tl.load(BL_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        AH_ptr += BK\n        AL_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef run_k2(BM, BN, BK, GROUP, nw, ns):\n    M, K = x.shape\n    N = O\n    y = torch.empty(M, N, device=device, dtype=torch.flo"]
[642.87656, "i", "at32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def run():\n        k2[grid](x, wt_hi, wt_lo, b15, y, M, N, K,\n                 x.stride(0), x.stride(1), y.stride(0), y.stride(1),\n                 BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\n        return y\n    return run\n\ndef run_k3(BM, BN, BK, GROUP, nw, ns):\n    M, K = x.shape\n    N = O\n    y = torch.empty(M, N, device=device, dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def run():\n        x_hi = x.half()\n        x_lo = (x - x_hi.float()).half()\n        k3[grid](x_hi, x_lo, wt_hi, wt_lo, b15, y, M, N, K,\n                 y.stride(0), y.stride(1),\n                 BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\n        return y\n    return run\n\nconfigs = [(256,256,32,8,8,3),(256,256,32,8,8,2),(256,128,64,8,8,3),(256,128,64,8,8,2),\n           (128,256,64,8,8,3),(256,128,32,8,8,4),(128,128,64,8,8,3),(256,64,64,4,8,3)]\nfor (BM,BN,BK,G,nw,ns) in configs:\n    for name, mk in [('K2', run_k2), ('K3', run_k3)]:\n  "]
[642.876682, "i", "      try:\n            run = mk(BM,BN,BK,G,nw,ns)\n            y = run()\n            check(f'{name} {BM}x{BN}x{BK} w{nw} s{ns}', y)\n            print(f'  ms: {timeit(run):.4f}')\n        except Exception as e:\n            print(f'{name} {BM},{BN},{BK},{nw},{ns} failed: {str(e)[:100]}')\nEOF\n"]
[642.876704, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r"]
[642.876733, "o", "\u001b[?2004h> "]
[642.876796, "o", "import torch\r\n\u001b[?2004l\r"]
[642.87682, "o", "\u001b[?2004h> "]
[642.876904, "o", "import triton\r\n\u001b[?2004l\r"]
[642.876928, "o", "\u001b[?2004h"]
[642.876954, "o", "> "]
[642.877058, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[642.877091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[642.877115, "o", "\u001b[?2004h> "]
[642.877243, "o", "B, I, O = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[642.877268, "o", "\u001b[?2004h> "]
[642.877323, "o", "device = 'cuda'\r\n\u001b[?2004l\r"]
[642.877349, "o", "\u001b[?2004h> "]
[642.877431, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[642.877455, "o", "\u001b[?2004h> "]
[642.877624, "o", "x = torch.rand(B, I, device=device)\r\n\u001b[?2004l\r"]
[642.877651, "o", "\u001b[?2004h> "]
[642.877811, "o", "lin = torch.nn.Linear(I, O).to(device)\r\n\u001b[?2004l\r"]
[642.877836, "o", "\u001b[?2004h"]
[642.877859, "o", "> "]
[642.87811, "o", "w, b = lin.weight.detach().clone(), lin.bias.detach().clone()\r\n\u001b[?2004l\r"]
[642.878137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re"]
[642.878163, "o", "\u001b[?2004h> "]
[642.878372, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[642.878398, "o", "\u001b[?2004h> "]
[642.87857, "o", "ref32 = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[642.878595, "o", "\u001b[?2004h> "]
[642.8787, "o", "ref = ref32 * 0.5 + ref32\r\n\u001b[?2004l\r"]
[642.878724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[642.878751, "o", "\u001b[?2004h> "]
[642.878834, "o", "def check(name, y):\r\n\u001b[?2004l\r"]
[642.878859, "o", "\u001b[?2004h> "]
[642.87898, "o", "    diff = (y - ref).abs()\r\n\u001b[?2004l\r"]
[642.879004, "o", "\u001b[?2004h> "]
[642.879162, "o", "    denom = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[642.879188, "o", "\u001b[?2004h> "]
[642.879352, "o", "    frac = (diff / denom).max().item()\r\n\u001b[?2004l\r"]
[642.879375, "o", "\u001b[?2004h> "]
[642.879635, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[642.87966, "o", "\u001b[?2004h> "]
[642.880028, "o", "    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.4f} pass={ok}\")\r\n\u001b[?2004l\r"]
[642.880056, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[642.880082, "o", "\u001b[?2004h> "]
[642.880183, "o", "def timeit(fn, n=200):\r\n\u001b[?2004l\r"]
[642.880209, "o", "\u001b[?2004h> "]
[642.88032, "o", "    for _ in range(20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.880342, "o", "> "]
[642.88039, "o", "        fn()\r\n\u001b[?2004l\r"]
[642.880421, "o", "\u001b[?2004h> "]
[642.88054, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[642.880561, "o", "\u001b[?2004h> "]
[642.880835, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[642.880866, "o", "\u001b[?2004h> "]
[642.880921, "o", "    s.record()\r\n\u001b[?2004l\r"]
[642.880951, "o", "\u001b[?2004h> "]
[642.881041, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[642.881076, "o", "\u001b[?2004h> "]
[642.881135, "o", "        fn()\r\n\u001b[?2004l\r"]
[642.881162, "o", "\u001b[?2004h> "]
[642.881329, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[642.881349, "o", "\u001b[?2004h> "]
[642.881487, "o", "    return s.elapsed_time(e) / n\r\n\u001b[?2004l\r"]
[642.881507, "o", "\u001b[?2004h"]
[642.881537, "o", "> \r\n\u001b[?2004l\rw\u001b[?2004h"]
[642.881559, "o", "> "]
[642.88166, "o", "w15 = (w * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[642.881688, "o", "\u001b[?2004h> "]
[642.881802, "o", "b15 = (b * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[642.881822, "o", "\u001b[?2004h> "]
[642.881906, "o", "w_hi = w15.half()\r\n\u001b[?2004l\r"]
[642.881936, "o", "\u001b[?2004h> "]
[642.882081, "o", "w_lo = (w15 - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[642.88211, "o", "\u001b[?2004h> "]
[642.88228, "o", "wt_hi = w_hi.t().contiguous()  # (K, N)\r\n\u001b[?2004l\r"]
[642.882301, "o", "\u001b[?2004h"]
[642.882321, "o", "> "]
[642.882435, "o", "wt_lo = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[642.882466, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[642.882487, "o", "x\u001b[?2004h"]
[642.88251, "o", "> "]
[642.882769, "o", "# K2: pre-split fp16 weights, in-kernel split of A (fp32 loads)\r\n\u001b[?2004l\r"]
[642.882798, "o", "\u001b[?2004h> "]
[642.882845, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[642.882869, "o", "\u001b[?2004h> "]
[642.883018, "o", "def k2(A, BH, BL, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[642.883041, "o", "\u001b[?2004h> "]
[642.883163, "o", "       sam, sak, scm, scn,\r\n\u001b[?2004l\r"]
[642.883183, "o", "\u001b[?2004h> "]
[642.883465, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[642.883495, "o", "\u001b[?2004h> "]
[642.883557, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[642.883584, "o", "\u001b[?2004h> "]
[642.88365, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[642.883677, "o", "\u001b[?2004h> "]
[642.88375, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[642.88377, "o", "\u001b[?2004h> "]
[642.883872, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[642.8839, "o", "\u001b[?2004h> "]
[642.883988, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[642.884019, "o", "\u001b[?2004h> "]
[642.884103, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[642.88413, "o", "\u001b[?2004h> "]
[642.884262, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.88429, "o", "> "]
[642.884439, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[642.884466, "o", "\u001b[?2004h> "]
[642.884586, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[642.884614, "o", "\u001b[?2004h> "]
[642.884703, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[642.884733, "o", "\u001b[?2004h> "]
[642.88484, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[642.88486, "o", "> "]
[642.884921, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[642.88494, "o", "\u001b[?2004h> "]
[642.885077, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[642.885108, "o", "\u001b[?2004h> "]
[642.885214, "o", "    BH_ptr = BH + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[642.885241, "o", "\u001b[?2004h> "]
[642.885352, "o", "    BL_ptr = BL + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[642.885379, "o", "\u001b[?2004h> "]
[642.88549, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[642.885517, "o", "\u001b[?2004h> "]
[642.885608, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[642.885634, "o", "\u001b[?2004h> "]
[642.885699, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[642.88572, "o", "\u001b[?2004h> "]
[642.885793, "o", "        bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[642.885819, "o", "\u001b[?2004h> "]
[642.885888, "o", "        bl = tl.load(BL_ptr)\r\n\u001b[?2004l\r"]
[642.885908, "o", "\u001b[?2004h> "]
[642.885988, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[642.886006, "o", "\u001b[?2004h> "]
[642.886149, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[642.886167, "o", "\u001b[?2004h> "]
[642.88626, "o", "        acc = tl.dot(a_hi, bh, acc)\r\n\u001b[?2004l\r"]
[642.886286, "o", "\u001b[?2004h> "]
[642.886369, "o", "        acc = tl.dot(a_hi, bl, acc)\r\n\u001b[?2004l\r"]
[642.886387, "o", "\u001b[?2004h> "]
[642.886479, "o", "        acc = tl.dot(a_lo, bh, acc)\r\n\u001b[?2004l\r"]
[642.886509, "o", "\u001b[?2004h> "]
[642.886567, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[642.886587, "o", "\u001b[?2004h> "]
[642.886653, "o", "        BH_ptr += BK * N\r\n\u001b[?2004l\r"]
[642.886671, "o", "\u001b[?2004h> "]
[642.886739, "o", "        BL_ptr += BK * N\r\n\u001b[?2004l\r"]
[642.886766, "o", "\u001b[?2004h> "]
[642.886835, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[642.886856, "o", "\u001b[?2004h> "]
[642.886932, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[642.886952, "o", "\u001b[?2004h> "]
[642.88709, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[642.887111, "o", "\u001b[?2004h> "]
[642.887179, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[642.887198, "o", "\u001b[?2004h> \r\n"]
[642.88722, "o", "\u001b[?2004l\r"]
[642.887241, "o", "\u001b[?2004h> "]
[642.887316, "o", "# K3: fully pre-split fp16 inputs\r\n\u001b[?2004l\r"]
[642.887342, "o", "\u001b[?2004h> "]
[642.887372, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[642.887392, "o", "\u001b[?2004h> "]
[642.887494, "o", "def k3(AH, AL, BH, BL, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[642.887512, "o", "\u001b[?2004h> "]
[642.887562, "o", "       scm, scn,\r\n\u001b[?2004l\r"]
[642.887581, "o", "\u001b[?2004h> "]
[642.887779, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[642.88781, "o", "\u001b[?2004h> "]
[642.887869, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[642.887887, "o", "\u001b[?2004h> "]
[642.887969, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[642.887986, "o", "\u001b[?2004h> "]
[642.888075, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[642.888095, "o", "\u001b[?2004h> "]
[642.888195, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[642.888215, "o", "\u001b[?2004h> "]
[642.888313, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[642.88834, "o", "\u001b[?2004h> "]
[642.888422, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[642.888448, "o", "\u001b[?2004h> "]
[642.888575, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[642.888602, "o", "\u001b[?2004h> "]
[642.888757, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[642.888791, "o", "\u001b[?2004h> "]
[642.888915, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[642.888945, "o", "\u001b[?2004h> "]
[642.889032, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[642.889059, "o", "\u001b[?2004h> "]
[642.889156, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[642.889174, "o", "\u001b[?2004h> "]
[642.889245, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[642.889271, "o", "\u001b[?2004h> "]
[642.889382, "o", "    AH_ptr = AH + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[642.889412, "o", "\u001b[?2004h> "]
[642.88952, "o", "    AL_ptr = AL + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[642.889546, "o", "\u001b[?2004h> "]
[642.889657, "o", "    BH_ptr = BH + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[642.889683, "o", "\u001b[?2004h> "]
[642.889795, "o", "    BL_ptr = BL + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[642.889825, "o", "\u001b[?2004h> "]
[642.889931, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[642.889958, "o", "\u001b[?2004h> "]
[642.890049, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[642.890075, "o", "\u001b[?2004h> "]
[642.890152, "o", "        ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r"]
[642.89018, "o", "\u001b[?2004h> "]
[642.890246, "o", "        al = tl.load(AL_ptr)\r\n\u001b[?2004l\r"]
[642.890266, "o", "\u001b[?2004h> "]
[642.89034, "o", "        bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[642.890367, "o", "\u001b[?2004h> "]
[642.890436, "o", "        bl = tl.load(BL_ptr)\r\n\u001b[?2004l\r"]
[642.890462, "o", "\u001b[?2004h> "]
[642.890543, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[642.890569, "o", "\u001b[?2004h> "]
[642.890648, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[642.890677, "o", "\u001b[?2004h> "]
[642.890754, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[642.890785, "o", "\u001b[?2004h> "]
[642.89083, "o", "        AH_ptr += BK\r\n\u001b[?2004l\r"]
[642.890848, "o", "\u001b[?2004h> "]
[642.890909, "o", "        AL_ptr += BK\r\n\u001b[?2004l\r"]
[642.890936, "o", "\u001b[?2004h> "]
[642.890994, "o", "        BH_ptr += BK * N\r\n\u001b[?2004l\r"]
[642.891021, "o", "\u001b[?2004h> "]
[642.89109, "o", "        BL_ptr += BK * N\r\n\u001b[?2004l\r"]
[642.891117, "o", "\u001b[?2004h> "]
[642.891188, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[642.891205, "o", "\u001b[?2004h> "]
[642.891284, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[642.891312, "o", "\u001b[?2004h> "]
[642.891434, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[642.891459, "o", "\u001b[?2004h> "]
[642.891522, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[642.891549, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[642.891571, "o", "\u001b[?2004h"]
[642.891585, "o", "> "]
[642.891673, "o", "def run_k2(BM, BN, BK, GROUP, nw, ns):\r\n\u001b[?2004l\r"]
[642.891691, "o", "\u001b[?2004h> "]
[642.891746, "o", "    M, K = x.shape\r\n\u001b[?2004l\r"]
[642.891773, "o", "\u001b[?2004h> "]
[642.891804, "o", "    N = O\r\n\u001b[?2004l\r"]
[642.891826, "o", "\u001b[?2004h> "]
[642.891968, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[642.891986, "o", "\u001b[?2004h> "]
[642.892126, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[642.892153, "o", "\u001b[?2004h> "]
[642.892189, "o", "    def run():\r\n\u001b[?2004l\r"]
[642.892209, "o", "\u001b[?2004h> "]
[642.892333, "o", "        k2[grid](x, wt_hi, wt_lo, b15, y, M, N, K,\r\n\u001b[?2004l\r"]
[642.892364, "o", "\u001b[?2004h> "]
[642.892517, "o", "                 x.stride(0), x.stride(1), y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[642.892548, "o", "\u001b[?2004h> "]
[642.892693, "o", "                 BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[642.89272, "o", "\u001b[?2004h> "]
[642.892763, "o", "        return y\r\n\u001b[?2004l\r"]
[642.892793, "o", "\u001b[?2004h"]
[642.892807, "o", "> "]
[642.892845, "o", "    return run\r\n\u001b[?2004l\r"]
[642.892863, "o", "\u001b[?2004h> \r\n"]
[642.892878, "o", "\u001b[?2004l\r"]
[642.892909, "o", "\u001b[?2004h> "]
[642.893001, "o", "def run_k3(BM, BN, BK, GROUP, nw, ns):\r\n\u001b[?2004l\r"]
[642.893022, "o", "\u001b[?2004h> "]
[642.893073, "o", "    M, K = x.shape\r\n\u001b[?2004l\r"]
[642.893093, "o", "\u001b[?2004h> "]
[642.893125, "o", "    N = O\r\n\u001b[?2004l\r"]
[642.893146, "o", "\u001b[?2004h> "]
[642.893299, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[642.893329, "o", "\u001b[?2004h> "]
[642.893447, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[642.893464, "o", "\u001b[?2004h> "]
[642.89351, "o", "    def run():\r\n\u001b[?2004l\r"]
[642.89354, "o", "\u001b[?2004h> "]
[642.893594, "o", "        x_hi = x.half()\r\n\u001b[?2004l\r"]
[642.893621, "o", "\u001b[?2004h> "]
[642.893715, "o", "        x_lo = (x - x_hi.float()).half()\r\n\u001b[?2004l\r"]
[642.893735, "o", "\u001b[?2004h> "]
[642.893879, "o", "        k3[grid](x_hi, x_lo, wt_hi, wt_lo, b15, y, M, N, K,\r\n\u001b[?2004l\r"]
[642.893906, "o", "\u001b[?2004h> "]
[642.894005, "o", "                 y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[642.894032, "o", "\u001b[?2004h> "]
[642.894186, "o", "                 BM, BN, BK, GROUP, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[642.894214, "o", "\u001b[?2004h> "]
[642.894253, "o", "        return y\r\n\u001b[?2004l\r"]
[642.894283, "o", "\u001b[?2004h> "]
[642.894316, "o", "    return run\r\n\u001b[?2004l\r"]
[642.894343, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[642.894373, "o", "\u001b[?2004h> "]
[642.894578, "o", "configs = [(256,256,32,8,8,3),(256,256,32,8,8,2),(256,128,64,8,8,3),(256,128,64,8,8,2),\r\n\u001b[?2004l\r"]
[642.894606, "o", "\u001b[?2004h> "]
[642.894801, "o", "           (128,256,64,8,8,3),(256,128,32,8,8,4),(128,128,64,8,8,3),(256,64,64,4,8,3)]\r\n\u001b[?2004l\r"]
[642.894832, "o", "\u001b[?2004h> "]
[642.894911, "o", "for (BM,BN,BK,G,nw,ns) in configs:\r\n\u001b[?2004l\r"]
[642.894931, "o", "\u001b[?2004h> "]
[642.895068, "o", "    for name, mk in [('K2', run_k2), ('K3', run_k3)]:\r\n\u001b[?2004l\r"]
[642.895089, "o", "\u001b[?2004h> "]
[642.895128, "o", "        try:\r\n\u001b[?2004l\r"]
[642.895155, "o", "\u001b[?2004h> "]
[642.895245, "o", "            run = mk(BM,BN,BK,G,nw,ns)\r\n\u001b[?2004l\r"]
[642.89527, "o", "\u001b[?2004h> "]
[642.895324, "o", "            y = run()\r\n\u001b[?2004l\r"]
[642.895358, "o", "\u001b[?2004h> "]
[642.895487, "o", "            check(f'{name} {BM}x{BN}x{BK} w{nw} s{ns}', y)\r\n\u001b[?2004l\r"]
[642.895513, "o", "\u001b[?2004h> "]
[642.895621, "o", "            print(f'  ms: {timeit(run):.4f}')\r\n\u001b[?2004l\r"]
[642.895648, "o", "\u001b[?2004h> "]
[642.895724, "o", "        except Exception as e:\r\n\u001b[?2004l\r"]
[642.895746, "o", "\u001b[?2004h> "]
[642.895934, "o", "            print(f'{name} {BM},{BN},{BK},{nw},{ns} failed: {str(e)[:100]}')\r\n\u001b[?2004l\r"]
[642.895958, "o", "\u001b[?2004h> "]
[642.89598, "o", "EOF\r\n\u001b[?2004l\r"]
[642.897437, "o", "\u001b[?2004hroot@modal:/workspace# "]
