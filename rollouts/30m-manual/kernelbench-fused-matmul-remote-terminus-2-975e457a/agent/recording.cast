[1040.162362, "o", "\u001b[?2004h> "]
[1040.162488, "o", "            b_hi = bh_desc.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1040.162517, "o", "\u001b[?2004h> "]
