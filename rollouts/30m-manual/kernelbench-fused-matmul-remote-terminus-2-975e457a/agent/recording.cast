[1266.236369, "o", "            a_lo = al_desc.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[1266.236387, "o", "\u001b[?2004h> "]
[1266.236515, "o", "            b_hi = bh_desc.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1266.236535, "o", "\u001b[?2004h> "]
[1266.236658, "o", "            b_lo = bl_desc.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1266.236691, "o", "\u001b[?2004h> "]
[1266.2368, "o", "            acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[1266.236828, "o", "\u001b[?2004h> "]
[1266.236917, "o", "            acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[1266.236934, "o", "\u001b[?2004h> "]
[1266.237038, "o", "            acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[1266.237068, "o", "\u001b[?2004h> "]
[1266.237201, "o", "        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[1266.237227, "o", "\u001b[?2004h> "]
[1266.237305, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1266.237335, "o", "\u001b[?2004h> "]
[1266.237435, "o", "        c_desc.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[1266.237466, "o", "\u001b[?2004h> \r\n"]
[1266.237496, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1266.237518, "o", "> "]
[1266.237667, "o", "NUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r\u001b[?2004h"]
[1266.237696, "o", "> \r\n\u001b[?2004l\r"]
[1266.237719, "o", "\u001b[?2004h"]
[1266.23774, "o", "> "]
[1266.237837, "o", "def run16(BM, BN, BK, GROUP, nw, ns, ws):\r\n\u001b[?2004l\r"]
[1266.237859, "o", "\u001b[?2004h> "]
[1266.238007, "o", "    y = torch.empty(M, N, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1266.238029, "o", "\u001b[?2004h> "]
[1266.238159, "o", "    ah = TensorDescriptor.from_tensor(x_hi, [BM, BK])\r\n\u001b[?2004l\r"]
[1266.238189, "o", "\u001b[?2004h> "]
[1266.238305, "o", "    al = TensorDescriptor.from_tensor(x_lo, [BM, BK])\r\n\u001b[?2004l\r"]
[1266.238332, "o", "\u001b[?2004h> "]
[1266.238461, "o", "    bh = TensorDescriptor.from_tensor(wt_hi, [BK, BN])\r\n\u001b[?2004l\r"]
[1266.238478, "o", "\u001b[?2004h> "]
[1266.238617, "o", "    bl = TensorDescriptor.from_tensor(wt_lo, [BK, BN])\r\n\u001b[?2004l\r"]
[1266.238645, "o", "\u001b[?2004h> "]
[1266.238766, "o", "    c = TensorDescriptor.from_tensor(y, [BM, BN])\r\n\u001b[?2004l\r"]
[1266.238796, "o", "\u001b[?2004h> "]
[1266.238949, "o", "    grid = (min(NUM_SMS, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r"]
[1266.238969, "o", "\u001b[?2004h> "]
[1266.239013, "o", "    def run():\r\n\u001b[?2004l\r"]
[1266.239033, "o", "\u001b[?2004h> "]
[1266.239165, "o", "        k16[grid](ah, al, bh, bl, bias15, c, M, N, K,\r\n\u001b[?2004l\r"]
[1266.239191, "o", "\u001b[?2004h> "]
[1266.239379, "o", "                  BM, BN, BK, GROUP, NUM_SMS, ws, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1266.239403, "o", "\u001b[?2004h> "]
[1266.239442, "o", "        return y\r\n\u001b[?2004l\r"]
[1266.239461, "o", "\u001b[?2004h> "]
[1266.239507, "o", "    return run\r\n\u001b[?2004l\r"]
[1266.239537, "o", "\u001b[?2004h> \r\n"]
[1266.239554, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1266.239574, "o", "> "]
[1266.23964, "o", "for (BM,BN,BK,G,nw,ns,ws) in [\r\n\u001b[?2004l\r"]
[1266.239667, "o", "\u001b[?2004h> "]
[1266.239743, "o", "    (128,256,32,8,8,3,True),\r\n\u001b[?2004l\r"]
[1266.239774, "o", "\u001b[?2004h> "]
[1266.239841, "o", "    (128,256,32,8,8,3,False),\r\n\u001b[?2004l\r"]
[1266.239868, "o", "\u001b[?2004h> "]
[1266.239937, "o", "    (128,256,32,8,8,4,True),\r\n\u001b[?2004l\r"]
[1266.239964, "o", "\u001b[?2004h> "]
[1266.240034, "o", "    (256,128,32,8,8,3,True),\r\n\u001b[?2004l\r"]
[1266.240065, "o", "\u001b[?2004h> "]
[1266.240129, "o", "    (128,256,32,8,4,3,True),\r\n\u001b[?2004l\r"]
[1266.240156, "o", "\u001b[?2004h> "]
[1266.240225, "o", "    (128,128,32,8,8,4,True),\r\n\u001b[?2004l\r"]
[1266.240252, "o", "\u001b[?2004h> "]
[1266.240321, "o", "    (256,256,32,8,8,2,True),\r\n\u001b[?2004l\r"]
[1266.240342, "o", "\u001b[?2004h> "]
[1266.240418, "o", "    (128,128,64,8,8,3,True),\r\n\u001b[?2004l\r"]
[1266.240446, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r"]
[1266.240477, "o", "\u001b[?2004h> "]
[1266.240505, "o", "    try:\r\n\u001b[?2004l\r"]
[1266.240525, "o", "\u001b[?2004h> "]
[1266.240629, "o", "        run = run16(BM,BN,BK,G,nw,ns,ws)\r\n\u001b[?2004l\r"]
[1266.240659, "o", "\u001b[?2004h> "]
[1266.240706, "o", "        y = run()\r\n\u001b[?2004l\r"]
[1266.240737, "o", "\u001b[?2004h> "]
[1266.240915, "o", "        check(f'K16 {BM}x{BN}x{BK} G{G} w{nw} s{ns} ws{int(ws)}', y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1266.240938, "o", "> "]
[1266.241037, "o", "        print(f'  ms: {timeit(run):.4f}')\r\n\u001b[?2004l\r"]
[1266.241068, "o", "\u001b[?2004h> "]
[1266.241131, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[1266.241158, "o", "\u001b[?2004h> "]
[1266.241345, "o", "        print(f'K16 {BM},{BN},{BK},{G},{nw},{ns},{ws} failed: {str(e)[:90]}')\r\n\u001b[?2004l\r"]
[1266.241366, "o", "\u001b[?2004h> "]
[1266.241391, "o", "EOF\r\n\u001b[?2004l\r"]
