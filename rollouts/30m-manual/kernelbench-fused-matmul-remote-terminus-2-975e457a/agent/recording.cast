[1405.669645, "o", "\u001b[?2004h> "]
[1405.669686, "o", "M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1405.669724, "o", "N = O\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1405.66984, "o", "# B_pack: (2K, N): rows [0..K) hi, [K..2K) lo\r\n\u001b[?2004l\r"]
[1405.669879, "o", "\u001b[?2004h> "]
[1405.669995, "o", "B_pack = torch.cat([wt_hi, wt_lo], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[1405.670038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1405.670154, "o", "# packed-B kernel: one (2BK, BN) load per step\r\n\u001b[?2004l\r"]
[1405.670192, "o", "\u001b[?2004h> "]
[1405.670229, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1405.670307, "o", "def kp(A, BP, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[1405.670342, "o", "\u001b[?2004h> "]
[1405.670397, "o", "       sam, sak, scm, scn,\r\n\u001b[?2004l\r"]
[1405.670435, "o", "\u001b[?2004h> "]
[1405.670622, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.670654, "o", "> "]
[1405.670705, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1405.670743, "o", "\u001b[?2004h> "]
[1405.670801, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1405.670836, "o", "\u001b[?2004h> "]
[1405.670899, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1405.670933, "o", "\u001b[?2004h> "]
[1405.671021, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1405.671056, "o", "\u001b[?2004h> "]
[1405.671134, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1405.671173, "o", "\u001b[?2004h> "]
[1405.671241, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[1405.67128, "o", "\u001b[?2004h> "]
[1405.671391, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[1405.671429, "o", "\u001b[?2004h> "]
[1405.671577, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1405.671618, "o", "\u001b[?2004h> "]
[1405.671728, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1405.671766, "o", "\u001b[?2004h> "]
[1405.671842, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1405.671878, "o", "\u001b[?2004h> "]
[1405.671965, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1405.672004, "o", "\u001b[?2004h> "]
[1405.672051, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1405.672089, "o", "\u001b[?2004h> "]
[1405.672148, "o", "    rk2 = tl.arange(0, 2 * BK)\r\n\u001b[?2004l\r"]
[1405.672182, "o", "\u001b[?2004h> "]
[1405.672296, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1405.67233, "o", "\u001b[?2004h> "]
[1405.672433, "o", "    BP_ptr = BP + rk2[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1405.672468, "o", "\u001b[?2004h> "]
[1405.672573, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1405.672608, "o", "\u001b[?2004h> "]
[1405.672687, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[1405.672725, "o", "\u001b[?2004h> "]
[1405.672785, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[1405.672821, "o", "\u001b[?2004h> "]
[1405.673049, "o", "        bp = tl.load(BP_ptr)  # (2BK, BN): first BK rows are hi of this k-block? NO - need interleave\r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.673092, "o", "> "]
[1405.673131, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.673169, "o", "> "]
[1405.673219, "o", "        BP_ptr += 2 * BK * N\r\n\u001b[?2004l\r"]
[1405.673257, "o", "\u001b[?2004h> "]
[1405.67337, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1405.673409, "o", "\u001b[?2004h> "]
[1405.673447, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[1405.673486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.673521, "o", "> "]
[1405.673686, "o", "print('packed layout needs interleaved rows; use direct interleave instead')\r\n\u001b[?2004l\r"]
[1405.673732, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1405.673947, "o", "# Interleaved along K: B2 (K, 2, N) -> (K*2, N) where row 2k = hi of k, row 2k+1 = lo of k\r\n\u001b[?2004l\r"]
[1405.673985, "o", "\u001b[?2004h> "]
[1405.674139, "o", "B_int = torch.stack([wt_hi, wt_lo], dim=1).reshape(2 * K, N).contiguous()\r\n\u001b[?2004l\r"]
[1405.674178, "o", "\u001b[?2004h> "]
[1405.674286, "o", "# A_int: (M, 2K): col 2k = hi of k, col 2k+1 = lo of k\r\n\u001b[?2004l\r"]
[1405.674324, "o", "\u001b[?2004h> "]
[1405.674556, "o", "# in-kernel: load a (BM, BK) fp32, split; load b_int tile (2BK, BN) = hi/lo interleaved rows of this block\r\n\u001b[?2004l\r"]
[1405.674598, "o", "\u001b[?2004h> "]
[1405.674826, "o", "# b_hi = rows even, b_lo = rows odd -> use strided view: load (BK, 2, BN)? tl doesn't do 3D loads well.\r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.674868, "o", "> "]
[1405.675109, "o", "# Instead: single dot! acc += dot(a_int (BM,2BK), b_int (2BK,BN)) computes a_hi@b_hi + a_lo@b_lo -- WRONG pairing.\r\n\u001b[?2004l\r"]
[1405.675149, "o", "\u001b[?2004h> "]
[1405.675374, "o", "# Correct pairing needs a_hi@b_lo + a_lo@b_hi too. So make A_int2 (M, 2K): col 2k = a_hi, col 2k+1 = a_lo\r\n\u001b[?2004l\r"]
[1405.675397, "o", "\u001b[?2004h> "]
[1405.675534, "o", "# and B_int2 (2K, N): row 2k = b_hi, row 2k+1 = b_hi?? no.\r\n\u001b[?2004l\r"]
[1405.675575, "o", "\u001b[?2004h> "]
[1405.675841, "o", "# Trick: sum of 3 terms = dot([a_hi, a_hi, a_lo], [b_hi; b_lo; b_hi]) over 3K! A3 (M,3K), B3 (3K,N), single dot of 3K.\r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.675883, "o", "> "]
[1405.67624, "o", "# That reads A 3x and B 2x (b_hi twice) -> more traffic but ONE dot; L2 catches re-reads? DRAM traffic same as before per-tile but only one pipeline per operand.\r\n\u001b[?2004l\r"]
[1405.676283, "o", "\u001b[?2004h> "]
[1405.676393, "o", "print('skip - testing 3K packed single-dot variant')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1405.676434, "o", "> EOF\r\n\u001b[?2004l\r"]
[1405.677757, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1405.966546, "i", "echo done\n"]
[1405.966785, "o", "echo done\r\n\u001b[?2004l\rdone\r\n\u001b[?2004hroot@modal:/workspace# "]
[1408.731403, "i", "cat /workspace/solution.py | head -20 && ls -la /workspace/solution.py\n"]
[1408.731721, "o", "cat /workspace/solution.py | head -20 && ls -la /workspace/solution.py\r\n\u001b[?2004l\r"]
[1408.733064, "o", "import torch\r\nimport torch.nn as nn\r\nimport triton\r\nimport triton.language as tl\r\n\r\n\r\n@triton.jit\r\ndef _fp16x3_kernel(A, BH, BL, Bias, C, M, N, K,\r\n                   sam, sak, scm, scn,\r\n                   BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n                   GROUP: tl.constexpr):\r\n    pid = tl.program_id(0)\r\n    num_pid_m = tl.cdiv(M, BM)\r\n    num_pid_n = tl.cdiv(N, BN)\r\n    num_pid_in_group = GROUP * num_pid_n\r\n    group_id = pid // num_pid_in_group\r\n"]
[1408.733119, "o", "    first_pid_m = group_id * GROUP\r\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n    pid_n = (pid % num_pid_in_group) // group_size_m\r\n"]
[1408.734479, "o", "-rw-r--r-- 1 root root 3301 Nov  3 05:30 /workspace/solution.py\r\n"]
[1408.734679, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1409.032528, "i", "gpu stop sb-9dAeRgZGBAU8Zb7zDJsKdq\n"]
[1409.032799, "o", "gpu stop sb-9dAeRgZGBAU8Zb7zDJsKdq\r\n\u001b[?2004l\r"]
[1411.119393, "o", "{\r\n  \"stopped\": \"sb-9dAeRgZGBAU8Zb7zDJsKdq\"\r\n}\r\n"]
