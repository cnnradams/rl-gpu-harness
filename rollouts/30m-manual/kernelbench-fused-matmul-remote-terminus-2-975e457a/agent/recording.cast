[1405.666198, "i", "cat > /workspace/bench11.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\nB, I, O = 16384, 4096, 4096\ndevice = 'cuda'\ntorch.manual_seed(0)\nx = torch.rand(B, I, device=device)\nlin = torch.nn.Linear(I, O).to(device)\nw, b = lin.weight.detach().clone(), lin.bias.detach().clone()\n\ntorch.backends.cuda.matmul.allow_tf32 = False\nref32 = torch.nn.functional.linear(x, w, b)\nref = ref32 * 0.5 + ref32\n\ndef check(name, y):\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    print(f\"{name}: pass={ok}\")\n\ndef timeit(fn, n=300):\n    for _ in range(30):\n        fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(n):\n        fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / n\n\nw15 = (w * 1.5).contiguous()\nbias15 = (b * 1.5).contiguous()\nw_hi = w15.half(); w_lo = (w15 - w_hi.float()).half()\nwt_hi = w_hi.t().contiguous(); wt_lo = w_lo.t().contiguous()\nM, K = x.shape\nN = O\n# B_pack: (2K, N): rows [0..K) h"]
[1405.666248, "i", "i, [K..2K) lo\nB_pack = torch.cat([wt_hi, wt_lo], dim=0).contiguous()\n\n# packed-B kernel: one (2BK, BN) load per step\n@triton.jit\ndef kp(A, BP, Bias, C, M, N, K,\n       sam, sak, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    rk2 = tl.arange(0, 2 * BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    BP_ptr = BP + rk2[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(A_ptr)\n        bp = tl.load(B"]
[1405.666263, "i", "P_ptr)  # (2BK, BN): first BK rows are hi of this k-block? NO - need interleave\n        A_ptr += BK * sak\n        BP_ptr += 2 * BK * N\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\nprint('packed layout needs interleaved rows; use direct interleave instead')\n\n# Interleaved along K: B2 (K, 2, N) -> (K*2, N) where row 2k = hi of k, row 2k+1 = lo of k\nB_int = torch.stack([wt_hi, wt_lo], dim=1).reshape(2 * K, N).contiguous()\n# A_int: (M, 2K): col 2k = hi of k, col 2k+1 = lo of k\n# in-kernel: load a (BM, BK) fp32, split; load b_int tile (2BK, BN) = hi/lo interleaved rows of this block\n# b_hi = rows even, b_lo = rows odd -> use strided view: load (BK, 2, BN)? tl doesn't do 3D loads well.\n# Instead: single dot! acc += dot(a_int (BM,2BK), b_int (2BK,BN)) computes a_hi@b_hi + a_lo@b_lo -- WRONG pairing.\n# Correct pairing needs a_hi@b_lo + a_lo@b_hi too. So make A_int2 (M, 2K): col 2k = a_hi, col 2k+1 = a_lo\n# and B_int2 (2K, N): row 2k = b_hi, row 2k+1 = b_hi?? no.\n# Trick: sum of 3 te"]
[1405.666272, "i", "rms = dot([a_hi, a_hi, a_lo], [b_hi; b_lo; b_hi]) over 3K! A3 (M,3K), B3 (3K,N), single dot of 3K.\n# That reads A 3x and B 2x (b_hi twice) -> more traffic but ONE dot; L2 catches re-reads? DRAM traffic same as before per-tile but only one pipeline per operand.\nprint('skip - testing 3K packed single-dot variant')\nEOF\n"]
