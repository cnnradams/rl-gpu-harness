[280.350673, "o", "\u001b[?2004h> "]
[280.350724, "o", "ref = ref32 * 0.5 + ref32\r\n\u001b[?2004l\r"]
[280.350764, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.350802, "o", "> "]
[280.350843, "o", "def check(name, y):\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.350863, "o", "> "]
[280.350929, "o", "    diff = (y - ref).abs()\r\n\u001b[?2004l\r"]
[280.350968, "o", "\u001b[?2004h> "]
[280.351045, "o", "    denom = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[280.351065, "o", "\u001b[?2004h> "]
[280.351167, "o", "    frac = (diff / denom).max().item()\r\n\u001b[?2004l\r"]
[280.351195, "o", "\u001b[?2004h> "]
[280.351335, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.351376, "o", "> "]
[280.351562, "o", "    print(f\"{name}: max_diff={diff.max().item():.3e} frac_of_tol={frac:.4f} pass={ok}\")\r\n\u001b[?2004l\r"]
[280.351581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[280.351617, "o", "\u001b[?2004h> "]
[280.351679, "o", "def timeit(fn, n=100):\r\n\u001b[?2004l\r"]
[280.351715, "o", "\u001b[?2004h> "]
[280.351766, "o", "    for _ in range(10):\r\n\u001b[?2004l\r"]
[280.351808, "o", "\u001b[?2004h> "]
[280.351848, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.351923, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[280.351964, "o", "\u001b[?2004h> "]
[280.352091, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[280.352131, "o", "\u001b[?2004h> "]
[280.352173, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.352248, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[280.352291, "o", "\u001b[?2004h> "]
[280.352333, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.35243, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[280.352472, "o", "\u001b[?2004h"]
[280.352509, "o", "> "]
[280.352568, "o", "    return s.elapsed_time(e) / n\r\n\u001b[?2004l\r"]
[280.352606, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.352645, "o", "> "]
[280.352682, "o", "w15 = w * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.352719, "o", "b15 = b * 1.5\r\n\u001b[?2004l\r"]
[280.352757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[280.35289, "o", "\u001b[?2004h> # tf32x3 decomposition\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.352999, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.35304, "o", "> "]
[280.353113, "o", "import torch.backends.cuda.matmul as M\r\n\u001b[?2004l\r"]
[280.353152, "o", "\u001b[?2004h> "]
[280.353303, "o", "print('fp32_precision API:', getattr(M, 'fp32_precision', 'n/a'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.353343, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.353379, "o", "> "]
[280.353449, "o", "x_tf = x  # will be rounded internally\r\n\u001b[?2004l\r"]
[280.353488, "o", "\u001b[?2004h> "]
[280.353683, "o", "# split into hi/lo in tf32 representation: tf32 has 19 bits total; hi = round-to-tf32(x)\r\n\u001b[?2004l\r"]
[280.353725, "o", "\u001b[?2004h> "]
[280.353948, "o", "# emulate: hi = (x viewed as tf32). In torch, we can round to tf32 by truncating mantissa to 10 bits.\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.353987, "o", "> "]
[280.354025, "o", "def to_tf32(t):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.354104, "o", "    i = t.view(torch.int32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.354141, "o", "> "]
[280.354198, "o", "    mask = ~((1 << 13) - 1)\r\n\u001b[?2004l\r"]
[280.35423, "o", "\u001b[?2004h> "]
[280.354364, "o", "    hi_i = (i + (1 << 12)) & mask  # round-to-nearest-ish\r\n\u001b[?2004l\r"]
[280.354402, "o", "\u001b[?2004h> "]
[280.354468, "o", "    hi = hi_i.view(torch.float32)\r\n\u001b[?2004l\r"]
[280.354505, "o", "\u001b[?2004h> "]
[280.354539, "o", "    return hi\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.354578, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.35461, "o", "> "]
[280.354644, "o", "x_hi = to_tf32(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.354676, "o", "> "]
[280.354709, "o", "x_lo = x - x_hi\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.354746, "o", "> "]
[280.354784, "o", "w_hi = to_tf32(w15)\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.354822, "o", "> "]
[280.354859, "o", "w_lo = w15 - w_hi\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.354898, "o", "> "]
[280.354944, "o", "wt_hi = w_hi.t().contiguous()\r\n\u001b[?2004l\r"]
[280.354981, "o", "\u001b[?2004h> "]
[280.355041, "o", "wt_lo = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[280.355079, "o", "\u001b[?2004h> "]
[280.355133, "o", "wt15 = w15.t().contiguous()\r\n\u001b[?2004l\r"]
[280.355172, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[280.355212, "o", "> "]
[280.355247, "o", "def tf32x3():\r\n\u001b[?2004l\r\u001b[?2004h"]
[280.355284, "o", "> "]
[280.355343, "o", "    y = torch.mm(x_hi, wt_hi)\r\n\u001b[?2004l\r"]
[280.355376, "o", "\u001b[?2004h> "]
[280.355454, "o", "    y = torch.addmm(y, x_hi, wt_lo)\r\n\u001b[?2004l\r"]
[280.355492, "o", "\u001b[?2004h> "]
[280.355565, "o", "    y = torch.addmm(y, x_lo, wt_hi)\r\n\u001b[?2004l\r"]
[280.355603, "o", "\u001b[?2004h> "]
[280.355638, "o", "    return y + b15\r\n\u001b[?2004l\r"]
[280.355672, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[280.35571, "o", "\u001b[?2004h> "]
[280.355748, "o", "y = tf32x3()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[280.3558, "o", "check('tf32x3', y)\r\n\u001b[?2004l\r"]
[280.355837, "o", "\u001b[?2004h> "]
[280.355912, "o", "print('tf32x3 ms:', timeit(tf32x3))\r\n\u001b[?2004l\r"]
[280.355948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[280.355985, "o", "\u001b[?2004h> "]
[280.356021, "o", "def tf32single():\r\n\u001b[?2004l\r"]
[280.356059, "o", "\u001b[?2004h> "]
[280.35613, "o", "    return torch.addmm(b15, x, wt15)\r\n\u001b[?2004l\r"]
[280.356164, "o", "\u001b[?2004h> "]
[280.356249, "o", "check('tf32 single', tf32single())\r\n\u001b[?2004l\r"]
[280.356287, "o", "\u001b[?2004h> "]
[280.356391, "o", "print('tf32 single ms:', timeit(tf32single))\r\n\u001b[?2004l\r"]
[280.356429, "o", "\u001b[?2004h> "]
[280.356522, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[280.35656, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
