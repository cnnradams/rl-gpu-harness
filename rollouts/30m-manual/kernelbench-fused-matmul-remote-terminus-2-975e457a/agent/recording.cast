[1040.167905, "o", "\u001b[?2004h> "]
[1040.168027, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1040.168047, "o", "\u001b[?2004h> "]
[1040.168131, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[1040.168151, "o", "\u001b[?2004h> "]
