[434.025524, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom kernels import run_split\n\ntorch.manual_seed(0)\ndevice = 'cuda'\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device=device)\nlin = torch.nn.Linear(K, N).to(device)\nwith torch.no_grad():\n    ref = lin(x)\n    ref = ref * 0.5 + ref\nWs = lin.weight.detach() * 1.5\nbs = lin.bias.detach() * 1.5\nw_hi_t = Ws.half().t().contiguous()\nw_lo_t = (Ws - Ws.half().float()).half().t().contiguous()\n\nconfigs = [\n    (256, 128, 64, 8, 8, 3),\n    (256, 128, 32, 8, 8, 4),\n    (256, 256, 32, 8, 8, 3),\n    (128, 256, 32, 8, 8, 4),\n    (256, 128, 64, 4, 8, 3),\n    (256, 128, 64, 16, 8, 3),\n    (128, 128, 32, 8, 8, 6),\n    (256, 64, 64, 8, 8, 4),\n]\nfor cfg in configs:\n    BM, BN, BK, GM, warps, stages = cfg\n    try:\n        out = run_split(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages)\n        diff = (out - ref).abs()\n        denom = 1e-4 + 1e-4 * ref.abs()\n        margin = (diff / denom).max()"]
[434.025573, "i", ".item()\n        ms = triton.testing.do_bench(lambda: run_split(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages), warmup=10, rep=50)\n        print(f\"cfg={cfg} time={ms:.3f}ms margin={margin:.4f}\")\n    except Exception as e:\n        print(f\"cfg={cfg} FAILED: {type(e).__name__}: {str(e)[:80]}\")\nEOF\ngpu push sb-kfYe8vYlOOrLGQoVDgchrW /workspace/bench2.py /workspace/bench2.py\n"]
