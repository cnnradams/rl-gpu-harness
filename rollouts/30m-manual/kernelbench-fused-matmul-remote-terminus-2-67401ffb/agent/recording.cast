[520.094265, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\ntorch.manual_seed(0)\ndevice = 'cuda'\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device=device)\nlin = torch.nn.Linear(K, N).to(device)\nwith torch.no_grad():\n    ref = lin(x)\n    ref = ref * 0.5 + ref\nWs = lin.weight.detach() * 1.5\nbs = lin.bias.detach() * 1.5\nw_hi_t = Ws.half().t().contiguous()\nw_lo_t = (Ws - Ws.half().float()).half().t().contiguous()\n\n@triton.jit\ndef tma_gemm(a_desc, bh_desc, bl_desc, bias_ptr, c_ptr, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n             GROUP_M: tl.constexpr, WS: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m"]
[520.094314, "i", " = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in tl.range(0, K, BK, warp_specialize=WS):\n        a = a_desc.load([off_m, k])\n        bh = bh_desc.load([k, off_n])\n        bl = bl_desc.load([k, off_n])\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, bh, acc)\n        acc = tl.dot(a_lo, bh, acc)\n        acc = tl.dot(a_hi, bl, acc)\n    rn = off_n + tl.arange(0, BN)\n    bias = tl.load(bias_ptr + rn)\n    acc = acc + bias[None, :]\n    rm = off_m + tl.arange(0, BM)\n    c_ptrs = c_ptr + rm[:, None] * N + rn[None, :]\n    tl.store(c_ptrs, acc)\n\ndef run_tma(x, w_hi, w_lo, b, BM, BN, BK, GM, warps, stages, ws):\n    M, K = x.shape\n    N = w_hi.shape[1]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    a_desc = TensorDescriptor.from_tensor(x, [BM, BK])\n    bh_desc = Tens"]
[520.094322, "i", "orDescriptor.from_tensor(w_hi, [BK, BN])\n    bl_desc = TensorDescriptor.from_tensor(w_lo, [BK, BN])\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    tma_gemm[grid](a_desc, bh_desc, bl_desc, b, out, M, N, K,\n                   BM=BM, BN=BN, BK=BK, GROUP_M=GM, WS=ws,\n                   num_warps=warps, num_stages=stages)\n    return out\n\nconfigs = [\n    (128, 128, 64, 8, 8, 3, True),\n    (256, 128, 32, 8, 8, 4, True),\n    (128, 256, 64, 8, 8, 3, True),\n    (256, 128, 64, 8, 8, 2, True),\n    (128, 128, 64, 8, 8, 3, False),\n    (256, 128, 64, 8, 8, 2, False),\n]\nfor cfg in configs:\n    BM, BN, BK, GM, warps, stages, ws = cfg\n    try:\n        out = run_tma(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages, ws)\n        diff = (out - ref).abs()\n        denom = 1e-4 + 1e-4 * ref.abs()\n        margin = (diff / denom).max().item()\n        ms = triton.testing.do_bench(lambda: run_tma(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages, ws), warmup=10, rep=50)\n        print(f\"cfg={cfg} time={ms:.3f}ms margin={"]
