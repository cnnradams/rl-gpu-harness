[330.521418, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[330.521443, "o", "\u001b[?2004h> "]
[330.521468, "o", "import torch, sys\r\n\u001b[?2004l\r"]
[330.521494, "o", "\u001b[?2004h> "]
[330.521523, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[330.521547, "o", "\u001b[?2004h> "]
[330.521573, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.521612, "o", "from kernels import run_split\r\n\u001b[?2004l\r"]
[330.521637, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[330.521662, "o", "> "]
[330.521688, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.521719, "o", "device = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.521743, "o", "> "]
[330.521767, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.521791, "o", "> "]
[330.521821, "o", "x = torch.rand(M, K, device=device)\r\n\u001b[?2004l\r"]
[330.521846, "o", "\u001b[?2004h> "]
[330.521879, "o", "lin = torch.nn.Linear(K, N).to(device)\r\n\u001b[?2004l\r"]
[330.521905, "o", "\u001b[?2004h> "]
[330.521931, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.521958, "o", "    ref = lin(x)\r\n\u001b[?2004l\r"]
[330.521983, "o", "\u001b[?2004h> "]
[330.522007, "o", "    ref = ref * 0.5 + ref\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.522036, "o", "> "]
[330.522061, "o", "W = lin.weight.detach()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.52209, "o", "bias = lin.bias.detach()\r\n\u001b[?2004l\r"]
[330.522116, "o", "\u001b[?2004h> s = 1.5\r\n\u001b[?2004l\r"]
[330.52214, "o", "\u001b[?2004h> "]
[330.522164, "o", "Ws = W * s\r\n\u001b[?2004l\r\u001b[?2004h> "]
