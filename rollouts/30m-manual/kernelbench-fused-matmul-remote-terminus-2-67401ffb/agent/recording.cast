[887.124491, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nfrom kernels import run_split\n\ntorch.manual_seed(0)\ndevice = 'cuda'\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device=device)\nlin = torch.nn.Linear(K, N).to(device)\nwith torch.no_grad():\n    ref = lin(x)\n    ref = ref * 0.5 + ref\nWs = lin.weight.detach() * 1.5\nbs = lin.bias.detach() * 1.5\nw_hi_t = Ws.half().t().contiguous()\nw_lo_t = (Ws - Ws.half().float()).half().t().contiguous()\n\nconfigs = [\n    (256, 128, 32, 8, 8, 5),\n    (256, 128, 32, 8, 8, 6),\n    (256, 256, 32, 8, 8, 2),\n    (256, 128, 32, 4, 8, 5),\n    (128, 128, 64, 8, 8, 4),\n    (256, 128, 32, 8, 4, 4),\n    (512, 128, 32, 8, 8, 3),\n]\nfor cfg in configs:\n    BM, BN, BK, GM, warps, stages = cfg\n    try:\n        out = run_split(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages)\n        diff = (out - ref).abs()\n        denom = 1e-4 + 1e-4 * ref.abs()\n        margin = (diff / denom).max().item()\n        ms = triton.testing.do_bench(lambda: run_s"]
[887.124637, "i", "plit(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages), warmup=10, rep=50)\n        print(f\"cfg={cfg} time={ms:.3f}ms margin={margin:.4f}\")\n    except Exception as e:\n        print(f\"cfg={cfg} FAILED: {type(e).__name__}: {str(e)[:80]}\")\nEOF\ngpu push sb-kfYe8vYlOOrLGQoVDgchrW /workspace/bench5.py /workspace/bench5.py\n"]
[887.124648, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r"]
[887.124689, "o", "plit(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages), warmup=10, rep=50)\r\n        print(f\"cfg={cfg} time={ms:.3f}ms margin={margin:.4f}\")\r\n    except Exception as e:\r\n        print(f\"cfg={cfg} FAILED: {type(e).__name__}: {str(e)[:80]}\")\r\nEOF\r\ngpu push sb-kfYe8vYlOOrLGQoVDgchrW /workspace/bench5.py /workspace/bench5.py\r\n"]
[887.124723, "o", "\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r"]
[887.12475, "o", "\u001b[?2004h> "]
[887.124874, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> from kernels import run_split\r\n\u001b[?2004l\r\u001b[?2004h"]
[887.124933, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[887.12497, "o", "\u001b[?2004h> device = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125013, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[887.125052, "o", "> "]
[887.125099, "o", "x = torch.rand(M, K, device=device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.12514, "o", "lin = torch.nn.Linear(K, N).to(device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.12518, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[887.125219, "o", ">     ref = lin(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125257, "o", "    ref = ref * 0.5 + ref\r\n\u001b[?2004l\r"]
[887.125295, "o", "\u001b[?2004h> "]
[887.125344, "o", "Ws = lin.weight.detach() * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125383, "o", "bs = lin.bias.detach() * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125425, "o", "w_hi_t = Ws.half().t().contiguous()\r\n\u001b[?2004l\r"]
[887.125464, "o", "\u001b[?2004h> "]
[887.125504, "o", "w_lo_t = (Ws - Ws.half().float()).half().t().contiguous()\r\n\u001b[?2004l\r"]
[887.125546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125584, "o", "configs = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125623, "o", "    (256, 128, 32, 8, 8, 5),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125663, "o", "    (256, 128, 32, 8, 8, 6),\r\n\u001b[?2004l\r\u001b[?2004h"]
[887.125701, "o", ">     (256, 256, 32, 8, 8, 2),\r\n\u001b[?2004l\r"]
[887.12574, "o", "\u001b[?2004h> "]
[887.125779, "o", "    (256, 128, 32, 4, 8, 5),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125817, "o", "    (128, 128, 64, 8, 8, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125857, "o", "    (256, 128, 32, 8, 4, 4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.125897, "o", "    (512, 128, 32, 8, 8, 3),\r\n\u001b[?2004l\r"]
[887.125957, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> for cfg in configs:\r\n\u001b[?2004l\r"]
[887.125997, "o", "\u001b[?2004h> "]
[887.126036, "o", "    BM, BN, BK, GM, warps, stages = cfg\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[887.126078, "o", "\u001b[?2004h> "]
[887.126148, "o", "        out = run_split(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages)\r\n\u001b[?2004l\r"]
[887.126164, "o", "\u001b[?2004h> "]
[887.126196, "o", "        diff = (out - ref).abs()\r\n\u001b[?2004l\r"]
[887.126214, "o", "\u001b[?2004h> "]
[887.126333, "o", "        denom = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.126464, "o", "        margin = (diff / denom).max().item()\r\n\u001b[?2004l\r"]
[887.126558, "o", "\u001b[?2004h> "]
[887.126707, "o", "        ms = triton.testing.do_bench(lambda: run_split(x, w_hi_t, w_lo_t, bs, BM, BN, BK, GM, warps, stages), warmup=10, rep=50)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.126817, "o", "        print(f\"cfg={cfg} time={ms:.3f}ms margin={margin:.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.126858, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[887.126949, "o", "        print(f\"cfg={cfg} FAILED: {type(e).__name__}: {str(e)[:80]}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[887.127003, "o", "> EOF\r\n\u001b[?2004l\r"]
