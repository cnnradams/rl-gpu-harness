[330.522564, "o", "\u001b[?2004h> "]
[330.522591, "o", "    (128, 256, 64, 8, 8, 3),\r\n\u001b[?2004l\r"]
[330.522617, "o", "\u001b[?2004h> "]
[330.522641, "o", "    (256, 128, 64, 8, 8, 3),\r\n\u001b[?2004l\r"]
[330.52267, "o", "\u001b[?2004h> "]
[330.522694, "o", "    (128, 128, 128, 8, 8, 3),\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.522723, "o", "> "]
[330.522749, "o", "    (64, 256, 64, 8, 8, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.522776, "o", "> "]
[330.522799, "o", "    (128, 256, 64, 8, 8, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.522823, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.52285, "o", "for cfg in configs:\r\n\u001b[?2004l\r"]
[330.522875, "o", "\u001b[?2004h> "]
