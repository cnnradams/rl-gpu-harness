[230.877487, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[230.877508, "o", "\u001b[?2004h> "]
[230.877572, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[230.877592, "o", "\u001b[?2004h> "]
[230.877645, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[230.877665, "o", "\u001b[?2004h> "]
[230.877703, "o", "        s = 1.0 + scaling_factor\r\n\u001b[?2004l\r"]
[230.877724, "o", "\u001b[?2004h> "]
[230.877825, "o", "        self.register_buffer('w_scaled', (self.matmul.weight * s).detach(), persistent=False)\r\n\u001b[?2004l\r"]
[230.877849, "o", "\u001b[?2004h> "]
[230.877956, "o", "        self.register_buffer('b_scaled', (self.matmul.bias * s).detach(), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.877988, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.878021, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[230.878044, "o", "\u001b[?2004h> "]
[230.878064, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[230.878089, "o", "\u001b[?2004h> "]
[230.878131, "o", "        N = self.w_scaled.shape[0]\r\n\u001b[?2004l\r"]
[230.878151, "o", "\u001b[?2004h> "]
[230.878238, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[230.87826, "o", "\u001b[?2004h> "]
[230.878308, "o", "        BM, BN, BK, GM = 128, 128, 64, 8\r\n\u001b[?2004l\r"]
[230.878329, "o", "\u001b[?2004h> "]
[230.878393, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[230.878415, "o", "\u001b[?2004h> "]
[230.878456, "o", "        _matmul_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.878539, "o", "            x, self.w_scaled, self.b_scaled, out, M, N, K,\r\n\u001b[?2004l\r"]
[230.878561, "o", "\u001b[?2004h> "]
[230.878605, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[230.878627, "o", "\u001b[?2004h> "]
[230.8787, "o", "            self.w_scaled.stride(1), self.w_scaled.stride(0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[230.878726, "o", "> "]
[230.878765, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[230.878785, "o", "\u001b[?2004h> "]
[230.878847, "o", "            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,\r\n\u001b[?2004l\r"]
[230.878867, "o", "\u001b[?2004h> "]
[230.878904, "o", "            PRECISION=\"tf32x3\",\r\n\u001b[?2004l\r"]
[230.878925, "o", "\u001b[?2004h> "]
[230.878971, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[230.878992, "o", "\u001b[?2004h> "]
[230.879013, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.879046, "o", "        return out\r\n\u001b[?2004l\r"]
[230.879067, "o", "\u001b[?2004h> EOF\r\n"]
