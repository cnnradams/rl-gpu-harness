[330.519691, "o", "> "]
[330.51978, "o", "def run_split(x, w_hi, w_lo, b, BM, BN, BK, GM, warps, stages):\r\n\u001b[?2004l\r"]
[330.519807, "o", "\u001b[?2004h> "]
[330.519833, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[330.519866, "o", "    N = w_hi.shape[1]\r\n\u001b[?2004l\r"]
[330.519891, "o", "\u001b[?2004h> "]
[330.519958, "o", "    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[330.519983, "o", "\u001b[?2004h> "]
[330.520031, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[330.520055, "o", "\u001b[?2004h> "]
[330.520105, "o", "    split_gemm[grid](x, w_hi, w_lo, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[330.520131, "o", "\u001b[?2004h> "]
[330.520211, "o", "                     x.stride(0), x.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[330.520223, "o", "> "]
[330.520297, "o", "                     BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,\r\n\u001b[?2004l\r"]
[330.520322, "o", "\u001b[?2004h> "]
[330.520375, "o", "                     num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
