[330.522294, "o", "\u001b[?2004h> "]
[330.522337, "o", "# weight layout for kernel: B is [K, N] = W.t()\r\n\u001b[?2004l\r"]
[330.522362, "o", "\u001b[?2004h> "]
[330.522388, "o", "w_hi_t = w_hi.t().contiguous()\r\n\u001b[?2004l\r"]
[330.522414, "o", "\u001b[?2004h> "]
[330.522439, "o", "w_lo_t = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[330.522465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[330.52249, "o", "> configs = [\r\n\u001b[?2004l\r"]
[330.522515, "o", "\u001b[?2004h> "]
