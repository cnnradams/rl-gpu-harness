[851.638302, "o", "gpu policy 2>&1 | grep -E \"box_seconds|gpu_seconds_used|boxes\"\r\n\u001b[?2004l\r"]
[852.225311, "o", "    \"max_\u001b[01;31m\u001b[Kboxes\u001b[m\u001b[K\": 1,\r\n    \"\u001b[01;31m\u001b[Kbox_seconds\u001b[m\u001b[K\": 1800,\r\n  \"\u001b[01;31m\u001b[Kboxes\u001b[m\u001b[K\": [\r\n  \"\u001b[01;31m\u001b[Kgpu_seconds_used\u001b[m\u001b[K\": 746.4290528297424,\r\n"]
