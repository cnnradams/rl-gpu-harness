[685.526485, "o", "\u001b[?2004h> "]
[685.526632, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[685.526654, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[685.526674, "o", "\u001b[?2004h> "]
[685.526708, "o", "def bench(fn, n=10):\r\n\u001b[?2004l\r"]
[685.526728, "o", "\u001b[?2004h> "]
[685.526749, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[685.526771, "o", "> "]
[685.526816, "o", "        for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[685.526837, "o", "\u001b[?2004h> "]
[685.526887, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[685.526907, "o", "\u001b[?2004h> "]
[685.526962, "o", "        return None, str(e)[:60]\r\n\u001b[?2004l\r"]
[685.526983, "o", "\u001b[?2004h> "]
[685.527035, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[685.527055, "o", "\u001b[?2004h> "]
[685.527076, "o", "    ts = []\r\n\u001b[?2004l\r"]
[685.527097, "o", "\u001b[?2004h> "]
[685.527133, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[685.527154, "o", "\u001b[?2004h> "]
[685.527208, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[685.527229, "o", "\u001b[?2004h> "]
[685.527376, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[685.527398, "o", "\u001b[?2004h> "]
[685.527426, "o", "        clear_l2()\r\n\u001b[?2004l\r"]
[685.527443, "o", "\u001b[?2004h> "]
[685.527547, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[685.527567, "o", "\u001b[?2004h> "]
[685.527627, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[685.527648, "o", "\u001b[?2004h> "]
[685.527674, "o", "    ts = ts[1:]\r\n\u001b[?2004l\r"]
[685.527695, "o", "\u001b[?2004h> "]
[685.527749, "o", "    return sum(ts)/len(ts), None\r\n\u001b[?2004l\r"]
