[685.517398, "i", "cat > /workspace/tune3.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\nwh = w.half(); wl = (w - wh.float()).half()\nb = torch.randn(N, device='cuda')\n\n@triton.jit\ndef k3(X, WH, WL, B, O, M, N, K,\n      sxm, sxk, swk, swn, slk, sln, som, son,\n      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    xp = X + om[:, None] * sxm + ok[None, :] * sxk\n    wp = WH + ok[:, None] * swk + on[None, :] * swn\n    lp = WL + ok[:, None] * slk + on[None, :] * sln\n    acc = tl.zeros((BM, B"]
[685.517449, "i", "N), tl.float32)\n    for _ in range(0, K, BK):\n        xx = tl.load(xp)\n        wh_ = tl.load(wp)\n        wl_ = tl.load(lp)\n        xh = xx.to(tl.float16)\n        xl = (xx - xh.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(xh, wh_, acc)\n        acc = tl.dot(xl, wh_, acc)\n        acc = tl.dot(xh, wl_, acc)\n        xp += BK * sxk; wp += BK * swk; lp += BK * slk\n    bb = tl.load(B + on)\n    acc = acc + bb[None, :].to(tl.float32)\n    op = O + om[:, None] * som + on[None, :] * son\n    tl.store(op, acc)\n\n@triton.jit\ndef kbf(X, W0, W1, W2, B, O, M, N, K,\n        sxm, sxk, swk, swn, som, son,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, B"]
[685.517459, "i", "K)\n    xp = X + om[:, None] * sxm + ok[None, :] * sxk\n    w0p = W0 + ok[:, None] * swk + on[None, :] * swn\n    w1p = W1 + ok[:, None] * swk + on[None, :] * swn\n    w2p = W2 + ok[:, None] * swk + on[None, :] * swn\n    acc = tl.zeros((BM, BN), tl.float32)\n    for _ in range(0, K, BK):\n        xx = tl.load(xp)\n        x0 = xx.to(tl.bfloat16)\n        r0 = xx - x0.to(tl.float32)\n        x1 = r0.to(tl.bfloat16)\n        x2 = (r0 - x1.to(tl.float32)).to(tl.bfloat16)\n        w0 = tl.load(w0p); w1 = tl.load(w1p); w2 = tl.load(w2p)\n        acc = tl.dot(x0, w0, acc)\n        acc = tl.dot(x0, w1, acc)\n        acc = tl.dot(x0, w2, acc)\n        acc = tl.dot(x1, w0, acc)\n        acc = tl.dot(x1, w1, acc)\n        acc = tl.dot(x2, w0, acc)\n        xp += BK * sxk; w0p += BK * swk; w1p += BK * swk; w2p += BK * swk\n    bb = tl.load(B + on)\n    acc = acc + bb[None, :].to(tl.float32)\n    op = O + om[:, None] * som + on[None, :] * son\n    tl.store(op, acc)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device"]
[685.517467, "i", "='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=10):\n    try:\n        for _ in range(3): fn()\n    except Exception as e:\n        return None, str(e)[:60]\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = ts[1:]\n    return sum(ts)/len(ts), None\n\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ndef mk3(BM, BN, BK, GM, warps, stages):\n    grid = ((M // BM) * (N // BN),)\n    def fn():\n        k3[grid](x, wh, wl, b, out, M, N, K,\n                x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\n                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\n    return fn\n\nw0 = w.bfloat16()\nr0 = w - w0.float()\nw1 = r0.bfloat16()\nw2 = (r0 - w1.float()"]
[685.517609, "i", ").bfloat16()\n\ndef mkbf(BM, BN, BK, GM, warps, stages):\n    grid = ((M // BM) * (N // BN),)\n    def fn():\n        kbf[grid](x, w0, w1, w2, b, out, M, N, K,\n                x.stride(0), x.stride(1), w0.stride(0), w0.stride(1),\n                out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\n    return fn\n\nprint('--- k3 fused fp16-split: more configs ---')\nfor c in [(256,128,32,8,8,4),(256,128,32,8,8,3),(256,128,16,8,8,4),(256,128,16,8,8,6),(256,256,16,8,8,3),(256,256,32,8,8,3),(128,256,16,8,8,4),(256,128,32,4,8,4),(256,128,32,32,8,4),(512,128,32,8,8,3),(256,128,32,8,4,4)]:\n    t, err = bench(mk3(*c))\n    print(f'k3 BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\n\nprint('--- kbf bf16x9 ---')\nfor c in [(128,128,32,8,8,4),(256,128,32,8,8,3),(128,128,64,8,8,3),(128,256,32,8,8,3)]:\n    t, err = bench(mkbf(*c))\n    print(f'kbf BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(e"]
[685.517643, "o", "cat > /workspace/tune3.py << 'EOF'\r\n\u001b[?2004l\r"]
[685.517673, "i", "rr)} ms')\n\nref = x @ w + b\nkbf[((M//128)*(N//128),)](x, w0, w1, w2, b, out, M, N, K,\n    x.stride(0), x.stride(1), w0.stride(0), w0.stride(1),\n    out.stride(0), out.stride(1),\n    BM=128, BN=128, BK=32, GM=8, num_warps=8, num_stages=4)\ntorch.cuda.synchronize()\nprint('kbf err:', (out-ref).abs().max().item())\nEOF\ngpu push sb-7DII30Hvisr3hFrKntoV7Q /workspace/tune3.py /workspace/tune3.py\n"]
[685.517699, "o", "\u001b[?2004h> "]
