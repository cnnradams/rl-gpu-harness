[227.509971, "o", "\u001b[01;31m\u001b[Kninja\u001b[m\u001b[K                     1.13.2\r\n"]
[227.513144, "o", "\u001b[01;31m\u001b[Ktorch\u001b[m\u001b[K                     2.9.0\r\n"]
