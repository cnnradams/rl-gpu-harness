[342.0078, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[342.007825, "o", "\u001b[?2004h> "]
[342.007925, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[342.007959, "o", "\u001b[?2004h> "]
[342.007992, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.008099, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[342.008125, "o", "\u001b[?2004h> "]
[342.008187, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[342.008218, "o", "\u001b[?2004h> "]
[342.008249, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[342.008273, "o", "\u001b[?2004h> "]
[342.008305, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[342.00833, "o", "\u001b[?2004h> "]
[342.008367, "o", "        self._b = None\r\n\u001b[?2004l\r"]
[342.008399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.008442, "o", "    def _prepare(self):\r\n\u001b[?2004l\r"]
[342.008475, "o", "\u001b[?2004h> "]
[342.008509, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[342.00854, "o", "\u001b[?2004h> "]
[342.008607, "o", "            s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[342.008634, "o", "\u001b[?2004h> "]
[342.008684, "o", "            w = self.matmul.weight\r\n\u001b[?2004l\r"]
[342.00871, "o", "\u001b[?2004h> "]
[342.008772, "o", "            wt = (w * s).t().contiguous()\r\n\u001b[?2004l\r"]
[342.008798, "o", "\u001b[?2004h> "]
[342.008836, "o", "            wh = wt.half()\r\n\u001b[?2004l\r"]
[342.008864, "o", "\u001b[?2004h> "]
[342.008925, "o", "            wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[342.008957, "o", "\u001b[?2004h> "]
[342.008988, "o", "            self._wh = wh\r\n\u001b[?2004l\r"]
[342.009019, "o", "\u001b[?2004h> "]
[342.009046, "o", "            self._wl = wl\r\n\u001b[?2004l\r"]
[342.009066, "o", "\u001b[?2004h> "]
[342.00917, "o", "            self._b = (self.matmul.bias * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.0092, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.00925, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[342.009277, "o", "\u001b[?2004h> "]
[342.009372, "o", "        if self._wh is None or self._wh.device != x.device:\r\n\u001b[?2004l\r"]
[342.009398, "o", "\u001b[?2004h> "]
[342.009428, "o", "            self._prepare()\r\n\u001b[?2004l\r"]
[342.009459, "o", "\u001b[?2004h> "]
[342.009491, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[342.009521, "o", "\u001b[?2004h> "]
[342.00956, "o", "        N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[342.009591, "o", "\u001b[?2004h> "]
[342.009648, "o", "        BM, BN, BK, GM = 128, 128, 64, 8\r\n\u001b[?2004l\r"]
[342.009681, "o", "\u001b[?2004h> "]
[342.00984, "o", "        if x.is_contiguous() and M % BM == 0 and N % BN == 0 and K % BK == 0 and x.dtype == torch.float32:\r\n\u001b[?2004l\r"]
[342.009874, "o", "\u001b[?2004h> "]
[342.009979, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[342.01001, "o", "\u001b[?2004h> "]
[342.010078, "o", "            grid = ((M // BM) * (N // BN),)\r\n\u001b[?2004l\r"]
[342.010109, "o", "\u001b[?2004h> "]
[342.010151, "o", "            _lin15_kernel[grid](\r\n\u001b[?2004l\r"]
[342.010183, "o", "\u001b[?2004h> "]
[342.010269, "o", "                x, self._wh, self._wl, self._b, out, M, N, K,\r\n\u001b[?2004l\r"]
[342.010302, "o", "\u001b[?2004h> "]
[342.010356, "o", "                x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[342.010388, "o", "\u001b[?2004h> "]
[342.010464, "o", "                self._wh.stride(0), self._wh.stride(1),\r\n\u001b[?2004l\r"]
[342.010499, "o", "\u001b[?2004h> "]
[342.010574, "o", "                self._wl.stride(0), self._wl.stride(1),\r\n\u001b[?2004l\r"]
[342.010607, "o", "\u001b[?2004h> "]
[342.010667, "o", "                out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[342.010699, "o", "\u001b[?2004h> "]
[342.010757, "o", "                BM=BM, BN=BN, BK=BK, GM=GM,\r\n\u001b[?2004l\r"]
[342.010789, "o", "\u001b[?2004h> "]
[342.010846, "o", "                num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[342.010878, "o", "\u001b[?2004h> "]
[342.010906, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.010948, "o", "            return out\r\n\u001b[?2004l\r"]
[342.010973, "o", "\u001b[?2004h> "]
[342.011077, "o", "        t = F.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r"]
[342.011108, "o", "\u001b[?2004h> "]
[342.011169, "o", "        return t * self.scaling_factor + t\r\n\u001b[?2004l\r"]
[342.011201, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[342.012915, "o", "\u001b[?2004hroot@modal:/workspace# "]
