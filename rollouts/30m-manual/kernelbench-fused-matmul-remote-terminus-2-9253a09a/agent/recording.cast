[685.518295, "o", "r\u001b[?2004h"]
[685.518325, "o", "> "]
[685.518535, "o", "w = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\r\n\u001b[?2004l\r"]
[685.518568, "o", "\u001b[?2004h> "]
