[685.523818, "o", "\u001b[?2004h> "]
[685.523867, "o", "    gid = pid // width\r\n\u001b[?2004l\r"]
[685.523882, "o", "\u001b[?2004h> "]
[685.523964, "o", "    gsize = tl.minimum(grid_m - gid * GM, GM)\r\n\u001b[?2004l\r"]
[685.523981, "o", "\u001b[?2004h> "]
[685.524046, "o", "    pid_m = gid * GM + (pid % gsize)\r\n\u001b[?2004l\r"]
[685.524062, "o", "\u001b[?2004h> "]
[685.524126, "o", "    pid_n = (pid % width) // gsize\r\n\u001b[?2004l\r"]
[685.524143, "o", "\u001b[?2004h> "]
[685.524245, "o", "    om = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[685.524263, "o", "\u001b[?2004h> "]
[685.524328, "o", "    on = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[685.524349, "o", "\u001b[?2004h> "]
[685.52439, "o", "    ok = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[685.524412, "o", "\u001b[?2004h> "]
[685.524493, "o", "    xp = X + om[:, None] * sxm + ok[None, :] * sxk\r\n\u001b[?2004l\r"]
[685.52451, "o", "\u001b[?2004h> "]
[685.524597, "o", "    w0p = W0 + ok[:, None] * swk + on[None, :] * swn\r\n\u001b[?2004l\r"]
[685.524618, "o", "\u001b[?2004h> "]
[685.524703, "o", "    w1p = W1 + ok[:, None] * swk + on[None, :] * swn\r\n\u001b[?2004l\r"]
[685.524724, "o", "\u001b[?2004h> "]
[685.524808, "o", "    w2p = W2 + ok[:, None] * swk + on[None, :] * swn\r\n\u001b[?2004l\r"]
[685.524829, "o", "\u001b[?2004h> "]
[685.524899, "o", "    acc = tl.zeros((BM, BN), tl.float32)\r\n\u001b[?2004l\r"]
[685.524914, "o", "\u001b[?2004h> "]
[685.524968, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[685.524983, "o", "\u001b[?2004h> "]
