[685.525271, "o", "\u001b[?2004h> "]
[685.525365, "o", "        x2 = (r0 - x1.to(tl.float32)).to(tl.bfloat16)\r\n\u001b[?2004l\r"]
[685.52538, "o", "\u001b[?2004h> "]
[685.525491, "o", "        w0 = tl.load(w0p); w1 = tl.load(w1p); w2 = tl.load(w2p)\r\n\u001b[?2004l\r\u001b[?2004h"]
[685.525512, "o", "> "]
[685.525563, "o", "        acc = tl.dot(x0, w0, acc)\r\n\u001b[?2004l\r"]
[685.525582, "o", "\u001b[?2004h> "]
[685.525638, "o", "        acc = tl.dot(x0, w1, acc)\r\n\u001b[?2004l\r"]
[685.525659, "o", "\u001b[?2004h> "]
