[685.522388, "o", "\u001b[?2004h> "]
[685.522517, "o", "        acc = tl.dot(xl, wh_, acc)\r\n\u001b[?2004l\rr\u001b[?2004h"]
[685.522533, "o", "> "]
[685.522649, "o", "        acc = tl.dot(xh, wl_, acc)\r\n\u001b[?2004l\rE"]
[685.522666, "o", "\u001b[?2004h> "]
