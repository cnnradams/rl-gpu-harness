[685.517789, "o", "> "]
[685.517922, "o", "import triton, triton.language as tl\r\n\u001b[?2004l\r"]
[685.517948, "o", "\u001b[?2004h"]
[685.517981, "o", "> \r\n\u001b[?2004l\r)\u001b[?2004h> "]
[685.518028, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[685.51806, "o", "\u001b[?2004h> "]
[685.518143, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[685.518175, "o", "\u001b[?2004h> "]
