[594.734345, "o", "    acc = tl.zeros((BM, BN), tl.float32)\r\n\u001b[?2004l\r"]
[594.73436, "o", "\u001b[?2004h> "]
[594.734414, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[594.734428, "o", "\u001b[?2004h"]
[594.734447, "o", "> "]
[594.734477, "o", "        xx = tl.load(xp)\r\n\u001b[?2004l\r"]
[594.734494, "o", "\u001b[?2004h> "]
[594.734538, "o", "        ww = tl.load(wp)\r\n\u001b[?2004l\r"]
[594.734557, "o", "\u001b[?2004h> "]
[594.734612, "o", "        acc = tl.dot(xx, ww, acc)\r\n\u001b[?2004l\r"]
[594.734631, "o", "\u001b[?2004h> "]
[594.734695, "o", "        xp += BK * sxk; wp += BK * swk\r\n\u001b[?2004l\r"]
[594.734712, "o", "\u001b[?2004h> "]
[594.734755, "o", "    bb = tl.load(B + on)\r\n\u001b[?2004l\r"]
[594.734773, "o", "\u001b[?2004h> "]
[594.734821, "o", "    acc = acc + bb[None, :]\r\n\u001b[?2004l\r"]
[594.734835, "o", "\u001b[?2004h> "]
[594.734922, "o", "    op = O + om[:, None] * som + on[None, :] * son\r\n\u001b[?2004l\r"]
[594.734937, "o", "\u001b[?2004h> "]
[594.734978, "o", "    tl.store(op, acc)\r\n\u001b[?2004l\r"]
[594.734994, "o", "\u001b[?2004h"]
[594.735008, "o", "> \r\n\u001b[?2004l\r"]
[594.735026, "o", "\u001b[?2004h> "]
[594.735056, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[594.735076, "o", "\u001b[?2004h> "]
[594.735226, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[594.735241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[594.735259, "o", "\u001b[?2004h> "]
[594.735304, "o", "def bench(fn, n=10):\r\n\u001b[?2004l\r"]
[594.735318, "o", "\u001b[?2004h> "]
[594.73534, "o", "    try:\r\n\u001b[?2004l\r"]
[594.735355, "o", "\u001b[?2004h> "]
[594.735411, "o", "        for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[594.735431, "o", "\u001b[?2004h> "]
[594.735475, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[594.735491, "o", "\u001b[?2004h> "]
[594.735548, "o", "        return None, str(e)[:80]\r\n\u001b[?2004l\r"]
[594.735564, "o", "\u001b[?2004h> "]
[594.735617, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[594.735632, "o", "\u001b[?2004h> "]
[594.735657, "o", "    ts = []\r\n\u001b[?2004l\r"]
[594.735675, "o", "\u001b[?2004h> "]
[594.735715, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[594.735731, "o", "\u001b[?2004h> "]
[594.735789, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[594.735804, "o", "\u001b[?2004h> "]
[594.735953, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[594.735968, "o", "\u001b[?2004h> "]
[594.736003, "o", "        clear_l2()\r\n\u001b[?2004l\r"]
[594.736019, "o", "\u001b[?2004h> "]
[594.736123, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[594.736137, "o", "\u001b[?2004h> "]
[594.736207, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[594.736222, "o", "\u001b[?2004h> "]
[594.736253, "o", "    ts = ts[1:]\r\n\u001b[?2004l\r"]
[594.736269, "o", "\u001b[?2004h> "]
[594.736333, "o", "    return sum(ts)/len(ts), None\r\n\u001b[?2004l\r"]
[594.736348, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[594.736367, "o", "\u001b[?2004h> "]
[594.736472, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[594.736487, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[594.736505, "o", "\u001b[?2004h"]
[594.736522, "o", "> "]
[594.736586, "o", "def mk4(BM, BN, BK, GM, warps, stages):\r\n\u001b[?2004l\r"]
[594.736601, "o", "\u001b[?2004h> "]
[594.736665, "o", "    grid = ((M // BM) * (N // BN),)\r\n\u001b[?2004l\r"]
[594.73668, "o", "\u001b[?2004h> "]
[594.736712, "o", "    SBK = 4096*16\r\n\u001b[?2004l\r"]
[594.736727, "o", "\u001b[?2004h> "]
[594.736756, "o", "    def fn():\r\n\u001b[?2004l\r"]
[594.73677, "o", "\u001b[?2004h> "]
[594.736887, "o", "        splitx[((M*K)//SBK,)](x, xh, xl, M*K, BK=SBK, num_warps=8)\r\n\u001b[?2004l\r"]
[594.736904, "o", "\u001b[?2004h> "]
[594.736984, "o", "        k4[grid](xh, xl, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[594.736999, "o", "\u001b[?2004h> "]
[594.737119, "o", "                xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r"]
[594.737134, "o", "\u001b[?2004h> "]
[594.737261, "o", "                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[594.737276, "o", "\u001b[?2004h> "]
[594.737418, "o", "                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[594.737435, "o", "\u001b[?2004h> "]
[594.737464, "o", "    return fn\r\n\u001b[?2004l\r"]
[594.737478, "o", "\u001b[?2004h> \r\n"]
[594.737492, "o", "\u001b[?2004l\r"]
[594.73751, "o", "\u001b[?2004h> "]
[594.737575, "o", "def mktf(BM, BN, BK, GM, warps, stages):\r\n\u001b[?2004l\r"]
[594.737591, "o", "\u001b[?2004h> "]
[594.737652, "o", "    grid = ((M // BM) * (N // BN),)\r\n\u001b[?2004l\r"]
[594.737669, "o", "\u001b[?2004h> "]
[594.737695, "o", "    def fn():\r\n\u001b[?2004l\r"]
[594.737709, "o", "\u001b[?2004h> "]
[594.737782, "o", "        ktf[grid](x, w, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[594.737796, "o", "\u001b[?2004h> "]
[594.737909, "o", "                x.stride(0), x.stride(1), w.stride(0), w.stride(1),\r\n\u001b[?2004l\r"]
[594.737929, "o", "\u001b[?2004h> "]
[594.738003, "o", "                out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[594.738018, "o", "\u001b[?2004h> "]
[594.738149, "o", "                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[594.738168, "o", "\u001b[?2004h> "]
[594.738197, "o", "    return fn\r\n\u001b[?2004l\r"]
[594.738213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[594.738231, "o", "\u001b[?2004h"]
[594.73825, "o", "> "]
[594.738339, "o", "print('--- k4 (precomputed xl, includes split kernel) ---')\r\n\u001b[?2004l\r"]
[594.738354, "o", "\u001b[?2004h> "]
[594.73868, "o", "for c in [(256,128,32,8,8,4),(256,128,32,8,8,5),(256,128,32,8,8,6),(256,128,64,8,8,3),(256,128,64,8,8,4),(256,256,32,8,8,3),(256,64,32,8,4,4),(128,128,32,8,8,4),(256,128,32,4,8,4),(256,128,32,16,8,4)]:\r\n\u001b[?2004l\r"]
[594.7387, "o", "\u001b[?2004h> "]
[594.738741, "o", "    t, err = bench(mk4(*c))\r\n\u001b[?2004l\r"]
[594.738756, "o", "\u001b[?2004h> "]
[594.738942, "o", "    print(f'k4 BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\r\n\u001b[?2004l\r"]
[594.738962, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[594.738977, "o", "\u001b[?2004h> "]
[594.739054, "o", "print('--- tf32 direct (reference point) ---')\r\n\u001b[?2004l\r"]
[594.739067, "o", "\u001b[?2004h> "]
[594.739225, "o", "for c in [(128,128,32,8,8,4),(128,128,64,8,8,3),(256,128,32,8,8,4),(128,256,64,8,8,3)]:\r\n\u001b[?2004l\r"]
[594.739239, "o", "\u001b[?2004h> "]
[594.739288, "o", "    t, err = bench(mktf(*c))\r\n\u001b[?2004l\r"]
[594.739303, "o", "\u001b[?2004h> "]
[594.73949, "o", "    print(f'tf BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[594.739509, "o", "> \r\n\u001b[?2004l\r"]
[594.739528, "o", "\u001b[?2004h> "]
[594.739558, "o", "ref = x @ w + b\r\n\u001b[?2004l\r"]
[594.739573, "o", "\u001b[?2004h> "]
[594.739688, "o", "splitx[((M*K)//(4096*16),)](x, xh, xl, M*K, BK=4096*16, num_warps=8)\r\n\u001b[?2004l\r"]
[594.739702, "o", "\u001b[?2004h"]
[594.739716, "o", "> "]
[594.739801, "o", "k4[((M//256)*(N//128),)](xh, xl, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[594.739819, "o", "\u001b[?2004h> "]
[594.739917, "o", "    xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r"]
[594.739937, "o", "\u001b[?2004h> "]
[594.740036, "o", "    wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[594.740052, "o", "\u001b[?2004h> "]
[594.740152, "o", "    BM=256, BN=128, BK=32, GM=8, num_warps=8, num_stages=4)\r\n\u001b[?2004l\r"]
[594.740174, "o", "\u001b[?2004h> "]
[594.740215, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[594.74023, "o", "\u001b[?2004h> "]
[594.740314, "o", "print('k4 err:', (out-ref).abs().max().item())\r\n\u001b[?2004l\r"]
[594.740334, "o", "\u001b[?2004h> "]
[594.740352, "o", "EOF\r\n\u001b[?2004l\r"]
