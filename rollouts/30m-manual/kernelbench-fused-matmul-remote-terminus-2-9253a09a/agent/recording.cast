[349.722282, "o", "box: sb-7DII30Hvisr3hFrKntoV7Q\r\ncommand: ab5e57b582434e58a49181cb7a7bbb36\r\n{\r\n  \"id\": \"ab5e57b582434e58a49181cb7a7bbb36\",\r\n  \"trial\": \"5724ab17d4514120bca85234f91fd841\",\r\n  \"box\": \"sb-7DII30Hvisr3hFrKntoV7Q\",\r\n  \"state\": \"running\"\r\n}\r\n"]
[349.739439, "o", "\u001b[?2004hroot@modal:/workspace# "]
[370.747779, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time, sys\nimport torch.nn.functional as F\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nsf = 0.5\nx = torch.rand(M, K, device='cuda')\nmodel = ModelNew(K, N, sf)\nmodel.cuda()\n\nwith torch.no_grad():\n    ref = (F.linear(x, model.matmul.weight, model.matmul.bias))\n    ref = ref * sf + ref\n    out = model(x)\n    torch.cuda.synchronize()\n    err = (out - ref).abs().max().item()\n    rel = ((out - ref).abs() / (ref.abs() + 1e-3)).max().item()\n    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n    print(f'triton-split max_abs_err={err:.3e} allclose={ok}')\n\n    xh = x.half(); xl = (x - xh.float()).half()\n    wh = model._wh; wl = model._wl\n    out2 = (xh @ wh + xl @ wh + xh @ wl) + model._b\n    print(f'torch-split  max_abs_err={(out2-ref).abs().max().item():.3e} allclose={torch.allclose(ref,out2,atol=1e-4,rtol=1e-4)}')\n\n    out16 = F.linear(x.half(), (model.matmul.weight*1.5).half(), (model.matmul.bia"]
[370.747825, "i", "s*1.5).half()).float()\n    print(f'fp16-direct max_abs_err={(out16-ref).abs().max().item():.3e} allclose={torch.allclose(ref,out16,atol=1e-4,rtol=1e-4)}')\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times)\n\nwith torch.no_grad():\n    w = model.matmul.weight; b = model.matmul.bias\n    def f_ref():\n        t = F.linear(x, w, b); return t*sf + t\n    def f_triton():\n        return model(x)\n    xh = x.half(); xl = (x - xh.float()).half(); wh = model._wh; wl = model._wl; bb = model._b\n    def f_torchsplit():\n        return (xh @ wh + xl @ wh + "]
[370.747993, "i", "xh @ wl) + bb\n    print(f'ref:        {bench(f_ref):.3f} ms')\n    print(f'triton:     {bench(f_triton):.3f} ms')\n    print(f'torchsplit: {bench(f_torchsplit):.3f} ms')\n    torch.backends.cuda.matmul.allow_tf32 = True\n    def f_tf32():\n        t = F.linear(x, w, b); return t*sf + t\n    print(f'tf32-ref:   {bench(f_tf32):.3f} ms')\n    torch.backends.cuda.matmul.allow_tf32 = False\nEOF\necho done\n"]
