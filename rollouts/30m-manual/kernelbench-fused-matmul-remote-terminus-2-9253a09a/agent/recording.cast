[850.999463, "i", "cat > /workspace/tune4.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\nwh = w.half(); wl = (w - wh.float()).half()\nb = torch.randn(N, device='cuda')\n\n@triton.jit\ndef k2a(X, WH, WL, B, O, M, N, K,\n        sxm, sxk, swk, swn, slk, sln, som, son,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    xp = X + om[:, None] * sxm + ok[None, :] * sxk\n    wp = WH + ok[:, None] * swk + on[None, :] * swn\n    lp = WL + ok[:, None] * slk + on[None, :] * sln\n    acc0 = tl.zeros("]
[850.999505, "i", "(BM, BN), tl.float32)\n    acc1 = tl.zeros((BM, BN), tl.float32)\n    for _ in range(0, K, BK):\n        xx = tl.load(xp)\n        wh_ = tl.load(wp)\n        wl_ = tl.load(lp)\n        xh = xx.to(tl.float16)\n        xl = (xx - xh.to(tl.float32)).to(tl.float16)\n        acc0 = tl.dot(xh, wh_, acc0)\n        acc1 = tl.dot(xl, wh_, acc1)\n        acc0 = tl.dot(xh, wl_, acc0)\n        xp += BK * sxk; wp += BK * swk; lp += BK * slk\n    acc = acc0 + acc1\n    bb = tl.load(B + on)\n    acc = acc + bb[None, :].to(tl.float32)\n    op = O + om[:, None] * som + on[None, :] * son\n    tl.store(op, acc)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=12):\n    try:\n        for _ in range(3): fn()\n    except Exception as e:\n        return None, str(e)[:60]\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n   "]
[850.999535, "i", "     s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = ts[1:]\n    return sum(ts)/len(ts), None\n\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ndef mk2a(BM, BN, BK, GM, warps, stages):\n    grid = ((M // BM) * (N // BN),)\n    def fn():\n        k2a[grid](x, wh, wl, b, out, M, N, K,\n                x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\n                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\n    return fn\n\nprint('--- k2a two-accumulator ---')\nfor c in [(256,128,32,8,8,4),(256,128,32,8,8,3),(128,256,32,8,8,4),(128,256,32,8,8,3),(128,128,32,8,8,4),(256,128,32,4,8,4),(256,128,32,16,8,4),(128,256,32,4,8,4),(128,256,32,16,8,4),(128,128,64,8,8,3),(128,128,32,8,8,5)]:\n    t, err = bench(mk2a(*c))\n    print(f'k2a BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\n\nref = x @ w + b\nk2a[((M//256)*(N//128"]
[850.99973, "i", "),)](x, wh, wl, b, out, M, N, K,\n    x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\n    wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n    BM=256, BN=128, BK=32, GM=8, num_warps=8, num_stages=4)\ntorch.cuda.synchronize()\nprint('k2a err:', (out-ref).abs().max().item())\nEOF\ngpu push sb-7DII30Hvisr3hFrKntoV7Q /workspace/tune4.py /workspace/tune4.py\n"]
[850.999739, "o", "cat > /workspace/tune4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.999866, "o", "import triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.999915, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.999954, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.999987, "o", "> "]
