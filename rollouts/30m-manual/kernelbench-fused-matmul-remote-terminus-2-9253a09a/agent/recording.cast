[851.00005, "o", "> "]
[851.00017, "o", "w = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.000204, "o", "> "]
[851.000251, "o", "wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r"]
[851.00027, "o", "\u001b[?2004h> "]
[851.00033, "o", "b = torch.randn(N, device='cuda')\r\n\u001b[?2004l\r"]
[851.000364, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.000397, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.00046, "o", "def k2a(X, WH, WL, B, O, M, N, K,\r\n\u001b[?2004l\r"]
[851.000494, "o", "\u001b[?2004h> "]
[851.000554, "o", "        sxm, sxk, swk, swn, slk, sln, som, son,\r\n\u001b[?2004l\r"]
[851.000588, "o", "\u001b[?2004h> "]
[851.000704, "o", "        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.000738, "o", "> "]
[851.000771, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.000863, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[851.000895, "o", "\u001b[?2004h> "]
[851.000928, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.000974, "o", "    gid = pid // width\r\n\u001b[?2004l\r"]
[851.001006, "o", "\u001b[?2004h> "]
[851.001066, "o", "    gsize = tl.minimum(grid_m - gid * GM, GM)\r\n\u001b[?2004l\r"]
[851.001099, "o", "\u001b[?2004h> "]
[851.001144, "o", "    pid_m = gid * GM + (pid % gsize)\r\n\u001b[?2004l\r"]
[851.001177, "o", "\u001b[?2004h> "]
[851.001219, "o", "    pid_n = (pid % width) // gsize\r\n\u001b[?2004l\r"]
[851.001251, "o", "\u001b[?2004h> "]
[851.001306, "o", "    om = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[851.001333, "o", "\u001b[?2004h> "]
[851.001402, "o", "    on = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[851.00143, "o", "\u001b[?2004h> "]
[851.001456, "o", "    ok = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[851.00149, "o", "\u001b[?2004h> "]
[851.001558, "o", "    xp = X + om[:, None] * sxm + ok[None, :] * sxk\r\n\u001b[?2004l\r"]
[851.001592, "o", "\u001b[?2004h> "]
[851.00166, "o", "    wp = WH + ok[:, None] * swk + on[None, :] * swn\r\n\u001b[?2004l\r"]
[851.001692, "o", "\u001b[?2004h> "]
[851.001761, "o", "    lp = WL + ok[:, None] * slk + on[None, :] * sln\r\n\u001b[?2004l\r"]
[851.001793, "o", "\u001b[?2004h> "]
[851.001846, "o", "    acc0 = tl.zeros((BM, BN), tl.float32)\r\n\u001b[?2004l\r"]
[851.001879, "o", "\u001b[?2004h> "]
[851.00193, "o", "    acc1 = tl.zeros((BM, BN), tl.float32)\r\n\u001b[?2004l\r"]
[851.001957, "o", "\u001b[?2004h> "]
[851.001997, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[851.002024, "o", "\u001b[?2004h> "]
[851.002057, "o", "        xx = tl.load(xp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.002089, "o", "> "]
[851.002123, "o", "        wh_ = tl.load(wp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.002172, "o", "        wl_ = tl.load(lp)\r\n\u001b[?2004l\r"]
[851.002203, "o", "\u001b[?2004h> "]
[851.002236, "o", "        xh = xx.to(tl.float16)\r\n\u001b[?2004l\r"]
[851.002269, "o", "\u001b[?2004h> "]
[851.002347, "o", "        xl = (xx - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[851.002379, "o", "\u001b[?2004h> "]
[851.002424, "o", "        acc0 = tl.dot(xh, wh_, acc0)\r\n\u001b[?2004l\r"]
[851.002457, "o", "\u001b[?2004h> "]
[851.002501, "o", "        acc1 = tl.dot(xl, wh_, acc1)\r\n\u001b[?2004l\r"]
[851.002527, "o", "\u001b[?2004h> "]
[851.002578, "o", "        acc0 = tl.dot(xh, wl_, acc0)\r\n\u001b[?2004l\r"]
[851.00261, "o", "\u001b[?2004h> "]
[851.002682, "o", "        xp += BK * sxk; wp += BK * swk; lp += BK * slk\r\n\u001b[?2004l\r"]
[851.002714, "o", "\u001b[?2004h> "]
[851.002747, "o", "    acc = acc0 + acc1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.002794, "o", "    bb = tl.load(B + on)\r\n\u001b[?2004l\r"]
[851.002825, "o", "\u001b[?2004h> "]
[851.00288, "o", "    acc = acc + bb[None, :].to(tl.float32)\r\n\u001b[?2004l\r"]
[851.002906, "o", "\u001b[?2004h> "]
[851.002979, "o", "    op = O + om[:, None] * som + on[None, :] * son\r\n\u001b[?2004l\r"]
[851.003011, "o", "\u001b[?2004h> "]
[851.003038, "o", "    tl.store(op, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.003064, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.0031, "o", "def clear_l2():\r\n\u001b[?2004l\r"]
[851.003132, "o", "\u001b[?2004h> "]
[851.00327, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[851.003308, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[851.003341, "o", "def bench(fn, n=12):\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.003373, "o", ">     try:\r\n\u001b[?2004l\r"]
[851.003407, "o", "\u001b[?2004h> "]
[851.00344, "o", "        for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[851.003473, "o", "\u001b[?2004h> "]
[851.003505, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[851.003532, "o", "\u001b[?2004h> "]
[851.003583, "o", "        return None, str(e)[:60]\r\n\u001b[?2004l\r"]
[851.003615, "o", "\u001b[?2004h> "]
[851.00365, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[851.003683, "o", "\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r"]
[851.003716, "o", "\u001b[?2004h> "]
[851.003748, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[851.003781, "o", "\u001b[?2004h> "]
[851.003814, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[851.003841, "o", "\u001b[?2004h> "]
[851.003987, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[851.004021, "o", "\u001b[?2004h> "]
[851.004047, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.004156, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[851.004189, "o", "\u001b[?2004h> "]
[851.004236, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[851.004268, "o", "\u001b[?2004h> "]
[851.0043, "o", "    ts = ts[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.004359, "o", "    return sum(ts)/len(ts), None\r\n\u001b[?2004l\r"]
[851.004391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.0045, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[851.004532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.004598, "o", "def mk2a(BM, BN, BK, GM, warps, stages):\r\n\u001b[?2004l\r"]
[851.004631, "o", "\u001b[?2004h> "]
[851.004673, "o", "    grid = ((M // BM) * (N // BN),)\r\n\u001b[?2004l\r"]
[851.0047, "o", "\u001b[?2004h> "]
[851.004732, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.004805, "o", "        k2a[grid](x, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[851.004837, "o", "\u001b[?2004h> "]
[851.004937, "o", "                x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.004968, "o", "> "]
[851.005068, "o", "                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[851.005095, "o", "\u001b[?2004h> "]
[851.005212, "o", "                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[851.005245, "o", "\u001b[?2004h>     return fn\r\n\u001b[?2004l\r"]
[851.005279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.005354, "o", "print('--- k2a two-accumulator ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.005396, "o", "> "]
[851.005738, "o", "for c in [(256,128,32,8,8,4),(256,128,32,8,8,3),(128,256,32,8,8,4),(128,256,32,8,8,3),(128,128,32,8,8,4),(256,128,32,4,8,4),(256,128,32,16,8,4),(128,256,32,4,8,4),(128,256,32,16,8,4),(128,128,64,8,8,3),(128,128,32,8,8,5)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.005757, "o", "> "]
[851.0058, "o", "    t, err = bench(mk2a(*c))\r\n\u001b[?2004l\r"]
[851.005834, "o", "\u001b[?2004h> "]
[851.005999, "o", "    print(f'k2a BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[851.006034, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.006066, "o", "ref = x @ w + b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.006158, "o", "k2a[((M//256)*(N//128),)](x, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[851.006189, "o", "\u001b[?2004h> "]
[851.006267, "o", "    x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r"]
[851.006305, "o", "\u001b[?2004h> "]
[851.006388, "o", "    wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[851.006416, "o", "\u001b[?2004h> "]
[851.006501, "o", "    BM=256, BN=128, BK=32, GM=8, num_warps=8, num_stages=4)\r\n\u001b[?2004l\r"]
[851.006533, "o", "\u001b[?2004h> "]
[851.006566, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[851.006655, "o", "print('k2a err:', (out-ref).abs().max().item())\r\n\u001b[?2004l\r"]
[851.006688, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[851.007575, "o", "\u001b[?2004hroot@modal:/workspace# "]
[851.00771, "o", "gpu push sb-7DII30Hvisr3hFrKntoV7Q /workspace/tune4.py /workspace/tune4.py\r\n\u001b[?2004l\r"]
[852.130382, "o", "{\r\n  \"bytes\": 3323,\r\n  \"sha256\": \"46ce9d95115f66e499427b39391b84339f94923781a4d072aeceeb63f2d27cb2\"\r\n}\r\n"]
[852.147112, "o", "\u001b[?2004hroot@modal:/workspace# "]
[866.000865, "i", "gpu exec sb-7DII30Hvisr3hFrKntoV7Q -- python3 /workspace/tune4.py\n"]
[866.001126, "o", "gpu exec sb-7DII30Hvisr3hFrKntoV7Q -- python3 /workspace/tune4.py\r\n\u001b[?2004l\r"]
[866.093534, "o", "request ID: 65e8286d941441f888a654d67e10d3fb\r\n"]
[868.607899, "o", "command: 314e610bc811438aa7f79cb2dcb948c2\r\n"]
[879.623752, "o", "--- k2a two-accumulator ---\r\nk2a BM=256 BN=128 BK=32 GM=8 w=8 s=4: 25.168686606667258 ms\r\nk2a BM=256 BN=128 BK=32 GM=8 w=8 s=3: 24.402088685469195 ms\r\nk2a BM=128 BN=256 BK=32 GM=8 w=8 s=4: 29.321280045942828 ms\r\nk2a BM=128 BN=256 BK=32 GM=8 w=8 s=3: 29.403770273382012 ms\r\nk2a BM=128 BN=128 BK=32 GM=8 w=8 s=4: 2.635310563174161 ms\r\nk2a BM=256 BN=128 BK=32 GM=4 w=8 s=4: 24.651592948219992 ms\r\nk2a BM=256 BN=128 BK=32 GM=16 w=8 s=4: 25.367383089932527 ms\r\nk2a BM=128 BN=256 BK=32 GM=4 w=8 s=4: 29.44234743985263 ms\r\nk2a BM=128 BN=256 BK=32 GM=16 w=8 s=4: 29.04584451155229 ms\r\nk2a BM=128 BN=128 BK=64 GM=8 w=8 s=3: 2.7830283641815186 ms\r\nk2a BM=128 BN=128 BK=32 GM=8 w=8 s=5: 2.6086719903078945 ms\r\nk2a err: 7.295608520507812e-05\r\n"]
[880.464343, "o", "\u001b[?2004hroot@modal:/workspace# "]
[935.310731, "i", "cat > /workspace/tune5.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nfrom solution import _lin15_kernel as k3\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\nwh = w.half(); wl = (w - wh.float()).half()\nb = torch.randn(N, device='cuda')\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=14):\n    try:\n        for _ in range(3): fn()\n    except Exception as e:\n        return None, str(e)[:60]\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = ts[1:]\n    return sum(ts)/len(ts), None\n\n"]
[935.310775, "i", "def mk3(BM, BN, BK, GM, warps, stages):\n    grid = ((M // BM) * (N // BN),)\n    def fn():\n        k3[grid](x, wh, wl, b, out, M, N, K,\n                x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\n                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\n    return fn\n\nfor c in [(128,256,32,8,8,4),(128,256,32,8,8,3),(128,256,64,8,8,2),(256,128,32,8,8,4),(128,256,16,8,8,4),(128,256,32,4,8,4),(128,256,32,16,8,4)]:\n    t, err = bench(mk3(*c))\n    print(f'k3 BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\nEOF\ngpu push sb-7DII30Hvisr3hFrKntoV7Q /workspace/tune5.py /workspace/tune5.py\n"]
[935.310993, "o", "cat > /workspace/tune5.py << 'EOF'\r\n\u001b[?2004l\r"]
[935.311038, "o", "\u001b[?2004h> "]
[935.311076, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.311137, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.31117, "o", "import triton\r\n\u001b[?2004l\r"]
[935.311194, "o", "\u001b[?2004h> "]
[935.311258, "o", "from solution import _lin15_kernel as k3\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.311272, "o", "> \r\n\u001b[?2004l\r"]
[935.311382, "o", "\u001b[?2004h> torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[935.311422, "o", "\u001b[?2004h> "]
[935.311471, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[935.311503, "o", "\u001b[?2004h> "]
[935.311606, "o", "w = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\r\n\u001b[?2004l\r"]
[935.31163, "o", "\u001b[?2004h> "]
[935.311694, "o", "wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r"]
[935.311721, "o", "\u001b[?2004h> "]
[935.31177, "o", "b = torch.randn(N, device='cuda')\r\n\u001b[?2004l\r"]
[935.311795, "o", "\u001b[?2004h> "]
[935.311891, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[935.311919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[935.311947, "o", "\u001b[?2004h> "]
[935.311973, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.312006, "o", "> "]
[935.312138, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[935.312166, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.312211, "o", "def bench(fn, n=14):\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.312238, "o", ">     try:\r\n\u001b[?2004l\r"]
[935.312265, "o", "\u001b[?2004h> "]
[935.312318, "o", "        for _ in range(3): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.312344, "o", "> "]
[935.312377, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[935.312411, "o", "\u001b[?2004h> "]
[935.312447, "o", "        return None, str(e)[:60]\r\n\u001b[?2004l\r"]
[935.312474, "o", "\u001b[?2004h> "]
[935.312511, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[935.312537, "o", "\u001b[?2004h> "]
[935.312563, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.312609, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[935.312636, "o", "\u001b[?2004h> "]
[935.312687, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[935.312712, "o", "\u001b[?2004h> "]
[935.312856, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[935.312882, "o", "\u001b[?2004h> "]
[935.312908, "o", "        clear_l2()\r\n\u001b[?2004l\r"]
[935.312933, "o", "\u001b[?2004h> "]
[935.313032, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[935.313058, "o", "\u001b[?2004h> "]
[935.313112, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[935.313138, "o", "\u001b[?2004h> "]
[935.313164, "o", "    ts = ts[1:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.31319, "o", "> "]
[935.313233, "o", "    return sum(ts)/len(ts), None\r\n\u001b[?2004l\r"]
[935.313259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[935.313284, "o", "\u001b[?2004h> "]
[935.313341, "o", "def mk3(BM, BN, BK, GM, warps, stages):\r\n\u001b[?2004l\r"]
[935.313393, "o", "\u001b[?2004h> "]
[935.31343, "o", "    grid = ((M // BM) * (N // BN),)\r\n\u001b[?2004l\r"]
[935.313457, "o", "\u001b[?2004h> "]
[935.313484, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[935.313563, "o", "        k3[grid](x, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[935.313589, "o", "\u001b[?2004h> "]
[935.313696, "o", "                x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.313722, "o", "> "]
[935.313828, "o", "                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[935.313856, "o", "\u001b[?2004h> "]
[935.313974, "o", "                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[935.314006, "o", "\u001b[?2004h> "]
[935.314034, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[935.314061, "o", "\u001b[?2004h> "]
[935.314293, "o", "for c in [(128,256,32,8,8,4),(128,256,32,8,8,3),(128,256,64,8,8,2),(256,128,32,8,8,4),(128,256,16,8,8,4),(128,256,32,4,8,4),(128,256,32,16,8,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[935.314325, "o", "> "]
[935.314352, "o", "    t, err = bench(mk3(*c))\r\n\u001b[?2004l\r"]
[935.314378, "o", "\u001b[?2004h> "]
[935.314549, "o", "    print(f'k3 BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\r\n\u001b[?2004l\r"]
