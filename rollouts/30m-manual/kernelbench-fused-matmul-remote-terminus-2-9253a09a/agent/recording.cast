[594.726441, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\nwh = w.half(); wl = (w - wh.float()).half()\nb = torch.randn(N, device='cuda')\nxh = x.half(); xl = (x - xh.float()).half()\n\n@triton.jit\ndef splitx(X, XH, XL, Ktot, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BK + tl.arange(0, BK)\n    xx = tl.load(X + off)\n    h = xx.to(tl.float16)\n    l = (xx - h.to(tl.float32)).to(tl.float16)\n    tl.store(XH + off, h)\n    tl.store(XL + off, l)\n\n@triton.jit\ndef k4(XH, XL, WH, WL, B, O, M, N, K,\n      sxm, sxk, swk, swn, slk, sln, som, son,\n      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % g"]
[594.726593, "i", "size)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    xhp = XH + om[:, None] * sxm + ok[None, :] * sxk\n    xlp = XL + om[:, None] * sxm + ok[None, :] * sxk\n    wp = WH + ok[:, None] * swk + on[None, :] * swn\n    lp = WL + ok[:, None] * slk + on[None, :] * sln\n    acc = tl.zeros((BM, BN), tl.float32)\n    for _ in range(0, K, BK):\n        xh_ = tl.load(xhp)\n        xl_ = tl.load(xlp)\n        wh_ = tl.load(wp)\n        wl_ = tl.load(lp)\n        acc = tl.dot(xh_, wh_, acc)\n        acc = tl.dot(xl_, wh_, acc)\n        acc = tl.dot(xh_, wl_, acc)\n        xhp += BK * sxk; xlp += BK * sxk; wp += BK * swk; lp += BK * slk\n    bb = tl.load(B + on)\n    acc = acc + bb[None, :].to(tl.float32)\n    op = O + om[:, None] * som + on[None, :] * son\n    tl.store(op, acc)\n\n@triton.jit\ndef ktf(X, W, B, O, M, N, K,\n        sxm, sxk, swk, swn, som, son,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid ="]
[594.726685, "o", "cat > /workspace/tune2.py << 'EOF'\r\n\u001b[?2004l\r"]
[594.726708, "i", " tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    xp = X + om[:, None] * sxm + ok[None, :] * sxk\n    wp = W + ok[:, None] * swk + on[None, :] * swn\n    acc = tl.zeros((BM, BN), tl.float32)\n    for _ in range(0, K, BK):\n        xx = tl.load(xp)\n        ww = tl.load(wp)\n        acc = tl.dot(xx, ww, acc)\n        xp += BK * sxk; wp += BK * swk\n    bb = tl.load(B + on)\n    acc = acc + bb[None, :]\n    op = O + om[:, None] * som + on[None, :] * son\n    tl.store(op, acc)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=10):\n    try:\n        for _ in range(3): fn()\n    except Exception as e:\n        return None, str(e)[:80]\n    torch.cuda.synchronize()\n   "]
[594.726723, "o", "\u001b[?2004h> "]
[594.726739, "i", " ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = ts[1:]\n    return sum(ts)/len(ts), None\n\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ndef mk4(BM, BN, BK, GM, warps, stages):\n    grid = ((M // BM) * (N // BN),)\n    SBK = 4096*16\n    def fn():\n        splitx[((M*K)//SBK,)](x, xh, xl, M*K, BK=SBK, num_warps=8)\n        k4[grid](xh, xl, wh, wl, b, out, M, N, K,\n                xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1),\n                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\n    return fn\n\ndef mktf(BM, BN, BK, GM, warps, stages):\n    grid = ((M // BM) * (N // BN),)\n    def fn():\n        ktf[grid](x, w, b, out, M, N, K,\n                x.stride(0), x.stride("]
[594.726751, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[594.726768, "i", "1), w.stride(0), w.stride(1),\n                out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)\n    return fn\n\nprint('--- k4 (precomputed xl, includes split kernel) ---')\nfor c in [(256,128,32,8,8,4),(256,128,32,8,8,5),(256,128,32,8,8,6),(256,128,64,8,8,3),(256,128,64,8,8,4),(256,256,32,8,8,3),(256,64,32,8,4,4),(128,128,32,8,8,4),(256,128,32,4,8,4),(256,128,32,16,8,4)]:\n    t, err = bench(mk4(*c))\n    print(f'k4 BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\n\nprint('--- tf32 direct (reference point) ---')\nfor c in [(128,128,32,8,8,4),(128,128,64,8,8,3),(256,128,32,8,8,4),(128,256,64,8,8,3)]:\n    t, err = bench(mktf(*c))\n    print(f'tf BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL \"+str(err)} ms')\n\nref = x @ w + b\nsplitx[((M*K)//(4096*16),)](x, xh, xl, M*K, BK=4096*16, num_warps=8)\nk4[((M//256)*(N//128),)](xh, xl, wh, wl, b, out, M, N, K,\n    xh.stride(0), xh.stride(1), wh"]
[594.72678, "o", "> "]
[594.726792, "i", ".stride(0), wh.stride(1),\n    wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n    BM=256, BN=128, BK=32, GM=8, num_warps=8, num_stages=4)\ntorch.cuda.synchronize()\nprint('k4 err:', (out-ref).abs().max().item())\nEOF\ngpu push sb-7DII30Hvisr3hFrKntoV7Q /workspace/tune2.py /workspace/tune2.py\n"]
