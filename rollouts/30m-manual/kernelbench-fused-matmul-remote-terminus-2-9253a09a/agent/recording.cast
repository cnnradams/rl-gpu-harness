[685.525733, "o", "\u001b[?2004h> "]
[685.52579, "o", "        acc = tl.dot(x1, w0, acc)\r\n\u001b[?2004l\r"]
[685.52581, "o", "\u001b[?2004h> "]
[685.525871, "o", "        acc = tl.dot(x1, w1, acc)\r\n\u001b[?2004l\r"]
[685.525892, "o", "\u001b[?2004h> "]
[685.525945, "o", "        acc = tl.dot(x2, w0, acc)\r\n\u001b[?2004l\r"]
[685.525966, "o", "\u001b[?2004h> "]
[685.526084, "o", "        xp += BK * sxk; w0p += BK * swk; w1p += BK * swk; w2p += BK * swk\r\n\u001b[?2004l\r"]
[685.526105, "o", "\u001b[?2004h> "]
[685.526147, "o", "    bb = tl.load(B + on)\r\n\u001b[?2004l\r"]
[685.526167, "o", "\u001b[?2004h> "]
[685.526237, "o", "    acc = acc + bb[None, :].to(tl.float32)\r\n\u001b[?2004l\r"]
[685.526258, "o", "\u001b[?2004h> "]
[685.526339, "o", "    op = O + om[:, None] * som + on[None, :] * son\r\n\u001b[?2004l\r"]
[685.526358, "o", "\u001b[?2004h> "]
