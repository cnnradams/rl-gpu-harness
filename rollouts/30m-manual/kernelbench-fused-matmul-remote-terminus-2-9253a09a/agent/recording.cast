[393.110603, "o", "triton-split max_abs_err=4.363e-05 allclose=True\r\ntorch-split  max_abs_err=1.349e-03 allclose=False\r\nfp16-direct max_abs_err=1.322e-03 allclose=False\r\nref:        11.222 ms\r\ntriton:     2.941 ms\r\ntorchsplit: 2.796 ms\r\ntf32-ref:   1.898 ms\r\n"]
[393.934419, "o", "\u001b[?2004hroot@modal:/workspace# "]
[508.239896, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, sys\nimport triton, triton.language as tl\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()\nwh = w.half(); wl = (w - wh.float()).half()\nb = torch.randn(N, device='cuda')\n\n@triton.jit\ndef k(X, WH, WL, B, O, M, N, K,\n      sxm, sxk, swk, swn, slk, sln, som, son,\n      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsize = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsize)\n    pid_n = (pid % width) // gsize\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    xp = X + om[:, None] * sxm + ok[None, :] * sxk\n    wp = WH + ok[:, None] * swk + on[None, :] * swn\n    lp = WL + ok[:, None] * slk + on[None, :] * sln\n    acc = tl.zeros((BM, BN)"]
[508.240014, "i", ", tl.float32)\n    for _ in range(0, K, BK):\n        xx = tl.load(xp)\n        wh_ = tl.load(wp)\n        wl_ = tl.load(lp)\n        xh = xx.to(tl.float16)\n        xl = (xx - xh.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(xh, wh_, acc)\n        acc = tl.dot(xl, wh_, acc)\n        acc = tl.dot(xh, wl_, acc)\n        xp += BK * sxk; wp += BK * swk; lp += BK * slk\n    bb = tl.load(B + on)\n    acc = acc + bb[None, :].to(tl.float32)\n    op = O + om[:, None] * som + on[None, :] * son\n    tl.store(op, acc)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench_cfg(BM, BN, BK, GM, warps, stages, n=10):\n    out = torch.empty((M, N), device='cuda', dtype=torch.float32)\n    grid = ((M // BM) * (N // BN),)\n    def fn():\n        k[grid](x, wh, wl, b, out, M, N, K,\n                x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\n                wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),\n                BM=BM, BN=BN, BK=BK, GM=GM, num_warps="]
[508.240038, "i", "warps, num_stages=stages)\n    try:\n        for _ in range(3): fn()\n    except Exception as e:\n        return None\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = ts[1:]\n    return sum(ts)/len(ts)\n\ncfgs = [\n    (128,128,64,8,8,3),\n    (128,128,64,8,8,4),\n    (128,256,32,8,8,4),\n    (128,256,64,8,8,2),\n    (128,256,64,8,8,3),\n    (256,128,32,8,8,4),\n    (256,128,64,8,8,2),\n    (256,128,64,8,8,3),\n    (128,128,32,8,8,5),\n    (256,64,64,8,8,3),\n    (64,256,64,8,8,2),\n    (128,64,64,8,4,4),\n    (256,256,32,8,8,2),\n    (256,256,64,8,8,2),\n]\nfor c in cfgs:\n    t = bench_cfg(*c)\n    print(f'BM={c[0]} BN={c[1]} BK={c[2]} GM={c[3]} w={c[4]} s={c[5]}: {t if t else \"FAIL\"} ms')\nEOF\ngpu push sb-7DII30Hvisr3hFrKntoV7Q /workspace/tune.py /workspace/tune.py\n"]
