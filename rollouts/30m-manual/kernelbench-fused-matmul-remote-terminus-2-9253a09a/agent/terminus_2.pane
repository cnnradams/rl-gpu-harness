[?2004l[?2004h>     ts = []
[?2004l[?2004h>     for _ in range(n):
[?2004l[?2004h>         torch.cuda.synchronize()
[?2004l[?2004h>         s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>         clear_l2()
[?2004l[?2004h>         s.record(); fn(); e.record(); torch.cuda.synchronize()
[?2004l[?2004h>         ts.append(s.elapsed_time(e))
[?2004l[?2004h>     ts = ts[1:]
[?2004l[?2004h>     return sum(ts)/len(ts), None
[?2004l[?2004h> 
[?2004l[?2004h> out = torch.empty((M, N), device='cuda', dtype=torch.float32)
[?2004l[?2004h> 
[?2004l[?2004h> def mk2a(BM, BN, BK, GM, warps, stages):
[?2004l[?2004h>     grid = ((M // BM) * (N // BN),)
[?2004l[?2004h>     def fn():
[?2004l[?2004h>         k2a[grid](x, wh, wl, b, out, M, N, K,
[?2004l[?2004h>                 x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),
[?2004l[?2004h>                 wl.stride(0), wl.stride(1), out.stride(0), out.stride(1),
[?2004l[?2004h>                 BM=BM, BN=BN, BK=BK, GM=GM, num_warps=warps, num_stages=stages)
[?2004l[?2004h>     return fn
[?2004l[?2004h> 
[?2004l[?2004h> print('--- k2a two-accumulator ---')
[?2004l[?2004h> for c in [(256,128,32,8,8,4),(256,128,32,8,8,3),(128,256,32,8,8,4),(128,256,32,8,8,3),(128,128,32,8,8,4),(256,128,32,4,8,4),(256,128,32,16,8,4),(128,256,32,4,8,4),(128,256,32,16,8,4),(128,128,64,8,8,3),(128,128,32,8,8,5)]:
