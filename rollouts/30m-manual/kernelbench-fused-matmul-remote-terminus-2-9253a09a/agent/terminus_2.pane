[?2004l[?2004h> b = torch.randn(N, device='cuda')
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def k2a(X, WH, WL, B, O, M, N, K,
[?2004l[?2004h>         sxm, sxk, swk, swn, slk, sln, som, son,
[?2004l[?2004h>         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GM * grid_n
[?2004l[?2004h>     gid = pid // width
[?2004l[?2004h>     gsize = tl.minimum(grid_m - gid * GM, GM)
[?2004l[?2004h>     pid_m = gid * GM + (pid % gsize)
[?2004l[?2004h>     pid_n = (pid % width) // gsize
[?2004l[?2004h>     om = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     on = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     ok = tl.arange(0, BK)
[?2004l[?2004h>     xp = X + om[:, None] * sxm + ok[None, :] * sxk
[?2004l[?2004h>     wp = WH + ok[:, None] * swk + on[None, :] * swn
[?2004l[?2004h>     lp = WL + ok[:, None] * slk + on[None, :] * sln
[?2004l[?2004h>     acc0 = tl.zeros((BM, BN), tl.float32)
[?2004l[?2004h>     acc1 = tl.zeros((BM, BN), tl.float32)
[?2004l[?2004h>     for _ in range(0, K, BK):
[?2004l[?2004h>         xx = tl.load(xp)
[?2004l[?2004h>         wh_ = tl.load(wp)
[?2004l[?2004h>         wl_ = tl.load(lp)
[?2004l[?2004h>         xh = xx.to(tl.float16)
[?2004l[?2004h>         xl = (xx - xh.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>         acc0 = tl.dot(xh, wh_, acc0)
[?2004l[?2004h>         acc1 = tl.dot(xl, wh_, acc1)
[?2004l[?2004h>         acc0 = tl.dot(xh, wl_, acc0)
[?2004l[?2004h>         xp += BK * sxk; wp += BK * swk; lp += BK * slk
[?2004l[?2004h>     acc = acc0 + acc1
[?2004l[?2004h>     bb = tl.load(B + on)
[?2004l[?2004h>     acc = acc + bb[None, :].to(tl.float32)
[?2004l[?2004h>     op = O + om[:, None] * som + on[None, :] * son
[?2004l[?2004h>     tl.store(op, acc)
[?2004l[?2004h> 
[?2004l[?2004h> def clear_l2():
[?2004l[?2004h>     d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d
[?2004l[?2004h> 
[?2004l[?2004h> def bench(fn, n=12):
[?2004l[?2004h>     try:
