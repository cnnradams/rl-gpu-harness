[?2004l[?2004h> torch.manual_seed(42)
[?2004l[?2004h> M, K, N = 16384, 4096, 4096
[?2004l[?2004h> x = torch.rand(M, K, device='cuda')
[?2004l[?2004h> w = (torch.randn(N, K, device='cuda') * 0.02 * 1.5).t().contiguous()
