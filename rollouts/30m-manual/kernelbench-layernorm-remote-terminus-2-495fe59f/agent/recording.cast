[345.196985, "o", "\u001b[?2004h> "]
[345.197031, "o", "    v = tl.load(P + (row * SPLIT + offs) * 2 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.197057, "o", "> "]
[345.19709, "o", "    mean = tl.sum(a, axis=0) / SPLIT\r\n\u001b[?2004l\r"]
[345.197117, "o", "\u001b[?2004h> "]
[345.197146, "o", "    d = a - mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.197218, "o", "    var = (tl.sum(v, axis=0) + tl.sum(d * d, axis=0)) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.19725, "o", "> "]
