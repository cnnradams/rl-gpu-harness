[345.198573, "o", "def run3(BL, nw, ev):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.198602, "o", "    SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.198632, "o", "> "]
[345.198689, "o", "    P = torch.empty(rows*SPLIT*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[345.198725, "o", "\u001b[?2004h> "]
[345.198783, "o", "    S = torch.empty(rows*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.198808, "o", "> "]
