[423.684663, "o", "        P = torch.empty(rows * SPLIT * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[423.684704, "o", "\u001b[?2004h> "]
[423.684756, "o", "        S = torch.empty(rows * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[423.684789, "o", "\u001b[?2004h> "]
[423.684828, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[423.684867, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[423.684906, "o", ">         b = self.ln.bias\r\n\u001b[?2004l\r"]
[423.684946, "o", "\u001b[?2004h> "]
