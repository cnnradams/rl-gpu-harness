[345.191637, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport kernelbench.timing as kt\n\ndev = 'cuda'\nx = torch.rand(16, 64, 256, 256, device=dev)\nw = torch.rand(64, 256, 256, device=dev)\nb = torch.rand(64, 256, 256, device=dev)\nN = w.numel(); rows = 16\nref = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        kt.clear_l2_cache(dev)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return sum(times)/len(times), min(times)\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid.to(tl.int64)*BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y+offs, tl.load(X+offs))\n\ny = torch.empty_like(x)\nTOT = x.numel()\nfor BL in (8192, 16384, 32768):\n    for nw in (4, 8, 16):\n        f "]
[345.191831, "i", "= lambda: _copy[(TOT//BL,)](x, y, BLOCK=BL, num_warps=nw)\n        m, mn = time_fn(f)\n        print(f\"copy BL={BL} nw={nw}: mean={m:.4f} min={mn:.4f}  bw={(2*TOT*4/m*1e3/1e12):.2f}TB/s\")\n\n@triton.jit\ndef _ln_partial(X, W, B, P, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row.to(tl.int64) * N\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    if EV:\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n    else:\n        xx = tl.load(X + base + offs)\n    ww = tl.load(W + offs)\n    bb = tl.load(B + offs)\n    yy = xx * ww + bb\n    m = tl.sum(yy, axis=0) / BLOCK\n    d = yy - m\n    v = tl.sum(d * d, axis=0) / BLOCK\n    tl.store(P + pid * 2 + 0, m)\n    tl.store(P + pid * 2 + 1, v)\n\n@triton.jit\ndef _ln_combine(P, S, eps, SPLIT: tl.constexpr):\n    row = tl.program_id(0)\n    offs = tl.arange(0, SPLIT)\n    a = tl.load(P + (row * SPLIT + offs) * 2 + 0)\n    v = tl.load(P + (row * SPLIT + offs) * 2 + 1)\n    "]
[345.191885, "o", "cat > /workspace/tune.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.191923, "i", "mean = tl.sum(a, axis=0) / SPLIT\n    d = a - mean\n    var = (tl.sum(v, axis=0) + tl.sum(d * d, axis=0)) / SPLIT\n    tl.store(S + row * 2 + 0, mean)\n    tl.store(S + row * 2 + 1, 1.0 / tl.sqrt(var + eps))\n\n@triton.jit\ndef _ln_apply(X, W, B, S, Y, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    mean = tl.load(S + row * 2 + 0)\n    rstd = tl.load(S + row * 2 + 1)\n    base = row.to(tl.int64) * N\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    if EV:\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n    else:\n        xx = tl.load(X + base + offs)\n    ww = tl.load(W + offs)\n    bb = tl.load(B + offs)\n    yy = (xx * ww + bb - mean) * rstd\n    if EV:\n        tl.store(Y + base + offs, yy, eviction_policy='evict_first')\n    else:\n        tl.store(Y + base + offs, yy)\n\ndef run3(BL, nw, ev):\n    SPLIT = N // BL\n    P = torch.empty(rows*SPLIT*2, device=dev, dtype=torch.float32)\n    S = torch.empty(rows*2, devic"]
