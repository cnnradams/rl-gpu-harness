[345.196784, "o", "def _ln_combine(P, S, eps, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[345.196817, "o", "\u001b[?2004h> "]
[345.196841, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.196887, "o", "    offs = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[345.196912, "o", "\u001b[?2004h> "]
