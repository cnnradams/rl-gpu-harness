[815.474852, "o", "gpu push sb-SJcs6JNKITdG6sIAqJLtKK /workspace/tune4.py /workspace/tune4.py && gpu exec sb-SJcs6JNKITdG6sIAqJLtKK -- python3 /workspace/tune4.py\r\n\u001b[?2004l\r"]
[816.707093, "o", "{\r\n  \"bytes\": 2951,\r\n  \"sha256\": \"fb5dbfc7682803280ff5a65dd961c46bee8d77103e66c87e09cf55a0d0d5b650\"\r\n}\r\n"]
[816.875293, "o", "request ID: c536c0a3877546a591b3800e74b52acc\r\n"]
[820.186148, "o", "command: a30207ff1c7143938ad7f9beaf24af88\r\n"]
[823.767165, "o", "3k pre nw1=4 nw2=4 freshy=True: mean=0.5213 min=0.5066 err=3.46e-06\r\n3k pre nw1=4 nw2=4 freshy=False: mean=0.5130 min=0.5064 err=3.46e-06\r\n3k pre nw1=4 nw2=8 freshy=True: mean=0.5152 min=0.5060 err=3.46e-06\r\n3k pre nw1=4 nw2=8 freshy=False: mean=0.5118 min=0.5077 err=3.46e-06\r\n3k pre nw1=8 nw2=4 freshy=True: mean=0.5151 min=0.5036 err=3.46e-06\r\n3k pre nw1=8 nw2=4 freshy=False: mean=0.5104 min=0.5053 err=3.46e-06\r\n3k pre nw1=8 nw2=8 freshy=True: mean=0.5137 min=0.5078 err=3.46e-06\r\n3k pre nw1=8 nw2=8 freshy=False: mean=0.5103 min=0.5062 err=3.46e-06\r\n"]
[825.260016, "o", "\u001b[?2004hroot@modal:/workspace# "]
[901.930006, "i", "cat > /workspace/tune5.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport kernelbench.timing as kt\n\ndev = 'cuda'\ntorch.manual_seed(0)\nln = torch.nn.LayerNorm((64,256,256)).cuda()\nx = torch.rand(16, 64, 256, 256, device=dev)\nw, b = ln.weight, ln.bias\nN = w.numel(); rows = 16\nref = ln(x)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        kt.clear_l2_cache(dev)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef _ln_fused(X, W, B, P, BAR, Y, N, eps, K, TOT: tl.constexpr, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    t = pid\n    while t < TOT:\n        row = t // SPLIT\n        part = t % SPLIT\n        base = row.to(tl.int64) * N\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + "]
[901.930048, "i", "base + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        yy = xx * ww + bb\n        m = tl.sum(yy, axis=0) / BLOCK\n        d = yy - m\n        v = tl.sum(d * d, axis=0) / BLOCK\n        tl.store(P + t * 2 + 0, m)\n        tl.store(P + t * 2 + 1, v)\n        t += K\n    tl.debug_barrier()\n    tl.atomic_add(BAR, 1)\n    cnt = 0\n    while cnt < K:\n        cnt = tl.atomic_add(BAR, 0)\n    t = pid\n    while t < TOT:\n        row = t // SPLIT\n        part = t % SPLIT\n        offs2 = tl.arange(0, SPLIT)\n        a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\n        v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\n        mean = tl.sum(a, axis=0) / SPLIT\n        dd = a - mean\n        var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\n        rstd = 1.0 / tl.sqrt(var + eps)\n        base = row.to(tl.int64) * N\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n       "]
[901.93006, "i", " bb = tl.load(B + offs)\n        tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\n        t += K\n\nP = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\nY = torch.empty_like(x)\nBAR = torch.zeros(1, device=dev, dtype=torch.int32)\n\ndef runf(BL, nw, K):\n    SPLIT = N // BL\n    TOT = rows * SPLIT\n    BAR.zero_()\n    _ln_fused[(K,)](x, w, b, P, BAR, Y, N, 1e-5, K, TOT=TOT, BLOCK=BL, SPLIT=SPLIT, num_warps=nw)\n    return Y\n\nfor BL in (8192, 16384):\n    for nw in (8, 16):\n        for K in (132, 264, 528):\n            Yr = runf(BL, nw, K)\n            err = (Yr-ref).abs().max().item()\n            m, mn = time_fn(lambda: runf(BL, nw, K))\n            print(f\"fused BL={BL} nw={nw} K={K}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\nEOF\n"]
