[668.180914, "o", "x = torch.rand(16, 64, 256, 256, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.180952, "o", "> w, b = ln.weight, ln.bias\r\n\u001b[?2004l\r"]
