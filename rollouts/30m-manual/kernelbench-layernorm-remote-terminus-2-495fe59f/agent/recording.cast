[507.820421, "o", "> "]
[507.820442, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r"]
[507.820468, "o", "\u001b[?2004h> "]
[507.82049, "o", "        SPLIT = N // _BLOCK\r\n\u001b[?2004l\r"]
[507.820514, "o", "\u001b[?2004h> "]
[507.820538, "o", "        dev = x.device\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.820559, "o", "> "]
[507.82058, "o", "        xs = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[507.820606, "o", "\u001b[?2004h> "]
[507.820683, "o", "        P = torch.empty(rows * SPLIT * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[507.820708, "o", "\u001b[?2004h> "]
[507.820774, "o", "        S = torch.empty(rows * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[507.8208, "o", "\u001b[?2004h> "]
[507.820837, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.820858, "o", "> "]
[507.820883, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.820908, "o", "> "]
[507.82093, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[507.820971, "o", "        grid = (rows * SPLIT,)\r\n\u001b[?2004l\r"]
[507.820991, "o", "\u001b[?2004h> "]
[507.821027, "o", "        side = torch.cuda.Stream()\r\n\u001b[?2004l\r"]
[507.821052, "o", "\u001b[?2004h> "]
[507.821102, "o", "        side.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r"]
[507.821126, "o", "\u001b[?2004h> "]
[507.821159, "o", "        with torch.cuda.stream(side):\r\n\u001b[?2004l\r"]
[507.821184, "o", "\u001b[?2004h> "]
[507.821211, "o", "            for _ in range(2):\r\n\u001b[?2004l\r"]
[507.821232, "o", "\u001b[?2004h> "]
[507.821329, "o", "                _ln_partial[grid](xs, w, b, P, N, BLOCK=_BLOCK, SPLIT=SPLIT, num_warps=8)\r\n\u001b[?2004l\r"]
[507.821355, "o", "\u001b[?2004h> "]
[507.821434, "o", "                _ln_combine[(rows,)](P, S, self.ln.eps, SPLIT=SPLIT, num_warps=4)\r\n\u001b[?2004l\r"]
[507.82146, "o", "\u001b[?2004h> "]
[507.821548, "o", "                _ln_apply[grid](xs, w, b, S, Y, N, BLOCK=_BLOCK, SPLIT=SPLIT, num_warps=8)\r\n\u001b[?2004l\r"]
[507.821573, "o", "\u001b[?2004h> "]
[507.821622, "o", "        torch.cuda.current_stream().wait_stream(side)\r\n\u001b[?2004l\r"]
[507.821645, "o", "\u001b[?2004h> "]
[507.821683, "o", "        g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[507.82171, "o", "\u001b[?2004h> "]
[507.821736, "o", "        with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[507.821761, "o", "\u001b[?2004h> "]
[507.821845, "o", "            _ln_partial[grid](xs, w, b, P, N, BLOCK=_BLOCK, SPLIT=SPLIT, num_warps=8)\r\n\u001b[?2004l\r"]
[507.82187, "o", "\u001b[?2004h> "]
[507.821945, "o", "            _ln_combine[(rows,)](P, S, self.ln.eps, SPLIT=SPLIT, num_warps=4)\r\n\u001b[?2004l\r"]
[507.82197, "o", "\u001b[?2004h> "]
[507.822054, "o", "            _ln_apply[grid](xs, w, b, S, Y, N, BLOCK=_BLOCK, SPLIT=SPLIT, num_warps=8)\r\n\u001b[?2004l\r"]
[507.822079, "o", "\u001b[?2004h> "]
[507.822104, "o", "        self._xs = xs\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.822128, "o", "> "]
[507.822154, "o", "        self._gY = Y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[507.822196, "o", "        self._graph = g\r\n\u001b[?2004l\r\u001b[?2004h> "]
[507.822221, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[507.822286, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[507.82231, "o", "\u001b[?2004h> "]
[507.822332, "o", "        N = self._N\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.822357, "o", "> "]
[507.82243, "o", "        if (N % _BLOCK != 0 or not x.is_contiguous() or x.dtype != torch.float32\r\n\u001b[?2004l\r"]
[507.822451, "o", "\u001b[?2004h> "]
[507.822487, "o", "                or not x.is_cuda):\r\n\u001b[?2004l\r"]
[507.822511, "o", "\u001b[?2004h> "]
[507.822537, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[507.822565, "o", "\u001b[?2004h> "]
[507.822598, "o", "        key = (x.shape, x.device.index)\r\n\u001b[?2004l\r"]
[507.822622, "o", "\u001b[?2004h> "]
[507.822648, "o", "        if self._key != key:\r\n\u001b[?2004l\r"]
[507.822669, "o", "\u001b[?2004h> "]
[507.822698, "o", "            self._graph = None\r\n\u001b[?2004l\r"]
[507.822727, "o", "\u001b[?2004h> "]
[507.822754, "o", "            self._key = key\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.822775, "o", "> "]
[507.822799, "o", "            self._calls = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.822825, "o", "> "]
[507.822847, "o", "        self._calls += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[507.822888, "o", "        if self._graph is None:\r\n\u001b[?2004l\r"]
[507.822913, "o", "\u001b[?2004h> "]
[507.822938, "o", "            y = self._eager(x)\r\n\u001b[?2004l\r"]
[507.822963, "o", "\u001b[?2004h> "]
[507.82299, "o", "            if self._calls >= 2:\r\n\u001b[?2004l\r"]
[507.823018, "o", "\u001b[?2004h> "]
[507.823042, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.823071, "o", "> "]
[507.8231, "o", "                    self._capture(x)\r\n\u001b[?2004l\r"]
[507.823126, "o", "\u001b[?2004h> "]
[507.823151, "o", "                except Exception:\r\n\u001b[?2004l\r"]
[507.823176, "o", "\u001b[?2004h> "]
[507.823209, "o", "                    self._graph = None\r\n\u001b[?2004l\r"]
[507.82323, "o", "\u001b[?2004h> "]
[507.823275, "o", "                    self._calls = -10**9\r\n\u001b[?2004l\r"]
[507.8233, "o", "\u001b[?2004h> "]
[507.823325, "o", "            return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.823354, "o", "> "]
[507.823384, "o", "        self._xs.copy_(x, non_blocking=True)\r\n\u001b[?2004l\r"]
[507.823407, "o", "\u001b[?2004h> "]
[507.823435, "o", "        self._graph.replay()\r\n\u001b[?2004l\r"]
[507.823461, "o", "\u001b[?2004h> "]
[507.823489, "o", "        return self._gY\r\n\u001b[?2004l\r\u001b[?2004h"]
[507.823515, "o", "> EOF\r\n\u001b[?2004l\r"]
[507.824379, "o", "\u001b[?2004hroot@modal:/workspace# "]
[508.315858, "i", "cat > /workspace/test_graph.py << 'EOF'\nimport torch, time\nimport importlib.util\nspec = importlib.util.spec_from_file_location('sg', '/workspace/solution_graph.py')\nsg = importlib.util.module_from_spec(spec); spec.loader.exec_module(sg)\ntorch.manual_seed(42)\nref_m = torch.nn.LayerNorm((64,256,256)).cuda()\nnew_m = sg.ModelNew((64,256,256)).cuda()\nnew_m.ln.weight = ref_m.weight\nnew_m.ln.bias = ref_m.bias\n# correctness across many different inputs\nok = True\nfor i in range(12):\n    x = torch.rand(16,64,256,256, device='cuda')\n    r = ref_m(x); o = new_m(x)\n    err = (r-o).abs().max().item()\n    rel = (r-o).abs().max().item()/ (r.abs().max().item()+1e-6)\n    print(f\"trial {i}: max abs err {err:.3e}\")\n    if err > 5e-3: ok = False\nprint('correct' if ok else 'INCORRECT')\nimport kernelbench.timing as kt\nx = torch.rand(16,64,256,256, device='cuda')\nfor name, m in (('ref', ref_m), ('new', new_m)):\n    for _ in range(5): m(x)\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(30):\n        kt.clear_l2_cache('cud"]
[508.315995, "i", "a')\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); y = m(x); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    print(name, 'mean', sum(ts)/len(ts), 'min', min(ts))\nEOF\n"]
