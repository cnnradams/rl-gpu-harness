[1230.549159, "o", "\u001b[?2004h> "]
[1230.549183, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.549226, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[1230.54926, "o", "\u001b[?2004h> "]
[1230.549303, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.549331, "o", "> "]
[1230.54939, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1230.54942, "o", "\u001b[?2004h> "]
[1230.549449, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.549493, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[1230.549521, "o", "\u001b[?2004h> "]
[1230.54955, "o", "    yy = xx * ww + bb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.549597, "o", "    m = tl.sum(yy, axis=0) / BLOCK\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.549627, "o", "> "]
[1230.549656, "o", "    d = yy - m\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.549695, "o", "    v = tl.sum(d * d, axis=0) / BLOCK\r\n\u001b[?2004l\r"]
[1230.54972, "o", "\u001b[?2004h> "]
[1230.549761, "o", "    tl.atomic_add(S + row * 2 + 0, m / SPLIT)\r\n\u001b[?2004l\r"]
[1230.549786, "o", "\u001b[?2004h> "]
[1230.549841, "o", "    tl.atomic_add(S + row * 2 + 1, (v + m * m) / SPLIT)\r\n\u001b[?2004l\r"]
[1230.549874, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.549901, "o", "> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.549925, "o", "> "]
[1230.550002, "o", "def _ln_apply_a(X, W, B, S, Y, N, eps, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.55003, "o", "> "]
[1230.550059, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.550092, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[1230.550122, "o", "\u001b[?2004h> "]
[1230.55015, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.550196, "o", "    mean = tl.load(S + row * 2 + 0)\r\n\u001b[?2004l\r"]
[1230.550225, "o", "\u001b[?2004h> "]
[1230.55026, "o", "    s2 = tl.load(S + row * 2 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.550285, "o", "> "]
[1230.550328, "o", "    rstd = 1.0 / tl.sqrt(s2 - mean * mean + eps)\r\n\u001b[?2004l\r"]
[1230.550354, "o", "\u001b[?2004h> "]
[1230.55038, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[1230.55041, "o", "\u001b[?2004h> "]
[1230.550449, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1230.550478, "o", "\u001b[?2004h> "]
[1230.550538, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[1230.550567, "o", "\u001b[?2004h> "]
[1230.550597, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.550638, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[1230.550665, "o", "\u001b[?2004h> "]
[1230.550753, "o", "    tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.55078, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.550848, "o", "S = torch.zeros(rows*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1230.55088, "o", "\u001b[?2004h> "]
[1230.550907, "o", "Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.550936, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.550967, "o", "def run2a(BL, nw1, nw2):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.550993, "o", "> "]
[1230.551042, "o", "    SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.55107, "o", "    grid = (rows*SPLIT,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1230.551093, "o", "    S.zero_()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.551119, "o", "> "]
[1230.55119, "o", "    _ln_stats_a[grid](x, w, b, S, N, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\r\n\u001b[?2004l\r"]
[1230.551215, "o", "\u001b[?2004h> "]
[1230.551304, "o", "    _ln_apply_a[grid](x, w, b, S, Y, N, 1e-5, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\r\n\u001b[?2004l\r"]
[1230.551337, "o", "\u001b[?2004h> "]
[1230.551368, "o", "    return Y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1230.551397, "o", "\u001b[?2004h> "]
[1230.551424, "o", "for BL in (8192, 16384, 32768):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.551449, "o", "> "]
[1230.551478, "o", "    for nw1, nw2 in ((8,8),(8,4),(16,8)):\r\n\u001b[?2004l\r"]
[1230.551504, "o", "\u001b[?2004h> "]
[1230.551533, "o", "        Yr = run2a(BL, nw1, nw2)\r\n\u001b[?2004l\r"]
[1230.551561, "o", "\u001b[?2004h> "]
[1230.551597, "o", "        err = (Yr-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1230.551621, "o", "\u001b[?2004h> "]
[1230.551674, "o", "        m, mn = time_fn(lambda: run2a(BL, nw1, nw2))\r\n\u001b[?2004l\r"]
[1230.551702, "o", "\u001b[?2004h> "]
[1230.551798, "o", "        print(f\"2ka BL={BL} nw1={nw1} nw2={nw2}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[1230.551823, "o", "> EOF\r\n\u001b[?2004l\r"]
[1230.552783, "o", "\u001b[?2004hroot@modal:/workspace# "]
