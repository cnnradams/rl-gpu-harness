[345.199914, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.199951, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[345.199976, "o", "\u001b[?2004h> "]
[345.200001, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
