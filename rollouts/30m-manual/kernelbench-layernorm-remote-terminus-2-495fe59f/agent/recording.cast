[668.181203, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181242, "o", "def time_fn(fn, n=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181281, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181319, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[668.181357, "o", "\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.181396, "o", ">     for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.181435, "o", "> "]
