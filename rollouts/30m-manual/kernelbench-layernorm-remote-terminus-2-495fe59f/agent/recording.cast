[745.491081, "i", "cat > /workspace/tune3.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport kernelbench.timing as kt\n\ndev = 'cuda'\ntorch.manual_seed(0)\nln = torch.nn.LayerNorm((64,256,256)).cuda()\nx = torch.rand(16, 64, 256, 256, device=dev)\nw, b = ln.weight, ln.bias\nN = w.numel(); rows = 16\nref = ln(x)\nNSM = torch.cuda.get_device_properties(0).multi_processor_count\nprint('SMs:', NSM)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        kt.clear_l2_cache(dev)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef _ln_partial_p(X, W, B, P, CNT, TICK, N, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    t = tl.atomic_add(TICK, 1)\n    while t < total:\n        row = t // SPLIT\n        part = t % SPLIT\n        base = row.to(tl.int64) * N\n        off"]
[745.491123, "i", "s = part * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        yy = xx * ww + bb\n        m = tl.sum(yy, axis=0) / BLOCK\n        d = yy - m\n        v = tl.sum(d * d, axis=0) / BLOCK\n        tl.store(P + t * 2 + 0, m)\n        tl.store(P + t * 2 + 1, v)\n        tl.debug_barrier()\n        tl.atomic_add(CNT + row, 1)\n        t = tl.atomic_add(TICK, 1)\n\n@triton.jit\ndef _ln_apply_p(X, W, B, P, CNT, TICK, Y, N, eps, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    t = tl.atomic_add(TICK, 1)\n    while t < total:\n        row = t // SPLIT\n        part = t % SPLIT\n        cnt = 0\n        while cnt < SPLIT:\n            cnt = tl.atomic_add(CNT + row, 0)\n        offs2 = tl.arange(0, SPLIT)\n        a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\n        v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\n        mean = tl.sum(a, axis=0) / SPLIT\n        dd = a - mean\n        var = (tl.sum(v, axis=0) + tl.sum(dd * "]
[745.49113, "i", "dd, axis=0)) / SPLIT\n        rstd = 1.0 / tl.sqrt(var + eps)\n        base = row.to(tl.int64) * N\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\n        t = tl.atomic_add(TICK, 1)\n\nP = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\nY = torch.empty_like(x)\nCNT = torch.zeros(rows, device=dev, dtype=torch.int32)\nTICK = torch.zeros(2, device=dev, dtype=torch.int32)\n\ndef runp(BL, nw1, nw2, nblk):\n    SPLIT = N // BL\n    total = rows * SPLIT\n    CNT.zero_()\n    TICK.zero_()\n    _ln_partial_p[(nblk,)](x, w, b, P, CNT, TICK[0:], N, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\n    _ln_apply_p[(nblk,)](x, w, b, P, CNT, TICK[1:], Y, N, 1e-5, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\n    return Y\n\nfor BL in (8192, 16384):\n    for nw in (8, 16):\n        for nblk in (NSM, 2*NSM):\n      "]
[745.49114, "i", "      Yr = runp(BL, nw, nw, nblk)\n            err = (Yr-ref).abs().max().item()\n            m, mn = time_fn(lambda: runp(BL, nw, nw, nblk))\n            print(f\"pers BL={BL} nw={nw} nblk={nblk}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\nEOF\n"]
