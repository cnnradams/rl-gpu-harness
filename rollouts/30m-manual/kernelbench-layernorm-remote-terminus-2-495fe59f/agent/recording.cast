[197.88883, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.888851, "o", "> "]
[197.888904, "o", "def _ln_combine(P, S, eps, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[197.88893, "o", "\u001b[?2004h> "]
[197.888958, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.889002, "o", "    offs = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[197.889023, "o", "\u001b[?2004h> "]
[197.889075, "o", "    a = tl.load(P + (row * SPLIT + offs) * 2 + 0)\r\n\u001b[?2004l\r"]
[197.889096, "o", "\u001b[?2004h> "]
[197.889148, "o", "    v = tl.load(P + (row * SPLIT + offs) * 2 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.88917, "o", "> "]
[197.889209, "o", "    mean = tl.sum(a, axis=0) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.88924, "o", ">     d = a - mean\r\n\u001b[?2004l\r"]
[197.889262, "o", "\u001b[?2004h> "]
[197.889348, "o", "    var = (tl.sum(v, axis=0) + tl.sum(d * d, axis=0)) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.889398, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.889419, "o", "> "]
[197.889456, "o", "    tl.store(S + row * 2 + 0, mean)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.889481, "o", "> "]
[197.889513, "o", "    tl.store(S + row * 2 + 1, rstd)\r\n\u001b[?2004l\r"]
[197.889535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.889557, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.88958, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[197.889617, "o", "\u001b[?2004h> "]
[197.88968, "o", "def _ln_apply(X, W, B, S, Y, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[197.889703, "o", "\u001b[?2004h> "]
[197.889728, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[197.889749, "o", "\u001b[?2004h> "]
[197.889784, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[197.889806, "o", "\u001b[?2004h> "]
[197.889829, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.88985, "o", "> "]
[197.88989, "o", "    mean = tl.load(S + row * 2 + 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.88992, "o", "> "]
[197.889947, "o", "    rstd = tl.load(S + row * 2 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.889967, "o", "> "]
[197.89, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[197.890021, "o", "\u001b[?2004h> "]
[197.89008, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.890128, "o", "    x = tl.load(X + base + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890151, "o", "> "]
[197.890172, "o", "    w = tl.load(W + offs)\r\n\u001b[?2004l\r"]
[197.890197, "o", "\u001b[?2004h> "]
[197.890222, "o", "    b = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[197.890242, "o", "\u001b[?2004h> "]
[197.890278, "o", "    y = (x * w + b - mean) * rstd\r\n\u001b[?2004l\r"]
[197.890307, "o", "\u001b[?2004h> "]
[197.89034, "o", "    tl.store(Y + base + offs, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890363, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890384, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.890413, "o", "_BLOCK = 16384\r\n\u001b[?2004l\r"]
[197.890436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890462, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.890504, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890535, "o", "> "]
[197.890577, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.8906, "o", "> "]
[197.890629, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890654, "o", "> "]
[197.890713, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[197.890736, "o", "\u001b[?2004h> "]
[197.890759, "o", "        n = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.890783, "o", "> "]
[197.890826, "o", "        for s in self.ln.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.89086, "o", "            n *= s\r\n\u001b[?2004l\r"]
[197.890884, "o", "\u001b[?2004h> "]
[197.890908, "o", "        self._N = n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.890929, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[197.891001, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.891051, "o", ">         N = self._N\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.891074, "o", "> "]
[197.891158, "o", "        if N % _BLOCK != 0 or not x.is_contiguous() or x.dtype != torch.float32:\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.891183, "o", "> "]
[197.89121, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[197.891234, "o", "\u001b[?2004h> "]
[197.891266, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r"]
[197.891294, "o", "\u001b[?2004h> "]
[197.891346, "o", "        SPLIT = N // _BLOCK\r\n\u001b[?2004l\r"]
[197.891368, "o", "\u001b[?2004h> "]
[197.891396, "o", "        dev = x.device\r\n\u001b[?2004l\r"]
[197.891417, "o", "\u001b[?2004h> "]
[197.8915, "o", "        P = torch.empty(rows * SPLIT * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[197.891526, "o", "\u001b[?2004h> "]
[197.891597, "o", "        S = torch.empty(rows * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.891621, "o", "> "]
[197.891655, "o", "        Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[197.891676, "o", "\u001b[?2004h> "]
[197.891701, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r"]
[197.891723, "o", "\u001b[?2004h> "]
[197.89175, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.891775, "o", "> "]
[197.8918, "o", "        grid = (rows * SPLIT,)\r\n\u001b[?2004l\r"]
[197.89182, "o", "\u001b[?2004h> "]
[197.89191, "o", "        _ln_partial[grid](x, w, b, P, N, BLOCK=_BLOCK, SPLIT=SPLIT, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.891937, "o", "> "]
[197.892007, "o", "        _ln_combine[(rows,)](P, S, self.ln.eps, SPLIT=SPLIT, num_warps=4)\r\n\u001b[?2004l\r"]
[197.892028, "o", "\u001b[?2004h> "]
[197.892119, "o", "        _ln_apply[grid](x, w, b, S, Y, N, BLOCK=_BLOCK, SPLIT=SPLIT, num_warps=8)\r\n\u001b[?2004l\r"]
[197.892139, "o", "\u001b[?2004h> "]
[197.892159, "o", "        return Y\r\n\u001b[?2004l\r\u001b[?2004h"]
[197.89218, "o", "> EOF\r\n\u001b[?2004l\r"]
