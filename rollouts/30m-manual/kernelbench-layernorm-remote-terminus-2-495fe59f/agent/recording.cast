[345.199613, "o", "\u001b[?2004h> "]
[345.199712, "o", "            print(f\"3k BL={BL} nw={nw} ev={ev}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.199734, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
