[586.993083, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport kernelbench.timing as kt\n\ndev = 'cuda'\ntorch.manual_seed(0)\nln = torch.nn.LayerNorm((64,256,256)).cuda()\nx = torch.rand(16, 64, 256, 256, device=dev)\nw, b = ln.weight, ln.bias\nN = w.numel(); rows = 16\nref = ln(x)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        kt.clear_l2_cache(dev)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef _ln_partial_c(X, W, B, P, CNT, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row.to(tl.int64) * N\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + base + offs, eviction_policy='evict_first')\n    ww = tl.load(W + offs)\n  "]
[586.993212, "i", "  bb = tl.load(B + offs)\n    yy = xx * ww + bb\n    m = tl.sum(yy, axis=0) / BLOCK\n    d = yy - m\n    v = tl.sum(d * d, axis=0) / BLOCK\n    tl.store(P + (row * SPLIT + part) * 2 + 0, m)\n    tl.store(P + (row * SPLIT + part) * 2 + 1, v)\n    tl.debug_barrier()\n    tl.atomic_add(CNT + row, 1)\n\n@triton.jit\ndef _ln_apply_c(X, W, B, P, CNT, Y, N, eps, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    cnt = 0\n    while cnt < SPLIT:\n        cnt = tl.atomic_add(CNT + row, 0)\n    offs2 = tl.arange(0, SPLIT)\n    a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\n    v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\n    mean = tl.sum(a, axis=0) / SPLIT\n    dd = a - mean\n    var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + base + offs, eviction_policy='evict_first')\n    ww = tl.load(W + offs)\n    bb = tl.load(B + offs"]
[586.993223, "o", "cat > /workspace/tune2.py << 'EOF'\r\n\u001b[?2004l\r"]
[586.993268, "i", ")\n    tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\n\nP = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\nY = torch.empty_like(x)\n\ndef run2c(BL, nw1, nw2):\n    SPLIT = N // BL\n    CNT = torch.zeros(rows, device=dev, dtype=torch.int32)\n    grid = (rows*SPLIT,)\n    _ln_partial_c[grid](x, w, b, P, CNT, N, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\n    _ln_apply_c[grid](x, w, b, P, CNT, Y, N, 1e-5, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\n    return Y\n\nfor BL in (8192, 16384, 32768):\n    for nw in (8, 16):\n        Y = run2c(BL, nw, nw)\n        err = (Y-ref).abs().max().item()\n        m, mn = time_fn(lambda: run2c(BL, nw, nw))\n        print(f\"2kc BL={BL} nw={nw}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\nEOF\n"]
[586.993278, "o", "\u001b[?2004h> "]
[586.993319, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.993343, "o", "import kernelbench.timing as kt\r\n\u001b[?2004l\r"]
[586.993364, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[586.993386, "o", "\u001b[?2004h> "]
[586.993407, "o", "dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.993439, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[586.993465, "o", "\u001b[?2004h> "]
[586.993514, "o", "ln = torch.nn.LayerNorm((64,256,256)).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.993574, "o", "x = torch.rand(16, 64, 256, 256, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.993596, "o", "> "]
[586.993618, "o", "w, b = ln.weight, ln.bias\r\n\u001b[?2004l\r"]
[586.993642, "o", "\u001b[?2004h> "]
[586.993669, "o", "N = w.numel(); rows = 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.993694, "o", "> ref = ln(x)\r\n\u001b[?2004l\r"]
[586.993718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[586.993742, "o", "> "]
[586.993768, "o", "def time_fn(fn, n=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.9938, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[586.993827, "o", "\u001b[?2004h> "]
[586.993852, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[586.993878, "o", "\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r"]
[586.993904, "o", "\u001b[?2004h> "]
[586.993928, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.993954, "o", "> "]
[586.993979, "o", "        kt.clear_l2_cache(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.994004, "o", "> "]
[586.994036, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[586.994062, "o", "\u001b[?2004h> "]
[586.99412, "o", "        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[586.994146, "o", "\u001b[?2004h> "]
[586.994179, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[586.994204, "o", "\u001b[?2004h> "]
[586.994232, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[586.994257, "o", "\u001b[?2004h> "]
[586.994291, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[586.994317, "o", "\u001b[?2004h> "]
[586.994348, "o", "    return sum(ts)/len(ts), min(ts)\r\n\u001b[?2004l\r"]
[586.994374, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[586.994399, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[586.994425, "o", "\u001b[?2004h> "]
[586.994512, "o", "def _ln_partial_c(X, W, B, P, CNT, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.994539, "o", "> "]
[586.994562, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.994596, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[586.994621, "o", "\u001b[?2004h> "]
[586.994644, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.99467, "o", "> "]
[586.994695, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.994722, "o", "> "]
[586.99476, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[586.994786, "o", "\u001b[?2004h> "]
[586.994845, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[586.994871, "o", "\u001b[?2004h> "]
[586.994896, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.99492, "o", "> "]
[586.994945, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.994971, "o", "> "]
[586.994996, "o", "    yy = xx * ww + bb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.995081, "o", "    m = tl.sum(yy, axis=0) / BLOCK\r\n\u001b[?2004l\r\u001b[?2004h>     d = yy - m\r\n\u001b[?2004l\r"]
[586.995109, "o", "\u001b[?2004h> "]
[586.995137, "o", "    v = tl.sum(d * d, axis=0) / BLOCK\r\n\u001b[?2004l\r"]
[586.995164, "o", "\u001b[?2004h> "]
[586.995209, "o", "    tl.store(P + (row * SPLIT + part) * 2 + 0, m)\r\n\u001b[?2004l\r"]
[586.995234, "o", "\u001b[?2004h> "]
[586.99528, "o", "    tl.store(P + (row * SPLIT + part) * 2 + 1, v)\r\n\u001b[?2004l\r"]
[586.995309, "o", "\u001b[?2004h> "]
[586.995334, "o", "    tl.debug_barrier()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.995373, "o", "    tl.atomic_add(CNT + row, 1)\r\n\u001b[?2004l\r"]
[586.995398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[586.995423, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[586.995448, "o", "\u001b[?2004h> "]
[586.995536, "o", "def _ln_apply_c(X, W, B, P, CNT, Y, N, eps, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[586.995562, "o", "\u001b[?2004h> "]
[586.995587, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.995612, "o", "> "]
[586.995637, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.995663, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r"]
[586.995688, "o", "\u001b[?2004h>     cnt = 0\r\n\u001b[?2004l\r"]
[586.995713, "o", "\u001b[?2004h> "]
[586.995738, "o", "    while cnt < SPLIT:\r\n\u001b[?2004l\r"]
[586.99577, "o", "\u001b[?2004h> "]
[586.995799, "o", "        cnt = tl.atomic_add(CNT + row, 0)\r\n\u001b[?2004l\r"]
[586.995825, "o", "\u001b[?2004h> "]
[586.995851, "o", "    offs2 = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[586.995879, "o", "\u001b[?2004h> "]
[586.995922, "o", "    a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\r\n\u001b[?2004l\r"]
[586.995945, "o", "\u001b[?2004h> "]
[586.995993, "o", "    v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\r\n\u001b[?2004l\r"]
[586.996022, "o", "\u001b[?2004h> "]
[586.996056, "o", "    mean = tl.sum(a, axis=0) / SPLIT\r\n\u001b[?2004l\r"]
[586.996082, "o", "\u001b[?2004h> "]
[586.996106, "o", "    dd = a - mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.996178, "o", "    var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\r\n\u001b[?2004l\r"]
[586.996202, "o", "\u001b[?2004h> "]
[586.996262, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.996289, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[586.996318, "o", "\u001b[?2004h> "]
[586.996358, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.996383, "o", "> "]
[586.996441, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[586.996466, "o", "\u001b[?2004h> "]
[586.996493, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.996517, "o", "> "]
[586.996542, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.996569, "o", "> "]
[586.996653, "o", "    tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[586.99668, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.996753, "o", "P = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[586.99678, "o", "\u001b[?2004h> "]
[586.996806, "o", "Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.996836, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.996861, "o", "def run2c(BL, nw1, nw2):\r\n\u001b[?2004l\r"]
[586.996886, "o", "\u001b[?2004h> "]
[586.996912, "o", "    SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.996981, "o", "    CNT = torch.zeros(rows, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[586.997007, "o", "\u001b[?2004h> "]
[586.99704, "o", "    grid = (rows*SPLIT,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[586.997136, "o", "    _ln_partial_c[grid](x, w, b, P, CNT, N, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\r\n\u001b[?2004l\r"]
[586.997161, "o", "\u001b[?2004h> "]
[586.997247, "o", "    _ln_apply_c[grid](x, w, b, P, CNT, Y, N, 1e-5, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\r\n\u001b[?2004l\r"]
[586.997273, "o", "\u001b[?2004h> "]
[586.997299, "o", "    return Y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[586.997324, "o", "\u001b[?2004h> "]
[586.99735, "o", "for BL in (8192, 16384, 32768):\r\n\u001b[?2004l\r"]
[586.997375, "o", "\u001b[?2004h> "]
[586.997401, "o", "    for nw in (8, 16):\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.997426, "o", "> "]
[586.99745, "o", "        Y = run2c(BL, nw, nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[586.997475, "o", "> "]
[586.997504, "o", "        err = (Y-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[586.997528, "o", "\u001b[?2004h> "]
[586.997577, "o", "        m, mn = time_fn(lambda: run2c(BL, nw, nw))\r\n\u001b[?2004l\r"]
[586.997603, "o", "\u001b[?2004h> "]
[586.997681, "o", "        print(f\"2kc BL={BL} nw={nw}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r"]
[586.997705, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[586.998606, "o", "\u001b[?2004hroot@modal:/workspace# "]
[587.492614, "i", "gpu push sb-SJcs6JNKITdG6sIAqJLtKK /workspace/tune2.py /workspace/tune2.py\n"]
[587.49281, "o", "gpu push sb-SJcs6JNKITdG6sIAqJLtKK /workspace/tune2.py /workspace/tune2.py\r\n\u001b[?2004l\r"]
[589.641531, "o", "{\r\n  \"bytes\": 2763,\r\n  \"sha256\": \"28c8269c03cc48fb4ad4988eb26c8ebdce6a690d60b6bf6e439176772905e443\"\r\n}\r\n"]
[589.663887, "o", "\u001b[?2004hroot@modal:/workspace# "]
[597.493572, "i", "gpu exec sb-SJcs6JNKITdG6sIAqJLtKK -- python3 /workspace/tune2.py\n"]
[597.493792, "o", "gpu exec sb-SJcs6JNKITdG6sIAqJLtKK -- python3 /workspace/tune2.py\r\n"]
[597.493837, "o", "\u001b[?2004l\r"]
[597.636229, "o", "request ID: 2ed20d7d5b154eefb8a9fa4324eed45e\r\n"]
[598.981912, "o", "command: 1843e036c47e4d849cbdb36dc610654c\r\n"]
[606.009453, "o", "2kc BL=8192 nw=8: mean=0.6200 min=0.5270 err=3.34e-06\r\n2kc BL=8192 nw=16: mean=0.5397 min=0.5330 err=3.22e-06\r\n2kc BL=16384 nw=8: mean=0.5306 min=0.5243 err=3.22e-06\r\n2kc BL=16384 nw=16: mean=0.5394 min=0.5339 err=3.46e-06\r\n2kc BL=32768 nw=8: mean=0.5480 min=0.5359 err=3.34e-06\r\n2kc BL=32768 nw=16: mean=0.5429 min=0.5355 err=3.34e-06\r\n"]
[607.499709, "o", "\u001b[?2004hroot@modal:/workspace# "]
[668.18037, "i", "cat > /workspace/tune3.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport kernelbench.timing as kt\n\ndev = 'cuda'\ntorch.manual_seed(0)\nln = torch.nn.LayerNorm((64,256,256)).cuda()\nx = torch.rand(16, 64, 256, 256, device=dev)\nw, b = ln.weight, ln.bias\nN = w.numel(); rows = 16\nref = ln(x)\nNSM = torch.cuda.get_device_properties(0).multi_processor_count\nprint('SMs:', NSM)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        kt.clear_l2_cache(dev)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef _ln_partial_p(X, W, B, P, CNT, TICK, N, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    while True:\n        t = tl.atomic_add(TICK, 1)\n        if t >= total:\n            break\n        row = t // SPLIT\n        part = t % SPLIT\n       "]
[668.180505, "i", " base = row.to(tl.int64) * N\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        yy = xx * ww + bb\n        m = tl.sum(yy, axis=0) / BLOCK\n        d = yy - m\n        v = tl.sum(d * d, axis=0) / BLOCK\n        tl.store(P + t * 2 + 0, m)\n        tl.store(P + t * 2 + 1, v)\n        tl.debug_barrier()\n        tl.atomic_add(CNT + row, 1)\n\n@triton.jit\ndef _ln_apply_p(X, W, B, P, CNT, TICK, Y, N, eps, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    while True:\n        t = tl.atomic_add(TICK, 1)\n        if t >= total:\n            break\n        row = t // SPLIT\n        part = t % SPLIT\n        cnt = 0\n        while cnt < SPLIT:\n            cnt = tl.atomic_add(CNT + row, 0)\n        offs2 = tl.arange(0, SPLIT)\n        a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\n        v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\n        mean = tl.sum(a, axis=0) / SPLIT\n        dd = a - mean\n  "]
[668.180631, "o", "cat > /workspace/tune3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.180675, "i", "      var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\n        rstd = 1.0 / tl.sqrt(var + eps)\n        base = row.to(tl.int64) * N\n        offs = part * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + base + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\n\nP = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\nY = torch.empty_like(x)\nCNT = torch.zeros(rows, device=dev, dtype=torch.int32)\nTICK = torch.zeros(2, device=dev, dtype=torch.int32)\n\ndef runp(BL, nw1, nw2, nblk):\n    SPLIT = N // BL\n    total = rows * SPLIT\n    CNT.zero_()\n    TICK[0] = 0; TICK[1] = 0\n    _ln_partial_p[(nblk,)](x, w, b, P, CNT, TICK[0:], N, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\n    _ln_apply_p[(nblk,)](x, w, b, P, CNT, TICK[1:], Y, N, 1e-5, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\n    return Y\n\nfor BL in (8192, 16384):\n    for nw in (8, 16):\n        for nblk i"]
[668.180705, "o", "> import kernelbench.timing as kt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[668.180743, "i", "n (NSM, 2*NSM):\n            Yr = runp(BL, nw, nw, nblk)\n            err = (Yr-ref).abs().max().item()\n            m, mn = time_fn(lambda: runp(BL, nw, nw, nblk))\n            print(f\"pers BL={BL} nw={nw} nblk={nblk}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\nEOF\n"]
