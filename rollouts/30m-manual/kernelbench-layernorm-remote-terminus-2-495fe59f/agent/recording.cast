[668.181512, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181581, "o", "        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[668.181597, "o", "\u001b[?2004h> "]
[668.181641, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[668.18168, "o", "\u001b[?2004h> "]
[668.181718, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181756, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.181799, "o", "> "]
[668.181846, "o", "    return sum(ts)/len(ts), min(ts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181885, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.181992, "o", "def _ln_partial_p(X, W, B, P, CNT, TICK, N, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.18201, "o", "> "]
[668.182052, "o", "    while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.182091, "o", "        t = tl.atomic_add(TICK, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.182129, "o", "        if t >= total:\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.182168, "o", ">             break\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.182187, "o", "> "]
[668.182202, "o", "        row = t // SPLIT\r\n\u001b[?2004l\r"]
[668.182245, "o", "\u001b[?2004h>         part = t % SPLIT\r\n\u001b[?2004l\r"]
[668.182285, "o", "\u001b[?2004h> "]
[668.182302, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[668.182342, "o", "\u001b[?2004h> "]
[668.18238, "o", "        offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.182418, "o", "> "]
[668.182466, "o", "        xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[668.182505, "o", "\u001b[?2004h> "]
[668.182543, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.18259, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.182628, "o", "        yy = xx * ww + bb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.182673, "o", "        m = tl.sum(yy, axis=0) / BLOCK\r\n\u001b[?2004l\r"]
[668.182713, "o", "\u001b[?2004h>         d = yy - m\r\n\u001b[?2004l\r"]
[668.182753, "o", "\u001b[?2004h> "]
[668.182792, "o", "        v = tl.sum(d * d, axis=0) / BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.182839, "o", "        tl.store(P + t * 2 + 0, m)\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.182858, "o", "> "]
[668.182891, "o", "        tl.store(P + t * 2 + 1, v)\r\n\u001b[?2004l\r"]
[668.182931, "o", "\u001b[?2004h> "]
[668.182965, "o", "        tl.debug_barrier()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.183006, "o", "        tl.atomic_add(CNT + row, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[668.18303, "o", "\u001b[?2004h> "]
[668.183075, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.183179, "o", "def _ln_apply_p(X, W, B, P, CNT, TICK, Y, N, eps, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.183221, "o", ">     while True:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.18326, "o", "        t = tl.atomic_add(TICK, 1)\r\n\u001b[?2004l\r"]
[668.183299, "o", "\u001b[?2004h>         if t >= total:\r\n\u001b[?2004l\r"]
[668.183338, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[668.183371, "o", "\u001b[?2004h> "]
[668.183408, "o", "        row = t // SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.183447, "o", "        part = t % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.183486, "o", "        cnt = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.18352, "o", "        while cnt < SPLIT:\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.183558, "o", "> "]
[668.183597, "o", "            cnt = tl.atomic_add(CNT + row, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.183635, "o", "        offs2 = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[668.183669, "o", "\u001b[?2004h> "]
[668.183706, "o", "        a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\r\n\u001b[?2004l\r"]
[668.183746, "o", "\u001b[?2004h> "]
[668.183783, "o", "        v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\r\n\u001b[?2004l\r"]
[668.183823, "o", "\u001b[?2004h> "]
[668.183861, "o", "        mean = tl.sum(a, axis=0) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.1839, "o", ">         dd = a - mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.183938, "o", "> "]
[668.183985, "o", "        var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\r\n\u001b[?2004l\r"]
[668.184023, "o", "\u001b[?2004h> "]
[668.184057, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.184103, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[668.184142, "o", "\u001b[?2004h> "]
[668.184175, "o", "        offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[668.184211, "o", "\u001b[?2004h> "]
[668.184264, "o", "        xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[668.184298, "o", "\u001b[?2004h> "]
[668.184335, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.184368, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[668.184407, "o", "\u001b[?2004h> "]
[668.184489, "o", "        tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[668.184526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.184586, "o", "P = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[668.184627, "o", "\u001b[?2004h> Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[668.184662, "o", "\u001b[?2004h> "]
[668.184706, "o", "CNT = torch.zeros(rows, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[668.18474, "o", "\u001b[?2004h> "]
[668.18478, "o", "TICK = torch.zeros(2, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[668.184818, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.184856, "o", "def runp(BL, nw1, nw2, nblk):\r\n\u001b[?2004l\r"]
[668.184897, "o", "\u001b[?2004h>     SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.184936, "o", ">     total = rows * SPLIT\r\n\u001b[?2004l\r"]
[668.184969, "o", "\u001b[?2004h>     CNT.zero_()\r\n\u001b[?2004l\r"]
[668.185008, "o", "\u001b[?2004h> "]
[668.185041, "o", "    TICK[0] = 0; TICK[1] = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.18515, "o", "    _ln_partial_p[(nblk,)](x, w, b, P, CNT, TICK[0:], N, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.18519, "o", "> "]
[668.18528, "o", "    _ln_apply_p[(nblk,)](x, w, b, P, CNT, TICK[1:], Y, N, 1e-5, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\r\n\u001b[?2004l\r"]
[668.185314, "o", "\u001b[?2004h>     return Y\r\n\u001b[?2004l\r"]
[668.185347, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.18538, "o", "for BL in (8192, 16384):\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.185413, "o", ">     for nw in (8, 16):\r\n\u001b[?2004l\r"]
[668.185445, "o", "\u001b[?2004h> "]
[668.18548, "o", "        for nblk in (NSM, 2*NSM):\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.185518, "o", "> "]
[668.185551, "o", "            Yr = runp(BL, nw, nw, nblk)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[668.185603, "o", "            err = (Yr-ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[668.185643, "o", "> "]
[668.185683, "o", "            m, mn = time_fn(lambda: runp(BL, nw, nw, nblk))\r\n\u001b[?2004l\r"]
[668.185717, "o", "\u001b[?2004h> "]
[668.185804, "o", "            print(f\"pers BL={BL} nw={nw} nblk={nblk}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r"]
[668.18585, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
