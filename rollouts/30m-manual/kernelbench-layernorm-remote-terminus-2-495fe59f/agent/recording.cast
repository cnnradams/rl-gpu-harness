[368.116838, "o", "copy BL=8192 nw=4: mean=0.2051 min=0.1971  bw=2.62TB/s\r\ncopy BL=8192 nw=8: mean=0.2006 min=0.1981  bw=2.68TB/s\r\ncopy BL=8192 nw=16: mean=0.2014 min=0.1966  bw=2.67TB/s\r\ncopy BL=16384 nw=4: mean=0.2079 min=0.1992  bw=2.58TB/s\r\ncopy BL=16384 nw=8: mean=0.1995 min=0.1969  bw=2.69TB/s\r\ncopy BL=16384 nw=16: mean=0.2010 min=0.1971  bw=2.67TB/s\r\ncopy BL=32768 nw=4: mean=0.2142 min=0.2114  bw=2.51TB/s\r\ncopy BL=32768 nw=8: mean=0.2080 min=0.1967  bw=2.58TB/s\r\ncopy BL=32768 nw=16: mean=0.2022 min=0.1990  bw=2.66TB/s\r\n3k BL=8192 nw=8 ev=0: mean=0.6252 min=0.6206 err=2.06e+00\r\n3k BL=8192 nw=8 ev=1: mean=0.5162 min=0.5116 err=2.06e+00\r\n3k BL=8192 nw=16 ev=0: mean=0.6259 min=0.6220 err=2.06e+00\r\n3k BL=8192 nw=16 ev=1: mean=0.5268 min=0.5228 err=2.06e+00\r\n3k BL=16384 nw=8 ev=0: mean=0.6301 min=0.6260 err=2.06e+00\r\n3k BL=16384 nw=8 ev=1: mean=0.5230 min=0.5182 err=2.06e+00\r\n3k BL=16384 nw=16 ev=0: mean=0.6281 min=0.6235 err=2.06e+00\r\n3k BL=16384 nw=16 ev=1: mean=0.5279 min=0.5222 err=2.06e+00\r\n3k BL=32768 nw=8 ev=0: mean=0.6"]
[368.116904, "o", "317 min=0.6268 err=2.06e+00\r\n3k BL=32768 nw=8 ev=1: mean=0.5336 min=0.5266 err=2.06e+00\r\n3k BL=32768 nw=16 ev=0: mean=0.6343 min=0.6296 err=2.06e+00\r\n3k BL=32768 nw=16 ev=1: mean=0.5335 min=0.5250 err=2.06e+00\r\n2k BL=16384 nw=8: mean=0.5299 min=0.5241 err=2.06e+00\r\n2k BL=16384 nw=16: mean=0.5398 min=0.5337 err=2.06e+00\r\n2k BL=32768 nw=8: mean=0.5392 min=0.5321 err=2.06e+00\r\n2k BL=32768 nw=16: mean=0.5401 min=0.5340 err=2.06e+00\r\n"]
