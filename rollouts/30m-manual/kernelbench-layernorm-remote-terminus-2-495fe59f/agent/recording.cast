[345.201351, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[345.201377, "o", "\u001b[?2004h> "]
[345.201402, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.20143, "o", "> "]
[345.201461, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.201563, "o", "    tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[345.20159, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.201621, "o", "def run2(BL, nw):\r\n\u001b[?2004l\r"]
[345.201651, "o", "\u001b[?2004h> "]
[345.201676, "o", "    SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.20176, "o", "    S = torch.zeros(rows*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.201785, "o", "> "]
[345.20181, "o", "    Y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.20184, "o", "> "]
[345.201867, "o", "    grid = (rows*SPLIT,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.201958, "o", "    _ln_stats_a[grid](x, w, b, S, N, BLOCK=BL, SPLIT=SPLIT, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.201983, "o", "> "]
[345.202066, "o", "    _ln_apply_a[grid](x, w, b, S, Y, N, 1e-5, BLOCK=BL, SPLIT=SPLIT, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.202092, "o", ">     return Y\r\n\u001b[?2004l\r"]
[345.202117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[345.202147, "o", "\u001b[?2004h> "]
[345.202171, "o", "for BL in (16384, 32768):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.202208, "o", "    for nw in (8, 16):\r\n\u001b[?2004l\r"]
[345.202238, "o", "\u001b[?2004h> "]
[345.202263, "o", "        Y = run2(BL, nw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.202321, "o", "        err = (Y-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[345.202351, "o", "\u001b[?2004h> "]
[345.202391, "o", "        m, mn = time_fn(lambda: run2(BL, nw))\r\n\u001b[?2004l\r"]
[345.202417, "o", "\u001b[?2004h> "]
[345.202496, "o", "        print(f\"2k BL={BL} nw={nw}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.202521, "o", "> EOF\r\n\u001b[?2004l\r"]
[345.203539, "o", "\u001b[?2004hroot@modal:/workspace# "]
