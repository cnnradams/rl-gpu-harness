[1231.048098, "o", "gpu push sb-SJcs6JNKITdG6sIAqJLtKK /workspace/tune6.py /workspace/tune6.py && gpu exec sb-SJcs6JNKITdG6sIAqJLtKK -- python3 /workspace/tune6.py\r\n\u001b[?2004l\r"]
