[345.200713, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[345.200742, "o", "\u001b[?2004h> "]
[345.200815, "o", "def _ln_apply_a(X, W, B, S, Y, N, eps, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[345.200843, "o", "\u001b[?2004h> "]
[345.200867, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.200897, "o", "> "]
[345.200922, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.200957, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.200988, "o", "> "]
[345.201017, "o", "    mean = tl.load(S + row * 2 + 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.201043, "o", "> "]
