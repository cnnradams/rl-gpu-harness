[345.197964, "o", "\u001b[?2004h> "]
[345.198035, "o", "        xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[345.198061, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[345.198091, "o", "\u001b[?2004h> "]
[345.198125, "o", "        xx = tl.load(X + base + offs)\r\n\u001b[?2004l\r"]
[345.198151, "o", "\u001b[?2004h> "]
[345.19818, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.198208, "o", "> "]
[345.198233, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.198282, "o", "    yy = (xx * ww + bb - mean) * rstd\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.198307, "o", ">     if EV:\r\n\u001b[?2004l\r"]
[345.198332, "o", "\u001b[?2004h> "]
