[814.976195, "o", "    tl.store(P + pid * 2 + 1, v)\r\n\u001b[?2004l\r"]
[814.976216, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[814.976248, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[814.976268, "o", "\u001b[?2004h> "]
[814.97633, "o", "def _ln_combine(P, S, eps, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[814.976358, "o", "\u001b[?2004h> "]
[814.97638, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.976402, "o", "> "]
[814.976424, "o", "    offs = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[814.976445, "o", "\u001b[?2004h> "]
[814.976501, "o", "    a = tl.load(P + (row * SPLIT + offs) * 2 + 0)\r\n\u001b[?2004l\r"]
[814.976522, "o", "\u001b[?2004h> "]
[814.976575, "o", "    v = tl.load(P + (row * SPLIT + offs) * 2 + 1)\r\n\u001b[?2004l\r"]
[814.976598, "o", "\u001b[?2004h> "]
[814.976635, "o", "    mean = tl.sum(a, axis=0) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.976656, "o", "> "]
[814.976678, "o", "    d = a - mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.976757, "o", "    var = (tl.sum(v, axis=0) + tl.sum(d * d, axis=0)) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.976781, "o", "> "]
[814.976814, "o", "    tl.store(S + row * 2 + 0, mean)\r\n\u001b[?2004l\r"]
[814.976836, "o", "\u001b[?2004h> "]
[814.976894, "o", "    tl.store(S + row * 2 + 1, 1.0 / tl.sqrt(var + eps))\r\n\u001b[?2004l\r"]
[814.976916, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[814.976937, "o", "> "]
[814.976962, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.977051, "o", "def _ln_apply(X, W, B, S, Y, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.977073, "o", "> "]
[814.977095, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[814.977117, "o", "\u001b[?2004h> "]
[814.977143, "o", "    row = pid // SPLIT\r\n\u001b[?2004l\r"]
[814.977166, "o", "\u001b[?2004h> "]
[814.977188, "o", "    part = pid % SPLIT\r\n\u001b[?2004l\r"]
[814.97721, "o", "\u001b[?2004h> "]
[814.977251, "o", "    mean = tl.load(S + row * 2 + 0)\r\n\u001b[?2004l\r"]
[814.977275, "o", "\u001b[?2004h> "]
[814.97731, "o", "    rstd = tl.load(S + row * 2 + 1)\r\n\u001b[?2004l\r"]
[814.977331, "o", "\u001b[?2004h> "]
[814.977368, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[814.97739, "o", "\u001b[?2004h> "]
[814.977443, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.977465, "o", "> "]
[814.977532, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.977554, "o", "> "]
[814.97758, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.977602, "o", "> "]
[814.977626, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[814.977647, "o", "\u001b[?2004h> "]
[814.977744, "o", "    tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[814.977774, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[814.977798, "o", "\u001b[?2004h> BL = 16384\r\n\u001b[?2004l\r"]
[814.977821, "o", "\u001b[?2004h> "]
[814.977844, "o", "SPLIT = N // BL\r\n\u001b[?2004l\r"]
[814.977867, "o", "\u001b[?2004h> "]
[814.977931, "o", "P = torch.empty(rows*SPLIT*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.977954, "o", "> "]
[814.978009, "o", "S = torch.empty(rows*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[814.97803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978052, "o", "> "]
[814.978074, "o", "def run(nw1, nw2, fresh_y):\r\n\u001b[?2004l\r"]
[814.978096, "o", "\u001b[?2004h> "]
[814.978152, "o", "    Y = torch.empty_like(x) if fresh_y else run.Y\r\n\u001b[?2004l\r"]
[814.978178, "o", "\u001b[?2004h> "]
[814.978199, "o", "    grid = (rows*SPLIT,)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978221, "o", "> "]
[814.978304, "o", "    _ln_partial[grid](x, w, b, P, N, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978326, "o", "> "]
[814.97839, "o", "    _ln_combine[(rows,)](P, S, 1e-5, SPLIT=SPLIT, num_warps=4)\r\n\u001b[?2004l\r"]
[814.978414, "o", "\u001b[?2004h> "]
[814.97849, "o", "    _ln_apply[grid](x, w, b, S, Y, N, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978514, "o", "> "]
[814.978536, "o", "    return Y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.97857, "o", "run.Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[814.978592, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978614, "o", "> "]
[814.978636, "o", "for nw1 in (4, 8):\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978658, "o", "> "]
[814.97868, "o", "    for nw2 in (4, 8):\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978702, "o", "> "]
[814.97873, "o", "        for fy in (True, False):\r\n\u001b[?2004l\r"]
[814.978753, "o", "\u001b[?2004h> "]
[814.978789, "o", "            Y = run(nw1, nw2, fy)\r\n\u001b[?2004l\r"]
[814.978811, "o", "\u001b[?2004h> "]
[814.978856, "o", "            err = (Y-ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978878, "o", "> "]
[814.978935, "o", "            m, mn = time_fn(lambda: run(nw1, nw2, fy))\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.978959, "o", "> "]
[814.979076, "o", "            print(f\"3k pre nw1={nw1} nw2={nw2} freshy={fy}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.979102, "o", "> EOF\r\n\u001b[?2004l\r"]
[814.98014, "o", "\u001b[?2004hroot@modal:/workspace# "]
