[901.933313, "o", ">         dd = a - mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.933352, "o", "> "]
[901.933411, "o", "        var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.933472, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.933524, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[901.933565, "o", "\u001b[?2004h> "]
[901.933604, "o", "        offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.933645, "o", "> "]
[901.933692, "o", "        xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[901.933733, "o", "\u001b[?2004h> "]
[901.933765, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.933806, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.933847, "o", "> "]
[901.933924, "o", "        tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.933967, "o", ">         t += K\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[901.934007, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[901.93407, "o", "P = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.93411, "o", "Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[901.934151, "o", "\u001b[?2004h> "]
[901.934192, "o", "BAR = torch.zeros(1, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.934232, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934273, "o", "def runf(BL, nw, K):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934314, "o", "    SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934355, "o", "    TOT = rows * SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934395, "o", "    BAR.zero_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934498, "o", "    _ln_fused[(K,)](x, w, b, P, BAR, Y, N, 1e-5, K, TOT=TOT, BLOCK=BL, SPLIT=SPLIT, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.934539, "o", ">     return Y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[901.93458, "o", "\u001b[?2004h> "]
[901.93462, "o", "for BL in (8192, 16384):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934661, "o", "    for nw in (8, 16):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934702, "o", "        for K in (132, 264, 528):\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.934742, "o", "> "]
[901.934782, "o", "            Yr = runf(BL, nw, K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[901.934822, "o", "            err = (Yr-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[901.934862, "o", "\u001b[?2004h> "]
[901.934903, "o", "            m, mn = time_fn(lambda: runf(BL, nw, K))\r\n\u001b[?2004l\r\u001b[?2004h"]
[901.934939, "o", "> "]
[901.935024, "o", "            print(f\"fused BL={BL} nw={nw} K={K}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r"]
[901.935072, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
