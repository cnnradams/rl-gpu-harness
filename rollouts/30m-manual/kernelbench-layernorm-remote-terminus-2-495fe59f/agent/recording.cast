[745.492586, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[745.492625, "o", "\u001b[?2004h> "]
[745.492705, "o", "def _ln_partial_p(X, W, B, P, CNT, TICK, N, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.492745, "o", "> "]
[745.492783, "o", "    t = tl.atomic_add(TICK, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.492823, "o", "    while t < total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.492862, "o", "        row = t // SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.492901, "o", "        part = t % SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.492939, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[745.492978, "o", "\u001b[?2004h> "]
[745.493016, "o", "        offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[745.493055, "o", "\u001b[?2004h> "]
[745.493105, "o", "        xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[745.493145, "o", "\u001b[?2004h> "]
[745.493185, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493224, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493263, "o", "        yy = xx * ww + bb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493314, "o", "        m = tl.sum(yy, axis=0) / BLOCK\r\n\u001b[?2004l\r"]
[745.493352, "o", "\u001b[?2004h>         d = yy - m\r\n\u001b[?2004l\r"]
[745.49339, "o", "\u001b[?2004h> "]
[745.493429, "o", "        v = tl.sum(d * d, axis=0) / BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493469, "o", "        tl.store(P + t * 2 + 0, m)\r\n\u001b[?2004l\r"]
[745.493507, "o", "\u001b[?2004h> "]
[745.493546, "o", "        tl.store(P + t * 2 + 1, v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.49359, "o", "        tl.debug_barrier()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.49363, "o", "        tl.atomic_add(CNT + row, 1)\r\n\u001b[?2004l\r"]
[745.493669, "o", "\u001b[?2004h> "]
[745.493708, "o", "        t = tl.atomic_add(TICK, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[745.493747, "o", "> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493861, "o", "def _ln_apply_p(X, W, B, P, CNT, TICK, Y, N, eps, total, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.493878, "o", "> "]
[745.49392, "o", "    t = tl.atomic_add(TICK, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493959, "o", "    while t < total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.493998, "o", "        row = t // SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.494037, "o", ">         part = t % SPLIT\r\n\u001b[?2004l\r"]
[745.494077, "o", "\u001b[?2004h>         cnt = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.494115, "o", ">         while cnt < SPLIT:\r\n\u001b[?2004l\r"]
[745.494154, "o", "\u001b[?2004h> "]
[745.494193, "o", "            cnt = tl.atomic_add(CNT + row, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.494239, "o", "        offs2 = tl.arange(0, SPLIT)\r\n\u001b[?2004l\r"]
[745.494278, "o", "\u001b[?2004h> "]
[745.494317, "o", "        a = tl.load(P + (row * SPLIT + offs2) * 2 + 0)\r\n\u001b[?2004l\r"]
[745.494358, "o", "\u001b[?2004h> "]
[745.494396, "o", "        v = tl.load(P + (row * SPLIT + offs2) * 2 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.494435, "o", "> "]
[745.494474, "o", "        mean = tl.sum(a, axis=0) / SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.494513, "o", "        dd = a - mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.494589, "o", "        var = (tl.sum(v, axis=0) + tl.sum(dd * dd, axis=0)) / SPLIT\r\n\u001b[?2004l\r"]
[745.494629, "o", "\u001b[?2004h> "]
[745.494668, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.494708, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[745.494748, "o", "\u001b[?2004h> "]
[745.494787, "o", "        offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.494866, "o", "        xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[745.494905, "o", "\u001b[?2004h> "]
[745.494945, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.494984, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.495093, "o", "        tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[745.495135, "o", "\u001b[?2004h> "]
[745.495174, "o", "        t = tl.atomic_add(TICK, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.495245, "o", "P = torch.empty(rows*512*2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[745.495284, "o", "\u001b[?2004h> Y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[745.495323, "o", "\u001b[?2004h> "]
[745.495362, "o", "CNT = torch.zeros(rows, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[745.495402, "o", "\u001b[?2004h> "]
[745.49544, "o", "TICK = torch.zeros(2, device=dev, dtype=torch.int32)\r\n\u001b[?2004l\r"]
[745.49548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.495517, "o", "def runp(BL, nw1, nw2, nblk):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.495562, "o", "    SPLIT = N // BL\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.495602, "o", "    total = rows * SPLIT\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.495636, "o", ">     CNT.zero_()\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.495675, "o", ">     TICK.zero_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.495792, "o", "    _ln_partial_p[(nblk,)](x, w, b, P, CNT, TICK[0:], N, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw1)\r\n\u001b[?2004l\r"]
[745.495831, "o", "\u001b[?2004h> "]
[745.495924, "o", "    _ln_apply_p[(nblk,)](x, w, b, P, CNT, TICK[1:], Y, N, 1e-5, total, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\r\n\u001b[?2004l\r"]
[745.495965, "o", "\u001b[?2004h>     return Y\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.496004, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.496043, "o", "for BL in (8192, 16384):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.496081, "o", "    for nw in (8, 16):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.496121, "o", "        for nblk in (NSM, 2*NSM):\r\n\u001b[?2004l\r"]
[745.496159, "o", "\u001b[?2004h> "]
[745.496198, "o", "            Yr = runp(BL, nw, nw, nblk)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.496248, "o", "            err = (Yr-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[745.496289, "o", "\u001b[?2004h> "]
[745.496328, "o", "            m, mn = time_fn(lambda: runp(BL, nw, nw, nblk))\r\n\u001b[?2004l\r"]
[745.496369, "o", "\u001b[?2004h> "]
[745.496456, "o", "            print(f\"pers BL={BL} nw={nw} nblk={nblk}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\r\n\u001b[?2004l\r"]
[745.496496, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[745.497955, "o", "\u001b[?2004hroot@modal:/workspace# "]
