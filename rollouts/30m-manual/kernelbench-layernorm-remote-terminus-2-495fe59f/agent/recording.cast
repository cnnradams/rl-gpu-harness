[345.19272, "o", "\u001b[?2004h> "]
[345.192859, "o", "ref = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\r\n\u001b[?2004l\r"]
[345.192885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[345.192917, "o", "> "]
[345.19296, "o", "def time_fn(fn, n=30):\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.192988, "o", "> "]
[345.193042, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[345.193068, "o", "\u001b[?2004h> "]
[345.193135, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[345.19316, "o", "\u001b[?2004h> "]
[345.193188, "o", "    times = []\r\n\u001b[?2004l\r"]
[345.193215, "o", "\u001b[?2004h> "]
[345.193265, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[345.193295, "o", "\u001b[?2004h> "]
[345.193355, "o", "        kt.clear_l2_cache(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.193383, "o", "> "]
[345.19345, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.193479, "o", "> "]
[345.19361, "o", "        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[345.193639, "o", "\u001b[?2004h> "]
[345.193721, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[345.193745, "o", "\u001b[?2004h> "]
[345.193817, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[345.193846, "o", "\u001b[?2004h> "]
[345.19393, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[345.193955, "o", "\u001b[?2004h> "]
[345.194053, "o", "    return sum(times)/len(times), min(times)\r\n\u001b[?2004l\r"]
[345.194079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
