[526.052096, "o", "trial 0: max abs err 3.219e-06\r\ntrial 1: max abs err 3.099e-06\r\ntrial 2: max abs err 3.338e-06\r\ntrial 3: max abs err 2.980e-06\r\ntrial 4: max abs err 3.219e-06\r\ntrial 5: max abs err 3.099e-06\r\ntrial 6: max abs err 2.980e-06\r\ntrial 7: max abs err 2.980e-06\r\ntrial 8: max abs err 2.980e-06\r\ntrial 9: max abs err 2.861e-06\r\ntrial 10: max abs err 2.742e-06\r\ntrial 11: max abs err 3.338e-06\r\ncorrect\r\nref mean 8.118209075927734 min 8.084159851074219\r\nnew mean 0.6970069328943889 min 0.6834239959716797\r\n"]
