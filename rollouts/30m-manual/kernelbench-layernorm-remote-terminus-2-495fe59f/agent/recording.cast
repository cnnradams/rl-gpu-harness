[1230.547473, "i", "cat > /workspace/tune6.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport kernelbench.timing as kt\n\ndev = 'cuda'\ntorch.manual_seed(0)\nln = torch.nn.LayerNorm((64,256,256)).cuda()\nx = torch.rand(16, 64, 256, 256, device=dev)\nw, b = ln.weight, ln.bias\nN = w.numel(); rows = 16\nref = ln(x)\n\ndef time_fn(fn, n=50):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        kt.clear_l2_cache(dev)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef _ln_stats_a(X, W, B, S, N, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    base = row.to(tl.int64) * N\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + base + offs, eviction_policy='evict_first')\n    ww = tl.load(W + offs)\n    bb = "]
[1230.547516, "i", "tl.load(B + offs)\n    yy = xx * ww + bb\n    m = tl.sum(yy, axis=0) / BLOCK\n    d = yy - m\n    v = tl.sum(d * d, axis=0) / BLOCK\n    tl.atomic_add(S + row * 2 + 0, m / SPLIT)\n    tl.atomic_add(S + row * 2 + 1, (v + m * m) / SPLIT)\n\n@triton.jit\ndef _ln_apply_a(X, W, B, S, Y, N, eps, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPLIT\n    part = pid % SPLIT\n    mean = tl.load(S + row * 2 + 0)\n    s2 = tl.load(S + row * 2 + 1)\n    rstd = 1.0 / tl.sqrt(s2 - mean * mean + eps)\n    base = row.to(tl.int64) * N\n    offs = part * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + base + offs, eviction_policy='evict_first')\n    ww = tl.load(W + offs)\n    bb = tl.load(B + offs)\n    tl.store(Y + base + offs, (xx * ww + bb - mean) * rstd, eviction_policy='evict_first')\n\nS = torch.zeros(rows*2, device=dev, dtype=torch.float32)\nY = torch.empty_like(x)\n\ndef run2a(BL, nw1, nw2):\n    SPLIT = N // BL\n    grid = (rows*SPLIT,)\n    S.zero_()\n    _ln_stats_a[grid](x, w, b, S, N, BLOCK=BL, SPLIT"]
[1230.547616, "i", "=SPLIT, num_warps=nw1)\n    _ln_apply_a[grid](x, w, b, S, Y, N, 1e-5, BLOCK=BL, SPLIT=SPLIT, num_warps=nw2)\n    return Y\n\nfor BL in (8192, 16384, 32768):\n    for nw1, nw2 in ((8,8),(8,4),(16,8)):\n        Yr = run2a(BL, nw1, nw2)\n        err = (Yr-ref).abs().max().item()\n        m, mn = time_fn(lambda: run2a(BL, nw1, nw2))\n        print(f\"2ka BL={BL} nw1={nw1} nw2={nw2}: mean={m:.4f} min={mn:.4f} err={err:.2e}\")\nEOF\n"]
