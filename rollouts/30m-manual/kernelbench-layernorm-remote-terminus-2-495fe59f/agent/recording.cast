[345.200073, "o", "\u001b[?2004h> "]
[345.200118, "o", "    offs = part * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[345.200146, "o", "\u001b[?2004h> "]
[345.200205, "o", "    xx = tl.load(X + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[345.200232, "o", "\u001b[?2004h> "]
[345.200259, "o", "    ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.200289, "o", "> "]
[345.200319, "o", "    bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.200347, "o", "    yy = xx * ww + bb\r\n\u001b[?2004l\r"]
[345.200376, "o", "\u001b[?2004h> "]
[345.200401, "o", "    m = tl.sum(yy, axis=0) / BLOCK\r\n\u001b[?2004l\r"]
[345.200427, "o", "\u001b[?2004h> "]
[345.200455, "o", "    d = yy - m\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.200502, "o", "    v = tl.sum(d * d, axis=0) / BLOCK\r\n\u001b[?2004l\r"]
[345.200528, "o", "\u001b[?2004h> "]
