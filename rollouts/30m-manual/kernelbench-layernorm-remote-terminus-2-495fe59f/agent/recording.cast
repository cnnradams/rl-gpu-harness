[345.198877, "o", "    grid = (rows*SPLIT,)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.198902, "o", "> "]
[345.198986, "o", "    _ln_partial[grid](x, w, b, P, N, BLOCK=BL, SPLIT=SPLIT, EV=ev, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.199021, "o", "> "]
[345.199079, "o", "    _ln_combine[(rows,)](P, S, 1e-5, SPLIT=SPLIT, num_warps=4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[345.199105, "o", "> "]
[345.199184, "o", "    _ln_apply[grid](x, w, b, S, Y, N, BLOCK=BL, SPLIT=SPLIT, EV=ev, num_warps=nw)\r\n\u001b[?2004l\r"]
[345.199215, "o", "\u001b[?2004h>     return Y\r\n"]
[345.199244, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.19929, "o", "for BL in (8192, 16384, 32768):\r\n\u001b[?2004l\r"]
[345.19932, "o", "\u001b[?2004h> "]
[345.199349, "o", "    for nw in (8, 16):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.199391, "o", "        for ev in (0, 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
