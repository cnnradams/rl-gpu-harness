[1726.294956, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, sys\nimport triton.language as tl\nsys.path.insert(0, '/workspace')\nfrom solution import _gemm_f16x3_ws, _ensure_alloc\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nxf = torch.rand(M, K, device='cuda')\nxh = xf.half(); xl = (xf - xh.float()).half()\nwf = torch.rand(K, N, device='cuda')\nwh = wf.half(); wl = (wf - wh.float()).half()\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\n_ensure_alloc()\n\ndef timeit(fn, iters=100):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\nfor nsms in [132, 198, 264]:\n    def run():\n        grid = (min(nsms, triton.cdiv(M,128)*triton.cdiv(N,128)),)\n        _gemm_f16x3_ws[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=1.5,\n            BLOCK_M=128, BLOCK_N=128, BLOCK_K=64, GROUP_M=4, NUM_SMS=nsms,\n            num_w"]
[1726.295003, "i", "arps=4, num_stages=2)\n    try:\n        t = timeit(run)\n        print(f'NUM_SMS={nsms}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'NUM_SMS={nsms}: FAIL {str(ex)[:60]}')\nEOF\ngpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/bench5.py /workspace/bench5.py && gpu exec sb-ins49HDnKyysW9SUxtfB1d -- python3 /workspace/bench5.py\n"]
