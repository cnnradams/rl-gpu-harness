[347.518031, "o", "\u001b[?2004h> "]
[347.518095, "o", "import torch, time, sys\r\n\u001b[?2004l\r"]
[347.518115, "o", "\u001b[?2004h> "]
[347.518197, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[347.518218, "o", "\u001b[?2004h> "]
[347.518278, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[347.5183, "o", "\u001b[?2004h> \r\n"]
[347.518331, "o", "\u001b[?2004l\r\u001b[?2004h"]
[347.518361, "o", "> "]
[347.518389, "o", "class Model(nn.Module):\r\n\u001b[?2004l\r"]
[347.518407, "o", "\u001b[?2004h> "]
[347.518569, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.518594, "o", "> "]
[347.518648, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[347.518667, "o", "\u001b[?2004h> "]
[347.518804, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[347.518825, "o", "\u001b[?2004h> "]
[347.518924, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[347.518955, "o", "\u001b[?2004h> "]
[347.519008, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[347.519028, "o", "\u001b[?2004h> "]
[347.519092, "o", "        x = self.matmul(x)\r\n\u001b[?2004l\r"]
[347.51912, "o", "\u001b[?2004h> "]
[347.519205, "o", "        original_x = x.clone().detach()\r\n\u001b[?2004l\r"]
[347.519235, "o", "\u001b[?2004h> "]
[347.519317, "o", "        x = x * self.scaling_factor\r\n\u001b[?2004l\r"]
[347.519342, "o", "\u001b[?2004h> "]
[347.519402, "o", "        x = x + original_x\r\n\u001b[?2004l\r"]
[347.519429, "o", "\u001b[?2004h> "]
[347.519465, "o", "        return x\r\n\u001b[?2004l\r"]
[347.519485, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.5195, "o", "\u001b[?2004h"]
[347.519515, "o", "> "]
[347.519582, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[347.519602, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.519632, "o", "\u001b[?2004h> "]
[347.519683, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[347.51971, "o", "\u001b[?2004h> "]
[347.519789, "o", "ref = Model(4096, 4096, 0.5).cuda()\r\n\u001b[?2004l\r"]
[347.51982, "o", "\u001b[?2004h> "]
[347.519864, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[347.519895, "o", "\u001b[?2004h> "]
[347.519973, "o", "new = ModelNew(4096, 4096, 0.5).cuda()\r\n\u001b[?2004l\r"]
[347.520004, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.520034, "o", "\u001b[?2004h> "]
[347.520089, "o", "def timeit(fn, x, iters=50):\r\n\u001b[?2004l\r"]
[347.520116, "o", "\u001b[?2004h> "]
[347.52018, "o", "    for _ in range(10): fn(x)\r\n\u001b[?2004l\r"]
[347.520199, "o", "\u001b[?2004h> "]
