[347.50362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[347.503634, "o", "\u001b[?2004h"]
[347.503653, "o", "> \r\n\u001b[?2004l\r"]
[347.503675, "o", "\u001b[?2004h> "]
[347.503767, "o", "@triton.autotune(\r\n\u001b[?2004l\r"]
[347.50379, "o", "\u001b[?2004h> "]
[347.503855, "o", "    configs=[\r\n\u001b[?2004l\r"]
[347.503882, "o", "\u001b[?2004h> "]
[347.504364, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[347.504393, "o", "\u001b[?2004h> "]
[347.504869, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.504892, "o", "> "]
[347.505359, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[347.505373, "o", "\u001b[?2004h"]
[347.505421, "o", "> "]
[347.505855, "o", "        triton.Config({'BLOCK_M': 256, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[347.505882, "o", "\u001b[?2004h> "]
[347.506414, "o", "        triton.Config({'BLOCK_M': 64, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r"]
[347.506443, "o", "\u001b[?2004h"]
[347.50646, "o", ">     ],\r\n\u001b[?2004l\r"]
[347.506489, "o", "\u001b[?2004h"]
[347.50652, "o", "> "]
[347.506609, "o", "    key=['M', 'N', 'K'],\r\n\u001b[?2004l\r"]
[347.506638, "o", "\u001b[?2004h> )\r\n"]
[347.506658, "o", "\u001b[?2004l\r\u001b[?2004h"]
[347.50669, "o", "> "]
[347.506725, "o", "@triton.jit\r\n"]
[347.506752, "o", "\u001b[?2004l\r\u001b[?2004h"]
[347.506783, "o", "> "]
[347.506934, "o", "def _gemm_f16x3(A, B, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[347.506961, "o", "\u001b[?2004h> "]
[347.507145, "o", "                sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[347.507175, "o", "\u001b[?2004h> "]
[347.50733, "o", "                ALPHA: tl.constexpr,\r\n\u001b[?2004l\r"]
[347.507355, "o", "\u001b[?2004h> "]
[347.507709, "o", "                BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[347.507737, "o", "\u001b[?2004h> "]
[347.507903, "o", "                GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[347.507934, "o", "\u001b[?2004h> "]
[347.508024, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[347.508046, "o", "\u001b[?2004h"]
[347.508068, "o", "> "]
[347.508203, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[347.50823, "o", "\u001b[?2004h> "]
[347.508372, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[347.508404, "o", "\u001b[?2004h> "]
[347.508562, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[347.508592, "o", "\u001b[?2004h> "]
[347.508744, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[347.508771, "o", "\u001b[?2004h> "]
[347.508932, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[347.508961, "o", "\u001b[?2004h> "]
[347.509086, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[347.509113, "o", "\u001b[?2004h> "]
[347.509272, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[347.5093, "o", "\u001b[?2004h> "]
[347.509417, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[347.509445, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.509462, "o", "\u001b[?2004h> "]
[347.509581, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[347.509608, "o", "\u001b[?2004h> "]
[347.509716, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[347.509743, "o", "\u001b[?2004h> "]
[347.509813, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[347.50984, "o", "\u001b[?2004h> "]
[347.509974, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[347.509996, "o", "\u001b[?2004h> "]
[347.510117, "o", "    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[347.510144, "o", "\u001b[?2004h> "]
[347.510278, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[347.510306, "o", "\u001b[?2004h> "]
[347.510404, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[347.510431, "o", "\u001b[?2004h> "]
[347.510491, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[347.510521, "o", "\u001b[?2004h> "]
[347.510578, "o", "        b = tl.load(B_ptr)\r\n\u001b[?2004l\r"]
[347.510605, "o", "\u001b[?2004h> "]
[347.510676, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[347.510702, "o", "\u001b[?2004h> "]
[347.510829, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[347.510856, "o", "\u001b[?2004h> "]
[347.510928, "o", "        b_hi = b.to(tl.float16)\r\n\u001b[?2004l\r"]
[347.510958, "o", "\u001b[?2004h> "]
[347.511079, "o", "        b_lo = (b - b_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[347.511107, "o", "\u001b[?2004h> "]
[347.511192, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[347.511213, "o", "\u001b[?2004h> "]
[347.511312, "o", "        acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[347.511342, "o", "\u001b[?2004h> "]
[347.511422, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[347.51145, "o", "\u001b[?2004h> "]
[347.511518, "o", "        A_ptr += BLOCK_K * sak\r\n\u001b[?2004l\r"]
[347.511545, "o", "\u001b[?2004h> "]
[347.511614, "o", "        B_ptr += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[347.511641, "o", "\u001b[?2004h> "]
[347.511741, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[347.511768, "o", "\u001b[?2004h> "]
[347.511874, "o", "    acc = acc * ALPHA + (ALPHA * bias)[None, :]\r\n\u001b[?2004l\r"]
[347.511905, "o", "\u001b[?2004h> "]
[347.512024, "o", "    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[347.512051, "o", "\u001b[?2004h> "]
[347.512108, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[347.512136, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.512162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.512193, "o", "\u001b[?2004h> "]
[347.512249, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[347.512277, "o", "\u001b[?2004h> "]
[347.512431, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[347.512464, "o", "\u001b[?2004h> "]
[347.51252, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[347.512548, "o", "\u001b[?2004h> "]
[347.51268, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[347.512707, "o", "\u001b[?2004h> "]
[347.512822, "o", "        self.scaling_factor = float(scaling_factor)\r\n\u001b[?2004l\r"]
[347.512853, "o", "\u001b[?2004h> "]
[347.512957, "o", "        self._alpha = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[347.512984, "o", "\u001b[?2004h> "]
[347.513038, "o", "        self._wt = None\r\n\u001b[?2004l\r"]
[347.513066, "o", "\u001b[?2004h> "]
[347.513134, "o", "        self._cache_key = None\r\n\u001b[?2004l\r"]
[347.513165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.513191, "o", "\u001b[?2004h> "]
[347.513247, "o", "    def _get_wt(self, w):\r\n\u001b[?2004l\r"]
[347.513283, "o", "\u001b[?2004h> "]
[347.513414, "o", "        key = (w.device, w.dtype, w.data_ptr(), w._version)\r\n\u001b[?2004l\r"]
[347.513441, "o", "\u001b[?2004h> "]
[347.513518, "o", "        if self._cache_key != key:\r\n\u001b[?2004l\r"]
[347.513545, "o", "\u001b[?2004h> "]
[347.513638, "o", "            self._wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[347.513665, "o", "\u001b[?2004h> "]
[347.513741, "o", "            self._cache_key = key\r\n\u001b[?2004l\r"]
[347.513772, "o", "\u001b[?2004h> "]
[347.513822, "o", "        return self._wt\r\n\u001b[?2004l\r"]
[347.513849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[347.513876, "o", "\u001b[?2004h> "]
[347.513943, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[347.513964, "o", "\u001b[?2004h> "]
[347.514038, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[347.514062, "o", "\u001b[?2004h> "]
[347.514131, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[347.514152, "o", "\u001b[?2004h> "]
[347.514317, "o", "        if (x.is_cuda and x.dtype == torch.float32 and x.dim() == 2\r\n\u001b[?2004l\r"]
[347.514336, "o", "\u001b[?2004h> "]
[347.514478, "o", "                and x.stride(1) == 1 and w.stride(1) == 1):\r\n\u001b[?2004l\r"]
[347.514505, "o", "\u001b[?2004h> "]
[347.514565, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[347.514593, "o", "\u001b[?2004h> "]
[347.514652, "o", "            N = w.shape[0]\r\n\u001b[?2004l\r"]
[347.514679, "o", "\u001b[?2004h> "]
[347.514872, "o", "            if M % 256 == 0 and N % 256 == 0 and K % 64 == 0 and K == w.shape[1]:\r\n\u001b[?2004l\r"]
[347.514899, "o", "\u001b[?2004h> "]
[347.514981, "o", "                wt = self._get_wt(w)\r\n\u001b[?2004l\r"]
[347.515, "o", "\u001b[?2004h> "]
[347.515185, "o", "                out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[347.515212, "o", "\u001b[?2004h> "]
[347.515464, "o", "                grid = lambda meta: (triton.cdiv(M, meta['BLOCK_M']) * triton.cdiv(N, meta['BLOCK_N']),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.515493, "o", "> "]
[347.515615, "o", "                _gemm_f16x3[grid](x, wt, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[347.515641, "o", "\u001b[?2004h> "]
[347.515777, "o", "                                  x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[347.515805, "o", "> "]
[347.515935, "o", "                                  wt.stride(0), wt.stride(1),\r\n\u001b[?2004l\r"]
[347.515962, "o", "\u001b[?2004h> "]
[347.516103, "o", "                                  out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[347.516131, "o", "\u001b[?2004h> "]
[347.51625, "o", "                                  ALPHA=self._alpha)\r\n\u001b[?2004l\r"]
[347.516277, "o", "\u001b[?2004h> "]
[347.516344, "o", "                return out\r\n\u001b[?2004l\r"]
[347.516369, "o", "\u001b[?2004h> "]
[347.516503, "o", "        return torch.addmm(b, x, w.t(), alpha=self._alpha)\r\n\u001b[?2004l\r"]
[347.516531, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
