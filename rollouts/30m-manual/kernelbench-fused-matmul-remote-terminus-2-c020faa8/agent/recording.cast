[952.959552, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, sys\nsys.path.insert(0, '/workspace')\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nxh = torch.rand(M, K, device='cuda').half()\nwh = torch.rand(K, N, device='cuda').half()\nout16 = torch.empty(M, N, device='cuda', dtype=torch.float16)\n\ndef timeit(fn, iters=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\nt = timeit(lambda: torch.matmul(xh, wh, out=out16))\nprint(f'cublas fp16 gemm: {t:.3f} ms -> {2*M*N*K/t/1e9:.0f} TFLOPS')\n\n# tf32 cublas\nxf = torch.rand(M, K, device='cuda')\nwf = torch.rand(N, K, device='cuda')\noutf = torch.empty(M, N, device='cuda')\ntorch.backends.cuda.matmul.allow_tf32 = False\nt = timeit(lambda: torch.addmm(b if False else torch.zeros(N, device='cuda'), xf, wf.t(), out=outf))\nprint(f'cublas fp32 addmm: {t:.3f} "]
[952.95961, "i", "ms -> {2*M*N*K/t/1e9:.0f} TFLOPS')\ntorch.backends.cuda.matmul.allow_tf32 = True\nt = timeit(lambda: torch.addmm(torch.zeros(N, device='cuda'), xf, wf.t(), out=outf))\nprint(f'cublas tf32 addmm: {t:.3f} ms -> {2*M*N*K/t/1e9:.0f} TFLOPS')\ntorch.backends.cuda.matmul.allow_tf32 = False\nEOF\ngpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/bench2.py /workspace/bench2.py && gpu exec sb-ins49HDnKyysW9SUxtfB1d -- python3 /workspace/bench2.py\n"]
