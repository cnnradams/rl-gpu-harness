[880.440073, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, sys\nsys.path.insert(0, '/workspace')\nimport triton.language as tl\nfrom sol_v3 import _split_kernel, _gemm_f16x3_tma, _launch_split, _ensure_alloc\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\nwh = wt.half(); wl = (wt - wh.float()).half()\nxh = x.half(); xl = (x - xh.float()).half()\nout = torch.empty(M, N, device='cuda')\n\ndef timeit(fn, iters=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\n# split kernel timing\nxh2 = torch.empty_like(xh); xl2 = torch.empty_like(xl)\nt_split = timeit(lambda: _launch_split(x, xh2, xl2))\nprint(f'split x: {t_split*1000:.1f} us')\n\n_ensure_alloc()\nnum_sms = 132\ndef gemm():\n    grid = lambda meta: (min(nu"]
[880.44012, "i", "m_sms, triton.cdiv(M, meta['BLOCK_M'])*triton.cdiv(N, meta['BLOCK_N'])),)\n    _gemm_f16x3_tma[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=1.5)\nt_g = timeit(gemm)\nprint(f'f16x3 tma gemm: {t_g:.3f} ms')\nprint(f'best config: {_gemm_f16x3_tma.best_config}')\n\n# pure fp16 gemm (1 dot) for reference: use same kernel but pass hi for lo\n# simple bandwidth test: copy 268MB\ny = torch.empty_like(x)\nt_cp = timeit(lambda: y.copy_(x))\nprint(f'copy 256MB->256MB: {t_cp:.3f} ms, eff bw: {2*x.numel()*4/t_cp/1e9:.2f} TB/s')\nEOF\ngpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/bench.py /workspace/bench.py && gpu exec sb-ins49HDnKyysW9SUxtfB1d -- python3 /workspace/bench.py\n"]
