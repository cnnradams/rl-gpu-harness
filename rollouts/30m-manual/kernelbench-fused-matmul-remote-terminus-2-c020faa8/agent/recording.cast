[1025.125501, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, sys\nimport triton.language as tl\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nxh = torch.rand(M, K, device='cuda').half()\nxl = torch.rand(M, K, device='cuda').half()\nwh = torch.rand(K, N, device='cuda').half()\nwl = torch.rand(K, N, device='cuda').half()\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\n\ndef alloc(size, align, stream):\n    return torch.empty(size, dtype=torch.int8, device='cuda')\ntriton.set_allocator(alloc)\n\ndef timeit(fn, iters=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\n@triton.jit\ndef k_ws(ah_ptr, al_ptr, bh_ptr, bl_ptr, c_ptr, Bias, M, N, K,\n         ALPHA: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr,\n         BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, NUM_SMS: tl.constexpr,\n         WS: tl"]
[1025.125548, "i", ".constexpr, FLAT: tl.constexpr):\n    desc_ah = tl.make_tensor_descriptor(ah_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\n    desc_al = tl.make_tensor_descriptor(al_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\n    desc_bh = tl.make_tensor_descriptor(bh_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\n    desc_bl = tl.make_tensor_descriptor(bl_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\n    desc_c = tl.make_tensor_descriptor(c_ptr, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    k_tiles = tl.cdiv(K, BLOCK_K)\n    num_tiles = num_pid_m * num_pid_n\n    for tile_id in tl.range(tl.program_id(0), num_tiles, NUM_SMS, flatten=FLAT, warp_specialize=WS):\n        num_pid_in_group = GROUP_M * num_pid_n\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GROUP_M\n        group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n  "]
[1025.125562, "i", "      pid_m = first_pid_m + (tile_id % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        offs_am = pid_m * BLOCK_M\n        offs_bn = pid_n * BLOCK_N\n        acc0 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n        acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n        for ki in range(k_tiles):\n            offs_k = ki * BLOCK_K\n            ah = desc_ah.load([offs_am, offs_k])\n            al = desc_al.load([offs_am, offs_k])\n            bh = desc_bh.load([offs_k, offs_bn])\n            bl = desc_bl.load([offs_k, offs_bn])\n            acc0 = tl.dot(ah, bh, acc0)\n            acc1 = tl.dot(ah, bl, acc1)\n            acc1 = tl.dot(al, bh, acc1)\n        acc = acc0 + acc1\n        bias = tl.load(Bias + pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.float32)\n        acc = acc * ALPHA + (ALPHA * bias)[None, :]\n        desc_c.store([offs_am, offs_bn], acc)\n\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\nprint('sms', NUM_SMS)\n\ndef run(BM, BN, BK, GM, ws, flat"]
[1025.125702, "i", ", warps, stages):\n    grid = (min(NUM_SMS, triton.cdiv(M,BM)*triton.cdiv(N,BN)),)\n    k_ws[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=1.5,\n               BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM, NUM_SMS=NUM_SMS,\n               WS=ws, FLAT=flat, num_warps=warps, num_stages=stages)\n\n# correctness vs fp32 ref\nxf = xh.float() + xl.float()\nwf = wh.float() + wl.float()\nref = 1.5*(xf @ wf + b)\nfor (BM, BN, BK, ws, flat, warps, stages) in [\n    (128,128,64,False,True,8,3),\n    (128,128,64,True,False,4,3),\n    (128,256,64,True,False,4,3),\n    (128,256,64,True,False,8,2),\n    (256,128,64,True,False,4,3),\n    (128,128,64,True,False,8,3),\n    (64,256,64,True,False,4,3),\n    (128,256,128,True,False,4,2),\n]:\n    try:\n        t = timeit(lambda: run(BM,BN,BK,8,ws,flat,warps,stages))\n        run(BM,BN,BK,8,ws,flat,warps,stages)\n        md = (out - ref).abs().max().item()\n        print(f'BM{BM} BN{BN} BK{BK} ws={int(ws)} flat={int(flat)} w{warps} s{stages}: {t:.3f} ms  md={md:.2e}')\n    except Exception as ex:\n       "]
