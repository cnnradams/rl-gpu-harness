[726.237578, "o", "\u001b[?2004h> "]
[726.237736, "o", "    tl.store(lo_ptr + offs, lo, mask=m)\r\n\u001b[?2004l\r"]
[726.23777, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[726.237815, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.237913, "o", "@triton.autotune(\r\n\u001b[?2004l\r"]
[726.237954, "o", "\u001b[?2004h> "]
[726.237995, "o", "    configs=[\r\n\u001b[?2004l\r"]
[726.238035, "o", "\u001b[?2004h> "]
[726.238529, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r"]
[726.238571, "o", "\u001b[?2004h"]
[726.238604, "o", "> "]
[726.239092, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=5),\r\n\u001b[?2004l\r"]
[726.239116, "o", "\u001b[?2004h> "]
[726.239619, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[726.239659, "o", "\u001b[?2004h"]
[726.239691, "o", "> "]
[726.240175, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r"]
[726.240212, "o", "\u001b[?2004h"]
[726.24025, "o", "> "]
[726.240732, "o", "        triton.Config({'BLOCK_M': 256, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r"]
[726.240771, "o", "\u001b[?2004h> "]
[726.241297, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 128, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[726.241335, "o", "\u001b[?2004h> "]
[726.24186, "o", "        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 128, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[726.24191, "o", "\u001b[?2004h> "]
[726.242412, "o", "        triton.Config({'BLOCK_M': 64, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\r\n\u001b[?2004l\r"]
[726.242452, "o", "\u001b[?2004h> "]
[726.242492, "o", "    ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.242594, "o", "    key=['M', 'N', 'K'],\r\n\u001b[?2004l\r"]
[726.242636, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[726.242674, "o", "\u001b[?2004h> "]
[726.242713, "o", "@triton.jit\r\n\u001b[?2004l\r_"]
[726.242751, "o", "\u001b[?2004h> "]
[726.243057, "o", "def _gemm_f16x3_tma(ah_ptr, al_ptr, bh_ptr, bl_ptr, c_ptr, Bias, M, N, K,\r\n\u001b[?2004l\r"]
[726.243097, "o", "\u001b[?2004h"]
[726.243136, "o", "> "]
[726.243271, "o", "                    ALPHA: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.243635, "o", "                    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[726.243679, "o", "\u001b[?2004h> "]
[726.243961, "o", "                    GROUP_M: tl.constexpr, NUM_SMS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.244011, "o", "> "]
[726.244413, "o", "    desc_ah = tl.make_tensor_descriptor(ah_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r"]
[726.244452, "o", "\u001b[?2004h> "]
[726.244789, "o", "    desc_al = tl.make_tensor_descriptor(al_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r"]
[726.244838, "o", "\u001b[?2004h> "]
[726.24507, "o", "    desc_bh = tl.make_tensor_descriptor(bh_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.245109, "o", "> "]
[726.245339, "o", "    desc_bl = tl.make_tensor_descriptor(bl_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.245376, "o", "> "]
[726.245605, "o", "    desc_c = tl.make_tensor_descriptor(c_ptr, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\r\n\u001b[?2004l\r"]
[726.245621, "o", "\u001b[?2004h> "]
[726.245713, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.245755, "o", "> "]
[726.245823, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[726.245863, "o", "\u001b[?2004h> "]
[726.245953, "o", "    k_tiles = tl.cdiv(K, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.246064, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.2461, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.246291, "o", "    for tile_id in tl.range(tl.program_id(0), num_tiles, NUM_SMS, flatten=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.246309, "o", "> "]
[726.246411, "o", "        num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[726.246452, "o", "\u001b[?2004h> "]
[726.246563, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[726.246601, "o", "\u001b[?2004h> "]
[726.246684, "o", "        first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[726.246723, "o", "\u001b[?2004h> "]
[726.246854, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[726.246888, "o", "\u001b[?2004h> "]
[726.247006, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[726.247039, "o", "\u001b[?2004h> "]
[726.247172, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[726.24721, "o", "\u001b[?2004h> "]
[726.247278, "o", "        offs_am = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[726.247316, "o", "\u001b[?2004h> "]
[726.247384, "o", "        offs_bn = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[726.247422, "o", "\u001b[?2004h> "]
[726.247553, "o", "        acc0 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[726.247591, "o", "\u001b[?2004h> "]
[726.24772, "o", "        acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[726.247751, "o", "\u001b[?2004h> "]
[726.247831, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[726.247869, "o", "\u001b[?2004h> "]
[726.247936, "o", "            offs_k = ki * BLOCK_K\r\n\u001b[?2004l\r"]
[726.247975, "o", "\u001b[?2004h> "]
[726.248076, "o", "            ah = desc_ah.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[726.248107, "o", "\u001b[?2004h> "]
[726.248215, "o", "            al = desc_al.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[726.248254, "o", "\u001b[?2004h> "]
[726.248354, "o", "            bh = desc_bh.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[726.248385, "o", "\u001b[?2004h> "]
[726.248494, "o", "            bl = desc_bl.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[726.248527, "o", "\u001b[?2004h> "]
[726.248613, "o", "            acc0 = tl.dot(ah, bh, acc0)\r\n\u001b[?2004l\r"]
[726.248651, "o", "\u001b[?2004h> "]
[726.248732, "o", "            acc1 = tl.dot(ah, bl, acc1)\r\n\u001b[?2004l\r"]
[726.248764, "o", "\u001b[?2004h> "]
[726.248859, "o", "            acc1 = tl.dot(al, bh, acc1)\r\n\u001b[?2004l\r"]
[726.248891, "o", "\u001b[?2004h> "]
[726.248947, "o", "        acc = acc0 + acc1\r\n\u001b[?2004l\r"]
[726.248986, "o", "\u001b[?2004h> "]
[726.249174, "o", "        bias = tl.load(Bias + pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.float32)\r\n\u001b[?2004l\r"]
[726.249215, "o", "\u001b[?2004h> "]
[726.249317, "o", "        acc = acc * ALPHA + (ALPHA * bias)[None, :]\r\n\u001b[?2004l\r"]
[726.249356, "o", "\u001b[?2004h> "]
[726.249449, "o", "        desc_c.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[726.249489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[726.249521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[726.249558, "o", "\u001b[?2004h> "]
[726.249615, "o", "def _launch_split(x, hi, lo):\r\n\u001b[?2004l\r"]
[726.249647, "o", "\u001b[?2004h> "]
[726.249696, "o", "    numel = x.numel()\r\n\u001b[?2004l\r"]
[726.249728, "o", "\u001b[?2004h> "]
[726.249766, "o", "    BLOCK = 16384\r\n\u001b[?2004l\r"]
[726.249805, "o", "\u001b[?2004h> "]
[726.249907, "o", "    grid = (triton.cdiv(numel, BLOCK),)\r\n\u001b[?2004l\r"]
[726.249947, "o", "\u001b[?2004h> "]
[726.250085, "o", "    _split_kernel[grid](x, hi, lo, numel, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[726.250127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[726.250166, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.250232, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[726.250264, "o", "\u001b[?2004h> "]
[726.250408, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[726.250447, "o", "\u001b[?2004h> "]
[726.250486, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[726.250517, "o", "\u001b[?2004h> "]
[726.250652, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[726.250691, "o", "\u001b[?2004h> "]
[726.250791, "o", "        self.scaling_factor = float(scaling_factor)\r\n\u001b[?2004l\r"]
[726.250829, "o", "\u001b[?2004h> "]
[726.250932, "o", "        self._alpha = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[726.250964, "o", "\u001b[?2004h> "]
[726.25101, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[726.251042, "o", "\u001b[?2004h> "]
[726.25109, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[726.251121, "o", "\u001b[?2004h> "]
[726.251184, "o", "        self._cache_key = None\r\n\u001b[?2004l\r"]
[726.251223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[726.251261, "o", "> "]
[726.251306, "o", "    def _get_wsplits(self, w):\r\n\u001b[?2004l\r"]
[726.251338, "o", "\u001b[?2004h> "]
[726.251465, "o", "        key = (w.device, w.dtype, w.data_ptr(), w._version)\r\n\u001b[?2004l\r"]
[726.251497, "o", "\u001b[?2004h> "]
[726.251569, "o", "        if self._cache_key != key:\r\n\u001b[?2004l\r"]
[726.251607, "o", "\u001b[?2004h> "]
[726.251676, "o", "            wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[726.251714, "o", "\u001b[?2004h> "]
[726.251798, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[726.251843, "o", "\u001b[?2004h> "]
[726.251978, "o", "            wl = (wt - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[726.252011, "o", "\u001b[?2004h> "]
[726.25209, "o", "            self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[726.252123, "o", "\u001b[?2004h> "]
[726.252208, "o", "            self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[726.252244, "o", "\u001b[?2004h> "]
[726.252314, "o", "            self._cache_key = key\r\n\u001b[?2004l\r"]
[726.252352, "o", "\u001b[?2004h> "]
[726.252421, "o", "        return self._wh, self._wl\r\n\u001b[?2004l\r"]
[726.252454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[726.252485, "o", "\u001b[?2004h> "]
[726.252532, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[726.252563, "o", "\u001b[?2004h> "]
[726.252628, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[726.252666, "o", "\u001b[?2004h> "]
[726.252718, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[726.252755, "o", "\u001b[?2004h> "]
[726.252906, "o", "        if (x.is_cuda and x.dtype == torch.float32 and x.dim() == 2\r\n\u001b[?2004l\r"]
[726.252938, "o", "\u001b[?2004h> "]
[726.253064, "o", "                and x.stride(1) == 1 and w.stride(1) == 1):\r\n\u001b[?2004l\r"]
[726.253095, "o", "\u001b[?2004h> "]
[726.253151, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[726.253189, "o", "\u001b[?2004h> "]
[726.253238, "o", "            N = w.shape[0]\r\n\u001b[?2004l\r"]
[726.253269, "o", "\u001b[?2004h> "]
[726.253448, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 64 == 0 and K == w.shape[1]:\r\n\u001b[?2004l\r"]
[726.253486, "o", "\u001b[?2004h> "]
[726.253556, "o", "                _ensure_alloc()\r\n\u001b[?2004l\r"]
[726.253594, "o", "\u001b[?2004h> "]
[726.253688, "o", "                wh, wl = self._get_wsplits(w)\r\n\u001b[?2004l\r"]
[726.253728, "o", "\u001b[?2004h> "]
[726.253912, "o", "                xh = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[726.253952, "o", "\u001b[?2004h> "]
[726.254119, "o", "                xl = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[726.254157, "o", "\u001b[?2004h> "]
[726.254234, "o", "                _launch_split(x, xh, xl)\r\n\u001b[?2004l\r"]
[726.254273, "o", "\u001b[?2004h> "]
[726.254453, "o", "                out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[726.254486, "o", "\u001b[?2004h> "]
[726.254691, "o", "                num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count\r\n\u001b[?2004l\r"]
[726.254732, "o", "\u001b[?2004h> "]
[726.255, "o", "                grid = lambda meta: (min(num_sms, triton.cdiv(M, meta['BLOCK_M']) * triton.cdiv(N, meta['BLOCK_N'])),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.255041, "o", "> "]
[726.255229, "o", "                _gemm_f16x3_tma[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=self._alpha)\r\n\u001b[?2004l\r"]
[726.255271, "o", "\u001b[?2004h> "]
[726.255318, "o", "                return out\r\n\u001b[?2004l\r"]
[726.255357, "o", "\u001b[?2004h> "]
[726.255481, "o", "        return torch.addmm(b, x, w.t(), alpha=self._alpha)\r\n\u001b[?2004l\r"]
[726.255513, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[726.256541, "o", "\u001b[?2004hroot@modal:/workspace# "]
[726.256792, "o", "sed 's/from sol_v2 import ModelNew/from sol_v3 import ModelNew/' /workspace/test_v2.py > /workspace/test_v3.py\r\n\u001b[?2004l\r"]
[726.258156, "o", "\u001b[?2004hroot@modal:/workspace# "]
