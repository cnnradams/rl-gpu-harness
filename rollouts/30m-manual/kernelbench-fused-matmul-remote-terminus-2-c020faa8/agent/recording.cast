[726.233969, "i", "cat > /workspace/sol_v3.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n_alloc_set = False\ndef _ensure_alloc():\n    global _alloc_set\n    if not _alloc_set:\n        def alloc(size, align, stream):\n            return torch.empty(size, dtype=torch.int8, device='cuda')\n        triton.set_allocator(alloc)\n        _alloc_set = True\n\n\n@triton.jit\ndef _split_kernel(x_ptr, hi_ptr, lo_ptr, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < numel\n    v = tl.load(x_ptr + offs, mask=m)\n    hi = v.to(tl.float16)\n    lo = (v - hi.to(tl.float32)).to(tl.float16)\n    tl.store(hi_ptr + offs, hi, mask=m)\n    tl.store(lo_ptr + offs, lo, mask=m)\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\n        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_st"]
[726.23402, "i", "ages=5),\n        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=3),\n        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\n        triton.Config({'BLOCK_M': 256, 'BLOCK_N': 128, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\n        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 128, 'BLOCK_K': 128, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=3),\n        triton.Config({'BLOCK_M': 128, 'BLOCK_N': 256, 'BLOCK_K': 128, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=3),\n        triton.Config({'BLOCK_M': 64, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8, 'NUM_SMS': 132}, num_warps=8, num_stages=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _gemm_f16x3_tma(ah_ptr, al_ptr, bh_ptr, bl_ptr, c_ptr, Bias, M, N, K,\n                    ALPHA: tl.constexpr,\n                    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.c"]
[726.234029, "i", "onstexpr,\n                    GROUP_M: tl.constexpr, NUM_SMS: tl.constexpr):\n    desc_ah = tl.make_tensor_descriptor(ah_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\n    desc_al = tl.make_tensor_descriptor(al_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\n    desc_bh = tl.make_tensor_descriptor(bh_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\n    desc_bl = tl.make_tensor_descriptor(bl_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\n    desc_c = tl.make_tensor_descriptor(c_ptr, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    k_tiles = tl.cdiv(K, BLOCK_K)\n    num_tiles = num_pid_m * num_pid_n\n\n    for tile_id in tl.range(tl.program_id(0), num_tiles, NUM_SMS, flatten=True):\n        num_pid_in_group = GROUP_M * num_pid_n\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GROUP_M\n        group_size_m = min(num_pid_m -"]
[726.234187, "i", " first_pid_m, GROUP_M)\n        pid_m = first_pid_m + (tile_id % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        offs_am = pid_m * BLOCK_M\n        offs_bn = pid_n * BLOCK_N\n        acc0 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n        acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n        for ki in range(k_tiles):\n            offs_k = ki * BLOCK_K\n            ah = desc_ah.load([offs_am, offs_k])\n            al = desc_al.load([offs_am, offs_k])\n            bh = desc_bh.load([offs_k, offs_bn])\n            bl = desc_bl.load([offs_k, offs_bn])\n            acc0 = tl.dot(ah, bh, acc0)\n            acc1 = tl.dot(ah, bl, acc1)\n            acc1 = tl.dot(al, bh, acc1)\n        acc = acc0 + acc1\n        bias = tl.load(Bias + pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.float32)\n        acc = acc * ALPHA + (ALPHA * bias)[None, :]\n        desc_c.store([offs_am, offs_bn], acc)\n\n\ndef _launch_split(x, hi, lo):\n    numel = x.numel()\n    BLOCK = 16384\n    grid = (triton.cdiv(num"]
[726.234213, "o", "cat > /workspace/sol_v3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.234235, "i", "el, BLOCK),)\n    _split_kernel[grid](x, hi, lo, numel, BLOCK=BLOCK, num_warps=8)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = float(scaling_factor)\n        self._alpha = 1.0 + self.scaling_factor\n        self._wh = None\n        self._wl = None\n        self._cache_key = None\n\n    def _get_wsplits(self, w):\n        key = (w.device, w.dtype, w.data_ptr(), w._version)\n        if self._cache_key != key:\n            wt = w.t().contiguous()\n            wh = wt.to(torch.float16)\n            wl = (wt - wh.to(torch.float32)).to(torch.float16)\n            self._wh = wh.contiguous()\n            self._wl = wl.contiguous()\n            self._cache_key = key\n        return self._wh, self._wl\n\n    def forward(self, x):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        if (x.is_cuda and x.dtype == torch.float32 and x.dim() == 2\n                a"]
[726.234265, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.234277, "i", "nd x.stride(1) == 1 and w.stride(1) == 1):\n            M, K = x.shape\n            N = w.shape[0]\n            if M % 128 == 0 and N % 128 == 0 and K % 64 == 0 and K == w.shape[1]:\n                _ensure_alloc()\n                wh, wl = self._get_wsplits(w)\n                xh = torch.empty((M, K), device=x.device, dtype=torch.float16)\n                xl = torch.empty((M, K), device=x.device, dtype=torch.float16)\n                _launch_split(x, xh, xl)\n                out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n                num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count\n                grid = lambda meta: (min(num_sms, triton.cdiv(M, meta['BLOCK_M']) * triton.cdiv(N, meta['BLOCK_N'])),)\n                _gemm_f16x3_tma[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=self._alpha)\n                return out\n        return torch.addmm(b, x, w.t(), alpha=self._alpha)\nEOF\nsed 's/from sol_v2 import ModelNew/from sol_v3 import ModelNew/' /workspace/test_v2.py > /workspac"]
