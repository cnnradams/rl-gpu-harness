[1374.256201, "o", "trial 0: max_diff=2.170e-05 allclose=True\r\ntrial 1: max_diff=2.038e-05 allclose=True\r\ntrial 2: max_diff=2.241e-05 allclose=True\r\ntrial 3: max_diff=2.122e-05 allclose=True\r\ntrial 4: max_diff=2.301e-05 allclose=True\r\nnew: 2.593 ms  (all ok: True)\r\n"]
