[1025.130535, "o", "    desc_al = tl.make_tensor_descriptor(al_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.130551, "o", "> "]
[1025.131141, "o", "    desc_bh = tl.make_tensor_descriptor(bh_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h>     desc_bl = tl.make_tensor_descriptor(bl_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.131337, "o", "    desc_c = tl.make_tensor_descriptor(c_ptr, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.131354, "o", "> "]
[1025.131454, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.131471, "o", "> "]
[1025.13156, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1025.131602, "o", "\u001b[?2004h> "]
[1025.131666, "o", "    k_tiles = tl.cdiv(K, BLOCK_K)\r\n\u001b[?2004l\r"]
[1025.131706, "o", "\u001b[?2004h> "]
[1025.131785, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r"]
[1025.131824, "o", "\u001b[?2004h> "]
[1025.132048, "o", "    for tile_id in tl.range(tl.program_id(0), num_tiles, NUM_SMS, flatten=FLAT, warp_specialize=WS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.132088, "o", "> "]
[1025.132179, "o", "        num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[1025.132218, "o", "\u001b[?2004h> "]
[1025.13231, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[1025.132349, "o", "\u001b[?2004h> "]
[1025.132441, "o", "        first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[1025.132474, "o", "\u001b[?2004h> "]
[1025.132605, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[1025.132644, "o", "\u001b[?2004h> "]
[1025.132758, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[1025.132796, "o", "\u001b[?2004h> "]
[1025.132925, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1025.13296, "o", "\u001b[?2004h> "]
[1025.133031, "o", "        offs_am = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[1025.13307, "o", "\u001b[?2004h> "]
[1025.133139, "o", "        offs_bn = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[1025.133171, "o", "\u001b[?2004h> "]
[1025.133307, "o", "        acc0 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1025.133342, "o", "\u001b[?2004h> "]
[1025.133488, "o", "        acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1025.133521, "o", "\u001b[?2004h> "]
[1025.133594, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[1025.133633, "o", "\u001b[?2004h> "]
[1025.133703, "o", "            offs_k = ki * BLOCK_K\r\n\u001b[?2004l\r"]
[1025.133741, "o", "\u001b[?2004h> "]
[1025.133843, "o", "            ah = desc_ah.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[1025.133883, "o", "\u001b[?2004h> "]
[1025.133994, "o", "            al = desc_al.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[1025.134033, "o", "\u001b[?2004h> "]
[1025.134131, "o", "            bh = desc_bh.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1025.134171, "o", "\u001b[?2004h> "]
[1025.134271, "o", "            bl = desc_bl.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1025.134303, "o", "\u001b[?2004h> "]
[1025.134392, "o", "            acc0 = tl.dot(ah, bh, acc0)\r\n\u001b[?2004l\r"]
[1025.134439, "o", "\u001b[?2004h> "]
[1025.134521, "o", "            acc1 = tl.dot(ah, bl, acc1)\r\n\u001b[?2004l\r"]
[1025.134559, "o", "\u001b[?2004h> "]
[1025.13464, "o", "            acc1 = tl.dot(al, bh, acc1)\r\n\u001b[?2004l\r"]
[1025.134675, "o", "\u001b[?2004h> "]
[1025.134729, "o", "        acc = acc0 + acc1\r\n\u001b[?2004l\r"]
[1025.134768, "o", "\u001b[?2004h> "]
[1025.134955, "o", "        bias = tl.load(Bias + pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.float32)\r\n\u001b[?2004l\r"]
[1025.134996, "o", "\u001b[?2004h> "]
[1025.135098, "o", "        acc = acc * ALPHA + (ALPHA * bias)[None, :]\r\n\u001b[?2004l\r"]
[1025.135136, "o", "\u001b[?2004h> "]
[1025.13523, "o", "        desc_c.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[1025.135268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1025.135303, "o", "\u001b[?2004h> "]
[1025.135454, "o", "NUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r"]
[1025.135493, "o", "\u001b[?2004h> "]
[1025.135531, "o", "print('sms', NUM_SMS)\r\n\u001b[?2004l\r"]
[1025.13557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1025.135602, "o", "\u001b[?2004h> "]
[1025.13571, "o", "def run(BM, BN, BK, GM, ws, flat, warps, stages):\r\n\u001b[?2004l\r"]
[1025.135743, "o", "\u001b[?2004h> "]
[1025.135884, "o", "    grid = (min(NUM_SMS, triton.cdiv(M,BM)*triton.cdiv(N,BN)),)\r\n\u001b[?2004l\r"]
[1025.135923, "o", "\u001b[?2004h> "]
[1025.136047, "o", "    k_ws[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=1.5,\r\n\u001b[?2004l\r"]
[1025.136086, "o", "\u001b[?2004h> "]
[1025.136257, "o", "               BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM, NUM_SMS=NUM_SMS,\r\n\u001b[?2004l\r"]
[1025.136298, "o", "\u001b[?2004h> "]
[1025.136449, "o", "               WS=ws, FLAT=flat, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[1025.136489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.136528, "o", "> "]
[1025.136566, "o", "# correctness vs fp32 ref\r\n\u001b[?2004l\r"]
[1025.136604, "o", "\u001b[?2004h> "]
[1025.136666, "o", "xf = xh.float() + xl.float()\r\n\u001b[?2004l\r"]
[1025.136706, "o", "\u001b[?2004h> "]
[1025.136761, "o", "wf = wh.float() + wl.float()\r\n\u001b[?2004l\r"]
[1025.1368, "o", "\u001b[?2004h> "]
[1025.136847, "o", "ref = 1.5*(xf @ wf + b)\r\n\u001b[?2004l\r"]
[1025.136882, "o", "\u001b[?2004h> "]
[1025.136983, "o", "for (BM, BN, BK, ws, flat, warps, stages) in [\r\n\u001b[?2004l\r"]
[1025.137015, "o", "\u001b[?2004h> "]
[1025.137089, "o", "    (128,128,64,False,True,8,3),\r\n\u001b[?2004l\r"]
[1025.137128, "o", "\u001b[?2004h> "]
[1025.137194, "o", "    (128,128,64,True,False,4,3),\r\n\u001b[?2004l\r"]
[1025.137232, "o", "\u001b[?2004h> "]
[1025.137298, "o", "    (128,256,64,True,False,4,3),\r\n\u001b[?2004l\r"]
[1025.137336, "o", "\u001b[?2004h> "]
[1025.137402, "o", "    (128,256,64,True,False,8,2),\r\n\u001b[?2004l\r"]
[1025.137439, "o", "\u001b[?2004h> "]
[1025.137516, "o", "    (256,128,64,True,False,4,3),\r\n\u001b[?2004l\r"]
[1025.137558, "o", "\u001b[?2004h> "]
[1025.137619, "o", "    (128,128,64,True,False,8,3),\r\n\u001b[?2004l\r"]
[1025.137655, "o", "\u001b[?2004h> "]
[1025.137722, "o", "    (64,256,64,True,False,4,3),\r\n\u001b[?2004l\r"]
[1025.137762, "o", "\u001b[?2004h> "]
[1025.13783, "o", "    (128,256,128,True,False,4,2),\r\n\u001b[?2004l\r"]
[1025.137866, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r"]
[1025.137917, "o", "\u001b[?2004h> "]
[1025.13795, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.138106, "o", "        t = timeit(lambda: run(BM,BN,BK,8,ws,flat,warps,stages))\r\n\u001b[?2004l\r"]
[1025.138146, "o", "\u001b[?2004h> "]
[1025.138237, "o", "        run(BM,BN,BK,8,ws,flat,warps,stages)\r\n\u001b[?2004l\r"]
[1025.138277, "o", "\u001b[?2004h> "]
[1025.138371, "o", "        md = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1025.138409, "o", "\u001b[?2004h> "]
[1025.138681, "o", "        print(f'BM{BM} BN{BN} BK{BK} ws={int(ws)} flat={int(flat)} w{warps} s{stages}: {t:.3f} ms  md={md:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.138758, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1025.1388, "o", "\u001b[?2004h> "]
[1025.139021, "o", "        print(f'BM{BM} BN{BN} BK{BK} ws={int(ws)} w{warps} s{stages}: FAIL {str(ex)[:80]}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.13909, "o", "EOF\r\n\u001b[?2004l\r"]
[1025.140373, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1025.140727, "o", "gpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/bench3.py /workspace/bench3.py && gpu exec sb-ins49HDnKyysW9SUxtfB1d -- python3 /workspace/bench3.py\r\n\u001b[?2004l\r"]
[1026.23254, "o", "{\r\n  \"bytes\": 4145,\r\n  \"sha256\": \"45506eaca8cd478917e79f07dddd222fb0ee9063ae98bca3087521f3568ffff4\"\r\n}\r\n"]
[1026.373271, "o", "request ID: 703e6d7aedbe4362b9566d49c64234c2\r\n"]
[1027.847934, "o", "command: 1d9dac4fd26f459a85369775320da60c\r\n"]
[1042.697363, "o", "sms 132\r\nBM128 BN128 BK64 ws=0 w8 s3: FAIL out of resource: shared memory, Required: 262168, Hardware limit: 232448. Reduci\r\nBM128 BN128 BK64 ws=1 w4 s3: FAIL out of resource: shared memory, Required: 278976, Hardware limit: 232448. Reduci\r\nBM128 BN256 BK64 ws=1 w4 s3: FAIL out of resource: shared memory, Required: 434872, Hardware limit: 232448. Reduci\r\nBM128 BN256 BK64 ws=1 w8 s2: FAIL out of resource: shared memory, Required: 327696, Hardware limit: 232448. Reduci\r\nBM256 BN128 BK64 ws=1 w4 s3: FAIL out of resource: shared memory, Required: 459200, Hardware limit: 232448. Reduci\r\nBM128 BN128 BK64 ws=1 w8 s3: FAIL out of resource: shared memory, Required: 262168, Hardware limit: 232448. Reduci\r\nBM64 BN256 BK64 ws=1 w4 s3: FAIL out of resource: shared memory, Required: 311992, Hardware limit: 232448. Reduci\r\nBM128 BN256 BK128 ws=1 w4 s2: FAIL out of resource: shared memory, Required: 524776, Hardware limit: 232448. Reduci\r\n"]
[1043.67159, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1092.55083, "i", "python3 - << 'EOF'\nsrc = open('/workspace/bench3.py').read()\nold_start = src.index('for (BM, BN, BK, ws, flat, warps, stages) in [')\nold_end = src.index(']:\\n    try:')\ncombos = '''for (BM, BN, BK, ws, flat, warps, stages) in [\n    (128,128,64,False,True,8,2),\n    (128,128,64,True,False,4,2),\n    (128,128,64,True,False,8,2),\n    (128,128,32,True,False,4,4),\n    (128,128,32,True,False,4,6),\n    (128,256,32,True,False,4,3),\n    (256,128,32,True,False,4,3),\n    (128,256,64,True,False,4,2),\n    (256,128,64,True,False,4,2),\n    (64,256,64,True,False,4,3),\n    (128,128,128,True,False,4,2),\n    (128,128,128,True,False,8,1),\n    (256,256,32,True,False,8,2),\n]\n'''\nsrc = src[:old_start] + combos + src[old_end+2:]\nopen('/workspace/bench3.py','w').write(src)\nEOF\ngpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/bench3.py /workspace/bench3.py && gpu exec sb-ins49HDnKyysW9SUxtfB1d -- python3 /workspace/bench3.py\n"]
