[517.698794, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[517.698824, "o", "\u001b[?2004h> "]
[517.69908, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[517.699106, "o", "\u001b[?2004h> "]
[517.699239, "o", "        offs_am = pid_m * BLOCK_M\r\n\u001b[?2004l\r\u001b[?2004h"]
[517.699264, "o", "> "]
[517.699392, "o", "        offs_bn = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[517.699413, "o", "\u001b[?2004h> "]
[517.699667, "o", "        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[517.699693, "o", "> "]
[517.69979, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[517.699821, "o", "\u001b[?2004h> "]
[517.699893, "o", "            offs_k = ki * BLOCK_K\r\n\u001b[?2004l\r"]
[517.699914, "o", "\u001b[?2004h> "]
[517.700028, "o", "            a = desc_a.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[517.700055, "o", "\u001b[?2004h> "]
[517.700163, "o", "            b = desc_b.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[517.700183, "o", "\u001b[?2004h> "]
[517.70027, "o", "            a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[517.700291, "o", "\u001b[?2004h> "]
[517.700439, "o", "            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[517.700461, "o", "> "]
[517.70054, "o", "            b_hi = b.to(tl.float16)\r\n\u001b[?2004l\r"]
[517.700562, "o", "\u001b[?2004h> "]
[517.700699, "o", "            b_lo = (b - b_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[517.700722, "o", "\u001b[?2004h> "]
[517.700818, "o", "            acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[517.700846, "o", "\u001b[?2004h> "]
[517.700938, "o", "            acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[517.700969, "o", "\u001b[?2004h> "]
[517.701065, "o", "            acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[517.701086, "o", "\u001b[?2004h> "]
[517.701286, "o", "        bias = tl.load(Bias + pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.float32)\r\n\u001b[?2004l\r"]
[517.701309, "o", "\u001b[?2004h> "]
[517.701428, "o", "        acc = acc * ALPHA + (ALPHA * bias)[None, :]\r\n\u001b[?2004l\r"]
[517.701458, "o", "\u001b[?2004h> "]
[517.701558, "o", "        desc_c.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[517.701579, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.701599, "o", "\u001b[?2004h> "]
[517.701622, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[517.701654, "o", "> "]
[517.701706, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[517.701727, "o", "\u001b[?2004h> "]
[517.701899, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[517.70193, "o", "\u001b[?2004h> "]
[517.701983, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[517.702013, "o", "\u001b[?2004h> "]
[517.702156, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[517.702176, "o", "\u001b[?2004h> "]
[517.702294, "o", "        self.scaling_factor = float(scaling_factor)\r\n\u001b[?2004l\r"]
[517.702325, "o", "\u001b[?2004h> "]
[517.702429, "o", "        self._alpha = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[517.702449, "o", "\u001b[?2004h> "]
[517.70251, "o", "        self._wt = None\r\n\u001b[?2004l\r"]
[517.70254, "o", "\u001b[?2004h> "]
[517.702606, "o", "        self._cache_key = None\r\n\u001b[?2004l\r"]
[517.702636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.702657, "o", "\u001b[?2004h> "]
[517.702716, "o", "    def _get_wt(self, w):\r\n\u001b[?2004l\r"]
[517.702747, "o", "\u001b[?2004h> "]
[517.702878, "o", "        key = (w.device, w.dtype, w.data_ptr(), w._version)\r\n\u001b[?2004l\r"]
[517.702909, "o", "\u001b[?2004h> "]
[517.702983, "o", "        if self._cache_key != key:\r\n\u001b[?2004l\r"]
[517.703014, "o", "\u001b[?2004h> "]
[517.703112, "o", "            self._wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[517.70314, "o", "\u001b[?2004h> "]
[517.703214, "o", "            self._cache_key = key\r\n\u001b[?2004l\r"]
[517.703245, "o", "\u001b[?2004h> "]
[517.703294, "o", "        return self._wt\r\n\u001b[?2004l\r"]
[517.703324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.703345, "o", "\u001b[?2004h> "]
[517.703406, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[517.703436, "o", "\u001b[?2004h> "]
[517.703501, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[517.703533, "o", "\u001b[?2004h> "]
[517.703593, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[517.703624, "o", "\u001b[?2004h> "]
[517.703809, "o", "        if (HAS_DEV_DESC and x.is_cuda and x.dtype == torch.float32 and x.dim() == 2\r\n\u001b[?2004l\r"]
[517.703834, "o", "\u001b[?2004h> "]
[517.703971, "o", "                and x.stride(1) == 1 and w.stride(1) == 1):\r\n\u001b[?2004l\r"]
[517.703999, "o", "\u001b[?2004h> "]
[517.704066, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[517.704096, "o", "\u001b[?2004h> "]
[517.704153, "o", "            N = w.shape[0]\r\n\u001b[?2004l\r"]
[517.704184, "o", "\u001b[?2004h> "]
[517.704362, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 64 == 0 and K == w.shape[1]:\r\n\u001b[?2004l\r"]
[517.70438, "o", "\u001b[?2004h> "]
[517.70447, "o", "                wt = self._get_wt(w)\r\n\u001b[?2004l\r"]
[517.70449, "o", "\u001b[?2004h> "]
[517.704676, "o", "                out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[517.704698, "o", "\u001b[?2004h> "]
[517.704827, "o", "                dummy = torch.empty(1, device=x.device)\r\n\u001b[?2004l\r"]
[517.704847, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.70487, "o", "\u001b[?2004h> "]
[517.704988, "o", "                def alloc(size, align, stream):\r\n\u001b[?2004l\r"]
[517.705013, "o", "\u001b[?2004h"]
[517.705045, "o", "> "]
[517.705223, "o", "                    return torch.empty(size, dtype=torch.int8, device=x.device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[517.705254, "o", "> "]
[517.70534, "o", "                triton.set_allocator(alloc)\r\n\u001b[?2004l\r"]
[517.70537, "o", "\u001b[?2004h> "]
[517.705537, "o", "                desc_a = TensorDescriptor(x, x.shape, x.stride(), [1, 64])\r\n\u001b[?2004l\r"]
[517.705558, "o", "\u001b[?2004h> "]
[517.705737, "o", "                desc_b = TensorDescriptor(wt, wt.shape, wt.stride(), [1, 128])\r\n\u001b[?2004l\r"]
[517.705767, "o", "\u001b[?2004h> "]
[517.705966, "o", "                desc_c = TensorDescriptor(out, out.shape, out.stride(), [1, 128])\r\n\u001b[?2004l\r"]
[517.705987, "o", "\u001b[?2004h> "]
[517.706198, "o", "                num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count\r\n\u001b[?2004l\r"]
[517.706215, "o", "\u001b[?2004h> "]
[517.706408, "o", "                grid = (min(num_sms, triton.cdiv(M, 128) * triton.cdiv(N, 128)),)\r\n\u001b[?2004l\r"]
[517.70644, "o", "\u001b[?2004h> "]
[517.706582, "o", "                _gemm_tma[grid](desc_a, desc_b, desc_c, b, M, N, K,\r\n\u001b[?2004l\r"]
[517.706603, "o", "\u001b[?2004h> "]
[517.706722, "o", "                                ALPHA=self._alpha)\r\n\u001b[?2004l\r"]
[517.706753, "o", "\u001b[?2004h> "]
[517.706808, "o", "                return out\r\n\u001b[?2004l\r"]
[517.706834, "o", "\u001b[?2004h> "]
[517.706967, "o", "        return torch.addmm(b, x, w.t(), alpha=self._alpha)\r\n\u001b[?2004l\r"]
[517.706999, "o", "\u001b[?2004h> "]
[517.70702, "o", "EOF\r\n\u001b[?2004l\r"]
[517.708219, "o", "\u001b[?2004hroot@modal:/workspace# "]
[517.708303, "o", "cat > /workspace/test_v2.py << 'EOF'\r\n\u001b[?2004l\r"]
[517.708324, "o", "\u001b[?2004h> "]
[517.708373, "o", "import torch, sys\r\n\u001b[?2004l\r"]
[517.708393, "o", "\u001b[?2004h> "]
[517.708481, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[517.708511, "o", "\u001b[?2004h> "]
[517.708555, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[517.708573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.7086, "o", "\u001b[?2004h> "]
[517.708665, "o", "class Model(nn.Module):\r\n\u001b[?2004l\r"]
[517.708686, "o", "\u001b[?2004h> "]
[517.708767, "o", "    def __init__(self, a, b, c):\r\n\u001b[?2004l\r"]
[517.708797, "o", "\u001b[?2004h> "]
[517.708857, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[517.708879, "o", "\u001b[?2004h> "]
[517.708969, "o", "        self.matmul = nn.Linear(a, b)\r\n\u001b[?2004l\r"]
[517.708989, "o", "\u001b[?2004h> "]
[517.709076, "o", "        self.scaling_factor = c\r\n\u001b[?2004l\r"]
[517.709097, "o", "\u001b[?2004h> "]
[517.709167, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[517.709198, "o", "\u001b[?2004h> "]
[517.709248, "o", "        x = self.matmul(x)\r\n\u001b[?2004l\r"]
[517.709279, "o", "\u001b[?2004h> "]
[517.709342, "o", "        o = x.clone().detach()\r\n\u001b[?2004l\r"]
[517.709361, "o", "\u001b[?2004h> "]
[517.709461, "o", "        return x * self.scaling_factor + o\r\n\u001b[?2004l\r"]
[517.709481, "o", "\u001b[?2004h> "]
[517.709502, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[517.709574, "o", "from sol_v2 import ModelNew\r\n\u001b[?2004l\r"]
[517.709594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.709613, "o", "\u001b[?2004h"]
[517.709634, "o", "> "]
[517.709674, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[517.709705, "o", "\u001b[?2004h> "]
[517.709777, "o", "ref = Model(4096, 4096, 0.5).cuda()\r\n\u001b[?2004l\r"]
[517.709795, "o", "\u001b[?2004h> "]
[517.709851, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[517.709869, "o", "\u001b[?2004h> "]
[517.709977, "o", "new = ModelNew(4096, 4096, 0.5).cuda()\r\n\u001b[?2004l\r"]
[517.709997, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.71002, "o", "\u001b[?2004h> "]
[517.710099, "o", "def timeit(fn, x, iters=50):\r\n\u001b[?2004l\r"]
[517.71013, "o", "\u001b[?2004h> "]
[517.710189, "o", "    for _ in range(10): fn(x)\r\n\u001b[?2004l\r"]
[517.710207, "o", "\u001b[?2004h> "]
[517.710279, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[517.71031, "o", "\u001b[?2004h> "]
[517.710437, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[517.710462, "o", "\u001b[?2004h> "]
[517.710495, "o", "    s.record()\r\n\u001b[?2004l\r"]
[517.710515, "o", "\u001b[?2004h> "]
[517.710592, "o", "    for _ in range(iters): fn(x)\r\n\u001b[?2004l\r"]
[517.710618, "o", "\u001b[?2004h> "]
[517.710706, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[517.710736, "o", "\u001b[?2004h> "]
[517.710812, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r"]
[517.71084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.71086, "o", "\u001b[?2004h> "]
[517.710896, "o", "ok_all = True\r\n\u001b[?2004l\r"]
[517.710926, "o", "\u001b[?2004h> "]
[517.710972, "o", "for trial in range(5):\r\n\u001b[?2004l\r"]
[517.711002, "o", "\u001b[?2004h> "]
[517.711081, "o", "    torch.manual_seed(100 + trial)\r\n\u001b[?2004l\r"]
[517.711101, "o", "\u001b[?2004h> "]
[517.711209, "o", "    x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[517.711239, "o", "\u001b[?2004h> "]
[517.711291, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r"]
[517.711321, "o", "\u001b[?2004h> "]
[517.711388, "o", "        o1 = ref(x); o2 = new(x)\r\n\u001b[?2004l\r"]
[517.711407, "o", "\u001b[?2004h> "]
[517.711496, "o", "    md = (o1 - o2).abs().max().item()\r\n\u001b[?2004l\r"]
[517.711527, "o", "\u001b[?2004h> "]
[517.711638, "o", "    ok = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[517.711658, "o", "\u001b[?2004h> "]
[517.711724, "o", "    ok_all = ok_all and ok\r\n\u001b[?2004l\r"]
[517.711755, "o", "\u001b[?2004h> "]
[517.711882, "o", "    print(f'trial {trial}: max_diff={md:.3e} allclose={ok}')\r\n\u001b[?2004l\r"]
[517.711912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[517.711942, "o", "\u001b[?2004h> "]
[517.712025, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[517.712049, "o", "\u001b[?2004h> "]
[517.712107, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[517.712128, "o", "\u001b[?2004h> "]
[517.712191, "o", "    t_new = timeit(new, x)\r\n\u001b[?2004l\r"]
[517.712222, "o", "\u001b[?2004h> "]
[517.712324, "o", "print(f'new: {t_new:.3f} ms  (all ok: {ok_all})')\r\n\u001b[?2004l\r"]
[517.712353, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[517.7133, "o", "\u001b[?2004hroot@modal:/workspace# "]
[517.713814, "o", "gpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/sol_v2.py /workspace/sol_v2.py && gpu push sb-ins49HDnKyysW9SUxtfB1d /workspace/test_v2.py /workspace/test_v2.py && gpu exec sb-ins49HDnKyysW9SUxtfB1d -- python3 /workspace/test_v2.py\r\n\u001b[?2004l\r"]
[520.063114, "o", "{\r\n  \"bytes\": 4541,\r\n  \"sha256\": \"fff23e2a4b0e1f45ee1ce8a73d5e46df1337c40897cee07268c3a7a282247a77\"\r\n}\r\n"]
[521.872248, "o", "{\r\n  \"bytes\": 1280,\r\n  \"sha256\": \"c717f5c17ebb59b4d8634ca334273fac0a4ffd91473fcc91377872205db6b412\"\r\n}\r\n"]
