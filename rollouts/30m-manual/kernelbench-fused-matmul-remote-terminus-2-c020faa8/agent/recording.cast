[1367.521495, "o", "\u001b[?2004h> "]
[1367.521599, "o", "    if not _alloc_set:\r\n\u001b[?2004l\r"]
[1367.521619, "o", "\u001b[?2004h"]
[1367.521639, "o", "> "]
[1367.521798, "o", "        def alloc(size, align, stream):\r\n\u001b[?2004l\r"]
[1367.521819, "o", "\u001b[?2004h"]
[1367.52185, "o", "> "]
[1367.522174, "o", "            return torch.empty(size, dtype=torch.int8, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.522199, "o", "> "]
[1367.522348, "o", "        triton.set_allocator(alloc)\r\n\u001b[?2004l\r"]
[1367.522372, "o", "\u001b[?2004h> "]
[1367.522485, "o", "        _alloc_set = True\r\n\u001b[?2004l\r"]
[1367.522504, "o", "\u001b[?2004h"]
[1367.522525, "o", "> \r\n\u001b[?2004l\rh"]
[1367.522553, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r."]
[1367.522573, "o", "\u001b[?2004h> "]
[1367.522633, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1367.522654, "o", "\u001b[?2004h"]
[1367.522675, "o", "> "]
[1367.522977, "o", "def _split_kernel(x_ptr, hi_ptr, lo_ptr, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1367.523009, "o", "\u001b[?2004h> "]
[1367.523134, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1367.523157, "o", "\u001b[?2004h> "]
[1367.523334, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1367.523356, "o", "\u001b[?2004h> "]
[1367.523453, "o", "    m = offs < numel\r\n\u001b[?2004l\ri"]
[1367.523474, "o", "\u001b[?2004h> "]
[1367.523629, "o", "    v = tl.load(x_ptr + offs, mask=m)\r\n\u001b[?2004l\r"]
[1367.52365, "o", "\u001b[?2004h> "]
[1367.523767, "o", "    hi = v.to(tl.float16)\r\n\u001b[?2004l\r"]
[1367.523787, "o", "\u001b[?2004h"]
[1367.523816, "o", "> "]
[1367.523993, "o", "    lo = (v - hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1367.524015, "o", "\u001b[?2004h"]
[1367.524036, "o", "> "]
[1367.524186, "o", "    tl.store(hi_ptr + offs, hi, mask=m)\r\n\u001b[?2004l\r"]
[1367.524207, "o", "\u001b[?2004h"]
[1367.524228, "o", "> "]
[1367.524378, "o", "    tl.store(lo_ptr + offs, lo, mask=m)\r\n\u001b[?2004l\r"]
[1367.524399, "o", "\u001b[?2004h"]
[1367.524419, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[1367.524449, "o", "> \r\n\u001b[?2004l\r "]
[1367.524475, "o", "\u001b[?2004h> "]
[1367.524507, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1367.524527, "o", "\u001b[?2004h"]
[1367.524547, "o", "> "]
[1367.524826, "o", "def _gemm_f16x3_ws(ah_ptr, al_ptr, bh_ptr, bl_ptr, c_ptr, Bias, M, N, K,\r\n\u001b[?2004l\r"]
[1367.524855, "o", "\u001b[?2004h> "]
[1367.525023, "o", "                   ALPHA: tl.constexpr,\r\n\u001b[?2004l\r"]
[1367.525054, "o", "\u001b[?2004h> "]
[1367.5254, "o", "                   BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[1367.52543, "o", "\u001b[?2004h> "]
[1367.525698, "o", "                   GROUP_M: tl.constexpr, NUM_SMS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1367.525727, "o", "\u001b[?2004h> "]
[1367.52616, "o", "    desc_ah = tl.make_tensor_descriptor(ah_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r"]
[1367.526184, "o", "\u001b[?2004h"]
[1367.526205, "o", "> "]
[1367.526619, "o", "    desc_al = tl.make_tensor_descriptor(al_ptr, shape=[M, K], strides=[K, 1], block_shape=[BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r"]
[1367.526644, "o", "\u001b[?2004h> "]
[1367.527104, "o", "    desc_bh = tl.make_tensor_descriptor(bh_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r"]
[1367.527128, "o", "\u001b[?2004h> "]
[1367.527417, "o", "    desc_bl = tl.make_tensor_descriptor(bl_ptr, shape=[K, N], strides=[N, 1], block_shape=[BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.527446, "o", "> "]
[1367.527684, "o", "    desc_c = tl.make_tensor_descriptor(c_ptr, shape=[M, N], strides=[N, 1], block_shape=[BLOCK_M, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.527711, "o", "> "]
[1367.527789, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1367.527817, "o", "\u001b[?2004h> "]
[1367.527895, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1367.527918, "o", "\u001b[?2004h> "]
[1367.528003, "o", "    k_tiles = tl.cdiv(K, BLOCK_K)\r\n\u001b[?2004l\r"]
[1367.528027, "o", "\u001b[?2004h> "]
[1367.528111, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r"]
[1367.528132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.528159, "o", "\u001b[?2004h> "]
[1367.52837, "o", "    for tile_id in tl.range(tl.program_id(0), num_tiles, NUM_SMS, warp_specialize=True):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.528399, "o", "> "]
[1367.528496, "o", "        num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[1367.528518, "o", "\u001b[?2004h> "]
[1367.52863, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[1367.528655, "o", "\u001b[?2004h> "]
[1367.528744, "o", "        first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[1367.528764, "o", "\u001b[?2004h> "]
[1367.528907, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[1367.528929, "o", "\u001b[?2004h> "]
[1367.529076, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[1367.529095, "o", "\u001b[?2004h> "]
[1367.529238, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1367.529259, "o", "\u001b[?2004h> "]
[1367.529346, "o", "        offs_am = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[1367.529374, "o", "\u001b[?2004h> "]
[1367.529452, "o", "        offs_bn = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[1367.529472, "o", "\u001b[?2004h> "]
[1367.529621, "o", "        acc0 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1367.529641, "o", "\u001b[?2004h> "]
[1367.52979, "o", "        acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1367.529811, "o", "\u001b[?2004h> "]
[1367.52991, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[1367.52994, "o", "\u001b[?2004h> "]
[1367.53002, "o", "            offs_k = ki * BLOCK_K\r\n\u001b[?2004l\r"]
[1367.530041, "o", "\u001b[?2004h> "]
[1367.530165, "o", "            ah = desc_ah.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[1367.530185, "o", "\u001b[?2004h> "]
[1367.530302, "o", "            al = desc_al.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[1367.530323, "o", "\u001b[?2004h> "]
[1367.530439, "o", "            bh = desc_bh.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1367.53046, "o", "\u001b[?2004h> "]
[1367.530571, "o", "            bl = desc_bl.load([offs_k, offs_bn])\r\n\u001b[?2004l\r"]
[1367.530591, "o", "\u001b[?2004h> "]
[1367.530687, "o", "            acc0 = tl.dot(ah, bh, acc0)\r\n\u001b[?2004l\r"]
[1367.530707, "o", "\u001b[?2004h> "]
[1367.530805, "o", "            acc1 = tl.dot(ah, bl, acc1)\r\n\u001b[?2004l\r"]
[1367.530825, "o", "\u001b[?2004h> "]
[1367.530922, "o", "            acc1 = tl.dot(al, bh, acc1)\r\n\u001b[?2004l\r"]
[1367.530946, "o", "\u001b[?2004h> "]
[1367.531013, "o", "        acc = acc0 + acc1\r\n\u001b[?2004l\r"]
[1367.531032, "o", "\u001b[?2004h> "]
[1367.531238, "o", "        bias = tl.load(Bias + pid_n * BLOCK_N + tl.arange(0, BLOCK_N)).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.531266, "o", "> "]
[1367.531374, "o", "        acc = acc * ALPHA + (ALPHA * bias)[None, :]\r\n\u001b[?2004l\r"]
[1367.531398, "o", "\u001b[?2004h> "]
[1367.531504, "o", "        desc_c.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r"]
[1367.531524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.531542, "o", "\u001b[?2004h"]
[1367.531572, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.531593, "o", "> "]
[1367.531646, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1367.531666, "o", "\u001b[?2004h> "]
[1367.531841, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1367.53192, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1367.53194, "o", "\u001b[?2004h> "]
[1367.532086, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1367.532107, "o", "\u001b[?2004h> "]
[1367.532234, "o", "        self.scaling_factor = float(scaling_factor)\r\n\u001b[?2004l\r"]
[1367.532253, "o", "\u001b[?2004h> "]
[1367.53237, "o", "        self._alpha = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[1367.53239, "o", "\u001b[?2004h> "]
[1367.532448, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[1367.532478, "o", "\u001b[?2004h> "]
[1367.532528, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[1367.532548, "o", "\u001b[?2004h> "]
[1367.532625, "o", "        self._cache_key = None\r\n\u001b[?2004l\r"]
[1367.532656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.532686, "o", "\u001b[?2004h> "]
[1367.53275, "o", "    def _get_wsplits(self, w):\r\n\u001b[?2004l\r"]
[1367.53277, "o", "\u001b[?2004h> "]
[1367.532913, "o", "        key = (w.device, w.dtype, w.data_ptr(), w._version)\r\n\u001b[?2004l\r"]
[1367.532933, "o", "\u001b[?2004h> "]
[1367.533027, "o", "        if self._cache_key != key:\r\n\u001b[?2004l\r"]
[1367.533048, "o", "\u001b[?2004h> "]
[1367.533135, "o", "            wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[1367.533156, "o", "\u001b[?2004h> "]
[1367.533248, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[1367.533269, "o", "\u001b[?2004h> "]
[1367.533413, "o", "            wl = (wt - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[1367.533434, "o", "\u001b[?2004h> "]
[1367.533529, "o", "            self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[1367.53355, "o", "\u001b[?2004h> "]
[1367.533642, "o", "            self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[1367.533663, "o", "\u001b[?2004h> "]
[1367.533745, "o", "            self._cache_key = key\r\n\u001b[?2004l\r"]
[1367.533764, "o", "\u001b[?2004h> "]
[1367.533848, "o", "        return self._wh, self._wl\r\n\u001b[?2004l\r"]
[1367.533869, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1367.533897, "o", "\u001b[?2004h"]
[1367.533909, "o", "> "]
[1367.533971, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1367.533999, "o", "\u001b[?2004h> "]
[1367.534078, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[1367.534098, "o", "\u001b[?2004h> "]
[1367.534169, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[1367.53419, "o", "\u001b[?2004h> "]
[1367.53435, "o", "        if (x.is_cuda and x.dtype == torch.float32 and x.dim() == 2\r\n\u001b[?2004l\r"]
[1367.534371, "o", "\u001b[?2004h> "]
[1367.53451, "o", "                and x.stride(1) == 1 and w.stride(1) == 1):\r\n\u001b[?2004l\r"]
[1367.534543, "o", "\u001b[?2004h> "]
[1367.534597, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[1367.534618, "o", "\u001b[?2004h> "]
[1367.534685, "o", "            N = w.shape[0]\r\n\u001b[?2004l\r"]
[1367.534706, "o", "\u001b[?2004h> "]
[1367.534894, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 64 == 0 and K == w.shape[1]:\r\n\u001b[?2004l\r"]
[1367.534915, "o", "\u001b[?2004h> "]
[1367.535003, "o", "                _ensure_alloc()\r\n\u001b[?2004l\r"]
[1367.535022, "o", "\u001b[?2004h> "]
[1367.535133, "o", "                wh, wl = self._get_wsplits(w)\r\n\u001b[?2004l\r"]
[1367.535154, "o", "\u001b[?2004h> "]
[1367.535336, "o", "                xh = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1367.535356, "o", "\u001b[?2004h> "]
[1367.53554, "o", "                xl = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1367.535571, "o", "\u001b[?2004h> "]
[1367.535646, "o", "                numel = x.numel()\r\n\u001b[?2004l\r"]
[1367.535676, "o", "\u001b[?2004h> "]
[1367.535919, "o", "                _split_kernel[(triton.cdiv(numel, 16384),)](x, xh, xl, numel, BLOCK=16384, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.535949, "o", "> "]
[1367.536131, "o", "                out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1367.536162, "o", "> "]
[1367.536356, "o", "                num_sms = torch.cuda.get_device_properties(x.device).multi_processor_count\r\n\u001b[?2004l\r"]
[1367.536377, "o", "\u001b[?2004h> "]
[1367.536494, "o", "                BM, BN, BK, GM = 128, 128, 64, 4\r\n\u001b[?2004l\r"]
[1367.536514, "o", "\u001b[?2004h> "]
[1367.536696, "o", "                grid = (min(num_sms, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r"]
[1367.536716, "o", "\u001b[?2004h> "]
[1367.536878, "o", "                _gemm_f16x3_ws[grid](xh, xl, wh, wl, out, b, M, N, K,\r\n\u001b[?2004l\r"]
[1367.5369, "o", "\u001b[?2004h> "]
[1367.537049, "o", "                                     ALPHA=self._alpha,\r\n\u001b[?2004l\r"]
[1367.537067, "o", "\u001b[?2004h> "]
[1367.537241, "o", "                                     BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK,\r\n\u001b[?2004l\r"]
[1367.537262, "o", "\u001b[?2004h> "]
[1367.537418, "o", "                                     GROUP_M=GM, NUM_SMS=num_sms,\r\n\u001b[?2004l\r"]
[1367.537438, "o", "\u001b[?2004h> "]
[1367.537589, "o", "                                     num_warps=4, num_stages=2)\r\n\u001b[?2004l\r"]
[1367.53761, "o", "\u001b[?2004h> "]
[1367.53768, "o", "                return out\r\n\u001b[?2004l\r"]
[1367.537701, "o", "\u001b[?2004h> "]
[1367.537843, "o", "        return torch.addmm(b, x, w.t(), alpha=self._alpha)\r\n\u001b[?2004l\r"]
[1367.537874, "o", "\u001b[?2004h> "]
[1367.537905, "o", "EOF\r\n\u001b[?2004l\r"]
[1367.539244, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1367.539516, "o", "sed 's/from sol_v3 import ModelNew/from solution import ModelNew/' /workspace/test_v3.py > /workspace/test_sol.py\r\n\u001b[?2004l\r"]
[1367.541027, "o", "\u001b[?2004hroot@modal:/workspace# "]
