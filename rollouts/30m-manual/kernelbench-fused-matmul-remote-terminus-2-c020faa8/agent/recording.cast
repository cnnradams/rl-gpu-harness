[1726.298178, "o", "        _gemm_f16x3_ws[grid](xh, xl, wh, wl, out, b, M, N, K, ALPHA=1.5,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1726.298223, "o", "> "]
