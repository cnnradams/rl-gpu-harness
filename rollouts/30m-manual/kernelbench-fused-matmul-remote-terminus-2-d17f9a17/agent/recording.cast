[1225.060496, "o", "                        out.stride(0), out.stride(1), SCALE=1.5, BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8,\r\n\u001b[?2004l\r"]
[1225.060535, "o", "\u001b[?2004h> "]
[1225.060572, "o", "                        num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h"]
