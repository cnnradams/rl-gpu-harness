[674.649695, "o", "triton fp16 1dot: 0.9076043100661884\r\nbest cfg fp16: BLOCK_M: 128, BLOCK_N: 256, BLOCK_K: 64, GROUP_M: 8, num_warps: 8, num_ctas: 1, num_stages: 3, maxnreg: None\r\ntriton fp16 x3 : 2.2917264189038957\r\nbest cfg x3: BLOCK_M: 128, BLOCK_N: 256, BLOCK_K: 64, GROUP_M: 8, num_warps: 8, num_ctas: 1, num_stages: 3, maxnreg: None\r\n"]
[674.798743, "o", "\u001b[?2004hroot@modal:/workspace# "]
[730.006872, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\nM, K, N = 16384, 4096, 4096\n\ndef cfgs():\n    out = []\n    for bm, bn, bk, w, s in [\n        (128,256,64,8,3),(128,128,64,8,4),(256,128,64,8,3),(128,256,128,8,3),(256,256,64,8,3),\n    ]:\n        out.append(triton.Config({'BLOCK_M':bm,'BLOCK_N':bn,'BLOCK_K':bk,'GROUP_M':8}, num_warps=w, num_stages=s))\n    return out\n\n@triton.autotune(configs=cfgs(), key=['M','N','K'])\n@triton.jit\ndef k_tma(a_desc, b_desc, c_desc, M, N, K,\n          BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOC"]
[730.006929, "i", "K_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, K, BLOCK_K):\n        a = a_desc.load([off_m, k])\n        b = b_desc.load([k, off_n])\n        acc = tl.dot(a, b, acc)\n    c_desc.store([off_m, off_n], acc)\n\nxh = torch.rand(M, K, device='cuda').half()\nwtc = torch.rand(K, N, device='cuda').half()\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\ndef run_tma(meta_cfg=None):\n    cfg = k_tma.best_config\n    BM, BN, BK = cfg.kwargs['BLOCK_M'], cfg.kwargs['BLOCK_N'], cfg.kwargs['BLOCK_K']\n    da = TensorDescriptor(xh, xh.shape, xh.stride(), [BM, BK])\n    db = TensorDescriptor(wtc, wtc.shape, wtc.stride(), [BK, BN])\n    dc = TensorDescriptor(out, out.shape, out.stride(), [BM, BN])\n    grid = (triton.cdiv(M, BM)*triton.cdiv(N, BN),)\n    k_tma[grid](da, db, dc, M, N, K)\n\n# warmup autotune with generic grid first\nda = TensorDescriptor(xh, xh.shape, xh.stride(), [128, 64])\ndb = TensorDescriptor(wtc, wtc.shape, wtc.stride(), [64, 256])\ndc = TensorDescriptor(out, out.shape, out.st"]
[730.007059, "i", "ride(), [128, 256])\ngrid = lambda meta: (triton.cdiv(M, meta['BLOCK_M'])*triton.cdiv(N, meta['BLOCK_N']),)\nk_tma[grid](da, db, dc, M, N, K)\nprint('autotune done, best:', k_tma.best_config)\n\n# descriptors are config-dependent; time with best config descriptors\nbest = k_tma.best_config\nBM, BN, BK = best.kwargs['BLOCK_M'], best.kwargs['BLOCK_N'], best.kwargs['BLOCK_K']\ndescs = (\n    TensorDescriptor(xh, xh.shape, xh.stride(), [BM, BK]),\n    TensorDescriptor(wtc, wtc.shape, wtc.stride(), [BK, BN]),\n    TensorDescriptor(out, out.shape, out.stride(), [BM, BN]),\n)\ngrid2 = (triton.cdiv(M, BM)*triton.cdiv(N, BN),)\n\ndef run2():\n    k_tma.run(grid2[0], 1, 1, descs[0], descs[1], descs[2], M, N, K, *[], **best.kwargs, warmup=False)\n    \ndef run3():\n    k_tma[grid2](descs[0], descs[1], descs[2], M, N, K, BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8, num_warps=best.num_warps, num_stages=best.num_stages)\n\nprint('tma fp16 1dot:', triton.testing.do_bench(run3, warmup=25, rep=200))\nEOF\n"]
