[884.588306, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.588386, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[884.588426, "o", "\u001b[?2004h> "]
[884.588466, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[884.588504, "o", "> "]
[884.588544, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.588583, "o", "    off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.588623, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
