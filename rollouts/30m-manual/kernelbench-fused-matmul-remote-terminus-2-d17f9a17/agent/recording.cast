[1681.632347, "i", "cat > /workspace/stress.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\nimport importlib.util\n\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod.ModelNew\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ninit = get_init_inputs()\nset_seed(42)\nref = Model(*init).cuda()\n\ntorch.manual_seed(42)\ntrial_seeds = [torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(25)]\n\nfor path, name in [('/workspace/solution.py', 'cur'), ('/workspace/solution2.py', 'two')]:\n    try:\n        M2 = load(path, name)\n    except Exception as e:\n        print(name, 'load fail', e)\n        continue\n    set_seed(42)\n    new = M2(*init).cuda()\n    worst = 0.0; worst_ratio = 0.0\n    for s in trial_seeds:\n        set_seed(s)\n        x = torch.rand(16384, 4096).cuda()\n        with torch.no_grad():\n            o1 = ref(x)\n  "]
[1681.632493, "i", "          o2 = new(x)\n        d = (o1 - o2).abs()\n        thr = 1e-4 + 1e-4 * o1.abs()\n        ratio = (d / thr).max().item()\n        worst = max(worst, d.max().item())\n        worst_ratio = max(worst_ratio, ratio)\n    print(f'{name}: 25 trials worst_absdiff={worst:.3e} worst_ratio_vs_threshold={worst_ratio:.3f} ({\"PASS\" if worst_ratio < 1 else \"FAIL\"})')\nEOF\n"]
