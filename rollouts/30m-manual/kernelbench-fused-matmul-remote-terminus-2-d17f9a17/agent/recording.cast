[1401.066442, "o", "/usr/local/cuda/bin/nvcc\r\n\r\ncublas tf32 mm: 1.5586520684392828\r\ncublas fp32 mm: 10.824264844258627\r\ncublas fp16 mm: 0.6874365678855351\r\nREG 256x128x64 w8 s2: 3.4416 ms\r\nREG 256x128x32 w8 s4: 2.6596 ms\r\nREG 128x256x32 w8 s3: 2.7692 ms\r\nREG 256x128x64 w4 s2: 21.5718 ms\r\nREG 128x128x64 w8 s4: 3.0628 ms\r\n"]
