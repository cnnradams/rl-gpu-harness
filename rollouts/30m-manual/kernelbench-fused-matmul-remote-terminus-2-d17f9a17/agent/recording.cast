[1225.059895, "o", "\u001b[?2004h> "]
[1225.059948, "o", "        print(f'TMA {BM}x{BN}x{BK} w{w} s{s}: {ms:.4f} ms err={err:.2e}')\r\n\u001b[?2004l\r"]
[1225.059987, "o", "\u001b[?2004h> "]
[1225.060023, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
