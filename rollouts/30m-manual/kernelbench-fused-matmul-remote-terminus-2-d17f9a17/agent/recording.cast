[1681.633466, "o", "> "]
[1681.63349, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.633588, "o", "trial_seeds = [torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(25)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.633618, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.633715, "o", "for path, name in [('/workspace/solution.py', 'cur'), ('/workspace/solution2.py', 'two')]:\r\n\u001b[?2004l\r"]
[1681.63375, "o", "\u001b[?2004h> "]
[1681.633776, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.633813, "o", "        M2 = load(path, name)\r\n\u001b[?2004l\r"]
[1681.633842, "o", "\u001b[?2004h> "]
[1681.633871, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1681.633899, "o", "> "]
[1681.633926, "o", "        print(name, 'load fail', e)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1681.633955, "o", "> "]
[1681.633991, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.634012, "o", "    set_seed(42)\r\n"]
[1681.634042, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1681.634074, "o", "    new = M2(*init).cuda()\r\n\u001b[?2004l\r"]
[1681.634103, "o", "\u001b[?2004h> "]
[1681.634138, "o", "    worst = 0.0; worst_ratio = 0.0\r\n\u001b[?2004l\r"]
[1681.634165, "o", "\u001b[?2004h> "]
[1681.634195, "o", "    for s in trial_seeds:\r\n\u001b[?2004l\r"]
[1681.634224, "o", "\u001b[?2004h> "]
[1681.634253, "o", "        set_seed(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.634307, "o", "        x = torch.rand(16384, 4096).cuda()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1681.634336, "o", "> "]
[1681.634369, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1681.634394, "o", ">             o1 = ref(x)\r\n\u001b[?2004l\r"]
[1681.634419, "o", "\u001b[?2004h> "]
[1681.634451, "o", "            o2 = new(x)\r\n\u001b[?2004l\r"]
[1681.634475, "o", "\u001b[?2004h> "]
[1681.634509, "o", "        d = (o1 - o2).abs()\r\n\u001b[?2004l\r"]
[1681.63453, "o", "\u001b[?2004h> "]
[1681.634576, "o", "        thr = 1e-4 + 1e-4 * o1.abs()\r\n\u001b[?2004l\r"]
[1681.634599, "o", "\u001b[?2004h> "]
[1681.634642, "o", "        ratio = (d / thr).max().item()\r\n\u001b[?2004l\r"]
[1681.634673, "o", "\u001b[?2004h> "]
[1681.634713, "o", "        worst = max(worst, d.max().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[1681.634741, "o", "> "]
[1681.634789, "o", "        worst_ratio = max(worst_ratio, ratio)\r\n\u001b[?2004l\r"]
[1681.634817, "o", "\u001b[?2004h> "]
[1681.634979, "o", "    print(f'{name}: 25 trials worst_absdiff={worst:.3e} worst_ratio_vs_threshold={worst_ratio:.3f} ({\"PASS\" if worst_ratio < 1 else \"FAIL\"})')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1681.635012, "o", "EOF\r\n\u001b[?2004l\r"]
[1681.635989, "o", "\u001b[?2004hroot@modal:/workspace# "]
