[1555.968036, "o", "\u001b[?2004h> "]
[1555.968063, "o", "    rk = tl.arange(0, BLOCK_K)\r\n"]
[1555.968089, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1555.968145, "o", "    a_ptrs = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1555.968174, "o", "\u001b[?2004h> "]
[1555.968225, "o", "    bh_ptrs = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1555.96825, "o", "\u001b[?2004h> "]
[1555.968304, "o", "    bl_ptrs = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1555.968329, "o", "\u001b[?2004h> "]
[1555.968387, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1555.968417, "o", "\u001b[?2004h> "]
[1555.968457, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.968481, "o", "> "]
[1555.96851, "o", "        if EVEN_MN and EVEN_K:\r\n\u001b[?2004l\r"]
[1555.968538, "o", "\u001b[?2004h> "]
[1555.968565, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[1555.968595, "o", "\u001b[?2004h> "]
[1555.968619, "o", "            bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r"]
[1555.968645, "o", "\u001b[?2004h> "]
[1555.968678, "o", "            bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r"]
[1555.968701, "o", "\u001b[?2004h> "]
[1555.968725, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.968768, "o", "            k_rem = K - k * BLOCK_K\r\n\u001b[?2004l\r"]
[1555.968795, "o", "\u001b[?2004h> "]
[1555.968855, "o", "            amask = (rm[:, None] < M) & (rk[None, :] < k_rem)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.968883, "o", "> "]
[1555.968937, "o", "            bmask = (rk[:, None] < k_rem) & (rn[None, :] < N)\r\n\u001b[?2004l\r"]
[1555.968971, "o", "\u001b[?2004h> "]
[1555.96902, "o", "            a = tl.load(a_ptrs, mask=amask, other=0.0)\r\n\u001b[?2004l\r"]
[1555.96905, "o", "\u001b[?2004h> "]
[1555.969101, "o", "            bh = tl.load(bh_ptrs, mask=bmask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.969127, "o", "> "]
[1555.96918, "o", "            bl = tl.load(bl_ptrs, mask=bmask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.969212, "o", "> "]
[1555.969239, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.969265, "o", "> "]
[1555.969305, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1555.969329, "o", "\u001b[?2004h> "]
[1555.969362, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.969388, "o", "> "]
[1555.969414, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[1555.969444, "o", "\u001b[?2004h> "]
[1555.969475, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.969507, "o", "> "]
[1555.969534, "o", "        a_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.969559, "o", "> "]
[1555.96959, "o", "        bh_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.969635, "o", "        bl_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[1555.969662, "o", "\u001b[?2004h> "]
[1555.96969, "o", "    if EVEN_MN:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.969733, "o", "        bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[1555.969758, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[1555.969785, "o", "\u001b[?2004h> "]
[1555.970047, "o", "        bias = tl.load(Bias + rn, mask=rn < N, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h>     acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r\u001b[?2004h>     c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r\u001b[?2004h>     if EVEN_MN:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.970079, "o", "        tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.970101, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.970186, "o", "        tl.store(c_ptrs, acc, mask=(rm[:, None] < M) & (rn[None, :] < N))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.970216, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1555.970242, "o", "\u001b[?2004h> "]
[1555.970267, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1555.970282, "o", "\u001b[?2004h> "]
[1555.970367, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.970397, "o", "> "]
[1555.970423, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.97049, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1555.970516, "o", "\u001b[?2004h> "]
[1555.97056, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1555.970589, "o", "\u001b[?2004h> "]
[1555.970613, "o", "        self._wh = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.970647, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[1555.97068, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.970709, "o", "    def _prep(self, w):\r\n\u001b[?2004l\r"]
[1555.970734, "o", "\u001b[?2004h> "]
[1555.970772, "o", "        wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[1555.970797, "o", "\u001b[?2004h> "]
[1555.970822, "o", "        wh = wt.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.970875, "o", "        wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.970905, "o", "> "]
[1555.970928, "o", "        self._wh, self._wl = wh, wl\r\n\u001b[?2004l\r"]
[1555.970964, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.971002, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1555.971029, "o", "\u001b[?2004h> "]
[1555.971057, "o", "        if not x.is_cuda:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.971087, "o", "> "]
[1555.971117, "o", "            m = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.971177, "o", "            return m * (self.scaling_factor + 1.0)\r\n\u001b[?2004l\r"]
[1555.971207, "o", "\u001b[?2004h> "]
[1555.971235, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.971259, "o", "> "]
[1555.971349, "o", "        if self._wh is None or self._wh.device != w.device or self._wh.dtype != torch.float16:\r\n\u001b[?2004l\r"]
[1555.971375, "o", "\u001b[?2004h> "]
[1555.971402, "o", "            self._prep(w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.97145, "o", "        wh, wl = self._wh, self._wl\r\n\u001b[?2004l\r"]
[1555.97148, "o", "\u001b[?2004h> "]
[1555.971509, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.971534, "o", "> "]
[1555.971558, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.971602, "o", "        if x.dtype != torch.float32:\r\n\u001b[?2004l\r"]
[1555.971631, "o", "\u001b[?2004h> "]
[1555.971662, "o", "            x = x.float()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1555.971697, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.971725, "o", "> "]
[1555.971749, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.971773, "o", "> "]
[1555.971845, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1555.971873, "o", "\u001b[?2004h> "]
[1555.97191, "o", "        BM, BN, BK, GM = 256, 128, 32, 8\r\n\u001b[?2004l\r"]
[1555.971938, "o", "\u001b[?2004h> "]
[1555.971986, "o", "        even_mn = (M % BM == 0) and (N % BN == 0)\r\n\u001b[?2004l\r"]
[1555.972011, "o", "\u001b[?2004h> "]
[1555.972041, "o", "        even_k = (K % BK == 0)\r\n\u001b[?2004l\r"]
[1555.972071, "o", "\u001b[?2004h> "]
[1555.972124, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1555.972151, "o", "\u001b[?2004h> "]
[1555.972175, "o", "        _linear_scale_x3[grid](\r\n\u001b[?2004l\r"]
[1555.972202, "o", "\u001b[?2004h> "]
[1555.972241, "o", "            x, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[1555.972266, "o", "\u001b[?2004h> "]
[1555.97233, "o", "            x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.972363, "o", "> "]
[1555.972388, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[1555.972418, "o", "\u001b[?2004h> "]
[1555.972469, "o", "            SCALE=float(self.scaling_factor) + 1.0,\r\n\u001b[?2004l\r"]
[1555.972496, "o", "\u001b[?2004h> "]
[1555.972552, "o", "            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.97258, "o", "> "]
[1555.972617, "o", "            EVEN_MN=even_mn, EVEN_K=even_k,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1555.972644, "o", "> "]
[1555.972678, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[1555.972705, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[1555.972738, "o", "\u001b[?2004h> "]
[1555.972769, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1555.974136, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1555.974238, "o", "python3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[1555.988596, "o", "ok\r\n"]
