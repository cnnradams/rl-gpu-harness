[1133.3642, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\ntry:\n    from triton.tools.tensor_descriptor import TensorDescriptor\n    _HAS_TMA = True\nexcept Exception:\n    _HAS_TMA = False\n\n_BM, _BN, _BK, _GM, _WARPS, _STAGES = 128, 256, 64, 8, 8, 3\n\n\n@triton.jit\ndef _k_tma(a_desc, bh_desc, bl_desc, Bias, C, M, N, K,\n           sam, scm, scn,\n           SCALE: tl.constexpr,\n           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n           GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, K, BLOCK_K):\n        a = a_desc.l"]
[1133.364357, "i", "oad([off_m, k])\n        bh = bh_desc.load([k, off_n])\n        bl = bl_desc.load([k, off_n])\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah, bh, acc, out_dtype=tl.float32)\n        acc = tl.dot(ah, bl, acc, out_dtype=tl.float32)\n        acc = tl.dot(al, bh, acc, out_dtype=tl.float32)\n    rn = off_n + tl.arange(0, BLOCK_N)\n    rm = off_m + tl.arange(0, BLOCK_M)\n    bias = tl.load(Bias + rn)\n    acc = (acc + bias[None, :]) * SCALE\n    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc)\n\n\n@triton.jit\ndef _k_reg(A, BH, BL, Bias, C, M, N, K,\n           sam, sak, sbk, sbn, scm, scn,\n           SCALE: tl.constexpr,\n           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n           GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROU"]
