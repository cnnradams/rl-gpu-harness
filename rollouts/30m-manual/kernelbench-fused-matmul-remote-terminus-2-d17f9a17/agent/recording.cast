[806.537195, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\nM, K, N = 16384, 4096, 4096\n\n@triton.jit\ndef k_tma(a_desc, b_desc, c_desc, M, N, K,\n          BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, K, BLOCK_K):\n        a = a_desc.load([off_m, k])\n        b = b_desc.load([k, off_n])\n        acc = tl.dot(a, b, acc)\n    c_desc.store([off_m, off_n], acc)\n\nxh = torch.rand(M, K, device='cuda').half()\nwtc = torch.rand(K, N, device='cuda').half()\nout = torch."]
[806.537381, "i", "empty(M, N, device='cuda', dtype=torch.float32)\n\nfor BM, BN, BK, w, s in [(128,256,64,8,3),(128,128,64,8,4),(256,128,64,8,3),(128,256,128,8,3),(128,128,128,8,4)]:\n    try:\n        da = TensorDescriptor(xh, xh.shape, xh.stride(), [BM, BK])\n        db = TensorDescriptor(wtc, wtc.shape, wtc.stride(), [BK, BN])\n        dc = TensorDescriptor(out, out.shape, out.stride(), [BM, BN])\n        grid = (triton.cdiv(M, BM)*triton.cdiv(N, BN),)\n        def run():\n            k_tma[grid](da, db, dc, M, N, K, BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8, num_warps=w, num_stages=s)\n        ms = triton.testing.do_bench(run, warmup=25, rep=200)\n        print(f'TMA {BM}x{BN}x{BK} w{w} s{s}: {ms:.4f} ms')\n    except Exception as e:\n        print(f'{BM}x{BN}x{BK} w{w} s{s}: FAIL {str(e)[:100]}')\nEOF\n"]
[806.537419, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.537459, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[806.537491, "o", "> "]
[806.537811, "o", "from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r\u001b[?2004h> M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def k_tma(a_desc, b_desc, c_desc, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h>           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[806.537829, "o", "\u001b[?2004h> "]
[806.53788, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.537956, "o", "    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538374, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h>     group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h>     pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h>     off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538442, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538489, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538529, "o", "    for k in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538569, "o", "        a = a_desc.load([off_m, k])\r\n\u001b[?2004l\r"]
[806.538609, "o", "\u001b[?2004h> "]
[806.538652, "o", "        b = b_desc.load([k, off_n])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538692, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538744, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[806.538784, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538823, "o", "xh = torch.rand(M, K, device='cuda').half()\r\n\u001b[?2004l\r"]
[806.538864, "o", "\u001b[?2004h> "]
[806.538906, "o", "wtc = torch.rand(K, N, device='cuda').half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.538988, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[806.539003, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[806.539146, "o", "for BM, BN, BK, w, s in [(128,256,64,8,3),(128,128,64,8,4),(256,128,64,8,3),(128,256,128,8,3),(128,128,128,8,4)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.539198, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.53926, "o", "        da = TensorDescriptor(xh, xh.shape, xh.stride(), [BM, BK])\r\n\u001b[?2004l\r"]
[806.539298, "o", "\u001b[?2004h> "]
[806.539352, "o", "        db = TensorDescriptor(wtc, wtc.shape, wtc.stride(), [BK, BN])\r\n\u001b[?2004l\r"]
[806.539393, "o", "\u001b[?2004h> "]
[806.539446, "o", "        dc = TensorDescriptor(out, out.shape, out.stride(), [BM, BN])\r\n\u001b[?2004l\r"]
[806.539484, "o", "\u001b[?2004h> "]
[806.539524, "o", "        grid = (triton.cdiv(M, BM)*triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[806.539565, "o", "\u001b[?2004h>         def run():\r\n\u001b[?2004l\r"]
[806.539608, "o", "\u001b[?2004h> "]
[806.539716, "o", "            k_tma[grid](da, db, dc, M, N, K, BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.539794, "o", "        ms = triton.testing.do_bench(run, warmup=25, rep=200)\r\n\u001b[?2004l\r"]
[806.539835, "o", "\u001b[?2004h> "]
[806.539873, "o", "        print(f'TMA {BM}x{BN}x{BK} w{w} s{s}: {ms:.4f} ms')\r\n\u001b[?2004l\r"]
[806.539913, "o", "\u001b[?2004h> "]
[806.539953, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[806.54002, "o", "        print(f'{BM}x{BN}x{BK} w{w} s{s}: FAIL {str(e)[:100]}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[806.540058, "o", "> EOF\r\n\u001b[?2004l\r"]
