[1133.364492, "i", "= tl.load(Bias + rn)\n    acc = (acc + bias[None, :]) * SCALE\n    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._wh = None\n        self._wl = None\n        self._dbh = None\n        self._dbl = None\n        self._use_tma = _HAS_TMA\n\n    def _prep(self, w):\n        wt = w.detach().t().contiguous()\n        wh = wt.half()\n        wl = (wt - wh.float()).half()\n        self._wh, self._wl = wh, wl\n        if self._use_tma:\n            try:\n                self._dbh = TensorDescriptor(wh, wh.shape, wh.stride(), [_BK, _BN])\n                self._dbl = TensorDescriptor(wl, wl.shape, wl.stride(), [_BK, _BN])\n            except Exception:\n                self._use_tma = False\n\n    def forward(self, x):\n        if not x.is_cuda:\n            m = self.matmul(x"]
