[884.58874, "o", "\u001b[?2004h> "]
[884.588779, "o", "    for k in tl.range(0, K, BLOCK_K, warp_specialize=WS):\r\n\u001b[?2004l\r"]
[884.588818, "o", "\u001b[?2004h> "]
