[1157.504175, "o", "\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": false,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"runtime_error\": \"out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\",\r\n    \"runtime_error_name\": \"triton.runtime.errors.OutOfResources\",\r\n    \"runtime_error_traceback\": \"Traceback (most recent call last):\\n  File \\\"/usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\\\", line 782, in run_and_check_correctness\\n    output_new = model_new(*inputs)\\n  File \\\"/usr/local/lib/python3.10/dist-packages/torch/nn/modules/module.py\\\", line 1775, in _wrapped_call_impl\\n    return self._call_impl(*args, **kwargs)\\n  File \\\"/usr/local/lib/python3.10/dist-packages/torch/nn/modules/module.py\\\", line 1786, in _call_impl\\n    return forward_call(*args, **kwargs)\\n  File \\\"/tmp/tmpmxxb7mjg.py\\\", line 137,"]
[1157.504246, "o", " in forward\\n    _k_reg[grid](x, wh, wl, b, out, M, N, K,\\n  File \\\"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\\\", line 419, in <lambda>\\n    return lambda *args, **kwargs: self.run(grid=grid, warmup=False, *args, **kwargs)\\n  File \\\"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\\\", line 756, in run\\n    launch_metadata = kernel.launch_metadata(grid, stream, *bound_args.values())\\n  File \\\"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\\\", line 490, in launch_metadata\\n    self._init_handles()\\n  File \\\"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\\\", line 464, in _init_handles\\n    raise_(OutOfResources(self.metadata.shared, max_shared, \\\"shared memory\\\"))\\n  File \\\"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\\\", line 456, in raise_\\n    raise err\\ntriton.runtime.errors.OutOfResources: out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\\n\"\r\n  }"]
[1157.504258, "o", ",\r\n  \"runtime\": -1.0,\r\n  \"runtime_stats\": {},\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0148,\r\n    \"min\": 11.3,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"359c9fc074e6ef75c06cba3b56c31719d9ec95d9335e41782e94c57de093c090\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 0.0\r\n}\r\n"]
