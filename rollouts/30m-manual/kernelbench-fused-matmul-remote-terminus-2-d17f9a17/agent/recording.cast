[641.658811, "o", "\u001b[?2004h> "]
[641.658854, "o", "    c_ptrs = C + rm[:,None]*scm + rn[None,:]*scn\r\n\u001b[?2004l\r"]
[641.65888, "o", "\u001b[?2004h> "]
[641.658906, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.658934, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.658991, "o", "@triton.autotune(configs=cfgs(), key=['M','N','K'])\r\n\u001b[?2004l\r"]
[641.659019, "o", "\u001b[?2004h> "]
[641.659045, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.659104, "o", "def k_x3(A, BH, BL, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[641.659123, "o", "\u001b[?2004h> "]
[641.659228, "o", "         BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[641.659253, "o", "\u001b[?2004h> "]
[641.65928, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[641.659305, "o", "\u001b[?2004h> "]
[641.659363, "o", "    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[641.659388, "o", "\u001b[?2004h> "]
[641.659416, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[641.659449, "o", "\u001b[?2004h> "]
[641.659474, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.659549, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[641.659575, "o", "\u001b[?2004h> "]
[641.659621, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[641.659647, "o", "\u001b[?2004h> "]
[641.659682, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[641.659707, "o", "\u001b[?2004h> "]
[641.659751, "o", "    rm = pid_m*BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[641.659775, "o", "\u001b[?2004h> "]
[641.659836, "o", "    rn = pid_n*BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.659887, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.65996, "o", "    a_ptrs = A + rm[:,None]*sam + rk[None,:]*sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.660026, "o", "    bh_ptrs = BH + rk[:,None]*sbk + rn[None,:]*sbn\r\n\u001b[?2004l\r"]
[641.660051, "o", "\u001b[?2004h> "]
[641.660093, "o", "    bl_ptrs = BL + rk[:,None]*sbk + rn[None,:]*sbn\r\n\u001b[?2004l\r"]
[641.660119, "o", "\u001b[?2004h> "]
[641.660171, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[641.660195, "o", "\u001b[?2004h> "]
[641.660239, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[641.660263, "o", "\u001b[?2004h> "]
[641.660292, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[641.660317, "o", "\u001b[?2004h> "]
[641.660358, "o", "        bh = tl.load(bh_ptrs); bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r"]
[641.660383, "o", "\u001b[?2004h> "]
[641.66041, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[641.660437, "o", "\u001b[?2004h> "]
[641.660497, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.660523, "o", "> "]
[641.660548, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.660574, "o", "> "]
[641.660602, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[641.660628, "o", "\u001b[?2004h> "]
[641.660653, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[641.660678, "o", "\u001b[?2004h> "]
[641.660749, "o", "        a_ptrs += BLOCK_K*sak; bh_ptrs += BLOCK_K*sbk; bl_ptrs += BLOCK_K*sbk\r\n\u001b[?2004l\r"]
[641.660775, "o", "\u001b[?2004h> "]
[641.66082, "o", "    c_ptrs = C + rm[:,None]*scm + rn[None,:]*scn\r\n\u001b[?2004l\r"]
[641.660845, "o", "\u001b[?2004h> "]
[641.66087, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.660896, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.660964, "o", "xh = torch.rand(M, K, device='cuda').half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.661008, "o", "w = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[641.661033, "o", "\u001b[?2004h> "]
[641.661059, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.661085, "o", "> "]
[641.661119, "o", "wh = wt.half(); wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[641.661148, "o", "\u001b[?2004h> "]
[641.6612, "o", "out = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[641.661225, "o", "\u001b[?2004h> "]
[641.661309, "o", "grid = lambda meta: (triton.cdiv(M, meta['BLOCK_M'])*triton.cdiv(N, meta['BLOCK_N']),)\r\n\u001b[?2004l\r"]
[641.661334, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[641.66136, "o", "\u001b[?2004h> "]
[641.661383, "o", "def run_fp16():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.661551, "o", "    k_fp16[grid](xh, wh, out, M, N, K, xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[641.661583, "o", "\u001b[?2004h> "]
[641.661613, "o", "def run_x3():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.661748, "o", "    k_x3[grid](xh, wh, wl, out, M, N, K, xh.stride(0), xh.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[641.661778, "o", "\u001b[?2004h> "]
[641.661865, "o", "print('triton fp16 1dot:', triton.testing.do_bench(run_fp16, warmup=25, rep=200))\r\n\u001b[?2004l\r"]
[641.661893, "o", "\u001b[?2004h> "]
[641.661933, "o", "print('best cfg fp16:', k_fp16.best_config)\r\n\u001b[?2004l\r"]
[641.66196, "o", "\u001b[?2004h> "]
[641.662043, "o", "print('triton fp16 x3 :', triton.testing.do_bench(run_x3, warmup=25, rep=200))\r\n\u001b[?2004l\r"]
[641.662069, "o", "\u001b[?2004h> "]
[641.662102, "o", "print('best cfg x3:', k_x3.best_config)\r\n\u001b[?2004l\r"]
