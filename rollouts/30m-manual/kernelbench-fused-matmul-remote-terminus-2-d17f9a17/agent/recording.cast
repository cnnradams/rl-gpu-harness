[435.696133, "o", "        triton.Config({'BLOCK_M': 64, 'BLOCK_N': 256, 'BLOCK_K': 64, 'GROUP_M': 8}, num_warps=4, num_stages=4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
