[537.935991, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nprint('triton', triton.__version__, 'torch', torch.__version__)\nM, K, N = 16384, 4096, 4096\nxh = torch.rand(M, K, device='cuda').half()\nwh = torch.rand(N, K, device='cuda').half()\nwtc = wh.t().contiguous()\nx = xh.float()\nprint('raw fp16 linear:', triton.testing.do_bench(lambda: F.linear(xh, wh), warmup=25, rep=200))\nprint('raw fp16 mm kt:', triton.testing.do_bench(lambda: xh @ wtc, warmup=25, rep=200))\nx32 = xh.float(); w32 = wh.float()\nprint('raw fp32 linear:', triton.testing.do_bench(lambda: F.linear(x32, w32), warmup=25, rep=200))\nEOF\n"]
