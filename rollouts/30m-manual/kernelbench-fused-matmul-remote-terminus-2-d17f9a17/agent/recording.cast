[884.588942, "o", "> "]
[884.588982, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.589021, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[884.589039, "o", "\u001b[?2004h"]
