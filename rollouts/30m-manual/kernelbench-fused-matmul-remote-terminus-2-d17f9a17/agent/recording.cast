[1225.057359, "o", "> "]
[1225.057397, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.057445, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1225.05749, "o", "\u001b[?2004h> "]
