[1225.055348, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1225.055387, "o", "\u001b[?2004h> "]
[1225.055428, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.055485, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1225.055526, "o", "\u001b[?2004h>     off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[1225.055566, "o", "\u001b[?2004h> "]
[1225.055605, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r\u001b[?2004h> "]
