[968.181068, "o", "\u001b[?2004h> "]
[968.181096, "o", "           GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[968.181118, "o", "\u001b[?2004h> "]
[968.181147, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[968.181176, "o", "\u001b[?2004h> "]
[968.181204, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.181229, "o", "> "]
[968.181258, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.181283, "o", "> "]
[968.181312, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.181342, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[968.18137, "o", "\u001b[?2004h> "]
[968.181429, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[968.181458, "o", "\u001b[?2004h> "]
[968.181501, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[968.181529, "o", "\u001b[?2004h> "]
[968.181561, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[968.18159, "o", "\u001b[?2004h> "]
[968.181629, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[968.181652, "o", "\u001b[?2004h> "]
[968.181699, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[968.181728, "o", "\u001b[?2004h> "]
[968.181755, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[968.181778, "o", "\u001b[?2004h> "]
[968.181828, "o", "    a_ptrs = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[968.181855, "o", "\u001b[?2004h> "]
[968.181912, "o", "    bh_ptrs = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[968.181941, "o", "\u001b[?2004h> "]
[968.182002, "o", "    bl_ptrs = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.182032, "o", "> "]
[968.182076, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[968.182099, "o", "\u001b[?2004h> "]
[968.18214, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[968.182173, "o", "\u001b[?2004h> "]
[968.182199, "o", "        k_rem = K - k * BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.182278, "o", "        a = tl.load(a_ptrs, mask=(rk[None, :] < k_rem), other=0.0)\r\n\u001b[?2004l\r"]
[968.182305, "o", "\u001b[?2004h> "]
[968.182368, "o", "        bh = tl.load(bh_ptrs, mask=(rk[:, None] < k_rem), other=0.0)\r\n\u001b[?2004l\r"]
[968.182397, "o", "\u001b[?2004h> "]
[968.18246, "o", "        bl = tl.load(bl_ptrs, mask=(rk[:, None] < k_rem), other=0.0)\r\n\u001b[?2004l\r"]
[968.18249, "o", "\u001b[?2004h> "]
[968.182518, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.182548, "o", "> "]
[968.182579, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[968.182607, "o", "\u001b[?2004h> "]
[968.182636, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[968.182664, "o", "\u001b[?2004h> "]
[968.182692, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[968.18272, "o", "\u001b[?2004h> "]
[968.182748, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.182773, "o", "> "]
[968.182797, "o", "        a_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r"]
[968.182822, "o", "\u001b[?2004h> "]
[968.182853, "o", "        bh_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[968.182877, "o", "\u001b[?2004h> "]
[968.182912, "o", "        bl_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[968.182939, "o", "\u001b[?2004h> "]
[968.182964, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.182992, "o", "> "]
[968.183021, "o", "    acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r"]
[968.183045, "o", "\u001b[?2004h> "]
[968.183091, "o", "    c_ptrs = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[968.183116, "o", "\u001b[?2004h> "]
[968.183141, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[968.183161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[968.183186, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.183222, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[968.183247, "o", "\u001b[?2004h> "]
[968.183309, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[968.183334, "o", "\u001b[?2004h> "]
[968.183363, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[968.183392, "o", "\u001b[?2004h> "]
[968.183439, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[968.183467, "o", "\u001b[?2004h> "]
[968.183505, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[968.183533, "o", "\u001b[?2004h> "]
[968.183563, "o", "        self._wh = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.183589, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[968.183617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[968.183646, "o", "> "]
[968.183674, "o", "    def _prep(self, w):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.183709, "o", "        wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[968.183737, "o", "\u001b[?2004h> "]
[968.183766, "o", "        wh = wt.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.183809, "o", "        wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[968.183834, "o", "\u001b[?2004h> "]
[968.183864, "o", "        self._wh, self._wl = wh, wl\r\n\u001b[?2004l\r"]
[968.1839, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.183931, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[968.18396, "o", "\u001b[?2004h> "]
[968.183989, "o", "        if not x.is_cuda:\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.184015, "o", "> "]
[968.184036, "o", "            m = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.184065, "o", "> "]
[968.184098, "o", "            return m * (self.scaling_factor + 1.0)\r\n\u001b[?2004l\r"]
[968.184127, "o", "\u001b[?2004h> "]
[968.184153, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[968.184178, "o", "\u001b[?2004h> "]
[968.184234, "o", "        if self._wh is None or self._wh.device != w.device:\r\n\u001b[?2004l\r"]
[968.184263, "o", "\u001b[?2004h> "]
[968.18429, "o", "            self._prep(w)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.184335, "o", "        wh, wl = self._wh, self._wl\r\n\u001b[?2004l\r"]
[968.184361, "o", "\u001b[?2004h> "]
[968.184385, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[968.18441, "o", "\u001b[?2004h> "]
[968.18444, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[968.184469, "o", "\u001b[?2004h> "]
[968.184495, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.184519, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[968.184549, "o", "> "]
[968.184607, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[968.184637, "o", "\u001b[?2004h> "]
[968.184677, "o", "        scale = float(self.scaling_factor) + 1.0\r\n\u001b[?2004l\r"]
[968.18471, "o", "\u001b[?2004h> "]
[968.184734, "o", "        if _HAS_TMA:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.184839, "o", "            grid = lambda meta: (triton.cdiv(M, meta['BLOCK_M']) * triton.cdiv(N, meta['BLOCK_N']),)\r\n\u001b[?2004l\r"]
[968.184864, "o", "\u001b[?2004h> "]
[968.184936, "o", "            da = TensorDescriptor(x, x.shape, x.stride(), [128, 64])\r\n\u001b[?2004l\r"]
[968.184961, "o", "\u001b[?2004h> "]
[968.185031, "o", "            dbh = TensorDescriptor(wh, wh.shape, wh.stride(), [64, 256])\r\n\u001b[?2004l\r"]
[968.185061, "o", "\u001b[?2004h> "]
[968.185125, "o", "            dbl = TensorDescriptor(wl, wl.shape, wl.stride(), [64, 256])\r\n\u001b[?2004l\r"]
[968.18515, "o", "\u001b[?2004h> "]
[968.185201, "o", "            _k_tma[grid](da, dbh, dbl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[968.18523, "o", "\u001b[?2004h> "]
[968.185305, "o", "                         x.stride(0), out.stride(0), out.stride(1), SCALE=scale)\r\n\u001b[?2004l\r"]
[968.185335, "o", "\u001b[?2004h> "]
[968.185359, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[968.185462, "o", "            grid = lambda meta: (triton.cdiv(M, meta['BLOCK_M']) * triton.cdiv(N, meta['BLOCK_N']),)\r\n\u001b[?2004l\r"]
[968.18549, "o", "\u001b[?2004h> "]
[968.185536, "o", "            _k_reg[grid](x, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[968.185566, "o", "\u001b[?2004h> "]
[968.185637, "o", "                         x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r"]
[968.185664, "o", "\u001b[?2004h> "]
[968.185727, "o", "                         out.stride(0), out.stride(1), SCALE=scale)\r\n\u001b[?2004l\r"]
[968.185758, "o", "\u001b[?2004h> "]
[968.185788, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[968.187178, "o", "\u001b[?2004hroot@modal:/workspace# "]
