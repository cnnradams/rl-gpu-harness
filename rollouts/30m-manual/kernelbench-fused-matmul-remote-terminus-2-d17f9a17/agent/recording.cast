[435.701217, "o", "\u001b[?2004h> "]
[435.701258, "o", "    k_tf32x3[grid](x, wt, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[435.7013, "o", "\u001b[?2004h> "]
[435.701385, "o", "        x.stride(0), x.stride(1), wt.stride(0), wt.stride(1), out.stride(0), out.stride(1), SCALE=1.5)\r\n\u001b[?2004l\r"]
[435.70141, "o", "\u001b[?2004h> "]
[435.701438, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[435.701466, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[435.701494, "o", "for name, fn in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.701553, "o", "    ('linear_fp32', lambda: F.linear(x, w, b)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.701577, "o", "> "]
[435.70164, "o", "    ('ref_full', lambda: (lambda m: m*0.5 + m)(F.linear(x, w, b))),\r\n\u001b[?2004l\r"]
[435.701668, "o", "\u001b[?2004h> "]
[435.70172, "o", "    ('linear_fp16', lambda: F.linear(x.half(), w.half())),\r\n\u001b[?2004l\r"]
[435.701749, "o", "\u001b[?2004h> "]
[435.70178, "o", "    ('presplit', run_presplit),\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.701806, "o", "> "]
[435.701831, "o", "    ('tf32x3', run_tf32x3),\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.701857, "o", "> ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.701927, "o", "    ms = triton.testing.do_bench(fn, warmup=25, rep=200)\r\n\u001b[?2004l\r"]
[435.70196, "o", "\u001b[?2004h>     out = fn()\r\n\u001b[?2004l\r"]
[435.701989, "o", "\u001b[?2004h> "]
[435.702026, "o", "    if out.dtype != torch.float32:\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.702054, "o", "> "]
[435.702078, "o", "        out = out.float()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.702122, "o", "    if out.shape == ref.shape:\r\n\u001b[?2004l\r"]
[435.702146, "o", "\u001b[?2004h> "]
[435.702196, "o", "        diff = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.702221, "o", ">     else:\r\n\u001b[?2004l\r"]
[435.702249, "o", "\u001b[?2004h> "]
[435.702273, "o", "        diff = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[435.702344, "o", "    print(f'{name}: {ms:.4f} ms  maxdiff={diff:.3e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[435.702372, "o", "> EOF\r\n\u001b[?2004l\r"]
