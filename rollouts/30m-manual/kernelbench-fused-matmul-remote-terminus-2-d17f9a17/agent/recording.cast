[1225.054752, "o", "def k_tma(a_desc, bh_desc, bl_desc, Bias, C, M, N, K, sam, scm, scn,\r\n\u001b[?2004l\r"]
[1225.054789, "o", "\u001b[?2004h> "]
[1225.054845, "o", "          SCALE: tl.constexpr,\r\n\u001b[?2004l\r"]
[1225.054888, "o", "\u001b[?2004h> "]
[1225.055012, "o", "          BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1225.055032, "o", "\u001b[?2004h> "]
[1225.055072, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1225.05515, "o", "    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1225.055191, "o", "\u001b[?2004h> "]
