[1133.37289, "o", "\u001b[?2004h> "]
[1133.372912, "o", "        self._wh = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.372937, "o", "> "]
[1133.372958, "o", "        self._wl = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.372979, "o", "> "]
[1133.373008, "o", "        self._dbh = None\r\n\u001b[?2004l\r"]
[1133.373029, "o", "\u001b[?2004h> "]
[1133.373049, "o", "        self._dbl = None\r\n"]
[1133.373073, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1133.373097, "o", "> "]
[1133.373122, "o", "        self._use_tma = _HAS_TMA\r\n\u001b[?2004l\r"]
[1133.373146, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1133.373167, "o", "\u001b[?2004h> "]
[1133.373198, "o", "    def _prep(self, w):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.373219, "o", "> "]
[1133.373254, "o", "        wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[1133.37328, "o", "\u001b[?2004h> "]
[1133.373302, "o", "        wh = wt.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.373323, "o", "> "]
[1133.373362, "o", "        wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[1133.373383, "o", "\u001b[?2004h> "]
[1133.373421, "o", "        self._wh, self._wl = wh, wl\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.373443, "o", "> "]
[1133.373468, "o", "        if self._use_tma:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.373489, "o", "> "]
[1133.373514, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1133.373616, "o", "                self._dbh = TensorDescriptor(wh, wh.shape, wh.stride(), [_BK, _BN])\r\n\u001b[?2004l\r"]
[1133.373652, "o", "\u001b[?2004h> "]
[1133.373731, "o", "                self._dbl = TensorDescriptor(wl, wl.shape, wl.stride(), [_BK, _BN])\r\n\u001b[?2004l\r"]
[1133.373761, "o", "\u001b[?2004h> "]
[1133.373785, "o", "            except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.373807, "o", "> "]
[1133.373845, "o", "                self._use_tma = False\r\n\u001b[?2004l\r"]
[1133.373866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1133.373892, "o", "\u001b[?2004h> "]
[1133.373917, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.37394, "o", "> "]
[1133.37397, "o", "        if not x.is_cuda:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1133.374017, "o", "            m = self.matmul(x)\r\n\u001b[?2004l\r"]
[1133.374038, "o", "\u001b[?2004h> "]
[1133.374089, "o", "            return m * (self.scaling_factor + 1.0)\r\n\u001b[?2004l\r"]
[1133.374115, "o", "\u001b[?2004h> "]
[1133.374137, "o", "        w = self.matmul.weight\r\n"]
[1133.374159, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1133.374229, "o", "        if self._wh is None or self._wh.device != w.device:\r\n\u001b[?2004l\r"]
[1133.37425, "o", "\u001b[?2004h> "]
[1133.374282, "o", "            self._prep(w)\r\n\u001b[?2004l\r"]
[1133.374303, "o", "\u001b[?2004h> "]
[1133.374343, "o", "        wh, wl = self._wh, self._wl\r\n\u001b[?2004l\r"]
[1133.374368, "o", "\u001b[?2004h> "]
[1133.374396, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[1133.37442, "o", "\u001b[?2004h> "]
[1133.374444, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[1133.374467, "o", "\u001b[?2004h> "]
[1133.374489, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[1133.374512, "o", "\u001b[?2004h> "]
[1133.374541, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r"]
[1133.374562, "o", "\u001b[?2004h> "]
[1133.374651, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1133.374714, "o", "        scale = float(self.scaling_factor) + 1.0\r\n\u001b[?2004l\r"]
[1133.374735, "o", "\u001b[?2004h> "]
[1133.374799, "o", "        grid = (triton.cdiv(M, _BM) * triton.cdiv(N, _BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.374822, "o", "> "]
[1133.374854, "o", "        if self._use_tma:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1133.374878, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1133.3749, "o", "> "]
[1133.374976, "o", "                da = TensorDescriptor(x, x.shape, x.stride(), [_BM, _BK])\r\n\u001b[?2004l\r"]
[1133.375001, "o", "\u001b[?2004h> "]
[1133.375076, "o", "                _k_tma[grid](da, self._dbh, self._dbl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[1133.3751, "o", "\u001b[?2004h> "]
[1133.375186, "o", "                             x.stride(0), out.stride(0), out.stride(1), SCALE=scale,\r\n\u001b[?2004l\r"]
[1133.375216, "o", "\u001b[?2004h> "]
[1133.375298, "o", "                             BLOCK_M=_BM, BLOCK_N=_BN, BLOCK_K=_BK, GROUP_M=_GM,\r\n\u001b[?2004l\r"]
[1133.375326, "o", "\u001b[?2004h> "]
[1133.375391, "o", "                             num_warps=_WARPS, num_stages=_STAGES)\r\n\u001b[?2004l\r"]
[1133.375415, "o", "\u001b[?2004h> "]
[1133.375441, "o", "                return out\r\n\u001b[?2004l\r"]
[1133.375461, "o", "\u001b[?2004h> "]
[1133.375497, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[1133.375522, "o", "\u001b[?2004h> "]
[1133.375559, "o", "                self._use_tma = False\r\n\u001b[?2004l\r"]
[1133.37558, "o", "\u001b[?2004h> "]
[1133.375639, "o", "        _k_reg[grid](x, wh, wl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[1133.375662, "o", "\u001b[?2004h> "]
[1133.375742, "o", "                     x.stride(0), x.stride(1), wh.stride(0), wh.stride(1),\r\n\u001b[?2004l\r"]
[1133.375766, "o", "\u001b[?2004h> "]
[1133.375833, "o", "                     out.stride(0), out.stride(1), SCALE=scale,\r\n\u001b[?2004l\r"]
[1133.375855, "o", "\u001b[?2004h> "]
[1133.375932, "o", "                     BLOCK_M=_BM, BLOCK_N=_BN, BLOCK_K=_BK, GROUP_M=_GM,\r\n\u001b[?2004l\r"]
[1133.375952, "o", "\u001b[?2004h> "]
[1133.376017, "o", "                     num_warps=_WARPS, num_stages=_STAGES)\r\n\u001b[?2004l\r"]
[1133.376043, "o", "\u001b[?2004h> "]
[1133.376065, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1133.376087, "o", "EOF\r\n\u001b[?2004l\r"]
