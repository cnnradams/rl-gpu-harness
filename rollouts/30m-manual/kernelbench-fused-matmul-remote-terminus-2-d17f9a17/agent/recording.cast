[884.587358, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\nM, K, N = 16384, 4096, 4096\n\n@triton.jit\ndef k_ws(a_desc, b_desc, c_desc, M, N, K,\n         BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, WS: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in tl.range(0, K, BLOCK_K, warp_specialize=WS):\n        a = a_desc.load([off_m, k])\n        b = b_desc.load([k, off_n])\n        acc = tl.dot(a, b, acc)\n    c_desc.store([off_m, off_n], acc)\n\nxh = torch.rand(M, K, device='cuda').half()\nwtc = torch.rand(K"]
[884.587414, "i", ", N, device='cuda').half()\nout = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\nfor WS in [True, False]:\n    for BM, BN, BK, w, s in [(128,256,64,8,3),(128,256,64,8,4),(256,256,64,8,3),(128,256,64,4,3),(256,128,64,8,4)]:\n        try:\n            da = TensorDescriptor(xh, xh.shape, xh.stride(), [BM, BK])\n            db = TensorDescriptor(wtc, wtc.shape, wtc.stride(), [BK, BN])\n            dc = TensorDescriptor(out, out.shape, out.stride(), [BM, BN])\n            grid = (triton.cdiv(M, BM)*triton.cdiv(N, BN),)\n            def run():\n                k_ws[grid](da, db, dc, M, N, K, BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=8, WS=WS, num_warps=w, num_stages=s)\n            ms = triton.testing.do_bench(run, warmup=25, rep=200)\n            print(f'WS={WS} {BM}x{BN}x{BK} w{w} s{s}: {ms:.4f} ms')\n        except Exception as e:\n            print(f'WS={WS} {BM}x{BN}x{BK} w{w} s{s}: FAIL {str(e)[:80]}')\nEOF\n"]
[884.587576, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.587634, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.587734, "o", "from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.587777, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[884.587811, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.587844, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.587903, "o", "def k_ws(a_desc, b_desc, c_desc, M, N, K,\r\n\u001b[?2004l\r"]
[884.587944, "o", "\u001b[?2004h> "]
[884.588053, "o", "         BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[884.5881, "o", "\u001b[?2004h> "]
[884.588131, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.588197, "o", "    grid_m = tl.cdiv(M, BLOCK_M); grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[884.588232, "o", "\u001b[?2004h> "]
