                self._dbh = TensorDescriptor(wh, wh.shape, wh.stride(), [_BK, _BN])
                self._dbl = TensorDescriptor(wl, wl.shape, wl.stride(), [_BK, _BN])
            except Exception:
                self._use_tma = False

