        self.scaling_factor = scaling_factor
        self._wh = None
        self._wl = None
        self._dbh = None
        self._dbl = None
        self._use_tma = _HAS_TMA

    def _prep(self, w):
        wt = w.detach().t().contiguous()
        wh = wt.half()
        wl = (wt - wh.float()).half()
        self._wh, self._wl = wh, wl
