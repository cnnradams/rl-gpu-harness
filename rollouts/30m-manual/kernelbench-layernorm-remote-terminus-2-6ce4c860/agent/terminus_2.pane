    for W in [8, 16]:
        pmr = torch.zeros(rows*2, device='cuda')
        rdy = torch.zeros(rows, dtype=torch.int32, device='cuda')
        cnt = torch.zeros(rows, dtype=torch.int32, device='cuda')
        def pipe():
            cnt.zero_(); rdy.zero_(); pmr.zero_()
            _ln2[(rows*S,)](x.view(-1), y.view(-1), pmr, cnt, rdy, N, 1e-5, CH=CH, IT=IT, S=S, num_warps=W)
        pipe()
        torch.cuda.synchronize()
        xr = x.view(rows, -1)
        mean = xr.mean(1, keepdim=True)
        var = xr.var(1, unbiased=False, keepdim=True)
        oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)
        md = (y - oref).abs().max().item()
        t = do_bench(pipe, warmup=10, rep=50)
        print(f'S={S} CH={CH} IT={IT} W={W}: {t:.4f} ms maxdiff={md:.2e}', flush=True)
