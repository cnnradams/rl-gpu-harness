[1082.570688, "i", "cat > /workspace/pdl.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\nfrom triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nN = 64*256*256\nrows = 16\n\n# bandwidth ceilings\nprint('clone:', do_bench(lambda: y.copy_(x), warmup=10, rep=50), 'ms')\nxs = x.view(rows, -1)\nprint('rowmean:', do_bench(lambda: xs.mean(1), warmup=10, rep=50), 'ms')\n\n\n@triton.jit\ndef _stats_pdl(X, PM, PV, N, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * (CH * IT)\n    acc = tl.zeros((CH,), tl.float32)\n    acc2 = tl.zeros((CH,), tl.float32)\n    for i in tl.static_range(IT):\n        off = base + i * CH + tl.arange(0, CH)\n        xx = tl.load(X + off)\n        acc += xx\n        acc2 += xx * xx\n    gdc_launch_dependents()\n    tl.store(PM + pid, tl.sum(acc) / N)\n    tl.store(PV + pid, tl.sum(acc2) / N)\n\n\n@triton.ji"]
[1082.570738, "i", "t\ndef _apply_pdl(X, Y, PM, PV, N, eps, BLK: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * BLK\n    r = tl.arange(0, BLK)\n    xs_ = tl.load(X + base + r)\n    gdc_wait()\n    poff = row * S + tl.arange(0, S)\n    pm = tl.load(PM + poff)\n    pv = tl.load(PV + poff)\n    mean = tl.sum(pm)\n    var = tl.sum(pv) - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(Y + base + r, (xs_ - mean) * rstd)\n\n\nfor S in [128, 256]:\n    for CH, IT, WS in [(4096, 8, 8), (8192, 4, 8), (8192, 2, 16), (16384, 2, 16)]:\n        if N % (S*CH) != 0:\n            continue\n        BLK = N // S\n        for WA in [8, 16, 32]:\n            pm = torch.empty(rows*S, device='cuda')\n            pv = torch.empty(rows*S, device='cuda')\n            def pipe():\n                _stats_pdl[(rows*S,)](x.view(-1), pm, pv, N, CH=CH, IT=IT, S=S, num_warps=WS)\n                _apply_pdl[(rows*S,)](x.view(-1), y.view(-1), pm, pv, N, 1e-5, BLK=BLK, S=S, num_warps=WA, launch_pdl=True)\n     "]
[1082.57078, "i", "       pipe()\n            torch.cuda.synchronize()\n            # correctness spot check\n            xr = x.view(rows, -1)\n            mean = xr.mean(1, keepdim=True)\n            var = xr.var(1, unbiased=False, keepdim=True)\n            oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\n            md = (y - oref).abs().max().item()\n            t = do_bench(pipe, warmup=10, rep=50)\n            print(f'S={S} CH={CH} IT={IT} WS={WS} WA={WA}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\nEOF\n"]
[1082.570815, "o", "cat > /workspace/pdl.py << 'EOF'\r\n\u001b[?2004l\r"]
[1082.57085, "o", "\u001b[?2004h> "]
[1082.570882, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.57089, "o", "> "]
[1082.57091, "o", "import triton\r\n\u001b[?2004l\r"]
[1082.570918, "o", "\u001b[?2004h"]
[1082.570932, "o", "> "]
[1082.570976, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.570983, "o", "> "]
[1082.571198, "o", "from triton.testing import do_bench\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.571222, "o", "from triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> x = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.571253, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1082.571277, "o", "\u001b[?2004h> "]
[1082.571297, "o", "N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.571318, "o", "rows = 16\r\n\u001b[?2004l\r"]
[1082.571338, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.571357, "o", "> "]
[1082.571377, "o", "# bandwidth ceilings\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.571396, "o", "> "]
[1082.571465, "o", "print('clone:', do_bench(lambda: y.copy_(x), warmup=10, rep=50), 'ms')\r\n\u001b[?2004l\r"]
[1082.571479, "o", "\u001b[?2004h> "]
[1082.57151, "o", "xs = x.view(rows, -1)\r\n\u001b[?2004l\r"]
[1082.571534, "o", "\u001b[?2004h> "]
[1082.571601, "o", "print('rowmean:', do_bench(lambda: xs.mean(1), warmup=10, rep=50), 'ms')\r\n\u001b[?2004l\r"]
[1082.571623, "o", "\u001b[?2004h> \r\n"]
[1082.571649, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.57168, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.57187, "o", "def _stats_pdl(X, PM, PV, N, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     row = pid // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.57193, "o", "    base = row * N + (pid % S) * (CH * IT)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.571955, "o", "> "]
[1082.571982, "o", "    acc = tl.zeros((CH,), tl.float32)\r\n\u001b[?2004l\r"]
[1082.572006, "o", "\u001b[?2004h> "]
[1082.572041, "o", "    acc2 = tl.zeros((CH,), tl.float32)\r\n\u001b[?2004l\r"]
[1082.572065, "o", "\u001b[?2004h> "]
[1082.572096, "o", "    for i in tl.static_range(IT):\r\n\u001b[?2004l\r"]
[1082.572119, "o", "\u001b[?2004h> "]
[1082.572164, "o", "        off = base + i * CH + tl.arange(0, CH)\r\n\u001b[?2004l\r"]
[1082.572188, "o", "\u001b[?2004h> "]
[1082.572226, "o", "        xx = tl.load(X + off)\r\n\u001b[?2004l\r"]
[1082.572251, "o", "\u001b[?2004h> "]
[1082.572274, "o", "        acc += xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.572308, "o", "        acc2 += xx * xx\r\n\u001b[?2004l\r"]
[1082.572332, "o", "\u001b[?2004h> "]
[1082.572356, "o", "    gdc_launch_dependents()\r\n\u001b[?2004l\r"]
[1082.57238, "o", "\u001b[?2004h> "]
[1082.572416, "o", "    tl.store(PM + pid, tl.sum(acc) / N)\r\n\u001b[?2004l\r"]
[1082.572439, "o", "\u001b[?2004h> "]
[1082.572476, "o", "    tl.store(PV + pid, tl.sum(acc2) / N)\r\n\u001b[?2004l\r"]
[1082.572499, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.57252, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.572543, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1082.572567, "o", "\u001b[?2004h> "]
[1082.572656, "o", "def _apply_pdl(X, Y, PM, PV, N, eps, BLK: tl.constexpr, S: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.572681, "o", "> "]
[1082.572705, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1082.572728, "o", "\u001b[?2004h> "]
[1082.572753, "o", "    row = pid // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.5728, "o", "    base = row * N + (pid % S) * BLK\r\n\u001b[?2004l\r"]
[1082.572825, "o", "\u001b[?2004h> "]
[1082.572848, "o", "    r = tl.arange(0, BLK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.572871, "o", "> "]
[1082.572895, "o", "    xs_ = tl.load(X + base + r)\r\n\u001b[?2004l\r"]
[1082.572918, "o", "\u001b[?2004h> "]
[1082.572949, "o", "    gdc_wait()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.572989, "o", "    poff = row * S + tl.arange(0, S)\r\n\u001b[?2004l\r"]
[1082.573012, "o", "\u001b[?2004h> "]
[1082.573035, "o", "    pm = tl.load(PM + poff)\r\n\u001b[?2004l\r"]
[1082.573058, "o", "\u001b[?2004h> "]
[1082.573088, "o", "    pv = tl.load(PV + poff)\r\n\u001b[?2004l\r"]
[1082.573111, "o", "\u001b[?2004h> "]
[1082.573139, "o", "    mean = tl.sum(pm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.573188, "o", "    var = tl.sum(pv) - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.573212, "o", "> "]
[1082.573238, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1082.573257, "o", "\u001b[?2004h> "]
[1082.573311, "o", "    tl.store(Y + base + r, (xs_ - mean) * rstd)\r\n\u001b[?2004l\r"]
[1082.573335, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.573357, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1082.573381, "o", "> "]
[1082.573404, "o", "for S in [128, 256]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.573503, "o", "    for CH, IT, WS in [(4096, 8, 8), (8192, 4, 8), (8192, 2, 16), (16384, 2, 16)]:\r\n\u001b[?2004l\r"]
[1082.573528, "o", "\u001b[?2004h> "]
[1082.573559, "o", "        if N % (S*CH) != 0:\r\n\u001b[?2004l\r"]
[1082.573582, "o", "\u001b[?2004h> "]
[1082.573606, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.573635, "o", "        BLK = N // S\r\n\u001b[?2004l\r"]
[1082.573658, "o", "\u001b[?2004h> "]
[1082.573685, "o", "        for WA in [8, 16, 32]:\r\n\u001b[?2004l\r"]
[1082.573708, "o", "\u001b[?2004h> "]
[1082.573757, "o", "            pm = torch.empty(rows*S, device='cuda')\r\n\u001b[?2004l\r"]
[1082.573781, "o", "\u001b[?2004h> "]
[1082.573833, "o", "            pv = torch.empty(rows*S, device='cuda')\r\n\u001b[?2004l\r"]
[1082.573856, "o", "\u001b[?2004h> "]
[1082.57388, "o", "            def pipe():\r\n\u001b[?2004l\r"]
[1082.573904, "o", "\u001b[?2004h> "]
[1082.573999, "o", "                _stats_pdl[(rows*S,)](x.view(-1), pm, pv, N, CH=CH, IT=IT, S=S, num_warps=WS)\r\n\u001b[?2004l\r"]
[1082.574023, "o", "\u001b[?2004h> "]
[1082.574146, "o", "                _apply_pdl[(rows*S,)](x.view(-1), y.view(-1), pm, pv, N, 1e-5, BLK=BLK, S=S, num_warps=WA, launch_pdl=True)\r\n\u001b[?2004l\r"]
[1082.574171, "o", "\u001b[?2004h> "]
[1082.574194, "o", "            pipe()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1082.57424, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1082.574263, "o", "\u001b[?2004h> "]
[1082.574296, "o", "            # correctness spot check\r\n\u001b[?2004l\r"]
[1082.57432, "o", "\u001b[?2004h> "]
[1082.57435, "o", "            xr = x.view(rows, -1)\r\n\u001b[?2004l\r"]
[1082.574373, "o", "\u001b[?2004h> "]
[1082.574414, "o", "            mean = xr.mean(1, keepdim=True)\r\n\u001b[?2004l\r"]
[1082.574437, "o", "\u001b[?2004h> "]
[1082.574492, "o", "            var = xr.var(1, unbiased=False, keepdim=True)\r\n\u001b[?2004l\r"]
[1082.574516, "o", "\u001b[?2004h> "]
[1082.5746, "o", "            oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\r\n\u001b[?2004l\r"]
[1082.574623, "o", "\u001b[?2004h> "]
[1082.574667, "o", "            md = (y - oref).abs().max().item()\r\n\u001b[?2004l\r"]
[1082.57469, "o", "\u001b[?2004h> "]
[1082.574738, "o", "            t = do_bench(pipe, warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[1082.574761, "o", "\u001b[?2004h> "]
[1082.574864, "o", "            print(f'S={S} CH={CH} IT={IT} WS={WS} WA={WA}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\r\n\u001b[?2004l\r"]
[1082.574888, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1082.575759, "o", "\u001b[?2004hroot@modal:/workspace# "]
