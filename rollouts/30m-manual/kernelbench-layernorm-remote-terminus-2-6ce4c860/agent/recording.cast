[1428.57752, "o", "S=64 CH=16384 IT=4 W=16: 0.2923 ms maxdiff=1.67e-06\r\nS=64 CH=8192 IT=8 W=8: 0.2932 ms maxdiff=1.91e-06\r\n"]
[1429.345414, "o", "S=64 CH=8192 IT=8 W=16: 0.2909 ms maxdiff=2.15e-06\r\nS=128 CH=8192 IT=4 W=8: 0.2949 ms maxdiff=2.03e-06\r\nS=128 CH=8192 IT=4 W=16: 0.3017 ms maxdiff=3.34e-06\r\n"]
[1430.106941, "o", "S=128 CH=16384 IT=2 W=8: 0.2975 ms maxdiff=2.26e-06\r\nS=128 CH=16384 IT=2 W=16: 0.3024 ms maxdiff=1.91e-06\r\nS=256 CH=8192 IT=2 W=8: 0.3036 ms maxdiff=3.93e-06\r\nS=256 CH=8192 IT=2 W=16: 0.3533 ms maxdiff=3.58e-06\r\n"]
[1430.978467, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1540.535769, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_fused(X, Y, PMR, CNT, RDY, N, eps, BLK: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    seg = pid % S\n    base = row * N + seg * BLK\n    r = tl.arange(0, BLK)\n    xs_ = tl.load(X + base + r)\n    pm = tl.sum(xs_) / N\n    pv = tl.sum(xs_ * xs_) / N\n    tl.atomic_add(PMR + row * 2, pm)\n    tl.atomic_add(PMR + row * 2 + 1, pv)\n    old = tl.atomic_add(CNT + row, 1, sem='acq_rel')\n    if old == S - 1:\n        m = tl.atomic_add(PMR + row * 2, 0.0, sem='acquire')\n        v = tl.atomic_add(PMR + row * 2 + 1, 0.0, sem='acquire')\n        var = v - m * m\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.atomic_xchg(PMR + row * 2, m)\n        tl.atomic_xchg(PMR + row * 2 + 1, rstd)\n        tl.atomic_xchg(RDY + row, 1, sem='release')\n    ok = tl.zeros((), tl.int32)\n    while ok == 0:\n        ok = tl.atomic_add(RDY + row, 0"]
[1540.53647, "i", ", sem='acquire')\n    m2 = tl.atomic_add(PMR + row * 2, 0.0, sem='acquire')\n    r2 = tl.atomic_add(PMR + row * 2 + 1, 0.0, sem='acquire')\n    tl.store(Y + base + r, (xs_ - m2) * r2)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape, eps: float = 1e-5):\n        super().__init__()\n        if isinstance(normalized_shape, int):\n            normalized_shape = (normalized_shape,)\n        self.normalized_shape = tuple(normalized_shape)\n        self.eps = eps\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n        n = 1\n        for d in self.normalized_shape:\n            n *= d\n        self._N = n\n        self._S = 64\n        self._BLK = n // self._S if n % self._S == 0 else 0\n        self._ok = self._BLK > 0 and self._BLK <= 65536 and (self._BLK & (self._BLK - 1)) == 0\n        self._buf = None\n        self._graphs = {}\n        self._outs = {}\n        self._fast = None\nEOF\n"]
