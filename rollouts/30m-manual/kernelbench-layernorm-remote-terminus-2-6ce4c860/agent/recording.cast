[1088.156894, "o", "clone: 0.18217599987983704 ms\r\nrowmean: 0.1066170115295041 ms\r\nS=128 CH=4096 IT=8 WS=8 WA=8: 0.2746 ms maxdiff=7.15e-07\r\n"]
[1088.214935, "o", "S=128 CH=4096 IT=8 WS=8 WA=16: 0.2745 ms maxdiff=7.15e-07\r\n"]
[1088.947389, "o", "S=128 CH=4096 IT=8 WS=8 WA=32: 0.2749 ms maxdiff=7.15e-07\r\nS=128 CH=8192 IT=4 WS=8 WA=8: 0.2747 ms maxdiff=8.34e-07\r\nS=128 CH=8192 IT=4 WS=8 WA=16: 0.2746 ms maxdiff=8.34e-07\r\nS=128 CH=8192 IT=4 WS=8 WA=32: 0.2751 ms maxdiff=8.34e-07\r\nS=128 CH=8192 IT=2 WS=16 WA=8: 0.2318 ms maxdiff=9.58e-01\r\nS=128 CH=8192 IT=2 WS=16 WA=16: 0.2315 ms maxdiff=9.58e-01\r\nS=128 CH=8192 IT=2 WS=16 WA=32: 0.2320 ms maxdiff=9.58e-01\r\n"]
[1089.697681, "o", "S=128 CH=16384 IT=2 WS=16 WA=8: 0.2744 ms maxdiff=7.15e-07\r\nS=128 CH=16384 IT=2 WS=16 WA=16: 0.2745 ms maxdiff=7.15e-07\r\nS=128 CH=16384 IT=2 WS=16 WA=32: 0.2747 ms maxdiff=7.15e-07\r\nS=256 CH=4096 IT=8 WS=8 WA=8: 0.2928 ms maxdiff=nan\r\nS=256 CH=4096 IT=8 WS=8 WA=16: 0.2917 ms maxdiff=nan\r\n"]
[1090.434135, "o", "S=256 CH=4096 IT=8 WS=8 WA=32: 0.2914 ms maxdiff=nan\r\nS=256 CH=8192 IT=4 WS=8 WA=8: 0.3090 ms maxdiff=nan\r\nS=256 CH=8192 IT=4 WS=8 WA=16: 0.3075 ms maxdiff=nan\r\nS=256 CH=8192 IT=4 WS=8 WA=32: 0.3075 ms maxdiff=nan\r\nS=256 CH=8192 IT=2 WS=16 WA=8: 0.2773 ms maxdiff=7.15e-07\r\nS=256 CH=8192 IT=2 WS=16 WA=16: 0.2757 ms maxdiff=7.15e-07\r\nS=256 CH=8192 IT=2 WS=16 WA=32: 0.2756 ms maxdiff=7.15e-07\r\n"]
[1091.177986, "o", "S=256 CH=16384 IT=2 WS=16 WA=8: 0.3093 ms maxdiff=nan\r\nS=256 CH=16384 IT=2 WS=16 WA=16: 0.3089 ms maxdiff=nan\r\nS=256 CH=16384 IT=2 WS=16 WA=32: 0.3090 ms maxdiff=nan\r\n"]
