[1290.618502, "o", "Traceback (most recent call last):\r\n  File \"/workspace/pdl3.py\", line 54, in <module>\r\n    pipe()\r\n  File \"/workspace/pdl3.py\", line 53, in pipe\r\n    _ln1[(rows*S,)](x.view(-1), y.view(-1), pmr, cnt, mr, N, 1e-5, BLK=BLK, S=S, num_warps=W)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 419, in <lambda>\r\n    return lambda *args, **kwargs: self.run(grid=grid, warmup=False, *args, **kwargs)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 733, in run\r\n    kernel = self._do_compile(key, signature, device, constexprs, options, attrs, warmup)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 861, in _do_compile\r\n    kernel = self.compile(src, target=target, options=options.__dict__)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\", line 300, in compile\r\n    module = src.make_ir(target, options, codegen_fns, module_map, context)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler"]
[1290.61856, "o", ".py\", line 80, in make_ir\r\n    return ast_to_ttir(self.fn, self, context=context, options=options, codegen_fns=codegen_fns,\r\ntriton.compiler.errors.CompilationError: at 27:8:\r\n        var = v - m * m\r\n        rstd = 1.0 / tl.sqrt(var + eps)\r\n        tl.atomic_xchg(MR + row * 2, m)\r\n        tl.atomic_xchg(MR + row * 2 + 1, rstd)\r\n    m2 = tl.zeros((), tl.float32)\r\n    r2 = tl.zeros((), tl.float32)\r\n    if old == S - 1:\r\n        m2 = tl.load(MR + row * 2)\r\n        r2 = tl.load(MR + row * 2 + 1)\r\n    else:\r\n        ok = tl.zeros((), tl.int32)\r\n        while ok == 0:\r\n        ^\r\nAssertionError('Loop-carried variable ok has initial type int32 but is re-assigned to int1 in loop! Please make sure that the type stays consistent.')\r\n"]
[1291.410689, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1353.449727, "i", "cat > /workspace/pdl3.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nN = 64*256*256\nrows = 16\n\n@triton.jit\ndef _ln1(X, Y, PMR, CNT, RDY, N, eps, BLK: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    seg = pid % S\n    base = row * N + seg * BLK\n    r = tl.arange(0, BLK)\n    xs_ = tl.load(X + base + r)\n    pm = tl.sum(xs_) / N\n    pv = tl.sum(xs_ * xs_) / N\n    tl.atomic_add(PMR + row * 2, pm)\n    tl.atomic_add(PMR + row * 2 + 1, pv)\n    old = tl.atomic_add(CNT + row, 1, sem='acq_rel')\n    if old == S - 1:\n        m = tl.atomic_add(PMR + row * 2, 0.0, sem='acquire')\n        v = tl.atomic_add(PMR + row * 2 + 1, 0.0, sem='acquire')\n        var = v - m * m\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.atomic_xchg(PMR + row * 2, m)\n        tl.atomic_xchg(PMR + row * 2 + 1, rstd)\n        tl.atomic_xchg(RDY + row, 1, sem='release')\n    ok = tl.zer"]
[1353.449778, "i", "os((), tl.int32)\n    while ok == 0:\n        ok = tl.atomic_add(RDY + row, 0, sem='acquire')\n    m2 = tl.atomic_add(PMR + row * 2, 0.0, sem='acquire')\n    r2 = tl.atomic_add(PMR + row * 2 + 1, 0.0, sem='acquire')\n    tl.store(Y + base + r, (xs_ - m2) * r2)\n\nfor S in [64, 128, 256]:\n    BLK = N // S\n    for W in [16, 32]:\n        pmr = torch.zeros(rows*2, device='cuda')\n        rdy = torch.zeros(rows, dtype=torch.int32, device='cuda')\n        cnt = torch.zeros(rows, dtype=torch.int32, device='cuda')\n        def pipe():\n            cnt.zero_(); rdy.zero_(); pmr.zero_()\n            _ln1[(rows*S,)](x.view(-1), y.view(-1), pmr, cnt, rdy, N, 1e-5, BLK=BLK, S=S, num_warps=W)\n        pipe()\n        torch.cuda.synchronize()\n        xr = x.view(rows, -1)\n        mean = xr.mean(1, keepdim=True)\n        var = xr.var(1, unbiased=False, keepdim=True)\n        oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\n        md = (y - oref).abs().max().item()\n        t = do_bench(pipe, warmup=10, rep=50)\n      "]
[1353.449889, "i", "  print(f'S={S} W={W}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\nEOF\n"]
