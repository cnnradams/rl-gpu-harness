[384.996248, "o", "> "]
[384.996338, "o", "        _ln_apply[grid](xf, yf, self._pm, self._pv, N, self.eps, BLOCK=B, S=S, REV=True, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
