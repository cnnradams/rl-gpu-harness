[134.32464, "o", "device)\r\n270-\r\n271-            # Calculate the elapsed time in milliseconds\r\n272-            elapsed_time_ms = start_event.elapsed_time(end_event)\r\n273-            \r\n274-            if trial >= discard_first:\r\n275-                if verbose:\r\n276-                    logical_idx = trial - discard_first + 1\r\n277-                    print(f\"Trial {logical_idx}: {elapsed_time_ms:.3g} ms\")\r\n278-                elapsed_times.append(elapsed_time_ms)\r\n279-\r\n280-\r\n281-    return elapsed_times\r\n"]
