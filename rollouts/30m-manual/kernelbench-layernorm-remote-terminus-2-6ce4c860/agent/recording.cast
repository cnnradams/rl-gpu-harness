[187.503012, "o", ".synchronize(device=device)\r\n779-            # ensure all GPU operations are completed before checking results\r\n780-\r\n781-            try:\r\n782-                output_new = model_new(*inputs)\r\n783-                torch.cuda.synchronize(device=device)\r\n784-                if output.shape != output_new.shape:\r\n785-                    metadata = register_and_format_exception(\r\n786-                        \"correctness_issue\",\r\n787-                        f\"Output shape mismatch: Expected {output.shape}, got {output_new.shape}\",\r\n788-                        metadata,\r\n789-                    )\r\n790-                    metadata[\"correctness_issue_name\"] = \"correctness_issue\"\r\n791-                    if verbose:\r\n792-                        print(\r\n793-                            f\"[FAIL] trial {trial}: Output shape mismatch: Expected {output.shape}, got {output_new.shape}\"\r\n794-                        )\r\n795-                    return KernelExecResult(\r\n796-                        compiled=True, correctness=False, "]
[187.503172, "o", "metadata=metadata\r\n797-                    )\r\n798-\r\n799-                # in torchbench, they use both precisions for atol and rtol\r\n800-                # kernelbench v0 and v0.1 uses fp32, atol = rtol = 1e-02\r\n801-                # now we will return the tolerance from get_tolerance_for_precision\r\n802-                tolerance = get_tolerance_for_precision(precision)\r\n803-                # check output value difference\r\n804-                if not torch.allclose(\r\n805-                    output, output_new, atol=tolerance, rtol=tolerance\r\n806-                ):  # fail\r\n807-                    max_diff = torch.max(torch.abs(output - output_new)).item()\r\n808-                    avg_diff = torch.mean(torch.abs(output - output_new)).item()\r\n809-                    metadata.setdefault(\"max_difference\", []).append(f\"{max_diff:.6f}\")\r\n810-                    metadata.setdefault(\"avg_difference\", []).append(f\"{avg_diff:.6f}\")\r\n811-                    metadata[\"correctness_issue\"] = \"Output mismatch\"\r\n812-           "]
