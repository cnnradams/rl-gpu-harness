[850.536934, "o", "\u001b[?2004h> "]
[850.537031, "o", "                _ln_stats[(rows*S,)](x.view(-1), pm, pv, N, CH=CH, IT=IT, S=S, num_warps=W)\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.537048, "o", "> "]
