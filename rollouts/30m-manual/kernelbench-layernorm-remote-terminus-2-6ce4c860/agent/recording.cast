[1285.773744, "o", "def _ln1(X, Y, PMR, CNT, MR, N, eps, BLK: tl.constexpr, S: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1285.77377, "o", "> "]
[1285.773799, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1285.773825, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[1285.773851, "o", "\u001b[?2004h> "]
