[724.110663, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_stats(X, PM, PV, N, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * (CH * IT)\n    acc = tl.zeros((CH,), tl.float32)\n    acc2 = tl.zeros((CH,), tl.float32)\n    for i in tl.static_range(IT):\n        off = base + i * CH + tl.arange(0, CH)\n        x = tl.load(X + off)\n        acc += x\n        acc2 += x * x\n    tl.store(PM + pid, tl.sum(acc) / N)\n    tl.store(PV + pid, tl.sum(acc2) / N)\n\n\n@triton.jit\ndef _ln_apply(X, Y, PM, PV, N, eps, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr, REV: tl.constexpr):\n    pid = tl.program_id(0)\n    if REV:\n        pid = tl.num_programs(0) - 1 - pid\n    row = pid // S\n    poff = row * S + tl.arange(0, S)\n    pm = tl.load(PM + poff)\n    pv = tl.load(PV + poff)\n    mean = tl.sum(pm)\n    var = tl.sum(pv) - mean * mean\n    rstd ="]
[724.110915, "i", " 1.0 / tl.sqrt(var + eps)\n    base = row * N + (pid % S) * (CH * IT)\n    for i in tl.static_range(IT):\n        off = base + i * CH + tl.arange(0, CH)\n        x = tl.load(X + off)\n        tl.store(Y + off, (x - mean) * rstd)\nEOF\n"]
