[1017.442691, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\nfrom triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\n\nVEC: tl.constexpr = 8\n\n\n@triton.jit\ndef _stats_pdl(X, PM, PV, N, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * (CH * IT)\n    acc = tl.zeros((CH,), tl.float32)\n    acc2 = tl.zeros((CH,), tl.float32)\n    for i in tl.static_range(IT):\n        off = base + i * CH + tl.arange(0, CH)\n        x = tl.load(X + off)\n        acc += x\n        acc2 += x * x\n    gdc_launch_dependents()\n    tl.store(PM + pid, tl.sum(acc) / N)\n    tl.store(PV + pid, tl.sum(acc2) / N)\n\n\n@triton.jit\ndef _apply_pdl(X, Y, PM, PV, N, eps, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * (CH * IT)\n    r = tl.arange(0, CH)\n    xs = tl.zeros((IT, CH), tl.float32)\n  "]
[1017.442746, "i", "  for i in tl.static_range(IT):\n        x = tl.load(X + base + i * CH + r)\n        xs = tl.where((r < CH)[None, :] & (tl.full((IT, 1), i, tl.int32) == i), x[None, :], xs)\n    gdc_wait()\n    poff = row * S + tl.arange(0, S)\n    pm = tl.load(PM + poff)\n    pv = tl.load(PV + poff)\n    mean = tl.sum(pm)\n    var = tl.sum(pv) - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for i in tl.static_range(IT):\n        xi = tl.sum(tl.where(tl.arange(0, IT)[:, None] == i, xs, 0.0), axis=0)\n        tl.store(Y + base + i * CH + r, (xi - mean) * rstd)\nEOF\n"]
