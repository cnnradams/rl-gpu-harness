[492.565703, "i", "cat > /workspace/dbg.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_stats, _ln_apply\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256\nS = 32\nBLOCK = 131072\nrows = 16\npm = torch.full((rows*S,), -1.0, device='cuda')\npv = torch.full((rows*S,), -1.0, device='cuda')\nxf = x.view(-1)\n_ln_stats[(rows*S,)](xf, pm, pv, N, BLOCK=BLOCK, S=S, num_warps=8)\ntorch.cuda.synchronize()\npm = pm.view(rows, S); pv = pv.view(rows, S)\nmean = pm.sum(1)/S\nvar = pv.sum(1)/S - mean**2\ntm = x.view(rows,-1).mean(1)\ntv = x.view(rows,-1).var(1, unbiased=False)\nprint('pm[0,:4]', pm[0,:4].tolist())\nprint('expected partial means row0', (x.view(rows,-1)[0].view(S,-1).mean(1)).tolist()[:4])\nprint('mean diff', (mean-tm).abs().max().item())\nprint('var diff', (var-tv).abs().max().item())\nEOF\n"]
