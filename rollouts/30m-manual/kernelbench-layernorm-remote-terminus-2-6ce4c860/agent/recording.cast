[1151.465836, "i", "cat > /workspace/pdl2.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\nfrom triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nN = 64*256*256\nrows = 16\n\n@triton.jit\ndef _stats_pdl2(X, PM, PV, CNT, N, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * (CH * IT)\n    acc = tl.zeros((CH,), tl.float32)\n    acc2 = tl.zeros((CH,), tl.float32)\n    for i in tl.static_range(IT):\n        off = base + i * CH + tl.arange(0, CH)\n        xx = tl.load(X + off)\n        acc += xx\n        acc2 += xx * xx\n    gdc_launch_dependents()\n    tl.store(PM + pid, tl.sum(acc) / N)\n    tl.store(PV + pid, tl.sum(acc2) / N)\n    cnt = tl.atomic_add(CNT + row, 1, sem='release')\n\n@triton.jit\ndef _apply_pdl2(X, Y, PM, PV, CNT, N, eps, BLK: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n  "]
[1151.46612, "i", "  base = row * N + (pid % S) * BLK\n    r = tl.arange(0, BLK)\n    xs_ = tl.load(X + base + r)\n    gdc_wait()\n    done = 0\n    while done == 0:\n        done = tl.atomic_add(CNT + row, 0, sem='acquire') == S\n    poff = row * S + tl.arange(0, S)\n    pm = tl.load(PM + poff)\n    pv = tl.load(PV + poff)\n    mean = tl.sum(pm)\n    var = tl.sum(pv) - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(Y + base + r, (xs_ - mean) * rstd)\n\nfor S, CH, IT, WS in [(128, 8192, 4, 8), (128, 16384, 2, 16), (64, 16384, 4, 16), (64, 8192, 8, 8)]:\n    BLK = N // S\n    for WA in [16, 32]:\n        pm = torch.zeros(rows*S, device='cuda')\n        pv = torch.zeros(rows*S, device='cuda')\n        cnt = torch.zeros(rows, dtype=torch.int32, device='cuda')\n        def pipe():\n            cnt.zero_()\n            _stats_pdl2[(rows*S,)](x.view(-1), pm, pv, cnt, N, CH=CH, IT=IT, S=S, num_warps=WS)\n            _apply_pdl2[(rows*S,)](x.view(-1), y.view(-1), pm, pv, cnt, N, 1e-5, BLK=BLK, S=S, num_warps=WA, launch_pdl=True)\n        pipe()"]
[1151.466412, "o", "cat > /workspace/pdl2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> from triton.testing import do_bench\r\n\u001b[?2004l\r\u001b[?2004h> from triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> x = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> N = 64*256*256\r\n\u001b[?2004l\r"]
[1151.466459, "i", "\n        torch.cuda.synchronize()\n        xr = x.view(rows, -1)\n        mean = xr.mean(1, keepdim=True)\n        var = xr.var(1, unbiased=False, keepdim=True)\n        oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\n        md = (y - oref).abs().max().item()\n        t = do_bench(pipe, warmup=10, rep=50)\n        print(f'S={S} CH={CH} IT={IT} WS={WS} WA={WA}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\nEOF\n"]
[1151.466477, "o", "\u001b[?2004h> rows = 16\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.466516, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.466613, "o", "def _stats_pdl2(X, PM, PV, CNT, N, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.466648, "o", "> "]
[1151.466669, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.46669, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[1151.466712, "o", "\u001b[?2004h> "]
[1151.466758, "o", "    base = row * N + (pid % S) * (CH * IT)\r\n\u001b[?2004l\r"]
[1151.466783, "o", "\u001b[?2004h> "]
[1151.466815, "o", "    acc = tl.zeros((CH,), tl.float32)\r\n\u001b[?2004l\r"]
[1151.466835, "o", "\u001b[?2004h> "]
[1151.466874, "o", "    acc2 = tl.zeros((CH,), tl.float32)\r\n\u001b[?2004l\r"]
[1151.466894, "o", "\u001b[?2004h> "]
[1151.466928, "o", "    for i in tl.static_range(IT):\r\n\u001b[?2004l\r"]
[1151.466953, "o", "\u001b[?2004h> "]
[1151.466996, "o", "        off = base + i * CH + tl.arange(0, CH)\r\n\u001b[?2004l\r"]
[1151.467023, "o", "\u001b[?2004h> "]
[1151.467051, "o", "        xx = tl.load(X + off)\r\n\u001b[?2004l\r"]
[1151.467076, "o", "\u001b[?2004h> "]
[1151.4671, "o", "        acc += xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.467128, "o", "        acc2 += xx * xx\r\n\u001b[?2004l\r"]
[1151.467152, "o", "\u001b[?2004h> "]
[1151.467176, "o", "    gdc_launch_dependents()\r\n\u001b[?2004l\r"]
[1151.467204, "o", "\u001b[?2004h> "]
[1151.467236, "o", "    tl.store(PM + pid, tl.sum(acc) / N)\r\n\u001b[?2004l\r"]
[1151.467263, "o", "\u001b[?2004h> "]
[1151.467303, "o", "    tl.store(PV + pid, tl.sum(acc2) / N)\r\n\u001b[?2004l\r"]
[1151.467326, "o", "\u001b[?2004h> "]
[1151.467383, "o", "    cnt = tl.atomic_add(CNT + row, 1, sem='release')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.467412, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.46744, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.467469, "o", "> "]
[1151.46753, "o", "def _apply_pdl2(X, Y, PM, PV, CNT, N, eps, BLK: tl.constexpr, S: tl.constexpr):\r\n\u001b[?2004l\r"]
[1151.467561, "o", "\u001b[?2004h> "]
[1151.467589, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.467617, "o", ">     row = pid // S\r\n\u001b[?2004l\r"]
[1151.467645, "o", "\u001b[?2004h> "]
[1151.467673, "o", "    base = row * N + (pid % S) * BLK\r\n\u001b[?2004l\r"]
[1151.467698, "o", "\u001b[?2004h> "]
[1151.467724, "o", "    r = tl.arange(0, BLK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.46775, "o", "> "]
[1151.467804, "o", "    xs_ = tl.load(X + base + r)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.467827, "o", "    gdc_wait()\r\n\u001b[?2004l\r"]
[1151.467848, "o", "\u001b[?2004h> "]
[1151.46787, "o", "    done = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.467916, "o", "    while done == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.467995, "o", "        done = tl.atomic_add(CNT + row, 0, sem='acquire') == S\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.468026, "o", "> "]
[1151.468055, "o", "    poff = row * S + tl.arange(0, S)\r\n\u001b[?2004l\r"]
[1151.468081, "o", "\u001b[?2004h> "]
[1151.468108, "o", "    pm = tl.load(PM + poff)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.468146, "o", "    pv = tl.load(PV + poff)\r\n\u001b[?2004l\r"]
[1151.468171, "o", "\u001b[?2004h> "]
[1151.468199, "o", "    mean = tl.sum(pm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.468229, "o", "> "]
[1151.468258, "o", "    var = tl.sum(pv) - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.468289, "o", "> "]
[1151.468311, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.468339, "o", "> "]
[1151.468376, "o", "    tl.store(Y + base + r, (xs_ - mean) * rstd)\r\n\u001b[?2004l\r"]
[1151.468406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.468435, "o", "> "]
[1151.468533, "o", "for S, CH, IT, WS in [(128, 8192, 4, 8), (128, 16384, 2, 16), (64, 16384, 4, 16), (64, 8192, 8, 8)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.468565, "o", "    BLK = N // S\r\n\u001b[?2004l\r"]
[1151.468585, "o", "\u001b[?2004h> "]
[1151.468604, "o", "    for WA in [16, 32]:\r\n\u001b[?2004l\r"]
[1151.468624, "o", "\u001b[?2004h> "]
[1151.468679, "o", "        pm = torch.zeros(rows*S, device='cuda')\r\n\u001b[?2004l\r"]
[1151.468706, "o", "\u001b[?2004h> "]
[1151.468758, "o", "        pv = torch.zeros(rows*S, device='cuda')\r\n\u001b[?2004l\r"]
[1151.468784, "o", "\u001b[?2004h> "]
[1151.468845, "o", "        cnt = torch.zeros(rows, dtype=torch.int32, device='cuda')\r\n\u001b[?2004l\r"]
[1151.468873, "o", "\u001b[?2004h> "]
[1151.468896, "o", "        def pipe():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.468927, "o", "            cnt.zero_()\r\n\u001b[?2004l\r"]
[1151.468956, "o", "\u001b[?2004h> "]
[1151.469046, "o", "            _stats_pdl2[(rows*S,)](x.view(-1), pm, pv, cnt, N, CH=CH, IT=IT, S=S, num_warps=WS)\r\n\u001b[?2004l\r"]
[1151.469074, "o", "\u001b[?2004h> "]
[1151.469224, "o", "            _apply_pdl2[(rows*S,)](x.view(-1), y.view(-1), pm, pv, cnt, N, 1e-5, BLK=BLK, S=S, num_warps=WA, launch_pdl=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.469252, "o", "        pipe()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.469292, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1151.469316, "o", "\u001b[?2004h> "]
[1151.469343, "o", "        xr = x.view(rows, -1)\r\n\u001b[?2004l\r"]
[1151.469371, "o", "\u001b[?2004h> "]
[1151.469404, "o", "        mean = xr.mean(1, keepdim=True)\r\n\u001b[?2004l\r"]
[1151.469431, "o", "\u001b[?2004h> "]
[1151.469494, "o", "        var = xr.var(1, unbiased=False, keepdim=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.469598, "o", "        oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.46965, "o", "        md = (y - oref).abs().max().item()\r\n\u001b[?2004l\r"]
[1151.469674, "o", "\u001b[?2004h> "]
[1151.469717, "o", "        t = do_bench(pipe, warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[1151.469745, "o", "\u001b[?2004h> "]
[1151.46984, "o", "        print(f'S={S} CH={CH} IT={IT} WS={WS} WA={WA}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\r\n\u001b[?2004l\r"]
[1151.469872, "o", "\u001b[?2004h> "]
[1151.469901, "o", "EOF\r\n\u001b[?2004l\r"]
[1151.470881, "o", "\u001b[?2004hroot@modal:/workspace# "]
