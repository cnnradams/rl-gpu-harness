[1000.425686, "o", "/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:317:static void _launch(int gridX, int gridY, int gridZ, int num_warps, int num_ctas, int launch_cooperative_grid, int launch_pdl, int clusterDimX, int clusterDimY, int clusterDimZ, int shared_memory, CUstream stream, CUfunction function, CUdeviceptr global_scratch, CUdeviceptr profile_scratch{', ' + arg_decls if len(arg_decls) > 0 else ''}) {{\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:345:    if (launch_pdl != 0) {{\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:496:  int launch_pdl;\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:505:                                           &_stream, &_function, &launch_cooperative_grid, &launch_pdl, &global_scratch_obj, &profile_scratch_obj,\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:548:  _launch(gridX, gridY, gridZ, num_warps, num_ctas, launch_cooperative_grid, launch_pdl, clusterDim"]
[1000.425746, "o", "X, clusterDimY, clusterDimZ, shared_memory, (CUstream)_stream, (CUfunction)_function, global_scratch, profile_scratch{', ' + ', '.join(internal_args_list) if len(internal_args_list) > 0 else ''});\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:697:        self.launch_pdl = metadata.launch_pdl\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/driver.py:712:        self.launch(gridX, gridY, gridZ, stream, function, self.launch_cooperative_grid, self.launch_pdl,\r\n/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/compiler.py:120:    launch_pdl: bool = False\r\n/usr/local/lib/python3.10/dist-packages/triton/language/extra/cuda/gdc.py:13:def gdc_wait(_semantic=None):\r\n/usr/local/lib/python3.10/dist-packages/triton/language/extra/cuda/gdc.py:28:def gdc_launch_dependents(_semantic=None):\r\n/usr/local/lib/python3.10/dist-packages/triton/language/extra/cuda/__init__.py:4:from .gdc import (gdc_launch_dependents, gdc_wait)\r\n/usr/local/lib/python3.10/dist-packages/triton/"]
