[1285.773985, "o", "> "]
[1285.77401, "o", "    xs_ = tl.load(X + base + r)\r\n\u001b[?2004l\r"]
[1285.774031, "o", "\u001b[?2004h> "]
[1285.774055, "o", "    pm = tl.sum(xs_) / N\r\n\u001b[?2004l\r"]
[1285.77408, "o", "\u001b[?2004h> "]
[1285.774106, "o", "    pv = tl.sum(xs_ * xs_) / N\r\n\u001b[?2004l\r"]
[1285.774129, "o", "\u001b[?2004h> "]
[1285.774162, "o", "    tl.atomic_add(PMR + row * 2, pm)\r\n\u001b[?2004l\r"]
[1285.774187, "o", "\u001b[?2004h> "]
[1285.774228, "o", "    tl.atomic_add(PMR + row * 2 + 1, pv)\r\n\u001b[?2004l\r\u001b[?2004h"]
