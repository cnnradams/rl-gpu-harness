[384.994018, "i", "cat >> /workspace/solution.py << 'EOF'\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape, eps: float = 1e-5):\n        super().__init__()\n        if isinstance(normalized_shape, int):\n            normalized_shape = (normalized_shape,)\n        self.normalized_shape = tuple(normalized_shape)\n        self.eps = eps\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n        n = 1\n        for d in self.normalized_shape:\n            n *= d\n        self._N = n\n        self._S = 32\n        self._BLOCK = triton.next_power_of_2((n + self._S - 1) // self._S)\n        self._pm = None\n        self._pv = None\n        self._graphs = {}\n        self._outs = {}\n\n    def _run_eager(self, x, y):\n        N = self._N\n        S = self._S\n        B = self._BLOCK\n        rows = x.numel() // N\n        grid = (rows * S,)\n        xf = x.view(-1)\n        yf = y.view(-1)\n        if self._pm is None or self._pm.numel() < rows * S:\n    "]
[384.994176, "i", "        self._pm = torch.empty(rows * S, device=x.device, dtype=torch.float32)\n            self._pv = torch.empty(rows * S, device=x.device, dtype=torch.float32)\n        _ln_stats[grid](xf, self._pm, self._pv, N, BLOCK=B, S=S, num_warps=8)\n        _ln_apply[grid](xf, yf, self._pm, self._pv, N, self.eps, BLOCK=B, S=S, REV=True, num_warps=8)\n        return y\nEOF\n"]
