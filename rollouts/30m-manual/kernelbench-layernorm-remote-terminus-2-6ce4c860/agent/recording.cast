[850.535823, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom triton.testing import do_bench\nfrom solution import _ln_stats, _ln_apply\nx = torch.rand(16, 64, 256, 256, device='cuda')\nN = 64*256*256\nrows = 16\ny = torch.empty_like(x)\nresults = []\nfor S in [16, 32, 64, 128]:\n    for CH in [2048, 4096, 8192, 16384]:\n        if N % (S*CH) != 0:\n            continue\n        IT = N // (S*CH)\n        for W in [4, 8, 16]:\n            pm = torch.empty(rows*S, device='cuda')\n            pv = torch.empty(rows*S, device='cuda')\n            def stats():\n                _ln_stats[(rows*S,)](x.view(-1), pm, pv, N, CH=CH, IT=IT, S=S, num_warps=W)\n            def apply():\n                _ln_apply[(rows*S,)](x.view(-1), y.view(-1), pm, pv, N, 1e-5, CH=CH, IT=IT, S=S, REV=True, num_warps=W)\n            stats()\n            torch.cuda.synchronize()\n            t1 = do_bench(stats, warmup=10, rep=50)\n            t2 = do_bench(apply, warmup=10, rep=50)\n            results.append((t1+t2, t1, t2, S, CH, IT"]
[850.535882, "i", ", W))\n            print(f'S={S} CH={CH} IT={IT} W={W}: stats={t1:.4f} apply={t2:.4f} total={t1+t2:.4f}', flush=True)\nresults.sort()\nprint('BEST:', results[0])\nEOF\n"]
