[381.175307, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_stats(X, PM, PV, N, BLOCK: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    off = (pid % S) * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + row * N + off).to(tl.float32)\n    tl.store(PM + pid, tl.sum(x) / N)\n    tl.store(PV + pid, tl.sum(x * x) / N)\n\n\n@triton.jit\ndef _ln_apply(X, Y, PM, PV, N, eps, BLOCK: tl.constexpr, S: tl.constexpr, REV: tl.constexpr):\n    pid = tl.program_id(0)\n    if REV:\n        pid = tl.num_programs(0) - 1 - pid\n    row = pid // S\n    poff = row * S + tl.arange(0, S)\n    pm = tl.load(PM + poff)\n    pv = tl.load(PV + poff)\n    mean = tl.sum(pm) / S\n    var = tl.sum(pv) / S - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    off = (pid % S) * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + row * N + off).to(tl.float32)\n    tl.store(Y + row * N + off, (x - mean) * rstd)\nEOF\n"]
