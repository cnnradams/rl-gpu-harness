[1360.911187, "o", "S=128 W=16: 0.2967 ms maxdiff=2.86e-06\r\nS=128 W=32: 0.3002 ms maxdiff=2.26e-06\r\nS=256 W=16: 0.3136 ms maxdiff=4.65e-06\r\nS=256 W=32: 0.3082 ms maxdiff=3.93e-06\r\n"]
[1361.767992, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1422.889169, "i", "cat > /workspace/pdl4.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nN = 64*256*256\nrows = 16\n\n@triton.jit\ndef _ln2(X, Y, PMR, CNT, RDY, N, eps, CH: tl.constexpr, IT: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    base = row * N + (pid % S) * (CH * IT)\n    r = tl.arange(0, CH)\n    acc = tl.zeros((CH,), tl.float32)\n    acc2 = tl.zeros((CH,), tl.float32)\n    for i in tl.static_range(IT):\n        xx = tl.load(X + base + i * CH + r)\n        acc += xx\n        acc2 += xx * xx\n    pm = tl.sum(acc) / N\n    pv = tl.sum(acc2) / N\n    tl.atomic_add(PMR + row * 2, pm)\n    tl.atomic_add(PMR + row * 2 + 1, pv)\n    old = tl.atomic_add(CNT + row, 1, sem='acq_rel')\n    if old == S - 1:\n        m = tl.atomic_add(PMR + row * 2, 0.0, sem='acquire')\n        v = tl.atomic_add(PMR + row * 2 + 1, 0.0, sem='acquire')\n        var = v - m * m\n        rstd = 1.0 / tl.sq"]
[1422.889429, "i", "rt(var + eps)\n        tl.atomic_xchg(PMR + row * 2, m)\n        tl.atomic_xchg(PMR + row * 2 + 1, rstd)\n        tl.atomic_xchg(RDY + row, 1, sem='release')\n    ok = tl.zeros((), tl.int32)\n    while ok == 0:\n        ok = tl.atomic_add(RDY + row, 0, sem='acquire')\n    m2 = tl.atomic_add(PMR + row * 2, 0.0, sem='acquire')\n    r2 = tl.atomic_add(PMR + row * 2 + 1, 0.0, sem='acquire')\n    for i in tl.static_range(IT):\n        xx = tl.load(X + base + i * CH + r)\n        tl.store(Y + base + i * CH + r, (xx - m2) * r2)\n\nfor S, CH, IT in [(64, 16384, 4), (64, 8192, 8), (128, 8192, 4), (128, 16384, 2), (256, 8192, 2)]:\n    for W in [8, 16]:\n        pmr = torch.zeros(rows*2, device='cuda')\n        rdy = torch.zeros(rows, dtype=torch.int32, device='cuda')\n        cnt = torch.zeros(rows, dtype=torch.int32, device='cuda')\n        def pipe():\n            cnt.zero_(); rdy.zero_(); pmr.zero_()\n            _ln2[(rows*S,)](x.view(-1), y.view(-1), pmr, cnt, rdy, N, 1e-5, CH=CH, IT=IT, S=S, num_warps=W)\n        pipe()\n        torc"]
[1422.889451, "i", "h.cuda.synchronize()\n        xr = x.view(rows, -1)\n        mean = xr.mean(1, keepdim=True)\n        var = xr.var(1, unbiased=False, keepdim=True)\n        oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\n        md = (y - oref).abs().max().item()\n        t = do_bench(pipe, warmup=10, rep=50)\n        print(f'S={S} CH={CH} IT={IT} W={W}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\nEOF\n"]
[1422.889529, "o", "cat > /workspace/pdl4.py << 'EOF'\r\n\u001b[?2004l\r"]
