[394.567007, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ntorch.manual_seed(42)\ndev = 'cuda'\ninit = get_init_inputs()\nref = Model(*init).to(dev)\nnew = ModelNew(*init).to(dev)\nwith torch.no_grad():\n    x = get_inputs()[0].to(dev)\n    o = ref(x)\n    o2 = new(x)\n    torch.cuda.synchronize()\n    print('maxdiff', (o - o2).abs().max().item())\n    for name, m in [('ref', ref), ('new', new)]:\n        ts = time_execution_with_cuda_event(m, [x], num_warmup=3, num_trials=30, discard_first=1, verbose=False, device=dev)\n        ts = sorted(ts)\n        print(name, 'mean', sum(ts)/len(ts), 'median', ts[len(ts)//2], 'min', ts[0])\nEOF\n"]
