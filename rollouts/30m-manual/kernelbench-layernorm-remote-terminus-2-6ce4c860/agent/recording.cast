[730.817527, "o", "> "]
[730.817569, "o", "            x = x.contiguous() if x.is_cuda else x\r\n\u001b[?2004l\r"]
[730.817594, "o", "\u001b[?2004h> "]
[730.817619, "o", "            if not x.is_cuda:\r\n\u001b[?2004l\r"]
[730.817643, "o", "\u001b[?2004h> "]
[730.817744, "o", "                return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[730.817766, "o", "> "]
[730.817789, "o", "        if self._fast is None:\r\n\u001b[?2004l\r"]
[730.817811, "o", "\u001b[?2004h> "]
[730.81786, "o", "            self._fast = self._identity_weights()\r\n\u001b[?2004l\r"]
[730.817885, "o", "\u001b[?2004h> "]
[730.817907, "o", "            if not self._fast:\r\n\u001b[?2004l\r"]
[730.817931, "o", "\u001b[?2004h> "]
[730.817966, "o", "                self._graphs = None\r\n\u001b[?2004l\r"]
[730.817991, "o", "\u001b[?2004h> "]
[730.818015, "o", "        if not self._fast:\r\n\u001b[?2004l\r"]
[730.818035, "o", "\u001b[?2004h> "]
[730.818133, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[730.818197, "o", "        key = (x.data_ptr(), x.shape, x.dtype)\r\n\u001b[?2004l\r\u001b[?2004h"]
[730.818224, "o", "> "]
[730.818249, "o", "        g = self._graphs.get(key)\r\n\u001b[?2004l\r"]
[730.818273, "o", "\u001b[?2004h> "]
[730.818296, "o", "        if g is not None:\r\n\u001b[?2004l\r"]
[730.818321, "o", "\u001b[?2004h> "]
[730.81835, "o", "            g.replay()\r\n\u001b[?2004l\r\u001b[?2004h"]
[730.818373, "o", "> "]
[730.8184, "o", "            return self._outs[key]\r\n\u001b[?2004l\r"]
[730.818425, "o", "\u001b[?2004h> "]
[730.818452, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[730.818473, "o", "\u001b[?2004h> "]
[730.8185, "o", "        self._run_eager(x, y)\r\n\u001b[?2004l\r"]
[730.818522, "o", "\u001b[?2004h> "]
[730.818558, "o", "        if len(self._graphs) < 8:\r\n\u001b[?2004l\r"]
[730.818579, "o", "\u001b[?2004h> "]
[730.818604, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[730.818654, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[730.818675, "o", "\u001b[?2004h> "]
[730.818719, "o", "                gr = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[730.818747, "o", "\u001b[?2004h> "]
[730.818782, "o", "                with torch.cuda.graph(gr):\r\n\u001b[?2004l\r"]
[730.818805, "o", "\u001b[?2004h> "]
[730.818845, "o", "                    self._run_eager(x, y)\r\n\u001b[?2004l\r"]
[730.818866, "o", "\u001b[?2004h> "]
[730.818905, "o", "                self._graphs[key] = gr\r\n\u001b[?2004l\r"]
[730.818932, "o", "\u001b[?2004h> "]
[730.818963, "o", "                self._outs[key] = y\r\n\u001b[?2004l\r"]
[730.818988, "o", "\u001b[?2004h> "]
[730.819013, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[730.819037, "o", "\u001b[?2004h> "]
[730.819069, "o", "                self._graphs = {}\r\n\u001b[?2004l\r"]
[730.819093, "o", "\u001b[?2004h> "]
[730.819113, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[730.819138, "o", "EOF\r\n\u001b[?2004l\r"]
