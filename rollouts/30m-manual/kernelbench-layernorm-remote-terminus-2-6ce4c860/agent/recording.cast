[1221.329429, "o", "S=128 CH=8192 IT=4 WS=8 WA=16: 0.2781 ms maxdiff=9.54e-07\r\nS=128 CH=8192 IT=4 WS=8 WA=32: 0.2773 ms maxdiff=9.54e-07\r\n"]
[1222.07742, "o", "S=128 CH=16384 IT=2 WS=16 WA=16: 0.2779 ms maxdiff=9.54e-07\r\nS=128 CH=16384 IT=2 WS=16 WA=32: 0.2781 ms maxdiff=9.54e-07\r\nS=64 CH=16384 IT=4 WS=16 WA=16: 0.3340 ms maxdiff=8.34e-07\r\nS=64 CH=16384 IT=4 WS=16 WA=32: 0.3221 ms maxdiff=8.34e-07\r\n"]
[1222.824941, "o", "S=64 CH=8192 IT=8 WS=8 WA=16: 0.3228 ms maxdiff=9.54e-07\r\nS=64 CH=8192 IT=8 WS=8 WA=32: 0.3123 ms maxdiff=9.54e-07\r\n"]
