[1285.772881, "i", "cat > /workspace/pdl3.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nN = 64*256*256\nrows = 16\n\n@triton.jit\ndef _ln1(X, Y, PMR, CNT, MR, N, eps, BLK: tl.constexpr, S: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    seg = pid % S\n    base = row * N + seg * BLK\n    r = tl.arange(0, BLK)\n    xs_ = tl.load(X + base + r)\n    pm = tl.sum(xs_) / N\n    pv = tl.sum(xs_ * xs_) / N\n    tl.atomic_add(PMR + row * 2, pm)\n    tl.atomic_add(PMR + row * 2 + 1, pv)\n    old = tl.atomic_add(CNT + row, 1, sem='acq_rel')\n    if old == S - 1:\n        m = tl.load(PMR + row * 2)\n        v = tl.load(PMR + row * 2 + 1)\n        var = v - m * m\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.atomic_xchg(MR + row * 2, m)\n        tl.atomic_xchg(MR + row * 2 + 1, rstd)\n    m2 = tl.zeros((), tl.float32)\n    r2 = tl.zeros((), tl.float32)\n    if old == S - 1:\n        m2 = tl.load(MR + row * 2"]
[1285.772931, "i", ")\n        r2 = tl.load(MR + row * 2 + 1)\n    else:\n        ok = tl.zeros((), tl.int32)\n        while ok == 0:\n            ok = tl.atomic_add(CNT + row, 0, sem='acquire') == (2 * S - 1)\n        m2 = tl.load(MR + row * 2)\n        r2 = tl.load(MR + row * 2 + 1)\n    tl.store(Y + base + r, (xs_ - m2) * r2)\n\nfor S in [64, 128]:\n    BLK = N // S\n    for W in [16, 32]:\n        pmr = torch.zeros(rows*2, device='cuda')\n        mr = torch.zeros(rows*2, device='cuda')\n        cnt = torch.zeros(rows, dtype=torch.int32, device='cuda')\n        def pipe():\n            cnt.zero_()\n            pmr.zero_()\n            _ln1[(rows*S,)](x.view(-1), y.view(-1), pmr, cnt, mr, N, 1e-5, BLK=BLK, S=S, num_warps=W)\n        pipe()\n        torch.cuda.synchronize()\n        xr = x.view(rows, -1)\n        mean = xr.mean(1, keepdim=True)\n        var = xr.var(1, unbiased=False, keepdim=True)\n        oref = (x - mean.view(16,1,1,1)) / torch.sqrt(var.view(16,1,1,1) + 1e-5)\n        md = (y - oref).abs().max().item()\n        t = do_bench(pipe, warm"]
[1285.773047, "i", "up=10, rep=50)\n        print(f'S={S} W={W}: {t:.4f} ms maxdiff={md:.2e}', flush=True)\nEOF\n"]
[1285.773201, "o", "cat > /workspace/pdl3.py << 'EOF'\r\n\u001b[?2004l\r"]
[1285.773233, "o", "\u001b[?2004h> "]
