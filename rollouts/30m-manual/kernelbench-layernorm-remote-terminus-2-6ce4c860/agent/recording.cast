[850.536507, "o", "> "]
[850.536525, "o", "    for CH in [2048, 4096, 8192, 16384]:\r\n\u001b[?2004l\r"]
[850.536567, "o", "\u001b[?2004h> "]
[850.536621, "o", "        if N % (S*CH) != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.536652, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.536683, "o", "        IT = N // (S*CH)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.536714, "o", "        for W in [4, 8, 16]:\r\n\u001b[?2004l\r"]
[850.536745, "o", "\u001b[?2004h> "]
