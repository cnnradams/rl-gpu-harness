[1156.523991, "o", "triton/compiler/compiler.py\", line 80, in make_ir\r\n    return ast_to_ttir(self.fn, self, context=context, options=options, codegen_fns=codegen_fns,\r\ntriton.compiler.errors.CompilationError: at 9:4:\r\ndef _apply_pdl2(X, Y, PM, PV, CNT, N, eps, BLK: tl.constexpr, S: tl.constexpr):\r\n    pid = tl.program_id(0)\r\n    row = pid // S\r\n    base = row * N + (pid % S) * BLK\r\n    r = tl.arange(0, BLK)\r\n    xs_ = tl.load(X + base + r)\r\n    gdc_wait()\r\n    done = 0\r\n    while done == 0:\r\n    ^\r\nAssertionError('Loop-carried variable done has initial type int32 but is re-assigned to int1 in loop! Please make sure that the type stays consistent.')\r\n"]
