[736.852028, "i", "cat >> /workspace/bench.py << 'EOF'\n\nwith torch.no_grad():\n    torch.cuda.synchronize()\n    import time\n    for _ in range(3):\n        new(x)\n    torch.cuda.synchronize()\n    t0 = time.perf_counter()\n    R = 200\n    for _ in range(R):\n        new(x)\n    torch.cuda.synchronize()\n    t1 = time.perf_counter()\n    print('hot replay ms per call (wall):', (t1-t0)/R*1000)\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    torch.cuda.synchronize()\n    s.record()\n    for _ in range(R):\n        new(x)\n    e.record()\n    torch.cuda.synchronize()\n    print('hot replay ms per call (events, back-to-back):', s.elapsed_time(e)/R)\nEOF\n"]
