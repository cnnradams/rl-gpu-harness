[850.537218, "o", "                _ln_apply[(rows*S,)](x.view(-1), y.view(-1), pm, pv, N, 1e-5, CH=CH, IT=IT, S=S, REV=True, num_warps=W)\r\n\u001b[?2004l\r"]
