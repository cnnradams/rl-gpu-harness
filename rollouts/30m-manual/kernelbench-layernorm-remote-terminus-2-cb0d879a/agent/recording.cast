[119.298331, "o", "\u001b[?2004h> "]
[119.29838, "o", "x = torch.rand(16, 64, 256, 256, device=dev)\r\n\u001b[?2004l\r"]
[119.298409, "o", "\u001b[?2004h> "]
[119.298437, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.298465, "o", ">     ref = m(x)\r\n\u001b[?2004l\r"]
[119.298494, "o", "\u001b[?2004h> "]
[119.298524, "o", "    out = m2(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.298582, "o", "print('max diff', (ref - out).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.298606, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.29864, "o", "def bench(f, n=50):\r\n\u001b[?2004l\r"]
[119.298666, "o", "\u001b[?2004h> "]
[119.298695, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[119.298721, "o", "\u001b[?2004h>         f(x)\r\n\u001b[?2004l\r"]
[119.298753, "o", "\u001b[?2004h> "]
[119.298781, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[119.298811, "o", "\u001b[?2004h> "]
[119.29884, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.298879, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.298909, "o", "> "]
[119.298935, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.298965, "o", "> "]
[119.299048, "o", "        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[119.299075, "o", "\u001b[?2004h> "]
[119.299166, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[119.299192, "o", "\u001b[?2004h> "]
[119.299228, "o", "        s.record(); f(x); e.record()\r\n\u001b[?2004l\r"]
[119.299258, "o", "\u001b[?2004h> "]
[119.299283, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[119.299313, "o", "\u001b[?2004h> "]
[119.299348, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[119.299378, "o", "\u001b[?2004h> "]
[119.299407, "o", "    times = times[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.299459, "o", "    return sum(times)/len(times), min(times)\r\n\u001b[?2004l\r"]
[119.29952, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r"]
[119.299549, "o", "\u001b[?2004h>     r = bench(m)\r\n\u001b[?2004l\r"]
[119.299576, "o", "\u001b[?2004h> "]
