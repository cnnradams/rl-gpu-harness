[248.345238, "i", "cat > /workspace/solution.py << 'EOF'\nimport os\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n_NC = int(os.environ.get('LN_NUM_CHUNKS', '64'))\n_NW = int(os.environ.get('LN_NUM_WARPS', '8'))\n\n\n@triton.jit\ndef _ln_stats_kernel(x_ptr, partials_ptr, N, num_chunks, CHUNK, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // num_chunks\n    chunk = pid % num_chunks\n    start = row * N + chunk * CHUNK\n    offs = tl.arange(0, BLOCK)\n    acc = tl.zeros((BLOCK,), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for i in range(0, CHUNK, BLOCK):\n        v = tl.load(x_ptr + start + i + offs)\n        acc += v\n        acc2 += v * v\n    s = tl.sum(acc, axis=0)\n    s2 = tl.sum(acc2, axis=0)\n    tl.store(partials_ptr + row * num_chunks * 2 + chunk * 2 + 0, s)\n    tl.store(partials_ptr + row * num_chunks * 2 + chunk * 2 + 1, s2)\n\n\n@triton.jit\ndef _ln_norm_kernel(x_ptr, w_ptr, b_ptr, y_ptr, partials_ptr, N, num_chunks, eps,\n                    CHUNK, BLOCK: tl.con"]
[248.345286, "i", "stexpr, NP2: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // num_chunks\n    chunk = pid % num_chunks\n    poffs = tl.arange(0, NP2)\n    pmask = poffs < num_chunks\n    s = tl.load(partials_ptr + row * num_chunks * 2 + poffs * 2 + 0, mask=pmask, other=0.0)\n    s2 = tl.load(partials_ptr + row * num_chunks * 2 + poffs * 2 + 1, mask=pmask, other=0.0)\n    mean = tl.sum(s, axis=0) / N\n    mean2 = tl.sum(s2, axis=0) / N\n    var = mean2 - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    start = row * N + chunk * CHUNK\n    offs = tl.arange(0, BLOCK)\n    for i in range(0, CHUNK, BLOCK):\n        idx = start + i + offs\n        v = tl.load(x_ptr + idx)\n        w = tl.load(w_ptr + chunk * CHUNK + i + offs)\n        b = tl.load(b_ptr + chunk * CHUNK + i + offs)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + idx, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super(ModelNew, self).__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n"]
[248.345437, "i", "        self._partials = None\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        x = x.contiguous()\n        N = 1\n        for d in self.ln.normalized_shape:\n            N *= d\n        B = x.numel() // N\n        num_chunks = _NC\n        CHUNK = N // num_chunks\n        BLOCK = 8192\n        while CHUNK % BLOCK != 0 and BLOCK > 256:\n            BLOCK //= 2\n        w = self.ln.weight.reshape(-1)\n        b = self.ln.bias.reshape(-1)\n        y = torch.empty_like(x)\n        if self._partials is None or self._partials.shape[0] < B * num_chunks * 2 or self._partials.device != x.device:\n            self._partials = torch.empty(B * num_chunks * 2, dtype=torch.float32, device=x.device)\n        partials = self._partials\n        grid = (B * num_chunks,)\n        _ln_stats_kernel[grid](x, partials, N, num_chunks, CHUNK, BLOCK, num_warps=_NW)\n        _ln_norm_kernel[grid](x, w, b, y, partials, N, num_chunks, self.ln.eps, CHUNK, BLOCK, NP2=triton.next_power_of_2(num_chunks), num_warps=_NW)\n        return y\nEOF\ncat"]
[248.345496, "i", " > /workspace/sweep.py << 'EOF'\nimport os, importlib, torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\n\ndev = 'cuda'\nm = Model(*get_init_inputs()).to(dev)\nx = torch.rand(16, 64, 256, 256, device=dev)\nwith torch.no_grad():\n    ref = m(x)\n\ndef bench(f, n=30):\n    for _ in range(5):\n        f(x)\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); f(x); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times)\n\nimport solution\nfor nc in [32, 64, 128, 256]:\n    for nw in [4, 8, 16]:\n        solution._NC = nc; solution._NW = nw\n        m2 = solution.ModelNew(*get_init_inputs()).to(dev)\n        with torch.no_grad():\n            out = m2(x)"]
[248.345542, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[248.345583, "i", "\n            diff = (ref - out).abs().max().item()\n            t = bench(m2)\n        print(f'nc={nc} nw={nw} diff={diff:.2e} t={t:.4f} ms')\nEOF\ngpu push sb-i2miFDDkSuPpeSXN5Hqxdp /workspace/solution.py /workspace/solution.py && gpu push sb-i2miFDDkSuPpeSXN5Hqxdp /workspace/sweep.py /workspace/sweep.py\n"]
