[118.878338, "o", "\u001b[?2004h> "]
[118.878361, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.878396, "o", "        acc2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.878426, "o", "> "]
[118.878453, "o", "    s = tl.sum(acc, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.878485, "o", "> "]
[118.87852, "o", "    s2 = tl.sum(acc2, axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.878601, "o", "    tl.store(partials_ptr + row * num_chunks * 2 + chunk * 2 + 0, s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.878632, "o", "> "]
[118.878699, "o", "    tl.store(partials_ptr + row * num_chunks * 2 + chunk * 2 + 1, s2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.878734, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.878761, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.878789, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.87889, "o", "def _ln_norm_kernel(x_ptr, w_ptr, b_ptr, y_ptr, partials_ptr, N, num_chunks, eps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.878921, "o", "> "]
[118.878982, "o", "                    CHUNK, BLOCK: tl.constexpr, NP2: tl.constexpr):\r\n\u001b[?2004l\r"]
[118.879017, "o", "\u001b[?2004h> "]
[118.879044, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.87907, "o", "> "]
[118.879096, "o", "    row = pid // num_chunks\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.879124, "o", "> "]
[118.879157, "o", "    chunk = pid % num_chunks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.879205, "o", "    poffs = tl.arange(0, NP2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.879233, "o", "> "]
[118.879258, "o", "    pmask = poffs < num_chunks\r\n\u001b[?2004l\r"]
[118.879284, "o", "\u001b[?2004h> "]
[118.87939, "o", "    s = tl.load(partials_ptr + row * num_chunks * 2 + poffs * 2 + 0, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[118.879417, "o", "\u001b[?2004h> "]
[118.879516, "o", "    s2 = tl.load(partials_ptr + row * num_chunks * 2 + poffs * 2 + 1, mask=pmask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.879546, "o", "> "]
[118.879572, "o", "    mean = tl.sum(s, axis=0) / N\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.879603, "o", "> "]
[118.879625, "o", "    mean2 = tl.sum(s2, axis=0) / N\r\n\u001b[?2004l\r"]
[118.879656, "o", "\u001b[?2004h> "]
[118.879685, "o", "    var = mean2 - mean * mean\r\n\u001b[?2004l\r"]
[118.879719, "o", "\u001b[?2004h> "]
[118.879754, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[118.87979, "o", "\u001b[?2004h> "]
[118.879825, "o", "    start = row * N + chunk * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.879851, "o", "> "]
[118.879877, "o", "    offs = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.879903, "o", "> "]
[118.879929, "o", "    for i in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[118.87996, "o", "\u001b[?2004h> "]
[118.879988, "o", "        idx = start + i + offs\r\n\u001b[?2004l\r"]
[118.880017, "o", "\u001b[?2004h> "]
[118.880044, "o", "        v = tl.load(x_ptr + idx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880072, "o", "> "]
[118.880122, "o", "        w = tl.load(w_ptr + chunk * CHUNK + i + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880147, "o", "> "]
[118.880201, "o", "        b = tl.load(b_ptr + chunk * CHUNK + i + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880231, "o", "> "]
[118.880256, "o", "        y = (v - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[118.880283, "o", "\u001b[?2004h> "]
[118.880331, "o", "        tl.store(y_ptr + idx, y)\r\n\u001b[?2004l\r"]
[118.880356, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880382, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.880418, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[118.880447, "o", "\u001b[?2004h> "]
[118.88049, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[118.880515, "o", "\u001b[?2004h> "]
[118.880555, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880589, "o", "> "]
[118.880646, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880671, "o", "> "]
[118.880703, "o", "        self._partials = None\r\n\u001b[?2004l\r"]
[118.880737, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.8808, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[118.880827, "o", "\u001b[?2004h> "]
[118.880858, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.8809, "o", "        orig_shape = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.880925, "o", "> "]
[118.881087, "o", "        N = self.ln.normalized_shape.numel() if hasattr(self.ln.normalized_shape, 'numel') else int(torch.tensor(self.ln.normalized_shape).prod())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.881127, "o", "        B = x.numel() // N\r\n\u001b[?2004l\r"]
[118.881156, "o", "\u001b[?2004h> "]
[118.881187, "o", "        num_chunks = 64\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.881218, "o", "> "]
[118.881247, "o", "        CHUNK = N // num_chunks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.881272, "o", "        BLOCK = 4096\r\n\u001b[?2004l\r"]
[118.8813, "o", "\u001b[?2004h> "]
[118.881343, "o", "        while CHUNK % BLOCK != 0 and BLOCK > 256:\r\n\u001b[?2004l\r"]
[118.881371, "o", "\u001b[?2004h> "]
[118.881399, "o", "            BLOCK //= 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.881449, "o", "        w = self.ln.weight.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.881477, "o", "> "]
[118.881501, "o", "        b = self.ln.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[118.881526, "o", "\u001b[?2004h> "]
[118.881565, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.881594, "o", "> "]
[118.881708, "o", "        if self._partials is None or self._partials.shape[0] < B * num_chunks * 2 or self._partials.device != x.device:\r\n\u001b[?2004l\r"]
[118.881736, "o", "\u001b[?2004h> "]
[118.881839, "o", "            self._partials = torch.empty(B * num_chunks * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r"]
[118.881869, "o", "\u001b[?2004h> "]
[118.881898, "o", "        partials = self._partials\r\n\u001b[?2004l\r"]
[118.881924, "o", "\u001b[?2004h> "]
[118.881952, "o", "        grid = (B * num_chunks,)\r\n\u001b[?2004l\r"]
[118.881977, "o", "\u001b[?2004h> "]
[118.88205, "o", "        _ln_stats_kernel[grid](x, partials, N, num_chunks, CHUNK, BLOCK)\r\n\u001b[?2004l\r"]
[118.882078, "o", "\u001b[?2004h> "]
[118.882216, "o", "        _ln_norm_kernel[grid](x, w, b, y, partials, N, num_chunks, self.ln.eps, CHUNK, BLOCK, NP2=triton.next_power_of_2(num_chunks))\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.882255, "o", ">         return y\r\n\u001b[?2004l\r"]
[118.882283, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[118.884086, "o", "\u001b[?2004hroot@modal:/workspace# "]
[118.884102, "o", "echo written\r\n\u001b[?2004l\r"]
[118.884143, "o", "written\r\n\u001b[?2004hroot@modal:/workspace# "]
[119.297488, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\n\ndev = 'cuda'\ntorch.manual_seed(42)\nm = Model(*get_init_inputs()).to(dev)\nm2 = ModelNew(*get_init_inputs()).to(dev)\nx = torch.rand(16, 64, 256, 256, device=dev)\nwith torch.no_grad():\n    ref = m(x)\n    out = m2(x)\nprint('max diff', (ref - out).abs().max().item())\n\ndef bench(f, n=50):\n    for _ in range(5):\n        f(x)\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); f(x); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times), min(times)\n\nwith torch.no_grad():\n    r = bench(m)\n    c = bench(m2)\nprint("]
[119.297633, "i", "f'ref mean {r[0]:.4f} ms min {r[1]:.4f}')\nprint(f'new mean {c[0]:.4f} ms min {c[1]:.4f}')\nprint(f'speedup {r[0]/c[0]:.2f}')\nEOF\necho written\n"]
[119.297829, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[119.297898, "o", "\u001b[?2004h> import torch, time, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.29793, "o", "sys.path.insert(0, '/opt/task')\r\n\u001b[?2004l\r"]
[119.297957, "o", "\u001b[?2004h> "]
