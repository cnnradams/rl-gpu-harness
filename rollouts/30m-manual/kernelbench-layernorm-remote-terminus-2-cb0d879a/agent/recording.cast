[119.298043, "o", "\u001b[?2004h> "]
[119.298073, "o", "from solution import ModelNew\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[119.298099, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[119.298127, "o", "dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.298168, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.298194, "o", "> "]
[119.298243, "o", "m = Model(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.298277, "o", "> "]
