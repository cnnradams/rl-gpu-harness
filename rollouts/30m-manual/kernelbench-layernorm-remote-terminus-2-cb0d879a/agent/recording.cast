[328.772959, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport os, importlib, torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\n\ndev = 'cuda'\nm = Model(*get_init_inputs()).to(dev)\nx = torch.rand(16, 64, 256, 256, device=dev)\nwith torch.no_grad():\n    ref = m(x)\n\ndef bench(f, n=30):\n    for _ in range(5):\n        f(x)\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        d = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); f(x); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times)\n\nimport solution\nfor nc in [4, 8, 16, 32]:\n    for nw in [16, 32]:\n        solution._NC = nc; solution._NW = nw\n        m2 = solution.ModelNew(*get_init_inputs()).to(dev)\n        with torch.no_grad():\n            out = m2(x)\n "]
[328.773006, "i", "           diff = (ref - out).abs().max().item()\n            t = bench(m2)\n        print(f'nc={nc} nw={nw} diff={diff:.2e} t={t:.4f} ms')\nEOF\ngpu push sb-i2miFDDkSuPpeSXN5Hqxdp /workspace/sweep2.py /workspace/sweep2.py\n"]
