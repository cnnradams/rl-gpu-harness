[119.299669, "o", "print(f'ref mean {r[0]:.4f} ms min {r[1]:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.2997, "o", "> "]
[119.299745, "o", "print(f'new mean {c[0]:.4f} ms min {c[1]:.4f}')\r\n\u001b[?2004l\r"]
