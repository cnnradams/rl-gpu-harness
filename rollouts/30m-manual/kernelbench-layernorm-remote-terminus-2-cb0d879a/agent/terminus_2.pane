[?2004luous()
        orig_shape = x.shape
        N = self.ln.normalized_shape.numel() if hasattr(self.ln.normalized_shape, 'numel') else int(torch.tensor(self.ln.normalized_shape).prod())
        B = x.numel() // N
        num_chunks = 64
        CHUNK = N // num_chunks
        BLOCK = 4096
        while CHUNK % BLOCK != 0 and BLOCK > 256:
            BLOCK //= 2
        w = self.ln.weight.reshape(-1)
        b = self.ln.bias.reshape(-1)
        y = torch.empty_like(x)
        if self._partials is None or self._partials.shape[0] < B * num_chunks * 2 or self._partials.device != x.device:
            self._partials = torch.empty(B * num_chunks * 2, dtype=torch.float32, device=x.device)
        partials = self._partials
        grid = (B * num_chunks,)
        _ln_stats_kernel[grid](x, partials, N, num_chunks, CHUNK, BLOCK)
        _ln_norm_kernel[grid](x, w, b, y, partials, N, num_chunks, self.ln.eps, CHUNK, BLOCK, NP2=triton.next_power_of_2(num_chunks))
        return y
