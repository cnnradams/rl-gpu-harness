[1172.652345, "o", "368-\r\n369-\r\n370:def _process_input_tensor(input, device, backend=\"cuda\", precision=torch.float32):\r\n371-    \"\"\"\r\n372-    Helper function to move tensors to the correct device and apply backend-specific dtype casting.\r\n373-    \r\n374-    Args:\r\n375-        input: Input tensor or non-tensor value\r\n376-        device: Target CUDA device\r\n377-        backend: Backend type (e.g., 'cuda', 'triton', 'cute')\r\n378-        precision: torch.dtype \r\n379-    Returns:\r\n380-        Processed tensor on correct device with correct dtype, or original value if not a tensor\r\n381-    \"\"\"\r\n382-\r\n383-    # sometimes things like init inputs are floats (like in the case of labels / targets, classification losses, etc.) \r\n384-    if not isinstance(input, torch.Tensor):\r\n385-        return input\r\n386-    \r\n387-    # cast to the desired percision dtype for activations\r\n388-    input_tensor = input.to(dtype=precision)\r\n389-    \r\n390-    # Default for all other backends and float types\r\n391-    return input_tensor.to(device=device)\r\n392-\r\n"]
[1172.652388, "o", "393-\r\n394-def eval_kernel_against_ref(\r\n395-    original_model_src: str,\r\n396-    custom_model_src: str,\r\n397-    seed_num: int = 42,\r\n398-    num_correct_trials: int = 1,\r\n399-    num_perf_trials: int = 10,\r\n400-    measure_performance: bool = False,\r\n401-    timing_method: str = \"cuda_event\", # see timing.py\r\n402-    verbose: bool = False,\r\n403-    build_dir: os.PathLike = None,\r\n404-    device: Union[torch.device, int] = (\r\n405-        torch.cuda.current_device() if torch.cuda.is_available() else None\r\n406-    ),  # have to run on GPU\r\n407-    backend: str = \"cuda\",  # can be 'cuda', 'triton', 'tilelang', or 'cute'\r\n408-    precision: torch.dtype = torch.float32,\r\n409-\r\n410-    # Guard against potential reward hacking [optional but ongoing enhancement]\r\n--\r\n493-    \r\n494-    # Convert inputs to appropriate dtypes for GPU computation\r\n495:    init_inputs = [_process_input_tensor(x, device, backend, precision) for x in init_inputs]\r\n496-    \r\n497-    with torch.no_grad():\r\n498-        set_seed(seed_num)  # s"]
[1172.652416, "o", "et seed for reproducible weights\r\n499-        original_model = Model(*init_inputs)\r\n500-        assert hasattr(original_model, \"forward\")\r\n501-        if verbose:\r\n502-            print(\"[Eval] Original Model Loaded\")\r\n503-    \r\n504-    if verbose:\r\n505-        print(\"[Eval] Loading and Compiling New Model with Custom CUDA Kernel\")\r\n506-\r\n507-    # this is where compilation happens\r\n508-    try:\r\n509-        os.environ[\"TORCH_USE_CUDA_DSA\"] = \"1\"  # compile with device side assertion\r\n510-        tempfile = None\r\n511-        # add hash for later to distinguish between multi-turn kernels\r\n512-        \r\n513-        backend_lower = backend.lower()\r\n514-        if backend_lower in [\"triton\", \"tilelang\", \"cute\"]:\r\n515-            # Use tempfile approach for triton, tilelang, and cute\r\n516-            # These DSLs require proper module import for JIT decorators to work\r\n517-            ModelNew, tempfile = load_custom_model_with_tempfile(\r\n518-                custom_model_src, entry_point=\"ModelNew\"\r\n519-          "]
[1172.65244, "o", "  )\r\n520-        else:\r\n521-            # Default CUDA backend\r\n522-            ModelNew = load_custom_model(custom_model_src, context, build_dir)\r\n523-        torch.cuda.synchronize(device=device)  # not sure if this is too much\r\n524-    except Exception as e:\r\n525-        print(\r\n526-            f\"Failed to compile custom CUDA kernel: Record as compilation failure. \\nError: {e}\"\r\n527-        )\r\n528-        # TODO: add metadata for compilation error (how to we get the compilation error message?)\r\n"]
