[1100.919276, "i", "cat > /workspace/dbg8.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew, _split_gemm_kernel, _split_linear\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nwt = model._prep(); b = model.matmul.bias.detach()\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\ny64 = (x.double() @ wt.double() + b.double()) * 0.5\n# direct call through autotuner interface (as eval does)\ny = _split_linear(x, wt, b, 0.5)\ntorch.cuda.synchronize()\nprint('autotuner path err:', (y.double()-y64).abs().max().item())\nprint('chosen config:', _split_gemm_kernel.best_config)\ny2 = _split_linear(x, wt, b, 0.5)\ntorch.cuda.synchronize()\nprint('second call err:', (y2.double()-y64).abs().max().item())\nEOF\n"]
