[1175.924742, "o", "\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef _process_input_tensor\u001b[m\u001b[K(input, device, backend=\"cuda\", precision=torch.float32):\r\n\u001b[32m\u001b[K371\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K372\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Helper function to move tensors to the correct device and apply backend-specific dtype casting.\r\n\u001b[32m\u001b[K373\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K374\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Args:\r\n\u001b[32m\u001b[K375\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        input: Input tensor or non-tensor value"]
[1175.924793, "o", "\r\n\u001b[32m\u001b[K376\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        device: Target CUDA device\r\n\u001b[32m\u001b[K377\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        backend: Backend type (e.g., 'cuda', 'triton', 'cute')\r\n\u001b[32m\u001b[K378\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        precision: torch.dtype \r\n\u001b[32m\u001b[K379\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Returns:\r\n\u001b[32m\u001b[K380\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        Processed tensor on correct device with correct dtype, or original value if not a tensor\r\n\u001b[32m\u001b[K381\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K382\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K383\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # sometimes things like init inputs are floats (like in the case of labels / targets, classification losses, etc.) \r\n\u001b[32m\u001b[K384\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if not isinstance(input, torch.Tensor):\r\n\u001b[32m\u001b[K385\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        return input\r\n\u001b[32m\u001b[K386\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K387\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # cast to the desired percision dtype for activations\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    input_tensor = input.to(dtype=precision)\r\n\u001b[32m\u001b[K389\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K390\u001b["]
[1175.924819, "o", "m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Default for all other backends and float types\r\n\u001b[32m\u001b[K391\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return input_tensor.to(device=device)\r\n\u001b[32m\u001b[K392\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K393\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kdef eval_kernel_against_ref(\r\n\u001b[32m\u001b[K395\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    original_model_src: str,\r\n\u001b[32m\u001b[K396\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    custom_model_src: str,\r\n"]
[1175.92485, "o", "\u001b[32m\u001b[K397\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    seed_num: int = 42,\r\n\u001b[32m\u001b[K398\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: int = 1,\r\n\u001b[32m\u001b[K399\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_perf_trials: int = 10,\r\n\u001b[32m\u001b[K400\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    measure_performance: bool = False,\r\n\u001b[32m\u001b[K401\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    timing_method: str = \"cuda_event\", # see timing.py\r\n\u001b[32m\u001b[K402\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    verbose: bool = False,\r\n\u001b[32m\u001b[K403\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    build_dir: os.PathLike = None,\r\n\u001b[32m\u001b[K404\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: Union[torch.device, int] = (\r\n\u001b[32m\u001b[K405\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.cuda.current_device() if torch.cuda.is_available() else None\r\n\u001b[32m\u001b[K406\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ),  # have to run on GPU\r\n\u001b[32m\u001b[K407\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str = \"cuda\",  # can be 'cuda', 'triton', 'tilelang', or 'cute'\r\n\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype = torch.float32,\r\n"]
