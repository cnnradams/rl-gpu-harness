[430.679081, "i", "cat > /workspace/dbg.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _split_linear\n\ntorch.manual_seed(0)\nM = K = N = 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(K, N, device='cuda') - 0.5) * 0.03\nb = torch.randn(N, device='cuda') * 0.01\n\ny64 = (x.double() @ w.double() + b.double())\nxh = x.half(); xl = (x - xh.float()).half()\nwh = w.half(); wl = (w - wh.float()).half()\ny_split = (xh @ wh).float() + (xh @ wl).float() + (xl @ wh).float() + b\nprint('torch split vs fp64: max', (y_split.double()-y64).abs().max().item())\ny_hi = (xh @ wh).float() + b\nprint('hi only vs fp64: max', (y_hi.double()-y64).abs().max().item())\ny_triton = _split_linear(x, w, b, 1.0)\nprint('triton vs fp64: max', (y_triton.double()-y64).abs().max().item())\nprint('triton vs torch split: max', (y_triton - y_split).abs().max().item())\nprint('triton vs hi only: max', (y_triton - y_hi).abs().max().item())\nEOF\n"]
