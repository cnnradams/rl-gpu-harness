[596.059031, "i", "cat > /workspace/dbg3.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport solution\nfrom solution import _split_linear, ModelNew\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nwt = model._prep()\nb = model.matmul.bias.detach()\n\ndef check(M, scale, tag):\n    x = torch.rand(M, 4096, device='cuda')\n    y64 = (x.double() @ wt.double() + b.double()) * scale\n    y = _split_linear(x, wt, b, scale)\n    print(f'{tag}: M={M} scale={scale} maxdiff={(y.double()-y64).abs().max().item():.6g}')\n\ncheck(4096, 1.0, 'direct')\ncheck(16384, 1.0, 'direct')\ncheck(4096, 0.5, 'direct')\ncheck(16384, 0.5, 'direct')\n\n# check determinism of full model\nx = torch.rand(16384, 4096, device='cuda')\nwith torch.no_grad():\n    y1 = model(x); y2 = model(x)\nprint('determinism:', (y1-y2).abs().max().item())\n# compare model path vs direct call\nwith torch.no_grad():\n    y3 = _split_linear(x.contiguous(), model._prep(), model.matmul.bias, 0.5)\nprint('model vs direct:', (y1-y3).abs().max().item())\nEOF\n"]
