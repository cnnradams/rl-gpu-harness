[969.755589, "o", "{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8} w=8 s=4: err=1.552e-05 time=3.689ms\r\n{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8} w=8 s=3: err=1.552e-05 time=3.743ms\r\n{'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8} w=8 s=3: err=1.552e-05 time=4.220ms\r\n{'BM': 256, 'BN': 64, 'BK': 64, 'GROUP_M': 8} w=8 s=3: err=1.552e-05 time=4.144ms\r\n{'BM': 64, 'BN': 128, 'BK': 64, 'GROUP_M': 8} w=4 s=4: err=1.552e-05 time=6.173ms\r\n{'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8} w=4 s=4: err=1.552e-05 time=6.012ms\r\n{'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8} w=4 s=4: err=1.558e-05 time=3.564ms\r\n{'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8} w=8 s=3: err=1.558e-05 time=43.604ms\r\n{'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8} w=8 s=2: err=1.552e-05 time=4.343ms\r\n{'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 8} w=8 s=4: err=1.558e-05 time=3.211ms\r\n{'BM': 64, 'BN': 256, 'BK': 32, 'GROUP_M': 8} w=4 s=4: err=1.558e-05 time=6.095ms\r\n"]
