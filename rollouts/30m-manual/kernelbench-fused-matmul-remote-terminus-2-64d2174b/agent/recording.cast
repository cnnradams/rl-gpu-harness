[822.569228, "i", "cat > /workspace/dbg5.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew, _split_gemm_kernel\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nwt = model._prep(); b = model.matmul.bias.detach()\n\nx16 = torch.rand(16384, 4096, device='cuda')\ny64 = (x16.double() @ wt.double() + b.double()) * 1.5\nwith torch.no_grad():\n    y_new = model(x16)\nprint('A: new (first) vs fp64:', (y_new.double()-y64).abs().max().item())\nprint('best config:', _split_gemm_kernel.best_config)\nwith torch.no_grad():\n    y_ref = torch.nn.functional.linear(x16, model.matmul.weight, model.matmul.bias)\n    y_ref = y_ref * 0.5 + y_ref\n    y_new2 = model(x16)\nprint('B: new (after ref) vs fp64:', (y_new2.double()-y64).abs().max().item())\nprint('ref vs fp64:', (y_ref.double()-y64).abs().max().item())\nx4 = torch.rand(4096, 4096, device='cuda')\ny644 = (x4.double() @ wt.double() + b.double()) * 1.5\nwith torch.no_grad():\n    y4 = model(x4)\nprint('C: M=4096 vs fp64:', (y4.double()-y644).abs().max()."]
