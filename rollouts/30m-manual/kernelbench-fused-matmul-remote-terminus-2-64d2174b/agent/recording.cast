[956.552851, "i", "cat > /workspace/dbg7.py << 'EOF'\nimport torch, sys, triton, time\nsys.path.insert(0, '/workspace')\nfrom solution import _split_gemm_kernel, ModelNew\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nwt = model._prep(); b = model.matmul.bias.detach()\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\ny64 = (x.double() @ wt.double() + b.double()) * 0.5\n\ncands = [\n    dict(BM=128, BN=128, BK=64, GROUP_M=8, num_warps=8, num_stages=4),\n    dict(BM=128, BN=128, BK=64, GROUP_M=8, num_warps=8, num_stages=3),\n    dict(BM=256, BN=128, BK=64, GROUP_M=8, num_warps=8, num_stages=3),\n    dict(BM=256, BN=64, BK=64, GROUP_M=8, num_warps=8, num_stages=3),\n    dict(BM=64, BN=128, BK=64, GROUP_M=8, num_warps=4, num_stages=4),\n    dict(BM=128, BN=64, BK=64, GROUP_M=8, num_warps=4, num_stages=4),\n    dict(BM=128, BN=128, BK=32, GROUP_M=8, num_warps=4, num_stages=4),\n    dict(BM=256, BN=256, BK=32, GROUP_M=8, num_warps=8, num_stages=3),\n    dict(BM=128, BN=256, BK=64, GROUP_M=8, num_warps=8, num_stages=2"]
[956.552898, "i", "),\n    dict(BM=256, BN=128, BK=32, GROUP_M=8, num_warps=8, num_stages=4),\n    dict(BM=64, BN=256, BK=32, GROUP_M=8, num_warps=4, num_stages=4),\n]\nfor cfg in cands:\n    kw = dict(cfg); nw = kw.pop('num_warps'); ns = kw.pop('num_stages')\n    try:\n        y = torch.empty((M, N), device='cuda', dtype=torch.float32)\n        grid = (triton.cdiv(M, kw['BM']) * triton.cdiv(N, kw['BN']),)\n        def call():\n            _split_gemm_kernel.fn.run(\n                x, wt, b, y, M, N, K,\n                x.stride(0), x.stride(1), wt.stride(0), wt.stride(1), y.stride(0), y.stride(1),\n                grid=grid, SCALE=0.5, warmup=False, num_warps=nw, num_stages=ns, **kw)\n        call(); torch.cuda.synchronize()\n        err = (y.double()-y64).abs().max().item()\n        for _ in range(3): call()\n        torch.cuda.synchronize()\n        t0 = time.perf_counter()\n        for _ in range(20): call()\n        torch.cuda.synchronize()\n        ms = (time.perf_counter()-t0)/20*1e3\n        print(f\"{kw} w={nw} s={ns}: err={err:.3e} time={m"]
[956.552904, "i", "s:.3f}ms\")\n    except Exception as e:\n        print(f\"{kw} w={nw} s={ns}: FAILED {type(e).__name__}\")\nEOF\n"]
