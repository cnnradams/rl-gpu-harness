[888.480453, "i", "cat > /workspace/dbg6.py << 'EOF'\nimport torch, sys, triton\nsys.path.insert(0, '/workspace')\nfrom solution import _split_gemm_kernel, ModelNew\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nwt = model._prep(); b = model.matmul.bias.detach()\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\ny64 = (x.double() @ wt.double() + b.double()) * 0.5\n\nfor cfg in _split_gemm_kernel.configs:\n    kw = dict(cfg.kwargs)\n    errs = []\n    for rep in range(2):\n        y = torch.empty((M, N), device='cuda', dtype=torch.float32)\n        grid = (triton.cdiv(M, kw['BM']) * triton.cdiv(N, kw['BN']),)\n        _split_gemm_kernel.fn.run(\n            x, wt, b, y, M, N, K,\n            x.stride(0), x.stride(1), wt.stride(0), wt.stride(1), y.stride(0), y.stride(1),\n            grid=grid, SCALE=0.5, warmup=False, num_warps=cfg.num_warps, num_stages=cfg.num_stages, **kw)\n        torch.cuda.synchronize()\n        errs.append(f'{(y.double()-y64).abs().max().item():.3e}')\n    print(kw, cfg.num_warps, cfg.num_stag"]
[888.480496, "i", "es, errs)\nEOF\n"]
