[1027.772254, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.772354, "o", "        if x.is_cuda and x.dtype == torch.float32 and w_t.dtype == torch.float32:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1027.772376, "o", "> "]
[1027.772465, "o", "            return _split_linear(x.contiguous(), w_t, b, float(self.scaling_factor))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.772557, "o", "        y = torch.nn.functional.linear(x, self.matmul.weight, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.772616, "o", "        return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h"]
