[755.155929, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[755.155956, "o", "\u001b[?2004h> "]
[755.156001, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[755.156026, "o", "\u001b[?2004h> "]
[755.156072, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.156096, "o", "> "]
[755.156153, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[755.156178, "o", "\u001b[?2004h> "]
[755.156251, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[755.156281, "o", "\u001b[?2004h> "]
[755.156333, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[755.156362, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.156392, "o", "> "]
[755.156427, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[755.156456, "o", "\u001b[?2004h> "]
[755.156492, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n"]
[755.15652, "o", "\u001b[?2004l\r"]
[755.156549, "o", "\u001b[?2004h> "]
[755.156573, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[755.156598, "o", "\u001b[?2004h> "]
[755.156626, "o", "    mask_m = rm < M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.156656, "o", "    mask_n = rn < N\r\n\u001b[?2004l\r"]
[755.156685, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[755.156713, "o", "\u001b[?2004h> "]
[755.156759, "o", "    x_ptrs = x_ptr + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[755.156787, "o", "\u001b[?2004h> "]
[755.156844, "o", "    w_ptrs = w_ptr + rk[:, None] * swk + rn[None, :] * swn\r\n\u001b[?2004l\r"]
[755.156872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[755.1569, "o", "\u001b[?2004h> "]
[755.15694, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[755.156969, "o", "\u001b[?2004h> "]
[755.157006, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n"]
[755.157037, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[755.157097, "o", "        mk = mask_m[:, None] & (rk[None, :] + k * BK < K)\r\n\u001b[?2004l\r"]
[755.157126, "o", "\u001b[?2004h> "]
[755.15717, "o", "        x = tl.load(x_ptrs, mask=mk, other=0.0)\r\n\u001b[?2004l\r"]
[755.157196, "o", "\u001b[?2004h> "]
[755.157254, "o", "        nk = (rk[:, None] + k * BK < K) & mask_n[None, :]\r\n\u001b[?2004l\r"]
[755.157278, "o", "\u001b[?2004h> "]
[755.157327, "o", "        w = tl.load(w_ptrs, mask=nk, other=0.0)\r\n\u001b[?2004l\r"]
[755.157354, "o", "\u001b[?2004h> "]
[755.157386, "o", "        x_hi = x.to(tl.float16)\r\n\u001b[?2004l\r"]
[755.157411, "o", "\u001b[?2004h> "]
[755.157467, "o", "        x_lo = (x - x_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[755.157494, "o", "\u001b[?2004h> "]
[755.157519, "o", "        w_hi = w.to(tl.float16)\r\n\u001b[?2004l\r"]
[755.157546, "o", "\u001b[?2004h> "]
[755.157615, "o", "        w_lo = (w - w_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[755.157646, "o", "\u001b[?2004h"]
[755.157671, "o", "> "]
[755.157697, "o", "        acc = tl.dot(x_hi, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.157746, "o", "        acc = tl.dot(x_hi, w_lo, acc)\r\n\u001b[?2004l\r"]
[755.157773, "o", "\u001b[?2004h> "]
[755.157809, "o", "        acc = tl.dot(x_lo, w_hi, acc)\r\n\u001b[?2004l\r"]
[755.157835, "o", "\u001b[?2004h> "]
[755.157865, "o", "        x_ptrs += BK * sxk\r\n\u001b[?2004l\r"]
[755.157891, "o", "\u001b[?2004h> "]
[755.157918, "o", "        w_ptrs += BK * swk\r\n\u001b[?2004l\r"]
[755.157946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.158016, "o", "    bias = tl.load(b_ptr + rn, mask=mask_n, other=0.0)\r\n\u001b[?2004l\r"]
[755.15804, "o", "\u001b[?2004h> "]
[755.158089, "o", "    acc = acc * SCALE + (SCALE * bias)[None, :]\r\n\u001b[?2004l\r"]
[755.158115, "o", "\u001b[?2004h> "]
[755.158174, "o", "    y_ptrs = y_ptr + rm[:, None] * sym + rn[None, :] * syn\r\n\u001b[?2004l\r"]
[755.158198, "o", "\u001b[?2004h> "]
[755.158265, "o", "    tl.store(y_ptrs, acc, mask=mask_m[:, None] & mask_n[None, :])\r\n\u001b[?2004l\r"]
[755.158289, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[755.158317, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.158345, "o", "> "]
[755.158373, "o", "def _split_linear(x, w_t, b, scale):\r\n\u001b[?2004l\r"]
[755.158402, "o", "\u001b[?2004h> "]
[755.158434, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.158458, "o", "    N = w_t.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.158483, "o", "> "]
[755.158546, "o", "    y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[755.15857, "o", "\u001b[?2004h> "]
[755.158659, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[755.158684, "o", "\u001b[?2004h> "]
[755.158712, "o", "    _split_gemm_kernel[grid](\r\n\u001b[?2004l\r"]
[755.158737, "o", "\u001b[?2004h> "]
[755.158767, "o", "        x, w_t, b, y, M, N, K,\r\n\u001b[?2004l\r"]
[755.158792, "o", "\u001b[?2004h> "]
[755.15889, "o", "        x.stride(0), x.stride(1), w_t.stride(0), w_t.stride(1), y.stride(0), y.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.158915, "o", "> "]
[755.158944, "o", "        SCALE=scale,\r\n\u001b[?2004l\r"]
[755.15897, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.159005, "o", ">     return y\r\n\u001b[?2004l\r"]
[755.159032, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.159058, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.159095, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[755.159119, "o", "\u001b[?2004h> "]
[755.159187, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[755.159216, "o", "\u001b[?2004h> "]
[755.15924, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[755.159265, "o", "\u001b[?2004h> "]
[755.159328, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[755.159354, "o", "\u001b[?2004h> "]
[755.159398, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[755.159423, "o", "\u001b[?2004h> "]
[755.159449, "o", "        self._wt = None\r\n\u001b[?2004l\r"]
[755.159477, "o", "\u001b[?2004h> "]
[755.159501, "o", "        self._key = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.159526, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.159553, "o", "> "]
[755.159578, "o", "    def _prep(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.159616, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[755.15964, "o", "\u001b[?2004h> "]
[755.159689, "o", "        key = (w.data_ptr(), w.device, w.dtype)\r\n\u001b[?2004l\r"]
[755.159717, "o", "\u001b[?2004h> "]
[755.159763, "o", "        if self._key != key or self._wt is None:\r\n\u001b[?2004l\r"]
[755.159787, "o", "\u001b[?2004h> "]
[755.15984, "o", "            self._wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[755.159868, "o", "\u001b[?2004h> "]
[755.159893, "o", "            self._key = key\r\n\u001b[?2004l\r"]
[755.159919, "o", "\u001b[?2004h> "]
[755.159942, "o", "        return self._wt\r\n\u001b[?2004l\r"]
[755.159967, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[755.159997, "o", "> "]
[755.160023, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.160052, "o", "> "]
[755.16008, "o", "        w_t = self._prep()\r\n\u001b[?2004l\r\u001b[?2004h"]
[755.160105, "o", "> "]
[755.160131, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[755.160231, "o", "        if x.is_cuda and x.dtype == torch.float32 and w_t.dtype == torch.float32:\r\n\u001b[?2004l\r"]
[755.160255, "o", "\u001b[?2004h> "]
[755.160346, "o", "            return _split_linear(x.contiguous(), w_t, b, float(self.scaling_factor))\r\n\u001b[?2004l\r"]
[755.16037, "o", "\u001b[?2004h> "]
[755.160439, "o", "        y = torch.nn.functional.linear(x, self.matmul.weight, b)\r\n\u001b[?2004l\r"]
[755.160464, "o", "\u001b[?2004h> "]
[755.16051, "o", "        return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[755.160538, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
