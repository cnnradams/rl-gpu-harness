[263.2945, "o", "def _split_gemm_kernel(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.29454, "o", "    x_ptr, w_ptr, b_ptr, y_ptr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.294578, "o", "    M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.294617, "o", "    sxm, sxk, swk, swn, sym, syn,\r\n\u001b[?2004l\r"]
[263.294657, "o", "\u001b[?2004h> "]
[263.294702, "o", "    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.294721, "o", "> "]
[263.294775, "o", "    GROUP_M: tl.constexpr, SCALE: tl.constexpr,\r\n\u001b[?2004l\r"]
[263.294817, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.294848, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.29489, "o", ">     num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[263.294943, "o", "\u001b[?2004h>     num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[263.294987, "o", "\u001b[?2004h> "]
[263.295027, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295068, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[263.295107, "o", "\u001b[?2004h> "]
[263.295145, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295207, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[263.295246, "o", "\u001b[?2004h> "]
[263.295299, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[263.295338, "o", "\u001b[?2004h> "]
[263.295379, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.295419, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295458, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.295498, "o", "> "]
[263.295537, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295581, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295601, "o", "    mask_m = rm < M\r\n\u001b[?2004l\r"]
[263.295642, "o", "\u001b[?2004h>     mask_n = rn < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.295683, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295738, "o", "    x_ptrs = x_ptr + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r"]
[263.295783, "o", "\u001b[?2004h> "]
[263.295827, "o", "    w_ptrs = w_ptr + rk[:, None] * swk + rn[None, :] * swn"]
[263.295867, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.295925, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[263.295965, "o", "\u001b[?2004h> "]
[263.296012, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[263.296053, "o", "\u001b[?2004h> "]
[263.296095, "o", "        mk = mask_m[:, None] & (rk[None, :] + k * BK < K)\r\n\u001b[?2004l\r"]
[263.296135, "o", "\u001b[?2004h> "]
[263.296175, "o", "        x = tl.load(x_ptrs, mask=mk, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.296243, "o", "        nk = (rk[:, None] + k * BK < K) & mask_n[None, :]\r\n\u001b[?2004l\r"]
[263.296282, "o", "\u001b[?2004h> "]
[263.29632, "o", "        w = tl.load(w_ptrs, mask=nk, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.296365, "o", "        x_hi = x.to(tl.float16)\r\n\u001b[?2004l\r"]
[263.296409, "o", "\u001b[?2004h> "]
[263.296448, "o", "        x_lo = (x - x_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.296488, "o", ">         w_hi = w.to(tl.float16)\r\n\u001b[?2004l\r"]
[263.296527, "o", "\u001b[?2004h> "]
[263.296574, "o", "        w_lo = (w - w_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[263.296614, "o", "\u001b[?2004h> "]
[263.296654, "o", "        acc = tl.dot(x_hi, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.296694, "o", "        acc = tl.dot(x_hi, w_lo, acc)\r\n\u001b[?2004l\r"]
[263.296734, "o", "\u001b[?2004h> "]
[263.296783, "o", "        acc = tl.dot(x_lo, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.296829, "o", "        x_ptrs += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.296848, "o", "        w_ptrs += BK * swk\r\n\u001b[?2004l\r"]
[263.296864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.296914, "o", "\u001b[?2004h> "]
[263.296957, "o", "    bias = tl.load(b_ptr + rn, mask=mask_n, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.297015, "o", "    acc = acc * SCALE + (SCALE * bias)[None, :]\r\n\u001b[?2004l\r"]
[263.297055, "o", "\u001b[?2004h> "]
[263.297096, "o", "    y_ptrs = y_ptr + rm[:, None] * sym + rn[None, :] * syn\r\n\u001b[?2004l\r"]
[263.29714, "o", "\u001b[?2004h> "]
[263.297184, "o", "    tl.store(y_ptrs, acc, mask=mask_m[:, None] & mask_n[None, :])\r\n\u001b[?2004l\r"]
[263.297224, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[263.297261, "o", "> "]
[263.297301, "o", "def _split_linear(x, w_t, b, scale):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.297341, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.297381, "o", "    N = w_t.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.297441, "o", "    y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[263.297482, "o", "\u001b[?2004h> "]
[263.297547, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[263.297587, "o", "\u001b[?2004h> "]
[263.297613, "o", "    _split_gemm_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.297655, "o", ">         x, w_t, b, y, M, N, K,\r\n\u001b[?2004l\r"]
[263.297696, "o", "\u001b[?2004h> "]
[263.297776, "o", "        x.stride(0), x.stride(1), w_t.stride(0), w_t.stride(1), y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[263.297816, "o", "\u001b[?2004h>         SCALE=scale,\r\n\u001b[?2004l\r"]
[263.297854, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.297896, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.297936, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.297975, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298048, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[263.298088, "o", "\u001b[?2004h>         super().__init__()\r\n\u001b[?2004l\r"]
[263.298127, "o", "\u001b[?2004h> "]
[263.298176, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[263.298215, "o", "\u001b[?2004h> "]
[263.298254, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298294, "o", "        self._wt = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298333, "o", "        self._key = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[263.298373, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298413, "o", "    def _prep(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298452, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298501, "o", "        key = (w.data_ptr(), w.device, w.dtype)\r\n\u001b[?2004l\r"]
[263.298541, "o", "\u001b[?2004h> "]
[263.29858, "o", "        if self._key != key or self._wt is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298647, "o", "            self._wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[263.298686, "o", "\u001b[?2004h> "]
[263.298725, "o", "            self._key = key\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298765, "o", "        return self._wt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[263.298804, "o", "\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r"]
[263.298846, "o", "\u001b[?2004h> "]
[263.298868, "o", "        w_t = self._prep()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[263.298905, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[263.298947, "o", "\u001b[?2004h> "]
[263.299013, "o", "        if x.is_cuda and x.dtype == torch.float32 and w_t.dtype == torch.float32:\r\n\u001b[?2004l\r"]
[263.299057, "o", "\u001b[?2004h> "]
[263.299118, "o", "            return _split_linear(x.contiguous(), w_t, b, float(self.scaling_factor))\r\n\u001b[?2004l\r"]
[263.299165, "o", "\u001b[?2004h> "]
[263.299206, "o", "        y = torch.nn.functional.linear(x, self.matmul.weight, b)\r\n\u001b[?2004l\r"]
[263.299247, "o", "\u001b[?2004h> "]
[263.299288, "o", "        return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[263.30087, "o", "\u001b[?2004hroot@modal:/workspace# "]
[263.764205, "i", "gpu run --detach -- sleep 1700\n"]
[263.764474, "o", "gpu run --detach -- sleep 1700\r\n\u001b[?2004l\r"]
[263.915572, "o", "request ID: 2870b1a803d145e19ec89c74a844e813\r\n"]
[268.91793, "o", "box: sb-E6l94cLsr4ASHZncad1F2R\r\ncommand: 15e19c6337b04bd9a81b2692b8de8a78\r\n{\r\n  \"id\": \"15e19c6337b04bd9a81b2692b8de8a78\",\r\n  \"trial\": \"ef73e83aaa6f44a0918d5e28bdb46f68\",\r\n  \"box\": \"sb-E6l94cLsr4ASHZncad1F2R\",\r\n  \"state\": \"running\"\r\n}\r\n"]
[268.943458, "o", "\u001b[?2004hroot@modal:/workspace# "]
[301.283062, "i", "gpu push sb-E6l94cLsr4ASHZncad1F2R /workspace/solution.py /workspace/solution.py\n"]
[301.283283, "o", "gpu push sb-E6l94cLsr4ASHZncad1F2R /workspace/solution.py /workspace/solution.py\r\n\u001b[?2004l\r"]
[302.278892, "o", "{\r\n  \"bytes\": 3882,\r\n  \"sha256\": \"bc7f0b59e3f152437ede067c591f816df3c5730adc6e736294034b71aacd9e4a\"\r\n}\r\n"]
[302.303309, "o", "\u001b[?2004hroot@modal:/workspace# "]
[316.283872, "i", "cat > /workspace/sanity.py << 'EOF'\nimport torch, time, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nx = torch.rand(16384, 4096, device='cuda')\nwith torch.no_grad():\n    y_ref = torch.nn.functional.linear(x, model.matmul.weight, model.matmul.bias)\n    y_ref = y_ref * 0.5 + y_ref\n    y_new = model(x)\nd = (y_ref - y_new).abs()\nprint('max diff', d.max().item(), 'mean diff', d.mean().item())\nprint('allclose 1e-4:', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\nrel = d / (y_ref.abs() + 1e-6)\nprint('max rel (with atol offset ok):', ((d - 1e-4) / (y_ref.abs() + 1e-4)).max().item())\n# timing\nfor _ in range(5):\n    y = model(x)\ntorch.cuda.synchronize()\nn = 50\ntorch.cuda.synchronize()\nt0 = time.perf_counter()\nfor _ in range(n):\n    y = model(x)\ntorch.cuda.synchronize()\nt1 = time.perf_counter()\nprint('split gemm ms:', (t1-t0)/n*1e3)\n# reference timing\nfor _ in range(5):\n    yr = y_ref = torch.nn.functional.linear(x, model.matmul."]
[316.283931, "i", "weight, model.matmul.bias)\n    yr = yr*0.5+yr\ntorch.cuda.synchronize()\nt0 = time.perf_counter()\nfor _ in range(n):\n    yr = torch.nn.functional.linear(x, model.matmul.weight, model.matmul.bias)\n    yr = yr*0.5+yr\ntorch.cuda.synchronize()\nt1 = time.perf_counter()\nprint('ref ms:', (t1-t0)/n*1e3)\nEOF\n"]
[316.284123, "o", "cat > /workspace/sanity.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, time, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.284154, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.284193, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[316.284209, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[316.284218, "o", "\u001b[?2004h"]
[316.284227, "o", "> "]
[316.284375, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> model = ModelNew(4096, 4096, 0.5).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.284414, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.284457, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.28455, "o", "    y_ref = torch.nn.functional.linear(x, model.matmul.weight, model.matmul.bias)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.284591, "o", "    y_ref = y_ref * 0.5 + y_ref\r\n\u001b[?2004l\r"]
[316.28463, "o", "\u001b[?2004h>     y_new = model(x)\r\n\u001b[?2004l\r"]
[316.284671, "o", "\u001b[?2004h> "]
[316.284712, "o", "d = (y_ref - y_new).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.284769, "o", "print('max diff', d.max().item(), 'mean diff', d.mean().item())\r\n\u001b[?2004l\r"]
[316.284809, "o", "\u001b[?2004h> "]
[316.284866, "o", "print('allclose 1e-4:', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r"]
[316.284909, "o", "\u001b[?2004h> "]
[316.284949, "o", "rel = d / (y_ref.abs() + 1e-6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.28503, "o", "print('max rel (with atol offset ok):', ((d - 1e-4) / (y_ref.abs() + 1e-4)).max().item())\r\n\u001b[?2004l\r"]
[316.285047, "o", "\u001b[?2004h> "]
[316.285095, "o", "# timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.285143, "o", "for _ in range(5):\r\n\u001b[?2004l\r\u001b[?2004h>     y = model(x)\r\n\u001b[?2004l\r"]
[316.285184, "o", "\u001b[?2004h> torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.285226, "o", "> n = 50\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.285244, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[316.285287, "o", "\u001b[?2004h> t0 = time.perf_counter()\r\n\u001b[?2004l\r"]
[316.285327, "o", "\u001b[?2004h> for _ in range(n):\r\n\u001b[?2004l\r"]
[316.285368, "o", "\u001b[?2004h>     y = model(x)\r\n\u001b[?2004l\r"]
[316.285408, "o", "\u001b[?2004h> torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[316.285455, "o", "\u001b[?2004h> "]
[316.285497, "o", "t1 = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.28554, "o", "print('split gemm ms:', (t1-t0)/n*1e3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.28558, "o", "# reference timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.285636, "o", "for _ in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[316.285713, "o", "    yr = y_ref = torch.nn.functional.linear(x, model.matmul.weight, model.matmul.bias)\r\n\u001b[?2004l\r"]
[316.285753, "o", "\u001b[?2004h>     yr = yr*0.5+yr\r\n\u001b[?2004l\r"]
[316.285792, "o", "\u001b[?2004h> torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[316.285831, "o", "\u001b[?2004h> "]
[316.28587, "o", "t0 = time.perf_counter()\r\n\u001b[?2004l\r\u001b[?2004h> for _ in range(n):\r\n\u001b[?2004l\r"]
[316.285909, "o", "\u001b[?2004h> "]
[316.285977, "o", "    yr = torch.nn.functional.linear(x, model.matmul.weight, model.matmul.bias)\r\n\u001b[?2004l\r"]
[316.286019, "o", "\u001b[?2004h>     yr = yr*0.5+yr\r\n\u001b[?2004l\r\u001b[?2004h"]
[316.286059, "o", "> torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[316.286104, "o", "\u001b[?2004h> t1 = time.perf_counter()\r\n\u001b[?2004l\r"]
[316.286143, "o", "\u001b[?2004h> "]
[316.286182, "o", "print('ref ms:', (t1-t0)/n*1e3)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[316.287241, "o", "\u001b[?2004hroot@modal:/workspace# "]
