[683.885366, "i", "cat > /workspace/dbg4.py << 'EOF'\nimport torch, sys, triton\nsys.path.insert(0, '/workspace')\nimport solution\nfrom solution import _split_gemm_kernel, ModelNew\n\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nwt = model._prep(); b = model.matmul.bias.detach()\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\ny64 = (x.double() @ wt.double() + b.double()) * 0.5\n\nconfigs = [\n    dict(BM=128, BN=256, BK=64, GROUP_M=8, num_warps=8, num_stages=3),\n    dict(BM=128, BN=256, BK=64, GROUP_M=8, num_warps=8, num_stages=4),\n    dict(BM=128, BN=128, BK=64, GROUP_M=8, num_warps=8, num_stages=4),\n    dict(BM=256, BN=128, BK=64, GROUP_M=8, num_warps=8, num_stages=3),\n    dict(BM=128, BN=128, BK=32, GROUP_M=8, num_warps=4, num_stages=4),\n    dict(BM=64, BN=256, BK=64, GROUP_M=8, num_warps=4, num_stages=4),\n    dict(BM=128, BN=64, BK=64, GROUP_M=8, num_warps=4, num_stages=4),\n]\nfor cfg in configs:\n    kw = dict(cfg)\n    num_warps = kw.pop('num_warps'); num_stages = kw.pop('num_stages')\n    try:\n     "]
[683.88551, "i", "   y = torch.empty((M, N), device='cuda', dtype=torch.float32)\n        grid = (triton.cdiv(M, kw['BM']) * triton.cdiv(N, kw['BN']),)\n        _split_gemm_kernel.fn.run(*(\n            x, wt, b, y, M, N, K,\n            x.stride(0), x.stride(1), wt.stride(0), wt.stride(1), y.stride(0), y.stride(1),\n        ), grid=grid, SCALE=0.5, warmup=False, num_warps=num_warps, num_stages=num_stages, **kw)\n        torch.cuda.synchronize()\n        err = (y.double()-y64).abs().max().item()\n        print(cfg, 'err:', err)\n    except Exception as e:\n        print(cfg, 'FAILED:', type(e).__name__, str(e)[:100])\nEOF\n"]
