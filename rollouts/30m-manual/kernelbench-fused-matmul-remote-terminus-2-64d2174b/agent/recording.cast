[499.668668, "i", "cat > /workspace/dbg2.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\nprint('matmul precision:', torch.get_float32_matmul_precision())\ntorch.manual_seed(42)\nmodel = ModelNew(4096, 4096, 0.5).cuda()\nx = torch.rand(16384, 4096, device='cuda')\nwith torch.no_grad():\n    y64 = (x.double() @ model.matmul.weight.double().t() + model.matmul.bias.double()) * 1.5\n    y_ref = torch.nn.functional.linear(x, model.matmul.weight, model.matmul.bias)\n    y_ref = y_ref * 0.5 + y_ref\n    y_new = model(x)\nprint('ref(fp32 cublas) vs fp64:', (y_ref.double()-y64).abs().max().item())\nprint('new vs fp64:', (y_new.double()-y64).abs().max().item())\nprint('new vs ref:', (y_ref-y_new).abs().max().item())\nprint('allclose 1e-4:', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\nEOF\n"]
