[627.841735, "o", "\u001b[?2004h> "]
[627.841765, "o", "ref = ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[627.841796, "o", "\u001b[?2004h> "]
[627.841826, "o", "for BL in [8192, 16384]:\r\n\u001b[?2004l\r"]
[627.841856, "o", "\u001b[?2004h> "]
