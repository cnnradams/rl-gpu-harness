[627.836934, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, numpy as np\nimport triton\nimport triton.language as tl\nimport torch.nn as nn\n\ndef bench(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    times = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return float(np.mean(times)), float(np.min(times))\n\n@triton.jit\ndef _copy3(X, Y, W, B, N, NB, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    c = pid % NB\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    offs = b * N + o\n    x = tl.load(X + offs)\n    w = tl.load(W + o)\n    bb = tl.load(B + o)\n    tl.store(Y + offs, x * w + bb)\n\n@triton.jit\ndef _norm_ev(X, Y, W, B, WS, N, NB, eps, BLOCK: tl.constexpr, NBC: tl.constexpr, EV: tl.constexpr):\n    pid "]
[627.837113, "i", "= tl.program_id(0)\n    b = pid // NB\n    c = pid % NB\n    ar = tl.arange(0, NBC)\n    s = tl.sum(tl.load(WS + b * NB * 2 + ar * 2))\n    sq = tl.sum(tl.load(WS + b * NB * 2 + ar * 2 + 1))\n    inv = 1.0 / N\n    mean = s * inv\n    var = sq * inv - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    offs = b * N + o\n    if EV == 0:\n        x = tl.load(X + offs)\n        w = tl.load(W + o)\n        bb = tl.load(B + o)\n        tl.store(Y + offs, (x - mean) * rstd * w + bb)\n    else:\n        x = tl.load(X + offs, eviction_policy='evict_first')\n        w = tl.load(W + o, eviction_policy='evict_last')\n        bb = tl.load(B + o, eviction_policy='evict_last')\n        tl.store(Y + offs, (x - mean) * rstd * w + bb, eviction_policy='evict_first')\n\nx = torch.rand(16,64,256,256, device='cuda')\nln = nn.LayerNorm((64,256,256)).cuda()\nw, b = ln.weight, ln.bias\neps = ln.eps\nN = 64*256*256\nR = 16\ny = torch.empty_like(x)\nref = ln(x)\n\nfor BL in [8192, 16384]:\n    NB = N // BL\n    for wp in [8, "]
[627.83714, "i", "16, 32]:\n        g = R * NB\n        m, mn = bench(lambda: _copy3[(g,)](x, y, w, b, N, NB, BLOCK=BL, num_warps=wp))\n        print(f'copy3 BL={BL} w={wp}: mean={m:.4f} min={mn:.4f}')\n\nfor BL in [8192, 16384, 32768]:\n    NB = N // BL\n    ws = torch.empty(R*NB*2, device='cuda')\n    g = R * NB\n    for wp in [8, 16, 32]:\n        for EV in [0, 1]:\n            def run():\n                _norm_ev[(g,)](x, y, w, b, ws, N, NB, eps, BLOCK=BL, NBC=NB, EV=EV, num_warps=wp)\n            run()\n            err = (y - ref).abs().max().item()\n            m, mn = bench(run)\n            print(f'norm_ev BL={BL} w={wp} EV={EV}: mean={m:.4f} min={mn:.4f} err={err:.2e}')\nEOF\ngpu push sb-F7I6DbT5b7mTtD91nyBmIv /workspace/bench4.py /workspace/bench4.py\n"]
