[76.006698, "o", "            compiled=True, correctness=False, metadata=metadata\r\n        )  # skip further steps\r\n\r\n    kernel_exec_result = None\r\n\r\n    # Check Correctness\r\n    if verbose:\r\n        print(\"[Eval] Checking Correctness\")\r\n    try:\r\n        kernel_exec_result = run_and_check_correctness(\r\n            original_model,\r\n            custom_model,\r\n            get_inputs,\r\n            metadata=metadata,\r\n            num_correct_trials=num_correct_trials,\r\n            verbose=verbose,\r\n            seed=seed_num,\r\n            device=device,\r\n            backend=backend,\r\n            precision=precision,\r\n        )\r\n    except Exception as e:\r\n        # TODO: add metadata for runtime error e.g. error in launching kernel, illegal memory access, ...\r\n        metadata[\"runtime_error\"] = e\r\n        metadata[\"runtime_error_name\"] = get_error_name(e)"]
[76.006731, "o", "\r\n        kernel_exec_result = KernelExecResult(\r\n            compiled=True, correctness=False, metadata=metadata\r\n        )\r\n\r\n    # Measure Performance [Optional] | conditioned on compilation + correctness + no exception so far\r\n    if measure_performance:\r\n        try:\r\n            if kernel_exec_result and kernel_exec_result.correctness:\r\n                if verbose:\r\n                    print(\"[Eval] Measuring Performance as Sample is Correct\")\r\n\r\n                torch.cuda.synchronize(device=device)"]
