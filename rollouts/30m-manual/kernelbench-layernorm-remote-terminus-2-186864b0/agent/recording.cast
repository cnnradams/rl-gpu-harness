[1082.502617, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n_BLOCK = 8192\n_W1 = 16\n_W2 = 16\n_WR = 8\n_ROWS = 16\n\nif _HAS_TRITON:\n    @triton.jit\n    def _ln_part(X, WS, N, NB, BLOCK: tl.constexpr):\n        pid = tl.program_id(0)\n        b = pid // NB\n        o = (pid % NB) * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + b * N + o)\n        tl.store(WS + pid * 2, tl.sum(x))\n        tl.store(WS + pid * 2 + 1, tl.sum(x * x))\n\n    @triton.jit\n    def _ln_reduce(WS, MR, NB, eps, N, NBV: tl.constexpr):\n        b = tl.program_id(0)\n        ar = tl.arange(0, NBV)\n        s = tl.sum(tl.load(WS + b * NB * 2 + ar * 2))\n        sq = tl.sum(tl.load(WS + b * NB * 2 + ar * 2 + 1))\n        inv = 1.0 / N\n        mean = s * inv\n        var = sq * inv - mean * mean\n        tl.store(MR + b * 2, mean)\n        tl.store(MR + b * 2 + 1, 1.0 / tl.sqrt(var + eps))\n\n"]
[1082.502666, "i", "    @triton.jit\n    def _ln_norm(X, Y, W, B, MR, N, NB, R: tl.constexpr, BLOCK: tl.constexpr):\n        pid = tl.program_id(0)\n        b = pid % R\n        c = pid // R\n        mean = tl.load(MR + b * 2)\n        rstd = tl.load(MR + b * 2 + 1)\n        o = c * BLOCK + tl.arange(0, BLOCK)\n        offs = b * N + o\n        x = tl.load(X + offs)\n        w = tl.load(W + o)\n        bb = tl.load(B + o)\n        tl.store(Y + offs, (x - mean) * rstd * w + bb)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n        self._fn = None\n        self._state = None\n        self._compiled = None\n        if _HAS_TRITON:\n            try:\n                n = 1\n                for s in self.normalized_shape:\n                    n *= s\n                if len(self.normalized_shape) == 3 and n % _BLOCK == 0:\n                    nb = n // _BLOCK\n\n                  "]
[1082.502674, "i", "  def fn(x, w, b, ws, mr, y, _R=_ROWS, _NB=nb, _N=n, _eps=self.ln.eps):\n                        _ln_part[(_R * _NB,)](x, ws, _N, _NB, BLOCK=_BLOCK, num_warps=_W1)\n                        _ln_reduce[(_R,)](ws, mr, _NB, _eps, _N, NBV=_NB, num_warps=_WR)\n                        _ln_norm[(_R * _NB,)](x, y, w, b, mr, _N, _NB, R=_R, BLOCK=_BLOCK, num_warps=_W2)\n\n                    self._fn = fn\n            except Exception:\n                self._fn = None\n\n    def _plain(self, x):\n        st = self._state\n        if st is None or st[0] != x.shape:\n            nb = (x.numel() // x.shape[0]) // _BLOCK\n            ws = torch.empty(x.shape[0] * nb * 2, device=x.device, dtype=torch.float32)\n            mr = torch.empty(x.shape[0] * 2, device=x.device, dtype=torch.float32)\n            y = torch.empty_like(x)\n            self._state = (x.shape, ws, mr, y)\n        else:\n            _, ws, mr, y = st\n        self._fn(x, self.ln.weight, self.ln.bias, ws, mr, y)\n        return y\n\n    def _graph_path(self, x):\n        key = ("]
[1082.502681, "i", "x.data_ptr(), x.shape)\n        g = getattr(self, key, None)\n        if g is None:\n            y = self._plain(x)\n            torch.cuda.synchronize()\n            gr = torch.cuda.CUDAGraph()\n            with torch.cuda.graph(gr):\n                self._plain(x)\n            setattr(self, key, gr)\n            return y\n        g.replay()\n        st = self._state\n        return st[3]\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        shape = self.normalized_shape\n        if not (\n            _HAS_TRITON\n            and self._fn is not None\n            and x.is_cuda\n            and x.dtype == torch.float32\n            and x.dim() == 4\n            and x.shape[1:] == shape\n            and x.is_contiguous()\n            and x.shape[0] == _ROWS\n            and self.ln.weight is not None\n            and self.ln.bias is not None\n            and self.ln.weight.is_contiguous()\n            and self.ln.bias.is_contiguous()\n        ):\n            return F.layer_norm(x, shape, self.ln.weight, self.ln.bias, self.ln."]
[1082.502706, "i", "eps)\n        try:\n            if not torch.cuda.is_current_stream_capturing():\n                return self._graph_path(x)\n        except Exception:\n            pass\n        try:\n            if self._compiled is None:\n                self._compiled = torch.compile(self._plain, mode='reduce-overhead', fullgraph=True, dynamic=False)\n            return self._compiled(x)\n        except Exception:\n            return self._plain(x)\nEOF\ngpu push sb-F7I6DbT5b7mTtD91nyBmIv /workspace/solution.py /workspace/solution.py\n"]
