[759.269604, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, numpy as np\nimport triton\nimport triton.language as tl\nimport torch.nn as nn\n\ndef bench(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    times = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return float(np.mean(times)), float(np.min(times))\n\n@triton.jit\ndef _part(X, WS, N, NB, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    o = (pid % NB) * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + b * N + o)\n    tl.store(WS + pid * 2, tl.sum(x))\n    tl.store(WS + pid * 2 + 1, tl.sum(x * x))\n\n@triton.jit\ndef _reduce(WS, MR, NB, eps, N, NBV: tl.constexpr):\n    b = tl.program_id(0)\n    ar = tl.arange(0, NBV)\n    s = tl.sum(tl.load(WS + b * "]
[759.269661, "i", "NB * 2 + ar * 2))\n    sq = tl.sum(tl.load(WS + b * NB * 2 + ar * 2 + 1))\n    inv = 1.0 / N\n    mean = s * inv\n    var = sq * inv - mean * mean\n    tl.store(MR + b * 2, mean)\n    tl.store(MR + b * 2 + 1, 1.0 / tl.sqrt(var + eps))\n\n@triton.jit\ndef _norm_regs(X, Y, W, B, MR, N, NB, R: tl.constexpr, BLOCK: tl.constexpr):\n    c = tl.program_id(0)\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    w = tl.load(W + o)\n    bb = tl.load(B + o)\n    for b in range(R):\n        mean = tl.load(MR + b * 2)\n        rstd = tl.load(MR + b * 2 + 1)\n        offs = b * N + o\n        x = tl.load(X + offs, eviction_policy='evict_first')\n        tl.store(Y + offs, (x - mean) * rstd * w + bb, eviction_policy='evict_first')\n\n@triton.jit\ndef _norm_bmajor(X, Y, W, B, MR, N, NB, R: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid % R\n    c = pid // R\n    mean = tl.load(MR + b * 2)\n    rstd = tl.load(MR + b * 2 + 1)\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    offs = b * N + o\n    if EV == 1:\n        x ="]
[759.269673, "i", " tl.load(X + offs, eviction_policy='evict_first')\n        w = tl.load(W + o)\n        bb = tl.load(B + o)\n        tl.store(Y + offs, (x - mean) * rstd * w + bb, eviction_policy='evict_first')\n    else:\n        x = tl.load(X + offs)\n        w = tl.load(W + o)\n        bb = tl.load(B + o)\n        tl.store(Y + offs, (x - mean) * rstd * w + bb)\n\nx = torch.rand(16,64,256,256, device='cuda')\nln = nn.LayerNorm((64,256,256)).cuda()\nw, b = ln.weight, ln.bias\neps = ln.eps\nN = 64*256*256\nR = 16\ny = torch.empty_like(x)\nref = ln(x)\n\nfor BL in [4096, 8192]:\n    NB = N // BL\n    ws = torch.empty(R*NB*2, device='cuda')\n    mr = torch.empty(R*2, device='cuda')\n    for w1 in [4, 8, 16]:\n        m1, _ = bench(lambda: _part[(R*NB,)](x, ws, N, NB, BLOCK=BL, num_warps=w1))\n        m15, _ = bench(lambda: _reduce[(R,)](ws, mr, NB, eps, N, NBV=NB, num_warps=8))\n        print(f'BL={BL} w1={w1}: part={m1:.4f} reduce={m15:.4f}')\n\nfor BL in [2048, 4096, 8192]:\n    NB = N // BL\n    ws = torch.empty(R*NB*2, device='cuda')\n    mr = torch.empt"]
[759.269684, "i", "y(R*2, device='cuda')\n    _part[(R*NB,)](x, ws, N, NB, BLOCK=BL, num_warps=8)\n    _reduce[(R,)](ws, mr, NB, eps, N, NBV=NB, num_warps=8)\n    for wp in [4, 8, 16]:\n        def run():\n            _norm_regs[(NB,)](x, y, w, b, mr, N, NB, R=R, BLOCK=BL, num_warps=wp)\n        run()\n        err = (y - ref).abs().max().item()\n        m, mn = bench(run)\n        print(f'regs BL={BL} w={wp}: mean={m:.4f} min={mn:.4f} err={err:.2e}')\n    for wp in [8, 16]:\n        for EV in [0, 1]:\n            def run():\n                _norm_bmajor[(R*NB,)](x, y, w, b, mr, N, NB, R=R, BLOCK=BL, EV=EV, num_warps=wp)\n            run()\n            err = (y - ref).abs().max().item()\n            m, mn = bench(run)\n            print(f'bmajor BL={BL} w={wp} EV={EV}: mean={m:.4f} min={mn:.4f} err={err:.2e}')\nEOF\ngpu push sb-F7I6DbT5b7mTtD91nyBmIv /workspace/bench5.py /workspace/bench5.py\n"]
