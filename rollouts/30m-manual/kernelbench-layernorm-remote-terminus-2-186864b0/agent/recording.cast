[993.229335, "o", "\u001b[?2004h> "]
[993.229362, "o", "        b = pid % R\r\n\u001b[?2004l\r"]
[993.229398, "o", "\u001b[?2004h> "]
[993.229425, "o", "        c = pid // R\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.229488, "o", "        mean = tl.load(MR + b * 2)\r\n\u001b[?2004l\r"]
[993.229515, "o", "\u001b[?2004h> "]
[993.229568, "o", "        rstd = tl.load(MR + b * 2 + 1)\r\n\u001b[?2004l\r"]
[993.229595, "o", "\u001b[?2004h> "]
[993.229656, "o", "        o = c * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[993.229688, "o", "\u001b[?2004h> "]
[993.229721, "o", "        offs = b * N + o\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.229748, "o", "> "]
[993.229781, "o", "        x = tl.load(X + offs)\r\n\u001b[?2004l\r"]
[993.229812, "o", "\u001b[?2004h> "]
[993.229843, "o", "        w = tl.load(W + o)\r\n\u001b[?2004l\r"]
[993.229877, "o", "\u001b[?2004h> "]
[993.229911, "o", "        bb = tl.load(B + o)\r\n\u001b[?2004l\r"]
[993.229938, "o", "\u001b[?2004h> "]
[993.230016, "o", "        tl.store(Y + offs, (x - mean) * rstd * w + bb)\r\n\u001b[?2004l\r"]
[993.230043, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.230075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.230113, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[993.230145, "o", "\u001b[?2004h> "]
[993.230208, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[993.23024, "o", "\u001b[?2004h> "]
[993.230272, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[993.230298, "o", "\u001b[?2004h> "]
[993.230396, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[993.230422, "o", "\u001b[?2004h> "]
[993.230502, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[993.230534, "o", "\u001b[?2004h> "]
[993.230561, "o", "        self._fn = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.230601, "o", "> "]
[993.230635, "o", "        self._state = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.230667, "o", "> "]
[993.230694, "o", "        self._compiled = None\r\n\u001b[?2004l\r"]
[993.230727, "o", "\u001b[?2004h> "]
[993.230759, "o", "        if _HAS_TRITON:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.230791, "o", "            try:\r\n\u001b[?2004l\r"]
[993.230829, "o", "\u001b[?2004h> "]
[993.230855, "o", "                n = 1\r\n\u001b[?2004l\r"]
[993.230887, "o", "\u001b[?2004h> "]
[993.230955, "o", "                for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[993.230984, "o", "\u001b[?2004h> "]
[993.231012, "o", "                    n *= s\r\n\u001b[?2004l\r"]
[993.231041, "o", "\u001b[?2004h> "]
[993.231151, "o", "                if len(self.normalized_shape) == 3 and n % _BLOCK == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.231184, "o", "> "]
[993.231225, "o", "                    nb = n // _BLOCK\r\n\u001b[?2004l\r"]
[993.231253, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.231414, "o", "                    def fn(x, w, b, ws, mr, y, _R=_BLOCK // 8, _NB=nb, _N=n, _eps=self.ln.eps):\r\n\u001b[?2004l\r"]
[993.231441, "o", "\u001b[?2004h> "]
[993.231577, "o", "                        _ln_part[(_R * _NB,)](x, ws, _N, _NB, BLOCK=_BLOCK, num_warps=_W1)\r\n\u001b[?2004l\r"]
[993.231609, "o", "\u001b[?2004h> "]
[993.231736, "o", "                        _ln_reduce[(_R,)](ws, mr, _NB, _eps, _N, NBV=_NB, num_warps=_WR)\r\n\u001b[?2004l\r"]
[993.231769, "o", "\u001b[?2004h> "]
[993.23193, "o", "                        _ln_norm[(_R * _NB,)](x, y, w, b, mr, _N, _NB, R=_R, BLOCK=_BLOCK, num_warps=_W2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.231959, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.232017, "o", "                    self._fn = fn\r\n\u001b[?2004l\r"]
[993.23205, "o", "\u001b[?2004h> "]
[993.232077, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[993.232108, "o", "\u001b[?2004h> "]
[993.232155, "o", "                self._fn = None\r\n\u001b[?2004l\r"]
[993.232187, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.232231, "o", "    def _plain(self, x):\r\n\u001b[?2004l\r"]
[993.232263, "o", "\u001b[?2004h> "]
[993.232296, "o", "        st = self._state\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.232323, "o", "> "]
[993.23238, "o", "        if st is None or st[0] != x.shape:\r\n\u001b[?2004l\r"]
[993.232413, "o", "\u001b[?2004h> "]
[993.232589, "o", "            ws = torch.empty(x.shape[0] * (x.numel() // x.shape[0]) // _BLOCK * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[993.232626, "o", "\u001b[?2004h> "]
[993.232738, "o", "            mr = torch.empty(x.shape[0] * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[993.232765, "o", "\u001b[?2004h> "]
[993.232817, "o", "            y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[993.232847, "o", "\u001b[?2004h> "]
[993.232909, "o", "            self._state = (x.shape, ws, mr, y)\r\n\u001b[?2004l\r"]
[993.232942, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[993.232974, "o", "\u001b[?2004h> "]
[993.233016, "o", "            _, ws, mr, y = st\r\n\u001b[?2004l\r"]
[993.233049, "o", "\u001b[?2004h> "]
[993.233131, "o", "        self._fn(x, self.ln.weight, self.ln.bias, ws, mr, y)\r\n\u001b[?2004l\r"]
[993.233163, "o", "\u001b[?2004h> "]
[993.23319, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.233223, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.233255, "o", "    def _graph_path(self, x):\r\n\u001b[?2004l\r"]
[993.233287, "o", "\u001b[?2004h> "]
[993.23334, "o", "        key = (x.data_ptr(), x.shape)\r\n\u001b[?2004l\r"]
[993.233385, "o", "\u001b[?2004h> "]
[993.233413, "o", "        g = getattr(self, key, None)\r\n\u001b[?2004l\r"]
[993.233445, "o", "\u001b[?2004h> "]
[993.233472, "o", "        if g is None:\r\n\u001b[?2004l\r"]
[993.233504, "o", "\u001b[?2004h> "]
[993.233542, "o", "            y = self._plain(x)\r\n\u001b[?2004l\r"]
[993.233568, "o", "\u001b[?2004h> "]
[993.233629, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[993.233656, "o", "\u001b[?2004h> "]
[993.23371, "o", "            gr = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[993.233738, "o", "\u001b[?2004h> "]
[993.233791, "o", "            with torch.cuda.graph(gr):\r\n\u001b[?2004l\r"]
[993.233823, "o", "\u001b[?2004h> "]
[993.233862, "o", "                self._plain(x)\r\n\u001b[?2004l\r"]
[993.233889, "o", "\u001b[?2004h> "]
[993.233935, "o", "            setattr(self, key, gr)\r\n\u001b[?2004l\r"]
[993.233967, "o", "\u001b[?2004h> "]
[993.233999, "o", "            return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.234036, "o", "        g.replay()\r\n\u001b[?2004l\r"]
[993.234068, "o", "\u001b[?2004h> "]
[993.234094, "o", "        st = self._state\r\n\u001b[?2004l\r"]
[993.234127, "o", "\u001b[?2004h> "]
[993.234159, "o", "        return st[3]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[993.234192, "o", "\u001b[?2004h> "]
[993.234273, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[993.234306, "o", "\u001b[?2004h> "]
[993.234352, "o", "        shape = self.normalized_shape\r\n\u001b[?2004l\r"]
[993.23438, "o", "\u001b[?2004h> "]
[993.234411, "o", "        if not (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.234454, "o", "            _HAS_TRITON\r\n\u001b[?2004l\r"]
[993.234487, "o", "\u001b[?2004h> "]
[993.234537, "o", "            and self._fn is not None\r\n\u001b[?2004l\r"]
[993.234569, "o", "\u001b[?2004h> "]
[993.234607, "o", "            and x.is_cuda\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.23464, "o", "> "]
[993.234687, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[993.23472, "o", "\u001b[?2004h> "]
[993.234751, "o", "            and x.dim() == 4\r\n\u001b[?2004l\r"]
[993.234782, "o", "\u001b[?2004h> "]
[993.234833, "o", "            and x.shape[1:] == shape\r\n\u001b[?2004l\r"]
[993.234866, "o", "\u001b[?2004h> "]
[993.234905, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[993.234936, "o", "\u001b[?2004h> "]
[993.234994, "o", "            and x.shape[0] == _BLOCK // 512\r\n\u001b[?2004l\r"]
[993.235021, "o", "\u001b[?2004h> "]
[993.235081, "o", "            and self.ln.weight is not None\r\n\u001b[?2004l\r"]
[993.235114, "o", "\u001b[?2004h> "]
[993.235164, "o", "            and self.ln.bias is not None\r\n\u001b[?2004l\r"]
[993.23519, "o", "\u001b[?2004h> "]
[993.235257, "o", "            and self.ln.weight.is_contiguous()\r\n\u001b[?2004l\r"]
[993.235283, "o", "\u001b[?2004h> "]
[993.235348, "o", "            and self.ln.bias.is_contiguous()\r\n\u001b[?2004l\r"]
[993.23538, "o", "\u001b[?2004h>         ):\r\n\u001b[?2004l\r"]
[993.235412, "o", "\u001b[?2004h> "]
[993.235544, "o", "            return F.layer_norm(x, shape, self.ln.weight, self.ln.bias, self.ln.eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.235578, "o", ">         try:\r\n\u001b[?2004l\r"]
[993.235609, "o", "\u001b[?2004h> "]
[993.235694, "o", "            if not torch.cuda.is_current_stream_capturing():\r\n\u001b[?2004l\r"]
[993.235726, "o", "\u001b[?2004h> "]
[993.23578, "o", "                return self._graph_path(x)\r\n\u001b[?2004l\r"]
[993.235815, "o", "\u001b[?2004h> "]
[993.235843, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[993.235868, "o", "\u001b[?2004h> "]
[993.235895, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.235923, "o", ">         try:\r\n\u001b[?2004l\r"]
[993.235955, "o", "\u001b[?2004h> "]
[993.236012, "o", "            if self._compiled is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.23604, "o", "> "]
[993.236212, "o", "                self._compiled = torch.compile(self._plain, mode='reduce-overhead', fullgraph=True, dynamic=False)\r\n\u001b[?2004l\r"]
[993.236244, "o", "\u001b[?2004h> "]
[993.236287, "o", "            return self._compiled(x)\r\n\u001b[?2004l\r"]
[993.23632, "o", "\u001b[?2004h> "]
[993.236345, "o", "        except Exception:\r\n\u001b[?2004l\r"]
[993.236378, "o", "\u001b[?2004h> "]
[993.23642, "o", "            return self._plain(x)\r\n\u001b[?2004l\r"]
[993.236447, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[993.237674, "o", "\u001b[?2004hroot@modal:/workspace# "]
[993.237725, "o", "cat > /workspace/smoke.py << 'EOF'\r\n\u001b[?2004l\r"]
[993.237753, "o", "\u001b[?2004h> "]
[993.237786, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.237817, "o", "> "]
[993.23786, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[993.237892, "o", "\u001b[?2004h> "]
[993.237928, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[993.237955, "o", "\u001b[?2004h> "]
[993.238003, "o", "m = ModelNew((64,256,256)).cuda()\r\n\u001b[?2004l\r"]
[993.238035, "o", "\u001b[?2004h> "]
[993.238093, "o", "ref = torch.nn.LayerNorm((64,256,256)).cuda()\r\n\u001b[?2004l\r"]
[993.238127, "o", "\u001b[?2004h> "]
[993.238183, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[993.238214, "o", "\u001b[?2004h> "]
[993.238247, "o", "y1 = m(x); y2 = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[993.238323, "o", "print('err', (y1-y2).abs().max().item())\r\n\u001b[?2004l\r"]
[993.238355, "o", "\u001b[?2004h> "]
[993.238414, "o", "x2 = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[993.238446, "o", "\u001b[?2004h> "]
[993.238477, "o", "y3 = m(x2); y4 = ref(x2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[993.238503, "o", "> "]
[993.238556, "o", "print('err2', (y3-y4).abs().max().item())\r\n\u001b[?2004l\r"]
[993.238591, "o", "\u001b[?2004h> "]
[993.238693, "o", "y5 = m(x); print('same ptr replay err', (y5-y2).abs().max().item())\r\n\u001b[?2004l\r"]
[993.238726, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[993.239578, "o", "\u001b[?2004hroot@modal:/workspace# "]
