[151.233799, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, numpy as np, sys\nsys.path.insert(0, '/workspace')\nimport triton\nfrom solution import _ln3d_kernel\nimport torch.nn as nn\n\ndef bench(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    times = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return float(np.mean(times)), float(np.min(times))\n\nx = torch.rand(16,64,256,256, device='cuda')\nln = nn.LayerNorm((64,256,256)).cuda()\nw, b = ln.weight, ln.bias\neps = ln.eps\nN = 64*256*256\nR = 16\nNSM = torch.cuda.get_device_properties(0).multi_processor_count\nprint('NSM', NSM)\ny = torch.empty_like(x)\nref = ln(x)\nfor BLOCK in [2048, 4096, 8192, 16384]:\n    for warps in [4, 8, 16, 32]:\n        NB = N // BLOCK\n        g = min"]
[151.233829, "i", "(NSM, R*NB)\n        def run():\n            _ln3d_kernel[(g,)](x, y, w, b, R, N, NB, eps, BLOCK=BLOCK, NSM=g, num_warps=warps)\n        run()\n        err = (y - ref).abs().max().item()\n        mean, mn = bench(run)\n        print(f'BLOCK={BLOCK} warps={warps} grid={g} mean={mean:.4f}ms min={mn:.4f}ms err={err:.2e}')\nprint('ref LN:', bench(lambda: ln(x)))\nEOF\n"]
