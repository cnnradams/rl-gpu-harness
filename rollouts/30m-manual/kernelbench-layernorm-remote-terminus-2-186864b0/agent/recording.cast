[519.229113, "o", "m1, _ = bench(lambda: _part[(g,)](x, ws, N, NB, BLOCK=BLOCK, num_warps=16))\r\n\u001b[?2004l\r"]
[519.229145, "o", "\u001b[?2004h> "]
[519.229288, "o", "m2, _ = bench(lambda: _norm[(g,)](x, y, w, b, ws, N, NB, eps, BLOCK=BLOCK, NBC=NB, num_warps=16))\r\n\u001b[?2004l\r"]
[519.229318, "o", "\u001b[?2004h> "]
