[519.229711, "o", "> "]
[519.229738, "o", "        for w2 in [16, 32]:\r\n\u001b[?2004l\r"]
[519.229769, "o", "\u001b[?2004h> "]
[519.229801, "o", "            def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[519.229833, "o", "> "]
