[538.921032, "o", "part alone: 0.1009  norm alone: 0.3552\r\natomic BL=4096 w1=8 w2=16: mean=0.3739 min=0.3729 err=5.15e+00\r\natomic BL=4096 w1=8 w2=32: mean=0.3746 min=0.3732 err=5.15e+00\r\natomic BL=4096 w1=16 w2=16: mean=0.3740 min=0.3729 err=5.15e+00\r\natomic BL=4096 w1=16 w2=32: mean=0.3746 min=0.3733 err=5.15e+00\r\natomic BL=8192 w1=8 w2=16: mean=0.3699 min=0.3688 err=5.15e+00\r\natomic BL=8192 w1=8 w2=32: mean=0.3680 min=0.3668 err=5.15e+00\r\natomic BL=8192 w1=16 w2=16: mean=0.3695 min=0.3683 err=5.15e+00\r\natomic BL=8192 w1=16 w2=32: mean=0.3681 min=0.3668 err=5.15e+00\r\natomic BL=16384 w1=8 w2=16: mean=0.3675 min=0.3662 err=5.15e+00\r\natomic BL=16384 w1=8 w2=32: mean=0.3676 min=0.3662 err=5.15e+00\r\natomic BL=16384 w1=16 w2=16: mean=0.3679 min=0.3667 err=5.15e+00\r\natomic BL=16384 w1=16 w2=32: mean=0.3680 min=0.3666 err=5.15e+00\r\n"]
