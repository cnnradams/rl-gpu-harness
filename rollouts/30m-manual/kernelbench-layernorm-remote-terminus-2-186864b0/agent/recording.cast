[759.274096, "o", "    o = c * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[759.274121, "o", "\u001b[?2004h> "]
[759.274146, "o", "    offs = b * N + o\r\n\u001b[?2004l\r"]
[759.27417, "o", "\u001b[?2004h> "]
[759.274194, "o", "    if EV == 1:\r\n\u001b[?2004l\r"]
[759.274219, "o", "\u001b[?2004h> "]
[759.274304, "o", "        x = tl.load(X + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[759.274329, "o", "\u001b[?2004h> "]
