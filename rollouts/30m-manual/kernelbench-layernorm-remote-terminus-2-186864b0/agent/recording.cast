[519.222525, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, numpy as np\nimport triton\nimport triton.language as tl\nimport torch.nn as nn\n\ndef bench(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    times = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return float(np.mean(times)), float(np.min(times))\n\n@triton.jit\ndef _part(X, WS, N, NB, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    o = (pid % NB) * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + b * N + o)\n    tl.store(WS + pid * 2, tl.sum(x))\n    tl.store(WS + pid * 2 + 1, tl.sum(x * x))\n\n@triton.jit\ndef _part_atomic(X, WS, N, NB, BLOCK: tl.constexpr, NSM: tl.constexpr):\n    pid = tl.program_id(0)\n    for i in range(pid, NB, NSM):\n   "]
[519.222577, "i", "     b = i // (NB // 16)\n        o = (i % (NB // 16)) * BLOCK + tl.arange(0, BLOCK)\n        x = tl.load(X + b * N + o)\n        tl.atomic_add(WS + b * 2, tl.sum(x))\n        tl.atomic_add(WS + b * 2 + 1, tl.sum(x * x))\n\n@triton.jit\ndef _norm(X, Y, W, B, WS, N, NB, eps, BLOCK: tl.constexpr, NBC: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    c = pid % NB\n    ar = tl.arange(0, NBC)\n    s = tl.sum(tl.load(WS + b * NB * 2 + ar * 2))\n    sq = tl.sum(tl.load(WS + b * NB * 2 + ar * 2 + 1))\n    inv = 1.0 / N\n    mean = s * inv\n    var = sq * inv - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    offs = b * N + o\n    x = tl.load(X + offs)\n    w = tl.load(W + o)\n    bb = tl.load(B + o)\n    tl.store(Y + offs, (x - mean) * rstd * w + bb)\n\n@triton.jit\ndef _norm_scalar(X, Y, W, B, WS, N, NB, eps, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    c = pid % NB\n    s = tl.load(WS + b * 2)\n    sq = tl.load(WS + b * 2 + 1)\n    inv = 1.0 / N\n    mean "]
[519.222598, "i", "= s * inv\n    var = sq * inv - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    offs = b * N + o\n    x = tl.load(X + offs)\n    w = tl.load(W + o)\n    bb = tl.load(B + o)\n    tl.store(Y + offs, (x - mean) * rstd * w + bb)\n\nx = torch.rand(16,64,256,256, device='cuda')\nln = nn.LayerNorm((64,256,256)).cuda()\nw, b = ln.weight, ln.bias\neps = ln.eps\nN = 64*256*256\nR = 16\nNSM = torch.cuda.get_device_properties(0).multi_processor_count\ny = torch.empty_like(x)\nref = ln(x)\n\nBLOCK = 8192\nNB = N // BLOCK\nws = torch.empty(R*NB*2, device='cuda')\ng = R * NB\nm1, _ = bench(lambda: _part[(g,)](x, ws, N, NB, BLOCK=BLOCK, num_warps=16))\nm2, _ = bench(lambda: _norm[(g,)](x, y, w, b, ws, N, NB, eps, BLOCK=BLOCK, NBC=NB, num_warps=16))\nprint(f'part alone: {m1:.4f}  norm alone: {m2:.4f}')\n\nfor BL in [4096, 8192, 16384]:\n    NB = N // BL\n    ws2 = torch.zeros(R*2, device='cuda')\n    for w1 in [8, 16]:\n        for w2 in [16, 32]:\n            def run():\n                ws2.zero_()\n             "]
[519.222607, "i", "   _part_atomic[(NSM,)](x, ws2, N, NB, BLOCK=BL, NSM=NSM, num_warps=w1)\n                _norm_scalar[(R*NB,)](x, y, w, b, ws2, N, NB, eps, BLOCK=BL, num_warps=w2)\n            run()\n            err = (y - ref).abs().max().item()\n            m, mn = bench(run)\n            print(f'atomic BL={BL} w1={w1} w2={w2}: mean={m:.4f} min={mn:.4f} err={err:.2e}')\nEOF\ngpu push sb-F7I6DbT5b7mTtD91nyBmIv /workspace/bench3.py /workspace/bench3.py\n"]
