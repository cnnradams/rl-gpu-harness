[780.486724, "o", "BL=4096 w1=4: part=0.1016 reduce=0.0061\r\nBL=4096 w1=8: part=0.0992 reduce=0.0061\r\nBL=4096 w1=16: part=0.0985 reduce=0.0061\r\nBL=8192 w1=4: part=0.1011 reduce=0.0060\r\nBL=8192 w1=8: part=0.1011 reduce=0.0062\r\nBL=8192 w1=16: part=0.0990 reduce=0.0059\r\nregs BL=2048 w=4: mean=0.2050 min=0.2041 err=3.22e-06\r\nregs BL=2048 w=8: mean=0.2058 min=0.2041 err=3.22e-06\r\nregs BL=2048 w=16: mean=0.2049 min=0.2039 err=3.22e-06\r\nbmajor BL=2048 w=8 EV=0: mean=0.2006 min=0.1997 err=3.22e-06\r\nbmajor BL=2048 w=8 EV=1: mean=0.2095 min=0.2089 err=3.22e-06\r\nbmajor BL=2048 w=16 EV=0: mean=0.2017 min=0.2007 err=3.22e-06\r\nbmajor BL=2048 w=16 EV=1: mean=0.2114 min=0.2108 err=3.22e-06\r\nregs BL=4096 w=4: mean=0.2039 min=0.2029 err=3.46e-06\r\nregs BL=4096 w=8: mean=0.2045 min=0.2036 err=3.46e-06\r\nregs BL=4096 w=16: mean=0.2036 min=0.2025 err=3.46e-06\r\nbmajor BL=4096 w=8 EV=0: mean=0.2007 min=0.1989 err=3.46e-06\r\nbmajor BL=4096 w=8 EV=1: mean=0.2074 min=0.2066 err=3.46e-06\r\nbmajor BL=4096 w=16 EV=0: mean=0.2006 min=0.1995 err=3.46e-06\r\nbmajor "]
[780.486788, "o", "BL=4096 w=16 EV=1: mean=0.2106 min=0.2092 err=3.46e-06\r\nregs BL=8192 w=4: mean=0.2044 min=0.2023 err=2.98e-06\r\nregs BL=8192 w=8: mean=0.2048 min=0.2039 err=2.98e-06\r\nregs BL=8192 w=16: mean=0.2044 min=0.2031 err=2.98e-06\r\nbmajor BL=8192 w=8 EV=0: mean=0.2002 min=0.1991 err=2.98e-06\r\nbmajor BL=8192 w=8 EV=1: mean=0.2082 min=0.2076 err=2.98e-06\r\nbmajor BL=8192 w=16 EV=0: mean=0.1988 min=0.1975 err=2.98e-06\r\nbmajor BL=8192 w=16 EV=1: mean=0.2055 min=0.2049 err=2.98e-06\r\n"]
