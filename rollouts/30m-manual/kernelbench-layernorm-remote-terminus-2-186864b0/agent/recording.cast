[76.007082, "o", "    num_correct_trials: int,\r\n    verbose: bool =False,\r\n    seed: int =42,\r\n    device: Optional[torch.device] =None,\r\n    backend: str =\"cuda\",\r\n    precision: torch.dtype =torch.float32,"]
[76.007105, "o", "\r\n) -> KernelExecResult:\r\n    \"\"\"\r\n    run the model and check correctness,\r\n"]
[76.007362, "o", "\u001b[?2004hroot@modal:/workspace# "]
[151.110138, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    @triton.jit\n    def _ln3d_kernel(\n        X, Y, W, B,\n        R, N, NB, eps,\n        BLOCK: tl.constexpr,\n        NSM: tl.constexpr,\n    ):\n        pid = tl.program_id(0)\n        total = R * NB\n        inv_n = 1.0 / N\n        for i in range(pid, total, NSM):\n            b = i // NB\n            o = (i - b * NB) * BLOCK + tl.arange(0, BLOCK)\n            offs = b * N + o\n            x = tl.load(X + offs)\n            mean = tl.sum(x) * inv_n\n            d = x - mean\n            var = tl.sum(d * d) * inv_n\n            rstd = 1.0 / tl.sqrt(var + eps)\n            w = tl.load(W + o)\n            bb = tl.load(B + o)\n            tl.store(Y + offs, d * rstd * w + bb)\n\n\n_BLOCK = 8192\n_WARPS = 16\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n     "]
[151.110184, "i", "   super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        shape = self.normalized_shape\n        if not (\n            _HAS_TRITON\n            and x.is_cuda\n            and x.dtype == torch.float32\n            and len(shape) == 3\n            and x.dim() == 4\n            and x.is_contiguous()\n            and self.ln.weight is not None\n            and self.ln.bias is not None\n        ):\n            return F.layer_norm(x, shape, self.ln.weight, self.ln.bias, self.ln.eps)\n        n = shape[0] * shape[1] * shape[2]\n        if n % _BLOCK != 0 or x.numel() % n != 0:\n            return F.layer_norm(x, shape, self.ln.weight, self.ln.bias, self.ln.eps)\n        r = x.numel() // n\n        y = torch.empty_like(x)\n        NB = n // _BLOCK\n        NSM = torch.cuda.get_device_properties(x.device).multi_processor_count\n        g = min(NSM, r * NB)\n        _ln3d_kernel[(g,)](\n    "]
[151.110277, "i", "        x, y, self.ln.weight, self.ln.bias,\n            r, n, NB, self.ln.eps,\n            BLOCK=_BLOCK, NSM=g, num_warps=_WARPS,\n        )\n        return y\nEOF\n"]
