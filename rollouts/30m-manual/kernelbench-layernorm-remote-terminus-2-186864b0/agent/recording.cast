[386.872071, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, numpy as np\nimport triton\nimport triton.language as tl\nimport torch.nn as nn\n\ndef bench(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    times = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return float(np.mean(times)), float(np.min(times))\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    o = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + o, tl.load(X + o))\n\n@triton.jit\ndef _part(X, WS, N, NB, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    o = (pid % NB) * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + b * N + o)\n    tl.store(WS + pid * 2, tl.sum(x))\n    tl.store(WS + pid * 2 + 1, tl.sum(x"]
[386.87212, "i", " * x))\n\n@triton.jit\ndef _norm(X, Y, W, B, WS, N, NB, eps, BLOCK: tl.constexpr, NBC: tl.constexpr):\n    pid = tl.program_id(0)\n    b = pid // NB\n    c = pid % NB\n    ar = tl.arange(0, NBC)\n    s = tl.sum(tl.load(WS + b * NB * 2 + ar * 2))\n    sq = tl.sum(tl.load(WS + b * NB * 2 + ar * 2 + 1))\n    inv = 1.0 / N\n    mean = s * inv\n    var = sq * inv - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    o = c * BLOCK + tl.arange(0, BLOCK)\n    offs = b * N + o\n    x = tl.load(X + offs)\n    w = tl.load(W + o)\n    bb = tl.load(B + o)\n    tl.store(Y + offs, (x - mean) * rstd * w + bb)\n\nx = torch.rand(16,64,256,256, device='cuda')\nln = nn.LayerNorm((64,256,256)).cuda()\nw, b = ln.weight, ln.bias\neps = ln.eps\nN = 64*256*256\nR = 16\ny = torch.empty_like(x)\nref = ln(x)\n\n# roofline\nfor BLOCK in [4096, 8192, 16384]:\n    for warps in [4, 8, 16]:\n        g = x.numel() // BLOCK\n        m, mn = bench(lambda: _copy[(g,)](x, y, BLOCK=BLOCK, num_warps=warps))\n        print(f'copy BLOCK={BLOCK} warps={warps}: mean={m:.4f} min={mn:.4"]
[386.872134, "i", "f} -> {x.numel()*8/m/1e9:.0f} GB/s')\n\nfor BLOCK in [4096, 8192, 16384, 32768]:\n    NB = N // BLOCK\n    for w1 in [4, 8, 16]:\n        for w2 in [8, 16, 32]:\n            ws = torch.empty(R*NB*2, device='cuda')\n            g = R * NB\n            def run():\n                _part[(g,)](x, ws, N, NB, BLOCK=BLOCK, num_warps=w1)\n                _norm[(g,)](x, y, w, b, ws, N, NB, eps, BLOCK=BLOCK, NBC=NB, num_warps=w2)\n            run()\n            err = (y - ref).abs().max().item()\n            m, mn = bench(run)\n            print(f'2k BLOCK={BLOCK} w1={w1} w2={w2}: mean={m:.4f} min={mn:.4f} err={err:.2e}')\nEOF\ngpu push sb-F7I6DbT5b7mTtD91nyBmIv /workspace/bench2.py /workspace/bench2.py\n"]
