[1211.341017, "o", "    def _ln_reduce(WS, MR, NB, eps, N, NBV: tl.constexpr):\r\n\u001b[?2004l\r "]
[1211.341049, "o", "\u001b[?2004h"]
[1211.341076, "o", "> "]
[1211.341129, "o", "        b = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1211.341159, "o", "\u001b[?2004h> "]
[1211.341234, "o", "        ar = tl.arange(0, NBV)\r\n\u001b[?2004l\r"]
[1211.341266, "o", "\u001b[?2004h> "]
[1211.341422, "o", "        s = tl.sum(tl.load(WS + b * NB * 2 + ar * 2))\r\n\u001b[?2004l\re\u001b[?2004h"]
[1211.341458, "o", "> "]
[1211.341621, "o", "        sq = tl.sum(tl.load(WS + b * NB * 2 + ar * 2 + 1))\r\n\u001b[?2004l\r"]
[1211.341655, "o", "D\u001b[?2004h> "]
[1211.341705, "o", "        inv = 1.0 / N\r\n\u001b[?2004l\r"]
[1211.341734, "o", "\u001b[?2004h> "]
[1211.3418, "o", "        mean = s * inv\r\n\u001b[?2004l\r"]
[1211.341829, "o", "\u001b[?2004h> "]
[1211.34189, "o", "        var = sq * inv - mean * mean\r\n\u001b[?2004l\r"]
[1211.341922, "o", "\u001b[?2004h> "]
[1211.341973, "o", "        tl.store(MR + b * 2, mean)\r\n\u001b[?2004l\r"]
[1211.342002, "o", "\u001b[?2004h> "]
[1211.342091, "o", "        tl.store(MR + b * 2 + 1, 1.0 / tl.sqrt(var + eps))\r\n\u001b[?2004l\r"]
[1211.342124, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.342155, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[1211.342187, "o", "\u001b[?2004h> "]
[1211.342308, "o", "    def _ln_norm(X, Y, W, B, MR, N, NB, R: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1211.342343, "o", "\u001b[?2004h> "]
[1211.34238, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1211.342409, "o", "\u001b[?2004h> "]
[1211.342443, "o", "        b = pid % R\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.342487, "o", "        c = pid // R\r\n\u001b[?2004l\r"]
[1211.34252, "o", "\u001b[?2004h> "]
[1211.342566, "o", "        mean = tl.load(MR + b * 2)\r\n\u001b[?2004l\r"]
[1211.342603, "o", "\u001b[?2004h> "]
[1211.342657, "o", "        rstd = tl.load(MR + b * 2 + 1)\r\n\u001b[?2004l\r"]
[1211.342686, "o", "\u001b[?2004h> "]
[1211.34275, "o", "        o = c * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1211.34278, "o", "\u001b[?2004h> "]
[1211.342807, "o", "        offs = b * N + o\r\n\u001b[?2004l\r"]
[1211.342839, "o", "\u001b[?2004h> "]
[1211.342881, "o", "        x = tl.load(X + offs)\r\n\u001b[?2004l\r"]
[1211.342911, "o", "\u001b[?2004h> "]
[1211.342947, "o", "        w = tl.load(W + o)\r\n\u001b[?2004l\r"]
[1211.342984, "o", "\u001b[?2004h> "]
[1211.343016, "o", "        bb = tl.load(B + o)\r\n\u001b[?2004l\r"]
[1211.343043, "o", "\u001b[?2004h> "]
[1211.343127, "o", "        tl.store(Y + offs, (x - mean) * rstd * w + bb)\r\n\u001b[?2004l\r"]
[1211.343162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1211.343194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.343232, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1211.343257, "o", "\u001b[?2004h> "]
[1211.343333, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[1211.343362, "o", "\u001b[?2004h> "]
[1211.343395, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1211.343427, "o", "\u001b[?2004h> "]
[1211.343527, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[1211.34356, "o", "\u001b[?2004h> "]
[1211.343637, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[1211.343666, "o", "\u001b[?2004h> "]
[1211.3437, "o", "        self._fn = None\r\n\u001b[?2004l\r"]
[1211.343732, "o", "\u001b[?2004h> "]
[1211.343765, "o", "        self._graphs = {}\r\n\u001b[?2004l\r"]
[1211.343795, "o", "\u001b[?2004h> "]
[1211.343828, "o", "        if _HAS_TRITON:\r\n\u001b[?2004l\r"]
[1211.343853, "o", "\u001b[?2004h> "]
[1211.343885, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.343912, "o", "> "]
[1211.343946, "o", "                n = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.344037, "o", "                for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[1211.344064, "o", "\u001b[?2004h> "]
[1211.344103, "o", "                    n *= s\r\n\u001b[?2004l\r"]
[1211.34413, "o", "\u001b[?2004h> "]
[1211.344238, "o", "                if len(self.normalized_shape) == 3 and n % _BLOCK == 0:\r\n\u001b[?2004l\r"]
[1211.344268, "o", "\u001b[?2004h> "]
[1211.344319, "o", "                    nb = n // _BLOCK\r\n\u001b[?2004l\r"]
[1211.344349, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.344381, "o", "> "]
[1211.344505, "o", "                    def fn(x, w, b, ws, mr, y, _R=_ROWS, _NB=nb, _N=n, _eps=self.ln.eps):\r\n\u001b[?2004l\r"]
[1211.34454, "o", "\u001b[?2004h> "]
[1211.344673, "o", "                        _ln_part[(_R * _NB,)](x, ws, _N, _NB, BLOCK=_BLOCK, num_warps=_W1)\r\n\u001b[?2004l\r"]
[1211.344707, "o", "\u001b[?2004h> "]
[1211.34484, "o", "                        _ln_reduce[(_R,)](ws, mr, _NB, _eps, _N, NBV=_NB, num_warps=_WR)\r\n\u001b[?2004l\r"]
[1211.344872, "o", "\u001b[?2004h> "]
[1211.345035, "o", "                        _ln_norm[(_R * _NB,)](x, y, w, b, mr, _N, _NB, R=_R, BLOCK=_BLOCK, num_warps=_W2)\r\n\u001b[?2004l\r"]
[1211.345066, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.345131, "o", "                    self._fn = fn\r\n\u001b[?2004l\r"]
[1211.345162, "o", "\u001b[?2004h> "]
[1211.345201, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[1211.345231, "o", "\u001b[?2004h> "]
[1211.345274, "o", "                self._fn = None\r\n\u001b[?2004l\r"]
[1211.345304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.345355, "o", "    def _plain(self, x):\r\n\u001b[?2004l\r"]
[1211.345385, "o", "\u001b[?2004h> "]
[1211.345457, "o", "        nb = (x.numel() // x.shape[0]) // _BLOCK\r\n\u001b[?2004l\r"]
[1211.345482, "o", "\u001b[?2004h> "]
[1211.345615, "o", "        ws = torch.empty(x.shape[0] * nb * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1211.345647, "o", "\u001b[?2004h> "]
[1211.345763, "o", "        mr = torch.empty(x.shape[0] * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1211.345788, "o", "\u001b[?2004h> "]
[1211.345836, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1211.345866, "o", "\u001b[?2004h> "]
[1211.345963, "o", "        self._fn(x, self.ln.weight, self.ln.bias, ws, mr, y)\r\n\u001b[?2004l\r"]
[1211.345987, "o", "\u001b[?2004h> "]
[1211.346023, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.346055, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.346104, "o", "    def _make_graph(self, x):\r\n\u001b[?2004l\r"]
[1211.346134, "o", "\u001b[?2004h> "]
[1211.346202, "o", "        nb = (x.numel() // x.shape[0]) // _BLOCK\r\n\u001b[?2004l\r"]
[1211.346232, "o", "\u001b[?2004h> "]
[1211.346359, "o", "        ws = torch.empty(x.shape[0] * nb * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1211.346389, "o", "\u001b[?2004h> "]
[1211.346507, "o", "        mr = torch.empty(x.shape[0] * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1211.346568, "o", "\u001b[?2004h> "]
[1211.346609, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.34671, "o", "        # eager warm run (also produces this call's result in y)\r\n\u001b[?2004l\r"]
[1211.346737, "o", "\u001b[?2004h> "]
[1211.346829, "o", "        self._fn(x, self.ln.weight, self.ln.bias, ws, mr, y)\r\n\u001b[?2004l\r"]
[1211.346856, "o", "\u001b[?2004h> "]
[1211.346906, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1211.346938, "o", "\u001b[?2004h> "]
[1211.34699, "o", "        gr = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[1211.347017, "o", "\u001b[?2004h> "]
[1211.347063, "o", "        s = torch.cuda.Stream()\r\n\u001b[?2004l\r"]
[1211.347087, "o", "\u001b[?2004h> "]
[1211.347166, "o", "        s.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r"]
[1211.347193, "o", "\u001b[?2004h> "]
[1211.347245, "o", "        with torch.cuda.stream(s):\r\n\u001b[?2004l\r"]
[1211.347273, "o", "\u001b[?2004h> "]
[1211.347318, "o", "            gr.capture_begin()\r\n\u001b[?2004l\r"]
[1211.347344, "o", "\u001b[?2004h> "]
[1211.347444, "o", "            self._fn(x, self.ln.weight, self.ln.bias, ws, mr, y)\r\n\u001b[?2004l\r"]
[1211.347477, "o", "\u001b[?2004h> "]
[1211.347509, "o", "            gr.capture_end()\r\n\u001b[?2004l\r"]
[1211.347535, "o", "\u001b[?2004h> "]
[1211.347617, "o", "        torch.cuda.current_stream().wait_stream(s)\r\n\u001b[?2004l\r"]
[1211.347648, "o", "\u001b[?2004h> "]
[1211.347693, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1211.347721, "o", "\u001b[?2004h> "]
[1211.347764, "o", "        return (gr, y, ws, mr)\r\n\u001b[?2004l\r"]
[1211.347793, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.347898, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[1211.347929, "o", "\u001b[?2004h> "]
[1211.347991, "o", "        shape = self.normalized_shape\r\n\u001b[?2004l\r"]
[1211.348022, "o", "\u001b[?2004h> "]
[1211.348049, "o", "        if not (\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.348079, "o", "> "]
[1211.348106, "o", "            _HAS_TRITON\r\n\u001b[?2004l\r"]
[1211.348139, "o", "\u001b[?2004h> "]
[1211.348183, "o", "            and self._fn is not None\r\n\u001b[?2004l\r"]
[1211.34822, "o", "\u001b[?2004h> "]
[1211.348253, "o", "            and x.is_cuda\r\n\u001b[?2004l\r"]
[1211.348283, "o", "\u001b[?2004h> "]
[1211.348341, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1211.348366, "o", "\u001b[?2004h> "]
[1211.34841, "o", "            and x.dim() == 4\r\n\u001b[?2004l\r"]
[1211.34844, "o", "\u001b[?2004h> "]
[1211.348492, "o", "            and x.shape[1:] == shape\r\n\u001b[?2004l\r"]
[1211.348517, "o", "\u001b[?2004h> "]
[1211.348568, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[1211.348597, "o", "\u001b[?2004h> "]
[1211.348648, "o", "            and x.shape[0] == _ROWS\r\n\u001b[?2004l\r"]
[1211.348675, "o", "\u001b[?2004h> "]
[1211.34874, "o", "            and self.ln.weight is not None\r\n\u001b[?2004l\r"]
[1211.348769, "o", "\u001b[?2004h> "]
[1211.348828, "o", "            and self.ln.bias is not None\r\n\u001b[?2004l\r"]
[1211.348857, "o", "\u001b[?2004h> "]
[1211.348925, "o", "            and self.ln.weight.is_contiguous()\r\n\u001b[?2004l\r"]
[1211.348963, "o", "\u001b[?2004h> "]
[1211.349023, "o", "            and self.ln.bias.is_contiguous()\r\n\u001b[?2004l\r"]
[1211.349054, "o", "\u001b[?2004h> "]
[1211.34909, "o", "        ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.349219, "o", "            return F.layer_norm(x, shape, self.ln.weight, self.ln.bias, self.ln.eps)\r\n\u001b[?2004l\r"]
[1211.349244, "o", "\u001b[?2004h> "]
[1211.34928, "o", "        try:\r\n\u001b[?2004l\r"]
[1211.349312, "o", "\u001b[?2004h> "]
[1211.349392, "o", "            capturing = torch.cuda.is_current_stream_capturing()\r\n\u001b[?2004l\r"]
[1211.349426, "o", "\u001b[?2004h> "]
[1211.349455, "o", "        except Exception:\r\n"]
[1211.349489, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1211.349528, "o", "            capturing = True\r\n\u001b[?2004l\r"]
[1211.349561, "o", "\u001b[?2004h> "]
[1211.349594, "o", "        if capturing:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1211.349624, "o", "> "]
[1211.349657, "o", "            return self._plain(x)\r\n\u001b[?2004l\r"]
[1211.349689, "o", "\u001b[?2004h> "]
[1211.349757, "o", "        key = (x.data_ptr(), tuple(x.shape))\r\n\u001b[?2004l\r"]
[1211.34979, "o", "\u001b[?2004h> "]
[1211.349837, "o", "        ent = self._graphs.get(key)\r\n\u001b[?2004l\r"]
[1211.349865, "o", "\u001b[?2004h> "]
[1211.349897, "o", "        if ent is None:\r\n\u001b[?2004l\r"]
[1211.349928, "o", "\u001b[?2004h> "]
[1211.350007, "o", "            if len(self._graphs) >= _MAX_GRAPHS:\r\n\u001b[?2004l\r"]
[1211.350038, "o", "\u001b[?2004h> "]
[1211.35009, "o", "                return self._plain(x)\r\n\u001b[?2004l\r"]
[1211.350122, "o", "\u001b[?2004h> "]
[1211.350149, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1211.350227, "o", "                ent = self._make_graph(x)\r\n\u001b[?2004l\r"]
[1211.350259, "o", "\u001b[?2004h> "]
[1211.350299, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[1211.350331, "o", "\u001b[?2004h> "]
[1211.350381, "o", "                return self._plain(x)\r\n\u001b[?2004l\r"]
[1211.350408, "o", "\u001b[?2004h> "]
[1211.350462, "o", "            self._graphs[key] = ent\r\n\u001b[?2004l\r"]
[1211.350495, "o", "\u001b[?2004h> "]
[1211.350528, "o", "            return ent[1]\r\n\u001b[?2004l\r"]
[1211.35056, "o", "\u001b[?2004h> "]
[1211.350595, "o", "        ent[0].replay()\r\n\u001b[?2004l\r"]
[1211.350628, "o", "\u001b[?2004h> "]
[1211.35066, "o", "        return ent[1]\r\n\u001b[?2004l\r"]
[1211.350691, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1211.351927, "o", "\u001b[?2004hroot@modal:/workspace# "]
