@triton.jit
def _ln_apply_kernel(
    x_ptr, mean_ptr, rstd_ptr, w_ptr, b_ptr, y_ptr,
    N, BPR, eps, BLOCK: tl.constexpr,
):
    pid = tl.program_id(0)
    row = pid // BPR
    offs = pid * BLOCK + tl.arange(0, BLOCK)
    v = tl.load(x_ptr + offs)
    w = tl.load(w_ptr + offs % N)
    b = tl.load(b_ptr + offs % N)
    mean = tl.load(mean_ptr + row)
    rstd = tl.load(rstd_ptr + row)
    tl.store(y_ptr + offs, (v - mean) * rstd * w + b)


class ModelNew(nn.Module):
    def __init__(self, normalized_shape: tuple):
        super().__init__()
        self.normalized_shape = tuple(normalized_shape)
        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)
        self._part = None

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if not x.is_contiguous():
            x = x.contiguous()
        N = self.ln.normalized_shape[0]
        row2d = x.shape[-2] // N
        numel_per_row = row2d * N
        C = x.numel() // numel_per_row
        total = x.numel()
        w = self.ln.weight
        b = self.ln.bias
        eps = self.ln.eps
        x2 = x.view(-1)
        y = torch.empty_like(x)
        y2 = y.view(-1)
        NCHUNKS = 8
        part = self._part
        if part is None or part.shape[0] < C * NCHUNKS * 3:
