[?2004l[?2004h> # variant: apply without gdc_wait
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def apply_nog(x_ptr, s1_ptr, s2_ptr, w_ptr, b_ptr, y_ptr, eps,
[?2004l[?2004h>               C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     wv = tl.load(w_ptr + offs)
[?2004l[?2004h>     bv = tl.load(b_ptr + offs)
[?2004l[?2004h>     rows = tl.arange(0, C)
[?2004l[?2004h>     ch = tl.arange(0, NCHUNKS)
[?2004l[?2004h>     idx = rows[:, None] * NCHUNKS + ch[None, :]
[?2004l[?2004h>     ps1 = tl.load(s1_ptr + idx)
[?2004l[?2004h>     ps2 = tl.load(s2_ptr + idx)
[?2004l[?2004h>     s1v = tl.sum(tl.sum(ps1, axis=1), axis=0)
[?2004l[?2004h>     s2v = tl.sum(tl.sum(ps2, axis=1), axis=0)
[?2004l[?2004h>     mean = s1v / N
[?2004l[?2004h>     var = tl.maximum(s2v / N - mean * mean, 0.0)
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     a = rstd * wv
[?2004l[?2004h>     c = bv - mean * a
[?2004l[?2004h>     for r in range(C):
[?2004l[?2004h>         v = tl.load(x_ptr + r * N + offs)
[?2004l[?2004h>         tl.store(y_ptr + r * N + offs, v * a + c)
[?2004l[?2004h> 
[?2004l[?2004h> w = torch.ones(npr, device='cuda'); b = torch.zeros(npr, device='cuda')
[?2004l[?2004h> y = torch.empty_like(x); y2 = y.view(-1)
[?2004l[?2004h> apply_nog[(npr // 8192,)](x2, s1, s2, w, b, y2, 1e-5, C=C, BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2)
[?2004l[?2004h> torch.cuda.synchronize()
