[1367.159768, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\n@triton.jit\ndef stats_v2(x_ptr, part_s1_ptr, part_s2_ptr,\n             numel_per_row, NCHUNKS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NCHUNKS\n    chunk = pid % NCHUNKS\n    chunk_size = (numel_per_row + NCHUNKS - 1) // NCHUNKS\n    start = row * numel_per_row + chunk * chunk_size\n    end = tl.minimum(start + chunk_size, (row + 1) * numel_per_row)\n    a1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    a2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for off in range(start, end, BLOCK):\n        v = tl.load(x_ptr + off + tl.arange(0, BLOCK))\n        a1 += v\n        a2 += v * v\n    tl.store(part_s1_ptr + pid, tl.sum(a1, axis=0))\n    tl.store(part_s2_ptr + pid, tl.sum(a2, axis=0))\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\nbest = (1e9, None)\nfor NCH in [32, 64, 132, 264, 512]:\n"]
[1367.159817, "i", "    for BLK in [2048, 4096, 8192]:\n        for wp in [4, 8, 16]:\n            for st in [2, 4, 6]:\n                chunk = (npr + NCH - 1)//NCH\n                if chunk % BLK != 0:\n                    continue\n                pm = torch.empty(C*NCH, device='cuda'); p2 = torch.empty(C*NCH, device='cuda')\n                t = do_bench(lambda: stats_v2[(C*NCH,)](x2, pm, p2, npr, NCHUNKS=NCH, BLOCK=BLK, num_warps=wp, num_stages=st))\n                if t < best[0]: best = (t, (NCH,BLK,wp,st))\n                print(f'v2 NCH={NCH} BLK={BLK} w={wp} st={st}: {t*1000:.1f} us')\nprint('BEST', best)\n\n# accuracy check\nNCH, BLK, wp, st = best[1]\npm = torch.zeros(C*NCH, device='cuda'); p2 = torch.zeros(C*NCH, device='cuda')\nstats_v2[(C*NCH,)](x2, pm, p2, npr, NCHUNKS=NCH, BLOCK=BLK, num_warps=wp, num_stages=st)\ntorch.cuda.synchronize()\ns1 = pm.view(C, NCH).sum(1); s2 = p2.view(C, NCH).sum(1)\nmean = s1 / npr; var = s2/npr - mean*mean\nm0 = x.mean(dim=(1,2,3)); v0 = x.var(dim=(1,2,3), unbiased=False)\nprint('mean diff', (mean-m0)."]
[1367.159827, "i", "abs().max().item())\nprint('var diff', (var-v0).abs().max().item())\nrstd = 1/(var+1e-5).sqrt(); r0 = 1/(v0+1e-5).sqrt()\nprint('rstd diff', (rstd-r0).abs().max().item())\nEOF\ngpu run -- python3 /workspace/bench5.py 2>&1 | tail -25\n"]
