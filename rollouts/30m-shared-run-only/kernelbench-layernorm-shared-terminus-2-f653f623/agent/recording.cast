[147.223816, "o", "\u001b[32m\u001b[K602\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef get_timing_stats\u001b[m\u001b[K(elapsed_times: list[float], device: torch.device = None) -> dict:\r\n\u001b[32m\u001b[K603\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"Get timing statistics from a list of elapsed times.\r\n\u001b[32m\u001b[K604\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K605\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Args:\r\n\u001b[32m\u001b[K606\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        elapsed_times: List of elapsed times in milliseconds\r\n\u001b[32m\u001b[K607\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        device: CUDA device, record device info\r\n\u001b[32m\u001b[K608\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Returns:\r\n\u001b[32m\u001b[K609\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        Dict containing mean, std, min, max and num_trials\r\n\u001b[32m\u001b[K610\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        all timing are in ms\r\n\u001b[32m\u001b[K611\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n"]
[147.223835, "o", "\u001b[32m\u001b[K612\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K613\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    stats = {\r\n\u001b[32m\u001b[K614\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \"mean\": float(f\"{np.mean(elapsed_times):.3g}\"),\r\n\u001b[32m\u001b[K615\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \"std\": float(f\"{np.std(elapsed_times):.3g}\"),\r\n"]
[147.2239, "o", "\u001b[32m\u001b[K616\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \"min\": float(f\"{np.min(elapsed_times):.3g}\"),\r\n\u001b[32m\u001b[K617\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \"max\": float(f\"{np.max(elapsed_times):.3g}\"),\r\n\u001b[32m\u001b[K618\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \"num_trials\": len(elapsed_times),\r\n\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K620\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K621\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if device:\r\n\u001b[32m\u001b[K622\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        stats[\"hardware\"] = torch.cuda.get_device_name(device=device)\r\n\u001b[32m\u001b[K623\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        stats[\"device\"] = str(device)  # for debugging\r\n\u001b[32m\u001b[K624\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K625\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return stats\r\n\u001b[32m\u001b[K626\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
