[952.840137, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\n@triton.jit\ndef apply_v2(x_ptr, mean_ptr, rstd_ptr, w_ptr, b_ptr, y_ptr,\n             C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    wv = tl.load(w_ptr + offs)\n    bv = tl.load(b_ptr + offs)\n    for r in range(C):\n        base = r * N + offs\n        v = tl.load(x_ptr + base)\n        mean = tl.load(mean_ptr + r)\n        rstd = tl.load(rstd_ptr + r)\n        tl.store(y_ptr + base, (v - mean) * rstd * wv + bv)\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\nw = torch.randn(npr, device='cuda'); b = torch.randn(npr, device='cuda')\ny = torch.empty_like(x); y2 = y.view(-1)\nmean = torch.empty(C, device='cuda'); rstd = torch.empty(C, device='cuda')\n\nfor BLK in [2048, 4096, 8192]:\n    for wp in [4, 8, 16]:\n        for st in [1, 2, 4]:\n"]
[952.840183, "i", "            t = do_bench(lambda: apply_v2[(npr // BLK,)](x2, mean, rstd, w, b, y2, C=C, BLOCK=BLK, N=npr, num_warps=wp, num_stages=st))\n            print(f'apply_v2 BLK={BLK} w={wp} st={st}: {t*1000:.1f} us')\n\n# correctness spot check\nref = torch.nn.functional.layer_norm(x, (64,256,256), w, b, 1e-5)\nmean.copy_(x.mean(dim=(1,2,3))); rstd.copy_(1/(x.var(dim=(1,2,3),unbiased=False)+1e-5).sqrt())\napply_v2[(npr // 8192,)](x2, mean, rstd, w, b, y2, C=C, BLOCK=8192, N=npr, num_warps=8, num_stages=2)\ntorch.cuda.synchronize()\nprint('v2 diff', (y-ref).abs().max().item())\nEOF\ngpu run -- python3 /workspace/bench3.py 2>&1 | tail -32\n"]
