[1623.111103, "i", "cat > /workspace/bench8.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom sol3 import _apply3, _stats3\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\nNCH = 512\ns1 = torch.zeros(C*NCH, device='cuda'); s2 = torch.zeros(C*NCH, device='cuda')\n_stats3[(C*NCH,)](x2, s1, s2, npr, NCHUNKS=NCH, BLOCK=8192, num_warps=8, num_stages=2, launch_pdl=False)\nw = torch.ones(npr, device='cuda'); b = torch.zeros(npr, device='cuda')\ny = torch.empty_like(x); y2 = y.view(-1)\n_apply3[(npr // 8192,)](x2, s1, s2, w, b, y2, 1e-5, C=C, BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2, launch_pdl=False)\ntorch.cuda.synchronize()\nS1 = s1.view(C, NCH).sum(1); S2 = s2.view(C, NCH).sum(1)\nmean = S1/npr; var = S2/npr - mean*mean; rstd = 1/(var+1e-5).sqrt()\nref = (x - mean.view(16,1,1,1)) * rstd.view(16,1,1,1)\nprint('manual diff', (y-ref).abs().max().item())\n# check per-row: which rows are wrong?\nd = (y-ref).abs().amax(dim=(1,2,3))\nprint('per-row diff', d)\nEOF\ngpu run -- python3"]
[1623.111159, "i", " /workspace/bench8.py 2>&1 | tail -5\n"]
