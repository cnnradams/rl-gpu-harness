[1690.373992, "o", "\u001b[?2004h> "]
[1690.374143, "o", "def apply_nog(x_ptr, s1_ptr, s2_ptr, w_ptr, b_ptr, y_ptr, eps,\r\n\u001b[?2004l\r"]
[1690.374171, "o", "\u001b[?2004h> "]
[1690.374378, "o", "              C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1690.3744, "o", "\u001b[?2004h> "]
