[1636.617953, "o", "command: 9f35c519a65c45d4ad248cbb5e11d1e0\r\nmanual diff 2527.875244140625\r\nper-row diff tensor([2527.8733, 2527.8733, 2527.8740, 2527.8738, 2527.8752, 2527.8723,\r\n        2527.8735, 2527.8743, 2527.8733, 2527.8728, 2527.8745, 2527.8740,\r\n        2527.8733, 2527.8748, 2527.8733, 2527.8730], device='cuda:0')\r\n"]
