[1763.052824, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.052866, "o", "> "]
[1763.052904, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1763.052963, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[1763.052996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.053037, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1763.053063, "o", "\u001b[?2004h> "]
[1763.053244, "o", "def apply_dbg(x_ptr, s1_ptr, s2_ptr, y_ptr, mean_out, rstd_out, eps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.053284, "o", "> "]
[1763.053487, "o", "              C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1763.053527, "o", "\u001b[?2004h> "]
[1763.053576, "o", "    rows = tl.arange(0, C)\r\n\u001b[?2004l\r"]
[1763.053616, "o", "\u001b[?2004h> "]
[1763.053677, "o", "    ch = tl.arange(0, NCHUNKS)\r\n\u001b[?2004l\r"]
[1763.053718, "o", "\u001b[?2004h> "]
[1763.053817, "o", "    idx = rows[:, None] * NCHUNKS + ch[None, :]\r\n\u001b[?2004l\r"]
[1763.053851, "o", "\u001b[?2004h> "]
[1763.053919, "o", "    ps1 = tl.load(s1_ptr + idx)\r\n\u001b[?2004l\r"]
[1763.053951, "o", "\u001b[?2004h> "]
[1763.054021, "o", "    ps2 = tl.load(s2_ptr + idx)\r\n\u001b[?2004l\r"]
[1763.054042, "o", "\u001b[?2004h> "]
[1763.054155, "o", "    s1v = tl.sum(tl.sum(ps1, axis=1), axis=0)\r\n\u001b[?2004l\r"]
[1763.054195, "o", "\u001b[?2004h> "]
[1763.05429, "o", "    s2v = tl.sum(tl.sum(ps2, axis=1), axis=0)\r\n\u001b[?2004l\r"]
[1763.054322, "o", "\u001b[?2004h> "]
[1763.054365, "o", "    mean = s1v / N\r\n\u001b[?2004l\r"]
[1763.05441, "o", "\u001b[?2004h> "]
[1763.054512, "o", "    var = tl.maximum(s2v / N - mean * mean, 0.0)\r\n\u001b[?2004l\r"]
[1763.054552, "o", "\u001b[?2004h> "]
[1763.054627, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1763.054666, "o", "\u001b[?2004h> "]
[1763.054722, "o", "    tl.store(mean_out, mean)\r\n\u001b[?2004l\r"]
[1763.054757, "o", "\u001b[?2004h> "]
[1763.054816, "o", "    tl.store(rstd_out, rstd)\r\n\u001b[?2004l\r"]
[1763.054855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.054888, "o", "> "]
[1763.054976, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1763.055016, "o", "\u001b[?2004h> "]
[1763.055051, "o", "x2 = x.view(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.055089, "o", "> "]
[1763.055122, "o", "npr = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.055161, "o", "> C = 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.055199, "o", "> NCH = 512\r\n\u001b[?2004l\r"]
[1763.055232, "o", "\u001b[?2004h> "]
[1763.055424, "o", "s1 = torch.zeros(C*NCH, device='cuda'); s2 = torch.zeros(C*NCH, device='cuda')\r\n\u001b[?2004l\r"]
[1763.055463, "o", "\u001b[?2004h> "]
[1763.055502, "o", "from sol3 import _stats3\r\n\u001b[?2004l\r"]
[1763.05554, "o", "\u001b[?2004h> "]
[1763.055804, "o", "_stats3[(C*NCH,)](x2, s1, s2, npr, NCHUNKS=NCH, BLOCK=8192, num_warps=8, num_stages=2, launch_pdl=False)\r\n\u001b[?2004l\r"]
[1763.055818, "o", "\u001b[?2004h"]
[1763.055868, "o", "> "]
[1763.055995, "o", "mo = torch.zeros(1, device='cuda'); ro = torch.zeros(1, device='cuda')\r\n\u001b[?2004l\r"]
[1763.056037, "o", "\u001b[?2004h> "]
[1763.056291, "o", "apply_dbg[(1,)](x2, s1, s2, x2, mo, ro, 1e-5, C=C, BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.056336, "o", "> "]
[1763.056379, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1763.056538, "o", "print('kernel mean', mo.item(), 'ref', x.mean().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[1763.056581, "o", "> "]
[1763.056761, "o", "print('kernel rstd', ro.item(), 'ref', (1/(x.var(unbiased=False)+1e-5).sqrt()).item())\r\n\u001b[?2004l\r"]
[1763.056802, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
