[742.32715, "o", "  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\",\r\n    \"excessive_speedup\": true\r\n  },\r\n  \"runtime\": 0.517,\r\n  \"runtime_stats\": {\r\n    \"mean\": 0.517,\r\n    \"std\": 0.0159,\r\n    \"min\": 0.511,\r\n    \"max\": 0.584,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 8.08,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 8.08,\r\n    \"std\": 0.00552,\r\n    \"min\": 8.07,\r\n    \"max\": 8.09,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"14037d6b460656189984a4a26bf721a6e44031501a2f31c5f4d3cf9dfede52cd\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 15.628626692456479\r\n}\r\n"]
