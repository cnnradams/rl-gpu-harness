[1292.314605, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\nfrom solution import _ln_stats_kernel\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\n\nfor NCH in [32, 64, 132, 264]:\n    for BLK in [4096, 8192, 16384]:\n        for wp in [8, 16]:\n            for st in [2, 3, 5]:\n                pm = torch.empty(C*NCH, device='cuda'); p2 = torch.empty(C*NCH, device='cuda'); cn = torch.empty(C*NCH, device='cuda')\n                chunk = (npr + NCH - 1)//NCH\n                if chunk % BLK != 0:\n                    continue\n                t = do_bench(lambda: _ln_stats_kernel[(C*NCH,)](x2, pm, p2, cn, npr, NCHUNKS=NCH, BLOCK=BLK, num_warps=wp, num_stages=st))\n                print(f'stats NCH={NCH} BLK={BLK} w={wp} st={st}: {t*1000:.1f} us')\nEOF\ngpu run -- python3 /workspace/bench4.py 2>&1 | tail -40\n"]
[1292.314812, "o", "cat > /workspace/bench4.py << 'EOF'"]
