[1021.169953, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[1021.169988, "o", "\u001b[?2004h> "]
[1021.170062, "o", "        if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[1021.170098, "o", "\u001b[?2004h> "]
[1021.170161, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r"]
[1021.170201, "o", "\u001b[?2004h> "]
[1021.170246, "o", "        numel_per_row = 1\r\n\u001b[?2004l\r"]
[1021.170287, "o", "\u001b[?2004h> "]
[1021.170377, "o", "        for s in self.ln.normalized_shape:\r\n\u001b[?2004l\r"]
[1021.170416, "o", "\u001b[?2004h> "]
[1021.170478, "o", "            numel_per_row *= s\r\n\u001b[?2004l\r"]
[1021.170516, "o", "\u001b[?2004h> "]
[1021.170567, "o", "        total = x.numel()\r\n\u001b[?2004l\r"]
[1021.170605, "o", "\u001b[?2004h> "]
[1021.170675, "o", "        C = total // numel_per_row\r\n\u001b[?2004l\r"]
[1021.170713, "o", "\u001b[?2004h> "]
[1021.170763, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r"]
[1021.170801, "o", "\u001b[?2004h> "]
[1021.170851, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r"]
[1021.170886, "o", "\u001b[?2004h> "]
[1021.17094, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r"]
[1021.170974, "o", "\u001b[?2004h> "]
[1021.171024, "o", "        x2 = x.view(-1)\r\n\u001b[?2004l\r"]
[1021.171059, "o", "\u001b[?2004h> "]
[1021.171127, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1021.171162, "o", "\u001b[?2004h> "]
[1021.171212, "o", "        y2 = y.view(-1)\r\n\u001b[?2004l\r"]
[1021.17125, "o", "\u001b[?2004h> "]
[1021.171294, "o", "        NCHUNKS = 32\r\n\u001b[?2004l\r"]
[1021.171333, "o", "\u001b[?2004h> "]
[1021.171383, "o", "        part = self._part\r\n\u001b[?2004l\r"]
[1021.171417, "o", "\u001b[?2004h> "]
[1021.171544, "o", "        if part is None or part.shape[0] < C * NCHUNKS * 3:\r\n\u001b[?2004l\r"]
[1021.171584, "o", "\u001b[?2004h> "]
[1021.171787, "o", "            part = torch.empty(C * NCHUNKS * 3, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1021.171809, "o", "> "]
[1021.171874, "o", "            self._part = part\r\n\u001b[?2004l\r"]
[1021.17191, "o", "\u001b[?2004h> "]
[1021.171992, "o", "        part_mean = part[:C * NCHUNKS]\r\n\u001b[?2004l\r"]
[1021.17203, "o", "\u001b[?2004h> "]
[1021.172141, "o", "        part_m2 = part[C * NCHUNKS:2 * C * NCHUNKS]\r\n\u001b[?2004l\r"]
[1021.172179, "o", "\u001b[?2004h> "]
[1021.172302, "o", "        count = part[2 * C * NCHUNKS:3 * C * NCHUNKS]\r\n\u001b[?2004l\r"]
[1021.172341, "o", "\u001b[?2004h> "]
[1021.172487, "o", "        mr = torch.empty(2 * C, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1021.172526, "o", "\u001b[?2004h> "]
[1021.172563, "o", "        mean = mr[:C]\r\n\u001b[?2004l\r"]
[1021.172589, "o", "\u001b[?2004h> "]
[1021.172644, "o", "        rstd = mr[C:]\r\n\u001b[?2004l\r"]
[1021.172682, "o", "\u001b[?2004h> "]
[1021.172717, "o", "        BLOCK1 = 8192\r\n\u001b[?2004l\r"]
[1021.172747, "o", "\u001b[?2004h> "]
[1021.172845, "o", "        _ln_stats_kernel[(C * NCHUNKS,)](\r\n\u001b[?2004l\r"]
[1021.172884, "o", "\u001b[?2004h> "]
[1021.173004, "o", "            x2, part_mean, part_m2, count, numel_per_row,\r\n\u001b[?2004l\r"]
[1021.173033, "o", "\u001b[?2004h> "]
[1021.173188, "o", "            NCHUNKS=NCHUNKS, BLOCK=BLOCK1, num_warps=8, num_stages=5,\r\n\u001b[?2004l\r"]
[1021.173229, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[1021.173269, "o", "\u001b[?2004h> "]
[1021.173347, "o", "        _ln_reduce_kernel[(C,)](\r\n\u001b[?2004l\r"]
[1021.173385, "o", "\u001b[?2004h> "]
[1021.173537, "o", "            part_mean, part_m2, count, mean, rstd, numel_per_row, eps,\r\n\u001b[?2004l\r"]
[1021.173575, "o", "\u001b[?2004h> "]
[1021.173661, "o", "            NCHUNKS=NCHUNKS, num_warps=1,\r\n\u001b[?2004l\r"]
[1021.1737, "o", "\u001b[?2004h> "]
[1021.17374, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1021.173786, "o", "        BLOCK2 = 8192\r\n\u001b[?2004l\r"]
[1021.173823, "o", "\u001b[?2004h> "]
[1021.173933, "o", "        if numel_per_row % BLOCK2 == 0 and C <= 128:\r\n\u001b[?2004l\r"]
[1021.173972, "o", "\u001b[?2004h> "]
[1021.174092, "o", "            _ln_apply_kernel[(numel_per_row // BLOCK2,)](\r\n\u001b[?2004l\r"]
[1021.17413, "o", "\u001b[?2004h> "]
[1021.174302, "o", "                x2, mean, rstd, w, b, y2, C=C, BLOCK=BLOCK2, N=numel_per_row,\r\n\u001b[?2004l\r"]
[1021.174341, "o", "\u001b[?2004h> "]
[1021.174431, "o", "                num_warps=16, num_stages=2,\r\n\u001b[?2004l\r"]
[1021.174465, "o", "\u001b[?2004h> "]
[1021.174504, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1021.174549, "o", "        else:\r\n\u001b[?2004l\r"]
[1021.174583, "o", "\u001b[?2004h> "]
[1021.174775, "o", "            y = torch.nn.functional.layer_norm(x, self.ln.normalized_shape, w, b, eps)\r\n\u001b[?2004l\r"]
[1021.174811, "o", "\u001b[?2004h> "]
[1021.174849, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[1021.174887, "o", "> EOF\r\n\u001b[?2004l\r"]
[1021.176533, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1021.176718, "o", "gpu run -- python3 /opt/task/evaluate.py /workspace/solution.py 2>&1 | tail -28\r\n\u001b[?2004l\r"]
