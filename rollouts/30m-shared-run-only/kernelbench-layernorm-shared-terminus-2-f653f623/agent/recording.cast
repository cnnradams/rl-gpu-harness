[1317.58996, "o", "NCH=64 BLK=4096 w=16 st=2: 106.3 us\r\nstats NCH=64 BLK=4096 w=16 st=3: 105.8 us\r\nstats NCH=64 BLK=4096 w=16 st=5: 106.3 us\r\nstats NCH=64 BLK=8192 w=8 st=2: 100.0 us\r\nstats NCH=64 BLK=8192 w=8 st=3: 100.0 us\r\nstats NCH=64 BLK=8192 w=8 st=5: 100.0 us\r\nstats NCH=64 BLK=8192 w=16 st=2: 100.2 us\r\nstats NCH=64 BLK=8192 w=16 st=3: 100.2 us\r\nstats NCH=64 BLK=8192 w=16 st=5: 100.2 us\r\nstats NCH=64 BLK=16384 w=8 st=2: 101.4 us\r\nstats NCH=64 BLK=16384 w=8 st=3: 101.9 us\r\nstats NCH=64 BLK=16384 w=8 st=5: 101.4 us\r\nstats NCH=64 BLK=16384 w=16 st=2: 101.8 us\r\nstats NCH=64 BLK=16384 w=16 st=3: 101.3 us\r\nstats NCH=64 BLK=16384 w=16 st=5: 101.8 us\r\n"]
