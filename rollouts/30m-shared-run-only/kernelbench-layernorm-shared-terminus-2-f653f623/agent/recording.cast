[1292.315768, "o", "\u001b[?2004h> "]
[1292.315808, "o", "x2 = x.view(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.315913, "o", "npr = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> C = 16\r\n\u001b[?2004l\r"]
[1292.315961, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.315996, "o", "> "]
[1292.316049, "o", "for NCH in [32, 64, 132, 264]:\r\n\u001b[?2004l\r"]
[1292.316085, "o", "\u001b[?2004h> "]
[1292.316165, "o", "    for BLK in [4096, 8192, 16384]:\r\n\u001b[?2004l\r"]
[1292.316197, "o", "\u001b[?2004h> "]
[1292.316257, "o", "        for wp in [8, 16]:\r\n\u001b[?2004l\r"]
[1292.316289, "o", "\u001b[?2004h> "]
[1292.316367, "o", "            for st in [2, 3, 5]:\r\n\u001b[?2004l\r"]
[1292.316409, "o", "\u001b[?2004h> "]
[1292.316719, "o", "                pm = torch.empty(C*NCH, device='cuda'); p2 = torch.empty(C*NCH, device='cuda'); cn = torch.empty(C*NCH, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1292.316856, "o", "                chunk = (npr + NCH - 1)//NCH\r\n\u001b[?2004l\r\u001b[?2004h"]
[1292.316895, "o", "> "]
