[871.288706, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_stats_kernel, _ln_reduce_kernel, _ln_apply_kernel, ModelNew\nfrom triton.testing import do_bench\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\ntotal = x.numel()\nnpr = 64*256*256\nC = 16\nN = npr\nw = torch.randn(N, device='cuda'); b = torch.randn(N, device='cuda')\ny = torch.empty_like(x); y2 = y.view(-1)\nmean = torch.empty(C, device='cuda'); rstd = torch.empty(C, device='cuda')\n\nprint('copy floor us', do_bench(lambda: y.copy_(x))*1000)\nfor BLK in [2048, 4096, 8192, 16384]:\n    for wp in [8, 16, 32]:\n        t = do_bench(lambda: _ln_apply_kernel[(total // BLK,)](x2, mean, rstd, w, b, y2, N, npr // BLK, 1e-5, BLOCK=BLK, num_warps=wp, num_stages=2))\n        print(f'apply BLK={BLK} w={wp}: {t*1000:.1f} us')\nEOF\ngpu run -- python3 /workspace/bench2.py 2>&1 | tail -16\n"]
