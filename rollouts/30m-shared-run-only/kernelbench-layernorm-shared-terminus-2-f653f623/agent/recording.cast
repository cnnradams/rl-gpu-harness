[889.493178, "o", "request ID: 800b228500f9470590be6d6b6de89b80\r\nbox: sb-3b0LcyqZlqqdD938pkyPCM\r\ncommand: 82776ab5f1ae4833b28039fcfc6e01ed\r\ncopy floor us 183.2624744801294\r\napply BLK=2048 w=8: 354.3 us\r\napply BLK=2048 w=16: 353.3 us\r\napply BLK=2048 w=32: 353.0 us\r\napply BLK=4096 w=8: 354.7 us\r\napply BLK=4096 w=16: 353.8 us\r\napply BLK=4096 w=32: 353.2 us\r\napply BLK=8192 w=8: 355.0 us\r\napply BLK=8192 w=16: 354.5 us\r\napply BLK=8192 w=32: 353.8 us\r\napply BLK=16384 w=8: 355.5 us\r\napply BLK=16384 w=16: 354.9 us\r\napply BLK=16384 w=32: 354.7 us\r\n"]
