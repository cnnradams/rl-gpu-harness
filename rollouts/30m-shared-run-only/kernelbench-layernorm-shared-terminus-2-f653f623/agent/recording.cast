[1482.15709, "i", "cat > /workspace/sol3.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\nfrom triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\n\n\n@triton.jit\ndef _stats3(x_ptr, s1_ptr, s2_ptr, numel_per_row,\n            NCHUNKS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NCHUNKS\n    chunk = pid % NCHUNKS\n    chunk_size = (numel_per_row + NCHUNKS - 1) // NCHUNKS\n    start = row * numel_per_row + chunk * chunk_size\n    end = tl.minimum(start + chunk_size, (row + 1) * numel_per_row)\n    a1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    a2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for off in range(start, end, BLOCK):\n        v = tl.load(x_ptr + off + tl.arange(0, BLOCK))\n        a1 += v\n        a2 += v * v\n    gdc_launch_dependents()\n    tl.store(s1_ptr + pid, tl.sum(a1, axis=0))\n    tl.store(s2_ptr + pid, tl.sum(a2, axis=0))\n\n\n@triton.jit\ndef _apply3(x_ptr, s1_ptr, s2_ptr, w_ptr, b_ptr, y_ptr, eps,\n            C: tl.constexpr, BLOCK: tl.con"]
[1482.157135, "i", "stexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    wv = tl.load(w_ptr + offs)\n    bv = tl.load(b_ptr + offs)\n    rows = tl.arange(0, C)\n    ch = tl.arange(0, NCHUNKS)\n    idx = rows[:, None] * NCHUNKS + ch[None, :]\n    gdc_wait()\n    ps1 = tl.load(s1_ptr + idx)\n    ps2 = tl.load(s2_ptr + idx)\n    s1 = tl.sum(tl.sum(ps1, axis=1), axis=0)\n    s2 = tl.sum(tl.sum(ps2, axis=1), axis=0)\n    mean = s1 / N\n    var = tl.maximum(s2 / N - mean * mean, 0.0)\n    rstd = 1.0 / tl.sqrt(var + eps)\n    a = rstd * wv\n    c = bv - mean * a\n    for r in range(C):\n        v = tl.load(x_ptr + r * N + offs)\n        tl.store(y_ptr + r * N + offs, v * a + c)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\n        self._part = None\n\n    def forward(self, x: torch.Tensor) -> torch.Te"]
[1482.157149, "i", "nsor:\n        if not x.is_contiguous():\n            x = x.contiguous()\n        numel_per_row = 1\n        for s in self.ln.normalized_shape:\n            numel_per_row *= s\n        total = x.numel()\n        C = total // numel_per_row\n        w = self.ln.weight\n        b = self.ln.bias\n        eps = self.ln.eps\n        x2 = x.view(-1)\n        y = torch.empty_like(x)\n        y2 = y.view(-1)\n        NCHUNKS = 512\n        part = self._part\n        if part is None or part.shape[0] < C * NCHUNKS * 2:\n            part = torch.empty(C * NCHUNKS * 2, device=x.device, dtype=torch.float32)\n            self._part = part\n        s1 = part[:C * NCHUNKS]\n        s2 = part[C * NCHUNKS:2 * C * NCHUNKS]\n        BLOCK1 = 8192\n        _stats3[(C * NCHUNKS,)](\n            x2, s1, s2, numel_per_row,\n            NCHUNKS=NCHUNKS, BLOCK=BLOCK1, num_warps=8, num_stages=2,\n            launch_pdl=True,\n        )\n        BLOCK2 = 8192\n        _apply3[(numel_per_row // BLOCK2,)](\n            x2, s1, s2, w, b, y2, eps,\n            C=C, BLOCK"]
[1482.157159, "i", "=BLOCK2, N=numel_per_row, NCHUNKS=NCHUNKS,\n            num_warps=16, num_stages=2, launch_pdl=True,\n        )\n        return y\nEOF\ncat > /workspace/bench6.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom triton.testing import do_bench\nimport solution, sol3\n\nx = torch.rand(16,64,256,256, device='cuda')\nref = torch.nn.LayerNorm((64,256,256)).cuda()\nfor mod, name in [(solution, 'v2'), (sol3, 'v3')]:\n    m = mod.ModelNew((64,256,256)).cuda()\n    m.ln.weight.data.copy_(ref.weight); m.ln.bias.data.copy_(ref.bias)\n    with torch.no_grad():\n        out = m(x)\n        r = ref(x)\n        print(name, 'diff', (out-r).abs().max().item())\n        t = do_bench(lambda: m(x))\n        print(name, 'fwd us', t*1000)\nEOF\ngpu run -- python3 /workspace/bench6.py 2>&1 | tail -8\n"]
[1482.157353, "o", "cat > /workspace/sol3.py << 'EOF'\r\n\u001b[?2004l\r"]
[1482.157454, "o", "\u001b[?2004h> "]
[1482.157491, "o", "import torch\r\n\u001b[?2004l\r"]
[1482.157525, "o", "\u001b[?2004h> "]
[1482.15757, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[1482.157605, "o", "\u001b[?2004h> "]
[1482.157657, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.157696, "o", "> "]
[1482.157735, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1482.157925, "o", "from triton.language.extra.cuda import gdc_wait, gdc_launch_dependents\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.157966, "o", "> \r\n\u001b[?2004l\r"]
[1482.157986, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1482.158024, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1482.158059, "o", "\u001b[?2004h> "]
[1482.158171, "o", "def _stats3(x_ptr, s1_ptr, s2_ptr, numel_per_row,\r\n\u001b[?2004l\r"]
[1482.158211, "o", "\u001b[?2004h> "]
[1482.158322, "o", "            NCHUNKS: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1482.158337, "o", "\u001b[?2004h"]
[1482.158377, "o", "> "]
[1482.158417, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.158457, "o", "> "]
[1482.158497, "o", "    row = pid // NCHUNKS\r\n\u001b[?2004l\r"]
[1482.158525, "o", "\u001b[?2004h> "]
[1482.158579, "o", "    chunk = pid % NCHUNKS\r\n\u001b[?2004l\r"]
[1482.158612, "o", "\u001b[?2004h> "]
[1482.158751, "o", "    chunk_size = (numel_per_row + NCHUNKS - 1) // NCHUNKS\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.158786, "o", "> "]
[1482.158895, "o", "    start = row * numel_per_row + chunk * chunk_size\r\n\u001b[?2004l\r"]
[1482.15893, "o", "\u001b[?2004h> "]
[1482.159079, "o", "    end = tl.minimum(start + chunk_size, (row + 1) * numel_per_row)\r\n\u001b[?2004l\r"]
[1482.159111, "o", "\u001b[?2004h> "]
[1482.159209, "o", "    a1 = tl.zeros((BLOCK,), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1482.159258, "o", "\u001b[?2004h> "]
[1482.159352, "o", "    a2 = tl.zeros((BLOCK,), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1482.159391, "o", "\u001b[?2004h> "]
[1482.159473, "o", "    for off in range(start, end, BLOCK):\r\n\u001b[?2004l\r"]
[1482.159512, "o", "\u001b[?2004h> "]
[1482.159626, "o", "        v = tl.load(x_ptr + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1482.159662, "o", "\u001b[?2004h> "]
[1482.159694, "o", "        a1 += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.159743, "o", "> "]
[1482.159776, "o", "        a2 += v * v\r\n\u001b[?2004l\r"]
[1482.159816, "o", "\u001b[?2004h> "]
[1482.159877, "o", "    gdc_launch_dependents()\r\n\u001b[?2004l\r"]
[1482.159916, "o", "\u001b[?2004h> "]
[1482.16001, "o", "    tl.store(s1_ptr + pid, tl.sum(a1, axis=0))\r\n\u001b[?2004l\r"]
[1482.160043, "o", "\u001b[?2004h> "]
[1482.160145, "o", "    tl.store(s2_ptr + pid, tl.sum(a2, axis=0))\r\n\u001b[?2004l\r"]
[1482.160177, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.160214, "o", "> \r\n\u001b[?2004l\r"]
[1482.160253, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1482.160292, "o", "\u001b[?2004h> "]
[1482.160419, "o", "def _apply3(x_ptr, s1_ptr, s2_ptr, w_ptr, b_ptr, y_ptr, eps,\r\n\u001b[?2004l\r"]
[1482.160454, "o", "\u001b[?2004h> "]
[1482.160649, "o", "            C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1482.160691, "o", "\u001b[?2004h> "]
[1482.160739, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1482.160779, "o", "\u001b[?2004h> "]
[1482.160876, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1482.160914, "o", "\u001b[?2004h> "]
[1482.160973, "o", "    wv = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[1482.161009, "o", "\u001b[?2004h> "]
[1482.161068, "o", "    bv = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[1482.1611, "o", "\u001b[?2004h> "]
[1482.161158, "o", "    rows = tl.arange(0, C)\r\n\u001b[?2004l\r"]
[1482.161188, "o", "\u001b[?2004h> "]
[1482.161255, "o", "    ch = tl.arange(0, NCHUNKS)\r\n\u001b[?2004l\r"]
[1482.161284, "o", "\u001b[?2004h> "]
[1482.161388, "o", "    idx = rows[:, None] * NCHUNKS + ch[None, :]\r\n\u001b[?2004l\r"]
[1482.161427, "o", "\u001b[?2004h> "]
[1482.161455, "o", "    gdc_wait()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.161487, "o", "> "]
[1482.161549, "o", "    ps1 = tl.load(s1_ptr + idx)\r\n\u001b[?2004l\r"]
[1482.161585, "o", "\u001b[?2004h> "]
[1482.161646, "o", "    ps2 = tl.load(s2_ptr + idx)\r\n\u001b[?2004l\r"]
[1482.161685, "o", "\u001b[?2004h> "]
[1482.161774, "o", "    s1 = tl.sum(tl.sum(ps1, axis=1), axis=0)\r\n\u001b[?2004l\r"]
[1482.161805, "o", "\u001b[?2004h> "]
[1482.161911, "o", "    s2 = tl.sum(tl.sum(ps2, axis=1), axis=0)\r\n\u001b[?2004l\r"]
[1482.161948, "o", "\u001b[?2004h> "]
[1482.16198, "o", "    mean = s1 / N\r\n\u001b[?2004l\r"]
[1482.162012, "o", "\u001b[?2004h> "]
[1482.162111, "o", "    var = tl.maximum(s2 / N - mean * mean, 0.0)\r\n\u001b[?2004l\r"]
[1482.162151, "o", "\u001b[?2004h> "]
[1482.162219, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1482.162253, "o", "\u001b[?2004h> "]
[1482.162285, "o", "    a = rstd * wv\r\n\u001b[?2004l\r"]
[1482.162316, "o", "\u001b[?2004h> "]
[1482.16237, "o", "    c = bv - mean * a\r\n\u001b[?2004l\r"]
[1482.162407, "o", "\u001b[?2004h> "]
[1482.162449, "o", "    for r in range(C):\r\n\u001b[?2004l\r"]
[1482.162489, "o", "\u001b[?2004h> "]
[1482.162572, "o", "        v = tl.load(x_ptr + r * N + offs)\r\n\u001b[?2004l\r"]
[1482.162604, "o", "\u001b[?2004h> "]
[1482.162711, "o", "        tl.store(y_ptr + r * N + offs, v * a + c)\r\n\u001b[?2004l\r"]
[1482.162749, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1482.162781, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1482.162846, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1482.162889, "o", "\u001b[?2004h> "]
[1482.162988, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[1482.16302, "o", "\u001b[?2004h> "]
[1482.163077, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1482.163113, "o", "\u001b[?2004h> "]
[1482.16323, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[1482.16326, "o", "\u001b[?2004h> "]
[1482.163417, "o", "        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\r\n\u001b[?2004l\r"]
[1482.163447, "o", "\u001b[?2004h> "]
[1482.163502, "o", "        self._part = None\r\n\u001b[?2004l\r"]
[1482.163539, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1482.163679, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[1482.16373, "o", "\u001b[?2004h> "]
[1482.163795, "o", "        if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[1482.163831, "o", "\u001b[?2004h> "]
[1482.163898, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r"]
[1482.163929, "o", "\u001b[?2004h> "]
[1482.163983, "o", "        numel_per_row = 1\r\n\u001b[?2004l\r"]
[1482.16402, "o", "\u001b[?2004h> "]
[1482.164107, "o", "        for s in self.ln.normalized_shape:\r\n\u001b[?2004l\r"]
[1482.164143, "o", "\u001b[?2004h> "]
[1482.164203, "o", "            numel_per_row *= s\r\n\u001b[?2004l\r"]
[1482.164232, "o", "\u001b[?2004h> "]
[1482.164289, "o", "        total = x.numel()\r\n\u001b[?2004l\r"]
[1482.164319, "o", "\u001b[?2004h> "]
[1482.164394, "o", "        C = total // numel_per_row\r\n\u001b[?2004l\r"]
[1482.164431, "o", "\u001b[?2004h> "]
[1482.164481, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r"]
[1482.164521, "o", "\u001b[?2004h> "]
[1482.164565, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r"]
[1482.164598, "o", "\u001b[?2004h> "]
[1482.164654, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r"]
[1482.164685, "o", "\u001b[?2004h> "]
[1482.164735, "o", "        x2 = x.view(-1)\r\n\u001b[?2004l\r"]
[1482.164765, "o", "\u001b[?2004h> "]
[1482.164835, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1482.164876, "o", "\u001b[?2004h> "]
[1482.164927, "o", "        y2 = y.view(-1)\r\n\u001b[?2004l\r"]
[1482.164959, "o", "\u001b[?2004h> "]
[1482.165003, "o", "        NCHUNKS = 512\r\n\u001b[?2004l\r"]
[1482.165035, "o", "\u001b[?2004h> "]
[1482.165089, "o", "        part = self._part\r\n\u001b[?2004l\r"]
[1482.165125, "o", "\u001b[?2004h> "]
[1482.165252, "o", "        if part is None or part.shape[0] < C * NCHUNKS * 2:\r\n\u001b[?2004l\r"]
[1482.165284, "o", "\u001b[?2004h> "]
[1482.165473, "o", "            part = torch.empty(C * NCHUNKS * 2, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1482.165515, "o", "\u001b[?2004h> "]
[1482.165567, "o", "            self._part = part\r\n\u001b[?2004l\r"]
[1482.1656, "o", "\u001b[?2004h> "]
[1482.165669, "o", "        s1 = part[:C * NCHUNKS]\r\n\u001b[?2004l\r"]
[1482.165708, "o", "\u001b[?2004h> "]
[1482.165802, "o", "        s2 = part[C * NCHUNKS:2 * C * NCHUNKS]\r\n\u001b[?2004l\r"]
[1482.165832, "o", "\u001b[?2004h> "]
[1482.165886, "o", "        BLOCK1 = 8192\r\n\u001b[?2004l\r"]
[1482.165922, "o", "\u001b[?2004h> "]
[1482.165987, "o", "        _stats3[(C * NCHUNKS,)](\r\n\u001b[?2004l\r"]
[1482.166023, "o", "\u001b[?2004h> "]
[1482.166101, "o", "            x2, s1, s2, numel_per_row,\r\n\u001b[?2004l\r"]
[1482.166147, "o", "\u001b[?2004h> "]
[1482.166286, "o", "            NCHUNKS=NCHUNKS, BLOCK=BLOCK1, num_warps=8, num_stages=2,\r\n\u001b[?2004l\r"]
[1482.166323, "o", "\u001b[?2004h> "]
[1482.166378, "o", "            launch_pdl=True,\r\n\u001b[?2004l\r"]
[1482.166408, "o", "\u001b[?2004h> "]
[1482.166433, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h"]
[1482.166465, "o", "> "]
[1482.166497, "o", "        BLOCK2 = 8192\r\n\u001b[?2004l\r"]
[1482.166529, "o", "\u001b[?2004h> "]
[1482.166631, "o", "        _apply3[(numel_per_row // BLOCK2,)](\r\n\u001b[?2004l\r"]
[1482.166675, "o", "\u001b[?2004h> "]
[1482.166746, "o", "            x2, s1, s2, w, b, y2, eps,\r\n\u001b[?2004l\r"]
[1482.166782, "o", "\u001b[?2004h> "]
[1482.166927, "o", "            C=C, BLOCK=BLOCK2, N=numel_per_row, NCHUNKS=NCHUNKS,\r\n\u001b[?2004l\r"]
[1482.166957, "o", "\u001b[?2004h> "]
[1482.167082, "o", "            num_warps=16, num_stages=2, launch_pdl=True,\r\n\u001b[?2004l\r"]
[1482.167112, "o", "\u001b[?2004h> "]
[1482.16715, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1482.167189, "o", "        return y\r\n\u001b[?2004l\r"]
[1482.167215, "o", "\u001b[?2004h> "]
[1482.167246, "o", "EOF\r\n\u001b[?2004l\r"]
