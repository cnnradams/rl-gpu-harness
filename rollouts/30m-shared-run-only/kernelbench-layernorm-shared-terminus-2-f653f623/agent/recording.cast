[661.775253, "o", "\u001b[?2004h> "]
[661.775355, "o", "    m = tl.zeros((), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[661.775385, "o", "\u001b[?2004h> "]
[661.775476, "o", "    m2 = tl.zeros((), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[661.77552, "o", "\u001b[?2004h> "]
[661.775597, "o", "    n = tl.zeros((), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[661.77563, "o", "\u001b[?2004h> "]
[661.775744, "o", "    for off in range(start, end, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[661.775781, "o", "> "]
[661.775861, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[661.7759, "o", "\u001b[?2004h> "]
[661.776, "o", "        v = tl.load(x_ptr + row_start + idx)\r\n\u001b[?2004l\r"]
[661.776044, "o", "\u001b[?2004h> "]
[661.77609, "o", "        n_new = n + BLOCK\r\n\u001b[?2004l\r"]
[661.776129, "o", "\u001b[?2004h> "]
[661.776168, "o", "        delta = v - m\r\n\u001b[?2004l\r"]
[661.776206, "o", "\u001b[?2004h> "]
[661.776297, "o", "        m += tl.sum(delta, axis=0) / n_new\r\n\u001b[?2004l\r"]
[661.776336, "o", "\u001b[?2004h> "]
[661.776433, "o", "        m2 += tl.sum(delta * (v - m), axis=0)\r\n\u001b[?2004l\r"]
[661.776472, "o", "\u001b[?2004h> "]
[661.77651, "o", "        n = n_new\r\n\u001b[?2004l\r"]
[661.776547, "o", "\u001b[?2004h> "]
[661.776625, "o", "    tl.store(part_mean_ptr + pid, m)\r\n\u001b[?2004l\r"]
[661.776663, "o", "\u001b[?2004h> "]
[661.776738, "o", "    tl.store(part_m2_ptr + pid, m2)\r\n\u001b[?2004l\r"]
[661.776776, "o", "\u001b[?2004h> "]
[661.776844, "o", "    tl.store(count_ptr + pid, n)\r\n\u001b[?2004l\r"]
[661.776882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.776924, "o", "> \r\n\u001b[?2004l\r"]
[661.776963, "o", "\u001b[?2004h> @triton.jit\r\n"]
[661.777001, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[661.777052, "o", "def _ln_reduce_kernel(\r\n\u001b[?2004l\r"]
[661.777091, "o", "\u001b[?2004h> "]
[661.777227, "o", "    part_mean_ptr, part_m2_ptr, count_ptr, mean_ptr, rstd_ptr,\r\n\u001b[?2004l\r"]
[661.777267, "o", "\u001b[?2004h> "]
[661.777365, "o", "    numel_per_row, eps, NCHUNKS: tl.constexpr,\r\n\u001b[?2004l\r"]
[661.777403, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[661.777442, "o", "\u001b[?2004h> "]
[661.777496, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[661.777534, "o", "\u001b[?2004h> "]
[661.777601, "o", "    offs = tl.arange(0, NCHUNKS)\r\n\u001b[?2004l\r"]
[661.777639, "o", "\u001b[?2004h> "]
[661.777689, "o", "    base = row * NCHUNKS\r\n\u001b[?2004l\r"]
[661.777728, "o", "\u001b[?2004h> "]
[661.777821, "o", "    m = tl.load(part_mean_ptr + base + offs)\r\n\u001b[?2004l\r"]
[661.777859, "o", "\u001b[?2004h> "]
[661.777959, "o", "    m2 = tl.load(part_m2_ptr + base + offs)\r\n\u001b[?2004l\r"]
[661.777997, "o", "\u001b[?2004h> "]
[661.77808, "o", "    n = tl.load(count_ptr + base + offs)\r\n\u001b[?2004l\r"]
[661.778115, "o", "\u001b[?2004h> "]
[661.778181, "o", "    total = tl.sum(n, axis=0)\r\n\u001b[?2004l\r"]
[661.77822, "o", "\u001b[?2004h> "]
[661.778308, "o", "    mean = tl.sum(m * n, axis=0) / total\r\n\u001b[?2004l\r"]
[661.778346, "o", "\u001b[?2004h> "]
[661.778384, "o", "    delta = m - mean\r\n\u001b[?2004l\r"]
[661.778421, "o", "\u001b[?2004h> "]
[661.778522, "o", "    M2 = tl.sum(m2 + n * delta * delta, axis=0)\r\n\u001b[?2004l\r"]
[661.778559, "o", "\u001b[?2004h> "]
[661.778652, "o", "    rstd = 1.0 / tl.sqrt(M2 / total + eps)\r\n\u001b[?2004l\r"]
[661.77869, "o", "\u001b[?2004h> "]
[661.778762, "o", "    tl.store(mean_ptr + row, mean)\r\n\u001b[?2004l\r"]
[661.778799, "o", "\u001b[?2004h> "]
[661.778872, "o", "    tl.store(rstd_ptr + row, rstd)\r\n\u001b[?2004l\r"]
[661.77891, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.778955, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.778992, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[661.779017, "o", "\u001b[?2004h> "]
[661.779076, "o", "def _ln_apply_kernel(\r\n\u001b[?2004l\r"]
[661.779114, "o", "\u001b[?2004h> "]
[661.779225, "o", "    x_ptr, mean_ptr, rstd_ptr, w_ptr, b_ptr, y_ptr,\r\n\u001b[?2004l\r"]
[661.779262, "o", "\u001b[?2004h> "]
[661.779339, "o", "    N, BPR, eps, BLOCK: tl.constexpr,\r\n\u001b[?2004l\r"]
[661.779377, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[661.779414, "o", "\u001b[?2004h> "]
[661.779471, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[661.779509, "o", "\u001b[?2004h> "]
[661.779547, "o", "    row = pid // BPR\r\n\u001b[?2004l\r"]
[661.779582, "o", "\u001b[?2004h> "]
[661.779679, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[661.779728, "o", "\u001b[?2004h> "]
[661.77979, "o", "    v = tl.load(x_ptr + offs)\r\n\u001b[?2004l\r"]
[661.779825, "o", "\u001b[?2004h> "]
[661.779899, "o", "    w = tl.load(w_ptr + offs % N)\r\n\u001b[?2004l\r"]
[661.779938, "o", "\u001b[?2004h> "]
[661.780016, "o", "    b = tl.load(b_ptr + offs % N)\r\n\u001b[?2004l\r"]
[661.780052, "o", "\u001b[?2004h> "]
[661.780123, "o", "    mean = tl.load(mean_ptr + row)\r\n\u001b[?2004l\r"]
[661.780162, "o", "\u001b[?2004h> "]
[661.780233, "o", "    rstd = tl.load(rstd_ptr + row)\r\n\u001b[?2004l\r"]
[661.78027, "o", "\u001b[?2004h> "]
[661.780384, "o", "    tl.store(y_ptr + offs, (v - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[661.780409, "o", "\u001b[?2004h> \r\n"]
[661.780446, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[661.780485, "o", "\u001b[?2004h> "]
[661.78054, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[661.780579, "o", "\u001b[?2004h> "]
[661.780682, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[661.780717, "o", "\u001b[?2004h> "]
[661.780775, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[661.780809, "o", "\u001b[?2004h> "]
[661.780931, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[661.780973, "o", "\u001b[?2004h> "]
[661.781135, "o", "        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\r\n\u001b[?2004l\r"]
[661.781172, "o", "\u001b[?2004h> "]
[661.78122, "o", "        self._part = None\r\n\u001b[?2004l\r"]
[661.781259, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[661.781295, "o", "> "]
[661.781407, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[661.781447, "o", "\u001b[?2004h> "]
[661.781514, "o", "        if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[661.781552, "o", "\u001b[?2004h> "]
[661.781618, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r"]
[661.781657, "o", "\u001b[?2004h> "]
[661.781706, "o", "        numel_per_row = 1\r\n\u001b[?2004l\r"]
[661.781745, "o", "\u001b[?2004h> "]
[661.781835, "o", "        for s in self.ln.normalized_shape:\r\n\u001b[?2004l\r"]
[661.781873, "o", "\u001b[?2004h> "]
[661.781936, "o", "            numel_per_row *= s\r\n\u001b[?2004l\r"]
[661.781978, "o", "\u001b[?2004h> "]
[661.782031, "o", "        total = x.numel()\r\n\u001b[?2004l\r"]
[661.78207, "o", "\u001b[?2004h> "]
[661.782142, "o", "        C = total // numel_per_row\r\n\u001b[?2004l\r"]
[661.782182, "o", "\u001b[?2004h> "]
[661.78223, "o", "        N = numel_per_row\r\n\u001b[?2004l\r"]
[661.782268, "o", "\u001b[?2004h> "]
[661.782324, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r"]
[661.782363, "o", "\u001b[?2004h> "]
[661.782411, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r"]
[661.78245, "o", "\u001b[?2004h> "]
[661.782501, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r"]
[661.78254, "o", "\u001b[?2004h> "]
[661.78259, "o", "        x2 = x.view(-1)\r\n\u001b[?2004l\r"]
[661.782626, "o", "\u001b[?2004h> "]
[661.782692, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[661.782729, "o", "\u001b[?2004h> "]
[661.782776, "o", "        y2 = y.view(-1)\r\n\u001b[?2004l\r"]
[661.782815, "o", "\u001b[?2004h> "]
[661.782853, "o", "        NCHUNKS = 8\r\n\u001b[?2004l\r"]
[661.782891, "o", "\u001b[?2004h> "]
[661.782944, "o", "        part = self._part\r\n\u001b[?2004l\r"]
[661.782989, "o", "\u001b[?2004h> "]
[661.783118, "o", "        if part is None or part.shape[0] < C * NCHUNKS * 3:\r\n\u001b[?2004l\r"]
[661.783151, "o", "\u001b[?2004h> "]
[661.783341, "o", "            part = torch.empty(C * NCHUNKS * 3, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[661.783358, "o", "\u001b[?2004h"]
[661.783397, "o", "> "]
[661.783435, "o", "            self._part = part\r\n\u001b[?2004l\r"]
[661.783478, "o", "\u001b[?2004h> "]
[661.783559, "o", "        part_mean = part[:C * NCHUNKS]\r\n\u001b[?2004l\r"]
[661.783598, "o", "\u001b[?2004h> "]
[661.783723, "o", "        part_m2 = part[C * NCHUNKS:2 * C * NCHUNKS]\r\n\u001b[?2004l\r"]
[661.783737, "o", "\u001b[?2004h"]
[661.783778, "o", "> "]
[661.783875, "o", "        count = part[2 * C * NCHUNKS:3 * C * NCHUNKS]\r\n\u001b[?2004l\r"]
[661.783914, "o", "\u001b[?2004h> "]
[661.784072, "o", "        mr = torch.empty(2 * C, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[661.784108, "o", "\u001b[?2004h> "]
[661.784156, "o", "        mean = mr[:C]\r\n\u001b[?2004l\r"]
[661.784191, "o", "\u001b[?2004h> "]
[661.78423, "o", "        rstd = mr[C:]\r\n\u001b[?2004l\r"]
[661.784269, "o", "\u001b[?2004h> "]
[661.784306, "o", "        BLOCK1 = 4096\r\n\u001b[?2004l\r"]
[661.784333, "o", "\u001b[?2004h> "]
[661.784438, "o", "        _ln_stats_kernel[(C * NCHUNKS,)](\r\n\u001b[?2004l\r"]
[661.784474, "o", "\u001b[?2004h> "]
[661.784598, "o", "            x2, part_mean, part_m2, count, numel_per_row,\r\n\u001b[?2004l\r"]
[661.784636, "o", "\u001b[?2004h> "]
[661.784794, "o", "            NCHUNKS=NCHUNKS, BLOCK=BLOCK1, num_warps=16, num_stages=5,\r\n\u001b[?2004l\r"]
[661.784832, "o", "\u001b[?2004h> "]
[661.784871, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.784958, "o", "        _ln_reduce_kernel[(C,)](\r\n\u001b[?2004l\r"]
[661.784997, "o", "\u001b[?2004h> "]
[661.78515, "o", "            part_mean, part_m2, count, mean, rstd, numel_per_row, eps,\r\n\u001b[?2004l\r"]
[661.78519, "o", "\u001b[?2004h> "]
[661.785276, "o", "            NCHUNKS=NCHUNKS, num_warps=1,\r\n\u001b[?2004l\r"]
[661.785327, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[661.785371, "o", "\u001b[?2004h> "]
[661.785411, "o", "        BLOCK2 = 8192\r\n\u001b[?2004l\r"]
[661.785448, "o", "\u001b[?2004h> "]
[661.785544, "o", "        _ln_apply_kernel[(total // BLOCK2,)](\r\n\u001b[?2004l\r"]
[661.785584, "o", "\u001b[?2004h> "]
[661.785769, "o", "            x2, mean, rstd, w, b, y2, N, numel_per_row // BLOCK2, eps, BLOCK=BLOCK2,\r\n\u001b[?2004l\r"]
[661.785809, "o", "\u001b[?2004h> "]
[661.785892, "o", "            num_warps=16, num_stages=2,\r\n\u001b[?2004l\r"]
[661.785931, "o", "\u001b[?2004h> "]
[661.785975, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[661.786021, "o", "        return y\r\n\u001b[?2004l\r"]
[661.786058, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[661.787506, "o", "\u001b[?2004hroot@modal:/workspace# "]
[661.787657, "o", "gpu run -- bash -c 'python3 /workspace/test.py' 2>&1 | tail -6\r\n\u001b[?2004l\r"]
