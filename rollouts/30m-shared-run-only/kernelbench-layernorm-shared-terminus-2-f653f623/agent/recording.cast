[386.512877, "o", "    rstd = 1.0 / tl.sqrt(M2 / total + eps)\r\n    tl.store(mean_ptr + row, mean)\r\n    tl.store(rstd_ptr + row, rstd)\r\n\r\n\r\n@triton.jit\r\ndef _ln_apply_kernel(\r\n    x_ptr, mean_ptr, rstd_ptr, w_ptr, b_ptr, y_ptr,\r\n    N, BPR, eps, BLOCK: tl.constexpr,\r\n):\r\n    pid = tl.program_id(0)\r\n    row = pid // BPR\r\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n"]
[386.512927, "o", "    v = tl.load(x_ptr + offs)\r\n    w = tl.load(w_ptr + offs % N)\r\n    b = tl.load(b_ptr + offs % N)\r\n    mean = tl.load(mean_ptr + row)\r\n    rstd = tl.load(rstd_ptr + row)\r\n    tl.store(y_ptr + offs, (v - mean) * rstd * w + b)\r\n\r\n\r\nclass ModelNew(nn.Module):\r\n    def __init__(self, normalized_shape: tuple):\r\n        super().__init__()\r\n        self.normalized_shape = tuple(normalized_shape)\r\n"]
[386.512968, "o", "        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\r\n        self._part = None\r\n\r\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n        if not x.is_contiguous():\r\n            x = x.contiguous()\r\n        N = self.ln.normalized_shape[0]\r\n        row2d = x.shape[-2] // N\r\n        numel_per_row = row2d * N\r\n        C = x.numel() // numel_per_row\r\n        total = x.numel()\r\n        w = self.ln.weight\r\n        b = self.ln.bias\r\n        eps = self.ln.eps\r\n        x2 = x.view(-1)\r\n        y = torch.empty_like(x)\r\n        y2 = y.view(-1)\r\n        NCHUNKS = 8\r\n        part = self._part\r\n        if part is None or part.shape[0] < C * NCHUNKS * 3:\r\n            part = torch.empty(C * NCHUNKS * 3, device=x.device, dtype=torch.float32)\r\n            self._part = part\r\n        part_mean = part[:C * NCHUNKS]\r\n        part_m2 = part[C * NCHUNKS:2 * C * NCHUNKS]\r\n"]
[386.513017, "o", "        count = part[2 * C * NCHUNKS:3 * C * NCHUNKS]\r\n        mr = torch.empty(2 * C, device=x.device, dtype=torch.float32)\r\n        mean = mr[:C]\r\n        rstd = mr[C:]\r\n        BLOCK1 = 4096\r\n        _ln_stats_kernel[(C * NCHUNKS,)](\r\n            x2, part_mean, part_m2, count, numel_per_row,\r\n            NCHUNKS=NCHUNKS, BLOCK=BLOCK1, num_warps=16, num_stages=5,\r\n        )\r\n        _ln_reduce_kernel[(C,)](\r\n            part_mean, part_m2, count, mean, rstd, numel_per_row, eps,\r\n            NCHUNKS=NCHUNKS, num_warps=1,\r\n"]
[386.513234, "o", "\u001b[?2004hroot@modal:/workspace# "]
[387.011528, "i", "cat > /workspace/test.py << 'EOF'\nimport os, torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\nimport torch.nn as nn\ntorch.manual_seed(0)\nref = nn.LayerNorm((64,256,256)).cuda()\nnew = ModelNew((64,256,256)).cuda()\nnew.ln.weight.data.copy_(ref.weight)\nnew.ln.bias.data.copy_(ref.bias)\nx = torch.rand(16,64,256,256, device='cuda')\nwith torch.no_grad():\n    a = ref(x)\n    torch.cuda.synchronize()\n    print('ref done')\n    b = new(x)\n    torch.cuda.synchronize()\n    print('new done')\n    print('max diff', (a-b).abs().max().item())\nEOF\ngpu run -- bash -c 'CUDA_LAUNCH_BLOCKING=1 python3 /workspace/test.py' 2>&1 | tail -25\n"]
