[805.952509, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_stats_kernel, _ln_reduce_kernel, _ln_apply_kernel, ModelNew\nimport triton\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\ntotal = x.numel()\nnpr = 64*256*256\nC = 16\nN = npr\nw = torch.randn(N, device='cuda'); b = torch.randn(N, device='cuda')\ny = torch.empty_like(x); y2 = y.view(-1)\n\n# floor: pure copy\nfrom triton.testing import do_bench\nprint('copy floor ms', do_bench(lambda: y.copy_(x)))\n\nNCH = 8\npart_mean = torch.empty(C*NCH, device='cuda'); part_m2 = torch.empty(C*NCH, device='cuda'); cnt = torch.empty(C*NCH, device='cuda')\nmean = torch.empty(C, device='cuda'); rstd = torch.empty(C, device='cuda')\n\nfor NCH in [4, 8, 16, 32]:\n    pm = torch.empty(C*NCH, device='cuda'); p2 = torch.empty(C*NCH, device='cuda'); cn = torch.empty(C*NCH, device='cuda')\n    for BLK in [2048, 4096, 8192]:\n        for wp in [8, 16, 32]:\n            for st in [3, 5]:\n                t = do_bench(lambda: _ln_stat"]
[805.952547, "i", "s_kernel[(C*NCH,)](x2, pm, p2, cn, npr, NCHUNKS=NCH, BLOCK=BLK, num_warps=wp, num_stages=st))\n                print(f'stats NCH={NCH} BLK={BLK} w={wp} st={st}: {t*1000:.1f} us')\nEOF\ngpu run -- python3 /workspace/bench.py 2>&1 | tail -80\n"]
[805.952909, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.952987, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.953071, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.953281, "o", "from solution import _ln_stats_kernel, _ln_reduce_kernel, _ln_apply_kernel, ModelNew\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.953297, "o", "> "]
[805.953343, "o", "import triton\r\n\u001b[?2004l\r"]
[805.953387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[805.953441, "o", "> "]
[805.953529, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.95358, "o", "x2 = x.view(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.953623, "o", "> "]
[805.953664, "o", "total = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.953704, "o", "npr = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.953742, "o", "> C = 16\r\n\u001b[?2004l\r"]
[805.953781, "o", "\u001b[?2004h> "]
[805.95382, "o", "N = npr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.953988, "o", "w = torch.randn(N, device='cuda'); b = torch.randn(N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.95402, "o", "> "]
[805.954098, "o", "y = torch.empty_like(x); y2 = y.view(-1)\r\n\u001b[?2004l\r"]
