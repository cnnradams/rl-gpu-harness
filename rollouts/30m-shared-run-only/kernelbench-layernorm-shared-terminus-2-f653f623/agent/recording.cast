[1553.999193, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom sol3 import _stats3, _apply3\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\nNCH = 512\ns1 = torch.zeros(C*NCH, device='cuda'); s2 = torch.zeros(C*NCH, device='cuda')\n_stats3[(C*NCH,)](x2, s1, s2, npr, NCHUNKS=NCH, BLOCK=8192, num_warps=8, num_stages=2, launch_pdl=False)\ntorch.cuda.synchronize()\nS1 = s1.view(C, NCH).sum(1); S2 = s2.view(C, NCH).sum(1)\nprint('s1 diff', (S1 - x.sum(dim=(1,2,3))).abs().max().item())\nprint('s2 diff', (S2 - (x*x).sum(dim=(1,2,3))).abs().max().item())\nmean = S1/npr; var = S2/npr - mean*mean\nm0 = x.mean(dim=(1,2,3)); v0 = x.var(dim=(1,2,3), unbiased=False)\nprint('mean diff', (mean-m0).abs().max().item(), 'var diff', (var-v0).abs().max().item())\n\nw = torch.randn(npr, device='cuda'); b = torch.randn(npr, device='cuda')\ny = torch.empty_like(x); y2 = y.view(-1)\n_apply3[(npr // 8192,)](x2, s1, s2, w, b, y2, 1e-5, C=C, "]
[1553.999239, "i", "BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2, launch_pdl=False)\ntorch.cuda.synchronize()\nref = torch.nn.functional.layer_norm(x, (64,256,256), w.view(64,256,256), b.view(64,256,256), 1e-5)\nprint('apply3 diff', (y-ref).abs().max().item())\nEOF\ngpu run -- python3 /workspace/bench7.py 2>&1 | tail -6\n"]
