[1690.374612, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1690.374635, "o", "\u001b[?2004h> "]
[1690.374708, "o", "    wv = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[1690.374727, "o", "\u001b[?2004h> "]
[1690.37481, "o", "    bv = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[1690.37483, "o", "\u001b[?2004h> "]
[1690.374897, "o", "    rows = tl.arange(0, C)\r\n\u001b[?2004l\r"]
[1690.374917, "o", "\u001b[?2004h> "]
[1690.374997, "o", "    ch = tl.arange(0, NCHUNKS)\r\n\u001b[?2004l\r"]
[1690.375017, "o", "\u001b[?2004h> "]
[1690.375131, "o", "    idx = rows[:, None] * NCHUNKS + ch[None, :]\r\n\u001b[?2004l\r"]
[1690.375153, "o", "\u001b[?2004h> "]
[1690.375229, "o", "    ps1 = tl.load(s1_ptr + idx)\r\n\u001b[?2004l\r"]
[1690.375261, "o", "\u001b[?2004h> "]
[1690.375329, "o", "    ps2 = tl.load(s2_ptr + idx)\r\n\u001b[?2004l\r"]
[1690.375349, "o", "\u001b[?2004h> "]
[1690.375458, "o", "    s1v = tl.sum(tl.sum(ps1, axis=1), axis=0)\r\n\u001b[?2004l\r"]
[1690.375478, "o", "\u001b[?2004h> "]
[1690.375594, "o", "    s2v = tl.sum(tl.sum(ps2, axis=1), axis=0)\r\n\u001b[?2004l\r"]
[1690.375616, "o", "\u001b[?2004h> "]
[1690.375662, "o", "    mean = s1v / N\r\n\u001b[?2004l\r"]
[1690.375681, "o", "\u001b[?2004h> "]
[1690.375849, "o", "    var = tl.maximum(s2v / N - mean * mean, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.375871, "o", "> "]
[1690.375947, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1690.375967, "o", "\u001b[?2004h> "]
[1690.376013, "o", "    a = rstd * wv\r\n\u001b[?2004l\r"]
[1690.376033, "o", "\u001b[?2004h> "]
[1690.37609, "o", "    c = bv - mean * a\r\n\u001b[?2004l\r"]
[1690.376109, "o", "\u001b[?2004h> "]
[1690.376171, "o", "    for r in range(C):\r\n\u001b[?2004l\r"]
[1690.376192, "o", "\u001b[?2004h"]
[1690.376212, "o", "> "]
[1690.376299, "o", "        v = tl.load(x_ptr + r * N + offs)\r\n\u001b[?2004l\r"]
[1690.376323, "o", "\u001b[?2004h> "]
[1690.376436, "o", "        tl.store(y_ptr + r * N + offs, v * a + c)\r\n\u001b[?2004l\r"]
[1690.376457, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1690.376477, "o", "\u001b[?2004h> "]
[1690.376655, "o", "w = torch.ones(npr, device='cuda'); b = torch.zeros(npr, device='cuda')\r\n\u001b[?2004l\r"]
[1690.376686, "o", "\u001b[?2004h> "]
[1690.376776, "o", "y = torch.empty_like(x); y2 = y.view(-1)\r\n\u001b[?2004l\r"]
[1690.376806, "o", "\u001b[?2004h> "]
[1690.377081, "o", "apply_nog[(npr // 8192,)](x2, s1, s2, w, b, y2, 1e-5, C=C, BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.377106, "o", "> "]
[1690.377159, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1690.37718, "o", "\u001b[?2004h> "]
[1690.377358, "o", "ref = torch.nn.functional.layer_norm(x, (64,256,256), None, None, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.377383, "o", "> "]
[1690.377506, "o", "print('apply_nog diff', (y-ref).abs().max().item())\r\n\u001b[?2004l\r"]
[1690.377527, "o", "\u001b[?2004h> "]
[1690.377557, "o", "EOF\r\n\u001b[?2004l\r"]
[1690.378883, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1690.379021, "o", "gpu run -- python3 /workspace/bench9.py 2>&1 | tail -4\r\n\u001b[?2004l\r"]
[1706.569704, "o", "command: f8a8a4b30f1c44298ab2c7ac38f3e461\r\ns1 partials vs torch: 0.25\r\ns2 partials vs torch: 0.125\r\napply_nog diff 2527.926025390625\r\n"]
[1706.569906, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1763.052404, "i", "cat > /workspace/bench10.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef apply_dbg(x_ptr, s1_ptr, s2_ptr, y_ptr, mean_out, rstd_out, eps,\n              C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):\n    rows = tl.arange(0, C)\n    ch = tl.arange(0, NCHUNKS)\n    idx = rows[:, None] * NCHUNKS + ch[None, :]\n    ps1 = tl.load(s1_ptr + idx)\n    ps2 = tl.load(s2_ptr + idx)\n    s1v = tl.sum(tl.sum(ps1, axis=1), axis=0)\n    s2v = tl.sum(tl.sum(ps2, axis=1), axis=0)\n    mean = s1v / N\n    var = tl.maximum(s2v / N - mean * mean, 0.0)\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(mean_out, mean)\n    tl.store(rstd_out, rstd)\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\nNCH = 512\ns1 = torch.zeros(C*NCH, device='cuda'); s2 = torch.zeros(C*NCH, device='cuda')\nfrom sol3 import _stats3\n_stats3[(C*NCH,)](x2, s1, s2, npr, NCHUNKS=NCH, BLOCK=8192, num_warps=8, num_stages=2, launch_"]
[1763.052451, "i", "pdl=False)\nmo = torch.zeros(1, device='cuda'); ro = torch.zeros(1, device='cuda')\napply_dbg[(1,)](x2, s1, s2, x2, mo, ro, 1e-5, C=C, BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2)\ntorch.cuda.synchronize()\nprint('kernel mean', mo.item(), 'ref', x.mean().item())\nprint('kernel rstd', ro.item(), 'ref', (1/(x.var(unbiased=False)+1e-5).sqrt()).item())\nEOF\ngpu run -- python3 /workspace/bench10.py 2>&1 | tail -3\n"]
[1763.052611, "o", "cat > /workspace/bench10.py << 'EOF'\r\n\u001b[?2004l\r"]
[1763.052655, "o", "\u001b[?2004h> "]
[1763.052708, "o", "import torch, sys\r\n\u001b[?2004l\r"]
