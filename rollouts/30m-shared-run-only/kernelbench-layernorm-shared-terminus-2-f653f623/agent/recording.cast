[1690.371577, "i", "cat > /workspace/bench9.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nimport triton.language as tl\nfrom sol3 import _apply3, _stats3\n\nx = torch.rand(16,64,256,256, device='cuda')\nx2 = x.view(-1)\nnpr = 64*256*256\nC = 16\nNCH = 512\ns1 = torch.zeros(C*NCH, device='cuda'); s2 = torch.zeros(C*NCH, device='cuda')\n_stats3[(C*NCH,)](x2, s1, s2, npr, NCHUNKS=NCH, BLOCK=8192, num_warps=8, num_stages=2, launch_pdl=False)\ntorch.cuda.synchronize()\nprint('s1 partials vs torch:', (s1.view(C,NCH).sum(1) - x.sum(dim=(1,2,3))).abs().max().item())\nprint('s2 partials vs torch:', (s2.view(C,NCH).sum(1) - (x*x).sum(dim=(1,2,3))).abs().max().item())\n\n# variant: apply without gdc_wait\n@triton.jit\ndef apply_nog(x_ptr, s1_ptr, s2_ptr, w_ptr, b_ptr, y_ptr, eps,\n              C: tl.constexpr, BLOCK: tl.constexpr, N: tl.constexpr, NCHUNKS: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    wv = tl.load(w_ptr + offs)\n    bv = tl.load(b_ptr + offs)\n    rows = tl.arange(0"]
[1690.371619, "i", ", C)\n    ch = tl.arange(0, NCHUNKS)\n    idx = rows[:, None] * NCHUNKS + ch[None, :]\n    ps1 = tl.load(s1_ptr + idx)\n    ps2 = tl.load(s2_ptr + idx)\n    s1v = tl.sum(tl.sum(ps1, axis=1), axis=0)\n    s2v = tl.sum(tl.sum(ps2, axis=1), axis=0)\n    mean = s1v / N\n    var = tl.maximum(s2v / N - mean * mean, 0.0)\n    rstd = 1.0 / tl.sqrt(var + eps)\n    a = rstd * wv\n    c = bv - mean * a\n    for r in range(C):\n        v = tl.load(x_ptr + r * N + offs)\n        tl.store(y_ptr + r * N + offs, v * a + c)\n\nw = torch.ones(npr, device='cuda'); b = torch.zeros(npr, device='cuda')\ny = torch.empty_like(x); y2 = y.view(-1)\napply_nog[(npr // 8192,)](x2, s1, s2, w, b, y2, 1e-5, C=C, BLOCK=8192, N=npr, NCHUNKS=NCH, num_warps=16, num_stages=2)\ntorch.cuda.synchronize()\nref = torch.nn.functional.layer_norm(x, (64,256,256), None, None, 1e-5)\nprint('apply_nog diff', (y-ref).abs().max().item())\nEOF\ngpu run -- python3 /workspace/bench9.py 2>&1 | tail -4\n"]
