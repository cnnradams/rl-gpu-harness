[1482.168915, "o", "cat > /workspace/bench6.py << 'EOF'\r\n\u001b[?2004l\r"]
[1482.168941, "o", "\u001b[?2004h> "]
[1482.168986, "o", "import torch, sys\r\n\u001b[?2004l\r"]
[1482.169018, "o", "\u001b[?2004h> "]
[1482.169088, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[1482.169112, "o", "\u001b[?2004h> "]
[1482.169207, "o", "from triton.testing import do_bench\r\n\u001b[?2004l\r"]
[1482.169245, "o", "\u001b[?2004h> "]
[1482.169277, "o", "import solution, sol3\r\n\u001b[?2004l\r"]
[1482.169316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1482.169355, "o", "\u001b[?2004h> "]
[1482.169446, "o", "x = torch.rand(16,64,256,256, device='cuda')\r\n\u001b[?2004l\r"]
[1482.169478, "o", "\u001b[?2004h> "]
[1482.16958, "o", "ref = torch.nn.LayerNorm((64,256,256)).cuda()\r\n\u001b[?2004l\r"]
[1482.169613, "o", "\u001b[?2004h> "]
[1482.169724, "o", "for mod, name in [(solution, 'v2'), (sol3, 'v3')]:\r\n\u001b[?2004l\r"]
[1482.16976, "o", "\u001b[?2004h> "]
