[612.074909, "i", "cat > /workspace/t/test4.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _matmul\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\na = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')  # like nn.Linear weight\nref64 = (a.double() @ w.double().t())\nbt = w.t()\nprint('bt contig:', bt.is_contiguous(), bt.stride())\ncfg = (128, 128, 32, 8, 4, 4)\nout1 = _matmul(a, bt, *cfg)\nprint('non-contig b: max', (out1.double()-ref64).abs().max().item())\nout2 = _matmul(a, bt.contiguous(), *cfg)\nprint('contig b: max', (out2.double()-ref64).abs().max().item())\n# also compare against cublas\nref32 = a @ bt\nprint('noncontig vs cublas:', (out1-ref32).abs().max().item())\nprint('contig vs cublas:', (out2-ref32).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test4.py\n"]
