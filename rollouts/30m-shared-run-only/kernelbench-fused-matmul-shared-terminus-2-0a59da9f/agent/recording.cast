[545.533689, "i", "cat > /workspace/t/test3.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _matmul\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\na = torch.rand(M, K, device='cuda')\nb = torch.rand(K, N, device='cuda')\nref64 = (a.double() @ b.double())\ncfgs = [\n    (128, 128, 32, 8, 4, 4),\n    (64, 128, 64, 8, 4, 4),\n    (128, 64, 64, 8, 4, 4),\n    (128, 128, 64, 8, 4, 3),\n    (64, 256, 64, 8, 4, 4),\n]\nfor cfg in cfgs:\n    out = _matmul(a, b, *cfg)\n    d = (out.double() - ref64).abs()\n    print(cfg, 'max', d.max().item(), 'mean', d.mean().item())\nEOF\ngpu run -- python3 /workspace/t/test3.py\n"]
