[775.911369, "i", "cat > /workspace/t/test6.py << 'EOF'\nimport torch, sys, time\nsys.path.insert(0, '/opt/task')\nfrom reference import Model\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    ref = Model(4096, 4096, 0.5).to(device)\n    set_seed(42)\n    x = torch.rand(16384, 4096, device=device)\n    W, b = ref.matmul.weight, ref.matmul.bias\n    y1 = torch.nn.functional.linear(x, W, b)\n    y2 = torch.nn.functional.linear(x, W, b)\n    print('linear deterministic:', torch.equal(y1, y2))\n    y3 = torch.addmm(b, x, W.t())\n    print('linear vs addmm:', (y1-y3).abs().max().item())\n    out_ref = ref(x)\n    out_fused = y1 * 1.5\n    print('ref vs fused-scale equal:', torch.equal(out_ref, out_fused))\n    # timing\n    def bench(fn, n=20):\n        for _ in range(3): fn()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        ts = []\n        for _ in range(n):\n            torc"]
[775.911416, "i", "h.cuda.synchronize()\n            s.record(); fn(); e.record()\n            torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n        return min(ts), sum(ts)/len(ts)\n    print('ref fwd:', bench(lambda: ref(x)))\n    print('linear:', bench(lambda: torch.nn.functional.linear(x, W, b)))\n    print('linear+scale:', bench(lambda: torch.nn.functional.linear(x, W, b) * 1.5))\n    print('matmul:', bench(lambda: x @ W.t()))\n    print('mm noscale W1.5:', bench(lambda: x @ (W*1.5).t()))\nEOF\ngpu run -- python3 /workspace/t/test6.py\n"]
