[1776.109486, "i", "cat > /workspace/t/test14.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task'); sys.path.insert(0, '/workspace')\nfrom reference import Model\nfrom solution import ModelNew, _matmul\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    original_model = Model(4096, 4096, 0.5)\n    set_seed(42)\n    custom_model = ModelNew(4096, 4096, 0.5)\n    trial_seed = 734796314\n    set_seed(trial_seed)\n    x = torch.rand(16384, 4096).to(device)\n    model = original_model.to(device)\n    model_new = custom_model.to(device)\n    output = model(x)\n    torch.cuda.synchronize()\n    output_new = model_new(x)\n    torch.cuda.synchronize()\n    W, b = model.matmul.weight, model.matmul.bias\n    truth = (x.double() @ W.double().t() + b.double()) * 1.5\n    print('first fwd err:', (output_new.double()-truth).abs().max().item())\n    y2 = model_new(x)\n    torch.cuda.synchronize()\n    print('second fwd err:', (y2.double()-truth).abs().max().item())"]
[1776.109537, "i", "\n    cfg = model_new._plan[1]\n    y3 = _matmul(x, model_new.matmul.weight.t(), *cfg)\n    torch.cuda.synchronize()\n    print('manual _matmul err:', (y3.double()-truth).abs().max().item())\n    print('fwd1 vs fwd2:', (output_new-y2).abs().max().item())\n    print('fwd2 vs manual:', (y2-y3).abs().max().item())\n    # check weight integrity\n    print('weight vs 1.5x ref:', (model_new.matmul.weight - 1.5*W).abs().max().item())\n    print('x unchanged? create fresh and compare')\n    set_seed(trial_seed)\n    x2 = torch.rand(16384, 4096).to(device)\n    print('x diff:', (x-x2).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test14.py\n"]
