[976.550908, "i", "cat > /workspace/t/test7.py << 'EOF'\nimport torch, os, sys\nprint('torch', torch.__version__, 'cuda', torch.version.cuda)\nfor k in os.environ:\n    if 'TF32' in k or 'CUBLAS' in k or 'NVIDIA' in k:\n        print('env:', k, os.environ[k])\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    W0 = torch.nn.Linear(4096, 4096).weight.data.to(device) * 1.5\n    set_seed(42)\n    x = torch.rand(16384, 4096).to(device)\n    wt = W0.t()\n    ref64 = x.double() @ wt.double()\n    def err(y, name):\n        print(name, (y.double()-ref64).abs().max().item())\n    y_lin = torch.nn.functional.linear(x, W0)\n    err(y_lin, 'F.linear default:')\n    err(x.bfloat16() @ wt.bfloat16(), 'bf16:')\n    err(x.half() @ wt.half(), 'fp16:')\n    torch.backends.cuda.matmul.allow_tf32 = True\n    err(torch.nn.functional.linear(x, W0), 'F.linear allow_tf32=True:')\n    torch.backends.cuda.matmul.allow_tf32 = False\n    try:\n        torch.backends.cuda.matmul.fp32_"]
[976.550988, "i", "precision = 'ieee'\n        err(torch.nn.functional.linear(x, W0), 'F.linear fp32_precision=ieee:')\n        torch.backends.cuda.matmul.fp32_precision = 'tf32'\n        err(torch.nn.functional.linear(x, W0), 'F.linear fp32_precision=tf32:')\n    except Exception as e:\n        print('fp32_precision set failed:', e)\n    # emulated tf32 single-pass via explicit rounding\n    def to_tf32(t):\n        i = t.view(torch.int32)\n        i = (i + 0x1000) & ~0x1FFF\n        return i.view(torch.float32)\n    err(to_tf32(x) @ to_tf32(wt), 'manual tf32 inputs:')\n    # diff between F.linear default and manual tf32\n    y_tf = to_tf32(x) @ to_tf32(wt)\n    print('linear vs manual-tf32:', (y_lin - y_tf).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test7.py\n"]
