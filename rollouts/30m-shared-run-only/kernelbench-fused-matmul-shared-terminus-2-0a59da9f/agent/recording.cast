[680.46319, "i", "cat > /workspace/t/test5.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew, _matmul\n\ndef set_seed(s):\n    torch.manual_seed(s)\n    torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    new = ModelNew(4096, 4096, 0.5)\n    new = new.to(device=device, dtype=torch.float32)\n    set_seed(42)\n    x = torch.rand(16384, 4096).to(device)\n    print('x contig:', x.is_contiguous())\n    y_fwd = new(x)\n    print('plan:', new._plan)\n    cfg = new._plan[1]\n    wt = new.matmul.weight.t()\n    y_direct = _matmul(x, wt, *cfg)\n    print('fwd vs direct:', (y_fwd - y_direct).abs().max().item())\n    y_fb = torch.nn.functional.linear(x, new.matmul.weight, new.matmul.bias)\n    print('fwd vs fallback:', (y_fwd - y_fb).abs().max().item())\n    print('direct vs fallback:', (y_direct - y_fb).abs().max().item())\n    # run direct again now\n    y_direct2 = _matmul(x, wt, *cfg)\n    print('direct2 vs fallback:', (y_direct2 - y_fb).abs().max().item())\n    # 6"]
[680.463239, "i", "4-bit ground truth\n    ref64 = x.double() @ wt.double()\n    print('fwd vs f64:', (y_fwd.double()-ref64).abs().max().item())\n    print('direct vs f64:', (y_direct.double()-ref64).abs().max().item())\n    print('fallback vs f64:', (y_fb.double()-ref64).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test5.py\n"]
