[479.604548, "o", "    print('weight diff vs 1.5x ref:', wd, 'bias diff:', bd)\r\n\u001b[?2004l\r"]
[479.604576, "o", "\u001b[?2004h> "]
[479.604602, "o", "    set_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[479.60463, "o", "> "]
[479.604656, "o", "    x = torch.rand(16384, 4096).to(device)\r\n\u001b[?2004l\r"]
[479.604685, "o", "\u001b[?2004h> "]
[479.604709, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[479.604738, "o", "> "]
[479.604767, "o", "        y_ref = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[479.6048, "o", "        y_new = new(x)\r\n\u001b[?2004l\r"]
[479.604828, "o", "\u001b[?2004h> "]
[479.60485, "o", "    d = (y_ref - y_new).abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[479.604878, "o", "> "]
[479.604937, "o", "    print('output diff: max', d.max().item(), 'mean', d.mean().item())\r\n\u001b[?2004l\r"]
[479.604964, "o", "\u001b[?2004h> "]
[479.605034, "o", "    print('allclose:', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r"]
[479.605062, "o", "\u001b[?2004h> "]
[479.605105, "o", "    # also compare ref linear output vs x@(W^T)+b\r\n\u001b[?2004l\r"]
[479.605133, "o", "\u001b[?2004h> "]
[479.60521, "o", "    y_lin = torch.nn.functional.linear(x, ref.matmul.weight, ref.matmul.bias)\r\n\u001b[?2004l\r"]
[479.605235, "o", "\u001b[?2004h> "]
[479.605262, "o", "    y_man = y_lin * 0.5 + y_lin\r\n\u001b[?2004l\r"]
[479.60529, "o", "\u001b[?2004h> "]
[479.605345, "o", "    print('ref vs manual:', (y_ref - y_man).abs().max().item())\r\n\u001b[?2004l\r"]
[479.605372, "o", "\u001b[?2004h> "]
[479.605398, "o", "    # check what my plan selected\r\n\u001b[?2004l\r"]
[479.605426, "o", "\u001b[?2004h> "]
[479.605454, "o", "    print('plan:', new._plan)\r\n\u001b[?2004l\r"]
[479.605482, "o", "\u001b[?2004h> "]
[479.605545, "o", "    # compare new output computed via fallback linear with scaled weights\r\n\u001b[?2004l\r"]
[479.605568, "o", "\u001b[?2004h> "]
[479.605643, "o", "    y_fb = torch.nn.functional.linear(x, new.matmul.weight, new.matmul.bias)\r\n\u001b[?2004l\r"]
[479.605671, "o", "\u001b[?2004h> "]
[479.605734, "o", "    print('ref vs new-fallback:', (y_ref - y_fb).abs().max().item())\r\n\u001b[?2004l\r"]
[479.605762, "o", "\u001b[?2004h> "]
[479.605838, "o", "    print('new-triton vs new-fallback:', (y_new - y_fb).abs().max().item())\r\n\u001b[?2004l\r"]
[479.605865, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
