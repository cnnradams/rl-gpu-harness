[1700.311658, "i", "cat > /workspace/t/test13.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _matmul\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    lin = torch.nn.Linear(4096, 4096)\n    with torch.no_grad():\n        lin.weight.mul_(1.5)\n    lin = lin.to(device)\n    set_seed(734796314)\n    x = torch.rand(16384, 4096).to(device)\n    wt = lin.weight.t()\n    truth = x.double() @ wt.double()\n    cfgs = [\n        (128, 128, 32, 8, 4, 4),\n        (64, 128, 64, 8, 4, 4),\n        (128, 64, 64, 8, 4, 4),\n        (128, 128, 64, 8, 4, 3),\n    ]\n    for cfg in cfgs:\n        out = _matmul(x, wt, *cfg)\n        torch.cuda.synchronize()\n        print(cfg, 'err vs f64:', (out.double()-truth).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test13.py\n"]
