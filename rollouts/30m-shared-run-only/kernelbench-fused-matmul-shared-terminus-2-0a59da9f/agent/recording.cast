[1058.120076, "i", "cat > /workspace/t/test8.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _matmul\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\na = torch.rand(M, K, device='cuda')\nb = torch.rand(K, N, device='cuda')\na0 = a.clone(); b0 = b.clone()\nout = _matmul(a, b, 128, 128, 32, 8, 4, 4)\ntorch.cuda.synchronize()\nprint('a mutated:', (a-a0).abs().max().item())\nprint('b mutated:', (b-b0).abs().max().item())\n# run again, check output determinism\nout2 = _matmul(a, b, 128, 128, 32, 8, 4, 4)\ntorch.cuda.synchronize()\nprint('out1 vs out2:', (out-out2).abs().max().item())\nprint('a mutated more:', (a-a0).abs().max().item())\nref64 = a0.double() @ b0.double()\nprint('out vs f64:', (out.double()-ref64).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test8.py\n"]
