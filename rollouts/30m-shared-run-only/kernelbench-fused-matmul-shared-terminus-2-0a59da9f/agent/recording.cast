[1571.148666, "i", "cat > /workspace/t/test12.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model\nfrom solution import ModelNew\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\nprecision = torch.float32\nwith torch.no_grad():\n    set_seed(42)\n    original_model = Model(4096, 4096, 0.5)\n    set_seed(42)\n    custom_model = ModelNew(4096, 4096, 0.5)\n    torch.manual_seed(42)\n    seeds = [torch.randint(0, 2**32-1, (1,)).item() for _ in range(2)]\n    for trial_seed in seeds:\n        set_seed(trial_seed)\n        inputs = [torch.rand(16384, 4096)]\n        inputs = [x.to(dtype=precision).to(device) for x in inputs]\n        set_seed(trial_seed)\n        model = original_model.to(device=device, dtype=precision)\n        set_seed(trial_seed)\n        model_new = custom_model.to(device=device, dtype=precision)\n        output = model(*inputs)\n        torch.cuda.synchronize()\n        output_new = model_new(*inputs)\n        torch.cuda.synchronize()\n        x "]
[1571.148713, "i", "= inputs[0]\n        W, b = model.matmul.weight, model.matmul.bias\n        truth = (x.double() @ W.double().t() + b.double()) * 1.5\n        e_ref = (output.double()-truth).abs().max().item()\n        e_new = (output_new.double()-truth).abs().max().item()\n        print(f'seed {trial_seed}: ref err {e_ref:.6f}, new err {e_new:.6f}, mutual {(output-output_new).abs().max().item():.6f}')\n        print('plan:', model_new._plan)\nEOF\ngpu run -- python3 /workspace/t/test12.py\n"]
