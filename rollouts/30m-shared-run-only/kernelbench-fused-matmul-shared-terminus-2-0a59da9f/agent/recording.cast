[376.168414, "i", "mkdir -p /workspace/t && cat > /workspace/t/test1.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import _matmul\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\na = torch.rand(M, K, device='cuda')\nb = torch.rand(K, N, device='cuda')\nref64 = (a.double() @ b.double())\nref32 = a @ b\ncfg = (128, 128, 32, 8, 4, 4)\nout = _matmul(a, b, *cfg)\nd64 = (out.double() - ref64).abs()\nd32 = (ref32.double() - ref64).abs()\nprint('kernel vs f64: max', d64.max().item(), 'mean', d64.mean().item())\nprint('cublas vs f64: max', d32.max().item(), 'mean', d32.mean().item())\n# tolerance check vs cublas fp32 (what evaluator compares)\nok = torch.allclose(ref32, out, atol=1e-4, rtol=1e-4)\nprint('allclose vs cublas fp32:', ok)\nd = (out - ref32).abs()\nprint('kernel vs cublas: max', d.max().item())\nthr = 1e-4 + 1e-4 * ref32.abs()\nprint('violations:', (d > thr).sum().item())\nEOF\ngpu run -- python3 /workspace/t/test1.py\n"]
