[1222.582858, "i", "cat > /workspace/t/test10.py << 'EOF'\nimport torch\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\ndevice = torch.device('cuda')\n\ndef linerr():\n    with torch.no_grad():\n        set_seed(42)\n        lin = torch.nn.Linear(4096, 4096).to(device)\n        set_seed(42)\n        x = torch.rand(16384, 4096).to(device)\n        y = torch.nn.functional.linear(x, lin.weight, lin.bias)\n        truth = x.double() @ lin.weight.double().t() + lin.bias.double()\n        return (y.double()-truth).abs().max().item()\n\nprint('baseline linerr:', linerr())\nimport triton\nimport triton.language as tl\nprint('after triton import: allow_tf32 =', torch.backends.cuda.matmul.allow_tf32)\nprint('after triton import linerr:', linerr())\nimport sys\nsys.path.insert(0, '/workspace')\nfrom solution import _matmul\na = torch.rand(1024, 4096, device='cuda')\nb = torch.rand(4096, 4096, device='cuda')\n_matmul(a, b, 128, 128, 32, 8, 4, 4)\ntorch.cuda.synchronize()\nprint('after kernel run: allow_tf32 =', torch.backends.cuda.matmul.allo"]
[1222.582905, "i", "w_tf32)\nprint('after kernel run linerr:', linerr())\nEOF\ngpu run -- python3 /workspace/t/test10.py\n"]
