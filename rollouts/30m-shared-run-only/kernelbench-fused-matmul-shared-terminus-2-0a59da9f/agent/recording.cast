[479.602914, "i", "cat > /workspace/t/test2.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nsys.path.insert(0, '/opt/task')\nfrom reference import Model\nfrom solution import ModelNew\n\ndef set_seed(s):\n    torch.manual_seed(s)\n    torch.cuda.manual_seed(s)\n\nprint('allow_tf32 matmul:', torch.backends.cuda.matmul.allow_tf32)\ntry:\n    print('fp32_precision:', torch.backends.cuda.matmul.fp32_precision)\nexcept Exception as e:\n    print('no fp32_precision attr')\n\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    ref = Model(4096, 4096, 0.5)\n    set_seed(42)\n    new = ModelNew(4096, 4096, 0.5)\n    ref = ref.to(device=device, dtype=torch.float32)\n    new = new.to(device=device, dtype=torch.float32)\n    wd = (new.matmul.weight - ref.matmul.weight * 1.5).abs().max().item()\n    bd = (new.matmul.bias - ref.matmul.bias * 1.5).abs().max().item()\n    print('weight diff vs 1.5x ref:', wd, 'bias diff:', bd)\n    set_seed(42)\n    x = torch.rand(16384, 4096).to(device)\n    with torch.no_grad():\n        y_ref = r"]
[479.602963, "i", "ef(x)\n        y_new = new(x)\n    d = (y_ref - y_new).abs()\n    print('output diff: max', d.max().item(), 'mean', d.mean().item())\n    print('allclose:', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\n    # also compare ref linear output vs x@(W^T)+b\n    y_lin = torch.nn.functional.linear(x, ref.matmul.weight, ref.matmul.bias)\n    y_man = y_lin * 0.5 + y_lin\n    print('ref vs manual:', (y_ref - y_man).abs().max().item())\n    # check what my plan selected\n    print('plan:', new._plan)\n    # compare new output computed via fallback linear with scaled weights\n    y_fb = torch.nn.functional.linear(x, new.matmul.weight, new.matmul.bias)\n    print('ref vs new-fallback:', (y_ref - y_fb).abs().max().item())\n    print('new-triton vs new-fallback:', (y_new - y_fb).abs().max().item())\nEOF\ngpu run -- python3 /workspace/t/test2.py\n"]
