[1151.42471, "i", "cat > /workspace/t/test9.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\nprint('allow_tf32:', torch.backends.cuda.matmul.allow_tf32)\ntry:\n    print('fp32_precision:', torch.backends.cuda.matmul.fp32_precision)\nexcept Exception:\n    pass\ndevice = torch.device('cuda')\nwith torch.no_grad():\n    set_seed(42)\n    ref = Model(4096, 4096, 0.5)\n    ref = ref.to(device=device, dtype=torch.float32)\n    set_seed(42)\n    x = torch.rand(16384, 4096).to(device)\n    y_ref = ref(x)\n    W, b = ref.matmul.weight, ref.matmul.bias\n    truth = (x.double() @ W.double().t() + b.double()) * 1.5\n    print('ref err vs f64:', (y_ref.double()-truth).abs().max().item())\n    y_lin = torch.nn.functional.linear(x, W, b)\n    print('F.linear err vs f64:', ((y_lin.double()*1.5)-truth).abs().max().item())\n    print('ref vs linear*1.5 exact equal:', torch.equal(y_ref, y_lin*1.5))\n    print('allow_tf32 after:', torch.backends.cuda.matm"]
[1151.424769, "i", "ul.allow_tf32)\nEOF\ngpu run -- python3 /workspace/t/test9.py\n"]
