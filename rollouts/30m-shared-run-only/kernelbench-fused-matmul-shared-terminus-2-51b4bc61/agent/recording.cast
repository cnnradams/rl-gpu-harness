[663.177433, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\nMASK = -8192\n\ntarget = torch.addmm(b, x, w) * scale\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# Veltkamp split kernel: write hi/lo in bf16\n@triton.jit\ndef split_kernel(x_ptr, hi_ptr, lo_ptr, numel, C, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(x_ptr + offs, mask=mask)\n    t = v * C\n    hi ="]
[663.177491, "i", " t - (t - v)\n    lo = v - hi\n    tl.store(hi_ptr + offs, hi.to(tl.bfloat16), mask=mask)\n    tl.store(lo_ptr + offs, lo.to(tl.bfloat16), mask=mask)\n\n# cached weight splits\nwt = w.contiguous()\nt = wt * 8193.0\nw_hi_f = t - (t - wt)\nw_lo_f = wt - w_hi_f\nw_hi_b = w_hi_f.bfloat16().contiguous()\nw_lo_b = w_lo_f.bfloat16().contiguous()\n\nx_hi_b = torch.empty(M, K, device=dev, dtype=torch.bfloat16)\nx_lo_b = torch.empty(M, K, device=dev, dtype=torch.bfloat16)\n\ndef variant_a(x):\n    prev = torch.backends.cuda.matmul.allow_tf32\n    torch.backends.cuda.matmul.allow_tf32 = True\n    try:\n        t1 = torch.mm(x, w_hi_f)          # tf32, RN(x) @ w_hi\n    finally:\n        torch.backends.cuda.matmul.allow_tf32 = prev\n    numel = x.numel()\n    split_kernel[(triton.cdiv(numel, 4096),)](x, x_hi_b, x_lo_b, numel, 8193.0, BLOCK=4096, num_warps=8)\n    t2 = torch.mm(x_lo_b, w_hi_b)         # bf16\n    t3 = torch.mm(x_hi_b, w_lo_b)         # bf16\n    return t1, t2, t3\n\nt1, t2, t3 = variant_a(x)\nres = (t1 + t2.float() + t3.float() + b) *"]
[663.177629, "i", " scale\nprint('variant_a err_ratio %.4f' % err(res)[1])\nprint('variant_a (no epi) %.3f ms' % timeit(lambda: variant_a(x)))\n\n# also check error without x_lo term (is veltkamp+2gemm enough?)\nres2 = (t1 + t3.float() + b) * scale\nprint('a_nolo err_ratio %.4f' % err(res2)[1])\nres3 = (t1 + t2.float() + b) * scale\nprint('a_nohi err_ratio %.4f' % err(res3)[1])\n\n# timing components\nprev = torch.backends.cuda.matmul.allow_tf32\ntorch.backends.cuda.matmul.allow_tf32 = True\nprint('tf32 mm NN      %.3f ms' % timeit(lambda: torch.mm(x, w_hi_f)))\nwT_hi = w_hi_f.t().contiguous().t()  # (K,N) with stride (1,K) = N-major...\nwtN = w_hi_f.t().contiguous()  # (N,K) row major\nprint('tf32 mm TN      %.3f ms' % timeit(lambda: torch.mm(x, wtN.t())))\ntorch.backends.cuda.matmul.allow_tf32 = prev\nprint('bf16 mm         %.3f ms' % timeit(lambda: torch.mm(x_hi_b, w_hi_b)))\nprint('split           %.3f ms' % timeit(lambda: split_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_hi_b, x_lo_b, x.numel(), 8193.0, BLOCK=4096, num_warps=8)))\n\n# tuned o"]
[663.177643, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[663.177685, "i", "pt_3x: mask split fused, addmm accumulate\nx_hi = torch.empty(M, K, device=dev)\nx_lo = torch.empty(M, K, device=dev)\n\n@triton.jit\ndef split_f32_kernel(x_ptr, hi_ptr, lo_ptr, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(x_ptr + offs, mask=mask)\n    hi = (v.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\n    tl.store(hi_ptr + offs, hi, mask=mask)\n    tl.store(lo_ptr + offs, v - hi, mask=mask)\n\nw_hi = (wt.view(torch.int32) & MASK).view(torch.float32).contiguous()\nw_lo = (wt - w_hi).contiguous()\nt1b = torch.empty(M, N, device=dev)\n\ndef opt_3x_tuned(x):\n    prev = torch.backends.cuda.matmul.allow_tf32\n    torch.backends.cuda.matmul.allow_tf32 = True\n    try:\n        split_f32_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_hi, x_lo, x.numel(), BLOCK=4096, num_warps=8)\n        torch.mm(x_hi, w_hi, out=t1b)\n        torch.addmm(t1b, x_lo, w_hi, beta=1, out=t1b)\n        torch.addmm(t1b, x_hi, w_lo, beta=1, out="]
[663.177694, "o", "\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.177738, "i", "t1b)\n    finally:\n        torch.backends.cuda.matmul.allow_tf32 = prev\n    return t1b\n\nob = opt_3x_tuned(x)\nresb = (ob + b) * scale\nprint('opt_3x_tuned err_ratio %.4f' % err(resb)[1])\nprint('opt_3x_tuned (no epi) %.3f ms' % timeit(lambda: opt_3x_tuned(x)))\nEOF\ngpu run -- python3 /workspace/bench4.py > /tmp/bench4.log 2>&1 &\n"]
