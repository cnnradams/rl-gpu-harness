[499.500574, "o", "request ID: fbdb8231204747238ac92dd06a875d30\r\nbox: sb-fQdbaCSzyJkvuzreqWf5qg\r\ncommand: 09112b82b2054d7a919b45a0110b3179\r\nopt_3x err_ratio 0.1528\r\nopt_3x              6.242 ms\r\nopt_3x_b err_ratio 0.1528\r\nopt_3x_b            6.307 ms\r\nsplit_x_2g err_ratio 4.4355\r\nsplit_x_2g          4.419 ms\r\nsplit_w_2g err_ratio 4.8754\r\nsplit_w_2g          4.087 ms\r\n1x BM=128 BN=128 BK=64 GM=8 nw=8 ns=3: 6.415 ms\r\n1x BM=128 BN=256 BK=64 nw=8 ns=3: FAILED\r\n1x BM=128 BN=128 BK=32 GM=8 nw=8 ns=4: 6.580 ms\r\n1x BM=64 BN=128 BK=64 GM=8 nw=4 ns=4: 11.531 ms\r\n1x BM=128 BN=64 BK=64 GM=8 nw=4 ns=4: 6.230 ms\r\n"]
