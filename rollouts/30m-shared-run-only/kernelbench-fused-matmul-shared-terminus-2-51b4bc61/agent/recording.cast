[663.18047, "o", "def variant_a(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.180502, "o", "    prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[663.180532, "o", "\u001b[?2004h> "]
