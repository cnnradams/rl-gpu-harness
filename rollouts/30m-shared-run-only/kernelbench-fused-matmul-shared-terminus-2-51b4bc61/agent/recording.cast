[371.442503, "o", "> "]
[371.442525, "o", "    torch.mm(x, w_hi, out=tmp1)\r\n\u001b[?2004l\r"]
[371.442551, "o", "\u001b[?2004h> "]
[371.442584, "o", "    torch.mm(x, w_lo, out=tmp2)\r\n\u001b[?2004l\r"]
[371.442607, "o", "\u001b[?2004h> "]
[371.442659, "o", "    torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.442682, "o", "> "]
[371.442718, "o", "    return (tmp1 + tmp2 + b) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.442745, "o", "> "]
[371.442807, "o", "o = split_w_2g(x); print('split_w_2g err_ratio %.4f' % err(o)[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.442833, "o", "> "]
[371.442896, "o", "print('split_w_2g          %.3f ms' % timeit(lambda: split_w_2g(x)))\r\n\u001b[?2004l\r"]
[371.442927, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[371.44295, "o", "\u001b[?2004h> "]
[371.442991, "o", "# Triton pure tf32 dot speed test\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443013, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[371.443036, "o", "\u001b[?2004h> "]
[371.443122, "o", "def mm1x_kernel(a_ptr, b_ptr, c_ptr, M, N, K, sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[371.443144, "o", "\u001b[?2004h> "]
[371.443246, "o", "                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443267, "o", "> "]
[371.443291, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443322, "o", "> "]
[371.443371, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[371.443393, "o", "\u001b[?2004h> "]
[371.443416, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443438, "o", "> "]
[371.443459, "o", "    gid = pid // width\r\n\u001b[?2004l\r"]
[371.44348, "o", "\u001b[?2004h> "]
[371.443528, "o", "    gsz = tl.minimum(grid_m - gid * GM, GM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.44355, "o", "> "]
[371.443583, "o", "    pid_m = gid * GM + (pid % gsz)\r\n\u001b[?2004l\r"]
[371.443607, "o", "\u001b[?2004h> "]
[371.443642, "o", "    pid_n = (pid % width) // gsz\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443665, "o", "> "]
[371.443703, "o", "    om = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443726, "o", "> "]
[371.443764, "o", "    on = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443787, "o", "> "]
[371.443812, "o", "    ok = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[371.443833, "o", "\u001b[?2004h> "]
[371.443889, "o", "    ap = a_ptr + om[:, None]*sam + ok[None, :]*sak\r\n\u001b[?2004l\r"]
[371.443912, "o", "\u001b[?2004h> "]
[371.443964, "o", "    bp = b_ptr + ok[:, None]*sbk + on[None, :]*sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.443987, "o", "> "]
[371.444034, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.444065, "o", "> "]
[371.444087, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[371.44411, "o", "\u001b[?2004h> "]
[371.444159, "o", "        a = tl.load(ap); bb = tl.load(bp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.444182, "o", "> "]
[371.444238, "o", "        acc = tl.dot(a, bb, acc, input_precision=\"tf32\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.444262, "o", "> "]
[371.4443, "o", "        ap += BK * sak; bp += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.444328, "o", "> "]
[371.444377, "o", "    cp = c_ptr + om[:, None]*scm + on[None, :]*scn\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.44441, "o", "> "]
[371.444432, "o", "    tl.store(cp, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[371.444454, "o", "\u001b[?2004h> "]
[371.444492, "o", "out = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.444513, "o", "> "]
[371.444548, "o", "def run1x(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.44457, "o", "> "]
[371.44464, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.444665, "o", ">     def f():\r\n\u001b[?2004l\r"]
[371.444688, "o", "\u001b[?2004h> "]
[371.444742, "o", "        mm1x_kernel[grid](x, w, out, M, N, K,\r\n\u001b[?2004l\r"]
[371.444767, "o", "\u001b[?2004h> "]
[371.444854, "o", "                          x.stride(0), x.stride(1), w.stride(0), w.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.44488, "o", "> "]
[371.444933, "o", "                          out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.44496, "o", "> "]
[371.445028, "o", "                          BM, BN, BK, GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.445052, "o", ">     try:\r\n\u001b[?2004l\r"]
[371.445082, "o", "\u001b[?2004h>         f()\r\n\u001b[?2004l\r"]
[371.445105, "o", "\u001b[?2004h> "]
[371.445142, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.445163, "o", "> "]
[371.445234, "o", "        print(f'1x BM={BM} BN={BN} BK={BK} nw={nw} ns={ns}: FAILED')\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.445256, "o", "> "]
[371.445282, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[371.445387, "o", "    print(f'1x BM={BM} BN={BN} BK={BK} GM={GM} nw={nw} ns={ns}: {timeit(f):.3f} ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.445408, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[371.445431, "o", "> "]
[371.445539, "o", "for cfg in [(128,128,64,8,8,3),(128,256,64,8,8,3),(128,128,32,8,8,4),(64,128,64,8,4,4),(128,64,64,8,4,4)]:\r\n\u001b[?2004l\r"]
[371.445564, "o", "\u001b[?2004h> "]
[371.445585, "o", "    run1x(*cfg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[371.445608, "o", "> EOF\r\n\u001b[?2004l\r"]
[371.447432, "o", "\u001b[?2004hroot@modal:/# "]
