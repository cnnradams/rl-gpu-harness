[1185.85754, "i", "cat > /workspace/dbg4.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nfrom solution import _split_f32, _MASK\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\ndev='cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev)*2-1)/64.0\nb = torch.randn(N, device=dev)*0.05\ns = 1.5\n\nw_hi = (w.view(torch.int32) & _MASK).view(torch.float32)\nw_lo = w - w_hi\nw_hi_t = w_hi.t().contiguous()\nw_lo_t = w_lo.t().contiguous()\nbias_s = b * s\n\nx_hi = torch.empty(M, K, device=dev)\nx_lo = torch.empty(M, K, device=dev)\n_split_f32[(triton.cdiv(M*K, 4096),)](x, x_hi, x_lo, M*K, BLOCK=4096, num_warps=8)\n\ntorch.backends.cuda.matmul.allow_tf32 = True\nt = torch.empty(M, N, device=dev)\ntorch.addmm(bias_s, x, w_hi_t.t(), beta=1, alpha=s, out=t)\ntorch.addmm(t, x_lo, w_hi_t.t(), beta=1, alpha=s, out=t)\ntorch.addmm(t, x_hi, w_lo_t.t(), beta=1, alpha=s, out=t)\ntorch.backends.cuda.matmul.allow_tf32 = False\n\n# fp32 emulation of intended math (fp32 gemms, same algebra)\nem = bias_s + s*(x@w_hi) + s*(x_l"]
[1185.857587, "i", "o@w_hi) + s*(x_hi@w_lo)\nprint('pipeline vs fp32-emulation err:', (t-em).abs().max().item())\nrel = ((t-em).abs()/(em.abs()+1e-6)).max().item()\nprint('rel:', rel)\n\n# intended vs true target\ntarget = torch.addmm(b, x, w) * s\nprint('fp32-emulation vs target err:', (em-target).abs().max().item())\ntol = 1e-4 + 1e-4*target.abs()\nprint('emulation ratio:', ((em-target).abs()/tol).max().item())\nprint('pipeline ratio:', ((t-target).abs()/tol).max().item())\n\n# check tf32 aliased accumulate exactness with alpha\ntorch.manual_seed(1)\na2 = torch.randn(512,512,device=dev); b2 = torch.randn(512,512,device=dev)\nc0 = torch.randn(512,512,device=dev)\ntorch.backends.cuda.matmul.allow_tf32 = True\nc_alias = c0.clone()\ntorch.addmm(c_alias, a2, b2, beta=1, alpha=1.5, out=c_alias)\nc_non = torch.empty_like(c0)\ntorch.addmm(c0, a2, b2, beta=1, alpha=1.5, out=c_non)\ntorch.backends.cuda.matmul.allow_tf32 = False\nprint('alias==nonalias tf32 alpha:', torch.equal(c_alias, c_non))\nprint('alias sane:', torch.allclose(c_alias, c0 + 1.5*(a2@b2), at"]
