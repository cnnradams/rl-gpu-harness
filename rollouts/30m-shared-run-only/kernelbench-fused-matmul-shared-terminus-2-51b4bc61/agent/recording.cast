[1029.98409, "i", "cat > /workspace/dbg2.py << 'EOF'\nimport torch\ndev='cuda'\ntorch.manual_seed(0)\nM,K,N = 512, 512, 512\na = torch.randn(M,K,device=dev); b = torch.randn(K,N,device=dev)\nt = torch.randn(M,N,device=dev)\nt0 = t.clone()\ns = 1.5\n# aliased accumulate\ntorch.addmm(t, a, b, beta=1, alpha=s, out=t)\nprint('aliased changed:', (t - t0).abs().max().item(), 'expect', (s*(a@b)).abs().max().item())\n# exact?\nprint('aliased exact:', torch.allclose(t, t0 + s*(a@b), atol=1e-4, rtol=1e-4))\n# non-aliased\nt2 = torch.empty(M,N,device=dev)\ntorch.addmm(t0, a, b, beta=1, alpha=s, out=t2)\nprint('nonaliased matches aliased:', torch.equal(t, t2))\n# tf32 path aliasing?\ntorch.backends.cuda.matmul.allow_tf32 = True\nt3 = torch.randn(M,N,device=dev); t30 = t3.clone()\ntorch.addmm(t3, a, b, beta=1, alpha=s, out=t3)\nprint('tf32 aliased changed:', (t3-t30).abs().max().item())\nt4 = torch.empty(M,N,device=dev)\ntorch.addmm(t30, a, b, beta=1, alpha=s, out=t4)\nprint('tf32 nonalias ref changed:', (t4-t30).abs().max().item())\nprint('tf32 alias==nonalias:', t"]
[1029.984152, "i", "orch.equal(t3,t4))\nEOF\ngpu run -- python3 /workspace/dbg2.py > /tmp/dbg2.log 2>&1 &\n"]
