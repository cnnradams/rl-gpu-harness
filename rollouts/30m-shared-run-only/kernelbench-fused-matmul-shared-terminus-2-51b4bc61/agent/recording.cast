[559.993659, "o", "            torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r\u001b[?2004h"]
[559.993701, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.993737, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
