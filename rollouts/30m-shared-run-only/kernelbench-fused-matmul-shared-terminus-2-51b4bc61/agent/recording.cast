[166.186522, "o", "request ID: 4ad283bf1b4e435c9b27ad55229c5054\r\nbox: sb-H91rVm6j7rO0IzAAdJ5yMT\r\ncommand: 05d23ed8e8454c018d375e6d8d5c2268\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 13.6,\r\n  \"runtime_stats\": {\r\n    \"mean\": 13.6,\r\n    \"std\": 0.132,\r\n    \"min\": 13.5,\r\n    \"max\": 13.9,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.043,\r\n    \"min\": 11.3,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"62241deb95a4cab92f7f391c6977ec3d86939e1ecdd3fa2b4ed0af0734b15103\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"mi"]
[166.186583, "o", "lliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 0.8382352941176471\r\n}\r\n"]
