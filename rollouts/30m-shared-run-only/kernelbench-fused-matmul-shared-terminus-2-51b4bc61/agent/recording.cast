[1323.711252, "i", "python3 - << 'EOF'\nimport re\nsrc = open('/workspace/solution.py').read()\n# revert split kernel to truncation mask\nsrc = src.replace('''        v = tl.load(x_ptr + offs, mask=mask)\n        t = v * 8193.0\n        hi = t - (t - v)\n        tl.store(hi_ptr + offs, hi, mask=mask)\n        tl.store(lo_ptr + offs, v - hi, mask=mask)''',\n'''        v = tl.load(x_ptr + offs, mask=mask)\n        hi = (v.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\n        tl.store(hi_ptr + offs, hi, mask=mask)\n        tl.store(lo_ptr + offs, v - hi, mask=mask)''')\nsrc = src.replace('''def _veltkamp(v):\n    t = v * 8193.0\n    hi = t - (t - v)\n    return hi, v - hi''',\n'''def _veltkamp(v):\n    hi = (v.view(torch.int32) & -8192).view(torch.float32)\n    return hi, v - hi''')\nsrc = src.replace('torch.addmm(self._bias_s, x, self._w_hi_t.t(), beta=1, alpha=s, out=t)',\n                  'torch.addmm(self._bias_s, x_hi, self._w_hi_t.t(), beta=1, alpha=s, out=t)')\nopen('/workspace/solution.py','w').write(src)\nprint('patched')\nEO"]
