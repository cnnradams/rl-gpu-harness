[892.583436, "o", "> "]
[892.583475, "o", "        self._w_hi_t = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.583515, "o", "        self._w_lo_t = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.583556, "o", ">         self._bias_s = None\r\n\u001b[?2004l\r"]
[892.583591, "o", "\u001b[?2004h> "]
[892.583626, "o", "        self._bufs = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.583665, "o", "    def _refresh(self):\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.583699, "o", "> "]
[892.583732, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.583774, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.583848, "o", "        key = (w.data_ptr(), b.data_ptr(), w.device, w.dtype, w.shape)\r\n\u001b[?2004l\r"]
[892.583885, "o", "\u001b[?2004h> "]
[892.583925, "o", "        if self._key != key:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.583973, "o", "            wt = w.detach().t().contiguous()  # (in, out)\r\n\u001b[?2004l\r"]
[892.584008, "o", "\u001b[?2004h> "]
[892.584066, "o", "            w_hi = (wt.view(torch.int32) & _MASK).view(torch.float32)\r\n\u001b[?2004l\r"]
[892.584107, "o", "\u001b[?2004h> "]
[892.584148, "o", "            w_lo = wt - w_hi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.584183, "o", "            s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.584226, "o", "> "]
[892.584264, "o", "            self._w_hi_t = w_hi.t().contiguous()  # (out, in)\r\n\u001b[?2004l\r"]
[892.584304, "o", "\u001b[?2004h> "]
[892.584344, "o", "            self._w_lo_t = w_lo.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.584383, "o", "> "]
[892.584423, "o", "            self._bias_s = (b.detach() * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.584462, "o", "            self._bufs = {}\r\n\u001b[?2004l\r"]
[892.584503, "o", "\u001b[?2004h>             self._key = key\r\n\u001b[?2004l\r"]
[892.584541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.58459, "o", "    def _get_bufs(self, M, K, N, device):\r\n\u001b[?2004l\r"]
[892.584646, "o", "\u001b[?2004h>         key = (M, K, N, device)\r\n\u001b[?2004l\r"]
[892.584686, "o", "\u001b[?2004h> "]
[892.584726, "o", "        if key not in self._bufs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.584767, "o", "            self._bufs[key] = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.58485, "o", "                torch.empty(M, K, device=device, dtype=torch.float32),\r\n\u001b[?2004l\r"]
[892.584894, "o", "\u001b[?2004h> "]
[892.584946, "o", "                torch.empty(M, K, device=device, dtype=torch.float32),\r\n\u001b[?2004l\r"]
[892.58498, "o", "\u001b[?2004h> "]
[892.585042, "o", "                torch.empty(M, N, device=device, dtype=torch.float32),\r\n\u001b[?2004l\r"]
[892.585083, "o", "\u001b[?2004h>             )\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.585122, "o", ">         return self._bufs[key]\r\n\u001b[?2004l\r"]
[892.585161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.585201, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.585247, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[892.585281, "o", "\u001b[?2004h> "]
[892.585321, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.585361, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.585403, "o", "> "]
[892.58545, "o", "        if (not _HAS_TRITON or not x.is_cuda or x.dtype != torch.float32\r\n\u001b[?2004l\r"]
[892.58549, "o", "\u001b[?2004h> "]
[892.58553, "o", "                or not x.is_contiguous() or x.dim() != 2):\r\n\u001b[?2004l\r"]
[892.58557, "o", "\u001b[?2004h> "]
[892.585611, "o", "            y = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[892.58565, "o", "> "]
[892.585692, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[892.585732, "o", ">         self._refresh()\r\n\u001b[?2004l\r"]
[892.585752, "o", "\u001b[?2004h> "]
[892.585768, "o", "        M, K = x.shape"]
[892.585811, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         N = w.shape[0]\r\n\u001b[?2004l\r"]
[892.585845, "o", "\u001b[?2004h> "]
[892.585895, "o", "        x_hi, x_lo, t = self._get_bufs(M, K, N, x.device)\r\n\u001b[?2004l\r"]
[892.585932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.585987, "o", "        prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[892.586025, "o", "\u001b[?2004h> "]
[892.586066, "o", "        torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[892.586105, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[892.586167, "o", "            _split_f32[(triton.cdiv(M * K, 4096),)](\r\n\u001b[?2004l\r"]
[892.586206, "o", "\u001b[?2004h> "]
[892.586258, "o", "                x, x_hi, x_lo, M * K, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[892.586289, "o", "\u001b[?2004h> "]
[892.586368, "o", "            torch.addmm(self._bias_s, x, self._w_hi_t.t(), beta=0, alpha=s, out=t)\r\n\u001b[?2004l\r"]
[892.586402, "o", "\u001b[?2004h> "]
[892.586463, "o", "            torch.addmm(t, x_lo, self._w_hi_t.t(), beta=1, alpha=s, out=t)\r\n\u001b[?2004l\r"]
[892.586496, "o", "\u001b[?2004h> "]
[892.58656, "o", "            torch.addmm(t, x_hi, self._w_lo_t.t(), beta=1, alpha=s, out=t)\r\n\u001b[?2004l\r"]
[892.586596, "o", "\u001b[?2004h>         finally:\r\n\u001b[?2004l\r"]
[892.586635, "o", "\u001b[?2004h> "]
[892.586676, "o", "            torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[892.586714, "o", "\u001b[?2004h>         return t\r\n\u001b[?2004l\r"]
[892.586752, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[892.588188, "o", "\u001b[?2004hroot@modal:/# "]
[892.588304, "o", "python3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[892.60316, "o", "ok\r\n"]
[892.605653, "o", "\u001b[?2004hroot@modal:/# "]
[895.583557, "i", "cat > /workspace/test_sol.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\ndev = 'cuda'\nin_f, out_f, sf = 4096, 4096, 0.5\nm = ModelNew(in_f, out_f, sf).to(dev)\n\nx = torch.rand(16384, in_f, device=dev)\nwith torch.no_grad():\n    y_ref = m.matmul(x)\n    y_ref = y_ref * sf + y_ref.clone()\n    y_new = m(x)\nd = (y_ref - y_new).abs()\ntol = 1e-4 + 1e-4 * y_ref.abs()\nprint('max abs diff', d.max().item(), 'err_ratio', (d/tol).max().item())\nprint('allow_tf32 restored:', not torch.backends.cuda.matmul.allow_tf32)\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\nwith torch.no_grad():\n    print('new: %.3f ms' % timeit(lambda: m(x)))\n    def ref():\n        y = m.matmul(x)\n        return y * sf + y\n    print('ref: %.3f ms' % timeit(ref))\nEOF\ngpu"]
[895.583605, "i", " run -- python3 /workspace/test_sol.py > /tmp/test_sol.log 2>&1 &\n"]
