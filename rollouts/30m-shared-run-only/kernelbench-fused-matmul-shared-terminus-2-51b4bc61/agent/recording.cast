[559.99399, "o", "\u001b[?2004h> "]
[559.99403, "o", "            # bias add via modulo indexing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994088, "o", "            grid = (triton.cdiv(numel, 4096),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994188, "o", "            _epilogue2[grid](t1, t2, b, out, numel, N, s, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
