[559.994399, "o", "\r\n\u001b[?2004l\r"]
[559.994424, "o", "\u001b[?2004h>     @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994502, "o", "    def _epilogue2(t1_ptr, t2_ptr, b_ptr, o_ptr, numel, N, SCALE,\r\n\u001b[?2004l\r"]
[559.994544, "o", "\u001b[?2004h> "]
[559.994585, "o", "                   BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994629, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994689, "o", "        offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[559.994709, "o", "\u001b[?2004h> "]
[559.99475, "o", "        mask = offs < numel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994811, "o", "        t1 = tl.load(t1_ptr + offs, mask=mask)\r\n\u001b[?2004l\r"]
[559.994854, "o", "\u001b[?2004h> "]
[559.994894, "o", "        t2 = tl.load(t2_ptr + offs, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.994958, "o", "        b = tl.load(b_ptr + offs % N, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[559.995005, "o", "> "]
[559.995047, "o", "        tl.store(o_ptr + offs, (t1 + t2 + b) * SCALE, mask=mask)\r\n\u001b[?2004l\r"]
[559.995088, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
