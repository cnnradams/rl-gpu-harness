[559.990737, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.990825, "o", "    def _epilogue_kernel(t1_ptr, t2_ptr, b_ptr, o_ptr, numel, SCALE,\r\n\u001b[?2004l\r\u001b[?2004h> "]
