[371.435823, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\nMASK = -8192\n\ntarget = torch.addmm(b, x, w) * scale\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# cached w split\nw_hi = (w.view(torch.int32) & MASK).view(torch.float32)\nw_lo = w - w_hi\nw_hi = w_hi.contiguous(); w_lo = w_lo.contiguous()\ntmp1 = torch.empty(M, N, device=dev)\ntmp2 = torch.empty(M, N, device=dev)\ntmp3 = torch.empty(M, N, device=dev)\n\ndef opt_3x(x):\n    torch.backends.cu"]
[371.435875, "i", "da.matmul.allow_tf32 = True\n    x_hi = (x.view(torch.int32) & MASK).view(torch.float32)\n    x_lo = x - x_hi\n    torch.mm(x_hi, w_hi, out=tmp1)\n    torch.mm(x_lo, w_hi, out=tmp2)\n    tmp1 += tmp2\n    torch.mm(x_hi, w_lo, out=tmp2)\n    tmp1 += tmp2\n    torch.backends.cuda.matmul.allow_tf32 = False\n    return torch.addmm(b, tmp1, torch.eye(1, device=dev), beta=1, alpha=0) if False else (tmp1 + b) * scale\n\no = opt_3x(x); print('opt_3x err_ratio %.4f' % err(o)[1])\nprint('opt_3x              %.3f ms' % timeit(lambda: opt_3x(x)))\n\n# variant: fold scale into epilogue manually, avoid extra kernels: (tmp1+b)*scale is 1 fused? it's 2 kernels. Use add then mul? test with alpha trick: scale*(tmp1+b) = tmp1*scale + b*scale -> addmm(b*scale, tmp1, I)? no. Use torch.add(tmp1, b) then multiply - same.\nb_s = b * scale\ndef opt_3x_b(x):\n    torch.backends.cuda.matmul.allow_tf32 = True\n    x_hi = (x.view(torch.int32) & MASK).view(torch.float32)\n    x_lo = x - x_hi\n    torch.mm(x_hi, w_hi, out=tmp1)\n    torch.mm(x_lo, w_hi, out=tm"]
[371.435883, "i", "p2)\n    torch.mm(x_hi, w_lo, out=tmp3)\n    torch.backends.cuda.matmul.allow_tf32 = False\n    return torch.add(tmp1, tmp2).add_(tmp3).add_(b).mul_(scale)\n\no = opt_3x_b(x); print('opt_3x_b err_ratio %.4f' % err(o)[1])\nprint('opt_3x_b            %.3f ms' % timeit(lambda: opt_3x_b(x)))\n\n# fused epilogue via addmm with diagonal? Instead: append ones column trick too costly.\n# try: y = addmm(b_s_broadcast?, ...) addmm needs mat2 2-D. Use torch.addmm(bias, tmp1, dummy(N,N) zeros)? wasteful.\n\n# 2-GEMM variant: split x only (w stays fp32 but rounds to tf32 inside tensor core)\ndef split_x_2g(x):\n    torch.backends.cuda.matmul.allow_tf32 = True\n    x_hi = (x.view(torch.int32) & MASK).view(torch.float32)\n    x_lo = x - x_hi\n    torch.mm(x_hi, w, out=tmp1)\n    torch.mm(x_lo, w, out=tmp2)\n    torch.backends.cuda.matmul.allow_tf32 = False\n    return (tmp1 + tmp2 + b) * scale\no = split_x_2g(x); print('split_x_2g err_ratio %.4f' % err(o)[1])\nprint('split_x_2g          %.3f ms' % timeit(lambda: split_x_2g(x)))\n\n# 2-GEMM varian"]
[371.435891, "i", "t: split w only (x rounds to tf32)\ndef split_w_2g(x):\n    torch.backends.cuda.matmul.allow_tf32 = True\n    torch.mm(x, w_hi, out=tmp1)\n    torch.mm(x, w_lo, out=tmp2)\n    torch.backends.cuda.matmul.allow_tf32 = False\n    return (tmp1 + tmp2 + b) * scale\no = split_w_2g(x); print('split_w_2g err_ratio %.4f' % err(o)[1])\nprint('split_w_2g          %.3f ms' % timeit(lambda: split_w_2g(x)))\n\n# Triton pure tf32 dot speed test\n@triton.jit\ndef mm1x_kernel(a_ptr, b_ptr, c_ptr, M, N, K, sam, sak, sbk, sbn, scm, scn,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    ap = a_ptr + om[:, None]*sam + ok[None, :]*sak\n    bp = b_ptr + ok[:, None]*"]
[371.435976, "i", "sbk + on[None, :]*sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(ap); bb = tl.load(bp)\n        acc = tl.dot(a, bb, acc, input_precision=\"tf32\")\n        ap += BK * sak; bp += BK * sbk\n    cp = c_ptr + om[:, None]*scm + on[None, :]*scn\n    tl.store(cp, acc)\n\nout = torch.empty(M, N, device=dev)\ndef run1x(BM, BN, BK, GM, nw, ns):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        mm1x_kernel[grid](x, w, out, M, N, K,\n                          x.stride(0), x.stride(1), w.stride(0), w.stride(1),\n                          out.stride(0), out.stride(1),\n                          BM, BN, BK, GM, num_warps=nw, num_stages=ns)\n    try:\n        f()\n    except Exception as ex:\n        print(f'1x BM={BM} BN={BN} BK={BK} nw={nw} ns={ns}: FAILED')\n        return\n    print(f'1x BM={BM} BN={BN} BK={BK} GM={GM} nw={nw} ns={ns}: {timeit(f):.3f} ms')\n\nfor cfg in [(128,128,64,8,8,3),(128,256,64,8,8,3),(128,128,32,8,8,4),(64,128,64,8,4,4),(128,64,6"]
[371.436041, "i", "4,8,4,4)]:\n    run1x(*cfg)\nEOF\n"]
