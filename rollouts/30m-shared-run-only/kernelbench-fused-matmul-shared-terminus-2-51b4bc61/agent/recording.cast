[250.404111, "o", "request ID: 3c351eef36a242c1ad8536698def6dc7\r\nbox: sb-RpviilVdlzOkl7SNQEWm3M\r\ncommand: 395e459f5f41441aa706188fc7b17966\r\ncublas fp32 addmm        10.706 ms\r\nfused cublas err (4.76837158203125e-07, 0.0011920768301934004)\r\nfused cublas fp32        10.705 ms\r\ntriton prec=1 BM=128 BN=128 BK=64 nw=8 ns=3: 13.444 ms err=(1.4781951904296875e-05, 0.0785222128033638)\r\nTraceback (most recent call last):\r\n  File \"/workspace/bench.py\", line 84, in <module>\r\n    run_triton(prec, BM, BN, BK, 8, nw, ns)\r\n  File \"/workspace/bench.py\", line 77, in run_triton\r\n    f()\r\n  File \"/workspace/bench.py\", line 73, in f\r\n    mm_kernel[grid](x, w, b, out, M, N, K,\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 419, in <lambda>\r\n    return lambda *args, **kwargs: self.run(grid=grid, warmup=False, *args, **kwargs)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 756, in run\r\n    launch_metadata = kernel.launch_metadata(grid, stream, *bound_args.values())\r\n  File \"/usr/local/lib/"]
