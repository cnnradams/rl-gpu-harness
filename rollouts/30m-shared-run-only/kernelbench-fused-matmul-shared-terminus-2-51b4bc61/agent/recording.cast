[559.993126, "o", "        self._refresh()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.993176, "o", "        prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[559.993211, "o", "\u001b[?2004h> "]
