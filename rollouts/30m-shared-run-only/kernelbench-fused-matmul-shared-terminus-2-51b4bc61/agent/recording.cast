[663.181113, "o", "    t3 = torch.mm(x_hi_b, w_lo_b)         # bf16\r\n\u001b[?2004l\r"]
[663.181139, "o", "\u001b[?2004h> "]
[663.181164, "o", "    return t1, t2, t3\r\n\u001b[?2004l\r\u001b[?2004h"]
[663.181193, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.181223, "o", "t1, t2, t3 = variant_a(x)\r\n\u001b[?2004l\r"]
[663.181251, "o", "\u001b[?2004h> "]
[663.18129, "o", "res = (t1 + t2.float() + t3.float() + b) * scale\r\n\u001b[?2004l\r"]
[663.181318, "o", "\u001b[?2004h> "]
[663.181359, "o", "print('variant_a err_ratio %.4f' % err(res)[1])\r\n\u001b[?2004l\r"]
[663.181385, "o", "\u001b[?2004h> "]
[663.181447, "o", "print('variant_a (no epi) %.3f ms' % timeit(lambda: variant_a(x)))\r\n\u001b[?2004l\r"]
[663.181476, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.181555, "o", "# also check error without x_lo term (is veltkamp+2gemm enough?)\r\n\u001b[?2004l\r"]
[663.181585, "o", "\u001b[?2004h> "]
[663.181618, "o", "res2 = (t1 + t3.float() + b) * scale\r\n\u001b[?2004l\r"]
[663.181647, "o", "\u001b[?2004h> "]
[663.181684, "o", "print('a_nolo err_ratio %.4f' % err(res2)[1])\r\n\u001b[?2004l\r"]
[663.181712, "o", "\u001b[?2004h> "]
[663.181741, "o", "res3 = (t1 + t2.float() + b) * scale\r\n\u001b[?2004l\r"]
[663.18177, "o", "\u001b[?2004h> "]
[663.181808, "o", "print('a_nohi err_ratio %.4f' % err(res3)[1])\r\n\u001b[?2004l\r"]
[663.181837, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[663.181862, "o", "> # timing components\r\n\u001b[?2004l\r"]
[663.181892, "o", "\u001b[?2004h> "]
[663.181928, "o", "prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[663.181957, "o", "\u001b[?2004h> "]
[663.181994, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[663.182022, "o", "\u001b[?2004h> "]
[663.182088, "o", "print('tf32 mm NN      %.3f ms' % timeit(lambda: torch.mm(x, w_hi_f)))\r\n\u001b[?2004l\r"]
[663.182109, "o", "\u001b[?2004h> "]
[663.182185, "o", "wT_hi = w_hi_f.t().contiguous().t()  # (K,N) with stride (1,K) = N-major...\r\n\u001b[?2004l\r"]
[663.182214, "o", "\u001b[?2004h> "]
[663.182255, "o", "wtN = w_hi_f.t().contiguous()  # (N,K) row major\r\n\u001b[?2004l\r"]
[663.182284, "o", "\u001b[?2004h> "]
[663.182348, "o", "print('tf32 mm TN      %.3f ms' % timeit(lambda: torch.mm(x, wtN.t())))\r\n\u001b[?2004l\r"]
[663.18237, "o", "\u001b[?2004h> "]
[663.182415, "o", "torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[663.182444, "o", "\u001b[?2004h> "]
[663.182511, "o", "print('bf16 mm         %.3f ms' % timeit(lambda: torch.mm(x_hi_b, w_hi_b)))\r\n\u001b[?2004l\r"]
[663.182541, "o", "\u001b[?2004h> "]
[663.182704, "o", "print('split           %.3f ms' % timeit(lambda: split_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_hi_b, x_lo_b, x.numel(), 8193.0, BLOCK=4096, num_warps=8)))\r\n\u001b[?2004l\r"]
[663.182735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[663.182763, "o", "\u001b[?2004h> "]
[663.1828, "o", "# tuned opt_3x: mask split fused, addmm accumulate\r\n\u001b[?2004l\r"]
[663.182825, "o", "\u001b[?2004h> "]
[663.182858, "o", "x_hi = torch.empty(M, K, device=dev)\r\n\u001b[?2004l\r"]
[663.182888, "o", "\u001b[?2004h> "]
[663.182918, "o", "x_lo = torch.empty(M, K, device=dev)\r\n\u001b[?2004l\r"]
[663.182947, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[663.182971, "o", "> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[663.182997, "o", "> "]
[663.183058, "o", "def split_f32_kernel(x_ptr, hi_ptr, lo_ptr, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[663.183082, "o", "\u001b[?2004h> "]
[663.183107, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[663.183124, "o", "\u001b[?2004h> "]
[663.183171, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[663.1832, "o", "\u001b[?2004h> "]
[663.18323, "o", "    mask = offs < numel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.183276, "o", "    v = tl.load(x_ptr + offs, mask=mask)\r\n\u001b[?2004l\r"]
[663.183306, "o", "\u001b[?2004h> "]
[663.183376, "o", "    hi = (v.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\r\n\u001b[?2004l\r"]
[663.1834, "o", "\u001b[?2004h> "]
[663.18344, "o", "    tl.store(hi_ptr + offs, hi, mask=mask)\r\n\u001b[?2004l\r"]
[663.183463, "o", "\u001b[?2004h> "]
[663.183507, "o", "    tl.store(lo_ptr + offs, v - hi, mask=mask)\r\n\u001b[?2004l\r"]
[663.183532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.18362, "o", "w_hi = (wt.view(torch.int32) & MASK).view(torch.float32).contiguous()\r\n\u001b[?2004l\r"]
[663.183643, "o", "\u001b[?2004h> "]
[663.183672, "o", "w_lo = (wt - w_hi).contiguous()\r\n\u001b[?2004l\r"]
[663.183701, "o", "\u001b[?2004h> "]
[663.183728, "o", "t1b = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r"]
[663.183758, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[663.183787, "o", "> def opt_3x_tuned(x):\r\n\u001b[?2004l\r"]
[663.183817, "o", "\u001b[?2004h> "]
[663.183854, "o", "    prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[663.183878, "o", "\u001b[?2004h> "]
[663.183923, "o", "    torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[663.183953, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[663.183978, "o", "\u001b[?2004h> "]
[663.184084, "o", "        split_f32_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_hi, x_lo, x.numel(), BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[663.184106, "o", "\u001b[?2004h> "]
[663.18414, "o", "        torch.mm(x_hi, w_hi, out=t1b)\r\n\u001b[?2004l\r"]
[663.184165, "o", "\u001b[?2004h> "]
[663.184216, "o", "        torch.addmm(t1b, x_lo, w_hi, beta=1, out=t1b)\r\n\u001b[?2004l\r"]
[663.184246, "o", "\u001b[?2004h> "]
[663.184292, "o", "        torch.addmm(t1b, x_hi, w_lo, beta=1, out=t1b)\r\n\u001b[?2004l\r"]
[663.184321, "o", "\u001b[?2004h> "]
[663.184348, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.184398, "o", "        torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[663.184423, "o", "\u001b[?2004h> "]
[663.184444, "o", "    return t1b\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[663.184474, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[663.184502, "o", "ob = opt_3x_tuned(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[663.184527, "o", "> resb = (ob + b) * scale\r\n\u001b[?2004l\r"]
[663.184558, "o", "\u001b[?2004h> "]
[663.18462, "o", "print('opt_3x_tuned err_ratio %.4f' % err(resb)[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[663.184653, "o", "> "]
[663.184713, "o", "print('opt_3x_tuned (no epi) %.3f ms' % timeit(lambda: opt_3x_tuned(x)))\r\n\u001b[?2004l\r"]
[663.184741, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[663.186391, "o", "\u001b[?2004hroot@modal:/# "]
