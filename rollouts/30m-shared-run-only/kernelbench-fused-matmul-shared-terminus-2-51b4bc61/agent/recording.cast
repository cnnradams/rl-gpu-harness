[1264.932409, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1264.932453, "o", "\u001b[?2004h> "]
[1264.932505, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.932549, "o", "        self._key = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.932592, "o", "        self._w_hi_t = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.932692, "o", "        self._w_lo_t = None\r\n\u001b[?2004l\r\u001b[?2004h>         self._bias_s = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.932745, "o", ">         self._bufs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.932767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.932811, "o", "    def _refresh(self):\r\n\u001b[?2004l\r"]
[1264.932837, "o", "\u001b[?2004h> "]
[1264.932867, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.932894, "o", "> "]
[1264.932921, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.933019, "o", "        key = (w.data_ptr(), b.data_ptr(), w.device, w.dtype, w.shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.933044, "o", "> "]
[1264.933069, "o", "        if self._key != key:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.933094, "o", "> "]
[1264.933157, "o", "            wt = w.detach().t().contiguous()  # (in, out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.933215, "o", "            w_hi, w_lo = _veltkamp(wt)\r\n\u001b[?2004l\r"]
[1264.933241, "o", "\u001b[?2004h> "]
[1264.933287, "o", "            s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.93337, "o", "            self._w_hi_t = w_hi.t().contiguous()  # (out, in)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.933396, "o", "> "]
[1264.933438, "o", "            self._w_lo_t = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[1264.933462, "o", "\u001b[?2004h> "]
[1264.933529, "o", "            self._bias_s = (b.detach() * s).contiguous()\r\n\u001b[?2004l\r"]
[1264.933561, "o", "\u001b[?2004h> "]
[1264.933587, "o", "            self._bufs = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.933628, "o", "            self._key = key\r\n\u001b[?2004l\r"]
[1264.933656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.933714, "o", "    def _get_bufs(self, M, K, N, device):\r\n\u001b[?2004l\r"]
[1264.933741, "o", "\u001b[?2004h> "]
[1264.933769, "o", "        key = (M, K, N, device)\r\n\u001b[?2004l\r"]
[1264.933797, "o", "\u001b[?2004h> "]
[1264.933836, "o", "        if key not in self._bufs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.933865, "o", "> "]
[1264.933899, "o", "            self._bufs[key] = (\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.93393, "o", "> "]
[1264.933988, "o", "                torch.empty(M, K, device=device, dtype=torch.float32),\r\n\u001b[?2004l\r"]
[1264.934017, "o", "\u001b[?2004h> "]
[1264.934089, "o", "                torch.empty(M, K, device=device, dtype=torch.float32),\r\n\u001b[?2004l\r"]
[1264.934118, "o", "\u001b[?2004h> "]
[1264.934189, "o", "                torch.empty(M, N, device=device, dtype=torch.float32),\r\n\u001b[?2004l\r"]
[1264.934223, "o", "\u001b[?2004h> "]
[1264.934251, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.934279, "o", "        return self._bufs[key]\r\n\u001b[?2004l\r"]
[1264.934307, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1264.934397, "o", "\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.934462, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.934501, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.934546, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.934578, "o", "> "]
[1264.934645, "o", "        if (not _HAS_TRITON or not x.is_cuda or x.dtype != torch.float32\r\n\u001b[?2004l\r"]
[1264.934672, "o", "\u001b[?2004h> "]
[1264.934729, "o", "                or not x.is_contiguous() or x.dim() != 2):\r\n\u001b[?2004l\r"]
[1264.934759, "o", "\u001b[?2004h> "]
[1264.934806, "o", "            y = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[1264.934833, "o", "\u001b[?2004h> "]
[1264.934882, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.934908, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.934953, "o", "        self._refresh()\r\n\u001b[?2004l\r"]
[1264.934977, "o", "\u001b[?2004h> "]
[1264.935005, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[1264.935032, "o", "> "]
[1264.935058, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.93513, "o", "        x_hi, x_lo, t = self._get_bufs(M, K, N, x.device)\r\n\u001b[?2004l\r"]
[1264.935156, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1264.935183, "o", "\u001b[?2004h> "]
[1264.935236, "o", "        prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[1264.935267, "o", "\u001b[?2004h> "]
[1264.935316, "o", "        torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[1264.935343, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[1264.935368, "o", "\u001b[?2004h> "]
[1264.935427, "o", "            _split_f32[(triton.cdiv(M * K, 4096),)](\r\n\u001b[?2004l\r"]
[1264.935452, "o", "\u001b[?2004h> "]
[1264.935526, "o", "                x, x_hi, x_lo, M * K, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[1264.935554, "o", "\u001b[?2004h> "]
[1264.935635, "o", "            torch.addmm(self._bias_s, x, self._w_hi_t.t(), beta=1, alpha=s, out=t)\r\n\u001b[?2004l\r"]
[1264.935665, "o", "\u001b[?2004h> "]
[1264.935736, "o", "            torch.addmm(t, x_lo, self._w_hi_t.t(), beta=1, alpha=s, out=t)\r\n\u001b[?2004l\r"]
[1264.935766, "o", "\u001b[?2004h> "]
[1264.935838, "o", "            torch.addmm(t, x_hi, self._w_lo_t.t(), beta=1, alpha=s, out=t)\r\n\u001b[?2004l\r"]
[1264.935864, "o", "\u001b[?2004h> "]
[1264.935889, "o", "        finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.935958, "o", "            torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[1264.935988, "o", "\u001b[?2004h> "]
[1264.936018, "o", "        return t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1264.936047, "o", "EOF\r\n\u001b[?2004l\r"]
