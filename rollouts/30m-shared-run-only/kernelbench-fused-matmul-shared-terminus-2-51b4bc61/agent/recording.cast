[1464.407078, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\nMASK = -8192\n\ntarget = torch.addmm(b, x, w) * scale\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# 1) fp16 mm accumulation test\nah = torch.randn(1024, 4096, device=dev).half()\nbh = torch.randn(4096, 1024, device=dev).half()\nr16 = torch.mm(ah, bh)\nr64 = torch.mm(ah.double(), bh.double())\nprint('fp16 mm rel err vs fp64:', ((r16.double()-r64).abs()/(r64.abs()+1e-6)).max().item())\n\n# 2)"]
[1464.407131, "i", " full fp16-correction pipeline, correct pairing\n@triton.jit\ndef split_hi_lo_f16(x_ptr, hi_ptr, lo_ptr, numel, SLO, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(x_ptr + offs, mask=mask)\n    hi = (v.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\n    lo = (v - hi) * SLO\n    tl.store(hi_ptr + offs, hi.to(tl.float16), mask=mask)\n    tl.store(lo_ptr + offs, lo.to(tl.float16), mask=mask)\n\nw_hi = (w.view(torch.int32) & MASK).view(torch.float32)\nw_lo = w - w_hi\nS = 4096.0\nw_hi_h = w_hi.half()\nw_lo_h = (w_lo * S).half()\n# correction GEMM: [x_hi | x_lo_s] @ [w_lo_s? ...] pairing: x_hi@w_lo + x_lo@w_hi\n# cat A = [x_hi | x_lo*S], cat B = [w_lo*S ; w_hi] -> product = x_hi@w_lo*S + x_lo*S@w_hi = S*(x_hi@w_lo + x_lo@w_hi)\nwcat = torch.cat([w_lo_h, w_hi_h], 0).contiguous()  # (2K, N)\nxcat = torch.empty(M, 2*K, device=dev, dtype=torch.float16)\n\ndef pipe(x):\n    split_hi_lo_f16[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, :"]
[1464.407147, "i", "K], xcat[:, K:], x.numel(), S, BLOCK=4096, num_warps=8)\n    prev = torch.backends.cuda.matmul.allow_tf32\n    torch.backends.cuda.matmul.allow_tf32 = True\n    try:\n        t1 = torch.mm(x, w_hi)\n    finally:\n        torch.backends.cuda.matmul.allow_tf32 = prev\n    t2 = torch.mm(xcat, wcat)\n    return t1, t2\n\nt1, t2 = pipe(x)\nres = (t1 + t2 / S + b) * scale\nprint('fp16corr2 err_ratio %.4f' % err(res)[1])\nprint('fp16corr2 time %.3f ms' % timeit(lambda: pipe(x)))\n\n# what does correction alone contribute? check err without correction:\nres_nc = (t1 + b) * scale\nprint('main-only err_ratio %.4f' % err(res_nc)[1])\nEOF\ngpu run -- python3 /workspace/bench7.py > /tmp/bench7.log 2>&1 &\n"]
[1464.407456, "o", "cat > /workspace/bench7.py << 'EOF'\r\n\u001b[?2004l\r"]
[1464.407502, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[1464.407541, "o", "\u001b[?2004h> "]
[1464.407571, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.407596, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[1464.407624, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1464.407655, "o", "\u001b[?2004h> torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[1464.407686, "o", "\u001b[?2004h> "]
[1464.40771, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[1464.40773, "o", "\u001b[?2004h> "]
[1464.407756, "o", "dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.407782, "o", "> "]
[1464.407809, "o", "x = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r"]
[1464.407836, "o", "\u001b[?2004h> "]
[1464.407895, "o", "w = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\r\n\u001b[?2004l\r"]
[1464.407921, "o", "\u001b[?2004h> "]
[1464.407955, "o", "b = torch.randn(N, device=dev) * 0.05\r\n\u001b[?2004l\r"]
[1464.40798, "o", "\u001b[?2004h> scale = 1.5\r\n\u001b[?2004l\r"]
[1464.408001, "o", "\u001b[?2004h> "]
[1464.408022, "o", "MASK = -8192\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.408049, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.408099, "o", "target = torch.addmm(b, x, w) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.40813, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.408157, "o", "def err(o):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.408183, "o", "> "]
[1464.408208, "o", "    d = (o - target).abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.408239, "o", "> "]
[1464.408265, "o", "    tol = 1e-4 + 1e-4 * target.abs()\r\n\u001b[?2004l\r"]
[1464.40829, "o", "\u001b[?2004h> "]
[1464.408359, "o", "    return d.max().item(), (d / tol).max().item()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1464.408386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1464.40841, "o", "def timeit(fn, iters=30):"]
[1464.408441, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.408476, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[1464.408508, "o", "\u001b[?2004h> "]
[1464.40855, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.408628, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.408656, "o", ">     s.record()\r\n\u001b[?2004l\r"]
[1464.408683, "o", "\u001b[?2004h> "]
[1464.408714, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r"]
[1464.408743, "o", "\u001b[?2004h> "]
[1464.408779, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1464.408808, "o", "\u001b[?2004h> "]
[1464.408843, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r"]
[1464.408872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1464.408901, "o", "\u001b[?2004h> "]
[1464.408926, "o", "# 1) fp16 mm accumulation test\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.408989, "o", "ah = torch.randn(1024, 4096, device=dev).half()\r\n\u001b[?2004l\r"]
[1464.409019, "o", "\u001b[?2004h> "]
[1464.40906, "o", "bh = torch.randn(4096, 1024, device=dev).half()\r\n\u001b[?2004l\r"]
[1464.40909, "o", "\u001b[?2004h> "]
[1464.409119, "o", "r16 = torch.mm(ah, bh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.409148, "o", "> "]
[1464.409177, "o", "r64 = torch.mm(ah.double(), bh.double())\r\n\u001b[?2004l\r"]
[1464.409203, "o", "\u001b[?2004h> "]
[1464.409306, "o", "print('fp16 mm rel err vs fp64:', ((r16.double()-r64).abs()/(r64.abs()+1e-6)).max().item())\r\n\u001b[?2004l\r"]
[1464.409321, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1464.409355, "o", "\u001b[?2004h> "]
[1464.409402, "o", "# 2) full fp16-correction pipeline, correct pairing\r\n\u001b[?2004l\r"]
[1464.409436, "o", "\u001b[?2004h> "]
[1464.409461, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.409549, "o", "def split_hi_lo_f16(x_ptr, hi_ptr, lo_ptr, numel, SLO, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1464.40958, "o", "\u001b[?2004h> "]
[1464.409604, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.40963, "o", "> "]
[1464.409672, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1464.409702, "o", "\u001b[?2004h> "]
[1464.409727, "o", "    mask = offs < numel\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.409756, "o", "> "]
[1464.409788, "o", "    v = tl.load(x_ptr + offs, mask=mask)\r\n\u001b[?2004l\r"]
[1464.409815, "o", "\u001b[?2004h> "]
[1464.409897, "o", "    hi = (v.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.409928, "o", "> "]
[1464.409953, "o", "    lo = (v - hi) * SLO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.410025, "o", "    tl.store(hi_ptr + offs, hi.to(tl.float16), mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.410055, "o", "> "]
[1464.410104, "o", "    tl.store(lo_ptr + offs, lo.to(tl.float16), mask=mask)\r\n\u001b[?2004l\r"]
[1464.410131, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.410197, "o", "w_hi = (w.view(torch.int32) & MASK).view(torch.float32)\r\n\u001b[?2004l\r"]
[1464.410228, "o", "\u001b[?2004h> w_lo = w - w_hi\r\n\u001b[?2004l\r"]
[1464.410258, "o", "\u001b[?2004h> S = 4096.0\r\n"]
[1464.410279, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1464.410304, "o", "w_hi_h = w_hi.half()\r\n\u001b[?2004l\r"]
[1464.41033, "o", "\u001b[?2004h> "]
[1464.410356, "o", "w_lo_h = (w_lo * S).half()\r\n\u001b[?2004l\r"]
[1464.41038, "o", "\u001b[?2004h> "]
[1464.410473, "o", "# correction GEMM: [x_hi | x_lo_s] @ [w_lo_s? ...] pairing: x_hi@w_lo + x_lo@w_hi\r\n\u001b[?2004l\r"]
[1464.410501, "o", "\u001b[?2004h> "]
[1464.410629, "o", "# cat A = [x_hi | x_lo*S], cat B = [w_lo*S ; w_hi] -> product = x_hi@w_lo*S + x_lo*S@w_hi = S*(x_hi@w_lo + x_lo@w_hi)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.410707, "o", "wcat = torch.cat([w_lo_h, w_hi_h], 0).contiguous()  # (2K, N)\r\n\u001b[?2004l\r"]
[1464.410733, "o", "\u001b[?2004h> "]
[1464.41079, "o", "xcat = torch.empty(M, 2*K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1464.410809, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1464.410835, "o", "\u001b[?2004h> "]
[1464.410862, "o", "def pipe(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1464.410998, "o", "    split_hi_lo_f16[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, :K], xcat[:, K:], x.numel(), S, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[1464.411024, "o", "\u001b[?2004h> "]
[1464.411069, "o", "    prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[1464.411094, "o", "\u001b[?2004h> "]
[1464.411145, "o", "    torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[1464.411176, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1464.411202, "o", "\u001b[?2004h> "]
[1464.411233, "o", "        t1 = torch.mm(x, w_hi)\r\n\u001b[?2004l\r"]
[1464.411262, "o", "\u001b[?2004h>     finally:\r\n\u001b[?2004l\r"]
[1464.411291, "o", "\u001b[?2004h> "]
[1464.411345, "o", "        torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.411375, "o", "> "]
[1464.411407, "o", "    t2 = torch.mm(xcat, wcat)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.411442, "o", ">     return t1, t2\r\n\u001b[?2004l\r"]
[1464.411481, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1464.411504, "o", "\u001b[?2004h> "]
[1464.411534, "o", "t1, t2 = pipe(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.411564, "o", "> "]
[1464.411593, "o", "res = (t1 + t2 / S + b) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.411621, "o", "> "]
[1464.411653, "o", "print('fp16corr2 err_ratio %.4f' % err(res)[1])\r\n\u001b[?2004l\r"]
[1464.411681, "o", "\u001b[?2004h> "]
[1464.411738, "o", "print('fp16corr2 time %.3f ms' % timeit(lambda: pipe(x)))\r\n\u001b[?2004l\r"]
[1464.411768, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1464.411792, "o", "> "]
[1464.41185, "o", "# what does correction alone contribute? check err without correction:\r\n\u001b[?2004l\r"]
[1464.411875, "o", "\u001b[?2004h> "]
[1464.411901, "o", "res_nc = (t1 + b) * scale\r\n\u001b[?2004l\r"]
[1464.411928, "o", "\u001b[?2004h> "]
[1464.41198, "o", "print('main-only err_ratio %.4f' % err(res_nc)[1])\r\n\u001b[?2004l\r"]
[1464.412009, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1464.414519, "o", "\u001b[?2004hroot@modal:/# "]
