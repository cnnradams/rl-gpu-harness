[576.406975, "i", "cat > /workspace/test_sol.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\ndev = 'cuda'\nin_f, out_f, sf = 4096, 4096, 0.5\nm = ModelNew(in_f, out_f, sf).to(dev)\n\n# reference: fp32 eager\nx = torch.rand(16384, in_f, device=dev)\nwith torch.no_grad():\n    y_ref = m.matmul(x)\n    y_ref = y_ref * sf + y_ref.clone()\n    y_new = m(x)\nd = (y_ref - y_new).abs()\ntol = 1e-4 + 1e-4 * y_ref.abs()\nprint('max abs diff', d.max().item(), 'err_ratio', (d/tol).max().item())\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\nwith torch.no_grad():\n    print('new: %.3f ms' % timeit(lambda: m(x)))\n    def ref():\n        y = m.matmul(x)\n        return y * sf + y\n    print('ref: %.3f ms' % timeit(ref))\nEOF\ngpu run -- python3 /workspace/test_sol.py > /tmp/tes"]
[576.407035, "i", "t_sol.log 2>&1 &\n"]
[576.407147, "o", "cat > /workspace/test_sol.py << 'EOF'\r\n\u001b[?2004l\r"]
[576.407223, "o", "\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407266, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[576.407299, "o", "\u001b[?2004h> "]
[576.40734, "o", "from solution import ModelNew\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[576.407373, "o", "> "]
[576.407414, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407448, "o", "dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407481, "o", "in_f, out_f, sf = 4096, 4096, 0.5\r\n\u001b[?2004l\r"]
[576.407515, "o", "\u001b[?2004h> "]
[576.407548, "o", "m = ModelNew(in_f, out_f, sf).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407587, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407622, "o", "# reference: fp32 eager\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407663, "o", "x = torch.rand(16384, in_f, device=dev)\r\n\u001b[?2004l\r"]
[576.407704, "o", "\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r"]
[576.407745, "o", "\u001b[?2004h> "]
[576.407762, "o", "    y_ref = m.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407809, "o", "    y_ref = y_ref * sf + y_ref.clone()\r\n\u001b[?2004l\r"]
[576.407824, "o", "\u001b[?2004h> "]
[576.407863, "o", "    y_new = m(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407905, "o", "d = (y_ref - y_new).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.407945, "o", "tol = 1e-4 + 1e-4 * y_ref.abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.407986, "o", "> "]
[576.408037, "o", "print('max abs diff', d.max().item(), 'err_ratio', (d/tol).max().item())\r\n\u001b[?2004l\r"]
[576.408077, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.408117, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.408161, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.408202, "o", ">     torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[576.408217, "o", "\u001b[?2004h> "]
[576.408298, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.408334, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.408378, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r"]
[576.408403, "o", "\u001b[?2004h> "]
[576.408458, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[576.408499, "o", "\u001b[?2004h> "]
[576.408536, "o", "    return s.elapsed_time(e)/iters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[576.408577, "o", "\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r"]
[576.40863, "o", "\u001b[?2004h> "]
[576.408669, "o", "    print('new: %.3f ms' % timeit(lambda: m(x)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.408711, "o", ">     def ref():\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.408746, "o", ">         y = m.matmul(x)\r\n\u001b[?2004l\r"]
[576.408786, "o", "\u001b[?2004h> "]
[576.408826, "o", "        return y * sf + y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.408864, "o", "    print('ref: %.3f ms' % timeit(ref))\r\n\u001b[?2004l\r\u001b[?2004h"]
[576.408883, "o", "> EOF\r\n\u001b[?2004l\r"]
