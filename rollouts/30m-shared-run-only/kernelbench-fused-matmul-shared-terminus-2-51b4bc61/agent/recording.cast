[663.179446, "o", "\u001b[?2004h> "]
[663.179478, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[663.179507, "o", "\u001b[?2004h> "]
[663.179535, "o", "    mask = offs < numel\r\n\u001b[?2004l\r\u001b[?2004h"]
[663.17957, "o", "> "]
[663.179596, "o", "    v = tl.load(x_ptr + offs, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[663.179625, "o", ">     t = v * C\r\n\u001b[?2004l\r"]
[663.179654, "o", "\u001b[?2004h> "]
[663.179683, "o", "    hi = t - (t - v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.179713, "o", "    lo = v - hi\r\n\u001b[?2004l\r"]
[663.179743, "o", "\u001b[?2004h> "]
[663.179785, "o", "    tl.store(hi_ptr + offs, hi.to(tl.bfloat16), mask=mask)\r\n\u001b[?2004l\r"]
[663.179815, "o", "\u001b[?2004h> "]
[663.179866, "o", "    tl.store(lo_ptr + offs, lo.to(tl.bfloat16), mask=mask)\r\n\u001b[?2004l\r"]
[663.179895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[663.17992, "o", "> # cached weight splits\r\n\u001b[?2004l\r"]
[663.179942, "o", "\u001b[?2004h> "]
[663.179973, "o", "wt = w.contiguous()\r\n\u001b[?2004l\r"]
[663.180003, "o", "\u001b[?2004h> t = wt * 8193.0\r\n\u001b[?2004l\r"]
[663.180026, "o", "\u001b[?2004h> "]
