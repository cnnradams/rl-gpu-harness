[734.714883, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[734.714921, "o", "\u001b[?2004h> "]
[734.714976, "o", "# Veltkamp split fp32 -> hi,lo fp16 scaled (per-call x, cached w)\r\n\u001b[?2004l\r"]
[734.715019, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.71506, "o", "> "]
[734.715104, "o", "def split_h_kernel(x_ptr, hi_ptr, numel, C, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[734.715144, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[734.715185, "o", "\u001b[?2004h> "]
[734.715226, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.715269, "o", "    mask = offs < numel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.715333, "o", "    v = tl.load(x_ptr + offs, mask=mask)\r\n\u001b[?2004l\r"]
[734.715375, "o", "\u001b[?2004h>     t = v * C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.715406, "o", "    hi = t - (t - v)\r\n\u001b[?2004l\r"]
[734.715448, "o", "\u001b[?2004h> "]
[734.715487, "o", "    tl.store(hi_ptr + offs, hi.to(tl.float16), mask=mask)\r\n\u001b[?2004l\r"]
[734.715527, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.715566, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.715629, "o", "def split_l_kernel(x_ptr, lo_ptr, numel, C, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[734.71567, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[734.715709, "o", "\u001b[?2004h> "]
[734.71575, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[734.71579, "o", "\u001b[?2004h>     mask = offs < numel\r\n\u001b[?2004l\r"]
[734.71583, "o", "\u001b[?2004h> "]
[734.715874, "o", "    v = tl.load(x_ptr + offs, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.715923, "o", "    t = v * C\r\n\u001b[?2004l\r\u001b[?2004h>     hi = t - (t - v)\r\n\u001b[?2004l\r"]
[734.715966, "o", "\u001b[?2004h> "]
[734.716007, "o", "    lo = (v - hi) * S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716049, "o", "    tl.store(lo_ptr + offs, lo.to(tl.float16), mask=mask)\r\n\u001b[?2004l\r"]
[734.716091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.71617, "o", "# cached w splits: fp16 for corrections, fp32 for main tf32 term\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716211, "o", "tw = w * 8193.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716262, "o", "w_hi_f = tw - (tw - w)          # ~11 bits\r\n\u001b[?2004l\r"]
[734.716301, "o", "\u001b[?2004h> w_lo_f = w - w_hi_f\r\n\u001b[?2004l\r"]
[734.716348, "o", "\u001b[?2004h> "]
[734.716389, "o", "w_hi_h = w_hi_f.half().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.71643, "o", "s_w = 4096.0  # 2^12, exact\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716471, "o", "w_lo_h = (w_lo_f * s_w).half().contiguous()\r\n\u001b[?2004l\r"]
[734.716519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716579, "o", "x_hi_h = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.716626, "o", "> "]
[734.716665, "o", "x_lo_h = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.716706, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716798, "o", "# scales for x: x in [0,1): hi part max ~1 fits fp16 fine. lo: |x_lo|<=2^-12 -> scale 2^12\r\n\u001b[?2004l\r"]
[734.71684, "o", "\u001b[?2004h> s_x = 4096.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.716882, "o", "inv_s = 1.0 / (s_x * s_w)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[734.716924, "o", "\u001b[?2004h> "]
[734.716968, "o", "def variant_fp16corr(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717009, "o", "    prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[734.717051, "o", "\u001b[?2004h> "]
[734.717091, "o", "    torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717135, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717177, "o", "        t1 = torch.mm(x, w_hi_f)   # tf32 main\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.717218, "o", ">     finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717285, "o", "        torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[734.71733, "o", "\u001b[?2004h> "]
[734.717422, "o", "    split_h_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_hi_h, x.numel(), 8193.0, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[734.717464, "o", "\u001b[?2004h> "]
[734.717556, "o", "    split_l_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_lo_h, x.numel(), 8193.0, s_x, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[734.717597, "o", "\u001b[?2004h> "]
[734.717638, "o", "    t2 = torch.mm(x_lo_h, w_hi_h)   # fp16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717691, "o", "    t3 = torch.mm(x_hi_h, w_lo_h)   # fp16\r\n\u001b[?2004l\r"]
[734.717733, "o", "\u001b[?2004h>     return t1 + (t2 + t3) * inv_s\r\n\u001b[?2004l\r"]
[734.717771, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717814, "o", "t1 = variant_fp16corr(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.717855, "o", "res = (t1 + b) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.717896, "o", "> "]
[734.717934, "o", "print('fp16corr err_ratio %.4f' % err(res)[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.717975, "o", "> "]
[734.718016, "o", "print('fp16corr          %.3f ms' % timeit(lambda: variant_fp16corr(x)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.718058, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.718099, "o", "# variant: concat corrections into one 2K fp16 GEMM\r\n\u001b[?2004l\r"]
[734.71814, "o", "\u001b[?2004h> "]
[734.718181, "o", "xcat = torch.empty(M, 2*K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[734.718223, "o", "\u001b[?2004h> "]
[734.718263, "o", "wcat = torch.cat([w_hi_h, w_lo_h], 0).contiguous()  # (2K, N)\r\n\u001b[?2004l\r"]
[734.718304, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.718328, "o", "def variant_cat(x):\r\n\u001b[?2004l\r"]
[734.718369, "o", "\u001b[?2004h> "]
[734.718409, "o", "    prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.71847, "o", "    torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[734.718488, "o", "\u001b[?2004h> "]
[734.718529, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.718571, "o", "        t1 = torch.mm(x, w_hi_f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.718614, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.718655, "o", "        torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[734.718696, "o", "\u001b[?2004h> "]
[734.718793, "o", "    split_h_kernel[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, :K], x.numel(), 8193.0, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[734.718835, "o", "\u001b[?2004h> "]
[734.718934, "o", "    split_l_kernel[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, K:], x.numel(), 8193.0, s_x, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[734.718976, "o", "\u001b[?2004h> "]
[734.719047, "o", "    # t2 = x_lo@w_hi + x_hi@w_lo needs careful order in cat: [x_lo | x_hi] @ [w_hi ; w_lo]\r\n\u001b[?2004l\r"]
[734.719087, "o", "\u001b[?2004h>     return t1, xcat\r\n\u001b[?2004l\r"]
[734.71913, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.71917, "o", "t1c, xc = variant_cat(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.719211, "o", "tc = torch.mm(xc, wcat) * inv_s\r\n\u001b[?2004l\r"]
[734.719251, "o", "\u001b[?2004h> "]
[734.719291, "o", "res_c = (t1c + tc + b) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.719338, "o", "print('cat err_ratio %.4f' % err(res_c)[1])\r\n\u001b[?2004l\r"]
[734.719378, "o", "\u001b[?2004h> def full_cat(x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.719419, "o", ">     t1c, xc = variant_cat(x)\r\n\u001b[?2004l\r"]
[734.719458, "o", "\u001b[?2004h> "]
[734.719499, "o", "    tc = torch.mm(xc, wcat)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.719531, "o", "    return t1c + tc * inv_s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.719615, "o", "print('cat               %.3f ms' % timeit(lambda: full_cat(x)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.719662, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.719705, "o", "# epilogue timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.71975, "o", "out = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[734.71979, "o", "\u001b[?2004h> "]
[734.719878, "o", "def epi_kernel(t1_ptr, t2_ptr, b_ptr, o_ptr, numel, N, INV_S, SCALE, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[734.719919, "o", ">     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[734.719959, "o", "\u001b[?2004h> "]
[734.720001, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.720044, "o", "    mask = offs < numel\r\n\u001b[?2004l\r"]
[734.720083, "o", "\u001b[?2004h> "]
[734.720123, "o", "    a = tl.load(t1_ptr + offs, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.720166, "o", "    c = tl.load(t2_ptr + offs, mask=mask)\r\n\u001b[?2004l\r"]
[734.720206, "o", "\u001b[?2004h> "]
[734.720248, "o", "    bb = tl.load(b_ptr + offs % N, mask=mask)\r\n\u001b[?2004l\r"]
[734.720288, "o", "\u001b[?2004h> "]
[734.720344, "o", "    tl.store(o_ptr + offs, (a + c * INV_S + bb) * SCALE, mask=mask)\r\n\u001b[?2004l\r"]
[734.720363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[734.720405, "o", "> tc32 = torch.mm(xc, wcat)\r\n\u001b[?2004l\r"]
[734.720446, "o", "\u001b[?2004h> "]
[734.720608, "o", "print('epilogue          %.3f ms' % timeit(lambda: epi_kernel[(triton.cdiv(M*N, 4096),)](t1c, tc32, b, out, M*N, N, inv_s, scale, BLOCK=4096, num_warps=8)))\r\n\u001b[?2004l\r"]
[734.720629, "o", "\u001b[?2004h> "]
[734.720707, "o", "print('mm fp16 2K        %.3f ms' % timeit(lambda: torch.mm(xc, wcat)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.720749, "o", "EOF\r\n\u001b[?2004l\r"]
[734.722435, "o", "\u001b[?2004hroot@modal:/# "]
[734.722512, "o", "gpu run -- python3 /workspace/bench5.py > /tmp/bench5.log 2>&1 &\r\n\u001b[?2004l\r"]
[734.722718, "o", "[1] 1360\r\n"]
[734.7228, "o", "\u001b[?2004hroot@modal:/# "]
[795.290459, "i", "cat /tmp/bench5.log\n"]
[795.290633, "o", "cat /tmp/bench5.log\r\n\u001b[?2004l\r"]
[795.29159, "o", "request ID: be41f58e2a8a4e5199aceb7642e5436e\r\nbox: sb-7tqavf90EWbbrg1GQwbUF6\r\ncommand: 9bdb5100b176424b827af55417e9f897\r\n/usr/local/lib/python3.10/dist-packages/torch/backends/cuda/__init__.py:131: UserWarning: Please use the new API settings to control TF32 behavior, such as torch.backends.cudnn.conv.fp32_precision = 'tf32' or torch.backends.cuda.matmul.fp32_precision = 'ieee'. Old settings, e.g, torch.backends.cuda.matmul.allow_tf32 = True, torch.backends.cudnn.allow_tf32 = True, allowTF32CuDNN() and allowTF32CuBLAS() will be deprecated after Pytorch 2.9. Please see https://pytorch.org/docs/main/notes/cuda.html#tensorfloat-32-tf32-on-ampere-and-later-devices (Triggered internally at /pytorch/aten/src/ATen/Context.cpp:80.)\r\n  return torch._C._get_cublas_allow_tf32()\r\nfp16corr err_ratio 6.9226\r\nfp16corr          3.664 ms\r\ncat err_ratio nan\r\ncat               3.527 ms\r\nepilogue          0.227 ms\r\nmm fp16 2K        1.370 ms\r\n"]
[795.291685, "o", "[1]+  Done                    gpu run -- python3 /workspace/bench5.py > /tmp/bench5.log 2>&1\r\n"]
[795.291728, "o", "\u001b[?2004h"]
[795.291765, "o", "root@modal:/# "]
[805.563002, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\n\ntarget = torch.addmm(b, x, w) * scale\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# bf16 splits: c1 = bf16(w) (RN, 8 bits), c2 = bf16(w - c1) (next 8 bits)\nw1 = w.bfloat16()\nw2 = (w - w1.float()).bfloat16()\nw1 = w1.contiguous(); w2 = w2.contiguous()\nwcat = torch.cat([w1, w2], 0).contiguous()   # (2K, N) for [x2|x1] @ [w1;w2]? careful below\n\nx1 = torch.empty(M, K, device=dev, dtype"]
[805.563064, "i", "=torch.bfloat16)\nx2 = torch.empty(M, K, device=dev, dtype=torch.bfloat16)\nxcat = torch.empty(M, 2*K, device=dev, dtype=torch.bfloat16)\n\n@triton.jit\ndef split_bf16_kernel(x_ptr, h_ptr, l_ptr, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(x_ptr + offs, mask=mask)\n    hi = v.to(tl.bfloat16)\n    lo = (v - hi.to(tl.float32)).to(tl.bfloat16)\n    tl.store(h_ptr + offs, hi, mask=mask)\n    tl.store(l_ptr + offs, lo, mask=mask)\n\ndef split_x(x):\n    split_bf16_kernel[(triton.cdiv(x.numel(), 4096),)](x, x1, x2, x.numel(), BLOCK=4096, num_warps=8)\n\n# scheme A: 3 GEMMs: x1@w1 + (x1@w2 + x2@w1)\ndef scheme_a(x):\n    split_x(x)\n    t1 = torch.mm(x1, w1)\n    t2 = torch.mm(x1, w2)\n    t3 = torch.mm(x2, w1)\n    return t1, t2, t3\n\nt1, t2, t3 = scheme_a(x)\nres = (t1 + t2 + t3 + b) * scale\nprint('bf16x3 err_ratio %.4f' % err(res)[1])\nprint('bf16x3           %.3f ms' % timeit(lambda: scheme_a(x)))\n\n# scheme B: concat: t1 = x1@w1 ; t2 = [x1"]
[805.563225, "i", "|x2] @ [w2; w1]\ndef scheme_b(x):\n    split_bf16_kernel[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, :K], xcat[:, K:], x.numel(), BLOCK=4096, num_warps=8)\n    t1 = torch.mm(xcat[:, :K], w1)\n    t2 = torch.mm(xcat, wcat)\n    return t1, t2\n\nt1b, t2b = scheme_b(x)\nresb = (t1b + t2b + b) * scale\nprint('bf16x3cat err_ratio %.4f' % err(resb)[1])\nprint('bf16x3cat        %.3f ms' % timeit(lambda: scheme_b(x)))\n\n# also 4th term x2@w2 included? (adds robustness)\nwcat2 = torch.cat([w1, w2, w2], 0).contiguous()\nxcat3 = torch.empty(M, 3*K, device=dev, dtype=torch.bfloat16)\nEOF\ngpu run -- python3 /workspace/bench6.py > /tmp/bench6.log 2>&1 &\n"]
[805.563255, "o", "cat > /workspace/bench6.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.563283, "o", "import triton\r\n\u001b[?2004l\r"]
[805.563311, "o", "\u001b[?2004h> "]
[805.563334, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[805.563357, "o", "\u001b[?2004h> "]
[805.563378, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.5634, "o", "> "]
[805.563436, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.563462, "o", "dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.563485, "o", "> "]
[805.563534, "o", "x = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.563587, "o", "w = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.563617, "o", "> "]
[805.563654, "o", "b = torch.randn(N, device=dev) * 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.563681, "o", "scale = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[805.5637, "o", "\u001b[?2004h> "]
[805.563749, "o", "target = torch.addmm(b, x, w) * scale\r\n\u001b[?2004l\r"]
[805.563778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[805.563799, "o", "\u001b[?2004h> "]
[805.56383, "o", "def err(o):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.563859, "o", "    d = (o - target).abs()\r\n\u001b[?2004l\r"]
[805.56389, "o", "\u001b[?2004h> "]
[805.563915, "o", "    tol = 1e-4 + 1e-4 * target.abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.563942, "o", "> "]
[805.563987, "o", "    return d.max().item(), (d / tol).max().item()\r\n\u001b[?2004l\r"]
[805.564018, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.564056, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r"]
[805.564091, "o", "\u001b[?2004h> "]
[805.564117, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.564144, "o", "> "]
[805.564177, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.564202, "o", "> "]
[805.56425, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[805.564281, "o", "\u001b[?2004h> "]
[805.564311, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.564342, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.564368, "o", "> "]
[805.564398, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[805.564429, "o", "\u001b[?2004h> "]
[805.564458, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.564487, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[805.564513, "o", "> "]
[805.564574, "o", "# bf16 splits: c1 = bf16(w) (RN, 8 bits), c2 = bf16(w - c1) (next 8 bits)\r\n\u001b[?2004l\r"]
[805.564625, "o", "\u001b[?2004h> "]
[805.564659, "o", "w1 = w.bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.564693, "o", "w2 = (w - w1.float()).bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.564744, "o", "w1 = w1.contiguous(); w2 = w2.contiguous()\r\n\u001b[?2004l\r"]
[805.564773, "o", "\u001b[?2004h> "]
[805.564881, "o", "wcat = torch.cat([w1, w2], 0).contiguous()   # (2K, N) for [x2|x1] @ [w1;w2]? careful below\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.564911, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.564972, "o", "x1 = torch.empty(M, K, device=dev, dtype=torch.bfloat16)\r\n\u001b[?2004l\r"]
[805.564998, "o", "\u001b[?2004h> "]
[805.565053, "o", "x2 = torch.empty(M, K, device=dev, dtype=torch.bfloat16)\r\n\u001b[?2004l\r"]
[805.565089, "o", "\u001b[?2004h> "]
[805.565145, "o", "xcat = torch.empty(M, 2*K, device=dev, dtype=torch.bfloat16)\r\n\u001b[?2004l\r"]
[805.565171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.565202, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[805.565234, "o", "\u001b[?2004h> "]
[805.565295, "o", "def split_bf16_kernel(x_ptr, h_ptr, l_ptr, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[805.565326, "o", "\u001b[?2004h> "]
[805.565352, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.565383, "o", "> "]
[805.565413, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[805.565443, "o", "\u001b[?2004h> "]
[805.565472, "o", "    mask = offs < numel\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.565517, "o", "    v = tl.load(x_ptr + offs, mask=mask)\r\n\u001b[?2004l\r"]
[805.565542, "o", "\u001b[?2004h> "]
[805.565572, "o", "    hi = v.to(tl.bfloat16)\r\n\u001b[?2004l\r"]
[805.565601, "o", "\u001b[?2004h> "]
[805.565639, "o", "    lo = (v - hi.to(tl.float32)).to(tl.bfloat16)\r\n\u001b[?2004l\r"]
[805.565664, "o", "\u001b[?2004h> "]
[805.565702, "o", "    tl.store(h_ptr + offs, hi, mask=mask)\r\n\u001b[?2004l\r"]
[805.565728, "o", "\u001b[?2004h> "]
[805.56577, "o", "    tl.store(l_ptr + offs, lo, mask=mask)\r\n\u001b[?2004l\r"]
[805.565801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[805.565831, "o", "\u001b[?2004h> def split_x(x):\r\n\u001b[?2004l\r"]
[805.565861, "o", "\u001b[?2004h> "]
[805.565963, "o", "    split_bf16_kernel[(triton.cdiv(x.numel(), 4096),)](x, x1, x2, x.numel(), BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[805.565996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[805.566025, "o", "> "]
[805.566055, "o", "# scheme A: 3 GEMMs: x1@w1 + (x1@w2 + x2@w1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.566087, "o", "> "]
[805.566115, "o", "def scheme_a(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.566144, "o", "    split_x(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.566174, "o", "    t1 = torch.mm(x1, w1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.566205, "o", "> "]
[805.566231, "o", "    t2 = torch.mm(x1, w2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.566265, "o", "    t3 = torch.mm(x2, w1)\r\n\u001b[?2004l\r"]
[805.566295, "o", "\u001b[?2004h> "]
[805.566325, "o", "    return t1, t2, t3\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[805.566355, "o", "\u001b[?2004h> "]
[805.566384, "o", "t1, t2, t3 = scheme_a(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.566415, "o", "> "]
[805.566441, "o", "res = (t1 + t2 + t3 + b) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.5665, "o", "print('bf16x3 err_ratio %.4f' % err(res)[1])\r\n\u001b[?2004l\r"]
[805.56653, "o", "\u001b[?2004h> "]
[805.566592, "o", "print('bf16x3           %.3f ms' % timeit(lambda: scheme_a(x)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.566618, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.566691, "o", "# scheme B: concat: t1 = x1@w1 ; t2 = [x1|x2] @ [w2; w1]\r\n\u001b[?2004l\r"]
[805.566717, "o", "\u001b[?2004h> "]
[805.566743, "o", "def scheme_b(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.56688, "o", "    split_bf16_kernel[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, :K], xcat[:, K:], x.numel(), BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.56691, "o", "> "]
[805.566936, "o", "    t1 = torch.mm(xcat[:, :K], w1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.566963, "o", "> "]
[805.566993, "o", "    t2 = torch.mm(xcat, wcat)\r\n\u001b[?2004l\r\u001b[?2004h"]
[805.567024, "o", "> "]
[805.567054, "o", "    return t1, t2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[805.567085, "o", "> "]
[805.567115, "o", "t1b, t2b = scheme_b(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.567146, "o", "resb = (t1b + t2b + b) * scale\r\n\u001b[?2004l\r"]
[805.567176, "o", "\u001b[?2004h> "]
[805.567226, "o", "print('bf16x3cat err_ratio %.4f' % err(resb)[1])\r\n\u001b[?2004l\r"]
[805.56725, "o", "\u001b[?2004h> "]
[805.567313, "o", "print('bf16x3cat        %.3f ms' % timeit(lambda: scheme_b(x)))\r\n\u001b[?2004l\r"]
[805.567343, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[805.567398, "o", "# also 4th term x2@w2 included? (adds robustness)\r\n\u001b[?2004l\r"]
[805.567427, "o", "\u001b[?2004h> "]
[805.567476, "o", "wcat2 = torch.cat([w1, w2, w2], 0).contiguous()\r\n\u001b[?2004l\r"]
[805.567501, "o", "\u001b[?2004h> "]
[805.567555, "o", "xcat3 = torch.empty(M, 3*K, device=dev, dtype=torch.bfloat16)\r\n\u001b[?2004l\r"]
[805.567585, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[805.569232, "o", "\u001b[?2004hroot@modal:/# "]
[805.569323, "o", "gpu run -- python3 /workspace/bench6.py > /tmp/bench6.log 2>&1 &\r\n\u001b[?2004l\r"]
[805.569544, "o", "[1] 1369\r\n"]
[805.569616, "o", "\u001b[?2004h"]
[805.569643, "o", "root@modal:/# "]
[866.136904, "i", "cat /tmp/bench6.log\n"]
[866.13743, "o", "cat /tmp/bench6.log\r\n\u001b[?2004l\r"]
[866.138026, "o", "request ID: 3cef6c8fb34e49e6bc06d1da4a38fd8f\r\nbox: sb-VN19QQUU3aIwHsnjzLZcjI\r\ncommand: 0cde94bebbb44e7496045ddea3bf045c\r\nbf16x3 err_ratio 43.4433\r\nbf16x3           2.273 ms\r\nbf16x3cat err_ratio 31819.2754\r\nbf16x3cat        2.343 ms\r\n"]
[866.138138, "o", "[1]+  Done                    gpu run -- python3 /workspace/bench6.py > /tmp/bench6.log 2>&1\r\n"]
[866.13818, "o", "\u001b[?2004hroot@modal:/# "]
[892.581625, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n_MASK = -8192  # 0xFFFFE000: keep top mantissa bits (tf32-representable)\n\nif _HAS_TRITON:\n\n    @triton.jit\n    def _split_f32(x_ptr, hi_ptr, lo_ptr, numel, BLOCK: tl.constexpr):\n        pid = tl.program_id(0)\n        offs = pid * BLOCK + tl.arange(0, BLOCK)\n        mask = offs < numel\n        v = tl.load(x_ptr + offs, mask=mask)\n        hi = (v.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\n        tl.store(hi_ptr + offs, hi, mask=mask)\n        tl.store(lo_ptr + offs, v - hi, mask=mask)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._key = None\n        self._w_hi_t = None\n        self._w_lo_t = N"]
[892.581675, "i", "one\n        self._bias_s = None\n        self._bufs = {}\n\n    def _refresh(self):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        key = (w.data_ptr(), b.data_ptr(), w.device, w.dtype, w.shape)\n        if self._key != key:\n            wt = w.detach().t().contiguous()  # (in, out)\n            w_hi = (wt.view(torch.int32) & _MASK).view(torch.float32)\n            w_lo = wt - w_hi\n            s = 1.0 + self.scaling_factor\n            self._w_hi_t = w_hi.t().contiguous()  # (out, in)\n            self._w_lo_t = w_lo.t().contiguous()\n            self._bias_s = (b.detach() * s).contiguous()\n            self._bufs = {}\n            self._key = key\n\n    def _get_bufs(self, M, K, N, device):\n        key = (M, K, N, device)\n        if key not in self._bufs:\n            self._bufs[key] = (\n                torch.empty(M, K, device=device, dtype=torch.float32),\n                torch.empty(M, K, device=device, dtype=torch.float32),\n                torch.empty(M, N, device=device, dtype=torch.float32),\n      "]
[892.581686, "i", "      )\n        return self._bufs[key]\n\n    def forward(self, x):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        s = 1.0 + self.scaling_factor\n        if (not _HAS_TRITON or not x.is_cuda or x.dtype != torch.float32\n                or not x.is_contiguous() or x.dim() != 2):\n            y = torch.nn.functional.linear(x, w, b)\n            return y * self.scaling_factor + y\n\n        self._refresh()\n        M, K = x.shape\n        N = w.shape[0]\n        x_hi, x_lo, t = self._get_bufs(M, K, N, x.device)\n\n        prev = torch.backends.cuda.matmul.allow_tf32\n        torch.backends.cuda.matmul.allow_tf32 = True\n        try:\n            _split_f32[(triton.cdiv(M * K, 4096),)](\n                x, x_hi, x_lo, M * K, BLOCK=4096, num_warps=8)\n            torch.addmm(self._bias_s, x, self._w_hi_t.t(), beta=0, alpha=s, out=t)\n            torch.addmm(t, x_lo, self._w_hi_t.t(), beta=1, alpha=s, out=t)\n            torch.addmm(t, x_hi, self._w_lo_t.t(), beta=1, alpha=s, out=t)\n        finally:\n            to"]
[892.581864, "i", "rch.backends.cuda.matmul.allow_tf32 = prev\n        return t\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\n"]
[892.581883, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
