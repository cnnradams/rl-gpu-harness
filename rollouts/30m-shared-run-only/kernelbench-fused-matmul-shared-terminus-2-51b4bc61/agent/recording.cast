[125.91614, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.916163, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.916184, "o", "> "]
[125.916206, "o", "    import triton\r\n\u001b[?2004l\r"]
[125.916232, "o", "\u001b[?2004h> "]
[125.916281, "o", "    import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.916306, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\r"]
[125.916332, "o", "\u001b[?2004h> "]
[125.916367, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.916397, "o", ">     _HAS_TRITON = False\r\n\u001b[?2004l\r"]
[125.916422, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[125.916453, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.916479, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[125.916517, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[125.916546, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.916585, "o", "    def _linear_scaled_kernel(\r\n\u001b[?2004l\r"]
[125.916632, "o", "\u001b[?2004h> "]
[125.916665, "o", "        a_ptr, b_ptr, bias_ptr, c_ptr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.916687, "o", "> "]
[125.916713, "o", "        M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.91674, "o", "> "]
[125.916762, "o", "        stride_am, stride_ak,\r\n\u001b[?2004l\r"]
[125.916782, "o", "\u001b[?2004h> "]
[125.916815, "o", "        stride_bk, stride_bn,\r\n\u001b[?2004l\r"]
[125.916835, "o", "\u001b[?2004h> "]
[125.91687, "o", "        stride_cm, stride_cn,\r\n\u001b[?2004l\r"]
[125.916891, "o", "\u001b[?2004h> "]
[125.916913, "o", "        SCALE,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.916939, "o", "> "]
[125.917028, "o", "        BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.91707, "o", "        GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.917102, "o", ">     ):\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.917127, "o", "> "]
[125.917153, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.917202, "o", "        grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[125.917229, "o", "\u001b[?2004h> "]
[125.917269, "o", "        grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.9173, "o", "> "]
[125.917328, "o", "        width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.917378, "o", "        group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.917409, "o", "> "]
[125.91747, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[125.917493, "o", "\u001b[?2004h> "]
[125.91755, "o", "        pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.917582, "o", "> "]
[125.917618, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[125.917645, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[125.917671, "o", "> "]
[125.917721, "o", "        offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.917747, "o", "> "]
[125.917795, "o", "        offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[125.91783, "o", "\u001b[?2004h> "]
[125.917864, "o", "        offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[125.917889, "o", "\u001b[?2004h> "]
[125.917984, "o", "        a_ptrs = a_ptr + offs_m[:, None] * stride_am + offs_k[None, :] * stride_ak\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.918012, "o", "> "]
[125.918087, "o", "        b_ptrs = b_ptr + offs_k[:, None] * stride_bk + offs_n[None, :] * stride_bn\r\n\u001b[?2004l\r"]
[125.918116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.918137, "o", "\u001b[?2004h> "]
[125.918198, "o", "        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.918235, "o", "> "]
[125.918275, "o", "        for _ in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.918305, "o", "> "]
[125.918334, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[125.918364, "o", "\u001b[?2004h> "]
[125.918389, "o", "            b = tl.load(b_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.918415, "o", "> "]
[125.918469, "o", "            acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\r\n\u001b[?2004l\r"]
[125.9185, "o", "\u001b[?2004h> "]
[125.918539, "o", "            a_ptrs += BLOCK_K * stride_ak\r\n\u001b[?2004l\r"]
[125.918562, "o", "\u001b[?2004h> "]
[125.918604, "o", "            b_ptrs += BLOCK_K * stride_bk\r\n\u001b[?2004l\r"]
[125.918625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.918654, "o", "\u001b[?2004h> "]
[125.918705, "o", "        bias = tl.load(bias_ptr + offs_n).to(tl.float32)\r\n\u001b[?2004l\r"]
[125.91873, "o", "\u001b[?2004h> "]
[125.918785, "o", "        acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.918815, "o", "\u001b[?2004h> "]
[125.918904, "o", "        c_ptrs = c_ptr + offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn\r\n\u001b[?2004l\r"]
[125.918938, "o", "\u001b[?2004h> "]
[125.918971, "o", "        tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.919002, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.919031, "o", "\u001b[?2004h> "]
[125.919062, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.919146, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.919176, "o", "> "]
[125.919202, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[125.91923, "o", "\u001b[?2004h> "]
[125.919292, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.919322, "o", "> "]
[125.919358, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.919389, "o", "> "]
[125.919417, "o", "        self._wt = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.919457, "o", "        self._wt_key = None\r\n\u001b[?2004l\r"]
[125.919487, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.919521, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[125.919543, "o", "\u001b[?2004h> "]
[125.919578, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[125.919603, "o", "\u001b[?2004h> "]
[125.919632, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[125.919657, "o", "\u001b[?2004h> "]
[125.919688, "o", "        if (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.919719, "o", "            not _HAS_TRITON\r\n\u001b[?2004l\r"]
[125.919746, "o", "\u001b[?2004h> "]
[125.919777, "o", "            or not x.is_cuda\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.919832, "o", "            or x.dtype != torch.float32\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.919863, "o", "> "]
[125.919891, "o", "            or x.shape[-1] % 64 != 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.919913, "o", "> "]
[125.919955, "o", "            or w.shape[0] % 128 != 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.920008, "o", "            or x.shape[0] % 128 != 0\r\n\u001b[?2004l\r"]
[125.920038, "o", "\u001b[?2004h>         ):\r\n\u001b[?2004l\r"]
[125.920069, "o", "\u001b[?2004h> "]
[125.920117, "o", "            y = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.920151, "o", "> "]
[125.92018, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[125.92021, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.920291, "o", "        key = (w.data_ptr(), w.device, w.dtype, b.data_ptr())\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.920322, "o", "> "]
[125.92035, "o", "        if self._wt_key != key:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.920406, "o", "            self._wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[125.920437, "o", "\u001b[?2004h> "]
[125.920468, "o", "            self._wt_key = key\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.920496, "o", ">         wt = self._wt\r\n\u001b[?2004l\r"]
[125.920526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[125.920556, "o", "\u001b[?2004h> "]
[125.920586, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[125.920622, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r"]
[125.920643, "o", "\u001b[?2004h> "]
[125.920712, "o", "        out = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r"]
[125.920742, "o", "\u001b[?2004h> "]
[125.920801, "o", "        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 128, 128, 64, 8\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.92083, "o", "> "]
[125.920891, "o", "        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.920917, "o", "> "]
[125.92095, "o", "        _linear_scaled_kernel[grid](\r\n\u001b[?2004l\r"]
[125.920979, "o", "\u001b[?2004h> "]
[125.921012, "o", "            x, wt, b, out,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.921036, "o", ">             M, N, K,\r\n\u001b[?2004l\r"]
[125.921063, "o", "\u001b[?2004h> "]
[125.921105, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[125.921131, "o", "\u001b[?2004h> "]
[125.921176, "o", "            wt.stride(0), wt.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.921205, "o", "> "]
[125.921247, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.921273, "o", "> "]
[125.921308, "o", "            1.0 + self.scaling_factor,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.921337, "o", "> "]
[125.921412, "o", "            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\r\n\u001b[?2004l\r\u001b[?2004h"]
[125.921443, "o", "> "]
[125.921471, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[125.921503, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[125.921532, "o", "\u001b[?2004h>         return out\r\n\u001b[?2004l\r"]
[125.921564, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[125.948398, "o", "\u001b[?2004hroot@modal:/# "]
