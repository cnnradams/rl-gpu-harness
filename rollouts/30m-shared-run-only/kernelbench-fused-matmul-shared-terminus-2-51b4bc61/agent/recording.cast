[957.874912, "i", "cat > /workspace/dbg.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport triton\nfrom solution import _split_f32, _MASK\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev='cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev)*2-1)/64.0\nb = torch.randn(N, device=dev)*0.05\ns = 1.5\n\nwt = w.contiguous()\nw_hi = (wt.view(torch.int32) & _MASK).view(torch.float32)\nw_lo = wt - w_hi\nw_hi_t = w_hi.t().contiguous()\nw_lo_t = w_lo.t().contiguous()\nbias_s = b * s\n\nx_hi = torch.empty(M, K, device=dev)\nx_lo = torch.empty(M, K, device=dev)\n_split_f32[(triton.cdiv(M*K, 4096),)](x, x_hi, x_lo, M*K, BLOCK=4096, num_warps=8)\nprint('split recon err', ((x_hi + x_lo) - x).abs().max().item())\n\nprev = torch.backends.cuda.matmul.allow_tf32\ntorch.backends.cuda.matmul.allow_tf32 = True\nt = torch.empty(M, N, device=dev)\ntorch.addmm(bias_s, x, w_hi_t.t(), beta=0, alpha=s, out=t)\ntorch.backends.cuda.matmul.allow_tf32 = prev\nref1 = s * (x @ w_hi) + s*b\nprint('step1 err', (t - ref1).abs().max().item())\n\nt"]
[957.874961, "i", "orch.backends.cuda.matmul.allow_tf32 = True\ntorch.addmm(t, x_lo, w_hi_t.t(), beta=1, alpha=s, out=t)\ntorch.backends.cuda.matmul.allow_tf32 = prev\nref2 = ref1 + s * (x_lo @ w_hi)\nprint('step2 err', (t - ref2).abs().max().item())\n\ntorch.backends.cuda.matmul.allow_tf32 = True\ntorch.addmm(t, x_hi, w_lo_t.t(), beta=1, alpha=s, out=t)\ntorch.backends.cuda.matmul.allow_tf32 = prev\nref3 = ref2 + s * (x_hi @ w_lo)\nprint('step3 err', (t - ref3).abs().max().item())\n\n# final target\ntarget = (torch.addmm(b, x, w)) * s\nprint('total vs target err', (t - target).abs().max().item())\ntol = 1e-4 + 1e-4*target.abs()\nprint('ratio', ((t-target).abs()/tol).max().item())\nEOF\ngpu run -- python3 /workspace/dbg.py > /tmp/dbg.log 2>&1 &\n"]
