[663.180699, "o", "        t1 = torch.mm(x, w_hi_f)          # tf32, RN(x) @ w_hi\r\n\u001b[?2004l\r"]
[663.180725, "o", "\u001b[?2004h> "]
[663.180753, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[663.180803, "o", "        torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[663.180828, "o", "\u001b[?2004h> "]
