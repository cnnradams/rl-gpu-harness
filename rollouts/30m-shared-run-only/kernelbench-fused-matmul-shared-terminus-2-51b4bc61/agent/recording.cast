[287.783275, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\n# mimic nn.Linear default init magnitude\nw = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\n\ntarget = torch.addmm(b, x, w) * scale  # fp32 cuBLAS = evaluator reference\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# 1) cuBLAS tf32 raw GEMM time\ntorch.backends.cuda.matmul.allow_tf32 = True\nprint('cublas tf32 raw          %.3f ms' % timeit(lambda: torch.addmm(b, x, w)))\ntorch.backends.cuda.matmul.allow_tf32 = False\n\n@triton.jit\ndef mm3"]
[287.783352, "i", "x_kernel(a_ptr, b_ptr, bias_ptr, c_ptr, M, N, K,\n                sam, sak, sbk, sbn, scm, scn, SCALE,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    ap = a_ptr + om[:, None]*sam + ok[None, :]*sak\n    bp = b_ptr + ok[:, None]*sbk + on[None, :]*sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(ap); bb = tl.load(bp)\n        a_hi = (a.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\n        a_lo = a - a_hi\n        b_hi = (bb.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\n        b_lo = bb - b_hi\n        acc = tl.dot(a_hi, b_hi, acc, input_"]
[287.783391, "i", "precision=\"tf32\")\n        acc = tl.dot(a_lo, b_hi, acc, input_precision=\"tf32\")\n        acc = tl.dot(a_hi, b_lo, acc, input_precision=\"tf32\")\n        ap += BK * sak; bp += BK * sbk\n    bias = tl.load(bias_ptr + on).to(tl.float32)\n    acc = (acc + bias[None, :]) * SCALE\n    cp = c_ptr + om[:, None]*scm + on[None, :]*scn\n    tl.store(cp, acc)\n\nout = torch.empty(M, N, device=dev)\ndef run3x(BM, BN, BK, GM, nw, ns):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        mm3x_kernel[grid](x, w, b, out, M, N, K,\n                          x.stride(0), x.stride(1), w.stride(0), w.stride(1),\n                          out.stride(0), out.stride(1), scale,\n                          BM, BN, BK, GM, num_warps=nw, num_stages=ns)\n    try:\n        f()\n    except Exception as ex:\n        print(f'3x BM={BM} BN={BN} BK={BK} nw={nw} ns={ns}: FAILED {type(ex).__name__}')\n        return\n    e = err(out)\n    t = timeit(f)\n    print(f'3x BM={BM} BN={BN} BK={BK} GM={GM} nw={nw} ns={ns}: {t:.3f} ms err_ratio={e[1]:.4"]
[287.783404, "i", "f}')\n\nfor cfg in [(128,128,64,8,8,3),(128,128,32,8,8,4),(128,256,64,8,8,2),(128,256,32,8,8,3),(64,256,64,8,4,4),(256,128,64,8,8,3),(128,64,64,8,4,4),(64,128,64,8,4,4)]:\n    run3x(*cfg)\n\n# 3) cuBLAS-based 3xTF32 emulation\ndef cublas_3x():\n    torch.backends.cuda.matmul.allow_tf32 = True\n    a_hi = (x.view(torch.int32) & -8192).view(torch.float32)\n    a_lo = x - a_hi\n    b_hi = (w.view(torch.int32) & -8192).view(torch.float32)\n    b_lo = w - b_hi\n    y = torch.mm(a_hi, b_hi)\n    y += torch.mm(a_lo, b_hi)\n    y += torch.mm(a_hi, b_lo)\n    torch.backends.cuda.matmul.allow_tf32 = False\n    return (y + b) * scale\nob = cublas_3x()\nprint('cublas 3x err_ratio', err(ob)[1])\nprint('cublas 3x total          %.3f ms' % timeit(cublas_3x))\nEOF\n"]
[287.78357, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.78361, "o", "> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r"]
[287.783639, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
