[189.626394, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\nw = torch.randn(K, N, device=dev) * (1/64.0)\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\n\n# fp64 ground truth-ish and fp32 reference (mimics evaluator reference)\nref32 = torch.addmm(b, x, w)  # fp32 cuBLAS\ntarget = ref32 * scale\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nprint('cublas fp32 addmm        %.3f ms' % timeit(lambda: torch.addmm(b, x, w)))\nb2 = b * scale\ndef fused_cublas():\n    return torch.addmm(b2, x, w, beta=1, alpha=scale)\no = fused_cublas(); print('fus"]
[189.626472, "i", "ed cublas err', err(o))\nprint('fused cublas fp32        %.3f ms' % timeit(fused_cublas))\n\n@triton.jit\ndef mm_kernel(a_ptr, b_ptr, bias_ptr, c_ptr, M, N, K,\n              sam, sak, sbk, sbn, scm, scn, SCALE, PREC: tl.constexpr,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    om = pid_m * BM + tl.arange(0, BM)\n    on = pid_n * BN + tl.arange(0, BN)\n    ok = tl.arange(0, BK)\n    ap = a_ptr + om[:, None]*sam + ok[None, :]*sak\n    bp = b_ptr + ok[:, None]*sbk + on[None, :]*sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(ap); bb = tl.load(bp)\n        if PREC == 0:\n            acc = tl.dot(a, bb, acc, input_precision=\"tf32\")\n        elif PREC == 1:\n            acc = tl.dot(a, bb"]
[189.626481, "i", ", acc, input_precision=\"tf32x3\")\n        else:\n            acc = tl.dot(a, bb, acc, input_precision=\"ieee\")\n        ap += BK * sak; bp += BK * sbk\n    bias = tl.load(bias_ptr + on).to(tl.float32)\n    acc = (acc + bias[None, :]) * SCALE\n    cp = c_ptr + om[:, None]*scm + on[None, :]*scn\n    tl.store(cp, acc)\n\nout = torch.empty(M, N, device=dev)\ndef run_triton(prec, BM, BN, BK, GM, nw, ns):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        mm_kernel[grid](x, w, b, out, M, N, K,\n                        x.stride(0), x.stride(1), w.stride(0), w.stride(1),\n                        out.stride(0), out.stride(1), scale, prec,\n                        BM, BN, BK, GM, num_warps=nw, num_stages=ns)\n    f()\n    e = err(out)\n    t = timeit(f)\n    print(f'triton prec={prec} BM={BM} BN={BN} BK={BK} nw={nw} ns={ns}: {t:.3f} ms err={e}')\n\nfor prec in (1,):\n    for (BM, BN, BK, nw, ns) in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,32,4,4),(64,256,64,4,4),(128,256,32,8,3)]:\n        run_tri"]
[189.626487, "i", "ton(prec, BM, BN, BK, 8, nw, ns)\n\n# tf32 accuracy check\ntorch.backends.cuda.matmul.allow_tf32 = True\no32 = torch.addmm(b, x, w) * scale\nprint('cublas tf32 err', err(o32))\nprint('cublas tf32              %.3f ms' % timeit(lambda: torch.addmm(b2, x, w, beta=1, alpha=scale)))\ntorch.backends.cuda.matmul.allow_tf32 = False\n\n# bf16 check\nxb = x.bfloat16(); wb = w.bfloat16()\nob = torch.addmm(b, xb, wb).float() * scale\nprint('bf16 err', err(ob))\nprint('bf16 mm                  %.3f ms' % timeit(lambda: torch.addmm(b, xb, wb)))\nEOF\n"]
[189.626629, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[189.626724, "o", "\u001b[?2004h> "]
[189.62676, "o", "import torch, time\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r"]
[189.626854, "o", "\u001b[?2004h> "]
[189.626878, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.626929, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.626971, "o", "x = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r"]
[189.627003, "o", "\u001b[?2004h> "]
[189.627036, "o", "w = torch.randn(K, N, device=dev) * (1/64.0)\r\n\u001b[?2004l\r"]
[189.627073, "o", "\u001b[?2004h> "]
[189.627114, "o", "b = torch.randn(N, device=dev) * 0.05\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.627155, "o", "> scale = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.627195, "o", "\u001b[?2004h> "]
[189.627258, "o", "# fp64 ground truth-ish and fp32 reference (mimics evaluator reference)\r\n\u001b[?2004l\r"]
[189.627296, "o", "\u001b[?2004h> "]
[189.627335, "o", "ref32 = torch.addmm(b, x, w)  # fp32 cuBLAS\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.627375, "o", "> target = ref32 * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.627414, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627453, "o", "def err(o):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627493, "o", "    d = (o - target).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627533, "o", "    tol = 1e-4 + 1e-4 * target.abs()\r\n\u001b[?2004l\r"]
[189.627574, "o", "\u001b[?2004h> "]
[189.627616, "o", "    return d.max().item(), (d / tol).max().item()\r\n\u001b[?2004l\r"]
[189.627653, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627695, "o", "def timeit(fn, iters=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627741, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.62778, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627872, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.627915, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.62795, "o", "    for _ in range(iters): fn()\r\n\u001b[?2004l\r"]
[189.62799, "o", "\u001b[?2004h> "]
[189.628036, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[189.628077, "o", "\u001b[?2004h>     return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.628119, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.628229, "o", "print('cublas fp32 addmm        %.3f ms' % timeit(lambda: torch.addmm(b, x, w)))\r\n\u001b[?2004l\r\u001b[?2004h> b2 = b * scale\r\n\u001b[?2004l\r"]
[189.628255, "o", "\u001b[?2004h> "]
[189.628284, "o", "def fused_cublas():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.628348, "o", "    return torch.addmm(b2, x, w, beta=1, alpha=scale)\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.628385, "o", "> "]
[189.628427, "o", "o = fused_cublas(); print('fused cublas err', err(o))\r\n\u001b[?2004l\r"]
[189.628469, "o", "\u001b[?2004h> "]
[189.628511, "o", "print('fused cublas fp32        %.3f ms' % timeit(fused_cublas))\r\n\u001b[?2004l\r"]
[189.628558, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.628597, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.628687, "o", "def mm_kernel(a_ptr, b_ptr, bias_ptr, c_ptr, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.628781, "o", "              sam, sak, sbk, sbn, scm, scn, SCALE, PREC: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.628808, "o", "> "]
[189.628911, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.628957, "o", ">     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[189.629002, "o", "\u001b[?2004h> "]
[189.629048, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.629088, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.629126, "o", ">     gid = pid // width\r\n\u001b[?2004l\r"]
[189.629167, "o", "\u001b[?2004h> "]
[189.629207, "o", "    gsz = tl.minimum(grid_m - gid * GM, GM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.629249, "o", "    pid_m = gid * GM + (pid % gsz)\r\n\u001b[?2004l\r"]
[189.62929, "o", "\u001b[?2004h> "]
[189.629331, "o", "    pid_n = (pid % width) // gsz\r\n\u001b[?2004l\r"]
[189.629374, "o", "\u001b[?2004h> "]
[189.629415, "o", "    om = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[189.629454, "o", "\u001b[?2004h> "]
[189.629491, "o", "    on = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[189.62953, "o", "\u001b[?2004h>     ok = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[189.62957, "o", "\u001b[?2004h> "]
[189.62961, "o", "    ap = a_ptr + om[:, None]*sam + ok[None, :]*sak\r\n\u001b[?2004l\r"]
[189.62965, "o", "\u001b[?2004h> "]
[189.629691, "o", "    bp = b_ptr + ok[:, None]*sbk + on[None, :]*sbn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.629754, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[189.629802, "o", "\u001b[?2004h> "]
[189.629843, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.629887, "o", "        a = tl.load(ap); bb = tl.load(bp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.629928, "o", "        if PREC == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.629969, "o", "> "]
[189.630012, "o", "            acc = tl.dot(a, bb, acc, input_precision=\"tf32\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.630052, "o", ">         elif PREC == 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.630092, "o", "> "]
[189.630136, "o", "            acc = tl.dot(a, bb, acc, input_precision=\"tf32x3\")\r\n\u001b[?2004l\r"]
[189.630173, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.630216, "o", "> "]
[189.63026, "o", "            acc = tl.dot(a, bb, acc, input_precision=\"ieee\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.630301, "o", "> "]
[189.630344, "o", "        ap += BK * sak; bp += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.630395, "o", "    bias = tl.load(bias_ptr + on).to(tl.float32)\r\n\u001b[?2004l\r"]
[189.630436, "o", "\u001b[?2004h> "]
[189.630465, "o", "    acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.630504, "o", "> "]
[189.630553, "o", "    cp = c_ptr + om[:, None]*scm + on[None, :]*scn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.630593, "o", "    tl.store(cp, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.630633, "o", "\u001b[?2004h> "]
[189.630682, "o", "out = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.630728, "o", "def run_triton(prec, BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r"]
[189.630765, "o", "\u001b[?2004h> "]
[189.63081, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[189.63085, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.630892, "o", "> "]
[189.630933, "o", "        mm_kernel[grid](x, w, b, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631013, "o", "                        x.stride(0), x.stride(1), w.stride(0), w.stride(1),\r\n\u001b[?2004l\r"]
[189.631051, "o", "\u001b[?2004h> "]
[189.631109, "o", "                        out.stride(0), out.stride(1), scale, prec,\r\n\u001b[?2004l\r"]
[189.631152, "o", "\u001b[?2004h> "]
[189.631206, "o", "                        BM, BN, BK, GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[189.631247, "o", "\u001b[?2004h>     f()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631287, "o", "    e = err(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631328, "o", "    t = timeit(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631425, "o", "    print(f'triton prec={prec} BM={BM} BN={BN} BK={BK} nw={nw} ns={ns}: {t:.3f} ms err={e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.631467, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631506, "o", "for prec in (1,):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631641, "o", "    for (BM, BN, BK, nw, ns) in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,32,4,4),(64,256,64,4,4),(128,256,32,8,3)]:\r\n\u001b[?2004l\r"]
[189.631686, "o", "\u001b[?2004h> "]
[189.631727, "o", "        run_triton(prec, BM, BN, BK, 8, nw, ns)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[189.631766, "o", "\u001b[?2004h> # tf32 accuracy check\r\n\u001b[?2004l\r"]
[189.63181, "o", "\u001b[?2004h> "]
[189.631866, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.631909, "o", "o32 = torch.addmm(b, x, w) * scale\r\n\u001b[?2004l\r"]
[189.63195, "o", "\u001b[?2004h> "]
[189.631984, "o", "print('cublas tf32 err', err(o32))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.632103, "o", "print('cublas tf32              %.3f ms' % timeit(lambda: torch.addmm(b2, x, w, beta=1, alpha=scale)))\r\n\u001b[?2004l\r"]
[189.632144, "o", "\u001b[?2004h> "]
[189.632187, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.632227, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # bf16 check\r\n\u001b[?2004l\r"]
[189.632267, "o", "\u001b[?2004h> "]
[189.632304, "o", "xb = x.bfloat16(); wb = w.bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[189.632356, "o", "ob = torch.addmm(b, xb, wb).float() * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.632397, "o", "> print('bf16 err', err(ob))\r\n\u001b[?2004l\r"]
[189.632434, "o", "\u001b[?2004h> "]
[189.632514, "o", "print('bf16 mm                  %.3f ms' % timeit(lambda: torch.addmm(b, xb, wb)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[189.632532, "o", "> EOF\r\n\u001b[?2004l\r"]
