[663.180975, "o", "    split_kernel[(triton.cdiv(numel, 4096),)](x, x_hi_b, x_lo_b, numel, 8193.0, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[663.181002, "o", "\u001b[?2004h> "]
[663.181043, "o", "    t2 = torch.mm(x_lo_b, w_hi_b)         # bf16\r\n\u001b[?2004l\r"]
