[734.712826, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\ndev = 'cuda'\nx = torch.rand(M, K, device=dev)\nw = (torch.rand(K, N, device=dev) * 2 - 1) / 64.0\nb = torch.randn(N, device=dev) * 0.05\nscale = 1.5\n\ntarget = torch.addmm(b, x, w) * scale\n\ndef err(o):\n    d = (o - target).abs()\n    tol = 1e-4 + 1e-4 * target.abs()\n    return d.max().item(), (d / tol).max().item()\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n# Veltkamp split fp32 -> hi,lo fp16 scaled (per-call x, cached w)\n@triton.jit\ndef split_h_kernel(x_ptr, hi_ptr, numel, C, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(x_ptr + offs, mask=mask)\n    t = v * C\n    hi"]
[734.712878, "i", " = t - (t - v)\n    tl.store(hi_ptr + offs, hi.to(tl.float16), mask=mask)\n\n@triton.jit\ndef split_l_kernel(x_ptr, lo_ptr, numel, C, S, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(x_ptr + offs, mask=mask)\n    t = v * C\n    hi = t - (t - v)\n    lo = (v - hi) * S\n    tl.store(lo_ptr + offs, lo.to(tl.float16), mask=mask)\n\n# cached w splits: fp16 for corrections, fp32 for main tf32 term\ntw = w * 8193.0\nw_hi_f = tw - (tw - w)          # ~11 bits\nw_lo_f = w - w_hi_f\nw_hi_h = w_hi_f.half().contiguous()\ns_w = 4096.0  # 2^12, exact\nw_lo_h = (w_lo_f * s_w).half().contiguous()\n\nx_hi_h = torch.empty(M, K, device=dev, dtype=torch.float16)\nx_lo_h = torch.empty(M, K, device=dev, dtype=torch.float16)\n\n# scales for x: x in [0,1): hi part max ~1 fits fp16 fine. lo: |x_lo|<=2^-12 -> scale 2^12\ns_x = 4096.0\ninv_s = 1.0 / (s_x * s_w)\n\ndef variant_fp16corr(x):\n    prev = torch.backends.cuda.matmul.allow_tf32\n    torch.backends.cuda.matmul.allow_"]
[734.712893, "i", "tf32 = True\n    try:\n        t1 = torch.mm(x, w_hi_f)   # tf32 main\n    finally:\n        torch.backends.cuda.matmul.allow_tf32 = prev\n    split_h_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_hi_h, x.numel(), 8193.0, BLOCK=4096, num_warps=8)\n    split_l_kernel[(triton.cdiv(x.numel(), 4096),)](x, x_lo_h, x.numel(), 8193.0, s_x, BLOCK=4096, num_warps=8)\n    t2 = torch.mm(x_lo_h, w_hi_h)   # fp16\n    t3 = torch.mm(x_hi_h, w_lo_h)   # fp16\n    return t1 + (t2 + t3) * inv_s\n\nt1 = variant_fp16corr(x)\nres = (t1 + b) * scale\nprint('fp16corr err_ratio %.4f' % err(res)[1])\nprint('fp16corr          %.3f ms' % timeit(lambda: variant_fp16corr(x)))\n\n# variant: concat corrections into one 2K fp16 GEMM\nxcat = torch.empty(M, 2*K, device=dev, dtype=torch.float16)\nwcat = torch.cat([w_hi_h, w_lo_h], 0).contiguous()  # (2K, N)\n\ndef variant_cat(x):\n    prev = torch.backends.cuda.matmul.allow_tf32\n    torch.backends.cuda.matmul.allow_tf32 = True\n    try:\n        t1 = torch.mm(x, w_hi_f)\n    finally:\n        torch.backends.cuda.matmu"]
[734.713063, "i", "l.allow_tf32 = prev\n    split_h_kernel[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, :K], x.numel(), 8193.0, BLOCK=4096, num_warps=8)\n    split_l_kernel[(triton.cdiv(x.numel(), 4096),)](x, xcat[:, K:], x.numel(), 8193.0, s_x, BLOCK=4096, num_warps=8)\n    # t2 = x_lo@w_hi + x_hi@w_lo needs careful order in cat: [x_lo | x_hi] @ [w_hi ; w_lo]\n    return t1, xcat\n\nt1c, xc = variant_cat(x)\ntc = torch.mm(xc, wcat) * inv_s\nres_c = (t1c + tc + b) * scale\nprint('cat err_ratio %.4f' % err(res_c)[1])\ndef full_cat(x):\n    t1c, xc = variant_cat(x)\n    tc = torch.mm(xc, wcat)\n    return t1c + tc * inv_s\nprint('cat               %.3f ms' % timeit(lambda: full_cat(x)))\n\n# epilogue timing\nout = torch.empty(M, N, device=dev)\n@triton.jit\ndef epi_kernel(t1_ptr, t2_ptr, b_ptr, o_ptr, numel, N, INV_S, SCALE, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    a = tl.load(t1_ptr + offs, mask=mask)\n    c = tl.load(t2_ptr + offs, mask=mask)\n    bb = tl.load(b_ptr + o"]
[734.713083, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[734.713138, "i", "ffs % N, mask=mask)\n    tl.store(o_ptr + offs, (a + c * INV_S + bb) * SCALE, mask=mask)\n\ntc32 = torch.mm(xc, wcat)\nprint('epilogue          %.3f ms' % timeit(lambda: epi_kernel[(triton.cdiv(M*N, 4096),)](t1c, tc32, b, out, M*N, N, inv_s, scale, BLOCK=4096, num_warps=8)))\nprint('mm fp16 2K        %.3f ms' % timeit(lambda: torch.mm(xc, wcat)))\nEOF\ngpu run -- python3 /workspace/bench5.py > /tmp/bench5.log 2>&1 &\n"]
