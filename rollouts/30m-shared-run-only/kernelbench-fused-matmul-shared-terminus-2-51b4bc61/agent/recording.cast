[287.786139, "o", "    ok = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[287.786184, "o", "\u001b[?2004h> "]
[287.786225, "o", "    ap = a_ptr + om[:, None]*sam + ok[None, :]*sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.786279, "o", "> "]
[287.786321, "o", "    bp = b_ptr + ok[:, None]*sbk + on[None, :]*sbn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.786375, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.786415, "o", "> "]
[287.78646, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.7865, "o", "        a = tl.load(ap); bb = tl.load(bp)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.78654, "o", "> "]
[287.786602, "o", "        a_hi = (a.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\r\n\u001b[?2004l\r"]
[287.786644, "o", "\u001b[?2004h>         a_lo = a - a_hi\r\n\u001b[?2004l\r"]
[287.786684, "o", "\u001b[?2004h> "]
[287.786754, "o", "        b_hi = (bb.to(tl.int32, bitcast=True) & -8192).to(tl.float32, bitcast=True)\r\n\u001b[?2004l\r"]
[287.786794, "o", "\u001b[?2004h>         b_lo = bb - b_hi\r\n\u001b[?2004l\r"]
[287.786845, "o", "\u001b[?2004h> "]
[287.786894, "o", "        acc = tl.dot(a_hi, b_hi, acc, input_precision=\"tf32\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.786936, "o", "> "]
[287.786977, "o", "        acc = tl.dot(a_lo, b_hi, acc, input_precision=\"tf32\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.787018, "o", "> "]
[287.787059, "o", "        acc = tl.dot(a_hi, b_lo, acc, input_precision=\"tf32\")\r\n\u001b[?2004l\r"]
[287.787099, "o", "\u001b[?2004h> "]
[287.787138, "o", "        ap += BK * sak; bp += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.787197, "o", "    bias = tl.load(bias_ptr + on).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.787244, "o", "> "]
[287.787284, "o", "    acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.787323, "o", "    cp = c_ptr + om[:, None]*scm + on[None, :]*scn\r\n\u001b[?2004l\r"]
[287.787362, "o", "\u001b[?2004h> "]
[287.787401, "o", "    tl.store(cp, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.787441, "o", "out = torch.empty(M, N, device=dev)\r\n\u001b[?2004l\r"]
[287.787482, "o", "\u001b[?2004h> "]
[287.787522, "o", "def run3x(BM, BN, BK, GM, nw, ns):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.787579, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[287.78762, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.787682, "o", "        mm3x_kernel[grid](x, w, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[287.787724, "o", "\u001b[?2004h> "]
[287.787788, "o", "                          x.stride(0), x.stride(1), w.stride(0), w.stride(1),\r\n\u001b[?2004l\r"]
[287.78783, "o", "\u001b[?2004h> "]
[287.78787, "o", "                          out.stride(0), out.stride(1), scale,\r\n\u001b[?2004l\r"]
[287.78791, "o", "\u001b[?2004h> "]
[287.787968, "o", "                          BM, BN, BK, GM, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.788011, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h>         f()\r\n\u001b[?2004l\r"]
[287.788041, "o", "\u001b[?2004h> "]
[287.788126, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.788194, "o", "        print(f'3x BM={BM} BN={BN} BK={BK} nw={nw} ns={ns}: FAILED {type(ex).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.788243, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.788285, "o", "    e = err(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
