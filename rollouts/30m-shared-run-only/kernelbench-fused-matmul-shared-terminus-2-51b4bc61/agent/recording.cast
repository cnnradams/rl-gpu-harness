[1082.967058, "i", "cat > /workspace/dbg3.py << 'EOF'\nimport torch\ndev='cuda'\ntorch.manual_seed(0)\nM,K,N = 1024, 1024, 1024\nx = torch.rand(M,K,device=dev)\nw = torch.randn(K,N,device=dev)\nbias = torch.randn(N,device=dev)\ns = 1.5\nwt_t = w.t().contiguous()\n\nr = torch.empty(M,N,device=dev)\ntorch.addmm(bias*s, x, wt_t.t(), beta=0, alpha=s, out=r)\nexpect = s*(x@w) + s*bias\nprint('beta0 alpha=s err:', (r-expect).abs().max().item())\nexpect_nb = s*(x@w)\nprint('vs no-bias       err:', (r-expect_nb).abs().max().item())\nexpect_na = (x@w) + s*bias\nprint('vs no-alpha      err:', (r-expect_na).abs().max().item())\n\nr2 = torch.mm(x, wt_t.t())\nprint('TN mm vs NN mm err:', (r2 - x@w).abs().max().item())\n\n# tf32 mode\ntorch.backends.cuda.matmul.allow_tf32 = True\nr3 = torch.empty(M,N,device=dev)\ntorch.addmm(bias*s, x, wt_t.t(), beta=0, alpha=s, out=r3)\ntorch.backends.cuda.matmul.allow_tf32 = False\nprint('tf32 beta0 alpha=s err vs fp32 expect:', (r3-expect).abs().max().item())\nEOF\ngpu run -- python3 /workspace/dbg3.py > /tmp/dbg3.log 2>&1 &\n"]
