[287.784079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[287.784109, "o", "> "]
[287.784168, "o", "target = torch.addmm(b, x, w) * scale  # fp32 cuBLAS = evaluator reference\r\n\u001b[?2004l\r"]
[287.784195, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.784221, "o", "def err(o):\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.784256, "o", "> "]
[287.784286, "o", "    d = (o - target).abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.784316, "o", "> "]
[287.784347, "o", "    tol = 1e-4 + 1e-4 * target.abs()\r\n\u001b[?2004l\r"]
[287.784376, "o", "\u001b[?2004h> "]
[287.784413, "o", "    return d.max().item(), (d / tol).max().item()\r\n\u001b[?2004l\r"]
[287.784439, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.784479, "o", "def timeit(fn, iters=20):\r\n\u001b[?2004l\r"]
[287.784503, "o", "\u001b[?2004h> "]
[287.784531, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.784557, "o", "> "]
[287.784584, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.784681, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[287.784698, "o", "\u001b[?2004h> "]
[287.784839, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(iters): fn()\r\n\u001b[?2004l\r\u001b[?2004h>     e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.784887, "o", "> "]
[287.784932, "o", "    return s.elapsed_time(e) / iters\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.784982, "o", "# 1) cuBLAS tf32 raw GEMM time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.785043, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[287.785087, "o", "\u001b[?2004h> "]
[287.785149, "o", "print('cublas tf32 raw          %.3f ms' % timeit(lambda: torch.addmm(b, x, w)))\r\n\u001b[?2004l\r"]
[287.785196, "o", "\u001b[?2004h> "]
[287.785242, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[287.785286, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.785329, "o", "> "]
[287.785372, "o", "def mm3x_kernel(a_ptr, b_ptr, bias_ptr, c_ptr, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.785442, "o", "                sam, sak, sbk, sbn, scm, scn, SCALE,\r\n\u001b[?2004l\r"]
[287.785462, "o", "\u001b[?2004h> "]
[287.785566, "o", "                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.785609, "o", ">     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[287.785648, "o", "\u001b[?2004h> "]
[287.785688, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[287.78573, "o", "\u001b[?2004h>     width = GM * grid_n\r\n\u001b[?2004l\r"]
[287.785767, "o", "\u001b[?2004h> "]
[287.785803, "o", "    gid = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.785842, "o", "    gsz = tl.minimum(grid_m - gid * GM, GM)\r\n\u001b[?2004l\r"]
[287.785881, "o", "\u001b[?2004h> "]
[287.785925, "o", "    pid_m = gid * GM + (pid % gsz)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.785966, "o", "    pid_n = (pid % width) // gsz\r\n\u001b[?2004l\r\u001b[?2004h> "]
[287.786025, "o", "    om = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[287.786068, "o", "> "]
