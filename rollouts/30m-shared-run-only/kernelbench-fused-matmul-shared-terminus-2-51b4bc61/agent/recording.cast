[559.991972, "o", "\u001b[?2004h>         self._w_lo = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[559.992023, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.992066, "o", "    def _refresh(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.992108, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.992161, "o", "        key = (w.data_ptr(), w.device, w.dtype, w.shape)\r\n\u001b[?2004l\r"]
[559.992201, "o", "\u001b[?2004h> "]
[559.99224, "o", "        if self._key != key:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.992288, "o", "            wt = w.detach().t().contiguous()  # (in, out)\r\n\u001b[?2004l\r"]
[559.992305, "o", "\u001b[?2004h> "]
[559.992383, "o", "            w_hi = (wt.view(torch.int32) & _MASK).view(torch.float32)\r\n\u001b[?2004l\r"]
[559.992401, "o", "\u001b[?2004h> "]
[559.992445, "o", "            self._w_hi = w_hi.contiguous()\r\n\u001b[?2004l\r"]
[559.992485, "o", "\u001b[?2004h> "]
[559.992515, "o", "            self._w_lo = (wt - w_hi).contiguous()\r\n\u001b[?2004l\r"]
[559.992555, "o", "\u001b[?2004h>             self._key = key\r\n\u001b[?2004l\r"]
[559.992574, "o", "\u001b[?2004h"]
[559.992637, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[559.992678, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
