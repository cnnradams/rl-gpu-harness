[?2004l[?2004h>     numel = x.numel()
[?2004l[?2004h>     split_kernel[(triton.cdiv(numel, 4096),)](x, x_hi_b, x_lo_b, numel, 8193.0, BLOCK=4096, num_warps=8)
[?2004l[?2004h>     t2 = torch.mm(x_lo_b, w_hi_b)         # bf16
[?2004l[?2004h>     t3 = torch.mm(x_hi_b, w_lo_b)         # bf16
[?2004l[?2004h>     return t1, t2, t3
[?2004l[?2004h> 
