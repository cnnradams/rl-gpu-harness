[?2004l[?2004h> x_hi_b = torch.empty(M, K, device=dev, dtype=torch.bfloat16)
[?2004l[?2004h> x_lo_b = torch.empty(M, K, device=dev, dtype=torch.bfloat16)
[?2004l[?2004h> 
[?2004l[?2004h> def variant_a(x):
[?2004l[?2004h>     prev = torch.backends.cuda.matmul.allow_tf32
[?2004l[?2004h>     torch.backends.cuda.matmul.allow_tf32 = True
[?2004l[?2004h>     try:
[?2004l[?2004h>         t1 = torch.mm(x, w_hi_f)          # tf32, RN(x) @ w_hi
[?2004l[?2004h>     finally:
