[?2004l[?2004h>     mask = offs < numel
[?2004l[?2004h>     v = tl.load(x_ptr + offs, mask=mask)
[?2004l[?2004h>     t = v * C
[?2004l[?2004h>     hi = t - (t - v)
[?2004l[?2004h>     lo = v - hi
[?2004l[?2004h>     tl.store(hi_ptr + offs, hi.to(tl.bfloat16), mask=mask)
[?2004l[?2004h>     tl.store(lo_ptr + offs, lo.to(tl.bfloat16), mask=mask)
[?2004l[?2004h> 
