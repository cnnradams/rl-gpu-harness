[?2004l[?2004h> # Veltkamp split kernel: write hi/lo in bf16
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def split_kernel(x_ptr, hi_ptr, lo_ptr, numel, C, BLOCK: tl.constexpr):
