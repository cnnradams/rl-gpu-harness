[?2004l[?2004h> print('variant_a (no epi) %.3f ms' % timeit(lambda: variant_a(x)))
[?2004l[?2004h> 
[?2004l[?2004h> # also check error without x_lo term (is veltkamp+2gemm enough?)
[?2004l[?2004h> res2 = (t1 + t3.float() + b) * scale
