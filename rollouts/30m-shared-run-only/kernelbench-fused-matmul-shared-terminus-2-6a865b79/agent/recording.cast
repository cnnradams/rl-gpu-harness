[1251.335099, "o", "\u001b[?2004h> "]
[1251.335134, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1251.335166, "o", "\u001b[?2004h> "]
[1251.335197, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1251.335229, "o", "\u001b[?2004h> "]
