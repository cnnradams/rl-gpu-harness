[694.978078, "o", "\u001b[?2004hroot@modal:/# "]
[729.26189, "i", "sed -i 's/def bench(fn, trials=10):/def bench(fn, trials=10):/; s/clear_l2(x.device)/clear_l2(dev)/' /workspace/tune.py && sed -i \"s/x32 = torch.rand(M,K,device='cuda')/dev='cuda'\\nx32 = torch.rand(M,K,device=dev)/\" /workspace/tune.py && grep -n \"dev\" /workspace/tune.py | head\n"]
[729.262331, "o", "sed -i 's/def bench(fn, trials=10):/def bench(fn, trials=10):/; s/clear_l2(x.device)/clear_l2(dev)/' /workspace/tune.py && sed -i \"s/x32 = torch.rand(M,K,device='cuda')/dev='cuda'\\nx32 = torch.rand(M,K,device=dev)/\" /workspace/tune.py && grep -n \"dev\" /workspace/tune.py | head\r\n\u001b[?2004l\r"]
[729.267259, "o", "33:def clear_l2(device):\r\n34:    d = torch.empty((32,1024,1024), dtype=torch.int64, device=device); d.fill_(42); del d\r\n42:        clear_l2(dev)\r\n48:dev='cuda'\r\n49:x32 = torch.rand(M,K,device=dev)\r\n51:wt = (torch.rand(N,K,device='cuda')*1.5).t().contiguous().half()\r\n52:bias = torch.rand(N,device='cuda')\r\n53:out = torch.empty(M,N,device='cuda')\r\n"]
