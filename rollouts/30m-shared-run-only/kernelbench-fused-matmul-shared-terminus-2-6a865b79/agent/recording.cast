[1419.042755, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1419.042783, "o", "\u001b[?2004h> "]
[1419.042845, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1419.042874, "o", "\u001b[?2004h> "]
[1419.042906, "o", "        b_hi = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[1419.042937, "o", "\u001b[?2004h> "]
[1419.042963, "o", "        b_lo = tl.load(BL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.042989, "o", "> "]
[1419.043023, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[1419.043055, "o", "\u001b[?2004h> "]
[1419.043097, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.043154, "o", "        acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.043185, "o", "> "]
