[1251.333119, "i", "cat > /workspace/tune4.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev='cuda'\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n\ndef bench(fn, trials=10):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if t>=1: times.append(s.elapsed_time(e))\n    times.sort(); return sum(times)/len(times)\n\n@triton.jit\ndef _k3(A, B, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n  "]
[1251.333167, "i", "  pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        b = tl.load(B_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = b.to(tl.float16)\n        b_lo = (b - b_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        A_ptr += BK * sak\n        B_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\nM,N,K=16384,4096,4096\ntorch.manual_seed(0)\nx32 = torch.rand(M,K,device=dev)\nwt = torch.randn(N,K,device=dev) / (K**0.5)\nbias0 = torch.randn(N,devi"]
[1251.333174, "i", "ce=dev)\nc = 1.5\nwtT = (wt*c).t().contiguous()\nbias32 = (bias0*c).contiguous()\nout32 = torch.empty(M,N,device=dev)\n\nres=[]\nfor (bm,bn,bk) in [(128,256,64),(128,256,32),(256,128,64),(128,128,64),(64,256,64),(128,64,64)]:\n    for grp in [8,16]:\n        for st in [2,3,4]:\n            for wp in [4,8]:\n                if M%bm or N%bn or K%bk: continue\n                grid=((M//bm)*(N//bn),)\n                def f():\n                    _k3[grid](x32, wtT, bias32, out32, M,N,K, x32.stride(0),x32.stride(1), wtT.stride(0),wtT.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=wp,num_stages=st)\n                    return out32\n                try:\n                    res.append((bench(f),bm,bn,bk,grp,st,wp))\n                except Exception:\n                    pass\nres.sort()\nfor r in res[:6]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} stages={r[5]} warps={r[6]}')\n\nbm,bn,bk,grp,st,wp = res[0][1:]\ngrid=((M//bm)*(N//bn),)\n_k3[grid](x32, wtT, bias32, out32, M,N,K, x32.s"]
[1251.333321, "i", "tride(0),x32.stride(1), wtT.stride(0),wtT.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=wp,num_stages=st)\nref = (torch.nn.functional.linear(x32, wt, bias0)) * c\nmd = (ref-out32).abs().max().item()\nprint('split-fp16 max_diff:', md, 'allclose(1e-4):', torch.allclose(ref, out32, atol=1e-4, rtol=1e-4))\nEOF\n"]
