[1130.861925, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1130.861964, "o", "\u001b[?2004h> "]
[1130.862028, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.862067, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1130.862106, "o", "\u001b[?2004h> "]
[1130.862144, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1130.862184, "o", "\u001b[?2004h> "]
[1130.862223, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.862264, "o", ">         self._wb = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.862314, "o", "> "]
[1130.862361, "o", "        self._b = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1130.8624, "o", "\u001b[?2004l\r\u001b[?2004h>     @torch.no_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.862453, "o", "    def _build_cache(self, x):\r\n\u001b[?2004l\r"]
[1130.862495, "o", "\u001b[?2004h> "]
[1130.862537, "o", "        c = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.86262, "o", "        w = self.matmul.weight.detach().to(x.device, torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.862662, "o", "> "]
[1130.862702, "o", "        b = self.matmul.bias.detach().to(x.device, torch.float32)\r\n\u001b[?2004l\r"]
[1130.862741, "o", "\u001b[?2004h> "]
[1130.8628, "o", "        self._wb = (w * c).t().contiguous().to(torch.bfloat16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.862839, "o", "> "]
[1130.86288, "o", "        self._b = (b * c).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.862922, "o", ">     @torch.no_grad()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.862962, "o", ">     def forward(self, x):\r\n\u001b[?2004l\r"]
[1130.863001, "o", "\u001b[?2004h> "]
[1130.863055, "o", "        if self._wb is None or self._wb.device != x.device:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.863096, "o", "> "]
[1130.863136, "o", "            self._build_cache(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863178, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863219, "o", "        N = self._wb.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863322, "o", "        if x.dtype == torch.float32 and M % 128 == 0 and N % 256 == 0 and K % 64 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.863366, "o", "> "]
[1130.863432, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.863474, "o", "> "]
[1130.863516, "o", "            grid = ((M // 128) * (N // 256),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863555, "o", "            a = x.to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[1130.863594, "o", "\u001b[?2004h> "]
[1130.863632, "o", "            _fused_linear_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863704, "o", "                a, self._wb, self._b, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.863745, "o", "> "]
[1130.863785, "o", "                a.stride(0), a.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863856, "o", "                self._wb.stride(0), self._wb.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.863896, "o", "> "]
[1130.863936, "o", "                out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.863999, "o", "                BM=128, BN=256, BK=64, GROUP=16,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.86404, "o", "> "]
[1130.864075, "o", "                num_warps=8, num_stages=4,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.864115, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.864154, "o", "            return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.864206, "o", "        # fallback: cuBLAS fp16 path\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.864245, "o", "> "]
[1130.864286, "o", "        a = x.to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.864383, "o", "        o = torch.addmm(self._b.to(torch.float16), a, self._wb.to(torch.float16))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1130.864443, "o", "        return o.to(torch.float32)\r\n\u001b[?2004l\r"]
[1130.864483, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
