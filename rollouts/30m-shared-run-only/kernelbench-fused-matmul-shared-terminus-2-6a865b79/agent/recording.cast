[1664.772868, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.77291, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.772954, "o", "def _split(A, AH, AL, n, BLK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.772995, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.773015, "o", "> "]
