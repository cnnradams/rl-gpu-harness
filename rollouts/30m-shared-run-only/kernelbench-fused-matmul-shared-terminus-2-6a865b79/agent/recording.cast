[920.423334, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[920.42336, "o", "\u001b[?2004h> "]
[920.423459, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.423485, "o", ">         clear_l2()\r\n\u001b[?2004l\r"]
[920.423513, "o", "\u001b[?2004h> "]
[920.423582, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[920.423608, "o", "\u001b[?2004h> "]
[920.423657, "o", "        if t>=1: times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[920.423681, "o", "\u001b[?2004h> "]
[920.42373, "o", "    times.sort(); return sum(times)/len(times)\r\n\u001b[?2004l\r"]
[920.423756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[920.423781, "o", "\u001b[?2004h> "]
[920.423805, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.423878, "o", "def _k(A, B, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.42391, "o", "> "]
[920.42399, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\r\n\u001b[?2004l\r"]
[920.424019, "o", "\u001b[?2004h> "]
[920.424042, "o", "       DOT_DTYPE: tl.constexpr):\r\n\u001b[?2004l\r"]
[920.424065, "o", "\u001b[?2004h> "]
[920.424091, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[920.42412, "o", "\u001b[?2004h> "]
[920.424178, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[920.424212, "o", "\u001b[?2004h> "]
[920.424239, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[920.424267, "o", "\u001b[?2004h> "]
[920.424294, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.424372, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[920.424398, "o", "\u001b[?2004h> "]
[920.424447, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[920.424476, "o", "\u001b[?2004h> "]
[920.424515, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[920.424544, "o", "\u001b[?2004h> "]
[920.424579, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[920.424607, "o", "\u001b[?2004h> "]
[920.424643, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[920.424671, "o", "\u001b[?2004h> "]
[920.424695, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[920.424719, "o", "\u001b[?2004h> "]
[920.424769, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[920.424796, "o", "\u001b[?2004h> "]
[920.424848, "o", "    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[920.424874, "o", "\u001b[?2004h> "]
[920.42492, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[920.424946, "o", "\u001b[?2004h> "]
[920.424973, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[920.424999, "o", "\u001b[?2004h> "]
[920.425026, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.425051, "o", "> "]
[920.425078, "o", "        b = tl.load(B_ptr)\r\n\u001b[?2004l\r"]
[920.425103, "o", "\u001b[?2004h> "]
[920.425158, "o", "        acc = tl.dot(a.to(DOT_DTYPE), b.to(DOT_DTYPE), acc)\r\n\u001b[?2004l\r"]
[920.425184, "o", "\u001b[?2004h> "]
[920.425216, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[920.425244, "o", "\u001b[?2004h> "]
[920.425273, "o", "        B_ptr += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.425333, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.425361, "o", "> "]
[920.425389, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.425463, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[920.42549, "o", "\u001b[?2004h> "]
[920.425514, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[920.425541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.425578, "o", "M,N,K=16384,4096,4096\r\n\u001b[?2004l\r"]
[920.425605, "o", "\u001b[?2004h> "]
[920.425632, "o", "x32 = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r"]
[920.42566, "o", "\u001b[?2004h> "]
[920.425693, "o", "x16 = x32.half(); xb = x32.bfloat16()\r\n\u001b[?2004l\r"]
[920.425721, "o", "\u001b[?2004h> "]
[920.425783, "o", "wt16 = (torch.rand(N,K,device=dev)*1.5).t().contiguous().half()\r\n\u001b[?2004l\r"]
[920.425812, "o", "\u001b[?2004h> "]
[920.425878, "o", "wtb = (torch.rand(N,K,device=dev)*1.5).t().contiguous().bfloat16()\r\n\u001b[?2004l\r"]
[920.425901, "o", "\u001b[?2004h> "]
[920.425942, "o", "bias16 = torch.rand(N,device=dev).half()\r\n\u001b[?2004l\r"]
[920.425971, "o", "\u001b[?2004h> "]
[920.425999, "o", "bias32 = torch.rand(N,device=dev)\r\n\u001b[?2004l\r"]
[920.426023, "o", "\u001b[?2004h> "]
[920.426066, "o", "out32 = torch.empty(M,N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.426094, "o", "> "]
[920.426139, "o", "out16 = torch.empty(M,N,device=dev,dtype=torch.half)\r\n\u001b[?2004l\r"]
[920.426167, "o", "\u001b[?2004h> "]
[920.426197, "o", "grid=((M//128)*(N//256),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.426223, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.426249, "o", "def f_mm16():\r\n\u001b[?2004l\r"]
[920.426274, "o", "\u001b[?2004h> "]
[920.426334, "o", "    torch.mm(x16, wt16, out=out16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.426368, "o", "def f_cublas():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.426397, "o", "    xh = x32.half()\r\n\u001b[?2004l\r"]
[920.426417, "o", "\u001b[?2004h> "]
[920.426464, "o", "    oh = torch.addmm(bias16, xh, wt16)\r\n\u001b[?2004l\r"]
[920.426483, "o", "\u001b[?2004h> "]
[920.426503, "o", "    return oh.float()\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.426523, "o", "> "]
[920.426543, "o", "def f_triton_fp16():\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.426563, "o", "> "]
[920.426585, "o", "    xh = x32.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.426607, "o", "> "]
[920.426841, "o", "    _k[grid](xh, wt16, bias32, out32, M,N,K, xh.stride(0),xh.stride(1), wt16.stride(0),wt16.stride(1), out32.stride(0),out32.stride(1), BM=128,BN=256,BK=64,GROUP=8,DOT_DTYPE=tl.float16,num_warps=8,num_stages=4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.42687, "o", "    return out32\r\n\u001b[?2004l\r"]
[920.426891, "o", "\u001b[?2004h> "]
[920.426921, "o", "def f_triton_bf16():\r\n\u001b[?2004l\r"]
[920.426942, "o", "\u001b[?2004h> "]
[920.426961, "o", "    xbb = x32.bfloat16()\r\n\u001b[?2004l\r"]
[920.426981, "o", "\u001b[?2004h> "]
[920.427225, "o", "    _k[grid](xbb, wtb, bias32, out32, M,N,K, xbb.stride(0),xbb.stride(1), wtb.stride(0),wtb.stride(1), out32.stride(0),out32.stride(1), BM=128,BN=256,BK=64,GROUP=8,DOT_DTYPE=tl.bfloat16,num_warps=8,num_stages=4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.427257, "o", "    return out32\r\n\u001b[?2004l\r"]
[920.427281, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[920.427305, "o", "> "]
[920.427351, "o", "print('pure mm fp16 no bias:', bench(f_mm16))\r\n\u001b[?2004l\r"]
[920.427378, "o", "\u001b[?2004h> "]
[920.427429, "o", "print('cublas addmm fp16 + casts:', bench(f_cublas))\r\n\u001b[?2004l\r"]
