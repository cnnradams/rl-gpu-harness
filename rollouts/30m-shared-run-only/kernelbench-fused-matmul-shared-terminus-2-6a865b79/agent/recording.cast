[1193.791758, "i", "grep -n -A 20 \"def get_tolerance_for_precision\" /usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\n"]
[1193.792181, "o", "grep -n -A 20 \"def get_tolerance_for_precision\" /usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\r\n\u001b[?2004l\r"]
[1193.793166, "o", "\u001b[32m\u001b[K83\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef get_tolerance_for_precision\u001b[m\u001b[K(precision: str | torch.dtype) -> float:\r\n\u001b[32m\u001b[K84\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K85\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Get the tolerance from a string representing the percision.\r\n\u001b[32m\u001b[K86\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    These tolerances are inspired by torchbench (PyTorch Benchmarking Suite): \r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Reference:\r\n\u001b[32m\u001b[K88\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    https://github.com/pytorch/benchmark/blob/cfd835c35d04513ced9a59bd074eeb21dc8187d7/torchbenchmark/util/env_check.py#L519\r\n\u001b[32m\u001b[K89\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n"]
[1193.793221, "o", "\u001b[32m\u001b[K90\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if isinstance(precision, str):\r\n\u001b[32m\u001b[K91\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        precision = get_torch_dtype_from_string(precision)\r\n\u001b[32m\u001b[K92\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K93\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    PRECISION_TOLERANCES = {\r\n\u001b[32m\u001b[K94\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # By default for fp32, 1e-4 is used according to torchbench.\r\n\u001b[32m\u001b[K95\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.float32: 1e-4,\r\n\u001b[32m\u001b[K96\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # torchbench states for bf16 and fp16, use 1e-3 as tolerance and 1e-2 if it's too strict. \r\n\u001b[32m\u001b[K97\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # @todo: Let user configure own tolerance as an option\r\n\u001b[32m\u001b[K98\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.float16: 1e-2, \r\n\u001b[32m\u001b[K99\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.bfloat16: 1e-2,\r\n\u001b[32m\u001b[K100\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    }\r\n\u001b[32m\u001b[K101\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    assert precision in PRECISION_TOLERANCES, f\"Invalid precision not supported: {precision}\"\r\n\u001b[32m\u001b[K102\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return PRECISION_TOLERANCES[precision]\r\n\u001b[32m\u001b[K103\u001b[m\u001b[K\u001b"]
[1193.793257, "o", "[36m\u001b[K-\u001b[m\u001b[K    \r\n"]
