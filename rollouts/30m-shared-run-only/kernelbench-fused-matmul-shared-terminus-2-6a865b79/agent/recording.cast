[1130.861626, "o", "> "]
[1130.861684, "o", "    and cached (as plain attributes so Module.to() does not touch them).\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.861724, "o", "> "]
[1130.861786, "o", "    The GEMM runs on bf16 tensor cores with fp32 accumulation; a single fused\r\n\u001b[?2004l\r\u001b[?2004h"]
[1130.861827, "o", "> "]
