[1509.856506, "o", "box: sb-ByP3pwhEErSrMkkDHPoAWK\r\ncommand: 24c40288d81546259595fffb1920bc82\r\n"]
[1516.893421, "o", "FOUR=True 3.151 ms BM=256 BN=128 BK=64 GROUP=8 stages=3\r\nFOUR=True 3.204 ms BM=128 BN=256 BK=32 GROUP=8 stages=5\r\nFOUR=True 3.225 ms BM=128 BN=256 BK=32 GROUP=16 stages=5\r\nFOUR=False 2.627 ms BM=256 BN=128 BK=64 GROUP=8 stages=3\r\nFOUR=False 2.680 ms BM=128 BN=256 BK=32 GROUP=8 stages=5\r\nFOUR=False 2.652 ms BM=128 BN=256 BK=32 GROUP=16 stages=5\r\n--- robustness, FOUR=True, 256/128/64/g8/s3 ---\r\nseed 0: max_diff 8.202e-05 ratio 0.570\r\nseed 1: max_diff 8.059e-05 ratio 0.573\r\nseed 2: max_diff 7.820e-05 ratio 0.624\r\nseed 3: max_diff 7.200e-05 ratio 0.561\r\nseed 4: max_diff 7.915e-05 ratio 0.568\r\nworst ratio: 0.6242614984512329\r\n"]
[1521.834749, "o", "\u001b[?2004hroot@modal:/# "]
[1584.453937, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _split_fp16_gemm(A, BH, BL, Bias, C, M, N, K,\n                     sam, sak, sbk, sbn, scm, scn,\n                     BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                     GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        a_h"]
[1584.453984, "i", "i = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        A_ptr += BK * sak\n        BH_ptr += BK * sbk\n        BL_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\n\nclass ModelNew(nn.Module):\n    \"\"\"\n    y = linear(x) * s + linear(x) = (1 + s) * (x @ W^T + b)\n\n    The (1+s) factor is folded into the weights once (cached as plain\n    attributes so Module.to() never disturbs them).  The GEMM runs on\n    fp16 tensor cores using an error-compensated hi/lo split of both\n    operands (3 dots with fp32 accumulation), which keeps the result\n    within ~8e-5 of the fp32 reference while being ~4x faster than\n    the default fp32 cuBLAS path on H100.\n    \"\"\"\n\n    def __init__(self, in_features, out_fea"]
[1584.454141, "i", "tures, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._w32 = None\n        self._bh = None\n        self._bl = None\n        self._b32 = None\n\n    @torch.no_grad()\n    def _build_cache(self, x):\n        c = 1.0 + float(self.scaling_factor)\n        w = self.matmul.weight.detach().to(x.device, torch.float32)\n        b = self.matmul.bias.detach().to(x.device, torch.float32)\n        w = (w * c).contiguous()\n        b = (b * c).contiguous()\n        wt = w.t().contiguous()\n        bh = wt.to(torch.float16)\n        bl = (wt - bh.to(torch.float32)).to(torch.float16)\n        self._w32 = wt\n        self._bh = bh\n        self._bl = bl\n        self._b32 = b\n\n    @torch.no_grad()\n    def forward(self, x):\n        if self._b32 is None or self._b32.device != x.device:\n            self._build_cache(x)\n        M, K = x.shape\n        N = self._b32.shape[0]\n        if (x.dtype == torch.float32 and x.is_cuda\n           "]
[1584.454161, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1584.454215, "i", "     and M % 256 == 0 and N % 128 == 0 and K % 64 == 0):\n            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n            grid = ((M // 256) * (N // 128),)\n            _split_fp16_gemm[grid](\n                x, self._bh, self._bl, self._b32, out, M, N, K,\n                x.stride(0), x.stride(1),\n                self._bh.stride(0), self._bh.stride(1),\n                out.stride(0), out.stride(1),\n                BM=256, BN=128, BK=64, GROUP=8,\n                num_warps=8, num_stages=3,\n            )\n            return out\n        # exact fp32 fallback for any other shape/dtype\n        return torch.addmm(self._b32.to(x.dtype), x, self._w32.to(x.dtype))\nEOF\n"]
