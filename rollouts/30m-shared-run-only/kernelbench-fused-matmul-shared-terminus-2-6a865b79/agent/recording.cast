[1361.324539, "o", "3.036 ms BM=128 BN=256 BK=32 GROUP=16 stages=4 warps=8\r\n3.070 ms BM=128 BN=256 BK=32 GROUP=8 stages=4 warps=8\r\n3.314 ms BM=128 BN=256 BK=32 GROUP=8 stages=3 warps=8\r\n3.317 ms BM=128 BN=256 BK=32 GROUP=16 stages=3 warps=8\r\n3.356 ms BM=128 BN=128 BK=64 GROUP=8 stages=4 warps=8\r\n3.372 ms BM=128 BN=128 BK=64 GROUP=16 stages=4 warps=8\r\nsplit-fp16 max_diff: 7.49826431274414e-05 allclose(1e-4): True\r\n"]
[1366.287899, "o", "\u001b[?2004hroot@modal:/# "]
[1419.039325, "i", "cat > /workspace/tune5.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev='cuda'\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n\ndef bench(fn, trials=10):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if t>=1: times.append(s.elapsed_time(e))\n    times.sort(); return sum(times)/len(times)\n\n@triton.jit\ndef _k3p(A, BH, BL, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\n         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_s"]
[1419.039376, "i", "ize)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        A_ptr += BK * sak\n        BH_ptr += BK * sbk\n        BL_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef split16(t):\n    hi = t.half()\n    lo = (t - hi.float()).half()\n    return hi, lo\n\nM,N,K=16384,4096,409"]
[1419.039386, "i", "6\ntorch.manual_seed(0)\nwt = torch.randn(N,K,device=dev) / (K**0.5)\nbias0 = torch.randn(N,device=dev)\nc = 1.5\nwtT = (wt*c).t().contiguous()\nbh, bl = split16(wtT)\nbias32 = (bias0*c).contiguous()\nout32 = torch.empty(M,N,device=dev)\n\nres=[]\nfor (bm,bn,bk) in [(128,256,64),(128,256,32),(256,128,64),(128,128,64),(64,256,64),(256,256,32),(128,64,64),(256,64,64)]:\n    for grp in [8,16]:\n        for st in [3,4,5]:\n            if M%bm or N%bn or K%bk: continue\n            grid=((M//bm)*(N//bn),)\n            def f(x32):\n                _k3p[grid](x32, bh, bl, bias32, out32, M,N,K, x32.stride(0),x32.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\n                return out32\n            x0 = torch.rand(M,K,device=dev)\n            try:\n                res.append((bench(lambda: f(x0)),bm,bn,bk,grp,st))\n            except Exception:\n                pass\nres.sort()\nfor r in res[:8]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} s"]
[1419.039524, "i", "tages={r[5]}')\n\nbm,bn,bk,grp,st = res[0][1:]\ngrid=((M//bm)*(N//bn),)\nworst=0.0\nfor seed in range(5):\n    torch.manual_seed(100+seed)\n    x = torch.rand(M,K,device=dev)\n    _k3p[grid](x, bh, bl, bias32, out32, M,N,K, x.stride(0),x.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\n    ref = (torch.nn.functional.linear(x, wt, bias0)) * c\n    ratio = ((ref-out32).abs()/(1e-4 + 1e-4*ref.abs())).max().item()\n    md = (ref-out32).abs().max().item()\n    worst = max(worst, ratio)\n    print(f'seed {seed}: max_diff {md:.3e} violation_ratio {ratio:.3f} pass {ratio<1.0}')\nprint('worst ratio:', worst)\nEOF\n"]
