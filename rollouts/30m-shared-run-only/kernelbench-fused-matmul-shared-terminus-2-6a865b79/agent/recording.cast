[902.981625, "o", "=== fp32 A loads, in-kernel cast ===\r\n0.964 ms  BM=128 BN=256 BK=64 stages=3 warps=8\r\n0.966 ms  BM=128 BN=256 BK=64 stages=4 warps=8\r\n1.193 ms  BM=64 BN=256 BK=64 stages=4 warps=4\r\n1.268 ms  BM=256 BN=128 BK=32 stages=4 warps=8\r\n1.273 ms  BM=128 BN=256 BK=32 stages=5 warps=8\r\n1.274 ms  BM=128 BN=256 BK=32 stages=4 warps=8\r\n1.280 ms  BM=64 BN=256 BK=64 stages=4 warps=8\r\n1.316 ms  BM=256 BN=128 BK=32 stages=5 warps=8\r\n=== fp16 A pre-cast (includes cast kernel in timing) ===\r\n0.902 ms  BM=128 BN=256 BK=64 stages=4 warps=8\r\n0.919 ms  BM=128 BN=256 BK=32 stages=5 warps=8\r\n0.945 ms  BM=256 BN=128 BK=32 stages=5 warps=8\r\n0.950 ms  BM=256 BN=128 BK=64 stages=4 warps=8\r\n0.951 ms  BM=128 BN=256 BK=32 stages=4 warps=8\r\n0.969 ms  BM=128 BN=256 BK=64 stages=3 warps=8\r\n0.985 ms  BM=256 BN=128 BK=64 stages=3 warps=8\r\n0.991 ms  BM=256 BN=128 BK=32 stages=4 warps=8\r\n"]
[907.90543, "o", "\u001b[?2004hroot@modal:/# "]
[920.422564, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev='cuda'\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n\ndef bench(fn, trials=10):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if t>=1: times.append(s.elapsed_time(e))\n    times.sort(); return sum(times)/len(times)\n\n@triton.jit\ndef _k(A, B, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\n       DOT_DTYPE: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id *"]
[920.422611, "i", " GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        b = tl.load(B_ptr)\n        acc = tl.dot(a.to(DOT_DTYPE), b.to(DOT_DTYPE), acc)\n        A_ptr += BK * sak\n        B_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\nM,N,K=16384,4096,4096\nx32 = torch.rand(M,K,device=dev)\nx16 = x32.half(); xb = x32.bfloat16()\nwt16 = (torch.rand(N,K,device=dev)*1.5).t().contiguous().half()\nwtb = (torch.rand(N,K,device=dev)*1.5).t().contiguous().bfloat16()\nbias16 = torch.rand(N,device=dev).half()\nbias32 = torch.rand(N,device=dev)\nout32 = torch.empty(M,N,device=dev)\nout16 = tor"]
[920.422618, "i", "ch.empty(M,N,device=dev,dtype=torch.half)\ngrid=((M//128)*(N//256),)\n\ndef f_mm16():\n    torch.mm(x16, wt16, out=out16)\ndef f_cublas():\n    xh = x32.half()\n    oh = torch.addmm(bias16, xh, wt16)\n    return oh.float()\ndef f_triton_fp16():\n    xh = x32.half()\n    _k[grid](xh, wt16, bias32, out32, M,N,K, xh.stride(0),xh.stride(1), wt16.stride(0),wt16.stride(1), out32.stride(0),out32.stride(1), BM=128,BN=256,BK=64,GROUP=8,DOT_DTYPE=tl.float16,num_warps=8,num_stages=4)\n    return out32\ndef f_triton_bf16():\n    xbb = x32.bfloat16()\n    _k[grid](xbb, wtb, bias32, out32, M,N,K, xbb.stride(0),xbb.stride(1), wtb.stride(0),wtb.stride(1), out32.stride(0),out32.stride(1), BM=128,BN=256,BK=64,GROUP=8,DOT_DTYPE=tl.bfloat16,num_warps=8,num_stages=4)\n    return out32\n\nprint('pure mm fp16 no bias:', bench(f_mm16))\nprint('cublas addmm fp16 + casts:', bench(f_cublas))\nprint('triton fp16 precast:', bench(f_triton_fp16))\nprint('triton bf16 precast:', bench(f_triton_bf16))\nEOF\n"]
[920.422724, "o", "cat > /workspace/tune2.py << 'EOF'\r\n\u001b[?2004l\r"]
[920.422767, "o", "\u001b[?2004h> "]
[920.422827, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[920.422864, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.422886, "o", "dev='cuda'\r\n\u001b[?2004l\r"]
[920.422915, "o", "\u001b[?2004h> "]
[920.422934, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[920.423042, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device=dev); d.fill_(42); del d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[920.423073, "o", "\u001b[?2004h> "]
[920.423098, "o", "def bench(fn, trials=10):\r\n\u001b[?2004l\r"]
[920.423124, "o", "\u001b[?2004h> "]
[920.423178, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[920.423214, "o", "\u001b[?2004h>     times=[]\r\n\u001b[?2004l\r"]
[920.423242, "o", "\u001b[?2004h> "]
[920.423276, "o", "    for t in range(trials+1):\r\n\u001b[?2004l\r"]
