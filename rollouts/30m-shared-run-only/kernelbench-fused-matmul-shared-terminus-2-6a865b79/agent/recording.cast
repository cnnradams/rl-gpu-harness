[1419.044363, "o", "\u001b[?2004h> res=[]\r\n\u001b[?2004l\r"]
[1419.044389, "o", "\u001b[?2004h> "]
[1419.044519, "o", "for (bm,bn,bk) in [(128,256,64),(128,256,32),(256,128,64),(128,128,64),(64,256,64),(256,256,32),(128,64,64),(256,64,64)]:\r\n\u001b[?2004l\r"]
[1419.044547, "o", "\u001b[?2004h> "]
[1419.044575, "o", "    for grp in [8,16]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.044626, "o", "        for st in [3,4,5]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.044657, "o", "> "]
[1419.0447, "o", "            if M%bm or N%bn or K%bk: continue\r\n\u001b[?2004l\r"]
[1419.044727, "o", "\u001b[?2004h> "]
[1419.044765, "o", "            grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.044796, "o", "> "]
[1419.044827, "o", "            def f(x32):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.045067, "o", "                _k3p[grid](x32, bh, bl, bias32, out32, M,N,K, x32.stride(0),x32.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.045125, "o", "                return out32\r\n\u001b[?2004l\r"]
[1419.04515, "o", "\u001b[?2004h> "]
[1419.045193, "o", "            x0 = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r"]
[1419.045218, "o", "\u001b[?2004h> "]
[1419.045244, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.045336, "o", "                res.append((bench(lambda: f(x0)),bm,bn,bk,grp,st))\r\n\u001b[?2004l\r"]
[1419.045362, "o", "\u001b[?2004h> "]
[1419.045388, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[1419.045414, "o", "\u001b[?2004h> "]
[1419.04544, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.045464, "o", "res.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.045491, "o", "> "]
[1419.045584, "o", "for r in res[:8]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} stages={r[5]}')\r\n\u001b[?2004l\r"]
[1419.04562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.045659, "o", "bm,bn,bk,grp,st = res[0][1:]\r\n\u001b[?2004l\r"]
[1419.045683, "o", "\u001b[?2004h> "]
[1419.045711, "o", "grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r"]
[1419.045735, "o", "\u001b[?2004h> worst=0.0\r\n\u001b[?2004l\r"]
[1419.045761, "o", "\u001b[?2004h> "]
[1419.045789, "o", "for seed in range(5):\r\n\u001b[?2004l\r"]
[1419.045817, "o", "\u001b[?2004h> "]
[1419.045851, "o", "    torch.manual_seed(100+seed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.04588, "o", "> "]
[1419.045907, "o", "    x = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r"]
[1419.045929, "o", "\u001b[?2004h> "]
[1419.046135, "o", "    _k3p[grid](x, bh, bl, bias32, out32, M,N,K, x.stride(0),x.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.046162, "o", "> "]
[1419.046213, "o", "    ref = (torch.nn.functional.linear(x, wt, bias0)) * c\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.046243, "o", "> "]
[1419.046319, "o", "    ratio = ((ref-out32).abs()/(1e-4 + 1e-4*ref.abs())).max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.046345, "o", "> "]
[1419.04637, "o", "    md = (ref-out32).abs().max().item()\r\n\u001b[?2004l\r"]
[1419.046395, "o", "\u001b[?2004h> "]
[1419.046431, "o", "    worst = max(worst, ratio)\r\n\u001b[?2004l\r"]
[1419.046457, "o", "\u001b[?2004h> "]
[1419.046551, "o", "    print(f'seed {seed}: max_diff {md:.3e} violation_ratio {ratio:.3f} pass {ratio<1.0}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.046578, "o", "> "]
[1419.046607, "o", "print('worst ratio:', worst)\r\n\u001b[?2004l\r"]
[1419.046636, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
