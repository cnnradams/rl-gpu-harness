[467.570712, "i", "cat > /workspace/sol_triton.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _fused_mm(A, B, Bias, C, M, N, K,\n              sam, sak, sbk, sbn, scm, scn,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n              GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        b = tl.load(B_ptr)\n        acc = tl.dot(a.to(tl.float16), b, acc)\n        A_ptr += BK * sak\n"]
[467.570765, "i", "        B_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._wt = None\n        self._b = None\n\n    @torch.no_grad()\n    def forward(self, x):\n        if self._wt is None or self._wt.device != x.device:\n            c = 1.0 + float(self.scaling_factor)\n            w = self.matmul.weight.detach().to(x.device, torch.float32)\n            b = self.matmul.bias.detach().to(x.device, torch.float32)\n            self._wt = (w * c).t().contiguous().to(torch.float16)\n            self._b = (b * c).contiguous()\n        M, K = x.shape\n        N = self._wt.shape[1]\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        if M % 128 == 0 and N % 256 ="]
[467.57118, "i", "= 0 and K % 64 == 0:\n            grid = ((M // 128) * (N // 256),)\n            _fused_mm[grid](x, self._wt, self._b, out, M, N, K,\n                            x.stride(0), x.stride(1),\n                            self._wt.stride(0), self._wt.stride(1),\n                            out.stride(0), out.stride(1),\n                            BM=128, BN=256, BK=64, GROUP=8,\n                            num_warps=8, num_stages=3)\n        else:\n            xh = x.to(torch.float16)\n            oh = torch.addmm(self._b.to(torch.float16), xh, self._wt)\n            out = oh.to(torch.float32)\n        return out\nEOF\n"]
