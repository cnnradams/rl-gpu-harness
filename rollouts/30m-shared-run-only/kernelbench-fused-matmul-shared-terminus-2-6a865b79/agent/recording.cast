[543.703454, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef _k(A, B, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\n       CAST: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        b = tl.load(B_ptr)\n        if CAST:\n            a = a.to(tl.float16)\n        acc = tl.dot(a, b, acc)\n        A_ptr += BK * sak\n        B_ptr += BK * sb"]
[543.703508, "i", "k\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef clear_l2(device):\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device=device); d.fill_(42); del d\n\ndef bench(fn, trials=10):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2(x.device)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if t>=1: times.append(s.elapsed_time(e))\n    times.sort(); return sum(times)/len(times)\n\nM=N=K=4096; M=16384\nx32 = torch.rand(M,K,device='cuda')\nx16 = x32.half()\nwt = (torch.rand(N,K,device='cuda')*1.5).t().contiguous().half()\nbias = torch.rand(N,device='cuda')\nout = torch.empty(M,N,device='cuda')\n\nconfigs = []\nfor (bm,bn,bk) in [(128,256,64),(128,256,32),(256,128,64),(256,128,32),(128,128,64),(128,128,128),(2"]
[543.70352, "i", "56,64,64),(64,256,64),(128,64,64),(64,128,64),(256,256,64),(128,512,64)]:\n    for st in [2,3,4,5]:\n        for wp in [4,8]:\n            configs.append((bm,bn,bk,st,wp))\n\nprint('=== fp32 A loads, in-kernel cast ===')\nresults=[]\nfor (bm,bn,bk,st,wp) in configs:\n    if M%bm or N%bn or K%bk: continue\n    grid=((M//bm)*(N//bn),)\n    def f():\n        _k[grid](x32, wt, bias, out, M,N,K, x32.stride(0),x32.stride(1), wt.stride(0),wt.stride(1), out.stride(0),out.stride(1), BM=bm,BN=bn,BK=bk,GROUP=8,CAST=True,num_warps=wp,num_stages=st)\n    try:\n        t=bench(f)\n        results.append((t,bm,bn,bk,st,wp))\n    except Exception as ex:\n        pass\nresults.sort()\nfor r in results[:8]: print(f'{r[0]:.3f} ms  BM={r[1]} BN={r[2]} BK={r[3]} stages={r[4]} warps={r[5]}')\n\nprint('=== fp16 A pre-cast (includes cast kernel in timing) ===')\nresults=[]\nfor (bm,bn,bk,st,wp) in configs:\n    if M%bm or N%bn or K%bk: continue\n    grid=((M//bm)*(N//bn),)\n    def f():\n        xh = x32.half()\n        _k[grid](xh, wt, bias, out, M,N,K, xh.s"]
[543.703652, "i", "tride(0),xh.stride(1), wt.stride(0),wt.stride(1), out.stride(0),out.stride(1), BM=bm,BN=bn,BK=bk,GROUP=8,CAST=False,num_warps=wp,num_stages=st)\n    try:\n        t=bench(f)\n        results.append((t,bm,bn,bk,st,wp))\n    except Exception as ex:\n        pass\nresults.sort()\nfor r in results[:8]: print(f'{r[0]:.3f} ms  BM={r[1]} BN={r[2]} BK={r[3]} stages={r[4]} warps={r[5]}')\nEOF\n"]
