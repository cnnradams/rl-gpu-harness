[1461.712814, "o", "2.617 ms BM=256 BN=128 BK=64 GROUP=8 stages=3\r\n2.625 ms BM=128 BN=256 BK=32 GROUP=8 stages=5\r\n2.633 ms BM=128 BN=256 BK=32 GROUP=16 stages=5\r\n2.656 ms BM=256 BN=128 BK=64 GROUP=16 stages=3\r\n2.711 ms BM=128 BN=256 BK=32 GROUP=16 stages=3\r\n2.719 ms BM=128 BN=256 BK=32 GROUP=8 stages=3\r\n2.724 ms BM=128 BN=128 BK=64 GROUP=8 stages=3\r\n2.766 ms BM=128 BN=128 BK=64 GROUP=16 stages=3\r\nseed 0: max_diff 8.202e-05 violation_ratio 0.570 pass True\r\nseed 1: max_diff 8.059e-05 violation_ratio 0.573 pass True\r\nseed 2: max_diff 7.820e-05 violation_ratio 0.624 pass True\r\nseed 3: max_diff 7.200e-05 violation_ratio 0.561 pass True\r\nseed 4: max_diff 7.915e-05 violation_ratio 0.568 pass True\r\nworst ratio: 0.6242614984512329\r\n"]
