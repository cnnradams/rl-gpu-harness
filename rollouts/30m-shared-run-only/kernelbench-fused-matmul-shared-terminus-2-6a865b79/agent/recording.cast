[299.519743, "i", "cat > /workspace/sol_fp16.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._wh = None\n        self._bh = None\n\n    @torch.no_grad()\n    def forward(self, x):\n        if self._wh is None or self._wh.device != x.device:\n            c = 1.0 + float(self.scaling_factor)\n            w = self.matmul.weight.detach()\n            b = self.matmul.bias.detach()\n            self._wh = (w.to(x.device, torch.float32) * c).to(torch.float16).contiguous()\n            self._bh = (b.to(x.device, torch.float32) * c).to(torch.float16).contiguous()\n        xh = x.to(torch.float16)\n        oh = torch.addmm(self._bh, xh, self._wh.t())\n        return oh.to(torch.float32)\nEOF\n"]
