[1419.043238, "o", "> "]
[1419.043267, "o", "        BH_ptr += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.043312, "o", "        BL_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[1419.043332, "o", "\u001b[?2004h> "]
[1419.043386, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[1419.043414, "o", "\u001b[?2004h> "]
[1419.043445, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1419.043474, "o", "\u001b[?2004h> "]
[1419.043525, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.043555, "o", "> "]
[1419.043585, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.043621, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.043644, "o", "def split16(t):\r\n\u001b[?2004l\r"]
[1419.043672, "o", "\u001b[?2004h> "]
[1419.0437, "o", "    hi = t.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.043728, "o", "> "]
[1419.043756, "o", "    lo = (t - hi.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.043782, "o", "> "]
[1419.043814, "o", "    return hi, lo\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.043839, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.043865, "o", "M,N,K=16384,4096,4096\r\n\u001b[?2004l\r"]
[1419.043891, "o", "\u001b[?2004h> "]
[1419.043918, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[1419.043944, "o", "\u001b[?2004h> "]
[1419.043991, "o", "wt = torch.randn(N,K,device=dev) / (K**0.5)\r\n\u001b[?2004l\r"]
[1419.044017, "o", "\u001b[?2004h> "]
[1419.044056, "o", "bias0 = torch.randn(N,device=dev)\r\n\u001b[?2004l\r"]
[1419.044081, "o", "\u001b[?2004h> c = 1.5\r\n\u001b[?2004l\r"]
[1419.044104, "o", "\u001b[?2004h> "]
[1419.044141, "o", "wtT = (wt*c).t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1419.04417, "o", "> "]
[1419.044196, "o", "bh, bl = split16(wtT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1419.044247, "o", "bias32 = (bias0*c).contiguous()\r\n\u001b[?2004l\r"]
[1419.044276, "o", "\u001b[?2004h> "]
