[1499.162849, "o", "    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1499.162887, "o", "\u001b[?2004h> "]
[1499.162926, "o", "    BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1499.162959, "o", "\u001b[?2004h> "]
[1499.162998, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1499.163037, "o", "\u001b[?2004h> "]
[1499.163072, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.163108, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.163157, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1499.16319, "o", "> "]
[1499.16324, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1499.163279, "o", "\u001b[?2004h> "]
[1499.163319, "o", "        b_hi = tl.load(BH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.163352, "o", "        b_lo = tl.load(BL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1499.163393, "o", "> "]
[1499.163426, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.163465, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[1499.163497, "o", "\u001b[?2004h> "]
[1499.163535, "o", "        acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[1499.163567, "o", "\u001b[?2004h> "]
[1499.163612, "o", "        if FOUR:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.16365, "o", "            acc = tl.dot(a_lo, b_lo, acc)\r\n\u001b[?2004l\r"]
[1499.163686, "o", "\u001b[?2004h> "]
[1499.163719, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.163759, "o", "        BH_ptr += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.163798, "o", "        BL_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[1499.163837, "o", "\u001b[?2004h> "]
[1499.163875, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[1499.16391, "o", "\u001b[?2004h> "]
[1499.163949, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.164006, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1499.164044, "o", "\u001b[?2004h>     tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[1499.164082, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1499.164118, "o", "\u001b[?2004h> def split16(t):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.164157, "o", "    hi = t.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.164207, "o", "    lo = (t - hi.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1499.164242, "o", ">     return hi, lo\r\n\u001b[?2004l\r"]
[1499.164275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.164313, "o", "M,N,K=16384,4096,4096\r\n\u001b[?2004l\r"]
[1499.164351, "o", "\u001b[?2004h> "]
[1499.164393, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.16444, "o", "wt = torch.randn(N,K,device=dev) / (K**0.5)\r\n\u001b[?2004l\r"]
[1499.164474, "o", "\u001b[?2004h> "]
[1499.164512, "o", "bias0 = torch.randn(N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.164552, "o", "c = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.16457, "o", "wtT = (wt*c).t().contiguous()\r\n\u001b[?2004l\r"]
[1499.164614, "o", "\u001b[?2004h> "]
[1499.164644, "o", "bh, bl = split16(wtT)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1499.164681, "o", "> "]
[1499.164719, "o", "bias32 = (bias0*c).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.16476, "o", "out32 = torch.empty(M,N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1499.164798, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1499.164837, "o", "def run(x32, bm,bn,bk,grp,st, four):\r\n\u001b[?2004l\r"]
[1499.164874, "o", "\u001b[?2004h> "]
[1499.164912, "o", "    grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.165138, "o", "    _k4p[grid](x32, bh, bl, bias32, out32, M,N,K, x32.stride(0),x32.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,FOUR=four,num_warps=8,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.165179, "o", "    return out32\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1499.165218, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1499.165256, "o", "x0 = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.165296, "o", "for four in [True, False]:\r\n\u001b[?2004l\r"]
[1499.165334, "o", "\u001b[?2004h> "]
[1499.165406, "o", "    for (bm,bn,bk,grp,st) in [(256,128,64,8,3),(128,256,32,8,5),(128,256,32,16,5)]:\r\n\u001b[?2004l\r"]
[1499.165446, "o", "\u001b[?2004h> "]
[1499.165484, "o", "        t = bench(lambda: run(x0,bm,bn,bk,grp,st,four))\r\n\u001b[?2004l\r"]
[1499.165523, "o", "\u001b[?2004h> "]
[1499.165608, "o", "        print(f'FOUR={four} {t:.3f} ms BM={bm} BN={bn} BK={bk} GROUP={grp} stages={st}')\r\n\u001b[?2004l\r"]
[1499.165647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.165702, "o", "print('--- robustness, FOUR=True, 256/128/64/g8/s3 ---')\r\n\u001b[?2004l\r"]
[1499.165741, "o", "\u001b[?2004h> worst=0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.16578, "o", "for seed in range(5):\r\n\u001b[?2004l\r"]
[1499.165855, "o", "\u001b[?2004h> "]
[1499.165899, "o", "    torch.manual_seed(100+seed)\r\n\u001b[?2004l\r\u001b[?2004h>     x = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.16595, "o", "    run(x,256,128,64,8,3,True)\r\n\u001b[?2004l\r"]
[1499.165991, "o", "\u001b[?2004h> "]
[1499.166032, "o", "    ref = (torch.nn.functional.linear(x, wt, bias0)) * c\r\n\u001b[?2004l\r"]
[1499.166072, "o", "\u001b[?2004h> "]
[1499.166131, "o", "    ratio = ((ref-out32).abs()/(1e-4 + 1e-4*ref.abs())).max().item()\r\n\u001b[?2004l\r"]
[1499.166164, "o", "\u001b[?2004h> "]
[1499.166204, "o", "    md = (ref-out32).abs().max().item()\r\n\u001b[?2004l\r"]
[1499.166243, "o", "\u001b[?2004h> "]
[1499.166285, "o", "    worst = max(worst, ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1499.166363, "o", "    print(f'seed {seed}: max_diff {md:.3e} ratio {ratio:.3f}')\r\n\u001b[?2004l\r"]
[1499.166402, "o", "\u001b[?2004h> "]
[1499.166443, "o", "print('worst ratio:', worst)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1499.168031, "o", "\u001b[?2004hroot@modal:/# "]
[1499.44323, "i", "gpu run -- python3 /workspace/tune6.py\n"]
[1499.443429, "o", "gpu run -- python3 /workspace/tune6.py\r\n\u001b[?2004l\r"]
