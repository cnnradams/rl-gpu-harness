[299.821631, "i", "cat > /workspace/bench.py << 'EOF'\nimport importlib.util, sys, torch\n\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    m = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(m)\n    return m\n\nModel = load('/opt/task/reference.py', 'reference').Model\n\ndef clear_l2(device):\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device=device)\n    dummy.fill_(42)\n    del dummy\n\ndef timeit(model, x, trials=20):\n    device = x.device\n    for _ in range(3):\n        model(x); torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    times = []\n    for t in range(trials+1):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2(device)\n        s.record()\n        model(x)\n        e.record()\n        torch.cuda.synchronize()\n        if t >= 1:\n            times.append(s.elapsed_time(e))\n    times.sort()\n    return sum(times)/len(times), times[0], times[-1]\n\ndef main(path):\n    ca"]
[299.821831, "i", "nd = load(path, 'cand')\n    torch.manual_seed(42); mref = Model(4096,4096,0.5).cuda()\n    torch.manual_seed(42); mnew = cand.ModelNew(4096,4096,0.5).cuda()\n    torch.manual_seed(123)\n    x = torch.rand(16384,4096,device='cuda')\n    with torch.no_grad():\n        o1 = mref(x)\n    o2 = mnew(x)\n    ok = torch.allclose(o1.float(), o2.float(), atol=1e-2, rtol=1e-2)\n    md = (o1.float()-o2.float()).abs().max().item()\n    print('correct:', ok, 'max_diff:', md)\n    tnew = timeit(mnew, x)\n    tref = timeit(mref, x)\n    print(f'cand: mean {tnew[0]:.3f} ms (min {tnew[1]:.3f} max {tnew[2]:.3f})')\n    print(f'ref : mean {tref[0]:.3f} ms (min {tref[1]:.3f} max {tref[2]:.3f})')\n    print(f'speedup: {tref[0]/tnew[0]:.2f}x')\n\nmain(sys.argv[1])\nEOF\n"]
[299.821851, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
