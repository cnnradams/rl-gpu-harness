[1604.285758, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.61,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.61,\r\n    \"std\": 0.0123,\r\n    \"min\": 2.59,\r\n    \"max\": 2.65,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0396,\r\n    \"min\": 11.3,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"b4a938bbb3059db729bb8e6d373b64ab4a0940f2f7ce4dad73317eabba9aeb8d\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.367816091954023\r\n}\r\n"]
[1610.622591, "o", "\u001b[?2004hroot@modal:/# "]
[1664.771291, "i", "cat > /workspace/tune7.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev='cuda'\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device=dev); d.fill_(42); del d\n\ndef bench(fn, trials=10):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if t>=1: times.append(s.elapsed_time(e))\n    times.sort(); return sum(times)/len(times)\n\n@triton.jit\ndef _split(A, AH, AL, n, BLK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLK + tl.arange(0, BLK)\n    a = tl.load(A + off)\n    ah = a.to(tl.float16)\n    al = (a - ah.to(tl.float32)).to(tl.float16)\n    tl.store(AH + off, ah)\n    tl.store(AL + off, al)\n\n@triton.jit\ndef _gemm(AH, AL, BH, BL, Bias, C, M, N, K,\n          sam, sak, sbk, sbn, scm, scn,\n          BM: tl.constexpr, BN: t"]
[1664.771335, "i", "l.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\n    AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\n    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a_hi = tl.load(AH_ptr)\n        a_lo = tl.load(AL_ptr)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        AH_ptr += BK * sak\n        AL_ptr"]
[1664.771343, "i", " += BK * sak\n        BH_ptr += BK * sbk\n        BL_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\nM,N,K=16384,4096,4096\ntorch.manual_seed(0)\nwt = torch.randn(N,K,device=dev) / (K**0.5)\nbias0 = torch.randn(N,device=dev)\nc = 1.5\nwtT = (wt*c).t().contiguous()\nbh = wtT.half(); bl = (wtT - bh.float()).half()\nbias32 = (bias0*c).contiguous()\nout32 = torch.empty(M,N,device=dev)\nBLK=4096\nnsplit = (M*K + BLK - 1)//BLK\n\nres=[]\nfor (bm,bn,bk) in [(256,128,64),(128,256,32),(128,256,64),(128,128,64),(256,64,64),(64,256,64),(256,128,32),(128,64,64)]:\n    for grp in [8,16]:\n        for st in [3,4]:\n            for wp in [4,8]:\n                if M%bm or N%bn or K%bk: continue\n                grid=((M//bm)*(N//bn),)\n                def f(x32, ah, al):\n                    _split[(nsplit,)](x32, ah, al, M*K, BLK=BLK, num_warps=8)\n                    _gemm[grid](ah, al, bh, bl, bias32, out32, M,N,K, ah.stri"]
[1664.771349, "i", "de(0),ah.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=wp,num_stages=st)\n                    return out32\n                x0 = torch.rand(M,K,device=dev)\n                ah0 = torch.empty(M,K,device=dev,dtype=torch.half)\n                al0 = torch.empty(M,K,device=dev,dtype=torch.half)\n                try:\n                    res.append((bench(lambda: f(x0, ah0, al0)),bm,bn,bk,grp,st,wp))\n                except Exception:\n                    pass\nres.sort()\nfor r in res[:8]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} stages={r[5]} warps={r[6]}')\n\nbm,bn,bk,grp,st,wp = res[0][1:]\ngrid=((M//bm)*(N//bn),)\nworst=0.0\nfor seed in range(5):\n    torch.manual_seed(100+seed)\n    x = torch.rand(M,K,device=dev)\n    ah = torch.empty(M,K,device=dev,dtype=torch.half)\n    al = torch.empty(M,K,device=dev,dtype=torch.half)\n    _split[(nsplit,)](x, ah, al, M*K, BLK=BLK, num_warps=8)\n    _gemm[grid](ah, al, bh, bl, bias32, out32, M,N,K, ah.strid"]
[1664.771355, "i", "e(0),ah.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=wp,num_stages=st)\n    ref = (torch.nn.functional.linear(x, wt, bias0)) * c\n    ratio = ((ref-out32).abs()/(1e-4 + 1e-4*ref.abs())).max().item()\n    worst = max(worst, ratio)\n    print(f'seed {seed}: ratio {ratio:.3f}')\nprint('worst ratio:', worst)\nEOF\n"]
