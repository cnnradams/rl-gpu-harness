[1732.996728, "o", "> "]
[1732.99676, "o", "                return out32\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[1732.996793, "o", "\u001b[?2004h> "]
[1732.996845, "o", "                res.append((bench(f),bm,bn,bk,grp,st))\r\n\u001b[?2004l\r\u001b[?2004h"]
