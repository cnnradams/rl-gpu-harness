[1060.7783, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1060.77834, "o", "\u001b[?2004h> "]
[1060.778378, "o", "def _k(A, B, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[1060.778418, "o", "\u001b[?2004h> "]
[1060.778497, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.778536, "o", ">     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1060.778575, "o", "\u001b[?2004h> "]
[1060.778613, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1060.778651, "o", "\u001b[?2004h> "]
[1060.778695, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.778737, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.778817, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.778856, "o", "> "]
[1060.778894, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.778934, "o", "> "]
[1060.778975, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.779023, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.779063, "o", "> "]
[1060.779101, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.77914, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.77918, "o", "> "]
[1060.779221, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.779259, "o", "> "]
[1060.779299, "o", "    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1060.779338, "o", "\u001b[?2004h> "]
[1060.779378, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.779417, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1060.77946, "o", "\u001b[?2004h> "]
[1060.779499, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.77954, "o", "        b = tl.load(B_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.77958, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.779618, "o", ">         A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[1060.779658, "o", "\u001b[?2004h> "]
[1060.779705, "o", "        B_ptr += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.779746, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[1060.779789, "o", "\u001b[?2004h>     acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1060.779829, "o", "\u001b[?2004h> "]
[1060.779869, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1060.779904, "o", "\u001b[?2004h> "]
[1060.779947, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.779987, "o", "M,N,K=16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780034, "o", "x32 = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r"]
[1060.780075, "o", "\u001b[?2004h> "]
[1060.780116, "o", "wt = (torch.rand(N,K,device=dev)*1.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780156, "o", "bias0 = torch.rand(N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780196, "o", "c = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780238, "o", "wtb = (wt*c).t().contiguous().bfloat16()\r\n\u001b[?2004l\r"]
[1060.78028, "o", "\u001b[?2004h> bias32 = bias0*c\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780337, "o", "out32 = torch.empty(M,N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.78038, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> res=[]\r\n\u001b[?2004l\r"]
[1060.780414, "o", "\u001b[?2004h> "]
[1060.780537, "o", "for (bm,bn,bk) in [(128,256,64),(128,256,32),(256,128,64),(128,128,64),(128,256,128),(256,256,32),(128,512,64),(64,256,64)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.780571, "o", "> "]
[1060.780613, "o", "    for grp in [4,8,16]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780657, "o", "        for st in [3,4,5]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.7807, "o", "            if M%bm or N%bn or K%bk: continue\r\n\u001b[?2004l\r"]
[1060.78074, "o", "\u001b[?2004h> "]
[1060.780778, "o", "            grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780817, "o", "            def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.780855, "o", "                xh = x32.bfloat16()\r\n\u001b[?2004l\r"]
[1060.780894, "o", "\u001b[?2004h> "]
[1060.781103, "o", "                _k[grid](xh, wtb, bias32, out32, M,N,K, xh.stride(0),xh.stride(1), wtb.stride(0),wtb.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.781149, "o", "                return out32\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.781188, "o", ">             try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.781226, "o", "> "]
[1060.781264, "o", "                res.append((bench(f),bm,bn,bk,grp,st))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.781304, "o", ">             except Exception:\r\n\u001b[?2004l\r"]
[1060.781346, "o", "\u001b[?2004h"]
[1060.781385, "o", ">                 pass\r\n\u001b[?2004l\r\u001b[?2004h> res.sort()\r\n\u001b[?2004l\r"]
[1060.781424, "o", "\u001b[?2004h> "]
[1060.781524, "o", "for r in res[:6]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} stages={r[5]}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.781568, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.78161, "o", "# correctness of best config\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.781651, "o", "bm,bn,bk,grp,st = res[0][1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.781693, "o", "grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.781734, "o", "> xh = x32.bfloat16()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.781774, "o", "> "]
[1060.781947, "o", "_k[grid](xh, wtb, bias32, out32, M,N,K, xh.stride(0),xh.stride(1), wtb.stride(0),wtb.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\r\n\u001b[?2004l\r"]
[1060.781989, "o", "\u001b[?2004h> "]
[1060.782104, "o", "ref = (torch.nn.functional.linear(x32, wt, bias0)) * c  # emulate reference: (x@W.T+b) then *c... ref does x*s + x = (1+s)*mm\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.782144, "o", "> "]
[1060.782183, "o", "md = (ref-out32).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1060.782302, "o", "print('bf16 max_diff vs fp32 ref:', md, 'allclose:', torch.allclose(ref, out32, atol=1e-2, rtol=1e-2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1060.782322, "o", "> EOF\r\n\u001b[?2004l\r"]
[1060.783746, "o", "\u001b[?2004hroot@modal:/# "]
[1061.078931, "i", "gpu run -- python3 /workspace/tune3.py\n"]
[1061.079118, "o", "gpu run -- python3 /workspace/tune3.py\r\n\u001b[?2004l\r"]
[1061.222936, "o", "request ID: 2199f84d1f6049b5b2115d3952e64b37\r\n"]
[1069.371183, "o", "box: sb-FXOgYb9JlX0T2tSaOLNiQr\r\ncommand: f2149207af744b5bbbcf668dbfb55517\r\n"]
[1113.56496, "o", "0.859 ms BM=128 BN=256 BK=64 GROUP=16 stages=4\r\n0.863 ms BM=128 BN=256 BK=64 GROUP=8 stages=4\r\n0.874 ms BM=128 BN=256 BK=32 GROUP=16 stages=5\r\n0.883 ms BM=128 BN=256 BK=64 GROUP=4 stages=4\r\n0.887 ms BM=128 BN=256 BK=32 GROUP=8 stages=5\r\n0.889 ms BM=128 BN=256 BK=32 GROUP=4 stages=5\r\nbf16 max_diff vs fp32 ref: 0.623046875 allclose: True\r\n"]
[1115.779041, "o", "\u001b[?2004hroot@modal:/# "]
[1130.859072, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _fused_linear_kernel(A, B, Bias, C, M, N, K,\n                         sam, sak, sbk, sbn, scm, scn,\n                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                         GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        b = tl.load(B_ptr)\n        acc = tl.dot(a, b, acc)"]
[1130.859117, "i", "\n        A_ptr += BK * sak\n        B_ptr += BK * sbk\n    bias = tl.load(Bias + rn).to(tl.float32)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\n\nclass ModelNew(nn.Module):\n    \"\"\"\n    y = linear(x) * s + linear(x) = (1 + s) * (x @ W^T + b)\n    The (1 + s) factor is folded into pre-scaled weights/bias, computed once\n    and cached (as plain attributes so Module.to() does not touch them).\n    The GEMM runs on bf16 tensor cores with fp32 accumulation; a single fused\n    Triton kernel performs the epilogue (bias add) and writes fp32 output.\n    \"\"\"\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._wb = None\n        self._b = None\n\n    @torch.no_grad()\n    def _build_cache(self, x):\n        c = 1.0 + float(self.scaling_factor)\n        w = self.matmul.weight.detach().to(x.device, torch.float3"]
[1130.859136, "i", "2)\n        b = self.matmul.bias.detach().to(x.device, torch.float32)\n        self._wb = (w * c).t().contiguous().to(torch.bfloat16)\n        self._b = (b * c).contiguous()\n\n    @torch.no_grad()\n    def forward(self, x):\n        if self._wb is None or self._wb.device != x.device:\n            self._build_cache(x)\n        M, K = x.shape\n        N = self._wb.shape[1]\n        if x.dtype == torch.float32 and M % 128 == 0 and N % 256 == 0 and K % 64 == 0:\n            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n            grid = ((M // 128) * (N // 256),)\n            a = x.to(torch.bfloat16)\n            _fused_linear_kernel[grid](\n                a, self._wb, self._b, out, M, N, K,\n                a.stride(0), a.stride(1),\n                self._wb.stride(0), self._wb.stride(1),\n                out.stride(0), out.stride(1),\n                BM=128, BN=256, BK=64, GROUP=16,\n                num_warps=8, num_stages=4,\n            )\n            return out\n        # fallback: cuBLAS fp16 path\n        a ="]
[1130.859294, "i", " x.to(torch.float16)\n        o = torch.addmm(self._b.to(torch.float16), a, self._wb.to(torch.float16))\n        return o.to(torch.float32)\nEOF\n"]
[1130.859312, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
