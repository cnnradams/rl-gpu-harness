[1664.773303, "o", "\u001b[?2004h>     tl.store(AL + off, al)\r\n\u001b[?2004l\r"]
[1664.773343, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.773383, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.773426, "o", "def _gemm(AH, AL, BH, BL, Bias, C, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.773467, "o", "> "]
[1664.773507, "o", "          sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.773593, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1664.773633, "o", "\u001b[?2004h> "]
[1664.773654, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.773726, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1664.773745, "o", "\u001b[?2004h> "]
[1664.773784, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.773826, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.773861, "o", "> "]
[1664.773904, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[1664.773945, "o", "\u001b[?2004h> "]
[1664.773985, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.774035, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1664.774071, "o", "\u001b[?2004h> "]
[1664.774089, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1664.774131, "o", "\u001b[?2004h> "]
[1664.77415, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1664.774193, "o", "\u001b[?2004h> "]
[1664.774234, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.774274, "o", "    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1664.774333, "o", "\u001b[?2004h> "]
[1664.774397, "o", "    AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1664.774433, "o", "\u001b[?2004h> "]
[1664.774474, "o", "    BH_ptr = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1664.774519, "o", "\u001b[?2004h> "]
[1664.774559, "o", "    BL_ptr = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.774593, "o", "> "]
[1664.774634, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.774676, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.774723, "o", "> "]
[1664.774763, "o", "        a_hi = tl.load(AH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.774804, "o", "        a_lo = tl.load(AL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.774844, "o", "        b_hi = tl.load(BH_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.774882, "o", "        b_lo = tl.load(BL_ptr)\r\n\u001b[?2004l\r"]
[1664.774923, "o", "\u001b[?2004h> "]
[1664.774963, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775006, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.775045, "o", "> "]
[1664.775085, "o", "        acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775127, "o", "        AH_ptr += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775163, "o", "        AL_ptr += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775202, "o", "        BH_ptr += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775242, "o", "        BL_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[1664.775282, "o", "\u001b[?2004h> "]
[1664.775324, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775364, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775431, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1664.775471, "o", "\u001b[?2004h>     tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[1664.775511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.77555, "o", "M,N,K=16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775586, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775637, "o", "wt = torch.randn(N,K,device=dev) / (K**0.5)\r\n\u001b[?2004l\r"]
[1664.775678, "o", "\u001b[?2004h> "]
[1664.77572, "o", "bias0 = torch.randn(N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> c = 1.5\r\n\u001b[?2004l\r"]
[1664.77576, "o", "\u001b[?2004h> "]
[1664.775799, "o", "wtT = (wt*c).t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775838, "o", "bh = wtT.half(); bl = (wtT - bh.float()).half()\r\n\u001b[?2004l\r"]
[1664.775876, "o", "\u001b[?2004h> "]
[1664.775915, "o", "bias32 = (bias0*c).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.775954, "o", "out32 = torch.empty(M,N,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.775991, "o", "> BLK=4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.776032, "o", "nsplit = (M*K + BLK - 1)//BLK\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.776072, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> res=[]\r\n\u001b[?2004l\r"]
[1664.776107, "o", "\u001b[?2004h> "]
[1664.776228, "o", "for (bm,bn,bk) in [(256,128,64),(128,256,32),(128,256,64),(128,128,64),(256,64,64),(64,256,64),(256,128,32),(128,64,64)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.776269, "o", ">     for grp in [8,16]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.776309, "o", ">         for st in [3,4]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.776347, "o", "> "]
[1664.776386, "o", "            for wp in [4,8]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.776426, "o", "                if M%bm or N%bn or K%bk: continue\r\n\u001b[?2004l\r"]
[1664.776464, "o", "\u001b[?2004h> "]
[1664.776503, "o", "                grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.776544, "o", "                def f(x32, ah, al):\r\n\u001b[?2004l\r"]
[1664.776583, "o", "\u001b[?2004h> "]
[1664.776642, "o", "                    _split[(nsplit,)](x32, ah, al, M*K, BLK=BLK, num_warps=8)\r\n\u001b[?2004l\r"]
[1664.776682, "o", "\u001b[?2004h> "]
[1664.776903, "o", "                    _gemm[grid](ah, al, bh, bl, bias32, out32, M,N,K, ah.stride(0),ah.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.77692, "o", "> "]
[1664.776958, "o", "                    return out32\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.776995, "o", "> "]
[1664.77703, "o", "                x0 = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777118, "o", "                ah0 = torch.empty(M,K,device=dev,dtype=torch.half)\r\n\u001b[?2004l\r"]
[1664.777159, "o", "\u001b[?2004h> "]
[1664.777205, "o", "                al0 = torch.empty(M,K,device=dev,dtype=torch.half)\r\n\u001b[?2004l\r"]
[1664.777245, "o", "\u001b[?2004h>                 try:\r\n\u001b[?2004l\r"]
[1664.777283, "o", "\u001b[?2004h> "]
[1664.777361, "o", "                    res.append((bench(lambda: f(x0, ah0, al0)),bm,bn,bk,grp,st,wp))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.7774, "o", "> "]
[1664.777438, "o", "                except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777478, "o", "                    pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777517, "o", "res.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777622, "o", "for r in res[:8]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} stages={r[5]} warps={r[6]}')\r\n\u001b[?2004l\r"]
[1664.777664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777702, "o", "bm,bn,bk,grp,st,wp = res[0][1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777749, "o", "grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.777789, "o", "> worst=0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777829, "o", "for seed in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777868, "o", "    torch.manual_seed(100+seed)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1664.777907, "o", "> "]
[1664.777947, "o", "    x = torch.rand(M,K,device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.777994, "o", "    ah = torch.empty(M,K,device=dev,dtype=torch.half)\r\n\u001b[?2004l\r"]
[1664.778034, "o", "\u001b[?2004h> "]
[1664.778071, "o", "    al = torch.empty(M,K,device=dev,dtype=torch.half)\r\n\u001b[?2004l\r"]
[1664.778105, "o", "\u001b[?2004h> "]
[1664.778152, "o", "    _split[(nsplit,)](x, ah, al, M*K, BLK=BLK, num_warps=8)\r\n\u001b[?2004l\r"]
[1664.77819, "o", "\u001b[?2004h> "]
[1664.778386, "o", "    _gemm[grid](ah, al, bh, bl, bias32, out32, M,N,K, ah.stride(0),ah.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[1664.778427, "o", "\u001b[?2004h> "]
[1664.778465, "o", "    ref = (torch.nn.functional.linear(x, wt, bias0)) * c\r\n\u001b[?2004l\r"]
[1664.778504, "o", "\u001b[?2004h> "]
[1664.778557, "o", "    ratio = ((ref-out32).abs()/(1e-4 + 1e-4*ref.abs())).max().item()\r\n\u001b[?2004l\r"]
[1664.778596, "o", "\u001b[?2004h> "]
[1664.778636, "o", "    worst = max(worst, ratio)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.778686, "o", "    print(f'seed {seed}: ratio {ratio:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1664.778729, "o", "print('worst ratio:', worst)\r\n\u001b[?2004l\r"]
[1664.778769, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1664.78022, "o", "\u001b[?2004hroot@modal:/# "]
[1665.070652, "i", "gpu run -- python3 /workspace/tune7.py\n"]
[1665.070796, "o", "gpu run -- python3 /workspace/tune7.py\r\n\u001b[?2004l\r"]
[1665.214606, "o", "request ID: d02a32cdbe3745c6b3c3b3ef38124549\r\n"]
[1673.897334, "o", "box: sb-KEBiNC2U3riYISvzDQuvVU\r\ncommand: 1999119253214382996533d1b0d6f19d\r\n"]
[1719.015243, "o", "2.481 ms BM=128 BN=256 BK=32 GROUP=8 stages=3 warps=8\r\n2.488 ms BM=128 BN=256 BK=32 GROUP=16 stages=3 warps=8\r\n2.534 ms BM=256 BN=128 BK=32 GROUP=8 stages=3 warps=8\r\n2.559 ms BM=128 BN=256 BK=32 GROUP=16 stages=4 warps=8\r\n2.560 ms BM=256 BN=128 BK=32 GROUP=16 stages=3 warps=8\r\n2.568 ms BM=256 BN=128 BK=32 GROUP=8 stages=4 warps=8\r\n2.578 ms BM=128 BN=256 BK=32 GROUP=8 stages=4 warps=8\r\n2.602 ms BM=256 BN=128 BK=32 GROUP=16 stages=4 warps=8\r\nseed 0: ratio 0.565\r\nseed 1: ratio 0.569\r\nseed 2: ratio 0.615\r\nseed 3: ratio 0.566\r\nseed 4: ratio 0.570\r\nworst ratio: 0.6153115034103394\r\n"]
[1724.009634, "o", "\u001b[?2004hroot@modal:/# "]
[1732.994389, "i", "cat > /workspace/tune8.py << 'EOF'\nimport torch, triton, triton.language as tl\nexec(open('/workspace/tune7.py').read().split('M,N,K=16384')[0].replace('import torch, triton, triton.language as tl',''))\nM,N,K=16384,4096,4096\ntorch.manual_seed(0)\nwt = torch.randn(N,K,device=dev) / (K**0.5)\nbias0 = torch.randn(N,device=dev)\nc = 1.5\nwtT = (wt*c).t().contiguous()\nbh = wtT.half(); bl = (wtT - bh.float()).half()\nbias32 = (bias0*c).contiguous()\nout32 = torch.empty(M,N,device=dev)\nBLK=4096\nnsplit = (M*K + BLK - 1)//BLK\nx0 = torch.rand(M,K,device=dev)\nah0 = torch.empty(M,K,device=dev,dtype=torch.half)\nal0 = torch.empty(M,K,device=dev,dtype=torch.half)\n\n# time split kernel alone\nprint('split only:', bench(lambda: _split[(nsplit,)](x0, ah0, al0, M*K, BLK=BLK, num_warps=8)))\n\nres=[]\nfor (bm,bn,bk) in [(128,256,32),(128,256,64),(128,256,128),(256,128,32),(256,128,64),(128,128,64),(128,128,128),(128,512,32),(128,512,64),(256,256,32),(64,256,64),(128,64,128)]:\n    for grp in [8]:\n        for st in [3,4,5,6]:\n            if M"]
[1732.994448, "i", "%bm or N%bn or K%bk: continue\n            grid=((M//bm)*(N//bn),)\n            def f():\n                _split[(nsplit,)](x0, ah0, al0, M*K, BLK=BLK, num_warps=8)\n                _gemm[grid](ah0, al0, bh, bl, bias32, out32, M,N,K, ah0.stride(0),ah0.stride(1), bh.stride(0),bh.stride(1), out32.stride(0),out32.stride(1), BM=bm,BN=bn,BK=bk,GROUP=grp,num_warps=8,num_stages=st)\n                return out32\n            try:\n                res.append((bench(f),bm,bn,bk,grp,st))\n            except Exception:\n                pass\nres.sort()\nfor r in res[:10]: print(f'{r[0]:.3f} ms BM={r[1]} BN={r[2]} BK={r[3]} GROUP={r[4]} stages={r[5]}')\nEOF\n"]
