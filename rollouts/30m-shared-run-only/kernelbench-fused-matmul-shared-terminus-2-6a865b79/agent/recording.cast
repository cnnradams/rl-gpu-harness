[543.703876, "o", "def _k(A, B, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.7039, "o", "> "]
[543.703983, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.704007, "o", "> "]
[543.704032, "o", "       CAST: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.704056, "o", "> "]
[543.704082, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.704149, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[543.704176, "o", "\u001b[?2004h> "]
[543.704201, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.70423, "o", "> "]
[543.704257, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.704281, "o", "> "]
[543.70433, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[543.704356, "o", "\u001b[?2004h> "]
[543.704402, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[543.704424, "o", "\u001b[?2004h> "]
[543.704461, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[543.704489, "o", "\u001b[?2004h> "]
[543.704521, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[543.704548, "o", "\u001b[?2004h> "]
[543.704579, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[543.704606, "o", "\u001b[?2004h> "]
[543.704633, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[543.70466, "o", "\u001b[?2004h> "]
[543.704702, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[543.704726, "o", "\u001b[?2004h> "]
[543.704776, "o", "    B_ptr = B + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[543.704803, "o", "\u001b[?2004h> "]
[543.70485, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[543.704875, "o", "\u001b[?2004h> "]
[543.704906, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[543.704929, "o", "\u001b[?2004h> "]
[543.704953, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[543.704978, "o", "\u001b[?2004h> "]
[543.705005, "o", "        b = tl.load(B_ptr)\r\n\u001b[?2004l\r"]
[543.705031, "o", "\u001b[?2004h> "]
[543.70506, "o", "        if CAST:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.70509, "o", "            a = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[543.705116, "o", "\u001b[?2004h> "]
[543.705142, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r"]
[543.705169, "o", "\u001b[?2004h> "]
[543.705197, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.705232, "o", "        B_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[543.70526, "o", "\u001b[?2004h> "]
[543.705298, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[543.705321, "o", "\u001b[?2004h> "]
[543.705347, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[543.705372, "o", "\u001b[?2004h> "]
[543.705424, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[543.705451, "o", "\u001b[?2004h> "]
[543.705474, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.7055, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.705541, "o", "def clear_l2(device):\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.705569, "o", "> "]
[543.705663, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device=device); d.fill_(42); del d\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.705687, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.705731, "o", "def bench(fn, trials=10):\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.70576, "o", "> "]
[543.705801, "o", "    for _ in range(3): fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[543.705833, "o", "\u001b[?2004h>     times=[]\r\n\u001b[?2004l\r"]
[543.705858, "o", "\u001b[?2004h> "]
[543.705884, "o", "    for t in range(trials+1):\r\n\u001b[?2004l\r"]
[543.705909, "o", "\u001b[?2004h> "]
[543.705934, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[543.70596, "o", "\u001b[?2004h> "]
[543.706049, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[543.706073, "o", "\u001b[?2004h> "]
[543.706098, "o", "        clear_l2(x.device)\r\n\u001b[?2004l\r"]
[543.706122, "o", "\u001b[?2004h> "]
[543.706179, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[543.706204, "o", "\u001b[?2004h> "]
[543.70625, "o", "        if t>=1: times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[543.706288, "o", "\u001b[?2004h> "]
[543.706336, "o", "    times.sort(); return sum(times)/len(times)\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.706376, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.706401, "o", "M=N=K=4096; M=16384\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.70644, "o", "x32 = torch.rand(M,K,device='cuda')\r\n\u001b[?2004l\r"]
[543.706464, "o", "\u001b[?2004h> "]
[543.706488, "o", "x16 = x32.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.706562, "o", "wt = (torch.rand(N,K,device='cuda')*1.5).t().contiguous().half()\r\n\u001b[?2004l\r"]
[543.706589, "o", "\u001b[?2004h> "]
[543.706618, "o", "bias = torch.rand(N,device='cuda')\r\n\u001b[?2004l\r"]
[543.706646, "o", "\u001b[?2004h> "]
[543.706674, "o", "out = torch.empty(M,N,device='cuda')\r\n\u001b[?2004l\r"]
[543.706698, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[543.706726, "o", "> configs = []\r\n\u001b[?2004l\r"]
[543.706753, "o", "\u001b[?2004h> "]
[543.70694, "o", "for (bm,bn,bk) in [(128,256,64),(128,256,32),(256,128,64),(256,128,32),(128,128,64),(128,128,128),(256,64,64),(64,256,64),(128,64,64),(64,128,64),(256,256,64),(128,512,64)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.706967, "o", "> "]
[543.706993, "o", "    for st in [2,3,4,5]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.707022, "o", "        for wp in [4,8]:\r\n\u001b[?2004l\r"]
[543.707048, "o", "\u001b[?2004h> "]
[543.707088, "o", "            configs.append((bm,bn,bk,st,wp))\r\n\u001b[?2004l\r"]
[543.707116, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.707172, "o", "print('=== fp32 A loads, in-kernel cast ===')\r\n\u001b[?2004l\r"]
[543.707201, "o", "\u001b[?2004h> results=[]\r\n\u001b[?2004l\r"]
[543.707225, "o", "\u001b[?2004h> "]
[543.707271, "o", "for (bm,bn,bk,st,wp) in configs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.707318, "o", "    if M%bm or N%bn or K%bk: continue\r\n\u001b[?2004l\r"]
[543.707343, "o", "\u001b[?2004h> "]
[543.707366, "o", "    grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r"]
[543.707392, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r"]
[543.707416, "o", "\u001b[?2004h> "]
[543.707627, "o", "        _k[grid](x32, wt, bias, out, M,N,K, x32.stride(0),x32.stride(1), wt.stride(0),wt.stride(1), out.stride(0),out.stride(1), BM=bm,BN=bn,BK=bk,GROUP=8,CAST=True,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.707654, "o", "> "]
[543.707679, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.707706, "o", "        t=bench(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.70775, "o", "        results.append((t,bm,bn,bk,st,wp))\r\n\u001b[?2004l\r"]
[543.707776, "o", "\u001b[?2004h> "]
[543.707801, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[543.707833, "o", "\u001b[?2004h>         pass\r\n\u001b[?2004l\r"]
[543.707857, "o", "\u001b[?2004h> "]
[543.707882, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.707999, "o", "for r in results[:8]: print(f'{r[0]:.3f} ms  BM={r[1]} BN={r[2]} BK={r[3]} stages={r[4]} warps={r[5]}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.708027, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[543.708054, "o", "> "]
[543.708115, "o", "print('=== fp16 A pre-cast (includes cast kernel in timing) ===')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.70814, "o", "results=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.708168, "o", "> "]
[543.708193, "o", "for (bm,bn,bk,st,wp) in configs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.708218, "o", "> "]
[543.708245, "o", "    if M%bm or N%bn or K%bk: continue\r\n\u001b[?2004l\r"]
[543.708269, "o", "\u001b[?2004h> "]
[543.708297, "o", "    grid=((M//bm)*(N//bn),)\r\n\u001b[?2004l\r"]
[543.708325, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r"]
[543.708351, "o", "\u001b[?2004h> "]
[543.708375, "o", "        xh = x32.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.708586, "o", "        _k[grid](xh, wt, bias, out, M,N,K, xh.stride(0),xh.stride(1), wt.stride(0),wt.stride(1), out.stride(0),out.stride(1), BM=bm,BN=bn,BK=bk,GROUP=8,CAST=False,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[543.708614, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[543.708637, "o", "\u001b[?2004h> "]
[543.708661, "o", "        t=bench(f)\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.708689, "o", "> "]
[543.708718, "o", "        results.append((t,bm,bn,bk,st,wp))\r\n\u001b[?2004l\r"]
[543.708746, "o", "\u001b[?2004h> "]
[543.708771, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[543.708796, "o", ">         pass\r\n\u001b[?2004l\r"]
[543.708827, "o", "\u001b[?2004h> "]
[543.708852, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[543.708966, "o", "for r in results[:8]: print(f'{r[0]:.3f} ms  BM={r[1]} BN={r[2]} BK={r[3]} stages={r[4]} warps={r[5]}')\r\n\u001b[?2004l\r"]
[543.708994, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[543.710788, "o", "\u001b[?2004hroot@modal:/# "]
[544.003703, "i", "gpu run -- python3 /workspace/tune.py\n"]
