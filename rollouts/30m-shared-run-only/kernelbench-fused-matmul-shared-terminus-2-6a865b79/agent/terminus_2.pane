[32m[K84[m[K[36m[K-[m[K    """
[32m[K85[m[K[36m[K-[m[K    Get the tolerance from a string representing the percision.
[32m[K86[m[K[36m[K-[m[K    These tolerances are inspired by torchbench (PyTorch Benchmarking Suite): 
[32m[K87[m[K[36m[K-[m[K    Reference:
[32m[K88[m[K[36m[K-[m[K    https://github.com/pytorch/benchmark/blob/cfd835c35d04513ced9a59bd074eeb21dc8187d7/torchbenchmark/util/env_check.py#L519
[32m[K89[m[K[36m[K-[m[K    """
[32m[K90[m[K[36m[K-[m[K    if isinstance(precision, str):
[32m[K91[m[K[36m[K-[m[K        precision = get_torch_dtype_from_string(precision)
[32m[K92[m[K[36m[K-[m[K
[32m[K93[m[K[36m[K-[m[K    PRECISION_TOLERANCES = {
[32m[K94[m[K[36m[K-[m[K        # By default for fp32, 1e-4 is used according to torchbench.
[32m[K95[m[K[36m[K-[m[K        torch.float32: 1e-4,
[32m[K96[m[K[36m[K-[m[K        # torchbench states for bf16 and fp16, use 1e-3 as tolerance and 1e-2 if it's too strict. 
[32m[K97[m[K[36m[K-[m[K        # @todo: Let user configure own tolerance as an option
[32m[K98[m[K[36m[K-[m[K        torch.float16: 1e-2, 
[32m[K99[m[K[36m[K-[m[K        torch.bfloat16: 1e-2,
[32m[K100[m[K[36m[K-[m[K    }
[32m[K101[m[K[36m[K-[m[K    assert precision in PRECISION_TOLERANCES, f"Invalid precision not supported: {precision}"
[32m[K102[m[K[36m[K-[m[K    return PRECISION_TOLERANCES[precision]
