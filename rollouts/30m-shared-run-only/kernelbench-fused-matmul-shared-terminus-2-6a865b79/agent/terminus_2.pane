[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     """
[?2004l[?2004h>     y = linear(x) * s + linear(x) = (1 + s) * (x @ W^T + b)
[?2004l[?2004h> 
[?2004l[?2004h>     The (1+s) factor is folded into the weights once (cached as plain
[?2004l[?2004h>     attributes so Module.to() never disturbs them).  The GEMM runs on
[?2004l[?2004h>     fp16 tensor cores using an error-compensated hi/lo split of both
[?2004l[?2004h>     operands (3 dots with fp32 accumulation), which keeps the result
[?2004l[?2004h>     within ~8e-5 of the fp32 reference while being ~4x faster than
[?2004l[?2004h>     the default fp32 cuBLAS path on H100.
[?2004l[?2004h>     """
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.matmul = nn.Linear(in_features, out_features)
[?2004l[?2004h>         self.scaling_factor = scaling_factor
[?2004l[?2004h>         self._w32 = None
[?2004l[?2004h>         self._bh = None
[?2004l[?2004h>         self._bl = None
[?2004l[?2004h>         self._b32 = None
[?2004l[?2004h> 
[?2004l[?2004h>     @torch.no_grad()
[?2004l[?2004h>     def _build_cache(self, x):
[?2004l[?2004h>         c = 1.0 + float(self.scaling_factor)
[?2004l[?2004h>         w = self.matmul.weight.detach().to(x.device, torch.float32)
[?2004l[?2004h>         b = self.matmul.bias.detach().to(x.device, torch.float32)
[?2004l[?2004h>         w = (w * c).contiguous()
[?2004l[?2004h>         b = (b * c).contiguous()
[?2004l[?2004h>         wt = w.t().contiguous()
[?2004l[?2004h>         bh = wt.to(torch.float16)
[?2004l[?2004h>         bl = (wt - bh.to(torch.float32)).to(torch.float16)
[?2004l[?2004h>         self._w32 = wt
[?2004l[?2004h>         self._bh = bh
[?2004l[?2004h>         self._bl = bl
[?2004l[?2004h>         self._b32 = b
[?2004l[?2004h> 
[?2004l[?2004h>     @torch.no_grad()
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         if self._b32 is None or self._b32.device != x.device:
[?2004l[?2004h>             self._build_cache(x)
[?2004l[?2004h>         M, K = x.shape
[?2004l[?2004h>         N = self._b32.shape[0]
[?2004l[?2004h>         if (x.dtype == torch.float32 and x.is_cuda
[?2004l[?2004h>                 and M % 256 == 0 and N % 128 == 0 and K % 64 == 0):
[?2004l[?2004h>             out = torch.empty((M, N), device=x.device, dtype=torch.float32)
[?2004l[?2004h>             grid = ((M // 256) * (N // 128),)
[?2004l[?2004h>             _split_fp16_gemm[grid](
[?2004l[?2004h>                 x, self._bh, self._bl, self._b32, out, M, N, K,
[?2004l[?2004h>                 x.stride(0), x.stride(1),
[?2004l[?2004h>                 self._bh.stride(0), self._bh.stride(1),
[?2004l[?2004h>                 out.stride(0), out.stride(1),
[?2004l[?2004h>                 BM=256, BN=128, BK=64, GROUP=8,
[?2004l[?2004h>                 num_warps=8, num_stages=3,
[?2004l[?2004h>             )
[?2004l[?2004h>             return out
[?2004l[?2004h>         # exact fp32 fallback for any other shape/dtype
[?2004l[?2004h>         return torch.addmm(self._b32.to(x.dtype), x, self._w32.to(x.dtype))
