[35.514574, "o", "\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Keval_kernel_against_ref(\r\n\u001b[32m\u001b[K702\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kregister_and_format_exception(\r\n\u001b[32m\u001b[K727\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Krun_and_check_correctness(\r\n\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcheck_metadata_serializable(metadata: dict):\r\n\u001b[32m\u001b[K880\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcheck_metadata_serializable_all_types(metadata: dict):\r\n\u001b[32m\u001b[K886\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kconvert_to_serializable(obj):\r\n"]
