[38.501678, "o", "tadata=metadata\r\n        )  # skip further steps\r\n\r\n    kernel_exec_result = None\r\n\r\n    # Check Correctness\r\n    if verbose:\r\n        print(\"[Eval] Checking Correctness\")\r\n    try:\r\n        kernel_exec_result = run_and_check_correctness(\r\n            original_model,\r\n            custom_model,\r\n            get_inputs,\r\n            metadata=metadata,\r\n            num_correct_trials=num_correct_trials,\r\n            verbose=verbose,\r\n            seed=seed_num,\r\n"]
