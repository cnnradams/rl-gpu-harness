[243.560418, "i", "mkdir -p /workspace && cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    @triton.jit\n    def _split_gemm_kernel(\n        X, WH, WL, B, Y, M, N, K, s,\n        stride_xm, stride_xk,\n        stride_wk, stride_wn,\n        stride_ym, stride_yn,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\n    ):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GROUP * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n        pid_m = group_id * GROUP + (pid % group_size)\n        pid_n = (pid % width) // group_size\n\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n        X_ptr = X + rm[:, None] * stride_xm + rk[None, :] * stride_xk\n        WH_ptr = W"]
[243.560465, "i", "H + rk[:, None] * stride_wk + rn[None, :] * stride_wn\n        WL_ptr = WL + rk[:, None] * stride_wk + rn[None, :] * stride_wn\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for _ in range(0, K, BK):\n            x = tl.load(X_ptr)\n            xh = x.to(tl.float16)\n            xl = (x - xh.to(tl.float32)).to(tl.float16)\n            wh = tl.load(WH_ptr)\n            wl = tl.load(WL_ptr)\n            acc = tl.dot(xh, wh, acc)\n            acc = tl.dot(xl, wh, acc)\n            acc = tl.dot(xh, wl, acc)\n            X_ptr += BK * stride_xk\n            WH_ptr += BK * stride_wk\n            WL_ptr += BK * stride_wk\n        b = tl.load(B + rn).to(tl.float32)\n        y = acc * s + b * s\n        Y_ptr = Y + rm[:, None] * stride_ym + rn[None, :] * stride_yn\n        tl.store(Y_ptr, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n       "]
[243.560572, "i", " self._cache_key = None\n        self._wh = None\n        self._wl = None\n        self._b = None\n        self._s = None\n\n    def _prepare(self, x):\n        w = self.matmul.weight\n        key = (w.data_ptr(), w._version, str(w.device), x.shape)\n        if self._cache_key == key:\n            return\n        with torch.no_grad():\n            wt = w.detach().t().contiguous()  # [K, N] fp32\n            wh = wt.to(torch.float16)\n            wl = (wt - wh.to(torch.float32)).to(torch.float16)\n            self._wh = wh.contiguous()\n            self._wl = wl.contiguous()\n            self._b = self.matmul.bias.detach().clone()\n            self._s = float(self.scaling_factor) + 1.0\n            self._cache_key = key\n\n    def forward(self, x):\n        if (\n            _HAS_TRITON\n            and x.device.type == \"cuda\"\n            and x.dtype == torch.float32\n            and x.dim() == 2\n        ):\n            if not x.is_contiguous():\n                x = x.contiguous()\n            self._prepare(x)\n            M, K = x.shape\n"]
[243.560607, "i", "            N = self._wh.shape[1]\n            if M % 128 == 0 and N % 128 == 0 and K % 32 == 0:\n                y = torch.empty((M, N), device=x.device, dtype=torch.float32)\n                grid = lambda meta: (\n                    triton.cdiv(M, meta[\"BM\"]) * triton.cdiv(N, meta[\"BN\"]),\n                )\n                _split_gemm_kernel[grid](\n                    x, self._wh, self._wl, self._b, y,\n                    M, N, K, self._s,\n                    x.stride(0), x.stride(1),\n                    self._wh.stride(0), self._wh.stride(1),\n                    y.stride(0), y.stride(1),\n                    BM=128, BN=256, BK=64, GROUP=8,\n                    num_warps=8, num_stages=3,\n                )\n                return y\n        y = self.matmul(x)\n        return y * self.scaling_factor + y.detach()\nEOF\necho written\n"]
