[415.940993, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    def _cfgs():\n        cfgs = []\n        for bm, bn, bk, ns, nw in [\n            (128, 128, 64, 3, 8),\n            (128, 128, 32, 5, 8),\n            (256, 128, 32, 4, 8),\n            (128, 64, 64, 4, 4),\n            (64, 128, 64, 4, 4),\n            (128, 128, 32, 6, 8),\n            (256, 64, 32, 4, 8),\n            (128, 256, 32, 4, 8),\n        ]:\n            cfgs.append(\n                triton.Config(\n                    {\"BM\": bm, \"BN\": bn, \"BK\": bk, \"GROUP\": 8},\n                    num_warps=nw, num_stages=ns,\n                )\n            )\n        return cfgs\n\n    @triton.autotune(configs=_cfgs(), key=[\"M\", \"N\", \"K\"])\n    @triton.jit\n    def _split_gemm_kernel(\n        X, WH, WL, B, Y, M, N, K, s,\n        stride_xm, stride_xk,\n        stride_wk, stride_wn,\n        stride_ym, stride_yn,\n        "]
[415.941043, "i", "BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\n    ):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GROUP * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n        pid_m = group_id * GROUP + (pid % group_size)\n        pid_n = (pid % width) // group_size\n\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n        X_ptr = X + rm[:, None] * stride_xm + rk[None, :] * stride_xk\n        WH_ptr = WH + rk[:, None] * stride_wk + rn[None, :] * stride_wn\n        WL_ptr = WL + rk[:, None] * stride_wk + rn[None, :] * stride_wn\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for _ in range(0, K, BK):\n            x = tl.load(X_ptr)\n            xh = x.to(tl.float16)\n            xl = (x - xh.to(tl.float32)).to(tl.float16)\n            wh = tl.load(WH_ptr)\n            wl = tl.load(WL_ptr)\n            acc ="]
[415.94106, "i", " tl.dot(xh, wh, acc)\n            acc = tl.dot(xl, wh, acc)\n            acc = tl.dot(xh, wl, acc)\n            X_ptr += BK * stride_xk\n            WH_ptr += BK * stride_wk\n            WL_ptr += BK * stride_wk\n        b = tl.load(B + rn).to(tl.float32)\n        y = acc * s + b * s\n        Y_ptr = Y + rm[:, None] * stride_ym + rn[None, :] * stride_yn\n        tl.store(Y_ptr, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._cache_key = None\n        self._wh = None\n        self._wl = None\n        self._b = None\n        self._s = None\n\n    def _prepare(self, x):\n        w = self.matmul.weight\n        key = (w.data_ptr(), w._version, str(w.device), x.shape)\n        if self._cache_key == key:\n            return\n        with torch.no_grad():\n            wt = w.detach().t().contiguous()  # [K, N] fp32\n            wh = wt.to(torch."]
[415.941067, "i", "float16)\n            wl = (wt - wh.to(torch.float32)).to(torch.float16)\n            self._wh = wh.contiguous()\n            self._wl = wl.contiguous()\n            self._b = self.matmul.bias.detach().clone()\n            self._s = float(self.scaling_factor) + 1.0\n            self._cache_key = key\n\n    def forward(self, x):\n        if (\n            _HAS_TRITON\n            and x.device.type == \"cuda\"\n            and x.dtype == torch.float32\n            and x.dim() == 2\n        ):\n            if not x.is_contiguous():\n                x = x.contiguous()\n            self._prepare(x)\n            M, K = x.shape\n            N = self._wh.shape[1]\n            if M % 64 == 0 and N % 64 == 0 and K % 32 == 0:\n                y = torch.empty((M, N), device=x.device, dtype=torch.float32)\n                grid = lambda meta: (\n                    triton.cdiv(M, meta[\"BM\"]) * triton.cdiv(N, meta[\"BN\"]),\n                )\n                _split_gemm_kernel[grid](\n                    x, self._wh, self._wl, self._b, y,\n             "]
[415.941073, "i", "       M, N, K, self._s,\n                    x.stride(0), x.stride(1),\n                    self._wh.stride(0), self._wh.stride(1),\n                    y.stride(0), y.stride(1),\n                )\n                return y\n        y = self.matmul(x)\n        return y * self.scaling_factor + y.detach()\nEOF\ngpu run -- python3 /workspace/bench.py\n"]
[415.941287, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[415.94135, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[415.941402, "o", "> "]
[415.941438, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.941504, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.94156, "o", "    import triton\r\n\u001b[?2004l\r"]
[415.941589, "o", "\u001b[?2004h> "]
[415.94168, "o", "    import triton.language as tl\r\n\u001b[?2004l\r1)\u001b[?2004h> "]
[415.941778, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\ry"]
[415.941818, "o", "\u001b[?2004h> "]
[415.941853, "o", "except Exception:\r\n"]
[415.94189, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[415.941967, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r"]
[415.942005, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.94204, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.942092, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\rr"]
[415.94212, "o", "\u001b[?2004h> "]
[415.942219, "o", "    def _cfgs():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.942255, "o", "        cfgs = []\r\n"]
[415.94229, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[415.942417, "o", "        for bm, bn, bk, ns, nw in [\r\n\u001b[?2004l\rt\u001b[?2004h"]
[415.94245, "o", "> "]
[415.942545, "o", "            (128, 128, 64, 3, 8),\r\n\u001b[?2004l\r"]
[415.942579, "o", "\u001b[?2004h> "]
[415.942654, "o", "            (128, 128, 32, 5, 8),\r\n\u001b[?2004l\r"]
[415.942687, "o", "\u001b[?2004h> "]
[415.942737, "o", "            (256, 128, 32, 4, 8),\r\n\u001b[?2004l\r"]
[415.94277, "o", "\u001b[?2004h> "]
[415.94281, "o", "            (128, 64, 64, 4, 4),\r\n\u001b[?2004l\r"]
[415.942843, "o", "\u001b[?2004h> "]
[415.942883, "o", "            (64, 128, 64, 4, 4),\r\n\u001b[?2004l\r"]
[415.942915, "o", "\u001b[?2004h> "]
[415.942958, "o", "            (128, 128, 32, 6, 8),\r\n\u001b[?2004l\r"]
[415.942991, "o", "\u001b[?2004h> "]
[415.943033, "o", "            (256, 64, 32, 4, 8),\r\n\u001b[?2004l\r"]
[415.943064, "o", "\u001b[?2004h> "]
[415.943108, "o", "            (128, 256, 32, 4, 8),\r\n\u001b[?2004l\r"]
[415.943144, "o", "\u001b[?2004h>         ]:\r\n\u001b[?2004l\r"]
[415.943179, "o", "\u001b[?2004h> "]
[415.943212, "o", "            cfgs.append(\r\n\u001b[?2004l\r"]
[415.943245, "o", "\u001b[?2004h> "]
[415.943291, "o", "                triton.Config(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.943407, "o", "                    {\"BM\": bm, \"BN\": bn, \"BK\": bk, \"GROUP\": 8},\r\n\u001b[?2004l\r"]
[415.943436, "o", "\u001b[?2004h> "]
[415.943506, "o", "                    num_warps=nw, num_stages=ns,\r\n\u001b[?2004l\r"]
[415.943539, "o", "\u001b[?2004h> "]
[415.94357, "o", "                )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.943602, "o", "            )\r\n\u001b[?2004l\r"]
[415.943636, "o", "\u001b[?2004h> "]
[415.943669, "o", "        return cfgs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[415.943702, "o", "\u001b[?2004h> "]
[415.943804, "o", "    @triton.autotune(configs=_cfgs(), key=[\"M\", \"N\", \"K\"])\r\n\u001b[?2004l\r"]
[415.943838, "o", "\u001b[?2004h> "]
[415.943871, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.943917, "o", "    def _split_gemm_kernel(\r\n\u001b[?2004l\r"]
[415.943947, "o", "\u001b[?2004h> "]
[415.943996, "o", "        X, WH, WL, B, Y, M, N, K, s,\r\n\u001b[?2004l\r"]
[415.944029, "o", "\u001b[?2004h> "]
[415.944074, "o", "        stride_xm, stride_xk,\r\n\u001b[?2004l\r"]
[415.944107, "o", "\u001b[?2004h> "]
[415.944139, "o", "        stride_wk, stride_wn,\r\n\u001b[?2004l\r"]
[415.944172, "o", "\u001b[?2004h> "]
[415.944213, "o", "        stride_ym, stride_yn,\r\n\u001b[?2004l\r"]
[415.944246, "o", "\u001b[?2004h> "]
[415.944364, "o", "        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\r\n\u001b[?2004l\r"]
[415.944397, "o", "\u001b[?2004h>     ):\r\n\u001b[?2004l\r"]
[415.944431, "o", "\u001b[?2004h> "]
[415.94447, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[415.944503, "o", "\u001b[?2004h> "]
[415.944544, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[415.944577, "o", "\u001b[?2004h> "]
[415.944609, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[415.944643, "o", "\u001b[?2004h> "]
[415.944691, "o", "        width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[415.944728, "o", "> "]
[415.944784, "o", "        group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.944887, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[415.944923, "o", "> "]
[415.944999, "o", "        pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[415.945034, "o", "\u001b[?2004h> "]
[415.945092, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[415.945126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.945205, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[415.945235, "o", "\u001b[?2004h> "]
[415.945296, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[415.945329, "o", "\u001b[?2004h> "]
[415.945361, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[415.945394, "o", "\u001b[?2004h> "]
[415.945502, "o", "        X_ptr = X + rm[:, None] * stride_xm + rk[None, :] * stride_xk\r\n\u001b[?2004l\r"]
[415.945535, "o", "\u001b[?2004h> "]
[415.945637, "o", "        WH_ptr = WH + rk[:, None] * stride_wk + rn[None, :] * stride_wn\r\n\u001b[?2004l\r"]
[415.94567, "o", "\u001b[?2004h> "]
[415.945778, "o", "        WL_ptr = WL + rk[:, None] * stride_wk + rn[None, :] * stride_wn\r\n\u001b[?2004l\r"]
[415.94581, "o", "\u001b[?2004h> "]
[415.945879, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[415.945911, "o", "\u001b[?2004h> "]
[415.945955, "o", "        for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[415.945988, "o", "\u001b[?2004h> "]
[415.946021, "o", "            x = tl.load(X_ptr)\r\n\u001b[?2004l\r"]
[415.946055, "o", "\u001b[?2004h> "]
[415.946108, "o", "            xh = x.to(tl.float16)\r\n\u001b[?2004l\r"]
[415.946141, "o", "\u001b[?2004h> "]
[415.946221, "o", "            xl = (x - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[415.946254, "o", "\u001b[?2004h> "]
[415.946295, "o", "            wh = tl.load(WH_ptr)\r\n\u001b[?2004l\r"]
[415.946326, "o", "\u001b[?2004h> "]
[415.946369, "o", "            wl = tl.load(WL_ptr)\r\n\u001b[?2004l\r"]
[415.946401, "o", "\u001b[?2004h> "]
[415.946451, "o", "            acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[415.946483, "o", "\u001b[?2004h> "]
[415.946532, "o", "            acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[415.946564, "o", "\u001b[?2004h> "]
[415.946614, "o", "            acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[415.946645, "o", "\u001b[?2004h> "]
[415.946693, "o", "            X_ptr += BK * stride_xk\r\n\u001b[?2004l\r"]
[415.94673, "o", "\u001b[?2004h> "]
[415.946778, "o", "            WH_ptr += BK * stride_wk\r\n\u001b[?2004l\r"]
[415.94681, "o", "\u001b[?2004h> "]
[415.946857, "o", "            WL_ptr += BK * stride_wk\r\n\u001b[?2004l\r"]
[415.946889, "o", "\u001b[?2004h> "]
[415.946947, "o", "        b = tl.load(B + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[415.946977, "o", "\u001b[?2004h> "]
[415.947009, "o", "        y = acc * s + b * s\r\n\u001b[?2004l\r"]
[415.947042, "o", "\u001b[?2004h> "]
[415.947149, "o", "        Y_ptr = Y + rm[:, None] * stride_ym + rn[None, :] * stride_yn\r\n\u001b[?2004l\r"]
[415.947183, "o", "\u001b[?2004h> "]
[415.947217, "o", "        tl.store(Y_ptr, y)\r\n\u001b[?2004l\r\u001b[?2004h"]
[415.947251, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.947285, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.947318, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[415.947352, "o", "\u001b[?2004h> "]
[415.947449, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[415.947483, "o", "\u001b[?2004h> "]
[415.947514, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[415.947547, "o", "\u001b[?2004h> "]
[415.947628, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[415.947659, "o", "\u001b[?2004h> "]
[415.947726, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[415.947759, "o", "\u001b[?2004h> "]
[415.947798, "o", "        self._cache_key = None\r\n\u001b[?2004l\r"]
[415.947828, "o", "\u001b[?2004h> "]
[415.947858, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[415.947892, "o", "\u001b[?2004h> "]
[415.947923, "o", "        self._wl = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[415.947957, "o", "> "]
[415.947987, "o", "        self._b = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.948032, "o", "        self._s = None\r\n\u001b[?2004l\r"]
[415.948065, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[415.948098, "o", "> "]
[415.948131, "o", "    def _prepare(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.94819, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[415.948224, "o", "\u001b[?2004h> "]
[415.948315, "o", "        key = (w.data_ptr(), w._version, str(w.device), x.shape)\r\n\u001b[?2004l\r"]
[415.948348, "o", "\u001b[?2004h> "]
[415.948391, "o", "        if self._cache_key == key:\r\n\u001b[?2004l\r"]
[415.948424, "o", "\u001b[?2004h> "]
[415.948457, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.948511, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[415.948545, "o", "\u001b[?2004h> "]
[415.948629, "o", "            wt = w.detach().t().contiguous()  # [K, N] fp32\r\n\u001b[?2004l\r"]
[415.948662, "o", "\u001b[?2004h> "]
[415.948711, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[415.948749, "o", "\u001b[?2004h> "]
[415.948839, "o", "            wl = (wt - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[415.948872, "o", "\u001b[?2004h> "]
[415.948923, "o", "            self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[415.948956, "o", "\u001b[?2004h> "]
[415.949006, "o", "            self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[415.949039, "o", "\u001b[?2004h> "]
[415.949117, "o", "            self._b = self.matmul.bias.detach().clone()\r\n\u001b[?2004l\r"]
[415.94915, "o", "\u001b[?2004h> "]
[415.949226, "o", "            self._s = float(self.scaling_factor) + 1.0\r\n\u001b[?2004l\r"]
[415.94926, "o", "\u001b[?2004h> "]
[415.949301, "o", "            self._cache_key = key\r\n\u001b[?2004l\r"]
[415.949335, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.949386, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[415.94942, "o", "\u001b[?2004h>         if (\r\n\u001b[?2004l\r"]
[415.949452, "o", "\u001b[?2004h> "]
[415.949485, "o", "            _HAS_TRITON\r\n\u001b[?2004l\r"]
[415.949517, "o", "\u001b[?2004h> "]
[415.949572, "o", "            and x.device.type == \"cuda\"\r\n\u001b[?2004l\r"]
[415.949605, "o", "\u001b[?2004h> "]
[415.949659, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[415.949692, "o", "\u001b[?2004h> "]
[415.94973, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[415.949763, "o", "\u001b[?2004h>         ):\r\n\u001b[?2004l\r"]
[415.949796, "o", "\u001b[?2004h> "]
[415.949852, "o", "            if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[415.949885, "o", "\u001b[?2004h> "]
[415.949929, "o", "                x = x.contiguous()\r\n\u001b[?2004l\r"]
[415.949962, "o", "\u001b[?2004h> "]
[415.949994, "o", "            self._prepare(x)\r\n\u001b[?2004l\r"]
[415.950027, "o", "\u001b[?2004h> "]
[415.950059, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[415.950092, "o", "\u001b[?2004h> "]
[415.950147, "o", "            N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[415.95018, "o", "\u001b[?2004h> "]
[415.950262, "o", "            if M % 64 == 0 and N % 64 == 0 and K % 32 == 0:\r\n\u001b[?2004l\r"]
[415.950295, "o", "\u001b[?2004h> "]
[415.950407, "o", "                y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[415.95044, "o", "\u001b[?2004h> "]
[415.950489, "o", "                grid = lambda meta: (\r\n\u001b[?2004l\r"]
[415.950522, "o", "\u001b[?2004h> "]
[415.950632, "o", "                    triton.cdiv(M, meta[\"BM\"]) * triton.cdiv(N, meta[\"BN\"]),\r\n\u001b[?2004l\r"]
[415.950666, "o", "\u001b[?2004h> "]
[415.950696, "o", "                )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.950776, "o", "                _split_gemm_kernel[grid](\r\n\u001b[?2004l\r"]
[415.950809, "o", "\u001b[?2004h> "]
[415.950884, "o", "                    x, self._wh, self._wl, self._b, y,\r\n\u001b[?2004l\r"]
[415.950917, "o", "\u001b[?2004h> "]
[415.950968, "o", "                    M, N, K, self._s,\r\n\u001b[?2004l\r"]
[415.951001, "o", "\u001b[?2004h> "]
[415.951063, "o", "                    x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[415.951098, "o", "\u001b[?2004h> "]
[415.951181, "o", "                    self._wh.stride(0), self._wh.stride(1),\r\n\u001b[?2004l\r"]
[415.951213, "o", "\u001b[?2004h> "]
[415.951276, "o", "                    y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[415.951308, "o", "\u001b[?2004h> "]
[415.951341, "o", "                )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.951389, "o", "                return y\r\n\u001b[?2004l\r"]
[415.951422, "o", "\u001b[?2004h> "]
[415.951451, "o", "        y = self.matmul(x)\r\n\u001b[?2004l\r"]
[415.951484, "o", "\u001b[?2004h> "]
[415.951562, "o", "        return y * self.scaling_factor + y.detach()\r\n\u001b[?2004l\r"]
[415.951596, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
