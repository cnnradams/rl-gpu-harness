[617.527209, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, sys, itertools\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nimport triton, triton.language as tl\n\n@triton.jit\ndef _k(X, WH, WL, B, Y, M, N, K, s,\n       sxm, sxk, swk, swn, sym, syn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Xp = X + rm[:, None] * sxm + rk[None, :] * sxk\n    WHp = WH + rk[:, None] * swk + rn[None, :] * swn\n    WLp = WL + rk[:, None] * swk + rn[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n    "]
[617.527387, "i", "    x = tl.load(Xp)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        wh = tl.load(WHp)\n        wl = tl.load(WLp)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xl, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        Xp += BK * sxk\n        WHp += BK * swk\n        WLp += BK * swk\n    b = tl.load(B + rn).to(tl.float32)\n    tl.store(Y + rm[:, None] * sym + rn[None, :] * syn, acc * s + b * s)\n\ndevice = 'cuda'\ntorch.manual_seed(42)\ninit = get_init_inputs()\nm = Model(*init).to(device)\nx = get_inputs()[0].to(device)\nw = m.matmul.weight.detach().t().contiguous()\nwh = w.to(torch.float16).contiguous()\nwl = (w - wh.to(torch.float32)).to(torch.float16).contiguous()\nb = m.matmul.bias.detach().clone()\nM = K = N = 16384 // 4, 4096, 4096\nM, K, N = 16384, 4096, 4096\ny = torch.empty((M, N), device=device)\ncache = torch.empty(256*1024*1024//4, device=device, dtype=torch.float32)\n\ndef run(cfg):\n    bm, bn, bk, ns, nw, grp = cfg\n    smem = ns * (bm*bk*4 + 2*bk*bn*2)\n    if smem > 232"]
[617.527475, "o", "cat > /workspace/sweep.py << 'EOF'\r\n\u001b[?2004l\r"]
[617.527548, "i", "448: return None\n    grid = (triton.cdiv(M,bm)*triton.cdiv(N,bn),)\n    def call():\n        _k[grid](x, wh, wl, b, y, M, N, K, 1.5,\n                 x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), y.stride(0), y.stride(1),\n                 BM=bm, BN=bn, BK=bk, GROUP=grp, num_warps=nw, num_stages=ns)\n    try:\n        call(); torch.cuda.synchronize()\n    except Exception as e:\n        return None\n    es = []\n    for _ in range(15):\n        cache.zero_(); torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); call(); e.record(); torch.cuda.synchronize()\n        es.append(s.elapsed_time(e))\n    es.sort()\n    return es[len(es)//2]\n\ncfgs = [\n    (256,128,32,4,8,8),\n    (256,256,32,3,8,8),\n    (256,256,64,2,8,8),\n    (128,256,64,3,8,8),\n    (256,128,64,3,8,8),\n    (256,64,64,3,8,8),\n    (256,128,32,4,8,4),\n    (256,128,32,4,16,8),\n    (512,128,32,3,8,8),\n    (128,128,64,3,8,8),\n    (256,256,32,3,16,8),\n]\nfor c in cfgs:\n    t = run("]
