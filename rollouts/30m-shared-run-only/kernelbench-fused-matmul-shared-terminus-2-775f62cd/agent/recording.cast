[243.561076, "o", "> "]
[243.561164, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.561182, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r"]
[243.561202, "o", "\u001b[?2004h> "]
[243.561239, "o", "    import triton\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.561263, "o", "> "]
[243.561307, "o", "    import triton.language as tl\r\n\u001b[?2004l\r"]
[243.561326, "o", "\u001b[?2004h> "]
[243.561361, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\r"]
[243.561377, "o", "\u001b[?2004h> "]
[243.561408, "o", "except Exception:\r\n\u001b[?2004l\r"]
[243.561433, "o", "\u001b[?2004h> "]
[243.561468, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r"]
[243.561486, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.561503, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.56153, "o", "> "]
[243.561546, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.561566, "o", "> "]
[243.561589, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[243.561606, "o", "\u001b[?2004h> "]
[243.561653, "o", "    def _split_gemm_kernel(\r\n\u001b[?2004l\r"]
[243.561673, "o", "\u001b[?2004h> "]
[243.561728, "o", "        X, WH, WL, B, Y, M, N, K, s,\r\n\u001b[?2004l\r"]
[243.561749, "o", "\u001b[?2004h> "]
[243.561795, "o", "        stride_xm, stride_xk,\r\n\u001b[?2004l\r"]
[243.561806, "o", "\u001b[?2004h> "]
[243.56186, "o", "        stride_wk, stride_wn,\r\n\u001b[?2004l\r"]
[243.561881, "o", "\u001b[?2004h> "]
[243.561927, "o", "        stride_ym, stride_yn,\r\n\u001b[?2004l\r"]
[243.561947, "o", "\u001b[?2004h> "]
[243.562084, "o", "        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.562173, "o", ">     ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.562212, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.562274, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[243.56229, "o", "\u001b[?2004h> "]
[243.562344, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[243.562364, "o", "\u001b[?2004h> "]
[243.562413, "o", "        width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[243.562437, "o", "\u001b[?2004h> "]
[243.562486, "o", "        group_id = pid // width\r\n\u001b[?2004l\r"]
[243.562504, "o", "\u001b[?2004h> "]
[243.562618, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.562632, "o", "> "]
[243.562718, "o", "        pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[243.562735, "o", "\u001b[?2004h> "]
[243.562812, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[243.562831, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.562845, "o", "\u001b[?2004h> "]
[243.562917, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[243.562933, "o", "\u001b[?2004h> "]
[243.563008, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[243.563024, "o", "\u001b[?2004h> "]
[243.563077, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[243.563093, "o", "\u001b[?2004h> "]
[243.563212, "o", "        X_ptr = X + rm[:, None] * stride_xm + rk[None, :] * stride_xk\r\n\u001b[?2004l\r"]
[243.563234, "o", "\u001b[?2004h> "]
[243.563363, "o", "        WH_ptr = WH + rk[:, None] * stride_wk + rn[None, :] * stride_wn\r\n\u001b[?2004l\r"]
[243.563385, "o", "\u001b[?2004h> "]
[243.563496, "o", "        WL_ptr = WL + rk[:, None] * stride_wk + rn[None, :] * stride_wn\r\n\u001b[?2004l\r"]
[243.563514, "o", "\u001b[?2004h> "]
[243.563597, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[243.563611, "o", "\u001b[?2004h> "]
[243.563669, "o", "        for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[243.563684, "o", "\u001b[?2004h> "]
[243.563735, "o", "            x = tl.load(X_ptr)\r\n\u001b[?2004l\r"]
[243.563755, "o", "\u001b[?2004h> "]
[243.563809, "o", "            xh = x.to(tl.float16)\r\n\u001b[?2004l\r"]
[243.563823, "o", "\u001b[?2004h> "]
[243.563916, "o", "            xl = (x - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[243.563931, "o", "\u001b[?2004h> "]
[243.563987, "o", "            wh = tl.load(WH_ptr)\r\n\u001b[?2004l\r"]
[243.564006, "o", "\u001b[?2004h> "]
[243.564057, "o", "            wl = tl.load(WL_ptr)\r\n\u001b[?2004l\r"]
[243.564076, "o", "\u001b[?2004h> "]
[243.564142, "o", "            acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[243.564156, "o", "\u001b[?2004h> "]
[243.56422, "o", "            acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[243.564234, "o", "\u001b[?2004h> "]
[243.564298, "o", "            acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[243.564318, "o", "\u001b[?2004h> "]
[243.564374, "o", "            X_ptr += BK * stride_xk\r\n\u001b[?2004l\r"]
[243.564389, "o", "\u001b[?2004h> "]
[243.564452, "o", "            WH_ptr += BK * stride_wk\r\n\u001b[?2004l\r"]
[243.564466, "o", "\u001b[?2004h> "]
[243.564529, "o", "            WL_ptr += BK * stride_wk\r\n\u001b[?2004l\r"]
[243.564544, "o", "\u001b[?2004h> "]
[243.564616, "o", "        b = tl.load(B + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[243.564631, "o", "\u001b[?2004h> "]
[243.564679, "o", "        y = acc * s + b * s\r\n\u001b[?2004l\r"]
[243.564694, "o", "\u001b[?2004h> "]
[243.564809, "o", "        Y_ptr = Y + rm[:, None] * stride_ym + rn[None, :] * stride_yn\r\n\u001b[?2004l\r"]
[243.564823, "o", "\u001b[?2004h> "]
[243.564871, "o", "        tl.store(Y_ptr, y)\r\n\u001b[?2004l\r"]
[243.564885, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.564901, "o", "\u001b[?2004h> "]
[243.564916, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.564969, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[243.564984, "o", "\u001b[?2004h> "]
[243.565094, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[243.565115, "o", "\u001b[?2004h> "]
[243.565161, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[243.565176, "o", "\u001b[?2004h> "]
[243.565273, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[243.565293, "o", "\u001b[?2004h> "]
[243.565363, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[243.565377, "o", "\u001b[?2004h> "]
[243.56543, "o", "        self._cache_key = None\r\n\u001b[?2004l\r"]
[243.565449, "o", "\u001b[?2004h> "]
[243.565488, "o", "        self._wh = None\r\n\u001b[?2004l\r"]
[243.565507, "o", "\u001b[?2004h> "]
[243.565545, "o", "        self._wl = None\r\n\u001b[?2004l\r"]
[243.565559, "o", "\u001b[?2004h> "]
[243.5656, "o", "        self._b = None\r\n\u001b[?2004l\r"]
[243.56562, "o", "\u001b[?2004h> "]
[243.565655, "o", "        self._s = None\r\n\u001b[?2004l\r"]
[243.56567, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.565684, "o", "\u001b[?2004h> "]
[243.565734, "o", "    def _prepare(self, x):\r\n\u001b[?2004l\r"]
[243.565753, "o", "\u001b[?2004h> "]
[243.565802, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[243.565819, "o", "\u001b[?2004h> "]
[243.565923, "o", "        key = (w.data_ptr(), w._version, str(w.device), x.shape)\r\n\u001b[?2004l\r"]
[243.565938, "o", "\u001b[?2004h> "]
[243.565998, "o", "        if self._cache_key == key:\r\n\u001b[?2004l\r"]
[243.566013, "o", "\u001b[?2004h> "]
[243.566049, "o", "            return\r\n\u001b[?2004l\r"]
[243.566063, "o", "\u001b[?2004h> "]
[243.56613, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[243.566144, "o", "\u001b[?2004h> "]
[243.566241, "o", "            wt = w.detach().t().contiguous()  # [K, N] fp32\r\n\u001b[?2004l\r"]
[243.566255, "o", "\u001b[?2004h> "]
[243.56632, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[243.566335, "o", "\u001b[?2004h> "]
[243.566438, "o", "            wl = (wt - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[243.566458, "o", "\u001b[?2004h> "]
[243.566518, "o", "            self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[243.566532, "o", "\u001b[?2004h> "]
[243.566598, "o", "            self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[243.566612, "o", "\u001b[?2004h> "]
[243.566704, "o", "            self._b = self.matmul.bias.detach().clone()\r\n\u001b[?2004l\r"]
[243.566718, "o", "\u001b[?2004h> "]
[243.566809, "o", "            self._s = float(self.scaling_factor) + 1.0\r\n\u001b[?2004l\r"]
[243.566828, "o", "\u001b[?2004h> "]
[243.566882, "o", "            self._cache_key = key\r\n\u001b[?2004l\r"]
[243.566897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.566911, "o", "\u001b[?2004h> "]
[243.566959, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[243.566974, "o", "\u001b[?2004h> "]
[243.566998, "o", "        if (\r\n\u001b[?2004l\r"]
[243.567013, "o", "\u001b[?2004h> "]
[243.567055, "o", "            _HAS_TRITON\r\n\u001b[?2004l\r"]
[243.56707, "o", "\u001b[?2004h> "]
[243.567141, "o", "            and x.device.type == \"cuda\"\r\n\u001b[?2004l\r"]
[243.56716, "o", "\u001b[?2004h> "]
[243.567224, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[243.567243, "o", "\u001b[?2004h> "]
[243.567289, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[243.567304, "o", "\u001b[?2004h> "]
[243.567328, "o", "        ):\r\n\u001b[?2004l\r"]
[243.567343, "o", "\u001b[?2004h> "]
[243.567408, "o", "            if not x.is_contiguous():\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.567422, "o", "> "]
[243.567481, "o", "                x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.567496, "o", "> "]
[243.567546, "o", "            self._prepare(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.56756, "o", "> "]
[243.567606, "o", "            M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.567621, "o", "> "]
[243.567676, "o", "            N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[243.567695, "o", "\u001b[?2004h> "]
[243.567794, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 32 == 0:\r\n\u001b[?2004l\r"]
[243.567813, "o", "\u001b[?2004h> "]
[243.567939, "o", "                y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[243.567958, "o", "\u001b[?2004h> "]
[243.568018, "o", "                grid = lambda meta: (\r\n\u001b[?2004l\r"]
[243.568037, "o", "\u001b[?2004h> "]
[243.568161, "o", "                    triton.cdiv(M, meta[\"BM\"]) * triton.cdiv(N, meta[\"BN\"]),\r\n\u001b[?2004l\r"]
[243.568181, "o", "\u001b[?2004h> "]
[243.568207, "o", "                )\r\n\u001b[?2004l\r"]
[243.568222, "o", "\u001b[?2004h> "]
[243.568291, "o", "                _split_gemm_kernel[grid](\r\n\u001b[?2004l\r"]
[243.56831, "o", "\u001b[?2004h> "]
[243.568397, "o", "                    x, self._wh, self._wl, self._b, y,\r\n\u001b[?2004l\r"]
[243.568414, "o", "\u001b[?2004h> "]
[243.568475, "o", "                    M, N, K, self._s,\r\n\u001b[?2004l\r"]
[243.568489, "o", "\u001b[?2004h> "]
[243.568565, "o", "                    x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[243.568583, "o", "\u001b[?2004h> "]
[243.568678, "o", "                    self._wh.stride(0), self._wh.stride(1),\r\n\u001b[?2004l\r"]
[243.568697, "o", "\u001b[?2004h> "]
[243.568768, "o", "                    y.stride(0), y.stride(1),\r\n\u001b[?2004l\r"]
[243.568783, "o", "\u001b[?2004h> "]
[243.568869, "o", "                    BM=128, BN=256, BK=64, GROUP=8,\r\n\u001b[?2004l\r"]
[243.568884, "o", "\u001b[?2004h> "]
[243.568962, "o", "                    num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[243.56898, "o", "\u001b[?2004h> "]
[243.56901, "o", "                )\r\n\u001b[?2004l\r"]
[243.569025, "o", "\u001b[?2004h> "]
[243.56907, "o", "                return y\r\n\u001b[?2004l\r"]
[243.569085, "o", "\u001b[?2004h> "]
[243.569137, "o", "        y = self.matmul(x)\r\n\u001b[?2004l\r"]
[243.569156, "o", "\u001b[?2004h> "]
[243.569242, "o", "        return y * self.scaling_factor + y.detach()\r\n\u001b[?2004l\r"]
[243.569256, "o", "\u001b[?2004h> "]
[243.569271, "o", "EOF\r\n\u001b[?2004l\r"]
[243.629073, "o", "\u001b[?2004hroot@modal:/# echo written\r\n\u001b[?2004l\rwritten\r\n\u001b[?2004hroot@modal:/# "]
[243.971853, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\n\ndevice = 'cuda'\ntorch.manual_seed(42)\ninit = get_init_inputs()\nm_ref = Model(*init).to(device)\ntorch.manual_seed(42)\nfrom solution import ModelNew\nm_new = ModelNew(*init).to(device)\nprint('weights close:', torch.allclose(m_ref.matmul.weight, m_new.matmul.weight))\nx = get_inputs()[0].to(device)\nwith torch.no_grad():\n    ref = m_ref(x)\n    out = m_new(x)\nprint('max diff', (ref - out).abs().max().item(), 'mean diff', (ref-out).abs().mean().item())\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    es = []\n    cache = torch.empty(256*1024*1024//4, device=device, dtype=torch.float32)\n    for _ in range(n):\n        cache.zero_()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.sync"]
[243.971981, "i", "hronize()\n        es.append(s.elapsed_time(e))\n    es.sort()\n    return sum(es)/len(es), es[0]\n\nwith torch.no_grad():\n    t_ref, t_ref_min = bench(lambda: m_ref(x))\n    t_new, t_new_min = bench(lambda: m_new(x))\n\n# 3xTF32 variant\nw = m_ref.matmul.weight.detach()\nb = m_ref.matmul.bias.detach()\nmask = ~65535\nwh32 = (w.view(torch.int32) & mask).view(torch.float32).t().contiguous()\nwl32 = (w - (w.view(torch.int32) & mask).view(torch.float32)).t().contiguous()\ndef f_tf32():\n    prev = torch.backends.cuda.matmul.allow_tf32\n    torch.backends.cuda.matmul.allow_tf32 = True\n    try:\n        xh = (x.view(torch.int32) & mask).view(torch.float32)\n        xl = x - xh\n        y = torch.addmm(b, xh, wh32, beta=1.5, alpha=1.5)\n        y.addmm_(xl, wh32)\n        y.addmm_(xh, wl32)\n    finally:\n        torch.backends.cuda.matmul.allow_tf32 = prev\n    return y\nwith torch.no_grad():\n    o32 = f_tf32()\n    print('tf32 max diff', (ref - o32).abs().max().item())\n    t_t32, t_t32_min = bench(f_tf32)\n\n# plain fused fp32 addmm\nwt = w."]
[243.972006, "i", "t().contiguous()\ndef f_f32():\n    return torch.addmm(b, x, wt, beta=1.5, alpha=1.5)\nwith torch.no_grad():\n    of = f_f32()\n    print('fused fp32 max diff', (ref-of).abs().max().item())\n    t_f32, _ = bench(f_f32)\nprint(f'ref {t_ref:.3f} ms | triton-split {t_new:.3f} (min {t_new_min:.3f}) | tf32x3 {t_t32:.3f} (min {t_t32_min:.3f}) | fused-fp32 {t_f32:.3f}')\nprint(f'speedups: triton {t_ref/t_new:.2f}x, tf32x3 {t_ref/t_t32:.2f}x, fp32 {t_ref/t_f32:.2f}x')\nEOF\necho bench written\n"]
[243.972116, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[243.972165, "o", "\u001b[?2004h> "]
[243.972221, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.972241, "o", "> "]
[243.972319, "o", "sys.path.insert(0, '/opt/task')\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.972332, "o", "> "]
[243.972525, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.972587, "o", "from reference import Model, get_inputs, get_init_inputs\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.972603, "o", "\u001b[?2004h> "]
[243.972646, "o", "device = 'cuda'\r\n\u001b[?2004l\r"]
[243.97268, "o", "\u001b[?2004h> "]
[243.972741, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.972755, "o", "> "]
[243.972811, "o", "init = get_init_inputs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.972825, "o", "> "]
[243.972893, "o", "m_ref = Model(*init).to(device)\r\n\u001b[?2004l\r"]
[243.972907, "o", "\u001b[?2004h> "]
[243.972954, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[243.972986, "o", "\u001b[?2004h> "]
[243.973033, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[243.973065, "o", "\u001b[?2004h> "]
[243.973132, "o", "m_new = ModelNew(*init).to(device)\r\n\u001b[?2004l\r"]
[243.973164, "o", "\u001b[?2004h> "]
[243.973315, "o", "print('weights close:', torch.allclose(m_ref.matmul.weight, m_new.matmul.weight))\r\n\u001b[?2004l\r"]
[243.973328, "o", "\u001b[?2004h> "]
[243.973397, "o", "x = get_inputs()[0].to(device)\r\n\u001b[?2004l\r"]
[243.973425, "o", "\u001b[?2004h> "]
[243.97346, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[243.973496, "o", "\u001b[?2004h> "]
[243.973522, "o", "    ref = m_ref(x)\r\n\u001b[?2004l\r"]
[243.973553, "o", "\u001b[?2004h> "]
[243.973583, "o", "    out = m_new(x)\r\n\u001b[?2004l\r"]
[243.973618, "o", "\u001b[?2004h> "]
[243.973778, "o", "print('max diff', (ref - out).abs().max().item(), 'mean diff', (ref-out).abs().mean().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.973815, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.973847, "o", "def bench(fn, n=30):\r\n\u001b[?2004l\r"]
[243.97388, "o", "\u001b[?2004h> "]
[243.973915, "o", "    for _ in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.97394, "o", "        fn()\r\n\u001b[?2004l\r"]
[243.973975, "o", "\u001b[?2004h> "]
[243.974005, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[243.974043, "o", "\u001b[?2004h>     es = []\r\n\u001b[?2004l\r"]
[243.974078, "o", "\u001b[?2004h> "]
[243.974214, "o", "    cache = torch.empty(256*1024*1024//4, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.97425, "o", "> "]
[243.974286, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.974322, "o", "        cache.zero_()\r\n\u001b[?2004l\r"]
[243.974356, "o", "\u001b[?2004h> "]
[243.974391, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[243.974424, "o", "\u001b[?2004h> "]
[243.974557, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[243.974592, "o", "\u001b[?2004h> "]
[243.974675, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[243.97471, "o", "\u001b[?2004h> "]
[243.974753, "o", "        es.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[243.974785, "o", "\u001b[?2004h> "]
[243.974818, "o", "    es.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.974877, "o", "    return sum(es)/len(es), es[0]\r\n\u001b[?2004l\r"]
[243.974905, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.974947, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[243.974979, "o", "\u001b[?2004h> "]
[243.97504, "o", "    t_ref, t_ref_min = bench(lambda: m_ref(x))\r\n\u001b[?2004l\r"]
[243.975073, "o", "\u001b[?2004h> "]
[243.975137, "o", "    t_new, t_new_min = bench(lambda: m_new(x))\r\n\u001b[?2004l\r"]
[243.975172, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.975204, "o", "# 3xTF32 variant\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.975236, "o", "> "]
[243.975271, "o", "w = m_ref.matmul.weight.detach()\r\n\u001b[?2004l\r"]
[243.975304, "o", "\u001b[?2004h> "]
[243.975341, "o", "b = m_ref.matmul.bias.detach()\r\n\u001b[?2004l\r"]
[243.975369, "o", "\u001b[?2004h> "]
[243.975403, "o", "mask = ~65535\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.975519, "o", "wh32 = (w.view(torch.int32) & mask).view(torch.float32).t().contiguous()\r\n\u001b[?2004l\r"]
[243.975556, "o", "\u001b[?2004h> "]
[243.97566, "o", "wl32 = (w - (w.view(torch.int32) & mask).view(torch.float32)).t().contiguous()\r\n\u001b[?2004l\r"]
[243.975696, "o", "\u001b[?2004h> "]
[243.97573, "o", "def f_tf32():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.975799, "o", "    prev = torch.backends.cuda.matmul.allow_tf32\r\n\u001b[?2004l\r"]
[243.975832, "o", "\u001b[?2004h> "]
[243.975896, "o", "    torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[243.97593, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[243.975966, "o", "\u001b[?2004h> "]
[243.976045, "o", "        xh = (x.view(torch.int32) & mask).view(torch.float32)\r\n\u001b[?2004l\r"]
[243.976079, "o", "\u001b[?2004h> "]
[243.97611, "o", "        xl = x - xh\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.976211, "o", "        y = torch.addmm(b, xh, wh32, beta=1.5, alpha=1.5)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.976244, "o", "> "]
[243.976275, "o", "        y.addmm_(xl, wh32)\r\n\u001b[?2004l\r"]
[243.976303, "o", "\u001b[?2004h> "]
[243.976346, "o", "        y.addmm_(xh, wl32)\r\n\u001b[?2004l\r"]
[243.976381, "o", "\u001b[?2004h> "]
[243.976416, "o", "    finally:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.9765, "o", "        torch.backends.cuda.matmul.allow_tf32 = prev\r\n\u001b[?2004l\r"]
[243.976528, "o", "\u001b[?2004h> "]
[243.976562, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.976595, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[243.976628, "o", "\u001b[?2004h> "]
[243.97666, "o", "    o32 = f_tf32()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.976755, "o", "    print('tf32 max diff', (ref - o32).abs().max().item())\r\n\u001b[?2004l\r"]
[243.976788, "o", "\u001b[?2004h> "]
[243.976832, "o", "    t_t32, t_t32_min = bench(f_tf32)\r\n\u001b[?2004l\r"]
[243.976864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.976909, "o", "# plain fused fp32 addmm\r\n\u001b[?2004l\r"]
[243.976942, "o", "\u001b[?2004h> "]
[243.976969, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.976998, "o", "> def f_f32():\r\n\u001b[?2004l\r"]
[243.977032, "o", "\u001b[?2004h> "]
[243.977115, "o", "    return torch.addmm(b, x, wt, beta=1.5, alpha=1.5)\r\n\u001b[?2004l\r"]
[243.977149, "o", "\u001b[?2004h> "]
[243.977176, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.977209, "o", "    of = f_f32()\r\n\u001b[?2004l\r"]
[243.977237, "o", "\u001b[?2004h> "]
[243.977329, "o", "    print('fused fp32 max diff', (ref-of).abs().max().item())\r\n\u001b[?2004l\r"]
[243.977361, "o", "\u001b[?2004h> "]
[243.977391, "o", "    t_f32, _ = bench(f_f32)\r\n\u001b[?2004l\r"]
[243.977424, "o", "\u001b[?2004h> "]
[243.977651, "o", "print(f'ref {t_ref:.3f} ms | triton-split {t_new:.3f} (min {t_new_min:.3f}) | tf32x3 {t_t32:.3f} (min {t_t32_min:.3f}) | fused-fp32 {t_f32:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.977678, "o", "> "]
[243.977831, "o", "print(f'speedups: triton {t_ref/t_new:.2f}x, tf32x3 {t_ref/t_t32:.2f}x, fp32 {t_ref/t_f32:.2f}x')\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.97787, "o", "> EOF\r\n\u001b[?2004l\r"]
[243.979438, "o", "\u001b[?2004hroot@modal:/# "]
[243.979465, "o", "echo bench written\r\n\u001b[?2004l\r"]
[243.979498, "o", "bench written\r\n\u001b[?2004hroot@modal:/# "]
[246.38906, "i", "gpu run -- python3 /workspace/bench.py\n"]
[246.389307, "o", "gpu run -- python3 /workspace/bench.py\r\n\u001b[?2004l\r"]
