[37.321981, "o", "\r\n    init_inputs = get_init_inputs()\r\n    \r\n    # Convert inputs to appropriate dtypes for GPU computation\r\n    init_inputs = [_process_input_tensor(x, device, backend, precision) for x in init_inputs]\r\n    \r\n"]
