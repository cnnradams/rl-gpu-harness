[?2004limport torch
import torch.nn as nn
import torch.nn.functional as F

# Ensure exact FP32 matmul (no TF32) for bitwise-stable correctness
torch.backends.cuda.matmul.allow_tf32 = False
torch.backends.cudnn.allow_tf32 = False


class ModelNew(nn.Module):
    """
    Fused: matmul -> scale -> add residual simplifies to (1+s) * linear(x).
    We pre-scale the weights and bias by (1 + scaling_factor) so the forward
    pass is a single GEMM (addmm), eliminating clone/mul/add elementwise ops.
    """
    def __init__(self, in_features, out_features, scaling_factor):
        super(ModelNew, self).__init__()
        self.matmul = nn.Linear(in_features, out_features)
        self.scaling_factor = scaling_factor
        alpha = 1.0 + float(scaling_factor)
        with torch.no_grad():
            self.matmul.weight.mul_(alpha)
            self.matmul.bias.mul_(alpha)

    def forward(self, x):
        return F.linear(x, self.matmul.weight, self.matmul.bias)
