[?2004l[?2004h> # TMA descriptor based split gemm
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def split_gemm_tma(XHd, XLd, WHd, WLd, BIAS, OUT, M, N, K,
[?2004l[?2004h>                alpha: tl.constexpr, inv_s: tl.constexpr,
[?2004l[?2004h>                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     num_pid_in_group = GROUP * num_pid_n
[?2004l[?2004h>     group_id = pid // num_pid_in_group
[?2004l[?2004h>     first_pid_m = group_id * GROUP
[?2004l[?2004h>     group_size_m = min(num_pid_m - first_pid_m, GROUP)
[?2004l[?2004h>     pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)
[?2004l[?2004h>     pid_n = (pid % num_pid_in_group) // group_size_m
[?2004l[?2004h>     om = pid_m * BM
[?2004l[?2004h>     on = pid_n * BN
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     accc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, K, BK):
[?2004l[?2004h>         xh = XHd.load([om, k])
[?2004l[?2004h>         xl = XLd.load([om, k])
[?2004l[?2004h>         wh = WHd.load([k, on])
[?2004l[?2004h>         wl = WLd.load([k, on])
[?2004l[?2004h>         acc = tl.dot(xh, wh, acc)
[?2004l[?2004h>         accc = tl.dot(xh, wl, accc)
[?2004l[?2004h>         accc = tl.dot(xl, wh, accc)
[?2004l[?2004h>     bias = tl.load(BIAS + on + tl.arange(0, BN))
[?2004l[?2004h>     out = (acc + accc*inv_s)*alpha + bias[None, :]
[?2004l[?2004h>     rm = om + tl.arange(0, BM)
[?2004l[?2004h>     rn = on + tl.arange(0, BN)
[?2004l[?2004h>     tl.store(OUT + rm[:, None]*N + rn[None, :], out)
[?2004l[?2004h> 
[?2004l[?2004h> def timeit(fn, n=15):
[?2004l[?2004h>     for _ in range(3): fn()
[?2004l[?2004h>     torch.cuda.synchronize()
[?2004l[?2004h>     ts=[]
[?2004l[?2004h>     for _ in range(n):
[?2004l[?2004h>         d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d
[?2004l[?2004h>         s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>         torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()
[?2004l[?2004h>         ts.append(s.elapsed_time(e))
[?2004l[?2004h>     ts.sort(); return ts[len(ts)//2]
[?2004l[?2004h> 
