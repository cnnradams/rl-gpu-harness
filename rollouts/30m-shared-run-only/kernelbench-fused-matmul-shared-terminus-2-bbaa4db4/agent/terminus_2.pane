print(f"3xtf32: {t_3xtf32:.3f} ms, max abs err {err:.3e}, max rel {rel:.3e}")
torch.backends.cuda.matmul.allow_tf32 = False

# fp16x3 emulation: a = hi(fp16) + lo(fp16 scaled)
def split_fp16(a):
    hi = a.half()
    lo = (a - hi.float()).half()
    return hi, lo

def mm_3xfp16(x, w, b):
    xh, xl = split_fp16(x)
    wh, wl = split_fp16(w)
    out = torch.mm(xh, wh.t()).float()
    out.addmm_(xh.float() if False else xh, wl.t())  # hmm need fp16 in, fp32 out
    out.addmm_(xl, wh.t())
    out.add_(b)
    return out
# torch mm with fp16 inputs gives fp16 output; need fp32 accumulate-out: use torch.mm with out= fp32 not supported.
# Use torch.addmm with float out? Mixed dtype mm: torch.mm supports only same dtype.
# Instead accumulate in fp32 via baddbmm? Simpler: cast results.
def mm_3xfp16_v2(x, w, b):
    xh, xl = split_fp16(x)
    wh, wl = split_fp16(w)
    out = torch.mm(xh, wh.t()).float()
    out += torch.mm(xh, wl.t()).float()
    out += torch.mm(xl, wh.t()).float()
    out += b
    return out
t_3xfp16 = bench(lambda: mm_3xfp16_v2(x, w, b))
err2 = (mm_3xfp16_v2(x, w, b) - ref).abs().max().item()
print(f"3xfp16: {t_3xfp16:.3f} ms, max abs err {err2:.3e}")
