[353.898726, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time\n\ntorch.backends.cuda.matmul.allow_tf32 = False\n\ndef bench(fn, n=50):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    times = []\n    for _ in range(n):\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return times[len(times)//2]\n\nM = K = N = 4096\nB = 16384\nx = torch.randn(B, K, device='cuda')\nw = torch.randn(N, K, device='cuda')\nb = torch.randn(N, device='cuda')\n\n# fp32\nt_fp32 = bench(lambda: torch.addmm(b, x, w.t()))\nprint(f\"fp32 addmm: {t_fp32:.3f} ms  ({2*B*K*N/t_fp32/1e9:.1f} TFLOPS)\")\n\n# tf32\ntorch.backends.cuda.matmul.allow_tf32 = True\nt_tf32 = bench(lambda: torch.addmm(b, x, w.t()))\nprint(f\"tf32 addmm: {t_tf32:.3f} ms  ({2*B*K*N/t_tf32/1e9:.1f} TFLOPS)\")\ntorch.backends.cuda.matmul.allow_tf32 = False\n\n# fp16\nxh = x.half(); wh = "]
[353.898776, "i", "w.half(); bh = b.half()\nt_fp16 = bench(lambda: torch.addmm(bh, xh, wh.t()))\nprint(f\"fp16 addmm: {t_fp16:.3f} ms  ({2*B*K*N/t_fp16/1e9:.1f} TFLOPS)\")\n\n# bf16\nxb = x.bfloat16(); wb = w.bfloat16()\nt_bf16 = bench(lambda: torch.addmm(b.float16 if False else b.bfloat16(), xb, wb.t()))\nprint(f\"bf16 addmm: {t_bf16:.3f} ms  ({2*B*K*N/t_bf16/1e9:.1f} TFLOPS)\")\n\nref = torch.addmm(b, x, w.t())\n\n# 3xTF32 emulation: split each operand into hi (tf32-representable) + lo\ndef split_tf32(a):\n    # zero out low 13 mantissa bits of fp32\n    ai = a.view(torch.int32)\n    hi = (ai & -8192).view(torch.float32)  # keep top 10 mantissa bits\n    lo = a - hi\n    return hi, lo\n\ntorch.backends.cuda.matmul.allow_tf32 = True\ndef mm_3xtf32(x, w, b):\n    xh, xl = split_tf32(x)\n    wh, wl = split_tf32(w)\n    wt = w.t()\n    out = torch.mm(xh, wh.t())\n    out.addmm_(xh, wl.t())\n    out.addmm_(xl, wh.t())\n    out.add_(b)\n    return out\nt_3xtf32 = bench(lambda: mm_3xtf32(x, w, b))\nerr = (mm_3xtf32(x, w, b) - ref).abs().max().item()\nrel = ((mm_3xtf3"]
[353.898928, "i", "2(x, w, b) - ref).abs() / ref.abs().clamp_min(1)).max().item()\nprint(f\"3xtf32: {t_3xtf32:.3f} ms, max abs err {err:.3e}, max rel {rel:.3e}\")\ntorch.backends.cuda.matmul.allow_tf32 = False\n\n# fp16x3 emulation: a = hi(fp16) + lo(fp16 scaled)\ndef split_fp16(a):\n    hi = a.half()\n    lo = (a - hi.float()).half()\n    return hi, lo\n\ndef mm_3xfp16(x, w, b):\n    xh, xl = split_fp16(x)\n    wh, wl = split_fp16(w)\n    out = torch.mm(xh, wh.t()).float()\n    out.addmm_(xh.float() if False else xh, wl.t())  # hmm need fp16 in, fp32 out\n    out.addmm_(xl, wh.t())\n    out.add_(b)\n    return out\n# torch mm with fp16 inputs gives fp16 output; need fp32 accumulate-out: use torch.mm with out= fp32 not supported.\n# Use torch.addmm with float out? Mixed dtype mm: torch.mm supports only same dtype.\n# Instead accumulate in fp32 via baddbmm? Simpler: cast results.\ndef mm_3xfp16_v2(x, w, b):\n    xh, xl = split_fp16(x)\n    wh, wl = split_fp16(w)\n    out = torch.mm(xh, wh.t()).float()\n    out += torch.mm(xh, wl.t()).float()\n    out += to"]
[353.898944, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[353.898996, "i", "rch.mm(xl, wh.t()).float()\n    out += b\n    return out\nt_3xfp16 = bench(lambda: mm_3xfp16_v2(x, w, b))\nerr2 = (mm_3xfp16_v2(x, w, b) - ref).abs().max().item()\nprint(f\"3xfp16: {t_3xfp16:.3f} ms, max abs err {err2:.3e}\")\nEOF\ngpu run -- python3 /workspace/bench.py\n"]
[353.899029, "o", "2(x, w, b) - ref).abs() / ref.abs().clamp_min(1)).max().item()\r\nprint(f\"3xtf32: {t_3xtf32:.3f} ms, max abs err {err:.3e}, max rel {rel:.3e}\")\r\ntorch.backends.cuda.matmul.allow_tf32 = False\r\n\r\n# fp16x3 emulation: a = hi(fp16) + lo(fp16 scaled)\r\ndef split_fp16(a):\r\n    hi = a.half()\r\n    lo = (a - hi.float()).half()\r\n    return hi, lo\r\n\r\ndef mm_3xfp16(x, w, b):\r\n    xh, xl = split_fp16(x)\r\n    wh, wl = split_fp16(w)\r\n    out = torch.mm(xh, wh.t()).float()\r\n    out.addmm_(xh.float() if False else xh, wl.t())  # hmm need fp16 in, fp32 out\r\n    out.addmm_(xl, wh.t())\r\n    out.add_(b)\r\n    return out\r\n# torch mm with fp16 inputs gives fp16 output; need fp32 accumulate-out: use torch.m"]
[353.899064, "o", "m with out= fp32 not supported.\r\n# Use torch.addmm with float ou"]
[353.899098, "o", "t? Mixed dtype mm: torch.mm supports only same dtype.\r\n# Instead accumulate in fp32 via baddbmm? Simpler: cast results.\r\ndef mm_3xfp16_v2(x, w, b):\r\n    xh, xl = split_fp16(x)\r\n    wh, wl = split_fp16(w)\r\n    out = torch.mm(xh, wh.t()).float()\r\n    out += torch.mm(xh, wl.t()).float()\r\n    out += torch.mm(xl, wh.t()).float()\r\n    out += b\r\n    return out\r\nt_3xfp16 = bench(lambda: mm_3xfp16_v2(x, w, b))\r\nerr2 = (mm_3xfp16_v2(x, w, b"]
