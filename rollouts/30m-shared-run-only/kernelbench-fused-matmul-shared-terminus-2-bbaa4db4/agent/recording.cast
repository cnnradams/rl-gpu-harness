[1039.933172, "o", "from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.933246, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.933283, "o", "def split_ws(XHd, XLd, WHd, WLd, BIAS, OUTd, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.933337, "o", "             alpha: tl.constexpr, inv_s: tl.constexpr,\r\n\u001b[?2004l\r"]
[1039.933368, "o", "\u001b[?2004h> "]
[1039.933489, "o", "             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.933529, "o", "             GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1039.933561, "o", "\u001b[?2004h> "]
[1039.933608, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.933671, "o", "    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1039.933702, "o", "\u001b[?2004h> "]
