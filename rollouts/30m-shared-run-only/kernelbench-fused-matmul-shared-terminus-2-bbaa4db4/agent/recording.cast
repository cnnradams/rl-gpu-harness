[1039.93613, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1039.936154, "o", "> "]
[1039.936178, "o", "M,K,N = 16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[1039.936206, "o", "> "]
