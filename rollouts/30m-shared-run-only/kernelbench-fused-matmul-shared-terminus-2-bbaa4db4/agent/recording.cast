[553.453498, "o", "    rm = pid_m*BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.453544, "o", "    rn = pid_n*BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
