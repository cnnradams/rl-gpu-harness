[1039.933764, "o", "\u001b[?2004h> "]
[1039.933809, "o", "    num_tiles = num_pid_m * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.933848, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1039.933887, "o", "\u001b[?2004h> "]
[1039.933977, "o", "    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\r\n\u001b[?2004l\r"]
[1039.934032, "o", "\u001b[?2004h> "]
[1039.934074, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.934122, "o", "        first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r\u001b[?2004h"]
[1039.934162, "o", "> "]
[1039.934202, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1039.934231, "o", "> "]
[1039.934303, "o", "        pid_m = first_pid_m + ((tile_id % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1039.934345, "o", "\u001b[?2004h> "]
[1039.934384, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1039.934425, "o", "\u001b[?2004h>         om = pid_m * BM\r\n\u001b[?2004l\r"]
