[1215.050391, "i", "cat > /workspace/solution.py << 'PYEOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ntorch.backends.cuda.matmul.allow_tf32 = False\ntorch.backends.cudnn.allow_tf32 = False\n\n_SPLIT_SCALE = 2048.0  # 2**11\n\n\n@triton.jit\ndef _xsplit_kernel(X, XH, XL, n, s: tl.constexpr, BLK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLK + tl.arange(0, BLK)\n    mask = offs < n\n    a = tl.load(X + offs, mask=mask)\n    ah = a.to(tl.float16)\n    al = ((a - ah.to(tl.float32)) * s).to(tl.float16)\n    tl.store(XH + offs, ah, mask=mask)\n    tl.store(XL + offs, al, mask=mask)\n\n\n@triton.jit\ndef _split_gemm(XHd, XLd, WHd, WLd, BIAS, OUT, M, N, K,\n                alpha: tl.constexpr, inv_s: tl.constexpr,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // "]
[1215.050443, "i", "num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    om = pid_m * BM\n    on = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    accc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        xh = XHd.load([om, k])\n        xl = XLd.load([om, k])\n        wh = WHd.load([k, on])\n        wl = WLd.load([k, on])\n        acc = tl.dot(xh, wh, acc)\n        accc = tl.dot(xh, wl, accc)\n        accc = tl.dot(xl, wh, accc)\n    rn = on + tl.arange(0, BN)\n    bias = tl.load(BIAS + rn, mask=rn < N, other=0.0)\n    out = (acc + accc * inv_s) * alpha + bias[None, :]\n    rm = om + tl.arange(0, BM)\n    tl.store(OUT + rm[:, None] * N + rn[None, :], out,\n             mask=(rm < M)[:, None] & (rn < N)[None, :])\n\n\nclass ModelNew(nn.Module):\n    \"\"\"\n    The reference computes y = x @ W^T + b, then y*s + y = (1+s)*y.\n    We fuse t"]
[1215.050453, "i", "he (1+s) factor into an fp32 copy of the bias and evaluate the\n    GEMM using an fp16 hi/lo (2-segment) decomposition computed on tensor\n    cores with fp32 accumulation:\n        x ~ xh + xl/2^11,  W ~ wh + wl/2^11\n        x@W ~ xh@wh + (xh@wl + xl@wh)/2^11   (dropped term ~2^-22 relative)\n    Max abs error vs fp32 reference is ~2e-5 (tolerance is 1e-4).\n    \"\"\"\n\n    BM = 128\n    BN = 128\n    BK = 64\n    GROUP = 8\n    WARPS = 8\n    STAGES = 3\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        alpha = 1.0 + float(scaling_factor)\n        self._alpha = alpha\n        with torch.no_grad():\n            wt = self.matmul.weight.detach().t().contiguous()\n            wh = wt.half()\n            wl = ((wt - wh.float()) * _SPLIT_SCALE).half()\n            bias = (self.matmul.bias.detach() * alpha).contiguous()\n        # Store fp16 tensors as int16 views so"]
[1215.050459, "i", " nn.Module.to(dtype=float32)\n        # does not upcast them (it only converts floating point tensors).\n        self.register_buffer(\"wh_i16\", wh.view(torch.int16), persistent=False)\n        self.register_buffer(\"wl_i16\", wl.view(torch.int16), persistent=False)\n        self.register_buffer(\"bias_f\", bias, persistent=False)\n\n    def forward(self, x):\n        if x.is_cuda and x.dtype == torch.float32:\n            return self._forward_cuda(x)\n        y = F.linear(x, self.matmul.weight, self.matmul.bias)\n        return y * self.scaling_factor + y\n\n    def _forward_cuda(self, x):\n        from triton.tools.tensor_descriptor import TensorDescriptor\n\n        x = x.contiguous()\n        M, K = x.shape\n        N = self.bias_f.shape[0]\n        dev = x.device\n\n        xh = torch.empty((M, K), device=dev, dtype=torch.float16)\n        xl = torch.empty((M, K), device=dev, dtype=torch.float16)\n        n = M * K\n        BLK = 8192\n        _xsplit_kernel[(triton.cdiv(n, BLK),)](\n            x, xh, xl, n, _SPLIT_SCALE, BLK, num_w"]
[1215.050605, "i", "arps=8\n        )\n\n        wh = self.wh_i16.view(torch.float16)\n        wl = self.wl_i16.view(torch.float16)\n\n        BM, BN, BK = self.BM, self.BN, self.BK\n        out = torch.empty((M, N), device=dev, dtype=torch.float32)\n        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\n        xld = TensorDescriptor.from_tensor(xl, [BM, BK])\n        whd = TensorDescriptor.from_tensor(wh, [BK, BN])\n        wld = TensorDescriptor.from_tensor(wl, [BK, BN])\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        _split_gemm[grid](\n            xhd, xld, whd, wld, self.bias_f, out, M, N, K,\n            self._alpha, 1.0 / _SPLIT_SCALE,\n            BM, BN, BK, self.GROUP,\n            num_warps=self.WARPS, num_stages=self.STAGES,\n        )\n        return out\nPYEOF\ngpu run -- python3 /opt/task/evaluate.py /workspace/solution.py\n"]
[1215.050646, "o", "cat > /workspace/solution.py << 'PYEOF'\r\n\u001b[?2004l\rarps=8\r\n        )\r\n\r\n        wh = self.wh_"]
