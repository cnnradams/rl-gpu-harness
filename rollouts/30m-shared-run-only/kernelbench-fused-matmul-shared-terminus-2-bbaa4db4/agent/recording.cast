[1503.967948, "o", "\u001b[?2004h"]
[1503.967976, "o", "> "]
[1503.968001, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1503.968026, "o", "\u001b[?2004h> "]
[1503.968061, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1503.968085, "o", "\u001b[?2004h> "]
[1503.968115, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[1503.96814, "o", "\u001b[?2004h> "]
[1503.968193, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[1503.968217, "o", "\u001b[?2004h> "]
[1503.968283, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1503.968307, "o", "\u001b[?2004h> "]
[1503.968378, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.9684, "o", "> "]
[1503.968441, "o", "    om = pid_m * BM; on = pid_n * BN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.968505, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.968568, "o", "    accc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1503.968594, "o", "\u001b[?2004h> "]
[1503.968619, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1503.968642, "o", "\u001b[?2004h> "]
[1503.968676, "o", "        xh = XHd.load([om, k])\r\n\u001b[?2004l\r"]
[1503.9687, "o", "\u001b[?2004h> "]
[1503.968727, "o", "        x2 = X2d.load([om, 2*k])\r\n\u001b[?2004l\r"]
[1503.968752, "o", "\u001b[?2004h> "]
[1503.968779, "o", "        wh = WHd.load([k, on])\r\n\u001b[?2004l\r"]
[1503.968802, "o", "\u001b[?2004h> "]
[1503.968833, "o", "        w2 = W2d.load([2*k, on])\r\n\u001b[?2004l\r"]
[1503.96886, "o", "\u001b[?2004h> "]
[1503.968892, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[1503.968919, "o", "\u001b[?2004h> "]
[1503.968949, "o", "        accc = tl.dot(x2, w2, accc)\r\n\u001b[?2004l\r"]
[1503.968976, "o", "\u001b[?2004h> "]
[1503.969047, "o", "    bias = tl.load(BIAS + on + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[1503.969074, "o", "\u001b[?2004h> "]
[1503.969121, "o", "    out = (acc + accc*inv_s)*alpha + bias[None, :]\r\n\u001b[?2004l\r"]
[1503.969142, "o", "\u001b[?2004h> "]
[1503.969218, "o", "    rm = om + tl.arange(0, BM); rn = on + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.969248, "o", "> "]
[1503.969303, "o", "    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.969329, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.969363, "o", "def timeit(fn, n=15):\r\n\u001b[?2004l\r"]
[1503.969391, "o", "\u001b[?2004h> "]
[1503.969416, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.969441, "o", "> "]
[1503.969463, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1503.969486, "o", "\u001b[?2004h>     ts=[]\r\n\u001b[?2004l\r"]
[1503.969512, "o", "\u001b[?2004h> "]
[1503.969536, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1503.969559, "o", "\u001b[?2004h> "]
[1503.969654, "o", "        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[1503.96968, "o", "\u001b[?2004h> "]
[1503.969767, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1503.969791, "o", "\u001b[?2004h> "]
[1503.969883, "o", "        torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1503.969908, "o", "\u001b[?2004h> "]
[1503.96994, "o", "        ts.append(s.elapsed_time(e))\r\n"]
[1503.969999, "o", "\u001b[?2004l\r"]
[1503.970022, "o", "\u001b[?2004h> "]
[1503.970072, "o", "    ts.sort(); return ts[len(ts)//2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.970095, "o", "> "]
[1503.970119, "o", "M,K,N = 16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.970147, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[1503.97017, "o", "\u001b[?2004h> "]
[1503.970201, "o", "x = torch.rand(M,K,device='cuda')\r\n\u001b[?2004l\r"]
[1503.970224, "o", "\u001b[?2004h> "]
[1503.970247, "o", "bound=1/64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.970295, "o", "w=(torch.rand(N,K,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r"]
[1503.970318, "o", "\u001b[?2004h> "]
[1503.970357, "o", "b=(torch.rand(N,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r"]
[1503.97038, "o", "\u001b[?2004h> alpha=1.5\r\n\u001b[?2004l\r"]
[1503.970402, "o", "\u001b[?2004h> "]
[1503.970443, "o", "ref = F.linear(x,w,b); ref=ref*0.5+ref\r\n\u001b[?2004l\r"]
[1503.970467, "o", "\u001b[?2004h> "]
[1503.97049, "o", "wt=w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.970515, "o", "> "]
[1503.970551, "o", "wh=wt.half(); wl=((wt-wh.float())*2048).half()\r\n\u001b[?2004l\r"]
[1503.970576, "o", "\u001b[?2004h> "]
[1503.970601, "o", "bias=(b*alpha).contiguous()\r\n\u001b[?2004l\r"]
[1503.970626, "o", "\u001b[?2004h> "]
[1503.970671, "o", "xh=x.half(); xl=((x-xh.float())*2048).half()\r\n\u001b[?2004l\r"]
[1503.970682, "o", "\u001b[?2004h> "]
[1503.970771, "o", "# concat along K: x2 = [xh | xl] shape (M, 2K); w2 = [wl ; wh] shape (2K, N)\r\n\u001b[?2004l\r"]
[1503.970805, "o", "\u001b[?2004h> "]
[1503.970837, "o", "x2 = torch.cat([xh, xl], dim=1).contiguous()\r\n\u001b[?2004l\r"]
[1503.97086, "o", "\u001b[?2004h> "]
[1503.970901, "o", "w2 = torch.cat([wl, wh], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[1503.970926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.970951, "o", "> "]
[1503.971045, "o", "cfgs = [(128,128,64,8,2,8),(128,128,64,8,3,8),(128,128,32,8,3,8),(128,128,32,8,4,8),(128,64,64,8,3,8)]\r\n\u001b[?2004l\r"]
[1503.97107, "o", "\u001b[?2004h> "]
[1503.971094, "o", "for cfg in cfgs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.971128, "o", "    BM,BN,BK,wp,st,gr = cfg\r\n\u001b[?2004l\r"]
[1503.971153, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1503.971175, "o", "\u001b[?2004h> "]
[1503.971237, "o", "        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1503.97126, "o", "\u001b[?2004h> "]
[1503.971315, "o", "        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\r\n\u001b[?2004l\r"]
[1503.971339, "o", "\u001b[?2004h> "]
[1503.971396, "o", "        x2d = TensorDescriptor.from_tensor(x2, [BM, 2*BK])\r\n\u001b[?2004l\r"]
[1503.97142, "o", "\u001b[?2004h> "]
[1503.971472, "o", "        whd = TensorDescriptor.from_tensor(wh, [BK, BN])\r\n\u001b[?2004l\r"]
[1503.971495, "o", "\u001b[?2004h> "]
[1503.971552, "o", "        w2d = TensorDescriptor.from_tensor(w2, [2*BK, BN])\r\n\u001b[?2004l\r"]
[1503.971575, "o", "\u001b[?2004h> "]
[1503.971624, "o", "        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1503.971654, "o", "\u001b[?2004h> "]
[1503.971779, "o", "        fn=lambda: split_concat[grid](xhd,x2d,whd,w2d,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[1503.97179, "o", "\u001b[?2004h> "]
[1503.971816, "o", "        t=timeit(fn)\r\n\u001b[?2004l\r"]
[1503.971839, "o", "\u001b[?2004h> "]
[1503.971883, "o", "        fn(); err=(o-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1503.971907, "o", "\u001b[?2004h> "]
[1503.972001, "o", "        print('cat BM%d BN%d BK%d w%d s%d g%d: %.3f ms err %.2e' % (BM,BN,BK,wp,st,gr,t,err))\r\n\u001b[?2004l\r"]
[1503.972024, "o", "\u001b[?2004h> "]
[1503.972049, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1503.972072, "o", "\u001b[?2004h> "]
[1503.972165, "o", "        print('cat BM%d BN%d BK%d w%d s%d g%d: FAIL %s' % (BM,BN,BK,wp,st,gr,str(ex)[:70]))\r\n\u001b[?2004l\r"]
[1503.972188, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[1503.973707, "o", "\u001b[?2004hroot@modal:/# "]
[1503.973758, "o", "gpu run -- python3 /workspace/bench10.py\r\n\u001b[?2004l\r"]
