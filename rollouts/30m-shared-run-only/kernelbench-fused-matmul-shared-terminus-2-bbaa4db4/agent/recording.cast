[1215.056051, "o", "    BN = 128\r\n\u001b[?2004l\r"]
[1215.05609, "o", "\u001b[?2004h>     BK = 64\r\n\u001b[?2004l\r"]
[1215.056122, "o", "\u001b[?2004h>     GROUP = 8\r\n\u001b[?2004l\r"]
