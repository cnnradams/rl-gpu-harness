[1039.937293, "o", "\u001b[?2004h> "]
[1039.937349, "o", "        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\r\n\u001b[?2004l\r"]
[1039.937376, "o", "\u001b[?2004h> "]
