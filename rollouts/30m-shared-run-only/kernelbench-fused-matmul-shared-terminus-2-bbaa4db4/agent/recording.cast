[1567.425651, "o", "\u001b[32m\u001b[K70\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[KGROUP = \u001b[m\u001b[K8\r\n"]
