[1039.936959, "o", "> "]
[1039.937165, "o", "for (BM,BN,BK,wp,st,gr,ws) in [(128,128,64,8,3,8,True),(128,128,64,8,3,8,False),(128,256,64,8,3,8,True),(128,128,64,4,3,8,True),(128,256,64,8,2,8,True),(128,128,32,8,3,8,True)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.937192, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
