[1503.96752, "o", "from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.967545, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1503.96761, "o", "def split_concat(XHd, X2d, WHd, W2d, BIAS, OUT, M, N, K,\r\n\u001b[?2004l\r"]
[1503.967623, "o", "\u001b[?2004h> "]
[1503.967701, "o", "               alpha: tl.constexpr, inv_s: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1503.967728, "o", "> "]
[1503.967813, "o", "               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1503.967824, "o", "\u001b[?2004h> "]
[1503.967857, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1503.96788, "o", "\u001b[?2004h> "]
