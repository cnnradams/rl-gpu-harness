[1039.935141, "o", "> "]
[1039.93518, "o", "            accc = tl.dot(xl, wh, accc)\r\n\u001b[?2004l\r"]
[1039.935204, "o", "\u001b[?2004h> "]
[1039.935253, "o", "        bias = tl.load(BIAS + on + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[1039.935282, "o", "\u001b[?2004h> "]
