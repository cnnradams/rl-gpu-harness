[1290.081038, "o", "    bias = tl.load(BIAS + rn, mask=rn < N, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1290.081062, "o", "> "]
[1290.081116, "o", "    out = (acc + accc * inv_s) * alpha + bias[None, :]\r\n\u001b[?2004l\r"]
[1290.081145, "o", "\u001b[?2004h> "]
[1290.08117, "o", "    rm = om + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1290.081198, "o", "\u001b[?2004h> "]
[1290.081252, "o", "    tl.store(OUT + rm[:, None] * N + rn[None, :], out,\r\n\u001b[?2004l\r"]
[1290.081276, "o", "\u001b[?2004h> "]
[1290.081335, "o", "             mask=(rm < M)[:, None] & (rn < N)[None, :])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1290.081362, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.08139, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.081427, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1290.081461, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[1290.081489, "o", "\u001b[?2004h> "]
[1290.081545, "o", "    Reference: y = Linear(x); return y*s + y == (1+s) * Linear(x).\r\n\u001b[?2004l\r"]
[1290.081574, "o", "\u001b[?2004h> "]
[1290.08164, "o", "    Fused into a single tensor-core GEMM using an fp16 hi/lo split:\r\n\u001b[?2004l\r"]
[1290.081665, "o", "\u001b[?2004h> "]
[1290.081733, "o", "      x ~ xh + xl/2^11, W^T ~ wh + wl/2^11 (fp16, fp32 accumulate)\r\n\u001b[?2004l\r"]
[1290.081761, "o", "\u001b[?2004h> "]
[1290.081828, "o", "      x@W^T ~ xh@wh + (xh@wl + xl@wh)/2^11   (error ~2e-5, tol 1e-4)\r\n\u001b[?2004l\r"]
[1290.081854, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[1290.081883, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1290.081912, "o", ">     BM = 128\r\n\u001b[?2004l\r"]
[1290.08194, "o", "\u001b[?2004h> "]
[1290.081971, "o", "    BN = 128\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.081997, "o", "    BK = 64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.082022, "o", "    GROUP = 8\r\n\u001b[?2004l\r"]
[1290.08205, "o", "\u001b[?2004h> "]
[1290.082074, "o", "    WARPS = 8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.082099, "o", "    STAGES = 3\r\n\u001b[?2004l\r"]
[1290.082123, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1290.082151, "o", "\u001b[?2004h> "]
[1290.082222, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1290.082245, "o", "\u001b[?2004h> "]
[1290.082286, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[1290.082311, "o", "\u001b[?2004h> "]
[1290.082371, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1290.082396, "o", "\u001b[?2004h> "]
[1290.082439, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1290.082463, "o", "\u001b[?2004h> "]
[1290.082508, "o", "        alpha = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r"]
[1290.082534, "o", "\u001b[?2004h> "]
[1290.082564, "o", "        self._alpha = alpha\r\n\u001b[?2004l\r"]
[1290.08259, "o", "\u001b[?2004h> "]
[1290.082619, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.082697, "o", "            wt = self.matmul.weight.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[1290.082722, "o", "\u001b[?2004h> "]
[1290.082745, "o", "            wh = wt.half()\r\n\u001b[?2004l\r"]
[1290.082773, "o", "\u001b[?2004h> "]
[1290.082831, "o", "            wl = ((wt - wh.float()) * _SPLIT_SCALE).half()\r\n\u001b[?2004l\r"]
[1290.082855, "o", "\u001b[?2004h> "]
[1290.082924, "o", "            bias = (self.matmul.bias.detach() * alpha).contiguous()\r\n\u001b[?2004l\r"]
[1290.08295, "o", "\u001b[?2004h> "]
[1290.083034, "o", "        # int16 views: nn.Module.to(dtype=float32) won't upcast int buffers\r\n\u001b[?2004l\r"]
[1290.083059, "o", "\u001b[?2004h> "]
[1290.083138, "o", "        self.register_buffer(\"wh_i16\", wh.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r"]
[1290.083163, "o", "\u001b[?2004h> "]
[1290.083242, "o", "        self.register_buffer(\"wl_i16\", wl.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r"]
[1290.083269, "o", "\u001b[?2004h> "]
[1290.08333, "o", "        self.register_buffer(\"bias_f\", bias, persistent=False)\r\n\u001b[?2004l\r"]
[1290.083354, "o", "\u001b[?2004h> "]
[1290.083379, "o", "        self._cache = None\r\n\u001b[?2004l\r"]
[1290.083407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1290.083435, "o", "\u001b[?2004h> "]
[1290.083463, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.083524, "o", "        if x.is_cuda and x.dtype == torch.float32:\r\n\u001b[?2004l\r"]
[1290.083548, "o", "\u001b[?2004h> "]
[1290.083588, "o", "            return self._forward_cuda(x)\r\n\u001b[?2004l\r"]
[1290.083612, "o", "\u001b[?2004h> "]
[1290.083672, "o", "        y = F.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r"]
[1290.083696, "o", "\u001b[?2004h> "]
[1290.083738, "o", "        return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[1290.083767, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.083812, "o", "    def _forward_cuda(self, x):\r\n\u001b[?2004l\r"]
[1290.083836, "o", "\u001b[?2004h> "]
[1290.083904, "o", "        from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r"]
[1290.083932, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.083973, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[1290.084003, "o", "\u001b[?2004h> "]
[1290.084027, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[1290.084055, "o", "\u001b[?2004h> "]
[1290.084078, "o", "        N = self.bias_f.shape[0]\r\n\u001b[?2004l\r"]
[1290.084102, "o", "\u001b[?2004h> "]
[1290.084125, "o", "        dev = x.device\r\n\u001b[?2004l\r"]
[1290.084149, "o", "\u001b[?2004h> "]
[1290.084199, "o", "        BM, BN, BK = self.BM, self.BN, self.BK\r\n\u001b[?2004l\r"]
[1290.084225, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1290.084253, "o", "\u001b[?2004h> "]
[1290.084283, "o", "        cache = self._cache\r\n\u001b[?2004l\r"]
[1290.084307, "o", "\u001b[?2004h> "]
[1290.084361, "o", "        if cache is None or cache[0] != (M, K, N, dev):\r\n\u001b[?2004l\r"]
[1290.084386, "o", "\u001b[?2004h> "]
[1290.084456, "o", "            xh = torch.empty((M, K), device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1290.084481, "o", "\u001b[?2004h> "]
[1290.084552, "o", "            xl = torch.empty((M, K), device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1290.084576, "o", "\u001b[?2004h> "]
[1290.084648, "o", "            out = torch.empty((M, N), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1290.084673, "o", "\u001b[?2004h> "]
[1290.084721, "o", "            wh = self.wh_i16.view(torch.float16)\r\n\u001b[?2004l\r"]
[1290.084744, "o", "\u001b[?2004h> "]
[1290.084793, "o", "            wl = self.wl_i16.view(torch.float16)\r\n\u001b[?2004l\r"]
[1290.084821, "o", "\u001b[?2004h> "]
[1290.08485, "o", "            descs = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.084923, "o", "                TensorDescriptor.from_tensor(xh, [BM, BK]),\r\n\u001b[?2004l\r"]
[1290.084947, "o", "\u001b[?2004h> "]
[1290.085014, "o", "                TensorDescriptor.from_tensor(xl, [BM, BK]),\r\n\u001b[?2004l\r"]
[1290.085036, "o", "\u001b[?2004h> "]
[1290.085106, "o", "                TensorDescriptor.from_tensor(wh, [BK, BN]),\r\n\u001b[?2004l\r"]
[1290.085134, "o", "\u001b[?2004h> "]
[1290.085193, "o", "                TensorDescriptor.from_tensor(wl, [BK, BN]),\r\n\u001b[?2004l\r"]
[1290.085217, "o", "\u001b[?2004h> "]
[1290.085246, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.085316, "o", "            grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1290.085341, "o", "\u001b[?2004h> "]
[1290.085367, "o", "            n = M * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.085424, "o", "            sgrid = (triton.cdiv(n, 8192),)\r\n\u001b[?2004l\r"]
[1290.085452, "o", "\u001b[?2004h> "]
[1290.085544, "o", "            self._cache = cache = ((M, K, N, dev), xh, xl, out, wh, wl, descs, grid, sgrid, n)\r\n\u001b[?2004l\r"]
[1290.085573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1290.085597, "o", "\u001b[?2004h> "]
[1290.085659, "o", "        _, xh, xl, out, wh, wl, descs, grid, sgrid, n = cache\r\n\u001b[?2004l\r"]
[1290.085683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1290.085708, "o", "\u001b[?2004h> "]
[1290.085789, "o", "        _xsplit_kernel[sgrid](x, xh, xl, n, _SPLIT_SCALE, 8192, num_warps=8)\r\n\u001b[?2004l\r"]
[1290.085814, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.085857, "o", "        _split_gemm[grid](\r\n\u001b[?2004l\r"]
[1290.085881, "o", "\u001b[?2004h> "]
[1290.085966, "o", "            descs[0], descs[1], descs[2], descs[3], self.bias_f, out, M, N, K,\r\n\u001b[?2004l\r"]
[1290.085992, "o", "\u001b[?2004h> "]
[1290.086042, "o", "            self._alpha, 1.0 / _SPLIT_SCALE,\r\n\u001b[?2004l\r"]
[1290.086066, "o", "\u001b[?2004h> "]
[1290.086101, "o", "            BM, BN, BK, self.GROUP,\r\n\u001b[?2004l\r"]
[1290.086126, "o", "\u001b[?2004h> "]
[1290.086185, "o", "            num_warps=self.WARPS, num_stages=self.STAGES,\r\n\u001b[?2004l\r"]
[1290.086215, "o", "\u001b[?2004h> "]
[1290.086243, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.086267, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1290.086291, "o", "PYEOF\r\n\u001b[?2004l\r"]
[1290.087762, "o", "\u001b[?2004hroot@modal:/# "]
[1290.087834, "o", "gpu run -- python3 /opt/task/evaluate.py /workspace/solution.py\r\n\u001b[?2004l\r"]
