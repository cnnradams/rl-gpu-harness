[1051.518127, "o", "SMs 132\r\nws=True BM128 BN128 BK64 w8 s3 g8: FAIL out of resource: shared memory, Required: 262168, Hardware limit: 232448. Reducing block s\r\nws=False BM128 BN128 BK64 w8 s3 g8: FAIL out of resource: shared memory, Required: 262168, Hardware limit: 232448. Reducing block s\r\nws=True BM128 BN256 BK64 w8 s3 g8: FAIL out of resource: shared memory, Required: 427032, Hardware limit: 232448. Reducing block s\r\nws=True BM128 BN128 BK64 w4 s3 g8: FAIL out of resource: shared memory, Required: 262680, Hardware limit: 232448. Reducing block s\r\nws=True BM128 BN256 BK64 w8 s2 g8: FAIL out of resource: shared memory, Required: 328720, Hardware limit: 232448. Reducing block s\r\nws=True BM128 BN128 BK32 w8 s3 g8: 3.232 ms err 2.17e-05\r\n"]
[1053.772909, "o", "\u001b[?2004hroot@modal:/# "]
[1131.415479, "i", "cat > /workspace/bench8.py << 'PYEOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\n@triton.jit\ndef split_pers(XHd, XLd, WHd, WLd, BIAS, OUT, M, N, K,\n             alpha: tl.constexpr, inv_s: tl.constexpr,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n             GROUP: tl.constexpr, NUM_SMS: tl.constexpr, WS: tl.constexpr):\n    start_pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    k_tiles = tl.cdiv(K, BK)\n    num_tiles = num_pid_m * num_pid_n\n    num_pid_in_group = GROUP * num_pid_n\n    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GROUP\n        group_size_m = min(num_pid_m - first_pid_m, GROUP)\n        pid_m = first_pid_m + ((tile_id % num_pid_in_group) % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        "]
[1131.415529, "i", "om = pid_m * BM\n        on = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        accc = tl.zeros((BM, BN), dtype=tl.float32)\n        for ki in range(k_tiles):\n            ok = ki * BK\n            xh = XHd.load([om, ok])\n            xl = XLd.load([om, ok])\n            wh = WHd.load([ok, on])\n            wl = WLd.load([ok, on])\n            acc = tl.dot(xh, wh, acc)\n            accc = tl.dot(xh, wl, accc)\n            accc = tl.dot(xl, wh, accc)\n        bias = tl.load(BIAS + on + tl.arange(0, BN))\n        out = (acc + accc*inv_s)*alpha + bias[None, :]\n        rm = om + tl.arange(0, BM)\n        rn = on + tl.arange(0, BN)\n        tl.store(OUT + rm[:, None]*N + rn[None, :], out)\n\ndef timeit(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize("]
[1131.415538, "i", "); s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nM,K,N = 16384,4096,4096\ntorch.manual_seed(0)\nx = torch.rand(M,K,device='cuda')\nbound=1/64\nw=(torch.rand(N,K,device='cuda')*2-1)*bound\nb=(torch.rand(N,device='cuda')*2-1)*bound\nalpha=1.5\nref = F.linear(x,w,b); ref=ref*0.5+ref\nwt=w.t().contiguous()\nwh=wt.half(); wl=((wt-wh.float())*2048).half()\nbias=(b*alpha).contiguous()\nxh=x.half(); xl=((x-xh.float())*2048).half()\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\n\ncfgs = [(128,128,64,8,3,8,True),(128,128,64,8,3,8,False),(128,128,64,8,3,16,True),(128,256,64,8,2,8,True),(128,256,32,8,3,8,True)]\nfor cfg in cfgs:\n    BM,BN,BK,wp,st,gr,ws = cfg\n    try:\n        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\n        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\n        xld = TensorDescriptor.from_tensor(xl, [BM, BK])\n        whd = TensorDescriptor.from_tensor(wh, [BK, BN])\n        wld = TensorDescriptor.from"]
[1131.415628, "i", "_tensor(wl, [BK, BN])\n        grid=(min(NUM_SMS, triton.cdiv(M,BM)*triton.cdiv(N,BN)),)\n        fn=lambda: split_pers[grid](xhd,xld,whd,wld,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,NUM_SMS,ws,num_warps=wp,num_stages=st)\n        t=timeit(fn)\n        fn(); err=(o-ref).abs().max().item()\n        print('pers ws=%s BM%d BN%d BK%d w%d s%d g%d: %.3f ms err %.2e' % (ws,BM,BN,BK,wp,st,gr,t,err))\n    except Exception as ex:\n        print('pers ws=%s BM%d BN%d BK%d: FAIL %s' % (ws,BM,BN,BK,str(ex)[:90]))\nPYEOF\ngpu run -- python3 /workspace/bench8.py\n"]
