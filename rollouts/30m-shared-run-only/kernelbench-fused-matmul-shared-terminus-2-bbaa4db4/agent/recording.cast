[738.440229, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\n\n# grouped swizzle split gemm\n@triton.jit\ndef split_gemm(XH, XL, WH, WL, BIAS, OUT, M, N, K,\n               alpha: tl.constexpr, inv_s: tl.constexpr,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m*BM + tl.arange(0, BM)\n    rn = pid_n*BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    XHp = XH + rm[:, None]*K + rk[None, :]\n    XLp = XL + rm[:, None]*K + rk[None, :]\n    WHp = WH + rk[:, None]*N + rn[None, :]\n    WLp = WL + rk[:, None]*N + rn[None, :]\n    acc = tl.zeros((BM"]
[738.44029, "i", ", BN), dtype=tl.float32)\n    accc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        xh = tl.load(XHp); xl = tl.load(XLp)\n        wh = tl.load(WHp); wl = tl.load(WLp)\n        acc = tl.dot(xh, wh, acc)\n        accc = tl.dot(xh, wl, accc)\n        accc = tl.dot(xl, wh, accc)\n        XHp += BK; XLp += BK; WHp += BK*N; WLp += BK*N\n    bias = tl.load(BIAS + rn)\n    out = (acc + accc*inv_s)*alpha + bias[None, :]\n    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\n\n# in-kernel x split, fp32 x load\n@triton.jit\ndef split_gemm_inline(X, WH, WL, BIAS, OUT, M, N, K,\n               alpha: tl.constexpr, inv_s: tl.constexpr,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid %"]
[738.440389, "i", " num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    rm = pid_m*BM + tl.arange(0, BM)\n    rn = pid_n*BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Xp = X + rm[:, None]*K + rk[None, :]\n    WHp = WH + rk[:, None]*N + rn[None, :]\n    WLp = WL + rk[:, None]*N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    accc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Xp)\n        a_hi = a.to(tl.float16)\n        a_lo = ((a - a_hi.to(tl.float32)) * 2048.0).to(tl.float16)\n        wh = tl.load(WHp); wl = tl.load(WLp)\n        acc = tl.dot(a_hi, wh, acc)\n        accc = tl.dot(a_hi, wl, accc)\n        accc = tl.dot(a_lo, wh, accc)\n        Xp += BK; WHp += BK*N; WLp += BK*N\n    bias = tl.load(BIAS + rn)\n    out = (acc + accc*inv_s)*alpha + bias[None, :]\n    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\n\n# x split elementwise kernel\n@triton.jit\ndef xsplit_kernel(X, XH, XL, n, s: tl.constexpr, BLK: tl.constexpr):\n    pid = tl.pro"]
[738.440451, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r"]
[738.440493, "i", "gram_id(0)\n    offs = pid*BLK + tl.arange(0, BLK)\n    mask = offs < n\n    a = tl.load(X + offs, mask=mask)\n    ah = a.to(tl.float16)\n    al = ((a - ah.to(tl.float32)) * s).to(tl.float16)\n    tl.store(XH + offs, ah, mask=mask)\n    tl.store(XL + offs, al, mask=mask)\n\ndef timeit(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nM,K,N = 16384,4096,4096\ntorch.manual_seed(0)\nx = torch.rand(M,K,device='cuda')\nbound=1/64\nw=(torch.rand(N,K,device='cuda')*2-1)*bound\nb=(torch.rand(N,device='cuda')*2-1)*bound\nalpha=1.5\nref = F.linear(x,w,b); ref=ref*0.5+ref\n\nwt=w.t().contiguous()\nwh=wt.half(); wl=((wt-wh.float())*2048).half()\nbias=("]
[738.440503, "o", "\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.440535, "i", "b*alpha).contiguous()\nxh=torch.empty(M,K,device='cuda',dtype=torch.float16)\nxl=torch.empty(M,K,device='cuda',dtype=torch.float16)\n\ndef do_split():\n    n = M*K\n    xsplit_kernel[(triton.cdiv(n, 8192),)](x, xh, xl, n, 2048.0, 8192, num_warps=8)\n\nt = timeit(do_split)\nprint(f\"xsplit: {t:.3f} ms\")\n\n# torch mm fp16 in fp32 out?\ntry:\n    of32 = torch.empty(M,N,device='cuda',dtype=torch.float32)\n    torch.mm(xh, wh, out=of32)\n    print(\"torch.mm fp16->fp32 WORKS\")\nexcept Exception as ex:\n    print(f\"torch.mm fp16->fp32: NO ({str(ex)[:60]})\")\n\nfor (BM,BN,BK,wp,st,gr) in [(128,256,64,8,2,8),(128,256,64,8,2,4),(128,128,64,8,3,8),(128,256,32,8,3,8),(128,128,32,8,4,8)]:\n    try:\n        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\n        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        fn=lambda: split_gemm[grid](xh,xl,wh,wl,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\n        t=timeit(fn)\n        fn(); err=(o-ref).abs().max().item()\n        print(f\"swz BM{BM} BN{BN} BK{BK} w{wp} s{st} g{g"]
[738.440555, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\rb*"]
[738.440579, "i", "r}: {t:.3f} ms err {err:.2e}\")\n    except Exception as ex:\n        print(f\"swz BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: FAIL {str(ex)[:60]}\")\n\nfor (BM,BN,BK,wp,st,gr) in [(128,256,64,8,2,8),(128,128,64,8,3,8)]:\n    try:\n        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\n        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        fn=lambda: split_gemm_inline[grid](x,wh,wl,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\n        t=timeit(fn)\n        fn(); err=(o-ref).abs().max().item()\n        print(f\"inl BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: {t:.3f} ms err {err:.2e}\")\n    except Exception as ex:\n        print(f\"inl BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: FAIL {str(ex)[:60]}\")\nEOF\ngpu run -- python3 /workspace/bench5.py\n"]
