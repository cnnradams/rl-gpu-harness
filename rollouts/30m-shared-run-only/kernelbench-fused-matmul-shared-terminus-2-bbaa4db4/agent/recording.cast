[1503.967081, "i", "cat > /workspace/bench10.py << 'PYEOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\n@triton.jit\ndef split_concat(XHd, X2d, WHd, W2d, BIAS, OUT, M, N, K,\n               alpha: tl.constexpr, inv_s: tl.constexpr,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    om = pid_m * BM; on = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    accc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        xh = XHd.load([om, k])\n        x2 = X2d.load([om, 2*k])\n        wh = WHd.load([k, on"]
[1503.967128, "i", "])\n        w2 = W2d.load([2*k, on])\n        acc = tl.dot(xh, wh, acc)\n        accc = tl.dot(x2, w2, accc)\n    bias = tl.load(BIAS + on + tl.arange(0, BN))\n    out = (acc + accc*inv_s)*alpha + bias[None, :]\n    rm = om + tl.arange(0, BM); rn = on + tl.arange(0, BN)\n    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\n\ndef timeit(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nM,K,N = 16384,4096,4096\ntorch.manual_seed(0)\nx = torch.rand(M,K,device='cuda')\nbound=1/64\nw=(torch.rand(N,K,device='cuda')*2-1)*bound\nb=(torch.rand(N,device='cuda')*2-1)*bound\nalpha=1.5\nref = F.linear(x,w,b); ref=ref*0.5+ref\nwt=w.t().contiguous()\nw"]
[1503.967144, "i", "h=wt.half(); wl=((wt-wh.float())*2048).half()\nbias=(b*alpha).contiguous()\nxh=x.half(); xl=((x-xh.float())*2048).half()\n# concat along K: x2 = [xh | xl] shape (M, 2K); w2 = [wl ; wh] shape (2K, N)\nx2 = torch.cat([xh, xl], dim=1).contiguous()\nw2 = torch.cat([wl, wh], dim=0).contiguous()\n\ncfgs = [(128,128,64,8,2,8),(128,128,64,8,3,8),(128,128,32,8,3,8),(128,128,32,8,4,8),(128,64,64,8,3,8)]\nfor cfg in cfgs:\n    BM,BN,BK,wp,st,gr = cfg\n    try:\n        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\n        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\n        x2d = TensorDescriptor.from_tensor(x2, [BM, 2*BK])\n        whd = TensorDescriptor.from_tensor(wh, [BK, BN])\n        w2d = TensorDescriptor.from_tensor(w2, [2*BK, BN])\n        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        fn=lambda: split_concat[grid](xhd,x2d,whd,w2d,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\n        t=timeit(fn)\n        fn(); err=(o-ref).abs().max().item()\n        print('cat BM%d BN%d BK%d w%d s%d g%d: %."]
[1503.967376, "i", "3f ms err %.2e' % (BM,BN,BK,wp,st,gr,t,err))\n    except Exception as ex:\n        print('cat BM%d BN%d BK%d w%d s%d g%d: FAIL %s' % (BM,BN,BK,wp,st,gr,str(ex)[:70]))\nPYEOF\ngpu run -- python3 /workspace/bench10.py\n"]
[1503.967401, "o", "cat > /workspace/bench10.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
