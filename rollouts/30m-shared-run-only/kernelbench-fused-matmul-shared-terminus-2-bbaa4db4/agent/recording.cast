[553.455303, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.455344, "o", "    ts.sort(); return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[553.455378, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.455415, "o", "M,K,N = 16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.455452, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.455497, "o", "x = torch.rand(M,K,device='cuda')\r\n\u001b[?2004l\r"]
[553.45553, "o", "\u001b[?2004h> bound=1/64\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.455567, "o", "> "]
[553.455598, "o", "w=(torch.rand(N,K,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.45563, "o", "> "]
[553.455662, "o", "b=(torch.rand(N,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.455693, "o", "> alpha=1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.45574, "o", "ref = F.linear(x,w,b); ref=ref*0.5+ref\r\n\u001b[?2004l\r"]
[553.455779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.455816, "o", "wt=w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.455863, "o", "xh=x.half(); xl=((x-xh.float())*2048).half()\r\n\u001b[?2004l\r"]
[553.4559, "o", "\u001b[?2004h> "]
[553.455937, "o", "wh=wt.half(); wl=((wt-wh.float())*2048).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.45597, "o", "> bias=b*alpha\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.456001, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.456032, "o", "# roofline fp16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.456118, "o", "for (BM,BN,BK,wp,st) in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3)]:\r\n\u001b[?2004l\r"]
[553.456154, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[553.456186, "o", "> "]
[553.456232, "o", "        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r"]
[553.456268, "o", "\u001b[?2004h> "]
[553.45635, "o", "        fn=lambda: fp16_gemm[(M//BM,N//BN)](xh,wh,o,M,N,K,BM,BN,BK,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[553.456382, "o", "\u001b[?2004h> "]
[553.456413, "o", "        t=timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.456483, "o", "        print(f\"fp16roof BM{BM} BN{BN} BK{BK} w{wp} s{st}: {t:.3f} ms\")\r\n\u001b[?2004l\r"]
[553.456522, "o", "\u001b[?2004h> "]
[553.456553, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.456619, "o", "        print(f\"fp16roof BM{BM} BN{BN} BK{BK}: FAIL {str(ex)[:80]}\")\r\n\u001b[?2004l\r"]
[553.45665, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.456832, "o", "for (BM,BN,BK,wp,st) in [(128,128,64,8,3),(128,128,32,4,4),(128,64,64,4,4),(64,128,64,4,4),(128,128,64,4,3),(64,64,64,4,4),(128,256,64,8,3),(256,128,64,8,3)]: \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K:\r\n\u001b[?2004l\r"]
[553.456847, "o", "\u001b[?2004h"]
[553.456882, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.456946, "o", "        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r"]
[553.456978, "o", "\u001b[?2004h> "]
[553.457095, "o", "        fn=lambda: split_gemm[(M//BM,N//BN)](xh,xl,wh,wl,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[553.457139, "o", "\u001b[?2004h>         t=timeit(fn)\r\n\u001b[?2004l\r"]
[553.457177, "o", "\u001b[?2004h> "]
[553.457248, "o", "        split_t = timeit(lambda: (x.half(), ((x-x.half().float())*2048).half()))\r\n\u001b[?2004l\r"]
[553.457287, "o", "\u001b[?2004h> "]
[553.45733, "o", "        err=(fn()-ref).abs().max().item() if False else None\r\n\u001b[?2004l\r"]
[553.457361, "o", "\u001b[?2004h> "]
[553.457413, "o", "        o2=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r"]
[553.457444, "o", "\u001b[?2004h> "]
[553.457545, "o", "        split_gemm[(M//BM,N//BN)](xh,xl,wh,wl,bias,o2,M,N,K,alpha,1/2048,BM,BN,BK,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[553.457585, "o", "\u001b[?2004h> "]
[553.457615, "o", "        err=(o2-ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.457736, "o", "        print(f\"split BM{BM} BN{BN} BK{BK} w{wp} s{st}: {t:.3f} ms err {err:.2e} (xsplit {split_t:.3f} ms)\")\r\n\u001b[?2004l\r"]
[553.457775, "o", "\u001b[?2004h> "]
[553.457812, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[553.457872, "o", "        print(f\"split BM{BM} BN{BN} BK{BK}: FAIL {str(ex)[:80]}\")\r\n\u001b[?2004l\r"]
[553.457904, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[553.459403, "o", "\u001b[?2004hroot@modal:/# "]
[553.459454, "o", "gpu run -- python3 /workspace/bench3.py\r\n\u001b[?2004l\r"]
