[553.453623, "o", "\u001b[?2004h> "]
[553.453654, "o", "    XHp = XH + rm[:, None]*K + rk[None, :]\r\n\u001b[?2004l\r"]
[553.453685, "o", "\u001b[?2004h> "]
[553.453716, "o", "    XLp = XL + rm[:, None]*K + rk[None, :]\r\n\u001b[?2004l\r"]
[553.453753, "o", "\u001b[?2004h> "]
[553.453791, "o", "    WHp = WH + rk[:, None]*N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
