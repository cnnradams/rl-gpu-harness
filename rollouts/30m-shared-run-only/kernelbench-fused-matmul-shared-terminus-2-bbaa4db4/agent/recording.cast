[738.444762, "o", "    out = (acc + accc*inv_s)*alpha + bias[None, :]\r\n\u001b[?2004l\r"]
[738.444792, "o", "\u001b[?2004h> "]
[738.444901, "o", "    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.444931, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.444959, "o", "> "]
[738.445045, "o", "# in-kernel x split, fp32 x load\r\n\u001b[?2004l\r"]
[738.445072, "o", "\u001b[?2004h> "]
[738.445118, "o", "@triton.jit\r\n\u001b[?2004l\rn"]
[738.445142, "o", "\u001b[?2004h> "]
[738.445263, "o", "def split_gemm_inline(X, WH, WL, BIAS, OUT, M, N, K,\r\n\u001b[?2004l\r"]
[738.445287, "o", "\u001b[?2004h> "]
[738.445443, "o", "               alpha: tl.constexpr, inv_s: tl.constexpr,\r\n\u001b[?2004l\r"]
[738.445465, "o", "\u001b[?2004h> "]
[738.445699, "o", "               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.445779, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[738.445805, "o", "\u001b[?2004h> "]
[738.445863, "o", "    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[738.445889, "o", "\u001b[?2004h> "]
[738.445927, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[738.44595, "o", "\u001b[?2004h> "]
[738.445994, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[738.446016, "o", "\u001b[?2004h> "]
[738.446049, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[738.446069, "o", "\u001b[?2004h> "]
[738.446133, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446157, "o", "> "]
[738.446225, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[738.446253, "o", "\u001b[?2004h> "]
[738.446301, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[738.446322, "o", "\u001b[?2004h> "]
[738.446365, "o", "    rm = pid_m*BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[738.44639, "o", "\u001b[?2004h> "]
[738.446428, "o", "    rn = pid_n*BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446457, "o", "> "]
[738.446478, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446503, "o", "> "]
[738.446541, "o", "    Xp = X + rm[:, None]*K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446566, "o", "> "]
[738.446612, "o", "    WHp = WH + rk[:, None]*N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446634, "o", "> "]
[738.446682, "o", "    WLp = WL + rk[:, None]*N + rn[None, :]\r\n\u001b[?2004l\r"]
[738.446711, "o", "\u001b[?2004h> "]
[738.446753, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446777, "o", "> "]
[738.446823, "o", "    accc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.446846, "o", "> "]
[738.44687, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[738.446895, "o", "\u001b[?2004h> "]
[738.446918, "o", "        a = tl.load(Xp)\r\n"]
[738.446946, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[738.446981, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[738.447006, "o", "\u001b[?2004h> "]
[738.447073, "o", "        a_lo = ((a - a_hi.to(tl.float32)) * 2048.0).to(tl.float16)\r\n\u001b[?2004l\r"]
[738.447096, "o", "\u001b[?2004h> "]
[738.447145, "o", "        wh = tl.load(WHp); wl = tl.load(WLp)\r\n\u001b[?2004l\r"]
[738.447167, "o", "\u001b[?2004h> "]
[738.447205, "o", "        acc = tl.dot(a_hi, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.447266, "o", "        accc = tl.dot(a_hi, wl, accc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447287, "o", "> "]
[738.447327, "o", "        accc = tl.dot(a_lo, wh, accc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447348, "o", "> "]
[738.447393, "o", "        Xp += BK; WHp += BK*N; WLp += BK*N\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447414, "o", "> "]
[738.447444, "o", "    bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[738.447466, "o", "\u001b[?2004h> "]
[738.447525, "o", "    out = (acc + accc*inv_s)*alpha + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447553, "o", "> "]
[738.447599, "o", "    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\r\n\u001b[?2004l\r"]
[738.447635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.447682, "o", "# x split elementwise kernel\r\n\u001b[?2004l\r"]
[738.447708, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[738.447728, "o", "\u001b[?2004h> "]
[738.447811, "o", "def xsplit_kernel(X, XH, XL, n, s: tl.constexpr, BLK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447834, "o", "> "]
[738.447861, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447886, "o", "> "]
[738.447921, "o", "    offs = pid*BLK + tl.arange(0, BLK)\r\n\u001b[?2004l\r"]
[738.447949, "o", "\u001b[?2004h> "]
[738.44797, "o", "    mask = offs < n\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.447998, "o", "> "]
[738.44802, "o", "    a = tl.load(X + offs, mask=mask)\r\n\u001b[?2004l\r"]
[738.448046, "o", "\u001b[?2004h> "]
[738.44807, "o", "    ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[738.448098, "o", "\u001b[?2004h> "]
[738.448158, "o", "    al = ((a - ah.to(tl.float32)) * s).to(tl.float16)\r\n\u001b[?2004l\r"]
[738.448182, "o", "\u001b[?2004h> "]
[738.448219, "o", "    tl.store(XH + offs, ah, mask=mask)\r\n\u001b[?2004l\r"]
[738.44824, "o", "\u001b[?2004h> "]
[738.448283, "o", "    tl.store(XL + offs, al, mask=mask)\r\n\u001b[?2004l\r"]
[738.448308, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[738.448336, "o", "> "]
[738.448362, "o", "def timeit(fn, n=15):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.448396, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[738.448425, "o", "\u001b[?2004h> "]
[738.448453, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.448481, "o", "    ts=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.448506, "o", "> "]
[738.44853, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.448658, "o", "        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.448763, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.448785, "o", "> "]
[738.44888, "o", "        torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.448938, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[738.448966, "o", "\u001b[?2004h> "]
[738.448995, "o", "    ts.sort(); return ts[len(ts)//2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.449021, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449048, "o", "> "]
[738.449068, "o", "M,K,N = 16384,4096,4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449093, "o", "> "]
[738.449114, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[738.449139, "o", "\u001b[?2004h> "]
[738.449163, "o", "x = torch.rand(M,K,device='cuda')\r\n\u001b[?2004l\r"]
[738.449187, "o", "\u001b[?2004h> "]
[738.449208, "o", "bound=1/64\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449229, "o", "> "]
[738.449277, "o", "w=(torch.rand(N,K,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449299, "o", "> "]
[738.449343, "o", "b=(torch.rand(N,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r"]
[738.449366, "o", "\u001b[?2004h> alpha=1.5\r\n\u001b[?2004l\r"]
[738.44939, "o", "\u001b[?2004h> "]
[738.449437, "o", "ref = F.linear(x,w,b); ref=ref*0.5+ref\r\n\u001b[?2004l\r"]
[738.449463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449491, "o", "> "]
[738.449515, "o", "wt=w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.449571, "o", "wh=wt.half(); wl=((wt-wh.float())*2048).half()\r\n\u001b[?2004l\r"]
[738.449592, "o", "\u001b[?2004h> "]
[738.44963, "o", "bias=(b*alpha).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449651, "o", "> "]
[738.449707, "o", "xh=torch.empty(M,K,device='cuda',dtype=torch.float16)\r\n\u001b[?2004l\r"]
[738.449733, "o", "\u001b[?2004h> "]
[738.449786, "o", "xl=torch.empty(M,K,device='cuda',dtype=torch.float16)\r\n\u001b[?2004l\r"]
[738.449807, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[738.449831, "o", "\u001b[?2004h> "]
[738.449856, "o", "def do_split():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.449884, "o", "    n = M*K\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.449908, "o", "> "]
[738.449988, "o", "    xsplit_kernel[(triton.cdiv(n, 8192),)](x, xh, xl, n, 2048.0, 8192, num_warps=8)\r\n\u001b[?2004l\r"]
[738.450011, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[738.450032, "o", "> "]
[738.450054, "o", "t = timeit(do_split)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.450075, "o", "> "]
[738.450097, "o", "print(f\"xsplit: {t:.3f} ms\")\r\n\u001b[?2004l\r"]
[738.450117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[738.450138, "o", "\u001b[?2004h> "]
[738.450174, "o", "# torch mm fp16 in fp32 out?\r\n\u001b[?2004l\r"]
[738.450199, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.450226, "o", "> "]
[738.450282, "o", "    of32 = torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r"]
[738.450303, "o", "\u001b[?2004h> "]
[738.45033, "o", "    torch.mm(xh, wh, out=of32)\r\n"]
[738.450356, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[738.450399, "o", "    print(\"torch.mm fp16->fp32 WORKS\")\r\n\u001b[?2004l\r"]
[738.45043, "o", "\u001b[?2004h> "]
[738.450451, "o", "except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.450523, "o", "    print(f\"torch.mm fp16->fp32: NO ({str(ex)[:60]})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.450543, "o", "> \r\n\u001b[?2004l\r"]
[738.450566, "o", "\u001b[?2004h> "]
[738.450699, "o", "for (BM,BN,BK,wp,st,gr) in [(128,256,64,8,2,8),(128,256,64,8,2,4),(128,128,64,8,3,8),(128,256,32,8,3,8),(128,128,32,8,4,8)]:\r\n\u001b[?2004l\r"]
[738.450723, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[738.450744, "o", "\u001b[?2004h> "]
[738.450816, "o", "        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.450836, "o", "> "]
[738.450891, "o", "        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[738.450913, "o", "\u001b[?2004h> "]
[738.451031, "o", "        fn=lambda: split_gemm[grid](xh,xl,wh,wl,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[738.451056, "o", "\u001b[?2004h> "]
[738.451076, "o", "        t=timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.4511, "o", "> "]
[738.451143, "o", "        fn(); err=(o-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[738.451164, "o", "\u001b[?2004h> "]
[738.451259, "o", "        print(f\"swz BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: {t:.3f} ms err {err:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.451307, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[738.451328, "o", "\u001b[?2004h> "]
[738.451417, "o", "        print(f\"swz BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: FAIL {str(ex)[:60]}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.451442, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[738.451533, "o", "for (BM,BN,BK,wp,st,gr) in [(128,256,64,8,2,8),(128,128,64,8,3,8)]:\r\n\u001b[?2004l\r"]
[738.451556, "o", "\u001b[?2004h>     try:\r\n"]
[738.451581, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[738.451659, "o", "        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r"]
[738.451685, "o", "\u001b[?2004h> "]
[738.451736, "o", "        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[738.451758, "o", "\u001b[?2004h> "]
[738.45188, "o", "        fn=lambda: split_gemm_inline[grid](x,wh,wl,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r"]
[738.451901, "o", "\u001b[?2004h> "]
[738.451926, "o", "        t=timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.451946, "o", "> "]
[738.451993, "o", "        fn(); err=(o-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[738.452017, "o", "\u001b[?2004h> "]
[738.452105, "o", "        print(f\"inl BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: {t:.3f} ms err {err:.2e}\")\r\n\u001b[?2004l\r"]
[738.45213, "o", "\u001b[?2004h> "]
[738.452152, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[738.452173, "o", "> "]
[738.452265, "o", "        print(f\"inl BM{BM} BN{BN} BK{BK} w{wp} s{st} g{gr}: FAIL {str(ex)[:60]}\")\r\n\u001b[?2004l\r"]
[738.452291, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[738.453992, "o", "\u001b[?2004hroot@modal:/# "]
[738.454055, "o", "gpu run -- python3 /workspace/bench5.py\r\n\u001b[?2004l\r"]
