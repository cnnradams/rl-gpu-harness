[1360.751281, "i", "cat > /workspace/bench9.py << 'PYEOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\n@triton.jit\ndef split_gemm(XHd, XLd, WHd, WLd, BIAS, OUT, M, N, K,\n               alpha: tl.constexpr, inv_s: tl.constexpr,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP\n    group_size_m = min(num_pid_m - first_pid_m, GROUP)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    om = pid_m * BM; on = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    accc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        xh = XHd.load([om, k]); xl = XLd.load([om, k])\n        wh = WHd.load([k, on]); wl = WLd"]
[1360.75145, "i", ".load([k, on])\n        acc = tl.dot(xh, wh, acc)\n        accc = tl.dot(xh, wl, accc)\n        accc = tl.dot(xl, wh, accc)\n    bias = tl.load(BIAS + on + tl.arange(0, BN))\n    out = (acc + accc*inv_s)*alpha + bias[None, :]\n    rm = om + tl.arange(0, BM); rn = on + tl.arange(0, BN)\n    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\n\ndef timeit(fn, n=15):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nM,K,N = 16384,4096,4096\ntorch.manual_seed(0)\nx = torch.rand(M,K,device='cuda')\nbound=1/64\nw=(torch.rand(N,K,device='cuda')*2-1)*bound\nb=(torch.rand(N,device='cuda')*2-1)*bound\nalpha=1.5\nref = F.linear(x,w,b); ref=ref*0.5+ref\nwt=w.t()"]
[1360.751498, "o", "cat > /workspace/bench9.py << 'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.751544, "i", ".contiguous()\nwh=wt.half(); wl=((wt-wh.float())*2048).half()\nbias=(b*alpha).contiguous()\nxh=x.half(); xl=((x-xh.float())*2048).half()\n\ncfgs = [(128,128,64,8,3,4),(128,128,64,8,3,8),(128,128,64,8,3,16),(128,128,64,8,3,32),(64,128,64,4,3,8),(128,64,64,8,3,8),(64,64,64,4,4,8),(128,128,64,8,2,8),(96,128,64,8,3,8)]\nfor cfg in cfgs:\n    BM,BN,BK,wp,st,gr = cfg\n    try:\n        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\n        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\n        xld = TensorDescriptor.from_tensor(xl, [BM, BK])\n        whd = TensorDescriptor.from_tensor(wh, [BK, BN])\n        wld = TensorDescriptor.from_tensor(wl, [BK, BN])\n        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        fn=lambda: split_gemm[grid](xhd,xld,whd,wld,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\n        t=timeit(fn)\n        fn(); err=(o-ref).abs().max().item()\n        print('BM%d BN%d BK%d w%d s%d g%d: %.3f ms err %.2e' % (BM,BN,BK,wp,st,gr,t,err))\n    except Exception as ex:\n        print('"]
[1360.75157, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.751598, "i", "BM%d BN%d BK%d w%d s%d g%d: FAIL %s' % (BM,BN,BK,wp,st,gr,str(ex)[:70]))\nPYEOF\ngpu run -- python3 /workspace/bench9.py\n"]
[1360.751625, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.751721, "o", "from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.751771, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.751814, "o", "def split_gemm(XHd, XLd, WHd, WLd, BIAS, OUT, M, N, K,\r\n\u001b[?2004l\r"]
[1360.751837, "o", "\u001b[?2004h> "]
[1360.751901, "o", "               alpha: tl.constexpr, inv_s: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.752018, "o", "               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.75206, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.75209, "o", "> "]
[1360.75214, "o", "    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1360.752167, "o", "\u001b[?2004h> "]
[1360.752205, "o", "    num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1360.752227, "o", "\u001b[?2004h> "]
[1360.752265, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1360.752295, "o", "\u001b[?2004h> "]
[1360.752316, "o", "    first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[1360.752337, "o", "\u001b[?2004h> "]
[1360.752401, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[1360.752422, "o", "\u001b[?2004h> "]
[1360.752493, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1360.752522, "o", "\u001b[?2004h> "]
[1360.752577, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1360.752599, "o", "\u001b[?2004h> "]
[1360.752639, "o", "    om = pid_m * BM; on = pid_n * BN\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.752665, "o", "> "]
[1360.752709, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.752732, "o", "> "]
[1360.752779, "o", "    accc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1360.752805, "o", "\u001b[?2004h> "]
[1360.75283, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.752853, "o", "> "]
[1360.752906, "o", "        xh = XHd.load([om, k]); xl = XLd.load([om, k])\r\n\u001b[?2004l\r"]
[1360.752928, "o", "\u001b[?2004h> "]
[1360.752984, "o", "        wh = WHd.load([k, on]); wl = WLd.load([k, on])\r\n\u001b[?2004l\r"]
[1360.753021, "o", "\u001b[?2004h> "]
[1360.753053, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.753076, "o", "> "]
[1360.75311, "o", "        accc = tl.dot(xh, wl, accc)\r\n\u001b[?2004l\r"]
[1360.753131, "o", "\u001b[?2004h> "]
[1360.75317, "o", "        accc = tl.dot(xl, wh, accc)\r\n\u001b[?2004l\r"]
[1360.753193, "o", "\u001b[?2004h> "]
[1360.753241, "o", "    bias = tl.load(BIAS + on + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[1360.753267, "o", "\u001b[?2004h> "]
[1360.753316, "o", "    out = (acc + accc*inv_s)*alpha + bias[None, :]\r\n\u001b[?2004l\r"]
[1360.753341, "o", "\u001b[?2004h> "]
[1360.753398, "o", "    rm = om + tl.arange(0, BM); rn = on + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1360.753423, "o", "\u001b[?2004h> "]
[1360.753473, "o", "    tl.store(OUT + rm[:, None]*N + rn[None, :], out)\r\n\u001b[?2004l\r"]
[1360.7535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.753541, "o", "def timeit(fn, n=15):\r\n\u001b[?2004l\r"]
[1360.753562, "o", "\u001b[?2004h> "]
[1360.753592, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.753614, "o", "> "]
[1360.753643, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1360.753669, "o", "\u001b[?2004h>     ts=[]\r\n\u001b[?2004l\r"]
[1360.753691, "o", "\u001b[?2004h> "]
[1360.753716, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.753742, "o", "> "]
[1360.753834, "o", "        d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[1360.753856, "o", "\u001b[?2004h> "]
[1360.753944, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1360.75397, "o", "\u001b[?2004h> "]
[1360.754057, "o", "        torch.cuda.synchronize(); s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1360.754083, "o", "\u001b[?2004h> "]
[1360.754116, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1360.754139, "o", "\u001b[?2004h> "]
[1360.754175, "o", "    ts.sort(); return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1360.754201, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.754239, "o", "M,K,N = 16384,4096,4096\r\n\u001b[?2004l\r"]
[1360.754261, "o", "\u001b[?2004h> "]
[1360.754283, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.754306, "o", "> "]
[1360.754336, "o", "x = torch.rand(M,K,device='cuda')\r\n\u001b[?2004l\r"]
[1360.754361, "o", "\u001b[?2004h> bound=1/64\r\n\u001b[?2004l\r"]
[1360.754386, "o", "\u001b[?2004h> "]
[1360.754441, "o", "w=(torch.rand(N,K,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.754507, "o", "b=(torch.rand(N,device='cuda')*2-1)*bound\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.75455, "o", "alpha=1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.754603, "o", "ref = F.linear(x,w,b); ref=ref*0.5+ref\r\n\u001b[?2004l\r"]
[1360.75463, "o", "\u001b[?2004h> "]
[1360.754655, "o", "wt=w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.754713, "o", "wh=wt.half(); wl=((wt-wh.float())*2048).half()\r\n\u001b[?2004l\r"]
[1360.754739, "o", "\u001b[?2004h> "]
[1360.754763, "o", "bias=(b*alpha).contiguous()\r\n\u001b[?2004l\r"]
[1360.754789, "o", "\u001b[?2004h> "]
[1360.75483, "o", "xh=x.half(); xl=((x-xh.float())*2048).half()\r\n\u001b[?2004l\r"]
[1360.754855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.755063, "o", "cfgs = [(128,128,64,8,3,4),(128,128,64,8,3,8),(128,128,64,8,3,16),(128,128,64,8,3,32),(64,128,64,4,3,8),(128,64,64,8,3,8),(64,64,64,4,4,8),(128,128,64,8,2,8),(96,128,64,8,3,8)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.755094, "o", "for cfg in cfgs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.755116, "o", "> "]
[1360.755137, "o", "    BM,BN,BK,wp,st,gr = cfg\r\n\u001b[?2004l\r"]
[1360.755163, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1360.755189, "o", "\u001b[?2004h> "]
[1360.755259, "o", "        o=torch.empty(M,N,device='cuda',dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.755284, "o", "> "]
[1360.75534, "o", "        xhd = TensorDescriptor.from_tensor(xh, [BM, BK])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.755362, "o", "> "]
[1360.755419, "o", "        xld = TensorDescriptor.from_tensor(xl, [BM, BK])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.755442, "o", "> "]
[1360.755496, "o", "        whd = TensorDescriptor.from_tensor(wh, [BK, BN])\r\n\u001b[?2004l\r"]
[1360.755524, "o", "\u001b[?2004h> "]
[1360.755584, "o", "        wld = TensorDescriptor.from_tensor(wl, [BK, BN])\r\n\u001b[?2004l\r"]
[1360.755606, "o", "\u001b[?2004h> "]
[1360.755658, "o", "        grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1360.755684, "o", "\u001b[?2004h> "]
[1360.755805, "o", "        fn=lambda: split_gemm[grid](xhd,xld,whd,wld,bias,o,M,N,K,alpha,1/2048,BM,BN,BK,gr,num_warps=wp,num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1360.755832, "o", "> "]
[1360.755856, "o", "        t=timeit(fn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.755921, "o", "        fn(); err=(o-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1360.755947, "o", "\u001b[?2004h> "]
[1360.756035, "o", "        print('BM%d BN%d BK%d w%d s%d g%d: %.3f ms err %.2e' % (BM,BN,BK,wp,st,gr,t,err))\r\n\u001b[?2004l\r"]
[1360.756065, "o", "\u001b[?2004h> "]
[1360.756092, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1360.756197, "o", "        print('BM%d BN%d BK%d w%d s%d g%d: FAIL %s' % (BM,BN,BK,wp,st,gr,str(ex)[:70]))\r\n\u001b[?2004l\r"]
[1360.756222, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[1360.757544, "o", "\u001b[?2004hroot@modal:/# "]
[1360.757598, "o", "gpu run -- python3 /workspace/bench9.py\r\n\u001b[?2004l\r"]
