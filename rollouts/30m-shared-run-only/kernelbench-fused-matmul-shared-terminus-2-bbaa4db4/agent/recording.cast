[272.356366, "o", "import torch\r\nimport torch.nn as nn\r\nimport torch.nn.functional as F\r\n\r\n# Ensure exact FP32 matmul (no TF32) for bitwise-stable correctness\r\ntorch.backends.cuda.matmul.allow_tf32 = False\r\ntorch.backends.cudnn.allow_tf32 = False\r\n\r\n\r\nclass ModelNew(nn.Module):\r\n    \"\"\"\r\n    Fused: matmul -> scale -> add residual simplifies to (1+s) * linear(x).\r\n    We pre-scale the weights and bias by (1 + scaling_factor) so the forward\r\n    pass is a single GEMM (addmm), eliminating clone/mul/add elementwise ops.\r\n    \"\"\"\r\n    def __init__(self, in_features, out_features, scaling_factor):\r\n        super(ModelNew, self).__init__()\r\n        self.matmul = nn.Linear(in_features, out_features)\r\n        self.scaling_factor = scaling_factor\r\n        alpha = 1.0 + float(scaling_factor)\r\n        with torch.no_grad():\r\n            self.matmul.weight.mul_(alpha)\r\n            self.matmul.bias.mul_(alpha)\r\n\r\n    def forward(self, x):\r\n        return F.linear(x, self.matmul.weight, self.matmul.bias)\r\n"]
