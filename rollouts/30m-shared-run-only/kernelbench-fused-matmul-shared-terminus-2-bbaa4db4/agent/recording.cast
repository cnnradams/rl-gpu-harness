[1215.055315, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r"]
[1215.055349, "o", "\u001b[?2004h> "]
[1215.055423, "o", "    The reference computes y = x @ W^T + b, then y*s + y = (1+s)*y.\r\n\u001b[?2004l\r"]
[1215.055457, "o", "\u001b[?2004h> "]
[1215.055527, "o", "    We fuse the (1+s) factor into an fp32 copy of the bias and evaluate the\r\n\u001b[?2004l\r"]
[1215.055567, "o", "\u001b[?2004h> "]
[1215.055627, "o", "    GEMM using an fp16 hi/lo (2-segment) decomposition computed on tensor\r\n\u001b[?2004l\r"]
[1215.055666, "o", "\u001b[?2004h> "]
[1215.055703, "o", "    cores with fp32 accumulation:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1215.055741, "o", "        x ~ xh + xl/2^11,  W ~ wh + wl/2^11\r\n\u001b[?2004l\r"]
[1215.055779, "o", "\u001b[?2004h> "]
[1215.055847, "o", "        x@W ~ xh@wh + (xh@wl + xl@wh)/2^11   (dropped term ~2^-22 relative)\r\n\u001b[?2004l\r"]
[1215.055885, "o", "\u001b[?2004h> "]
[1215.055935, "o", "    Max abs error vs fp32 reference is ~2e-5 (tolerance is 1e-4).\r\n\u001b[?2004l\r"]
[1215.055974, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
