[1444.012077, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.6,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.6,\r\n    \"std\": 0.116,\r\n    \"min\": 2.42,\r\n    \"max\": 2.78,\r\n    \"num_trials\": 100\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0305,\r\n    \"min\": 11.4,\r\n    \"max\": 11.6,\r\n    \"num_trials\": 100\r\n  },\r\n  \"solution_sha256\": \"c19bbf49285dd84ee02316619adeb45fa5d39b0978c601131bf70de16fd83286\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 100,\r\n  \"speedup\": 4.384615384615385\r\n}\r\n"]
