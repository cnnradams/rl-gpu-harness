[1039.936789, "o", "\u001b[?2004h> "]
[1039.936858, "o", "NUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r"]
[1039.936882, "o", "\u001b[?2004h> "]
