[1039.934952, "o", "\u001b[?2004h> "]
[1039.934993, "o", "            wl = WLd.load([ok, on])\r\n\u001b[?2004l\r"]
[1039.935021, "o", "\u001b[?2004h> "]
[1039.935055, "o", "            acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1039.935084, "o", "> "]
