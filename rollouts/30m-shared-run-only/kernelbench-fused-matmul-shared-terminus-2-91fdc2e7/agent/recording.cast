[265.212725, "o", "mm fp32      : 10.744983959197999\r\nmm tf32      : 1.526339191198349\r\ntriton tf32x3 128x128x64 w8 s3: 13.632 ms  err=1.00e+00\r\ntriton tf32x3 128x128x32 w8 s4: 14.779 ms  err=1.00e+00\r\ntriton tf32x3 128x256x64 w8 s3: FAIL OutOfResources\r\ntriton tf32x3 256x128x64 w8 s3: FAIL OutOfResources\r\ntriton tf32x3 64x256x64 w4 s4: FAIL OutOfResources\r\ntriton tf32x3 128x64x64 w4 s4: 20.300 ms  err=1.00e+00\r\ntriton tf32 128x128x64 w8 s3: 6.446 ms  err=1.08e+00\r\ntriton tf32 128x128x32 w8 s4: 6.633 ms  err=1.08e+00\r\ntriton tf32 128x256x64 w8 s3: FAIL OutOfResources\r\ntriton tf32 256x128x64 w8 s3: FAIL OutOfResources\r\ntriton tf32 64x256x64 w4 s4: FAIL OutOfResources\r\ntriton tf32 128x64x64 w4 s4: 6.277 ms  err=1.08e+00\r\ntriton ieee 128x128x64 w8 s3: 12.985 ms  err=9.99e-01\r\ntriton ieee 128x128x32 w8 s4: 12.862 ms  err=9.99e-01\r\ntriton ieee 128x256x64 w8 s3: 32.625 ms  err=9.99e-01\r\ntriton ieee 256x128x64 w8 s3: 32.684 ms  err=9.99e-01\r\ntriton ieee 64x256x64 w4 s4: FAIL OutOfResources\r\ntriton ieee 128x64x64 w4 s4: 21.395 ms  err="]
