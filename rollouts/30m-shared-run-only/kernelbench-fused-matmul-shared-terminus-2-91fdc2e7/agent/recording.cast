[1199.41275, "o", "type=x.dtype)\r\n                grid = lambda META: (\r\n                    triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),\r\n                )\r\n             "]
[1199.4128, "o", "   _linear_fp16x3_kernel[grid](x, self._w_hi, self._w_lo, b, out, M, N, K)\r\n                return out\r\n        return torch.addmm(b, x.reshape(-1, K), self.w_full).reshape(*x.shape[:-1], b.shape[0])\r\nEOF\r\n"]
