[1501.602499, "o", "    acc=acc+bias[None,:]\r\n\u001b[?2004l\r"]
[1501.602557, "o", "\u001b[?2004h> "]
[1501.602668, "o", "    cp=c_ptr+om[:,None]*N+on[None,:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.60272, "o", "    tl.store(cp,acc)\r\n\u001b[?2004l\r"]
[1501.602759, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.603011, "o", "def run(BM,BN,BK,GM,warps,stages,ws,flat):\r\n\u001b[?2004l\r\u001b[?2004h>     out=torch.empty(M,N,device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.603128, "o", "    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.603358, "o", "    k_ws[grid](x,wt_h,wt_l,b,out,M,N,K,BM,BN,BK,GM,ws,flat,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1501.60339, "o", "> "]
[1501.603431, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.603468, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.603514, "o", "def viol(out):\r\n\u001b[?2004l\r"]
[1501.603553, "o", "\u001b[?2004h> "]
[1501.6036, "o", "    diff=(out-ref).abs()\r\n\u001b[?2004l\r"]
[1501.603638, "o", "\u001b[?2004h> "]
[1501.603693, "o", "    denom=1e-4+1e-4*ref.abs()\r\n\u001b[?2004l\r"]
[1501.603731, "o", "\u001b[?2004h> "]
[1501.603806, "o", "    return (diff/denom).max().item()\r\n\u001b[?2004l\r"]
[1501.603845, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.603911, "o", "for ws in (True,False):\r\n\u001b[?2004l\r"]
[1501.603948, "o", "\u001b[?2004h> "]
[1501.604332, "o", "    for (BM,BN,BK,GM,w_,s_) in [(128,128,32,8,8,4),(128,128,16,8,8,6),(128,128,64,8,8,3),(128,256,32,8,8,4),(256,128,32,8,8,4),(128,128,32,8,8,2),(128,128,32,8,8,3)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1501.60439, "o", "> "]
[1501.604428, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.604543, "o", "            out=run(BM,BN,BK,GM,w_,s_,ws,False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1501.604585, "o", "> "]
[1501.604701, "o", "            t=timeit(lambda: run(BM,BN,BK,GM,w_,s_,ws,False))\r\n\u001b[?2004l\r"]
[1501.604742, "o", "\u001b[?2004h> "]
[1501.604949, "o", "            print(f\"ws={ws} {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms viol={viol(out):.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.605097, "o", "        except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1501.605299, "o", "            print(f\"ws={ws} {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}: {str(ex)[:80]}\")\r\n\u001b[?2004l\r"]
[1501.605313, "o", "\u001b[?2004h> "]
[1501.605332, "o", "EOF\r\n\u001b[?2004l\r"]
[1501.607209, "o", "\u001b[?2004hroot@modal:/# "]
