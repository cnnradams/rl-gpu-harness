[495.170583, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 0.1)\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\nref = torch.addmm(b, x, wt)\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    evs=[(torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)) for _ in range(n)]\n    for s,e in evs:\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    ts=[s.elapsed_time(e) for s,e in evs]\n    return sum(ts)/len(ts)\n\ndef viol(out):\n    diff=(out-ref).abs()\n    denom=1e-4+1e-4*ref.abs()\n    return (diff/denom).max().item()\n\n@triton.jit\ndef k_fp16x3(a_ptr,b_ptr,bias_ptr,c_ptr,M,N,K,BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GM:tl.constexpr,SPLIT:tl.constexpr):\n    pid=tl.program_id(0)\n    npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\n    ng=GM*npn; gid=pid//ng; fm=gid*GM; gs=min(npm-fm,GM)\n    pm=fm+((pid"]
[495.170635, "i", "%ng)%gs); pn=(pid%ng)//gs\n    om=pm*BM+tl.arange(0,BM); on=pn*BN+tl.arange(0,BN); ok=tl.arange(0,BK)\n    ap=a_ptr+om[:,None]*K+ok[None,:]; bp=b_ptr+ok[:,None]*N+on[None,:]\n    acc=tl.zeros((BM,BN),dtype=tl.float32)\n    if SPLIT:\n        acc2=tl.zeros((BM,BN),dtype=tl.float32)\n    else:\n        acc2=acc\n    for _ in range(0,K,BK):\n        a=tl.load(ap)\n        bb=tl.load(bp)\n        ah=a.to(tl.float16); al=(a-ah.to(tl.float32)).to(tl.float16)\n        bh=bb.to(tl.float16); bl=(bb-bh.to(tl.float32)).to(tl.float16)\n        acc=tl.dot(ah,bh,acc)\n        acc2=tl.dot(ah,bl,acc2)\n        acc2=tl.dot(al,bh,acc2)\n        ap+=BK; bp+=BK*N\n    acc=acc+acc2\n    bias=tl.load(bias_ptr+on)\n    acc=acc+bias[None,:]\n    cp=c_ptr+om[:,None]*N+on[None,:]\n    tl.store(cp,acc)\n\ndef run(BM,BN,BK,GM,warps,stages,split):\n    out=torch.empty(M,N,device='cuda')\n    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    k_fp16x3[grid](x,wt,b,out,M,N,K,BM,BN,BK,GM,split,num_warps=warps,num_stages=stages)\n    return out\n\nfor split in (1,0):\n    "]
[495.170646, "i", "for (BM,BN,BK,GM,w_,s_) in [(128,128,64,8,8,3),(256,128,64,8,8,3),(128,256,64,8,8,2),(128,128,32,8,8,4),(64,256,64,8,4,4),(128,64,64,8,4,4),(256,64,64,8,8,3)]:\n        try:\n            out=run(BM,BN,BK,GM,w_,s_,split)\n            t=timeit(lambda: run(BM,BN,BK,GM,w_,s_,split))\n            print(f\"fp16x3 split={split} {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms viol={viol(out):.4f} maxdiff={(out-ref).abs().max().item():.3e}\")\n        except Exception as ex:\n            print(f\"fp16x3 split={split} {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}\")\nEOF\n"]
