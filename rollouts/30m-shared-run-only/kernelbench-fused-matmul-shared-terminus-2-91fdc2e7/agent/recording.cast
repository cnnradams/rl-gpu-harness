[1440.940357, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.48,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.48,\r\n    \"std\": 0.123,\r\n    \"min\": 2.38,\r\n    \"max\": 2.65,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0494,\r\n    \"min\": 11.3,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"4b87a154833ee8c77094db30bf6388c9533c7b136f5cd2d166a9617a065da059\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.596774193548387\r\n}\r\n"]
