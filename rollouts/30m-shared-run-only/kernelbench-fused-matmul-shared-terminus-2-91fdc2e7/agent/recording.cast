[150.249689, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 13.5,\r\n  \"runtime_stats\": {\r\n    \"mean\": 13.5,\r\n    \"std\": 0.177,\r\n    \"min\": 13.3,\r\n    \"max\": 13.8,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0417,\r\n    \"min\": 11.3,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"70734424eaf22da7ac1839430cb528735c65a124b870a72712de9bac47c4c125\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 0.8444444444444444\r\n}\r\n"]
[153.371659, "o", "\u001b[?2004hroot@modal:/# "]
[225.619463, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl, time\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 0.1)\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    evs = [(torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)) for _ in range(n)]\n    for s, e in evs:\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    ts = [s.elapsed_time(e) for s, e in evs]\n    return sum(ts)/len(ts)\n\n# ref exact\nref = torch.addmm(b, x, wt)\n\nprint(\"mm fp32      :\", timeit(lambda: torch.mm(x, wt)))\ntorch.backends.cuda.matmul.allow_tf32 = True\nprint(\"mm tf32      :\", timeit(lambda: torch.mm(x, wt)))\ntorch.backends.cuda.matmul.allow_tf32 = False\n\n@triton.jit\ndef k_tf32x3(a_ptr,b_ptr,c_ptr,M,N,K,BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GM:tl.constexpr,PREC:tl.constexpr):\n    pid=tl.program_id(0)\n"]
[225.619518, "i", "    npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\n    ng=GM*npn; gid=pid//ng; fm=gid*GM; gs=min(npm-fm,GM)\n    pm=fm+((pid%ng)%gs); pn=(pid%ng)//gs\n    om=pm*BM+tl.arange(0,BM); on=pn*BN+tl.arange(0,BN); ok=tl.arange(0,BK)\n    ap=a_ptr+om[:,None]*K+ok[None,:]; bp=b_ptr+ok[:,None]*N+on[None,:]\n    acc=tl.zeros((BM,BN),dtype=tl.float32)\n    for _ in range(0,K,BK):\n        a=tl.load(ap); bb=tl.load(bp)\n        acc=tl.dot(a,bb,acc,input_precision=PREC)\n        ap+=BK; bp+=BK*N\n    cp=c_ptr+om[:,None]*N+on[None,:]\n    tl.store(cp,acc)\n\ndef run_triton(prec, BM,BN,BK,GM,warps,stages):\n    out=torch.empty(M,N,device='cuda')\n    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    k_tf32x3[grid](x,wt,out,M,N,K,BM,BN,BK,GM,prec,num_warps=warps,num_stages=stages)\n    return out\n\nfor prec in [\"tf32x3\",\"tf32\",\"ieee\"]:\n    for (BM,BN,BK,GM,w_,s_) in [(128,128,64,8,8,3),(128,128,32,8,8,4),(128,256,64,8,8,3),(256,128,64,8,8,3),(64,256,64,8,4,4),(128,64,64,8,4,4)]:\n        try:\n            out=run_triton(prec,BM,BN,BK,GM,w_,s_)\n           "]
[225.619545, "i", " t=timeit(lambda: run_triton(prec,BM,BN,BK,GM,w_,s_))\n            err=(out-ref).abs().max().item()\n            print(f\"triton {prec} {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms  err={err:.2e}\")\n        except Exception as ex:\n            print(f\"triton {prec} {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}\")\nEOF\n"]
[225.619727, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[225.61977, "o", "\u001b[?2004h> "]
[225.619901, "o", "import torch, triton, triton.language as tl, time\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.619926, "o", "> \r\n\u001b[?2004l\r"]
[225.619948, "o", "\u001b[?2004h"]
[225.619968, "o", "> "]
[225.62003, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.620117, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.620147, "o", "> "]
[225.620225, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[225.620246, "o", "\u001b[?2004h> "]
[225.620356, "o", "w = (torch.rand(N, K, device='cuda') * 0.1)\r\n\u001b[?2004l\r"]
[225.620416, "o", "\u001b[?2004h> "]
[225.620503, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[225.620544, "o", "\u001b[?2004h> "]
[225.620596, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.620626, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[225.620649, "o", "> "]
[225.6207, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r"]
[225.62072, "o", "\u001b[?2004h> "]
[225.620794, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[225.620817, "o", "\u001b[?2004h> "]
[225.620889, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[225.620912, "o", "\u001b[?2004h> "]
[225.621171, "o", "    evs = [(torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)) for _ in range(n)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.621199, "o", "> "]
[225.621248, "o", "    for s, e in evs:\r\n\u001b[?2004l\r"]
[225.621271, "o", "\u001b[?2004h> "]
[225.621365, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.621393, "o", "> "]
[225.621454, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[225.621478, "o", "\u001b[?2004h> "]
[225.621599, "o", "    ts = [s.elapsed_time(e) for s, e in evs]\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.62163, "o", "> "]
[225.621683, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r"]
[225.621708, "o", "\u001b[?2004h> \r\n"]
[225.62173, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[225.621773, "o", "# ref exact\r\n\u001b[?2004l\r"]
[225.621796, "o", "\u001b[?2004h> "]
[225.621863, "o", "ref = torch.addmm(b, x, wt)\r\n\u001b[?2004l\r"]
[225.62189, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[225.621901, "o", "\u001b[?2004h"]
[225.621928, "o", "> "]
[225.622053, "o", "print(\"mm fp32      :\", timeit(lambda: torch.mm(x, wt)))\r\n\u001b[?2004l\r"]
[225.622075, "o", "\u001b[?2004h> "]
[225.622186, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[225.622211, "o", "\u001b[?2004h> "]
[225.622351, "o", "print(\"mm tf32      :\", timeit(lambda: torch.mm(x, wt)))\r\n\u001b[?2004l\r"]
[225.622413, "o", "\u001b[?2004h> "]
[225.622535, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[225.622555, "o", "\u001b[?2004h> "]
[225.622578, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.622593, "o", "> "]
[225.622617, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[225.622643, "o", "\u001b[?2004h> "]
[225.622951, "o", "def k_tf32x3(a_ptr,b_ptr,c_ptr,M,N,K,BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GM:tl.constexpr,PREC:tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[225.623019, "o", "    pid=tl.program_id(0)\r\n\u001b[?2004l\r"]
[225.623051, "o", "\u001b[?2004h> "]
[225.623144, "o", "    npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\r\n\u001b[?2004l\r"]
[225.62316, "o", "\u001b[?2004h> "]
[225.623301, "o", "    ng=GM*npn; gid=pid//ng; fm=gid*GM; gs=min(npm-fm,GM)\r\n\u001b[?2004l\r"]
[225.62333, "o", "\u001b[?2004h> "]
[225.623421, "o", "    pm=fm+((pid%ng)%gs); pn=(pid%ng)//gs\r\n\u001b[?2004l\r"]
[225.623442, "o", "\u001b[?2004h> "]
[225.623635, "o", "    om=pm*BM+tl.arange(0,BM); on=pn*BN+tl.arange(0,BN); ok=tl.arange(0,BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[225.62366, "o", "> "]
[225.623816, "o", "    ap=a_ptr+om[:,None]*K+ok[None,:]; bp=b_ptr+ok[:,None]*N+on[None,:]\r\n\u001b[?2004l\r"]
[225.623837, "o", "\u001b[?2004h> "]
[225.623945, "o", "    acc=tl.zeros((BM,BN),dtype=tl.float32)\r\n\u001b[?2004l\r"]
[225.623967, "o", "\u001b[?2004h> "]
[225.624035, "o", "    for _ in range(0,K,BK):\r\n\u001b[?2004l\r"]
[225.624062, "o", "\u001b[?2004h> "]
[225.62415, "o", "        a=tl.load(ap); bb=tl.load(bp)\r\n\u001b[?2004l\r"]
[225.624179, "o", "\u001b[?2004h> "]
[225.624294, "o", "        acc=tl.dot(a,bb,acc,input_precision=PREC)\r\n\u001b[?2004l\r"]
[225.624324, "o", "\u001b[?2004h> "]
[225.624399, "o", "        ap+=BK; bp+=BK*N\r\n\u001b[?2004l\r"]
[225.624424, "o", "\u001b[?2004h> "]
[225.624532, "o", "    cp=c_ptr+om[:,None]*N+on[None,:]\r\n\u001b[?2004l\r"]
[225.624553, "o", "\u001b[?2004h> "]
[225.624614, "o", "    tl.store(cp,acc)\r\n\u001b[?2004l\r"]
[225.624641, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[225.624661, "o", "\u001b[?2004h> "]
[225.624787, "o", "def run_triton(prec, BM,BN,BK,GM,warps,stages):\r\n\u001b[?2004l\r"]
[225.624809, "o", "\u001b[?2004h> "]
[225.624902, "o", "    out=torch.empty(M,N,device='cuda')\r\n\u001b[?2004l\r"]
[225.624932, "o", "\u001b[?2004h> "]
