[1270.314153, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1270.314634, "o", "for (BM,BN,BK,GM,w_,s_) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,128,32,8,8,4),(128,256,64,8,8,2),(256,128,64,8,8,2),(128,256,64,8,8,3),(128,128,128,8,8,2),(256,128,128,8,8,2),(128,256,128,8,8,2)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
