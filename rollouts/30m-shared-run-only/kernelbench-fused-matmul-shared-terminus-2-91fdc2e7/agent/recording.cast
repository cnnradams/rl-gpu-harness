[1218.35995, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.47,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.47,\r\n    \"std\": 0.0299,\r\n    \"min\": 2.45,\r\n    \"max\": 2.58,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.069,\r\n    \"min\": 11.2,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"84bacf49e9a0b533d4ba2ea383e0474e9decee0e44a9572758cd03f414de1284\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.574898785425101\r\n}\r\n"]
