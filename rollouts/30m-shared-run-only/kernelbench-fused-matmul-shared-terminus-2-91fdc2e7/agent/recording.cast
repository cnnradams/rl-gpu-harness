[859.94917, "o", "\u001b[?2004h> "]
[859.949224, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[859.949268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[859.949306, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[859.949342, "o", "> "]
[859.949389, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[859.949429, "o", "\u001b[?2004h> "]
[859.949574, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[859.949615, "o", "\u001b[?2004h> "]
[859.949704, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[859.949739, "o", "\u001b[?2004h> "]
[859.94987, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[859.949909, "o", "\u001b[?2004h> "]
[859.950001, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[859.950037, "o", "\u001b[?2004h> "]
[859.950116, "o", "        scale = 1.0 + scaling_factor\r\n\u001b[?2004l\r"]
[859.950156, "o", "\u001b[?2004h> "]
[859.950215, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[859.95026, "o", "\u001b[?2004h> "]
[859.950398, "o", "            w_t = (scale * self.matmul.weight.t()).contiguous()\r\n\u001b[?2004l\r"]
[859.950436, "o", "\u001b[?2004h> "]
[859.950557, "o", "            b = (scale * self.matmul.bias).contiguous()\r\n\u001b[?2004l\r"]
[859.950595, "o", "\u001b[?2004h> "]
[859.950655, "o", "            w_h = w_t.half()\r\n\u001b[?2004l\r"]
[859.950693, "o", "\u001b[?2004h> "]
[859.950788, "o", "            w_l = (w_t - w_h.float()).half()\r\n\u001b[?2004l\r"]
[859.950826, "o", "\u001b[?2004h> "]
[859.950914, "o", "        self.register_buffer(\"w_hi\", w_h)\r\n\u001b[?2004l\r"]
[859.950951, "o", "\u001b[?2004h> "]
[859.95104, "o", "        self.register_buffer(\"w_lo\", w_l)\r\n\u001b[?2004l\r"]
[859.951083, "o", "\u001b[?2004h> "]
[859.951177, "o", "        self.register_buffer(\"scaled_bias\", b)\r\n\u001b[?2004l\r"]
[859.951215, "o", "\u001b[?2004h> "]
[859.951316, "o", "        self.register_buffer(\"w_full\", w_t)\r\n\u001b[?2004l\r"]
[859.951354, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[859.951391, "o", "\u001b[?2004h> "]
[859.951444, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[859.951482, "o", "\u001b[?2004h> "]
[859.95152, "o", "        wh = self.w_hi\r\n\u001b[?2004l\r"]
[859.951558, "o", "\u001b[?2004h> "]
[859.951607, "o", "        wl = self.w_lo\r\n\u001b[?2004l\r"]
[859.951645, "o", "\u001b[?2004h> "]
[859.951705, "o", "        b = self.scaled_bias\r\n\u001b[?2004l\r"]
[859.951746, "o", "\u001b[?2004h> "]
[859.951786, "o", "        if (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[859.951878, "o", "            x.is_cuda\r\n\u001b[?2004l\r\u001b[?2004h> "]
[859.951972, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[859.952017, "o", "\u001b[?2004h> "]
[859.952069, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[859.952107, "o", "\u001b[?2004h> "]
[859.952178, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[859.952216, "o", "\u001b[?2004h> "]
[859.952262, "o", "        ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[859.952332, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[859.952381, "o", "\u001b[?2004h> "]
[859.952437, "o", "            N = wh.shape[1]\r\n\u001b[?2004l\r"]
[859.952472, "o", "\u001b[?2004h> "]
[859.95261, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 32 == 0:\r\n\u001b[?2004l\r"]
[859.952649, "o", "\u001b[?2004h> "]
[859.952807, "o", "                out = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r"]
[859.952845, "o", "\u001b[?2004h> "]
[859.952924, "o", "                grid = lambda META: (\r\n\u001b[?2004l\r"]
[859.95296, "o", "\u001b[?2004h> "]
[859.953151, "o", "                    triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),\r\n\u001b[?2004l\r"]
[859.953185, "o", "\u001b[?2004h> "]
[859.953228, "o", "                )\r\n\u001b[?2004l\r"]
[859.953274, "o", "\u001b[?2004h> "]
[859.953424, "o", "                _linear_fp16x3_kernel[grid](x, wh, wl, b, out, M, N, K)\r\n\u001b[?2004l\r"]
[859.953462, "o", "\u001b[?2004h> "]
[859.953518, "o", "                return out\r\n\u001b[?2004l\r"]
[859.953557, "o", "\u001b[?2004h> "]
[859.953793, "o", "        return torch.addmm(b, x.reshape(-1, K), self.w_full).reshape(*x.shape[:-1], b.shape[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[859.953842, "o", "> EOF\r\n\u001b[?2004l\r"]
[859.955402, "o", "\u001b[?2004hroot@modal:/# "]
[860.041748, "i", "gpu run -- python3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report3.json\n"]
