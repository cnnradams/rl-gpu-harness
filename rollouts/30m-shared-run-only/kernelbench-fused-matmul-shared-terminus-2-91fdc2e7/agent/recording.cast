[792.011664, "o", "\u001b[?2004h> "]
[792.01178, "o", "    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[792.011798, "o", "\u001b[?2004h> "]
[792.012032, "o", "    k_presplit[grid](x,wt_h,wt_l,b,out,M,N,K,BM,BN,BK,GM,num_warps=warps,num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[792.012055, "o", "> "]
[792.012086, "o", "    return out\r\n\u001b[?2004l\r"]
[792.012117, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[792.012135, "o", "\u001b[?2004h> "]
[792.012182, "o", "best=(1e9,None)\r\n\u001b[?2004l\r"]
[792.012207, "o", "\u001b[?2004h> "]
[792.012932, "o", "for (BM,BN,BK,GM,w_,s_) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,128,64,8,8,5),(128,128,32,8,8,4),(128,128,32,8,8,6),(128,128,128,8,8,2),(128,128,128,8,8,3),(256,128,64,8,8,3),(128,256,64,8,8,2),(64,128,64,8,4,4),(128,64,64,8,4,4),(128,128,64,8,4,3),(64,128,128,8,4,4),(64,128,64,8,4,6)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[792.01296, "o", "    try:\r\n\u001b[?2004l\r"]
[792.012982, "o", "\u001b[?2004h> "]
[792.013071, "o", "        out=run(BM,BN,BK,GM,w_,s_)\r\n\u001b[?2004l\r"]
[792.013091, "o", "\u001b[?2004h> "]
[792.013218, "o", "        t=timeit(lambda: run(BM,BN,BK,GM,w_,s_))\r\n\u001b[?2004l\r"]
[792.013241, "o", "\u001b[?2004h> "]
[792.01329, "o", "        v=viol(out)\r\n\u001b[?2004l\r"]
[792.013319, "o", "\u001b[?2004h> "]
[792.013441, "o", "        if t<best[0]: best=(t,(BM,BN,BK,GM,w_,s_))\r\n\u001b[?2004l\r"]
[792.013471, "o", "\u001b[?2004h> "]
[792.013646, "o", "        print(f\"presplit {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms viol={v:.4f}\")\r\n\u001b[?2004l\r"]
[792.013666, "o", "\u001b[?2004h> "]
[792.013749, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[792.01378, "o", "\u001b[?2004h> "]
[792.013975, "o", "        print(f\"presplit {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[792.013998, "o", "> "]
[792.014048, "o", "print(\"BEST:\", best)\r\n\u001b[?2004l\r"]
[792.014079, "o", "\u001b[?2004h> "]
[792.014097, "o", "EOF\r\n\u001b[?2004l\r"]
[792.015774, "o", "\u001b[?2004hroot@modal:/# "]
