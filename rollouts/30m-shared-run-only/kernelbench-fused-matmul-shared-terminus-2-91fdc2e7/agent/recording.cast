[1270.310112, "o", "def k_tma(a_desc, bh_desc, bl_desc, bias_ptr, c_desc, M, N, K,\r\n\u001b[?2004l\r"]
[1270.310142, "o", "\u001b[?2004h> "]
[1270.310342, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r"]
