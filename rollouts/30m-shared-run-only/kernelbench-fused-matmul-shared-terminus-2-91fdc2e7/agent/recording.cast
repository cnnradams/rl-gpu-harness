[1199.422083, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[1199.422127, "o", "\u001b[?2004h> "]
[1199.422165, "o", "        ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1199.422226, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[1199.422264, "o", "\u001b[?2004h> "]
[1199.422337, "o", "            N = self._w_hi.shape[1]\r\n\u001b[?2004l\r"]
[1199.42238, "o", "\u001b[?2004h> "]
[1199.422505, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 32 == 0:\r\n\u001b[?2004l\r"]
[1199.422543, "o", "\u001b[?2004h> "]
[1199.422639, "o", "                if self._w_device != x.device:\r\n\u001b[?2004l\r"]
[1199.422676, "o", "\u001b[?2004h> "]
[1199.422801, "o", "                    self._w_hi = self._w_hi.to(x.device)\r\n\u001b[?2004l\r"]
[1199.42284, "o", "\u001b[?2004h> "]
[1199.422957, "o", "                    self._w_lo = self._w_lo.to(x.device)\r\n\u001b[?2004l\r"]
[1199.422995, "o", "\u001b[?2004h> "]
[1199.423089, "o", "                    self._w_device = x.device\r\n\u001b[?2004l\r"]
[1199.423127, "o", "\u001b[?2004h> "]
[1199.423283, "o", "                out = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r"]
[1199.423321, "o", "\u001b[?2004h> "]
[1199.423396, "o", "                grid = lambda META: (\r\n\u001b[?2004l\r"]
[1199.423435, "o", "\u001b[?2004h> "]
[1199.423619, "o", "                    triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),\r\n\u001b[?2004l\r"]
[1199.423657, "o", "\u001b[?2004h> "]
[1199.423695, "o", "                )\r\n\u001b[?2004l\r"]
[1199.423734, "o", "\u001b[?2004h> "]
[1199.423942, "o", "                _linear_fp16x3_kernel[grid](x, self._w_hi, self._w_lo, b, out, M, N, K)\r\n\u001b[?2004l\r"]
[1199.423981, "o", "\u001b[?2004h> "]
[1199.424034, "o", "                return out\r\n\u001b[?2004l\r"]
[1199.424072, "o", "\u001b[?2004h> "]
[1199.424297, "o", "        return torch.addmm(b, x.reshape(-1, K), self.w_full).reshape(*x.shape[:-1], b.shape[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
