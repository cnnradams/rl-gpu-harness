[334.285859, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 0.1)\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\nref64 = (x.double() @ wt.double() + b.double())\nref32 = torch.addmm(b, x, wt)\nprint(\"cublas fp32 err vs fp64:\", (ref32.double()-ref64).abs().max().item())\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    evs=[(torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)) for _ in range(n)]\n    for s,e in evs:\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    ts=[s.elapsed_time(e) for s,e in evs]\n    return sum(ts)/len(ts)\n\n@triton.jit\ndef k_bf16x3(a_ptr,b_ptr,bias_ptr,c_ptr,M,N,K,BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GM:tl.constexpr,NDOT:tl.constexpr):\n    pid=tl.program_id(0)\n    npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\n    ng=GM*npn; gid=pid//ng; fm=gid*GM; gs=min(npm-fm,G"]
[334.285907, "i", "M)\n    pm=fm+((pid%ng)%gs); pn=(pid%ng)//gs\n    om=pm*BM+tl.arange(0,BM); on=pn*BN+tl.arange(0,BN); ok=tl.arange(0,BK)\n    ap=a_ptr+om[:,None]*K+ok[None,:]; bp=b_ptr+ok[:,None]*N+on[None,:]\n    acc=tl.zeros((BM,BN),dtype=tl.float32)\n    for _ in range(0,K,BK):\n        a=tl.load(ap)\n        bb=tl.load(bp)\n        ah=a.to(tl.bfloat16); al=(a-ah.to(tl.float32)).to(tl.bfloat16)\n        bh=bb.to(tl.bfloat16); bl=(bb-bh.to(tl.float32)).to(tl.bfloat16)\n        acc=tl.dot(ah,bh,acc)\n        acc=tl.dot(ah,bl,acc)\n        if NDOT==3:\n            acc=tl.dot(al,bh,acc)\n        ap+=BK; bp+=BK*N\n    bias=tl.load(bias_ptr+on)\n    acc=acc+bias[None,:]\n    cp=c_ptr+om[:,None]*N+on[None,:]\n    tl.store(cp,acc)\n\ndef run(BM,BN,BK,GM,warps,stages,ndot=3):\n    out=torch.empty(M,N,device='cuda')\n    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    k_bf16x3[grid](x,wt,b,out,M,N,K,BM,BN,BK,GM,ndot,num_warps=warps,num_stages=stages)\n    return out\n\nfor (BM,BN,BK,GM,w_,s_) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(25"]
[334.286002, "i", "6,128,64,8,8,3),(128,256,64,8,8,2),(128,128,128,8,8,2),(64,256,64,8,4,4),(128,64,64,8,4,4)]:\n    for ndot in (3,2):\n        try:\n            out=run(BM,BN,BK,GM,w_,s_,ndot)\n            t=timeit(lambda: run(BM,BN,BK,GM,w_,s_,ndot))\n            err=(out.double()-ref64).abs().max().item()\n            rel=((out.double()-ref64).abs()/(ref64.abs()+1e-6)).max().item()\n            print(f\"bf16x{ndot} {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms maxabs={err:.3e} maxrel={rel:.3e}\")\n        except Exception as ex:\n            print(f\"bf16x{ndot} {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}: {ex}\")\n\nxb=x.bfloat16(); wtb=wt.bfloat16()\nprint(\"torch bf16 mm:\", timeit(lambda: torch.mm(xb,wtb)))\nEOF\n"]
