[1270.312599, "o", "\u001b[?2004h> "]
[1270.312686, "o", "    out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r"]
[1270.312724, "o", "\u001b[?2004h> "]
[1270.312909, "o", "    a_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(x, [BM, BK])\r\n\u001b[?2004l\r"]
