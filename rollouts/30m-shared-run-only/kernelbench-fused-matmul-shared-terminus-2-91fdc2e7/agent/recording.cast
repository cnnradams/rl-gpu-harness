[1501.596729, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 0.1)\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\nref = torch.addmm(b, x, wt)\nwt_h = wt.half()\nwt_l = (wt - wt_h.float()).half()\n\ndef timeit(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    evs=[(torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)) for _ in range(n)]\n    for s,e in evs:\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    ts=[s.elapsed_time(e) for s,e in evs]\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef k_ws(a_ptr,bh_ptr,bl_ptr,bias_ptr,c_ptr,M,N,K,BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GM:tl.constexpr,WS:tl.constexpr,FLAT:tl.constexpr):\n    pid=tl.program_id(0)\n    if FLAT:\n        npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\n        pm=pid%npm; pn=pid//npm\n        start=pid\n        step=tol=0\n    else:\n "]
[1501.596866, "i", "       npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\n        ng=GM*npn; gid=pid//ng; fm=gid*GM; gs=min(npm-fm,GM)\n        pm=fm+((pid%ng)%gs); pn=(pid%ng)//gs\n    om=pm*BM+tl.arange(0,BM); on=pn*BN+tl.arange(0,BN); ok=tl.arange(0,BK)\n    ap=a_ptr+om[:,None]*K+ok[None,:]\n    bhp=bh_ptr+ok[:,None]*N+on[None,:]; blp=bl_ptr+ok[:,None]*N+on[None,:]\n    acc=tl.zeros((BM,BN),dtype=tl.float32)\n    for k in tl.range(0,K,BK,warp_specialize=WS):\n        a=tl.load(ap)\n        ah=a.to(tl.float16); al=(a-ah.to(tl.float32)).to(tl.float16)\n        bh=tl.load(bhp); bl=tl.load(blp)\n        acc=tl.dot(ah,bh,acc)\n        acc=tl.dot(ah,bl,acc)\n        acc=tl.dot(al,bh,acc)\n        ap+=BK; bhp+=BK*N; blp+=BK*N\n    bias=tl.load(bias_ptr+on)\n    acc=acc+bias[None,:]\n    cp=c_ptr+om[:,None]*N+on[None,:]\n    tl.store(cp,acc)\n\ndef run(BM,BN,BK,GM,warps,stages,ws,flat):\n    out=torch.empty(M,N,device='cuda')\n    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    k_ws[grid](x,wt_h,wt_l,b,out,M,N,K,BM,BN,BK,GM,ws,flat,num_warps=warps,num_stages=stage"]
[1501.596893, "i", "s)\n    return out\n\ndef viol(out):\n    diff=(out-ref).abs()\n    denom=1e-4+1e-4*ref.abs()\n    return (diff/denom).max().item()\n\nfor ws in (True,False):\n    for (BM,BN,BK,GM,w_,s_) in [(128,128,32,8,8,4),(128,128,16,8,8,6),(128,128,64,8,8,3),(128,256,32,8,8,4),(256,128,32,8,8,4),(128,128,32,8,8,2),(128,128,32,8,8,3)]:\n        try:\n            out=run(BM,BN,BK,GM,w_,s_,ws,False)\n            t=timeit(lambda: run(BM,BN,BK,GM,w_,s_,ws,False))\n            print(f\"ws={ws} {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms viol={viol(out):.4f}\")\n        except Exception as ex:\n            print(f\"ws={ws} {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}: {str(ex)[:80]}\")\nEOF\n"]
