[68.845051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[68.845089, "o", "> "]
[68.845208, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[68.845246, "o", "\u001b[?2004h> "]
[68.84532, "o", "    for _ in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r"]
[68.845353, "o", "\u001b[?2004h> "]
[68.845414, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[68.845448, "o", "\u001b[?2004h> "]
[68.845507, "o", "        b = tl.load(b_ptrs)\r\n\u001b[?2004l\r"]
[68.845551, "o", "\u001b[?2004h> "]
[68.84568, "o", "        acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\r\n\u001b[?2004l\r"]
[68.845724, "o", "\u001b[?2004h> "]
[68.845762, "o", "        a_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[68.845799, "o", "\u001b[?2004h> "]
[68.845866, "o", "        b_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[68.845896, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.845927, "o", "\u001b[?2004h> "]
[68.846023, "o", "    bias = tl.load(bias_ptr + offs_n)\r\n\u001b[?2004l\r"]
[68.84606, "o", "\u001b[?2004h> "]
[68.846114, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[68.846151, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.846182, "o", "\u001b[?2004h> "]
[68.846317, "o", "    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[68.846348, "o", "\u001b[?2004h> "]
[68.846404, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[68.846443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.846477, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[68.846508, "o", "> "]
[68.846567, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[68.846598, "o", "\u001b[?2004h> "]
[68.846751, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[68.846782, "o", "\u001b[?2004h> "]
[68.846875, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[68.846905, "o", "\u001b[?2004h> "]
[68.847039, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[68.847077, "o", "\u001b[?2004h> "]
[68.847171, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[68.847204, "o", "\u001b[?2004h> "]
[68.847286, "o", "        scale = 1.0 + scaling_factor\r\n\u001b[?2004l\r"]
[68.847317, "o", "\u001b[?2004h> "]
[68.847384, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[68.847422, "o", "\u001b[?2004h> "]
[68.847567, "o", "            w_t = (scale * self.matmul.weight.t()).contiguous()\r\n\u001b[?2004l\r"]
[68.847605, "o", "\u001b[?2004h> "]
[68.847755, "o", "            b = (scale * self.matmul.bias).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.847873, "o", "        self.register_buffer(\"scaled_w_t\", w_t)\r\n\u001b[?2004l\r"]
[68.847913, "o", "\u001b[?2004h> "]
[68.848001, "o", "        self.register_buffer(\"scaled_bias\", b)\r\n\u001b[?2004l\r"]
[68.848038, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[68.848076, "o", "\u001b[?2004h> "]
[68.848122, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[68.848154, "o", "\u001b[?2004h> "]
[68.848233, "o", "        w = self.scaled_w_t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.848323, "o", "        b = self.scaled_bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.848354, "o", "> "]
[68.848405, "o", "        if (\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.848442, "o", "> "]
[68.848481, "o", "            x.is_cuda\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.84851, "o", "> "]
[68.84861, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[68.848641, "o", "\u001b[?2004h> "]
[68.848703, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[68.848742, "o", "\u001b[?2004h> "]
[68.848811, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[68.848842, "o", "\u001b[?2004h> "]
[68.84892, "o", "            and w.is_contiguous()\r\n\u001b[?2004l\r"]
[68.848951, "o", "\u001b[?2004h> "]
[68.848988, "o", "        ):\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.849027, "o", "> "]
[68.849064, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[68.849102, "o", "\u001b[?2004h> "]
[68.849164, "o", "            N = w.shape[1]\r\n\u001b[?2004l\r"]
[68.849201, "o", "\u001b[?2004h> "]
[68.849342, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 32 == 0:\r\n\u001b[?2004l\r"]
[68.849376, "o", "\u001b[?2004h> "]
[68.849575, "o", "                out = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.849671, "o", "                grid = lambda META: (\r\n\u001b[?2004l\r"]
[68.849703, "o", "\u001b[?2004h> "]
[68.84992, "o", "                    triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.84996, "o", "> "]
[68.849994, "o", "                )\r\n\u001b[?2004l\r"]
[68.850032, "o", "\u001b[?2004h> "]
[68.85018, "o", "                _linear_tf32x3_kernel[grid](x, w, b, out, M, N, K)\r\n\u001b[?2004l\r\u001b[?2004h"]
[68.850217, "o", "> "]
[68.850268, "o", "                return out\r\n\u001b[?2004l\r"]
[68.850306, "o", "\u001b[?2004h> "]
[68.850501, "o", "        return torch.addmm(b, x.reshape(-1, K), w).reshape(*x.shape[:-1], b.shape[0])\r\n\u001b[?2004l\r"]
[68.850551, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[68.894665, "i", "gpu run -- python3 -c \"import torch, triton; print(torch.__version__, triton.__version__, torch.cuda.get_device_name(0))\"\n"]
[68.894783, "o", "gpu run -- python3 -c \"import torch, triton; print(torch.__version__, triton.__version__, torch.cuda.get_device_name(0))\"\r\n"]
[72.478241, "o", "\u001b[?2004hroot@modal:/# "]
[72.478451, "o", "gpu run -- python3 -c \"import torch, triton; print(torch.__version__, triton.__version__, torch.cuda.get_device_name(0))\"\r\n\u001b[?2004l\r"]
