[1336.432266, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 0.1)\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\nref = torch.addmm(b, x, wt)\nwt_h = wt.half()\nwt_l = (wt - wt_h.float()).half()\n\ndef timeit(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    evs=[(torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)) for _ in range(n)]\n    for s,e in evs:\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    ts=[s.elapsed_time(e) for s,e in evs]\n    ts.sort()\n    return ts[len(ts)//2]\n\ndef viol(out):\n    diff=(out-ref).abs()\n    denom=1e-4+1e-4*ref.abs()\n    return (diff/denom).max().item()\n\n@triton.jit\ndef k_p(a_ptr,bh_ptr,bl_ptr,bias_ptr,c_ptr,M,N,K,BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GM:tl.constexpr):\n    pid=tl.program_id(0)\n    npm=tl.cdiv(M,BM); npn=tl.cdiv(N,BN)\n    ng=GM*npn; gid=pid//"]
[1336.432313, "i", "ng; fm=gid*GM; gs=min(npm-fm,GM)\n    pm=fm+((pid%ng)%gs); pn=(pid%ng)//gs\n    om=pm*BM+tl.arange(0,BM); on=pn*BN+tl.arange(0,BN); ok=tl.arange(0,BK)\n    ap=a_ptr+om[:,None]*K+ok[None,:]\n    bhp=bh_ptr+ok[:,None]*N+on[None,:]; blp=bl_ptr+ok[:,None]*N+on[None,:]\n    acc=tl.zeros((BM,BN),dtype=tl.float32)\n    for _ in range(0,K,BK):\n        a=tl.load(ap)\n        ah=a.to(tl.float16); al=(a-ah.to(tl.float32)).to(tl.float16)\n        bh=tl.load(bhp); bl=tl.load(blp)\n        acc=tl.dot(ah,bh,acc)\n        acc=tl.dot(ah,bl,acc)\n        acc=tl.dot(al,bh,acc)\n        ap+=BK; bhp+=BK*N; blp+=BK*N\n    bias=tl.load(bias_ptr+on)\n    acc=acc+bias[None,:]\n    cp=c_ptr+om[:,None]*N+on[None,:]\n    tl.store(cp,acc)\n\ndef run(BM,BN,BK,GM,warps,stages):\n    out=torch.empty(M,N,device='cuda')\n    grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    k_p[grid](x,wt_h,wt_l,b,out,M,N,K,BM,BN,BK,GM,num_warps=warps,num_stages=stages)\n    return out\n\nres=[]\nfor (BM,BN,BK,GM,w_,s_) in [(128,128,32,8,8,4),(128,128,32,8,8,3),(128,128,32,8,8,5),(128"]
[1336.432324, "i", ",128,32,4,8,4),(128,128,32,16,8,4),(128,128,16,8,8,4),(128,128,16,8,8,6),(128,128,32,8,4,4),(128,128,32,8,4,6),(256,128,32,8,8,4),(128,256,32,8,8,3),(64,128,32,8,4,4),(128,64,32,8,4,4),(128,128,64,8,8,3),(128,128,64,4,8,3),(256,128,32,8,8,3)]:\n    try:\n        out=run(BM,BN,BK,GM,w_,s_)\n        t=timeit(lambda: run(BM,BN,BK,GM,w_,s_))\n        v=viol(out)\n        res.append((t,(BM,BN,BK,GM,w_,s_),v))\n        print(f\"ptr {BM}x{BN}x{BK} gm{GM} w{w_} s{s_}: {t:.3f} ms viol={v:.4f}\")\n    except Exception as ex:\n        print(f\"ptr {BM}x{BN}x{BK} gm{GM} w{w_} s{s_}: FAIL {type(ex).__name__}\")\nres.sort()\nprint(\"BEST:\", res[:3])\nEOF\n"]
