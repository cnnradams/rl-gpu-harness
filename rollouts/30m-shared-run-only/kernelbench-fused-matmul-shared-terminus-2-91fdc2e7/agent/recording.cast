[1270.307087, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 0.1)\nb = torch.rand(N, device='cuda')\nwt = w.t().contiguous()\nref = torch.addmm(b, x, wt)\nwt_h = wt.half()\nwt_l = (wt - wt_h.float()).half()\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    evs=[(torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)) for _ in range(n)]\n    for s,e in evs:\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    ts=[s.elapsed_time(e) for s,e in evs]\n    return sum(ts)/len(ts)\n\ndef viol(out):\n    diff=(out-ref).abs()\n    denom=1e-4+1e-4*ref.abs()\n    return (diff/denom).max().item()\n\n@triton.jit\ndef k_tma(a_desc, bh_desc, bl_desc, bias_ptr, c_desc, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    npm = tl.cdiv(M, BM); npn = tl.cdiv(N, BN"]
[1270.307138, "i", ")\n    ng = GM*npn; gid = pid//ng; fm = gid*GM; gs = min(npm-fm, GM)\n    pm = fm+((pid%ng)%gs); pn = (pid%ng)//gs\n    om = pm*BM; on = pn*BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = a_desc.load([om, k])\n        bh = bh_desc.load([k, on])\n        bl = bl_desc.load([k, on])\n        ah = a.to(tl.float16); al = (a - ah.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n    bias = tl.load(bias_ptr + on + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc.store([om, on], acc)\n\ndef run(BM, BN, BK, GM, warps, stages):\n    out = torch.empty(M, N, device='cuda')\n    a_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(x, [BM, BK])\n    bh_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(wt_h, [BK, BN])\n    bl_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(wt_l, [BK, BN])\n    c_desc = triton.tools.tensor_descriptor.TensorDescriptor.f"]
[1270.307408, "i", "rom_tensor(out, [BM, BN])\n    grid = (triton.cdiv(M, BM)*triton.cdiv(N, BN),)\n    k_tma[grid](a_desc, bh_desc, bl_desc, b, c_desc, M, N, K, BM, BN, BK, GM, num_warps=warps, num_stages=stages)\n    return out\n\nfor (BM,BN,BK,GM,w_,s_) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,128,32,8,8,4),(128,256,64,8,8,2),(256,128,64,8,8,2),(128,256,64,8,8,3),(128,128,128,8,8,2),(256,128,128,8,8,2),(128,256,128,8,8,2)]:\n    try:\n        out=run(BM,BN,BK,GM,w_,s_)\n        t=timeit(lambda: run(BM,BN,BK,GM,w_,s_))\n        print(f\"tma {BM}x{BN}x{BK} w{w_} s{s_}: {t:.3f} ms viol={viol(out):.4f}\")\n    except Exception as ex:\n        print(f\"tma {BM}x{BN}x{BK} w{w_} s{s_}: FAIL {type(ex).__name__}: {str(ex)[:100]}\")\nEOF\n"]
