[1421.186954, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1421.186975, "o", "\u001b[?2004h> "]
[1421.187046, "o", "        b = self.scaled_bias\r\n\u001b[?2004l\r"]
[1421.187073, "o", "\u001b[?2004h> "]
[1421.187112, "o", "        if (\r\n\u001b[?2004l\r"]
[1421.187139, "o", "\u001b[?2004h> "]
[1421.187194, "o", "            x.is_cuda\r\n\u001b[?2004l\r"]
[1421.187214, "o", "\u001b[?2004h> "]
[1421.187318, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1421.187335, "o", "\u001b[?2004h"]
[1421.187356, "o", "> "]
[1421.187415, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[1421.187435, "o", "\u001b[?2004h> "]
[1421.187523, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[1421.187544, "o", "\u001b[?2004h> "]
[1421.187578, "o", "        ):\r\n\u001b[?2004l\r"]
[1421.187605, "o", "\u001b[?2004h> "]
[1421.18767, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[1421.187691, "o", "\u001b[?2004h> "]
[1421.187782, "o", "            N = self._w_hi.shape[1]\r\n\u001b[?2004l\r"]
[1421.187803, "o", "\u001b[?2004h> "]
[1421.187974, "o", "            if M % 128 == 0 and N % 128 == 0 and K % 16 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1421.188101, "o", "                if self._w_device != x.device:\r\n\u001b[?2004l\r"]
[1421.188122, "o", "\u001b[?2004h> "]
[1421.18826, "o", "                    self._w_hi = self._w_hi.to(x.device)\r\n\u001b[?2004l\r"]
[1421.188281, "o", "\u001b[?2004h> "]
[1421.188429, "o", "                    self._w_lo = self._w_lo.to(x.device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1421.188447, "o", "> "]
[1421.188555, "o", "                    self._w_device = x.device\r\n\u001b[?2004l\r"]
[1421.188576, "o", "\u001b[?2004h> "]
[1421.188668, "o", "                    self._graphs = {}\r\n\u001b[?2004l\r"]
[1421.188695, "o", "\u001b[?2004h> "]
[1421.188786, "o", "                key = x.data_ptr()\r\n\u001b[?2004l\r"]
[1421.188806, "o", "\u001b[?2004h> "]
[1421.188924, "o", "                entry = self._graphs.get(key)\r\n\u001b[?2004l\r"]
[1421.188945, "o", "\u001b[?2004h> "]
[1421.189027, "o", "                if entry is None:\r\n\u001b[?2004l\r"]
[1421.189048, "o", "\u001b[?2004h> "]
[1421.189122, "o", "                    try:\r\n\u001b[?2004l\r"]
[1421.189148, "o", "\u001b[?2004h> "]
[1421.189272, "o", "                        stream = torch.cuda.Stream()\r\n\u001b[?2004l\r"]
[1421.189293, "o", "\u001b[?2004h> "]
[1421.189465, "o", "                        stream.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r"]
[1421.189492, "o", "\u001b[?2004h> "]
[1421.189622, "o", "                        with torch.cuda.stream(stream):\r\n\u001b[?2004l\r"]
[1421.189643, "o", "\u001b[?2004h> "]
[1421.18985, "o", "                            warm = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r"]
[1421.189871, "o", "\u001b[?2004h> "]
[1421.189987, "o", "                            for _ in range(2):\r\n\u001b[?2004l\r"]
[1421.190006, "o", "\u001b[?2004h> "]
[1421.190146, "o", "                                self._launch(x, warm)\r\n\u001b[?2004l\r"]
[1421.190168, "o", "\u001b[?2004h> "]
[1421.19034, "o", "                        torch.cuda.current_stream().wait_stream(stream)\r\n\u001b[?2004l\r"]
[1421.190361, "o", "\u001b[?2004h> "]
[1421.190556, "o", "                        out = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r"]
[1421.190577, "o", "\u001b[?2004h> "]
[1421.19071, "o", "                        graph = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[1421.19073, "o", "\u001b[?2004h> "]
[1421.190866, "o", "                        with torch.cuda.graph(graph):\r\n\u001b[?2004l\r"]
[1421.190888, "o", "\u001b[?2004h> "]
[1421.191008, "o", "                            self._launch(x, out)\r\n\u001b[?2004l\r"]
[1421.191029, "o", "\u001b[?2004h> "]
[1421.191149, "o", "                        entry = (graph, out)\r\n\u001b[?2004l\r"]
[1421.19117, "o", "\u001b[?2004h> "]
[1421.191293, "o", "                        self._graphs[key] = entry\r\n\u001b[?2004l\r"]
[1421.191319, "o", "\u001b[?2004h> "]
[1421.191411, "o", "                    except Exception:\r\n\u001b[?2004l\r"]
[1421.191428, "o", "\u001b[?2004h"]
[1421.191444, "o", "> "]
[1421.191628, "o", "                        out = torch.empty((M, N), device=x.device, dtype=x.dtype)\r\n\u001b[?2004l\r"]
[1421.191645, "o", "\u001b[?2004h"]
[1421.191658, "o", "> "]
[1421.191763, "o", "                        self._launch(x, out)\r\n\u001b[?2004l\r"]
[1421.191792, "o", "\u001b[?2004h> "]
[1421.191874, "o", "                        return out\r\n\u001b[?2004l\r"]
[1421.191895, "o", "\u001b[?2004h> "]
[1421.191984, "o", "                graph, out = entry\r\n\u001b[?2004l\r"]
[1421.192009, "o", "\u001b[?2004h> "]
[1421.192091, "o", "                graph.replay()\r\n\u001b[?2004l\r"]
[1421.192111, "o", "\u001b[?2004h> "]
[1421.192185, "o", "                return out\r\n\u001b[?2004l\r"]
[1421.192206, "o", "\u001b[?2004h> "]
[1421.192457, "o", "        return torch.addmm(b, x.reshape(-1, K), self.w_full).reshape(*x.shape[:-1], b.shape[0])\r\n\u001b[?2004l\r"]
[1421.192484, "o", "\u001b[?2004h> "]
[1421.19251, "o", "EOF\r\n\u001b[?2004l\r"]
[1421.194045, "o", "\u001b[?2004hroot@modal:/# "]
