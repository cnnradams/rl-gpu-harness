[1009.972515, "o", "\r\n\u001b[?2004l\r"]
[1009.972539, "o", "\u001b[?2004h> "]
[1009.972575, "o", "def bench(fn, n=20):\r\n\u001b[?2004l\r"]
[1009.972593, "o", "\u001b[?2004h> "]
