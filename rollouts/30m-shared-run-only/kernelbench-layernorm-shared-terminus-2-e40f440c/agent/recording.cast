[1434.007555, "o", "\u001b[?2004hroot@modal:/# "]
[1449.137801, "i", "cat > /workspace/bench2.py << 'EOF'\nimport numpy as np, torch, triton, triton.language as tl, torch.nn as nn\n\ntorch.manual_seed(0)\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device='cuda')\neps = 1e-5\nw0 = torch.ones(N, device='cuda'); b0 = torch.zeros(N, device='cuda')\nref = nn.functional.layer_norm(x, (N,), w0, b0, eps)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); torch.cuda.empty_cache()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if i: ts.append(s.elapsed_time(e))\n    return float(np.mean(ts))\n\n@triton.jit\ndef _ln_pers(x_ptr, y_ptr, w_ptr, b_ptr, sum_ptr, sq_ptr, arr_ptr, flag_ptr,\n             mean_ptr, rstd_ptr,\n             N, eps, epoch,\n             B: tl.constexpr, S: tl.constexpr, BLOCK: tl"]
[1449.13785, "i", ".constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    split = pid % S\n    chunk = N // S\n    rowbase = row * N\n    base = rowbase + split * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, chunk, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        acc += v\n        acc2 += v * v\n    ps = tl.sum(acc)\n    ps2 = tl.sum(acc2)\n    tl.atomic_add(sum_ptr + row, ps)\n    tl.atomic_add(sq_ptr + row, ps2)\n    old = tl.atomic_add(arr_ptr + row, 1, sem='release')\n    if (old + 1) % S == 0:\n        total = tl.atomic_xchg(sum_ptr + row, 0.0, sem='acquire')\n        total2 = tl.atomic_xchg(sq_ptr + row, 0.0, sem='acquire')\n        mean = total / N\n        var = total2 / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.atomic_xchg(mean_ptr + row, mean)\n        tl.atomic_xchg(rstd_ptr + row, rstd)\n        tl.atomic_xchg(flag_ptr + row, epoch, sem='release')\n    f = tl.atomic_add(flag"]
[1449.137861, "i", "_ptr + row, 0, sem='acquire')\n    while f < epoch:\n        f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\n    mean = tl.atomic_add(mean_ptr + row, 0.0, sem='acquire')\n    rstd = tl.atomic_add(rstd_ptr + row, 0.0, sem='acquire')\n    for off in tl.range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        w = tl.load(w_ptr + idx)\n        b = tl.load(b_ptr + idx)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + base + idx, y)\n\ndef make_pers(S, BLOCK, warps):\n    sums = torch.zeros(B, dtype=torch.float32, device='cuda')\n    sqs = torch.zeros(B, dtype=torch.float32, device='cuda')\n    arr = torch.zeros(B, dtype=torch.int32, device='cuda')\n    flag = torch.zeros(B, dtype=torch.int32, device='cuda')\n    means = torch.zeros(B, dtype=torch.float32, device='cuda')\n    rstds = torch.zeros(B, dtype=torch.float32, device='cuda')\n    xf = x.view(-1)\n    st = {'epoch': 0}\n    def fn():\n        st['epoch'] += 1\n        y = torch.empty_like(x); yf = y.vie"]
[1449.137992, "i", "w(-1)\n        _ln_pers[(B*S,)](xf, yf, w0, b0, sums, sqs, arr, flag, means, rstds,\n                         N, eps, st['epoch'], B=B, S=S, BLOCK=BLOCK,\n                         num_warps=warps)\n        return y\n    return fn\n\nprops = torch.cuda.get_device_properties(0)\nprint('SMs', props.multi_processor_count, flush=True)\nfor S in [4, 8]:\n    chunk = N // S\n    for BLOCK in [2048, 4096, 8192, 16384]:\n        if chunk % BLOCK: continue\n        for wp in [4, 8, 16, 32]:\n            try:\n                fn = make_pers(S, BLOCK, wp)\n                y = fn()\n                torch.cuda.synchronize()\n                md = (y - ref).abs().max().item()\n                t = bench(fn)\n                print(f'pers S={S} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\n            except Exception as ex:\n                print(f'pers S={S} BLOCK={BLOCK} w={wp} FAIL {type(ex).__name__}: {ex}', flush=True)\nEOF\ngpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 | tail -30\n"]
[1449.138005, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[1449.13812, "o", "w(-1)\r\n        _ln_pers[(B*S,)](xf, yf, w0, b0, sums, sqs, arr, flag, means, rstds,\r\n                         N, eps, st['epoch'], B=B, S=S, BLOCK=BLOCK,\r\n                         num_warps=warps)\r\n        return y\r\n    return fn\r\n\r\nprops = torch.cu"]
[1449.138167, "o", "da.get_device_properties(0)\r\nprint('SMs', props.multi_processor_count, flush=True)\r\nfor S in [4, 8]:\r\n    chunk = N // S\r\n    for BLOCK in [2048, 4096, 8192, 16384]:\r\n        if chunk % BLOCK: continue\r\n        for wp in [4, 8, 16, 32]:\r\n           "]
[1449.138284, "o", " try:\r\n                fn = make_pers(S, BLOCK, wp)\r\n                y = fn()\r\n                torch.cuda.synchronize()\r\n                md = (y - ref).abs().max().item()\r\n                t = bench("]
[1449.138338, "o", "fn)\r\n                print(f'pers S={S} BLOCK={BLOCK"]
[1449.138357, "o", "} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\r\n            except Exception"]
[1449.138375, "o", " as ex:\r\n              "]
[1449.138393, "o", "  print(f'pers S={S} BLO"]
[1449.138406, "o", "CK={BLOCK} w={wp} FAIL {"]
[1449.138421, "o", "type(ex).__name__}: {ex}', flush=True"]
[1449.138439, "o", ")\r\nEOF"]
[1449.138451, "o", "\r\ngpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 "]
[1449.138466, "o", "| tail -30\r\n"]
[1449.138523, "o", "\u001b[?2004h> "]
[1449.138653, "o", "import numpy as np, torch, triton, triton.language as tl, torch.nn as nn\r\n\u001b[?2004l\r"]
[1449.138705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.138735, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.138747, "o", "> "]
[1449.138781, "o", "B, N = 16, 64*256*256\r\n\u001b[?2004l\r"]
[1449.138808, "o", "\u001b[?2004h> "]
[1449.138863, "o", "x = torch.rand(B, N, device='cuda')\r\n\u001b[?2004l\r"]
[1449.138895, "o", "\u001b[?2004h> "]
[1449.13892, "o", "eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.139036, "o", "w0 = torch.ones(N, device='cuda'); b0 = torch.zeros(N, device='cuda')\r\n\u001b[?2004l\r"]
[1449.139068, "o", "\u001b[?2004h> "]
[1449.139135, "o", "ref = nn.functional.layer_norm(x, (N,), w0, b0, eps)\r\n\u001b[?2004l\r"]
[1449.139166, "o", "\u001b[?2004h"]
[1449.139196, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.139227, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.139369, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r"]
[1449.139392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1449.139419, "o", "\u001b[?2004h> "]
[1449.139456, "o", "def bench(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.139486, "o", "> "]
[1449.139517, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1449.139549, "o", "\u001b[?2004h> "]
[1449.139619, "o", "    torch.cuda.synchronize(); torch.cuda.empty_cache()\r\n\u001b[?2004l\r"]
[1449.13965, "o", "\u001b[?2004h> "]
[1449.13968, "o", "    ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.139715, "o", "    for i in range(n+1):\r\n\u001b[?2004l\r"]
[1449.139746, "o", "\u001b[?2004h> "]
[1449.139788, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1449.139819, "o", "\u001b[?2004h> "]
[1449.139903, "o", "        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[1449.139934, "o", "\u001b[?2004h> "]
[1449.139964, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.139995, "o", "> "]
[1449.140073, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1449.140103, "o", "\u001b[?2004h> "]
[1449.140161, "o", "        if i: ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1449.140191, "o", "\u001b[?2004h> "]
[1449.14023, "o", "    return float(np.mean(ts))\r\n\u001b[?2004l\r"]
[1449.14026, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.140291, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1449.140322, "o", "\u001b[?2004h> "]
[1449.140443, "o", "def _ln_pers(x_ptr, y_ptr, w_ptr, b_ptr, sum_ptr, sq_ptr, arr_ptr, flag_ptr,\r\n\u001b[?2004l\r"]
[1449.140473, "o", "\u001b[?2004h> "]
[1449.140537, "o", "             mean_ptr, rstd_ptr,\r\n\u001b[?2004l\r"]
[1449.140587, "o", "\u001b[?2004h> "]
[1449.140604, "o", "             N, eps, epoch,\r\n\u001b[?2004l\r"]
[1449.140619, "o", "\u001b[?2004h> "]
[1449.140739, "o", "             B: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1449.140754, "o", "\u001b[?2004h> "]
[1449.140804, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1449.140821, "o", "\u001b[?2004h> "]
[1449.140857, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[1449.140874, "o", "\u001b[?2004h> "]
[1449.140912, "o", "    split = pid % S\r\n\u001b[?2004l\r"]
[1449.140928, "o", "\u001b[?2004h> "]
[1449.140964, "o", "    chunk = N // S\r\n\u001b[?2004l\r"]
[1449.140979, "o", "\u001b[?2004h> "]
[1449.141021, "o", "    rowbase = row * N\r\n\u001b[?2004l\r"]
[1449.141038, "o", "\u001b[?2004h> "]
[1449.1411, "o", "    base = rowbase + split * chunk\r\n\u001b[?2004l\r"]
[1449.141117, "o", "\u001b[?2004h> "]
[1449.141196, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1449.141213, "o", "\u001b[?2004h> "]
[1449.141294, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1449.14131, "o", "\u001b[?2004h> "]
[1449.141453, "o", "    for off in tl.range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[1449.141472, "o", "\u001b[?2004h> "]
[1449.141547, "o", "        idx = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1449.141561, "o", "\u001b[?2004h> "]
[1449.141618, "o", "        v = tl.load(x_ptr + idx)\r\n\u001b[?2004l\r"]
[1449.141632, "o", "\u001b[?2004h> "]
[1449.141667, "o", "        acc += v\r\n\u001b[?2004l\r"]
[1449.141701, "o", "\u001b[?2004h"]
[1449.14173, "o", ">         acc2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.14176, "o", "> "]
[1449.141791, "o", "    ps = tl.sum(acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.141829, "o", "    ps2 = tl.sum(acc2)\r\n\u001b[?2004l\r"]
[1449.14186, "o", "\u001b[?2004h> "]
[1449.141908, "o", "    tl.atomic_add(sum_ptr + row, ps)\r\n\u001b[?2004l\r"]
[1449.141939, "o", "\u001b[?2004h> "]
[1449.141988, "o", "    tl.atomic_add(sq_ptr + row, ps2)\r\n\u001b[?2004l\r"]
[1449.142019, "o", "\u001b[?2004h> "]
[1449.142097, "o", "    old = tl.atomic_add(arr_ptr + row, 1, sem='release')\r\n\u001b[?2004l\r"]
[1449.142113, "o", "\u001b[?2004h> "]
[1449.142162, "o", "    if (old + 1) % S == 0:\r\n\u001b[?2004l\r"]
[1449.14219, "o", "\u001b[?2004h> "]
[1449.142283, "o", "        total = tl.atomic_xchg(sum_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1449.142314, "o", "\u001b[?2004h> "]
[1449.142407, "o", "        total2 = tl.atomic_xchg(sq_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1449.142438, "o", "\u001b[?2004h> "]
[1449.142476, "o", "        mean = total / N\r\n\u001b[?2004l\r"]
[1449.142506, "o", "\u001b[?2004h> "]
[1449.142558, "o", "        var = total2 / N - mean * mean\r\n\u001b[?2004l\r"]
[1449.142588, "o", "\u001b[?2004h> "]
[1449.142641, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1449.142671, "o", "\u001b[?2004h> "]
[1449.142732, "o", "        tl.atomic_xchg(mean_ptr + row, mean)\r\n\u001b[?2004l\r"]
[1449.142763, "o", "\u001b[?2004h> "]
[1449.142823, "o", "        tl.atomic_xchg(rstd_ptr + row, rstd)\r\n\u001b[?2004l\r"]
[1449.142852, "o", "\u001b[?2004h> "]
[1449.14294, "o", "        tl.atomic_xchg(flag_ptr + row, epoch, sem='release')\r\n\u001b[?2004l\r"]
[1449.14297, "o", "\u001b[?2004h> "]
[1449.143048, "o", "    f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\r\n\u001b[?2004l\r"]
[1449.143079, "o", "\u001b[?2004h> "]
[1449.143109, "o", "    while f < epoch:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.143144, "o", "> "]
[1449.143216, "o", "        f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\r\n\u001b[?2004l\r"]
[1449.143248, "o", "\u001b[?2004h> "]
[1449.143332, "o", "    mean = tl.atomic_add(mean_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1449.143364, "o", "\u001b[?2004h> "]
[1449.143452, "o", "    rstd = tl.atomic_add(rstd_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1449.143481, "o", "\u001b[?2004h> "]
[1449.143538, "o", "    for off in tl.range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[1449.143573, "o", "\u001b[?2004h> "]
[1449.143621, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1449.143652, "o", "\u001b[?2004h> "]
[1449.143705, "o", "        v = tl.load(x_ptr + base + idx)\r\n\u001b[?2004l\r"]
[1449.143736, "o", "\u001b[?2004h> "]
[1449.143779, "o", "        w = tl.load(w_ptr + idx)\r\n\u001b[?2004l\r"]
[1449.143809, "o", "\u001b[?2004h> "]
[1449.143851, "o", "        b = tl.load(b_ptr + idx)\r\n\u001b[?2004l\r"]
[1449.143882, "o", "\u001b[?2004h> "]
[1449.143931, "o", "        y = (v - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[1449.143962, "o", "\u001b[?2004h> "]
[1449.144014, "o", "        tl.store(y_ptr + base + idx, y)\r\n\u001b[?2004l\r"]
[1449.144046, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.144109, "o", "def make_pers(S, BLOCK, warps):\r\n\u001b[?2004l\r"]
[1449.14414, "o", "\u001b[?2004h> "]
[1449.144233, "o", "    sums = torch.zeros(B, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[1449.144264, "o", "\u001b[?2004h> "]
[1449.144351, "o", "    sqs = torch.zeros(B, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[1449.14438, "o", "\u001b[?2004h> "]
[1449.144467, "o", "    arr = torch.zeros(B, dtype=torch.int32, device='cuda')\r\n\u001b[?2004l\r"]
[1449.144501, "o", "\u001b[?2004h> "]
[1449.14459, "o", "    flag = torch.zeros(B, dtype=torch.int32, device='cuda')\r\n\u001b[?2004l\r"]
[1449.144621, "o", "\u001b[?2004h> "]
[1449.144708, "o", "    means = torch.zeros(B, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[1449.14474, "o", "\u001b[?2004h> "]
[1449.144828, "o", "    rstds = torch.zeros(B, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[1449.144859, "o", "\u001b[?2004h> "]
[1449.14489, "o", "    xf = x.view(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.14492, "o", "> "]
[1449.144949, "o", "    st = {'epoch': 0}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.14498, "o", "    def fn():\r\n\u001b[?2004l\r"]
[1449.145012, "o", "\u001b[?2004h> "]
[1449.145044, "o", "        st['epoch'] += 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.145075, "o", "> "]
[1449.145134, "o", "        y = torch.empty_like(x); yf = y.view(-1)\r\n\u001b[?2004l\r"]
[1449.145165, "o", "\u001b[?2004h> "]
[1449.145275, "o", "        _ln_pers[(B*S,)](xf, yf, w0, b0, sums, sqs, arr, flag, means, rstds,\r\n\u001b[?2004l\r"]
[1449.145306, "o", "\u001b[?2004h> "]
[1449.145405, "o", "                         N, eps, st['epoch'], B=B, S=S, BLOCK=BLOCK,\r\n\u001b[?2004l\r"]
[1449.14544, "o", "\u001b[?2004h> "]
[1449.145497, "o", "                         num_warps=warps)\r\n\u001b[?2004l\r"]
[1449.145528, "o", "\u001b[?2004h> "]
[1449.145564, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.145595, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.145627, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.145699, "o", "props = torch.cuda.get_device_properties(0)\r\n\u001b[?2004l\r"]
[1449.14573, "o", "\u001b[?2004h> "]
[1449.145803, "o", "print('SMs', props.multi_processor_count, flush=True)\r\n\u001b[?2004l\r"]
[1449.145834, "o", "\u001b[?2004h> "]
[1449.145864, "o", "for S in [4, 8]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.145901, "o", "    chunk = N // S\r\n\u001b[?2004l\r"]
[1449.145932, "o", "\u001b[?2004h> "]
[1449.145989, "o", "    for BLOCK in [2048, 4096, 8192, 16384]:\r\n\u001b[?2004l\r"]
[1449.14602, "o", "\u001b[?2004h> "]
[1449.146065, "o", "        if chunk % BLOCK: continue\r\n\u001b[?2004l\r"]
[1449.146096, "o", "\u001b[?2004h> "]
[1449.146139, "o", "        for wp in [4, 8, 16, 32]:\r\n\u001b[?2004l\r"]
[1449.146169, "o", "\u001b[?2004h> "]
[1449.146199, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.146276, "o", "                fn = make_pers(S, BLOCK, wp)\r\n\u001b[?2004l\r"]
[1449.146307, "o", "\u001b[?2004h> "]
[1449.146338, "o", "                y = fn()\r\n\u001b[?2004l\r"]
[1449.146369, "o", "\u001b[?2004h> "]
[1449.146421, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1449.146441, "o", "\u001b[?2004h> "]
[1449.146534, "o", "                md = (y - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.146566, "o", "> "]
[1449.146598, "o", "                t = bench(fn)\r\n\u001b[?2004l\r"]
[1449.146629, "o", "\u001b[?2004h> "]
[1449.146791, "o", "                print(f'pers S={S} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1449.146856, "o", "            except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1449.146887, "o", "> "]
[1449.14704, "o", "                print(f'pers S={S} BLOCK={BLOCK} w={wp} FAIL {type(ex).__name__}: {ex}', flush=True)\r\n\u001b[?2004l\r"]
[1449.147071, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1449.148391, "o", "\u001b[?2004hroot@modal:/# "]
[1449.148534, "o", "gpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 | tail -30\r\n\u001b[?2004l\r"]
[1483.324973, "o", "pers S=4 BLOCK=2048 w=16 ms=8.0976 maxdiff=3.34e-06\r\npers S=4 BLOCK=2048 w=32 ms=7.9219 maxdiff=3.34e-06\r\npers S=4 BLOCK=4096 w=4 ms=10.7638 maxdiff=3.34e-06\r\npers S=4 BLOCK=4096 w=8 ms=9.1444 maxdiff=3.34e-06\r\npers S=4 BLOCK=4096 w=16 ms=8.5756 maxdiff=3.46e-06\r\npers S=4 BLOCK=4096 w=32 ms=8.0323 maxdiff=3.46e-06\r\npers S=4 BLOCK=8192 w=4 ms=15.9534 maxdiff=3.34e-06\r\npers S=4 BLOCK=8192 w=8 ms=10.6840 maxdiff=3.34e-06\r\npers S=4 BLOCK=8192 w=16 ms=8.8588 maxdiff=3.46e-06\r\npers S=4 BLOCK=8192 w=32 ms=8.7026 maxdiff=3.46e-06\r\npers S=4 BLOCK=16384 w=4 ms=36.8232 maxdiff=3.46e-06\r\npers S=4 BLOCK=16384 w=8 ms=15.8690 maxdiff=3.34e-06\r\npers S=4 BLOCK=16384 w=16 ms=10.8060 maxdiff=3.58e-06\r\npers S=4 BLOCK=16384 w=32 ms=8.9242 maxdiff=3.46e-06\r\npers S=8 BLOCK=2048 w=4 ms=10.3050 maxdiff=3.70e-06\r\npers S=8 BLOCK=2048 w=8 ms=8.7756 maxdiff=3.70e-06\r\npers S=8 BLOCK=2048 w=16 ms=11.5655 maxdiff=3.58e-06\r\npers S=8 BLOCK=2048 w=32 ms=7.9199 maxdiff=3.46e-06\r\npers S=8 BLOCK=4096 w=4 ms=12.6143 maxdiff=3.70e-06\r\npers S=8 BLOC"]
[1483.325034, "o", "K=4096 w=8 ms=10.1801 maxdiff=3.46e-06\r\npers S=8 BLOCK=4096 w=16 ms=8.6259 maxdiff=3.34e-06\r\npers S=8 BLOCK=4096 w=32 ms=8.3821 maxdiff=3.81e-06\r\npers S=8 BLOCK=8192 w=4 ms=19.5570 maxdiff=3.81e-06\r\npers S=8 BLOCK=8192 w=8 ms=12.7788 maxdiff=3.70e-06\r\npers S=8 BLOCK=8192 w=16 ms=9.9864 maxdiff=3.34e-06\r\npers S=8 BLOCK=8192 w=32 ms=8.7041 maxdiff=2.98e-06\r\npers S=8 BLOCK=16384 w=4 ms=45.0578 maxdiff=3.70e-06\r\npers S=8 BLOCK=16384 w=8 ms=19.3781 maxdiff=3.81e-06\r\npers S=8 BLOCK=16384 w=16 ms=12.4406 maxdiff=3.22e-06\r\npers S=8 BLOCK=16384 w=32 ms=9.7715 maxdiff=2.98e-06\r\n"]
[1483.32517, "o", "\u001b[?2004hroot@modal:/# "]
[1518.65283, "i", "cat > /workspace/bench3.py << 'EOF'\nimport numpy as np, torch, triton, triton.language as tl, torch.nn as nn\n\ntorch.manual_seed(0)\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device='cuda')\neps = 1e-5\nw0 = torch.ones(N, device='cuda'); b0 = torch.zeros(N, device='cuda')\nref = nn.functional.layer_norm(x, (N,), w0, b0, eps)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); torch.cuda.empty_cache()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if i: ts.append(s.elapsed_time(e))\n    return float(np.mean(ts))\n\n@triton.jit\ndef _stats(x_ptr, psum_ptr, psq_ptr, N,\n           S: tl.constexpr, BLOCK: tl.constexpr, CM: tl.constexpr, NS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    split = pid % S\n  "]
[1518.652878, "i", "  chunk = N // S\n    base = row * N + split * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, chunk, BLOCK, num_stages=NS):\n        idx = base + off + tl.arange(0, BLOCK)\n        if CM == 1:\n            v = tl.load(x_ptr + idx, cache_modifier='.cg')\n        else:\n            v = tl.load(x_ptr + idx)\n        acc += v\n        acc2 += v * v\n    tl.store(psum_ptr + pid, tl.sum(acc))\n    tl.store(psq_ptr + pid, tl.sum(acc2))\n\n@triton.jit\ndef _norm(x_ptr, y_ptr, w_ptr, b_ptr, psum_ptr, psq_ptr, N, eps,\n          S: tl.constexpr, SP: tl.constexpr, BLOCK: tl.constexpr,\n          CM: tl.constexpr, NS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    split = pid % S\n    offs = tl.arange(0, SP)\n    mask = offs < S\n    s = tl.load(psum_ptr + row * S + offs, mask=mask, other=0.0)\n    s2 = tl.load(psq_ptr + row * S + offs, mask=mask, other=0.0)\n    total = tl.sum(s)\n    total2 = tl.sum(s2)\n    mean = total / N\n    var = total2 / N"]
[1518.65292, "i", " - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    chunk = N // S\n    base = row * N + split * chunk\n    for off in tl.range(0, chunk, BLOCK, num_stages=NS):\n        idx = off + tl.arange(0, BLOCK)\n        if CM == 1:\n            v = tl.load(x_ptr + base + idx, cache_modifier='.cg')\n            w = tl.load(w_ptr + idx, cache_modifier='.cg')\n            b = tl.load(b_ptr + idx, cache_modifier='.cg')\n        else:\n            v = tl.load(x_ptr + base + idx)\n            w = tl.load(w_ptr + idx)\n            b = tl.load(b_ptr + idx)\n        y = (v - mean) * rstd * w + b\n        if CM == 1:\n            tl.store(y_ptr + base + idx, y, cache_modifier='.cs')\n        else:\n            tl.store(y_ptr + base + idx, y)\n\ndef make_two(S, BLOCK, warps, CM, NS):\n    psum = torch.empty(B*S, device='cuda'); psq = torch.empty(B*S, device='cuda')\n    xf = x.view(-1)\n    def fn():\n        y = torch.empty_like(x); yf = y.view(-1)\n        grid = (B*S,)\n        _stats[grid](xf, psum, psq, N, S=S, BLOCK=BLOCK, CM=CM, NS=NS, num_wa"]
[1518.652931, "i", "rps=warps)\n        _norm[grid](xf, yf, w0, b0, psum, psq, N, eps, S=S, SP=triton.next_power_of_2(S), BLOCK=BLOCK, CM=CM, NS=NS, num_warps=warps)\n        return y\n    return fn\n\nbest = (1e9, None)\nfor CM in [0, 1]:\n    for NS in [1, 2, 4]:\n        for S in [64, 128, 256]:\n            for BLOCK in [4096, 8192]:\n                if N % (S*BLOCK): continue\n                for wp in [8, 16]:\n                    try:\n                        fn = make_two(S, BLOCK, wp, CM, NS)\n                        y = fn(); torch.cuda.synchronize()\n                        md = (y-ref).abs().max().item()\n                        t = bench(fn)\n                        if t < best[0]: best = (t, (CM,NS,S,BLOCK,wp))\n                        print(f'CM={CM} NS={NS} S={S} B={BLOCK} w={wp} ms={t:.4f} md={md:.1e}', flush=True)\n                    except Exception as ex:\n                        print(f'CM={CM} NS={NS} S={S} B={BLOCK} w={wp} FAIL {type(ex).__name__}', flush=True)\nprint('BEST', best, flush=True)\nEOF\ngpu run --timeout 600 -- pyt"]
[1518.652938, "i", "hon3 /workspace/bench3.py 2>&1 | tail -40\n"]
