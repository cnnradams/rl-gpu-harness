[1761.879919, "o", "\u001b[?2004h> "]
[1761.880024, "o", "print('maxdiff:', (y.view(B,N)-ref).abs().max().item(), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.880056, "o", "> "]
[1761.880167, "o", "print('cuda ext ms:', bench(lambda: m(x.view(16,64,256,256))), flush=True)\r\n\u001b[?2004l\r"]
