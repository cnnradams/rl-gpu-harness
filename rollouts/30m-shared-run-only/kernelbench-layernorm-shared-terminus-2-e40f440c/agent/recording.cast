[36.224077, "o", " = backend.lower()\r\n514:        if backend_lower in [\"triton\", \"tilelang\", \"cute\"]:\r\n515:            # Use tempfile approach for triton, tilelang, and cute\r\n517:            ModelNew, tempfile = load_custom_model_with_tempfile(\r\n518:                custom_model_src, entry_point=\"ModelNew\"\r\n521:            # Default CUDA backend\r\n522:            ModelNew = load_custom_model(custom_model_src, context, build_dir)\r\n546:    # Check if ModelNew was successfully loaded (load_custom_model returns None on syntax errors)\r\n547:    if ModelNew is None:\r\n549:            \"Failed to load custom model: Syntax error or ModelNew not found in generated code. Record as compilation failure.\"\r\n552:        metadata[\"compilation_error\"] = \"Syntax error in custom generated code or ModelNew not found\"\r\n561:            set_seed(seed_num)  # set seed for reproducible weights\r\n562:            custom_model = ModelNew(*init_inputs)\r\n590:            get_inputs,\r\n596:            backend=backend,\r\n615:                set_seed(seed_num)\r\n616:  "]
