[1758.949559, "o", "\u001b[?2004h> "]
[1758.949605, "o", "        float4 wv = w[colbase + i];\r\n\u001b[?2004l\r"]
[1758.949632, "o", "\u001b[?2004h> "]
[1758.949682, "o", "        float4 bv = b[colbase + i];\r\n\u001b[?2004l\r"]
[1758.949719, "o", "\u001b[?2004h> "]
[1758.949752, "o", "        float4 o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.949836, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[1758.949869, "o", "\u001b[?2004h> "]
[1758.949934, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[1758.949967, "o", "\u001b[?2004h> "]
[1758.950033, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[1758.950066, "o", "\u001b[?2004h> "]
[1758.95013, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[1758.950163, "o", "\u001b[?2004h> "]
[1758.950195, "o", "        y[base + i] = o;\r\n\u001b[?2004l\r"]
[1758.950228, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.95026, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1758.950292, "o", "\u001b[?2004h> "]
[1758.950407, "o", "torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b,\r\n\u001b[?2004l\r"]
[1758.950439, "o", "\u001b[?2004h> "]
[1758.950507, "o", "                         double eps, int64_t S) {\r\n\u001b[?2004l\r"]
[1758.95054, "o", "\u001b[?2004h> "]
[1758.950584, "o", "    auto y = torch::empty_like(x);\r\n\u001b[?2004l\r"]
[1758.950616, "o", "\u001b[?2004h> "]
[1758.950649, "o", "    long N = w.numel();\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.950681, "o", "> "]
[1758.950719, "o", "    long total = x.numel();\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.950751, "o", "> "]
[1758.950784, "o", "    int B = (int)(total / N);\r\n\u001b[?2004l\r"]
[1758.950814, "o", "\u001b[?2004h> "]
[1758.950846, "o", "    long chunk = N / S;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.950879, "o", "> "]
[1758.950911, "o", "    long chunk4 = chunk / 4;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.950944, "o", "> "]
[1758.950977, "o", "    int grid = B * (int)S;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.95101, "o", "> "]
[1758.95107, "o", "    auto psum = torch::empty({grid}, x.options());\r\n\u001b[?2004l\r"]
[1758.951103, "o", "\u001b[?2004h> "]
[1758.95117, "o", "    auto psq = torch::empty({grid}, x.options());\r\n\u001b[?2004l\r"]
[1758.951202, "o", "\u001b[?2004h> "]
[1758.951273, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[1758.951306, "o", "\u001b[?2004h> "]
[1758.951374, "o", "    ln_stats_kernel<<<grid, THREADS, 0, stream>>>(\r\n\u001b[?2004l\r"]
[1758.951406, "o", "\u001b[?2004h> "]
[1758.951493, "o", "        reinterpret_cast<const float4*>(x.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1758.951525, "o", "\u001b[?2004h> "]
[1758.951614, "o", "        psum.data_ptr<float>(), psq.data_ptr<float>(), chunk4);\r\n\u001b[?2004l\r"]
[1758.951647, "o", "\u001b[?2004h> "]
[1758.95172, "o", "    ln_norm_kernel<<<grid, THREADS, 0, stream>>>(\r\n\u001b[?2004l\r"]
[1758.951752, "o", "\u001b[?2004h> "]
[1758.951838, "o", "        reinterpret_cast<const float4*>(x.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1758.951869, "o", "\u001b[?2004h> "]
[1758.951947, "o", "        reinterpret_cast<float4*>(y.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1758.951978, "o", "\u001b[?2004h> "]
[1758.952065, "o", "        reinterpret_cast<const float4*>(w.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1758.952097, "o", "\u001b[?2004h> "]
[1758.952191, "o", "        reinterpret_cast<const float4*>(b.data_ptr<float>()),\r\n\u001b[?2004l\r"]
[1758.952223, "o", "\u001b[?2004h> "]
[1758.952298, "o", "        psum.data_ptr<float>(), psq.data_ptr<float>(),\r\n\u001b[?2004l\r"]
[1758.952331, "o", "\u001b[?2004h> "]
[1758.952382, "o", "        chunk4, N, (float)eps, (int)S);\r\n\u001b[?2004l\r"]
[1758.952415, "o", "\u001b[?2004h> "]
[1758.952448, "o", "    return y;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1758.95248, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[1758.952526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.952758, "o", "_CPP_SRC = '#include <torch/extension.h>\\ntorch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, double eps, int64_t S);'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.952795, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.952828, "o", "_ext = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.95286, "o", "> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.952954, "o", "    from torch.utils.cpp_extension import load_inline\r\n\u001b[?2004l\r"]
[1758.952986, "o", "\u001b[?2004h> "]
[1758.953055, "o", "    os.makedirs('/workspace/ln_ext', exist_ok=True)\r\n\u001b[?2004l\r"]
[1758.953087, "o", "\u001b[?2004h> "]
[1758.953117, "o", "    _ext = load_inline(\r\n\u001b[?2004l\r"]
[1758.95315, "o", "\u001b[?2004h> "]
[1758.953182, "o", "        name='ln_fast_ext',\r\n\u001b[?2004l\r"]
[1758.953213, "o", "\u001b[?2004h> "]
[1758.953245, "o", "        cpp_sources=[_CPP_SRC],\r\n\u001b[?2004l\r"]
[1758.953277, "o", "\u001b[?2004h> "]
[1758.953387, "o", "        cuda_sources=['#include <ATen/cuda/CUDAContext.h>\\n' + _CUDA_SRC],\r\n\u001b[?2004l\r"]
[1758.953423, "o", "\u001b[?2004h> "]
[1758.953462, "o", "        functions=['ln_forward'],\r\n\u001b[?2004l\r"]
[1758.953496, "o", "\u001b[?2004h> "]
[1758.953538, "o", "        extra_cuda_cflags=['-O3'],\r\n\u001b[?2004l\r"]
[1758.953571, "o", "\u001b[?2004h> "]
[1758.953629, "o", "        build_directory='/workspace/ln_ext',\r\n\u001b[?2004l\r"]
[1758.953661, "o", "\u001b[?2004h> "]
[1758.953695, "o", "        verbose=False,\r\n\u001b[?2004l\r"]
[1758.953728, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.95376, "o", "> "]
[1758.953793, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.953824, "o", "    _ext = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.953857, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1758.953889, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1758.953928, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1758.95396, "o", "\u001b[?2004h> "]
[1758.954026, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[1758.954058, "o", "\u001b[?2004h> "]
[1758.954091, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1758.954124, "o", "\u001b[?2004h> "]
[1758.954184, "o", "        if isinstance(normalized_shape, int):\r\n\u001b[?2004l\r"]
[1758.954216, "o", "\u001b[?2004h> "]
[1758.954285, "o", "            normalized_shape = (normalized_shape,)\r\n\u001b[?2004l\r"]
[1758.954318, "o", "\u001b[?2004h> "]
[1758.954395, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[1758.954428, "o", "\u001b[?2004h> "]
[1758.95446, "o", "        self.N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.954529, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[1758.954559, "o", "\u001b[?2004h> "]
[1758.954591, "o", "            self.N *= d\r\n\u001b[?2004l\r"]
[1758.954624, "o", "\u001b[?2004h> "]
[1758.954656, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.954689, "o", "> "]
[1758.954781, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[1758.954813, "o", "\u001b[?2004h> "]
[1758.954913, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[1758.954945, "o", "\u001b[?2004h> "]
[1758.954977, "o", "        self.S = 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[1758.95501, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1758.955096, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[1758.955127, "o", "\u001b[?2004h> "]
[1758.95522, "o", "        if (_ext is not None and x.is_cuda and x.is_contiguous()\r\n\u001b[?2004l\r"]
[1758.955251, "o", "\u001b[?2004h> "]
[1758.955312, "o", "                and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1758.955344, "o", "\u001b[?2004h> "]
[1758.95541, "o", "                and self.N % (4 * self.S) == 0):\r\n\u001b[?2004l\r"]
[1758.955443, "o", "\u001b[?2004h> "]
[1758.955556, "o", "            return _ext.ln_forward(x, self.weight, self.bias, self.eps, self.S)\r\n\u001b[?2004l\r"]
[1758.955588, "o", "\u001b[?2004h> "]
[1758.955643, "o", "        return nn.functional.layer_norm(\r\n\u001b[?2004l\r"]
[1758.955674, "o", "\u001b[?2004h> "]
[1758.955785, "o", "            x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[1758.955819, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1758.957351, "o", "\u001b[?2004hroot@modal:/# "]
[1758.957493, "o", "python3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[1758.967138, "o", "ok\r\n"]
[1758.969088, "o", "\u001b[?2004hroot@modal:/# "]
[1761.877419, "i", "cat > /workspace/bench4.py << 'EOF'\nimport numpy as np, torch, torch.nn as nn, sys, time\nsys.path.insert(0, '/workspace')\nt0 = time.time()\nfrom solution import ModelNew, _ext\nprint('import+compile s:', time.time()-t0, 'ext:', _ext is not None, flush=True)\n\ntorch.manual_seed(0)\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device='cuda')\neps = 1e-5\nref = nn.functional.layer_norm(x, (N,), torch.ones(N, device='cuda'), torch.zeros(N, device='cuda'), eps)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); torch.cuda.empty_cache()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if i: ts.append(s.elapsed_time(e))\n    return float(np.mean(ts))\n\nm = ModelNew((64,256,256)).cuda()\ny = m(x.view(16,64,256,256))\ntorch.cuda.sy"]
[1761.877728, "i", "nchronize()\nprint('maxdiff:', (y.view(B,N)-ref).abs().max().item(), flush=True)\nprint('cuda ext ms:', bench(lambda: m(x.view(16,64,256,256))), flush=True)\nEOF\ngpu run --timeout 600 -- python3 /workspace/bench4.py 2>&1 | tail -10\n"]
[1761.877764, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np, torch, torch.nn as nn, sys, time\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.877812, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[1761.877842, "o", "\u001b[?2004h> "]
[1761.877868, "o", "t0 = time.time()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.877894, "o", "> "]
[1761.877939, "o", "from solution import ModelNew, _ext\r\n\u001b[?2004l\r"]
[1761.877973, "o", "\u001b[?2004h> "]
[1761.878094, "o", "print('import+compile s:', time.time()-t0, 'ext:', _ext is not None, flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.878125, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.87818, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.878241, "o", "B, N = 16, 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h"]
[1761.878274, "o", "> "]
[1761.878311, "o", "x = torch.rand(B, N, device='cuda')\r\n\u001b[?2004l\r"]
[1761.878343, "o", "\u001b[?2004h> "]
[1761.878374, "o", "eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.878558, "o", "ref = nn.functional.layer_norm(x, (N,), torch.ones(N, device='cuda'), torch.zeros(N, device='cuda'), eps)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1761.878603, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1761.878636, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.878796, "o", "    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.878829, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1761.878862, "o", "def bench(fn, n=20):\r\n\u001b[?2004l\r"]
[1761.878894, "o", "\u001b[?2004h> "]
[1761.878925, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1761.878956, "o", "\u001b[?2004h> "]
[1761.87904, "o", "    torch.cuda.synchronize(); torch.cuda.empty_cache()\r\n\u001b[?2004l\r"]
[1761.879072, "o", "\u001b[?2004h>     ts=[]\r\n\u001b[?2004l\r"]
[1761.879104, "o", "\u001b[?2004h> "]
[1761.879136, "o", "    for i in range(n+1):\r\n\u001b[?2004l\r"]
[1761.879169, "o", "\u001b[?2004h> "]
[1761.879209, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1761.87924, "o", "\u001b[?2004h> "]
[1761.879323, "o", "        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[1761.879354, "o", "\u001b[?2004h> "]
[1761.879388, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h> "]
