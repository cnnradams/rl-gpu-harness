[839.782998, "o", "\u001b[?2004hroot@modal:/# "]
[915.976182, "i", "sed -i 's/for G in \\[props.multi_processor_count, 2\\*props.multi_processor_count\\]:/for G in [64, 128]:/' /workspace/bench2.py && gpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 | tail -30\n"]
[915.976682, "o", "sed -i 's/for G in \\[props.multi_processor_count, 2\\*props.multi_processor_count\\]:/for G in [64, 128]:/' /workspace/bench2.py && gpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 | tail -30\r\n\u001b[?2004l\r"]
[929.043617, "o", "request ID: e668584be7e34a4aa6a3292ec47b059d\r\nbox: sb-iWC7hd9IC2vHyzJv9oRNtT\r\ncommand: 2953133773174ae7a7559a596d18c8a8\r\nSMs 132\r\npers G=64 BLOCK=2048 w=4 ms=0.0744 maxdiff=1.73e+00\r\npers G=64 BLOCK=2048 w=8 ms=0.0694 maxdiff=1.73e+00\r\npers G=64 BLOCK=2048 w=16 ms=0.0561 maxdiff=1.73e+00\r\npers G=64 BLOCK=4096 w=4 ms=0.0542 maxdiff=1.73e+00\r\npers G=64 BLOCK=4096 w=8 ms=0.0490 maxdiff=1.73e+00\r\npers G=64 BLOCK=4096 w=16 ms=0.0469 maxdiff=1.73e+00\r\npers G=64 BLOCK=8192 w=4 ms=0.0463 maxdiff=1.73e+00\r\npers G=64 BLOCK=8192 w=8 ms=0.0383 maxdiff=1.73e+00\r\npers G=64 BLOCK=8192 w=16 ms=0.0352 maxdiff=1.73e+00\r\npers G=128 BLOCK=2048 w=4 ms=0.0457 maxdiff=1.73e+00\r\npers G=128 BLOCK=2048 w=8 ms=0.0440 maxdiff=1.73e+00\r\npers G=128 BLOCK=2048 w=16 ms=0.0367 maxdiff=1.73e+00\r\npers G=128 BLOCK=4096 w=4 ms=0.0351 maxdiff=1.73e+00\r\npers G=128 BLOCK=4096 w=8 ms=0.0325 maxdiff=1.73e+00\r\npers G=128 BLOCK=4096 w=16 ms=0.0321 maxdiff=1.73e+00\r\npers G=128 BLOCK=8192 w=4 ms=0.0303 maxdiff=1.73e+00\r\npers G=128 BLOCK=8192 w=8 ms=0.027"]
[929.043688, "o", "4 maxdiff=1.73e+00\r\npers G=128 BLOCK=8192 w=16 ms=0.0263 maxdiff=1.73e+00\r\n"]
[929.043862, "o", "\u001b[?2004hroot@modal:/# "]
[1009.971371, "i", "cat > /workspace/bench2.py << 'EOF'\nimport numpy as np, torch, triton, triton.language as tl, torch.nn as nn\n\ntorch.manual_seed(0)\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device='cuda')\neps = 1e-5\nw0 = torch.ones(N, device='cuda'); b0 = torch.zeros(N, device='cuda')\nref = nn.functional.layer_norm(x, (N,), w0, b0, eps)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); torch.cuda.empty_cache()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if i: ts.append(s.elapsed_time(e))\n    return float(np.mean(ts))\n\n@triton.jit\ndef _ln_pers(x_ptr, y_ptr, w_ptr, b_ptr, sum_ptr, sq_ptr, arr_ptr, flag_ptr,\n             N, eps, epoch,\n             B: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program"]
[1009.971416, "i", "_id(0)\n    row = pid // S\n    split = pid % S\n    chunk = N // S\n    rowbase = row * N\n    base = rowbase + split * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, chunk, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        acc += v\n        acc2 += v * v\n    ps = tl.sum(acc)\n    ps2 = tl.sum(acc2)\n    tl.atomic_add(sum_ptr + row, ps)\n    tl.atomic_add(sq_ptr + row, ps2)\n    old = tl.atomic_add(arr_ptr + row, 1, sem='release')\n    if old == S - 1:\n        total = tl.atomic_add(sum_ptr + row, 0.0, sem='acquire')\n        total2 = tl.atomic_add(sq_ptr + row, 0.0, sem='acquire')\n        mean = total / N\n        var = total2 / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.atomic_xchg(sum_ptr + row, mean)\n        tl.atomic_xchg(sq_ptr + row, rstd)\n        tl.atomic_xchg(flag_ptr + row, epoch, sem='release')\n    f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\n    while f < "]
[1009.971426, "i", "epoch:\n        f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\n    mean = tl.atomic_add(sum_ptr + row, 0.0, sem='acquire')\n    rstd = tl.atomic_add(sq_ptr + row, 0.0, sem='acquire')\n    for off in tl.range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        w = tl.load(w_ptr + idx)\n        b = tl.load(b_ptr + idx)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + base + idx, y)\n\nstate = {}\n\ndef make_pers(S, BLOCK, warps):\n    sums = torch.zeros(B, dtype=torch.float32, device='cuda')\n    sqs = torch.zeros(B, dtype=torch.float32, device='cuda')\n    arr = torch.zeros(B, dtype=torch.int32, device='cuda')\n    flag = torch.zeros(B, dtype=torch.int32, device='cuda')\n    xf = x.view(-1)\n    st = {'epoch': 0}\n    def fn():\n        st['epoch'] += 1\n        y = torch.empty_like(x); yf = y.view(-1)\n        _ln_pers[(B*S,)](xf, yf, w0, b0, sums, sqs, arr, flag,\n                         N, eps, st['epoch'], B=B, S=S, BLOCK=BLOCK,\n                       "]
[1009.971613, "i", "  num_warps=warps)\n        return y\n    return fn\n\nprops = torch.cuda.get_device_properties(0)\nprint('SMs', props.multi_processor_count, flush=True)\nfor S in [4, 8]:\n    chunk = N // S\n    for BLOCK in [2048, 4096, 8192, 16384]:\n        if chunk % BLOCK: continue\n        for wp in [4, 8, 16, 32]:\n            try:\n                fn = make_pers(S, BLOCK, wp)\n                y = fn()\n                torch.cuda.synchronize()\n                md = (y - ref).abs().max().item()\n                t = bench(fn)\n                print(f'pers S={S} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\n            except Exception as ex:\n                print(f'pers S={S} BLOCK={BLOCK} w={wp} FAIL {type(ex).__name__}: {ex}', flush=True)\nEOF\ngpu run --timeout 400 -- python3 /workspace/bench2.py 2>&1 | tail -30\n"]
