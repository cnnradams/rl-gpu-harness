[830.548379, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[830.548411, "o", "\u001b[?2004h> "]
[830.548517, "o", "        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.548556, "o", "> "]
[830.548573, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.548622, "o", "> "]
[830.548686, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[830.548715, "o", "\u001b[?2004h> "]
[830.548774, "o", "        if i: ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[830.548808, "o", "\u001b[?2004h> "]
[830.548834, "o", "    return float(np.mean(ts))\r\n\u001b[?2004l\r"]
[830.548864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[830.54889, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[830.548918, "o", "\u001b[?2004h> "]
[830.54902, "o", "def _ln_persistent(x_ptr, y_ptr, w_ptr, b_ptr, cnt_ptr, N, eps,\r\n\u001b[?2004l\r"]
[830.549048, "o", "\u001b[?2004h> "]
[830.549165, "o", "                   G, SPP: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr):\r\n\u001b[?2004l\r"]
[830.549203, "o", "\u001b[?2004h> "]
[830.54923, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.549263, "o", "> "]
[830.549289, "o", "    chunk = N // G\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.549337, "o", "    rowbase = pid * chunk\r\n\u001b[?2004l\r"]
[830.549364, "o", "\u001b[?2004h> "]
[830.549429, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[830.549456, "o", "\u001b[?2004h> "]
[830.549525, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[830.549558, "o", "\u001b[?2004h> "]
[830.549608, "o", "    for off in tl.range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[830.549635, "o", "\u001b[?2004h> "]
[830.549705, "o", "        idx = rowbase + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[830.549737, "o", "\u001b[?2004h> "]
[830.549771, "o", "        v = tl.load(x_ptr + idx)\r\n\u001b[?2004l\r"]
[830.549806, "o", "\u001b[?2004h> "]
[830.549838, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.54987, "o", "> "]
[830.549902, "o", "        acc2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.549933, "o", "    ps = tl.sum(acc)\r\n\u001b[?2004l\r"]
[830.549969, "o", "\u001b[?2004h> "]
[830.549999, "o", "    ps2 = tl.sum(acc2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.550028, "o", "> "]
[830.55006, "o", "    tl.atomic_add(cnt_ptr + 1, ps)\r\n\u001b[?2004l\r"]
[830.550092, "o", "\u001b[?2004h> "]
[830.550139, "o", "    tl.atomic_add(cnt_ptr + 2, ps2)\r\n\u001b[?2004l\r"]
[830.55017, "o", "\u001b[?2004h> "]
[830.550204, "o", "    tl.debug_barrier()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.550277, "o", "    myepoch = tl.atomic_add(cnt_ptr, 1) + 1\r\n\u001b[?2004l\r"]
[830.550309, "o", "\u001b[?2004h> "]
[830.550336, "o", "    epoch = myepoch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.550375, "o", "    while epoch < G:\r\n\u001b[?2004l\r"]
[830.550406, "o", "\u001b[?2004h> "]
[830.550458, "o", "        epoch = tl.atomic_add(cnt_ptr, 0)\r\n\u001b[?2004l\r"]
[830.55049, "o", "\u001b[?2004h> "]
[830.550545, "o", "    total = tl.atomic_add(cnt_ptr + 1, 0.0)\r\n\u001b[?2004l\r"]
[830.550575, "o", "\u001b[?2004h> "]
[830.550632, "o", "    total2 = tl.atomic_add(cnt_ptr + 2, 0.0)\r\n\u001b[?2004l\r"]
[830.550663, "o", "\u001b[?2004h> "]
[830.550694, "o", "    mean = total / N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.550754, "o", "    var = total2 / N - mean * mean\r\n\u001b[?2004l\r"]
[830.550786, "o", "\u001b[?2004h> "]
[830.550828, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[830.550859, "o", "\u001b[?2004h> "]
[830.550911, "o", "    for off in tl.range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[830.550943, "o", "\u001b[?2004h> "]
[830.550995, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[830.551025, "o", "\u001b[?2004h> "]
[830.55108, "o", "        v = tl.load(x_ptr + rowbase + idx)\r\n\u001b[?2004l\r"]
[830.551109, "o", "\u001b[?2004h> "]
[830.551149, "o", "        w = tl.load(w_ptr + idx)\r\n\u001b[?2004l\r"]
[830.551178, "o", "\u001b[?2004h> "]
[830.55122, "o", "        b = tl.load(b_ptr + idx)\r\n\u001b[?2004l\r"]
[830.551253, "o", "\u001b[?2004h> "]
[830.551296, "o", "        y = (v - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[830.551325, "o", "\u001b[?2004h> "]
[830.55138, "o", "        tl.store(y_ptr + rowbase + idx, y)\r\n\u001b[?2004l\r"]
[830.551412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.551465, "o", "def make_pers(G, BLOCK, warps):\r\n\u001b[?2004l\r"]
[830.551497, "o", "\u001b[?2004h> "]
[830.551581, "o", "    cnt = torch.zeros(4, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.551612, "o", "> "]
[830.551643, "o", "    xf = x.view(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.551675, "o", "    def fn():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.551763, "o", "        y = torch.empty_like(x); yf = y.view(-1)\r\n\u001b[?2004l\r"]
[830.551795, "o", "\u001b[?2004h> "]
[830.551875, "o", "        _ln_persistent[(G,)](xf, yf, w0, b0, cnt, N, eps, G,\r\n\u001b[?2004l\r"]
[830.551908, "o", "\u001b[?2004h> "]
[830.55201, "o", "                             SPP=triton.next_power_of_2(G), BLOCK=BLOCK,\r\n\u001b[?2004l\r"]
[830.552042, "o", "\u001b[?2004h> "]
[830.552125, "o", "                             NB=BLOCK//1024, num_warps=warps)\r\n\u001b[?2004l\r"]
[830.552154, "o", "\u001b[?2004h> "]
[830.552185, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.552217, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.552248, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.552315, "o", "props = torch.cuda.get_device_properties(0)\r\n\u001b[?2004l\r"]
[830.552344, "o", "\u001b[?2004h> "]
[830.552418, "o", "print('SMs', props.multi_processor_count, flush=True)\r\n\u001b[?2004l\r"]
[830.55245, "o", "\u001b[?2004h> "]
[830.552554, "o", "for G in [props.multi_processor_count, 2*props.multi_processor_count]:\r\n\u001b[?2004l\r"]
[830.552587, "o", "\u001b[?2004h> "]
[830.552619, "o", "    if N % G: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.55265, "o", "> "]
[830.552682, "o", "    chunk = N // G\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.552737, "o", "    for BLOCK in [2048, 4096, 8192]:\r\n\u001b[?2004l\r"]
[830.552768, "o", "\u001b[?2004h> "]
[830.552809, "o", "        if chunk % BLOCK: continue\r\n\u001b[?2004l\r"]
[830.55284, "o", "\u001b[?2004h> "]
[830.552872, "o", "        for wp in [4, 8, 16]:\r\n\u001b[?2004l\r"]
[830.552904, "o", "\u001b[?2004h> "]
[830.552935, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.553011, "o", "                fn = make_pers(G, BLOCK, wp)\r\n\u001b[?2004l\r"]
[830.553042, "o", "\u001b[?2004h> "]
[830.553071, "o", "                y = fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[830.553101, "o", "> "]
[830.55315, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[830.553184, "o", "\u001b[?2004h> "]
[830.553246, "o", "                md = (y - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[830.553278, "o", "\u001b[?2004h> "]
[830.553309, "o", "                t = bench(fn)\r\n\u001b[?2004l\r"]
[830.55334, "o", "\u001b[?2004h> "]
[830.553481, "o", "                print(f'pers G={G} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\r\n\u001b[?2004l\r"]
[830.553512, "o", "\u001b[?2004h> "]
[830.553562, "o", "            except Exception as ex:\r\n\u001b[?2004l\r"]
[830.553594, "o", "\u001b[?2004h> "]
[830.553741, "o", "                print(f'pers G={G} BLOCK={BLOCK} w={wp} FAIL {type(ex).__name__} {ex}', flush=True)\r\n\u001b[?2004l\r"]
[830.553773, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[830.555259, "o", "\u001b[?2004hroot@modal:/# "]
[830.555392, "o", "gpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 | tail -30\r\n\u001b[?2004l\r"]
