[830.546913, "i", "cat > /workspace/bench2.py << 'EOF'\nimport numpy as np, torch, triton, triton.language as tl, torch.nn as nn\n\ntorch.manual_seed(0)\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device='cuda')\neps = 1e-5\nw0 = torch.ones(N, device='cuda'); b0 = torch.zeros(N, device='cuda')\nref = nn.functional.layer_norm(x, (N,), w0, b0, eps)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); torch.cuda.empty_cache()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if i: ts.append(s.elapsed_time(e))\n    return float(np.mean(ts))\n\n@triton.jit\ndef _ln_persistent(x_ptr, y_ptr, w_ptr, b_ptr, cnt_ptr, N, eps,\n                   G, SPP: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr):\n    pid = tl.program_id(0)\n    chunk = N // G\n   "]
[830.547118, "i", " rowbase = pid * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, chunk, BLOCK):\n        idx = rowbase + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        acc += v\n        acc2 += v * v\n    ps = tl.sum(acc)\n    ps2 = tl.sum(acc2)\n    tl.atomic_add(cnt_ptr + 1, ps)\n    tl.atomic_add(cnt_ptr + 2, ps2)\n    tl.debug_barrier()\n    myepoch = tl.atomic_add(cnt_ptr, 1) + 1\n    epoch = myepoch\n    while epoch < G:\n        epoch = tl.atomic_add(cnt_ptr, 0)\n    total = tl.atomic_add(cnt_ptr + 1, 0.0)\n    total2 = tl.atomic_add(cnt_ptr + 2, 0.0)\n    mean = total / N\n    var = total2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for off in tl.range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + rowbase + idx)\n        w = tl.load(w_ptr + idx)\n        b = tl.load(b_ptr + idx)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + rowbase + idx, y)\n\ndef make_pers(G, BLOCK, w"]
[830.547133, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[830.547167, "i", "arps):\n    cnt = torch.zeros(4, dtype=torch.float32, device='cuda')\n    xf = x.view(-1)\n    def fn():\n        y = torch.empty_like(x); yf = y.view(-1)\n        _ln_persistent[(G,)](xf, yf, w0, b0, cnt, N, eps, G,\n                             SPP=triton.next_power_of_2(G), BLOCK=BLOCK,\n                             NB=BLOCK//1024, num_warps=warps)\n        return y\n    return fn\n\nprops = torch.cuda.get_device_properties(0)\nprint('SMs', props.multi_processor_count, flush=True)\nfor G in [props.multi_processor_count, 2*props.multi_processor_count]:\n    if N % G: continue\n    chunk = N // G\n    for BLOCK in [2048, 4096, 8192]:\n        if chunk % BLOCK: continue\n        for wp in [4, 8, 16]:\n            try:\n                fn = make_pers(G, BLOCK, wp)\n                y = fn()\n                torch.cuda.synchronize()\n                md = (y - ref).abs().max().item()\n                t = bench(fn)\n                print(f'pers G={G} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\n            except Excepti"]
[830.547187, "i", "on as ex:\n                print(f'pers G={G} BLOCK={BLOCK} w={wp} FAIL {type(ex).__name__} {ex}', flush=True)\nEOF\ngpu run --timeout 300 -- python3 /workspace/bench2.py 2>&1 | tail -30\n"]
