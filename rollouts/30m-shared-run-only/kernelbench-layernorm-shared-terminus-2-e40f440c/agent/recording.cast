[1009.972931, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1009.972947, "o", "\u001b[?2004h> "]
[1009.973044, "o", "        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[1009.97306, "o", "\u001b[?2004h> "]
[1009.973094, "o", "        clear_l2()\r\n\u001b[?2004l\r"]
[1009.97311, "o", "\u001b[?2004h> "]
[1009.973215, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1009.973234, "o", "\u001b[?2004h> "]
[1009.973306, "o", "        if i: ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1009.973322, "o", "\u001b[?2004h> "]
[1009.973375, "o", "    return float(np.mean(ts))\r\n\u001b[?2004l\r"]
[1009.973392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1009.973409, "o", "\u001b[?2004h"]
[1009.973425, "o", "> "]
[1009.973444, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1009.973461, "o", "\u001b[?2004h> "]
[1009.97359, "o", "def _ln_pers(x_ptr, y_ptr, w_ptr, b_ptr, sum_ptr, sq_ptr, arr_ptr, flag_ptr,\r\n\u001b[?2004l\r"]
[1009.973607, "o", "\u001b[?2004h> "]
[1009.973656, "o", "             N, eps, epoch,\r\n\u001b[?2004l\r"]
[1009.973672, "o", "\u001b[?2004h> "]
[1009.973788, "o", "             B: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1009.973803, "o", "\u001b[?2004h> "]
[1009.973854, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1009.97387, "o", "\u001b[?2004h> "]
[1009.973906, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[1009.973923, "o", "\u001b[?2004h> "]
[1009.973962, "o", "    split = pid % S\r\n\u001b[?2004l\r"]
[1009.973977, "o", "\u001b[?2004h> "]
[1009.974014, "o", "    chunk = N // S\r\n\u001b[?2004l\r"]
[1009.97403, "o", "\u001b[?2004h> "]
[1009.974072, "o", "    rowbase = row * N\r\n\u001b[?2004l\r"]
[1009.974087, "o", "\u001b[?2004h> "]
[1009.974149, "o", "    base = rowbase + split * chunk\r\n\u001b[?2004l\r"]
[1009.974167, "o", "\u001b[?2004h> "]
[1009.974272, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1009.974289, "o", "\u001b[?2004h> "]
[1009.974365, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1009.974384, "o", "\u001b[?2004h> "]
[1009.974452, "o", "    for off in tl.range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[1009.974465, "o", "\u001b[?2004h> "]
[1009.974552, "o", "        idx = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1009.974565, "o", "\u001b[?2004h> "]
[1009.974623, "o", "        v = tl.load(x_ptr + idx)\r\n\u001b[?2004l\r"]
[1009.974634, "o", "\u001b[?2004h> "]
[1009.97467, "o", "        acc += v\r\n\u001b[?2004l\r"]
[1009.974683, "o", "\u001b[?2004h> "]
[1009.974725, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[1009.974739, "o", "\u001b[?2004h> "]
[1009.974779, "o", "    ps = tl.sum(acc)\r\n\u001b[?2004l\r"]
[1009.974795, "o", "\u001b[?2004h> "]
[1009.974836, "o", "    ps2 = tl.sum(acc2)\r\n\u001b[?2004l\r"]
[1009.974849, "o", "\u001b[?2004h> "]
[1009.974915, "o", "    tl.atomic_add(sum_ptr + row, ps)\r\n\u001b[?2004l\r"]
[1009.974935, "o", "\u001b[?2004h> "]
[1009.974994, "o", "    tl.atomic_add(sq_ptr + row, ps2)\r\n\u001b[?2004l\r"]
[1009.975014, "o", "\u001b[?2004h> "]
[1009.975104, "o", "    old = tl.atomic_add(arr_ptr + row, 1, sem='release')\r\n\u001b[?2004l\r"]
[1009.975124, "o", "\u001b[?2004h> "]
[1009.975158, "o", "    if old == S - 1:\r\n\u001b[?2004l\r"]
[1009.975177, "o", "\u001b[?2004h> "]
[1009.975281, "o", "        total = tl.atomic_add(sum_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1009.975299, "o", "\u001b[?2004h> "]
[1009.975403, "o", "        total2 = tl.atomic_add(sq_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1009.975422, "o", "\u001b[?2004h> "]
[1009.975463, "o", "        mean = total / N\r\n\u001b[?2004l\r"]
[1009.975483, "o", "\u001b[?2004h> "]
[1009.97555, "o", "        var = total2 / N - mean * mean\r\n\u001b[?2004l\r"]
[1009.975572, "o", "\u001b[?2004h> "]
[1009.975633, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1009.975653, "o", "\u001b[?2004h> "]
[1009.975724, "o", "        tl.atomic_xchg(sum_ptr + row, mean)\r\n\u001b[?2004l\r"]
[1009.975737, "o", "\u001b[?2004h> "]
[1009.975812, "o", "        tl.atomic_xchg(sq_ptr + row, rstd)\r\n\u001b[?2004l\r"]
[1009.975832, "o", "\u001b[?2004h> "]
[1009.975929, "o", "        tl.atomic_xchg(flag_ptr + row, epoch, sem='release')\r\n\u001b[?2004l\r"]
[1009.975947, "o", "\u001b[?2004h> "]
[1009.976036, "o", "    f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\r\n\u001b[?2004l\r"]
[1009.976052, "o", "\u001b[?2004h> "]
[1009.976091, "o", "    while f < epoch:\r\n\u001b[?2004l\r"]
[1009.97611, "o", "\u001b[?2004h> "]
[1009.976205, "o", "        f = tl.atomic_add(flag_ptr + row, 0, sem='acquire')\r\n\u001b[?2004l\r"]
[1009.976224, "o", "\u001b[?2004h> "]
[1009.97632, "o", "    mean = tl.atomic_add(sum_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1009.97634, "o", "\u001b[?2004h> "]
[1009.976432, "o", "    rstd = tl.atomic_add(sq_ptr + row, 0.0, sem='acquire')\r\n\u001b[?2004l\r"]
[1009.976452, "o", "\u001b[?2004h> "]
[1009.976531, "o", "    for off in tl.range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[1009.976545, "o", "\u001b[?2004h> "]
[1009.976613, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1009.976625, "o", "\u001b[?2004h> "]
[1009.976696, "o", "        v = tl.load(x_ptr + base + idx)\r\n\u001b[?2004l\r"]
[1009.976709, "o", "\u001b[?2004h> "]
[1009.976769, "o", "        w = tl.load(w_ptr + idx)\r\n\u001b[?2004l\r"]
[1009.976786, "o", "\u001b[?2004h> "]
[1009.976842, "o", "        b = tl.load(b_ptr + idx)\r\n\u001b[?2004l\r"]
[1009.976862, "o", "\u001b[?2004h> "]
[1009.976922, "o", "        y = (v - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[1009.976941, "o", "\u001b[?2004h> "]
[1009.977005, "o", "        tl.store(y_ptr + base + idx, y)\r\n\u001b[?2004l\r"]
[1009.977023, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1009.977047, "o", "\u001b[?2004h> "]
[1009.977072, "o", "state = {}\r\n\u001b[?2004l\r"]
[1009.977085, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1009.977106, "o", "\u001b[?2004h> "]
[1009.977166, "o", "def make_pers(S, BLOCK, warps):\r\n\u001b[?2004l\r"]
[1009.977181, "o", "\u001b[?2004h> "]
[1009.977283, "o", "    sums = torch.zeros(B, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[1009.977299, "o", "\u001b[?2004h> "]
[1009.9774, "o", "    sqs = torch.zeros(B, dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[1009.977419, "o", "\u001b[?2004h> "]
[1009.977516, "o", "    arr = torch.zeros(B, dtype=torch.int32, device='cuda')\r\n\u001b[?2004l\r"]
[1009.977535, "o", "\u001b[?2004h> "]
[1009.977632, "o", "    flag = torch.zeros(B, dtype=torch.int32, device='cuda')\r\n\u001b[?2004l\r"]
[1009.977652, "o", "\u001b[?2004h> "]
[1009.977684, "o", "    xf = x.view(-1)\r\n\u001b[?2004l\r"]
[1009.977704, "o", "\u001b[?2004h> "]
[1009.97774, "o", "    st = {'epoch': 0}\r\n\u001b[?2004l\r"]
[1009.977755, "o", "\u001b[?2004h> "]
[1009.977782, "o", "    def fn():\r\n\u001b[?2004l\r"]
[1009.977797, "o", "\u001b[?2004h> "]
[1009.977842, "o", "        st['epoch'] += 1\r\n\u001b[?2004l\r"]
[1009.977854, "o", "\u001b[?2004h> "]
[1009.97794, "o", "        y = torch.empty_like(x); yf = y.view(-1)\r\n\u001b[?2004l\r"]
[1009.97796, "o", "\u001b[?2004h> "]
[1009.978059, "o", "        _ln_pers[(B*S,)](xf, yf, w0, b0, sums, sqs, arr, flag,\r\n\u001b[?2004l\r"]
[1009.978078, "o", "\u001b[?2004h> "]
[1009.978189, "o", "                         N, eps, st['epoch'], B=B, S=S, BLOCK=BLOCK,\r\n\u001b[?2004l\r"]
[1009.978209, "o", "\u001b[?2004h> "]
[1009.978276, "o", "                         num_warps=warps)\r\n\u001b[?2004l\r"]
[1009.978295, "o", "\u001b[?2004h> "]
[1009.978323, "o", "        return y\r\n\u001b[?2004l\r"]
[1009.978343, "o", "\u001b[?2004h> "]
[1009.978366, "o", "    return fn\r\n\u001b[?2004l\r"]
[1009.978383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1009.978396, "o", "\u001b[?2004h"]
[1009.978413, "o", "> "]
[1009.97848, "o", "props = torch.cuda.get_device_properties(0)\r\n\u001b[?2004l\r"]
[1009.978501, "o", "\u001b[?2004h> "]
[1009.97859, "o", "print('SMs', props.multi_processor_count, flush=True)\r\n\u001b[?2004l\r"]
[1009.97861, "o", "\u001b[?2004h> "]
[1009.978635, "o", "for S in [4, 8]:\r\n\u001b[?2004l\r"]
[1009.978655, "o", "\u001b[?2004h> "]
[1009.978685, "o", "    chunk = N // S\r\n\u001b[?2004l\r"]
[1009.978704, "o", "\u001b[?2004h> "]
[1009.978775, "o", "    for BLOCK in [2048, 4096, 8192, 16384]:\r\n\u001b[?2004l\r"]
[1009.978795, "o", "\u001b[?2004h> "]
[1009.97885, "o", "        if chunk % BLOCK: continue\r\n\u001b[?2004l\r"]
[1009.978869, "o", "\u001b[?2004h> "]
[1009.978924, "o", "        for wp in [4, 8, 16, 32]:\r\n\u001b[?2004l\r"]
[1009.978942, "o", "\u001b[?2004h> "]
[1009.978971, "o", "            try:\r\n\u001b[?2004l\r"]
[1009.978992, "o", "\u001b[?2004h> "]
[1009.97907, "o", "                fn = make_pers(S, BLOCK, wp)\r\n\u001b[?2004l\r"]
[1009.97909, "o", "\u001b[?2004h> "]
[1009.97913, "o", "                y = fn()\r\n\u001b[?2004l\r"]
[1009.979145, "o", "\u001b[?2004h> "]
[1009.979215, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1009.979234, "o", "\u001b[?2004h> "]
[1009.979315, "o", "                md = (y - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1009.979333, "o", "\u001b[?2004h> "]
[1009.979383, "o", "                t = bench(fn)\r\n\u001b[?2004l\r"]
[1009.979398, "o", "\u001b[?2004h> "]
[1009.979564, "o", "                print(f'pers S={S} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\r\n\u001b[?2004l\r"]
[1009.979579, "o", "\u001b[?2004h> "]
[1009.979639, "o", "            except Exception as ex:\r\n\u001b[?2004l\r"]
[1009.979658, "o", "\u001b[?2004h> "]
[1009.979827, "o", "                print(f'pers S={S} BLOCK={BLOCK} w={wp} FAIL {type(ex).__name__}: {ex}', flush=True)\r\n\u001b[?2004l\r"]
[1009.979842, "o", "\u001b[?2004h> "]
[1009.979855, "o", "EOF\r\n\u001b[?2004l\r"]
[1009.981402, "o", "\u001b[?2004hroot@modal:/# "]
[1009.981526, "o", "gpu run --timeout 400 -- python3 /workspace/bench2.py 2>&1 | tail -30\r\n\u001b[?2004l\r"]
[1429.35394, "i", "\u0003"]
[1429.353987, "o", "^C"]
[1429.37592, "o", "\r\n"]
[1429.375974, "o", "\u001b[?2004hroot@modal:/# "]
[1431.354499, "i", "gpu stop sb-BeNrf2KjBMGJHpJ7lwDcIE 2>/dev/null; gpu stop sb-iWC7hd9IC2vHyzJv9oRNtT 2>/dev/null; echo done\n"]
[1431.354817, "o", "gpu stop sb-BeNrf2KjBMGJHpJ7lwDcIE 2>/dev/null; gpu stop sb-iWC7hd9IC2vHyzJv9oRNtT 2>/dev/null; echo done\r\n\u001b[?2004l\r"]
[1433.295775, "o", "{\r\n  \"stopped\": \"sb-BeNrf2KjBMGJHpJ7lwDcIE\"\r\n}\r\n"]
