[751.542416, "i", "cat > /workspace/bench.py << 'EOF'\nimport numpy as np, torch, triton, triton.language as tl, torch.nn as nn, sys\nsys.path.insert(0, '/workspace')\n\ntorch.manual_seed(0)\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device='cuda')\nw = torch.rand(N, device='cuda'); b = torch.rand(N, device='cuda')\neps = 1e-5\nref = nn.functional.layer_norm(x, (N,), w, b, eps)\n\ndef clear_l2():\n    d = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda'); d.fill_(42); del d\n\ndef bench(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); torch.cuda.empty_cache()\n    ts=[]\n    for i in range(n+1):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        clear_l2()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        if i: ts.append(s.elapsed_time(e))\n    return float(np.mean(ts))\n\nprint('ref eager ms:', bench(lambda: nn.functional.layer_norm(x, (N,), w, b, eps)), flush=True)\n\nfrom solution import ModelNew, _ln_stats_kernel, _ln_norm_kernel\nm = ModelNew"]
[751.542468, "i", "((64,256,256)).cuda()\nwith torch.no_grad(): m.weight.copy_(w.view(64,256,256)); m.bias.copy_(b.view(64,256,256))\no = m(x.view(16,64,256,256))\nprint('current maxdiff', (o.view(B,N)-ref).abs().max().item(), flush=True)\nprint('current two-kernel ms:', bench(lambda: m(x.view(16,64,256,256))), flush=True)\n\ndef make_two(S, BLOCK, warps):\n    psum = torch.empty(B*S, device='cuda'); psq = torch.empty(B*S, device='cuda')\n    xf = x.view(-1)\n    def fn():\n        y = torch.empty_like(x); yf = y.view(-1)\n        grid = (B*S,)\n        _ln_stats_kernel[grid](xf, psum, psq, N, S=S, BLOCK=BLOCK, num_warps=warps)\n        _ln_norm_kernel[grid](xf, yf, w, b, psum, psq, N, eps, S=S, SP=triton.next_power_of_2(S), BLOCK=BLOCK, num_warps=warps)\n        return y\n    return fn\n\nfor S in [32, 64, 128, 256]:\n    for BLOCK in [2048, 4096, 8192]:\n        if N % (S*BLOCK): continue\n        for wp in [4, 8, 16]:\n            try:\n                fn = make_two(S, BLOCK, wp)\n                y = fn()\n                md = (y-ref).abs().max().i"]
[751.542823, "i", "tem()\n                t = bench(fn)\n                print(f'two S={S} BLOCK={BLOCK} w={wp} ms={t:.4f} maxdiff={md:.2e}', flush=True)\n            except Exception as ex:\n                print(f'two S={S} BLOCK={BLOCK} w={wp} FAIL {ex}', flush=True)\nEOF\ngpu run --timeout 900 -- python3 /workspace/bench.py 2>&1 | tail -50\n"]
