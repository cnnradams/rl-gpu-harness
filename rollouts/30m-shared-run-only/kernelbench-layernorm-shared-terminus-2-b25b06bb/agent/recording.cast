[322.684605, "o", "> "]
[322.68467, "o", "    def _forward_triton(self, x):\r\n\u001b[?2004l\r"]
[322.684701, "o", "\u001b[?2004h> "]
[322.684731, "o", "        N = 1\r\n\u001b[?2004l\r"]
