[412.209064, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, numpy as np, itertools\nimport triton, triton.language as tl\nimport importlib.util\nspec = importlib.util.spec_from_file_location('sol', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\n_stats = sol._stats_kernel\n_apply = sol._apply_kernel\n\ndevice = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=device)\nN = 64*256*256\nR = 16\nxf = x.view(-1)\nw = torch.ones(N, device=device)\nb = torch.zeros(N, device=device)\nout = torch.empty_like(x)\nof = out.view(-1)\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    ts = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)\n\nprint('--- stats kernel sweep ---')\nbest_s = None\nfor CB, IT, WP in [(2048,64,8),(4096,32,8),(8192,16,8),(4096,1"]
[412.209123, "i", "6,8),(2048,32,8),(2048,32,4),(8192,8,8),(16384,8,16),(4096,32,4),(4096,64,8),(8192,16,16),(2048,64,4)]:\n    C = N // (CB*IT)\n    psum = torch.empty(R, C, device=device); psq = torch.empty(R, C, device=device)\n    f = lambda: _stats[(R, C)](xf, psum, psq, N, ITERS=IT, CB=CB, num_warps=WP)\n    t = timeit(f)\n    bw = 268.4e6 / (t*1e-3) / 1e12\n    print(f'CB={CB} IT={IT} warps={WP} C={C}: {t:.4f} ms  ({bw:.2f} TB/s)')\n    if best_s is None or t < best_s[0]: best_s = (t, CB, IT, WP, C)\nprint('best stats:', best_s)\n\nC = best_s[4]\npsum = torch.empty(R, C, device=device); psq = torch.empty(R, C, device=device)\nprint('--- apply kernel sweep ---')\nbest_a = None\nfor CB, IT, WP in [(1024,32,4),(2048,16,4),(2048,16,8),(4096,8,8),(8192,4,8),(4096,8,4),(2048,8,4),(8192,4,4),(4096,16,8),(16384,2,8),(2048,32,8),(8192,2,4)]:\n    C2 = N // (CB*IT)\n    f = lambda: _apply[(R, C2)](xf, w, b, of, psum, psq, N, 1e-5, C=C, ITERS=IT, CB=CB, num_warps=WP)\n    t = timeit(f)\n    bw = 536.8e6 / (t*1e-3) / 1e12\n    print(f'CB={CB} IT={IT} "]
[412.209137, "i", "warps={WP} C2={C2}: {t:.4f} ms  ({bw:.2f} TB/s)')\n    if best_a is None or t < best_a[0]: best_a = (t, CB, IT, WP)\nprint('best apply:', best_a)\nprint('total est: %.4f ms' % (best_s[0]+best_a[0]))\nEOF\n"]
