[438.949744, "o", "--- stats kernel sweep ---\r\nCB=2048 IT=64 warps=8 C=32: 0.1058 ms  (2.54 TB/s)\r\nCB=4096 IT=32 warps=8 C=32: 0.1069 ms  (2.51 TB/s)\r\nCB=8192 IT=16 warps=8 C=32: 0.1053 ms  (2.55 TB/s)\r\nCB=4096 IT=16 warps=8 C=64: 0.1060 ms  (2.53 TB/s)\r\nCB=2048 IT=32 warps=8 C=64: 0.1072 ms  (2.50 TB/s)\r\nCB=2048 IT=32 warps=4 C=64: 0.1059 ms  (2.54 TB/s)\r\nCB=8192 IT=8 warps=8 C=64: 0.1058 ms  (2.54 TB/s)\r\nCB=16384 IT=8 warps=16 C=32: 0.1066 ms  (2.52 TB/s)\r\nCB=4096 IT=32 warps=4 C=32: 0.1075 ms  (2.50 TB/s)\r\nCB=4096 IT=64 warps=8 C=16: 0.1056 ms  (2.54 TB/s)\r\nCB=8192 IT=16 warps=16 C=32: 0.1063 ms  (2.52 TB/s)\r\nCB=2048 IT=64 warps=4 C=32: 0.1053 ms  (2.55 TB/s)\r\nbest stats: (np.float64(0.10528426691889763), 2048, 64, 4, 32)\r\n--- apply kernel sweep ---\r\nCB=1024 IT=32 warps=4 C2=128: 0.2367 ms  (2.27 TB/s)\r\nCB=2048 IT=16 warps=4 C2=128: 0.2337 ms  (2.30 TB/s)\r\nCB=2048 IT=16 warps=8 C2=128: 0.2289 ms  (2.35 TB/s)\r\nCB=4096 IT=8 warps=8 C2=128: 0.2210 ms  (2.43 TB/s)\r\nCB=8192 IT=4 warps=8 C2=128: 0.2224 ms  (2.41 TB/s)\r\nCB=4096 IT="]
[438.949792, "o", "8 warps=4 C2=128: 0.2275 ms  (2.36 TB/s)\r\nCB=2048 IT=8 warps=4 C2=256: 0.2249 ms  (2.39 TB/s)\r\nCB=8192 IT=4 warps=4 C2=128: 0.2202 ms  (2.44 TB/s)\r\nCB=4096 IT=16 warps=8 C2=64: 0.2303 ms  (2.33 TB/s)\r\nCB=16384 IT=2 warps=8 C2=128: 0.2228 ms  (2.41 TB/s)\r\nCB=2048 IT=32 warps=8 C2=64: 0.2327 ms  (2.31 TB/s)\r\nCB=8192 IT=2 warps=4 C2=256: 0.2175 ms  (2.47 TB/s)\r\nbest apply: (np.float64(0.21754026760657627), 8192, 2, 4)\r\ntotal est: 0.3228 ms\r\n"]
[443.348695, "o", "\u001b[?2004hroot@modal:/workspace# "]
[500.604279, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch, numpy as np\nimport triton, triton.language as tl\n\ndevice = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=device)\nN = 64*256*256\nR = 16\nxf = x.view(-1)\nw = torch.ones(N, device=device)\nb = torch.zeros(N, device=device)\nout = torch.empty_like(x)\nof = out.view(-1)\nC = 32\npsum = torch.rand(R, C, device=device); psq = torch.rand(R, C, device=device)\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    ts = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)\n\n@triton.jit\ndef apply_v(x_ptr, w_ptr, b_ptr, o_ptr, psum_ptr, psq_ptr, N, eps,\n            C: tl.constexpr, ITERS: tl.constexpr, CB: tl.constexpr,\n            LCM: tl.constexpr, SCM: tl.constexpr):\n    row = tl.program_id(0)\n    col = tl.program_id(1)\n    idx = tl.a"]
[500.604326, "i", "range(0, C)\n    s = tl.sum(tl.load(psum_ptr + row * C + idx))\n    s2 = tl.sum(tl.load(psq_ptr + row * C + idx))\n    mean = s / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + col.to(tl.int64) * (ITERS * CB)\n    wbase = col.to(tl.int64) * (ITERS * CB)\n    for i in tl.static_range(ITERS):\n        off = i * CB + tl.arange(0, CB)\n        if LCM == 1:\n            v = tl.load(x_ptr + base + off, cache_modifier='.cg')\n        elif LCM == 2:\n            v = tl.load(x_ptr + base + off, eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + off)\n        wv = tl.load(w_ptr + wbase + off)\n        bv = tl.load(b_ptr + wbase + off)\n        y = (v - mean) * (rstd * wv) + bv\n        if SCM == 1:\n            tl.store(o_ptr + base + off, y, cache_modifier='.cs')\n        elif SCM == 2:\n            tl.store(o_ptr + base + off, y, cache_modifier='.wt')\n        else:\n            tl.store(o_ptr + base + off, y)\n\nfor CB, IT, WP in [(8192,2,4),(8192,2"]
[500.60434, "i", ",8),(4096,4,4),(16384,1,8)]:\n    for LCM in [0,1,2]:\n        for SCM in [0,1,2]:\n            C2 = N // (CB*IT)\n            f = lambda: apply_v[(R, C2)](xf, w, b, of, psum, psq, N, 1e-5, C=C, ITERS=IT, CB=CB, LCM=LCM, SCM=SCM, num_warps=WP)\n            t = timeit(f)\n            print(f'CB={CB} IT={IT} W={WP} lcm={LCM} scm={SCM}: {t:.4f} ms')\nEOF\n"]
