[518.869135, "o", "\nCB=4096 IT=4 W=4 lcm=2 scm=1: 0.2259 ms\r\nCB=4096 IT=4 W=4 lcm=2 scm=2: 0.2254 ms\r\nCB=16384 IT=1 W=8 lcm=0 scm=0: 0.2232 ms\r\nCB=16384 IT=1 W=8 lcm=0 scm=1: 0.2170 ms\r\nCB=16384 IT=1 W=8 lcm=0 scm=2: 0.2296 ms\r\nCB=16384 IT=1 W=8 lcm=1 scm=0: 0.2245 ms\r\nCB=16384 IT=1 W=8 lcm=1 scm=1: 0.2173 ms\r\nCB=16384 IT=1 W=8 lcm=1 scm=2: 0.2270 ms\r\nCB=16384 IT=1 W=8 lcm=2 scm=0: 0.2233 ms\r\nCB=16384 IT=1 W=8 lcm=2 scm=1: 0.2227 ms\r\nCB=16384 IT=1 W=8 lcm=2 scm=2: 0.2230 ms\r\n"]
