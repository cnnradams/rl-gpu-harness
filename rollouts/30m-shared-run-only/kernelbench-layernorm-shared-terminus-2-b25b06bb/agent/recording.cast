[412.215402, "o", "    f = lambda: _apply[(R, C2)](xf, w, b, of, psum, psq, N, 1e-5, C=C, ITERS=IT, CB=CB, num_warps=WP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.21543, "o", "> "]
[412.215461, "o", "    t = timeit(f)\r\n\u001b[?2004l\r"]
[412.215481, "o", "\u001b[?2004h> "]
[412.215579, "o", "    bw = 536.8e6 / (t*1e-3) / 1e12\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.215609, "o", "> "]
[412.21579, "o", "    print(f'CB={CB} IT={IT} warps={WP} C2={C2}: {t:.4f} ms  ({bw:.2f} TB/s)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[412.215819, "o", "> "]
[412.21596, "o", "    if best_a is None or t < best_a[0]: best_a = (t, CB, IT, WP)\r\n\u001b[?2004l\r"]
[412.215982, "o", "\u001b[?2004h> "]
[412.216056, "o", "print('best apply:', best_a)\r\n\u001b[?2004l\r"]
[412.216086, "o", "\u001b[?2004h> "]
[412.216209, "o", "print('total est: %.4f ms' % (best_s[0]+best_a[0]))\r\n\u001b[?2004l\r"]
[412.216229, "o", "\u001b[?2004h> "]
[412.216258, "o", "EOF\r\n\u001b[?2004l\r"]
