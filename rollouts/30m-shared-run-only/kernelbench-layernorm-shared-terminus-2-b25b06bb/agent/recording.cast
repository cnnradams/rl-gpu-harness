[322.996403, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, importlib.util, numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    m = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(m)\n    return m\n\nref = load('/opt/task/reference.py', 'ref')\nsol = load('/workspace/solution.py', 'sol')\ndevice = torch.device('cuda')\ntorch.manual_seed(42)\nrm = ref.Model((64, 256, 256)).to(device)\nsm = sol.ModelNew((64, 256, 256)).to(device)\nx = torch.rand(16, 64, 256, 256, device=device)\nwith torch.no_grad():\n    r = rm(x)\n    s = sm(x)\nprint('maxdiff', (r - s).abs().max().item())\nprint('allclose 1e-4:', torch.allclose(r, s, atol=1e-4, rtol=1e-4))\nwith torch.no_grad():\n    times_r = time_execution_with_cuda_event(rm, [x], num_trials=20, verbose=False, device=device)\n    times_s = time_execution_with_cuda_event(sm, [x], num_trials=20, verbose=False, device=device)\nprint('ref  mean %.4f ms  min %.4f' % (np.mean(time"]
[322.996449, "i", "s_r), np.min(times_r)))\nprint('sol  mean %.4f ms  min %.4f' % (np.mean(times_s), np.min(times_s)))\nprint('speedup %.3f' % (np.mean(times_r) / np.mean(times_s)))\nEOF\n"]
