[577.655388, "o", "\u001b[?2004h> "]
[577.655507, "o", "        if (C < 1 or C > 1024 or N % (CB1 * IT1) != 0\r\n\u001b[?2004l\r"]
[577.655539, "o", "\u001b[?2004h> "]
[577.655653, "o", "                or C2 < 1 or N % (CB2 * IT2) != 0):\r\n\u001b[?2004l\r"]
