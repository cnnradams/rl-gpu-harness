[322.685512, "o", "\u001b[?2004h> "]
[322.685606, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[322.685636, "o", "\u001b[?2004h> "]
[322.685794, "o", "        psum = torch.empty(R, C, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[322.685825, "o", "\u001b[?2004h> "]
[322.685981, "o", "        psq = torch.empty(R, C, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
