[648.098071, "i", "cat > /workspace/sweep3.py << 'EOF'\nimport torch, numpy as np\nimport triton, triton.language as tl\n\ndevice = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=device)\nN = 64*256*256\nR = 16\nxf = x.view(-1)\nw = torch.ones(N, device=device)\nb = torch.zeros(N, device=device)\nout = torch.empty_like(x)\nof = out.view(-1)\nC = 32\npsum = torch.rand(R, C, device=device); psq = torch.rand(R, C, device=device)\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    ts = []\n    for _ in range(iters):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)\n\n@triton.jit\ndef apply_f(x_ptr, w_ptr, b_ptr, o_ptr, psum_ptr, psq_ptr, N, eps,\n            C: tl.constexpr, SPLIT: tl.constexpr, ITERS: tl.constexpr, CB: tl.constexpr):\n    row = tl.program_id(0)\n    col = tl.program_id(1)\n    idx = tl.arange(0, SPLIT)\n    chunk = C"]
[648.098119, "i", " // SPLIT\n    s = tl.sum(tl.load(psum_ptr + row * C + col * chunk + idx))\n    s2 = tl.sum(tl.load(psq_ptr + row * C + col * chunk + idx))\n    mean = s / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + col.to(tl.int64) * (ITERS * CB)\n    wbase = col.to(tl.int64) * (ITERS * CB)\n    for i in tl.static_range(ITERS):\n        off = i * CB + tl.arange(0, CB)\n        v = tl.load(x_ptr + base + off)\n        wv = tl.load(w_ptr + wbase + off)\n        bv = tl.load(b_ptr + wbase + off)\n        y = (v - mean) * (rstd * wv) + bv\n        tl.store(o_ptr + base + off, y)\n\nfor CB, IT, WP, SPLIT in [(4096,2,4,16),(8192,2,4,8),(8192,4,8,8),(4096,4,4,16),(8192,2,8,8),(16384,1,8,8),(4096,2,2,16)]:\n    C2 = N // (CB*IT)\n    f = lambda: apply_f[(R, C2)](xf, w, b, of, psum, psq, N, 1e-5, C=C, SPLIT=SPLIT, ITERS=IT, CB=CB, num_warps=WP)\n    t = timeit(f)\n    print(f'CB={CB} IT={IT} W={WP} SPLIT={SPLIT} C2={C2}: {t:.4f} ms')\nEOF\n"]
