[322.687257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[322.687288, "o", "\u001b[?2004h> "]
[322.687409, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
