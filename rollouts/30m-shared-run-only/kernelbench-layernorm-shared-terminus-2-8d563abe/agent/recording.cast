[930.679101, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[930.679126, "o", "\u001b[?2004h> "]
[930.67915, "o", "        dev = x.device\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.679178, "o", "> "]
[930.679267, "o", "        if self._part is None or self._part.device != dev or self._part.shape[0] != R * S * 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.679302, "o", "> "]
[930.679373, "o", "            self._part = torch.empty(R * S * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[930.679401, "o", "\u001b[?2004h> "]
[930.679428, "o", "        part = self._part\r\n\u001b[?2004l\r"]
[930.679455, "o", "\u001b[?2004h> "]
[930.679483, "o", "        out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.67951, "o", "> "]
[930.679537, "o", "        x2 = x.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.679571, "o", "        o2 = out.reshape(-1)\r\n\u001b[?2004l\r"]
[930.679598, "o", "\u001b[?2004h> "]
[930.679626, "o", "        w = self.weight.reshape(-1)\r\n\u001b[?2004l\r"]
[930.679653, "o", "\u001b[?2004h> "]
[930.67968, "o", "        b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[930.679708, "o", "\u001b[?2004h> "]
[930.679807, "o", "        _reduce_kernel[(R, S)](x2, part, self.N, CHUNK=CHUNK, BLOCK=BLOCK, S=S, num_warps=self._warps)\r\n\u001b[?2004l\r"]
[930.679835, "o", "\u001b[?2004h> "]
[930.679896, "o", "        _norm_kernel[(S, R)](x2, w, b, part, o2, self.N, self.eps,\r\n\u001b[?2004l\r"]
[930.679921, "o", "\u001b[?2004h> "]
[930.680007, "o", "                             CHUNK=CHUNK, BLOCK=BLOCK, S=S, num_warps=self._warps)\r\n\u001b[?2004l\r"]
[930.680031, "o", "\u001b[?2004h> "]
[930.680059, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
