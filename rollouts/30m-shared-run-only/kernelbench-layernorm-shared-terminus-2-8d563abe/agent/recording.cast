[1071.239148, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.239191, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.239256, "o", "def _norm_kernel(x_ptr, w_ptr, b_ptr, part_ptr, out_ptr, N, eps,\r\n\u001b[?2004l\r"]
