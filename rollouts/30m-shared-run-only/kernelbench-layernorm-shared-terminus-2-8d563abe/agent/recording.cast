[1071.239498, "o", "\u001b[?2004h> "]
[1071.239544, "o", "    offs = tl.arange(0, S)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.239598, "o", "    ps = tl.load(part_ptr + (row * S + offs) * 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.23964, "o", "> "]
[1071.239681, "o", "    ps2 = tl.load(part_ptr + (row * S + offs) * 2 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.239736, "o", ">     mean = tl.sum(ps) / N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.239788, "o", "    var = tl.sum(ps2) / N - mean * mean\r\n\u001b[?2004l\r"]
[1071.23983, "o", "\u001b[?2004h> "]
[1071.239867, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.239909, "o", "    base = row * N + sp * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.23995, "o", "    col = sp * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240016, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.24007, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1071.240116, "o", "\u001b[?2004h> "]
[1071.240151, "o", "        v = tl.load(x_ptr + base + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240206, "o", "        w = tl.load(w_ptr + col + idx)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.240249, "o", "> "]
[1071.240293, "o", "        b = tl.load(b_ptr + col + idx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240364, "o", "        tl.store(out_ptr + base + idx, (v - mean) * rstd * w + b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.240411, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240453, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.240495, "o", "> "]
[1071.240544, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240582, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240657, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.240699, "o", ">         n = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.240753, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.240798, "o", ">             n *= d\r\n\u001b[?2004l\r"]
[1071.240838, "o", "\u001b[?2004h>         self.N = n\r\n\u001b[?2004l\r"]
[1071.240878, "o", "\u001b[?2004h> "]
[1071.24094, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.240981, "o", "> "]
[1071.241033, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.241075, "o", ">         self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.241109, "o", ">         self._S = 256\r\n\u001b[?2004l\r"]
[1071.241148, "o", "\u001b[?2004h> "]
[1071.241189, "o", "        self._BLOCK = 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241229, "o", "        self._warps = 16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241268, "o", "        self._part = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1071.241307, "o", "\u001b[?2004h> "]
[1071.241348, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[1071.241389, "o", "\u001b[?2004h> "]
[1071.241428, "o", "        R = x.numel() // self.N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241468, "o", "        S = self._S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241507, "o", "        if self.N % S != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241619, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.241636, "o", "> "]
[1071.241674, "o", "        CHUNK = self.N // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241713, "o", "        BLOCK = self._BLOCK\r\n\u001b[?2004l\r"]
[1071.241751, "o", "\u001b[?2004h> "]
[1071.241792, "o", "        while BLOCK > CHUNK:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241833, "o", "            BLOCK //= 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.241875, "o", "        if CHUNK % BLOCK != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.24198, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.242022, "o", ">         dev = x.device\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.242057, "o", "> "]
[1071.242153, "o", "        if self._part is None or self._part.device != dev or self._part.shape[0] != R * S * 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.24226, "o", "            self._part = torch.empty(R * S * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.2423, "o", "        part = self._part\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.242333, "o", "> "]
[1071.242367, "o", "        out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.242408, "o", "        x2 = x.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.242443, "o", "        o2 = out.reshape(-1)\r\n\u001b[?2004l\r"]
[1071.242484, "o", "\u001b[?2004h> "]
[1071.242517, "o", "        w = self.weight.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.242568, "o", "        b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[1071.24261, "o", "\u001b[?2004h> "]
[1071.242703, "o", "        _reduce_kernel[(R, S)](x2, part, self.N, CHUNK=CHUNK, BLOCK=BLOCK, S=S, num_warps=self._warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.242745, "o", "> "]
[1071.242785, "o", "        _norm_kernel[(R, S)](x2, w, b, part, o2, self.N, self.eps,\r\n\u001b[?2004l\r"]
[1071.242826, "o", "\u001b[?2004h> "]
[1071.2429, "o", "                             CHUNK=CHUNK, BLOCK=BLOCK, S=S, num_warps=self._warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1071.242944, "o", ">         return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1071.242983, "o", "EOF\r\n\u001b[?2004l\r"]
[1071.244368, "o", "\u001b[?2004hroot@modal:/# "]
[1071.244458, "o", "gpu run --detach -- python3 /opt/task/evaluate.py /workspace/solution.py\r\n\u001b[?2004l\r"]
