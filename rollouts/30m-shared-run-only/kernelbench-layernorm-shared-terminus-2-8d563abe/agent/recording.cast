[202.209814, "o", "    base = row * N + sp * CHUNK\r\n\u001b[?2004l\r"]
[202.209841, "o", "\u001b[?2004h> "]
[202.209881, "o", "    acc = tl.zeros((BLOCK,), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[202.209914, "o", "\u001b[?2004h> "]
[202.209949, "o", "    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[202.209978, "o", "\u001b[?2004h> "]
[202.210012, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[202.210041, "o", "\u001b[?2004h> "]
[202.210098, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[202.210127, "o", "\u001b[?2004h> "]
[202.210143, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210174, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[202.210202, "o", "\u001b[?2004h> "]
[202.210229, "o", "    s = tl.sum(acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210258, "o", "    s2 = tl.sum(acc2)\r\n\u001b[?2004l\r"]
[202.210287, "o", "\u001b[?2004h> "]
[202.210326, "o", "    tl.store(part_ptr + (row * S + sp) * 2, s)\r\n\u001b[?2004l\r"]
[202.210351, "o", "\u001b[?2004h> "]
[202.210401, "o", "    tl.store(part_ptr + (row * S + sp) * 2 + 1, s2)\r\n\u001b[?2004l\r"]
[202.210425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[202.210456, "o", "\u001b[?2004h> "]
[202.210482, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.210558, "o", "def _norm_kernel(x_ptr, w_ptr, b_ptr, part_ptr, out_ptr, N, eps,\r\n\u001b[?2004l\r"]
[202.210586, "o", "\u001b[?2004h> "]
[202.210655, "o", "                 CHUNK: tl.constexpr, BLOCK: tl.constexpr, S: tl.constexpr):\r\n\u001b[?2004l\r"]
[202.210673, "o", "\u001b[?2004h> "]
[202.210707, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[202.210736, "o", "\u001b[?2004h> "]
[202.210761, "o", "    sp = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.21079, "o", "    offs = tl.arange(0, S)\r\n\u001b[?2004l\r"]
[202.210818, "o", "\u001b[?2004h> "]
[202.21086, "o", "    ps = tl.load(part_ptr + (row * S + offs) * 2)\r\n\u001b[?2004l\r"]
[202.210887, "o", "\u001b[?2004h> "]
[202.210938, "o", "    ps2 = tl.load(part_ptr + (row * S + offs) * 2 + 1)\r\n\u001b[?2004l\r"]
[202.210964, "o", "\u001b[?2004h> "]
[202.21099, "o", "    mean = tl.sum(ps) / N\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.211028, "o", "> "]
[202.211106, "o", "    var = tl.sum(ps2) / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.21114, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211179, "o", "    base = row * N + sp * CHUNK\r\n\u001b[?2004l\r"]
[202.211209, "o", "\u001b[?2004h> "]
[202.211233, "o", "    col = sp * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211276, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[202.211296, "o", "\u001b[?2004h> "]
[202.211341, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[202.21137, "o", "\u001b[?2004h> "]
[202.211403, "o", "        v = tl.load(x_ptr + base + idx)\r\n\u001b[?2004l\r"]
[202.211433, "o", "\u001b[?2004h> "]
[202.21147, "o", "        w = tl.load(w_ptr + col + idx)\r\n\u001b[?2004l\r"]
[202.211496, "o", "\u001b[?2004h> "]
[202.211531, "o", "        b = tl.load(b_ptr + col + idx)\r\n\u001b[?2004l\r"]
[202.211559, "o", "\u001b[?2004h> "]
[202.211621, "o", "        tl.store(out_ptr + base + idx, (v - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[202.211631, "o", "\u001b[?2004h"]
[202.211664, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[202.21169, "o", "\u001b[?2004h> "]
[202.211721, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.211773, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[202.211803, "o", "\u001b[?2004h> "]
[202.211832, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.211861, "o", "> "]
[202.2119, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[202.211924, "o", "\u001b[?2004h"]
[202.211949, "o", ">         n = 1\r\n\u001b[?2004l\r"]
[202.211977, "o", "\u001b[?2004h> "]
[202.212008, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[202.212038, "o", "\u001b[?2004h> "]
[202.212066, "o", "            n *= d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212094, "o", "        self.N = n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212174, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[202.212199, "o", "\u001b[?2004h> "]
[202.212264, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[202.212287, "o", "\u001b[?2004h> "]
[202.212313, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.212341, "o", "> "]
[202.212368, "o", "        self._S = 128\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212394, "o", "        self._BLOCK = 4096\r\n\u001b[?2004l\r"]
[202.212419, "o", "\u001b[?2004h> "]
[202.212449, "o", "        self._part = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.212475, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212543, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[202.212572, "o", "\u001b[?2004h> "]
[202.212599, "o", "        R = x.numel() // self.N\r\n\u001b[?2004l\r"]
[202.212626, "o", "\u001b[?2004h> "]
[202.212653, "o", "        S = self._S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212686, "o", "        if self.N % S != 0:\r\n\u001b[?2004l\r"]
[202.212709, "o", "\u001b[?2004h> "]
[202.2128, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[202.212829, "o", "\u001b[?2004h> "]
[202.212856, "o", "        CHUNK = self.N // S\r\n\u001b[?2004l\r"]
[202.212883, "o", "\u001b[?2004h> "]
[202.21291, "o", "        BLOCK = self._BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.212947, "o", "        while BLOCK > CHUNK:\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.212974, "o", "> "]
[202.213002, "o", "            BLOCK //= 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.213041, "o", "        if CHUNK % BLOCK != 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.213072, "o", "> "]
[202.213152, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[202.213181, "o", "\u001b[?2004h> "]
[202.213208, "o", "        dev = x.device\r\n\u001b[?2004l\r"]
[202.213236, "o", "\u001b[?2004h> "]
[202.213323, "o", "        if self._part is None or self._part.device != dev or self._part.shape[0] != R * S * 2:\r\n\u001b[?2004l\r"]
[202.213351, "o", "\u001b[?2004h> "]
[202.213426, "o", "            self._part = torch.empty(R * S * 2, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[202.213456, "o", "\u001b[?2004h> "]
[202.213485, "o", "        part = self._part\r\n\u001b[?2004l\r"]
[202.213511, "o", "\u001b[?2004h> "]
[202.213536, "o", "        out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[202.213561, "o", "\u001b[?2004h> "]
[202.213587, "o", "        x2 = x.reshape(-1)\r\n\u001b[?2004l\r"]
[202.213615, "o", "\u001b[?2004h> "]
[202.213643, "o", "        o2 = out.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.213671, "o", "> "]
[202.213703, "o", "        w = self.weight.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.213741, "o", "        b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[202.213768, "o", "\u001b[?2004h> "]
[202.213858, "o", "        _reduce_kernel[(R, S)](x2, part, self.N, CHUNK=CHUNK, BLOCK=BLOCK, S=S, num_warps=8)\r\n\u001b[?2004l\r"]
[202.213887, "o", "\u001b[?2004h> "]
[202.213948, "o", "        _norm_kernel[(R, S)](x2, w, b, part, o2, self.N, self.eps,\r\n\u001b[?2004l\r"]
[202.213973, "o", "\u001b[?2004h> "]
[202.214044, "o", "                             CHUNK=CHUNK, BLOCK=BLOCK, S=S, num_warps=8)\r\n\u001b[?2004l\r"]
[202.214073, "o", "\u001b[?2004h> "]
[202.2141, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.214127, "o", "EOF\r\n\u001b[?2004l\r"]
[202.21628, "o", "\u001b[?2004hroot@modal:/# "]
[202.216343, "o", "echo done\r\n\u001b[?2004l\rdone\r\n\u001b[?2004hroot@modal:/# "]
[202.394346, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\nfrom kernelbench import timing\n\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).to(dev)\nnew = ModelNew(*get_init_inputs()).to(dev)\nx = get_inputs()[0].to(dev)\nwith torch.no_grad():\n    a = ref(x)\n    b = new(x)\n    print('max diff', (a-b).abs().max().item())\n    print('allclose', torch.allclose(a, b, atol=1e-4, rtol=1e-4))\n    t_ref = timing.time_execution_with_cuda_event(ref, [x], num_trials=20, verbose=False, device=dev)\n    t_new = timing.time_execution_with_cuda_event(new, [x], num_trials=20, verbose=False, device=dev)\nimport numpy as np\nprint('ref ms', np.mean(t_ref), 'new ms', np.mean(t_new), 'speedup', np.mean(t_ref)/np.mean(t_new))\nEOF\ngpu run -- python3 /workspace/bench.py\n"]
[202.394538, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[202.394595, "o", "\u001b[?2004h> import sys, torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.394631, "o", "sys.path.insert(0, '/opt/task')\r\n\u001b[?2004l\r"]
[202.394655, "o", "\u001b[?2004h> "]
[202.394684, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[202.394705, "o", "\u001b[?2004h> "]
[202.394768, "o", "from reference import Model, get_inputs, get_init_inputs\r\n\u001b[?2004l\r"]
[202.394783, "o", "\u001b[?2004h> "]
[202.394861, "o", "from solution import ModelNew\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.394891, "o", "from kernelbench import timing\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[202.394917, "o", "> "]
[202.394943, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[202.394964, "o", "\u001b[?2004h> "]
[202.394992, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.395048, "o", "ref = Model(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.395071, "o", "> "]
[202.395107, "o", "new = ModelNew(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[202.395132, "o", "\u001b[?2004h> "]
[202.395158, "o", "x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r"]
[202.395186, "o", "\u001b[?2004h> "]
[202.395214, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.395243, "o", "    a = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.395271, "o", "    b = new(x)\r\n\u001b[?2004l\r"]
[202.3953, "o", "\u001b[?2004h> "]
[202.395333, "o", "    print('max diff', (a-b).abs().max().item())\r\n\u001b[?2004l\r"]
[202.39536, "o", "\u001b[?2004h> "]
[202.395421, "o", "    print('allclose', torch.allclose(a, b, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r"]
[202.395434, "o", "\u001b[?2004h> "]
[202.395567, "o", "    t_ref = timing.time_execution_with_cuda_event(ref, [x], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[202.395596, "o", "> "]
[202.395685, "o", "    t_new = timing.time_execution_with_cuda_event(new, [x], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[202.395716, "o", "\u001b[?2004h> "]
[202.395752, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[202.395846, "o", "print('ref ms', np.mean(t_ref), 'new ms', np.mean(t_new), 'speedup', np.mean(t_ref)/np.mean(t_new))\r\n\u001b[?2004l\r"]
[202.395876, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[202.397526, "o", "\u001b[?2004hroot@modal:/# "]
[202.397591, "o", "gpu run -- python3 /workspace/bench.py\r\n\u001b[?2004l\r"]
