[608.068352, "o", "            for W in [4, 8, 16]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.068393, "o", "                if BLOCK > 4194304 // S:\r\n\u001b[?2004l\r"]
[608.068436, "o", "\u001b[?2004h>                     continue\r\n\u001b[?2004l\r"]
[608.068478, "o", "\u001b[?2004h> "]
[608.068533, "o", "                new._S, new._BLOCK, new._warps = S, BLOCK, W\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.06857, "o", "> "]
[608.068607, "o", "                new._part = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.068649, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.068691, "o", "                    b = new(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.068771, "o", "                    ok = torch.allclose(a, b, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[608.068813, "o", "\u001b[?2004h> "]
[608.06886, "o", "                    if not ok:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.068924, "o", "                        print(S, BLOCK, W, 'INCORRECT')\r\n\u001b[?2004l\r"]
[608.068964, "o", "\u001b[?2004h> "]
[608.069005, "o", "                        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.069134, "o", "                    t = timing.time_execution_with_cuda_event(new, [x], num_trials=10, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.069186, "o", "                    m = np.mean(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.069236, "o", "> "]
[608.069276, "o", "                    results.append((m, S, BLOCK, W))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.069374, "o", "                    print(f'S={S} BLOCK={BLOCK} warps={W}: {m*1000:.1f} us')\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.069414, "o", "> "]
[608.069453, "o", "                except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[608.069519, "o", "                    print(S, BLOCK, W, 'ERR', str(e)[:80])\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.069558, "o", ">     results.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[608.069598, "o", "> "]
[608.069639, "o", "    print('BEST:', results[:5])\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
