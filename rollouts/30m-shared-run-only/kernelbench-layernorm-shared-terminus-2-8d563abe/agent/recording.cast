[930.681889, "o", "cat > /workspace/sweep3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.681921, "o", "import sys, torch, numpy as np\r\n\u001b[?2004l\r"]
[930.681942, "o", "\u001b[?2004h> "]
[930.681974, "o", "sys.path.insert(0, '/opt/task')\r\n\u001b[?2004l\r"]
[930.682002, "o", "\u001b[?2004h> "]
[930.68203, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[930.682059, "o", "\u001b[?2004h> "]
[930.682109, "o", "from reference import Model, get_inputs, get_init_inputs\r\n\u001b[?2004l\r"]
[930.682133, "o", "\u001b[?2004h> "]
[930.682157, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[930.682181, "o", "\u001b[?2004h> "]
[930.682209, "o", "from kernelbench import timing\r\n\u001b[?2004l\r"]
[930.682237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[930.682266, "o", "> dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[930.682301, "o", "\u001b[?2004h> "]
[930.68233, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.682353, "o", "> "]
[930.682381, "o", "ref = Model(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[930.682405, "o", "\u001b[?2004h> "]
[930.682445, "o", "new = ModelNew(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[930.682469, "o", "\u001b[?2004h> "]
[930.682497, "o", "x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r"]
[930.682521, "o", "\u001b[?2004h> "]
[930.682546, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.682572, "o", "    a = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.682599, "o", "> "]
[930.682622, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.682647, "o", "    for S in [128, 256]:\r\n\u001b[?2004l\r"]
[930.68268, "o", "\u001b[?2004h> "]
[930.682708, "o", "        for BLOCK in [2048, 4096, 8192]:\r\n\u001b[?2004l\r"]
[930.682736, "o", "\u001b[?2004h> "]
[930.68276, "o", "            for W in [8, 16]:\r\n\u001b[?2004l\r"]
[930.682789, "o", "\u001b[?2004h> "]
[930.68282, "o", "                if BLOCK > 4194304 // S:\r\n\u001b[?2004l\r"]
[930.682848, "o", "\u001b[?2004h> "]
[930.682874, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.682899, "o", "> "]
[930.682952, "o", "                new._S, new._BLOCK, new._warps = S, BLOCK, W\r\n\u001b[?2004l\r"]
[930.682977, "o", "\u001b[?2004h> "]
[930.683005, "o", "                new._part = None\r\n\u001b[?2004l\r"]
[930.683037, "o", "\u001b[?2004h> "]
[930.683062, "o", "                b = new(x)\r\n\u001b[?2004l\r"]
[930.683084, "o", "\u001b[?2004h> "]
[930.683147, "o", "                ok = torch.allclose(a, b, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[930.683172, "o", "\u001b[?2004h> "]
[930.683196, "o", "                if not ok:\r\n\u001b[?2004l\r"]
[930.683223, "o", "\u001b[?2004h> "]
[930.683276, "o", "                    print(S, BLOCK, W, 'INCORRECT'); continue\r\n\u001b[?2004l\r"]
[930.683305, "o", "\u001b[?2004h> "]
[930.683426, "o", "                t = timing.time_execution_with_cuda_event(new, [x], num_trials=15, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.683453, "o", "> "]
[930.683477, "o", "                m = np.mean(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.683506, "o", "> "]
[930.683541, "o", "                results.append((m, S, BLOCK, W))\r\n\u001b[?2004l\r"]
[930.683568, "o", "\u001b[?2004h> "]
[930.683637, "o", "                print(f'S={S} BLOCK={BLOCK} warps={W}: {m*1000:.1f} us')\r\n\u001b[?2004l\r"]
[930.68366, "o", "\u001b[?2004h> "]
[930.683688, "o", "    results.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[930.683715, "o", "> "]
[930.683738, "o", "    print('BEST:', results[:5])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[930.683766, "o", "EOF\r\n\u001b[?2004l\r"]
