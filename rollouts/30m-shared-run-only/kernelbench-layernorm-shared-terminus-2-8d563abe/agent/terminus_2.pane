import sys, torch, numpy as np
sys.path.insert(0, '/opt/task')
sys.path.insert(0, '/workspace')
from reference import Model, get_inputs, get_init_inputs
from solution import ModelNew
from kernelbench import timing

dev = torch.device('cuda')
torch.manual_seed(42)
ref = Model(*get_init_inputs()).to(dev)
new = ModelNew(*get_init_inputs()).to(dev)
x = get_inputs()[0].to(dev)
with torch.no_grad():
    a = ref(x)
    results = []
    for S in [64, 128, 256]:
        for BLOCK in [2048, 4096, 8192]:
            for W in [8, 16]:
                if BLOCK > 4194304 // S:
                    continue
                new._S, new._BLOCK, new._warps = S, BLOCK, W
                new._part = None
                b = new(x)
                ok = torch.allclose(a, b, atol=1e-4, rtol=1e-4)
                if not ok:
                    print(S, BLOCK, W, 'INCORRECT'); continue
                t = timing.time_execution_with_cuda_event(new, [x], num_trials=15, verbose=F[?2004h> import torch
