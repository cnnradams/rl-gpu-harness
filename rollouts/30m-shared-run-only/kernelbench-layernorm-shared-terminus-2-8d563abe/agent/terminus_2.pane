[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l [?2004h> 
[?2004l [?2004h> @triton.jit
[?2004l[?2004h> def _reduce_kernel(x_ptr, part_ptr, N, CHUNK: tl.constexpr, BLOCK: tl.constexpr, S: tl.constexpr):
[?2004l[?2004h>     row = tl.program_id(0)
[?2004l[?2004h>     sp = tl.program_id(1)
[?2004l[?2004h>     base = row * N + sp * CHUNK
[?2004l[?2004h>     acc = tl.zeros((BLOCK,), dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros((BLOCK,), dtype=tl.float32)
[?2004l[?2004h>     for off in range(0, CHUNK, BLOCK):
[?2004l[?2004h>         v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))
[?2004l[?2004h>         acc += v
[?2004l[?2004h>         acc2 += v * v
[?2004l[?2004h>     s = tl.sum(acc)
[?2004l[?2004h>     s2 = tl.sum(acc2)
[?2004l[?2004h>     tl.store(part_ptr + (row * S + sp) * 2, s)
[?2004l[?2004h>     tl.store(part_ptr + (row * S + sp) * 2 + 1, s2)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _norm_kernel(x_ptr, w_ptr, b_ptr, part_ptr, out_ptr, N, eps,
[?2004l[?2004h>                  CHUNK: tl.constexpr, BLOCK: tl.constexpr, S: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     row = pid // S
[?2004l[?2004h>     sp = pid % S
[?2004l[?2004h>     offs = tl.arange(0, S)
[?2004l[?2004h>     ps = tl.load(part_ptr + (row * S + offs) * 2)
[?2004l[?2004h>     ps2 = tl.load(part_ptr + (row * S + offs) * 2 + 1)
[?2004l[?2004h>     mean = tl.sum(ps) / N
[?2004l[?2004h>     var = tl.sum(ps2) / N - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     base = row * N + sp * CHUNK
[?2004l[?2004h>     col = sp * CHUNK
[?2004l[?2004h>     for off in range(0, CHUNK, BLOCK):
[?2004l[?2004h>         idx = off + tl.arange(0, BLOCK)
[?2004l[?2004h>         v = tl.load(x_ptr + base + idx)
[?2004l[?2004h>         w = tl.load(w_ptr + col + idx)
[?2004l[?2004h>         b = tl.load(b_ptr + col + idx)
