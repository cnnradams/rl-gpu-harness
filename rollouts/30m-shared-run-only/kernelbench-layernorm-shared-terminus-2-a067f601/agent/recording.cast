[565.026858, "o", "def timeit(fn, args, warmup=3, trials=15, discard=1):\r\n\u001b[?2004l\r"]
[565.026893, "o", "\u001b[?2004h> "]
[565.026947, "o", "    for _ in range(warmup):\r\n\u001b[?2004l\r"]
[565.026978, "o", "\u001b[?2004h> "]
[565.027105, "o", "        fn(*args); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[565.027139, "o", "\u001b[?2004h> "]
[565.02717, "o", "    times=[]\r\n\u001b[?2004l\r"]
[565.0272, "o", "\u001b[?2004h> "]
[565.027272, "o", "    for t in range(trials+discard):\r\n\u001b[?2004l\r"]
[565.027302, "o", "\u001b[?2004h> "]
[565.027379, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[565.02741, "o", "\u001b[?2004h> "]
[565.027605, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[565.027634, "o", "\u001b[?2004h> "]
[565.027664, "o", "        clear_l2()\r\n\u001b[?2004l\r"]
[565.027694, "o", "\u001b[?2004h> "]
[565.027736, "o", "        s.record()\r\n\u001b[?2004l\r"]
[565.027766, "o", "\u001b[?2004h> "]
[565.027808, "o", "        fn(*args)\r\n\u001b[?2004l\r"]
[565.027838, "o", "\u001b[?2004h> "]
[565.027882, "o", "        e.record()\r\n\u001b[?2004l\r"]
[565.027912, "o", "\u001b[?2004h> "]
[565.02798, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[565.02801, "o", "\u001b[?2004h> "]
[565.028139, "o", "        if t>=discard: times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[565.028167, "o", "\u001b[?2004h> "]
[565.028225, "o", "    times.sort()\r\n\u001b[?2004l\r,"]
[565.028251, "o", "\u001b[?2004h> "]
[565.028361, "o", "    return sum(times)/len(times), times[0]\r\n\u001b[?2004l\r"]
[565.028387, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rx\u001b[?2004h> "]
[565.028503, "o", "x = torch.rand(B,F,D1,D2, device=dev)\r\n\u001b[?2004l\r"]
[565.02853, "o", "\u001b[?2004h"]
[565.028561, "o", "> "]
[565.028622, "o", "ln = nn.LayerNorm((F,D1,D2)).to(dev)\r\n\u001b[?2004l\r"]
[565.028652, "o", "\u001b[?2004h> "]
[565.028683, "o", "ref = ln(x)\r\n\u001b[?2004l\rn\u001b[?2004h> \r\n\u001b[?2004l\r"]
[565.028713, "o", "\u001b[?2004h> "]
[565.028745, "o", "# floor: pure copy\r\n\u001b[?2004l\r"]
[565.028775, "o", "\u001b[?2004h> "]
[565.028837, "o", "yc = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[565.028867, "o", "\u001b[?2004h> "]
[565.028954, "o", "def cp(): torch.ops.aten.copy_(yc, x)\r\n\u001b[?2004l\r"]
[565.028981, "o", "\u001b[?2004h> "]
[565.029063, "o", "mean, mn = timeit(lambda t: cp(), [x])\r\n\u001b[?2004l\r"]
[565.029093, "o", "\u001b[?2004h> "]
[565.029261, "o", "print(f'copy floor: {mean:.4f} ms ({2*x.numel()*4/mean/1e9:.2f} TB/s)')\r\n\u001b[?2004l\r"]
[565.029292, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[565.029323, "o", "> "]
[565.029354, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.029629, "o", "def stats_kernel(X, PS, PS2, pid_offset, CHUNK: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.029661, "o", "> "]
[565.029708, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[565.029738, "o", "\u001b[?2004h> "]
[565.029783, "o", "    row = pid // S\r\n\u001b[?2004l\r"]
[565.029814, "o", "\u001b[?2004h> "]
[565.029844, "o", "    ch = pid % S\r\n\u001b[?2004l\r"]
[565.029874, "o", "\u001b[?2004h> "]
[565.029955, "o", "    base = row * (CHUNK * S) + ch * CHUNK\r\n\u001b[?2004l\r"]
[565.029986, "o", "\u001b[?2004h> "]
[565.03011, "o", "    acc1 = tl.zeros((BLOCK,), tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.030144, "o", "> "]
[565.030236, "o", "    acc2 = tl.zeros((BLOCK,), tl.float32)\r\n\u001b[?2004l\r"]
[565.030267, "o", "\u001b[?2004h> "]
[565.030363, "o", "    for off in tl.static_range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[565.030393, "o", "\u001b[?2004h> "]
[565.030425, "o", "        if EV:\r\n\u001b[?2004l\r"]
[565.030456, "o", "\u001b[?2004h> "]
[565.030638, "o", "            v = tl.load(X + base + off + tl.arange(0, BLOCK), eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[565.030667, "o", "\u001b[?2004h> "]
[565.030697, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.030805, "o", "            v = tl.load(X + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[565.03083, "o", "\u001b[?2004h> "]
[565.030863, "o", "        acc1 += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.030891, "o", "> "]
[565.030921, "o", "        acc2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.030987, "o", "    tl.store(PS + pid, tl.sum(acc1))\r\n\u001b[?2004l\r"]
[565.031018, "o", "\u001b[?2004h> "]
[565.031069, "o", "    tl.store(PS2 + pid, tl.sum(acc2))\r\n\u001b[?2004l\r"]
[565.0311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.031137, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.031382, "o", "def norm_kernel(X, Y, W, Bias, PS, PS2, eps, CHUNK: tl.constexpr, S: tl.constexpr, SPOW: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.031438, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.031469, "o", "> "]
[565.031499, "o", "    row = pid // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.03153, "o", "    ch = pid % S\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.03156, "o", "> "]
[565.031586, "o", "    offs = tl.arange(0, SPOW)\r\n\u001b[?2004l\r"]
[565.031617, "o", "\u001b[?2004h> "]
[565.031647, "o", "    pm = offs < S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.031742, "o", "    p1 = tl.load(PS + row*S + offs, mask=pm, other=0.0)\r\n\u001b[?2004l\r"]
[565.031775, "o", "\u001b[?2004h> "]
[565.031847, "o", "    p2 = tl.load(PS2 + row*S + offs, mask=pm, other=0.0)\r\n\u001b[?2004l\r"]
[565.031878, "o", "\u001b[?2004h> "]
[565.031909, "o", "    NN = CHUNK * S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.031955, "o", "    mean = tl.sum(p1) / NN\r\n\u001b[?2004l\r"]
[565.031985, "o", "\u001b[?2004h> "]
[565.032032, "o", "    var = tl.sum(p2) / NN - mean*mean\r\n\u001b[?2004l\r"]
[565.032063, "o", "\u001b[?2004h> "]
[565.032107, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[565.032141, "o", "\u001b[?2004h> "]
[565.032191, "o", "    base = row * NN + ch * CHUNK\r\n\u001b[?2004l\r"]
[565.032209, "o", "\u001b[?2004h> "]
[565.032245, "o", "    wbase = ch * CHUNK\r\n\u001b[?2004l\r"]
[565.03228, "o", "\u001b[?2004h> "]
[565.032339, "o", "    for off in tl.static_range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[565.032381, "o", "\u001b[?2004h> "]
[565.032416, "o", "        c = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[565.032447, "o", "\u001b[?2004h> "]
[565.032478, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.032587, "o", "            v = tl.load(X + base + c, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[565.032612, "o", "\u001b[?2004h> "]
[565.032665, "o", "            w = tl.load(W + wbase + c)\r\n\u001b[?2004l\r"]
[565.032697, "o", "\u001b[?2004h> "]
[565.032749, "o", "            b = tl.load(Bias + wbase + c)\r\n\u001b[?2004l\r"]
[565.03278, "o", "\u001b[?2004h> "]
[565.032914, "o", "            tl.store(Y + base + c, (v - mean) * rstd * w + b, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.032948, "o", ">         else:\r\n\u001b[?2004l\r"]
[565.032979, "o", "\u001b[?2004h> "]
[565.033027, "o", "            v = tl.load(X + base + c)\r\n\u001b[?2004l\r"]
[565.033058, "o", "\u001b[?2004h> "]
[565.033106, "o", "            w = tl.load(W + wbase + c)\r\n\u001b[?2004l\r"]
[565.033139, "o", "\u001b[?2004h> "]
[565.033193, "o", "            b = tl.load(Bias + wbase + c)\r\n\u001b[?2004l\r"]
[565.033224, "o", "\u001b[?2004h> "]
[565.033307, "o", "            tl.store(Y + base + c, (v - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[565.033338, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.033393, "o", "class SplitLN(nn.Module):\r\n\u001b[?2004l\r"]
[565.033424, "o", "\u001b[?2004h> "]
[565.033514, "o", "    def __init__(self, shape, chunk, block, warps, stages, ev):\r\n\u001b[?2004l\r"]
[565.033546, "o", "\u001b[?2004h> "]
[565.033576, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[565.033607, "o", "\u001b[?2004h> "]
[565.033684, "o", "        self.weight = nn.Parameter(torch.ones(shape))\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.033715, "o", "> "]
[565.033785, "o", "        self.bias = nn.Parameter(torch.zeros(shape))\r\n\u001b[?2004l\r"]
[565.033817, "o", "\u001b[?2004h> "]
[565.033848, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.03388, "o", "> "]
[565.033997, "o", "        self.chunk=chunk; self.block=block; self.w=warps; self.st=stages; self.ev=ev\r\n\u001b[?2004l\r"]
[565.034028, "o", "\u001b[?2004h> "]
[565.034059, "o", "        self.S = N // chunk\r\n\u001b[?2004l\r"]
[565.03409, "o", "\u001b[?2004h> "]
[565.034173, "o", "        self.ps = torch.empty(rows*self.S, device=dev)\r\n\u001b[?2004l\r"]
[565.0342, "o", "\u001b[?2004h> "]
[565.034281, "o", "        self.ps2 = torch.empty(rows*self.S, device=dev)\r\n\u001b[?2004l\r"]
[565.034312, "o", "\u001b[?2004h> "]
[565.034349, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[565.034379, "o", "\u001b[?2004h> "]
[565.03442, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[565.034451, "o", "\u001b[?2004h> "]
[565.034539, "o", "        w = self.weight.reshape(-1); b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[565.034564, "o", "\u001b[?2004h> "]
[565.034596, "o", "        S = self.S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.034845, "o", "        stats_kernel[(rows*S,)](x, self.ps, self.ps2, 0, CHUNK=self.chunk, S=S, BLOCK=self.block, EV=self.ev, num_warps=self.w, num_stages=self.st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.034864, "o", "> "]
[565.035174, "o", "        norm_kernel[(rows*S,)](x, y, w, b, self.ps, self.ps2, self.eps, CHUNK=self.chunk, S=S, SPOW=triton.next_power_of_2(S), BLOCK=self.block, EV=self.ev, num_warps=self.w, num_stages=self.st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.035203, "o", "> "]
[565.035234, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[565.035266, "o", "> "]
[565.035298, "o", "class GraphLN(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.03541, "o", "    def __init__(self, shape, chunk, block, warps, stages, ev):\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.035443, "o", "> "]
[565.035474, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.035598, "o", "        self.inner = SplitLN(shape, chunk, block, warps, stages, ev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.035705, "o", "        self.g = None; self.key = None; self.key_pending = None\r\n\u001b[?2004l\r"]
[565.035736, "o", "\u001b[?2004h> "]
[565.035767, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.035798, "o", "> "]
[565.03585, "o", "        key = (x.data_ptr(), tuple(x.shape))\r\n\u001b[?2004l\r"]
[565.035881, "o", "\u001b[?2004h> "]
[565.03595, "o", "        if self.g is not None and key == self.key:\r\n\u001b[?2004l\r"]
[565.035981, "o", "\u001b[?2004h> "]
[565.036038, "o", "            self.g.replay(); return self.out\r\n\u001b[?2004l\r"]
[565.036069, "o", "\u001b[?2004h> "]
[565.036111, "o", "        if key == self.key_pending:\r\n\u001b[?2004l\r"]
[565.036151, "o", "\u001b[?2004h> "]
[565.036227, "o", "            self.inner(x); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.036258, "o", "> "]
[565.036309, "o", "            self.g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[565.03634, "o", "\u001b[?2004h> "]
[565.036394, "o", "            with torch.cuda.graph(self.g):\r\n\u001b[?2004l\r"]
[565.036426, "o", "\u001b[?2004h> "]
[565.036476, "o", "                self.out = self.inner(x)\r\n\u001b[?2004l\r"]
[565.036506, "o", "\u001b[?2004h> "]
[565.036538, "o", "            self.key = key\r\n\u001b[?2004l\r"]
[565.036569, "o", "\u001b[?2004h> "]
[565.036623, "o", "            self.g.replay(); return self.out\r\n\u001b[?2004l\r"]
[565.036654, "o", "\u001b[?2004h> "]
[565.036685, "o", "        self.key_pending = key\r\n\u001b[?2004l\r"]
[565.036716, "o", "\u001b[?2004h> "]
[565.036747, "o", "        return self.inner(x)\r\n\u001b[?2004l\r"]
[565.036779, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.036811, "o", "results=[]\r\n\u001b[?2004l\r"]
[565.036842, "o", "\u001b[?2004h> "]
[565.036894, "o", "for chunk in (32768, 65536, 131072):\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.036925, "o", "> "]
[565.036967, "o", "    for block in (2048, 4096, 8192):\r\n\u001b[?2004l\r"]
[565.036999, "o", "\u001b[?2004h> "]
[565.03703, "o", "        for warps in (4, 8):\r\n\u001b[?2004l\r"]
[565.037056, "o", "\u001b[?2004h> "]
[565.037107, "o", "            for ev in (False, True):\r\n\u001b[?2004l\r"]
[565.037144, "o", "\u001b[?2004h> "]
[565.037208, "o", "                cfg = (chunk, block, warps, 3, ev)\r\n\u001b[?2004l\r"]
[565.037239, "o", "\u001b[?2004h> "]
[565.037265, "o", "                try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.037364, "o", "                    m = SplitLN((F,D1,D2), *cfg).to(dev)\r\n\u001b[?2004l\r"]
[565.03739, "o", "\u001b[?2004h> "]
[565.037468, "o", "                    md = (m(x)-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[565.037499, "o", "\u001b[?2004h> "]
[565.03759, "o", "                    if md > 5e-5: print('FAIL', cfg, md); continue\r\n\u001b[?2004l\r"]
[565.037621, "o", "\u001b[?2004h> "]
[565.037698, "o", "                    gm = GraphLN((F,D1,D2), *cfg).to(dev)\r\n\u001b[?2004l\r"]
[565.037729, "o", "\u001b[?2004h> "]
[565.037775, "o", "                    gm(x); g2 = gm(x)\r\n\u001b[?2004l\r"]
[565.037806, "o", "\u001b[?2004h> "]
[565.037877, "o", "                    gmd = (g2-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[565.037908, "o", "\u001b[?2004h> "]
[565.038003, "o", "                    if gmd > 5e-5: print('GFAIL', cfg, gmd); continue\r\n\u001b[?2004l\r"]
[565.038036, "o", "\u001b[?2004h> "]
[565.038114, "o", "                    gmean, gmn = timeit(gm, [x], trials=15)\r\n\u001b[?2004l\r"]
[565.038149, "o", "\u001b[?2004h> "]
[565.038213, "o", "                    results.append((gmean, cfg))\r\n\u001b[?2004l\r"]
[565.038245, "o", "\u001b[?2004h> "]
[565.038431, "o", "                    print(f'chunk={chunk} block={block} w={warps} ev={ev}: graph {gmean:.4f} (min {gmn:.4f}) md={gmd:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[565.038457, "o", "> "]
[565.038507, "o", "                except Exception as ex:\r\n\u001b[?2004l\r"]
[565.038538, "o", "\u001b[?2004h> "]
[565.038612, "o", "                    print('ERR', cfg, repr(ex)[:100])\r\n\u001b[?2004l\r"]
[565.038643, "o", "\u001b[?2004h> "]
[565.038675, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[565.038725, "o", "print('TOP5:', results[:5])\r\n\u001b[?2004l\r"]
[565.038756, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[565.040304, "o", "\u001b[?2004hroot@modal:/# "]
[565.040382, "o", "gpu run -- python3 /workspace/bench4.py\r\n\u001b[?2004l\r"]
