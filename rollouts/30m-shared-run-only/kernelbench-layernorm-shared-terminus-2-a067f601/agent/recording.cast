[210.013994, "o", "\u001b[?2004h> "]
[210.014088, "o", "            m = TriLN((F,D1,D2), block, loop, warps).to(dev)\r\n\u001b[?2004l\r"]
[210.014117, "o", "\u001b[?2004h> "]
[210.014148, "o", "            md = check(m)\r\n\u001b[?2004l\r"]
[210.014174, "o", "\u001b[?2004h> "]
[210.014211, "o", "            if md > 1e-4: \r\n\u001b[?2004l\r"]
[210.01425, "o", "\u001b[?2004h> "]
