[664.220798, "o", "            self._bufs[bkey] = bufs\r\n\u001b[?2004l\r"]
[664.220828, "o", "\u001b[?2004h> "]
[664.22086, "o", "        ps, ps2 = bufs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[664.220919, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[664.22095, "o", "\u001b[?2004h> "]
[664.220993, "o", "        w = self.weight.reshape(-1)\r\n\u001b[?2004l\r"]
[664.221024, "o", "\u001b[?2004h> "]
[664.221063, "o", "        b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[664.221094, "o", "\u001b[?2004h> "]
[664.221223, "o", "        _stats_kernel[(rows * S,)](x, ps, ps2, CHUNK=self.chunk, S=S, BLOCK=self.block,\r\n\u001b[?2004l\r"]
[664.221252, "o", "\u001b[?2004h> "]
[664.221365, "o", "                                   num_warps=self.warps, num_stages=self.stages)\r\n\u001b[?2004l\r"]
[664.221397, "o", "\u001b[?2004h> "]
[664.221484, "o", "        _norm_kernel[(rows * S,)](x, y, w, b, ps, ps2, self.eps,\r\n\u001b[?2004l\r"]
[664.221515, "o", "\u001b[?2004h> "]
[664.221641, "o", "                                  CHUNK=self.chunk, S=S, SPOW=triton.next_power_of_2(S),\r\n\u001b[?2004l\r"]
[664.221673, "o", "\u001b[?2004h> "]
[664.22181, "o", "                                  BLOCK=self.block, num_warps=self.warps, num_stages=self.stages)\r\n\u001b[?2004l\r"]
[664.221842, "o", "\u001b[?2004h> "]
[664.221873, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[664.221905, "o", "\u001b[?2004h> "]
[664.221937, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[664.221968, "o", "> "]
[664.222, "o", "        rows = x.numel() // self.N\r\n\u001b[?2004l\r"]
[664.222031, "o", "\u001b[?2004h> "]
[664.222208, "o", "        if (not x.is_cuda) or x.dtype != torch.float32 or (self.N % self.chunk) != 0 or rows * self.N != x.numel():\r\n\u001b[?2004l\r\u001b[?2004h"]
[664.222236, "o", "> "]
[664.222366, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[664.222398, "o", "\u001b[?2004h> "]
[664.222429, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[664.22246, "o", "\u001b[?2004h> "]
[664.222615, "o", "        key = (x.data_ptr(), tuple(x.shape), self.weight.data_ptr(), self.bias.data_ptr(), x.device.index)\r\n\u001b[?2004l\r"]
[664.222647, "o", "\u001b[?2004h> "]
[664.222726, "o", "        if self._graph is not None and key == self._gkey:\r\n\u001b[?2004l\r"]
[664.222757, "o", "\u001b[?2004h> "]
[664.222795, "o", "            self._graph.replay()\r\n\u001b[?2004l\r"]
[664.222825, "o", "\u001b[?2004h> "]
[664.222858, "o", "            return self._gout\r\n\u001b[?2004l\r"]
[664.22289, "o", "\u001b[?2004h> "]
[664.22294, "o", "        if key == self._pending:\r\n\u001b[?2004l\r"]
[664.22297, "o", "\u001b[?2004h> "]
[664.223005, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[664.22305, "o", "                self._run(x)\r\n\u001b[?2004l\r"]
[664.223082, "o", "\u001b[?2004h> "]
[664.223139, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[664.223171, "o", "\u001b[?2004h> "]
[664.223228, "o", "                g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[664.223258, "o", "\u001b[?2004h> "]
[664.223314, "o", "                with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[664.223345, "o", "\u001b[?2004h> "]
[664.223408, "o", "                    self._gout = self._run(x)\r\n\u001b[?2004l\r"]
[664.223436, "o", "\u001b[?2004h> "]
[664.223479, "o", "                self._graph = g\r\n\u001b[?2004l\r"]
[664.223511, "o", "\u001b[?2004h> "]
[664.223552, "o", "                self._gkey = key\r\n\u001b[?2004l\r"]
[664.223583, "o", "\u001b[?2004h> "]
[664.223615, "o", "                g.replay()\r\n\u001b[?2004l\r"]
[664.223646, "o", "\u001b[?2004h> "]
[664.22369, "o", "                return self._gout\r\n\u001b[?2004l\r"]
[664.223721, "o", "\u001b[?2004h> "]
[664.223753, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[664.223784, "o", "\u001b[?2004h> "]
[664.223839, "o", "                self._pending = None\r\n\u001b[?2004l\r"]
[664.22387, "o", "\u001b[?2004h> "]
[664.223915, "o", "                self._graph = None\r\n\u001b[?2004l\r"]
[664.223946, "o", "\u001b[?2004h> "]
[664.223989, "o", "                self._gkey = None\r\n\u001b[?2004l\r"]
[664.22402, "o", "\u001b[?2004h> "]
[664.224068, "o", "                return self._run(x)\r\n\u001b[?2004l\r"]
[664.2241, "o", "\u001b[?2004h> "]
[664.224137, "o", "        self._pending = key\r\n\u001b[?2004l\r"]
[664.224168, "o", "\u001b[?2004h> "]
[664.224218, "o", "        return self._run(x)\r\n\u001b[?2004l\r"]
[664.224249, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
