[565.025453, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nrows = B\ndev='cuda'\n\ndef clear_l2(device='cuda'):\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device=device)\n    dummy.fill_(42)\n    del dummy\n\ndef timeit(fn, args, warmup=3, trials=15, discard=1):\n    for _ in range(warmup):\n        fn(*args); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+discard):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record()\n        fn(*args)\n        e.record()\n        torch.cuda.synchronize()\n        if t>=discard: times.append(s.elapsed_time(e))\n    times.sort()\n    return sum(times)/len(times), times[0]\n\nx = torch.rand(B,F,D1,D2, device=dev)\nln = nn.LayerNorm((F,D1,D2)).to(dev)\nref = ln(x)\n\n# floor: pure copy\nyc = torch.empty_like(x)\ndef cp(): torch.ops.aten.copy_(yc, x)\nmean, mn = timeit(lambda t: cp(), ["]
[565.025499, "i", "x])\nprint(f'copy floor: {mean:.4f} ms ({2*x.numel()*4/mean/1e9:.2f} TB/s)')\n\n@triton.jit\ndef stats_kernel(X, PS, PS2, pid_offset, CHUNK: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    ch = pid % S\n    base = row * (CHUNK * S) + ch * CHUNK\n    acc1 = tl.zeros((BLOCK,), tl.float32)\n    acc2 = tl.zeros((BLOCK,), tl.float32)\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        if EV:\n            v = tl.load(X + base + off + tl.arange(0, BLOCK), eviction_policy='evict_first')\n        else:\n            v = tl.load(X + base + off + tl.arange(0, BLOCK))\n        acc1 += v\n        acc2 += v * v\n    tl.store(PS + pid, tl.sum(acc1))\n    tl.store(PS2 + pid, tl.sum(acc2))\n\n@triton.jit\ndef norm_kernel(X, Y, W, Bias, PS, PS2, eps, CHUNK: tl.constexpr, S: tl.constexpr, SPOW: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    ch = pid % S\n    offs = tl.arange(0, SPOW)\n    pm = offs < S\n    p1 = tl."]
[565.025618, "i", "load(PS + row*S + offs, mask=pm, other=0.0)\n    p2 = tl.load(PS2 + row*S + offs, mask=pm, other=0.0)\n    NN = CHUNK * S\n    mean = tl.sum(p1) / NN\n    var = tl.sum(p2) / NN - mean*mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * NN + ch * CHUNK\n    wbase = ch * CHUNK\n    for off in tl.static_range(0, CHUNK, BLOCK):\n        c = off + tl.arange(0, BLOCK)\n        if EV:\n            v = tl.load(X + base + c, eviction_policy='evict_first')\n            w = tl.load(W + wbase + c)\n            b = tl.load(Bias + wbase + c)\n            tl.store(Y + base + c, (v - mean) * rstd * w + b, eviction_policy='evict_first')\n        else:\n            v = tl.load(X + base + c)\n            w = tl.load(W + wbase + c)\n            b = tl.load(Bias + wbase + c)\n            tl.store(Y + base + c, (v - mean) * rstd * w + b)\n\nclass SplitLN(nn.Module):\n    def __init__(self, shape, chunk, block, warps, stages, ev):\n        super().__init__()\n        self.weight = nn.Parameter(torch.ones(shape))\n        self.bias = nn.Parameter(to"]
[565.025647, "i", "rch.zeros(shape))\n        self.eps = 1e-5\n        self.chunk=chunk; self.block=block; self.w=warps; self.st=stages; self.ev=ev\n        self.S = N // chunk\n        self.ps = torch.empty(rows*self.S, device=dev)\n        self.ps2 = torch.empty(rows*self.S, device=dev)\n    def forward(self, x):\n        y = torch.empty_like(x)\n        w = self.weight.reshape(-1); b = self.bias.reshape(-1)\n        S = self.S\n        stats_kernel[(rows*S,)](x, self.ps, self.ps2, 0, CHUNK=self.chunk, S=S, BLOCK=self.block, EV=self.ev, num_warps=self.w, num_stages=self.st)\n        norm_kernel[(rows*S,)](x, y, w, b, self.ps, self.ps2, self.eps, CHUNK=self.chunk, S=S, SPOW=triton.next_power_of_2(S), BLOCK=self.block, EV=self.ev, num_warps=self.w, num_stages=self.st)\n        return y\n\nclass GraphLN(nn.Module):\n    def __init__(self, shape, chunk, block, warps, stages, ev):\n        super().__init__()\n        self.inner = SplitLN(shape, chunk, block, warps, stages, ev)\n        self.g = None; self.key = None; self.key_pending = None\n    def"]
[565.025688, "i", " forward(self, x):\n        key = (x.data_ptr(), tuple(x.shape))\n        if self.g is not None and key == self.key:\n            self.g.replay(); return self.out\n        if key == self.key_pending:\n            self.inner(x); torch.cuda.synchronize()\n            self.g = torch.cuda.CUDAGraph()\n            with torch.cuda.graph(self.g):\n                self.out = self.inner(x)\n            self.key = key\n            self.g.replay(); return self.out\n        self.key_pending = key\n        return self.inner(x)\n\nresults=[]\nfor chunk in (32768, 65536, 131072):\n    for block in (2048, 4096, 8192):\n        for warps in (4, 8):\n            for ev in (False, True):\n                cfg = (chunk, block, warps, 3, ev)\n                try:\n                    m = SplitLN((F,D1,D2), *cfg).to(dev)\n                    md = (m(x)-ref).abs().max().item()\n                    if md > 5e-5: print('FAIL', cfg, md); continue\n                    gm = GraphLN((F,D1,D2), *cfg).to(dev)\n                    gm(x); g2 = gm(x)\n                 "]
[565.025718, "i", "   gmd = (g2-ref).abs().max().item()\n                    if gmd > 5e-5: print('GFAIL', cfg, gmd); continue\n                    gmean, gmn = timeit(gm, [x], trials=15)\n                    results.append((gmean, cfg))\n                    print(f'chunk={chunk} block={block} w={warps} ev={ev}: graph {gmean:.4f} (min {gmn:.4f}) md={gmd:.2e}')\n                except Exception as ex:\n                    print('ERR', cfg, repr(ex)[:100])\nresults.sort()\nprint('TOP5:', results[:5])\nEOF\ngpu run -- python3 /workspace/bench4.py\n"]
