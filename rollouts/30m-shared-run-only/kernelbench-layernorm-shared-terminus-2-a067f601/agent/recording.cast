[347.058366, "o", "\u001b[?2004hroot@modal:/# "]
[396.497392, "i", "sed -i 's/        self.g = None\\n        self.key = None/&/' /workspace/bench2.py; python3 - << 'EOF'\nimport re\nsrc = open('/workspace/bench2.py').read()\nsrc = src.replace(\"        self.g = None\\n        self.key = None\\n\", \"        self.g = None\\n        self.key = None\\n        self.key_pending = None\\n\")\nopen('/workspace/bench2.py','w').write(src)\nprint('patched')\nEOF\ngpu run -- python3 /workspace/bench2.py\n"]
[396.497694, "o", "sed -i 's/        self.g = None\\n        self.key = None/&/' /workspace/bench2.py; python3 - << 'EOF'\r\n\u001b[?2004l\r"]
[396.497746, "o", "\u001b[?2004h> "]
