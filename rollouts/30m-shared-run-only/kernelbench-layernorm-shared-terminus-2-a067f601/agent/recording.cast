[210.013623, "o", "\u001b[?2004h> "]
[210.013648, "o", "    return md\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[210.01368, "o", "\u001b[?2004h> "]
[210.013716, "o", "for loop in (False, True):\r\n\u001b[?2004l\r"]
[210.013747, "o", "\u001b[?2004h> "]
