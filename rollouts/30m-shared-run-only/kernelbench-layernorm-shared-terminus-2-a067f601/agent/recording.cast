[471.240301, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2\nrows = B\ndev='cuda'\n\ndef clear_l2(device='cuda'):\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device=device)\n    dummy.fill_(42)\n    del dummy\n\ndef timeit(fn, args, warmup=3, trials=20, discard=1):\n    for _ in range(warmup):\n        fn(*args); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+discard):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record()\n        fn(*args)\n        e.record()\n        torch.cuda.synchronize()\n        if t>=discard: times.append(s.elapsed_time(e))\n    times.sort()\n    return sum(times)/len(times), times[0]\n\nx = torch.rand(B,F,D1,D2, device=dev)\nln = nn.LayerNorm((F,D1,D2)).to(dev)\nref = ln(x)\n\n@triton.jit\ndef stats_kernel(X, PS, PS2, N, CHUNK, S, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid "]
[471.240452, "i", "// S\n    ch = pid % S\n    base = row.to(tl.int64)*N + ch*CHUNK\n    s1 = tl.zeros((), tl.float32)\n    s2 = tl.zeros((), tl.float32)\n    for off in range(0, CHUNK, BLOCK):\n        v = tl.load(X + base + off + tl.arange(0, BLOCK))\n        s1 += tl.sum(v)\n        s2 += tl.sum(v*v)\n    tl.store(PS + pid, s1)\n    tl.store(PS2 + pid, s2)\n\n@triton.jit\ndef norm_kernel(X, Y, W, Bias, PS, PS2, N, CHUNK, S, eps, SPOW: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    ch = pid % S\n    offs = tl.arange(0, SPOW)\n    pm = offs < S\n    p1 = tl.load(PS + row*S + offs, mask=pm, other=0.0)\n    p2 = tl.load(PS2 + row*S + offs, mask=pm, other=0.0)\n    mean = tl.sum(p1) / N\n    var = tl.sum(p2) / N - mean*mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64)*N + ch*CHUNK\n    wbase = ch*CHUNK\n    for off in range(0, CHUNK, BLOCK):\n        c = off + tl.arange(0, BLOCK)\n        v = tl.load(X + base + c)\n        w = tl.load(W + wbase + c)\n        b = tl.load(Bias + wbase + c)\n        t"]
[471.240511, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.240548, "i", "l.store(Y + base + c, (v - mean) * rstd * w + b)\n\nclass SplitLN(nn.Module):\n    def __init__(self, shape, chunk, block, warps, stages):\n        super().__init__()\n        self.weight = nn.Parameter(torch.ones(shape))\n        self.bias = nn.Parameter(torch.zeros(shape))\n        self.eps = 1e-5\n        self.chunk=chunk; self.block=block; self.w=warps; self.st=stages\n        self.S = N // chunk\n        self.ps = torch.empty(rows*self.S, device=dev)\n        self.ps2 = torch.empty(rows*self.S, device=dev)\n    def forward(self, x):\n        y = torch.empty_like(x)\n        w = self.weight.reshape(-1); b = self.bias.reshape(-1)\n        S = self.S\n        stats_kernel[(rows*S,)](x, self.ps, self.ps2, N, self.chunk, S, BLOCK=self.block, num_warps=self.w, num_stages=self.st)\n        spow = triton.next_power_of_2(S)\n        norm_kernel[(rows*S,)](x, y, w, b, self.ps, self.ps2, N, self.chunk, S, self.eps, SPOW=spow, BLOCK=self.block, num_warps=self.w, num_stages=self.st)\n        return y\n\nclass GraphLN(nn.Module):\n    def "]
[471.240571, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.240668, "i", "__init__(self, shape, chunk, block, warps, stages):\n        super().__init__()\n        self.inner = SplitLN(shape, chunk, block, warps, stages)\n        self.g = None; self.key = None; self.key_pending = None\n    def forward(self, x):\n        key = (x.data_ptr(), tuple(x.shape))\n        if self.g is not None and key == self.key:\n            self.g.replay(); return self.out\n        if key == self.key_pending:\n            self.inner(x); torch.cuda.synchronize()\n            self.g = torch.cuda.CUDAGraph()\n            with torch.cuda.graph(self.g):\n                self.out = self.inner(x)\n            self.key = key\n            self.g.replay(); return self.out\n        self.key_pending = key\n        return self.inner(x)\n\nresults=[]\nfor chunk in (65536, 131072, 262144):\n    for block in (2048, 4096):\n        for warps in (4, 8):\n            for stages in (2, 3, 4):\n                cfg = (chunk, block, warps, stages)\n                try:\n                    m = SplitLN((F,D1,D2), *cfg).to(dev)\n                    md ="]
[471.240675, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.240709, "i", " (m(x)-ref).abs().max().item()\n                    if md > 5e-5:\n                        print('FAIL', cfg, md); continue\n                    mean, mn = timeit(m, [x], trials=10)\n                    gm = GraphLN((F,D1,D2), *cfg).to(dev)\n                    g1 = gm(x); g2 = gm(x)\n                    gmd = (g2-ref).abs().max().item()\n                    if gmd > 5e-5:\n                        print('GRAPH FAIL', cfg, gmd); continue\n                    gmean, gmn = timeit(gm, [x], trials=10)\n                    results.append((gmean, cfg))\n                    print(f'chunk={chunk} block={block} w={warps} st={stages}: eager {mean:.4f} graph {gmean:.4f} (min {gmn:.4f}) md={md:.2e}')\n                except Exception as ex:\n                    print('ERR', cfg, ex)\nresults.sort()\nprint('TOP5:', results[:5])\nEOF\ngpu run -- python3 /workspace/bench3.py\n"]
