[210.011495, "o", "\u001b[?2004h> "]
[210.011521, "o", "        m = cols < N\r\n\u001b[?2004l\r"]
[210.011548, "o", "\u001b[?2004h> "]
[210.011615, "o", "        v = tl.load(Xr+cols, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
