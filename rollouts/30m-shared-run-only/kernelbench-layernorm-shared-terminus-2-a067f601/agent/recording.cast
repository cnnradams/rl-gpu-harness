[210.011677, "o", "        mean = tl.sum(v)/N\r\n\u001b[?2004l\r"]
[210.011702, "o", "\u001b[?2004h> "]
[210.011759, "o", "        var = tl.sum(v*v)/N - mean*mean\r\n\u001b[?2004l\r"]
[210.01179, "o", "\u001b[?2004h> "]
[210.011836, "o", "        rstd = 1.0/tl.sqrt(var+eps)\r\n\u001b[?2004l\r"]
[210.011868, "o", "\u001b[?2004h> "]
[210.011931, "o", "        w = tl.load(W+cols, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[210.011963, "o", "\u001b[?2004h> "]
[210.012031, "o", "        b = tl.load(Bias+cols, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[210.012056, "o", "\u001b[?2004h> "]
[210.012135, "o", "        tl.store(Yr+cols, (v-mean)*rstd*w+b, mask=m)\r\n\u001b[?2004l\r"]
[210.012167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
