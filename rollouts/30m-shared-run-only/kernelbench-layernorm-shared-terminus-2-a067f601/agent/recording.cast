[331.579321, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.579352, "o", "> "]
[331.579491, "o", "def norm_kernel(X, Y, W, Bias, PS, PS2, N, CHUNK, S, eps, SPOW: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[331.579524, "o", "\u001b[?2004h> "]
[331.579554, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[331.579585, "o", "\u001b[?2004h> "]
[331.579615, "o", "    row = pid // S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.579645, "o", "    ch = pid % S\r\n\u001b[?2004l\r"]
[331.579677, "o", "\u001b[?2004h> "]
[331.579715, "o", "    offs = tl.arange(0, SPOW)\r\n\u001b[?2004l\r"]
[331.579744, "o", "\u001b[?2004h> "]
[331.579775, "o", "    pm = offs < S\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.579805, "o", "> "]
[331.579876, "o", "    p1 = tl.load(PS + row*S + offs, mask=pm, other=0.0)\r\n\u001b[?2004l\r"]
[331.579904, "o", "\u001b[?2004h> "]
[331.579986, "o", "    p2 = tl.load(PS2 + row*S + offs, mask=pm, other=0.0)\r\n\u001b[?2004l\r"]
[331.580016, "o", "\u001b[?2004h> "]
[331.580046, "o", "    mean = tl.sum(p1) / N\r\n\u001b[?2004l\r"]
[331.580076, "o", "\u001b[?2004h> "]
[331.580127, "o", "    var = tl.sum(p2) / N - mean*mean\r\n\u001b[?2004l\r"]
[331.580158, "o", "\u001b[?2004h> "]
[331.580218, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[331.580231, "o", "\u001b[?2004h> "]
[331.58031, "o", "    base = row.to(tl.int64)*N + ch*CHUNK\r\n\u001b[?2004l\r"]
[331.580337, "o", "\u001b[?2004h> "]
[331.580365, "o", "    wbase = ch*CHUNK\r\n\u001b[?2004l\r"]
[331.580402, "o", "\u001b[?2004h> "]
[331.580448, "o", "    for off in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[331.58048, "o", "\u001b[?2004h> "]
[331.58053, "o", "        c = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[331.580557, "o", "\u001b[?2004h> "]
[331.580606, "o", "        v = tl.load(X + base + c)\r\n\u001b[?2004l\r"]
[331.580641, "o", "\u001b[?2004h> "]
[331.580684, "o", "        w = tl.load(W + wbase + c)\r\n\u001b[?2004l\r"]
[331.580717, "o", "\u001b[?2004h> "]
[331.580767, "o", "        b = tl.load(Bias + wbase + c)\r\n\u001b[?2004l\r"]
[331.580799, "o", "\u001b[?2004h> "]
[331.580879, "o", "        tl.store(Y + base + c, (v - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[331.58091, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[331.58094, "o", "> "]
[331.580975, "o", "class SplitLN(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.581007, "o", "> "]
[331.581081, "o", "    def __init__(self, shape, chunk, block, warps1, warps2):\r\n\u001b[?2004l\r"]
[331.581114, "o", "\u001b[?2004h> "]
[331.581147, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[331.581181, "o", "\u001b[?2004h> "]
[331.581258, "o", "        self.weight = nn.Parameter(torch.ones(shape))\r\n\u001b[?2004l\r"]
[331.581292, "o", "\u001b[?2004h> "]
[331.581362, "o", "        self.bias = nn.Parameter(torch.zeros(shape))\r\n\u001b[?2004l\r"]
[331.581394, "o", "\u001b[?2004h> "]
[331.581428, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.581462, "o", "> "]
[331.581517, "o", "        self.chunk = chunk; self.block = block\r\n\u001b[?2004l\r"]
[331.581551, "o", "\u001b[?2004h> "]
[331.581608, "o", "        self.w1 = warps1; self.w2 = warps2\r\n\u001b[?2004l\r"]
[331.581643, "o", "\u001b[?2004h> "]
[331.581674, "o", "        self.S = N // chunk\r\n\u001b[?2004l\r"]
[331.581708, "o", "\u001b[?2004h> "]
[331.581781, "o", "        self.ps = torch.empty(rows*self.S, device=dev)\r\n\u001b[?2004l\r"]
[331.581814, "o", "\u001b[?2004h> "]
[331.581892, "o", "        self.ps2 = torch.empty(rows*self.S, device=dev)\r\n\u001b[?2004l\r"]
[331.581918, "o", "\u001b[?2004h> "]
[331.581956, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[331.58199, "o", "\u001b[?2004h> "]
[331.582027, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[331.58206, "o", "\u001b[?2004h> "]
[331.58215, "o", "        w = self.weight.reshape(-1); b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[331.582184, "o", "\u001b[?2004h> "]
[331.582221, "o", "        S = self.S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.582399, "o", "        stats_kernel[(rows*S,)](x, self.ps, self.ps2, N, self.chunk, S, BLOCK=self.block, num_warps=self.w1)\r\n\u001b[?2004l\r"]
[331.582417, "o", "\u001b[?2004h> "]
[331.58249, "o", "        spow = triton.next_power_of_2(S)\r\n\u001b[?2004l\r"]
[331.582525, "o", "\u001b[?2004h> "]
[331.582722, "o", "        norm_kernel[(rows*S,)](x, y, w, b, self.ps, self.ps2, N, self.chunk, S, self.eps, SPOW=spow, BLOCK=self.block, num_warps=self.w2)\r\n\u001b[?2004l\r"]
[331.582751, "o", "\u001b[?2004h> "]
[331.582775, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.582809, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.58285, "o", "class GraphLN(nn.Module):\r\n\u001b[?2004l\r"]
[331.582876, "o", "\u001b[?2004h> "]
[331.582971, "o", "    def __init__(self, shape, chunk, block, warps1, warps2):\r\n\u001b[?2004l\r"]
[331.583004, "o", "\u001b[?2004h> "]
[331.583031, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[331.583072, "o", "\u001b[?2004h> "]
[331.583179, "o", "        self.inner = SplitLN(shape, chunk, block, warps1, warps2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.583224, "o", "        self.g = None\r\n\u001b[?2004l\r"]
[331.583258, "o", "\u001b[?2004h> "]
[331.58329, "o", "        self.key = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.583321, "o", "> "]
[331.583354, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.583385, "o", "> "]
[331.583437, "o", "        key = (x.data_ptr(), tuple(x.shape))\r\n\u001b[?2004l\r"]
[331.58347, "o", "\u001b[?2004h> "]
[331.583538, "o", "        if self.g is not None and key == self.key:\r\n\u001b[?2004l\r"]
[331.583569, "o", "\u001b[?2004h> "]
[331.583601, "o", "            self.g.replay()\r\n\u001b[?2004l\r"]
[331.583632, "o", "\u001b[?2004h> "]
[331.583669, "o", "            return self.out\r\n\u001b[?2004l\r"]
[331.583701, "o", "\u001b[?2004h> "]
[331.583746, "o", "        if key == self.key_pending:\r\n\u001b[?2004l\r"]
[331.583778, "o", "\u001b[?2004h> "]
[331.58381, "o", "            # capture now\r\n\u001b[?2004l\r"]
[331.583843, "o", "\u001b[?2004h> "]
[331.583882, "o", "            self.inner(x)  # warm\r\n\u001b[?2004l\r"]
[331.583911, "o", "\u001b[?2004h> "]
[331.583961, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[331.583993, "o", "\u001b[?2004h> "]
[331.58405, "o", "            self.g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[331.584082, "o", "\u001b[?2004h> "]
[331.584139, "o", "            with torch.cuda.graph(self.g):\r\n\u001b[?2004l\r"]
[331.584168, "o", "\u001b[?2004h> "]
[331.58424, "o", "                self.out = self.inner(x)\r\n\u001b[?2004l\r"]
[331.584272, "o", "\u001b[?2004h> "]
[331.584305, "o", "            self.key = key\r\n\u001b[?2004l\r"]
[331.584337, "o", "\u001b[?2004h> "]
[331.584369, "o", "            self.g.replay()\r\n\u001b[?2004l\r"]
[331.584401, "o", "\u001b[?2004h> "]
[331.584434, "o", "            return self.out\r\n\u001b[?2004l\r"]
[331.584467, "o", "\u001b[?2004h> "]
[331.584501, "o", "        self.key_pending = key\r\n\u001b[?2004l\r"]
[331.584533, "o", "\u001b[?2004h> "]
[331.584565, "o", "        return self.inner(x)\r\n\u001b[?2004l\r"]
[331.584597, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[331.584624, "o", "> "]
[331.584656, "o", "configs = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.584728, "o", "for chunk in (4096, 8192, 16384, 32768, 65536):\r\n\u001b[?2004l\r"]
[331.58476, "o", "\u001b[?2004h> "]
[331.584807, "o", "    for block in (1024, 2048, 4096):\r\n\u001b[?2004l\r"]
[331.584837, "o", "\u001b[?2004h> "]
[331.584883, "o", "        if block > chunk: continue\r\n\u001b[?2004l\r"]
[331.584915, "o", "\u001b[?2004h> "]
[331.584947, "o", "        for w1 in (4, 8):\r\n\u001b[?2004l\r"]
[331.584979, "o", "\u001b[?2004h> "]
[331.585046, "o", "            configs.append((chunk, block, w1, w1))\r\n\u001b[?2004l\r"]
[331.585077, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.585109, "o", "best = None\r\n\u001b[?2004l\r"]
[331.585142, "o", "\u001b[?2004h> "]
[331.585174, "o", "for cfg in configs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[331.585241, "o", "    chunk, block, w1, w2 = cfg\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.585274, "o", ">     try:\r\n\u001b[?2004l\r"]
[331.585306, "o", "\u001b[?2004h> "]
[331.585388, "o", "        m = SplitLN((F,D1,D2), chunk, block, w1, w2).to(dev)\r\n\u001b[?2004l\r"]
[331.58542, "o", "\u001b[?2004h> "]
[331.585447, "o", "        out = m(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.585473, "o", "> "]
[331.585527, "o", "        md = (out-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[331.585553, "o", "\u001b[?2004h> "]
[331.58558, "o", "        if md > 1e-4:\r\n\u001b[?2004l\r"]
[331.585611, "o", "\u001b[?2004h> "]
[331.585673, "o", "            print('FAIL', cfg, md); continue\r\n\u001b[?2004l\r"]
[331.5857, "o", "\u001b[?2004h> "]
[331.585764, "o", "        mean, mn = timeit(m, [x], trials=10)\r\n\u001b[?2004l\r"]
[331.585796, "o", "\u001b[?2004h> "]
[331.585886, "o", "        gm = GraphLN((F,D1,D2), chunk, block, w1, w2).to(dev)\r\n\u001b[?2004l\r"]
[331.585917, "o", "\u001b[?2004h> "]
[331.585962, "o", "        gout = gm(x); gout = gm(x)\r\n\u001b[?2004l\r"]
[331.585993, "o", "\u001b[?2004h> "]
[331.586051, "o", "        gmd = (gout-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[331.586083, "o", "\u001b[?2004h> "]
[331.586115, "o", "        if gmd > 1e-4:\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.586148, "o", "> "]
[331.586215, "o", "            print('GRAPH FAIL', cfg, gmd); continue\r\n\u001b[?2004l\r"]
[331.586248, "o", "\u001b[?2004h> "]
[331.58631, "o", "        gmean, gmn = timeit(gm, [x], trials=10)\r\n\u001b[?2004l\r"]
[331.586343, "o", "\u001b[?2004h> "]
[331.586507, "o", "        print(f'chunk={chunk} block={block} w={w1}: eager {mean:.4f} | graph {gmean:.4f} ms (min {gmn:.4f})')\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.58654, "o", "> "]
[331.586626, "o", "        if best is None or gmean < best[0]: best = (gmean, cfg)\r\n\u001b[?2004l\r"]
[331.586659, "o", "\u001b[?2004h> "]
[331.58669, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[331.586722, "o", "\u001b[?2004h> "]
[331.586767, "o", "        print('ERR', cfg, ex)\r\n\u001b[?2004l\r"]
[331.586799, "o", "\u001b[?2004h> "]
[331.586832, "o", "print('BEST:', best)\r\n\u001b[?2004l\r\u001b[?2004h"]
[331.586864, "o", "> EOF\r\n\u001b[?2004l\r"]
[331.588326, "o", "\u001b[?2004hroot@modal:/# "]
[331.588396, "o", "gpu run -- python3 /workspace/bench2.py\r\n\u001b[?2004l\r"]
