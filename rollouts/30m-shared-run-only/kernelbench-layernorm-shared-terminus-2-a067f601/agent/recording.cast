[396.497803, "o", "> "]
[396.497858, "o", "src = open('/workspace/bench2.py').read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[396.497896, "o", "> "]
[396.498127, "o", "src = src.replace(\"        self.g = None\\n        self.key = None\\n\", \"        self.g = None\\n        self.key = None\\n        self.key_pending = None\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[396.49817, "o", "> "]
[396.498224, "o", "open('/workspace/bench2.py','w').write(src)\r\n\u001b[?2004l\r"]
