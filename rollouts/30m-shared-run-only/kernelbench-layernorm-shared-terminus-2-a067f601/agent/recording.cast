[150.288255, "o", "\u001b[?2004hroot@modal:/# "]
[210.006164, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\nB,F,D1,D2 = 16,64,256,256\nN = F*D1*D2  # 65536 elements per row\nR = B*F      # rows... actually rows = B = 16? No: LN over last 3 dims -> rows = batch_size = 16\n\n# LayerNorm normalized_shape=(F,D1,D2): each 'row' is one batch sample: N=F*D1*D2=4194304? No: 64*256*256=4194304\nN = F*D1*D2\nrows = B\nprint('rows', rows, 'N', N)\n\ndef clear_l2(device='cuda'):\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device=device)\n    dummy.fill_(42)\n    del dummy\n\ndef timeit(fn, args, warmup=3, trials=20, discard=1):\n    for _ in range(warmup):\n        fn(*args); torch.cuda.synchronize()\n    times=[]\n    for t in range(trials+discard):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record()\n        fn(*args)\n        e.record()\n        torch.cuda.synchronize()\n        if t>=discard: times.append(s.elapsed_time(e))\n"]
[210.006212, "i", "    times.sort()\n    return sum(times)/len(times), times[0], times[-1]\n\ndev='cuda'\nx = torch.rand(B,F,D1,D2, device=dev)\nln = nn.LayerNorm((F,D1,D2)).to(dev)\nref = ln(x)\n\n@triton.jit\ndef ln_kernel(X, Y, W, Bias, rows, N, eps, BLOCK: tl.constexpr, LOOP: tl.constexpr):\n    row = tl.program_id(0)\n    Xr = X + row*N\n    Yr = Y + row*N\n    if LOOP:\n        s1 = tl.zeros((), dtype=tl.float32)\n        s2 = tl.zeros((), dtype=tl.float32)\n        for off in range(0, N, BLOCK):\n            cols = off + tl.arange(0, BLOCK)\n            m = cols < N\n            v = tl.load(Xr+cols, mask=m, other=0.0)\n            s1 += tl.sum(v)\n            s2 += tl.sum(v*v)\n        mean = s1 / N\n        var = s2 / N - mean*mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        for off in range(0, N, BLOCK):\n            cols = off + tl.arange(0, BLOCK)\n            m = cols < N\n            v = tl.load(Xr+cols, mask=m, other=0.0)\n            w = tl.load(W+cols, mask=m, other=0.0)\n            b = tl.load(Bias+cols, mask=m, other=0.0)\n          "]
[210.006344, "i", "  tl.store(Yr+cols, (v-mean)*rstd*w + b, mask=m)\n    else:\n        cols = tl.arange(0, BLOCK)\n        m = cols < N\n        v = tl.load(Xr+cols, mask=m, other=0.0)\n        mean = tl.sum(v)/N\n        var = tl.sum(v*v)/N - mean*mean\n        rstd = 1.0/tl.sqrt(var+eps)\n        w = tl.load(W+cols, mask=m, other=0.0)\n        b = tl.load(Bias+cols, mask=m, other=0.0)\n        tl.store(Yr+cols, (v-mean)*rstd*w+b, mask=m)\n\nclass TriLN(nn.Module):\n    def __init__(self, shape, block, loop, warps):\n        super().__init__()\n        self.weight = nn.Parameter(torch.ones(shape))\n        self.bias = nn.Parameter(torch.zeros(shape))\n        self.eps = 1e-5\n        self.block=block; self.loop=loop; self.warps=warps\n    def forward(self, x):\n        y = torch.empty_like(x)\n        w = self.weight.reshape(-1); b = self.bias.reshape(-1)\n        xf = x.reshape(rows, N); yf = y.reshape(rows, N)\n        ln_kernel[(rows,)](xf, yf, w, b, rows, N, self.eps, BLOCK=self.block, LOOP=self.loop, num_warps=self.warps)\n        return y\n\ndef"]
[210.006377, "i", " check(m):\n    out = m(x)\n    md = (out-ref).abs().max().item()\n    return md\n\nfor loop in (False, True):\n    for block in (1024, 2048, 4096, 8192):\n        for warps in (4, 8):\n            if not loop and block < N: continue\n            m = TriLN((F,D1,D2), block, loop, warps).to(dev)\n            md = check(m)\n            if md > 1e-4: \n                print('FAIL', loop, block, warps, md); continue\n            mean, mn, mx = timeit(m, [x])\n            print(f'triton loop={loop} block={block} warps={warps}: {mean:.4f} ms (min {mn:.4f})')\n\nmean, mn, mx = timeit(ln, [x])\nprint(f'eager nn.LayerNorm: {mean:.4f} ms (min {mn:.4f})')\nEOF\ngpu run -- python3 /workspace/bench.py\n"]
[210.006403, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[210.006449, "o", " check(m):\r\n    out = m(x)\r\n    md = (out-ref).abs().max().item()\r\n    return md\r\n\r\nfor loop in (False, True):\r\n    for block in (1024, 2048, 4096, 8192):\r\n        for warps in (4, 8):\r\n            if not loop and block < N: continue\r\n            "]
[210.006464, "o", "m = TriLN((F,D1,D2), block, loop, wa"]
[210.006573, "o", "rps).to(dev)\r\n            md = check("]
[210.006632, "o", "m)\r\n            if md > 1e-4: \r\n                print('FAIL', loop, block, warps, md); continue\r\n            mean, mn, mx = timeit(m, [x])\r\n            print(f'triton loop={loop} block={block} warps={warps}: {mean:.4f} ms (min {mn:.4f})')\r\n\r\nmean, mn, mx = tim"]
[210.006671, "o", "eit(ln, [x])\r\nprint(f'eager nn.LayerNorm: {mean:.4f} ms (min {mn:.4f})')\r\nEOF\r\ngpu run -- python3 /workspace/bench.py\r\n"]
