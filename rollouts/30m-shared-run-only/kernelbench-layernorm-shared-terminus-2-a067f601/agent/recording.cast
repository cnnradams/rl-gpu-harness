[471.247967, "o", "\u001b[?2004h> "]
[471.248061, "o", "        self.inner = SplitLN(shape, chunk, block, warps, stages)\r\n\u001b[?2004l\r"]
[471.248087, "o", "\u001b[?2004h> "]
[471.248192, "o", "        self.g = None; self.key = None; self.key_pending = None\r\n\u001b[?2004l\r"]
[471.248224, "o", "\u001b[?2004h> "]
[471.248256, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[471.248287, "o", "\u001b[?2004h> "]
[471.248351, "o", "        key = (x.data_ptr(), tuple(x.shape))\r\n\u001b[?2004l\r"]
[471.248382, "o", "\u001b[?2004h> "]
[471.248449, "o", "        if self.g is not None and key == self.key:\r\n\u001b[?2004l\r"]
[471.24848, "o", "\u001b[?2004h> "]
[471.24854, "o", "            self.g.replay(); return self.out\r\n\u001b[?2004l\r"]
[471.248566, "o", "\u001b[?2004h> "]
[471.248617, "o", "        if key == self.key_pending:\r\n\u001b[?2004l\r"]
[471.248648, "o", "\u001b[?2004h> "]
[471.24872, "o", "            self.inner(x); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[471.248752, "o", "\u001b[?2004h> "]
[471.248811, "o", "            self.g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[471.248837, "o", "\u001b[?2004h> "]
