[210.012643, "o", "\u001b[?2004h> "]
[210.012672, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[210.012703, "o", "\u001b[?2004h> "]
[210.012784, "o", "        self.block=block; self.loop=loop; self.warps=warps\r\n\u001b[?2004l\r"]
[210.012815, "o", "\u001b[?2004h> "]
[210.012846, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[210.012877, "o", "\u001b[?2004h> "]
[210.012917, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[210.012949, "o", "\u001b[?2004h> "]
[210.013036, "o", "        w = self.weight.reshape(-1); b = self.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[210.013062, "o", "\u001b[?2004h> "]
[210.013146, "o", "        xf = x.reshape(rows, N); yf = y.reshape(rows, N)\r\n\u001b[?2004l\r"]
[210.013173, "o", "\u001b[?2004h> "]
[210.013357, "o", "        ln_kernel[(rows,)](xf, yf, w, b, rows, N, self.eps, BLOCK=self.block, LOOP=self.loop, num_warps=self.warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.013387, "o", "> "]
[210.013417, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[210.013443, "o", "\u001b[?2004h> "]
[210.013475, "o", "def check(m):\r\n\u001b[?2004l\r\u001b[?2004h"]
[210.013506, "o", ">     out = m(x)\r\n\u001b[?2004l\r"]
[210.013531, "o", "\u001b[?2004h> "]
