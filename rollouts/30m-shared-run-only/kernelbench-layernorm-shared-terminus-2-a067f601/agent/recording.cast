[471.247298, "o", "        stats_kernel[(rows*S,)](x, self.ps, self.ps2, N, self.chunk, S, BLOCK=self.block, num_warps=self.w, num_stages=self.st)\r\n\u001b[?2004l\r"]
[471.24733, "o", "\u001b[?2004h> "]
[471.247384, "o", "        spow = triton.next_power_of_2(S)\r\n\u001b[?2004l\r"]
[471.247415, "o", "\u001b[?2004h> "]
[471.247657, "o", "        norm_kernel[(rows*S,)](x, y, w, b, self.ps, self.ps2, N, self.chunk, S, self.eps, SPOW=spow, BLOCK=self.block, num_warps=self.w, num_stages=self.st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.247695, "o", "        return y\r\n\u001b[?2004l\r"]
[471.247727, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[471.24777, "o", "class GraphLN(nn.Module):\r\n\u001b[?2004l\r"]
[471.247801, "o", "\u001b[?2004h> "]
[471.247884, "o", "    def __init__(self, shape, chunk, block, warps, stages):\r\n\u001b[?2004l\r"]
