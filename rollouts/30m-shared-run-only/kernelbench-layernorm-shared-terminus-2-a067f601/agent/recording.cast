[210.011352, "o", "            tl.store(Yr+cols, (v-mean)*rstd*w + b, mask=m)\r\n\u001b[?2004l\r"]
[210.011378, "o", "\u001b[?2004h> "]
[210.011404, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
