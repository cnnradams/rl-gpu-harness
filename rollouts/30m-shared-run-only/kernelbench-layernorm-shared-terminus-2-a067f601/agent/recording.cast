[45.709922, "o", "390:    # Default for all other backends and float types\r\n394:def eval_kernel_against_ref(\r\n401:    timing_method: str = \"cuda_event\", # see timing.py\r\n407:    backend: str = \"cuda\",  # can be 'cuda', 'triton', 'tilelang', or 'cute'\r\n423:    backend: str, one of 'cuda', 'triton', 'tilelang', or 'cute'\r\n435:    backend_lower = backend.lower()\r\n437:    if backend_lower == \"hip\" and vendor != \"amd\":\r\n438:        raise ValueError(f\"HIP backend requires AMD GPU, got {vendor}\")\r\n440:    if backend_lower in [\"cuda\", \"cute\", \"thunderkittens\"] and vendor == \"amd\":\r\n441:        raise ValueError(f\"{backend} backend requires NVIDIA GPU, got AMD\")\r\n443:    if backend_lower == \"tilelang\":\r\n458:    uses_tempfile = backend.lower() in [\"triton\", \"tilelang\", \"cute\"]\r\n495:    init_inputs = [_process_input_tensor(x, device, backend, precision) for x in init_inputs]\r\n513:        backend_lower = backend.lower()\r\n514:        if backend_lower in [\"triton\", \"tilelang\", \"cute\"]:\r\n521:            # Default CUDA backend\r\n596:           "]
[45.709961, "o", " backend=backend,\r\n618:                inputs = [_process_input_tensor(x, device, backend, precision) for x in inputs]\r\n623:                # support multiple timing backend\r\n663:        inputs = [_process_input_tensor(x, device, backend, precision) for x in inputs]\r\n702:def register_and_format_exception(\r\n727:def run_and_check_correctness(\r\n736:    backend: str =\"cuda\",\r\n745:    backend: backend type for handling dtype conversions\r\n767:            inputs = [_process_input_tensor(x, device, backend, precision) for x in inputs]\r\n851:def check_metadata_serializable(metadata: dict):\r\n880:def check_metadata_serializable_all_types(metadata: dict):\r\n886:    def convert_to_serializable(obj):\r\n"]
