[863.440853, "o", "\u001b[?2004h> "]
[863.440916, "o", "for NBN in [1024, 2048, 4096]:\r\n\u001b[?2004l\r"]
[863.440951, "o", "\u001b[?2004h> "]
[863.440998, "o", "    for NW in [4, 8]:\r\n\u001b[?2004l\r"]
[863.44104, "o", "\u001b[?2004h> "]
[863.441086, "o", "        for EV in [0, 1]:\r\n\u001b[?2004l\r"]
[863.441125, "o", "\u001b[?2004h> "]
[863.441367, "o", "            fn = lambda: _map_plain[(M*(N//NBN),)](x, w, b, mr, y, M, N, BLOCK_N=NBN, EV=EV, num_warps=NW)\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.441385, "o", "> "]
