[949.396681, "o", "                fn = lambda: _map_v3[(N//NBN,)](x, w, b, mr, y, M, N, BLOCK_N=NBN, EV=EV, num_warps=NW)\r\n\u001b[?2004l\r"]
[949.396731, "o", "\u001b[?2004h> "]
[949.396775, "o", "                t = bench(fn)\r\n\u001b[?2004l\r"]
[949.396815, "o", "\u001b[?2004h> "]
[949.396962, "o", "                print(f'v3 NBN={NBN} NW={NW} EV={EV}: {t:.1f} us')\r\n\u001b[?2004l\r"]
[949.396999, "o", "\u001b[?2004h> "]
[949.397067, "o", "            except Exception as ex:\r\n\u001b[?2004l\r"]
[949.397104, "o", "\u001b[?2004h> "]
[949.397245, "o", "                print(f'v3 NBN={NBN} NW={NW} EV={EV}: FAIL {ex}')\r\n\u001b[?2004l\r"]
[949.397283, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[949.397321, "o", "> "]
[949.3975, "o", "# v4: 2D program: each program handles ROWS_PER_PROG rows x BLOCK_N, w/b loaded once\r\n\u001b[?2004l\r"]
[949.397537, "o", "\u001b[?2004h> "]
[949.397575, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.397706, "o", "def _map_v4(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N,\r\n\u001b[?2004l\r"]
[949.39774, "o", "\u001b[?2004h> "]
[949.397902, "o", "            BLOCK_N: tl.constexpr, RPP: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r"]
[949.39794, "o", "\u001b[?2004h> "]
[949.397993, "o", "    cid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[949.39803, "o", "\u001b[?2004h> "]
[949.398133, "o", "    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[949.398171, "o", "\u001b[?2004h> "]
[949.398234, "o", "    ww = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[949.398272, "o", "\u001b[?2004h> "]
[949.398335, "o", "    bb = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[949.398372, "o", "\u001b[?2004h> "]
[949.398422, "o", "    for r in range(RPP):\r\n\u001b[?2004l\r"]
[949.398456, "o", "\u001b[?2004h> "]
[949.398538, "o", "        base = r.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[949.398572, "o", "\u001b[?2004h> "]
[949.398656, "o", "        mean = tl.load(mr_ptr + r * 2)\r\n\u001b[?2004l\r"]
[949.398685, "o", "\u001b[?2004h> "]
[949.398788, "o", "        rstd = tl.load(mr_ptr + r * 2 + 1)\r\n\u001b[?2004l\r"]
[949.398824, "o", "\u001b[?2004h> "]
[949.398861, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h"]
[949.398895, "o", "> "]
[949.399055, "o", "            v = tl.load(x_ptr + base + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[949.39909, "o", "\u001b[?2004h> "]
[949.399313, "o", "            tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[949.399349, "o", "\u001b[?2004h> "]
[949.399375, "o", "        else:\r\n\u001b[?2004l\r"]
[949.39941, "o", "\u001b[?2004h> "]
[949.399508, "o", "            v = tl.load(x_ptr + base + offs)\r\n\u001b[?2004l\r"]
[949.399547, "o", "\u001b[?2004h> "]
[949.399712, "o", "            tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.39975, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[949.399796, "o", "# correctness of v3\r\n\u001b[?2004l\r"]
[949.399835, "o", "\u001b[?2004h> "]
[949.399924, "o", "ref = ((x - mr[:,0:1]) * mr[:,1:2]) * w + b\r\n\u001b[?2004l\r"]
[949.399962, "o", "\u001b[?2004h> "]
[949.400121, "o", "_map_v3[(N//2048,)](x, w, b, mr, y, M, N, BLOCK_N=2048, EV=0, num_warps=8)\r\n\u001b[?2004l\r"]
[949.400155, "o", "\u001b[?2004h> "]
[949.400205, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[949.400237, "o", "\u001b[?2004h> "]
[949.400353, "o", "print('v3 maxdiff:', (ref - y).abs().max().item())\r\n\u001b[?2004l\r"]
[949.400387, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
