[863.439027, "o", "\u001b[?2004h> "]
[863.439101, "o", "    y = (v - mean) * rstd * ww + bb\r\n\u001b[?2004l\r"]
[863.439144, "o", "\u001b[?2004h> "]
[863.439183, "o", "    if EV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.439347, "o", "        tl.store(y_ptr + base + offs, y, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[863.439383, "o", "\u001b[?2004h> "]
[863.439427, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.439525, "o", "        tl.store(y_ptr + base + offs, y)\r\n\u001b[?2004l\r"]
[863.43956, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[863.4396, "o", "> "]
[863.43988, "o", "# fold w into (rstd*w) per row? try variant with combined coef: y = v*A[offs] + B[offs] where A=rstd*w per row impossible (row-dep)\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.439917, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[863.439948, "o", "\u001b[?2004h> "]
[863.44009, "o", "def _map_affine(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N,\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.440132, "o", "> "]
[863.440202, "o", "                BLOCK_N: tl.constexpr):\r\n\u001b[?2004l\r"]
[863.440247, "o", "\u001b[?2004h> "]
[863.44051, "o", "    # y = x * (rstd*w) + (b - mean*rstd*w); A=rstd*w is row-dependent -> precompute A per row? A would be M*N... no\r\n\u001b[?2004l\r\u001b[?2004h"]
[863.440546, "o", ">     pass\r\n\u001b[?2004l\r"]
[863.440584, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[863.440636, "o", "\u001b[?2004h> "]
[863.440695, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
