[1089.099659, "o", "\u001b[?2004h> "]
[1089.099726, "o", "    coffs = tl.arange(0, BLOCK_C)\r\n\u001b[?2004l\r"]
[1089.099764, "o", "\u001b[?2004h> "]
[1089.099801, "o", "    cmask = coffs < C\r\n\u001b[?2004l\r"]
[1089.099837, "o", "\u001b[?2004h> "]
[1089.099996, "o", "    s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cmask, other=0.0))\r\n\u001b[?2004l\r"]
[1089.100033, "o", "\u001b[?2004h> "]
[1089.100208, "o", "    s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))\r\n\u001b[?2004l\r"]
[1089.100245, "o", "\u001b[?2004h> "]
[1089.100282, "o", "    invN = 1.0 / N\r\n\u001b[?2004l\r"]
[1089.100318, "o", "\u001b[?2004h> "]
[1089.100355, "o", "    mean = s1 * invN\r\n\u001b[?2004l\r"]
[1089.100391, "o", "\u001b[?2004h> "]
[1089.10046, "o", "    var = s2 * invN - mean * mean\r\n\u001b[?2004l\r"]
[1089.100495, "o", "\u001b[?2004h> "]
[1089.100571, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1089.100609, "o", "\u001b[?2004h> "]
[1089.100704, "o", "    tl.store(mr_ptr + row * 2, mean)\r\n\u001b[?2004l\r"]
[1089.100741, "o", "\u001b[?2004h> "]
[1089.100824, "o", "    tl.store(mr_ptr + row * 2 + 1, rstd)\r\n\u001b[?2004l\r"]
[1089.100861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.100899, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1089.100935, "o", "\u001b[?2004h> "]
[1089.101115, "o", "def _map_v3(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N, BLOCK_N: tl.constexpr):\r\n\u001b[?2004l\r"]
[1089.101147, "o", "\u001b[?2004h> "]
[1089.101199, "o", "    cid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1089.101241, "o", "\u001b[?2004h> "]
[1089.101337, "o", "    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1089.101371, "o", "\u001b[?2004h> "]
[1089.101436, "o", "    ww = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[1089.101473, "o", "\u001b[?2004h> "]
[1089.101535, "o", "    bb = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[1089.101571, "o", "\u001b[?2004h> "]
[1089.101624, "o", "    for r in range(M):\r\n\u001b[?2004l\r"]
[1089.101659, "o", "\u001b[?2004h> "]
[1089.101727, "o", "        base = r.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[1089.101764, "o", "\u001b[?2004h> "]
[1089.101843, "o", "        mean = tl.load(mr_ptr + r * 2)\r\n\u001b[?2004l\r"]
[1089.101881, "o", "\u001b[?2004h> "]
[1089.101969, "o", "        rstd = tl.load(mr_ptr + r * 2 + 1)\r\n\u001b[?2004l\r"]
[1089.102006, "o", "\u001b[?2004h> "]
[1089.102088, "o", "        v = tl.load(x_ptr + base + offs)\r\n\u001b[?2004l\r"]
[1089.102126, "o", "\u001b[?2004h> "]
[1089.102277, "o", "        tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.102315, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.102353, "o", "> "]
[1089.102411, "o", "SBN, SW, NBN, NW = 8192, 16, 512, 8\r\n\u001b[?2004l\r"]
[1089.102448, "o", "\u001b[?2004h> "]
[1089.102472, "o", "C = N // SBN\r\n\u001b[?2004l\r"]
[1089.102509, "o", "\u001b[?2004h> "]
[1089.10266, "o", "ws = torch.empty(2 * M * C + 2 * M, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1089.102697, "o", "\u001b[?2004h> "]
[1089.102734, "o", "partials = ws[:2*M*C]\r\n\u001b[?2004l\r"]
[1089.102774, "o", "\u001b[?2004h> "]
[1089.102811, "o", "mr = ws[2*M*C:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.102848, "o", "> "]
[1089.102898, "o", "BC = triton.next_power_of_2(C)\r\n\u001b[?2004l\r"]
[1089.102935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.102972, "o", "> def full():\r\n\u001b[?2004l\r"]
[1089.102998, "o", "\u001b[?2004h> "]
[1089.103157, "o", "    _stats[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\r\n\u001b[?2004l\r"]
[1089.103194, "o", "\u001b[?2004h> "]
[1089.103345, "o", "    _reduce[(M,)](partials, mr, N, C, eps, BLOCK_C=BC, num_warps=4)\r\n\u001b[?2004l\r"]
[1089.103381, "o", "\u001b[?2004h> "]
[1089.103534, "o", "    _map_v3[(N//NBN,)](x, w, b, mr, y, M, N, BLOCK_N=NBN, num_warps=NW)\r\n\u001b[?2004l\r"]
[1089.103575, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.103619, "o", "> # correctness\r\n\u001b[?2004l\r"]
[1089.103657, "o", "\u001b[?2004h> "]
[1089.103783, "o", "ref = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\r\n\u001b[?2004l\r"]
[1089.10382, "o", "\u001b[?2004h> "]
[1089.103887, "o", "full(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1089.103925, "o", "\u001b[?2004h> "]
[1089.104034, "o", "print('full maxdiff:', (ref - y).abs().max().item())\r\n\u001b[?2004l\r"]
[1089.104071, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.104108, "o", "> "]
[1089.104146, "o", "# GPU time via graph\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.104183, "o", "> "]
[1089.104221, "o", "g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[1089.104258, "o", "\u001b[?2004h> "]
[1089.104309, "o", "with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[1089.104346, "o", "\u001b[?2004h> "]
[1089.104392, "o", "    for _ in range(20):\r\n\u001b[?2004l\r"]
[1089.104429, "o", "\u001b[?2004h> "]
[1089.104465, "o", "        full()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.104504, "o", "> "]
[1089.104537, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1089.104574, "o", "\u001b[?2004h> "]
[1089.104777, "o", "s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1089.104816, "o", "\u001b[?2004h> "]
[1089.104849, "o", "s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1089.104894, "o", "for _ in range(5):\r\n\u001b[?2004l\r"]
[1089.104932, "o", "\u001b[?2004h> "]
[1089.104968, "o", "    g.replay()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.105006, "o", "> "]
[1089.105068, "o", "e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1089.105105, "o", "\u001b[?2004h> "]
