[1089.108402, "o", "\u001b[?2004h> "]
[1089.108457, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1089.108494, "o", "\u001b[?2004h> "]
[1089.10855, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r"]
[1089.108587, "o", "\u001b[?2004h> "]
