[863.434491, "i", "cat > /workspace/tune3.py << 'EOF'\nimport sys, time, torch, numpy as np\nimport triton\nimport triton.language as tl\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\nmr = torch.rand(M, 2, device=dev)  # mean, rstd per row\neps = 1e-5\n\ndef bench(fn, iters=20):\n    fn(); torch.cuda.synchronize()\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        for _ in range(iters):\n            fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(5):\n        g.replay()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/5/iters*1000\n\n@triton.jit\ndef _map_plain(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N,\n               BLOCK_N: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    C2 = N // BLOCK_N\n    row = pid // C2\n    cid = pid % C2\n    base = row.to(tl.int64) * N\n    mean = tl.load(mr_ptr + row * 2)\n   "]
[863.434538, "i", " rstd = tl.load(mr_ptr + row * 2 + 1)\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    if EV:\n        v = tl.load(x_ptr + base + offs, eviction_policy='evict_first')\n    else:\n        v = tl.load(x_ptr + base + offs)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    y = (v - mean) * rstd * ww + bb\n    if EV:\n        tl.store(y_ptr + base + offs, y, eviction_policy='evict_first')\n    else:\n        tl.store(y_ptr + base + offs, y)\n\n# fold w into (rstd*w) per row? try variant with combined coef: y = v*A[offs] + B[offs] where A=rstd*w per row impossible (row-dep)\n@triton.jit\ndef _map_affine(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N,\n                BLOCK_N: tl.constexpr):\n    # y = x * (rstd*w) + (b - mean*rstd*w); A=rstd*w is row-dependent -> precompute A per row? A would be M*N... no\n    pass\n\ny = torch.empty_like(x)\nprint('--- pure map (mr precomputed) ---')\nfor NBN in [1024, 2048, 4096]:\n    for NW in [4, 8]:\n        for EV in [0, 1]:\n            fn = lambda: _map_plain[(M*(N//NBN),)](x, w,"]
[863.434548, "i", " b, mr, y, M, N, BLOCK_N=NBN, EV=EV, num_warps=NW)\n            t = bench(fn)\n            print(f'map NBN={NBN} NW={NW} EV={EV}: {t:.1f} us')\n\n# copy baseline y=x (2 streams)\n@triton.jit\ndef _copy(x_ptr, y_ptr, N, BLOCK_N: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid.to(tl.int64) * BLOCK_N + tl.arange(0, BLOCK_N)\n    tl.store(y_ptr + offs, tl.load(x_ptr + offs))\nfn = lambda: _copy[(M*N//4096,)](x, y, M*N, BLOCK_N=4096, num_warps=4)\nprint(f'copy y=x: {bench(fn):.1f} us')\n\n# read x + w + b, write y but w/b tiny rows... test L2 effect: map over only 1 row repeatedly\n@triton.jit\ndef _map_1row(x_ptr, w_ptr, b_ptr, y_ptr, N, BLOCK_N: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK_N + tl.arange(0, BLOCK_N)\n    v = tl.load(x_ptr + offs)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    tl.store(y_ptr + offs, (v - 0.5) * 2.0 * ww + bb)\nfn = lambda: _map_1row[(N//4096,)](x, w, b, y, N, BLOCK_N=4096, num_warps=4)\nprint(f'map 1 row (w/b hot): {bench(fn):.1f} us  (scale x16 = {"]
[863.434668, "i", "16*bench(fn):.0f})')\nEOF\ngpu push sb-FzEuLcuXePAWUpo631160R /workspace/tune3.py /tmp/tune3.py && gpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /tmp/tune3.py\n"]
