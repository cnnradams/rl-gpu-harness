[864.645938, "o", "{\r\n  \"bytes\": 3058,\r\n  \"sha256\": \"914399950b6d2896d7a821be8d2ade60dca0029b9eb6832a282f96bce59149dc\"\r\n}\r\n"]
[864.785691, "o", "request ID: 58dc1280990d40fa8102667f28736ca0\r\n"]
[866.048034, "o", "command: e0579482df044b9e9dbbadb7ba1fc820\r\n"]
[870.043196, "o", "--- pure map (mr precomputed) ---\r\nmap NBN=1024 NW=4 EV=0: 346.1 us\r\nmap NBN=1024 NW=4 EV=1: 337.4 us\r\nmap NBN=1024 NW=8 EV=0: 345.1 us\r\nmap NBN=1024 NW=8 EV=1: 341.9 us\r\nmap NBN=2048 NW=4 EV=0: 347.3 us\r\nmap NBN=2048 NW=4 EV=1: 337.1 us\r\nmap NBN=2048 NW=8 EV=0: 346.4 us\r\nmap NBN=2048 NW=8 EV=1: 338.0 us\r\nmap NBN=4096 NW=4 EV=0: 350.6 us\r\nmap NBN=4096 NW=4 EV=1: 342.9 us\r\nmap NBN=4096 NW=8 EV=0: 347.8 us\r\nmap NBN=4096 NW=8 EV=1: 341.4 us\r\ncopy y=x: 182.7 us\r\nmap 1 row (w/b hot): 25.6 us  (scale x16 = 408)\r\n"]
[870.211533, "o", "\u001b[?2004hroot@modal:/# "]
[949.390866, "i", "cat > /workspace/tune4.py << 'EOF'\nimport sys, time, torch, numpy as np\nimport triton\nimport triton.language as tl\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\nmr = torch.rand(M, 2, device=dev)\ny = torch.empty_like(x)\neps = 1e-5\n\ndef bench(fn, iters=20):\n    fn(); torch.cuda.synchronize()\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        for _ in range(iters):\n            fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(5):\n        g.replay()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/5/iters*1000\n\n# v3: one program per column tile; loop over rows; w/b loaded once\n@triton.jit\ndef _map_v3(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N,\n            BLOCK_N: tl.constexpr, EV: tl.constexpr):\n    cid = tl.program_id(0)\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    ww = tl.load(w_pt"]
[949.390911, "i", "r + offs)\n    bb = tl.load(b_ptr + offs)\n    for r in range(M):\n        base = r.to(tl.int64) * N\n        mean = tl.load(mr_ptr + r * 2)\n        rstd = tl.load(mr_ptr + r * 2 + 1)\n        if EV:\n            v = tl.load(x_ptr + base + offs, eviction_policy='evict_first')\n            tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb, eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + offs)\n            tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb)\n\nprint('--- v3 tile-per-column loop rows ---')\nfor NBN in [512, 1024, 2048, 4096]:\n    for NW in [4, 8]:\n        for EV in [0, 1]:\n            try:\n                fn = lambda: _map_v3[(N//NBN,)](x, w, b, mr, y, M, N, BLOCK_N=NBN, EV=EV, num_warps=NW)\n                t = bench(fn)\n                print(f'v3 NBN={NBN} NW={NW} EV={EV}: {t:.1f} us')\n            except Exception as ex:\n                print(f'v3 NBN={NBN} NW={NW} EV={EV}: FAIL {ex}')\n\n# v4: 2D program: each program handles ROWS_PER_PROG rows x BLOCK_N, "]
[949.390929, "i", "w/b loaded once\n@triton.jit\ndef _map_v4(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N,\n            BLOCK_N: tl.constexpr, RPP: tl.constexpr, EV: tl.constexpr):\n    cid = tl.program_id(0)\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    for r in range(RPP):\n        base = r.to(tl.int64) * N\n        mean = tl.load(mr_ptr + r * 2)\n        rstd = tl.load(mr_ptr + r * 2 + 1)\n        if EV:\n            v = tl.load(x_ptr + base + offs, eviction_policy='evict_first')\n            tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb, eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + offs)\n            tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb)\n\n# correctness of v3\nref = ((x - mr[:,0:1]) * mr[:,1:2]) * w + b\n_map_v3[(N//2048,)](x, w, b, mr, y, M, N, BLOCK_N=2048, EV=0, num_warps=8)\ntorch.cuda.synchronize()\nprint('v3 maxdiff:', (ref - y).abs().max().item())\nEOF\ngpu push sb-FzEuLcuXePAWUpo631160R /workspace/t"]
[949.391027, "i", "une4.py /tmp/tune4.py && gpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /tmp/tune4.py\n"]
