[863.441647, "o", "\u001b[?2004h"]
[863.44168, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.44176, "o", "# copy baseline y=x (2 streams)\r\n\u001b[?2004l\r"]
[863.441801, "o", "\u001b[?2004h> "]
[863.441844, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.441963, "o", "def _copy(x_ptr, y_ptr, N, BLOCK_N: tl.constexpr):\r\n\u001b[?2004l\r"]
[863.441998, "o", "\u001b[?2004h> "]
[863.442055, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[863.442094, "o", "\u001b[?2004h> "]
[863.442226, "o", "    offs = pid.to(tl.int64) * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[863.442266, "o", "\u001b[?2004h> "]
[863.442367, "o", "    tl.store(y_ptr + offs, tl.load(x_ptr + offs))\r\n\u001b[?2004l\r"]
[863.442406, "o", "\u001b[?2004h> "]
[863.442564, "o", "fn = lambda: _copy[(M*N//4096,)](x, y, M*N, BLOCK_N=4096, num_warps=4)\r\n\u001b[?2004l\r"]
[863.442603, "o", "\u001b[?2004h> "]
