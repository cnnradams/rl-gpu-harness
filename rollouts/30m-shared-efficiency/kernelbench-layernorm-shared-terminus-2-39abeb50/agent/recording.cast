[1089.107969, "o", "def harness_like(fn, trials=30):\r\n\u001b[?2004l\r"]
[1089.108006, "o", "\u001b[?2004h> "]
[1089.108043, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.108078, "o", "> "]
[1089.108223, "o", "    buf = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1089.108259, "o", "\u001b[?2004h> "]
[1089.108305, "o", "    for _ in range(3):\r\n\u001b[?2004l\r"]
[1089.108341, "o", "\u001b[?2004h> "]
