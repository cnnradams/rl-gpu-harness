[954.790827, "o", "--- v3 tile-per-column loop rows ---\r\nv3 NBN=512 NW=4 EV=0: 197.0 us\r\nv3 NBN=512 NW=4 EV=1: 200.5 us\r\nv3 NBN=512 NW=8 EV=0: 196.3 us\r\nv3 NBN=512 NW=8 EV=1: 201.8 us\r\nv3 NBN=1024 NW=4 EV=0: 199.2 us\r\nv3 NBN=1024 NW=4 EV=1: 202.5 us\r\nv3 NBN=1024 NW=8 EV=0: 197.5 us\r\nv3 NBN=1024 NW=8 EV=1: 201.1 us\r\nv3 NBN=2048 NW=4 EV=0: 199.5 us\r\nv3 NBN=2048 NW=4 EV=1: 201.6 us\r\nv3 NBN=2048 NW=8 EV=0: 198.8 us\r\nv3 NBN=2048 NW=8 EV=1: 202.8 us\r\nv3 NBN=4096 NW=4 EV=0: 198.7 us\r\nv3 NBN=4096 NW=4 EV=1: 200.3 us\r\nv3 NBN=4096 NW=8 EV=0: 197.5 us\r\nv3 NBN=4096 NW=8 EV=1: 201.8 us\r\nv3 maxdiff: 1.1920928955078125e-07\r\n"]
[955.703878, "o", "\u001b[?2004hroot@modal:/# "]
[1089.095019, "i", "cat > /workspace/tune5.py << 'EOF'\nimport sys, time, torch, numpy as np\nimport triton\nimport triton.language as tl\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\neps = 1e-5\n\n@triton.jit\ndef _stats(x_ptr, p_ptr, M, N, C, BLOCK_N: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    cid = pid % C\n    base = row.to(tl.int64) * N\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    v = tl.load(x_ptr + base + offs)\n    tl.store(p_ptr + row * C + cid, tl.sum(v))\n    tl.store(p_ptr + M * C + row * C + cid, tl.sum(v * v))\n\n@triton.jit\ndef _reduce(p_ptr, mr_ptr, N, C, eps, BLOCK_C: tl.constexpr):\n    row = tl.program_id(0)\n    M = tl.num_programs(0)\n    coffs = tl.arange(0, BLOCK_C)\n    cmask = coffs < C\n    s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cmask, other=0.0))\n    s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))\n    invN = 1.0 / N\n    mean = s1 * invN\n    var"]
[1089.09517, "i", " = s2 * invN - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(mr_ptr + row * 2, mean)\n    tl.store(mr_ptr + row * 2 + 1, rstd)\n\n@triton.jit\ndef _map_v3(x_ptr, w_ptr, b_ptr, mr_ptr, y_ptr, M, N, BLOCK_N: tl.constexpr):\n    cid = tl.program_id(0)\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    for r in range(M):\n        base = r.to(tl.int64) * N\n        mean = tl.load(mr_ptr + r * 2)\n        rstd = tl.load(mr_ptr + r * 2 + 1)\n        v = tl.load(x_ptr + base + offs)\n        tl.store(y_ptr + base + offs, (v - mean) * rstd * ww + bb)\n\nSBN, SW, NBN, NW = 8192, 16, 512, 8\nC = N // SBN\nws = torch.empty(2 * M * C + 2 * M, device=dev, dtype=torch.float32)\npartials = ws[:2*M*C]\nmr = ws[2*M*C:]\nBC = triton.next_power_of_2(C)\n\ndef full():\n    _stats[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\n    _reduce[(M,)](partials, mr, N, C, eps, BLOCK_C=BC, num_warps=4)\n    _map_v3[(N//NBN,)](x, w, b, mr, y, M, N, BLOCK_N=NBN, num_warps=NW"]
[1089.095197, "i", ")\n\n# correctness\nref = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\nfull(); torch.cuda.synchronize()\nprint('full maxdiff:', (ref - y).abs().max().item())\n\n# GPU time via graph\ng = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g):\n    for _ in range(20):\n        full()\ntorch.cuda.synchronize()\ns = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\ns.record()\nfor _ in range(5):\n    g.replay()\ne.record(); torch.cuda.synchronize()\nprint(f'full pipeline GPU: {s.elapsed_time(e)/5/20*1000:.1f} us')\n\n# CPU cost of full (3 triton launches)\nt0 = time.perf_counter()\nfor _ in range(100):\n    full()\nt1 = time.perf_counter()\ntorch.cuda.synchronize()\nprint(f'CPU cost full (3 launches): {(t1-t0)/100*1e6:.1f} us')\n\n# direct launch API test\nck = _stats.warmup(x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW, grid=(M*C,))\nck._init_handles()\nprint('compiled kernel type:', type(ck))\ntry:\n    runner = ck[(M*C, 1, 1)]\n    runner(x, partials, M, N, C)\n    torch.cuda.synchronize()\n    t0 = time.perf_co"]
[1089.095222, "o", "cat > /workspace/tune5.py << 'EOF'\r\n\u001b[?2004l\r"]
[1089.095274, "i", "unter()\n    for _ in range(200):\n        runner(x, partials, M, N, C)\n    t1 = time.perf_counter()\n    torch.cuda.synchronize()\n    print(f'CPU cost direct ck[grid] launch: {(t1-t0)/200*1e6:.1f} us')\nexcept Exception as ex:\n    print('direct ck[grid] failed:', ex)\n\n# end-to-end harness-like timing of full + empty_like\ndef harness_like(fn, trials=30):\n    times = []\n    buf = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)\n    for _ in range(3):\n        fn()\n    torch.cuda.synchronize()\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        se = torch.cuda.Event(enable_timing=True); ee = torch.cuda.Event(enable_timing=True)\n        buf.zero_()  # L2 thrash\n        torch.cuda.synchronize()\n        se.record()\n        fn()\n        ee.record()\n        torch.cuda.synchronize()\n        times.append(se.elapsed_time(ee))\n    return np.mean(times)*1000\n\ndef call_with_alloc():\n    yy = torch.empty_like(x)\n    _stats[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\n    _reduce[(M,)]("]
[1089.095293, "o", ")\r\n\r\n# correctness\r\nref = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\r\nfull(); torch.cuda.synchronize()\r\nprint('full maxdiff:', (ref - y).abs().max().item())\r\n\r\n# GPU time via graph\r\ng = torch.cuda.CUDAGraph()\r\nwith torch.cuda.graph(g):\r\n    for _ in range(20):\r\n        full()\r\ntorch.cuda.synchronize()\r\ns = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\ns.record()\r\nfor _ in range(5):\r\n  "]
[1089.095329, "i", "partials, mr, N, C, eps, BLOCK_C=BC, num_warps=4)\n    _map_v3[(N//NBN,)](x, w, b, mr, yy, M, N, BLOCK_N=NBN, num_warps=NW)\n    return yy\n\nprint(f'harness-like full+alloc: {harness_like(call_with_alloc):.1f} us')\nEOF\ngpu push sb-FzEuLcuXePAWUpo631160R /workspace/tune5.py /tmp/tune5.py && gpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /tmp/tune5.py\n"]
