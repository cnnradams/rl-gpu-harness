[1376.715659, "i", "cat > /workspace/tune8.py << 'EOF'\nimport sys, time, torch, numpy as np\nimport triton\nimport triton.language as tl\nsys.path.insert(0, '/tmp')\nfrom solution import _ln_stats_kernel, _ln_map_kernel\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\nmr = torch.rand(M*2, device=dev)\ny = torch.empty_like(x)\n\ndef bench(fn, iters=20):\n    fn(); torch.cuda.synchronize()\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        for _ in range(iters):\n            fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(5):\n        g.replay()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/5/iters*1000\n\nbest_s = None\nfor SBN in [2048, 4096, 8192, 16384]:\n    for SW in [4, 8, 16]:\n        for NS in [1, 2, 4]:\n            C = N // SBN\n            partials = torch.empty(2*M*C, device=dev, dtype=torch.float32)\n        "]
[1376.715701, "i", "    try:\n                t = bench(lambda: _ln_stats_kernel[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW, num_stages=NS))\n                if best_s is None or t < best_s[0]: best_s = (t, SBN, SW, NS)\n            except Exception:\n                pass\nprint('best stats:', best_s)\n\nbest_m = None\nfor NBN in [256, 512, 1024, 2048]:\n    for NW in [2, 4, 8]:\n        for NS in [1, 2, 4]:\n            try:\n                t = bench(lambda: _ln_map_kernel[(N//NBN,)](x, w, b, mr, y, M, N, BLOCK_N=NBN, num_warps=NW, num_stages=NS))\n                if best_m is None or t < best_m[0]: best_m = (t, NBN, NW, NS)\n            except Exception:\n                pass\nprint('best map:', best_m)\nEOF\ngpu push sb-FzEuLcuXePAWUpo631160R /workspace/tune8.py /tmp/tune8.py && gpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /tmp/tune8.py\n"]
