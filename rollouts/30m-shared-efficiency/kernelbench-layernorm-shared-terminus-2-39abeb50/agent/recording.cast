[473.509984, "i", "cat > /workspace/tune.py << 'EOF'\nimport sys, itertools, torch, numpy as np\nsys.path.insert(0, '/workspace')\nimport triton\nfrom solution import _ln_stats_kernel, _ln_norm_kernel\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\neps = 1e-5\n\ndef run_cfg(SBN, SW, NBN, NW, iters=50):\n    C = N // SBN\n    partials = torch.empty((2, M, C), device=dev, dtype=torch.float32)\n    y = torch.empty_like(x)\n    def call():\n        _ln_stats_kernel[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\n        _ln_norm_kernel[(M*(N//NBN),)](x, w, b, partials, y, M, N, C, eps, BLOCK_N=NBN, BLOCK_C=triton.next_power_of_2(C), num_warps=NW)\n    # warmup/compile\n    for _ in range(3):\n        call()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(iters):\n        call()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\nresu"]
[473.51009, "i", "lts = []\nfor SBN, SW in [(1024,4),(2048,4),(2048,8),(4096,4),(4096,8),(8192,8),(8192,16),(16384,16)]:\n    for NBN, NW in [(2048,4),(4096,4),(4096,8),(8192,8),(8192,16),(16384,16),(32768,32)]:\n        try:\n            t = run_cfg(SBN, SW, NBN, NW)\n            results.append((t, SBN, SW, NBN, NW))\n            print(f'SBN={SBN:6d} SW={SW:2d} NBN={NBN:6d} NW={NW:2d}: {t:.4f} ms')\n        except Exception as ex:\n            print(f'SBN={SBN} SW={SW} NBN={NBN} NW={NW}: FAIL {ex}')\nresults.sort()\nprint('BEST:', results[0])\nEOF\ngpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /workspace/tune.py\n"]
