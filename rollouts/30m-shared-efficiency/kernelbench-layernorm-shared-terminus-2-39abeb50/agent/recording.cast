[707.22547, "i", "cat > /workspace/prof.py << 'EOF'\nimport sys, time, torch, numpy as np\nsys.path.insert(0, '/workspace')\nimport triton\nprint('triton version:', triton.__version__)\nprint('torch version:', torch.__version__)\nfrom solution import _ln_stats_kernel, _ln_norm_kernel\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\neps = 1e-5\nSBN, SW, NBN, NW = 8192, 16, 4096, 8\nC = N // SBN\npartials = torch.empty((2, M, C), device=dev, dtype=torch.float32)\ny = torch.empty_like(x)\n\ndef stats_launch():\n    _ln_stats_kernel[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\ndef norm_launch():\n    _ln_norm_kernel[(M*(N//NBN),)](x, w, b, partials, y, M, N, C, eps, BLOCK_N=NBN, BLOCK_C=triton.next_power_of_2(C), num_warps=NW)\n\nstats_launch(); norm_launch()\ntorch.cuda.synchronize()\n\n# CPU launch overhead (queue many without sync)\nt0 = time.perf_counter()\nfor _ in range(200):\n    stats_launch()\nt1 = time.perf_counter()\ntorch.cuda.synchronize()\nprint(f'CPU"]
[707.225513, "i", " cost per stats launch: {(t1-t0)/200*1e6:.1f} us')\nt0 = time.perf_counter()\nfor _ in range(200):\n    norm_launch()\nt1 = time.perf_counter()\ntorch.cuda.synchronize()\nprint(f'CPU cost per norm launch: {(t1-t0)/200*1e6:.1f} us')\n\n# GPU time via graph of 100 launches\ng = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g):\n    for _ in range(100):\n        stats_launch()\ntorch.cuda.synchronize()\ns = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\ns.record()\nfor _ in range(10):\n    g.replay()\ne.record(); torch.cuda.synchronize()\nprint(f'stats kernel GPU time: {s.elapsed_time(e)/10/100*1000:.1f} us')\n\ng2 = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g2):\n    for _ in range(100):\n        norm_launch()\ntorch.cuda.synchronize()\ns.record()\nfor _ in range(10):\n    g2.replay()\ne.record(); torch.cuda.synchronize()\nprint(f'norm kernel GPU time: {s.elapsed_time(e)/10/100*1000:.1f} us')\n\n# graph replay of the full pair, measure replay cost\ng3 = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g3):\n    "]
[707.225666, "i", "stats_launch(); norm_launch()\ntorch.cuda.synchronize()\ns.record()\nfor _ in range(100):\n    g3.replay()\ne.record(); torch.cuda.synchronize()\nprint(f'pair graph replay GPU time: {s.elapsed_time(e)/100*1000:.1f} us')\nt0 = time.perf_counter()\nfor _ in range(200):\n    g3.replay()\nt1 = time.perf_counter()\ntorch.cuda.synchronize()\nprint(f'CPU cost per graph replay: {(t1-t0)/200*1e6:.1f} us')\n\n# torch.empty cost\nt0 = time.perf_counter()\nfor _ in range(200):\n    yy = torch.empty_like(x)\n    pp = torch.empty((2, M, C), device=dev, dtype=torch.float32)\nt1 = time.perf_counter()\nprint(f'CPU cost of 2 empties: {(t1-t0)/200*1e6:.1f} us')\n\n# copy-in + clone cost\nt0 = time.perf_counter()\nfor _ in range(100):\n    x2 = x.clone()\nt1 = time.perf_counter()\ntorch.cuda.synchronize()\nprint(f'CPU cost of clone launch: {(t1-t0)/100*1e6:.1f} us')\ns.record()\nfor _ in range(100):\n    x2 = x.clone()\ne.record(); torch.cuda.synchronize()\nprint(f'GPU time of clone (67MB): {s.elapsed_time(e)/100*1000:.1f} us')\nEOF\ngpu push sb-FzEuLcuXePAWUpo63"]
