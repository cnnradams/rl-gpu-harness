[221.390335, "o", "> try:\r\n\u001b[?2004l\r"]
[221.390372, "o", "\u001b[?2004h> "]
[221.390409, "o", "    import triton\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.39045, "o", "> "]
[221.390503, "o", "    import triton.language as tl\r\n\u001b[?2004l\r"]
[221.390558, "o", "\u001b[?2004h> "]
[221.390598, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.390634, "o", "> "]
[221.390672, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.390753, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r"]
[221.390783, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.390812, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.390853, "o", "\u001b[?2004h> "]
[221.390891, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[221.390926, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[221.390976, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[221.391013, "o", "\u001b[?2004h> "]
[221.391117, "o", "    def _ln_stats_kernel(x_ptr, p_ptr, M, N, C,\r\n\u001b[?2004l\r"]
[221.391149, "o", "\u001b[?2004h> "]
[221.391253, "o", "                         BLOCK_N: tl.constexpr):\r\n\u001b[?2004l\r"]
[221.391289, "o", "\u001b[?2004h> "]
[221.391352, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[221.391389, "o", "\u001b[?2004h> "]
[221.391426, "o", "        row = pid // C\r\n\u001b[?2004l\r"]
[221.391463, "o", "\u001b[?2004h> "]
[221.391512, "o", "        cid = pid % C\r\n\u001b[?2004l\r"]
[221.391549, "o", "\u001b[?2004h> "]
[221.391625, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[221.391663, "o", "\u001b[?2004h> "]
[221.391778, "o", "        offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[221.391817, "o", "\u001b[?2004h> "]
[221.3919, "o", "        x = tl.load(x_ptr + base + offs)\r\n\u001b[?2004l\r"]
[221.391938, "o", "\u001b[?2004h> "]
[221.391982, "o", "        s1 = tl.sum(x)\r\n\u001b[?2004l\r"]
[221.392018, "o", "\u001b[?2004h> "]
[221.392073, "o", "        s2 = tl.sum(x * x)\r\n\u001b[?2004l\r"]
[221.39211, "o", "\u001b[?2004h> "]
[221.392199, "o", "        tl.store(p_ptr + row * C + cid, s1)\r\n\u001b[?2004l\r"]
[221.392236, "o", "\u001b[?2004h> "]
[221.392344, "o", "        tl.store(p_ptr + M * C + row * C + cid, s2)\r\n\u001b[?2004l\r"]
[221.392382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[221.39242, "o", "> "]
[221.392456, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.392694, "o", "    def _ln_norm_kernel(x_ptr, w_ptr, b_ptr, p_ptr, y_ptr, M, N, C, eps,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.392855, "o", "                        BLOCK_N: tl.constexpr, BLOCK_C: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.392875, "o", "> "]
[221.392943, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[221.392966, "o", "\u001b[?2004h> "]
[221.393039, "o", "        C2 = N // BLOCK_N\r\n\u001b[?2004l\r"]
[221.393079, "o", "\u001b[?2004h> "]
[221.393117, "o", "        row = pid // C2\r\n\u001b[?2004l\r"]
[221.393152, "o", "\u001b[?2004h> "]
[221.393208, "o", "        cid = pid % C2\r\n\u001b[?2004l\r"]
[221.393251, "o", "\u001b[?2004h> "]
[221.393314, "o", "        base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[221.393349, "o", "\u001b[?2004h> "]
[221.393437, "o", "        coffs = tl.arange(0, BLOCK_C)\r\n\u001b[?2004l\r"]
[221.39346, "o", "\u001b[?2004h> "]
[221.393523, "o", "        cmask = coffs < C\r\n\u001b[?2004l\r"]
[221.393554, "o", "\u001b[?2004h> "]
[221.39373, "o", "        s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cmask, other=0.0))\r\n\u001b[?2004l\r"]
[221.39377, "o", "\u001b[?2004h> "]
[221.393953, "o", "        s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))\r\n\u001b[?2004l\r"]
[221.393987, "o", "\u001b[?2004h> "]
[221.394035, "o", "        invN = 1.0 / N\r\n\u001b[?2004l\r"]
[221.394066, "o", "\u001b[?2004h> "]
[221.394125, "o", "        mean = s1 * invN\r\n\u001b[?2004l\r"]
[221.394162, "o", "\u001b[?2004h> "]
[221.394242, "o", "        var = s2 * invN - mean * mean\r\n\u001b[?2004l\r"]
[221.394274, "o", "\u001b[?2004h> "]
[221.394363, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[221.394394, "o", "\u001b[?2004h> "]
[221.394514, "o", "        offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[221.394549, "o", "\u001b[?2004h> "]
[221.394635, "o", "        x = tl.load(x_ptr + base + offs)\r\n\u001b[?2004l\r"]
[221.394667, "o", "\u001b[?2004h> "]
[221.394749, "o", "        w = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[221.39478, "o", "\u001b[?2004h> "]
[221.394857, "o", "        b = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[221.394895, "o", "\u001b[?2004h> "]
[221.394974, "o", "        y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[221.395005, "o", "\u001b[?2004h> "]
[221.395097, "o", "        tl.store(y_ptr + base + offs, y)\r\n\u001b[?2004l\r"]
[221.395127, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.395164, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.395204, "o", "\u001b[?2004h> "]
[221.395236, "o", "_STATS_BLOCK_N = 4096\r\n\u001b[?2004l\r"]
[221.395267, "o", "\u001b[?2004h> "]
[221.395305, "o", "_STATS_WARPS = 4\r\n\u001b[?2004l\r"]
[221.395344, "o", "\u001b[?2004h> "]
[221.395383, "o", "_NORM_BLOCK_N = 8192\r\n\u001b[?2004l\r"]
[221.395421, "o", "\u001b[?2004h> "]
[221.395452, "o", "_NORM_WARPS = 8\r\n\u001b[?2004l\r"]
[221.395489, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.395528, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.395566, "o", "\u001b[?2004h> "]
[221.395616, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[221.395654, "o", "\u001b[?2004h> "]
[221.395764, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[221.395802, "o", "\u001b[?2004h> "]
[221.395856, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[221.395887, "o", "\u001b[?2004h> "]
[221.395989, "o", "        if isinstance(normalized_shape, int):\r\n\u001b[?2004l\r"]
[221.396021, "o", "\u001b[?2004h> "]
[221.396136, "o", "            normalized_shape = (normalized_shape,)\r\n\u001b[?2004l\r"]
[221.396167, "o", "\u001b[?2004h> "]
[221.396292, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[221.396322, "o", "\u001b[?2004h> "]
[221.396378, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[221.39641, "o", "\u001b[?2004h> "]
[221.396568, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[221.396599, "o", "\u001b[?2004h> "]
[221.396783, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[221.39682, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[221.396856, "o", "> "]
[221.396971, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[221.397011, "o", "\u001b[?2004h> "]
[221.397046, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.397084, "o", "> "]
[221.397152, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[221.39719, "o", "\u001b[?2004h> "]
[221.397228, "o", "            N *= s\r\n\u001b[?2004l\r"]
[221.397267, "o", "\u001b[?2004h> "]
[221.397408, "o", "        if (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[221.397439, "o", "\u001b[?2004h> "]
[221.397575, "o", "                and x.is_contiguous() and x.numel() % N == 0\r\n\u001b[?2004l\r"]
[221.397613, "o", "\u001b[?2004h> "]
[221.397775, "o", "                and N % _STATS_BLOCK_N == 0 and N % _NORM_BLOCK_N == 0):\r\n\u001b[?2004l\r"]
[221.397809, "o", "\u001b[?2004h> "]
[221.397907, "o", "            return self._triton_forward(x, N)\r\n\u001b[?2004l\r"]
[221.397938, "o", "\u001b[?2004h> "]
[221.398134, "o", "        return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[221.398151, "o", "\u001b[?2004h"]
[221.398192, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.39837, "o", "    def _triton_forward(self, x: torch.Tensor, N: int) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.398408, "o", "> "]
[221.398453, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r"]
[221.398485, "o", "\u001b[?2004h> "]
[221.398586, "o", "        w = self.weight.contiguous().view(-1)\r\n\u001b[?2004l\r"]
[221.398624, "o", "\u001b[?2004h> "]
[221.398716, "o", "        b = self.bias.contiguous().view(-1)\r\n\u001b[?2004l\r"]
[221.39876, "o", "\u001b[?2004h> "]
[221.398826, "o", "        C = N // _STATS_BLOCK_N\r\n\u001b[?2004l\r"]
[221.398859, "o", "\u001b[?2004h> "]
[221.399037, "o", "        partials = torch.empty((2, M, C), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[221.399068, "o", "\u001b[?2004h> "]
[221.399139, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[221.399171, "o", "\u001b[?2004h> "]
[221.399298, "o", "        _ln_stats_kernel[(M * C,)](x, partials, M, N, C,\r\n\u001b[?2004l\r"]
[221.399329, "o", "\u001b[?2004h> "]
[221.39946, "o", "                                   BLOCK_N=_STATS_BLOCK_N,\r\n\u001b[?2004l\r"]
[221.399506, "o", "\u001b[?2004h> "]
[221.399624, "o", "                                   num_warps=_STATS_WARPS)\r\n\u001b[?2004l\r"]
[221.399655, "o", "\u001b[?2004h> "]
[221.399727, "o", "        C2 = N // _NORM_BLOCK_N\r\n\u001b[?2004l\r"]
[221.399765, "o", "\u001b[?2004h> "]
[221.399933, "o", "        _ln_norm_kernel[(M * C2,)](x, w, b, partials, y, M, N, C, self.eps,\r\n\u001b[?2004l\r"]
[221.399971, "o", "\u001b[?2004h> "]
[221.400105, "o", "                                   BLOCK_N=_NORM_BLOCK_N,\r\n\u001b[?2004l\r"]
[221.400142, "o", "\u001b[?2004h> "]
[221.400295, "o", "                                   BLOCK_C=triton.next_power_of_2(C),\r\n\u001b[?2004l\r"]
[221.400335, "o", "\u001b[?2004h> "]
[221.400461, "o", "                                   num_warps=_NORM_WARPS)\r\n\u001b[?2004l\r"]
[221.400499, "o", "\u001b[?2004h> "]
[221.400536, "o", "        return y\r\n\u001b[?2004l\r"]
[221.400568, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[221.404193, "o", "\u001b[?2004hroot@modal:/# "]
[221.404255, "o", "echo written\r\n\u001b[?2004l\rwritten\r\n"]
[221.404291, "o", "\u001b[?2004hroot@modal:/# "]
[221.774732, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch, torch.nn as nn, torch.nn.functional as F\nsys.path.insert(0, '/workspace')\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n# reference model\nsrc = open('/opt/task/reference.py').read()\nctx = {}\nexec(src, ctx)\nModel = ctx['Model']\nget_inputs = ctx['get_inputs']\nget_init_inputs = ctx['get_init_inputs']\n\ntorch.manual_seed(42)\ndev = 'cuda'\nref = Model(*get_init_inputs()).to(dev)\n\nimport solution\nsol = solution.ModelNew(*get_init_inputs()).to(dev)\n\n# correctness\nx = get_inputs()[0].to(dev)\nwith torch.no_grad():\n    r = ref(x)\n    o = sol(x)\nprint('max abs diff:', (r - o).abs().max().item())\nassert torch.allclose(r, o, atol=1e-4, rtol=1e-4), 'MISMATCH'\nprint('correct OK')\n\ninp = [x]\nwith torch.no_grad():\n    t_ref = time_execution_with_cuda_event(ref, inp, num_warmup=3, num_trials=20, discard_first=1, verbose=False, device=dev)\n    t_sol = time_execution_with_cuda_event(sol, inp, num_warmup=3, num_trials=20, discard_first=1, verbose=False, device=d"]
[221.774787, "i", "ev)\nimport numpy as np\nprint(f'ref eager: {np.mean(t_ref):.4f} ms  (min {np.min(t_ref):.4f})')\nprint(f'solution : {np.mean(t_sol):.4f} ms  (min {np.min(t_sol):.4f})')\nprint(f'speedup  : {np.mean(t_ref)/np.mean(t_sol):.3f}x')\nEOF\necho bench written\n"]
[221.775154, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.775272, "o", "import sys, torch, torch.nn as nn, torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775312, "o", "> "]
[221.775376, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775418, "o", "> "]
[221.775548, "o", "from kernelbench.timing import time_execution_with_cuda_event\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775585, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775625, "o", "> "]
[221.775656, "o", "# reference model\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775691, "o", "> "]
[221.775795, "o", "src = open('/opt/task/reference.py').read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775813, "o", "> "]
[221.775856, "o", "ctx = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.775902, "o", "> exec(src, ctx)\r\n\u001b[?2004l\r"]
[221.775944, "o", "\u001b[?2004h> "]
[221.775983, "o", "Model = ctx['Model']\r\n\u001b[?2004l\r"]
[221.776017, "o", "\u001b[?2004h> "]
[221.776084, "o", "get_inputs = ctx['get_inputs']\r\n\u001b[?2004l\r"]
[221.776118, "o", "\u001b[?2004h> "]
[221.776207, "o", "get_init_inputs = ctx['get_init_inputs']\r\n\u001b[?2004l\r"]
[221.776237, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.776275, "o", "\u001b[?2004h> "]
[221.776315, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[221.776352, "o", "\u001b[?2004h> "]
[221.776383, "o", "dev = 'cuda'\r\n\u001b[?2004l\r"]
[221.776415, "o", "\u001b[?2004h> "]
[221.7765, "o", "ref = Model(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[221.776537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.776575, "o", "\u001b[?2004h> "]
[221.776613, "o", "import solution\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.776663, "o", "> "]
[221.776779, "o", "sol = solution.ModelNew(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[221.77681, "o", "\u001b[?2004h> \r\n"]
[221.776853, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[221.776891, "o", "# correctness\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.776969, "o", "x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.777002, "o", "> "]
[221.77704, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[221.777074, "o", "\u001b[?2004h> "]
[221.777113, "o", "    r = ref(x)\r\n\u001b[?2004l\r"]
[221.777152, "o", "\u001b[?2004h> "]
[221.77719, "o", "    o = sol(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.777229, "o", "> "]
[221.777318, "o", "print('max abs diff:', (r - o).abs().max().item())\r\n\u001b[?2004l\r"]
[221.777356, "o", "\u001b[?2004h> "]
[221.777493, "o", "assert torch.allclose(r, o, atol=1e-4, rtol=1e-4), 'MISMATCH'\r\n\u001b[?2004l\r"]
[221.777535, "o", "\u001b[?2004h> "]
[221.777569, "o", "print('correct OK')\r\n\u001b[?2004l\r"]
[221.777607, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[221.777644, "o", "\u001b[?2004h> "]
[221.777683, "o", "inp = [x]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.777734, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[221.777776, "o", "\u001b[?2004h> "]
[221.778066, "o", "    t_ref = time_execution_with_cuda_event(ref, inp, num_warmup=3, num_trials=20, discard_first=1, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[221.778108, "o", "\u001b[?2004h> "]
[221.77838, "o", "    t_sol = time_execution_with_cuda_event(sol, inp, num_warmup=3, num_trials=20, discard_first=1, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[221.778421, "o", "\u001b[?2004h> "]
[221.778455, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[221.778494, "o", "\u001b[?2004h> "]
[221.778649, "o", "print(f'ref eager: {np.mean(t_ref):.4f} ms  (min {np.min(t_ref):.4f})')\r\n\u001b[?2004l\r"]
[221.77869, "o", "\u001b[?2004h> "]
[221.778857, "o", "print(f'solution : {np.mean(t_sol):.4f} ms  (min {np.min(t_sol):.4f})')\r\n\u001b[?2004l\r"]
[221.778896, "o", "\u001b[?2004h> "]
