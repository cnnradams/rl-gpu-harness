[1089.108715, "o", "\u001b[?2004h> "]
[1089.108908, "o", "        se = torch.cuda.Event(enable_timing=True); ee = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1089.108923, "o", "\u001b[?2004h"]
[1089.108963, "o", "> "]
[1089.10901, "o", "        buf.zero_()  # L2 thrash\r\n\u001b[?2004l\r"]
[1089.109047, "o", "\u001b[?2004h> "]
[1089.109113, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1089.10915, "o", "\u001b[?2004h> "]
[1089.109188, "o", "        se.record()\r\n\u001b[?2004l\r"]
[1089.109224, "o", "\u001b[?2004h> "]
[1089.109261, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.109298, "o", "> "]
[1089.109324, "o", "        ee.record()\r\n\u001b[?2004l\r"]
[1089.109359, "o", "\u001b[?2004h> "]
[1089.109421, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1089.109458, "o", "\u001b[?2004h> "]
[1089.109545, "o", "        times.append(se.elapsed_time(ee))\r\n\u001b[?2004l\r"]
[1089.109583, "o", "\u001b[?2004h> "]
[1089.109651, "o", "    return np.mean(times)*1000\r\n\u001b[?2004l\r"]
[1089.109688, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1089.109726, "o", "> "]
