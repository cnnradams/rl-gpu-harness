[783.062696, "i", "cat > /workspace/tune2.py << 'EOF'\nimport sys, time, torch, numpy as np\nimport triton\nimport triton.language as tl\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\nwb = torch.stack([w, b]).contiguous()  # (2, N)\neps = 1e-5\n\n@triton.jit\ndef _stats(x_ptr, p_ptr, M, N, C, BLOCK_N: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    cid = pid % C\n    base = row.to(tl.int64) * N\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    v = tl.load(x_ptr + base + offs)\n    tl.store(p_ptr + row * C + cid, tl.sum(v))\n    tl.store(p_ptr + M * C + row * C + cid, tl.sum(v * v))\n\n@triton.jit\ndef _norm_v1(x_ptr, wb_ptr, p_ptr, y_ptr, M, N, C, eps,\n             BLOCK_N: tl.constexpr, BLOCK_C: tl.constexpr):\n    pid = tl.program_id(0)\n    C2 = N // BLOCK_N\n    row = pid // C2\n    cid = pid % C2\n    base = row.to(tl.int64) * N\n    coffs = tl.arange(0, BLOCK_C)\n    cmask = coffs < C\n    s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cma"]
[783.062747, "i", "sk, other=0.0))\n    s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))\n    invN = 1.0 / N\n    mean = s1 * invN\n    var = s2 * invN - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n    v = tl.load(x_ptr + base + offs)\n    wbv = tl.load(wb_ptr + offs)\n    ww = tl.load(wb_ptr + N + offs)\n    y = (v - mean) * rstd * wbv + ww\n    tl.store(y_ptr + base + offs, y)\n\n@triton.jit\ndef _norm_v2(x_ptr, wb_ptr, p_ptr, y_ptr, M, N, C, eps,\n             BLOCK_N: tl.constexpr, BLOCK_C: tl.constexpr):\n    pid = tl.program_id(0)\n    C2 = N // BLOCK_N\n    row = pid // C2\n    cid = pid % C2\n    base = row.to(tl.int64) * N\n    coffs = tl.arange(0, BLOCK_C)\n    cmask = coffs < C\n    s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cmask, other=0.0))\n    s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))\n    invN = 1.0 / N\n    mean = s1 * invN\n    var = s2 * invN - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = cid * BL"]
[783.062849, "i", "OCK_N + tl.arange(0, BLOCK_N)\n    v = tl.load(x_ptr + base + offs, cache_modifier='.cg')\n    wbv = tl.load(wb_ptr + offs)\n    ww = tl.load(wb_ptr + N + offs)\n    y = (v - mean) * rstd * wbv + ww\n    tl.store(y_ptr + base + offs, y, cache_modifier='.cg')\n\ndef bench(fn, iters=20):\n    fn(); torch.cuda.synchronize()\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        for _ in range(iters):\n            fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(5):\n        g.replay()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/5/iters*1000  # us\n\nSBN, SW = 8192, 16\nC = N // SBN\npartials = torch.empty((2, M, C), device=dev, dtype=torch.float32)\ny = torch.empty_like(x)\n_stats[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\nt_stats = bench(lambda: _stats[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW))\nprint(f'stats: {t_stats:.1f} us')\n\nprint('--- v1 (stacked wb,"]
[783.062874, "i", " default cache) ---')\nbest = None\nfor NBN in [1024, 2048, 4096, 8192]:\n    for NW in [4, 8, 16]:\n        for NS in [1, 2, 3]:\n            try:\n                fn = lambda: _norm_v1[(M*(N//NBN),)](x, wb, partials, y, M, N, C, eps, BLOCK_N=NBN, BLOCK_C=triton.next_power_of_2(C), num_warps=NW, num_stages=NS)\n                t = bench(fn)\n                tag = f'NBN={NBN} NW={NW} NS={NS}'\n                if best is None or t < best[0]: best = (t, 'v1', tag)\n                print(f'v1 {tag}: {t:.1f} us')\n            except Exception as ex:\n                print(f'v1 NBN={NBN} NW={NW} NS={NS}: FAIL')\nprint('--- v2 (stacked wb, .cg streaming) ---')\nfor NBN in [1024, 2048, 4096, 8192]:\n    for NW in [4, 8, 16]:\n        for NS in [1, 2, 3]:\n            try:\n                fn = lambda: _norm_v2[(M*(N//NBN),)](x, wb, partials, y, M, N, C, eps, BLOCK_N=NBN, BLOCK_C=triton.next_power_of_2(C), num_warps=NW, num_stages=NS)\n                t = bench(fn)\n                tag = f'NBN={NBN} NW={NW} NS={NS}'\n                if t"]
[783.062902, "i", " < best[0]: best = (t, 'v2', tag)\n                print(f'v2 {tag}: {t:.1f} us')\n            except Exception as ex:\n                print(f'v2 NBN={NBN} NW={NW} NS={NS}: FAIL')\nprint('BEST:', best)\n# correctness spot check\nr = torch.nn.functional.layer_norm(x, (N,), w, b, eps)\n_norm_v1[(M*(N//4096),)](x, wb, partials, y, M, N, C, eps, BLOCK_N=4096, BLOCK_C=triton.next_power_of_2(C), num_warps=8)\ntorch.cuda.synchronize()\nprint('v1 maxdiff:', (r-y).abs().max().item())\n_norm_v2[(M*(N//4096),)](x, wb, partials, y, M, N, C, eps, BLOCK_N=4096, BLOCK_C=triton.next_power_of_2(C), num_warps=8)\ntorch.cuda.synchronize()\nprint('v2 maxdiff:', (r-y).abs().max().item())\nEOF\ngpu push sb-FzEuLcuXePAWUpo631160R /workspace/tune2.py /tmp/tune2.py && gpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /tmp/tune2.py\n"]
