[1305.32916, "i", "cat > /workspace/tune7.py << 'EOF'\nimport sys, time, torch, numpy as np\nimport triton\nimport triton.language as tl\nsys.path.insert(0, '/tmp')\nfrom solution import _ln_stats_kernel\n\ndev = 'cuda'\nM, N = 16, 64*256*256\nx = torch.rand(M, N, device=dev)\ny = torch.empty_like(x)\nSBN, SW = 8192, 16\nC = N // SBN\npartials = torch.empty(2*M*C, device=dev, dtype=torch.float32)\n_ln_stats_kernel[(M*C,)](x, partials, M, N, C, BLOCK_N=SBN, num_warps=SW)\ntorch.cuda.synchronize()\nref = partials.clone()\n\nkc = _ln_stats_kernel.device_caches\ndev_cache = kc[list(kc.keys())[0]][0]\nck = list(dev_cache.values())[0]\nck._init_handles()\nmd = ck.metadata\nprint('global_scratch_size:', md.global_scratch_size, 'profile_scratch:', getattr(md, 'profile_scratch_size', None))\nstream = torch.cuda.current_stream().cuda_stream\npartials2 = torch.empty_like(partials)\n\ntry:\n    ck.run(M*C, 1, 1, stream, ck.function, x, partials2, M, N, C)\n    torch.cuda.synchronize()\n    print('variant A works, match:', torch.equal(ref, partials2))\nexcept Exception a"]
[1305.329446, "i", "s ex:\n    print('variant A failed:', ex)\n    try:\n        ck.run(M*C, 1, 1, stream, ck.function, x, partials2, M, N, C, None)\n        torch.cuda.synchronize()\n        print('variant B works, match:', torch.equal(ref, partials2))\n    except Exception as ex2:\n        print('variant B failed:', ex2)\n\ntry:\n    t0 = time.perf_counter()\n    for _ in range(300):\n        ck.run(M*C, 1, 1, stream, ck.function, x, partials2, M, N, C)\n    t1 = time.perf_counter()\n    torch.cuda.synchronize()\n    print(f'direct run CPU cost: {(t1-t0)/300*1e6:.2f} us')\nexcept Exception as ex:\n    print('timing failed:', ex)\n\n# compare with standard launch\nt0 = time.perf_counter()\nfor _ in range(300):\n    _ln_stats_kernel[(M*C,)](x, partials2, M, N, C, BLOCK_N=SBN, num_warps=SW)\nt1 = time.perf_counter()\ntorch.cuda.synchronize()\nprint(f'standard launch CPU cost: {(t1-t0)/300*1e6:.2f} us')\nEOF\ngpu push sb-FzEuLcuXePAWUpo631160R /workspace/tune7.py /tmp/tune7.py && gpu exec sb-FzEuLcuXePAWUpo631160R -- python3 /tmp/tune7.py\n"]
