[863.442724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[863.442763, "o", "> "]
[863.442953, "o", "# read x + w + b, write y but w/b tiny rows... test L2 effect: map over only 1 row repeatedly\r\n\u001b[?2004l\r"]
[863.442996, "o", "\u001b[?2004h> "]
[863.443033, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[863.443203, "o", "def _map_1row(x_ptr, w_ptr, b_ptr, y_ptr, N, BLOCK_N: tl.constexpr):\r\n\u001b[?2004l\r"]
[863.443239, "o", "\u001b[?2004h> "]
[863.443293, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[863.443332, "o", "\u001b[?2004h> "]
[863.443441, "o", "    offs = pid * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[863.443479, "o", "\u001b[?2004h> "]
[863.44354, "o", "    v = tl.load(x_ptr + offs)\r\n\u001b[?2004l\r"]
[863.443578, "o", "\u001b[?2004h> "]
[863.443641, "o", "    ww = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[863.443667, "o", "\u001b[?2004h> "]
[863.443747, "o", "    bb = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[863.443784, "o", "\u001b[?2004h> "]
[863.443894, "o", "    tl.store(y_ptr + offs, (v - 0.5) * 2.0 * ww + bb)\r\n\u001b[?2004l\r"]
[863.443932, "o", "\u001b[?2004h> "]
[863.444092, "o", "fn = lambda: _map_1row[(N//4096,)](x, w, b, y, N, BLOCK_N=4096, num_warps=4)\r\n\u001b[?2004l\r"]
[863.44413, "o", "\u001b[?2004h> "]
[863.444304, "o", "print(f'map 1 row (w/b hot): {bench(fn):.1f} us  (scale x16 = {16*bench(fn):.0f})')\r\n\u001b[?2004l\r"]
[863.444341, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
