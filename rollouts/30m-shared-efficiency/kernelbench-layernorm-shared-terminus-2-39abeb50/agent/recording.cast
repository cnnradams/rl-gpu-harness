[221.389656, "i", "mkdir -p /workspace && cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n\n    @triton.jit\n    def _ln_stats_kernel(x_ptr, p_ptr, M, N, C,\n                         BLOCK_N: tl.constexpr):\n        pid = tl.program_id(0)\n        row = pid // C\n        cid = pid % C\n        base = row.to(tl.int64) * N\n        offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n        x = tl.load(x_ptr + base + offs)\n        s1 = tl.sum(x)\n        s2 = tl.sum(x * x)\n        tl.store(p_ptr + row * C + cid, s1)\n        tl.store(p_ptr + M * C + row * C + cid, s2)\n\n    @triton.jit\n    def _ln_norm_kernel(x_ptr, w_ptr, b_ptr, p_ptr, y_ptr, M, N, C, eps,\n                        BLOCK_N: tl.constexpr, BLOCK_C: tl.constexpr):\n        pid = tl.program_id(0)\n        C2 = N // BLOCK_N\n        row = pid // C2\n        cid = pid % C2\n        base = row.to(tl."]
[221.389699, "i", "int64) * N\n        coffs = tl.arange(0, BLOCK_C)\n        cmask = coffs < C\n        s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cmask, other=0.0))\n        s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))\n        invN = 1.0 / N\n        mean = s1 * invN\n        var = s2 * invN - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)\n        x = tl.load(x_ptr + base + offs)\n        w = tl.load(w_ptr + offs)\n        b = tl.load(b_ptr + offs)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_ptr + base + offs, y)\n\n\n_STATS_BLOCK_N = 4096\n_STATS_WARPS = 4\n_NORM_BLOCK_N = 8192\n_NORM_WARPS = 8\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        if isinstance(normalized_shape, int):\n            normalized_shape = (normalized_shape,)\n        self.normalized_shape = tuple(normalized_shape)\n        self.eps = 1e-5\n        self.weight = nn.Parameter(torch.ones(self.normalize"]
[221.389714, "i", "d_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        N = 1\n        for s in self.normalized_shape:\n            N *= s\n        if (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32\n                and x.is_contiguous() and x.numel() % N == 0\n                and N % _STATS_BLOCK_N == 0 and N % _NORM_BLOCK_N == 0):\n            return self._triton_forward(x, N)\n        return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\n\n    def _triton_forward(self, x: torch.Tensor, N: int) -> torch.Tensor:\n        M = x.numel() // N\n        w = self.weight.contiguous().view(-1)\n        b = self.bias.contiguous().view(-1)\n        C = N // _STATS_BLOCK_N\n        partials = torch.empty((2, M, C), device=x.device, dtype=torch.float32)\n        y = torch.empty_like(x)\n        _ln_stats_kernel[(M * C,)](x, partials, M, N, C,\n                                   BLOCK_N=_STATS_BLOCK_N,\n                              "]
[221.389727, "i", "     num_warps=_STATS_WARPS)\n        C2 = N // _NORM_BLOCK_N\n        _ln_norm_kernel[(M * C2,)](x, w, b, partials, y, M, N, C, self.eps,\n                                   BLOCK_N=_NORM_BLOCK_N,\n                                   BLOCK_C=triton.next_power_of_2(C),\n                                   num_warps=_NORM_WARPS)\n        return y\nEOF\necho written\n"]
