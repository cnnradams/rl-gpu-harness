[1165.514252, "o", "\u001b[?2004h> "]
[1165.514361, "o", "            return self._triton_forward(x, N)\r\n\u001b[?2004l\r"]
[1165.514387, "o", "\u001b[?2004h> "]
[1165.514588, "o", "        return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[1165.514615, "o", "\u001b[?2004h> \r\n"]
[1165.51463, "o", "\u001b[?2004l\r"]
[1165.514647, "o", "\u001b[?2004h> "]
[1165.514827, "o", "    def _triton_forward(self, x: torch.Tensor, N: int) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[1165.514853, "o", "\u001b[?2004h> "]
[1165.514912, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r"]
[1165.514938, "o", "\u001b[?2004h> "]
[1165.515046, "o", "        w = self.weight.contiguous().view(-1)\r\n\u001b[?2004l\r"]
[1165.515073, "o", "\u001b[?2004h> "]
[1165.515177, "o", "        b = self.bias.contiguous().view(-1)\r\n\u001b[?2004l\r"]
[1165.515198, "o", "\u001b[?2004h> "]
[1165.51528, "o", "        C = N // _STATS_BLOCK_N\r\n\u001b[?2004l\r"]
[1165.515307, "o", "\u001b[?2004h> "]
[1165.515501, "o", "        ws = torch.empty(2 * M * C + 2 * M, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1165.515529, "o", "\u001b[?2004h> "]
[1165.515603, "o", "        partials = ws[:2 * M * C]\r\n\u001b[?2004l\r"]
[1165.515621, "o", "\u001b[?2004h"]
[1165.515643, "o", "> "]
[1165.515707, "o", "        mr = ws[2 * M * C:]\r\n\u001b[?2004l\r"]
[1165.515731, "o", "\u001b[?2004h> "]
[1165.515808, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1165.51583, "o", "\u001b[?2004h> "]
[1165.515967, "o", "        _ln_stats_kernel[(M * C,)](x, partials, M, N, C,\r\n\u001b[?2004l\r"]
[1165.515984, "o", "\u001b[?2004h"]
[1165.516005, "o", "> "]
[1165.516131, "o", "                                   BLOCK_N=_STATS_BLOCK_N,\r\n\u001b[?2004l\r"]
[1165.516152, "o", "\u001b[?2004h> "]
[1165.516294, "o", "                                   num_warps=_STATS_WARPS)\r\n\u001b[?2004l\r"]
[1165.516321, "o", "\u001b[?2004h> "]
[1165.516462, "o", "        _ln_reduce_kernel[(M,)](partials, mr, N, C, self.eps,\r\n\u001b[?2004l\r"]
[1165.516484, "o", "\u001b[?2004h> "]
[1165.516667, "o", "                                BLOCK_C=triton.next_power_of_2(C),\r\n\u001b[?2004l\r"]
[1165.516695, "o", "\u001b[?2004h> "]
[1165.516796, "o", "                                num_warps=4)\r\n\u001b[?2004l\r"]
[1165.516818, "o", "\u001b[?2004h> "]
[1165.516977, "o", "        _ln_map_kernel[(N // _MAP_BLOCK_N,)](x, w, b, mr, y, M, N,\r\n\u001b[?2004l\r"]
[1165.516998, "o", "\u001b[?2004h> "]
[1165.517157, "o", "                                             BLOCK_N=_MAP_BLOCK_N,\r\n\u001b[?2004l\r"]
[1165.517185, "o", "\u001b[?2004h> "]
[1165.517337, "o", "                                             num_warps=_MAP_WARPS)\r\n\u001b[?2004l\r"]
[1165.517358, "o", "\u001b[?2004h> "]
[1165.517406, "o", "        return y\r\n\u001b[?2004l\r"]
[1165.517428, "o", "\u001b[?2004h> "]
[1165.517449, "o", "EOF\r\n\u001b[?2004l\r"]
[1165.519019, "o", "\u001b[?2004hroot@modal:/# "]
