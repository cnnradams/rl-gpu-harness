[?2004l[?2004h>                 and N % _STATS_BLOCK_N == 0 and N % _NORM_BLOCK_N == 0):
[?2004l[?2004h>             return self._triton_forward(x, N)
[?2004l[?2004h>         return F.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)
[?2004l[?2004h> 
[?2004l[?2004h>     def _triton_forward(self, x: torch.Tensor, N: int) -> torch.Tensor:
[?2004l[?2004h>         M = x.numel() // N
[?2004l[?2004h>         w = self.weight.contiguous().view(-1)
[?2004l[?2004h>         b = self.bias.contiguous().view(-1)
[?2004l[?2004h>         C = N // _STATS_BLOCK_N
[?2004l[?2004h>         partials = torch.empty((2, M, C), device=x.device, dtype=torch.float32)
[?2004l[?2004h>         y = torch.empty_like(x)
