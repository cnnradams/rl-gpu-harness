except Exception as ex:
    print('direct ck[grid] failed:', ex)

# end-to-end harness-like timing of full + empty_like
def harness_like(fn, trials=30):
    times = []
    buf = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)
    for _ in range(3):
        fn()
    torch.cuda.synchronize()
    for _ in range(trials):
        torch.cuda.synchronize()
        se = torch.cuda.Event(enable_timing=True); ee = torch.cuda.Event(enable_timing=True)
        buf.zero_()  # L2 thrash
        torch.cuda.synchronize()
        se.record()
        fn()
        ee.record()
        torch.cuda.synchronize()
        times.append(se.elapsed_time(ee))
    return np.mean(times)*1000

