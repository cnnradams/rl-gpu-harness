[?2004l[?2004h>                                    BLOCK_N=_NORM_BLOCK_N,
[?2004l[?2004h>                                    BLOCK_C=triton.next_power_of_2(C),
[?2004l[?2004h>                                    num_warps=_NORM_WARPS)
[?2004l[?2004h>         return y
