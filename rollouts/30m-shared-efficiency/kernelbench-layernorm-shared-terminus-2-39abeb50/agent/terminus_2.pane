[?2004l[?2004h> 
[?2004l[?2004h> try:
[?2004l[?2004h>     import triton
[?2004l[?2004h>     import triton.language as tl
[?2004l[?2004h>     _HAS_TRITON = True
[?2004l[?2004h> except Exception:
[?2004l[?2004h>     _HAS_TRITON = False
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if _HAS_TRITON:
[?2004l[?2004h> 
[?2004l[?2004h>     @triton.jit
[?2004l[?2004h>     def _ln_stats_kernel(x_ptr, p_ptr, M, N, C,
[?2004l[?2004h>                          BLOCK_N: tl.constexpr):
[?2004l[?2004h>         pid = tl.program_id(0)
[?2004l[?2004h>         row = pid // C
[?2004l[?2004h>         cid = pid % C
[?2004l[?2004h>         base = row.to(tl.int64) * N
[?2004l[?2004h>         offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)
[?2004l[?2004h>         x = tl.load(x_ptr + base + offs)
[?2004l[?2004h>         s1 = tl.sum(x)
[?2004l[?2004h>         s2 = tl.sum(x * x)
[?2004l[?2004h>         tl.store(p_ptr + row * C + cid, s1)
[?2004l[?2004h>         tl.store(p_ptr + M * C + row * C + cid, s2)
[?2004l[?2004h> 
[?2004l[?2004h>     @triton.jit
[?2004l[?2004h>     def _ln_norm_kernel(x_ptr, w_ptr, b_ptr, p_ptr, y_ptr, M, N, C, eps,
[?2004l[?2004h>                         BLOCK_N: tl.constexpr, BLOCK_C: tl.constexpr):
[?2004l[?2004h>         pid = tl.program_id(0)
[?2004l[?2004h>         C2 = N // BLOCK_N
[?2004l[?2004h>         row = pid // C2
[?2004l[?2004h>         cid = pid % C2
[?2004l[?2004h>         base = row.to(tl.int64) * N
[?2004l[?2004h>         coffs = tl.arange(0, BLOCK_C)
[?2004l[?2004h>         cmask = coffs < C
[?2004l[?2004h>         s1 = tl.sum(tl.load(p_ptr + row * C + coffs, mask=cmask, other=0.0))
[?2004l[?2004h>         s2 = tl.sum(tl.load(p_ptr + M * C + row * C + coffs, mask=cmask, other=0.0))
[?2004l[?2004h>         invN = 1.0 / N
[?2004l[?2004h>         mean = s1 * invN
[?2004l[?2004h>         var = s2 * invN - mean * mean
[?2004l[?2004h>         rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>         offs = cid * BLOCK_N + tl.arange(0, BLOCK_N)
[?2004l[?2004h>         x = tl.load(x_ptr + base + offs)
[?2004l[?2004h>         w = tl.load(w_ptr + offs)
[?2004l[?2004h>         b = tl.load(b_ptr + offs)
[?2004l[?2004h>         y = (x - mean) * rstd * w + b
[?2004l[?2004h>         tl.store(y_ptr + base + offs, y)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> _STATS_BLOCK_N = 4096
[?2004l[?2004h> _STATS_WARPS = 4
[?2004l[?2004h> _NORM_BLOCK_N = 8192
[?2004l[?2004h> _NORM_WARPS = 8
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
