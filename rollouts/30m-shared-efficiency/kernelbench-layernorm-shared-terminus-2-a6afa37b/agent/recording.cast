[465.484027, "o", "a NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\n(128, 2048, 4, 3, 0, 4096, 4, 3, 0) ms: 0.3569834649562836 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\n(128, 2048, 4, 3, 0, 1024, 4, 3, 0) ms: 0.32762239972750345 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\n(64, 2048, 4, 3, 0, 2048, 4, 3, 0) ms: 0.3177813351154327 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\n(64, 4096, 4, 3, 0, 2048, 4, 3, 0) ms: 0.3179370661576589 maxdiff 3.4570693969726562e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\nstats only ms: 0.10224213401476542\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\napply2 only ms: 0.2776533305644989\r\n"]
[467.02172, "o", "\u001b[?2004hroot@modal:/# "]
[540.595576, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndev = 'cuda'\nNshape = (64, 256, 256)\nN = 64*256*256\nrows = 16\nln = nn.LayerNorm(Nshape).to(dev)\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\ny = torch.empty_like(x)\nw = ln.weight.contiguous().view(-1)\nb = ln.bias.contiguous().view(-1)\neps = ln.eps\ny0 = ln(x)\n\ndef t(fn, n=15):\n    ts = time_execution_with_cuda_event(fn, [], num_trials=n, verbose=False, device=dev)\n    return sum(ts)/len(ts)\n\n@triton.jit\ndef _stats_nm(X, PM, PV, N: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    lo = pid * CHUNK\n    s = 0.0\n    ss = 0.0\n    for off0 in tl.static_range(lo, lo + CHUNK, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        xv = tl.load(X + row * N + idx)\n        s += tl.sum(xv, 0)\n        ss += tl.sum(xv * xv, 0)\n    ns = tl.num_programs(0)\n    tl.sto"]
[540.59562, "i", "re(PM + row * ns + pid, s)\n    tl.store(PV + row * ns + pid, ss)\n\n@triton.jit\ndef _apply_nm(X, W, B, PM, PV, Y, N: tl.constexpr, NS: tl.constexpr, EPS: tl.constexpr, BLOCK: tl.constexpr, BLOCK_NS: tl.constexpr, EVW: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    off = tl.arange(0, BLOCK_NS)\n    nsmask = off < NS\n    s = tl.sum(tl.load(PM + row * NS + off, mask=nsmask, other=0.0), 0)\n    ss = tl.sum(tl.load(PV + row * NS + off, mask=nsmask, other=0.0), 0)\n    mean = s / N\n    var = ss / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    idx = pid * BLOCK + tl.arange(0, BLOCK)\n    xv = tl.load(X + row * N + idx, eviction_policy='evict_first')\n    if EVW == 1:\n        wv = tl.load(W + idx, eviction_policy='evict_last')\n        bv = tl.load(B + idx, eviction_policy='evict_last')\n    else:\n        wv = tl.load(W + idx)\n        bv = tl.load(B + idx)\n    tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\n\ndef npo2(n):\n    p = 1\n    while p < n: p *"]
[540.595756, "i", "= 2\n    return p\n\n# stats no-mask test\nfor (splits, BS, ws) in [(64,2048,4),(64,4096,4),(64,4096,8),(128,2048,4),(64,2048,8),(32,4096,4)]:\n    chunk = N // splits\n    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    fn = lambda: _stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=BS, num_warps=ws)\n    print('stats nm', (splits, BS, ws), 'ms:', t(fn))\n\n# apply no-mask one-tile test (partials precomputed)\nsplits = 64\nchunk = N // splits\npm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\npv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n_stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=2048, num_warps=4)\ntorch.cuda.synchronize()\nfor (BA, wa, evw) in [(1024,4,0),(2048,4,0),(2048,8,0),(4096,4,0),(4096,8,0),(1024,4,1),(2048,4,1),(8192,8,0),(512,4,0),(1024,8,0)]:\n    grid_a = N // BA\n    fn = lambda: _apply_nm[(grid_a, rows)](x, w, b, pm, pv, y, N=N, NS=splits, EPS=eps, BLOCK="]
[540.595798, "i", "BA, BLOCK_NS=npo2(splits), EVW=evw, num_warps=wa)\n    fn(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    print('apply nm', (BA, wa, evw), 'ms:', t(fn), 'maxdiff', md)\n\n# best 2-kernel combo\ndef combo(splits, BS, ws, BA, wa, evw):\n    chunk = N // splits\n    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    grid_a = N // BA\n    def run():\n        _stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=BS, num_warps=ws)\n        _apply_nm[(grid_a, rows)](x, w, b, pm, pv, y, N=N, NS=splits, EPS=eps, BLOCK=BA, BLOCK_NS=npo2(splits), EVW=evw, num_warps=wa)\n    return run\nfor c in [(64,2048,4,2048,4,0),(64,2048,4,1024,4,0),(64,2048,4,2048,4,1),(64,4096,8,2048,4,1)]:\n    run = combo(*c)\n    run(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    print('combo', c, 'ms:', t(run), 'maxdiff', md)\nEOF\ngpu push sb-KQ0yKfTnYDRkksell7LpJe /workspace/bench4.py /workspace/bench4.py && gpu exec sb"]
