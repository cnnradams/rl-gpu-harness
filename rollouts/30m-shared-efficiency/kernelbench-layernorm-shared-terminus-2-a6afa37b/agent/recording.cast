[698.742267, "o", "\u001b[?2004h> "]
[698.74238, "o", "    rstd = 1.0 / tl.sqrt(var + EPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[698.742423, "o", "    lo = pid * CHUNK\r\n\u001b[?2004l\r"]
[698.742448, "o", "\u001b[?2004h"]
[698.742478, "o", "> "]
[698.742531, "o", "    hi = tl.minimum(lo + CHUNK, N)\r\n\u001b[?2004l\r"]
[698.742561, "o", "\u001b[?2004h> "]
[698.742642, "o", "    for off0 in range(lo, hi, BLOCK):\r\n\u001b[?2004l\r"]
[698.742664, "o", "\u001b[?2004h> "]
[698.742762, "o", "        idx = off0 + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[698.742785, "o", "\u001b[?2004h> "]
[698.742846, "o", "        mask = idx < hi\r\n\u001b[?2004l\r"]
[698.742878, "o", "\u001b[?2004h> "]
[698.74292, "o", "        if EV == 0:\r\n\u001b[?2004l\r"]
[698.74294, "o", "\u001b[?2004h> "]
[698.743095, "o", "            xv = tl.load(X + row * N + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[698.743119, "o", "\u001b[?2004h> "]
[698.743249, "o", "            wv = tl.load(W + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[698.743266, "o", "\u001b[?2004h> "]
[698.743412, "o", "            bv = tl.load(B + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[698.743446, "o", "\u001b[?2004h> "]
[698.74362, "o", "            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask)\r\n\u001b[?2004l\r"]
[698.743652, "o", "\u001b[?2004h> "]
[698.743696, "o", "        elif EV == 1:\r\n\u001b[?2004l\r"]
[698.743716, "o", "\u001b[?2004h> "]
[698.743953, "o", "            xv = tl.load(X + row * N + idx, mask=mask, other=0.0, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.74398, "o", "> "]
[698.744176, "o", "            wv = tl.load(W + idx, mask=mask, other=0.0, eviction_policy='evict_last')\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.744197, "o", "> "]
[698.744404, "o", "            bv = tl.load(B + idx, mask=mask, other=0.0, eviction_policy='evict_last')\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.744432, "o", "> "]
[698.744682, "o", "            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.744708, "o", "> \r\n\u001b[?2004l\r"]
[698.744726, "o", "\u001b[?2004h> "]
[698.744764, "o", "def npo2(n):\r\n\u001b[?2004l\r"]
[698.744794, "o", "\u001b[?2004h> "]
[698.744814, "o", "    p = 1\r\n\u001b[?2004l\r"]
[698.744839, "o", "\u001b[?2004h> "]
[698.744903, "o", "    while p < n: p *= 2\r\n\u001b[?2004l\r"]
[698.744933, "o", "\u001b[?2004h> "]
[698.744961, "o", "    return p\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.744981, "o", "> \r\n\u001b[?2004l\r"]
[698.745001, "o", "\u001b[?2004h> "]
[698.745094, "o", "# precompute partials with splits=64\r\n\u001b[?2004l\r"]
[698.74512, "o", "\u001b[?2004h> "]
[698.745147, "o", "splits = 64\r\n"]
[698.745175, "o", "\u001b[?2004l\r\u001b[?2004h"]
[698.745205, "o", "> "]
[698.745238, "o", "chunk = N // splits\r\n\u001b[?2004l\r"]
[698.745265, "o", "\u001b[?2004h> "]
[698.745437, "o", "pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.74546, "o", "> "]
[698.745604, "o", "pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[698.745627, "o", "\u001b[?2004h> "]
[698.745793, "o", "_stats[(splits, rows)](x, pm, pv, N, chunk, BLOCK=2048, num_warps=4)\r\n\u001b[?2004l\r"]
[698.745817, "o", "\u001b[?2004h> "]
[698.745874, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[698.745901, "o", "\u001b[?2004h> \r\n"]
[698.745923, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[698.746023, "o", "for (asplits, BA, wa, ev, sw) in [\r\n\u001b[?2004l\r"]
[698.746037, "o", "\u001b[?2004h> "]
[698.746092, "o", "    (64,2048,4,0,0),\r\n\u001b[?2004l\r"]
[698.746112, "o", "\u001b[?2004h> "]
[698.746171, "o", "    (128,2048,4,0,0),\r\n\u001b[?2004l\r"]
[698.746201, "o", "\u001b[?2004h> "]
[698.74626, "o", "    (256,2048,4,0,0),\r\n\u001b[?2004l\r"]
[698.746289, "o", "\u001b[?2004h> "]
[698.746345, "o", "    (128,2048,4,1,0),\r\n\u001b[?2004l\r"]
[698.746375, "o", "\u001b[?2004h> "]
[698.746423, "o", "    (64,2048,4,1,0),\r\n\u001b[?2004l\r"]
[698.746444, "o", "\u001b[?2004h> "]
[698.746496, "o", "    (64,2048,4,1,1),\r\n\u001b[?2004l\r"]
[698.746519, "o", "\u001b[?2004h"]
[698.746542, "o", "> "]
[698.746568, "o", "    (64,2048,4,0,1),\r\n"]
[698.746599, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[698.746649, "o", "    (32,2048,4,1,0),\r\n\u001b[?2004l\r"]
[698.746666, "o", "\u001b[?2004h"]
[698.746689, "o", "> "]
[698.746725, "o", "    (64,1024,4,1,0),\r\n\u001b[?2004l\r"]
[698.746755, "o", "\u001b[?2004h> "]
[698.746798, "o", "    (64,4096,8,1,0),\r\n\u001b[?2004l\r"]
[698.746819, "o", "\u001b[?2004h> "]
[698.746839, "o", "]:\r\n\u001b[?2004l\r"]
[698.746869, "o", "\u001b[?2004h> "]
[698.746925, "o", "    chunk_a = N // asplits\r\n\u001b[?2004l\r"]
[698.74694, "o", "\u001b[?2004h"]
[698.746956, "o", "> "]
[698.747331, "o", "    fn = lambda: _apply[(asplits, rows)](x, w, b, pm, pv, y, N, NS=splits, EPS=eps, CHUNK=chunk_a, BLOCK=BA, BLOCK_NS=npo2(splits), EV=ev, SW=sw, num_warps=wa)\r\n\u001b[?2004l\r"]
[698.747364, "o", "\u001b[?2004h> "]
[698.747434, "o", "    fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[698.747462, "o", "\u001b[?2004h> "]
[698.747544, "o", "    md = (y0 - y).abs().max().item()\r\n\u001b[?2004l\r"]
[698.747565, "o", "\u001b[?2004h"]
[698.74758, "o", "> "]
[698.747745, "o", "    print('apply', (asplits, BA, wa, ev, sw), 'ms:', t(fn), 'maxdiff', md)\r\n\u001b[?2004l\r"]
[698.747764, "o", "\u001b[?2004h"]
[698.747781, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[698.74786, "o", "# full combos with best apply\r\n\u001b[?2004l\r"]
[698.747888, "o", "\u001b[?2004h> "]
[698.748007, "o", "def combo(ssplits, BS, ws, asplits, BA, wa, ev, sw):\r\n\u001b[?2004l\r"]
[698.748039, "o", "\u001b[?2004h> "]
[698.748094, "o", "    schunk = N // ssplits\r\n\u001b[?2004l\r"]
[698.748117, "o", "\u001b[?2004h> "]
[698.74828, "o", "    pm = torch.empty((rows, ssplits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[698.748302, "o", "\u001b[?2004h> "]
[698.748473, "o", "    pv = torch.empty((rows, ssplits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[698.748495, "o", "\u001b[?2004h> "]
[698.748559, "o", "    achunk = N // asplits\r\n\u001b[?2004l\r"]
[698.748586, "o", "\u001b[?2004h> "]
[698.748628, "o", "    def run():\r\n\u001b[?2004l\r"]
[698.748651, "o", "\u001b[?2004h"]
[698.748682, "o", "> "]
[698.748832, "o", "        _stats[(ssplits, rows)](x, pm, pv, N, schunk, BLOCK=BS, num_warps=ws)\r\n\u001b[?2004l\r"]
[698.748852, "o", "\u001b[?2004h> "]
[698.749206, "o", "        _apply[(asplits, rows)](x, w, b, pm, pv, y, N, NS=ssplits, EPS=eps, CHUNK=achunk, BLOCK=BA, BLOCK_NS=npo2(ssplits), EV=ev, SW=sw, num_warps=wa)\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.749231, "o", "> "]
[698.749261, "o", "    return run\r\n\u001b[?2004l\r"]
[698.749281, "o", "\u001b[?2004h> "]
[698.749516, "o", "for c in [(64,2048,4,64,2048,4,1,0),(64,2048,4,128,2048,4,1,0),(128,2048,4,128,2048,4,1,0)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.749541, "o", "> "]
[698.74958, "o", "    run = combo(*c)\r\n\u001b[?2004l\r"]
[698.749601, "o", "\u001b[?2004h> "]
[698.749694, "o", "    run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[698.749713, "o", "\u001b[?2004h"]
[698.74973, "o", "> "]
[698.749799, "o", "    md = (y0 - y).abs().max().item()\r\n\u001b[?2004l\r"]
[698.74983, "o", "\u001b[?2004h> "]
[698.749944, "o", "    print('combo', c, 'ms:', t(run), 'maxdiff', md)\r\n\u001b[?2004l\r"]
[698.749967, "o", "\u001b[?2004h"]
[698.749987, "o", "> EOF\r\n\u001b[?2004l\r"]
