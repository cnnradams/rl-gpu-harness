[130.649675, "o", "[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\neager LN ms: 8.064886379241944\r\nmax diff 3.4570693969726562e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\ntriton LN ms: 0.4072480037808418\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\ncompiled LN ms: 0.45169920176267625\r\n"]
