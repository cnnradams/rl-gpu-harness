[448.374341, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndev = 'cuda'\nNshape = (64, 256, 256)\nN = 64*256*256\nrows = 16\nln = nn.LayerNorm(Nshape).to(dev)\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\ny = torch.empty_like(x)\nw = ln.weight.contiguous().view(-1)\nb = ln.bias.contiguous().view(-1)\neps = ln.eps\ny0 = ln(x)\n\ndef t(fn, n=15):\n    ts = time_execution_with_cuda_event(fn, [], num_trials=n, verbose=False, device=dev)\n    return sum(ts)/len(ts)\n\n@triton.jit\ndef _stats(X, PM, PV, N, CHUNK, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    lo = pid * CHUNK\n    hi = tl.minimum(lo + CHUNK, N)\n    s = 0.0\n    ss = 0.0\n    for off0 in range(lo, hi, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        mask = idx < hi\n        if EV == 1:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0, eviction_policy='evict_f"]
[448.374392, "i", "irst')\n        else:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0)\n        s += tl.sum(xv, 0)\n        ss += tl.sum(xv * xv, 0)\n    ns = tl.num_programs(0)\n    tl.store(PM + row * ns + pid, s)\n    tl.store(PV + row * ns + pid, ss)\n\n@triton.jit\ndef _apply2(X, W, B, PM, PV, Y, N, NS: tl.constexpr, EPS: tl.constexpr, CHUNK, BLOCK: tl.constexpr, BLOCK_NS: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    off = tl.arange(0, BLOCK_NS)\n    nsmask = off < NS\n    s = tl.sum(tl.load(PM + row * NS + off, mask=nsmask, other=0.0), 0)\n    ss = tl.sum(tl.load(PV + row * NS + off, mask=nsmask, other=0.0), 0)\n    mean = s / N\n    var = ss / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    lo = pid * CHUNK\n    hi = tl.minimum(lo + CHUNK, N)\n    for off0 in range(lo, hi, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        mask = idx < hi\n        if EV == 1:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0, eviction_policy='evict_first')\n    "]
[448.374405, "i", "        wv = tl.load(W + idx, mask=mask, other=0.0, eviction_policy='evict_first')\n            bv = tl.load(B + idx, mask=mask, other=0.0, eviction_policy='evict_first')\n            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask, eviction_policy='evict_first')\n        else:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0)\n            wv = tl.load(W + idx, mask=mask, other=0.0)\n            bv = tl.load(B + idx, mask=mask, other=0.0)\n            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask)\n\ndef npo2(n):\n    p = 1\n    while p < n: p *= 2\n    return p\n\ndef mk2(splits_t, BLOCK_S, warps_s, stages_s, ev_s, BLOCK_A, warps_a, stages_a, ev_a):\n    chunk = ((N + splits_t - 1) // splits_t + BLOCK_S - 1) // BLOCK_S * BLOCK_S\n    splits = (N + chunk - 1) // chunk\n    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    chunk_a = ((N + splits_t - 1) // splits_t + BLOCK_A - 1) /"]
[448.374769, "i", "/ BLOCK_A * BLOCK_A\n    splits_a = (N + chunk_a - 1) // chunk_a\n    bns = npo2(splits)\n    def run():\n        _stats[(splits, rows)](x, pm, pv, N, chunk, BLOCK=BLOCK_S, EV=ev_s, num_warps=warps_s, num_stages=stages_s)\n        _apply2[(splits_a, rows)](x, w, b, pm, pv, y, N, NS=splits, EPS=eps, CHUNK=chunk_a, BLOCK=BLOCK_A, BLOCK_NS=bns, EV=ev_a, num_warps=warps_a, num_stages=stages_a)\n    return run\n\nfor cfg in [\n    (128,2048,4,3,0, 2048,4,3,0),\n    (256,2048,4,3,0, 2048,4,3,0),\n    (256,2048,4,4,0, 2048,4,4,0),\n    (256,2048,4,2,0, 2048,4,2,0),\n    (256,2048,4,3,1, 2048,4,3,1),\n    (256,2048,4,3,0, 2048,4,3,1),\n    (128,2048,4,3,0, 4096,4,3,0),\n    (128,2048,4,3,0, 1024,4,3,0),\n    (64,2048,4,3,0, 2048,4,3,0),\n    (64,4096,4,3,0, 2048,4,3,0),\n]:\n    run = mk2(*cfg)\n    run(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    print(cfg, 'ms:', t(run), 'maxdiff', md)\n\n# individual kernel times for best-ish config\nchunk = ((N + 256 - 1) // 256 + 2047) // 2048 * 2048\nsplits = (N + chunk - 1) // "]
[448.374787, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.374833, "i", "chunk\npm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\npv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\nprint('stats only ms:', t(lambda: _stats[(splits, rows)](x, pm, pv, N, chunk, BLOCK=2048, EV=0, num_warps=4, num_stages=3)))\nprint('apply2 only ms:', t(lambda: _apply2[(splits, rows)](x, w, b, pm, pv, y, N, NS=splits, EPS=eps, CHUNK=chunk, BLOCK=2048, BLOCK_NS=npo2(splits), EV=0, num_warps=4, num_stages=3)))\nEOF\ngpu push sb-KQ0yKfTnYDRkksell7LpJe /workspace/bench3.py /workspace/bench3.py\n"]
