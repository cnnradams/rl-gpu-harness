[98.651568, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    HAS_TRITON = True\nexcept Exception:\n    HAS_TRITON = False\n\n\nif HAS_TRITON:\n    @triton.jit\n    def _ln_stats(X, PM, PV, N, CHUNK, BLOCK: tl.constexpr):\n        row = tl.program_id(1)\n        pid = tl.program_id(0)\n        lo = pid * CHUNK\n        hi = tl.minimum(lo + CHUNK, N)\n        s = 0.0\n        ss = 0.0\n        for off0 in range(lo, hi, BLOCK):\n            idx = off0 + tl.arange(0, BLOCK)\n            mask = idx < hi\n            x = tl.load(X + row * N + idx, mask=mask, other=0.0)\n            s += tl.sum(x, 0)\n            ss += tl.sum(x * x, 0)\n        ns = tl.num_programs(0)\n        tl.store(PM + row * ns + pid, s)\n        tl.store(PV + row * ns + pid, ss)\n\n    @triton.jit\n    def _ln_combine(PM, PV, M, RSTD, N, NS, EPS: tl.constexpr, BLOCK_NS: tl.constexpr):\n        row = tl.program_id(0)\n        off = tl.arange(0, BLOCK_NS)\n        mask = off < NS\n        s = tl.sum(tl"]
[98.651619, "i", ".load(PM + row * NS + off, mask=mask, other=0.0), 0)\n        ss = tl.sum(tl.load(PV + row * NS + off, mask=mask, other=0.0), 0)\n        mean = s / N\n        var = ss / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + EPS)\n        tl.store(M + row, mean)\n        tl.store(RSTD + row, rstd)\n\n    @triton.jit\n    def _ln_apply(X, W, B, M, RSTD, Y, N, CHUNK, BLOCK: tl.constexpr):\n        row = tl.program_id(1)\n        pid = tl.program_id(0)\n        lo = pid * CHUNK\n        hi = tl.minimum(lo + CHUNK, N)\n        mean = tl.load(M + row)\n        rstd = tl.load(RSTD + row)\n        for off0 in range(lo, hi, BLOCK):\n            idx = off0 + tl.arange(0, BLOCK)\n            mask = idx < hi\n            x = tl.load(X + row * N + idx, mask=mask, other=0.0)\n            w = tl.load(W + idx, mask=mask, other=0.0)\n            b = tl.load(B + idx, mask=mask, other=0.0)\n            y = (x - mean) * rstd * w + b\n            tl.store(Y + row * N + idx, y, mask=mask)\n\n\ndef _next_pow2(n):\n    p = 1\n    while p < n:\n        p *= 2\n   "]
[98.651791, "i", " return p\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape):\n        super(ModelNew, self).__init__()\n        if isinstance(normalized_shape, int):\n            normalized_shape = (normalized_shape,)\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=list(self.normalized_shape))\n        self.eps = self.ln.eps\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if HAS_TRITON and x.is_cuda and x.dtype == torch.float32:\n            try:\n                return self._forward_triton(x)\n            except Exception:\n                pass\n        return self.ln(x)\n\n    def _forward_triton(self, x):\n        N = 1\n        for s in self.normalized_shape:\n            N *= s\n        rows = x.numel() // N\n        xc = x.contiguous()\n        w = self.ln.weight.contiguous().view(-1)\n        b = self.ln.bias.contiguous().view(-1)\n\n        BLOCK_S = 4096\n        splits = 256\n        chunk = ((N + splits - 1) // splits + BLOCK_S - 1) // BLOCK_S "]
[98.651845, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[98.651885, "i", "* BLOCK_S\n        splits = (N + chunk - 1) // chunk\n\n        pm = torch.empty((rows, splits), device=x.device, dtype=torch.float32)\n        pv = torch.empty((rows, splits), device=x.device, dtype=torch.float32)\n        m = torch.empty((rows,), device=x.device, dtype=torch.float32)\n        rstd = torch.empty((rows,), device=x.device, dtype=torch.float32)\n        y = torch.empty_like(xc)\n\n        _ln_stats[(splits, rows)](xc, pm, pv, N, chunk, BLOCK=BLOCK_S, num_warps=8)\n        _ln_combine[(rows,)](pm, pv, m, rstd, N, splits, EPS=self.eps,\n                             BLOCK_NS=_next_pow2(splits), num_warps=4)\n\n        BLOCK_A = 4096\n        chunk_a = ((N + splits - 1) // splits + BLOCK_A - 1) // BLOCK_A * BLOCK_A\n        splits_a = (N + chunk_a - 1) // chunk_a\n        _ln_apply[(splits_a, rows)](xc, w, b, m, rstd, y, N, chunk_a,\n                                    BLOCK=BLOCK_A, num_warps=8)\n        return y.view(x.shape)\nEOF\nls -la /workspace\n"]
