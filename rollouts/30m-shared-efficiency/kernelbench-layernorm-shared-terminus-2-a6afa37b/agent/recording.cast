[448.382721, "o", "> "]
[448.382829, "o", "            bv = tl.load(B + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[448.382871, "o", "\u001b[?2004h> "]
[448.383038, "o", "            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask)\r\n\u001b[?2004l\r"]
[448.383079, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.383126, "o", "def npo2(n):\r\n\u001b[?2004l\r"]
[448.383169, "o", "\u001b[?2004h> "]
[448.383211, "o", "    p = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.383265, "o", "    while p < n: p *= 2\r\n\u001b[?2004l\r"]
[448.383296, "o", "\u001b[?2004h> "]
[448.383326, "o", "    return p\r\n\u001b[?2004l\r"]
[448.383372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[448.383413, "o", "> "]
[448.38359, "o", "def mk2(splits_t, BLOCK_S, warps_s, stages_s, ev_s, BLOCK_A, warps_a, stages_a, ev_a):\r\n\u001b[?2004l\r"]
[448.38362, "o", "\u001b[?2004h> "]
[448.383799, "o", "    chunk = ((N + splits_t - 1) // splits_t + BLOCK_S - 1) // BLOCK_S * BLOCK_S\r\n\u001b[?2004l\r"]
[448.383829, "o", "\u001b[?2004h> "]
[448.383915, "o", "    splits = (N + chunk - 1) // chunk\r\n\u001b[?2004l\r"]
[448.383947, "o", "\u001b[?2004h> "]
[448.384106, "o", "    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[448.384146, "o", "\u001b[?2004h> "]
[448.38429, "o", "    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[448.384321, "o", "\u001b[?2004h> "]
[448.384517, "o", "    chunk_a = ((N + splits_t - 1) // splits_t + BLOCK_A - 1) // BLOCK_A * BLOCK_A\r\n\u001b[?2004l\r"]
[448.384559, "o", "\u001b[?2004h> "]
[448.384647, "o", "    splits_a = (N + chunk_a - 1) // chunk_a\r\n\u001b[?2004l\r"]
[448.38469, "o", "\u001b[?2004h> "]
[448.384732, "o", "    bns = npo2(splits)\r\n\u001b[?2004l\r"]
[448.384774, "o", "\u001b[?2004h> "]
[448.384801, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.38483, "o", "> "]
[448.385098, "o", "        _stats[(splits, rows)](x, pm, pv, N, chunk, BLOCK=BLOCK_S, EV=ev_s, num_warps=warps_s, num_stages=stages_s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.385131, "o", "> "]
[448.385534, "o", "        _apply2[(splits_a, rows)](x, w, b, pm, pv, y, N, NS=splits, EPS=eps, CHUNK=chunk_a, BLOCK=BLOCK_A, BLOCK_NS=bns, EV=ev_a, num_warps=warps_a, num_stages=stages_a)\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.38558, "o", "> "]
[448.385618, "o", "    return run\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[448.385654, "o", "\u001b[?2004h> "]
