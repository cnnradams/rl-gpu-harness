[448.385789, "o", "    (128,2048,4,3,0, 2048,4,3,0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.385812, "o", "> "]
[448.385887, "o", "    (256,2048,4,3,0, 2048,4,3,0),\r\n\u001b[?2004l\r"]
[448.385925, "o", "\u001b[?2004h> "]
[448.385997, "o", "    (256,2048,4,4,0, 2048,4,4,0),\r\n\u001b[?2004l\r"]
[448.38603, "o", "\u001b[?2004h> "]
[448.386101, "o", "    (256,2048,4,2,0, 2048,4,2,0),\r\n\u001b[?2004l\r"]
[448.386132, "o", "\u001b[?2004h> "]
[448.386207, "o", "    (256,2048,4,3,1, 2048,4,3,1),\r\n\u001b[?2004l\r"]
[448.386259, "o", "\u001b[?2004h> "]
[448.386323, "o", "    (256,2048,4,3,0, 2048,4,3,1),\r\n\u001b[?2004l\r"]
[448.38636, "o", "\u001b[?2004h> "]
[448.386436, "o", "    (128,2048,4,3,0, 4096,4,3,0),\r\n\u001b[?2004l\r"]
[448.386466, "o", "\u001b[?2004h> "]
[448.386542, "o", "    (128,2048,4,3,0, 1024,4,3,0),\r\n\u001b[?2004l\r"]
[448.386573, "o", "\u001b[?2004h> "]
