[631.49065, "o", "512, 4, 0) ms: 0.3542165378729502 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\napply nm (1024, 8, 0) ms: 0.35481173197428384 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\ncombo (64, 2048, 4, 2048, 4, 0) ms: 0.43401386539141334 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\ncombo (64, 2048, 4, 1024, 4, 0) ms: 0.43746986985206604 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\ncombo (64, 2048, 4, 2048, 4, 1) ms: 0.4339413324991862 maxdiff 3.337860107421875e-06\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 15\r\ncombo (64, 4096, 8, 2048, 4, 1) ms: 0.43303040067354837 maxdiff 3.6954879760742188e-06\r\n"]
[632.343528, "o", "\u001b[?2004hroot@modal:/# "]
[698.73601, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndev = 'cuda'\nNshape = (64, 256, 256)\nN = 64*256*256\nrows = 16\nln = nn.LayerNorm(Nshape).to(dev)\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\ny = torch.empty_like(x)\nw = ln.weight.contiguous().view(-1)\nb = ln.bias.contiguous().view(-1)\neps = ln.eps\ny0 = ln(x)\n\ndef t(fn, n=15):\n    ts = time_execution_with_cuda_event(fn, [], num_trials=n, verbose=False, device=dev)\n    return sum(ts)/len(ts)\n\n@triton.jit\ndef _stats(X, PM, PV, N, CHUNK, BLOCK: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    lo = pid * CHUNK\n    hi = tl.minimum(lo + CHUNK, N)\n    s = 0.0\n    ss = 0.0\n    for off0 in range(lo, hi, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        mask = idx < hi\n        xv = tl.load(X + row * N + idx, mask=mask, other=0.0)\n        s += tl.sum(xv, 0)\n        ss += tl.sum(xv * xv, 0)\n    ns"]
[698.736056, "i", " = tl.num_programs(0)\n    tl.store(PM + row * ns + pid, s)\n    tl.store(PV + row * ns + pid, ss)\n\n@triton.jit\ndef _apply(X, W, B, PM, PV, Y, N, NS: tl.constexpr, EPS: tl.constexpr, CHUNK, BLOCK: tl.constexpr, BLOCK_NS: tl.constexpr, EV: tl.constexpr, SW: tl.constexpr):\n    if SW == 0:\n        pid = tl.program_id(0)\n        row = tl.program_id(1)\n    else:\n        row = tl.program_id(0)\n        pid = tl.program_id(1)\n    off = tl.arange(0, BLOCK_NS)\n    nsmask = off < NS\n    s = tl.sum(tl.load(PM + row * NS + off, mask=nsmask, other=0.0), 0)\n    ss = tl.sum(tl.load(PV + row * NS + off, mask=nsmask, other=0.0), 0)\n    mean = s / N\n    var = ss / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    lo = pid * CHUNK\n    hi = tl.minimum(lo + CHUNK, N)\n    for off0 in range(lo, hi, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        mask = idx < hi\n        if EV == 0:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0)\n            wv = tl.load(W + idx, mask=mask, other=0.0)\n            bv = tl"]
[698.736348, "i", ".load(B + idx, mask=mask, other=0.0)\n            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask)\n        elif EV == 1:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0, eviction_policy='evict_first')\n            wv = tl.load(W + idx, mask=mask, other=0.0, eviction_policy='evict_last')\n            bv = tl.load(B + idx, mask=mask, other=0.0, eviction_policy='evict_last')\n            tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask, eviction_policy='evict_first')\n\ndef npo2(n):\n    p = 1\n    while p < n: p *= 2\n    return p\n\n# precompute partials with splits=64\nsplits = 64\nchunk = N // splits\npm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\npv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n_stats[(splits, rows)](x, pm, pv, N, chunk, BLOCK=2048, num_warps=4)\ntorch.cuda.synchronize()\n\nfor (asplits, BA, wa, ev, sw) in [\n    (64,2048,4,0,0),\n    (128,2048,4,0,0),\n    (256,2048,4,0,0),\n    (128,2048,4,1,0),\n    (64,2048,4,1,0),\n  "]
[698.736364, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[698.736408, "i", "  (64,2048,4,1,1),\n    (64,2048,4,0,1),\n    (32,2048,4,1,0),\n    (64,1024,4,1,0),\n    (64,4096,8,1,0),\n]:\n    chunk_a = N // asplits\n    fn = lambda: _apply[(asplits, rows)](x, w, b, pm, pv, y, N, NS=splits, EPS=eps, CHUNK=chunk_a, BLOCK=BA, BLOCK_NS=npo2(splits), EV=ev, SW=sw, num_warps=wa)\n    fn(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    print('apply', (asplits, BA, wa, ev, sw), 'ms:', t(fn), 'maxdiff', md)\n\n# full combos with best apply\ndef combo(ssplits, BS, ws, asplits, BA, wa, ev, sw):\n    schunk = N // ssplits\n    pm = torch.empty((rows, ssplits), device=dev, dtype=torch.float32)\n    pv = torch.empty((rows, ssplits), device=dev, dtype=torch.float32)\n    achunk = N // asplits\n    def run():\n        _stats[(ssplits, rows)](x, pm, pv, N, schunk, BLOCK=BS, num_warps=ws)\n        _apply[(asplits, rows)](x, w, b, pm, pv, y, N, NS=ssplits, EPS=eps, CHUNK=achunk, BLOCK=BA, BLOCK_NS=npo2(ssplits), EV=ev, SW=sw, num_warps=wa)\n    return run\nfor c in [(64,2048,4,64,2048,4,1,0),(64,2048,4"]
[698.736421, "o", "> "]
[698.736454, "i", ",128,2048,4,1,0),(128,2048,4,128,2048,4,1,0)]:\n    run = combo(*c)\n    run(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    print('combo', c, 'ms:', t(run), 'maxdiff', md)\nEOF\ngpu push sb-KQ0yKfTnYDRkksell7LpJe /workspace/bench5.py /workspace/bench5.py && gpu exec sb-KQ0yKfTnYDRkksell7LpJe -- python3 /workspace/bench5.py\n"]
