[43.33433, "o", "grep -n \"def eval_kernel_against_ref\\|def time_execution\\|cuda_event\\|graph\\|warmup\\|torch.compile\\|def \" /usr/local/lib/python3.10/dist-packages/kernelbench/eval.py | head -50\r\n\u001b[?2004l\r"]
