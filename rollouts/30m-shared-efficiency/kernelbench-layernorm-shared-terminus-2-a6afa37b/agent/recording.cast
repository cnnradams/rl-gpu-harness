[448.386676, "o", "\u001b[?2004h> "]
[448.386749, "o", "    (64,4096,4,3,0, 2048,4,3,0),\r\n\u001b[?2004l\r"]
[448.38678, "o", "\u001b[?2004h> ]:\r\n"]
[448.386811, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[448.386867, "o", "    run = mk2(*cfg)\r\n\u001b[?2004l\r"]
[448.386898, "o", "\u001b[?2004h> "]
[448.386983, "o", "    run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[448.387021, "o", "\u001b[?2004h> "]
[448.387092, "o", "    md = (y0 - y).abs().max().item()\r\n\u001b[?2004l\r"]
[448.387122, "o", "\u001b[?2004h> "]
