[206.007116, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch\nimport torch.nn as nn\nfrom kernelbench.timing import time_execution_with_cuda_event\nimport solution\nfrom solution import _ln_stats, _ln_combine, _ln_apply, _next_pow2\n\ndev = 'cuda'\nNshape = (64, 256, 256)\nN = 64*256*256\nrows = 16\nln = nn.LayerNorm(Nshape).to(dev)\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\ny = torch.empty_like(x)\nw = ln.weight.contiguous().view(-1)\nb = ln.bias.contiguous().view(-1)\neps = ln.eps\n\n# floor: copy 256MB\ndef fcopy():\n    y.copy_(x)\nts = time_execution_with_cuda_event(fcopy, [], num_trials=20, verbose=False, device=dev)\nprint('copy ms:', sum(ts)/len(ts))\n\ndef make_run(splits_t, BLOCK_S, warps_s, BLOCK_A, warps_a):\n    chunk = ((N + splits_t - 1) // splits_t + BLOCK_S - 1) // BLOCK_S * BLOCK_S\n    splits = (N + chunk - 1) // chunk\n    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\n    m = torch.empty((rows,), device=dev, dtype"]
[206.007181, "i", "=torch.float32)\n    rstd = torch.empty((rows,), device=dev, dtype=torch.float32)\n    chunk_a = ((N + splits_t - 1) // splits_t + BLOCK_A - 1) // BLOCK_A * BLOCK_A\n    splits_a = (N + chunk_a - 1) // chunk_a\n    bns = _next_pow2(splits)\n    def run():\n        _ln_stats[(splits, rows)](x, pm, pv, N, chunk, BLOCK=BLOCK_S, num_warps=warps_s)\n        _ln_combine[(rows,)](pm, pv, m, rstd, N, splits, EPS=eps, BLOCK_NS=bns, num_warps=4)\n        _ln_apply[(splits_a, rows)](x, w, b, m, rstd, y, N, chunk_a, BLOCK=BLOCK_A, num_warps=warps_a)\n    return run\n\ny0 = ln(x)\nfor cfg in [(128,4096,8,4096,8),(256,4096,8,4096,8),(512,4096,8,4096,8),(256,8192,8,8192,8),(256,2048,4,2048,4),(256,4096,16,4096,16),(512,8192,16,8192,16),(128,8192,8,8192,8),(512,4096,16,4096,8),(1024,4096,8,4096,8)]:\n    run = make_run(*cfg)\n    run(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    ts = time_execution_with_cuda_event(run, [], num_trials=15, verbose=False, device=dev)\n    print(cfg, 'ms:', sum(ts)/len(ts), 'maxdiff', md"]
[206.00719, "i", ")\nEOF\ngpu exec sb-KQ0yKfTnYDRkksell7LpJe -- python3 /workspace/bench2.py\n"]
