[99.151803, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch\nimport torch.nn as nn\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndev = 'cuda'\nNshape = (64, 256, 256)\nln = nn.LayerNorm(Nshape).to(dev)\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\n\n# reference timing\nts = time_execution_with_cuda_event(ln, [x], num_trials=20, verbose=False, device=dev)\nprint('eager LN ms:', sum(ts)/len(ts))\n\nimport solution\nm = solution.ModelNew(Nshape).to(dev)\ny0 = ln(x)\ny1 = m(x)\nprint('max diff', (y0 - y1).abs().max().item())\nts = time_execution_with_cuda_event(m, [x], num_trials=20, verbose=False, device=dev)\nprint('triton LN ms:', sum(ts)/len(ts))\n\n# torch.compile comparison\nmc = torch.compile(ln)\nfor _ in range(3):\n    mc(x)\nts = time_execution_with_cuda_event(mc, [x], num_trials=20, verbose=False, device=dev)\nprint('compiled LN ms:', sum(ts)/len(ts))\nEOF\n"]
