[884.719112, "o", "        if isinstance(normalized_shape, int):\r\n\u001b[?2004l\r"]
[884.719148, "o", "\u001b[?2004h> "]
[884.71926, "o", "            normalized_shape = (normalized_shape,)\r\n\u001b[?2004l\r"]
[884.719295, "o", "\u001b[?2004h> "]
[884.719424, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[884.719464, "o", "\u001b[?2004h> "]
[884.71962, "o", "        self.ln = nn.LayerNorm(normalized_shape=list(self.normalized_shape))\r\n\u001b[?2004l\r"]
[884.719659, "o", "\u001b[?2004h> "]
[884.719717, "o", "        self.eps = self.ln.eps\r\n\u001b[?2004l\r"]
[884.719755, "o", "\u001b[?2004h> "]
[884.719802, "o", "        self._cfg = None\r\n\u001b[?2004l\r"]
[884.71984, "o", "\u001b[?2004h> "]
[884.719883, "o", "        self._bufs = {}\r\n\u001b[?2004l\r"]
[884.719921, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[884.71996, "o", "> "]
[884.720064, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[884.720101, "o", "\u001b[?2004h> "]
[884.720239, "o", "        if HAS_TRITON and x.is_cuda and x.dtype == torch.float32:\r\n\u001b[?2004l\r"]
[884.720277, "o", "\u001b[?2004h> "]
[884.72032, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[884.720358, "o", "> "]
[884.720444, "o", "                return self._forward_triton(x)\r\n\u001b[?2004l\r"]
[884.720482, "o", "\u001b[?2004h> "]
[884.72054, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[884.720575, "o", "\u001b[?2004h> "]
[884.720611, "o", "                pass\r\n\u001b[?2004l\r"]
[884.72065, "o", "\u001b[?2004h> "]
[884.720701, "o", "        return self.ln(x)\r\n\u001b[?2004l\r"]
[884.72074, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.720829, "o", "    def _forward_triton(self, x):\r\n\u001b[?2004l\r"]
[884.720866, "o", "\u001b[?2004h> "]
[884.720902, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.721002, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[884.721045, "o", "\u001b[?2004h> "]
[884.721082, "o", "            N *= s\r\n\u001b[?2004l\r\u001b[?2004h"]
[884.72112, "o", "> "]
[884.721168, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r"]
[884.721206, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[884.721234, "o", "> "]
[884.721301, "o", "        xc = x.contiguous()\r\n\u001b[?2004l\r"]
[884.721343, "o", "\u001b[?2004h> "]
[884.721398, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r"]
[884.721424, "o", "\u001b[?2004h> "]
[884.721499, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r"]
[884.721537, "o", "\u001b[?2004h> "]
[884.721575, "o", "        if w is None:\r\n\u001b[?2004l\r"]
[884.721609, "o", "\u001b[?2004h> "]
[884.721809, "o", "            w = torch.ones(self.normalized_shape, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[884.721851, "o", "\u001b[?2004h> "]
[884.721888, "o", "        if b is None:\r\n\u001b[?2004l\r"]
[884.721926, "o", "\u001b[?2004h> "]
[884.722118, "o", "            b = torch.zeros(self.normalized_shape, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[884.722156, "o", "\u001b[?2004h> "]
[884.722234, "o", "        w = w.contiguous().view(-1)\r\n\u001b[?2004l\r"]
[884.722269, "o", "\u001b[?2004h> "]
[884.722366, "o", "        b = b.contiguous().view(-1)\r\n\u001b[?2004l\r"]
[884.722408, "o", "\u001b[?2004h"]
[884.722444, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.722497, "o", "        if self._cfg is None:\r\n\u001b[?2004l\r"]
[884.722535, "o", "\u001b[?2004h> "]
[884.722621, "o", "            if N >= 65536 and N % 64 == 0:\r\n\u001b[?2004l\r"]
[884.722661, "o", "\u001b[?2004h> "]
[884.722718, "o", "                SPLITS = 64\r\n\u001b[?2004l\r"]
[884.722757, "o", "\u001b[?2004h> "]
[884.722815, "o", "                BLOCK = 2048\r\n\u001b[?2004l\r"]
[884.722854, "o", "\u001b[?2004h> "]
[884.722908, "o", "            elif N >= 16384:\r\n\u001b[?2004l\r"]
[884.722953, "o", "\u001b[?2004h> "]
[884.723002, "o", "                SPLITS = 32\r\n\u001b[?2004l\r"]
[884.723045, "o", "\u001b[?2004h> "]
[884.723093, "o", "                BLOCK = 2048\r\n\u001b[?2004l\r"]
[884.723131, "o", "\u001b[?2004h> "]
[884.723168, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[884.723205, "o", "> "]
[884.723251, "o", "                SPLITS = 16\r\n\u001b[?2004l\r"]
[884.723289, "o", "\u001b[?2004h> "]
[884.723355, "o", "                BLOCK = 1024\r\n\u001b[?2004l\r"]
[884.723393, "o", "\u001b[?2004h> "]
[884.723555, "o", "            chunk = ((N + SPLITS - 1) // SPLITS + BLOCK - 1) // BLOCK * BLOCK\r\n\u001b[?2004l\r"]
[884.723592, "o", "\u001b[?2004h> "]
[884.723684, "o", "            SPLITS = (N + chunk - 1) // chunk\r\n\u001b[?2004l\r"]
[884.723723, "o", "\u001b[?2004h> "]
[884.723856, "o", "            self._cfg = (SPLITS, chunk, BLOCK, _npo2(SPLITS))\r\n\u001b[?2004l\r"]
[884.723899, "o", "\u001b[?2004h> "]
[884.723989, "o", "        SPLITS, chunk, BLOCK, BNS = self._cfg\r\n\u001b[?2004l\r"]
[884.724025, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[884.724065, "o", "> "]
[884.724123, "o", "        key = (rows, x.device.index)\r\n\u001b[?2004l\r"]
[884.724162, "o", "\u001b[?2004h> "]
[884.724228, "o", "        bufs = self._bufs.get(key)\r\n\u001b[?2004l\r"]
[884.724267, "o", "\u001b[?2004h> "]
[884.724305, "o", "        if bufs is None:\r\n\u001b[?2004l\r"]
[884.724352, "o", "\u001b[?2004h> "]
[884.724526, "o", "            pm = torch.empty((rows, SPLITS), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[884.724564, "o", "\u001b[?2004h> "]
[884.724742, "o", "            pv = torch.empty((rows, SPLITS), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[884.724784, "o", "\u001b[?2004h> "]
[884.724871, "o", "            self._bufs[key] = bufs = (pm, pv)\r\n\u001b[?2004l\r"]
[884.72491, "o", "\u001b[?2004h> "]
[884.724948, "o", "        pm, pv = bufs\r\n\u001b[?2004l\r"]
[884.724989, "o", "\u001b[?2004h> "]
[884.725048, "o", "        y = torch.empty_like(xc)\r\n\u001b[?2004l\r"]
[884.725087, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[884.725259, "o", "        _ln_stats[(SPLITS, rows)](xc, pm, pv, N, chunk, BLOCK=BLOCK,\r\n\u001b[?2004l\r\u001b[?2004h"]
[884.725298, "o", "> "]
[884.725422, "o", "                                  num_warps=4, num_stages=3)\r\n\u001b[?2004l\r"]
[884.725455, "o", "\u001b[?2004h> "]
[884.725608, "o", "        _ln_apply[(SPLITS, rows)](xc, w, b, pm, pv, y, N, NS=SPLITS,\r\n\u001b[?2004l\r"]
[884.725645, "o", "\u001b[?2004h> "]
[884.725798, "o", "                                  EPS=self.eps, CHUNK=chunk, BLOCK=BLOCK,\r\n\u001b[?2004l\r"]
[884.725838, "o", "\u001b[?2004h> "]
[884.725995, "o", "                                  BLOCK_NS=BNS, num_warps=4, num_stages=3)\r\n\u001b[?2004l\r"]
[884.726033, "o", "\u001b[?2004h> "]
[884.726095, "o", "        return y.view(x.shape)\r\n\u001b[?2004l\r"]
[884.726134, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[884.727933, "o", "\u001b[?2004hroot@modal:/# "]
