[448.388371, "o", "> "]
[448.388785, "o", "print('apply2 only ms:', t(lambda: _apply2[(splits, rows)](x, w, b, pm, pv, y, N, NS=splits, EPS=eps, CHUNK=chunk, BLOCK=2048, BLOCK_NS=npo2(splits), EV=0, num_warps=4, num_stages=3)))\r\n\u001b[?2004l\r\u001b[?2004h"]
