[814.491953, "o", "\u001b[?2004h> "]
[814.491994, "o", "    s = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.492041, "o", "    ss = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.492141, "o", "    for off0 in range(lo, hi, BLOCK):\r\n\u001b[?2004l\r"]
[814.492186, "o", "\u001b[?2004h> "]
[814.492261, "o", "        idx = off0 + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[814.492292, "o", "\u001b[?2004h> "]
