[540.597773, "o", "\u001b[?2004h> "]
[540.597804, "o", "def t(fn, n=15):\r\n\u001b[?2004l\r"]
[540.597832, "o", "\u001b[?2004h> "]
[540.598055, "o", "    ts = time_execution_with_cuda_event(fn, [], num_trials=n, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.598123, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r"]
[540.598161, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.598206, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[540.598286, "o", "\u001b[?2004h> "]
[540.598463, "o", "def _stats_nm(X, PM, PV, N: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[540.598505, "o", "\u001b[?2004h> "]
[540.598553, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[540.598591, "o", "\u001b[?2004h> "]
[540.598636, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[540.598667, "o", "\u001b[?2004h> "]
[540.598712, "o", "    lo = pid * CHUNK\r\n\u001b[?2004l\r"]
[540.598747, "o", "\u001b[?2004h> "]
[540.598782, "o", "    s = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.598836, "o", "    ss = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.598877, "o", "> "]
[540.598979, "o", "    for off0 in tl.static_range(lo, lo + CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[540.599017, "o", "\u001b[?2004h> "]
[540.5991, "o", "        idx = off0 + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[540.599139, "o", "\u001b[?2004h> "]
[540.599228, "o", "        xv = tl.load(X + row * N + idx)\r\n\u001b[?2004l\r"]
[540.599262, "o", "\u001b[?2004h> "]
[540.599312, "o", "        s += tl.sum(xv, 0)\r\n\u001b[?2004l\r"]
[540.599362, "o", "\u001b[?2004h> "]
[540.599438, "o", "        ss += tl.sum(xv * xv, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.599476, "o", "> "]
[540.599521, "o", "    ns = tl.num_programs(0)\r\n\u001b[?2004l\r"]
[540.599551, "o", "\u001b[?2004h> "]
[540.599641, "o", "    tl.store(PM + row * ns + pid, s)\r\n\u001b[?2004l\r"]
[540.599679, "o", "\u001b[?2004h> "]
[540.599751, "o", "    tl.store(PV + row * ns + pid, ss)\r\n\u001b[?2004l\r"]
[540.599784, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[540.599822, "o", "\u001b[?2004h> "]
[540.599853, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.600222, "o", "def _apply_nm(X, W, B, PM, PV, Y, N: tl.constexpr, NS: tl.constexpr, EPS: tl.constexpr, BLOCK: tl.constexpr, BLOCK_NS: tl.constexpr, EVW: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.600289, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[540.600305, "o", "\u001b[?2004h"]
[540.600351, "o", "> "]
[540.600392, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[540.600431, "o", "\u001b[?2004h> "]
[540.600495, "o", "    off = tl.arange(0, BLOCK_NS)\r\n\u001b[?2004l\r"]
[540.600534, "o", "\u001b[?2004h> "]
[540.600583, "o", "    nsmask = off < NS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.600762, "o", "    s = tl.sum(tl.load(PM + row * NS + off, mask=nsmask, other=0.0), 0)\r\n\u001b[?2004l\r"]
[540.600779, "o", "\u001b[?2004h> "]
[540.600943, "o", "    ss = tl.sum(tl.load(PV + row * NS + off, mask=nsmask, other=0.0), 0)\r\n\u001b[?2004l\r"]
[540.600975, "o", "\u001b[?2004h> "]
[540.601014, "o", "    mean = s / N\r\n\u001b[?2004l\r"]
[540.601051, "o", "\u001b[?2004h> "]
[540.601119, "o", "    var = ss / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.601151, "o", "> "]
[540.601219, "o", "    rstd = 1.0 / tl.sqrt(var + EPS)\r\n\u001b[?2004l\r"]
[540.60125, "o", "\u001b[?2004h> "]
[540.601359, "o", "    idx = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[540.601391, "o", "\u001b[?2004h> "]
[540.601541, "o", "    xv = tl.load(X + row * N + idx, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[540.60158, "o", "\u001b[?2004h> "]
[540.601603, "o", "    if EVW == 1:\r\n\u001b[?2004l\r"]
[540.601634, "o", "\u001b[?2004h> "]
[540.601763, "o", "        wv = tl.load(W + idx, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[540.601795, "o", "\u001b[?2004h> "]
[540.601932, "o", "        bv = tl.load(B + idx, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[540.601964, "o", "\u001b[?2004h> "]
[540.601993, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.602025, "o", "> "]
[540.602088, "o", "        wv = tl.load(W + idx)\r\n\u001b[?2004l\r"]
[540.602126, "o", "\u001b[?2004h> "]
[540.602177, "o", "        bv = tl.load(B + idx)\r\n\u001b[?2004l\r"]
[540.602221, "o", "\u001b[?2004h> "]
[540.602435, "o", "    tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[540.60245, "o", "\u001b[?2004h"]
[540.602489, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.602521, "o", "def npo2(n):\r\n\u001b[?2004l\r"]
[540.602559, "o", "\u001b[?2004h>     p = 1\r\n\u001b[?2004l\r"]
[540.60259, "o", "\u001b[?2004h> "]
[540.602647, "o", "    while p < n: p *= 2\r\n\u001b[?2004l\r"]
[540.602679, "o", "\u001b[?2004h> "]
[540.60271, "o", "    return p\r\n\u001b[?2004l\r"]
[540.602741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[540.602776, "o", "\u001b[?2004h> "]
[540.602807, "o", "# stats no-mask test\r\n\u001b[?2004l\r"]
[540.60283, "o", "\u001b[?2004h> "]
[540.603082, "o", "for (splits, BS, ws) in [(64,2048,4),(64,4096,4),(64,4096,8),(128,2048,4),(64,2048,8),(32,4096,4)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.603149, "o", "    chunk = N // splits\r\n\u001b[?2004l\r"]
[540.603188, "o", "\u001b[?2004h> "]
[540.603348, "o", "    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.603362, "o", "> "]
[540.603525, "o", "    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[540.603557, "o", "\u001b[?2004h> "]
[540.603777, "o", "    fn = lambda: _stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=BS, num_warps=ws)\r\n\u001b[?2004l\r"]
[540.603816, "o", "\u001b[?2004h> "]
[540.603927, "o", "    print('stats nm', (splits, BS, ws), 'ms:', t(fn))\r\n\u001b[?2004l\r"]
[540.603968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[540.604, "o", "> "]
[540.604103, "o", "# apply no-mask one-tile test (partials precomputed)\r\n\u001b[?2004l\r"]
[540.60414, "o", "\u001b[?2004h> "]
[540.604179, "o", "splits = 64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.604238, "o", "chunk = N // splits\r\n\u001b[?2004l\r"]
[540.604269, "o", "\u001b[?2004h> "]
[540.60443, "o", "pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[540.60446, "o", "\u001b[?2004h> "]
[540.604607, "o", "pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[540.604638, "o", "\u001b[?2004h> "]
[540.604819, "o", "_stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=2048, num_warps=4)\r\n\u001b[?2004l\r"]
[540.604851, "o", "\u001b[?2004h> "]
[540.604902, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[540.60494, "o", "\u001b[?2004h> "]
[540.605235, "o", "for (BA, wa, evw) in [(1024,4,0),(2048,4,0),(2048,8,0),(4096,4,0),(4096,8,0),(1024,4,1),(2048,4,1),(8192,8,0),(512,4,0),(1024,8,0)]:\r\n\u001b[?2004l\r"]
[540.605272, "o", "\u001b[?2004h> "]
[540.60531, "o", "    grid_a = N // BA\r\n\u001b[?2004l\r"]
[540.605347, "o", "\u001b[?2004h> "]
[540.605684, "o", "    fn = lambda: _apply_nm[(grid_a, rows)](x, w, b, pm, pv, y, N=N, NS=splits, EPS=eps, BLOCK=BA, BLOCK_NS=npo2(splits), EVW=evw, num_warps=wa)\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.605723, "o", "> "]
[540.605786, "o", "    fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[540.605817, "o", "\u001b[?2004h> "]
[540.605894, "o", "    md = (y0 - y).abs().max().item()\r\n\u001b[?2004l\r"]
[540.605927, "o", "\u001b[?2004h"]
[540.605957, "o", "> "]
[540.606072, "o", "    print('apply nm', (BA, wa, evw), 'ms:', t(fn), 'maxdiff', md)\r\n\u001b[?2004l\r"]
[540.606107, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[540.60614, "o", "> "]
[540.606178, "o", "# best 2-kernel combo\r\n\u001b[?2004l\r"]
[540.606207, "o", "\u001b[?2004h> "]
[540.606307, "o", "def combo(splits, BS, ws, BA, wa, evw):\r\n\u001b[?2004l\r"]
[540.606344, "o", "\u001b[?2004h> "]
[540.606397, "o", "    chunk = N // splits\r\n\u001b[?2004l\r"]
[540.606427, "o", "\u001b[?2004h> "]
[540.606592, "o", "    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.606626, "o", "> "]
[540.606768, "o", "    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[540.606799, "o", "\u001b[?2004h> "]
[540.606841, "o", "    grid_a = N // BA\r\n\u001b[?2004l\r"]
[540.606874, "o", "\u001b[?2004h> "]
[540.606907, "o", "    def run():\r\n\u001b[?2004l\r"]
[540.606934, "o", "\u001b[?2004h> "]
[540.607145, "o", "        _stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=BS, num_warps=ws)\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.607182, "o", "> "]
[540.607514, "o", "        _apply_nm[(grid_a, rows)](x, w, b, pm, pv, y, N=N, NS=splits, EPS=eps, BLOCK=BA, BLOCK_NS=npo2(splits), EVW=evw, num_warps=wa)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.60756, "o", "    return run\r\n\u001b[?2004l\r\u001b[?2004h"]
[540.607593, "o", "> "]
[540.607807, "o", "for c in [(64,2048,4,2048,4,0),(64,2048,4,1024,4,0),(64,2048,4,2048,4,1),(64,4096,8,2048,4,1)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[540.607861, "o", "    run = combo(*c)\r\n\u001b[?2004l\r"]
[540.607891, "o", "\u001b[?2004h> "]
[540.607976, "o", "    run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[540.608014, "o", "\u001b[?2004h> "]
[540.608081, "o", "    md = (y0 - y).abs().max().item()\r\n\u001b[?2004l\r"]
[540.608112, "o", "\u001b[?2004h> "]
[540.608227, "o", "    print('combo', c, 'ms:', t(run), 'maxdiff', md)\r\n\u001b[?2004l\r"]
[540.608257, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[540.609977, "o", "\u001b[?2004hroot@modal:/# "]
