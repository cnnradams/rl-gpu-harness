[814.489046, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\ndev = 'cuda'\nNshape = (64, 256, 256)\nN = 64*256*256\nrows = 16\nln = nn.LayerNorm(Nshape).to(dev)\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device=dev)\ny = torch.empty_like(x)\nw = ln.weight.contiguous().view(-1)\nb = ln.bias.contiguous().view(-1)\neps = ln.eps\ny0 = ln(x)\n\ndef t(fn, n=15):\n    ts = time_execution_with_cuda_event(fn, [], num_trials=n, verbose=False, device=dev)\n    return sum(ts)/len(ts)\n\n@triton.jit\ndef _stats(X, PM, PV, N, CHUNK, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(1)\n    pid = tl.program_id(0)\n    lo = pid * CHUNK\n    hi = tl.minimum(lo + CHUNK, N)\n    s = 0.0\n    ss = 0.0\n    for off0 in range(lo, hi, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        mask = idx < hi\n        if EV == 0:\n            xv = tl.load(X + row * N + idx, mask=mask, other=0.0)\n        else:\n          "]
[814.489088, "i", "  xv = tl.load(X + row * N + idx, mask=mask, other=0.0, eviction_policy='evict_first')\n        s += tl.sum(xv, 0)\n        ss += tl.sum(xv * xv, 0)\n    ns = tl.num_programs(0)\n    tl.store(PM + row * ns + pid, s)\n    tl.store(PV + row * ns + pid, ss)\n\n@triton.jit\ndef _apply(X, W, B, PM, PV, Y, N, NS: tl.constexpr, EPS: tl.constexpr, CHUNK, BLOCK: tl.constexpr, BLOCK_NS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    off = tl.arange(0, BLOCK_NS)\n    nsmask = off < NS\n    s = tl.sum(tl.load(PM + row * NS + off, mask=nsmask, other=0.0), 0)\n    ss = tl.sum(tl.load(PV + row * NS + off, mask=nsmask, other=0.0), 0)\n    mean = s / N\n    var = ss / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    lo = pid * CHUNK\n    hi = tl.minimum(lo + CHUNK, N)\n    for off0 in range(lo, hi, BLOCK):\n        idx = off0 + tl.arange(0, BLOCK)\n        mask = idx < hi\n        xv = tl.load(X + row * N + idx, mask=mask, other=0.0, eviction_policy='evict_first')\n        wv = tl.load(W + idx, mask=mask, other="]
[814.489102, "i", "0.0, eviction_policy='evict_last')\n        bv = tl.load(B + idx, mask=mask, other=0.0, eviction_policy='evict_last')\n        tl.store(Y + row * N + idx, (xv - mean) * rstd * wv + bv, mask=mask, eviction_policy='evict_first')\n\ndef npo2(n):\n    p = 1\n    while p < n: p *= 2\n    return p\n\nfor (sp, BS, ws, st, ev) in [\n    (64,2048,4,3,0),(64,2048,4,3,1),(64,2048,4,4,1),(64,2048,4,5,1),\n    (64,4096,4,3,1),(64,4096,8,3,1),(64,8192,8,3,1),(32,4096,4,4,1),\n    (128,2048,4,3,1),(64,2048,8,3,1),(64,2048,16,3,1),(64,2048,2,3,1),\n]:\n    chunk = N // sp\n    pm = torch.empty((rows, sp), device=dev, dtype=torch.float32)\n    pv = torch.empty((rows, sp), device=dev, dtype=torch.float32)\n    fn = lambda: _stats[(sp, rows)](x, pm, pv, N, chunk, BLOCK=BS, EV=ev, num_warps=ws, num_stages=st)\n    print('stats', (sp, BS, ws, st, ev), 'ms:', t(fn))\n\n# best combo with cached buffers\ndef mk(sp, BS, ws, st, sev, asp, BA, wa, ast):\n    chunk = N // sp\n    pm = torch.empty((rows, sp), device=dev, dtype=torch.float32)\n    pv = torch.emp"]
[814.48911, "i", "ty((rows, sp), device=dev, dtype=torch.float32)\n    achunk = N // asp\n    bns = npo2(sp)\n    def run():\n        _stats[(sp, rows)](x, pm, pv, N, chunk, BLOCK=BS, EV=sev, num_warps=ws, num_stages=st)\n        _apply[(asp, rows)](x, w, b, pm, pv, y, N, NS=sp, EPS=eps, CHUNK=achunk, BLOCK=BA, BLOCK_NS=bns, num_warps=wa, num_stages=ast)\n    return run\nfor c in [(64,2048,4,3,0,64,2048,4,3),(64,2048,4,3,1,64,2048,4,3),(64,4096,8,3,1,64,2048,4,3),(64,2048,4,5,1,64,1024,4,3)]:\n    run = mk(*c)\n    run(); torch.cuda.synchronize()\n    md = (y0 - y).abs().max().item()\n    print('combo', c, 'ms:', t(run), 'maxdiff', md)\nEOF\ngpu push sb-KQ0yKfTnYDRkksell7LpJe /workspace/bench6.py /workspace/bench6.py && gpu exec sb-KQ0yKfTnYDRkksell7LpJe -- python3 /workspace/bench6.py\n"]
[814.489304, "o", "cat > /workspace/bench6.py << 'EOF'\r\n\u001b[?2004l\r"]
