        splits = (N + chunk - 1) // chunk

        pm = torch.empty((rows, splits), device=x.device, dtype=torch.float32)
        pv = torch.empty((rows, splits), device=x.device, dtype=torch.float32)
        m = torch.empty((rows,), device=x.device, dtype=torch.float32)
        rstd = torch.empty((rows,), device=x.device, dtype=torch.float32)
        y = torch.empty_like(xc)

        _ln_stats[(splits, rows)](xc, pm, pv, N, chunk, BLOCK=BLOCK_S, num_warps=8)
        _ln_combine[(rows,)](pm, pv, m, rstd, N, splits, EPS=self.eps,
                             BLOCK_NS=_next_pow2(splits), num_warps=4)

        BLOCK_A = 4096
        chunk_a = ((N + splits - 1) // splits + BLOCK_A - 1) // BLOCK_A * BLOCK_A
        splits_a = (N + chunk_a - 1) // chunk_a
        _ln_apply[(splits_a, rows)](xc, w, b, m, rstd, y, N, chunk_a,
                                    BLOCK=BLOCK_A, num_warps=8)
        return y.view(x.shape)
