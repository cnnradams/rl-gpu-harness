# best 2-kernel combo
def combo(splits, BS, ws, BA, wa, evw):
    chunk = N // splits
    pm = torch.empty((rows, splits), device=dev, dtype=torch.float32)
    pv = torch.empty((rows, splits), device=dev, dtype=torch.float32)
    grid_a = N // BA
    def run():
        _stats_nm[(splits, rows)](x, pm, pv, N=N, CHUNK=chunk, BLOCK=BS, num_warps=ws)
        _apply_nm[(grid_a, rows)](x, w, b, pm, pv, y, N=N, NS=splits, EPS=eps, BLOCK=BA, BLOCK_NS=npo2(splits), EVW=evw, num_warps=wa)
    return run
for c in [(64,2048,4,2048,4,0),(64,2048,4,1024,4,0),(64,2048,4,2048,4,1),(64,4096,8,2048,4,1)]:
    run = combo(*c)
    run(); torch.cuda.synchronize()
    md = (y0 - y).abs().max().item()
    print('combo', c, 'ms:', t(run), 'maxdiff', md)
