[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _split(A, HI, LO, numel, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     mask = offs < numel
[?2004l[?2004h>     a = tl.load(A + offs, mask=mask)
[?2004l[?2004h>     hi = a.to(tl.float16)
[?2004l[?2004h>     lo = (a - hi.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>     tl.store(HI + offs, hi, mask=mask)
[?2004l[?2004h>     tl.store(LO + offs, lo, mask=mask)
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _k(
[?2004l[?2004h>     AH, AL, BH, BL, Bias, C,
[?2004l[?2004h>     M, N, K,
[?2004l[?2004h>     BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,
[?2004l[?2004h> ):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GROUP_M * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)
[?2004l[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     rn = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     rk = tl.arange(0, BK)
[?2004l[?2004h>     AH_ptr = AH + rm[:, None] * K + rk[None, :]
[?2004l[?2004h>     AL_ptr = AL + rm[:, None] * K + rk[None, :]
[?2004l[?2004h>     BH_ptr = BH + rk[:, None] * N + rn[None, :]
[?2004l[?2004h>     BL_ptr = BL + rk[:, None] * N + rn[None, :]
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for _ in range(0, K, BK):
[?2004l[?2004h>         a_hi = tl.load(AH_ptr)
[?2004l[?2004h>         a_lo = tl.load(AL_ptr)
[?2004l[?2004h>         b_hi = tl.load(BH_ptr)
[?2004l[?2004h>         b_lo = tl.load(BL_ptr)
[?2004l[?2004h>         acc = tl.dot(a_hi, b_hi, acc)
[?2004l[?2004h>         acc2 = tl.dot(a_lo, b_hi, acc2)
[?2004l[?2004h>         acc2 = tl.dot(a_hi, b_lo, acc2)
[?2004l[?2004h>         AH_ptr += BK
[?2004l[?2004h>         AL_ptr += BK
[?2004l[?2004h>         BH_ptr += BK * N
[?2004l[?2004h>         BL_ptr += BK * N
[?2004l[?2004h>     acc = acc + acc2
[?2004l[?2004h>     bias = tl.load(Bias + rn)
[?2004l[?2004h>     acc = acc + bias[None, :]
[?2004l[?2004h>     C_ptr = C + rm[:, None] * N + rn[None, :]
[?2004l[?2004h>     tl.store(C_ptr, acc)
[?2004l[?2004h> 
[?2004l[?2004h> M, N, K = 16384, 4096, 4096
[?2004l[?2004h> torch.manual_seed(0)
[?2004l[?2004h> x = torch.rand(M, K, device='cuda')
[?2004l[?2004h> w = torch.randn(N, K, device='cuda') * 1.5
[?2004l[?2004h> wt = w.t().contiguous()
[?2004l[?2004h> wh = wt.half(); wl = (wt - wh.float()).half()
[?2004l[?2004h> b = torch.randn(N, device='cuda') * 1.5
[?2004l[?2004h> out = torch.empty(M, N, device='cuda')
[?2004l[?2004h> xh = torch.empty(M, K, device='cuda', dtype=torch.float16)
[?2004l[?2004h> xl = torch.empty(M, K, device='cuda', dtype=torch.float16)
[?2004l[?2004h> numel = M*K
[?2004l[?2004h> 
[?2004l[?2004h> def bench(fn, n=15):
[?2004l[?2004h>     times = time_execution_with_cuda_event(fn, [], num_warmup=3, num_trials=n, discard_first=1, verbose=False, device=torch.device('cuda'))
[?2004l[?2004h>     return sum(times)/len(times)
[?2004l[?2004h> 
[?2004l[?2004h> def run_split():
[?2004l[?2004h>     _split[(triton.cdiv(numel, 8192),)](x, xh, xl, numel, BLOCK=8192, num_warps=8)
[?2004l[?2004h> print('split:', bench(run_split))
[?2004l[?2004h> 
[?2004l[?2004h> for BM,BN,BK,w,s in [(128,256,64,8,2),(256,128,64,8,2),(128,128,64,8,4),(128,128,64,8,3),(128,256,32,8,3),(256,128,32,8,3),(128,128,32,8,3),(64,128,64,4,3),(128,64,64,8,3),(128,512,32,8,2),(256,256,32,8,2)]:
[?2004l[?2004h>     grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)
[?2004l[?2004h>     def run():
[?2004l[?2004h>         _k[grid](xh, xl, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)
[?2004l[?2004h>     try:
