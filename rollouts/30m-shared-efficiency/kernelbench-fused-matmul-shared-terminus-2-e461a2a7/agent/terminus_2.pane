[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super(ModelNew, self).__init__()
[?2004l[?2004h>         self.matmul = nn.Linear(in_features, out_features)
[?2004l[?2004h>         self.scaling_factor = scaling_factor
[?2004l[?2004h>         scale = 1.0 + float(scaling_factor)
[?2004l[?2004h>         with torch.no_grad():
[?2004l[?2004h>             w2 = (self.matmul.weight * scale).t().contiguous()  # (in, out) fp32
[?2004l[?2004h>             b2 = (self.matmul.bias * scale).contiguous()
[?2004l[?2004h>             w_hi = w2.to(torch.float16)
[?2004l[?2004h>             w_lo = (w2 - w_hi.to(torch.float32)).to(torch.float16)
[?2004l[?2004h>         # store fp16 as int16 so .to(dtype=fp32) won't cast them
[?2004l[?2004h>         self.register_buffer("w_hi_i", w_hi.view(torch.int16))
[?2004l[?2004h>         self.register_buffer("w_lo_i", w_lo.view(torch.int16))
[?2004l[?2004h>         self.register_buffer("b2", b2)
[?2004l[?2004h> 
[?2004l[?2004h>     def _fast(self, x):
[?2004l[?2004h>         M, K = x.shape
[?2004l[?2004h>         N = self.b2.shape[0]
[?2004l[?2004h>         out = torch.empty((M, N), device=x.device, dtype=torch.float32)
[?2004l[?2004h>         w_hi = self.w_hi_i.view(torch.float16)
[?2004l[?2004h>         w_lo = self.w_lo_i.view(torch.float16)
[?2004l[?2004h>         grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)
[?2004l[?2004h>         _split_fp16_gemm[grid](x, w_hi, w_lo, self.b2, out, M, N, K)
[?2004l[?2004h>         return out
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         if x.is_cuda and x.dtype == torch.float32 and x.dim() == 2 and x.is_contiguous():
[?2004l[?2004h>             return self._fast(x)
[?2004l[?2004h>         y = self.matmul(x)
