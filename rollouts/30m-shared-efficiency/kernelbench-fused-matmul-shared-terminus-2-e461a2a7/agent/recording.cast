[130.803002, "o", "\u001b[?2004h> "]
[130.803097, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[130.803135, "o", "\u001b[?2004h> "]
[130.803195, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[130.803236, "o", "\u001b[?2004h> "]
