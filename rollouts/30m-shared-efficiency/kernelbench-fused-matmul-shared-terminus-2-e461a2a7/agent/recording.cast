[38.135413, "o", "\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_cuda_event(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_do_bench_interface(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_do_bench_impl(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_host_time(\r\n"]
[38.135448, "o", "\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K502\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_nsight_python(\r\n"]
