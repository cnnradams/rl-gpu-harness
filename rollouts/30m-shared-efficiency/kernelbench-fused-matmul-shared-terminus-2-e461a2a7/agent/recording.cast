[780.154297, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 10\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(2 / 2)\"\r\n  },\r\n  \"runtime\": 2.71,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.71,\r\n    \"std\": 0.058,\r\n    \"min\": 2.67,\r\n    \"max\": 2.83,\r\n    \"num_trials\": 10\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0187,\r\n    \"min\": 11.4,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 10\r\n  },\r\n  \"solution_sha256\": \"3727d4908f509d5bfd5f0ac969443903e8ce83f15112b8ce0008b3c7016b5e17\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 2,\r\n  \"perf_trials\": 10,\r\n  \"speedup\": 4.206642066420664\r\n}\r\n"]
[781.228334, "o", "\u001b[?2004hroot@modal:/# "]
[837.425511, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, itertools\nimport triton.language as tl\n\n@triton.jit\ndef _k(\n    A, BH, BL, Bias, C,\n    M, N, K,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(A_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.lo"]
[837.425555, "i", "ad(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        A_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    mask = (rm[:, None] < M) & (rn[None, :] < N)\n    tl.store(C_ptr, acc, mask=mask)\n\nM = N = K = 16384\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * 1.5\nwt = w.t().contiguous()\nwh = wt.half()\nwl = (wt - wh.float()).half()\nb = torch.randn(N, device='cuda') * 1.5\nout = torch.empty(M, N, device='cuda')\n\n# reference fp32 result for error check\nref = torch.addmm(b, x, wt)\n\nfrom kernelbench.timing import time_execution_with_cuda_event, clear_l2_cache\n\nresults = []\nfor BM, BN, BK, warps, stages in itertools.product([64,128,256],[64,128,256],[32,64],[4,8],[3,4,5]):\n    if BM*BN > 256*256: continue\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN)"]
[837.425569, "i", ",)\n    def run():\n        _k[grid](x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=warps, num_stages=stages)\n    try:\n        run()\n        torch.cuda.synchronize()\n        err = (out - ref).abs().max().item()\n        times = time_execution_with_cuda_event(lambda: run(), [], num_warmup=2, num_trials=10, discard_first=1, verbose=False, device=torch.device('cuda'))\n        t = sum(times)/len(times)\n        results.append((t, err, BM, BN, BK, warps, stages))\n    except Exception as e:\n        pass\nresults.sort()\nfor r in results[:15]:\n    print(f\"t={r[0]:.3f}ms err={r[1]:.2e} BM={r[2]} BN={r[3]} BK={r[4]} warps={r[5]} stages={r[6]}\")\nEOF\nB64=$(base64 -w0 /workspace/tune.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/tune.py && python3 /tmp/tune.py\"\n"]
