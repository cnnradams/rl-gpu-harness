[365.254253, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[365.254279, "o", "\u001b[?2004h> "]
[365.254388, "o", "    lin.weight.copy_(Wf); lin.bias.copy_(bf)\r\n\u001b[?2004l\r"]
[365.254417, "o", "\u001b[?2004h> "]
[365.254446, "o", "y = lin(xf)\r\n\u001b[?2004l\r"]
[365.254475, "o", "\u001b[?2004h> "]
[365.254648, "o", "print('ref linear vs fp64 max abs err:', (y.double() - y64).abs().max().item())\r\n\u001b[?2004l\r"]
[365.254667, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[365.254699, "o", "\u001b[?2004h"]
[365.254728, "o", "> "]
[365.254763, "o", "class Model(nn.Module):\r\n\u001b[?2004l\r"]
[365.254792, "o", "\u001b[?2004h> "]
[365.254844, "o", "    def __init__(self):\r\n\u001b[?2004l\r"]
[365.254862, "o", "\u001b[?2004h> "]
[365.254929, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[365.254965, "o", "\u001b[?2004h> "]
[365.255023, "o", "        self.matmul = lin\r\n\u001b[?2004l\r"]
[365.255052, "o", "\u001b[?2004h> "]
[365.255124, "o", "        self.scaling_factor = 0.5\r\n\u001b[?2004l\r"]
[365.255154, "o", "\u001b[?2004h"]
[365.255183, "o", "> "]
[365.255226, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[365.255253, "o", "> "]
[365.255302, "o", "        x = self.matmul(x)\r\n\u001b[?2004l\r"]
[365.255332, "o", "\u001b[?2004h> "]
[365.255397, "o", "        o = x.clone().detach()\r\n\u001b[?2004l\r"]
[365.255419, "o", "\u001b[?2004h> "]
[365.255518, "o", "        return x * self.scaling_factor + o\r\n\u001b[?2004l\r"]
[365.255539, "o", "\u001b[?2004h"]
[365.25556, "o", "> \r\n\u001b[?2004l\r"]
[365.255587, "o", "\u001b[?2004h> "]
[365.255618, "o", "refm = Model()\r\n\u001b[?2004l\r"]
[365.255645, "o", "\u001b[?2004h> "]
[365.255691, "o", "out_ref = refm(xf)\r\n\u001b[?2004l\r"]
[365.255717, "o", "\u001b[?2004h> "]
[365.25593, "o", "print('ref model vs fp64 max abs err:', (out_ref.double() - out64).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[365.255951, "o", "> \r\n\u001b[?2004l\r"]
[365.255994, "o", "\u001b[?2004h> "]
[365.256142, "o", "# folded cublas variant: out = addmm(1.5b, x, W.t(), alpha=1.5)\r\n\u001b[?2004l\r"]
[365.256166, "o", "\u001b[?2004h> "]
[365.256201, "o", "b15 = bf * 1.5\r\n\u001b[?2004l\r"]
[365.256222, "o", "\u001b[?2004h> "]
[365.256346, "o", "out_fold = torch.addmm(b15, xf, Wf.t(), alpha=1.5)\r\n\u001b[?2004l\r"]
[365.256365, "o", "\u001b[?2004h> "]
[365.256569, "o", "print('folded addmm vs ref model max abs diff:', (out_fold - out_ref).abs().max().item())\r\n\u001b[?2004l\r"]
[365.256592, "o", "\u001b[?2004h"]
[365.256617, "o", "> "]
[365.256786, "o", "print('allclose:', torch.allclose(out_ref, out_fold, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r"]
[365.256816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[365.25684, "o", "\u001b[?2004h> "]
[365.256871, "o", "def v_lin(x):\r\n\u001b[?2004l\r"]
[365.256893, "o", "\u001b[?2004h> "]
[365.256938, "o", "    return lin(x)\r\n\u001b[?2004l\r"]
[365.256977, "o", "\u001b[?2004h> "]
[365.257009, "o", "def v_fold(x):\r\n\u001b[?2004l\r"]
[365.257031, "o", "\u001b[?2004h> "]
[365.257148, "o", "    return torch.addmm(b15, x, Wf.t(), alpha=1.5)\r\n\u001b[?2004l\r"]
[365.257169, "o", "\u001b[?2004h> "]
[365.257202, "o", "def v_elt(x):\r\n\u001b[?2004l\r"]
[365.257226, "o", "\u001b[?2004h> "]
[365.257261, "o", "    y = lin(x)\r\n\u001b[?2004l\r"]
[365.257285, "o", "\u001b[?2004h> "]
[365.25736, "o", "    return y * 0.5 + y.clone()\r\n\u001b[?2004l\r"]
[365.257381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[365.257406, "o", "\u001b[?2004h> "]
[365.257475, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[365.257498, "o", "\u001b[?2004h> "]
[365.257699, "o", "for name, fn in [('ref_full', refm), ('linear_only', v_lin), ('folded_addmm', v_fold)]:\r\n\u001b[?2004l\r"]
[365.257722, "o", "\u001b[?2004h> "]
[365.257942, "o", "    times = time_execution_with_cuda_event(fn, [xf], num_trials=20, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[365.257973, "o", "\u001b[?2004h"]
[365.257995, "o", "> "]
[365.25814, "o", "    print(name, 'mean ms:', sum(times)/len(times), 'min:', min(times))\r\n\u001b[?2004l\r"]
[365.258164, "o", "\u001b[?2004h> "]
[365.258179, "o", "EOF\r\n\u001b[?2004l\r"]
