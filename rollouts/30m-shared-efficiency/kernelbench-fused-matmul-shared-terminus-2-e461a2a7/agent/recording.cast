[365.251388, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, os\nimport torch.nn as nn\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nprint('allow_tf32', torch.backends.cuda.matmul.allow_tf32)\nprint('float32_matmul_precision', torch.get_float32_matmul_precision())\ntry:\n    print('fp32_precision', torch.backends.cuda.matmul.fp32_precision)\nexcept Exception as e:\n    print('no fp32_precision attr')\nprint('NVIDIA_TF32_OVERRIDE', os.environ.get('NVIDIA_TF32_OVERRIDE'))\n\nbatch, inf, outf = 16384, 4096, 4096\ntorch.manual_seed(0)\nxf = torch.rand(batch, inf)\nWf = torch.randn(outf, inf)\nbf = torch.randn(outf)\n\n# fp64 ground truth on GPU\nx64 = xf.double().cuda()\nW64 = Wf.double().cuda()\nb64 = bf.double().cuda()\ny64 = x64 @ W64.t() + b64\nout64 = y64 * 0.5 + y64\n\nxf = xf.cuda(); Wf = Wf.cuda(); bf = bf.cuda()\nlin = nn.Linear(inf, outf).cuda()\nwith torch.no_grad():\n    lin.weight.copy_(Wf); lin.bias.copy_(bf)\ny = lin(xf)\nprint('ref linear vs fp64 max abs err:', (y.double() - y64).abs().max().item())\n\nclass Model(nn.Mo"]
[365.251435, "i", "dule):\n    def __init__(self):\n        super().__init__()\n        self.matmul = lin\n        self.scaling_factor = 0.5\n    def forward(self, x):\n        x = self.matmul(x)\n        o = x.clone().detach()\n        return x * self.scaling_factor + o\n\nrefm = Model()\nout_ref = refm(xf)\nprint('ref model vs fp64 max abs err:', (out_ref.double() - out64).abs().max().item())\n\n# folded cublas variant: out = addmm(1.5b, x, W.t(), alpha=1.5)\nb15 = bf * 1.5\nout_fold = torch.addmm(b15, xf, Wf.t(), alpha=1.5)\nprint('folded addmm vs ref model max abs diff:', (out_fold - out_ref).abs().max().item())\nprint('allclose:', torch.allclose(out_ref, out_fold, atol=1e-4, rtol=1e-4))\n\ndef v_lin(x):\n    return lin(x)\ndef v_fold(x):\n    return torch.addmm(b15, x, Wf.t(), alpha=1.5)\ndef v_elt(x):\n    y = lin(x)\n    return y * 0.5 + y.clone()\n\ndev = torch.device('cuda')\nfor name, fn in [('ref_full', refm), ('linear_only', v_lin), ('folded_addmm', v_fold)]:\n    times = time_execution_with_cuda_event(fn, [xf], num_trials=20, verbose=False, dev"]
[365.251553, "i", "ice=dev)\n    print(name, 'mean ms:', sum(times)/len(times), 'min:', min(times))\nEOF\ngpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- python3 /workspace/bench2.py\n"]
