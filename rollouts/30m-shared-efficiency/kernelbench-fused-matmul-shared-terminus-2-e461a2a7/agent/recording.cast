[1205.470971, "i", "cat > /workspace/tune4.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _kn(\n    AH, AL, BH, BL, C,\n    M, N, K,\n    NDOT: tl.constexpr,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * K + rk[None, :]\n    AL_ptr = AL + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc3 = tl.zeros((B"]
[1205.471018, "i", "M, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a_hi = tl.load(AH_ptr)\n        a_lo = tl.load(AL_ptr)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        if NDOT >= 2:\n            acc2 = tl.dot(a_lo, b_hi, acc2)\n        if NDOT >= 3:\n            acc3 = tl.dot(a_hi, b_lo, acc3)\n        AH_ptr += BK\n        AL_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    acc = acc + acc2 + acc3\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nxh = x.half().contiguous()\nxl = (x - xh.float()).half().contiguous()\nw = torch.randn(N, K, device='cuda') * 1.5\nwt = w.t().contiguous()\nwh = wt.half(); wl = (wt - wh.float()).half()\nout = torch.empty(M, N, device='cuda')\n\ndef bench(fn, n=10):\n    times = time_execution_with_cuda_event(fn, [], num_warmup=2, num_trials=n, discard_first=1, verbose=False, device=torch.device('cuda'))\n    return sum"]
[1205.471041, "i", "(times)/len(times)\n\nfor ndot in [1,2,3]:\n    for BM,BN,BK,w,s in [(128,128,64,8,3),(128,128,64,8,4),(128,256,64,8,3),(128,128,128,8,3),(256,128,64,8,3),(128,256,128,8,3)]:\n        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        def run():\n            _kn[grid](xh, xl, wh, wl, out, M, N, K, NDOT=ndot, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\n        try:\n            t = bench(run)\n            print(f'ndot={ndot} BM={BM} BN={BN} BK={BK} w={w} s={s}: {t:.3f} ms')\n        except Exception as e:\n            print(f'ndot={ndot} BM={BM} BN={BN} BK={BK} w={w} s={s}: FAIL {type(e).__name__}')\nEOF\nB64=$(base64 -w0 /workspace/tune4.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/tune4.py && python3 /tmp/tune4.py\" 2>&1 | grep -v Profiling\n"]
