[575.731702, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        scale = 1.0 + float(scaling_factor)\n        with torch.no_grad():\n            b2 = (self.matmul.bias * scale).contiguous()\n        self.register_buffer(\"b2\", b2)\n        self.register_buffer(\"scale\", torch.tensor(scale))\n\n    def forward(self, x):\n        if x.is_cuda and x.dtype == torch.float32 and x.dim() == 2:\n            return torch.addmm(self.b2, x, self.matmul.weight.t(), alpha=float(self.scale))\n        y = self.matmul(x)\n        return y * self.scaling_factor + y\nEOF\ngpu sync\n"]
