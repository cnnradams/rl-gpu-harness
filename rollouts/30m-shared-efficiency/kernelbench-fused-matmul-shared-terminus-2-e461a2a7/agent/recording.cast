[130.804846, "o", "\u001b[?2004h> "]
[130.804965, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[130.805003, "o", "\u001b[?2004h> "]
[130.805094, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[130.805132, "o", "\u001b[?2004h> "]
[130.805223, "o", "        scale = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r"]
[130.80526, "o", "\u001b[?2004h> "]
[130.805433, "o", "        # Fold scaling+residual into weights: out = x @ (W*scale)^T + b*scale\r\n\u001b[?2004l\r"]
[130.805471, "o", "\u001b[?2004h> "]
[130.805526, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[130.805563, "o", "\u001b[?2004h> "]
[130.805726, "o", "            w2 = (self.matmul.weight * scale).t().contiguous()  # (in, out)\r\n\u001b[?2004l\r"]
[130.805763, "o", "\u001b[?2004h> "]
[130.805917, "o", "            b2 = (self.matmul.bias * scale).contiguous()\r\n\u001b[?2004l\r"]
