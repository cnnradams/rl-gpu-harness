[767.015314, "o", "\u001b[?2004h> "]
[767.015462, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[767.0155, "o", "\u001b[?2004h> "]
[767.015585, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[767.015623, "o", "\u001b[?2004h> "]
[767.015747, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[767.015777, "o", "\u001b[?2004h> "]
[767.015879, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[767.015909, "o", "\u001b[?2004h> "]
[767.016025, "o", "        scale = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[767.016064, "o", "> "]
[767.016114, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[767.016145, "o", "\u001b[?2004h> "]
[767.016333, "o", "            w2 = (self.matmul.weight * scale).t().contiguous()  # (in, out) fp32\r\n\u001b[?2004l\r"]
[767.016353, "o", "\u001b[?2004h> "]
[767.016483, "o", "            b2 = (self.matmul.bias * scale).contiguous()\r\n\u001b[?2004l\r"]
[767.016526, "o", "\u001b[?2004h> "]
[767.016607, "o", "            w_hi = w2.to(torch.float16)\r\n\u001b[?2004l\r"]
[767.016644, "o", "\u001b[?2004h> "]
[767.016785, "o", "            w_lo = (w2 - w_hi.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[767.016821, "o", "\u001b[?2004h> "]
[767.016958, "o", "        # store fp16 as int16 so .to(dtype=fp32) won't cast them\r\n\u001b[?2004l\r"]
[767.01699, "o", "\u001b[?2004h> "]
[767.017129, "o", "        self.register_buffer(\"w_hi_i\", w_hi.view(torch.int16))\r\n\u001b[?2004l\r"]
[767.017162, "o", "\u001b[?2004h> "]
[767.017298, "o", "        self.register_buffer(\"w_lo_i\", w_lo.view(torch.int16))\r\n\u001b[?2004l\r"]
[767.017331, "o", "\u001b[?2004h> "]
[767.017413, "o", "        self.register_buffer(\"b2\", b2)\r\n\u001b[?2004l\r"]
[767.017447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[767.017483, "o", "\u001b[?2004h> "]
[767.017545, "o", "    def _fast(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[767.017566, "o", "> "]
[767.017622, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[767.01766, "o", "\u001b[?2004h> "]
[767.017714, "o", "        N = self.b2.shape[0]\r\n\u001b[?2004l\r"]
[767.017752, "o", "\u001b[?2004h> "]
[767.017904, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[767.017941, "o", "\u001b[?2004h> "]
[767.018036, "o", "        w_hi = self.w_hi_i.view(torch.float16)\r\n\u001b[?2004l\r"]
[767.018066, "o", "\u001b[?2004h> "]
[767.018169, "o", "        w_lo = self.w_lo_i.view(torch.float16)\r\n\u001b[?2004l\r"]
[767.018206, "o", "\u001b[?2004h> "]
[767.018393, "o", "        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[767.018424, "o", "\u001b[?2004h> "]
[767.018583, "o", "        _split_fp16_gemm[grid](x, w_hi, w_lo, self.b2, out, M, N, K)\r\n\u001b[?2004l\r"]
[767.018616, "o", "\u001b[?2004h> "]
[767.018656, "o", "        return out\r\n\u001b[?2004l\r"]
[767.018695, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[767.018731, "o", "\u001b[?2004h> "]
[767.018779, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[767.018816, "o", "\u001b[?2004h> "]
[767.019008, "o", "        if x.is_cuda and x.dtype == torch.float32 and x.dim() == 2 and x.is_contiguous():\r\n\u001b[?2004l\r"]
[767.019048, "o", "\u001b[?2004h> "]
[767.019111, "o", "            return self._fast(x)\r\n\u001b[?2004l\r"]
[767.019146, "o", "\u001b[?2004h> "]
[767.019198, "o", "        y = self.matmul(x)\r\n\u001b[?2004l\r"]
[767.019236, "o", "\u001b[?2004h> "]
[767.019327, "o", "        return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[767.019364, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[767.021269, "o", "\u001b[?2004hroot@modal:/# "]
