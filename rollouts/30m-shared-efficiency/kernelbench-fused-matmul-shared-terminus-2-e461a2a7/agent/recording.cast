[131.058513, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time\nfrom kernelbench.timing import time_execution_with_cuda_event\nimport torch.nn as nn\n\nbatch_size, in_features, out_features, scaling_factor = 16384, 4096, 4096, 0.5\n\ntorch.manual_seed(42)\n\nclass Model(nn.Module):\n    def __init__(self, i, o, s):\n        super().__init__()\n        self.matmul = nn.Linear(i, o)\n        self.scaling_factor = s\n    def forward(self, x):\n        x = self.matmul(x)\n        orig = x.clone().detach()\n        return x * self.scaling_factor + orig\n\nref = Model(in_features, out_features, scaling_factor).cuda()\nx = torch.rand(batch_size, in_features, device='cuda')\nwith torch.no_grad():\n    ref_out = ref(x)\n\nimport importlib.util\nspec = importlib.util.spec_from_file_location('sol', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(sol)\ntorch.manual_seed(42)\nnew = sol.ModelNew(in_features, out_features, scaling_factor).cuda()\nwith torch.no_grad():\n    new_out = new(x)\nprint('max diff triton:',"]
[131.058561, "i", " (ref_out - new_out).abs().max().item())\nprint('allclose 1e-4:', torch.allclose(ref_out, new_out, atol=1e-4, rtol=1e-4))\n\n# variant 2: cublas fp16 addmm + float cast\nscale = 1.5\nwh = (ref.matmul.weight * scale).t().contiguous().half()\nbh = (ref.matmul.bias * scale).half()\ndef v2(x):\n    return torch.addmm(bh, x.half(), wh).float()\nwith torch.no_grad():\n    v2_out = v2(x)\nprint('max diff cublas fp16:', (ref_out - v2_out).abs().max().item())\n\n# variant 3: tf32 folded\ntorch.backends.cuda.matmul.allow_tf32 = True\nw3 = (ref.matmul.weight * scale).t().contiguous()\nb3 = (ref.matmul.bias * scale).contiguous()\ndef v3(x):\n    return torch.addmm(b3, x, w3)\nwith torch.no_grad():\n    v3_out = v3(x)\nprint('max diff tf32:', (ref_out - v3_out).abs().max().item())\n\ndev = torch.device('cuda')\nfor name, fn in [('ref', ref), ('triton_fp16', new), ('cublas_fp16', v2), ('tf32', v3)]:\n    times = time_execution_with_cuda_event(fn, [x], num_trials=20, verbose=False, device=dev)\n    print(name, 'mean ms:', sum(times)/len(times), 'min"]
[131.058584, "i", ":', min(times))\nEOF\necho bench written\n"]
