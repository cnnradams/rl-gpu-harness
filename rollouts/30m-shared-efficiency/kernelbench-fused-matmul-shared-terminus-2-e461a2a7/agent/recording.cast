[1388.440596, "i", "cat > /workspace/tune5.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _k(\n    A, BH, BL, Bias, C,\n    M, N, K,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(A_ptr)\n        a_hi = a.to(tl.float16)\n       "]
[1388.440719, "i", " a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc2 = tl.dot(a_lo, b_hi, acc2)\n        acc2 = tl.dot(a_hi, b_lo, acc2)\n        A_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    acc = acc + acc2\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * 1.5\nwt = w.t().contiguous()\nwh = wt.half(); wl = (wt - wh.float()).half()\nb = torch.randn(N, device='cuda') * 1.5\nout = torch.empty(M, N, device='cuda')\n\ndef bench(fn, n=15):\n    times = time_execution_with_cuda_event(fn, [], num_warmup=3, num_trials=n, discard_first=1, verbose=False, device=torch.device('cuda'))\n    return sum(times)/len(times)\n\nfor BM,BN,BK,w,s,g in [(128,128,32,8,3,8),(128,128,32,8,4,8),(128,128,32,8,6,8),(128,128,32,8,3,4),"]
[1388.440754, "i", "(128,128,32,8,3,16),(64,256,32,4,4,8),(64,128,32,4,4,8),(64,128,32,4,5,8),(256,256,32,8,3,8),(128,64,32,4,4,8),(128,128,64,8,3,8),(256,64,32,4,4,8),(64,64,32,4,4,8)]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        _k[grid](x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=g, num_warps=w, num_stages=s)\n    try:\n        t = bench(run)\n        print(f'BM={BM} BN={BN} BK={BK} w={w} s={s} g={g}: {t:.3f} ms')\n    except Exception as e:\n        print(f'BM={BM} BN={BN} BK={BK} w={w} s={s} g={g}: FAIL {type(e).__name__}')\nEOF\nB64=$(base64 -w0 /workspace/tune5.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/tune5.py && python3 /tmp/tune5.py\" 2>&1 | grep -v Profiling\n"]
[1388.440807, "o", "cat > /workspace/tune5.py << 'EOF'\r\n\u001b[?2004l\r(128,128,32,8,3,16),(64,256,32,4,4,8),(64,128,32,4,4,8),(64,128,32,4,5,8),(256,256,32,8,3,8),(128,64,32,4,4,8),(128,128"]
[1388.440838, "o", ",64,8,3,8),(256,64,32,4,4,8),(64,64,32,4,4,8)]:\r\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n    def run():\r\n        _k[grid]"]
[1388.440865, "o", "(x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=g, num_warps=w, num_stages=s)\r\n    "]
[1388.440886, "o", "try:\r\n        t = bench(run)\r\n        print(f'BM={BM} BN={BN} BK={BK} w={w} s={s} g={g}: {t:"]
[1388.440911, "o", ".3f} ms')\r\n    except Exception as e:\r\n        print(f'BM={BM} BN="]
[1388.440949, "o", "{BN} BK={BK} w={w} s={s} g={g}: FAIL {type(e).__name__}')\r\nEOF\r\nB64=$(base64 -w0 /workspace/tune5.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/tune5.py && python3 /tmp/tune5.py\" 2>&1 | grep -v Profiling\r\n"]
