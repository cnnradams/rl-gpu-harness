[767.008713, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _split_fp16_gemm(\n    A, BH, BL, Bias, C,\n    M, N, K,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M,"]
[767.008757, "i", " GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(A_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        A_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    mask = (rm[:, None] < M) & (rn[None, :] < N)\n    tl.store(C_ptr, acc, mask=mask)\n\n\nclass ModelNew(nn.Module):\n    def __ini"]
[767.008887, "i", "t__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        scale = 1.0 + float(scaling_factor)\n        with torch.no_grad():\n            w2 = (self.matmul.weight * scale).t().contiguous()  # (in, out) fp32\n            b2 = (self.matmul.bias * scale).contiguous()\n            w_hi = w2.to(torch.float16)\n            w_lo = (w2 - w_hi.to(torch.float32)).to(torch.float16)\n        # store fp16 as int16 so .to(dtype=fp32) won't cast them\n        self.register_buffer(\"w_hi_i\", w_hi.view(torch.int16))\n        self.register_buffer(\"w_lo_i\", w_lo.view(torch.int16))\n        self.register_buffer(\"b2\", b2)\n\n    def _fast(self, x):\n        M, K = x.shape\n        N = self.b2.shape[0]\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        w_hi = self.w_hi_i.view(torch.float16)\n        w_lo = self.w_lo_i.view(torch.float16)\n        grid = lambda META: (trit"]
[767.008902, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[767.008944, "i", "on.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n        _split_fp16_gemm[grid](x, w_hi, w_lo, self.b2, out, M, N, K)\n        return out\n\n    def forward(self, x):\n        if x.is_cuda and x.dtype == torch.float32 and x.dim() == 2 and x.is_contiguous():\n            return self._fast(x)\n        y = self.matmul(x)\n        return y * self.scaling_factor + y\nEOF\nB64=$(base64 -w0 /workspace/solution.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/solution.py && cd /tmp && python3 /opt/task/evaluate.py /tmp/solution.py --correct-trials 2 --perf-trials 10\"\n"]
