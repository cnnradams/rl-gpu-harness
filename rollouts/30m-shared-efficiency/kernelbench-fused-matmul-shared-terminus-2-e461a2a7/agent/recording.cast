[1038.035259, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch, triton, itertools\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _k2acc(\n    A, BH, BL, Bias, C,\n    M, N, K,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(A_ptr)\n        a_hi = a.to(tl.f"]
[1038.035313, "i", "loat16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc2 = tl.dot(a_lo, b_hi, acc2)\n        acc2 = tl.dot(a_hi, b_lo, acc2)\n        A_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    acc = acc + acc2\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    mask = (rm[:, None] < M) & (rn[None, :] < N)\n    tl.store(C_ptr, acc, mask=mask)\n\n@triton.jit\ndef _k1(\n    A, B, Bias, C,\n    M, N, K,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + t"]
[1038.03533, "i", "l.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    B_ptr = B + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a = tl.load(A_ptr)\n        b = tl.load(B_ptr)\n        acc = tl.dot(a, b, acc)\n        A_ptr += BK\n        B_ptr += BK * N\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nxh = x.half()\nw = torch.randn(N, K, device='cuda') * 1.5\nwt = w.t().contiguous()\nwh = wt.half()\nwl = (wt - wh.float()).half()\nb = torch.randn(N, device='cuda') * 1.5\nout = torch.empty(M, N, device='cuda')\nref = torch.addmm(b, x, wt)\n\ndef bench(fn, n=10):\n    times = time_execution_with_cuda_event(fn, [], num_warmup=2, num_trials=n, discard_first=1, verbose=False, device=torch.device('cuda'))\n    return sum(times)/len(times)\n\nprint('--- pure fp16 single GEMM (pea"]
[1038.035476, "i", "k ref) ---')\nfor BM,BN,BK,w,s in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,64,4,4),(128,256,64,8,4),(256,128,64,8,4)]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        _k1[grid](xh, wh, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\n    t = bench(run)\n    print(f'BM={BM} BN={BN} BK={BK} w={w} s={s}: {t:.3f} ms')\n\nprint('--- 2-acc split kernel ---')\nfor BM,BN,BK,w,s in [(128,128,32,8,3),(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,64,4,4),(128,256,32,8,4),(64,256,64,4,4)]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        _k2acc[grid](x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\n    run(); torch.cuda.synchronize()\n    err = (out-ref).abs().max().item()\n    t = bench(run)\n    print(f'BM={BM} BN={BN} BK={BK} w={w} s={s}: {t:.3f} ms err={err:.2e}')\nEOF\nB64=$(base64 -w0 /workspace/tune2.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tm"]
