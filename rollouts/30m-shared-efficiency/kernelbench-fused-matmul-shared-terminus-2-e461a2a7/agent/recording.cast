[1324.769519, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(3 / 3)\"\r\n  },\r\n  \"runtime\": 2.79,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.79,\r\n    \"std\": 0.0343,\r\n    \"min\": 2.77,\r\n    \"max\": 2.94,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.00777,\r\n    \"min\": 11.4,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"f2220fbf4e1aa135034c71b4064e4a81cfa6b0615b67680fb94a647df53a2fec\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 3,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.086021505376344\r\n}\r\n"]
