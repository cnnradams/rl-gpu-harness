[1545.28848, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.97,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.97,\r\n    \"std\": 0.136,\r\n    \"min\": 2.83,\r\n    \"max\": 3.12,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0606,\r\n    \"min\": 11.3,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"5c2eca060f3f7df91b6ef75989d452ea6d288141d8a85331567d40503c1a949a\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 3.8047138047138045\r\n}\r\n"]
