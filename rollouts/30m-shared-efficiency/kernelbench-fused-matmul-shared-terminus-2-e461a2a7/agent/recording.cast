[837.4287, "o", "\u001b[?2004h> "]
[837.42876, "o", "        b_hi = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[837.428799, "o", "\u001b[?2004h> "]
[837.428857, "o", "        b_lo = tl.load(BL_ptr)\r\n\u001b[?2004l\r"]
[837.428903, "o", "\u001b[?2004h> "]
[837.428969, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[837.429003, "o", "\u001b[?2004h> "]
[837.429083, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[837.429122, "o", "\u001b[?2004h> "]
