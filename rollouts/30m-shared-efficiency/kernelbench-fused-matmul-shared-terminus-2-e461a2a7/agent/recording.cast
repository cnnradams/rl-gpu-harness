[837.428322, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[837.42836, "o", "\u001b[?2004h> "]
[837.428409, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
