[837.431796, "o", "for BM, BN, BK, warps, stages in itertools.product([64,128,256],[64,128,256],[32,64],[4,8],[3,4,5]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[837.431887, "o", "    if BM*BN > 256*256: continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[837.431934, "o", "> "]
[837.432039, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[837.432088, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[837.432129, "o", "> "]
[837.432379, "o", "        _k[grid](x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[837.43243, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[837.432472, "o", ">         run()\r\n\u001b[?2004l\r"]
[837.432516, "o", "\u001b[?2004h> "]
