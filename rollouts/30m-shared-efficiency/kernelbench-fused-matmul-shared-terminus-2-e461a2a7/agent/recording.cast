[1038.037656, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1038.037693, "o", "\u001b[?2004h> "]
[1038.037776, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1038.037815, "o", "\u001b[?2004h> "]
[1038.037867, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1038.037901, "o", "\u001b[?2004h> "]
[1038.038003, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[1038.038041, "o", "\u001b[?2004h> "]
[1038.038144, "o", "    BH_ptr = BH + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1038.038179, "o", "\u001b[?2004h> "]
[1038.038285, "o", "    BL_ptr = BL + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1038.038323, "o", "\u001b[?2004h> "]
[1038.038425, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1038.038462, "o", "\u001b[?2004h> "]
[1038.038575, "o", "    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1038.038613, "o", "\u001b[?2004h> "]
[1038.038673, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1038.038708, "o", "\u001b[?2004h> "]
[1038.038766, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[1038.0388, "o", "\u001b[?2004h> "]
[1038.03887, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1038.038907, "o", "\u001b[?2004h> "]
[1038.039028, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1038.039062, "o", "\u001b[?2004h> "]
[1038.039128, "o", "        b_hi = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[1038.039166, "o", "\u001b[?2004h> "]
[1038.039229, "o", "        b_lo = tl.load(BL_ptr)\r\n\u001b[?2004l\r"]
[1038.039267, "o", "\u001b[?2004h> "]
[1038.039345, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[1038.039382, "o", "\u001b[?2004h> "]
[1038.039465, "o", "        acc2 = tl.dot(a_lo, b_hi, acc2)\r\n\u001b[?2004l\r"]
[1038.039503, "o", "\u001b[?2004h> "]
[1038.039594, "o", "        acc2 = tl.dot(a_hi, b_lo, acc2)\r\n\u001b[?2004l\r"]
[1038.039631, "o", "\u001b[?2004h> "]
[1038.039668, "o", "        A_ptr += BK\r\n\u001b[?2004l\r"]
[1038.039706, "o", "\u001b[?2004h> "]
[1038.039755, "o", "        BH_ptr += BK * N\r\n\u001b[?2004l\r"]
[1038.039792, "o", "\u001b[?2004h> "]
[1038.039843, "o", "        BL_ptr += BK * N\r\n\u001b[?2004l\r"]
[1038.039874, "o", "\u001b[?2004h> "]
[1038.039922, "o", "    acc = acc + acc2\r\n\u001b[?2004l\r"]
[1038.039955, "o", "\u001b[?2004h> "]
[1038.040031, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[1038.040062, "o", "\u001b[?2004h> "]
[1038.040129, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1038.040167, "o", "\u001b[?2004h> "]
[1038.040263, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1038.040302, "o", "\u001b[?2004h> "]
[1038.040403, "o", "    mask = (rm[:, None] < M) & (rn[None, :] < N)\r\n\u001b[?2004l\r"]
[1038.040441, "o", "\u001b[?2004h> "]
[1038.040516, "o", "    tl.store(C_ptr, acc, mask=mask)\r\n\u001b[?2004l\r"]
[1038.040555, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1038.040587, "o", "\u001b[?2004h> "]
[1038.040619, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1038.040658, "o", "\u001b[?2004h> "]
[1038.040689, "o", "def _k1(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.040743, "o", "    A, B, Bias, C,\r\n\u001b[?2004l\r"]
[1038.040781, "o", "\u001b[?2004h> "]
[1038.040806, "o", "    M, N, K,\r\n\u001b[?2004l\r"]
[1038.040844, "o", "\u001b[?2004h> "]
[1038.041026, "o", "    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r"]
[1038.041065, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[1038.0411, "o", "\u001b[?2004h> "]
[1038.041149, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1038.041188, "o", "\u001b[?2004h> "]
[1038.041245, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1038.041283, "o", "\u001b[?2004h> "]
[1038.041338, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1038.041377, "o", "\u001b[?2004h> "]
[1038.041436, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1038.041475, "o", "\u001b[?2004h> "]
[1038.041534, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1038.041567, "o", "\u001b[?2004h> "]
[1038.041716, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1038.041755, "o", "\u001b[?2004h> "]
[1038.041862, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1038.041901, "o", "\u001b[?2004h> "]
[1038.041983, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1038.042015, "o", "\u001b[?2004h> "]
[1038.042101, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1038.042132, "o", "\u001b[?2004h> "]
[1038.042219, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1038.042258, "o", "\u001b[?2004h> "]
[1038.042309, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1038.042341, "o", "\u001b[?2004h> "]
[1038.042443, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[1038.042482, "o", "\u001b[?2004h> "]
[1038.042586, "o", "    B_ptr = B + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1038.042619, "o", "\u001b[?2004h> "]
[1038.042722, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1038.042772, "o", "\u001b[?2004h> "]
[1038.04282, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1038.042853, "o", "\u001b[?2004h> "]
[1038.042913, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[1038.042945, "o", "\u001b[?2004h> "]
[1038.043005, "o", "        b = tl.load(B_ptr)\r\n\u001b[?2004l\r"]
[1038.043037, "o", "\u001b[?2004h> "]
[1038.043107, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r"]
[1038.043139, "o", "\u001b[?2004h> "]
[1038.043184, "o", "        A_ptr += BK\r\n\u001b[?2004l\r"]
[1038.043216, "o", "\u001b[?2004h> "]
[1038.04327, "o", "        B_ptr += BK * N\r\n\u001b[?2004l\r"]
[1038.0433, "o", "\u001b[?2004h> "]
[1038.043367, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[1038.043399, "o", "\u001b[?2004h> "]
[1038.043466, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1038.043497, "o", "\u001b[?2004h> "]
[1038.043607, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1038.04364, "o", "\u001b[?2004h> "]
[1038.043724, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[1038.043755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1038.043787, "o", "\u001b[?2004h> "]
[1038.043851, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[1038.043883, "o", "\u001b[?2004h> "]
[1038.04393, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[1038.043961, "o", "\u001b[?2004h> "]
[1038.044057, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[1038.044088, "o", "\u001b[?2004h> "]
[1038.04412, "o", "xh = x.half()\r\n\u001b[?2004l\r"]
[1038.044159, "o", "\u001b[?2004h> "]
[1038.044242, "o", "w = torch.randn(N, K, device='cuda') * 1.5\r\n\u001b[?2004l\r"]
[1038.044273, "o", "\u001b[?2004h> "]
[1038.044327, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[1038.044359, "o", "\u001b[?2004h> "]
[1038.04439, "o", "wh = wt.half()\r\n\u001b[?2004l\r"]
[1038.044422, "o", "\u001b[?2004h> "]
[1038.044493, "o", "wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[1038.044512, "o", "\u001b[?2004h"]
[1038.044561, "o", "> "]
[1038.044621, "o", "b = torch.randn(N, device='cuda') * 1.5\r\n\u001b[?2004l\r"]
[1038.044666, "o", "\u001b[?2004h> "]
[1038.044741, "o", "out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r"]
[1038.044779, "o", "\u001b[?2004h> "]
[1038.044834, "o", "ref = torch.addmm(b, x, wt)\r\n\u001b[?2004l\r"]
[1038.044887, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.044921, "o", "> "]
[1038.044961, "o", "def bench(fn, n=10):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.045298, "o", "    times = time_execution_with_cuda_event(fn, [], num_warmup=2, num_trials=n, discard_first=1, verbose=False, device=torch.device('cuda'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.045388, "o", "    return sum(times)/len(times)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.04543, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.045567, "o", "print('--- pure fp16 single GEMM (peak ref) ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.045607, "o", "> "]
[1038.045871, "o", "for BM,BN,BK,w,s in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,64,4,4),(128,256,64,8,4),(256,128,64,8,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.045908, "o", "> "]
[1038.046003, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1038.046043, "o", "\u001b[?2004h> "]
[1038.046082, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.046114, "o", "> "]
[1038.04633, "o", "        _k1[grid](xh, wh, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[1038.04637, "o", "\u001b[?2004h> "]
[1038.046402, "o", "    t = bench(run)\r\n\u001b[?2004l\r"]
[1038.04644, "o", "\u001b[?2004h> "]
[1038.04658, "o", "    print(f'BM={BM} BN={BN} BK={BK} w={w} s={s}: {t:.3f} ms')\r\n\u001b[?2004l\r"]
[1038.046619, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.046658, "o", "> "]
[1038.046715, "o", "print('--- 2-acc split kernel ---')\r\n\u001b[?2004l\r"]
[1038.046754, "o", "\u001b[?2004h> "]
[1038.047068, "o", "for BM,BN,BK,w,s in [(128,128,32,8,3),(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,64,4,4),(128,256,32,8,4),(64,256,64,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.047108, "o", "> "]
[1038.047207, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1038.047245, "o", "\u001b[?2004h> "]
[1038.047284, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.047323, "o", "> "]
[1038.047557, "o", "        _k2acc[grid](x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.047573, "o", "> "]
[1038.047665, "o", "    run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1038.047703, "o", "\u001b[?2004h> "]
[1038.047776, "o", "    err = (out-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[1038.047814, "o", "\u001b[?2004h> "]
[1038.047853, "o", "    t = bench(run)\r\n\u001b[?2004l\r"]
[1038.047892, "o", "\u001b[?2004h> "]
[1038.048071, "o", "    print(f'BM={BM} BN={BN} BK={BK} w={w} s={s}: {t:.3f} ms err={err:.2e}')\r\n\u001b[?2004l\r"]
[1038.048087, "o", "\u001b[?2004h> "]
[1038.04812, "o", "EOF\r\n\u001b[?2004l\r"]
[1038.05, "o", "\u001b[?2004hroot@modal:/# "]
[1038.050353, "o", "B64=$(base64 -w0 /workspace/tune2.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/tune2.py && python3 /tmp/tune2.py\"\r\n\u001b[?2004l\r"]
[1038.17133, "o", "request ID: abafc6332ad14d03bbad4c462f5e8b6e\r\n"]
[1039.652108, "o", "command: 9c92040eb5964a21b1f327bc44ea44e3\r\n"]
[1049.479903, "o", "--- pure fp16 single GEMM (peak ref) ---\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=128 BN=128 BK=64 w=8 s=3: 0.994 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=128 BN=256 BK=64 w=8 s=3: 0.852 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=256 BN=128 BK=64 w=8 s=3: 0.897 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=128 BN=128 BK=64 w=4 s=4: 0.904 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=128 BN=256 BK=64 w=8 s=4: 0.785 ms\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=256 BN=128 BK=64 w=8 s=4: 0.871 ms\r\n--- 2-acc split kernel ---\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=128 BN=128 BK=32 w=8 s=3: 2.871 ms err=2.18e-03\r\n[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 2, trials 10\r\nBM=128 BN=128 BK=64 w=8 s=3: 2.758 ms err=2.18e-03\r\n"]
[1049.677222, "o", "Traceback (most recent call last):\r\n  File \"/tmp/tune2.py\", line 106, in <module>\r\n    run(); torch.cuda.synchronize()\r\n  File \"/tmp/tune2.py\", line 105, in run\r\n    _k2acc[grid](x, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 419, in <lambda>\r\n    return lambda *args, **kwargs: self.run(grid=grid, warmup=False, *args, **kwargs)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 756, in run\r\n    launch_metadata = kernel.launch_metadata(grid, stream, *bound_args.values())\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\", line 490, in launch_metadata\r\n    self._init_handles()\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\", line 464, in _init_handles\r\n    raise_(OutOfResources(self.metadata.shared, max_shared, \"shared memory\"))\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\", line 4"]
[1049.677374, "o", "56, in raise_\r\n    raise err\r\ntriton.runtime.errors.OutOfResources: out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\n"]
[1051.407168, "o", "\u001b[?2004hroot@modal:/# "]
[1127.272995, "i", "cat > /workspace/tune3.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _split(A, HI, LO, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    a = tl.load(A + offs, mask=mask)\n    hi = a.to(tl.float16)\n    lo = (a - hi.to(tl.float32)).to(tl.float16)\n    tl.store(HI + offs, hi, mask=mask)\n    tl.store(LO + offs, lo, mask=mask)\n\n@triton.jit\ndef _k(\n    AH, AL, BH, BL, Bias, C,\n    M, N, K,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    r"]
[1127.273039, "i", "k = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * K + rk[None, :]\n    AL_ptr = AL + rm[:, None] * K + rk[None, :]\n    BH_ptr = BH + rk[:, None] * N + rn[None, :]\n    BL_ptr = BL + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        a_hi = tl.load(AH_ptr)\n        a_lo = tl.load(AL_ptr)\n        b_hi = tl.load(BH_ptr)\n        b_lo = tl.load(BL_ptr)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc2 = tl.dot(a_lo, b_hi, acc2)\n        acc2 = tl.dot(a_hi, b_lo, acc2)\n        AH_ptr += BK\n        AL_ptr += BK\n        BH_ptr += BK * N\n        BL_ptr += BK * N\n    acc = acc + acc2\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.randn(N, K, device='cuda') * 1.5\nwt = w.t().contiguous()\nwh = wt.half()\nwl = (wt - wh.float()).half()\nb "]
[1127.273052, "i", "= torch.randn(N, device='cuda') * 1.5\nout = torch.empty(M, N, device='cuda')\nxh = torch.empty(M, K, device='cuda', dtype=torch.float16)\nxl = torch.empty(M, K, device='cuda', dtype=torch.float16)\nref = torch.addmm(b, x, wt)\nnumel = M * K\n\ndef bench(fn, n=10):\n    times = time_execution_with_cuda_event(fn, [], num_warmup=2, num_trials=n, discard_first=1, verbose=False, device=torch.device('cuda'))\n    return sum(times)/len(times)\n\ndef run_split():\n    _split[(triton.cdiv(numel, 4096),)](x, xh, xl, numel, BLOCK=4096, num_warps=8)\nprint('split kernel:', bench(run_split), 'ms')\n\nprint('--- fp16-input split GEMM ---')\nfor BM,BN,BK,w,s in [(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,256,64,8,4),(256,128,64,8,4),(128,128,64,8,4),(128,256,32,8,4),(64,256,64,4,4),(128,64,64,4,4)]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    def run():\n        _k[grid](xh, xl, wh, wl, b, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=w, num_stages=s)\n    try:\n        run(); torch.cuda.synchronize()\n       "]
[1127.273231, "i", " err = (out-ref).abs().max().item()\n        t = bench(run)\n        print(f'BM={BM} BN={BN} BK={BK} w={w} s={s}: {t:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'BM={BM} BN={BN} BK={BK} w={w} s={s}: FAIL {type(e).__name__}')\nEOF\nB64=$(base64 -w0 /workspace/tune3.py); gpu exec sb-tpWRvXhTooeSQCMNw1evw8 -- bash -c \"echo $B64 | base64 -d > /tmp/tune3.py && python3 /tmp/tune3.py\"\n"]
