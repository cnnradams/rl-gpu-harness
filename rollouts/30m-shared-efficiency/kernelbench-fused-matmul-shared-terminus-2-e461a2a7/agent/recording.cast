[837.427837, "o", "\u001b[?2004h> "]
[837.427929, "o", "    BH_ptr = BH + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[837.427968, "o", "\u001b[?2004h> "]
