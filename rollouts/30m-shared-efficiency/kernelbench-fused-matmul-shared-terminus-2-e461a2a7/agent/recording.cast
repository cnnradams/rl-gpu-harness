[837.429651, "o", "\u001b[?2004h> "]
[837.429762, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[837.429801, "o", "\u001b[?2004h> "]
