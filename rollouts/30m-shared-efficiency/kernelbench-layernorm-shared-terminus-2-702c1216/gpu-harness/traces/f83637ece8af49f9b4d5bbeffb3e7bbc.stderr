    PartialSum, PartialSq, Mean, Rstd,
    stride_pm, stride_pb,
    HW: tl.constexpr,
    BLOCK: tl.constexpr,
    eps,
):
    c = tl.program_id(0)
    acc = tl.zeros((HW,), dtype=tl.float64)
    acc2 = tl.zeros((HW,), dtype=tl.float64)
    for k in range(0, tl.cdiv(4096, BLOCK)):
        offs = k * BLOCK + tl.arange(0, BLOCK)
        m = offs < 4096
        ps_ptr = PartialSum + c * stride_pm + offs * stride_pb
        pq_ptr = PartialSq + c * stride_pm + offs * stride_pb
        s = tl.load(ps_ptr, mask=m, other=0.0)
        q = tl.load(pq_ptr, mask=m, other=0.0)
        acc += s
        acc2 += q
    total = tl.sum(acc, axis=0)
    total2 = tl.sum(acc2, axis=0)
    mean = total / 65536.0
    var = total2 / 65536.0 - mean * mean
    rstd = 1.0 / tl.sqrt(var + eps)
    tl.store(Mean + c, mean.to(tl.float32))
    tl.store(Rstd + c, rstd.to(tl.float32))

