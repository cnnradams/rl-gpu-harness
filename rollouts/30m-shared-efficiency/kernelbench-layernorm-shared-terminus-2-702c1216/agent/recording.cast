[794.631202, "o", "copy BLOCK=1024 nw=4: 0.1973 ms -> 2721 GB/s\r\ncopy BLOCK=2048 nw=8: 0.1958 ms -> 2742 GB/s\r\ncopy BLOCK=4096 nw=16: 0.1963 ms -> 2735 GB/s\r\ncopy BLOCK=8192 nw=32: 0.1952 ms -> 2750 GB/s\r\napply-noW: 0.1988 ms -> 2701 GB/s\r\napply-wb-simplified: 0.2027 ms -> 2649 GB/s\r\napply4d: 0.2029 ms -> 2646 GB/s\r\n"]
[795.432079, "o", "\u001b[?2004hroot@modal:/# "]
[883.063106, "i", "cat > /tmp/bench3.py << 'EOF'\nimport torch, sys, triton\nimport triton.language as tl\n\ndev = 'cuda'\nB, C, INNER = 16, 64, 65536\nS = C * INNER\nx = torch.rand(B, C, 256, 256, device=dev)\nx2 = x.reshape(B * C, INNER)\nw = torch.rand(C, INNER, device=dev)\nbias = torch.rand(C, INNER, device=dev)\nmean = torch.rand(B, device=dev)\nrstd = torch.rand(B, device=dev)\ny = torch.empty(B * C, INNER, device=dev)\nps = torch.empty(B * C, device=dev, dtype=torch.float64)\npq = torch.empty(B * C, device=dev, dtype=torch.float64)\n\ndef timeit(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef _stats2(X, W, Bs, PS, PQ, INNER: tl.constexpr, BLOCK: tl.constexpr, VEC: tl.constexpr, CM: tl.constex"]
[883.063154, "i", "pr):\n    pid = tl.program_id(0)\n    ch = pid % 64\n    N: tl.constexpr = BLOCK * VEC\n    offs = tl.arange(0, N)\n    x_ptr = X + pid.to(tl.int64) * INNER\n    w_ptr = W + ch * INNER\n    b_ptr = Bs + ch * INNER\n    s = tl.zeros((N,), dtype=tl.float64)\n    sq = tl.zeros((N,), dtype=tl.float64)\n    for k in range(0, INNER // N):\n        o = k * N + offs\n        if CM == 1:\n            xx = tl.load(x_ptr + o, cache_modifier='.cg').to(tl.float64)\n            ww = tl.load(w_ptr + o, cache_modifier='.cg').to(tl.float64)\n            bb = tl.load(b_ptr + o, cache_modifier='.cg').to(tl.float64)\n        else:\n            xx = tl.load(x_ptr + o).to(tl.float64)\n            ww = tl.load(w_ptr + o).to(tl.float64)\n            bb = tl.load(b_ptr + o).to(tl.float64)\n        yy = xx * ww + bb\n        s += yy\n        sq += yy * yy\n    tl.store(PS + pid, tl.sum(s, axis=0))\n    tl.store(PQ + pid, tl.sum(sq, axis=0))\n\nfor cm in [0, 1]:\n    for blk, vec, nw in [(1024, 4, 8), (2048, 4, 16), (1024, 2, 4), (2048, 2, 8), (4096, 4, 32)]:\n  "]
[883.06318, "i", "      try:\n            t = timeit(lambda: _stats2[(B*C,)](x2, w, bias, ps, pq, INNER=INNER, BLOCK=blk, VEC=vec, CM=cm, num_warps=nw))\n            print(f\"stats2 cm={cm} BLOCK={blk} VEC={vec} nw={nw}: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\n        except Exception as ex:\n            print(f\"stats2 cm={cm} BLOCK={blk} VEC={vec} nw={nw}: FAIL {ex}\")\n\n@triton.jit\ndef _apply_cs(X, W, Bs, Mean, Rstd, Y, S: tl.constexpr, INNER: tl.constexpr, BLOCK: tl.constexpr, CM: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    base = pid * BLOCK\n    b = base // S\n    j = base % INNER\n    offs = base + tl.arange(0, BLOCK)\n    offsj = j + tl.arange(0, BLOCK)\n    if CM == 1:\n        xx = tl.load(X + offs, cache_modifier='.cg')\n        ww = tl.load(W + offsj, cache_modifier='.cg')\n        bb = tl.load(Bs + offsj, cache_modifier='.cg')\n    else:\n        xx = tl.load(X + offs)\n        ww = tl.load(W + offsj)\n        bb = tl.load(Bs + offsj)\n    m = tl.load(Mean + b)\n    r = tl.load(Rstd + b)\n    res = (xx * ww + "]
[883.063295, "i", "bb - m) * r\n    if CM == 1:\n        tl.store(Y + offs, res, cache_modifier='.cs')\n    else:\n        tl.store(Y + offs, res)\n\nfor cm in [0, 1]:\n    for blk, nw in [(2048, 8), (4096, 16), (8192, 32)]:\n        t = timeit(lambda: _apply_cs[(B*S//blk,)](x2, w, bias, mean, rstd, y, S=S, INNER=INNER, BLOCK=blk, CM=cm, num_warps=nw))\n        print(f\"apply cm={cm} BLOCK={blk} nw={nw}: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\nEOF\ngpu push sb-nOQVVTiSixJVaDLT5CZJ67 /tmp/bench3.py /root/bench3.py && gpu exec sb-nOQVVTiSixJVaDLT5CZJ67 -- python3 /root/bench3.py\n"]
