[231.526974, "o", "\u001b[?2004h> "]
[231.527006, "o", "            x2, w, b, ps, pq,\r\n\u001b[?2004l\r"]
[231.527039, "o", "\u001b[?2004h> "]
[231.527122, "o", "            x2.stride(0), ps.stride(1), ps.stride(2),\r\n\u001b[?2004l\r"]
[231.527154, "o", "\u001b[?2004h> "]
[231.52722, "o", "            HW=256, BLOCK=1024, VEC=4, num_warps=8,\r\n\u001b[?2004l\r"]
[231.527251, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[231.527283, "o", "\u001b[?2004h> "]
[231.527338, "o", "        _ln_reduce_kernel[(64,)](\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.52737, "o", "> "]
