[359.919667, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_stats_kernel(\n    X, W, B, PS, PQ,\n    s0, s1,\n    C: tl.constexpr,\n    INNER: tl.constexpr,\n    BLOCK: tl.constexpr,\n    VEC: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    b = pid // C\n    ch = pid % C\n    N: tl.constexpr = BLOCK * VEC\n    offs = tl.arange(0, N)\n    x_ptr = X + pid.to(tl.int64) * INNER\n    w_ptr = W + ch * INNER\n    b_ptr = B + ch * INNER\n    s = tl.zeros((N,), dtype=tl.float64)\n    sq = tl.zeros((N,), dtype=tl.float64)\n    for k in range(0, INNER // N):\n        o = k * N + offs\n        x = tl.load(x_ptr + o).to(tl.float64)\n        w = tl.load(w_ptr + o).to(tl.float64)\n        bb = tl.load(b_ptr + o).to(tl.float64)\n        y = x * w + bb\n        s += y\n        sq += y * y\n    base = b.to(tl.int64) * s0 + ch * s1\n    tl.store(PS + base + offs, s)\n    tl.store(PQ + base + offs, sq)\n\n\n@triton.jit\ndef _ln_reduce_kernel(\n    PS, PQ, Mean, Rstd,\n    s0, s1, ep"]
[359.919713, "i", "s,\n    C: tl.constexpr,\n    S: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    b = tl.program_id(0).to(tl.int64)\n    offs = tl.arange(0, BLOCK)\n    acc = tl.zeros((BLOCK,), dtype=tl.float64)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float64)\n    for ch in range(0, C):\n        base = b * s0 + ch * s1\n        acc += tl.load(PS + base + offs)\n        acc2 += tl.load(PQ + base + offs)\n    total = tl.sum(acc, axis=0)\n    total2 = tl.sum(acc2, axis=0)\n    mean = total / S\n    var = total2 / S - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(Mean + b, mean.to(tl.float32))\n    tl.store(Rstd + b, rstd.to(tl.float32))\n\n\n@triton.jit\ndef _ln_apply_kernel(\n    X, W, B, Mean, Rstd, Y,\n    C: tl.constexpr,\n    INNER: tl.constexpr,\n    S: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    pid = tl.program_id(0).to(tl.int64)\n    base = pid * BLOCK\n    b = base // S\n    r = base % S\n    i = r // INNER\n    j = r % INNER\n    offs = base + tl.arange(0, BLOCK)\n    x = tl.load(X + offs)\n    w = tl.load(W + i * INNER + j + tl.ar"]
[359.919728, "i", "ange(0, BLOCK))\n    bb = tl.load(B + i * INNER + j + tl.arange(0, BLOCK))\n    mean = tl.load(Mean + b)\n    rstd = tl.load(Rstd + b)\n    y = x * w + bb\n    y = (y - mean) * rstd\n    tl.store(Y + offs, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        shape = x.shape\n        B = shape[0]\n        S = 1\n        for d in shape[1:]:\n            S *= d\n        C = self.ln.weight.shape[0]\n        INNER = S // C\n        if S % C != 0 or INNER % 4096 != 0 or S % 4096 != 0:\n            return self.ln(x)\n        x2 = x.reshape(B * C, INNER)\n        w = self.ln.weight.reshape(C, INNER)\n        bias = self.ln.bias.reshape(C, INNER)\n        PB = 4096\n        ps = torch.empty(B, C, PB, device=x.device, dtype=torch.float64)\n        pq = torch.empty(B, C, PB, device=x.device, dtype=torch.float64)\n        mean = torch.empty(B, device=x.device"]
[359.919735, "i", ", dtype=torch.float32)\n        rstd = torch.empty(B, device=x.device, dtype=torch.float32)\n        y = torch.empty(B * C, INNER, device=x.device, dtype=x.dtype)\n        eps = self.ln.eps\n        _ln_stats_kernel[(B * C,)](\n            x2, w, bias, ps, pq,\n            ps.stride(0), ps.stride(1),\n            C=C, INNER=INNER, BLOCK=1024, VEC=4, num_warps=8,\n        )\n        _ln_reduce_kernel[(B,)](\n            ps, pq, mean, rstd,\n            ps.stride(0), ps.stride(1), eps,\n            C=C, S=S, BLOCK=PB, num_warps=32,\n        )\n        _ln_apply_kernel[(B * S // 4096,)](\n            x2, w, bias, mean, rstd, y,\n            C=C, INNER=INNER, S=S, BLOCK=4096, num_warps=16,\n        )\n        return y.reshape(shape)\nEOF\ngpu exec sb-nOQVVTiSixJVaDLT5CZJ67 -- python3 /opt/task/evaluate.py /workspace/solution.py 2>&1 | tail -45\n"]
