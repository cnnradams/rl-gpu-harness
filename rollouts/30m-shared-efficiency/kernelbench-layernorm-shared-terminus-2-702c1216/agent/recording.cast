[231.525957, "o", "\u001b[?2004h> "]
[231.526006, "o", "        x2 = x.reshape(16, 64, 65536)\r\n\u001b[?2004l\r"]
[231.526039, "o", "\u001b[?2004h> "]
[231.526106, "o", "        w = self.ln.weight.reshape(64, 65536)\r\n\u001b[?2004l\r"]
[231.526135, "o", "\u001b[?2004h> "]
[231.526194, "o", "        b = self.ln.bias.reshape(64, 65536)\r\n\u001b[?2004l\r"]
[231.526226, "o", "\u001b[?2004h> "]
[231.526335, "o", "        ps = torch.empty(64, 256, 4096, device=x.device, dtype=torch.float64)\r\n\u001b[?2004l\r"]
[231.526367, "o", "\u001b[?2004h> "]
[231.526477, "o", "        pq = torch.empty(64, 256, 4096, device=x.device, dtype=torch.float64)\r\n\u001b[?2004l\r"]
[231.526505, "o", "\u001b[?2004h> "]
[231.526604, "o", "        mean = torch.empty(64, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[231.526631, "o", "\u001b[?2004h> "]
[231.526732, "o", "        rstd = torch.empty(64, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[231.526764, "o", "\u001b[?2004h> "]
[231.526803, "o", "        y = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[231.526835, "o", "\u001b[?2004h> "]
[231.526867, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.526899, "o", "> "]
