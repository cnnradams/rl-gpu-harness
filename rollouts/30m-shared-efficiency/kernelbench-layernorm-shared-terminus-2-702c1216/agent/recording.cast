[231.519645, "o", "    BLOCK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.5197, "o", "    VEC: tl.constexpr,\r\n\u001b[?2004l\r"]
[231.519733, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[231.519761, "o", "\u001b[?2004h> "]
[231.519812, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[231.519888, "o", "\u001b[?2004h>     c = pid // HW\r\n\u001b[?2004l\r"]
[231.519917, "o", "\u001b[?2004h> "]
[231.519954, "o", "    i = pid % HW\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.519981, "o", "> "]
[231.520028, "o", "    N: tl.constexpr = BLOCK * VEC\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.520064, "o", "> "]
[231.520091, "o", "    offs = tl.arange(0, N)\r\n\u001b[?2004l\r"]
[231.520128, "o", "\u001b[?2004h> "]
[231.520211, "o", "    mask = offs < N  # N is multiple of 4096 when full\r\n\u001b[?2004l\r"]
[231.520245, "o", "\u001b[?2004h> "]
[231.520302, "o", "    x_ptr = X + pid.to(tl.int64) * stride_xb\r\n\u001b[?2004l\r"]
[231.520338, "o", "\u001b[?2004h> "]
[231.520372, "o", "    w_ptr = W + i * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.520416, "o", "    b_ptr = B + i * N\r\n\u001b[?2004l\r"]
[231.52045, "o", "\u001b[?2004h> "]
[231.520504, "o", "    s = tl.zeros((N,), dtype=tl.float64)\r\n\u001b[?2004l\r"]
[231.520533, "o", "\u001b[?2004h> "]
[231.520594, "o", "    sq = tl.zeros((N,), dtype=tl.float64)\r\n\u001b[?2004l\r"]
[231.520621, "o", "\u001b[?2004h> "]
[231.520708, "o", "    # fixed number of iterations; guard tails with masks\r\n\u001b[?2004l\r"]
[231.520733, "o", "\u001b[?2004h> "]
[231.520798, "o", "    for k in range(0, tl.cdiv(65536, N)):\r\n\u001b[?2004l\r"]
[231.520832, "o", "\u001b[?2004h> "]
[231.520865, "o", "        o = k * N + offs\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.520898, "o", "> "]
[231.520925, "o", "        m = o < 65536\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.520959, "o", "> "]
[231.521044, "o", "        x = tl.load(x_ptr + o, mask=m, other=0.0).to(tl.float64)\r\n\u001b[?2004l\r"]
[231.521083, "o", "\u001b[?2004h> "]
[231.521186, "o", "        w = tl.load(w_ptr + o, mask=m, other=0.0).to(tl.float64)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.521301, "o", "        bb = tl.load(b_ptr + o, mask=m, other=0.0).to(tl.float64)\r\n\u001b[?2004l\r"]
[231.521329, "o", "\u001b[?2004h> "]
[231.521355, "o", "        y = x * w + bb\r\n\u001b[?2004l\r"]
[231.521388, "o", "\u001b[?2004h> "]
[231.521434, "o", "        s += tl.where(m, y, 0.0)\r\n\u001b[?2004l\r"]
[231.521466, "o", "\u001b[?2004h> "]
[231.52152, "o", "        sq += tl.where(m, y * y, 0.0)\r\n\u001b[?2004l\r"]
[231.521554, "o", "\u001b[?2004h> "]
[231.52165, "o", "    ps_ptr = PartialSum + c * stride_pm + i * stride_pb\r\n\u001b[?2004l\r"]
[231.521682, "o", "\u001b[?2004h> "]
[231.521759, "o", "    pq_ptr = PartialSq + c * stride_pm + i * stride_pb\r\n\u001b[?2004l\r"]
[231.521792, "o", "\u001b[?2004h> "]
[231.521863, "o", "    tl.store(ps_ptr + offs, tl.where(mask, s, 0.0))\r\n\u001b[?2004l\r"]
[231.521894, "o", "\u001b[?2004h> "]
[231.521969, "o", "    tl.store(pq_ptr + offs, tl.where(mask, sq, 0.0))\r\n\u001b[?2004l\r"]
[231.522001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[231.522033, "o", "\u001b[?2004h> "]
[231.522065, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.522106, "o", "def _ln_reduce_kernel(\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.522137, "o", "> "]
[231.522186, "o", "    PartialSum, PartialSq, Mean, Rstd,\r\n\u001b[?2004l\r"]
[231.522218, "o", "\u001b[?2004h> "]
[231.522247, "o", "    stride_pm, stride_pb,\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.522279, "o", "> "]
[231.52231, "o", "    HW: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.522355, "o", "    BLOCK: tl.constexpr,\r\n\u001b[?2004l\r"]
[231.522388, "o", "\u001b[?2004h>     eps,\r\n\u001b[?2004l\r"]
[231.522423, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.522449, "o", "> "]
[231.522477, "o", "    c = tl.program_id(0)\r\n\u001b[?2004l\r"]
[231.52251, "o", "\u001b[?2004h> "]
[231.522563, "o", "    acc = tl.zeros((HW,), dtype=tl.float64)\r\n\u001b[?2004l\r"]
[231.522596, "o", "\u001b[?2004h> "]
[231.522653, "o", "    acc2 = tl.zeros((HW,), dtype=tl.float64)\r\n\u001b[?2004l\r"]
[231.522686, "o", "\u001b[?2004h> "]
[231.522743, "o", "    for k in range(0, tl.cdiv(4096, BLOCK)):\r\n\u001b[?2004l\r"]
[231.522772, "o", "\u001b[?2004h> "]
[231.522835, "o", "        offs = k * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[231.522866, "o", "\u001b[?2004h> "]
[231.522899, "o", "        m = offs < 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.52293, "o", "> "]
[231.523011, "o", "        ps_ptr = PartialSum + c * stride_pm + offs * stride_pb\r\n\u001b[?2004l\r"]
[231.523038, "o", "\u001b[?2004h> "]
[231.523134, "o", "        pq_ptr = PartialSq + c * stride_pm + offs * stride_pb\r\n\u001b[?2004l\r"]
[231.523162, "o", "\u001b[?2004h> "]
[231.523227, "o", "        s = tl.load(ps_ptr, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[231.523259, "o", "\u001b[?2004h> "]
[231.523319, "o", "        q = tl.load(pq_ptr, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[231.523352, "o", "\u001b[?2004h> "]
[231.523385, "o", "        acc += s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.523417, "o", "        acc2 += q\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.523488, "o", "    total = tl.sum(acc, axis=0)\r\n\u001b[?2004l\r"]
[231.523523, "o", "\u001b[?2004h> "]
[231.523556, "o", "    total2 = tl.sum(acc2, axis=0)\r\n\u001b[?2004l\r"]
[231.523586, "o", "\u001b[?2004h> "]
[231.523626, "o", "    mean = total / 65536.0\r\n\u001b[?2004l\r"]
[231.523658, "o", "\u001b[?2004h> "]
[231.523712, "o", "    var = total2 / 65536.0 - mean * mean\r\n\u001b[?2004l\r"]
[231.523738, "o", "\u001b[?2004h> "]
[231.523789, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[231.52382, "o", "\u001b[?2004h> "]
[231.523882, "o", "    tl.store(Mean + c, mean.to(tl.float32))\r\n\u001b[?2004l\r"]
[231.523913, "o", "\u001b[?2004h> "]
[231.523974, "o", "    tl.store(Rstd + c, rstd.to(tl.float32))\r\n\u001b[?2004l\r"]
[231.524006, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
