[885.106334, "o", "{\r\n  \"bytes\": 3472,\r\n  \"sha256\": \"fe61ebd8a1aff86eefc091ed525e695c801180e5ea0dc72bbbe66681b0bbffc9\"\r\n}\r\n"]
[885.215879, "o", "request ID: a0d7600414724e149ec0daac9ec704ac\r\n"]
[887.369081, "o", "command: 237a19636cfd4dcfa1608a352a3571b5\r\n"]
[890.864599, "o", "stats2 cm=0 BLOCK=1024 VEC=4 nw=8: 0.2339 ms -> 2295 GB/s\r\nstats2 cm=0 BLOCK=2048 VEC=4 nw=16: 0.2022 ms -> 2655 GB/s\r\nstats2 cm=0 BLOCK=1024 VEC=2 nw=4: 0.1388 ms -> 3869 GB/s\r\nstats2 cm=0 BLOCK=2048 VEC=2 nw=8: 0.2329 ms -> 2305 GB/s\r\nstats2 cm=0 BLOCK=4096 VEC=4 nw=32: 0.8398 ms -> 639 GB/s\r\nstats2 cm=1 BLOCK=1024 VEC=4 nw=8: 0.2336 ms -> 2299 GB/s\r\nstats2 cm=1 BLOCK=2048 VEC=4 nw=16: 0.2029 ms -> 2646 GB/s\r\nstats2 cm=1 BLOCK=1024 VEC=2 nw=4: 0.1404 ms -> 3823 GB/s\r\nstats2 cm=1 BLOCK=2048 VEC=2 nw=8: 0.2361 ms -> 2274 GB/s\r\nstats2 cm=1 BLOCK=4096 VEC=4 nw=32: 0.7626 ms -> 704 GB/s\r\napply cm=0 BLOCK=2048 nw=8: 0.2040 ms -> 2632 GB/s\r\napply cm=0 BLOCK=4096 nw=16: 0.2044 ms -> 2626 GB/s\r\napply cm=0 BLOCK=8192 nw=32: 0.2037 ms -> 2635 GB/s\r\napply cm=1 BLOCK=2048 nw=8: 0.3163 ms -> 1697 GB/s\r\napply cm=1 BLOCK=4096 nw=16: 0.2962 ms -> 1813 GB/s\r\napply cm=1 BLOCK=8192 nw=32: 0.3063 ms -> 1753 GB/s\r\n"]
[891.664643, "o", "\u001b[?2004hroot@modal:/# "]
[957.27439, "i", "cat > /tmp/bench4.py << 'EOF'\nimport torch, sys, triton\nimport triton.language as tl\n\ndev = 'cuda'\nB, C, INNER = 16, 64, 65536\nx = torch.rand(B, C, 256, 256, device=dev)\nx2 = x.reshape(B * C, INNER)\nw = torch.rand(C, INNER, device=dev)\nbias = torch.rand(C, INNER, device=dev)\nps = torch.empty(4096, device=dev, dtype=torch.float64)\npq = torch.empty(4096, device=dev, dtype=torch.float64)\n\ndef timeit(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef _stats3(X, W, Bs, PS, PQ, INNER: tl.constexpr, SPL: tl.constexpr, BLOCK: tl.constexpr, VEC: tl.constexpr):\n    pid = tl.program_id(0)\n    slice_id = pid // SPL\n    sp = pid % SPL\n    ch = slice_id % 64\n    N: tl.constexpr = B"]
[957.274435, "i", "LOCK * VEC\n    CHUNK: tl.constexpr = INNER // SPL\n    offs = tl.arange(0, N)\n    x_ptr = X + slice_id.to(tl.int64) * INNER + sp * CHUNK\n    w_ptr = W + ch * INNER + sp * CHUNK\n    b_ptr = Bs + ch * INNER + sp * CHUNK\n    s = tl.zeros((N,), dtype=tl.float64)\n    sq = tl.zeros((N,), dtype=tl.float64)\n    for k in range(0, CHUNK // N):\n        o = k * N + offs\n        xx = tl.load(x_ptr + o).to(tl.float64)\n        ww = tl.load(w_ptr + o).to(tl.float64)\n        bb = tl.load(b_ptr + o).to(tl.float64)\n        yy = xx * ww + bb\n        s += yy\n        sq += yy * yy\n    tl.store(PS + pid, tl.sum(s, axis=0))\n    tl.store(PQ + pid, tl.sum(sq, axis=0))\n\nbest = None\nfor spl in [1, 2, 4]:\n    for blk, vec, nw in [(512,2,2),(1024,2,4),(512,4,4),(1024,1,2),(2048,2,8),(256,2,2),(512,2,4),(1024,2,8),(256,4,4),(512,8,8),(1024,4,8)]:\n        N = blk*vec\n        if (INNER//spl) % N: continue\n        try:\n            t = timeit(lambda: _stats3[(B*C*spl,)](x2, w, bias, ps, pq, INNER=INNER, SPL=spl, BLOCK=blk, VEC=vec, num_warps=nw"]
[957.274447, "i", "))\n            bw = 2*x.numel()*4/t*1e3/1e9\n            print(f\"stats3 spl={spl} BLOCK={blk} VEC={vec} nw={nw}: {t:.4f} ms -> {bw:.0f} GB/s\")\n            if best is None or t < best[0]: best = (t, spl, blk, vec, nw)\n        except Exception as ex:\n            print(f\"stats3 spl={spl} BLOCK={blk} VEC={vec} nw={nw}: FAIL {type(ex).__name__}\")\nprint(\"BEST:\", best)\nEOF\ngpu push sb-nOQVVTiSixJVaDLT5CZJ67 /tmp/bench4.py /root/bench4.py && gpu exec sb-nOQVVTiSixJVaDLT5CZJ67 -- python3 /root/bench4.py\n"]
[957.274612, "o", "cat > /tmp/bench4.py << 'EOF'"]
