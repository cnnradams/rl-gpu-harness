[231.519246, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.519287, "o", "def _ln_stats_kernel(\r\n\u001b[?2004l\r"]
[231.519319, "o", "\u001b[?2004h> "]
[231.519365, "o", "    X, W, B, PartialSum, PartialSq,\r\n\u001b[?2004l\r"]
[231.519398, "o", "\u001b[?2004h> "]
[231.519526, "o", "    stride_xb, stride_pm, stride_pb,\r\n\u001b[?2004l\r\u001b[?2004h> "]
