[570.715495, "i", "(e)/100:.4f} ms\")\n\nmed, mn = timeit(lambda: ln(x))\nprint(f\"nn.LayerNorm fwd per-call: med={med:.4f} min={mn:.4f} ms\")\n\nmed, mn = timeit(lambda: torch.var_mean(x, dim=(-1,-2,-3), keepdim=True))\nprint(f\"var_mean per-call: med={med:.4f} min={mn:.4f} ms\")\n\nmed, mn = timeit(lambda: torch.empty(16,64,256,256, device=dev))\nprint(f\"empty alloc per-call: med={med:.4f} min={mn:.4f} ms\")\n\nwith torch.no_grad():\n    med, mn = timeit(lambda: m(x))\n    print(f\"ModelNew no_grad per-call: med={med:.4f} min={mn:.4f} ms\")\nEOF\ngpu exec sb-nOQVVTiSixJVaDLT5CZJ67 -- python3 /tmp/prof.py\n"]
