[718.744936, "i", "cat > /tmp/bench.py << 'EOF'\nimport torch, sys, triton\nimport triton.language as tl\nsys.path.insert(0, '/root')\nimport solution as sol\n\ndev = 'cuda'\nB, C, INNER = 16, 64, 65536\nS = C * INNER\nx = torch.rand(B, C, 256, 256, device=dev)\nx2 = x.reshape(B * C, INNER)\nw = torch.rand(C, INNER, device=dev)\nbias = torch.rand(C, INNER, device=dev)\nps = torch.empty(B, C, 4096, device=dev, dtype=torch.float64)\npq = torch.empty(B, C, 4096, device=dev, dtype=torch.float64)\nmean = torch.empty(B, device=dev)\nrstd = torch.empty(B, device=dev)\ny = torch.empty(B * C, INNER, device=dev)\n\ndef timeit(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nt = timeit(lambda: sol._ln_stats_kernel[(B*C,)](x2, w, "]
[718.745061, "i", "bias, ps, pq, ps.stride(0), ps.stride(1), C=C, INNER=INNER, BLOCK=1024, VEC=4, num_warps=8))\nprint(f\"stats fp64: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\n\nt = timeit(lambda: sol._ln_reduce_kernel[(B,)](ps, pq, mean, rstd, ps.stride(0), ps.stride(1), 1e-5, C=C, S=S, BLOCK=4096, num_warps=32))\nprint(f\"reduce: {t:.4f} ms\")\n\nt = timeit(lambda: sol._ln_apply_kernel[(B*S//4096,)](x2, w, bias, mean, rstd, y, C=C, INNER=INNER, S=S, BLOCK=4096, num_warps=16))\nprint(f\"apply: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\n\nt = timeit(lambda: torch.var_mean(x, dim=(-1,-2,-3), keepdim=True))\nprint(f\"var_mean: {t:.4f} ms\")\n\n# try apply with different configs\nfor blk, nw in [(2048, 8), (4096, 8), (4096, 32), (8192, 16), (8192, 32), (1024, 4)]:\n    t = timeit(lambda: sol._ln_apply_kernel[(B*S//blk,)](x2, w, bias, mean, rstd, y, C=C, INNER=INNER, S=S, BLOCK=blk, num_warps=nw))\n    print(f\"apply BLOCK={blk} nw={nw}: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\nEOF\ngpu push sb-nOQVVTiSixJVaDLT5CZJ67 /tmp/ben"]
