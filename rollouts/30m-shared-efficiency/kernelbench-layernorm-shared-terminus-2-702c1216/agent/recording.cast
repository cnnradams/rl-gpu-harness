[788.314694, "i", "cat > /tmp/bench2.py << 'EOF'\nimport torch, sys, triton\nimport triton.language as tl\n\ndev = 'cuda'\nB, C, INNER = 16, 64, 65536\nS = C * INNER\nx = torch.rand(B, C, 256, 256, device=dev)\nx2 = x.reshape(B * C, INNER)\nw = torch.rand(C, INNER, device=dev)\nbias = torch.rand(C, INNER, device=dev)\nmean = torch.rand(B, device=dev)\nrstd = torch.rand(B, device=dev)\ny = torch.empty(B * C, INNER, device=dev)\ny4 = torch.empty(B, C, 256, 256, device=dev)\n\ndef timeit(fn, n=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef _copy_kernel(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\nf"]
[788.314739, "i", "or blk, nw in [(1024, 4), (2048, 8), (4096, 16), (8192, 32)]:\n    t = timeit(lambda: _copy_kernel[(B*S//blk,)](x2, y, BLOCK=blk, num_warps=nw))\n    print(f\"copy BLOCK={blk} nw={nw}: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\n\n@triton.jit\ndef _apply_now(X, Mean, Rstd, Y, S: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    base = pid * BLOCK\n    b = base // S\n    offs = base + tl.arange(0, BLOCK)\n    xx = tl.load(X + offs)\n    m = tl.load(Mean + b)\n    r = tl.load(Rstd + b)\n    tl.store(Y + offs, (xx - m) * r)\n\nt = timeit(lambda: _apply_now[(B*S//4096,)](x2, mean, rstd, y, S=S, BLOCK=4096, num_warps=16))\nprint(f\"apply-noW: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\n\n@triton.jit\ndef _apply_wb(X, W, Bs, Mean, Rstd, Y, S: tl.constexpr, INNER: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    base = pid * BLOCK\n    b = base // S\n    j = base % INNER\n    offs = base + tl.arange(0, BLOCK)\n    offsj = j + tl.arange(0, BLOCK)\n    xx = tl.load("]
[788.314746, "i", "X + offs)\n    ww = tl.load(W + offsj)\n    bb = tl.load(Bs + offsj)\n    m = tl.load(Mean + b)\n    r = tl.load(Rstd + b)\n    tl.store(Y + offs, (xx * ww + bb - m) * r)\n\nt = timeit(lambda: _apply_wb[(B*S//4096,)](x2, w, bias, mean, rstd, y, S=S, INNER=INNER, BLOCK=4096, num_warps=16))\nprint(f\"apply-wb-simplified: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\n\n# 4D tensor variant, contiguous identical layout\n@triton.jit\ndef _apply4(X, W, Bs, Mean, Rstd, Y, S: tl.constexpr, INNER: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0).to(tl.int64)\n    base = pid * BLOCK\n    b = base // S\n    j = base % INNER\n    offs = base + tl.arange(0, BLOCK)\n    offsj = j + tl.arange(0, BLOCK)\n    xx = tl.load(X + offs)\n    ww = tl.load(W + offsj)\n    bb = tl.load(Bs + offsj)\n    m = tl.load(Mean + b)\n    r = tl.load(Rstd + b)\n    tl.store(Y + offs, (xx * ww + bb - m) * r)\n\nt = timeit(lambda: _apply4[(B*S//4096,)](x, w, bias, mean, rstd, y4, S=S, INNER=INNER, BLOCK=4096, num_warps=16))\nprint(f\"apply4d: {t:.4f} ms "]
[788.314879, "i", "-> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\nEOF\ngpu push sb-nOQVVTiSixJVaDLT5CZJ67 /tmp/bench2.py /root/bench2.py && gpu exec sb-nOQVVTiSixJVaDLT5CZJ67 -- python3 /root/bench2.py\n"]
