[883.064629, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[883.064653, "o", "\u001b[?2004h> "]
[883.064676, "o", "        fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.064689, "o", "> "]
[883.064734, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[883.064752, "o", "\u001b[?2004h> "]
[883.064775, "o", "    ts = []\r\n\u001b[?2004l\r"]
[883.064788, "o", "\u001b[?2004h> "]
[883.06483, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[883.064848, "o", "\u001b[?2004h> "]
[883.064902, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[883.064922, "o", "\u001b[?2004h> "]
[883.065071, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.065092, "o", "> "]
[883.065144, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[883.065167, "o", "\u001b[?2004h> "]
[883.065216, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[883.065232, "o", "\u001b[?2004h> "]
[883.065294, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[883.065316, "o", "\u001b[?2004h> "]
[883.065345, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[883.065359, "o", "\u001b[?2004h> "]
[883.065405, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[883.065421, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[883.065439, "o", "\u001b[?2004h> "]
[883.065464, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[883.06548, "o", "\u001b[?2004h> "]
[883.065657, "o", "def _stats2(X, W, Bs, PS, PQ, INNER: tl.constexpr, BLOCK: tl.constexpr, VEC: tl.constexpr, CM: tl.constexpr):\r\n\u001b[?2004l\r"]
[883.065678, "o", "\u001b[?2004h> "]
[883.065718, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[883.065734, "o", "\u001b[?2004h> "]
[883.065765, "o", "    ch = pid % 64\r\n\u001b[?2004l\r"]
[883.065783, "o", "\u001b[?2004h> "]
[883.065838, "o", "    N: tl.constexpr = BLOCK * VEC\r\n\u001b[?2004l\r"]
[883.065854, "o", "\u001b[?2004h> "]
[883.0659, "o", "    offs = tl.arange(0, N)\r\n\u001b[?2004l\r"]
[883.065921, "o", "\u001b[?2004h> "]
[883.065984, "o", "    x_ptr = X + pid.to(tl.int64) * INNER\r\n\u001b[?2004l\r"]
[883.066005, "o", "\u001b[?2004h> "]
[883.066046, "o", "    w_ptr = W + ch * INNER\r\n\u001b[?2004l\r"]
[883.06606, "o", "\u001b[?2004h> "]
[883.06611, "o", "    b_ptr = Bs + ch * INNER\r\n\u001b[?2004l\r"]
[883.066125, "o", "\u001b[?2004h> "]
[883.066194, "o", "    s = tl.zeros((N,), dtype=tl.float64)\r\n\u001b[?2004l\r"]
[883.066215, "o", "\u001b[?2004h> "]
[883.06628, "o", "    sq = tl.zeros((N,), dtype=tl.float64)\r\n\u001b[?2004l\r"]
[883.066296, "o", "\u001b[?2004h> "]
[883.066358, "o", "    for k in range(0, INNER // N):\r\n\u001b[?2004l\r"]
[883.066379, "o", "\u001b[?2004h> "]
[883.066417, "o", "        o = k * N + offs\r\n\u001b[?2004l\r"]
[883.066439, "o", "\u001b[?2004h> "]
[883.066468, "o", "        if CM == 1:\r\n\u001b[?2004l\r"]
[883.066484, "o", "\u001b[?2004h> "]
[883.066602, "o", "            xx = tl.load(x_ptr + o, cache_modifier='.cg').to(tl.float64)\r\n\u001b[?2004l\r"]
[883.066616, "o", "\u001b[?2004h> "]
[883.066736, "o", "            ww = tl.load(w_ptr + o, cache_modifier='.cg').to(tl.float64)\r\n\u001b[?2004l\r"]
[883.066756, "o", "\u001b[?2004h> "]
[883.06687, "o", "            bb = tl.load(b_ptr + o, cache_modifier='.cg').to(tl.float64)\r\n\u001b[?2004l\r"]
[883.066888, "o", "\u001b[?2004h> "]
[883.066914, "o", "        else:\r\n\u001b[?2004l\r"]
[883.066933, "o", "\u001b[?2004h> "]
[883.067012, "o", "            xx = tl.load(x_ptr + o).to(tl.float64)\r\n\u001b[?2004l\r"]
[883.067032, "o", "\u001b[?2004h> "]
[883.067112, "o", "            ww = tl.load(w_ptr + o).to(tl.float64)\r\n\u001b[?2004l\r"]
[883.067132, "o", "\u001b[?2004h> "]
[883.067212, "o", "            bb = tl.load(b_ptr + o).to(tl.float64)\r\n\u001b[?2004l\r"]
[883.067232, "o", "\u001b[?2004h> "]
[883.067272, "o", "        yy = xx * ww + bb\r\n\u001b[?2004l\r"]
[883.067292, "o", "\u001b[?2004h> "]
[883.067317, "o", "        s += yy\r\n\u001b[?2004l\r"]
[883.067334, "o", "\u001b[?2004h> "]
[883.067374, "o", "        sq += yy * yy\r\n\u001b[?2004l\r"]
[883.067397, "o", "\u001b[?2004h> "]
[883.067471, "o", "    tl.store(PS + pid, tl.sum(s, axis=0))\r\n\u001b[?2004l\r"]
[883.067481, "o", "\u001b[?2004h> "]
[883.067556, "o", "    tl.store(PQ + pid, tl.sum(sq, axis=0))\r\n\u001b[?2004l\r"]
[883.06757, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[883.067591, "o", "\u001b[?2004h> "]
[883.067619, "o", "for cm in [0, 1]:\r\n\u001b[?2004l\r"]
[883.067638, "o", "\u001b[?2004h> "]
[883.067791, "o", "    for blk, vec, nw in [(1024, 4, 8), (2048, 4, 16), (1024, 2, 4), (2048, 2, 8), (4096, 4, 32)]:\r\n\u001b[?2004l\r"]
[883.067811, "o", "\u001b[?2004h> "]
[883.067832, "o", "        try:\r\n\u001b[?2004l\r"]
[883.067845, "o", "\u001b[?2004h> "]
[883.068046, "o", "            t = timeit(lambda: _stats2[(B*C,)](x2, w, bias, ps, pq, INNER=INNER, BLOCK=blk, VEC=vec, CM=cm, num_warps=nw))\r\n\u001b[?2004l\r"]
[883.068068, "o", "\u001b[?2004h> "]
[883.068249, "o", "            print(f\"stats2 cm={cm} BLOCK={blk} VEC={vec} nw={nw}: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\r\n\u001b[?2004l\r"]
[883.068262, "o", "\u001b[?2004h"]
[883.068278, "o", "> "]
[883.068321, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[883.068341, "o", "\u001b[?2004h> "]
[883.06847, "o", "            print(f\"stats2 cm={cm} BLOCK={blk} VEC={vec} nw={nw}: FAIL {ex}\")\r\n\u001b[?2004l\r"]
[883.068484, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[883.0685, "o", "\u001b[?2004h> "]
[883.068522, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[883.068537, "o", "\u001b[?2004h> "]
[883.068724, "o", "def _apply_cs(X, W, Bs, Mean, Rstd, Y, S: tl.constexpr, INNER: tl.constexpr, BLOCK: tl.constexpr, CM: tl.constexpr):\r\n\u001b[?2004l\r"]
[883.06874, "o", "\u001b[?2004h> "]
[883.068806, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[883.068821, "o", "\u001b[?2004h> "]
[883.068861, "o", "    base = pid * BLOCK\r\n\u001b[?2004l\r"]
[883.068874, "o", "\u001b[?2004h> "]
[883.068909, "o", "    b = base // S\r\n\u001b[?2004l\r"]
[883.068929, "o", "\u001b[?2004h> "]
[883.068962, "o", "    j = base % INNER\r\n\u001b[?2004l\r"]
[883.06898, "o", "\u001b[?2004h> "]
[883.06904, "o", "    offs = base + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[883.069056, "o", "\u001b[?2004h> "]
[883.069116, "o", "    offsj = j + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[883.069136, "o", "\u001b[?2004h> "]
[883.069161, "o", "    if CM == 1:\r\n\u001b[?2004l\r"]
[883.069181, "o", "\u001b[?2004h> "]
[883.069263, "o", "        xx = tl.load(X + offs, cache_modifier='.cg')\r\n\u001b[?2004l\r"]
[883.069283, "o", "\u001b[?2004h> "]
[883.069372, "o", "        ww = tl.load(W + offsj, cache_modifier='.cg')\r\n\u001b[?2004l\r"]
[883.069392, "o", "\u001b[?2004h> "]
[883.069478, "o", "        bb = tl.load(Bs + offsj, cache_modifier='.cg')\r\n\u001b[?2004l\r"]
[883.069491, "o", "\u001b[?2004h> "]
[883.069508, "o", "    else:\r\n\u001b[?2004l\r"]
[883.069524, "o", "\u001b[?2004h"]
[883.069537, "o", "> "]
[883.069586, "o", "        xx = tl.load(X + offs)\r\n\u001b[?2004l\r"]
[883.069605, "o", "\u001b[?2004h> "]
[883.069656, "o", "        ww = tl.load(W + offsj)\r\n\u001b[?2004l\r"]
[883.069676, "o", "\u001b[?2004h> "]
[883.069727, "o", "        bb = tl.load(Bs + offsj)\r\n\u001b[?2004l\r"]
[883.069748, "o", "\u001b[?2004h> "]
[883.069787, "o", "    m = tl.load(Mean + b)\r\n\u001b[?2004l\r"]
[883.069807, "o", "\u001b[?2004h> "]
[883.069847, "o", "    r = tl.load(Rstd + b)\r\n\u001b[?2004l\r"]
[883.069866, "o", "\u001b[?2004h> "]
[883.069918, "o", "    res = (xx * ww + bb - m) * r\r\n\u001b[?2004l\r"]
[883.069938, "o", "\u001b[?2004h> "]
[883.069963, "o", "    if CM == 1:\r\n\u001b[?2004l\r"]
[883.069983, "o", "\u001b[?2004h> "]
[883.070066, "o", "        tl.store(Y + offs, res, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[883.070082, "o", "\u001b[?2004h> "]
[883.070102, "o", "    else:\r\n\u001b[?2004l\r"]
[883.070125, "o", "\u001b[?2004h> "]
[883.070168, "o", "        tl.store(Y + offs, res)\r\n\u001b[?2004l\r"]
[883.070188, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[883.070201, "o", "> "]
[883.07023, "o", "for cm in [0, 1]:\r\n\u001b[?2004l\r"]
[883.070251, "o", "\u001b[?2004h> "]
[883.070342, "o", "    for blk, nw in [(2048, 8), (4096, 16), (8192, 32)]:\r\n\u001b[?2004l\r"]
[883.070362, "o", "\u001b[?2004h> "]
[883.070564, "o", "        t = timeit(lambda: _apply_cs[(B*S//blk,)](x2, w, bias, mean, rstd, y, S=S, INNER=INNER, BLOCK=blk, CM=cm, num_warps=nw))\r\n\u001b[?2004l\r"]
[883.070574, "o", "\u001b[?2004h> "]
[883.070758, "o", "        print(f\"apply cm={cm} BLOCK={blk} nw={nw}: {t:.4f} ms -> {2*x.numel()*4/t*1e3/1e9:.0f} GB/s\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[883.07078, "o", "EOF\r\n\u001b[?2004l\r"]
[883.071915, "o", "\u001b[?2004hroot@modal:/# "]
