[231.524063, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.524109, "o", "def _ln_apply_kernel(\r\n\u001b[?2004l\r"]
[231.52414, "o", "\u001b[?2004h> "]
[231.524167, "o", "    X, W, B, Mean, Rstd, Y,\r\n\u001b[?2004l\r"]
[231.524194, "o", "\u001b[?2004h> "]
[231.52424, "o", "    stride_x, HW: tl.constexpr,\r\n\u001b[?2004l\r"]
[231.524272, "o", "\u001b[?2004h> "]
[231.524305, "o", "    BLOCK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.524333, "o", "> ):\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.524359, "o", "> "]
[231.524415, "o", "    pid = tl.program_id(0).to(tl.int64)\r\n\u001b[?2004l\r"]
[231.524447, "o", "\u001b[?2004h> "]
[231.524479, "o", "    n = HW * 65536\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.524521, "o", "    base = pid * BLOCK\r\n\u001b[?2004l\r"]
[231.524553, "o", "\u001b[?2004h> "]
[231.524585, "o", "    c = base // n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.524616, "o", "    r = base % n\r\n\u001b[?2004l\r"]
[231.524647, "o", "\u001b[?2004h> "]
[231.524679, "o", "    i = r // 65536\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.524711, "o", ">     j = r % 65536\r\n\u001b[?2004l\r"]
[231.52474, "o", "\u001b[?2004h> "]
[231.5248, "o", "    offs = base + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.524832, "o", "> "]
[231.524864, "o", "    x = tl.load(X + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.524966, "o", "    w = tl.load(W + i * 65536 + j + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[231.524999, "o", "\u001b[?2004h> "]
[231.525077, "o", "    b = tl.load(B + i * 65536 + j + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[231.525109, "o", "\u001b[?2004h> "]
[231.525141, "o", "    mean = tl.load(Mean + c)\r\n\u001b[?2004l\r"]
[231.525173, "o", "\u001b[?2004h> "]
[231.525204, "o", "    rstd = tl.load(Rstd + c)\r\n\u001b[?2004l\r"]
[231.525231, "o", "\u001b[?2004h> "]
[231.525259, "o", "    y = x * w + b\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.525308, "o", "    y = (y - mean) * rstd\r\n\u001b[?2004l\r"]
[231.525335, "o", "\u001b[?2004h> "]
[231.525368, "o", "    tl.store(Y + offs, y)\r\n\u001b[?2004l\r"]
[231.525399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[231.52543, "o", "\u001b[?2004h> "]
[231.525467, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[231.525496, "o", "\u001b[?2004h> "]
