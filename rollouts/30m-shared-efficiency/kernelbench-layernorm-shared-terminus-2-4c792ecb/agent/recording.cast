[1094.256173, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r\u001b[?2004h>         s += v\r\n\u001b[?2004l\r\u001b[?2004h>         s2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(ws_ptr + pid, tl.sum(s))\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(ws2_ptr + pid, tl.sum(s2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def ln_apply_fused(x_ptr, y_ptr, w_ptr, b_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr, BS: tl.constexpr): \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K:\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2"]
[1094.256203, "o", "004l\r\u001b[?2004h>     row = pid // SPS\r\n\u001b[?2004l\r\u001b[?2004h>     seg = pid % SPS\r\n\u001b[?2004l\r\u001b[?2004h>     col0 = seg * SEG\r\n\u001b[?2004l\r\u001b[?2004h>     base = row.to(tl.int64) * N + col0\r\n\u001b[?2004l\r\u001b[?2004h>     o = row * SPS + tl.arange(0, BS)\r\n\u001b[?2004l\r\u001b[?2004h>     msk = tl.arange(0, BS) < SPS\r\n\u001b[?2004l\r\u001b[?2004h>     s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\r\n\u001b[?2004l\r\u001b[?2004h>     s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\r\n\u001b[?2004l\r\u001b[?2004h>     mean = s / N\r\n\u001b[?2004l\r\u001b[?2004h>     var = s2 / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h>     rstd = 1.0 / tl.sqrt(var + EPS)\r\n\u001b[?2004l\r\u001b[?2004h>     for off in range(0, SEG, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h>         oo = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h>         v = tl.load(x_ptr + base + oo)\r\n\u001b[?2004l\r\u001b[?2004h>         ww = tl.load(w_ptr + col0 + oo)\r\n\u001b[?2004l\r\u001b[?2004h>         bb = tl.load(b_ptr + col0 + oo)\r\n\u001b[?2004l\r\u001b[?2004h>         tl.store(y_ptr + base + oo, (v - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?200"]
[1094.256215, "o", "4h> class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r\u001b[?2004h>         super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h>         self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h>         self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h>         self._N = 1\r\n\u001b[?2004l\r\u001b[?2004h>         for d in self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h>             self._N *= d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h>         if not x.is_contiguous():\r\n\u001b[?2004l\r\u001b[?2004h>             x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h>         N = self._N\r\n\u001b[?2004l\r\u001b[?2004h>         lead = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h>         xf = x.view(lead, N)\r\n\u001b[?2004l\r\u001b[?2004h>         w = self.ln.weight\r\n\u001b[?2004l\r\u001b[?2004h>         b = self.ln.bias\r\n\u001b[?2004l\r\u001b[?2004h>         SEG = 262144\r\n\u001b[?2004l\r\u001b[?2004h>         if N % SEG != 0:\r\n\u001b[?2004l\r\u001b[?2004h>             "]
[1094.256372, "o", "return self.ln(x)\r\n\u001b[?2004l\r\u001b[?2004h>         SPS = N // SEG\r\n\u001b[?2004l\r\u001b[?2004h>         nblk = lead * SPS\r\n\u001b[?2004l\r\u001b[?2004h>         BLOCK = 2048\r\n\u001b[?2004l\r\u001b[?2004h>         dev = x.device\r\n\u001b[?2004l\r\u001b[?2004h>         ws = torch.empty(nblk, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         ws2 = torch.empty(nblk, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h>         out = torch.empty_like(xf)\r\n\u001b[?2004l\r\u001b[?2004h>         ln_partial[(nblk,)](xf, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h>         BS = 1\r\n\u001b[?2004l\r\u001b[?2004h>         while BS < SPS:\r\n\u001b[?2004l\r\u001b[?2004h>             BS *= 2\r\n\u001b[?2004l\r\u001b[?2004h>         ln_apply_fused[(nblk,)](xf, out, w, b, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, BS=BS, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h>         return out.view_as(x)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
