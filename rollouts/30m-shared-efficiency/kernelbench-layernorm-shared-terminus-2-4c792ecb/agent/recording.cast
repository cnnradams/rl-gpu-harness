[883.213368, "o", "\u001b[?2004h> "]
[883.213408, "o", "    const float* bp = b.data_ptr<float>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.213436, "o", "> "]
[883.213476, "o", "    float* wsp = ws.data_ptr<float>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.213506, "o", "> "]
[883.213542, "o", "    float* ws2p = ws2.data_ptr<float>();\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.213572, "o", "> "]
[883.213602, "o", "    float* mrp = mr.data_ptr<float>();\r\n\u001b[?2004l\r"]
[883.21363, "o", "\u001b[?2004h> "]
[883.213655, "o", "    int SPS = G;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[883.213819, "o", "    void* args[] = {(void*)&xp,(void*)&yp,(void*)&wp,(void*)&bp,(void*)&wsp,(void*)&ws2p,(void*)&mrp,(void*)&N,(void*)&G,(void*)&SPS};\r\n\u001b[?2004l\r"]
[883.213852, "o", "\u001b[?2004h> "]
[883.213882, "o", "    dim3 grid(M*G), block(nthreads);\r\n\u001b[?2004l\r"]
[883.213905, "o", "\u001b[?2004h> "]
[883.213985, "o", "    cudaLaunchCooperativeKernel((void*)coop_ln, grid, block, args, 0, 0);\r\n\u001b[?2004l\r"]
[883.21401, "o", "\u001b[?2004h> "]
[883.214036, "o", "    return y;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[883.214064, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[883.214094, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[883.21418, "o", "mod = load_inline(name='coop_ln_ext', cpp_sources='', cuda_sources=src,\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.214211, "o", "> "]
[883.214261, "o", "                  functions=['coop_ln_run'], verbose=False,\r\n\u001b[?2004l\r"]
[883.214287, "o", "\u001b[?2004h> "]
[883.214365, "o", "                  extra_cuda_cflags=['-O3','--use_fast_math','-arch=sm_90'])\r\n\u001b[?2004l\r"]
[883.21439, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[883.21442, "o", "\u001b[?2004h> "]
[883.214443, "o", "for G in [8, 16]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[883.214478, "o", "    for nt in [512, 1024]:\r\n\u001b[?2004l\r"]
[883.214503, "o", "\u001b[?2004h> "]
[883.21453, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[883.214592, "o", "            out = mod.coop_ln_run(xf, w, b, G, nt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.214615, "o", "> "]
[883.214653, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[883.214678, "o", "\u001b[?2004h> "]
[883.214743, "o", "            ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[883.214774, "o", "\u001b[?2004h> "]
[883.214935, "o", "            ts = time_execution_with_cuda_event(lambda a: mod.coop_ln_run(a, w, b, G, nt), [xf], num_warmup=3, num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[883.214967, "o", "\u001b[?2004h> "]
[883.215074, "o", "            print(f\"coop G={G} nt={nt}: mean {np.mean(ts):.4f} min {np.min(ts):.4f} ok={ok}\", flush=True)\r\n\u001b[?2004l\r"]
[883.215105, "o", "\u001b[?2004h> "]
[883.215134, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[883.215163, "o", "> "]
[883.215234, "o", "            print(f\"coop G={G} nt={nt}: FAIL {type(e).__name__} {e}\", flush=True)\r\n\u001b[?2004l\r"]
[883.215262, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
