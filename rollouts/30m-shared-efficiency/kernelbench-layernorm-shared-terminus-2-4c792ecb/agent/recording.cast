[736.02812, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, torch.nn as nn, numpy as np, triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\ndev = torch.device('cuda:0')\nM, N = 16, 64*256*256\nEPS = tl.constexpr(1e-5)\nx = torch.rand(M, 64, 256, 256, device=dev)\nln = nn.LayerNorm((64,256,256)).to(dev)\nxf = x.view(M, N)\nw = ln.weight.detach().contiguous()\nb = ln.bias.detach().contiguous()\nref = ln(x).view(M, N)\n\ndef timeit(fn, args, trials=30):\n    ts = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=trials, verbose=False, device=dev)\n    return float(np.mean(ts)), float(np.min(ts))\n\n@triton.jit\ndef ln_partial(x_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    base = row.to(tl.int64) * N + seg * SEG\n    s = tl.zeros([BLOCK], tl.float32)\n    s2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(0, SEG, BLOCK):\n        if EV:\n "]
[736.028301, "i", "           v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        s += v\n        s2 += v * v\n    tl.store(ws_ptr + pid, tl.sum(s))\n    tl.store(ws2_ptr + pid, tl.sum(s2))\n\n@triton.jit\ndef ln_stats(ws_ptr, ws2_ptr, mr_ptr, SPS: tl.constexpr, N: tl.constexpr, BS: tl.constexpr):\n    row = tl.program_id(0)\n    o = row * SPS + tl.arange(0, BS)\n    msk = tl.arange(0, BS) < SPS\n    s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\n    s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\n    mean = s / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    tl.store(mr_ptr + row * 2, mean)\n    tl.store(mr_ptr + row * 2 + 1, rstd)\n\n@triton.jit\ndef ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, mr_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    col0 = seg * SEG\n    base"]
[736.028354, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.028401, "i", " = row.to(tl.int64) * N + col0\n    mean = tl.load(mr_ptr + row * 2)\n    rstd = tl.load(mr_ptr + row * 2 + 1)\n    for off in range(0, SEG, BLOCK):\n        o = off + tl.arange(0, BLOCK)\n        if EV:\n            v = tl.load(x_ptr + base + o, eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + o)\n        ww = tl.load(w_ptr + col0 + o)\n        bb = tl.load(b_ptr + col0 + o)\n        tl.store(y_ptr + base + o, (v - mean) * rstd * ww + bb)\n\ndef run_split(inp, SEG, BLOCK, nw, EV):\n    SPS = N // SEG\n    nblk = M * SPS\n    ws = torch.empty(nblk, device=inp.device, dtype=torch.float32)\n    ws2 = torch.empty(nblk, device=inp.device, dtype=torch.float32)\n    mr = torch.empty(M*2, device=inp.device, dtype=torch.float32)\n    out = torch.empty_like(inp)\n    ln_partial[(nblk,)](inp, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, EV=EV, num_warps=nw)\n    BS = 1\n    while BS < SPS: BS *= 2\n    ln_stats[(M,)](ws, ws2, mr, SPS=SPS, N=N, BS=BS)\n    ln_apply[(nblk,)](inp, out, w, b, mr, N=N, SEG=SEG,"]
[736.028426, "o", "import torch, torch.nn as nn, numpy as np, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.02845, "i", " SPS=SPS, BLOCK=BLOCK, EV=EV, num_warps=nw)\n    return out\n\nbest = None\nfor SEG in [131072, 262144, 524288]:\n    for BLOCK in [1024, 2048, 4096]:\n        if BLOCK > SEG: continue\n        for nw in [4, 8, 16]:\n            for EV in [False, True]:\n                try:\n                    out = run_split(xf, SEG, BLOCK, nw, EV)\n                    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n                    m, mn = timeit(lambda a: run_split(a, SEG, BLOCK, nw, EV), [xf], trials=20)\n                    tag = f\"SEG={SEG} BLOCK={BLOCK} nw={nw} EV={EV}\"\n                    print(f\"{tag}: mean {m:.4f} min {mn:.4f} ok={ok}\", flush=True)\n                    if ok and (best is None or m < best[0]): best = (m, tag)\n                except Exception as e:\n                    print(f\"SEG={SEG} BLOCK={BLOCK} nw={nw} EV={EV}: FAIL {type(e).__name__}\", flush=True)\nprint(\"BEST:\", best, flush=True)\nEOF\nbase64 -w0 /workspace/bench2.py > /workspace/bench2.b64\n"]
