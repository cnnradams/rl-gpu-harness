[1025.04723, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, torch.nn as nn, numpy as np, triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\ndev = torch.device('cuda:0')\nM, N = 16, 64*256*256\nEPS = tl.constexpr(1e-5)\nx = torch.rand(M, 64, 256, 256, device=dev)\nln = nn.LayerNorm((64,256,256)).to(dev)\nxf = x.view(M, N)\nw = ln.weight.detach().contiguous()\nb = ln.bias.detach().contiguous()\nref = ln(x).view(M, N)\n\ndef timeit(fn, args, trials=30):\n    ts = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=trials, verbose=False, device=dev)\n    return float(np.mean(ts)), float(np.min(ts))\n\n# 2-kernel: partial kernel; fused apply kernel that recomputes stats from partials inline\n@triton.jit\ndef ln_partial(x_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    base = row.to(tl.int64) * N + seg * SEG\n    s = tl.zeros([BLOCK], tl.float32)\n    s2 = tl.zeros([B"]
[1025.047287, "i", "LOCK], tl.float32)\n    for off in range(0, SEG, BLOCK):\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        s += v\n        s2 += v * v\n    tl.store(ws_ptr + pid, tl.sum(s))\n    tl.store(ws2_ptr + pid, tl.sum(s2))\n\n@triton.jit\ndef ln_apply_fused(x_ptr, y_ptr, w_ptr, b_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr, BS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    col0 = seg * SEG\n    base = row.to(tl.int64) * N + col0\n    o = row * SPS + tl.arange(0, BS)\n    msk = tl.arange(0, BS) < SPS\n    s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\n    s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\n    mean = s / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    for off in range(0, SEG, BLOCK):\n        oo = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + oo)\n        ww = tl.load(w_ptr + col0 + oo)\n        bb = tl.load(b_ptr + col0 + oo)\n        tl.store(y_ptr + bas"]
[1025.04731, "i", "e + oo, (v - mean) * rstd * ww + bb)\n\ndef run2(inp, SEG, BLOCK, nw):\n    SPS = N // SEG\n    nblk = M * SPS\n    ws = torch.empty(nblk, device=inp.device, dtype=torch.float32)\n    ws2 = torch.empty(nblk, device=inp.device, dtype=torch.float32)\n    out = torch.empty_like(inp)\n    ln_partial[(nblk,)](inp, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=nw)\n    BS = 1\n    while BS < SPS: BS *= 2\n    ln_apply_fused[(nblk,)](inp, out, w, b, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, BS=BS, num_warps=nw)\n    return out\n\nfor SEG, BLOCK, nw in [(262144,2048,16),(262144,2048,8),(262144,4096,16),(524288,2048,16),(131072,2048,8),(131072,2048,16)]:\n    try:\n        out = run2(xf, SEG, BLOCK, nw)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        m, mn = timeit(lambda a: run2(a, SEG, BLOCK, nw), [xf], trials=25)\n        print(f\"2k SEG={SEG} BLOCK={BLOCK} nw={nw}: mean {m:.4f} min {mn:.4f} ok={ok}\", flush=True)\n    except Exception as e:\n        print(f\"2k SEG={SEG} BLOCK={BLOCK} nw={nw}: FAIL {type"]
[1025.047463, "i", "(e).__name__} {e}\", flush=True)\nEOF\nbase64 -w0 /workspace/bench3.py > /workspace/bench3.b64\n"]
