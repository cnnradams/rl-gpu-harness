[1025.049521, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.049709, "o", "def ln_apply_fused(x_ptr, y_ptr, w_ptr, b_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr, BS: tl.constexpr): \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K:\r\n\u001b[?2004l\r"]
[1025.049757, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1025.049848, "o", "\u001b[?2004h>     row = pid // SPS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.049902, "o", "    seg = pid % SPS\r\n\u001b[?2004l\r\u001b[?2004h>     col0 = seg * SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.049939, "o", "> "]
[1025.049969, "o", "    base = row.to(tl.int64) * N + col0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050025, "o", "    o = row * SPS + tl.arange(0, BS)\r\n\u001b[?2004l\r"]
[1025.050066, "o", "\u001b[?2004h> "]
[1025.050109, "o", "    msk = tl.arange(0, BS) < SPS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050174, "o", "    s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\r\n\u001b[?2004l\r"]
[1025.050212, "o", "\u001b[?2004h> "]
[1025.050252, "o", "    s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\r\n\u001b[?2004l\r"]
[1025.050291, "o", "\u001b[?2004h>     mean = s / N\r\n\u001b[?2004l\r"]
[1025.050332, "o", "\u001b[?2004h> "]
[1025.050351, "o", "    var = s2 / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050406, "o", "    rstd = 1.0 / tl.sqrt(var + EPS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.050451, "o", ">     for off in range(0, SEG, BLOCK):\r\n\u001b[?2004l\r"]
[1025.05047, "o", "\u001b[?2004h> "]
[1025.050525, "o", "        oo = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050578, "o", "        v = tl.load(x_ptr + base + oo)\r\n\u001b[?2004l\r"]
[1025.050596, "o", "\u001b[?2004h> "]
[1025.05064, "o", "        ww = tl.load(w_ptr + col0 + oo)\r\n\u001b[?2004l\r"]
[1025.050681, "o", "\u001b[?2004h> "]
[1025.050718, "o", "        bb = tl.load(b_ptr + col0 + oo)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050791, "o", "        tl.store(y_ptr + base + oo, (v - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r"]
[1025.050808, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1025.050848, "o", "\u001b[?2004h> "]
[1025.050888, "o", "def run2(inp, SEG, BLOCK, nw):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050928, "o", "    SPS = N // SEG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.050967, "o", "    nblk = M * SPS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.051029, "o", "    ws = torch.empty(nblk, device=inp.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1025.051068, "o", "\u001b[?2004h> "]
[1025.051124, "o", "    ws2 = torch.empty(nblk, device=inp.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1025.051157, "o", "\u001b[?2004h> "]
[1025.051189, "o", "    out = torch.empty_like(inp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.051292, "o", "    ln_partial[(nblk,)](inp, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=nw)\r\n\u001b[?2004l\r"]
[1025.051332, "o", "\u001b[?2004h>     BS = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.05137, "o", "    while BS < SPS: BS *= 2\r\n\u001b[?2004l\r"]
[1025.051389, "o", "\u001b[?2004h> "]
[1025.051504, "o", "    ln_apply_fused[(nblk,)](inp, out, w, b, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, BS=BS, num_warps=nw)\r\n\u001b[?2004l\r"]
[1025.051544, "o", "\u001b[?2004h>     return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.051584, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.051708, "o", "for SEG, BLOCK, nw in [(262144,2048,16),(262144,2048,8),(262144,4096,16),(524288,2048,16),(131072,2048,8),(131072,2048,16)]:\r\n\u001b[?2004l\r"]
[1025.051726, "o", "\u001b[?2004h> "]
[1025.051754, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1025.051804, "o", "        out = run2(xf, SEG, BLOCK, nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.051837, "o", "> "]
[1025.051879, "o", "        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1025.051899, "o", "\u001b[?2004h> "]
[1025.051981, "o", "        m, mn = timeit(lambda a: run2(a, SEG, BLOCK, nw), [xf], trials=25)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.052023, "o", "> "]
[1025.052102, "o", "        print(f\"2k SEG={SEG} BLOCK={BLOCK} nw={nw}: mean {m:.4f} min {mn:.4f} ok={ok}\", flush=True)\r\n\u001b[?2004l\r"]
[1025.052124, "o", "\u001b[?2004h> "]
[1025.052159, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1025.052199, "o", "> "]
[1025.052273, "o", "        print(f\"2k SEG={SEG} BLOCK={BLOCK} nw={nw}: FAIL {type(e).__name__} {e}\", flush=True)\r\n\u001b[?2004l\r"]
[1025.052307, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
