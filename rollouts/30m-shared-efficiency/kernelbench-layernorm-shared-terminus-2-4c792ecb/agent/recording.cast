[418.009332, "i", "cat >> /workspace/bench.py << 'EOF'\n\n@triton.jit\ndef ln_row2pass(x_ptr, y_ptr, w_ptr, b_ptr, N: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0).to(tl.int64)\n    base = row * N\n    s = tl.zeros([BLOCK], tl.float32)\n    s2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(0, N, BLOCK):\n        o = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + o)\n        s += v\n        s2 += v * v\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    for off in range(0, N, BLOCK):\n        o = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + o)\n        w = tl.load(w_ptr + o)\n        b = tl.load(b_ptr + o)\n        tl.store(y_ptr + base + o, (v - mean) * rstd * w + b)\n\nw = ln.weight.detach().contiguous()\nb = ln.bias.detach().contiguous()\nref = ln(x).view(M, N)\n\ndef run_row2pass(inp, BLOCK=4096, nw=32):\n    out = torch.empty_like(inp)\n    ln_row2pass[(M,)](inp, out, w, b, N=N, BLOCK=BLOCK, num_warps=nw)\n    return out\n\nfor BLOCK, nw in [(4"]
[418.009394, "i", "096,8),(4096,16),(4096,32),(8192,16),(8192,32),(16384,32)]:\n    try:\n        out = run_row2pass(xf, BLOCK, nw)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        m, mn = timeit(lambda a: run_row2pass(a, BLOCK, nw), [xf])\n        print(f\"row2pass BLOCK={BLOCK} nw={nw}: mean {m:.4f} min {mn:.4f} correct={ok}\", flush=True)\n    except Exception as e:\n        print(f\"row2pass BLOCK={BLOCK} nw={nw}: FAIL {type(e).__name__} {e}\", flush=True)\nEOF\n"]
