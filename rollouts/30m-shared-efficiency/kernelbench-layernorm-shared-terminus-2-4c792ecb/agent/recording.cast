[1094.252363, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def ln_partial(x_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
