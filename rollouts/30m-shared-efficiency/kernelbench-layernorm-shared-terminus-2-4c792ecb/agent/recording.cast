[423.60927, "o", "> "]
[423.609353, "o", "    ln_partial[(nblk,)](inp, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=nw)\r\n\u001b[?2004l\r"]
