[805.493251, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\nEPS = tl.constexpr(1e-5)\n\n@triton.jit\ndef ln_partial(x_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    base = row.to(tl.int64) * N + seg * SEG\n    s = tl.zeros([BLOCK], tl.float32)\n    s2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(0, SEG, BLOCK):\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        s += v\n        s2 += v * v\n    tl.store(ws_ptr + pid, tl.sum(s))\n    tl.store(ws2_ptr + pid, tl.sum(s2))\n\n@triton.jit\ndef ln_stats(ws_ptr, ws2_ptr, mr_ptr, SPS: tl.constexpr, N: tl.constexpr, BS: tl.constexpr):\n    row = tl.program_id(0)\n    o = row * SPS + tl.arange(0, BS)\n    msk = tl.arange(0, BS) < SPS\n    s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\n    s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\n    mean = s / N\n    var = s2 / N"]
[805.493307, "i", " - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    tl.store(mr_ptr + row * 2, mean)\n    tl.store(mr_ptr + row * 2 + 1, rstd)\n\n@triton.jit\ndef ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, mr_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    col0 = seg * SEG\n    base = row.to(tl.int64) * N + col0\n    mean = tl.load(mr_ptr + row * 2)\n    rstd = tl.load(mr_ptr + row * 2 + 1)\n    for off in range(0, SEG, BLOCK):\n        o = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + o)\n        ww = tl.load(w_ptr + col0 + o)\n        bb = tl.load(b_ptr + col0 + o)\n        tl.store(y_ptr + base + o, (v - mean) * rstd * ww + bb)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super(ModelNew, self).__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\n        self._N = 1\n        for d in self.normali"]
[805.493319, "i", "zed_shape:\n            self._N *= d\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not x.is_contiguous():\n            x = x.contiguous()\n        N = self._N\n        lead = x.numel() // N\n        xf = x.view(lead, N)\n        w = self.ln.weight\n        b = self.ln.bias\n        SEG = 262144\n        if N % SEG != 0:\n            return self.ln(x)\n        SPS = N // SEG\n        nblk = lead * SPS\n        BLOCK = 2048\n        dev = x.device\n        ws = torch.empty(nblk, device=dev, dtype=torch.float32)\n        ws2 = torch.empty(nblk, device=dev, dtype=torch.float32)\n        mr = torch.empty(lead * 2, device=dev, dtype=torch.float32)\n        out = torch.empty_like(xf)\n        ln_partial[(nblk,)](xf, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=16)\n        BS = 1\n        while BS < SPS:\n            BS *= 2\n        ln_stats[(lead,)](ws, ws2, mr, SPS=SPS, N=N, BS=BS)\n        ln_apply[(nblk,)](xf, out, w, b, mr, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=16)\n        return out.view_as(x)"]
[805.493469, "i", "\nEOF\nbase64 -w0 /workspace/solution.py > /workspace/solution.b64\n"]
