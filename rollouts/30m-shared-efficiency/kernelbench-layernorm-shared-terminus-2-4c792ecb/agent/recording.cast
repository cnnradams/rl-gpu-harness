[736.029501, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[736.029526, "o", "\u001b[?2004h> "]
[736.029554, "o", "    row = pid // SPS\r\n\u001b[?2004l\r"]
[736.02958, "o", "\u001b[?2004h> "]
[736.029608, "o", "    seg = pid % SPS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.029652, "o", "    base = row.to(tl.int64) * N + seg * SEG\r\n\u001b[?2004l\r"]
[736.029678, "o", "\u001b[?2004h> "]
[736.029713, "o", "    s = tl.zeros([BLOCK], tl.float32)\r\n\u001b[?2004l\r"]
[736.029743, "o", "\u001b[?2004h> "]
[736.02977, "o", "    s2 = tl.zeros([BLOCK], tl.float32)\r\n\u001b[?2004l\r"]
[736.029802, "o", "\u001b[?2004h> "]
[736.029843, "o", "    for off in range(0, SEG, BLOCK):\r\n\u001b[?2004l\r"]
[736.029863, "o", "\u001b[?2004h> "]
[736.029883, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h"]
[736.029903, "o", "> "]
[736.030001, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[736.030023, "o", "\u001b[?2004h> "]
[736.030042, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[736.030062, "o", "> "]
[736.030129, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[736.030155, "o", "\u001b[?2004h> "]
[736.030183, "o", "        s += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.030206, "o", "        s2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h"]
[736.030233, "o", "> "]
[736.030258, "o", "    tl.store(ws_ptr + pid, tl.sum(s))\r\n\u001b[?2004l\r"]
[736.030282, "o", "\u001b[?2004h> "]
[736.03032, "o", "    tl.store(ws2_ptr + pid, tl.sum(s2))\r\n\u001b[?2004l\r"]
[736.030344, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[736.030377, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[736.030404, "o", "\u001b[?2004h> "]
[736.030494, "o", "def ln_stats(ws_ptr, ws2_ptr, mr_ptr, SPS: tl.constexpr, N: tl.constexpr, BS: tl.constexpr):\r\n\u001b[?2004l\r"]
[736.030515, "o", "\u001b[?2004h> "]
[736.03054, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[736.030567, "o", "\u001b[?2004h> "]
[736.030598, "o", "    o = row * SPS + tl.arange(0, BS)\r\n\u001b[?2004l\r"]
[736.030627, "o", "\u001b[?2004h> "]
[736.030651, "o", "    msk = tl.arange(0, BS) < SPS\r\n\u001b[?2004l\r"]
[736.030675, "o", "\u001b[?2004h> "]
[736.030733, "o", "    s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\r\n\u001b[?2004l\r"]
[736.030755, "o", "\u001b[?2004h> "]
[736.030813, "o", "    s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\r\n\u001b[?2004l\r"]
[736.030842, "o", "\u001b[?2004h> "]
[736.030864, "o", "    mean = s / N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.030899, "o", "    var = s2 / N - mean * mean\r\n\u001b[?2004l\r"]
[736.030924, "o", "\u001b[?2004h> "]
[736.030959, "o", "    rstd = 1.0 / tl.sqrt(var + EPS)\r\n\u001b[?2004l\r"]
[736.030987, "o", "\u001b[?2004h> "]
[736.031017, "o", "    tl.store(mr_ptr + row * 2, mean)\r\n\u001b[?2004l\r"]
[736.031045, "o", "\u001b[?2004h> "]
[736.03108, "o", "    tl.store(mr_ptr + row * 2 + 1, rstd)\r\n\u001b[?2004l\r"]
[736.031108, "o", "\u001b[?2004h> \r\n"]
[736.031137, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[736.031164, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.03131, "o", "def ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, mr_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r"]
[736.031339, "o", "\u001b[?2004h> "]
[736.031364, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[736.031398, "o", "\u001b[?2004h> "]
[736.031424, "o", "    row = pid // SPS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.031452, "o", "    seg = pid % SPS\r\n\u001b[?2004l\r"]
[736.03148, "o", "\u001b[?2004h> "]
[736.031503, "o", "    col0 = seg * SEG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.031544, "o", "    base = row.to(tl.int64) * N + col0\r\n\u001b[?2004l\r"]
[736.031571, "o", "\u001b[?2004h> "]
[736.031601, "o", "    mean = tl.load(mr_ptr + row * 2)\r\n\u001b[?2004l\r"]
[736.031628, "o", "\u001b[?2004h> "]
[736.031663, "o", "    rstd = tl.load(mr_ptr + row * 2 + 1)\r\n\u001b[?2004l\r"]
[736.031691, "o", "\u001b[?2004h> "]
[736.031721, "o", "    for off in range(0, SEG, BLOCK):\r\n\u001b[?2004l\r"]
[736.031749, "o", "\u001b[?2004h> "]
[736.031778, "o", "        o = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[736.031805, "o", "\u001b[?2004h> "]
[736.031832, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.031904, "o", "            v = tl.load(x_ptr + base + o, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[736.031932, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[736.031959, "o", "\u001b[?2004h> "]
[736.031996, "o", "            v = tl.load(x_ptr + base + o)\r\n\u001b[?2004l\r"]
[736.032012, "o", "\u001b[?2004h> "]
[736.032055, "o", "        ww = tl.load(w_ptr + col0 + o)\r\n\u001b[?2004l\r"]
[736.032083, "o", "\u001b[?2004h> "]
[736.032114, "o", "        bb = tl.load(b_ptr + col0 + o)\r\n\u001b[?2004l\r"]
[736.032141, "o", "\u001b[?2004h> "]
[736.032201, "o", "        tl.store(y_ptr + base + o, (v - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r"]
[736.032224, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.032275, "o", "def run_split(inp, SEG, BLOCK, nw, EV):\r\n\u001b[?2004l\r"]
[736.032299, "o", "\u001b[?2004h> "]
[736.032326, "o", "    SPS = N // SEG\r\n\u001b[?2004l\r\u001b[?2004h"]
[736.032354, "o", ">     nblk = M * SPS\r\n\u001b[?2004l\r"]
[736.032381, "o", "\u001b[?2004h> "]
[736.032442, "o", "    ws = torch.empty(nblk, device=inp.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[736.032469, "o", "\u001b[?2004h> "]
[736.032531, "o", "    ws2 = torch.empty(nblk, device=inp.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[736.032559, "o", "\u001b[?2004h> "]
[736.032619, "o", "    mr = torch.empty(M*2, device=inp.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[736.032645, "o", "\u001b[?2004h> "]
[736.032668, "o", "    out = torch.empty_like(inp)\r\n\u001b[?2004l\r"]
[736.032691, "o", "\u001b[?2004h> "]
[736.032787, "o", "    ln_partial[(nblk,)](inp, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, EV=EV, num_warps=nw)\r\n\u001b[?2004l\r"]
[736.032815, "o", "\u001b[?2004h> "]
[736.032836, "o", "    BS = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.032865, "o", "    while BS < SPS: BS *= 2\r\n\u001b[?2004l\r"]
[736.032892, "o", "\u001b[?2004h> "]
[736.032939, "o", "    ln_stats[(M,)](ws, ws2, mr, SPS=SPS, N=N, BS=BS)\r\n\u001b[?2004l\r"]
[736.032967, "o", "\u001b[?2004h> "]
[736.033061, "o", "    ln_apply[(nblk,)](inp, out, w, b, mr, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, EV=EV, num_warps=nw)\r\n\u001b[?2004l\r"]
[736.033087, "o", "\u001b[?2004h> "]
[736.033113, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[736.033139, "o", "\u001b[?2004h> "]
[736.033166, "o", "best = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.033199, "o", "for SEG in [131072, 262144, 524288]:\r\n\u001b[?2004l\r"]
[736.033226, "o", "\u001b[?2004h> "]
[736.033255, "o", "    for BLOCK in [1024, 2048, 4096]:\r\n\u001b[?2004l\r"]
[736.033283, "o", "\u001b[?2004h> "]
[736.033309, "o", "        if BLOCK > SEG: continue\r\n\u001b[?2004l\r"]
[736.033336, "o", "\u001b[?2004h> "]
[736.033363, "o", "        for nw in [4, 8, 16]:\r\n\u001b[?2004l\r"]
[736.033439, "o", "\u001b[?2004h>             for EV in [False, True]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[736.033464, "o", "                try:\r\n\u001b[?2004l\r"]
[736.033485, "o", "\u001b[?2004h> "]
[736.033544, "o", "                    out = run_split(xf, SEG, BLOCK, nw, EV)\r\n\u001b[?2004l\r"]
[736.033573, "o", "\u001b[?2004h> "]
[736.033638, "o", "                    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[736.033664, "o", "\u001b[?2004h> "]
[736.033758, "o", "                    m, mn = timeit(lambda a: run_split(a, SEG, BLOCK, nw, EV), [xf], trials=20)\r\n\u001b[?2004l\r"]
[736.03379, "o", "\u001b[?2004h> "]
[736.033857, "o", "                    tag = f\"SEG={SEG} BLOCK={BLOCK} nw={nw} EV={EV}\"\r\n\u001b[?2004l\r"]
[736.033886, "o", "\u001b[?2004h> "]
[736.033966, "o", "                    print(f\"{tag}: mean {m:.4f} min {mn:.4f} ok={ok}\", flush=True)\r\n\u001b[?2004l\r"]
[736.033991, "o", "\u001b[?2004h> "]
[736.034067, "o", "                    if ok and (best is None or m < best[0]): best = (m, tag)\r\n\u001b[?2004l\r"]
[736.034091, "o", "\u001b[?2004h> "]
[736.034126, "o", "                except Exception as e:\r\n\u001b[?2004l\r"]
[736.034148, "o", "\u001b[?2004h> "]
[736.034259, "o", "                    print(f\"SEG={SEG} BLOCK={BLOCK} nw={nw} EV={EV}: FAIL {type(e).__name__}\", flush=True)\r\n\u001b[?2004l\r"]
[736.034286, "o", "\u001b[?2004h> "]
[736.034313, "o", "print(\"BEST:\", best, flush=True)\r\n\u001b[?2004l\r"]
[736.03434, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[736.035827, "o", "\u001b[?2004hroot@modal:/# "]
[736.035887, "o", "base64 -w0 /workspace/bench2.py > /workspace/bench2.b64\r\n\u001b[?2004l\r"]
[736.037123, "o", "\u001b[?2004hroot@modal:/# "]
[736.528266, "i", "gpu exec sb-BSeatPtZTF1DkFMzaNoPl3 -- bash -lc \"echo $(cat /workspace/bench2.b64) | base64 -d > /workspace/bench2.py && cd /workspace && timeout 900 python3 bench2.py > bench2.out 2>&1; tail -60 bench2.out\"\n"]
