[414.315509, "o", "xf = x.view(M, N)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[414.315551, "o", "\u001b[?2004h> def timeit(fn, args, trials=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[414.315682, "o", "    ts = time_execution_with_cuda_event(fn, args, num_warmup=3, num_trials=trials, verbose=False, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[414.31571, "o", "> "]
[414.315765, "o", "    return float(np.mean(ts)), float(np.min(ts))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[414.31581, "o", "\u001b[?2004h> m, mn = timeit(ln, [x])\r\n\u001b[?2004l\r"]
[414.315848, "o", "\u001b[?2004h> "]
[414.315908, "o", "print(f\"reference LayerNorm: mean {m:.4f} ms, min {mn:.4f} ms\", flush=True)\r\n\u001b[?2004l\r"]
[414.315948, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[414.316001, "o", "y = torch.empty_like(xf)\r\n\u001b[?2004l\r\u001b[?2004h> def docopy(a):\r\n\u001b[?2004l\r"]
