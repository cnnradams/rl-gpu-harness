[883.206803, "i", "cat > /workspace/coop.py << 'PYEOF'\nimport torch, torch.nn as nn, numpy as np\nfrom torch.utils.cpp_extension import load_inline\nfrom kernelbench.timing import time_execution_with_cuda_event\ndev = torch.device('cuda:0')\nM, N = 16, 64*256*256\nx = torch.rand(M, 64, 256, 256, device=dev)\nln = nn.LayerNorm((64,256,256)).to(dev)\nxf = x.view(M, N)\nw = ln.weight.detach().contiguous()\nb = ln.bias.detach().contiguous()\nref = ln(x).view(M, N)\n\nsrc = r'''\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <cooperative_groups.h>\nnamespace cg = cooperative_groups;\n\n#define FULL 0xffffffffu\n\n__global__ void coop_ln(const float* __restrict__ x, float* __restrict__ y,\n                        const float* __restrict__ w, const float* __restrict__ b,\n                        float* __restrict__ ws, float* __restrict__ ws2,\n                        float* __restrict__ mr,\n                        long long N, int G, int SPS) {\n    cg::grid_group grid = cg::this_grid();\n    int bid = blockIdx.x;\n    int row = bid / G;\n "]
[883.20696, "i", "   int seg = bid % G;\n    long long seglen = N / G;\n    long long base = (long long)row * N + (long long)seg * seglen;\n    float s = 0.f, s2 = 0.f;\n    for (long long i = threadIdx.x; i < seglen; i += blockDim.x) {\n        float v = x[base + i];\n        s += v; s2 += v * v;\n    }\n    // block reduce\n    __shared__ float shs[32], shs2[32];\n    for (int o = 16; o > 0; o >>= 1) {\n        s += __shfl_down_sync(FULL, s, o);\n        s2 += __shfl_down_sync(FULL, s2, o);\n    }\n    int lane = threadIdx.x & 31, wid = threadIdx.x >> 5;\n    int nwarp = blockDim.x >> 5;\n    if (lane == 0) { shs[wid] = s; shs2[wid] = s2; }\n    __syncthreads();\n    if (wid == 0) {\n        s = lane < nwarp ? shs[lane] : 0.f;\n        s2 = lane < nwarp ? shs2[lane] : 0.f;\n        for (int o = 16; o > 0; o >>= 1) {\n            s += __shfl_down_sync(FULL, s, o);\n            s2 += __shfl_down_sync(FULL, s2, o);\n        }\n        if (lane == 0) { ws[bid] = s; ws2[bid] = s2; }\n    }\n    grid.sync();\n    if (seg == 0 && threadIdx.x == 0) {\n        f"]
[883.206971, "o", "cat > /workspace/coop.py << 'PYEOF'\r\n\u001b[?2004l\r"]
