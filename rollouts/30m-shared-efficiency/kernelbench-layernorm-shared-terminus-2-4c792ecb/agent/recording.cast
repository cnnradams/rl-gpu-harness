[423.60583, "i", "cat >> /workspace/bench.py << 'EOF'\n\n@triton.jit\ndef ln_partial(x_ptr, ws_ptr, ws2_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    base = row.to(tl.int64) * N + seg * SEG\n    s = tl.zeros([BLOCK], tl.float32)\n    s2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(0, SEG, BLOCK):\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        s += v\n        s2 += v * v\n    tl.store(ws_ptr + pid, tl.sum(s))\n    tl.store(ws2_ptr + pid, tl.sum(s2))\n\n@triton.jit\ndef ln_stats(ws_ptr, ws2_ptr, mr_ptr, SPS: tl.constexpr, N: tl.constexpr, BS: tl.constexpr):\n    row = tl.program_id(0)\n    o = row * SPS + tl.arange(0, BS)\n    msk = tl.arange(0, BS) < SPS\n    s = tl.sum(tl.load(ws_ptr + o, mask=msk, other=0.0))\n    s2 = tl.sum(tl.load(ws2_ptr + o, mask=msk, other=0.0))\n    mean = s / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + EPS)\n    tl.store(mr_ptr + row * 2, mean)\n    tl.store(mr_pt"]
[423.605884, "i", "r + row * 2 + 1, rstd)\n\n@triton.jit\ndef ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, mr_ptr, N: tl.constexpr, SEG: tl.constexpr, SPS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // SPS\n    seg = pid % SPS\n    col0 = seg * SEG\n    base = row.to(tl.int64) * N + col0\n    mean = tl.load(mr_ptr + row * 2)\n    rstd = tl.load(mr_ptr + row * 2 + 1)\n    for off in range(0, SEG, BLOCK):\n        o = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + o)\n        ww = tl.load(w_ptr + col0 + o)\n        bb = tl.load(b_ptr + col0 + o)\n        tl.store(y_ptr + base + o, (v - mean) * rstd * ww + bb)\n\ndef run_split(inp, SEG=262144, BLOCK=2048, nw=8):\n    SPS = N // SEG\n    nblk = M * SPS\n    ws = torch.empty(nblk, device=inp.device, dtype=torch.float32)\n    ws2 = torch.empty(nblk, device=inp.device, dtype=torch.float32)\n    mr = torch.empty(M*2, device=inp.device, dtype=torch.float32)\n    out = torch.empty_like(inp)\n    ln_partial[(nblk,)](inp, ws, ws2, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_w"]
[423.606022, "i", "arps=nw)\n    BS = 1\n    while BS < SPS: BS *= 2\n    ln_stats[(M,)](ws, ws2, mr, SPS=SPS, N=N, BS=BS)\n    ln_apply[(nblk,)](inp, out, w, b, mr, N=N, SEG=SEG, SPS=SPS, BLOCK=BLOCK, num_warps=nw)\n    return out\n\nfor SEG, BLOCK, nw in [(262144,2048,8),(524288,4096,8),(1048576,4096,16)]:\n    try:\n        out = run_split(xf, SEG, BLOCK, nw)\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        m, mn = timeit(lambda a: run_split(a, SEG, BLOCK, nw), [xf])\n        print(f\"split SEG={SEG} BLOCK={BLOCK} nw={nw}: mean {m:.4f} min {mn:.4f} correct={ok}\", flush=True)\n    except Exception as e:\n        print(f\"split SEG={SEG} BLOCK={BLOCK} nw={nw}: FAIL {type(e).__name__} {e}\", flush=True)\nEOF\n"]
