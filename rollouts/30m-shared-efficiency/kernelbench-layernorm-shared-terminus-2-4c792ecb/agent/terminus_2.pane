[?2004l   int seg = bid % G;
    long long seglen = N / G;
    long long base = (long long)row * N + (long long)seg * seglen;
    float s = 0.f, s2 = 0.f;
    for (long long i = threadIdx.x; i < seglen; i += blockDim.x) {
        float v = x[base + i];
        s += v; s2 += v * v;
    }
    // block reduce
    __shared__ float shs[32], shs2[32];
    for (int o = 16; o > 0; o >>= 1) {
        s += __shfl_down_sync(FULL, s, o);
        s2 += __shfl_down_sync(FULL, s2, o);
    }
    int lane = threadIdx.x & 31, wid = threadIdx.x >> 5;
    int nwarp = blockDim.x >> 5;
    if (lane == 0) { shs[wid] = s; shs2[wid] = s2; }
    __syncthreads();
    if (wid == 0) {
        s = lane < nwarp ? shs[lane] : 0.f;
        s2 = lane < nwarp ? shs2[lane] : 0.f;
        for (int o = 16; o > 0; o >>= 1) {
            s += __shfl_down_sync(FULL, s, o);
            s2 += __shfl_down_sync(FULL, s2, o);
        }
        if (lane == 0) { ws[bid] = s; ws2[bid] = s2; }
    }
    grid.sync();
    if (seg == 0 && threadIdx.x == 0) {
        float ts = 0.f, ts2 = 0.f;
        for (int j = 0; j < G; ++j) { ts += ws[row*G+j]; ts2 += ws2[row*G+j]; }
        float mean = ts / (float)N;
        float var = ts2 / (float)N - mean * mean;
        float rstd = rsqrtf(var + 1e-5f);
        mr[row*2] = mean; mr[row*2+1] = rstd;
    }
    grid.sync();
    float mean = mr[row*2], rstd = mr[row*2+1];
    long long col0 = (long long)seg * seglen;
    for (long long i = threadIdx.x; i < seglen; i += blockDim.x) {
        float v = x[base + i];
        y[base + i] = (v - mean) * rstd * w[col0 + i] + b[col0 + i];
    }
}

torch::Tensor coop_ln_run(torch::Tensor x, torch::Tensor w, torch::Tensor b, int G, int nthreads) {
    long long N = x.size(1);
    int M = x.size(0);
    auto y = torch::empty_like(x);
    auto ws = torch::empty({M*G}, x.options());
    auto ws2 = torch::empty({M*G}, x.options());
    auto mr = torch::empty({M*2}, x.options());
    const float* xp = x.data_ptr<float>();
    float* yp = y.data_ptr<float>();
    const float* wp = w.data_ptr<float>();
    const float* bp = b.data_ptr<float>();
    float* wsp = ws.data_ptr<float>();
    float* ws2p = ws2.data_ptr<float>();
    float* mrp = mr.data_ptr<float>();
    int SPS = G;
    void* args[] = {(void*)&xp,(void*)&yp,(void*)&wp,(void*)&bp,(void*)&wsp,(void*)&ws2p,(void*)&mrp,(void*)&N,(void*)&G,(void*)&SPS};
    dim3 grid(M*G), block(nthreads);
    cudaLaunchCooperativeKernel((void*)coop_ln, grid, block, args, 0, 0);
    return y;
}
'''

