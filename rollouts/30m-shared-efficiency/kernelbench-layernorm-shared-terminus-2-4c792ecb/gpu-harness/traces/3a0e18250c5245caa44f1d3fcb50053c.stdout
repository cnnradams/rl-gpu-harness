797-                    )
798-
799-                # in torchbench, they use both precisions for atol and rtol
800-                # kernelbench v0 and v0.1 uses fp32, atol = rtol = 1e-02
801-                # now we will return the tolerance from get_tolerance_for_precision
802-                tolerance = get_tolerance_for_precision(precision)
