754-    ]
755-
756-    with torch.no_grad():
757-
758-        for trial in range(num_correct_trials):
759-
760-            trial_seed = correctness_trial_seeds[trial]
761-            if verbose:
762-                print(f"[Eval] Generating Random Input with seed {trial_seed}")
763-
764-            set_seed(trial_seed)
765-            inputs = get_inputs_fn()
