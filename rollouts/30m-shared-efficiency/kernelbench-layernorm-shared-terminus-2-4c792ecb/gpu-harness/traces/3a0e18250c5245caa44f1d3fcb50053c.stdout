767-            inputs = [_process_input_tensor(x, device, backend, precision) for x in inputs]
768-
769-            set_seed(trial_seed)
770-    
771-            model = original_model_instance.to(device=device, dtype=precision)
772-
773-            set_seed(trial_seed)
774-     
775-            model_new = new_model_instance.to(device=device, dtype=precision)
776-
777-            output = model(*inputs)
778-            torch.cuda.synchronize(device=device)
779-            # ensure all GPU operations are completed before checking results
780-
781-            try:
782-                output_new = model_new(*inputs)
