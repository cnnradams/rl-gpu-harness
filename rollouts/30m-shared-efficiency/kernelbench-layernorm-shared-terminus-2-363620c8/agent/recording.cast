[1283.454042, "i", "cat > /workspace/prof5.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=10):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return f'{sum(ts)/len(ts):.4f} ms'\n\nn = 16*1024*1024\nBLOCK = 2048\n# Case A: adjacent allocation (like model: x then y=empty_like)\nx = torch.rand(n, device='cuda')\ny = torch.empty_like(x)\nprint('x ptr', hex(x.data_ptr()), 'y ptr', hex(y.data_ptr()), 'diff MB', (y.data_ptr()-x.data_ptr())/2**20)\nprint('A adjacent:', timeit(lambda: _copy[(n//BLOC"]
[1283.454089, "i", "K,)](x, y, BLOCK=BLOCK, num_warps=8)))\n# Case B: y offset by 64MB+128KB\npad = torch.empty(64*1024*1024 + 32768, device='cuda')\ny2 = torch.empty_like(x)\nprint('y2 ptr', hex(y2.data_ptr()), 'diff MB', (y2.data_ptr()-x.data_ptr())/2**20)\nprint('B offset+128MB:', timeit(lambda: _copy[(n//BLOCK,)](x, y2, BLOCK=BLOCK, num_warps=8)))\n# Case C: fresh buffers each iter via empty_like reuse (like model fwd)\ndef fwd():\n    yy = torch.empty_like(x)\n    _copy[(n//BLOCK,)](x, yy, BLOCK=BLOCK, num_warps=8)\n    return yy\nprint('C empty_like each fwd:', timeit(fwd))\n# Case D: copy with float4-ish larger block\nprint('D adjacent BLOCK=8192:', timeit(lambda: _copy[(n//BLOCK,)](x, y, BLOCK=8192, num_warps=8)))\n# Case E: read x, write y, where y is x itself? no.\n# Case F: y2 with odd 4KB offset view\nbig = torch.empty(n + 1024, device='cuda')\ny3 = big[256:256+n]\nprint('y3 ptr', hex(y3.data_ptr()), 'diff MB', (y3.data_ptr()-x.data_ptr())/2**20)\nprint('F 1KB-shifted dst:', timeit(lambda: _copy[(n//BLOCK,)](x, y3, BLOCK=BLOCK, num_war"]
[1283.454345, "i", "ps=8)))\nEOF\n"]
