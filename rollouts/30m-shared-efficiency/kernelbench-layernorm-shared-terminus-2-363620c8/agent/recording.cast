[911.047986, "o", "2GB copy_: (1.4165632009506226, 1.4144320487976074) -> 3032 GB/s\r\n2GB tri copy: (1.441222357749939, 1.4381439685821533) -> 2980 GB/s\r\n64MB tri copy flat : (0.19329280257225037, 0.18240000307559967)\r\n64MB tri copy loop : (0.18728000074625015, 0.18671999871730804)\r\n64MB tri copy mask : (0.18700159937143326, 0.18556800484657288)\r\n64MB copy_ noclear : (0.18448319882154465, 0.18352000415325165)\r\n"]
[913.445689, "o", "\u001b[?2004hroot@modal:/# "]
[1066.768285, "i", "cat > /workspace/prof3.py << 'EOF'\nimport torch, time\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\n@triton.jit\ndef _spin(Y, iters, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    a = tl.zeros([BLOCK], tl.float32) + pid\n    for i in range(iters):\n        a = a * 1.0001 + 0.5\n    tl.store(Y + offs, a)\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nnumel = x.numel()\nBLOCK = 8192\nthrash = torch.empty((64, 1024, 1024), dtype=torch.int64, device='cuda')  # 512MB\n\ndef evt_time(n=10):\n    def deco(fn):\n        ts = []\n        for _ in range(n):\n            s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n            s.record(); fn(); e.record()\n            torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n        return sum(ts)/len(ts), min(ts)\n    return deco"]
[1066.768332, "i", "\n\ncopyfn = lambda: _copy[(numel//BLOCK,)](x, y, BLOCK=BLOCK, num_warps=8)\n\n# 1. sustained: 100 copies between events\nfor _ in range(3): copyfn()\ntorch.cuda.synchronize()\ns = torch.cuda.Event(True); e = torch.cuda.Event(True)\ns.record()\nfor _ in range(100): copyfn()\ne.record(); torch.cuda.synchronize()\nprint(f'sustained copy: {s.elapsed_time(e)/100:.4f} ms')\n\n# 2. after read-only thrash (clean L2)\ndef t2():\n    _ = thrash.float().sum()\n    torch.cuda.synchronize()\n    return evt_time()(copyfn)\nprint('copy after read thrash:', t2())\n\n# 3. after dirty fill thrash (evaluator pattern)\ndef t3():\n    thrash[:32].fill_(42)\n    torch.cuda.synchronize()\n    return evt_time()(copyfn)\nprint('copy after fill thrash:', t3())\n\n# 4. clocks hot from spin kernel (no thrash), then copy\ndef t4():\n    _spin[(132,)](y, 200000, BLOCK=1024, num_warps=8)  # ~ms busy\n    torch.cuda.synchronize()\n    return evt_time()(copyfn)\nprint('copy after spin (hot clocks):', t4())\n\n# 5. hot clocks + sleep 5ms before timing\ndef t5():\n    _spin[(13"]
[1066.768346, "i", "2,)](y, 200000, BLOCK=1024, num_warps=8)\n    torch.cuda.synchronize()\n    time.sleep(0.005)\n    return evt_time()(copyfn)\nprint('copy after spin + 5ms sleep:', t5())\nEOF\n"]
