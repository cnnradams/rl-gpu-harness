[1369.344369, "o", "stats2 blk=1024 w=4: 0.1176\r\nstats2 blk=2048 w=8: 0.1049\r\nstats2 blk=4096 w=16: 0.1001\r\nstats2 blk=2048 w=4: 0.1018\r\nstats2 blk=1024 w=2: 0.1053\r\napply2+wb blk=1024 w=4: 0.2482\r\napply2+wb blk=2048 w=8: 0.2710\r\napply2+wb blk=4096 w=16: 0.2995\r\napply2 no wb: 0.1962\r\nnsplit=64 stats2: 0.1056\r\nnsplit=64 apply2: 0.2503\r\nnsplit=256 stats2: 0.1011\r\nnsplit=256 apply2: 0.3124\r\n"]
[1371.13367, "o", "\u001b[?2004hroot@modal:/# "]
[1442.809016, "i", "cat > /workspace/prof7.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=10):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return f'{sum(ts)/len(ts):.4f}'\n\nROWS, N = 16, 4*1024*1024\nn = ROWS * N\nx = torch.rand(n, device='cuda')\ny = torch.empty_like(x)\nws = torch.empty(65536, device='cuda')\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\n@triton.jit\ndef _read_sum(X, WS, NPROG, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    start = pid * CHUNK\n    acc = tl.zeros([BLOCK], tl.float32)\n  "]
[1442.809062, "i", "  for off in range(start, start + CHUNK, BLOCK):\n        v = tl.load(X + off + tl.arange(0, BLOCK))\n        acc += v\n    tl.store(WS + pid * BLOCK + tl.arange(0, BLOCK), acc)\n\n@triton.jit\ndef _read_sum2(X, WS, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    start = pid * CHUNK\n    acc = tl.zeros([BLOCK], tl.float32)\n    acc2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(start, start + CHUNK, BLOCK):\n        v = tl.load(X + off + tl.arange(0, BLOCK))\n        acc += v\n        acc2 += v * v\n    tl.store(WS + pid * 2, tl.sum(acc))\n    tl.store(WS + pid * 2 + 1, tl.sum(acc2))\n\n@triton.jit\ndef _read_only(X, WS, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    start = pid * CHUNK\n    for off in range(start, start + CHUNK, BLOCK):\n        v = tl.load(X + off + tl.arange(0, BLOCK))\n    tl.store(WS + pid, tl.sum(v))\n\n@triton.jit\ndef _read_sum4(X, WS, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    start = pid * CHUNK\n    a0 = tl.zeros(["]
[1442.809075, "i", "BLOCK], tl.float32)\n    a1 = tl.zeros([BLOCK], tl.float32)\n    a2 = tl.zeros([BLOCK], tl.float32)\n    a3 = tl.zeros([BLOCK], tl.float32)\n    for off in range(start, start + CHUNK, 4 * BLOCK):\n        a0 += tl.load(X + off + tl.arange(0, BLOCK))\n        a1 += tl.load(X + off + BLOCK + tl.arange(0, BLOCK))\n        a2 += tl.load(X + off + 2 * BLOCK + tl.arange(0, BLOCK))\n        a3 += tl.load(X + off + 3 * BLOCK + tl.arange(0, BLOCK))\n    tl.store(WS + pid, tl.sum(a0 + a1 + a2 + a3))\n\nBLOCK = 2048\nprint('copy            :', timeit(lambda: _copy[(n//BLOCK,)](x, y, BLOCK=BLOCK, num_warps=8)))\nfor nprog, blk, warps in [(2048, 2048, 8), (2048, 1024, 4), (4096, 1024, 4), (8192, 512, 2), (1024, 4096, 16)]:\n    ch = n // nprog\n    print(f'read_sum np={nprog} blk={blk} w={warps}:', timeit(lambda: _read_sum[(nprog,)](x, ws, nprog, ch, blk, num_warps=warps)))\nfor nprog, blk, warps in [(2048, 2048, 8), (4096, 1024, 4)]:\n    ch = n // nprog\n    print(f'read_sum2 np={nprog} blk={blk} w={warps}:', timeit(lambda: _read_sum2[(n"]
[1442.809083, "i", "prog,)](x, ws, ch, blk, num_warps=warps)))\nprint('read_only np=2048:', timeit(lambda: _read_only[(2048,)](x, ws, n//2048, 2048, num_warps=8)))\nprint('read_sum4 np=2048:', timeit(lambda: _read_sum4[(2048,)](x, ws, n//2048, 1024, num_warps=8)))\nprint('read_sum4 np=4096:', timeit(lambda: _read_sum4[(4096,)](x, ws, n//4096, 1024, num_warps=8)))\nEOF\n"]
