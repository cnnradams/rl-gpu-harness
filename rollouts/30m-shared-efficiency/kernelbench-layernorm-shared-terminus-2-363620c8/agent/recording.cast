[1134.525898, "i", "cat > /workspace/prof4.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\n@triton.jit\ndef _copy_gs(X, Y, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    nprog = tl.num_programs(0)\n    for i in range(pid * BLOCK, n, nprog * BLOCK):\n        offs = i + tl.arange(0, BLOCK)\n        tl.store(Y + offs, tl.load(X + offs))\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=10):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nBLOCK = 8192\nfor mb in [64, 128, 256, 512, 1024]:\n    n = mb * 1024 * "]
[1134.525945, "i", "1024 // 4\n    a = torch.rand(n, device='cuda')\n    b = torch.empty_like(a)\n    t = timeit(lambda: _copy[(n//BLOCK,)](a, b, BLOCK=BLOCK, num_warps=8))\n    print(f'{mb}MB flat copy: {t:.4f} ms -> {2*n*4/t/1e6:.0f} GB/s')\n    del a, b; torch.cuda.empty_cache()\n\n# 64MB with different configs\nn = 16*1024*1024\na = torch.rand(n, device='cuda')\nb = torch.empty_like(a)\nfor blk, warps in [(1024, 4), (2048, 8), (4096, 4), (4096, 16), (8192, 8), (16384, 16)]:\n    t = timeit(lambda: _copy[(n//blk,)](a, b, BLOCK=blk, num_warps=warps))\n    print(f'64MB copy BLOCK={blk} w={warps} grid={n//blk}: {t:.4f} ms -> {2*n*4/t/1e6:.0f} GB/s')\nfor grid in [132, 264, 528, 1056]:\n    t = timeit(lambda: _copy_gs[(grid,)](a, b, n, BLOCK=4096, num_warps=8))\n    print(f'64MB copy gs grid={grid}: {t:.4f} ms -> {2*n*4/t/1e6:.0f} GB/s')\nEOF\n"]
