[813.542006, "i", "cat > /workspace/prof.py << 'EOF'\nimport torch, sys, os\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\nsys.path.insert(0, '/workspace')\n\ntorch.manual_seed(0)\nx = torch.rand(16, 64, 256, 256, device='cuda')\n\n@triton.jit\ndef _copy(X, Y, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=10):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\ny = torch.empty_like(x)\nnumel = x.numel()\nprint('clone     :', timeit(lambda: torch.clone(x)))\nprint('copy_     :', timeit(lambda: y.copy_(x)))\nBLOCK = 8192\nprint('tri copy  :'"]
[813.542053, "i", ", timeit(lambda: _copy[(numel//BLOCK,)](x, y, numel, BLOCK=BLOCK, num_warps=8)))\n\nimport solution\nm = solution.ModelNew((64,256,256)).cuda()\nprint('full fwd  :', timeit(lambda: m(x)))\n\nw = m.ln.weight.contiguous(); b = m.ln.bias.contiguous()\nN = 64*256*256\nrows = 16\nNS = solution._NSPLIT\nCHUNK = (N + NS - 1)//NS\nws = torch.empty(rows*NS*2, dtype=torch.float32, device='cuda')\nprint('NSPLIT', NS, 'CHUNK', CHUNK)\nprint('stats only:', timeit(lambda: solution._stats_kernel[(rows*NS,)](x, ws, N, NSPLIT=NS, CHUNK=CHUNK, BLOCK=solution._BLOCK_S, num_warps=solution._WARPS_S)))\nprint('apply only:', timeit(lambda: solution._apply_kernel[(rows*NS,)](x, y, w, b, ws, N, 1e-5, NSPLIT=NS, CHUNK=CHUNK, BLOCK=solution._BLOCK_A, num_warps=solution._WARPS_A)))\nEOF\n"]
