[1066.772372, "o", "\u001b[?2004h> "]
[1066.772484, "o", "s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[1066.772519, "o", "\u001b[?2004h> "]
[1066.772558, "o", "s.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1066.772631, "o", "for _ in range(100): copyfn()\r\n\u001b[?2004l\r"]
[1066.772663, "o", "\u001b[?2004h> "]
[1066.77274, "o", "e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1066.772783, "o", "\u001b[?2004h> "]
[1066.772896, "o", "print(f'sustained copy: {s.elapsed_time(e)/100:.4f} ms')\r\n\u001b[?2004l\r"]
[1066.772926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1066.772964, "o", "> "]
[1066.773033, "o", "# 2. after read-only thrash (clean L2)\r\n\u001b[?2004l\r"]
[1066.773075, "o", "\u001b[?2004h> "]
[1066.773135, "o", "def t2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1066.773193, "o", "    _ = thrash.float().sum()\r\n\u001b[?2004l\r"]
[1066.773262, "o", "\u001b[?2004h> "]
[1066.7733, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1066.773332, "o", "\u001b[?2004h> "]
[1066.773404, "o", "    return evt_time()(copyfn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1066.773427, "o", "> "]
[1066.773517, "o", "print('copy after read thrash:', t2())\r\n\u001b[?2004l\r\u001b[?2004h"]
[1066.773539, "o", "> \r\n\u001b[?2004l\r"]
[1066.77356, "o", "\u001b[?2004h> "]
[1066.773681, "o", "# 3. after dirty fill thrash (evaluator pattern)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1066.773709, "o", "> "]
[1066.773741, "o", "def t3():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1066.773809, "o", "    thrash[:32].fill_(42)\r\n\u001b[?2004l\r"]
[1066.773831, "o", "\u001b[?2004h> "]
[1066.773902, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1066.773932, "o", "\u001b[?2004h> "]
[1066.773995, "o", "    return evt_time()(copyfn)\r\n\u001b[?2004l\r"]
[1066.774017, "o", "\u001b[?2004h> "]
[1066.774116, "o", "print('copy after fill thrash:', t3())\r\n\u001b[?2004l\r"]
[1066.774147, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1066.774172, "o", "\u001b[?2004h> "]
[1066.774297, "o", "# 4. clocks hot from spin kernel (no thrash), then copy\r\n\u001b[?2004l\r"]
[1066.774317, "o", "\u001b[?2004h> "]
[1066.774349, "o", "def t4():\r\n\u001b[?2004l\r"]
[1066.774377, "o", "\u001b[?2004h> "]
[1066.774522, "o", "    _spin[(132,)](y, 200000, BLOCK=1024, num_warps=8)  # ~ms busy\r\n\u001b[?2004l\r"]
[1066.77454, "o", "\u001b[?2004h> "]
[1066.774614, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1066.774646, "o", "\u001b[?2004h> "]
[1066.774709, "o", "    return evt_time()(copyfn)\r\n\u001b[?2004l\r"]
[1066.774739, "o", "\u001b[?2004h> "]
[1066.77484, "o", "print('copy after spin (hot clocks):', t4())\r\n\u001b[?2004l\r"]
[1066.77487, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1066.774897, "o", "\u001b[?2004h> "]
[1066.774987, "o", "# 5. hot clocks + sleep 5ms before timing\r\n\u001b[?2004l\r"]
[1066.775016, "o", "\u001b[?2004h> "]
[1066.775036, "o", "def t5():\r\n\u001b[?2004l\r"]
[1066.775063, "o", "\u001b[?2004h> "]
[1066.775192, "o", "    _spin[(132,)](y, 200000, BLOCK=1024, num_warps=8)\r\n\u001b[?2004l\r"]
[1066.775212, "o", "\u001b[?2004h> "]
[1066.77529, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1066.775311, "o", "\u001b[?2004h> "]
[1066.775368, "o", "    time.sleep(0.005)\r\n\u001b[?2004l\r"]
[1066.775389, "o", "\u001b[?2004h> "]
[1066.775465, "o", "    return evt_time()(copyfn)\r\n\u001b[?2004l\r"]
[1066.775496, "o", "\u001b[?2004h> "]
[1066.775594, "o", "print('copy after spin + 5ms sleep:', t5())\r\n\u001b[?2004l\r"]
[1066.775623, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1066.841999, "o", "\u001b[?2004hroot@modal:/# "]
