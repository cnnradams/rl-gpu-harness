[1355.488911, "o", "    return f'{sum(ts)/len(ts):.4f}'\r\n\u001b[?2004l\r"]
[1355.488951, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.488991, "o", "> "]
[1355.48903, "o", "ROWS, N = 16, 4*1024*1024\r\n\u001b[?2004l\r"]
[1355.48907, "o", "\u001b[?2004h> "]
[1355.489161, "o", "x = torch.rand(ROWS, N, device='cuda')\r\n\u001b[?2004l\r"]
[1355.489207, "o", "\u001b[?2004h> "]
[1355.489246, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1355.489272, "o", "\u001b[?2004h> "]
[1355.48935, "o", "w = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[1355.489389, "o", "\u001b[?2004h> "]
[1355.489451, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[1355.48949, "o", "\u001b[?2004h> "]
[1355.48953, "o", "NSPLIT = 128\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1355.489583, "o", "CHUNK = N // NSPLIT\r\n\u001b[?2004l\r"]
[1355.489606, "o", "\u001b[?2004h"]
[1355.489621, "o", "> "]
[1355.489735, "o", "ws = torch.empty(ROWS*NSPLIT*2, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.489777, "o", "> \r\n\u001b[?2004l\r"]
[1355.489818, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1355.489837, "o", "\u001b[?2004h> "]
[1355.490081, "o", "def _stats2(X, WS, N: tl.constexpr, NSPLIT: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1355.490098, "o", "\u001b[?2004h> "]
[1355.490165, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1355.490209, "o", "\u001b[?2004h> "]
[1355.49025, "o", "    row = pid // NSPLIT\r\n\u001b[?2004l\r"]
[1355.49029, "o", "\u001b[?2004h> "]
[1355.490329, "o", "    part = pid % NSPLIT\r\n\u001b[?2004l\r"]
[1355.490361, "o", "\u001b[?2004h> "]
[1355.490425, "o", "    start = part * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.490465, "o", "> "]
[1355.490505, "o", "    Xb = X + row * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1355.49061, "o", "    acc = tl.zeros([BLOCK], tl.float32)\r\n\u001b[?2004l\r"]
[1355.490642, "o", "\u001b[?2004h"]
[1355.490681, "o", "> "]
[1355.490731, "o", "    acc2 = tl.zeros([BLOCK], tl.float32)\r\n\u001b[?2004l\r"]
[1355.490771, "o", "\u001b[?2004h> "]
[1355.490878, "o", "    for off in range(start, start + CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.490923, "o", "> "]
[1355.490991, "o", "        cols = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1355.49103, "o", "\u001b[?2004h> "]
[1355.491087, "o", "        v = tl.load(Xb + cols)\r\n\u001b[?2004l\r"]
[1355.491126, "o", "\u001b[?2004h> "]
[1355.491168, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1355.491227, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[1355.491266, "o", "\u001b[?2004h> "]
[1355.491382, "o", "    tl.store(WS + (row * NSPLIT + part) * 2, tl.sum(acc))\r\n\u001b[?2004l\r"]
[1355.491421, "o", "\u001b[?2004h> "]
[1355.49155, "o", "    tl.store(WS + (row * NSPLIT + part) * 2 + 1, tl.sum(acc2))\r\n\u001b[?2004l\r"]
[1355.491587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.491632, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1355.491677, "o", "\u001b[?2004h> "]
[1355.491977, "o", "def _apply2(X, Y, W, B, WS, N: tl.constexpr, eps, NSPLIT: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr, USE_WB: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.492014, "o", "> "]
[1355.492054, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1355.492093, "o", "\u001b[?2004h> "]
[1355.492132, "o", "    row = pid // NSPLIT\r\n\u001b[?2004l\r"]
[1355.492168, "o", "\u001b[?2004h> "]
[1355.492215, "o", "    part = pid % NSPLIT\r\n\u001b[?2004l\r"]
[1355.492254, "o", "\u001b[?2004h> "]
[1355.492293, "o", "    start = part * CHUNK\r\n\u001b[?2004l\r"]
[1355.492329, "o", "\u001b[?2004h> "]
[1355.492399, "o", "    parts = tl.arange(0, NSPLIT)\r\n\u001b[?2004l\r"]
[1355.492438, "o", "\u001b[?2004h> "]
[1355.492536, "o", "    s = tl.load(WS + (row * NSPLIT + parts) * 2)\r\n\u001b[?2004l\r"]
[1355.492567, "o", "\u001b[?2004h> "]
[1355.492694, "o", "    s2 = tl.load(WS + (row * NSPLIT + parts) * 2 + 1)\r\n\u001b[?2004l\r"]
[1355.492734, "o", "\u001b[?2004h"]
[1355.492772, "o", ">     mean = tl.sum(s) / N\r\n\u001b[?2004l\r"]
[1355.49281, "o", "\u001b[?2004h> "]
[1355.492889, "o", "    var = tl.sum(s2) / N - mean * mean\r\n\u001b[?2004l\r"]
[1355.492928, "o", "\u001b[?2004h> "]
[1355.492997, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1355.49304, "o", "\u001b[?2004h> "]
[1355.493079, "o", "    Xb = X + row * N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.493118, "o", "> "]
[1355.49317, "o", "    Yb = Y + row * N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.49321, "o", "> "]
[1355.493305, "o", "    for off in range(start, start + CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[1355.493341, "o", "\u001b[?2004h> "]
[1355.493423, "o", "        cols = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1355.493466, "o", "\u001b[?2004h> "]
[1355.493519, "o", "        v = tl.load(Xb + cols)\r\n\u001b[?2004l\r"]
[1355.493559, "o", "\u001b[?2004h> "]
[1355.493604, "o", "        if USE_WB:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.493642, "o", "> "]
[1355.493703, "o", "            wv = tl.load(W + cols)\r\n\u001b[?2004l\r"]
[1355.493747, "o", "\u001b[?2004h> "]
[1355.493809, "o", "            bv = tl.load(B + cols)\r\n\u001b[?2004l\r"]
[1355.493851, "o", "\u001b[?2004h> "]
[1355.493972, "o", "            tl.store(Yb + cols, (v - mean) * rstd * wv + bv)\r\n\u001b[?2004l\r"]
[1355.494008, "o", "\u001b[?2004h> "]
[1355.494044, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1355.494169, "o", "            tl.store(Yb + cols, (v - mean) * rstd)\r\n\u001b[?2004l\r"]
[1355.494205, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.494245, "o", "> "]
[1355.494392, "o", "for blk, warps in [(1024, 4), (2048, 8), (4096, 16), (2048, 4), (1024, 2)]:\r\n\u001b[?2004l\r"]
[1355.494431, "o", "\u001b[?2004h> "]
[1355.494725, "o", "    print(f'stats2 blk={blk} w={warps}:', timeit(lambda: _stats2[(ROWS*NSPLIT,)](x, ws, N, NSPLIT, CHUNK, blk, num_warps=warps)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.494761, "o", "> "]
[1355.494873, "o", "for blk, warps in [(1024, 4), (2048, 8), (4096, 16)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.494915, "o", "> "]
[1355.495245, "o", "    print(f'apply2+wb blk={blk} w={warps}:', timeit(lambda: _apply2[(ROWS*NSPLIT,)](x, y, w, b, ws, N, 1e-5, NSPLIT, CHUNK, blk, True, num_warps=warps)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.495266, "o", "> "]
[1355.495564, "o", "print('apply2 no wb:', timeit(lambda: _apply2[(ROWS*NSPLIT,)](x, y, w, b, ws, N, 1e-5, NSPLIT, CHUNK, 2048, False, num_warps=8)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.49561, "o", "> "]
[1355.495649, "o", "for ns in [64, 256]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1355.495697, "o", "    ch = N // ns\r\n\u001b[?2004l\r"]
[1355.495737, "o", "\u001b[?2004h> "]
[1355.495971, "o", "    print(f'nsplit={ns} stats2:', timeit(lambda: _stats2[(ROWS*ns,)](x, ws, N, ns, ch, 2048, num_warps=8)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.496008, "o", "> "]
[1355.496296, "o", "    print(f'nsplit={ns} apply2:', timeit(lambda: _apply2[(ROWS*ns,)](x, y, w, b, ws, N, 1e-5, ns, ch, 2048, True, num_warps=8)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1355.49634, "o", "> EOF\r\n\u001b[?2004l\r"]
