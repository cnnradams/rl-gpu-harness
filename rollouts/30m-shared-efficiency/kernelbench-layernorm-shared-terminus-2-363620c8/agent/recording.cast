[1355.486921, "i", "cat > /workspace/prof6.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=10):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return f'{sum(ts)/len(ts):.4f}'\n\nROWS, N = 16, 4*1024*1024\nx = torch.rand(ROWS, N, device='cuda')\ny = torch.empty_like(x)\nw = torch.rand(N, device='cuda')\nb = torch.rand(N, device='cuda')\nNSPLIT = 128\nCHUNK = N // NSPLIT\nws = torch.empty(ROWS*NSPLIT*2, device='cuda')\n\n@triton.jit\ndef _stats2(X, WS, N: tl.constexpr, NSPLIT: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NSPLIT\n    part = pid % NSPLIT\n    start = part * CHUNK\n    Xb = X + row * N\n    acc"]
[1355.486965, "i", " = tl.zeros([BLOCK], tl.float32)\n    acc2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(start, start + CHUNK, BLOCK):\n        cols = off + tl.arange(0, BLOCK)\n        v = tl.load(Xb + cols)\n        acc += v\n        acc2 += v * v\n    tl.store(WS + (row * NSPLIT + part) * 2, tl.sum(acc))\n    tl.store(WS + (row * NSPLIT + part) * 2 + 1, tl.sum(acc2))\n\n@triton.jit\ndef _apply2(X, Y, W, B, WS, N: tl.constexpr, eps, NSPLIT: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr, USE_WB: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NSPLIT\n    part = pid % NSPLIT\n    start = part * CHUNK\n    parts = tl.arange(0, NSPLIT)\n    s = tl.load(WS + (row * NSPLIT + parts) * 2)\n    s2 = tl.load(WS + (row * NSPLIT + parts) * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    Xb = X + row * N\n    Yb = Y + row * N\n    for off in range(start, start + CHUNK, BLOCK):\n        cols = off + tl.arange(0, BLOCK)\n        v = tl.load(Xb + cols)\n        if USE_W"]
[1355.487296, "i", "B:\n            wv = tl.load(W + cols)\n            bv = tl.load(B + cols)\n            tl.store(Yb + cols, (v - mean) * rstd * wv + bv)\n        else:\n            tl.store(Yb + cols, (v - mean) * rstd)\n\nfor blk, warps in [(1024, 4), (2048, 8), (4096, 16), (2048, 4), (1024, 2)]:\n    print(f'stats2 blk={blk} w={warps}:', timeit(lambda: _stats2[(ROWS*NSPLIT,)](x, ws, N, NSPLIT, CHUNK, blk, num_warps=warps)))\nfor blk, warps in [(1024, 4), (2048, 8), (4096, 16)]:\n    print(f'apply2+wb blk={blk} w={warps}:', timeit(lambda: _apply2[(ROWS*NSPLIT,)](x, y, w, b, ws, N, 1e-5, NSPLIT, CHUNK, blk, True, num_warps=warps)))\nprint('apply2 no wb:', timeit(lambda: _apply2[(ROWS*NSPLIT,)](x, y, w, b, ws, N, 1e-5, NSPLIT, CHUNK, 2048, False, num_warps=8)))\nfor ns in [64, 256]:\n    ch = N // ns\n    print(f'nsplit={ns} stats2:', timeit(lambda: _stats2[(ROWS*ns,)](x, ws, N, ns, ch, 2048, num_warps=8)))\n    print(f'nsplit={ns} apply2:', timeit(lambda: _apply2[(ROWS*ns,)](x, y, w, b, ws, N, 1e-5, ns, ch, 2048, True, num_warps=8)))\nEOF\n"]
