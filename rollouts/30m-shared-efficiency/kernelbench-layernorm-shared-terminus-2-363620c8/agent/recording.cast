[899.553432, "i", "cat > /workspace/prof2.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=10, clear=True):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        if clear: clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts), min(ts)\n\n@triton.jit\ndef _copy(X, Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\n@triton.jit\ndef _copy_loop(X, Y, CHUNK, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid * CHUNK\n    for off in range(base, base + CHUNK, BLOCK):\n        cols = off + tl.arange(0, BLOCK)\n        tl.store(Y + cols, tl.load(X + cols))\n\n@triton.jit\ndef _copy_loop_mask(X, Y"]
[899.553482, "i", ", N, CHUNK, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid * CHUNK\n    for off in range(base, base + CHUNK, BLOCK):\n        cols = off + tl.arange(0, BLOCK)\n        m = cols < N\n        tl.store(Y + cols, tl.load(X + cols, mask=m), mask=m)\n\n# big copy steady state\nbig = torch.rand(512*1024*1024, device='cuda')  # 2GB fp32? no, 512M*4=2GB\nbig2 = torch.empty_like(big)\nn = big.numel()\nBLOCK = 8192\nt = timeit(lambda: big2.copy_(big), n=5, clear=False)\nprint(f'2GB copy_: {t} -> {2*n*4/t[0]/1e6:.0f} GB/s')\nt = timeit(lambda: _copy[(n//BLOCK,)](big, big2, BLOCK=BLOCK, num_warps=8), n=5, clear=False)\nprint(f'2GB tri copy: {t} -> {2*n*4/t[0]/1e6:.0f} GB/s')\ndel big, big2\ntorch.cuda.empty_cache()\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\ny = torch.empty_like(x)\nnumel = x.numel()\nprint(f'64MB tri copy flat : {timeit(lambda: _copy[(numel//BLOCK,)](x, y, BLOCK=BLOCK, num_warps=8))}')\nCHUNK = 32768\nprint(f'64MB tri copy loop : {timeit(lambda: _copy_loop[(numel//CHUNK,)](x, y, CHUNK, BLOCK=BLOCK, num"]
[899.553496, "i", "_warps=8))}')\nprint(f'64MB tri copy mask : {timeit(lambda: _copy_loop_mask[(numel//CHUNK,)](x, y, numel, CHUNK, BLOCK=BLOCK, num_warps=8))}')\nprint(f'64MB copy_ noclear : {timeit(lambda: y.copy_(x), clear=False)}')\nEOF\n"]
