[899.554987, "o", "\u001b[?2004h> "]
[899.55506, "o", "        if clear: clear_l2()\r\n\u001b[?2004l\r"]
[899.555083, "o", "\u001b[?2004h> "]
[899.555235, "o", "        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[899.555263, "o", "\u001b[?2004h> "]
[899.555343, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[899.555366, "o", "\u001b[?2004h> "]
[899.555445, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[899.555468, "o", "\u001b[?2004h> "]
[899.555557, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[899.555581, "o", "\u001b[?2004h> "]
[899.555667, "o", "    return sum(ts)/len(ts), min(ts)\r\n\u001b[?2004l\r"]
[899.555692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[899.555713, "o", "\u001b[?2004h> "]
[899.555755, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[899.555783, "o", "\u001b[?2004h> "]
[899.555876, "o", "def _copy(X, Y, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[899.555903, "o", "\u001b[?2004h> "]
[899.555965, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[899.555987, "o", "\u001b[?2004h> "]
[899.556094, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[899.556117, "o", "\u001b[?2004h> "]
[899.556216, "o", "    tl.store(Y + offs, tl.load(X + offs))\r\n\u001b[?2004l\r"]
[899.55624, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[899.556268, "o", "\u001b[?2004h> "]
[899.5563, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[899.556332, "o", "\u001b[?2004h> "]
[899.556448, "o", "def _copy_loop(X, Y, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[899.556475, "o", "\u001b[?2004h> "]
[899.556537, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[899.556559, "o", "\u001b[?2004h> "]
[899.556617, "o", "    base = pid * CHUNK\r\n\u001b[?2004l\r"]
[899.556637, "o", "\u001b[?2004h> "]
[899.556763, "o", "    for off in range(base, base + CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[899.556786, "o", "\u001b[?2004h> "]
[899.556892, "o", "        cols = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[899.556915, "o", "\u001b[?2004h> "]
[899.557024, "o", "        tl.store(Y + cols, tl.load(X + cols))\r\n\u001b[?2004l\r"]
[899.557047, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[899.557073, "o", "\u001b[?2004h> "]
[899.557107, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[899.557172, "o", "\u001b[?2004h> "]
[899.557297, "o", "def _copy_loop_mask(X, Y, N, CHUNK, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[899.55734, "o", "\u001b[?2004h> "]
[899.557384, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[899.557426, "o", "\u001b[?2004h> "]
[899.557474, "o", "    base = pid * CHUNK\r\n\u001b[?2004l\r"]
[899.557489, "o", "\u001b[?2004h"]
[899.557531, "o", "> "]
[899.557618, "o", "    for off in range(base, base + CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[899.557634, "o", "\u001b[?2004h"]
[899.557675, "o", "> "]
[899.557745, "o", "        cols = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[899.557786, "o", "\u001b[?2004h> "]
[899.557825, "o", "        m = cols < N\r\n\u001b[?2004l\r"]
[899.557878, "o", "\u001b[?2004h> "]
[899.558004, "o", "        tl.store(Y + cols, tl.load(X + cols, mask=m), mask=m)\r\n\u001b[?2004l\r"]
[899.558044, "o", "\u001b[?2004h"]
[899.558087, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[899.558129, "o", "# big copy steady state\r\n\u001b[?2004l\r\u001b[?2004h"]
[899.558171, "o", "> "]
[899.558314, "o", "big = torch.rand(512*1024*1024, device='cuda')  # 2GB fp32? no, 512M*4=2GB\r\n\u001b[?2004l\r"]
[899.558356, "o", "\u001b[?2004h> "]
[899.558416, "o", "big2 = torch.empty_like(big)\r\n\u001b[?2004l\r"]
[899.558458, "o", "\u001b[?2004h> "]
[899.558499, "o", "n = big.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[899.558541, "o", "BLOCK = 8192\r\n\u001b[?2004l\r"]
[899.558583, "o", "\u001b[?2004h> "]
[899.558693, "o", "t = timeit(lambda: big2.copy_(big), n=5, clear=False)\r\n\u001b[?2004l\r"]
[899.55874, "o", "\u001b[?2004h> "]
[899.558848, "o", "print(f'2GB copy_: {t} -> {2*n*4/t[0]/1e6:.0f} GB/s')\r\n\u001b[?2004l\r"]
[899.558877, "o", "\u001b[?2004h> "]
[899.559111, "o", "t = timeit(lambda: _copy[(n//BLOCK,)](big, big2, BLOCK=BLOCK, num_warps=8), n=5, clear=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[899.559143, "o", "> "]
[899.559261, "o", "print(f'2GB tri copy: {t} -> {2*n*4/t[0]/1e6:.0f} GB/s')\r\n\u001b[?2004l\r"]
[899.559304, "o", "\u001b[?2004h"]
[899.559345, "o", "> del big, big2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[899.559415, "o", "torch.cuda.empty_cache()\r\n\u001b[?2004l\r"]
[899.559458, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[899.5595, "o", "> "]
[899.559583, "o", "x = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r"]
[899.559626, "o", "\u001b[?2004h> "]
[899.559667, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[899.55971, "o", "\u001b[?2004h> "]
[899.559752, "o", "numel = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h"]
[899.559792, "o", "> "]
[899.560037, "o", "print(f'64MB tri copy flat : {timeit(lambda: _copy[(numel//BLOCK,)](x, y, BLOCK=BLOCK, num_warps=8))}')\r\n\u001b[?2004l\r"]
[899.560076, "o", "\u001b[?2004h> "]
[899.560117, "o", "CHUNK = 32768\r\n\u001b[?2004l\r\u001b[?2004h> "]
[899.560392, "o", "print(f'64MB tri copy loop : {timeit(lambda: _copy_loop[(numel//CHUNK,)](x, y, CHUNK, BLOCK=BLOCK, num_warps=8))}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[899.560429, "o", "> "]
[899.560715, "o", "print(f'64MB tri copy mask : {timeit(lambda: _copy_loop_mask[(numel//CHUNK,)](x, y, numel, CHUNK, BLOCK=BLOCK, num_warps=8))}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[899.560757, "o", "> "]
[899.560924, "o", "print(f'64MB copy_ noclear : {timeit(lambda: y.copy_(x), clear=False)}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[899.560967, "o", "> "]
[899.561005, "o", "EOF\r\n\u001b[?2004l\r"]
[899.625926, "o", "\u001b[?2004hroot@modal:/# "]
[899.754383, "i", "gpu sync && gpu run --timeout 300 -- bash -c 'nvidia-smi; nvidia-smi -q -d CLOCK | head -30; python3 /workspace/prof2.py'\n"]
