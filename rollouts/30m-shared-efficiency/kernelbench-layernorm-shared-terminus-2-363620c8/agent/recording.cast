[735.1654, "o", "    row = pid // NSPLIT\r\n\u001b[?2004l\r"]
[735.165438, "o", "\u001b[?2004h> "]
[735.165486, "o", "    part = pid % NSPLIT\r\n\u001b[?2004l\r"]
[735.165524, "o", "\u001b[?2004h> "]
[735.165573, "o", "    start = part * CHUNK\r\n\u001b[?2004l\r"]
[735.165624, "o", "\u001b[?2004h> "]
[735.165684, "o", "    parts = tl.arange(0, NSPLIT)\r\n\u001b[?2004l\r"]
[735.165722, "o", "\u001b[?2004h> "]
[735.165827, "o", "    s = tl.load(WS + (row * NSPLIT + parts) * 2)\r\n\u001b[?2004l\r"]
[735.165867, "o", "\u001b[?2004h> "]
[735.165977, "o", "    s2 = tl.load(WS + (row * NSPLIT + parts) * 2 + 1)\r\n\u001b[?2004l\r"]
[735.166016, "o", "\u001b[?2004h> "]
[735.166064, "o", "    mean = tl.sum(s) / N\r\n\u001b[?2004l\r"]
[735.166103, "o", "\u001b[?2004h> "]
[735.166183, "o", "    var = tl.sum(s2) / N - mean * mean\r\n\u001b[?2004l\r"]
[735.166222, "o", "\u001b[?2004h> "]
[735.166296, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[735.166335, "o", "\u001b[?2004h> "]
[735.166372, "o", "    Xb = X + row * N\r\n\u001b[?2004l\r"]
[735.166411, "o", "\u001b[?2004h> "]
[735.16645, "o", "    Yb = Y + row * N\r\n\u001b[?2004l\r"]
[735.166487, "o", "\u001b[?2004h> "]
[735.166595, "o", "    for off in range(start, start + CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[735.166638, "o", "\u001b[?2004h> "]
[735.166721, "o", "        cols = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[735.166759, "o", "\u001b[?2004h> "]
[735.166796, "o", "        m = cols < N\r\n\u001b[?2004l\r"]
[735.166824, "o", "\u001b[?2004h> "]
[735.16695, "o", "        x = tl.load(Xb + cols, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[735.166986, "o", "\u001b[?2004h> "]
[735.167085, "o", "        w = tl.load(W + cols, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[735.16713, "o", "\u001b[?2004h> "]
[735.167224, "o", "        b = tl.load(B + cols, mask=m, other=0.0)\r\n\u001b[?2004l\r"]
[735.167262, "o", "\u001b[?2004h> "]
[735.167402, "o", "        tl.store(Yb + cols, (x - mean) * rstd * w + b, mask=m)\r\n\u001b[?2004l\r"]
[735.167443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[735.16748, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[735.167554, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[735.167594, "o", "\u001b[?2004h> "]
[735.1677, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[735.167739, "o", "\u001b[?2004h> "]
[735.167823, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[735.167861, "o", "\u001b[?2004h> "]
[735.167979, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[735.168015, "o", "\u001b[?2004h> "]
[735.168157, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[735.168192, "o", "\u001b[?2004h> "]
[735.168241, "o", "        self._ws = None\r\n\u001b[?2004l\r"]
[735.168285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[735.168323, "o", "> "]
[735.168425, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[735.168463, "o", "\u001b[?2004h> "]
[735.168516, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[735.16856, "o", "\u001b[?2004h> "]
[735.168606, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[735.168707, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[735.168747, "o", "\u001b[?2004h> "]
[735.168785, "o", "            N *= s\r\n\u001b[?2004l\r"]
[735.168829, "o", "\u001b[?2004h> "]
[735.168882, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r"]
[735.168921, "o", "\u001b[?2004h> "]
[735.168985, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[735.169027, "o", "\u001b[?2004h> "]
[735.169105, "o", "        w = self.ln.weight.contiguous()\r\n\u001b[?2004l\r"]
[735.169159, "o", "\u001b[?2004h> "]
[735.16924, "o", "        b = self.ln.bias.contiguous()\r\n\u001b[?2004l\r"]
[735.169281, "o", "\u001b[?2004h> "]
[735.169328, "o", "        NSPLIT = _NSPLIT\r\n\u001b[?2004l\r"]
[735.16937, "o", "\u001b[?2004h> "]
[735.169456, "o", "        CHUNK = (N + NSPLIT - 1) // NSPLIT\r\n\u001b[?2004l\r"]
[735.169497, "o", "\u001b[?2004h> "]
[735.169542, "o", "        ws = self._ws\r\n\u001b[?2004l\r"]
[735.16958, "o", "\u001b[?2004h> "]
[735.169736, "o", "        if ws is None or ws.shape[0] != rows or ws.device != x.device:\r\n\u001b[?2004l\r"]
[735.16977, "o", "\u001b[?2004h> "]
[735.169962, "o", "            ws = torch.empty(rows * NSPLIT * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r"]
[735.170004, "o", "\u001b[?2004h> "]
[735.170046, "o", "            self._ws = ws\r\n\u001b[?2004l\r"]
[735.170075, "o", "\u001b[?2004h> "]
[735.170142, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r"]
[735.170182, "o", "\u001b[?2004h> "]
[735.17044, "o", "        _stats_kernel[(rows * NSPLIT,)](x, ws, N, NSPLIT=NSPLIT, CHUNK=CHUNK, BLOCK=_BLOCK_S, num_warps=_WARPS_S)\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.170477, "o", "> "]
[735.170776, "o", "        _apply_kernel[(rows * NSPLIT,)](x, y, w, b, ws, N, eps, NSPLIT=NSPLIT, CHUNK=CHUNK, BLOCK=_BLOCK_A, num_warps=_WARPS_A)\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.170815, "o", "> "]
[735.170854, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.170893, "o", "> EOF\r\n\u001b[?2004l\r"]
[735.206279, "o", "\u001b[?2004hroot@modal:/# "]
[735.361839, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, sys, os, itertools, subprocess\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\n\ntorch.manual_seed(0)\nref = nn.LayerNorm((64, 256, 256)).cuda()\nx = torch.rand(16, 64, 256, 256, device='cuda')\nr = ref(x)\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\nimport importlib\nresults = []\nfor nsplit, bs, ws_, ba, wa in itertools.product([32, 64, 128, 256], [2048, 4096, 8192], [2, 4, 8], [4096, 8192], [4, 8, 16]):\n    os.environ['LN_NSPLIT'] = str(nsplit)\n    os.environ['LN_BLOCK_S'] = str(bs)\n    os.environ['LN_WARPS_S'] = str(ws_)\n    os.environ['LN_BLOCK_A'] = str(ba)\n    os.environ['LN_WARPS_A'] = str(wa)\n    if bs * wa > 8192 * 8 // 2:  # skip silly combos heuristically\n        continue\n    try:\n        import solution\n        importlib.reload(solution)\n        m = solution.ModelNew((64, 256, 256)).cuda()\n        out = m(x)\n        torch.cuda.synchronize()\n        diff = (out - r).abs().max().i"]
[735.3621, "i", "tem()\n        if diff > 1e-4:\n            continue\n        for _ in range(5): m(x)\n        torch.cuda.synchronize()\n        times = []\n        for _ in range(10):\n            clear_l2()\n            s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n            s.record(); m(x); e.record()\n            torch.cuda.synchronize()\n            times.append(s.elapsed_time(e))\n        t = sum(times) / len(times)\n        results.append((t, nsplit, bs, ws_, ba, wa))\n        print(f'{t:.4f} ms  nsplit={nsplit} bs={bs} ws={ws_} ba={ba} wa={wa}', flush=True)\n    except Exception as ex:\n        print('ERR', nsplit, bs, ws_, ba, wa, ex, flush=True)\n\nresults.sort()\nprint('BEST:', results[:5])\nEOF\n"]
[735.362213, "o", "cat > /workspace/tune.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, sys, os, itertools, subprocess\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.362267, "o", "> import torch.nn as nn\r\n\u001b[?2004l\r"]
[735.36231, "o", "\u001b[?2004h> "]
[735.362389, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.36242, "o", "> \r\n\u001b[?2004l\r"]
[735.36247, "o", "\u001b[?2004h> "]
[735.362499, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.36253, "o", "> "]
[735.362636, "o", "ref = nn.LayerNorm((64, 256, 256)).cuda()\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.362659, "o", "> "]
[735.362781, "o", "x = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.36282, "o", "> r = ref(x)\r\n\u001b[?2004l\r"]
[735.362849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[735.362887, "o", "\u001b[?2004h> "]
[735.362927, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.362967, "o", "> "]
[735.363114, "o", "    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.363153, "o", "> "]
[735.36318, "o", "    d.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.363219, "o", ">     del d\r\n\u001b[?2004l\r"]
[735.363245, "o", "\u001b[?2004h> "]
[735.363282, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[735.363321, "o", "import importlib\r\n\u001b[?2004l\r"]
[735.363356, "o", "\u001b[?2004h> "]
[735.363384, "o", "results = []\r\n\u001b[?2004l\r"]
[735.36342, "o", "\u001b[?2004h> "]
[735.363718, "o", "for nsplit, bs, ws_, ba, wa in itertools.product([32, 64, 128, 256], [2048, 4096, 8192], [2, 4, 8], [4096, 8192], [4, 8, 16]):\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.363753, "o", "> "]
[735.363827, "o", "    os.environ['LN_NSPLIT'] = str(nsplit)\r\n\u001b[?2004l\r"]
[735.363866, "o", "\u001b[?2004h> "]
[735.363949, "o", "    os.environ['LN_BLOCK_S'] = str(bs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.363988, "o", "> "]
[735.364059, "o", "    os.environ['LN_WARPS_S'] = str(ws_)\r\n\u001b[?2004l\r"]
[735.364098, "o", "\u001b[?2004h> "]
[735.364184, "o", "    os.environ['LN_BLOCK_A'] = str(ba)\r\n\u001b[?2004l\r"]
[735.36422, "o", "\u001b[?2004h> "]
[735.364295, "o", "    os.environ['LN_WARPS_A'] = str(wa)\r\n\u001b[?2004l\r"]
[735.364334, "o", "\u001b[?2004h> "]
[735.364499, "o", "    if bs * wa > 8192 * 8 // 2:  # skip silly combos heuristically\r\n\u001b[?2004l\r\u001b[?2004h> "]
[735.364547, "o", "        continue\r\n\u001b[?2004l\r"]
[735.364577, "o", "\u001b[?2004h> "]
[735.364615, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.364654, "o", "> "]
[735.364692, "o", "        import solution\r\n\u001b[?2004l\r"]
[735.36473, "o", "\u001b[?2004h> "]
[735.3648, "o", "        importlib.reload(solution)\r\n\u001b[?2004l\r"]
[735.364839, "o", "\u001b[?2004h> "]
[735.364949, "o", "        m = solution.ModelNew((64, 256, 256)).cuda()\r\n\u001b[?2004l\r"]
[735.364987, "o", "\u001b[?2004h> "]
[735.365025, "o", "        out = m(x)\r\n\u001b[?2004l\r"]
[735.365064, "o", "\u001b[?2004h> "]
[735.365144, "o", "        torch.cuda.synchronize()"]
[735.365191, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[735.365283, "o", "        diff = (out - r).abs().max().item()\r\n\u001b[?2004l\r"]
[735.365323, "o", "\u001b[?2004h> "]
[735.365361, "o", "        if diff > 1e-4:\r\n\u001b[?2004l\r"]
[735.365387, "o", "\u001b[?2004h> "]
[735.365448, "o", "            continue\r\n\u001b[?2004l\r"]
[735.365486, "o", "\u001b[?2004h> "]
[735.365545, "o", "        for _ in range(5): m(x)\r\n\u001b[?2004l\r"]
[735.365584, "o", "\u001b[?2004h> "]
[735.365657, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[735.3657, "o", "\u001b[?2004h> "]
[735.365737, "o", "        times = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.365776, "o", "> "]
[735.365824, "o", "        for _ in range(10):\r\n\u001b[?2004l\r"]
[735.365862, "o", "\u001b[?2004h> "]
[735.365901, "o", "            clear_l2()\r\n\u001b[?2004l\r"]
[735.365938, "o", "\u001b[?2004h> "]
[735.366086, "o", "            s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[735.366114, "o", "\u001b[?2004h> "]
[735.366212, "o", "            s.record(); m(x); e.record()\r\n\u001b[?2004l\r"]
[735.366254, "o", "\u001b[?2004h> "]
[735.366324, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[735.366364, "o", "\u001b[?2004h> "]
[735.366455, "o", "            times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[735.366497, "o", "\u001b[?2004h> "]
[735.366575, "o", "        t = sum(times) / len(times)\r\n\u001b[?2004l\r\u001b[?2004h"]
[735.366631, "o", "> "]
[735.36672, "o", "        results.append((t, nsplit, bs, ws_, ba, wa))\r\n\u001b[?2004l\r"]
[735.366757, "o", "\u001b[?2004h> "]
[735.366958, "o", "        print(f'{t:.4f} ms  nsplit={nsplit} bs={bs} ws={ws_} ba={ba} wa={wa}', flush=True)\r\n\u001b[?2004l\r"]
[735.366994, "o", "\u001b[?2004h> "]
[735.367047, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[735.367091, "o", "\u001b[?2004h> "]
[735.367223, "o", "        print('ERR', nsplit, bs, ws_, ba, wa, ex, flush=True)\r\n\u001b[?2004l\r"]
[735.367265, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[735.36731, "o", "> "]
[735.36735, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[735.367415, "o", "print('BEST:', results[:5])\r\n\u001b[?2004l\r"]
