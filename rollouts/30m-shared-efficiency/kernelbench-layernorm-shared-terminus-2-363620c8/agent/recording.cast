[1211.502875, "o", "\u001b[?2004hroot@modal:/# "]
[1211.654541, "i", "cat > /workspace/evalsim.py << 'EOF'\nimport torch, sys\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(0)\nref = nn.LayerNorm((64, 256, 256)).cuda()\nnew = ModelNew((64, 256, 256)).cuda()\nx = torch.rand(16, 64, 256, 256, device='cuda')\nwith torch.no_grad():\n    r = ref(x); n = new(x)\nprint('max diff:', (r-n).abs().max().item())\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        clear_l2()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return sum(ts)/len(ts), ts[0], ts[-1]\n\nwith torch.no_grad():\n    print('new:', timeit(lambda: new(x)))\n    print('ref:', timeit(lambda: ref(x)))\nEOF\n"]
