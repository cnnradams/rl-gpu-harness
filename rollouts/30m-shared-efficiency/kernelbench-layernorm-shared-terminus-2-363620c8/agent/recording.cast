[47.086892, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(0)\nref = nn.LayerNorm((64, 256, 256)).cuda()\nnew = ModelNew((64, 256, 256)).cuda()\nnew.load_state_dict(ref.state_dict())\nx = torch.rand(16, 64, 256, 256, device='cuda')\n\nwith torch.no_grad():\n    r = ref(x)\n    n = new(x)\nprint('max diff:', (r - n).abs().max().item())\n\ndef bench(f, iters=50):\n    for _ in range(10): f(x)\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): f(x)\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nwith torch.no_grad():\n    print('ref ms:', bench(ref))\n    print('new ms:', bench(new))\nEOF\n"]
