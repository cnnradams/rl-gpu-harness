[1716.432403, "o", "\u001b[?2004h> "]
[1716.432527, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1716.432568, "o", "> "]
[1716.432606, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1716.432698, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1716.432738, "o", "> "]
[1716.432779, "o", "            N *= s\r\n\u001b[?2004l\r\u001b[?2004h"]
[1716.432818, "o", "> "]
[1716.432854, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r"]
[1716.432888, "o", "\u001b[?2004h> "]
[1716.432933, "o", "        P = self._P\r\n\u001b[?2004l\r"]
[1716.43297, "o", "\u001b[?2004h> "]
[1716.433034, "o", "        CHUNK = (N + P - 1) // P\r\n\u001b[?2004l\r"]
[1716.43307, "o", "\u001b[?2004h> "]
[1716.433109, "o", "        BLOCK = 2048\r\n\u001b[?2004l\r"]
[1716.433133, "o", "\u001b[?2004h"]
[1716.433152, "o", "> "]
[1716.433363, "o", "        if (N % CHUNK == 0) and x.is_contiguous() and x.is_cuda and (P & (P - 1)) == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1716.433405, "o", "> "]
[1716.433465, "o", "            y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1716.433504, "o", "\u001b[?2004h> "]
[1716.433725, "o", "            if self._ws is None or self._ws.shape[0] != rows * P * 2 or self._ws.device != x.device:\r\n\u001b[?2004l\r"]
[1716.433771, "o", "\u001b[?2004h> "]
[1716.43396, "o", "                self._ws = torch.empty(rows * P * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1716.433992, "o", "> "]
[1716.434175, "o", "                self._bar = torch.zeros(rows, dtype=torch.int32, device=x.device)\r\n\u001b[?2004l\r"]
[1716.434207, "o", "\u001b[?2004h> "]
[1716.434274, "o", "                self._call = 0\r\n\u001b[?2004l\r"]
[1716.434314, "o", "\u001b[?2004h> "]
[1716.43437, "o", "            self._call += 1\r\n\u001b[?2004l\r"]
[1716.434389, "o", "\u001b[?2004h"]
[1716.434419, "o", "> "]
[1716.434483, "o", "            target = self._call * P\r\n\u001b[?2004l\r"]
[1716.434502, "o", "\u001b[?2004h> "]
[1716.434721, "o", "            _fused_ln[(P,)](x, y, self.ln.weight, self.ln.bias, self._ws, self._bar, target,\r\n\u001b[?2004l\r"]
[1716.434761, "o", "\u001b[?2004h"]
[1716.434804, "o", "> "]
[1716.434892, "o", "                            ROWS=rows, N=N, eps=self.ln.eps,\r\n\u001b[?2004l\r"]
[1716.434939, "o", "\u001b[?2004h> "]
[1716.435084, "o", "                            P=P, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[1716.435136, "o", "\u001b[?2004h> "]
[1716.43518, "o", "            return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1716.435456, "o", "        return nn.functional.layer_norm(x, self.normalized_shape, self.ln.weight, self.ln.bias, self.ln.eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1716.435505, "o", "> EOF\r\n\u001b[?2004l\r"]
