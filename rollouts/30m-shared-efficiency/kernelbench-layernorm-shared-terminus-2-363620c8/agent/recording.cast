[735.161303, "i", "cat > /workspace/solution.py << 'EOF'\nimport os\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n_NSPLIT = int(os.environ.get('LN_NSPLIT', '128'))\n_BLOCK_S = int(os.environ.get('LN_BLOCK_S', '4096'))\n_BLOCK_A = int(os.environ.get('LN_BLOCK_A', '8192'))\n_WARPS_S = int(os.environ.get('LN_WARPS_S', '4'))\n_WARPS_A = int(os.environ.get('LN_WARPS_A', '8'))\n\n\n@triton.jit\ndef _stats_kernel(X, WS, N, NSPLIT: tl.constexpr, CHUNK, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NSPLIT\n    part = pid % NSPLIT\n    start = part * CHUNK\n    Xb = X + row * N\n    acc = tl.zeros([BLOCK], tl.float32)\n    acc2 = tl.zeros([BLOCK], tl.float32)\n    for off in range(start, start + CHUNK, BLOCK):\n        cols = off + tl.arange(0, BLOCK)\n        m = cols < N\n        x = tl.load(Xb + cols, mask=m, other=0.0)\n        acc += x\n        acc2 += x * x\n    tl.store(WS + (row * NSPLIT + part) * 2, tl.sum(acc))\n    tl.store(WS + (row * NSPLIT + part) * 2 + 1, tl.sum(acc2))\n\n\n@triton.jit\ndef _appl"]
[735.161349, "i", "y_kernel(X, Y, W, B, WS, N, eps, NSPLIT: tl.constexpr, CHUNK, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NSPLIT\n    part = pid % NSPLIT\n    start = part * CHUNK\n    parts = tl.arange(0, NSPLIT)\n    s = tl.load(WS + (row * NSPLIT + parts) * 2)\n    s2 = tl.load(WS + (row * NSPLIT + parts) * 2 + 1)\n    mean = tl.sum(s) / N\n    var = tl.sum(s2) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    Xb = X + row * N\n    Yb = Y + row * N\n    for off in range(start, start + CHUNK, BLOCK):\n        cols = off + tl.arange(0, BLOCK)\n        m = cols < N\n        x = tl.load(Xb + cols, mask=m, other=0.0)\n        w = tl.load(W + cols, mask=m, other=0.0)\n        b = tl.load(B + cols, mask=m, other=0.0)\n        tl.store(Yb + cols, (x - mean) * rstd * w + b, mask=m)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super(ModelNew, self).__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shap"]
[735.161638, "i", "e)\n        self._ws = None\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        x = x.contiguous()\n        N = 1\n        for s in self.normalized_shape:\n            N *= s\n        rows = x.numel() // N\n        y = torch.empty_like(x)\n        w = self.ln.weight.contiguous()\n        b = self.ln.bias.contiguous()\n        NSPLIT = _NSPLIT\n        CHUNK = (N + NSPLIT - 1) // NSPLIT\n        ws = self._ws\n        if ws is None or ws.shape[0] != rows or ws.device != x.device:\n            ws = torch.empty(rows * NSPLIT * 2, dtype=torch.float32, device=x.device)\n            self._ws = ws\n        eps = self.ln.eps\n        _stats_kernel[(rows * NSPLIT,)](x, ws, N, NSPLIT=NSPLIT, CHUNK=CHUNK, BLOCK=_BLOCK_S, num_warps=_WARPS_S)\n        _apply_kernel[(rows * NSPLIT,)](x, y, w, b, ws, N, eps, NSPLIT=NSPLIT, CHUNK=CHUNK, BLOCK=_BLOCK_A, num_warps=_WARPS_A)\n        return y\nEOF\n"]
[735.161688, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\re)\r\n        self._ws = None\r\n\r\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n        x = x.contiguous()\r\n        N = 1\r\n        for s in self.normalized_shape:\r\n            N *= s\r\n        rows = x.numel() // N\r\n        y = torch.empty_like(x)\r\n        w = self.ln.weight.contiguous()\r\n        b = self.ln.bias.contiguous()\r\n        NSPLIT = _NSPLIT\r\n        CHUNK = (N + NSPLIT - 1) // NSPLIT\r\n        ws = self._ws\r\n        if ws is None or ws.shape[0] != rows or ws.device != x.device:\r\n            ws = torch.empty(rows * NS"]
[735.161724, "o", "PLIT * 2, dtype=torch.float32, device=x.device)\r\n            self._ws = ws\r\n        eps = self.ln.eps\r\n        _stats_kernel[(rows * NSPLIT,)](x, ws, N, NSPLIT=NSPLIT, CHUNK=CHUNK, BLOCK=_BLOCK_S, num_warps=_WARPS_S)\r\n        _apply_kernel[(rows * NSPLIT,)](x, y, w, b, ws, N, eps, NSPLIT=NSPLIT, CHUNK=CHUNK, BLOCK=_BLOCK_A, num_warps=_WARPS_A)\r\n        return y\r\nEOF\r\n"]
