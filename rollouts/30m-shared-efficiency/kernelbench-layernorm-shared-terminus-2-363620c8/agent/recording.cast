[1080.615341, "o", "sustained copy: 0.1832 ms\r\ncopy after read thrash: (0.21018240004777908, 0.1982720047235489)\r\ncopy after fill thrash: (0.21064640134572982, 0.1982080042362213)\r\ncopy after spin (hot clocks): (0.2066303998231888, 0.19679999351501465)\r\ncopy after spin + 5ms sleep: (0.21264960020780563, 0.19660800695419312)\r\n"]
