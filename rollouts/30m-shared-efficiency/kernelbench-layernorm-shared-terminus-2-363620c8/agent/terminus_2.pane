[?2004l[?2004h>         x = tl.load(Xb + cols, mask=m, other=0.0)
[?2004l[?2004h>         acc += x
[?2004l[?2004h>         acc2 += x * x
[?2004l[?2004h>     tl.store(WS + (row * NSPLIT + part) * 2, tl.sum(acc))
