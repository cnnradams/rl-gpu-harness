[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _apply_kernel(X, Y, W, B, WS, N, eps, NSPLIT: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):
