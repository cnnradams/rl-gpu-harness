[1173.787226, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = nn.Linear(K, N).cuda()\nW, b = lin.weight, lin.bias\nsf = 0.5\nalpha = 1.0 + sf\ny = lin(x)\nout_ref = y * sf + y.clone().detach()\n\ndef errinfo(o):\n    d = (o - out_ref).abs()\n    tol = 1e-4 + 1e-4 * out_ref.abs()\n    bad = (d > tol).sum().item()\n    return d.max().item(), bad\n\nFP8 = torch.float8_e5m2\nWh8 = W.detach().to(FP8)\nWl8 = (W.detach() - Wh8.float()).to(FP8)\nWh8 = Wh8.contiguous(); Wl8 = Wl8.contiguous()\n\n@triton.jit\ndef split8_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n\n    v = tl.load(X + offs, mask=m)\n    vh = v.to(tl.float8e5)\n    vl = (v - vh.to(tl.float32)).to(tl.float8e5)\n    tl.store(XH + offs, vh, mask=m)\n    tl.store(XL + offs, vl, mask=m)\n\n@triton.jit\ndef gemm8(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\n          B"]
[1173.787273, "i", "M: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * K + rk[None, :]\n    AL_ptr = AL + rm[:, None] * K + rk[None, :]\n    WH_ptr = WH + rn[None, :] * K + rk[:, None]\n    WL_ptr = WL + rn[None, :] * K + rk[:, None]\n    acc0 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc1 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(AH_ptr)\n        al = tl.load(AL_ptr)\n        bh = tl.load(WH_ptr)\n        bl = tl.load(WL_ptr)\n        acc0 = tl.dot(ah, bh, acc0)\n        acc1 = tl.dot(al, bh, acc1)\n    "]
[1173.78728, "i", "    acc2 = tl.dot(ah, bl, acc2)\n        AH_ptr += BK\n        AL_ptr += BK\n        WH_ptr += BK\n        WL_ptr += BK\n    acc = acc0 + acc1 + acc2\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\nXH8 = torch.empty(M, K, device='cuda', dtype=FP8)\nXL8 = torch.empty(M, K, device='cuda', dtype=FP8)\nC = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\ndef run8(BM, BN, BK, G, w, s):\n    n = M * K\n    split8_kernel[(triton.cdiv(n, 8192),)](x, XH8, XL8, n, BLOCK=8192, num_warps=8)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    gemm8[grid](XH8, XL8, Wh8, Wl8, b, C, M, N, K, alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\n    return C\n\ndef timeit(fn, iters=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torc"]
[1173.787287, "i", "h.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return round(ts[len(ts)//2], 3), round(ts[0], 3)\n\nfor cfg in [(128,128,64,8,8,3),(128,256,64,8,8,2),(128,256,32,8,8,3),(128,128,128,8,8,2),(128,256,128,8,8,2)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run8(BM,BN,BK,G,w,s)\n        print(f'FP8e5 cfg {cfg}: err,bad {errinfo(o)} ms {timeit(lambda: run8(BM,BN,BK,G,w,s))}')\n    except Exception as ex:\n        print(f'FP8e5 cfg {cfg} failed: {str(ex)[:60]}')\nEOF\ngpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/bench6.py /workspace/bench6.py && gpu exec sb-Rw5VsPy9C81UFv19STJ4Qn -- python3 /workspace/bench6.py 2>&1 | tail -8\n"]
