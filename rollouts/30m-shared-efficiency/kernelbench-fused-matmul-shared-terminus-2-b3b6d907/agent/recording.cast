[683.009517, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = nn.Linear(K, N).cuda()\nW, b = lin.weight, lin.bias\nsf = 0.5\nalpha = 1.0 + sf\nx64, W64, b64 = x.double(), W.double(), b.double()\nout64 = alpha * (x64 @ W64.t() + b64)\ny = lin(x)\nout_ref = y * sf + y.clone().detach()\n\ndef err(o):\n    return (o.double() - out_ref.double()).abs().max().item()\n\nWh = W.detach().half()\nWl = (W.detach() - Wh.float()).half()\n\n@triton.jit\ndef gemm_a(A, WH, WL, Bias, C, M, N, K, sam, sak, swn, swk, scm, scn, alpha,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm ="]
[683.009562, "i", " pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    WH_ptr = WH + rn[None, :] * swn + rk[:, None] * swk\n    WL_ptr = WL + rn[None, :] * swn + rk[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(WH_ptr)\n        bl = tl.load(WL_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        A_ptr += BK * sak\n        WH_ptr += BK * swk\n        WL_ptr += BK * swk\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\n@triton.jit\ndef split_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n\n    v = tl.load(X + offs, "]
[683.009664, "i", "mask=m)\n    vh = v.to(tl.float16)\n    vl = (v - vh.to(tl.float32)).to(tl.float16)\n    tl.store(XH + offs, vh, mask=m)\n    tl.store(XL + offs, vl, mask=m)\n\n@triton.jit\ndef gemm_b(AH, AL, WH, WL, Bias, C, M, N, K, sam, sak, swn, swk, scm, scn, alpha,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\n    AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\n    WH_ptr = WH + rn[None, :] * swn + rk[:, None] * swk\n    WL_ptr = WL + rn[None, :] * swn + rk[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, B"]
[683.009686, "i", "K):\n        ah = tl.load(AH_ptr)\n        al = tl.load(AL_ptr)\n        bh = tl.load(WH_ptr)\n        bl = tl.load(WL_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        AH_ptr += BK * sak\n        AL_ptr += BK * sak\n        WH_ptr += BK * swk\n        WL_ptr += BK * swk\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\nC = torch.empty(M, N, device='cuda', dtype=torch.float32)\nXH = torch.empty(M, K, device='cuda', dtype=torch.float16)\nXL = torch.empty(M, K, device='cuda', dtype=torch.float16)\n\ndef run_a(BM, BN, BK, G, w, s):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    gemm_a[grid](x, Wh, Wl, b, C, M, N, K, x.stride(0), x.stride(1), W.stride(0), W.stride(1),\n                 C.stride(0), C.stride(1), alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\n    return C\n\ndef run_b(BM, BN, BK, G, w, s):\n    n = M * K\n    split_kernel[(triton.cdi"]
[683.009746, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[683.00977, "i", "v(n, 4096),)](x, XH, XL, n, BLOCK=4096, num_warps=8)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    gemm_b[grid](XH, XL, Wh, Wl, b, C, M, N, K, XH.stride(0), XH.stride(1), W.stride(0), W.stride(1),\n                 C.stride(0), C.stride(1), alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\n    return C\n\ndef timeit(fn, iters=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return round(ts[len(ts)//2], 3), round(ts[0], 3)\n\nprint('variant A (W presplit):')\nfor cfg in [(128,128,64,8,8,3),(128,256,64,8,8,2),(256,128,64,8,8,2),(128,128,64,8,4,3),(128,256,32,8,8,3),(128,256,64,8,8,3),(128,128,128,8,8,2),(256,"]
[683.00979, "o", "\u001b[?2004h> "]
[683.009808, "i", "256,32,8,8,2),(128,64,64,8,4,4)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_a(BM,BN,BK,G,w,s)\n        print(f'A cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_a(BM,BN,BK,G,w,s))}')\n    except Exception as ex:\n        print(f'A cfg {cfg} failed: {str(ex)[:80]}')\n\nprint('variant B (A+W presplit):')\nfor cfg in [(128,128,64,8,8,3),(128,256,64,8,8,2),(256,128,64,8,8,2),(128,256,32,8,8,3),(128,128,128,8,8,2),(256,256,32,8,8,2),(128,256,64,8,8,3),(256,256,64,8,8,2)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_b(BM,BN,BK,G,w,s)\n        print(f'B cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_b(BM,BN,BK,G,w,s))}')\n    except Exception as ex:\n        print(f'B cfg {cfg} failed: {str(ex)[:80]}')\nEOF\ngpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/bench2.py /workspace/bench2.py\n"]
[683.009849, "o", "import torch, triton\r\n\u001b[?2004l\r"]
[683.009865, "o", "\u001b[?2004h> "]
[683.009973, "o", "import triton.language as tl\r\n\u001b[?2004l\r*\u001b[?2004h"]
[683.009994, "o", "> "]
[683.010063, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[683.010078, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[683.010093, "o", " \u001b[?2004h"]
[683.010113, "o", "> "]
[683.010174, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[683.010188, "o", "\u001b[?2004h> "]
[683.010297, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[683.01031, "o", "\u001b[?2004h> "]
[683.010444, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[683.010458, "o", "\u001b[?2004h> "]
[683.010566, "o", "lin = nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[683.010581, "o", "\u001b[?2004h"]
[683.010595, "o", "> "]
[683.010683, "o", "W, b = lin.weight, lin.bias\r\n\u001b[?2004l\r"]
[683.010697, "o", "\u001b[?2004h"]
[683.010725, "o", "> "]
[683.010745, "o", "sf = 0.5\r\n\u001b[?2004l\r"]
[683.010759, "o", "\u001b[?2004h> "]
[683.010823, "o", "alpha = 1.0 + sf\r\n\u001b[?2004l\r"]
[683.010843, "o", "\u001b[?2004h> "]
[683.011011, "o", "x64, W64, b64 = x.double(), W.double(), b.double()\r\n\u001b[?2004l\r"]
[683.011028, "o", "\u001b[?2004h> "]
[683.011159, "o", "out64 = alpha * (x64 @ W64.t() + b64)\r\n\u001b[?2004l\r"]
[683.011176, "o", "\u001b[?2004h> "]
[683.011215, "o", "y = lin(x)\r\n\u001b[?2004l\r"]
[683.011228, "o", "\u001b[?2004h"]
[683.01124, "o", "> "]
[683.011362, "o", "out_ref = y * sf + y.clone().detach()\r\n\u001b[?2004l\r"]
[683.011377, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[683.011396, "o", "y\u001b[?2004h"]
[683.011415, "o", "> "]
[683.011446, "o", "def err(o):\r\n\u001b[?2004l\r"]
[683.011468, "o", "\u001b[?2004h> "]
[683.011678, "o", "    return (o.double() - out_ref.double()).abs().max().item()\r\n\u001b[?2004l\r"]
[683.011694, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\r\n"]
[683.011714, "o", "\u001b[?2004h"]
[683.011737, "o", "> "]
[683.011794, "o", "Wh = W.detach().half()\r\n\u001b[?2004l\r"]
[683.011811, "o", "\u001b[?2004h> "]
[683.011944, "o", "Wl = (W.detach() - Wh.float()).half()\r\n\u001b[?2004l\r"]
[683.011958, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[683.011971, "o", "r\u001b[?2004h"]
[683.011984, "o", "> "]
[683.012026, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[683.012043, "o", "\u001b[?2004h> "]
[683.01233, "o", "def gemm_a(A, WH, WL, Bias, C, M, N, K, sam, sak, swn, swk, scm, scn, alpha,\r\n\u001b[?2004l\r"]
[683.012347, "o", "\u001b[?2004h> "]
[683.012652, "o", "           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[683.01267, "o", "\u001b[?2004h> "]
[683.012765, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[683.012787, "o", "\u001b[?2004h> "]
[683.012968, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[683.012986, "o", "\u001b[?2004h> "]
[683.01308, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[683.013095, "o", "\u001b[?2004h> "]
[683.013195, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[683.013209, "o", "\u001b[?2004h"]
[683.013224, "o", "> "]
[683.013429, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[683.013451, "o", "\u001b[?2004h> "]
[683.013614, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[683.013629, "o", "\u001b[?2004h> "]
[683.013778, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[683.013793, "o", "\u001b[?2004h> "]
[683.013926, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[683.013941, "o", "\u001b[?2004h"]
[683.01396, "o", "> "]
[683.014079, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[683.0141, "o", "\u001b[?2004h> "]
[683.014182, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[683.014197, "o", "\u001b[?2004h"]
[683.01421, "o", "> "]
[683.014388, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[683.014402, "o", "\u001b[?2004h> "]
[683.014586, "o", "    WH_ptr = WH + rn[None, :] * swn + rk[:, None] * swk\r\n\u001b[?2004l\r"]
[683.0146, "o", "\u001b[?2004h> "]
[683.014796, "o", "    WL_ptr = WL + rn[None, :] * swn + rk[:, None] * swk\r\n\u001b[?2004l\r"]
[683.014817, "o", "\u001b[?2004h> "]
[683.014961, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[683.014977, "o", "\u001b[?2004h> "]
[683.015085, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[683.0151, "o", "\u001b[?2004h> "]
