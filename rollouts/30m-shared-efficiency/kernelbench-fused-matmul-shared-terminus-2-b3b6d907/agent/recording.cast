[927.381365, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = nn.Linear(K, N).cuda()\nW, b = lin.weight, lin.bias\nsf = 0.5\nalpha = 1.0 + sf\ny = lin(x)\nout_ref = y * sf + y.clone().detach()\n\ndef err(o):\n    return (o.double() - out_ref.double()).abs().max().item()\n\nWh = W.detach().half().contiguous()\nWl = (W.detach() - Wh.float()).half().contiguous()\nXh = x.half()\nXH = Xh.contiguous()\nXL = (x - Xh.float()).half().contiguous()\nC = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, dtype=torch.int8, device='cuda')\ntriton.set_allocator(alloc_fn)\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\n\ndef timeit(fn, iters=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iter"]
[927.381409, "i", "s):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return round(ts[len(ts)//2], 3), round(ts[0], 3)\n\n# 1) single-dot ceiling, classic pointers\n@triton.jit\ndef gemm1(A, B, C, M, N, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    B_ptr = B + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k"]
[927.381424, "i", " in range(0, K, BK):\n        a = tl.load(A_ptr)\n        bb = tl.load(B_ptr)\n        acc = tl.dot(a, bb, acc)\n        A_ptr += BK\n        B_ptr += BK\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\nfor cfg in [(128,256,32,8,8,3),(128,256,64,8,8,2),(128,128,64,8,8,3)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        fn = lambda: gemm1[grid](XH, Wh, C, M, N, K, BM, BN, BK, G, num_warps=w, num_stages=s)\n        fn()\n        print(f'1dot cfg {cfg}: ms {timeit(fn)}')\n    except Exception as ex:\n        print(f'1dot cfg {cfg} failed: {str(ex)[:70]}')\n\n# 2) TMA loads + pointer store, persistent 3-dot\n@triton.jit\ndef gemm_tma2(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr, NUM_SMS: tl.constexpr):\n    aH = tl.make_tensor_descriptor(AH, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    aL = tl.make_tensor_descriptor(AL, shape=[M, K], strides=[K, 1], block_shape="]
[927.381432, "i", "[BM, BK])\n    wH = tl.make_tensor_descriptor(WH, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\n    wL = tl.make_tensor_descriptor(WL, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\n    start_pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    num_tiles = grid_m * grid_n\n    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True):\n        width = GROUP * grid_n\n        group_id = tile_id // width\n        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n        pid_m = group_id * GROUP + (tile_id % group_size)\n        pid_n = (tile_id % width) // group_size\n        off_m = pid_m * BM\n        off_n = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            ah = aH.load([off_m, k])\n            al = aL.load([off_m, k])\n            bh = wH.load([off_n, k])\n            bl = wL.load([off_n, k])\n            bht = tl.trans(bh)\n            acc = tl.dot(ah, bht, acc)\n            acc = tl.dot(al, bht, acc)\n     "]
[927.381438, "i", "       acc = tl.dot(ah, tl.trans(bl), acc)\n        rn = off_n + tl.arange(0, BN)\n        rm = off_m + tl.arange(0, BM)\n        bias = tl.load(Bias + rn)\n        acc = acc * alpha + alpha * bias[None, :]\n        C_ptr = C + rm[:, None] * N + rn[None, :]\n        tl.store(C_ptr, acc)\n\ndef run_tma2(BM, BN, BK, G, w, s):\n    num_tiles = triton.cdiv(M, BM) * triton.cdiv(N, BN)\n    grid = (min(NUM_SMS, num_tiles),)\n    gemm_tma2[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, NUM_SMS, num_warps=w, num_stages=s)\n    return C\n\nfor cfg in [(128,256,32,8,8,3),(128,256,64,8,8,2),(128,128,64,8,8,3),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,128,8,8,2)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_tma2(BM,BN,BK,G,w,s)\n        print(f'TMA2 cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_tma2(BM,BN,BK,G,w,s))}')\n    except Exception as ex:\n        print(f'TMA2 cfg {cfg} failed: {str(ex)[:70]}')\n\n# 3) 3 independent accumulators, 128x128 classic\n@triton.jit\ndef gemm_acc3(AH, AL, WH, WL, Bias, C, M, N, K"]
[927.381448, "i", ", alpha,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * K + rk[None, :]\n    AL_ptr = AL + rm[:, None] * K + rk[None, :]\n    WH_ptr = WH + rn[None, :] * K + rk[:, None]\n    WL_ptr = WL + rn[None, :] * K + rk[:, None]\n    acc0 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc1 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(AH_ptr)\n        al = tl.load(AL_ptr)\n        bh = tl.load(WH_ptr)\n        bl = tl.load(WL_ptr)\n        acc0 = tl.dot(ah, bh, acc0)\n        acc1 = t"]
[927.381455, "i", "l.dot(al, bh, acc1)\n        acc2 = tl.dot(ah, bl, acc2)\n        AH_ptr += BK\n        AL_ptr += BK\n        WH_ptr += BK\n        WL_ptr += BK\n    acc = acc0 + acc1 + acc2\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\ndef run_acc3(BM, BN, BK, G, w, s):\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    gemm_acc3[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\n    return C\n\nfor cfg in [(128,128,32,8,8,3),(128,128,64,8,8,2),(128,128,32,8,8,4),(64,128,64,8,4,3),(128,128,32,8,4,3)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_acc3(BM,BN,BK,G,w,s)\n        print(f'ACC3 cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_acc3(BM,BN,BK,G,w,s))}')\n    except Exception as ex:\n        print(f'ACC3 cfg {cfg} failed: {str(ex)[:70]}')\nEOF\ngpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/bench4.py /workspace/bench4.py\n"]
