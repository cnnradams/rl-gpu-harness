[801.988521, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.988647, "o", "def split_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.988743, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.988876, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.988902, "o", "> "]
[801.988945, "o", "    m = offs < n\r\n\u001b[?2004l\r"]
[801.98899, "o", "\u001b[?2004h> "]
[801.989066, "o", "    v = tl.load(X + offs, mask=m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.989143, "o", "    vh = v.to(tl.float16)\r\n\u001b[?2004l\r"]
[801.989175, "o", "\u001b[?2004h> "]
[801.98928, "o", "    vl = (v - vh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[801.989309, "o", "\u001b[?2004h> "]
[801.989389, "o", "    tl.store(XH + offs, vh, mask=m)\r\n\u001b[?2004l\r"]
[801.989423, "o", "\u001b[?2004h> "]
[801.989506, "o", "    tl.store(XL + offs, vl, mask=m)\r\n\u001b[?2004l\r"]
[801.989537, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.989584, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[801.989614, "o", " \u001b[?2004h> "]
[801.989884, "o", "def gemm_b(AH, AL, WH, WL, Bias, C, M, N, K, sam, sak, swn, swk, scm, scn, alpha,\r\n\u001b[?2004l\r"]
[801.989898, "o", "\u001b[?2004h> "]
[801.990211, "o", "           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[801.990236, "o", "\u001b[?2004h> "]
[801.990316, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.990332, "o", "> "]
[801.990476, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.990507, "o", "> "]
[801.990563, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[801.990594, "o", "\u001b[?2004h> "]
[801.990674, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[801.990707, "o", "\u001b[?2004h> "]
[801.990912, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.990944, "o", "> "]
[801.991107, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[801.991136, "o", "\u001b[?2004h> "]
[801.991258, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[801.991287, "o", "\u001b[?2004h> "]
[801.991402, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[801.991433, "o", "\u001b[?2004h> "]
[801.991551, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[801.991589, "o", "\u001b[?2004h> "]
[801.991643, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[801.991673, "o", "\u001b[?2004h> "]
[801.991805, "o", "    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[801.991837, "o", "\u001b[?2004h> "]
[801.991986, "o", "    AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[801.992017, "o", "\u001b[?2004h> "]
[801.992164, "o", "    WH_ptr = WH + rn[None, :] * swn + rk[:, None] * swk\r\n\u001b[?2004l\r"]
[801.992196, "o", "\u001b[?2004h> "]
[801.99233, "o", "    WL_ptr = WL + rn[None, :] * swn + rk[:, None] * swk\r\n\u001b[?2004l\r"]
[801.992362, "o", "\u001b[?2004h> "]
[801.992487, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[801.992517, "o", "\u001b[?2004h> "]
[801.992589, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[801.99262, "o", "\u001b[?2004h> "]
[801.9927, "o", "        ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r"]
[801.992728, "o", "\u001b[?2004h> "]
[801.992798, "o", "        al = tl.load(AL_ptr)\r\n\u001b[?2004l\r"]
[801.992831, "o", "\u001b[?2004h> "]
[801.992888, "o", "        bh = tl.load(WH_ptr)\r\n\u001b[?2004l\r"]
[801.99292, "o", "\u001b[?2004h> "]
[801.992985, "o", "        bl = tl.load(WL_ptr)\r\n\u001b[?2004l\r"]
[801.993016, "o", "\u001b[?2004h> "]
[801.993105, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[801.993137, "o", "\u001b[?2004h> "]
[801.993227, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[801.993258, "o", "\u001b[?2004h> "]
[801.993352, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[801.993382, "o", "\u001b[?2004h> "]
[801.99345, "o", "        AH_ptr += BK * sak\r\n\u001b[?2004l\r"]
[801.993481, "o", "\u001b[?2004h> "]
[801.993555, "o", "        AL_ptr += BK * sak\r\n\u001b[?2004l\r"]
[801.993586, "o", "\u001b[?2004h> "]
[801.993662, "o", "        WH_ptr += BK * swk\r\n\u001b[?2004l\r"]
[801.993692, "o", "\u001b[?2004h> "]
[801.993751, "o", "        WL_ptr += BK * swk\r\n\u001b[?2004l\r"]
[801.993781, "o", "\u001b[?2004h> "]
[801.993845, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[801.993875, "o", "\u001b[?2004h> "]
[801.993935, "o", "    acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[801.993966, "o", "\u001b[?2004h> "]
[801.994039, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[801.994071, "o", "\u001b[?2004h> "]
[801.994102, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[801.994132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.994191, "o", "def run_b(BM, BN, BK, G, w, s):\r\n\u001b[?2004l\r"]
[801.994221, "o", "\u001b[?2004h> "]
[801.99425, "o", "    n = M * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.994381, "o", "    split_kernel[(triton.cdiv(n, 8192),)](x, XH, XL, n, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.994412, "o", "> "]
[801.994482, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[801.994513, "o", "\u001b[?2004h> "]
[801.994686, "o", "    gemm_b[grid](XH, XL, Wh, Wl, b, C, M, N, K, K, 1, K, 1, N, 1, alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[801.994719, "o", "\u001b[?2004h>     return C\r\n\u001b[?2004l\r"]
[801.994739, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[801.994774, "o", "\u001b[?2004h> "]
[801.994805, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r"]
[801.994837, "o", "\u001b[?2004h> "]
[801.994868, "o", "    for _ in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.9949, "o", "        fn()\r\n\u001b[?2004l\r"]
[801.994927, "o", "\u001b[?2004h> "]
[801.994967, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[801.99501, "o", "\u001b[?2004h> "]
[801.995121, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.995153, "o", ">     ts = []\r\n\u001b[?2004l\r"]
[801.995182, "o", "\u001b[?2004h> "]
[801.995211, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[801.995233, "o", "\u001b[?2004h> "]
[801.995273, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[801.995305, "o", "\u001b[?2004h> "]
[801.995351, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[801.995378, "o", "\u001b[?2004h> "]
[801.99552, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[801.995552, "o", "\u001b[?2004h> "]
[801.995597, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[801.995627, "o", "\u001b[?2004h> "]
[801.995667, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[801.995697, "o", "\u001b[?2004h> "]
[801.995745, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[801.995776, "o", "\u001b[?2004h> "]
[801.995807, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.995889, "o", "    return round(ts[len(ts)//2], 3), round(ts[0], 3)\r\n\u001b[?2004l\r"]
[801.995918, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[801.995949, "o", "> "]
[801.99624, "o", "for cfg in [(128,256,32,8,8,3),(128,256,64,8,8,2),(128,256,32,4,8,4),(64,256,32,8,4,4),(128,512,32,8,8,2),(128,256,32,8,4,3),(64,128,64,8,4,5),(128,256,32,16,8,3),(128,128,64,8,8,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.996278, "o", "> "]
[801.99631, "o", "    BM,BN,BK,G,w,s = cfg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.996341, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.996374, "o", "> "]
[801.996412, "o", "        o = run_b(BM,BN,BK,G,w,s)\r\n\u001b[?2004l\r"]
[801.996442, "o", "\u001b[?2004h> "]
[801.996586, "o", "        print(f'B cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_b(BM,BN,BK,G,w,s))}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.996645, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[801.996674, "o", "\u001b[?2004h> "]
[801.99675, "o", "        print(f'B cfg {cfg} failed: {str(ex)[:70]}')\r\n\u001b[?2004l\r"]
[801.996778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[801.996805, "o", "> "]
[801.996834, "o", "# TMA persistent variant\r\n\u001b[?2004l\r"]
[801.996866, "o", "\u001b[?2004h> "]
[801.996919, "o", "def alloc_fn(size, alignment, stream):\r\n\u001b[?2004l\r"]
[801.996948, "o", "\u001b[?2004h> "]
[801.997038, "o", "    return torch.empty(size, dtype=torch.int8, device='cuda')\r\n\u001b[?2004l\r"]
[801.99707, "o", "\u001b[?2004h> "]
[801.997112, "o", "triton.set_allocator(alloc_fn)\r\n\u001b[?2004l\r"]
[801.997142, "o", "\u001b[?2004h> "]
[801.997241, "o", "NUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r"]
[801.997269, "o", "\u001b[?2004h> "]
[801.9973, "o", "print('NUM_SMS', NUM_SMS)\r\n\u001b[?2004l\r"]
[801.997332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[801.997362, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[801.997391, "o", "\u001b[?2004h> "]
[801.997467, "o", "def gemm_tma(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\r\n\u001b[?2004l\r"]
[801.997498, "o", "\u001b[?2004h> "]
[801.997661, "o", "             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr, NUM_SMS: tl.constexpr):\r\n\u001b[?2004l\r"]
[801.997692, "o", "\u001b[?2004h> "]
[801.997825, "o", "    aH = tl.make_tensor_descriptor(AH, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[801.997857, "o", "\u001b[?2004h> "]
[801.997984, "o", "    aL = tl.make_tensor_descriptor(AL, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[801.998016, "o", "\u001b[?2004h> "]
[801.99815, "o", "    wH = tl.make_tensor_descriptor(WH, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\r\n\u001b[?2004l\r"]
[801.998183, "o", "\u001b[?2004h> "]
[801.998322, "o", "    wL = tl.make_tensor_descriptor(WL, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\r\n\u001b[?2004l\r\u001b[?2004h"]
[801.998353, "o", "> "]
[801.998483, "o", "    cD = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\r\n\u001b[?2004l\r"]
[801.998512, "o", "\u001b[?2004h> "]
[801.998557, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[801.998585, "o", "\u001b[?2004h> "]
[801.998662, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[801.998693, "o", "\u001b[?2004h> "]
[801.998738, "o", "    num_tiles = grid_m * grid_n\r\n\u001b[?2004l\r"]
[801.998767, "o", "\u001b[?2004h> "]
[801.998877, "o", "    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True):\r\n\u001b[?2004l\r"]
[801.998906, "o", "\u001b[?2004h> "]
[801.998947, "o", "        width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[801.998976, "o", "\u001b[?2004h> "]
[801.999026, "o", "        group_id = tile_id // width\r\n\u001b[?2004l\r"]
[801.999058, "o", "\u001b[?2004h> "]
[801.999157, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[801.999186, "o", "\u001b[?2004h> "]
[801.99927, "o", "        pid_m = group_id * GROUP + (tile_id % group_size)\r\n\u001b[?2004l\r"]
[801.999302, "o", "\u001b[?2004h> "]
[801.999369, "o", "        pid_n = (tile_id % width) // group_size\r\n\u001b[?2004l\r"]
[801.999398, "o", "\u001b[?2004h> "]
[801.999429, "o", "        off_m = pid_m * BM\r\n\u001b[?2004l\r"]
[801.99946, "o", "\u001b[?2004h> "]
[801.999491, "o", "        off_n = pid_n * BN\r\n\u001b[?2004l\r"]
[801.999511, "o", "\u001b[?2004h> "]
[801.999594, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[801.999626, "o", "\u001b[?2004h> "]
[801.999666, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[801.999695, "o", "\u001b[?2004h> "]
[801.999748, "o", "            ah = aH.load([off_m, k])\r\n\u001b[?2004l\r"]
[801.999777, "o", "\u001b[?2004h> "]
[801.999829, "o", "            al = aL.load([off_m, k])\r\n\u001b[?2004l\r"]
[801.999857, "o", "\u001b[?2004h> "]
[801.999908, "o", "            bh = wH.load([off_n, k])\r\n\u001b[?2004l\r"]
[801.999933, "o", "\u001b[?2004h> "]
[801.999988, "o", "            bl = wL.load([off_n, k])\r\n\u001b[?2004l\r"]
[802.000017, "o", "\u001b[?2004h> "]
[802.000065, "o", "            bht = tl.trans(bh)\r\n\u001b[?2004l\r"]
[802.000097, "o", "\u001b[?2004h> "]
[802.000144, "o", "            acc = tl.dot(ah, bht, acc)\r\n\u001b[?2004l\r"]
[802.000175, "o", "\u001b[?2004h> "]
[802.000223, "o", "            acc = tl.dot(al, bht, acc)\r\n\u001b[?2004l\r"]
[802.000262, "o", "\u001b[?2004h> "]
[802.000324, "o", "            acc = tl.dot(ah, tl.trans(bl), acc)\r\n\u001b[?2004l\r"]
[802.000355, "o", "\u001b[?2004h> "]
[802.000402, "o", "        rn = off_n + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[802.000431, "o", "\u001b[?2004h> "]
[802.000474, "o", "        bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[802.000505, "o", "\u001b[?2004h> "]
[802.000571, "o", "        acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[802.000603, "o", "\u001b[?2004h> "]
[802.00065, "o", "        cD.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[802.000679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.000742, "o", "def run_tma(BM, BN, BK, G, w, s):\r\n\u001b[?2004l\r"]
[802.000769, "o", "\u001b[?2004h> "]
[802.0008, "o", "    n = M * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[802.000939, "o", "    split_kernel[(triton.cdiv(n, 8192),)](x, XH, XL, n, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r"]
[802.000968, "o", "\u001b[?2004h> "]
[802.001047, "o", "    num_tiles = triton.cdiv(M, BM) * triton.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[802.001082, "o", "\u001b[?2004h> "]
[802.001136, "o", "    grid = (min(NUM_SMS, num_tiles),)\r\n\u001b[?2004l\r"]
[802.001164, "o", "\u001b[?2004h> "]
[802.001328, "o", "    gemm_tma[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, NUM_SMS, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[802.001359, "o", "\u001b[?2004h> "]
[802.00139, "o", "    return C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[802.001421, "o", "> "]
