[1250.933635, "o", "\u001b[?2004h> "]
[1250.93369, "o", "        if torch.cuda.is_available():\r\n\u001b[?2004l\r"]
[1250.933718, "o", "\u001b[?2004h> "]
[1250.933753, "o", "            try:\r\n\u001b[?2004l\r"]
[1250.933768, "o", "\u001b[?2004h> "]
[1250.933824, "o", "                self._prepare_and_tune()\r\n\u001b[?2004l\r"]
[1250.933853, "o", "\u001b[?2004h> "]
[1250.933895, "o", "            except Exception:\r\n\u001b[?2004l\r"]
[1250.933923, "o", "\u001b[?2004h> "]
[1250.933955, "o", "                pass\r\n\u001b[?2004l\r"]
[1250.933983, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.934013, "o", "> "]
[1250.934043, "o", "    def _split_weights(self):\r\n\u001b[?2004l\r"]
[1250.934072, "o", "\u001b[?2004h> "]
[1250.934129, "o", "        w = self.matmul.weight.detach()\r\n\u001b[?2004l\r"]
[1250.934158, "o", "\u001b[?2004h> "]
[1250.934188, "o", "        wh = w.half()\r\n\u001b[?2004l\r"]
[1250.934217, "o", "\u001b[?2004h> "]
[1250.934268, "o", "        wl = (w - wh.float()).half()\r\n\u001b[?2004l\r"]
[1250.934301, "o", "\u001b[?2004h> "]
[1250.934355, "o", "        self._wh = wh.contiguous()\r\n\u001b[?2004l\r"]
[1250.934387, "o", "\u001b[?2004h> "]
[1250.934432, "o", "        self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[1250.93446, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.93449, "o", "> "]
[1250.934551, "o", "    def _run_cfg(self, cfg, XH, XL, C, M, N, K):\r\n\u001b[?2004l\r"]
[1250.934577, "o", "\u001b[?2004h> "]
[1250.934636, "o", "        BM, BN, BK, G, w, s, acc3 = cfg\r\n\u001b[?2004l\r"]
[1250.934659, "o", "\u001b[?2004h> "]
[1250.934749, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1250.934778, "o", "\u001b[?2004h> "]
[1250.934891, "o", "        _gemm_fp16x3[grid](XH, XL, self._wh, self._wl, self.matmul.bias, C,\r\n\u001b[?2004l\r"]
[1250.934919, "o", "\u001b[?2004h> "]
[1250.935022, "o", "                           M, N, K, self._alpha, BM, BN, BK, G, acc3,\r\n\u001b[?2004l\r"]
[1250.935051, "o", "\u001b[?2004h> "]
[1250.93513, "o", "                           num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[1250.935158, "o", "\u001b[?2004h> "]
[1250.935189, "o", "        return C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1250.935219, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1250.935267, "o", "    def _prepare_and_tune(self):\r\n\u001b[?2004l\r"]
[1250.935297, "o", "\u001b[?2004h> "]
[1250.935344, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[1250.935373, "o", "\u001b[?2004h> "]
[1250.935405, "o", "        K = w.shape[1]\r\n\u001b[?2004l\r"]
[1250.935435, "o", "\u001b[?2004h> "]
[1250.935466, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.935497, "o", "> "]
[1250.93553, "o", "        M = 16384\r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.93556, "o", "> "]
[1250.935591, "o", "        self._split_weights()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1250.935633, "o", "        dev = w.device\r\n\u001b[?2004l\r"]
[1250.935657, "o", "\u001b[?2004h> "]
[1250.935756, "o", "        XH = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1250.935784, "o", "\u001b[?2004h> "]
[1250.935878, "o", "        XL = torch.empty(M, K, device=dev, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1250.935909, "o", "\u001b[?2004h> "]
[1250.936001, "o", "        C = torch.empty(M, N, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1250.93603, "o", "\u001b[?2004h> "]
[1250.936093, "o", "        # pre-compile all candidate configs\r\n\u001b[?2004l\r"]
[1250.936122, "o", "\u001b[?2004h> "]
[1250.936161, "o", "        for cfg in _CONFIGS:\r\n\u001b[?2004l\r"]
[1250.93619, "o", "\u001b[?2004h> "]
[1250.936275, "o", "            self._run_cfg(cfg, XH, XL, C, M, N, K)\r\n\u001b[?2004l\r"]
[1250.936306, "o", "\u001b[?2004h> "]
[1250.93635, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1250.936381, "o", "\u001b[?2004h> "]
[1250.936409, "o", "        # tune\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1250.936454, "o", "        best_t = None\r\n\u001b[?2004l\r"]
[1250.936482, "o", "\u001b[?2004h> "]
[1250.936522, "o", "        for cfg in _CONFIGS:\r\n\u001b[?2004l\r"]
[1250.93655, "o", "\u001b[?2004h> "]
[1250.936579, "o", "            ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.93661, "o", "> "]
[1250.936642, "o", "            for _ in range(5):\r\n\u001b[?2004l\r"]
[1250.936672, "o", "\u001b[?2004h> "]
[1250.936731, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1250.936759, "o", "\u001b[?2004h> "]
[1250.936848, "o", "                s_ev = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1250.936876, "o", "\u001b[?2004h> "]
[1250.936965, "o", "                e_ev = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1250.936993, "o", "\u001b[?2004h> "]
[1250.937035, "o", "                s_ev.record()\r\n\u001b[?2004l\r"]
[1250.937064, "o", "\u001b[?2004h> "]
[1250.937144, "o", "                self._run_cfg(cfg, XH, XL, C, M, N, K)\r\n\u001b[?2004l\r"]
[1250.937166, "o", "\u001b[?2004h> "]
[1250.937212, "o", "                e_ev.record()\r\n\u001b[?2004l\r"]
[1250.937241, "o", "\u001b[?2004h> "]
[1250.937299, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1250.937327, "o", "\u001b[?2004h> "]
[1250.937407, "o", "                ts.append(s_ev.elapsed_time(e_ev))\r\n\u001b[?2004l\r"]
[1250.93743, "o", "\u001b[?2004h> "]
[1250.937475, "o", "            t = sorted(ts)[2]\r\n\u001b[?2004l\r"]
[1250.937504, "o", "\u001b[?2004h> "]
[1250.937568, "o", "            if best_t is None or t < best_t:\r\n\u001b[?2004l\r"]
[1250.937598, "o", "\u001b[?2004h> "]
[1250.937639, "o", "                best_t = t\r\n\u001b[?2004l\r"]
[1250.937667, "o", "\u001b[?2004h> "]
[1250.937712, "o", "                self._best = cfg\r\n\u001b[?2004l\r"]
[1250.937741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.937769, "o", "> "]
[1250.937798, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1250.937828, "o", "\u001b[?2004h> "]
[1250.937871, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[1250.937899, "o", "\u001b[?2004h> "]
[1250.937931, "o", "        N, K = w.shape\r\n\u001b[?2004l\r"]
[1250.937962, "o", "\u001b[?2004h> "]
[1250.937992, "o", "        x2 = x.reshape(-1, K)\r\n\u001b[?2004l\r"]
[1250.93802, "o", "\u001b[?2004h> "]
[1250.938056, "o", "        M = x2.shape[0]\r\n\u001b[?2004l\r"]
[1250.938087, "o", "\u001b[?2004h> "]
[1250.93817, "o", "        if self._wh is None or self._wh.device != x.device:\r\n\u001b[?2004l\r"]
[1250.938199, "o", "\u001b[?2004h> "]
[1250.938246, "o", "            self._split_weights()\r\n\u001b[?2004l\r"]
[1250.938274, "o", "\u001b[?2004h> "]
[1250.938371, "o", "        if (K % 64) or (N % 64) or x2.dtype != torch.float32:\r\n\u001b[?2004l\r"]
[1250.938397, "o", "\u001b[?2004h> "]
[1250.938476, "o", "            # fallback: exact fp32 computation fused\r\n\u001b[?2004l\r"]
[1250.938498, "o", "\u001b[?2004h> "]
[1250.938587, "o", "            y = torch.addmm(self.matmul.bias, x2, w.t())\r\n\u001b[?2004l\r"]
[1250.938616, "o", "\u001b[?2004h> "]
[1250.938708, "o", "            return (y * self._alpha).reshape(*x.shape[:-1], N)\r\n\u001b[?2004l\r"]
[1250.938735, "o", "\u001b[?2004h> "]
[1250.938839, "o", "        XH = torch.empty(M, K, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1250.938868, "o", "\u001b[?2004h> "]
[1250.93897, "o", "        XL = torch.empty(M, K, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1250.938998, "o", "\u001b[?2004h> "]
[1250.939029, "o", "        n = M * K\r\n\u001b[?2004l\r\u001b[?2004h"]
[1250.939059, "o", "> "]
[1250.939185, "o", "        _split_fp16_kernel[(triton.cdiv(n, 8192),)](x2, XH, XL, n, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r"]
[1250.939215, "o", "\u001b[?2004h> "]
[1250.939316, "o", "        C = torch.empty(M, N, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1250.93935, "o", "\u001b[?2004h> "]
[1250.939428, "o", "        self._run_cfg(self._best, XH, XL, C, M, N, K)\r\n\u001b[?2004l\r"]
[1250.939457, "o", "\u001b[?2004h> "]
[1250.939521, "o", "        return C.reshape(*x.shape[:-1], N)\r\n\u001b[?2004l\r"]
[1250.939547, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1250.941038, "o", "\u001b[?2004hroot@modal:/# "]
