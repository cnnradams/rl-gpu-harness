[683.018186, "o", "\u001b[?2004h> "]
[683.018237, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[683.018251, "o", "\u001b[?2004h> "]
[683.018341, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[683.01836, "o", "\u001b[?2004h> "]
[683.018405, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[683.018419, "o", "\u001b[?2004h> "]
