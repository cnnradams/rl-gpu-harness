[801.985599, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = nn.Linear(K, N).cuda()\nW, b = lin.weight, lin.bias\nsf = 0.5\nalpha = 1.0 + sf\ny = lin(x)\nout_ref = y * sf + y.clone().detach()\n\ndef err(o):\n    return (o.double() - out_ref.double()).abs().max().item()\n\nWh = W.detach().half().contiguous()\nWl = (W.detach() - Wh.float()).half().contiguous()\nXH = torch.empty(M, K, device='cuda', dtype=torch.float16)\nXL = torch.empty(M, K, device='cuda', dtype=torch.float16)\nC = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\n@triton.jit\ndef split_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n\n    v = tl.load(X + offs, mask=m)\n    vh = v.to(tl.float16)\n    vl = (v - vh.to(tl.float32)).to(tl.float16)\n    tl.store(XH + offs, vh, mask=m)\n    tl.store(XL + offs, vl, mask=m)\n\n@triton.jit\ndef gemm_b("]
[801.985647, "i", "AH, AL, WH, WL, Bias, C, M, N, K, sam, sak, swn, swk, scm, scn, alpha,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\n    AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\n    WH_ptr = WH + rn[None, :] * swn + rk[:, None] * swk\n    WL_ptr = WL + rn[None, :] * swn + rk[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(AH_ptr)\n        al = tl.load(AL_ptr)\n        bh = tl.load(WH_ptr)\n        bl = tl.load(WL_ptr)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al,"]
[801.985654, "i", " bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        AH_ptr += BK * sak\n        AL_ptr += BK * sak\n        WH_ptr += BK * swk\n        WL_ptr += BK * swk\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef run_b(BM, BN, BK, G, w, s):\n    n = M * K\n    split_kernel[(triton.cdiv(n, 8192),)](x, XH, XL, n, BLOCK=8192, num_warps=8)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    gemm_b[grid](XH, XL, Wh, Wl, b, C, M, N, K, K, 1, K, 1, N, 1, alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\n    return C\n\ndef timeit(fn, iters=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda."]
[801.98566, "i", "synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return round(ts[len(ts)//2], 3), round(ts[0], 3)\n\nfor cfg in [(128,256,32,8,8,3),(128,256,64,8,8,2),(128,256,32,4,8,4),(64,256,32,8,4,4),(128,512,32,8,8,2),(128,256,32,8,4,3),(64,128,64,8,4,5),(128,256,32,16,8,3),(128,128,64,8,8,4)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_b(BM,BN,BK,G,w,s)\n        print(f'B cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_b(BM,BN,BK,G,w,s))}')\n    except Exception as ex:\n        print(f'B cfg {cfg} failed: {str(ex)[:70]}')\n\n# TMA persistent variant\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, dtype=torch.int8, device='cuda')\ntriton.set_allocator(alloc_fn)\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\nprint('NUM_SMS', NUM_SMS)\n\n@triton.jit\ndef gemm_tma(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr, NUM_SMS: tl.constexpr):\n    aH = tl.make_tensor_descriptor(AH, shape=[M, K"]
[801.985759, "i", "], strides=[K, 1], block_shape=[BM, BK])\n    aL = tl.make_tensor_descriptor(AL, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    wH = tl.make_tensor_descriptor(WH, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\n    wL = tl.make_tensor_descriptor(WL, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\n    cD = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    start_pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    num_tiles = grid_m * grid_n\n    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True):\n        width = GROUP * grid_n\n        group_id = tile_id // width\n        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n        pid_m = group_id * GROUP + (tile_id % group_size)\n        pid_n = (tile_id % width) // group_size\n        off_m = pid_m * BM\n        off_n = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            ah = aH.load([off_m, k])\n            a"]
[801.985772, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r"]
[801.985804, "i", "l = aL.load([off_m, k])\n            bh = wH.load([off_n, k])\n            bl = wL.load([off_n, k])\n            bht = tl.trans(bh)\n            acc = tl.dot(ah, bht, acc)\n            acc = tl.dot(al, bht, acc)\n            acc = tl.dot(ah, tl.trans(bl), acc)\n        rn = off_n + tl.arange(0, BN)\n        bias = tl.load(Bias + rn)\n        acc = acc * alpha + alpha * bias[None, :]\n        cD.store([off_m, off_n], acc)\n\ndef run_tma(BM, BN, BK, G, w, s):\n    n = M * K\n    split_kernel[(triton.cdiv(n, 8192),)](x, XH, XL, n, BLOCK=8192, num_warps=8)\n    num_tiles = triton.cdiv(M, BM) * triton.cdiv(N, BN)\n    grid = (min(NUM_SMS, num_tiles),)\n    gemm_tma[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, NUM_SMS, num_warps=w, num_stages=s)\n    return C\n\nfor cfg in [(128,256,64,8,8,3),(128,128,64,8,8,3),(128,256,32,8,8,3),(256,128,64,8,8,3),(128,256,64,8,8,4)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_tma(BM,BN,BK,G,w,s)\n        print(f'TMA cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_tma(BM,BN,BK,"]
[801.985828, "o", "\u001b[?2004h> "]
