[927.388176, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[927.388206, "o", "\u001b[?2004h> "]
[927.388423, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h"]
[927.388435, "o", "> "]
[927.38861, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[927.388641, "o", "\u001b[?2004h> "]
[927.388761, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\rl"]
[927.388793, "o", "\u001b[?2004h> "]
[927.388911, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[927.388934, "o", "\u001b[?2004h> "]
[927.389075, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\rK"]
[927.389103, "o", "\u001b[?2004h> "]
[927.389174, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[927.389203, "o", "\u001b[?2004h> "]
[927.389343, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[927.389367, "o", "\u001b[?2004h> "]
[927.389533, "o", "    B_ptr = B + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[927.389563, "o", "\u001b[?2004h> "]
[927.389702, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[927.389731, "o", "\u001b[?2004h> "]
[927.38981, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[927.389838, "o", "\u001b[?2004h> "]
[927.38991, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[927.38994, "o", "\u001b[?2004h> "]
[927.390032, "o", "        bb = tl.load(B_ptr)\r\n\u001b[?2004l\rB\u001b[?2004h"]
[927.390061, "o", "> "]
[927.390152, "o", "        acc = tl.dot(a, bb, acc)\r\n\u001b[?2004l\r"]
[927.390185, "o", "\u001b[?2004h> "]
[927.390237, "o", "        A_ptr += BK\r\n\u001b[?2004l\rW\u001b[?2004h"]
[927.390266, "o", "> "]
[927.390317, "o", "        B_ptr += BK\r\n\u001b[?2004l\r"]
[927.390351, "o", "\u001b[?2004h> "]
[927.390484, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[927.390519, "o", "\u001b[?2004h> "]
[927.390587, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\rh"]
[927.390614, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h"]
[927.390634, "o", "> "]
[927.390864, "o", "for cfg in [(128,256,32,8,8,3),(128,256,64,8,8,2),(128,128,64,8,8,3)]:\r\n\u001b[?2004l\r"]
[927.390899, "o", "\u001b[?2004h> "]
[927.390982, "o", "    BM,BN,BK,G,w,s = cfg\r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[927.391011, "o", "> "]
[927.391042, "o", "    try:\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[927.39121, "o", "        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[927.391239, "o", "\u001b[?2004h> "]
[927.391537, "o", "        fn = lambda: gemm1[grid](XH, Wh, C, M, N, K, BM, BN, BK, G, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[927.391569, "o", "> "]
[927.391594, "o", "        fn()\r\n\u001b[?2004l\r"]
[927.391627, "o", "\u001b[?2004h> "]
[927.391783, "o", "        print(f'1dot cfg {cfg}: ms {timeit(fn)}')\r\n\u001b[?2004l\r"]
[927.39182, "o", "\u001b[?2004h> "]
[927.391894, "o", "    except Exception as ex:\r\n\u001b[?2004l\r,\u001b[?2004h"]
[927.391924, "o", "> "]
[927.392087, "o", "        print(f'1dot cfg {cfg} failed: {str(ex)[:70]}')\r\n\u001b[?2004l\r"]
[927.392115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[927.392144, "o", "> "]
[927.39231, "o", "# 2) TMA loads + pointer store, persistent 3-dot\r\n\u001b[?2004l\r"]
[927.392341, "o", "\u001b[?2004h> "]
[927.392369, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[927.392401, "o", "> "]
[927.392571, "o", "def gemm_tma2(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\r\n\u001b[?2004l\r"]
[927.392604, "o", "\u001b[?2004h> "]
[927.392963, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr, NUM_SMS: tl.constexpr):\r\n\u001b[?2004l\r"]
[927.392998, "o", "\u001b[?2004h> "]
[927.393273, "o", "    aH = tl.make_tensor_descriptor(AH, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[927.393307, "o", "\u001b[?2004h> "]
[927.393483, "o", "    aL = tl.make_tensor_descriptor(AL, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[927.393501, "o", "\u001b[?2004h> "]
[927.39364, "o", "    wH = tl.make_tensor_descriptor(WH, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\r\n\u001b[?2004l\r"]
[927.393672, "o", "\u001b[?2004h"]
[927.393704, "o", "> "]
[927.393805, "o", "    wL = tl.make_tensor_descriptor(WL, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\r\n\u001b[?2004l\r"]
[927.393837, "o", "\u001b[?2004h> "]
[927.393878, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[927.39391, "o", "\u001b[?2004h> "]
[927.393982, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[927.394011, "o", "\u001b[?2004h> "]
[927.394053, "o", "    num_tiles = grid_m * grid_n\r\n\u001b[?2004l\r"]
[927.394085, "o", "\u001b[?2004h> "]
[927.394189, "o", "    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True):\r\n\u001b[?2004l\r"]
[927.39422, "o", "\u001b[?2004h> "]
[927.39426, "o", "        width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[927.39429, "o", "\u001b[?2004h> "]
[927.394337, "o", "        group_id = tile_id // width\r\n\u001b[?2004l\r"]
[927.394367, "o", "\u001b[?2004h> "]
[927.394469, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[927.394494, "o", "\u001b[?2004h> "]
[927.394581, "o", "        pid_m = group_id * GROUP + (tile_id % group_size)\r\n\u001b[?2004l\r"]
[927.394611, "o", "\u001b[?2004h> "]
[927.394678, "o", "        pid_n = (tile_id % width) // group_size\r\n\u001b[?2004l\r"]
[927.394708, "o", "\u001b[?2004h> "]
[927.39474, "o", "        off_m = pid_m * BM\r\n\u001b[?2004l\r"]
[927.394769, "o", "\u001b[?2004h> "]
[927.394801, "o", "        off_n = pid_n * BN\r\n\u001b[?2004l\r"]
[927.394834, "o", "\u001b[?2004h> "]
[927.394904, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[927.394928, "o", "\u001b[?2004h> "]
[927.394979, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[927.395005, "o", "\u001b[?2004h> "]
[927.395056, "o", "            ah = aH.load([off_m, k])\r\n\u001b[?2004l\r"]
[927.395086, "o", "\u001b[?2004h> "]
[927.395136, "o", "            al = aL.load([off_m, k])\r\n\u001b[?2004l\r"]
[927.395161, "o", "\u001b[?2004h> "]
[927.395214, "o", "            bh = wH.load([off_n, k])\r\n\u001b[?2004l\r"]
[927.395246, "o", "\u001b[?2004h> "]
[927.395295, "o", "            bl = wL.load([off_n, k])\r\n\u001b[?2004l\r"]
[927.395326, "o", "\u001b[?2004h> "]
[927.395363, "o", "            bht = tl.trans(bh)\r\n\u001b[?2004l\r"]
[927.395395, "o", "\u001b[?2004h> "]
[927.395451, "o", "            acc = tl.dot(ah, bht, acc)\r\n\u001b[?2004l\r"]
[927.395476, "o", "\u001b[?2004h> "]
[927.395533, "o", "            acc = tl.dot(al, bht, acc)\r\n\u001b[?2004l\r"]
[927.395567, "o", "\u001b[?2004h> "]
[927.395629, "o", "            acc = tl.dot(ah, tl.trans(bl), acc)\r\n\u001b[?2004l\r"]
[927.395659, "o", "\u001b[?2004h> "]
[927.39571, "o", "        rn = off_n + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[927.395737, "o", "\u001b[?2004h> "]
[927.39579, "o", "        rm = off_m + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[927.395823, "o", "\u001b[?2004h> "]
[927.395867, "o", "        bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[927.395898, "o", "\u001b[?2004h> "]
[927.395965, "o", "        acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[927.396001, "o", "\u001b[?2004h> "]
[927.396065, "o", "        C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[927.396092, "o", "\u001b[?2004h> "]
[927.396131, "o", "        tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[927.396163, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[927.396227, "o", "def run_tma2(BM, BN, BK, G, w, s):\r\n\u001b[?2004l\r"]
[927.396264, "o", "\u001b[?2004h> "]
[927.396346, "o", "    num_tiles = triton.cdiv(M, BM) * triton.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[927.396377, "o", "\u001b[?2004h> "]
[927.39644, "o", "    grid = (min(NUM_SMS, num_tiles),)\r\n\u001b[?2004l\r"]
[927.396471, "o", "\u001b[?2004h> "]
[927.396635, "o", "    gemm_tma2[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, NUM_SMS, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[927.396667, "o", "\u001b[?2004h>     return C\r\n\u001b[?2004l\r"]
[927.39669, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[927.39672, "o", "\u001b[?2004h> "]
[927.396916, "o", "for cfg in [(128,256,32,8,8,3),(128,256,64,8,8,2),(128,128,64,8,8,3),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,128,8,8,2)]:\r\n\u001b[?2004l\r"]
[927.396949, "o", "\u001b[?2004h> "]
[927.396976, "o", "    BM,BN,BK,G,w,s = cfg\r\n\u001b[?2004l\r"]
[927.397007, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[927.397039, "o", "\u001b[?2004h> "]
[927.397089, "o", "        o = run_tma2(BM,BN,BK,G,w,s)\r\n\u001b[?2004l\r"]
[927.397121, "o", "\u001b[?2004h> "]
[927.397265, "o", "        print(f'TMA2 cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_tma2(BM,BN,BK,G,w,s))}')\r\n\u001b[?2004l\r"]
[927.397297, "o", "\u001b[?2004h> "]
[927.397329, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[927.397358, "o", "\u001b[?2004h> "]
[927.397439, "o", "        print(f'TMA2 cfg {cfg} failed: {str(ex)[:70]}')\r\n\u001b[?2004l\r"]
[927.397464, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[927.397496, "o", "> "]
[927.397556, "o", "# 3) 3 independent accumulators, 128x128 classic\r\n\u001b[?2004l\r"]
[927.397586, "o", "\u001b[?2004h> "]
[927.397612, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[927.397698, "o", "def gemm_acc3(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\r\n\u001b[?2004l\r"]
[927.397725, "o", "\u001b[?2004h> "]
[927.39786, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[927.397887, "o", "\u001b[?2004h> "]
[927.397923, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[927.397955, "o", "\u001b[?2004h> "]
[927.398029, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[927.398056, "o", "\u001b[?2004h> "]
[927.398092, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[927.398124, "o", "\u001b[?2004h> "]
[927.398155, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[927.398188, "o", "\u001b[?2004h> "]
[927.398278, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[927.398308, "o", "\u001b[?2004h> "]
[927.398378, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[927.398405, "o", "\u001b[?2004h> "]
[927.398472, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[927.398502, "o", "\u001b[?2004h> "]
[927.398554, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[927.398583, "o", "\u001b[?2004h> "]
[927.398636, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[927.398668, "o", "\u001b[?2004h> "]
[927.3987, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[927.398733, "o", "\u001b[?2004h> "]
[927.398801, "o", "    AH_ptr = AH + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[927.39883, "o", "\u001b[?2004h> "]
[927.398897, "o", "    AL_ptr = AL + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[927.398927, "o", "\u001b[?2004h> "]
[927.398994, "o", "    WH_ptr = WH + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[927.399019, "o", "\u001b[?2004h> "]
[927.39909, "o", "    WL_ptr = WL + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[927.399121, "o", "\u001b[?2004h> "]
[927.399188, "o", "    acc0 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[927.399218, "o", "\u001b[?2004h> "]
[927.399285, "o", "    acc1 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[927.399309, "o", "\u001b[?2004h> "]
[927.399381, "o", "    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[927.399412, "o", "\u001b[?2004h> "]
[927.399449, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[927.399482, "o", "\u001b[?2004h> "]
[927.399514, "o", "        ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r"]
[927.399547, "o", "\u001b[?2004h> "]
[927.399588, "o", "        al = tl.load(AL_ptr)\r\n\u001b[?2004l\r"]
[927.399621, "o", "\u001b[?2004h> "]
[927.399648, "o", "        bh = tl.load(WH_ptr)\r\n\u001b[?2004l\r"]
[927.399675, "o", "\u001b[?2004h> "]
[927.399719, "o", "        bl = tl.load(WL_ptr)\r\n\u001b[?2004l\r"]
[927.399743, "o", "\u001b[?2004h> "]
[927.399797, "o", "        acc0 = tl.dot(ah, bh, acc0)\r\n\u001b[?2004l\r"]
[927.399826, "o", "\u001b[?2004h> "]
[927.399874, "o", "        acc1 = tl.dot(al, bh, acc1)\r\n\u001b[?2004l\r"]
[927.399905, "o", "\u001b[?2004h> "]
[927.399952, "o", "        acc2 = tl.dot(ah, bl, acc2)\r\n\u001b[?2004l\r"]
[927.399982, "o", "\u001b[?2004h> "]
[927.400008, "o", "        AH_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[927.400036, "o", "> "]
[927.400064, "o", "        AL_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[927.400096, "o", "> "]
[927.400129, "o", "        WH_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[927.40016, "o", "        WL_ptr += BK\r\n\u001b[?2004l\r"]
[927.400192, "o", "\u001b[?2004h> "]
[927.400229, "o", "    acc = acc0 + acc1 + acc2\r\n\u001b[?2004l\r"]
[927.400249, "o", "\u001b[?2004h"]
[927.400275, "o", "> "]
[927.400302, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[927.400334, "o", "\u001b[?2004h> "]
[927.400398, "o", "    acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[927.400435, "o", "\u001b[?2004h> "]
[927.400496, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[927.400528, "o", "\u001b[?2004h> "]
[927.400558, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[927.400589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[927.400651, "o", "def run_acc3(BM, BN, BK, G, w, s):\r\n\u001b[?2004l\r"]
[927.400682, "o", "\u001b[?2004h> "]
[927.400761, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[927.40079, "o", "\u001b[?2004h> "]
