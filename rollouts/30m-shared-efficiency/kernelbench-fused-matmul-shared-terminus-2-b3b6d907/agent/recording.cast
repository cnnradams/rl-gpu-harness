[683.019118, "o", "    AH_ptr = AH + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[683.019132, "o", "\u001b[?2004h> "]
[683.019227, "o", "    AL_ptr = AL + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[683.019248, "o", "\u001b[?2004h> "]
[683.019337, "o", "    WH_ptr = WH + rn[None, :] * swn + rk[:, None] * swk\r\n\u001b[?2004l\r"]
[683.019351, "o", "\u001b[?2004h> "]
[683.019446, "o", "    WL_ptr = WL + rn[None, :] * swn + rk[:, None] * swk\r\n\u001b[?2004l\r"]
[683.019461, "o", "\u001b[?2004h> "]
[683.019542, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[683.01956, "o", "\u001b[?2004h> "]
[683.019611, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[683.019626, "o", "\u001b[?2004h> "]
[683.019679, "o", "        ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r"]
