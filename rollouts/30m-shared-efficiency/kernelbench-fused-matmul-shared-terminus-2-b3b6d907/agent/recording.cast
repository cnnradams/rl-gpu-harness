[1349.63865, "o", "> "]
[1349.638782, "o", "Xh = x.half(); XH = Xh.contiguous(); XL = (x - Xh.float()).half().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1349.638797, "o", "> "]
[1349.638881, "o", "C = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1349.638904, "o", "\u001b[?2004h> "]
[1349.638918, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1349.638932, "o", "> "]
[1349.638973, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r"]
[1349.638988, "o", "\u001b[?2004h> "]
[1349.639037, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[1349.639052, "o", "\u001b[?2004h> "]
[1349.639103, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1349.639118, "o", "\u001b[?2004h> "]
[1349.639239, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1349.639253, "o", "\u001b[?2004h> "]
[1349.639277, "o", "    ts = []\r\n\u001b[?2004l\r"]
[1349.639293, "o", "\u001b[?2004h> "]
[1349.639339, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[1349.639353, "o", "\u001b[?2004h> "]
[1349.639438, "o", "        dummy.fill_(42); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1349.639452, "o", "\u001b[?2004h> "]
[1349.639606, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1349.63962, "o", "\u001b[?2004h> "]
[1349.639725, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1349.639745, "o", "\u001b[?2004h> "]
[1349.639803, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1349.639818, "o", "\u001b[?2004h> "]
[1349.639846, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[1349.639866, "o", "\u001b[?2004h> "]
[1349.639949, "o", "    return round(ts[len(ts)//2], 3), round(ts[0], 3)\r\n\u001b[?2004l\r"]
[1349.639964, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1349.639979, "o", "\u001b[?2004h"]
[1349.639992, "o", "> "]
[1349.640007, "o", "def run(cfg):\r\n\u001b[?2004l\r"]
