[683.017102, "o", "\u001b[?2004h"]
[683.017117, "o", "> "]
[683.017196, "o", "def split_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[683.01721, "o", "\u001b[?2004h> "]
[683.01726, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[683.017278, "o", "\u001b[?2004h> "]
[683.017352, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[683.017371, "o", "\u001b[?2004h> "]
[683.017399, "o", "    m = offs < n\r\n\u001b[?2004l\r"]
[683.017412, "o", "\u001b[?2004h> "]
[683.01748, "o", "    v = tl.load(X + offs, mask=m)\r\n\u001b[?2004l\r"]
[683.017501, "o", "\u001b[?2004h> "]
[683.017544, "o", "    vh = v.to(tl.float16)\r\n\u001b[?2004l\r"]
[683.017565, "o", "\u001b[?2004h> "]
[683.017641, "o", "    vl = (v - vh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[683.017661, "o", "\u001b[?2004h> "]
[683.017724, "o", "    tl.store(XH + offs, vh, mask=m)\r\n\u001b[?2004l\r"]
[683.017745, "o", "\u001b[?2004h> "]
[683.017801, "o", "    tl.store(XL + offs, vl, mask=m)\r\n\u001b[?2004l\r"]
