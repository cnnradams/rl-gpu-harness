[1258.919781, "o", "gpu exec sb-Rw5VsPy9C81UFv19STJ4Qn -- python3 /opt/task/evaluate.py /workspace/solution.py 2>&1 | tail -45\r\n\u001b[?2004l\r"]
[1273.171781, "o", "request ID: 418c2a0b947a436981d7b56c09e4ecdd\r\ncommand: 1eff538920fe4881b6f518ab15f73df8\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.61,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.61,\r\n    \"std\": 0.0734,\r\n    \"min\": 2.54,\r\n    \"max\": 2.78,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0432,\r\n    \"min\": 11.4,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"8f74218c39fa568dfa436ec21ba7f9ea3d35d0ec4b669998f24bc34e8163a0b6\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trial"]
[1273.171837, "o", "s\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.367816091954023\r\n}\r\n"]
[1273.171985, "o", "\u001b[?2004hroot@modal:/# "]
[1349.637649, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, triton, importlib.util\nspec = importlib.util.spec_from_file_location('sol', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\nimport triton.language as tl\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nmodel = sol.ModelNew(K, N, 0.5).cuda()\nWh, Wl, b = model._wh, model._wl, model.matmul.bias\nXh = x.half(); XH = Xh.contiguous(); XL = (x - Xh.float()).half().contiguous()\nC = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\ndef timeit(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42); torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    re"]
[1349.637691, "i", "turn round(ts[len(ts)//2], 3), round(ts[0], 3)\n\ndef run(cfg):\n    BM, BN, BK, G, w, s, acc3 = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    sol._gemm_fp16x3[grid](XH, XL, Wh, Wl, b, C, M, N, K, 1.5, BM, BN, BK, G, acc3, num_warps=w, num_stages=s)\n    return C\n\nfor cfg in [(128,256,32,8,8,4,False),(128,256,32,4,8,3,False),(128,256,32,16,8,3,False),(256,128,32,8,8,4,False),(128,128,32,8,8,5,True),(128,128,32,4,8,4,True),(128,128,32,16,8,4,True),(64,256,32,8,4,4,True),(128,256,32,8,8,3,True)]:\n    try:\n        o = run(cfg)\n        print(f'cfg {cfg}: ms {timeit(lambda: run(cfg))}')\n    except Exception as ex:\n        print(f'cfg {cfg} failed: {str(ex)[:60]}')\nEOF\ngpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/bench7.py /workspace/bench7.py && gpu exec sb-Rw5VsPy9C81UFv19STJ4Qn -- python3 /workspace/bench7.py 2>&1 | tail -10\n"]
[1349.637877, "o", "cat > /workspace/bench7.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
