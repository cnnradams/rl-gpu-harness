[683.015344, "o", "\u001b[?2004h> "]
[683.015512, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[683.015527, "o", "\u001b[?2004h> "]
