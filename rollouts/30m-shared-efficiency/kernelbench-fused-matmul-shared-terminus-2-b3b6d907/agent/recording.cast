[1027.621945, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = nn.Linear(K, N).cuda()\nW, b = lin.weight, lin.bias\nsf = 0.5\nalpha = 1.0 + sf\ny = lin(x)\nout_ref = y * sf + y.clone().detach()\n\ndef err(o):\n    return (o.double() - out_ref.double()).abs().max().item()\n\nWh = W.detach().half().contiguous()\nWl = (W.detach() - Wh.float()).half().contiguous()\nXh = x.half()\nXH = Xh.contiguous()\nXL = (x - Xh.float()).half().contiguous()\nC = torch.empty(M, N, device='cuda', dtype=torch.float32)\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, dtype=torch.int8, device='cuda')\ntriton.set_allocator(alloc_fn)\nNUM_SMS = torch.cuda.get_device_properties(0).multi_processor_count\n\ndef timeit(fn, iters=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iter"]
[1027.621993, "i", "s):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return round(ts[len(ts)//2], 3), round(ts[0], 3)\n\n@triton.jit\ndef split_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n\n    v = tl.load(X + offs, mask=m)\n    vh = v.to(tl.float16)\n    vl = (v - vh.to(tl.float32)).to(tl.float16)\n    tl.store(XH + offs, vh, mask=m)\n    tl.store(XL + offs, vl, mask=m)\n\n@triton.jit\ndef gemm_tma2(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr,\n              NUM_SMS: tl.constexpr, WS: tl.constexpr):\n    aH = tl.make_tensor_descriptor(AH, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    aL = tl.make_tensor_descriptor(AL, shape=[M, K], stride"]
[1027.622001, "i", "s=[K, 1], block_shape=[BM, BK])\n    wH = tl.make_tensor_descriptor(WH, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\n    wL = tl.make_tensor_descriptor(WL, shape=[N, K], strides=[K, 1], block_shape=[BN, BK])\n    start_pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    num_tiles = grid_m * grid_n\n    for tile_id in tl.range(start_pid, num_tiles, NUM_SMS, flatten=True, warp_specialize=WS):\n        width = GROUP * grid_n\n        group_id = tile_id // width\n        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n        pid_m = group_id * GROUP + (tile_id % group_size)\n        pid_n = (tile_id % width) // group_size\n        off_m = pid_m * BM\n        off_n = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            ah = aH.load([off_m, k])\n            al = aL.load([off_m, k])\n            bh = wH.load([off_n, k])\n            bl = wL.load([off_n, k])\n            bht = tl.trans(bh)\n            acc = tl.dot(ah, bht, acc)\n  "]
[1027.62201, "i", "          acc = tl.dot(al, bht, acc)\n            acc = tl.dot(ah, tl.trans(bl), acc)\n        rn = off_n + tl.arange(0, BN)\n        rm = off_m + tl.arange(0, BM)\n        bias = tl.load(Bias + rn)\n        acc = acc * alpha + alpha * bias[None, :]\n        C_ptr = C + rm[:, None] * N + rn[None, :]\n        tl.store(C_ptr, acc)\n\ndef run_tma2(BM, BN, BK, G, w, s, ws=False):\n    n = M * K\n    split_kernel[(triton.cdiv(n, 8192),)](x, XH, XL, n, BLOCK=8192, num_warps=8)\n    num_tiles = triton.cdiv(M, BM) * triton.cdiv(N, BN)\n    grid = (min(NUM_SMS, num_tiles),)\n    gemm_tma2[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, NUM_SMS, ws, num_warps=w, num_stages=s)\n    return C\n\nfor cfg in [(128,128,32,8,8,4,False),(128,128,32,8,8,5,False),(128,128,64,8,8,2,False),(128,256,32,8,8,2,False),(128,128,32,8,8,4,True),(128,128,64,8,8,3,True),(128,256,64,8,8,3,True)]:\n    BM,BN,BK,G,w,s,ws = cfg\n    try:\n        o = run_tma2(BM,BN,BK,G,w,s,ws)\n        print(f'TMA2 cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_tma"]
[1027.622019, "i", "2(BM,BN,BK,G,w,s,ws))}')\n    except Exception as ex:\n        print(f'TMA2 cfg {cfg} failed: {str(ex)[:60]}')\n\n# inductor max-autotune fp16 mm ceiling\nimport torch._inductor.config as icfg\nicfg.max_autotune_gemm_backends = 'TRITON,ATEN'\n@torch.compile(mode='max-autotune-no-cudagraphs')\ndef f16mm(a, bb):\n    return torch.mm(a, bb.t())\ntry:\n    o = f16mm(XH, Wh)\n    print('inductor fp16 mm ms:', timeit(lambda: f16mm(XH, Wh)))\nexcept Exception as ex:\n    print('inductor failed', str(ex)[:100])\nEOF\ngpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/bench5.py /workspace/bench5.py\n"]
