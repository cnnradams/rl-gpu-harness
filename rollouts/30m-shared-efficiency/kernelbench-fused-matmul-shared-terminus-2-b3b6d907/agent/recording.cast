[328.873371, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time, triton\nimport triton.language as tl\nimport torch.nn as nn\n\nprint('torch', torch.__version__, 'triton', triton.__version__, torch.cuda.get_device_name(0))\n\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nlin = nn.Linear(K, N).cuda()\nW, b = lin.weight, lin.bias\nsf = 0.5\nalpha = 1.0 + sf\n\n# fp64 truth\nx64, W64, b64 = x.double(), W.double(), b.double()\nout64 = alpha * (x64 @ W64.t() + b64)\n\n# fp32 reference (what reference.py computes)\ny = lin(x)\nout_ref = y * sf + y.clone().detach()\n\ndef err(o):\n    o = o.double()\n    return (o - out_ref.double()).abs().max().item(), (o - out64).abs().max().item()\n\n# candidate 1: fp32 addmm fused\ntorch.backends.cuda.matmul.allow_tf32 = False\nout1 = torch.addmm(b, x, W.t(), alpha=alpha)\nprint('fp32 addmm err vs ref, vs fp64:', err(out1))\n\n# candidate 2: tf32\ntorch.backends.cuda.matmul.allow_tf32 = True\nout2 = torch.addmm(b, x, W.t(), alpha=alpha)\nprint('tf32 addmm err:', err(out2))\ntorch.b"]
[328.873416, "i", "ackends.cuda.matmul.allow_tf32 = False\n\n@triton.jit\ndef gemm_fp16x3(A, B, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn, alpha,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    B_ptr = B + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        bb = tl.load(B_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = bb.to(tl.float16)\n        bl = (bb - bh.to(tl.float32)).to(tl.float16)\n      "]
[328.873432, "i", "  bht = tl.trans(bh)\n        acc = tl.dot(ah, bht, acc)\n        acc = tl.dot(al, bht, acc)\n        acc = tl.dot(ah, tl.trans(bl), acc)\n        A_ptr += BK * sak\n        B_ptr += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef run_triton(BM=128, BN=128, BK=64, GROUP=8, warps=8, stages=3):\n    C = torch.empty(M, N, device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    gemm_fp16x3[grid](x, W, b, C, M, N, K, x.stride(0), x.stride(1), W.stride(0), W.stride(1),\n                      C.stride(0), C.stride(1), alpha, BM, BN, BK, GROUP,\n                      num_warps=warps, num_stages=stages)\n    return C\n\nout3 = run_triton()\nprint('triton fp16x3 err:', err(out3))\n\ndef timeit(fn, iters=30):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(ite"]
[328.873575, "i", "rs):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\n# reference timing\ndef ref_fn():\n    y2 = lin(x)\n    return y2 * sf + y2.clone().detach()\nprint('ref ms (median, min):', timeit(ref_fn))\ntorch.backends.cuda.matmul.allow_tf32 = False\nprint('fp32 addmm ms:', timeit(lambda: torch.addmm(b, x, W.t(), alpha=alpha)))\nfor cfg in [(128,128,64,8,8,3),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,32,8,8,4),(256,64,64,8,8,4),(128,256,32,8,8,4),(64,256,64,8,8,4),(256,256,32,8,8,3)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = run_triton(BM,BN,BK,G,w,s)\n        e_ = err(o)[0]\n        t = timeit(lambda: run_triton(BM,BN,BK,G,w,s))\n        print(f'cfg {cfg}: err {e_:.2e} ms {t}')\n    except Exception as ex:\n        print(f'cfg {cfg} failed: {ex}')\nEOF\ngpu exec sb-Rw5Vs"]
