[683.020559, "o", "\u001b[?2004h> "]
[683.020646, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[683.020665, "o", "\u001b[?2004h> "]
[683.020712, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[683.020726, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[683.020741, "o", "\u001b[?2004h"]
[683.020761, "o", "> "]
[683.020849, "o", "C = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[683.020863, "o", "\u001b[?2004h> "]
[683.020963, "o", "XH = torch.empty(M, K, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[683.020984, "o", "\u001b[?2004h> "]
[683.021078, "o", "XL = torch.empty(M, K, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[683.021095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[683.021117, "o", "\u001b[?2004h> "]
[683.021178, "o", "def run_a(BM, BN, BK, G, w, s):\r\n\u001b[?2004l\r\u001b[?2004h"]
[683.021193, "o", "> "]
[683.021282, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[683.021303, "o", "\u001b[?2004h> "]
[683.021455, "o", "    gemm_a[grid](x, Wh, Wl, b, C, M, N, K, x.stride(0), x.stride(1), W.stride(0), W.stride(1),\r\n\u001b[?2004l\r"]
[683.02147, "o", "\u001b[?2004h> "]
[683.021623, "o", "                 C.stride(0), C.stride(1), alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[683.021641, "o", "\u001b[?2004h> "]
[683.02166, "o", "    return C\r\n\u001b[?2004l\r"]
[683.021679, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[683.021697, "o", "\u001b[?2004h"]
