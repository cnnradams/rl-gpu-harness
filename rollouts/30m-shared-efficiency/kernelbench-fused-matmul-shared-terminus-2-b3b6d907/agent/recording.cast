[328.882623, "o", "for cfg in [(128,128,64,8,8,3),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,32,8,8,4),(256,64,64,8,8,4),(128,256,32,8,8,4),(64,256,64,8,8,4),(256,256,32,8,8,3)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
