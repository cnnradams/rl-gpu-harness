[1173.788316, "o", "out_ref = y * sf + y.clone().detach()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1173.78833, "o", "\u001b[?2004h"]
[1173.788361, "o", "> def errinfo(o):\r\n\u001b[?2004l\r"]
[1173.788394, "o", "\u001b[?2004h> "]
[1173.788425, "o", "    d = (o - out_ref).abs()\r\n\u001b[?2004l\r"]
[1173.788455, "o", "\u001b[?2004h> "]
[1173.788511, "o", "    tol = 1e-4 + 1e-4 * out_ref.abs()\r\n\u001b[?2004l\r"]
[1173.788541, "o", "\u001b[?2004h> "]
[1173.788585, "o", "    bad = (d > tol).sum().item()\r\n\u001b[?2004l\r"]
[1173.788615, "o", "\u001b[?2004h> "]
[1173.788656, "o", "    return d.max().item(), bad\r\n\u001b[?2004l\r"]
[1173.788683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.788712, "o", "> "]
[1173.788745, "o", "FP8 = torch.float8_e5m2\r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.788776, "o", "> "]
[1173.788799, "o", "Wh8 = W.detach().to(FP8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.788881, "o", "Wl8 = (W.detach() - Wh8.float()).to(FP8)\r\n\u001b[?2004l\r"]
[1173.788913, "o", "\u001b[?2004h> "]
[1173.788973, "o", "Wh8 = Wh8.contiguous(); Wl8 = Wl8.contiguous()\r\n\u001b[?2004l\r"]
[1173.789001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.789033, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1173.789063, "o", "\u001b[?2004h> "]
[1173.789146, "o", "def split8_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1173.789173, "o", "\u001b[?2004h> "]
[1173.789205, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1173.789237, "o", "\u001b[?2004h> "]
[1173.789301, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1173.789333, "o", "\u001b[?2004h> "]
[1173.789355, "o", "    m = offs < n\r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.789386, "o", "> "]
[1173.789428, "o", "    v = tl.load(X + offs, mask=m)\r\n\u001b[?2004l\r"]
[1173.789458, "o", "\u001b[?2004h> "]
[1173.78949, "o", "    vh = v.to(tl.float8e5)\r\n\u001b[?2004l\r"]
[1173.789521, "o", "\u001b[?2004h> "]
[1173.78959, "o", "    vl = (v - vh.to(tl.float32)).to(tl.float8e5)\r\n\u001b[?2004l\r"]
[1173.78962, "o", "\u001b[?2004h> "]
[1173.789668, "o", "    tl.store(XH + offs, vh, mask=m)\r\n\u001b[?2004l\r"]
[1173.789696, "o", "\u001b[?2004h> "]
[1173.789746, "o", "    tl.store(XL + offs, vl, mask=m)\r\n\u001b[?2004l\r"]
[1173.789775, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.789802, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1173.789824, "o", "\u001b[?2004h> "]
[1173.789907, "o", "def gemm8(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\r\n\u001b[?2004l\r"]
[1173.789936, "o", "\u001b[?2004h> "]
[1173.790067, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1173.790098, "o", "\u001b[?2004h> "]
[1173.79013, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1173.790161, "o", "\u001b[?2004h> "]
[1173.790238, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1173.790268, "o", "\u001b[?2004h> "]
[1173.790297, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[1173.790328, "o", "\u001b[?2004h> "]
[1173.790368, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1173.790399, "o", "\u001b[?2004h> "]
[1173.790484, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[1173.790514, "o", "\u001b[?2004h> "]
[1173.790583, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[1173.790614, "o", "\u001b[?2004h> "]
[1173.790667, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1173.790696, "o", "\u001b[?2004h> "]
[1173.79075, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1173.790779, "o", "\u001b[?2004h> "]
[1173.790832, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1173.790863, "o", "\u001b[?2004h> "]
[1173.790891, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1173.790923, "o", "\u001b[?2004h> "]
[1173.790992, "o", "    AH_ptr = AH + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[1173.79102, "o", "\u001b[?2004h> "]
[1173.79109, "o", "    AL_ptr = AL + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[1173.791124, "o", "\u001b[?2004h> "]
[1173.79119, "o", "    WH_ptr = WH + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[1173.791217, "o", "\u001b[?2004h> "]
[1173.791286, "o", "    WL_ptr = WL + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[1173.791316, "o", "\u001b[?2004h> "]
[1173.791382, "o", "    acc0 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1173.791411, "o", "\u001b[?2004h> "]
[1173.791478, "o", "    acc1 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1173.791507, "o", "\u001b[?2004h> "]
[1173.791575, "o", "    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1173.791603, "o", "\u001b[?2004h> "]
[1173.791643, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1173.791672, "o", "\u001b[?2004h> "]
[1173.791709, "o", "        ah = tl.load(AH_ptr)\r\n\u001b[?2004l\r"]
[1173.791741, "o", "\u001b[?2004h> "]
[1173.79177, "o", "        al = tl.load(AL_ptr)\r\n\u001b[?2004l\r"]
[1173.791791, "o", "\u001b[?2004h> "]
[1173.79184, "o", "        bh = tl.load(WH_ptr)\r\n\u001b[?2004l\r"]
[1173.79187, "o", "\u001b[?2004h> "]
[1173.791901, "o", "        bl = tl.load(WL_ptr)\r\n\u001b[?2004l\r"]
[1173.791933, "o", "\u001b[?2004h> "]
[1173.791983, "o", "        acc0 = tl.dot(ah, bh, acc0)\r\n\u001b[?2004l\r"]
[1173.792012, "o", "\u001b[?2004h> "]
[1173.79206, "o", "        acc1 = tl.dot(al, bh, acc1)\r\n\u001b[?2004l\r"]
[1173.792091, "o", "\u001b[?2004h> "]
[1173.792141, "o", "        acc2 = tl.dot(ah, bl, acc2)\r\n\u001b[?2004l\r"]
[1173.792168, "o", "\u001b[?2004h> "]
[1173.792195, "o", "        AH_ptr += BK\r\n\u001b[?2004l\r"]
[1173.792227, "o", "\u001b[?2004h> "]
[1173.792258, "o", "        AL_ptr += BK\r\n\u001b[?2004l\r"]
[1173.792287, "o", "\u001b[?2004h> "]
[1173.792319, "o", "        WH_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.79235, "o", "> "]
[1173.792377, "o", "        WL_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.792427, "o", "    acc = acc0 + acc1 + acc2\r\n\u001b[?2004l\r"]
[1173.792454, "o", "\u001b[?2004h> "]
[1173.792495, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[1173.792524, "o", "\u001b[?2004h> "]
[1173.792588, "o", "    acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[1173.792617, "o", "\u001b[?2004h> "]
[1173.79268, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1173.79271, "o", "\u001b[?2004h> "]
[1173.792739, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[1173.792769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.7928, "o", "> "]
[1173.79286, "o", "XH8 = torch.empty(M, K, device='cuda', dtype=FP8)\r\n\u001b[?2004l\r"]
[1173.79289, "o", "\u001b[?2004h> "]
[1173.792959, "o", "XL8 = torch.empty(M, K, device='cuda', dtype=FP8)\r\n\u001b[?2004l\r"]
[1173.792989, "o", "\u001b[?2004h> "]
[1173.793071, "o", "C = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1173.793101, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.793166, "o", "def run8(BM, BN, BK, G, w, s):\r\n\u001b[?2004l\r"]
[1173.793193, "o", "\u001b[?2004h> "]
[1173.793224, "o", "    n = M * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.793361, "o", "    split8_kernel[(triton.cdiv(n, 8192),)](x, XH8, XL8, n, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r"]
[1173.79339, "o", "\u001b[?2004h> "]
[1173.793468, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1173.793498, "o", "\u001b[?2004h> "]
[1173.793647, "o", "    gemm8[grid](XH8, XL8, Wh8, Wl8, b, C, M, N, K, alpha, BM, BN, BK, G, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[1173.793676, "o", "\u001b[?2004h> "]
[1173.793708, "o", "    return C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1173.79374, "o", "\u001b[?2004h> "]
[1173.793776, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r"]
[1173.793808, "o", "\u001b[?2004h> "]
[1173.793841, "o", "    for _ in range(5):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1173.793873, "o", ">         fn()\r\n\u001b[?2004l\r"]
[1173.793902, "o", "\u001b[?2004h> "]
[1173.793939, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1173.793968, "o", "\u001b[?2004h> "]
[1173.794072, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1173.794102, "o", "\u001b[?2004h> "]
[1173.794138, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.794179, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[1173.794208, "o", "\u001b[?2004h> "]
[1173.79424, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[1173.794271, "o", "\u001b[?2004h> "]
[1173.794312, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1173.794341, "o", "\u001b[?2004h> "]
[1173.794475, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1173.794505, "o", "\u001b[?2004h> "]
[1173.794555, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1173.794585, "o", "\u001b[?2004h> "]
[1173.79463, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1173.794659, "o", "\u001b[?2004h> "]
[1173.794708, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1173.794738, "o", "\u001b[?2004h> "]
[1173.79477, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.794853, "o", "    return round(ts[len(ts)//2], 3), round(ts[0], 3)\r\n\u001b[?2004l\r"]
[1173.794883, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.795068, "o", "for cfg in [(128,128,64,8,8,3),(128,256,64,8,8,2),(128,256,32,8,8,3),(128,128,128,8,8,2),(128,256,128,8,8,2)]:\r\n\u001b[?2004l\r"]
[1173.79508, "o", "\u001b[?2004h"]
[1173.795119, "o", "> "]
[1173.795152, "o", "    BM,BN,BK,G,w,s = cfg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.795184, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1173.795234, "o", "        o = run8(BM,BN,BK,G,w,s)\r\n\u001b[?2004l\r"]
[1173.795263, "o", "\u001b[?2004h> "]
[1173.795409, "o", "        print(f'FP8e5 cfg {cfg}: err,bad {errinfo(o)} ms {timeit(lambda: run8(BM,BN,BK,G,w,s))}')\r\n\u001b[?2004l\r"]
[1173.795439, "o", "\u001b[?2004h> "]
[1173.795475, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1173.795505, "o", "\u001b[?2004h> "]
[1173.795586, "o", "        print(f'FP8e5 cfg {cfg} failed: {str(ex)[:60]}')\r\n\u001b[?2004l\r"]
[1173.795615, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1173.797395, "o", "\u001b[?2004hroot@modal:/# "]
[1173.797664, "o", "gpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/bench6.py /workspace/bench6.py && gpu exec sb-Rw5VsPy9C81UFv19STJ4Qn -- python3 /workspace/bench6.py 2>&1 | tail -8\r\n\u001b[?2004l\r"]
[1176.445002, "o", "{\r\n  \"bytes\": 3647,\r\n  \"sha256\": \"7acbac32f8d652ca29ffa385bf65af09a2b1105a1768ad37598ae8685aab1eca\"\r\n}\r\n"]
[1191.777265, "o", "request ID: aef0c24efeb44cfd9e6024b5a40ae185\r\ncommand: ad1d1a35f2af495cb169780fa11ca146\r\nFP8e5 cfg (128, 128, 64, 8, 8, 3): err,bad (0.012629330158233643, 63329784) ms (1.541, 1.52)\r\nFP8e5 cfg (128, 256, 64, 8, 8, 2): err,bad (0.012629330158233643, 63329784) ms (37.07, 36.97)\r\nFP8e5 cfg (128, 256, 32, 8, 8, 3): err,bad (0.012629330158233643, 63329784) ms (71.09, 70.917)\r\nFP8e5 cfg (128, 128, 128, 8, 8, 2): err,bad (0.012629330158233643, 63329784) ms (1.933, 1.897)\r\nFP8e5 cfg (128, 256, 128, 8, 8, 2): err,bad (0.012629330158233643, 63329784) ms (20.917, 20.852)\r\n"]
[1191.777465, "o", "\u001b[?2004hroot@modal:/# "]
[1250.923028, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _split_fp16_kernel(X, XH, XL, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < n\n    v = tl.load(X + offs, mask=m)\n    vh = v.to(tl.float16)\n    vl = (v - vh.to(tl.float32)).to(tl.float16)\n    tl.store(XH + offs, vh, mask=m)\n    tl.store(XL + offs, vl, mask=m)\n\n\n@triton.jit\ndef _gemm_fp16x3(AH, AL, WH, WL, Bias, C, M, N, K, alpha,\n                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                 GROUP: tl.constexpr, ACC3: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, "]
[1250.923076, "i", "BN)\n    rk = tl.arange(0, BK)\n    AH_ptr = AH + rm[:, None] * K + rk[None, :]\n    AL_ptr = AL + rm[:, None] * K + rk[None, :]\n    WH_ptr = WH + rn[None, :] * K + rk[:, None]\n    WL_ptr = WL + rn[None, :] * K + rk[:, None]\n    if ACC3:\n        acc0 = tl.zeros((BM, BN), dtype=tl.float32)\n        acc1 = tl.zeros((BM, BN), dtype=tl.float32)\n        acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            ah = tl.load(AH_ptr)\n            al = tl.load(AL_ptr)\n            bh = tl.load(WH_ptr)\n            bl = tl.load(WL_ptr)\n            acc0 = tl.dot(ah, bh, acc0)\n            acc1 = tl.dot(al, bh, acc1)\n            acc2 = tl.dot(ah, bl, acc2)\n            AH_ptr += BK\n            AL_ptr += BK\n            WH_ptr += BK\n            WL_ptr += BK\n        acc = acc0 + acc1 + acc2\n    else:\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            ah = tl.load(AH_ptr)\n            al = tl.load(AL_ptr)\n            bh = tl.load(WH_ptr)\n            bl = tl."]
[1250.923083, "i", "load(WL_ptr)\n            acc = tl.dot(ah, bh, acc)\n            acc = tl.dot(al, bh, acc)\n            acc = tl.dot(ah, bl, acc)\n            AH_ptr += BK\n            AL_ptr += BK\n            WH_ptr += BK\n            WL_ptr += BK\n    bias = tl.load(Bias + rn)\n    acc = acc * alpha + alpha * bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\n\n# (BM, BN, BK, GROUP, num_warps, num_stages, ACC3)\n_CONFIGS = [\n    (128, 256, 32, 8, 8, 3, False),\n    (128, 128, 32, 8, 8, 4, True),\n    (128, 128, 64, 8, 8, 3, False),\n]\n\n\nclass ModelNew(nn.Module):\n    \"\"\"\n    out = (1 + scaling_factor) * (x @ W^T + b)\n    computed with an fp16-split (3-product, fp32-accumulate) GEMM that\n    matches fp32 accuracy (max abs err ~5e-5 < 1e-4 tolerance) while\n    using fp16 tensor cores on H100.\n    \"\"\"\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_"]
[1250.9232, "i", "factor\n        self._alpha = 1.0 + scaling_factor\n        self._wh = None\n        self._wl = None\n        self._best = _CONFIGS[0]\n        if torch.cuda.is_available():\n            try:\n                self._prepare_and_tune()\n            except Exception:\n                pass\n\n    def _split_weights(self):\n        w = self.matmul.weight.detach()\n        wh = w.half()\n        wl = (w - wh.float()).half()\n        self._wh = wh.contiguous()\n        self._wl = wl.contiguous()\n\n    def _run_cfg(self, cfg, XH, XL, C, M, N, K):\n        BM, BN, BK, G, w, s, acc3 = cfg\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        _gemm_fp16x3[grid](XH, XL, self._wh, self._wl, self.matmul.bias, C,\n                           M, N, K, self._alpha, BM, BN, BK, G, acc3,\n                           num_warps=w, num_stages=s)\n        return C\n\n    def _prepare_and_tune(self):\n        w = self.matmul.weight\n        K = w.shape[1]\n        N = w.shape[0]\n        M = 16384\n        self._split_weights()\n        dev = w.device"]
[1250.923237, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[1250.92325, "i", "\n        XH = torch.empty(M, K, device=dev, dtype=torch.float16)\n        XL = torch.empty(M, K, device=dev, dtype=torch.float16)\n        C = torch.empty(M, N, device=dev, dtype=torch.float32)\n        # pre-compile all candidate configs\n        for cfg in _CONFIGS:\n            self._run_cfg(cfg, XH, XL, C, M, N, K)\n        torch.cuda.synchronize()\n        # tune\n        best_t = None\n        for cfg in _CONFIGS:\n            ts = []\n            for _ in range(5):\n                torch.cuda.synchronize()\n                s_ev = torch.cuda.Event(enable_timing=True)\n                e_ev = torch.cuda.Event(enable_timing=True)\n                s_ev.record()\n                self._run_cfg(cfg, XH, XL, C, M, N, K)\n                e_ev.record()\n                torch.cuda.synchronize()\n                ts.append(s_ev.elapsed_time(e_ev))\n            t = sorted(ts)[2]\n            if best_t is None or t < best_t:\n                best_t = t\n                self._best = cfg\n\n    def forward(self, x):\n        w = self.matmul.weig"]
[1250.923259, "i", "ht\n        N, K = w.shape\n        x2 = x.reshape(-1, K)\n        M = x2.shape[0]\n        if self._wh is None or self._wh.device != x.device:\n            self._split_weights()\n        if (K % 64) or (N % 64) or x2.dtype != torch.float32:\n            # fallback: exact fp32 computation fused\n            y = torch.addmm(self.matmul.bias, x2, w.t())\n            return (y * self._alpha).reshape(*x.shape[:-1], N)\n        XH = torch.empty(M, K, device=x.device, dtype=torch.float16)\n        XL = torch.empty(M, K, device=x.device, dtype=torch.float16)\n        n = M * K\n        _split_fp16_kernel[(triton.cdiv(n, 8192),)](x2, XH, XL, n, BLOCK=8192, num_warps=8)\n        C = torch.empty(M, N, device=x.device, dtype=torch.float32)\n        self._run_cfg(self._best, XH, XL, C, M, N, K)\n        return C.reshape(*x.shape[:-1], N)\nEOF\ngpu push sb-Rw5VsPy9C81UFv19STJ4Qn /workspace/solution.py /workspace/solution.py\n"]
