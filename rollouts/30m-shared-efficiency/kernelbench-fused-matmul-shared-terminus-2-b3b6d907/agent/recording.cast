[1027.628179, "o", "\u001b[?2004h> "]
[1027.628217, "o", "        width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[1027.628254, "o", "\u001b[?2004h> "]
[1027.628303, "o", "        group_id = tile_id // width\r\n\u001b[?2004l\r"]
[1027.628331, "o", "\u001b[?2004h> "]
[1027.628428, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[1027.628456, "o", "\u001b[?2004h> "]
[1027.628538, "o", "        pid_m = group_id * GROUP + (tile_id % group_size)\r\n\u001b[?2004l\r"]
[1027.628571, "o", "\u001b[?2004h> "]
[1027.628632, "o", "        pid_n = (tile_id % width) // group_size\r\n\u001b[?2004l\r"]
[1027.628664, "o", "\u001b[?2004h> "]
[1027.628696, "o", "        off_m = pid_m * BM\r\n\u001b[?2004l\r\u001b[?2004h"]
[1027.628729, "o", "> "]
[1027.628763, "o", "        off_n = pid_n * BN\r\n\u001b[?2004l\r\u001b[?2004h"]
[1027.628797, "o", "> "]
[1027.628857, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1027.628886, "o", "\u001b[?2004h> "]
[1027.628932, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1027.628963, "o", "\u001b[?2004h> "]
[1027.629012, "o", "            ah = aH.load([off_m, k])\r\n\u001b[?2004l\r"]
[1027.629029, "o", "\u001b[?2004h> "]
[1027.629091, "o", "            al = aL.load([off_m, k])\r\n\u001b[?2004l\r"]
[1027.629121, "o", "\u001b[?2004h> "]
[1027.629171, "o", "            bh = wH.load([off_n, k])\r\n\u001b[?2004l\r"]
[1027.629199, "o", "\u001b[?2004h> "]
[1027.62925, "o", "            bl = wL.load([off_n, k])\r\n\u001b[?2004l\r"]
[1027.629277, "o", "\u001b[?2004h> "]
[1027.629321, "o", "            bht = tl.trans(bh)\r\n\u001b[?2004l\r"]
[1027.62935, "o", "\u001b[?2004h> "]
[1027.629404, "o", "            acc = tl.dot(ah, bht, acc)\r\n\u001b[?2004l\r"]
[1027.629429, "o", "\u001b[?2004h> "]
[1027.629487, "o", "            acc = tl.dot(al, bht, acc)\r\n\u001b[?2004l\r"]
[1027.629515, "o", "\u001b[?2004h> "]
[1027.629584, "o", "            acc = tl.dot(ah, tl.trans(bl), acc)\r\n\u001b[?2004l\r"]
[1027.629614, "o", "\u001b[?2004h> "]
[1027.629665, "o", "        rn = off_n + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1027.629689, "o", "\u001b[?2004h> "]
[1027.629753, "o", "        rm = off_m + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1027.629781, "o", "\u001b[?2004h> "]
[1027.629829, "o", "        bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[1027.629857, "o", "\u001b[?2004h> "]
[1027.629929, "o", "        acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[1027.629958, "o", "\u001b[?2004h> "]
[1027.630029, "o", "        C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[1027.630051, "o", "\u001b[?2004h> "]
[1027.630096, "o", "        tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[1027.630125, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.630207, "o", "def run_tma2(BM, BN, BK, G, w, s, ws=False):\r\n\u001b[?2004l\r"]
[1027.630234, "o", "\u001b[?2004h> "]
[1027.630264, "o", "    n = M * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.630405, "o", "    split_kernel[(triton.cdiv(n, 8192),)](x, XH, XL, n, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r"]
[1027.630438, "o", "\u001b[?2004h> "]
[1027.630514, "o", "    num_tiles = triton.cdiv(M, BM) * triton.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1027.630531, "o", "\u001b[?2004h> "]
[1027.630594, "o", "    grid = (min(NUM_SMS, num_tiles),)\r\n\u001b[?2004l\r"]
[1027.630625, "o", "\u001b[?2004h> "]
[1027.630796, "o", "    gemm_tma2[grid](XH, XL, Wh, Wl, b, C, M, N, K, alpha, BM, BN, BK, G, NUM_SMS, ws, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r"]
[1027.630822, "o", "\u001b[?2004h> "]
[1027.630854, "o", "    return C\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1027.630889, "o", "\u001b[?2004h> "]
[1027.631177, "o", "for cfg in [(128,128,32,8,8,4,False),(128,128,32,8,8,5,False),(128,128,64,8,8,2,False),(128,256,32,8,8,2,False),(128,128,32,8,8,4,True),(128,128,64,8,8,3,True),(128,256,64,8,8,3,True)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1027.631212, "o", "> "]
[1027.631244, "o", "    BM,BN,BK,G,w,s,ws = cfg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.631276, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.63135, "o", "        o = run_tma2(BM,BN,BK,G,w,s,ws)\r\n\u001b[?2004l\r"]
[1027.631381, "o", "\u001b[?2004h> "]
[1027.631536, "o", "        print(f'TMA2 cfg {cfg}: err {err(o):.2e} ms {timeit(lambda: run_tma2(BM,BN,BK,G,w,s,ws))}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1027.631564, "o", "> "]
[1027.631598, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1027.631629, "o", "\u001b[?2004h> "]
[1027.63171, "o", "        print(f'TMA2 cfg {cfg} failed: {str(ex)[:60]}')\r\n\u001b[?2004l\r"]
[1027.631735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1027.631766, "o", "> "]
[1027.631813, "o", "# inductor max-autotune fp16 mm ceiling\r\n\u001b[?2004l\r"]
[1027.631842, "o", "\u001b[?2004h> "]
[1027.631895, "o", "import torch._inductor.config as icfg\r\n\u001b[?2004l\r"]
[1027.631924, "o", "\u001b[?2004h> "]
[1027.631992, "o", "icfg.max_autotune_gemm_backends = 'TRITON,ATEN'\r\n\u001b[?2004l\r"]
[1027.632022, "o", "\u001b[?2004h> "]
[1027.632093, "o", "@torch.compile(mode='max-autotune-no-cudagraphs')\r\n\u001b[?2004l\r"]
[1027.632122, "o", "\u001b[?2004h> "]
[1027.632154, "o", "def f16mm(a, bb):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1027.632214, "o", "    return torch.mm(a, bb.t())\r\n\u001b[?2004l\r"]
[1027.632244, "o", "\u001b[?2004h> try:\r\n"]
[1027.632268, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1027.632299, "o", "    o = f16mm(XH, Wh)\r\n\u001b[?2004l\r"]
[1027.632331, "o", "\u001b[?2004h> "]
[1027.632427, "o", "    print('inductor fp16 mm ms:', timeit(lambda: f16mm(XH, Wh)))\r\n\u001b[?2004l\r"]
[1027.632458, "o", "\u001b[?2004h> "]
[1027.632489, "o", "except Exception as ex:\r\n\u001b[?2004l\r"]
[1027.632521, "o", "\u001b[?2004h> "]
[1027.632581, "o", "    print('inductor failed', str(ex)[:100])\r\n\u001b[?2004l\r"]
[1027.632607, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
