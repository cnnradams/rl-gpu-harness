[683.015644, "o", "\u001b[?2004h> "]
[683.015755, "o", "        bl = tl.load(WL_ptr)\r\n\u001b[?2004l\r"]
[683.015779, "o", "\u001b[?2004h> "]
[683.015903, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[683.015917, "o", "\u001b[?2004h> "]
[683.016035, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[683.016056, "o", "\u001b[?2004h> "]
[683.016168, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[683.016183, "o", "\u001b[?2004h> "]
[683.016284, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[683.016299, "o", "\u001b[?2004h> "]
[683.016393, "o", "        WH_ptr += BK * swk\r\n\u001b[?2004l\r"]
[683.016407, "o", "\u001b[?2004h"]
[683.016426, "o", "> "]
[683.016508, "o", "        WL_ptr += BK * swk\r\n\u001b[?2004l\r"]
[683.01653, "o", "\u001b[?2004h> "]
[683.016627, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[683.016642, "o", "\u001b[?2004h> "]
[683.016796, "o", "    acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[683.016813, "o", "\u001b[?2004h> "]
[683.016968, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
