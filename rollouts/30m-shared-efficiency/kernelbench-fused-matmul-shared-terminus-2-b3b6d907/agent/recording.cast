[328.874406, "o", "Py9C81UFv19STJ4Qn -- python3 /work\u001b[?2004h"]
[328.874437, "o", "> "]
[328.874498, "o", "import torch, time, triton\r\n\u001b[?2004l\r"]
[328.874533, "o", "\u001b[?2004h> "]
[328.874573, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[328.874604, "o", "\u001b[?2004h> "]
[328.874636, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.874672, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.874841, "o", "print('torch', torch.__version__, 'triton', triton.__version__, torch.cuda.get_device_name(0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.874873, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.874911, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[328.874942, "o", "\u001b[?2004h> "]
[328.87498, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[328.875011, "o", "\u001b[?2004h> "]
[328.875062, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[328.87509, "o", "\u001b[?2004h> "]
[328.875126, "o", "lin = nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[328.875158, "o", "\u001b[?2004h> "]
[328.875189, "o", "W, b = lin.weight, lin.bias\r\n\u001b[?2004l\r"]
[328.87522, "o", "\u001b[?2004h> "]
[328.875251, "o", "sf = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.875281, "o", "alpha = 1.0 + sf\r\n\u001b[?2004l\r"]
[328.875313, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.875344, "o", "# fp64 truth\r\n\u001b[?2004l\r"]
[328.875375, "o", "\u001b[?2004h> "]
[328.875444, "o", "x64, W64, b64 = x.double(), W.double(), b.double()\r\n\u001b[?2004l\r"]
[328.875475, "o", "\u001b[?2004h> "]
[328.875524, "o", "out64 = alpha * (x64 @ W64.t() + b64)\r\n\u001b[?2004l\r"]
[328.875555, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.875636, "o", "# fp32 reference (what reference.py computes)\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.875671, "o", "> y = lin(x)\r\n\u001b[?2004l\r"]
[328.875703, "o", "\u001b[?2004h> "]
[328.87575, "o", "out_ref = y * sf + y.clone().detach()\r\n\u001b[?2004l\r"]
[328.875781, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.875812, "o", "def err(o):\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.875842, "o", "> "]
[328.875873, "o", "    o = o.double()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.876018, "o", "    return (o - out_ref.double()).abs().max().item(), (o - out64).abs().max().item()\r\n\u001b[?2004l\r"]
[328.87605, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[328.876081, "o", "\u001b[?2004h> "]
[328.876114, "o", "# candidate 1: fp32 addmm fused\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.876195, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[328.876227, "o", "\u001b[?2004h> "]
[328.876317, "o", "out1 = torch.addmm(b, x, W.t(), alpha=alpha)\r\n\u001b[?2004l\r"]
[328.876343, "o", "\u001b[?2004h> "]
[328.876427, "o", "print('fp32 addmm err vs ref, vs fp64:', err(out1))\r\n\u001b[?2004l\r"]
[328.87646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.876537, "o", "# candidate 2: tf32\r\n\u001b[?2004l\r\u001b[?2004h> "]
[328.876598, "o", "torch.backends.cuda.matmul.allow_tf32 = True\r\n\u001b[?2004l\r"]
[328.876623, "o", "\u001b[?2004h> "]
[328.876697, "o", "out2 = torch.addmm(b, x, W.t(), alpha=alpha)\r\n\u001b[?2004l\r\u001b[?2004h"]
[328.876713, "o", "> "]
[328.876771, "o", "print('tf32 addmm err:', err(out2))\r\n\u001b[?2004l\r"]
[328.876787, "o", "\u001b[?2004h> "]
[328.876865, "o", "torch.backends.cuda.matmul.allow_tf32 = False\r\n\u001b[?2004l\r"]
[328.87688, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[328.876895, "o", "\u001b[?2004h> "]
[328.876923, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[328.876946, "o", "\u001b[?2004h> "]
[328.877066, "o", "def gemm_fp16x3(A, B, Bias, C, M, N, K, sam, sak, sbn, sbk, scm, scn, alpha,\r\n\u001b[?2004l\r"]
[328.877077, "o", "\u001b[?2004h> "]
[328.877249, "o", "                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[328.877268, "o", "\u001b[?2004h> "]
[328.87731, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[328.87733, "o", "\u001b[?2004h> "]
[328.877411, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[328.877426, "o", "\u001b[?2004h> "]
[328.877471, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[328.877485, "o", "\u001b[?2004h> "]
[328.877534, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[328.877552, "o", "\u001b[?2004h> "]
[328.87765, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[328.87767, "o", "\u001b[?2004h> "]
[328.877755, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[328.877774, "o", "\u001b[?2004h> "]
[328.877836, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[328.877852, "o", "\u001b[?2004h> "]
[328.877917, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[328.87793, "o", "\u001b[?2004h> "]
[328.877996, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[328.87801, "o", "\u001b[?2004h> "]
[328.878056, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[328.878074, "o", "\u001b[?2004h> "]
[328.878159, "o", "    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[328.878173, "o", "\u001b[?2004h> "]
[328.878262, "o", "    B_ptr = B + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r"]
[328.878284, "o", "\u001b[?2004h> "]
[328.878354, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[328.878366, "o", "\u001b[?2004h> "]
[328.87842, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[328.878441, "o", "\u001b[?2004h> "]
[328.87848, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[328.878502, "o", "\u001b[?2004h> "]
[328.878543, "o", "        bb = tl.load(B_ptr)\r\n\u001b[?2004l\r"]
[328.878557, "o", "\u001b[?2004h> "]
[328.878608, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[328.878623, "o", "\u001b[?2004h> "]
[328.87871, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[328.878726, "o", "\u001b[?2004h> "]
[328.878777, "o", "        bh = bb.to(tl.float16)\r\n\u001b[?2004l\r"]
[328.878791, "o", "\u001b[?2004h"]
[328.878812, "o", "> "]
[328.878886, "o", "        bl = (bb - bh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[328.87891, "o", "\u001b[?2004h> "]
[328.878969, "o", "        bht = tl.trans(bh)\r\n\u001b[?2004l\r"]
[328.878985, "o", "\u001b[?2004h> "]
[328.879049, "o", "        acc = tl.dot(ah, bht, acc)\r\n\u001b[?2004l\r"]
[328.879067, "o", "\u001b[?2004h> "]
[328.879122, "o", "        acc = tl.dot(al, bht, acc)\r\n\u001b[?2004l\r"]
[328.879135, "o", "\u001b[?2004h> "]
[328.879209, "o", "        acc = tl.dot(ah, tl.trans(bl), acc)\r\n\u001b[?2004l\r"]
[328.879222, "o", "\u001b[?2004h> "]
[328.879267, "o", "        A_ptr += BK * sak\r\n\u001b[?2004l\r"]
[328.87928, "o", "\u001b[?2004h> "]
[328.879326, "o", "        B_ptr += BK * sbk\r\n\u001b[?2004l\r"]
[328.879344, "o", "\u001b[?2004h> "]
[328.879391, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r"]
[328.879404, "o", "\u001b[?2004h> "]
[328.879482, "o", "    acc = acc * alpha + alpha * bias[None, :]\r\n\u001b[?2004l\r"]
[328.879495, "o", "\u001b[?2004h> "]
[328.879585, "o", "    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[328.879605, "o", "\u001b[?2004h> "]
[328.879643, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[328.879656, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[328.879682, "o", "\u001b[?2004h> "]
[328.879788, "o", "def run_triton(BM=128, BN=128, BK=64, GROUP=8, warps=8, stages=3):\r\n\u001b[?2004l\r"]
[328.879802, "o", "\u001b[?2004h> "]
[328.879903, "o", "    C = torch.empty(M, N, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[328.879919, "o", "\u001b[?2004h> "]
[328.880014, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[328.880035, "o", "\u001b[?2004h> "]
[328.880182, "o", "    gemm_fp16x3[grid](x, W, b, C, M, N, K, x.stride(0), x.stride(1), W.stride(0), W.stride(1),\r\n\u001b[?2004l\r"]
[328.880203, "o", "\u001b[?2004h> "]
[328.880325, "o", "                      C.stride(0), C.stride(1), alpha, BM, BN, BK, GROUP,\r\n\u001b[?2004l\r"]
[328.880339, "o", "\u001b[?2004h> "]
[328.880431, "o", "                      num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[328.880447, "o", "\u001b[?2004h> "]
[328.88047, "o", "    return C\r\n\u001b[?2004l\r"]
[328.880494, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.880516, "o", "> "]
[328.880539, "o", "out3 = run_triton()\r\n\u001b[?2004l\r"]
[328.880555, "o", "\u001b[?2004h> "]
[328.880628, "o", "print('triton fp16x3 err:', err(out3))\r\n\u001b[?2004l\r"]
[328.880651, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[328.88067, "o", "> "]
[328.880712, "o", "def timeit(fn, iters=30):\r\n\u001b[?2004l\r"]
[328.880727, "o", "\u001b[?2004h> "]
[328.880766, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[328.880785, "o", "\u001b[?2004h> "]
[328.880799, "o", "        fn()\r\n\u001b[?2004l\r"]
[328.880822, "o", "\u001b[?2004h> "]
[328.880878, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[328.8809, "o", "\u001b[?2004h> "]
[328.881014, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[328.881028, "o", "\u001b[?2004h> "]
[328.881054, "o", "    ts = []\r\n\u001b[?2004l\r"]
[328.881079, "o", "\u001b[?2004h> "]
[328.881118, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[328.881132, "o", "\u001b[?2004h> "]
[328.881177, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[328.8812, "o", "\u001b[?2004h> "]
[328.881252, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[328.881275, "o", "\u001b[?2004h> "]
[328.881417, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[328.881433, "o", "\u001b[?2004h> "]
[328.881497, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[328.881514, "o", "\u001b[?2004h> "]
[328.881571, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[328.881592, "o", "\u001b[?2004h> "]
[328.881651, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[328.881673, "o", "\u001b[?2004h> "]
[328.881701, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[328.881715, "o", "\u001b[?2004h> "]
