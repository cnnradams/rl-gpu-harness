[1109.230912, "o", "\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 128, 32, 8, 8, 4, False): err 4.78e-05 ms (3.604, 3.544)\r\n\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 128, 32, 8, 8, 5, False): err 4.78e-05 ms (3.6, 3.513)\r\n\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 128, 64, 8, 8, 2, False): err 4.78e-05 ms (4.283, 4.215)\r\n\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 256, 32, 8, 8, 2, False): err 4.78e-05 ms (4.19, 4.153)\r\n\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 128, 32, 8, 8, 4, True): err 4.78e-05 ms (3.564, 3.545)\r\n\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 128, 64, 8, 8, 3, True) failed: out of resource: shared memory, Required: 245840, Hardware l\r\n\u001b[01;31m\u001b[KTMA2\u001b[m\u001b[K cfg (128, 256, 64, 8, 8, 3, True) failed: out of resource: shared memory, Required: 393296, Hardware l\r\n\u001b[01;31m\u001b[Kinductor fp16\u001b[m\u001b[K mm ms: (0.775, 0.77)\r\n"]
