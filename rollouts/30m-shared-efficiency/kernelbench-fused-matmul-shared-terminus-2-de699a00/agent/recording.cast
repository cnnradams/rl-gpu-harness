[611.975499, "o", "    grid_m = M // BM\r\n\u001b[?2004l\r"]
[611.975529, "o", "\u001b[?2004h> "]
[611.975557, "o", "    grid_n = N // BN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.975589, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[611.975621, "o", "\u001b[?2004h> "]
[611.975646, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[611.97567, "o", "\u001b[?2004h> "]
[611.975738, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[611.975767, "o", "\u001b[?2004h> "]
[611.975818, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.975879, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[611.975908, "o", "\u001b[?2004h> "]
[611.975942, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[611.975971, "o", "\u001b[?2004h> "]
[611.976006, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[611.976031, "o", "\u001b[?2004h> "]
[611.97606, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[611.976086, "o", "\u001b[?2004h> "]
[611.976127, "o", "    Xp = X + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[611.976152, "o", "\u001b[?2004h> "]
[611.976202, "o", "    WHp = WH + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[611.976228, "o", "\u001b[?2004h> "]
[611.97628, "o", "    WLp = WL + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[611.976305, "o", "\u001b[?2004h> "]
[611.97635, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[611.976375, "o", "\u001b[?2004h> "]
[611.976406, "o", "    for _ in range(0, K, BK):\r\n\u001b[?2004l\r"]
[611.976436, "o", "\u001b[?2004h> "]
[611.976465, "o", "        x = tl.load(Xp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.97651, "o", "        xh = x.to(tl.float16)\r\n\u001b[?2004l\r"]
[611.976534, "o", "\u001b[?2004h> "]
[611.976585, "o", "        xl = (x - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[611.976634, "o", "\u001b[?2004h>         wh = tl.load(WHp)\r\n\u001b[?2004l\r"]
[611.976663, "o", "\u001b[?2004h> "]
[611.976692, "o", "        wl = tl.load(WLp)\r\n\u001b[?2004l\r"]
[611.976718, "o", "\u001b[?2004h> "]
[611.976749, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r"]
[611.976774, "o", "\u001b[?2004h> "]
[611.97681, "o", "        acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[611.976839, "o", "\u001b[?2004h> "]
[611.976869, "o", "        acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r"]
[611.976894, "o", "\u001b[?2004h> "]
[611.976925, "o", "        Xp += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.97695, "o", "        WHp += BK\r\n\u001b[?2004l\r"]
[611.976975, "o", "\u001b[?2004h> "]
[611.977001, "o", "        WLp += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.977042, "o", "    b = tl.load(B + rn)\r\n\u001b[?2004l\r"]
[611.977067, "o", "\u001b[?2004h> "]
[611.977092, "o", "    acc = acc + b[None, :]\r\n\u001b[?2004l\r"]
[611.977121, "o", "\u001b[?2004h> "]
[611.977161, "o", "    Yp = Y + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[611.977186, "o", "\u001b[?2004h> "]
[611.977216, "o", "    tl.store(Yp, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.977241, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.977286, "o", "def run(x, wh, wl, b, c):\r\n\u001b[?2004l\r"]
[611.977313, "o", "\u001b[?2004h> "]
[611.977342, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.977371, "o", "    N = wh.shape[0]\r\n\u001b[?2004l\r"]
[611.977396, "o", "\u001b[?2004h> "]
[611.977464, "o", "    y = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[611.977494, "o", "\u001b[?2004h> "]
[611.97754, "o", "    grid = ((M // c[\"BM\"]) * (N // c[\"BN\"]),)\r\n\u001b[?2004l\r"]
[611.977569, "o", "\u001b[?2004h> "]
[611.977619, "o", "    _gemm3xfp16[grid](x, wh, wl, b, y, M, N, K,\r\n\u001b[?2004l\r"]
[611.977645, "o", "\u001b[?2004h> "]
[611.977727, "o", "                      BM=c[\"BM\"], BN=c[\"BN\"], BK=c[\"BK\"], GROUP=c[\"GROUP\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.977826, "o", "                      num_warps=c[\"num_warps\"], num_stages=c[\"num_stages\"])\r\n\u001b[?2004l\r"]
[611.977855, "o", "\u001b[?2004h> "]
[611.977885, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[611.977911, "o", "\u001b[?2004h> "]
[611.977937, "o", "dev = torch.device(\"cuda\")\r\n\u001b[?2004l\r"]
[611.977968, "o", "\u001b[?2004h> "]
[611.977992, "o", "init = get_init_inputs()\r\n\u001b[?2004l\r"]
[611.978017, "o", "\u001b[?2004h> "]
[611.978047, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.978119, "o", "    torch.manual_seed(42); torch.cuda.manual_seed(42)\r\n\u001b[?2004l\r"]
[611.978149, "o", "\u001b[?2004h> "]
[611.978224, "o", "    ref = Model(*init).to(dev)\r\n\u001b[?2004l\r"]
[611.978253, "o", "\u001b[?2004h> "]
[611.978282, "o", "    torch.manual_seed(123)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.978341, "o", "    x = torch.rand(16384, 4096, device=dev)\r\n\u001b[?2004l\r"]
[611.978364, "o", "\u001b[?2004h> "]
[611.978385, "o", "    y_ref = ref(x)\r\n\u001b[?2004l\r"]
[611.978406, "o", "\u001b[?2004h> "]
[611.978452, "o", "    w = ref.matmul.weight.detach() * 1.5\r\n\u001b[?2004l\r"]
[611.978476, "o", "\u001b[?2004h> "]
[611.978508, "o", "    wh = w.half().contiguous()\r\n\u001b[?2004l\r"]
[611.97853, "o", "\u001b[?2004h> "]
[611.978581, "o", "    wl = (w - wh.float()).half().contiguous()\r\n\u001b[?2004l\r"]
[611.978618, "o", "\u001b[?2004h> "]
[611.978672, "o", "    b = (ref.matmul.bias.detach() * 1.5).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.978706, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.978737, "o", "def check(y):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.978814, "o", "    ok = torch.allclose(y_ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[611.978842, "o", "\u001b[?2004h> "]
[611.978883, "o", "    md = (y_ref - y).abs().max().item()\r\n\u001b[?2004l\r"]
[611.97891, "o", "\u001b[?2004h> "]
[611.978932, "o", "    return ok, md\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.978963, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.978992, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.979036, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[611.979062, "o", "\u001b[?2004h> "]
[611.979091, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[611.979117, "o", "\u001b[?2004h> "]
[611.979177, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[611.9792, "o", "\u001b[?2004h> "]
[611.979227, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.979261, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[611.979291, "o", "\u001b[?2004h> "]
[611.979353, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[611.979378, "o", "\u001b[?2004h> "]
[611.979417, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[611.979445, "o", "\u001b[?2004h>     ts.sort()\r\n\u001b[?2004l\r"]
[611.97947, "o", "\u001b[?2004h> "]
[611.979514, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[611.979543, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.979613, "o", "print(\"gpu:\", torch.cuda.get_device_name())\r\n\u001b[?2004l\r\u001b[?2004h"]
[611.979636, "o", "> "]
[611.979661, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.979723, "o", "    print(\"ref\", timeit(lambda: ref(x)))\r\n\u001b[?2004l\r"]
[611.979749, "o", "\u001b[?2004h> "]
[611.979774, "o", "    for cfg in [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.979865, "o", "        dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[611.979897, "o", "\u001b[?2004h> "]
[611.979966, "o", "        dict(BM=128, BN=128, BK=32, GROUP=8, num_warps=8, num_stages=5),\r\n\u001b[?2004l\r"]
[611.979994, "o", "\u001b[?2004h> "]
[611.980069, "o", "        dict(BM=128, BN=256, BK=32, GROUP=8, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[611.9801, "o", "\u001b[?2004h> "]
[611.980165, "o", "        dict(BM=256, BN=128, BK=32, GROUP=8, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[611.980198, "o", "\u001b[?2004h> "]
[611.98027, "o", "        dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=4, num_stages=3),\r\n\u001b[?2004l\r"]
[611.980298, "o", "\u001b[?2004h> "]
[611.980366, "o", "        dict(BM=128, BN=64, BK=64, GROUP=8, num_warps=4, num_stages=4),\r\n\u001b[?2004l\r"]
[611.980397, "o", "\u001b[?2004h> "]
[611.980466, "o", "        dict(BM=256, BN=64, BK=64, GROUP=8, num_warps=8, num_stages=2),\r\n\u001b[?2004l\r"]
[611.980498, "o", "\u001b[?2004h> "]
[611.98052, "o", "    ]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.980549, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[611.980595, "o", "            y = run(x, wh, wl, b, cfg)\r\n\u001b[?2004l\r"]
[611.980628, "o", "\u001b[?2004h> "]
[611.980705, "o", "            print(cfg, check(y), timeit(lambda: run(x, wh, wl, b, cfg)))\r\n\u001b[?2004l\r"]
[611.980734, "o", "\u001b[?2004h> "]
[611.980762, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[611.980789, "o", "\u001b[?2004h> "]
[611.980839, "o", "            print(cfg, \"FAILED\", type(ex).__name__)\r\n\u001b[?2004l\r"]
[611.980863, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[611.98089, "o", "\u001b[?2004h> "]
[611.980927, "o", "python3 /workspace/sweep2.py'\r\n\u001b[?2004l\r"]
[612.132249, "o", "request ID: ae90f8e44d614ae4b16f3e85c48c2c53\r\n"]
[613.418113, "o", "command: 1ea540e5cd1f41f7aa3c2a4efc7c3bb8\r\n"]
[619.169213, "o", "gpu: NVIDIA H100 80GB HBM3\r\nref (11.429823875427246, 11.419872283935547)\r\n{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8, 'num_warps': 8, 'num_stages': 3} (True, 4.935264587402344e-05) (2.7220160961151123, 2.712383985519409)\r\n{'BM': 128, 'BN': 128, 'BK': 32, 'GROUP': 8, 'num_warps': 8, 'num_stages': 5} (True, 4.887580871582031e-05) (3.5848000049591064, 3.54585599899292)\r\n{'BM': 128, 'BN': 256, 'BK': 32, 'GROUP': 8, 'num_warps': 8, 'num_stages': 3} (True, 4.887580871582031e-05) (2.9943039417266846, 2.9179840087890625)\r\n{'BM': 256, 'BN': 128, 'BK': 32, 'GROUP': 8, 'num_warps': 8, 'num_stages': 3} (True, 4.887580871582031e-05) (3.1385600566864014, 3.083103895187378)\r\n{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8, 'num_warps': 4, 'num_stages': 3} (True, 4.935264587402344e-05) (3.236959934234619, 3.04313588142395)\r\n{'BM': 128, 'BN': 64, 'BK': 64, 'GROUP': 8, 'num_warps': 4, 'num_stages': 4} (True, 4.935264587402344e-05) (3.6986238956451416, 3.67792010307312)\r\n{'BM': 256, 'BN': 64, 'BK': 64, 'GROUP': 8, 'num_warps': 8, "]
[619.169327, "o", "'num_stages': 2} (True, 4.935264587402344e-05) (5.245471954345703, 5.046432018280029)\r\n"]
[620.171845, "o", "\u001b[?2004hroot@modal:/# "]
[702.680019, "i", "gpu exec sb-jPczx3kh3bOZRNOc0y9C37 -- bash -c 'cat > /workspace/sweep3.py << \"PYEOF\"\nimport sys\nsys.path.insert(0, \"/opt/task\")\nexec(open(\"/workspace/sweep2.py\").read().split(\"print(\\\"gpu:\\\"[0])\nwith torch.no_grad():\n    for cfg in [\n        dict(BM=128, BN=128, BK=128, GROUP=8, num_warps=8, num_stages=2),\n        dict(BM=128, BN=256, BK=64, GROUP=8, num_warps=8, num_stages=2),\n        dict(BM=256, BN=256, BK=32, GROUP=8, num_warps=8, num_stages=2),\n        dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=2),\n        dict(BM=128, BN=128, BK=64, GROUP=4, num_warps=8, num_stages=3),\n        dict(BM=128, BN=128, BK=64, GROUP=16, num_warps=8, num_stages=3),\n    ]:\n        try:\n            y = run(x, wh, wl, b, cfg)\n            print(cfg, check(y), timeit(lambda: run(x, wh, wl, b, cfg)))\n        except Exception as ex:\n            print(cfg, \"FAILED\", type(ex).__name__)\nPYEOF\npython3 /workspace/sweep3.py'\n"]
[702.680259, "o", "gpu exec sb-jPczx3kh3bOZRNOc0y9C37 -- bash -c 'cat > /workspace/sweep3.py << \"PYEOF\"\r\n\u001b[?2004l\r"]
[702.680346, "o", "\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[702.680376, "o", "\u001b[?2004h> "]
[702.680404, "o", "sys.path.insert(0, \"/opt/task\")\r\n\u001b[?2004l\r"]
[702.68043, "o", "\u001b[?2004h> "]
[702.68052, "o", "exec(open(\"/workspace/sweep2.py\").read().split(\"print(\\\"gpu:\\\"[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[702.680563, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[702.680598, "o", ">     for cfg in [\r\n\u001b[?2004l\r"]
[702.680621, "o", "\u001b[?2004h> "]
[702.680709, "o", "        dict(BM=128, BN=128, BK=128, GROUP=8, num_warps=8, num_stages=2),\r\n\u001b[?2004l\r"]
[702.680738, "o", "\u001b[?2004h> "]
[702.680808, "o", "        dict(BM=128, BN=256, BK=64, GROUP=8, num_warps=8, num_stages=2),\r\n\u001b[?2004l\r"]
[702.680835, "o", "\u001b[?2004h> "]
[702.680911, "o", "        dict(BM=256, BN=256, BK=32, GROUP=8, num_warps=8, num_stages=2),\r\n\u001b[?2004l\r"]
[702.680943, "o", "\u001b[?2004h> "]
[702.681023, "o", "        dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=2),\r\n\u001b[?2004l\r"]
[702.681055, "o", "\u001b[?2004h> "]
[702.681125, "o", "        dict(BM=128, BN=128, BK=64, GROUP=4, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[702.681152, "o", "\u001b[?2004h> "]
[702.681224, "o", "        dict(BM=128, BN=128, BK=64, GROUP=16, num_warps=8, num_stages=3),\r\n\u001b[?2004l\r"]
[702.681252, "o", "\u001b[?2004h>     ]:\r\n\u001b[?2004l\r"]
[702.681278, "o", "\u001b[?2004h> "]
[702.6813, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[702.68136, "o", "            y = run(x, wh, wl, b, cfg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[702.681453, "o", "            print(cfg, check(y), timeit(lambda: run(x, wh, wl, b, cfg)))\r\n\u001b[?2004l\r"]
[702.681481, "o", "\u001b[?2004h> "]
[702.681516, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[702.681547, "o", "\u001b[?2004h> "]
[702.6816, "o", "            print(cfg, \"FAILED\", type(ex).__name__)\r\n\u001b[?2004l\r"]
[702.681622, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[702.681652, "o", "\u001b[?2004h> "]
[702.681686, "o", "python3 /workspace/sweep3.py'\r\n\u001b[?2004l\r"]
