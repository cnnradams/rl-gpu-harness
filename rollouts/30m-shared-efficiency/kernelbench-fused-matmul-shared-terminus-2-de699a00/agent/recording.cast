[790.06149, "o", "gpu: NVIDIA H100 80GB HBM3\r\nref (11.423871994018555, 11.413439750671387)\r\n{'BM': 128, 'BN': 128, 'BK': 128, 'GROUP': 8, 'num_warps': 8, 'num_stages': 2} (True, 4.935264587402344e-05) (3.7266879081726074, 3.6022400856018066)\r\n{'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8, 'num_warps': 8, 'num_stages': 2} (True, 4.935264587402344e-05) (3.096031904220581, 3.0216000080108643)\r\n{'BM': 256, 'BN': 256, 'BK': 32, 'GROUP': 8, 'num_warps': 8, 'num_stages': 2} (True, 4.887580871582031e-05) (42.200862884521484, 42.109920501708984)\r\n{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8, 'num_warps': 8, 'num_stages': 2} (True, 4.935264587402344e-05) (3.9443519115448, 3.859391927719116)\r\n{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 4, 'num_warps': 8, 'num_stages': 3} (True, 4.935264587402344e-05) (2.748703956604004, 2.736704111099243)\r\n{'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 16, 'num_warps': 8, 'num_stages': 3} (True, 4.935264587402344e-05) (2.7373759746551514, 2.7311038970947266)\r\n"]
