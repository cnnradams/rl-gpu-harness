[945.897881, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[945.89791, "o", "\u001b[?2004h> "]
[945.897938, "o", "def timeit(fn, n=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[945.897966, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[945.897997, "o", "\u001b[?2004h> "]
[945.898026, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[945.898055, "o", "\u001b[?2004h> "]
[945.898098, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[945.898126, "o", "\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r"]
[945.898157, "o", "\u001b[?2004h> "]
[945.898187, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[945.898213, "o", "\u001b[?2004h> "]
[945.898267, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[945.898294, "o", "\u001b[?2004h> "]
[945.898326, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[945.898352, "o", "\u001b[?2004h> "]
[945.898374, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[945.898415, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[945.898441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[945.898462, "o", "> "]
[945.898522, "o", "kA = make_kernel(\"A\"); kB = make_kernel(\"B\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[945.898615, "o", "cfg = dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[945.898638, "o", "> "]
[945.898662, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[945.898688, "o", "\u001b[?2004h> "]
[945.898724, "o", "    for name, k in [(\"A\", kA), (\"B\", kB)]:\r\n\u001b[?2004l\r"]
[945.89875, "o", "\u001b[?2004h> "]
[945.898818, "o", "        for c in [cfg, dict(cfg, GROUP=4), dict(cfg, num_stages=4)]:\r\n\u001b[?2004l\r"]
[945.898843, "o", "\u001b[?2004h> "]
[945.898867, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[945.898922, "o", "                y = run(k, x, wh, wl, b, c)\r\n\u001b[?2004l\r"]
[945.898946, "o", "\u001b[?2004h> "]
[945.899028, "o", "                print(name, c, check(y), timeit(lambda: run(k, x, wh, wl, b, c)))\r\n\u001b[?2004l\r"]
[945.899058, "o", "\u001b[?2004h> "]
[945.899089, "o", "            except Exception as ex:\r\n\u001b[?2004l\r"]
[945.899119, "o", "\u001b[?2004h> "]
[945.899174, "o", "                print(name, c, \"FAILED\", type(ex).__name__)\r\n\u001b[?2004l\r"]
[945.899199, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[945.899229, "o", "\u001b[?2004h> "]
[945.899254, "o", "python3 /workspace/sweep4.py'\r\n\u001b[?2004l\r"]
