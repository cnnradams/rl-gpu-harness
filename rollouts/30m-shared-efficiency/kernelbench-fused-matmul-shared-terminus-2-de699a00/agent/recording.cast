[231.261586, "o", "\u001b[?2004h> "]
[231.261617, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.261658, "o", "        w = self._w\r\n\u001b[?2004l\r\u001b[?2004h"]
[231.261688, "o", "> "]
