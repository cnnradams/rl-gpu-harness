[232.264824, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch\nsys.path.insert(0, '/opt/task')\nimport torch.nn.functional as F\nfrom reference import Model, get_init_inputs\n\ndev = torch.device('cuda')\ninit = get_init_inputs()\nwith torch.no_grad():\n    torch.manual_seed(42); torch.cuda.manual_seed(42)\n    ref = Model(*init).to(dev)\ntorch.manual_seed(123)\nx = torch.rand(16384, 4096, device=dev)\nwith torch.no_grad():\n    y_ref = ref(x)\n\ndef check(y):\n    ok = torch.allclose(y_ref, y, atol=1e-4, rtol=1e-4)\n    md = (y_ref - y).abs().max().item()\n    return ok, md\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    ts = []\n    for _ in range(n):\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\nprint('gpu:', torch.cuda.get_device_name())\nwith torch.no_grad():\n    print('ref', timeit(lambda: ref(x)))\n    W2 = (ref.matmul.weight * 1.5).conti"]
[232.264917, "i", "guous(); b2 = (ref.matmul.bias * 1.5).contiguous()\n    f1 = lambda: F.linear(x, W2, b2)\n    print('fp32 folded', check(f1()), timeit(f1))\n    torch.backends.cuda.matmul.allow_tf32 = True\n    def rt32(t):\n        return (t.view(torch.int32) & -8192).view(torch.float32)\n    Wt = ref.matmul.weight * 1.5\n    Wh = rt32(Wt).contiguous(); Wl = (Wt - Wh).contiguous()\n    Wht = Wh.t().contiguous(); Wlt = Wl.t().contiguous()\n    def f2():\n        xh = (x.view(torch.int32) & -8192).view(torch.float32)\n        xl = x - xh\n        y = torch.addmm(b2, xh, Wht.t())\n        y = torch.addmm(y, xl, Wht.t(), beta=1, alpha=1)\n        y = torch.addmm(y, xh, Wlt.t(), beta=1, alpha=1)\n        return y\n    print('tf32 3x', check(f2()), timeit(f2))\n    y2 = f2()\n    torch.backends.cuda.matmul.allow_tf32 = False\nEOF\n"]
