[454.354719, "i", "cat > /workspace/sol_triton.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _gemm3xfp16(X, WH, WL, B, Y, M, N, K,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = M // BM\n    grid_n = N // BN\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Xp = X + rm[:, None] * K + rk[None, :]\n    WHp = WH + rn[None, :] * K + rk[:, None]\n    WLp = WL + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, K, BK):\n        x = tl.load(Xp)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        wh = tl.load(WHp)\n        wl = tl.load(WLp)\n        ac"]
[454.354767, "i", "c = tl.dot(xh, wh, acc)\n        acc = tl.dot(xl, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        Xp += BK\n        WHp += BK\n        WLp += BK\n    b = tl.load(B + rn)\n    acc = acc + b[None, :]\n    Yp = Y + rm[:, None] * N + rn[None, :]\n    tl.store(Yp, acc)\n\n\n_CFG = dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=3)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._wh = None\n        self._wl = None\n        self._b = None\n\n    def _prepare(self, device):\n        with torch.no_grad():\n            s = 1.0 + float(self.scaling_factor)\n            w = (self.matmul.weight.detach().to(device) * s)\n            wh = w.half().contiguous()\n            wl = (w - wh.float()).half().contiguous()\n            b = (self.matmul.bias.detach().to(device) * s).contiguous()\n        self._wh, self._wl, self._b = wh, wl, b\n\n    d"]
[454.354781, "i", "ef forward(self, x):\n        x = x.contiguous()\n        if self._wh is None or self._wh.device != x.device:\n            self._prepare(x.device)\n        M, K = x.shape\n        N = self._wh.shape[0]\n        y = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        c = _CFG\n        grid = ((M // c['BM']) * (N // c['BN']),)\n        _gemm3xfp16[grid](x, self._wh, self._wl, self._b, y, M, N, K,\n                          BM=c['BM'], BN=c['BN'], BK=c['BK'], GROUP=c['GROUP'],\n                          num_warps=c['num_warps'], num_stages=c['num_stages'])\n        return y\n\n\nif __name__ == '__main__':\n    import sys\n    sys.path.insert(0, '/opt/task')\n    from reference import Model, get_init_inputs\n\n    dev = torch.device('cuda')\n    init = get_init_inputs()\n    with torch.no_grad():\n        torch.manual_seed(42)\n        torch.cuda.manual_seed(42)\n        ref = Model(*init).to(dev)\n        torch.manual_seed(42)\n        torch.cuda.manual_seed(42)\n        new = ModelNew(*init)\n    assert torch.equal(ref.matmu"]
[454.354832, "i", "l.weight, new.matmul.weight)\n    torch.manual_seed(123)\n    x = torch.rand(16384, 4096, device=dev)\n    with torch.no_grad():\n        y_ref = ref(x)\n\n    def check(y):\n        ok = torch.allclose(y_ref, y, atol=1e-4, rtol=1e-4)\n        md = (y_ref - y).abs().max().item()\n        return ok, md\n\n    def timeit(fn, n=20):\n        for _ in range(5):\n            fn()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n        ts = []\n        for _ in range(n):\n            s.record(); fn(); e.record(); torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n        ts.sort()\n        return ts[len(ts)//2], ts[0]\n\n    print('gpu:', torch.cuda.get_device_name())\n    with torch.no_grad():\n        print('ref', timeit(lambda: ref(x)))\n        for cfg in [\n            dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=3),\n            dict(BM=128, BN=128, BK=32, GROUP=8, num_warps=8, num_stages=5),\n            dict(BM=128, BN=256, BK=32, GROUP=8, num_warps=8, "]
[454.355027, "i", "num_stages=3),\n            dict(BM=256, BN=128, BK=32, GROUP=8, num_warps=8, num_stages=3),\n            dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=4, num_stages=3),\n            dict(BM=64, BN=256, BK=64, GROUP=8, num_warps=8, num_stages=2),\n            dict(BM=256, BN=64, BK=64, GROUP=8, num_warps=8, num_stages=2),\n            dict(BM=128, BN=64, BK=64, GROUP=8, num_warps=4, num_stages=4),\n        ]:\n            _CFG.update(cfg)\n            try:\n                y = new(x)\n                print(cfg, check(y), timeit(lambda: new(x)))\n            except Exception as ex:\n                print(cfg, 'FAILED', type(ex).__name__)\nEOF\n"]
