[231.261261, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[231.261296, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
