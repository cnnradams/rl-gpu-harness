[945.890712, "i", "gpu exec sb-jPczx3kh3bOZRNOc0y9C37 -- bash -c 'cat > /workspace/sweep4.py << \"PYEOF\"\nimport sys, torch\nsys.path.insert(0, \"/opt/task\")\nimport triton\nimport triton.language as tl\nfrom reference import Model, get_init_inputs\n\ndef make_kernel(order):\n    if order == \"A\":\n        @triton.jit\n        def kern(X, WH, WL, B, Y, M, N, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n            pid = tl.program_id(0)\n            grid_m = M // BM; grid_n = N // BN\n            width = GROUP * grid_n\n            group_id = pid // width\n            group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n            pid_m = group_id * GROUP + (pid % group_size)\n            pid_n = (pid % width) // group_size\n            rm = pid_m * BM + tl.arange(0, BM)\n            rn = pid_n * BN + tl.arange(0, BN)\n            rk = tl.arange(0, BK)\n            Xp = X + rm[:, None] * K + rk[None, :]\n            WHp = WH + rn[None, :] * K + rk[:, None]\n            WLp = WL + rn[None, :] * K + rk[:, None]\n  "]
[945.890946, "i", "          acc = tl.zeros((BM, BN), dtype=tl.float32)\n            for _ in range(0, K, BK):\n                x = tl.load(Xp)\n                xh = x.to(tl.float16)\n                xl = (x - xh.to(tl.float32)).to(tl.float16)\n                wh = tl.load(WHp)\n                wl = tl.load(WLp)\n                acc = tl.dot(xl, wh, acc)\n                acc = tl.dot(xh, wl, acc)\n                acc = tl.dot(xh, wh, acc)\n                Xp += BK; WHp += BK; WLp += BK\n            b = tl.load(B + rn)\n            acc = acc + b[None, :]\n            tl.store(Y + rm[:, None] * N + rn[None, :], acc)\n        return kern\n    if order == \"B\":\n        @triton.jit\n        def kern(X, WH, WL, B, Y, M, N, K, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n            pid = tl.program_id(0)\n            grid_m = M // BM; grid_n = N // BN\n            width = GROUP * grid_n\n            group_id = pid // width\n            group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n            pid_m = group_id * "]
[945.891004, "o", "gpu exec sb-jPczx3kh3bOZRNOc0y9C37 -- bash -c 'cat > /workspace/sweep4.py << \"PYEOF\"\r\n\u001b[?2004l\r"]
[945.891045, "i", "GROUP + (pid % group_size)\n            pid_n = (pid % width) // group_size\n            rm = pid_m * BM + tl.arange(0, BM)\n            rn = pid_n * BN + tl.arange(0, BN)\n            rk = tl.arange(0, BK)\n            Xp = X + rm[:, None] * K + rk[None, :]\n            WHp = WH + rn[None, :] * K + rk[:, None]\n            WLp = WL + rn[None, :] * K + rk[:, None]\n            acc = tl.zeros((BM, BN), dtype=tl.float32)\n            for _ in range(0, K, BK):\n                x = tl.load(Xp)\n                xh = x.to(tl.float16)\n                xl = (x - xh.to(tl.float32)).to(tl.float16)\n                wh = tl.load(WHp)\n                wl = tl.load(WLp)\n                acc = tl.dot(xl, wh, acc)\n                acc = tl.dot(xh, wh, acc)\n                acc = tl.dot(xh, wl, acc)\n                Xp += BK; WHp += BK; WLp += BK\n            b = tl.load(B + rn)\n            acc = acc + b[None, :]\n            tl.store(Y + rm[:, None] * N + rn[None, :], acc)\n        return kern\n\ndef run(kern, x, wh, wl, b, c):\n    M, K = x.shape\n"]
[945.89107, "o", "\u001b[?2004h> "]
[945.891097, "i", "    N = wh.shape[0]\n    y = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    grid = ((M // c[\"BM\"]) * (N // c[\"BN\"]),)\n    kern[grid](x, wh, wl, b, y, M, N, K, BM=c[\"BM\"], BN=c[\"BN\"], BK=c[\"BK\"], GROUP=c[\"GROUP\"], num_warps=c[\"num_warps\"], num_stages=c[\"num_stages\"])\n    return y\n\ndev = torch.device(\"cuda\")\ninit = get_init_inputs()\nwith torch.no_grad():\n    torch.manual_seed(42); torch.cuda.manual_seed(42)\n    ref = Model(*init).to(dev)\n    torch.manual_seed(123)\n    x = torch.rand(16384, 4096, device=dev)\n    y_ref = ref(x)\n    w = ref.matmul.weight.detach() * 1.5\n    wh = w.half().contiguous()\n    wl = (w - wh.float()).half().contiguous()\n    b = (ref.matmul.bias.detach() * 1.5).contiguous()\n\ndef check(y):\n    return torch.allclose(y_ref, y, atol=1e-4, rtol=1e-4), (y_ref - y).abs().max().item()\n\ndef timeit(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    ts = []\n    for _ in range(n):\n        s.record(); fn(); e.r"]
[945.891119, "o", "import sys, torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[945.891144, "i", "ecord(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\nkA = make_kernel(\"A\"); kB = make_kernel(\"B\")\ncfg = dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=3)\nwith torch.no_grad():\n    for name, k in [(\"A\", kA), (\"B\", kB)]:\n        for c in [cfg, dict(cfg, GROUP=4), dict(cfg, num_stages=4)]:\n            try:\n                y = run(k, x, wh, wl, b, c)\n                print(name, c, check(y), timeit(lambda: run(k, x, wh, wl, b, c)))\n            except Exception as ex:\n                print(name, c, \"FAILED\", type(ex).__name__)\nPYEOF\npython3 /workspace/sweep4.py'\n"]
