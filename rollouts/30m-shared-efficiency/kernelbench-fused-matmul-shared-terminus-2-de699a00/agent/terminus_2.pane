    tl.store(Yp, acc)

def run(x, wh, wl, b, c):
    M, K = x.shape
    N = wh.shape[0]
    y = torch.empty((M, N), device=x.device, dtype=torch.float32)
    grid = ((M // c["BM"]) * (N // c["BN"]),)
    _gemm3xfp16[grid](x, wh, wl, b, y, M, N, K,
                      BM=c["BM"], BN=c["BN"], BK=c["BK"], GROUP=c["GROUP"],
                      num_warps=c["num_warps"], num_stages=c["num_stages"])
    return y

dev = torch.device("cuda")
init = get_init_inputs()
with torch.no_grad():
    torch.manual_seed(42); torch.cuda.manual_seed(42)
    ref = Model(*init).to(dev)
    torch.manual_seed(123)
    x = torch.rand(16384, 4096, device=dev)
    y_ref = ref(x)
    w = ref.matmul.weight.detach() * 1.5
    wh = w.half().contiguous()
    wl = (w - wh.float()).half().contiguous()
    b = (ref.matmul.bias.detach() * 1.5).contiguous()

def check(y):
    ok = torch.allclose(y_ref, y, atol=1e-4, rtol=1e-4)
    md = (y_ref - y).abs().max().item()
    return ok, md

def timeit(fn, n=20):
    for _ in range(5): fn()
    torch.cuda.synchronize()
    s = torch.cuda.Event(True); e = torch.cuda.Event(True)
    ts = []
    for _ in range(n):
        s.record(); fn(); e.record(); torch.cuda.synchronize()
        ts.append(s.elapsed_time(e))
    ts.sort()
    return ts[len(ts)//2], ts[0]

print("gpu:", torch.cuda.get_device_name())
with torch.no_grad():
    print("ref", timeit(lambda: ref(x)))
    for cfg in [
        dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=8, num_stages=3),
        dict(BM=128, BN=128, BK=32, GROUP=8, num_warps=8, num_stages=5),
        dict(BM=128, BN=256, BK=32, GROUP=8, num_warps=8, num_stages=3),
        dict(BM=256, BN=128, BK=32, GROUP=8, num_warps=8, num_stages=3),
        dict(BM=128, BN=128, BK=64, GROUP=8, num_warps=4, num_stages=3),
        dict(BM=128, BN=64, BK=64, GROUP=8, num_warps=4, num_stages=4),
        dict(BM=256, BN=64, BK=64, GROUP=8, num_warps=8, num_stages=2),
    ]:
        try:
            y = run(x, wh, wl, b, cfg)
            print(cfg, check(y), timeit(lambda: run(x, wh, wl, b, cfg)))
        except Exception as ex:
            print(cfg, "FAILED", type(ex).__name__)
