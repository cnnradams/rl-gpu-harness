[?2004l: 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),
        triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),
        triton.Config({'BM': 64, 'BN': 256, 'BK': 128, 'GM': 8}, num_warps=4, num_stages=3),
    ], key=['M', 'N', 'K'])
@triton.jit
def k2(A, BH, Bias, C, M, N, K,
       sam, sak, sbk, sbn, scm, scn, coef,
       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):
    pid = tl.program_id(0)
    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)
    width = GM * grid_n
    gid = pid // width
    gsz = tl.minimum(grid_m - gid * GM, GM)
    pid_m = gid * GM + (pid % gsz)
    pid_n = (pid % width) // gsz
    rm = pid_m * BM + tl.arange(0, BM)
    rn = pid_n * BN + tl.arange(0, BN)
    rk = tl.arange(0, BK)
    Ap = A + rm[:, None] * sam + rk[None, :] * sak
    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn
    acc = tl.zeros((BM, BN), dtype=tl.float32)
    for k in range(0, K, BK):
        a = tl.load(Ap)
        ah = a.to(tl.float16)
        al = (a - ah.to(tl.float32)).to(tl.float16)
        b_h = tl.load(BHp)
        acc = tl.dot(ah, b_h, acc)
        acc = tl.dot(al, b_h, acc)
        Ap += BK * sak; BHp += BK * sbk
    b = tl.load(Bias + rn).to(tl.float32)
    acc = (acc + b[None, :]) * coef
    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)

out = torch.empty(M, N, device=dev, dtype=torch.float32)

def run2(x):
    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)
    k2[grid](x, bh, bias, out, M, N, K,
             x.stride(0), x.stride(1), bh.stride(0), bh.stride(1),
             out.stride(0), out.stride(1), 1.5)
    return out

def run3(x):
    xh = x.half(); xl = (x - xh.float()).half()
    y = torch.mm(xh, bh) + torch.mm(xl, bh) + torch.mm(xh, bl)
    return (y + bias) * 1.5

# eval trial seeds
torch.manual_seed(42)
trial_seeds = [torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(5)]
print('trial seeds', trial_seeds)

worst2 = 0.0; worst3 = 0.0
for s in trial_seeds + [42, 1, 2, 3, 123, 999, 31337]:
    torch.manual_seed(s)
    x = torch.rand(M, K).to(dev)
    ref = torch.nn.functional.linear(x, lin.weight.to(dev), bias) * 1.5
    o2 = run2(x).clone()
    o3 = run3(x)
    r2 = ((o2 - ref).abs() / (1e-4 + 1e-4 * o2.abs())).max().item()
