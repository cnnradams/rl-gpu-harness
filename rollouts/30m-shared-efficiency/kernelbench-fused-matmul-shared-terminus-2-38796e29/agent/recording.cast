[556.397537, "o", "        x = self.matmul(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[556.397578, "o", "        original_x = x.clone().detach()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[556.397631, "o", "        x = x * self.scaling_factor\r\n\u001b[?2004l\r"]
