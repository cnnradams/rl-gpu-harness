[848.696625, "o", "        coef = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[848.696691, "o", "        grid = lambda META: (triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[848.696721, "o", ">         _split_fp16_linear_kernel[grid](\r\n\u001b[?2004l\r"]
[848.696751, "o", "\u001b[?2004h> "]
[848.696781, "o", "            x, self._bh, self._bl, self._bias, out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[848.696813, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[848.696844, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[848.696888, "o", "            self._bh.stride(0), self._bh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[848.696925, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h>             coef,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[848.696957, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n\u001b[?2004l\r"]
[848.696987, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
