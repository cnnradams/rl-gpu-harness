[297.795853, "o", "    xh = x.half(); xl = (x - xh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.795887, "o", "    y = torch.mm(xh, bh) + torch.mm(xh, bl) + torch.mm(xl, bh)\r\n\u001b[?2004l\r\u001b[?2004h> "]
