[297.795985, "o", "def check(fn, name):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796016, "o", "    fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796048, "o", "    err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796107, "o", "    print(name, 'max err', err, 'allclose', torch.allclose(out, ref, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[297.796139, "o", "\u001b[?2004h> def bench(fn, name):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.79617, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796203, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796233, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796278, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796312, "o", "    for _ in range(10):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.796342, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
