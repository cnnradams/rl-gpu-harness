[485.790753, "o", "        triton.Config({'BM': 64, 'BN': 256, 'BK': 128, 'GM': 8}, num_warps=4, num_stages=3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.790786, "o", "    ], key=['M', 'N', 'K'])\r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[485.790818, "o", "\u001b[?2004h> def k2(A, BH, Bias, C, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.790849, "o", ">        sam, sak, sbk, sbn, scm, scn, coef,\r\n\u001b[?2004l\r"]
[485.790879, "o", "\u001b[?2004h> "]
[485.790909, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n\u001b[?2004l\r"]
[485.790942, "o", "\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.790984, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791015, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791043, "o", "    gid = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791077, "o", "    gsz = tl.minimum(grid_m - gid * GM, GM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791111, "o", "    pid_m = gid * GM + (pid % gsz)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791141, "o", "    pid_n = (pid % width) // gsz\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791175, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791212, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791241, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791271, "o", "    Ap = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791302, "o", "    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791332, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[485.791365, "o", "\u001b[?2004h>     for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[485.791396, "o", "\u001b[?2004h>         a = tl.load(Ap)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791426, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791453, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791485, "o", "        b_h = tl.load(BHp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791515, "o", "        acc = tl.dot(ah, b_h, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791546, "o", "        acc = tl.dot(al, b_h, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791577, "o", "        Ap += BK * sak; BHp += BK * sbk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791608, "o", "    b = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791636, "o", "    acc = (acc + b[None, :]) * coef\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791668, "o", "    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.7917, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791727, "o", "out = torch.empty(M, N, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[485.791758, "o", "\u001b[?2004h> def run2(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791807, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791839, "o", "    k2[grid](x, bh, bias, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791887, "o", "             x.stride(0), x.stride(1), bh.stride(0), bh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791923, "o", "             out.stride(0), out.stride(1), 1.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.791946, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[485.791979, "o", "\u001b[?2004l\r\u001b[?2004h> def run3(x):\r\n\u001b[?2004l\r"]
[485.79201, "o", "\u001b[?2004h> "]
[485.792045, "o", "    xh = x.half(); xl = (x - xh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792085, "o", "    y = torch.mm(xh, bh) + torch.mm(xl, bh) + torch.mm(xh, bl)\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.792117, "o", ">     return (y + bias) * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[485.792147, "o", "\u001b[?2004h> # eval trial seeds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792185, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792229, "o", "trial_seeds = [torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(5)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.792261, "o", "> print('trial seeds', trial_seeds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.792284, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792315, "o", "worst2 = 0.0; worst3 = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792345, "o", "for s in trial_seeds + [42, 1, 2, 3, 123, 999, 31337]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.792376, "o", ">     torch.manual_seed(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792407, "o", "    x = torch.rand(M, K).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792458, "o", "    ref = torch.nn.functional.linear(x, lin.weight.to(dev), bias) * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.79249, "o", "    o2 = run2(x).clone()\r\n\u001b[?2004l\r\u001b[?2004h>     o3 = run3(x)\r\n\u001b[?2004l\r"]
[485.79252, "o", "\u001b[?2004h> "]
[485.792551, "o", "    r2 = ((o2 - ref).abs() / (1e-4 + 1e-4 * o2.abs())).max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792596, "o", "    r3 = ((o3 - ref).abs() / (1e-4 + 1e-4 * o3.abs())).max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792637, "o", "    worst2 = max(worst2, r2); worst3 = max(worst3, r3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792683, "o", "    print(f'seed {s}: 2dot ratio {r2:.4f}  3dot ratio {r3:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792724, "o", "print('worst ratios (must be < 1):', worst2, worst3)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[485.792756, "o", "\u001b[?2004h> def bench(fn, name, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.792786, "o", ">     for _ in range(5): fn(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792812, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792843, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792876, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.792907, "o", "    for _ in range(11):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.79294, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h>         dummy.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.79297, "o", "> "]
[485.793, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[485.793034, "o", "\u001b[?2004h>         s.record(); fn(x); e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793065, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793092, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[485.793122, "o", "\u001b[?2004h>     times = times[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793191, "o", "    print(name, 'mean %.3f ms  min %.3f' % (sum(times)/len(times), min(times)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793224, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793254, "o", "torch.manual_seed(7)\r\n\u001b[?2004l\r\u001b[?2004h> x = torch.rand(M, K).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793287, "o", "bench(run2, '2dot fused', x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.793316, "o", "print(k2.best_config)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[485.795619, "o", "\u001b[?2004hroot@modal:/# "]
[485.795653, "o", "gpu sync && gpu run -- python3 /workspace/bench2.py\r\n\u001b[?2004l\r"]
[488.200763, "o", "{\r\n  \"box\": null,\r\n  \"committed\": [\r\n    \"agent\"\r\n  ],\r\n  \"reloaded\": [\r\n    \"agent\"\r\n  ]\r\n}\r\n"]
[488.329691, "o", "request ID: 65a2312a15e44240a757c68a647ffac6\r\n"]
[494.613132, "o", "box: sb-4SliUcx4cxcdZJz3hkwuik\r\ncommand: a9278600a2f541f38c654702026985e9\r\n"]
[508.588592, "o", "trial seeds [734796314, 576165995, 2197670066, 839703249, 2584932063]\r\nseed 734796314: 2dot ratio 4.2502  3dot ratio 5.2518\r\nseed 576165995: 2dot ratio 4.3292  3dot ratio 5.2145\r\nseed 2197670066: 2dot ratio 4.5875  3dot ratio 5.1032\r\nseed 839703249: 2dot ratio 4.3693  3dot ratio 5.3633\r\nseed 2584932063: 2dot ratio 4.3242  3dot ratio 5.6107\r\nseed 42: 2dot ratio 4.5087  3dot ratio 5.3137\r\nseed 1: 2dot ratio 4.7475  3dot ratio 5.2495\r\nseed 2: 2dot ratio 4.6254  3dot ratio 5.0616\r\nseed 3: 2dot ratio 4.4593  3dot ratio 5.3625\r\nseed 123: 2dot ratio 4.3947  3dot ratio 5.3481\r\nseed 999: 2dot ratio 4.3557  3dot ratio 5.2150\r\nseed 31337: 2dot ratio 4.4986  3dot ratio 5.0929\r\nworst ratios (must be < 1): 4.747508525848389 5.610703468322754\r\n2dot fused mean 1.607 ms  min 1.605\r\nBM: 128, BN: 256, BK: 64, GM: 8, num_warps: 8, num_ctas: 1, num_stages: 4, maxnreg: None\r\n"]
[513.763597, "o", "\u001b[?2004hroot@modal:/# "]
[556.396795, "i", "cat > /workspace/margin.py << 'EOF'\nimport torch, torch.nn as nn, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\n\ndev = torch.device('cuda')\nM, K, N, sf = 16384, 4096, 4096, 0.5\n\nclass Model(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n    def forward(self, x):\n        x = self.matmul(x)\n        original_x = x.clone().detach()\n        x = x * self.scaling_factor\n        x = x + original_x\n        return x\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\nwith torch.no_grad():\n    set_seed(42)\n    ref_model = Model(K, N, sf).to(dev)\n\nfrom solution import ModelNew as Sol3\nwith torch.no_grad():\n    set_seed(42)\n    sol3 = Sol3(K, N, sf).to(dev)\n\nimport bench2  # reuse k2 kernel? no, bench2 runs stuff. Define k2 inline instead.\nEOF\necho skip\n"]
[556.397049, "o", "cat > /workspace/margin.py << 'EOF'\r\n\u001b[?2004l\r"]
[556.397119, "o", "\u001b[?2004h> import torch, torch.nn as nn, sys\r\n\u001b[?2004l\r\u001b[?2004h> "]
[556.397153, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[556.397181, "o", "import triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[556.397208, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[556.39724, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[556.397267, "o", "M, K, N, sf = 16384, 4096, 4096, 0.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[556.397291, "o", "\u001b[?2004h> class Model(nn.Module):\r\n\u001b[?2004l\r"]
