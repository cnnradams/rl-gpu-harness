[649.90688, "o", "print('fused ok', torch.allclose(out, ref, atol=1e-4, rtol=1e-4))\r\n\u001b[?2004l\r"]
[649.90691, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
