[573.144181, "i", "cat > /workspace/margin.py << 'EOF'\nimport torch, torch.nn as nn, sys\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\n\ndev = torch.device('cuda')\nM, K, N, sf = 16384, 4096, 4096, 0.5\n\nclass Model(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n    def forward(self, x):\n        x = self.matmul(x)\n        original_x = x.clone().detach()\n        x = x * self.scaling_factor\n        x = x + original_x\n        return x\n\ndef set_seed(s):\n    torch.manual_seed(s); torch.cuda.manual_seed(s)\n\nwith torch.no_grad():\n    set_seed(42)\n    ref_model = Model(K, N, sf).to(dev, dtype=torch.float32)\n\nfrom solution import ModelNew as Sol3\nwith torch.no_grad():\n    set_seed(42)\n    sol3 = Sol3(K, N, sf).to(dev, dtype=torch.float32)\n\n@triton.autotune(configs=[\n    triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\n  "]
[573.144242, "i", "  triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\n], key=['M', 'N', 'K'])\n@triton.jit\ndef k2(A, BH, Bias, C, M, N, K, sam, sak, sbk, sbn, scm, scn, coef,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        b_h = tl.load(BHp)\n       "]
[573.144255, "i", " acc = tl.dot(ah, b_h, acc)\n        acc = tl.dot(al, b_h, acc)\n        Ap += BK * sak; BHp += BK * sbk\n    b = tl.load(Bias + rn).to(tl.float32)\n    acc = (acc + b[None, :]) * coef\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\nwith torch.no_grad():\n    Wt = ref_model.matmul.weight.detach().t().contiguous()\n    bh = Wt.half()\n    bias = ref_model.matmul.bias.detach().contiguous()\n    out2 = torch.empty(M, N, device=dev, dtype=torch.float32)\n    def run2(x):\n        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n        k2[grid](x, bh, bias, out2, M, N, K, x.stride(0), x.stride(1),\n                 bh.stride(0), bh.stride(1), out2.stride(0), out2.stride(1), 1.5)\n        return out2\n\n    torch.manual_seed(42)\n    trial_seeds = [torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(5)]\n    worst3 = worst2 = 0.0\n    for s in trial_seeds + [42, 1, 7, 12345]:\n        set_seed(s)\n        x = torch.rand(M, K).to(dev)\n        ref = ref_model(x)\n        o3 = sol3(x)\n    "]
[573.144569, "i", "    o2 = run2(x).clone()\n        r3 = ((o3 - ref).abs() / (1e-4 + 1e-4 * o3.abs())).max().item()\n        r2 = ((o2 - ref).abs() / (1e-4 + 1e-4 * o2.abs())).max().item()\n        ok3 = torch.allclose(ref, o3, atol=1e-4, rtol=1e-4)\n        ok2 = torch.allclose(ref, o2, atol=1e-4, rtol=1e-4)\n        worst3 = max(worst3, r3); worst2 = max(worst2, r2)\n        print(f'seed {s}: 3dot ratio {r3:.4f} ok={ok3}   2dot ratio {r2:.4f} ok={ok2}')\n    print('WORST (must be <<1):', '3dot', worst3, '2dot', worst2)\nEOF\ngpu sync && gpu run -- python3 /workspace/margin.py\n"]
