[141.292326, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.292336, "o", "\u001b[?2004h> "]
[141.292372, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.292412, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.292424, "o", "> "]
[141.292437, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[141.292447, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.292457, "o", "\u001b[?2004h> "]
[141.2925, "o", "    A_ptr = A + rm[:, None] * stride_am + rk[None, :] * stride_ak\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.292511, "o", "> "]
[141.292547, "o", "    BH_ptr = BH + rk[:, None] * stride_bk + rn[None, :] * stride_bn\r\n\u001b[?2004l\r"]
[141.292559, "o", "\u001b[?2004h> "]
[141.292596, "o", "    BL_ptr = BL + rk[:, None] * stride_bk + rn[None, :] * stride_bn\r\n\u001b[?2004l\r"]
[141.292608, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.29262, "o", "\u001b[?2004h> "]
[141.292656, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[141.292666, "o", "\u001b[?2004h> "]
[141.292688, "o", "    for k in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r"]
[141.292697, "o", "\u001b[?2004h> "]
[141.292716, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[141.292726, "o", "\u001b[?2004h> "]
[141.292744, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[141.292756, "o", "\u001b[?2004h> "]
[141.292792, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.292802, "o", "> "]
[141.292817, "o", "        bh = tl.load(BH_ptr)\r\n\u001b[?2004l\r"]
[141.292827, "o", "\u001b[?2004h> "]
[141.292849, "o", "        bl = tl.load(BL_ptr)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.292859, "o", "> "]
[141.292877, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[141.292887, "o", "\u001b[?2004h> "]
[141.292908, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.292918, "o", "> "]
[141.292945, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.292954, "o", "> "]
[141.292974, "o", "        A_ptr += BLOCK_K * stride_ak\r\n\u001b[?2004l\r"]
[141.292984, "o", "\u001b[?2004h> "]
[141.293015, "o", "        BH_ptr += BLOCK_K * stride_bk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293048, "o", "        BL_ptr += BLOCK_K * stride_bk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[141.293058, "o", "\u001b[?2004l\r\u001b[?2004h"]
[141.293068, "o", "> "]
[141.293099, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293133, "o", "    acc = (acc + bias[None, :]) * coef\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293182, "o", "    C_ptr = C + rm[:, None] * stride_cm + rn[None, :] * stride_cn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.29322, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293231, "o", "\r\n\u001b[?2004l\r"]
[141.29324, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[141.293251, "o", "> "]
[141.293267, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[141.293278, "o", "\u001b[?2004h> "]
[141.293322, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293349, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.293359, "o", "> "]
[141.293394, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.293405, "o", "> "]
[141.29343, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[141.293439, "o", "\u001b[?2004h> "]
[141.293455, "o", "        self._bh = None\r\n\u001b[?2004l\r"]
[141.293466, "o", "\u001b[?2004h> "]
[141.293487, "o", "        self._bl = None\r\n\u001b[?2004l\r"]
[141.293497, "o", "\u001b[?2004h> "]
[141.293516, "o", "        self._bias = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[141.293527, "o", "\u001b[?2004h> "]
[141.29355, "o", "    def _prep(self, device):\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.29356, "o", "> "]
[141.293614, "o", "        w = self.matmul.weight.detach().to(device=device, dtype=torch.float32).t().contiguous()\r\n\u001b[?2004l\r"]
[141.293625, "o", "\u001b[?2004h> "]
[141.293637, "o", "        bh = w.half()\r\n\u001b[?2004l\r"]
[141.293647, "o", "\u001b[?2004h> "]
[141.293669, "o", "        bl = (w - bh.float()).half()\r\n\u001b[?2004l\r"]
[141.293678, "o", "\u001b[?2004h> "]
[141.293693, "o", "        self._bh = bh\r\n\u001b[?2004l\r"]
[141.293703, "o", "\u001b[?2004h> "]
[141.293724, "o", "        self._bl = bl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293787, "o", "        self._bias = self.matmul.bias.detach().to(device=device, dtype=torch.float32).contiguous()\r\n\u001b[?2004l\r"]
[141.2938, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.293824, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[141.293835, "o", "\u001b[?2004h> "]
[141.293873, "o", "        if self._bh is None or self._bh.device != x.device:\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.293883, "o", "> "]
[141.293908, "o", "            self._prep(x.device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.293918, "o", "> "]
[141.29393, "o", "        x = x.contiguous()\r\n"]
[141.29394, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[141.293963, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.293972, "o", "> "]
[141.293997, "o", "        N = self._bh.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.294008, "o", "> "]
[141.294051, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.294091, "o", "        coef = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[141.294108, "o", "\u001b[?2004h> "]
[141.294175, "o", "        grid = lambda META: (triton.cdiv(M, META['BLOCK_M']) * triton.cdiv(N, META['BLOCK_N']),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.294187, "o", "> "]
[141.294223, "o", "        _split_fp16_linear_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.294265, "o", "            x, self._bh, self._bl, self._bias, out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.294288, "o", "            M, N, K,\r\n\u001b[?2004l\r"]
[141.294299, "o", "\u001b[?2004h> "]
[141.294324, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.294334, "o", "> "]
[141.294369, "o", "            self._bh.stride(0), self._bh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[141.294379, "o", "> "]
[141.294403, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[141.294412, "o", "\u001b[?2004h> "]
[141.294425, "o", "            coef,\r\n\u001b[?2004l\r"]
[141.294435, "o", "\u001b[?2004h> "]
[141.294452, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[141.294469, "o", "        return out\r\n\u001b[?2004l\r"]
[141.294481, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[141.29895, "o", "\u001b[?2004hroot@modal:/# echo done\r\n\u001b[?2004l\r"]
[141.298981, "o", "done\r\n\u001b[?2004hroot@modal:/# "]
