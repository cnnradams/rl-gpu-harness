[556.397994, "o", ">     set_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[556.398031, "o", "    sol3 = Sol3(K, N, sf).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
