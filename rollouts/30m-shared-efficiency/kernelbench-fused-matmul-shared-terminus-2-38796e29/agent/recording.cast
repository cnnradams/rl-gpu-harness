[649.900038, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev = 'cuda'\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(42)\nlin = torch.nn.Linear(K, N)\nWt = lin.weight.detach().t().contiguous().to(dev)\nbias = lin.bias.detach().to(dev)\nbh = Wt.half(); bl = (Wt - bh.float()).half()\nx = torch.rand(M, K, device=dev)\nout = torch.empty(M, N, device=dev, dtype=torch.float32)\n\ncfgs = []\nfor BM in (128, 256):\n    for BN in (128, 256):\n        for BK in (64, 128):\n            for st in (3, 4, 5):\n                cfgs.append(triton.Config({'BM': BM, 'BN': BN, 'BK': BK, 'GM': 8}, num_warps=8, num_stages=st))\n\n@triton.autotune(configs=cfgs, key=['M', 'N', 'K'])\n@triton.jit\ndef k_fused(A, BH, BL, Bias, C, M, N, K,\n            sam, sak, sbk, sbn, scm, scn, coef,\n            BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid *"]
[649.900101, "i", " GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        b_h = tl.load(BHp); b_l = tl.load(BLp)\n        acc = tl.dot(ah, b_l, acc)\n        acc = tl.dot(al, b_h, acc)\n        acc = tl.dot(ah, b_h, acc)\n        Ap += BK * sak; BHp += BK * sbk; BLp += BK * sbk\n    b = tl.load(Bias + rn).to(tl.float32)\n    acc = (acc + b[None, :]) * coef\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\n@triton.autotune(configs=cfgs, key=['M', 'N', 'K'])\n@triton.jit\ndef k_pre(AH, AL, BH, BL, Bias, C, M, N, K,\n          sam, sak, sbk, sbn, scm, scn, coef,\n"]
[649.900108, "i", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AHp = AH + rm[:, None] * sam + rk[None, :] * sak\n    ALp = AL + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(AHp); al = tl.load(ALp)\n        b_h = tl.load(BHp); b_l = tl.load(BLp)\n        acc = tl.dot(ah, b_l, acc)\n        acc = tl.dot(al, b_h, acc)\n        acc = tl.dot(ah, b_h, acc)\n        AHp += BK * sak; ALp += BK * sak; BHp += BK * sbk; BLp += BK * sbk\n    b = tl.load(Bias + rn).to(tl.floa"]
[649.900141, "i", "t32)\n    acc = (acc + b[None, :]) * coef\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\n@triton.jit\ndef k_split(A, AH, AL, total, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < total\n    a = tl.load(A + offs, mask=mask)\n    ah = a.to(tl.float16)\n    al = (a - ah.to(tl.float32)).to(tl.float16)\n    tl.store(AH + offs, ah, mask=mask)\n    tl.store(AL + offs, al, mask=mask)\n\nah_buf = torch.empty(M, K, device=dev, dtype=torch.float16)\nal_buf = torch.empty(M, K, device=dev, dtype=torch.float16)\n\ndef run_fused():\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    k_fused[grid](x, bh, bl, bias, out, M, N, K, x.stride(0), x.stride(1),\n                  bh.stride(0), bh.stride(1), out.stride(0), out.stride(1), 1.5)\n\ndef run_pre():\n    total = M * K\n    k_split[(triton.cdiv(total, 8192),)](x, ah_buf, al_buf, total, BLOCK=8192)\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),"]
[649.900321, "i", ")\n    k_pre[grid](ah_buf, al_buf, bh, bl, bias, out, M, N, K, ah_buf.stride(0), ah_buf.stride(1),\n                bh.stride(0), bh.stride(1), out.stride(0), out.stride(1), 1.5)\n\ndef bench(fn, name):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device=dev)\n    times = []\n    for _ in range(15):\n        torch.cuda.synchronize(); dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    print(name, 'mean %.3f ms min %.3f' % (sum(times)/len(times), min(times)))\n\nbench(run_fused, 'fused3')\nprint('fused best:', k_fused.best_config)\nbench(run_pre, 'presplit3')\nprint('pre best:', k_pre.best_config)\nref = torch.nn.functional.linear(x, lin.weight.to(dev), bias) * 1.5\nprint('fused ok', torch.allclose(out, ref, atol=1e-4, rtol=1e-4))\nEOF\ngpu sync && gpu run -- python3 /workspace"]
