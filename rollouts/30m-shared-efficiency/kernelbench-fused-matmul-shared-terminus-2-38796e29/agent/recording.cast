[649.906177, "o", "                bh.stride(0), bh.stride(1), out.stride(0), out.stride(1), 1.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906198, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906235, "o", "def bench(fn, name):\r\n\u001b[?2004l\r\u001b[?2004h>     for _ in range(5): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906267, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906317, "o", "    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906346, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906376, "o", "    for _ in range(15):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906405, "o", "        torch.cuda.synchronize(); dummy.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[649.906435, "o", "> "]
[649.906475, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[649.906505, "o", "> "]
[649.906527, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906561, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h"]
[649.906591, "o", ">     times = times[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[649.906645, "o", "    print(name, 'mean %.3f ms min %.3f' % (sum(times)/len(times), min(times)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[649.906673, "o", "\u001b[?2004h> bench(run_fused, 'fused3')\r\n\u001b[?2004l\r"]
[649.906704, "o", "\u001b[?2004h> "]
[649.906733, "o", "print('fused best:', k_fused.best_config)\r\n\u001b[?2004l\r\u001b[?2004h> bench(run_pre, 'presplit3')\r\n\u001b[?2004l\r"]
[649.906764, "o", "\u001b[?2004h> print('pre best:', k_pre.best_config)\r\n\u001b[?2004l\r"]
[649.906792, "o", "\u001b[?2004h> "]
