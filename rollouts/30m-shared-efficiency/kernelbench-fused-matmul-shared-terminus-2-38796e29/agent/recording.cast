[872.946382, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.61,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.61,\r\n    \"std\": 0.00657,\r\n    \"min\": 2.6,\r\n    \"max\": 2.63,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0337,\r\n    \"min\": 11.4,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"6286291112e2639e6247fe1b7dd2b4bb62431bdb28adc006fe4db35d6b3a2e60\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.367816091954023\r\n}\r\n"]
[875.354348, "o", "\u001b[?2004hroot@modal:/# "]
[921.09901, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev = 'cuda'\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(42)\nlin = torch.nn.Linear(K, N)\nWt = lin.weight.detach().t().contiguous().to(dev)\nbias = lin.bias.detach().to(dev)\nbh = Wt.half(); bl = (Wt - bh.float()).half()\nx = torch.rand(M, K, device=dev)\nout = torch.empty(M, N, device=dev, dtype=torch.float32)\n\ncfgs = [\n    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 16}, num_warps=8, num_stages=3),\n    triton.Config({'BM': 256, 'BN': 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),\n    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\n    triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 16}, num_warps=8, num_stages=3),\n    triton.Config({'BM': 256, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n]\n\n@triton.autotune(configs=cfgs, key=['M', 'N', 'K'])\n@triton.jit\ndef k_dual(A, BH, B"]
[921.099067, "i", "L, Bias, C, M, N, K,\n           sam, sak, sbk, sbn, scm, scn, coef,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc_hh = tl.zeros((BM, BN), dtype=tl.float32)\n    acc_lh = tl.zeros((BM, BN), dtype=tl.float32)\n    acc_hl = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        b_h = tl.load(BHp); b_l = tl.load(BLp)\n        acc_hl = tl.dot(ah, b_l, acc_hl"]
[921.099075, "i", ")\n        acc_lh = tl.dot(al, b_h, acc_lh)\n        acc_hh = tl.dot(ah, b_h, acc_hh)\n        Ap += BK * sak; BHp += BK * sbk; BLp += BK * sbk\n    b = tl.load(Bias + rn).to(tl.float32)\n    acc = ((acc_hh + acc_lh + acc_hl) + b[None, :]) * coef\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\ndef run_dual():\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    k_dual[grid](x, bh, bl, bias, out, M, N, K, x.stride(0), x.stride(1),\n                 bh.stride(0), bh.stride(1), out.stride(0), out.stride(1), 1.5)\n\ndef bench(fn, name):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device=dev)\n    times = []\n    for _ in range(15):\n        torch.cuda.synchronize(); dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    print(name"]
[921.099079, "i", ", 'mean %.3f ms min %.3f' % (sum(times)/len(times), min(times)))\n\nbench(run_dual, 'dual-acc')\nprint('best:', k_dual.best_config)\nref = torch.nn.functional.linear(x, lin.weight.to(dev), bias) * 1.5\nprint('ok', torch.allclose(out, ref, atol=1e-4, rtol=1e-4))\nEOF\ngpu sync && gpu run -- python3 /workspace/sweep2.py\n"]
