[485.788383, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev = 'cuda'\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(42)\nlin = torch.nn.Linear(K, N)\nWt = lin.weight.detach().t().contiguous().to(dev)\nbias = lin.bias.detach().to(dev)\nbh = Wt.half(); bl = (Wt - bh.float()).half()\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 64, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 256, 'BN'"]
[485.788596, "i", ": 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 128, 'GM': 8}, num_warps=4, num_stages=3),\n    ], key=['M', 'N', 'K'])\n@triton.jit\ndef k2(A, BH, Bias, C, M, N, K,\n       sam, sak, sbk, sbn, scm, scn, coef,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    gid = pid // width\n    gsz = tl.minimum(grid_m - gid * GM, GM)\n    pid_m = gid * GM + (pid % gsz)\n    pid_n = (pid % width) // gsz\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        ah = a.to(tl.float16)\n        "]
[485.788611, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[485.788647, "i", "al = (a - ah.to(tl.float32)).to(tl.float16)\n        b_h = tl.load(BHp)\n        acc = tl.dot(ah, b_h, acc)\n        acc = tl.dot(al, b_h, acc)\n        Ap += BK * sak; BHp += BK * sbk\n    b = tl.load(Bias + rn).to(tl.float32)\n    acc = (acc + b[None, :]) * coef\n    tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\nout = torch.empty(M, N, device=dev, dtype=torch.float32)\n\ndef run2(x):\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    k2[grid](x, bh, bias, out, M, N, K,\n             x.stride(0), x.stride(1), bh.stride(0), bh.stride(1),\n             out.stride(0), out.stride(1), 1.5)\n    return out\n\ndef run3(x):\n    xh = x.half(); xl = (x - xh.float()).half()\n    y = torch.mm(xh, bh) + torch.mm(xl, bh) + torch.mm(xh, bl)\n    return (y + bias) * 1.5\n\n# eval trial seeds\ntorch.manual_seed(42)\ntrial_seeds = [torch.randint(0, 2**32 - 1, (1,)).item() for _ in range(5)]\nprint('trial seeds', trial_seeds)\n\nworst2 = 0.0; worst3 = 0.0\nfor s in trial_seeds + [42, 1, 2, 3, 123, 999, "]
[485.78867, "o", ": 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),\r\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GM': 8}, num_warps=8, num_stages=3),\r\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 128, 'GM': 8}, num_warps=4, num_stages=3),\r\n    ], key=['M', 'N', 'K'])\r\n@triton.jit\r\ndef k2(A, BH, Bias, C, M, N, K,\r\n       sam, sak, sbk, sbn, scm, scn, coef,\r\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr):\r\n    pid = tl.program_id(0)\r\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n    width = GM "]
[485.788699, "i", "31337]:\n    torch.manual_seed(s)\n    x = torch.rand(M, K).to(dev)\n    ref = torch.nn.functional.linear(x, lin.weight.to(dev), bias) * 1.5\n    o2 = run2(x).clone()\n    o3 = run3(x)\n    r2 = ((o2 - ref).abs() / (1e-4 + 1e-4 * o2.abs())).max().item()\n    r3 = ((o3 - ref).abs() / (1e-4 + 1e-4 * o3.abs())).max().item()\n    worst2 = max(worst2, r2); worst3 = max(worst3, r3)\n    print(f'seed {s}: 2dot ratio {r2:.4f}  3dot ratio {r3:.4f}')\nprint('worst ratios (must be < 1):', worst2, worst3)\n\ndef bench(fn, name, x):\n    for _ in range(5): fn(x)\n    torch.cuda.synchronize()\n    times = []\n    dummy = torch.empty(32*1024*1024, dtype=torch.int64, device=dev)\n    for _ in range(11):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(x); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    print(name, 'mean %.3f ms  min %.3f' % (sum(times)/len(time"]
