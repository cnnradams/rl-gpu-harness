[585.640464, "o", "\u001b[32m\u001b[K81\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            self._bias_s = (b * (\u001b[01;31m\u001b[K1.0 + s\u001b[m\u001b[K)).detach().contiguous()\r\n\u001b[32m\u001b[K87\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        _gemm_fp16x3[grid](x, w, self._bias_s, out, M, N, K, \u001b[01;31m\u001b[K1.0 + s\u001b[m\u001b[K)\r\n"]
