[384.51498, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n\n    def _configs():\n        return [\n            triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n            triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n            triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n            triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n            triton.Config({'BM': 64, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n            triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n        ]\n\n    @triton.autotune(configs=_configs(), key=['M', 'N', 'K'])\n    @triton.jit\n    def _gemm_fp16x3(A, W, BIAS, C, M, N, K, scale,\n                     B"]
[384.515219, "i", "M: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                     GROUP_M: tl.constexpr):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GROUP_M * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n        pid_m = group_id * GROUP_M + (pid % group_size)\n        pid_n = (pid % width) // group_size\n\n        offs_m = pid_m * BM + tl.arange(0, BM)\n        offs_n = pid_n * BN + tl.arange(0, BN)\n        offs_k = tl.arange(0, BK)\n        a_ptrs = A + offs_m[:, None] * K + offs_k[None, :]\n        w_ptrs = W + offs_n[:, None] * K + offs_k[None, :]\n        m_mask = offs_m[:, None] < M\n        n_mask = offs_n[:, None] < N\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            k_mask = (k + offs_k)[None, :] < K\n            a = tl.load(a_ptrs, mask=m_mask & k_mask, other=0.0)\n            w = tl.load(w_ptrs, mask=n_mask & k_mask, other=0.0)\n            a"]
[384.515268, "i", "_hi = a.to(tl.float16)\n            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n            b = tl.trans(w)\n            b_hi = b.to(tl.float16)\n            b_lo = (b - b_hi.to(tl.float32)).to(tl.float16)\n            acc = tl.dot(a_hi, b_hi, acc)\n            acc = tl.dot(a_hi, b_lo, acc)\n            acc = tl.dot(a_lo, b_hi, acc)\n            a_ptrs += BK\n            w_ptrs += BK\n        bias = tl.load(BIAS + offs_n, mask=offs_n < N, other=0.0)\n        c = acc * scale + bias[None, :]\n        c_ptrs = C + offs_m[:, None] * N + offs_n[None, :]\n        tl.store(c_ptrs, c, mask=m_mask & (offs_n[None, :] < N))\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._bias_s = None\n\n    def forward(self, x):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        s = float(self.scaling_factor)\n        if not ("]
[384.51533, "i", "_HAS_TRITON and x.is_cuda and x.dtype == torch.float32 and x.dim() == 2):\n            y = torch.nn.functional.linear(x, w, b)\n            return y * s + y\n        if self._bias_s is None or self._bias_s.device != x.device:\n            self._bias_s = (b * s).detach().contiguous()\n        M, K = x.shape\n        N = w.shape[0]\n        x = x.contiguous()\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n        _gemm_fp16x3[grid](x, w, self._bias_s, out, M, N, K, s)\n        return out\nEOF\necho written\n"]
