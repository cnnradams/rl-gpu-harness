[1065.167415, "o", "ref = torch.nn.functional.linear(x, w, bias) * 1.5\r\n\u001b[?2004l\r \u001b[?2004h> \r\n"]
[1065.167447, "o", "\u001b[?2004l\rd\u001b[?2004h> "]
[1065.167532, "o", "w_t = w.t().contiguous()\r\n\u001b[?2004l\r[]\u001b[?2004h"]
[1065.167556, "o", "> "]
[1065.167608, "o", "w_hi = w_t.half()\r\n\u001b[?2004l\rg\u001b[?2004h"]
[1065.167636, "o", "> "]
[1065.167736, "o", "w_lo = (w_t - w_hi.float()).half()\r\n\u001b[?2004l\r \u001b[?2004h"]
[1065.167766, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[1065.16791, "o", "# Variant A: x fp32, W presplit fp16 (K,N)\r\n\u001b[?2004l\r \u001b[?2004h"]
[1065.167936, "o", "> "]
[1065.167968, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1065.168, "o", "\u001b[?2004h> "]
[1065.168124, "o", "def kernA(A, WH, WL, BIAS, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1065.16814, "o", "\u001b[?2004h> "]
[1065.168426, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.168458, "o", "> "]
[1065.16852, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1065.168558, "o", "\u001b[?2004h> "]
[1065.168683, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1065.168722, "o", "\u001b[?2004h> "]
[1065.168798, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\rk"]
[1065.168831, "o", "\u001b[?2004h> "]
[1065.1689, "o", "    group_id = pid // width\r\n\u001b[?2004l\r("]
[1065.168932, "o", "\u001b[?2004h> "]
[1065.169144, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1065.169177, "o", "\u001b[?2004h> "]
[1065.169332, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1065.169363, "o", "\u001b[?2004h> "]
[1065.169475, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1065.169503, "o", "\u001b[?2004h> "]
[1065.169639, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1065.169669, "o", "\u001b[?2004h> "]
[1065.169797, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1065.169827, "o", "\u001b[?2004h> "]
[1065.169913, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1065.169945, "o", "\u001b[?2004h> "]
[1065.170111, "o", "    a_ptrs = A + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1065.170141, "o", "\u001b[?2004h> "]
[1065.170305, "o", "    wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1065.170337, "o", "\u001b[?2004h> "]
[1065.170504, "o", "    wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1065.170536, "o", "\u001b[?2004h> "]
[1065.170624, "o", "    m_mask = offs_m[:, None] < M\r\n\u001b[?2004l\r"]
[1065.170654, "o", "\u001b[?2004h> "]
[1065.170758, "o", "    n_mask = offs_n[None, :] < N\r\n\u001b[?2004l\r"]
[1065.170788, "o", "\u001b[?2004h> "]
[1065.170925, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1065.170954, "o", "\u001b[?2004h> "]
[1065.171039, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1065.171068, "o", "\u001b[?2004h> "]
[1065.171197, "o", "        k_mask = (k + offs_k)[None, :] < K\r\n\u001b[?2004l\r"]
[1065.171227, "o", "\u001b[?2004h> "]
[1065.171411, "o", "        a = tl.load(a_ptrs, mask=m_mask & k_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1065.171441, "o", "\u001b[?2004h> "]
[1065.171705, "o", "        bhi = tl.load(wh_ptrs, mask=(k + offs_k)[:, None] < K & n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1065.171739, "o", "\u001b[?2004h> "]
[1065.171998, "o", "        blo = tl.load(wl_ptrs, mask=(k + offs_k)[:, None] < K & n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1065.17203, "o", "\u001b[?2004h> "]
[1065.17212, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.172133, "o", "> "]
[1065.172318, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1065.172331, "o", "\u001b[?2004h> "]
[1065.17246, "o", "        acc = tl.dot(a_hi, bhi, acc)\r\n\u001b[?2004l\r"]
[1065.172495, "o", "\u001b[?2004h> "]
[1065.172597, "o", "        acc = tl.dot(a_hi, blo, acc)\r\n\u001b[?2004l\r"]
[1065.172628, "o", "\u001b[?2004h> "]
[1065.172739, "o", "        acc = tl.dot(a_lo, bhi, acc)\r\n\u001b[?2004l\r"]
[1065.17277, "o", "\u001b[?2004h> "]
[1065.172803, "o", "        a_ptrs += BK\r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.172838, "o", "> "]
[1065.17287, "o", "        wh_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.172925, "o", "        wl_ptrs += BK * N\r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.172956, "o", "> "]
[1065.173036, "o", "    bv = tl.load(BIAS + offs_n, mask=offs_n < N, other=0.0)\r\n\u001b[?2004l\r"]
[1065.173067, "o", "\u001b[?2004h> "]
[1065.173113, "o", "    c = acc * scale + bv[None, :]\r\n\u001b[?2004l\r"]
[1065.173145, "o", "\u001b[?2004h> "]
[1065.173286, "o", "    tl.store(C + offs_m[:, None] * N + offs_n[None, :], c, mask=m_mask & (offs_n[None, :] < N))\r\n\u001b[?2004l\r"]
[1065.173316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.173371, "o", "# Variant B: x presplit too\r\n\u001b[?2004l\r"]
[1065.173401, "o", "\u001b[?2004h> "]
[1065.173433, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.173512, "o", "def splitk(X, HI, LO, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1065.173542, "o", "\u001b[?2004h> "]
[1065.173574, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1065.173604, "o", "\u001b[?2004h> "]
[1065.173668, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1065.173698, "o", "\u001b[?2004h> "]
[1065.173734, "o", "    mask = offs < numel\r\n\u001b[?2004l\r"]
[1065.173766, "o", "\u001b[?2004h> "]
[1065.173814, "o", "    v = tl.load(X + offs, mask=mask)\r\n\u001b[?2004l\r"]
[1065.173843, "o", "\u001b[?2004h> "]
[1065.173876, "o", "    h = v.to(tl.float16)\r\n\u001b[?2004l\r"]
[1065.173908, "o", "\u001b[?2004h> "]
[1065.173968, "o", "    l = (v - h.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1065.173997, "o", "\u001b[?2004h> "]
[1065.174052, "o", "    tl.store(HI + offs, h, mask=mask)\r\n\u001b[?2004l\r"]
[1065.174082, "o", "\u001b[?2004h> "]
[1065.174133, "o", "    tl.store(LO + offs, l, mask=mask)\r\n\u001b[?2004l\r"]
[1065.174162, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.174194, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1065.174224, "o", "\u001b[?2004h> "]
[1065.174297, "o", "def kernB(AH, AL, WH, WL, BIAS, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1065.174327, "o", "\u001b[?2004h> "]
[1065.174458, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1065.174488, "o", "\u001b[?2004h> "]
[1065.174521, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1065.174555, "o", "\u001b[?2004h> "]
[1065.174628, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1065.174658, "o", "\u001b[?2004h> "]
[1065.174691, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1065.174729, "o", "\u001b[?2004h> "]
[1065.174761, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1065.174792, "o", "\u001b[?2004h> "]
[1065.174891, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1065.174921, "o", "\u001b[?2004h> "]
[1065.174995, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1065.175025, "o", "\u001b[?2004h> "]
[1065.175079, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1065.175109, "o", "\u001b[?2004h> "]
[1065.175169, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1065.1752, "o", "\u001b[?2004h> "]
[1065.175267, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1065.175299, "o", "\u001b[?2004h> "]
[1065.175332, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1065.175362, "o", "\u001b[?2004h> "]
[1065.175443, "o", "    ah_ptrs = AH + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1065.175478, "o", "\u001b[?2004h> "]
[1065.175557, "o", "    al_ptrs = AL + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1065.17559, "o", "\u001b[?2004h> "]
[1065.175668, "o", "    wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1065.175698, "o", "\u001b[?2004h> "]
[1065.175783, "o", "    wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1065.175813, "o", "\u001b[?2004h> "]
[1065.175857, "o", "    m_mask = offs_m[:, None] < M\r\n\u001b[?2004l\r"]
[1065.175887, "o", "\u001b[?2004h> "]
[1065.175931, "o", "    n_mask = offs_n[None, :] < N\r\n\u001b[?2004l\r"]
[1065.17596, "o", "\u001b[?2004h> "]
[1065.176012, "o", "    k_mask0 = (offs_k)[None, :] < K\r\n\u001b[?2004l\r"]
[1065.176042, "o", "\u001b[?2004h> "]
[1065.176092, "o", "    kk_mask0 = (offs_k)[:, None] < K\r\n\u001b[?2004l\r"]
[1065.176123, "o", "\u001b[?2004h> "]
[1065.176191, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1065.176219, "o", "\u001b[?2004h> "]
[1065.17626, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1065.17629, "o", "\u001b[?2004h> "]
[1065.176417, "o", "        ahi = tl.load(ah_ptrs, mask=m_mask & ((k + offs_k)[None, :] < K), other=0.0)\r\n\u001b[?2004l\r"]
[1065.176445, "o", "\u001b[?2004h> "]
[1065.176572, "o", "        alo = tl.load(al_ptrs, mask=m_mask & ((k + offs_k)[None, :] < K), other=0.0)\r\n\u001b[?2004l\r"]
[1065.176601, "o", "\u001b[?2004h> "]
[1065.176733, "o", "        bhi = tl.load(wh_ptrs, mask=((k + offs_k)[:, None] < K) & n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1065.176761, "o", "\u001b[?2004h> "]
[1065.176889, "o", "        blo = tl.load(wl_ptrs, mask=((k + offs_k)[:, None] < K) & n_mask, other=0.0)\r\n\u001b[?2004l\r"]
[1065.176919, "o", "\u001b[?2004h> "]
[1065.176967, "o", "        acc = tl.dot(ahi, bhi, acc)\r\n\u001b[?2004l\r"]
[1065.176997, "o", "\u001b[?2004h> "]
[1065.177046, "o", "        acc = tl.dot(ahi, blo, acc)\r\n\u001b[?2004l\r"]
[1065.177076, "o", "\u001b[?2004h> "]
[1065.177125, "o", "        acc = tl.dot(alo, bhi, acc)\r\n\u001b[?2004l\r"]
[1065.177154, "o", "\u001b[?2004h> "]
[1065.177265, "o", "        ah_ptrs += BK; al_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\r\n\u001b[?2004l\r"]
[1065.177295, "o", "\u001b[?2004h> "]
[1065.177382, "o", "    bv = tl.load(BIAS + offs_n, mask=offs_n < N, other=0.0)\r\n\u001b[?2004l\r"]
[1065.177411, "o", "\u001b[?2004h> "]
[1065.177456, "o", "    c = acc * scale + bv[None, :]\r\n\u001b[?2004l\r"]
[1065.177488, "o", "\u001b[?2004h> "]
[1065.177632, "o", "    tl.store(C + offs_m[:, None] * N + offs_n[None, :], c, mask=m_mask & (offs_n[None, :] < N))\r\n\u001b[?2004l\r"]
[1065.177662, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.177774, "o", "x_hi = torch.empty(M, K, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1065.177804, "o", "\u001b[?2004h> "]
[1065.177892, "o", "x_lo = torch.empty(M, K, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1065.17792, "o", "\u001b[?2004h> "]
[1065.177951, "o", "numel = M * K\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1065.177983, "o", "\u001b[?2004h> "]
[1065.178015, "o", "def bench(fn, iters=20):\r\n\u001b[?2004l\r"]
[1065.178046, "o", "\u001b[?2004h> "]
[1065.178077, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1065.178092, "o", "\u001b[?2004h> "]
[1065.178149, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1065.178185, "o", "\u001b[?2004h> "]
[1065.178287, "o", "    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1065.178317, "o", "\u001b[?2004h> "]
[1065.178349, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.178386, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[1065.178416, "o", "\u001b[?2004h> "]
[1065.178448, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[1065.178478, "o", "\u001b[?2004h> "]
[1065.178521, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1065.178551, "o", "\u001b[?2004h> "]
[1065.178686, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1065.178718, "o", "\u001b[?2004h> "]
[1065.178812, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1065.178842, "o", "\u001b[?2004h> "]
[1065.178893, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1065.178922, "o", "\u001b[?2004h> "]
[1065.178954, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.178998, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1065.179028, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.179063, "o", "SB = 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.179095, "o", "> "]
[1065.179223, "o", "split_fn = lambda: splitk[(triton.cdiv(numel, SB),)](x, x_hi, x_lo, numel, SB, num_warps=8)\r\n\u001b[?2004l\r"]
[1065.179257, "o", "\u001b[?2004h"]
[1065.17929, "o", "> t_split = bench(split_fn)\r\n\u001b[?2004l\r"]
[1065.179321, "o", "\u001b[?2004h> "]
[1065.179397, "o", "print(f'split kernel: {t_split:.3f} ms', flush=True)\r\n\u001b[?2004l\r"]
[1065.179429, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.179458, "o", "res = []\r\n\u001b[?2004l\r"]
[1065.179487, "o", "\u001b[?2004h> "]
[1065.179633, "o", "for BM, BN, BK, nw, ns in itertools.product([64,128,256],[64,128,256],[32,64],[4,8],[3,4,5,6]):\r\n\u001b[?2004l\r"]
[1065.17966, "o", "\u001b[?2004h> "]
[1065.179739, "o", "    if BM*BN > 128*256 or BM*BN < 64*128: continue\r\n\u001b[?2004l\r"]
[1065.179769, "o", "\u001b[?2004h> "]
[1065.179841, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1065.179871, "o", "\u001b[?2004h> "]
[1065.179902, "o", "    for name, fn in [\r\n\u001b[?2004l\r"]
[1065.179932, "o", "\u001b[?2004h> "]
[1065.180114, "o", "        ('A', lambda: kernA[grid](x, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, 8, num_warps=nw, num_stages=ns)),\r\n\u001b[?2004l\r"]
[1065.180143, "o", "\u001b[?2004h> "]
[1065.180364, "o", "        ('B', lambda: (split_fn(), kernB[grid](x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, 8, num_warps=nw, num_stages=ns))),\r\n\u001b[?2004l\r"]
[1065.180392, "o", "\u001b[?2004h> "]
