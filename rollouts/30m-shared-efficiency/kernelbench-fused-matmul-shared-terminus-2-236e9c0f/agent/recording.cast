[1546.944339, "o", "import torch, triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1546.944393, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[1546.944427, "o", "> "]
