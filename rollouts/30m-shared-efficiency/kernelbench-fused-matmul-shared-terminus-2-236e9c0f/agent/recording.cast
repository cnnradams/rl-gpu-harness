[1327.732343, "o", "\u001b[?2004h> "]
[1327.732398, "o", "    tl.store(HI + offs, h, mask=mask)\r\n\u001b[?2004l\r"]
[1327.732422, "o", "\u001b[?2004h> "]
[1327.732479, "o", "    tl.store(LO + offs, l, mask=mask)\r\n\u001b[?2004l\r"]
[1327.732502, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.732529, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1327.732552, "o", "\u001b[?2004h> "]
[1327.73264, "o", "def kernB2(AH, AL, WH, WL, BIAS, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1327.732664, "o", "\u001b[?2004h> "]
[1327.732811, "o", "           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1327.732836, "o", "\u001b[?2004h> "]
[1327.732873, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1327.732897, "o", "\u001b[?2004h> "]
[1327.732981, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1327.733008, "o", "\u001b[?2004h> "]
[1327.733048, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1327.733074, "o", "\u001b[?2004h> "]
[1327.733111, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1327.733135, "o", "\u001b[?2004h> "]
[1327.733239, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1327.733264, "o", "\u001b[?2004h> "]
[1327.733345, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1327.73337, "o", "\u001b[?2004h> "]
[1327.733432, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1327.733459, "o", "\u001b[?2004h> "]
[1327.733521, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1327.733545, "o", "\u001b[?2004h> "]
[1327.733609, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1327.733633, "o", "\u001b[?2004h> "]
[1327.733677, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1327.733703, "o", "\u001b[?2004h> "]
[1327.733791, "o", "    ah_ptrs = AH + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1327.733817, "o", "\u001b[?2004h> "]
[1327.733902, "o", "    al_ptrs = AL + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1327.733938, "o", "\u001b[?2004h> "]
[1327.734017, "o", "    wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1327.734051, "o", "\u001b[?2004h> "]
[1327.73414, "o", "    wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1327.734165, "o", "\u001b[?2004h> "]
[1327.734236, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1327.734261, "o", "\u001b[?2004h> "]
[1327.734315, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[1327.73434, "o", "\u001b[?2004h> "]
[1327.734387, "o", "        ahi = tl.load(ah_ptrs)\r\n\u001b[?2004l\r"]
[1327.734411, "o", "\u001b[?2004h> "]
[1327.734454, "o", "        alo = tl.load(al_ptrs)\r\n\u001b[?2004l\r"]
[1327.73448, "o", "\u001b[?2004h> "]
[1327.734521, "o", "        bhi = tl.load(wh_ptrs)\r\n\u001b[?2004l\r"]
[1327.734546, "o", "\u001b[?2004h> "]
[1327.734588, "o", "        blo = tl.load(wl_ptrs)\r\n\u001b[?2004l\r"]
[1327.734621, "o", "\u001b[?2004h> "]
[1327.734663, "o", "        acc = tl.dot(ahi, bhi, acc)\r\n\u001b[?2004l\r"]
[1327.734689, "o", "\u001b[?2004h> "]
[1327.734743, "o", "        acc = tl.dot(ahi, blo, acc)\r\n\u001b[?2004l\r"]
[1327.734776, "o", "\u001b[?2004h> "]
[1327.734823, "o", "        acc = tl.dot(alo, bhi, acc)\r\n\u001b[?2004l\r"]
[1327.734847, "o", "\u001b[?2004h> "]
[1327.734961, "o", "        ah_ptrs += BK; al_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\r\n\u001b[?2004l\r"]
[1327.734986, "o", "\u001b[?2004h> "]
[1327.735034, "o", "    bv = tl.load(BIAS + offs_n)\r\n\u001b[?2004l\r"]
[1327.735061, "o", "\u001b[?2004h> "]
[1327.735106, "o", "    c = acc * scale + bv[None, :]\r\n\u001b[?2004l\r"]
[1327.735131, "o", "\u001b[?2004h> "]
[1327.735218, "o", "    tl.store(C + offs_m[:, None] * N + offs_n[None, :], c)\r\n\u001b[?2004l\r"]
[1327.73526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1327.735361, "o", "x_hi = torch.empty(M, K, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1327.735386, "o", "\u001b[?2004h> "]
[1327.735476, "o", "x_lo = torch.empty(M, K, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1327.735502, "o", "\u001b[?2004h> "]
[1327.735527, "o", "numel = M * K\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.735559, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1327.735596, "o", "def bench(fn, iters=20):\r\n\u001b[?2004l\r"]
[1327.735621, "o", "\u001b[?2004h> "]
[1327.735662, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1327.735687, "o", "\u001b[?2004h> "]
[1327.735726, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1327.735753, "o", "\u001b[?2004h> "]
[1327.735865, "o", "    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1327.73589, "o", "\u001b[?2004h> "]
[1327.735913, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.735939, "o", "> "]
[1327.735963, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[1327.735988, "o", "\u001b[?2004h> "]
[1327.736025, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[1327.73605, "o", "\u001b[?2004h> "]
[1327.736099, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1327.736122, "o", "\u001b[?2004h> "]
[1327.736263, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1327.736291, "o", "\u001b[?2004h> "]
[1327.736381, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1327.736406, "o", "\u001b[?2004h> "]
[1327.736459, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1327.736483, "o", "\u001b[?2004h> "]
[1327.736508, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1327.736558, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1327.736585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.73661, "o", "> SB = 4096\r\n\u001b[?2004l\r"]
[1327.736635, "o", "\u001b[?2004h> "]
[1327.736784, "o", "split_fn = lambda: splitk[(triton.cdiv(numel, SB),)](x, x_hi, x_lo, numel, SB, num_warps=8)\r\n\u001b[?2004l\r"]
[1327.73681, "o", "\u001b[?2004h> "]
[1327.736835, "o", "split_fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1327.736878, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1327.7369, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.736923, "o", "> "]
[1327.736967, "o", "# verify B2 correctness once\r\n\u001b[?2004l\r"]
[1327.736993, "o", "\u001b[?2004h> "]
[1327.737215, "o", "kernB2[(triton.cdiv(M,128)*triton.cdiv(N,128),)](x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K, 1.5, 128, 128, 32, 8, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.737248, "o", "> "]
[1327.737274, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.7373, "o", "> "]
[1327.737382, "o", "print('B2 err:', (out-ref).abs().max().item(), flush=True)\r\n\u001b[?2004l\r"]
[1327.737406, "o", "\u001b[?2004h> "]
[1327.73761, "o", "kernA2[(triton.cdiv(M,128)*triton.cdiv(N,128),)](x, w_hi, w_lo, bias, out, M, N, K, 1.5, 128, 128, 32, 8, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r"]
[1327.737644, "o", "\u001b[?2004h> "]
[1327.737675, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1327.737698, "o", "\u001b[?2004h> "]
[1327.737794, "o", "print('A2 err:', (out-ref).abs().max().item(), flush=True)\r\n\u001b[?2004l\r"]
[1327.737824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1327.737856, "o", "res = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.737885, "o", "> "]
[1327.73803, "o", "for BM, BN, BK, nw, ns in itertools.product([64,128,256],[64,128,256],[32,64],[4,8],[2,3,4,5]):\r\n\u001b[?2004l\r"]
[1327.738057, "o", "\u001b[?2004h> "]
[1327.738128, "o", "    if BM*BN > 128*256 or BM*BN < 64*128: continue\r\n\u001b[?2004l\r"]
[1327.738153, "o", "\u001b[?2004h> "]
[1327.738243, "o", "    if BK == 64 and BM*BN >= 128*256 and ns > 3: continue\r\n\u001b[?2004l\r"]
[1327.738269, "o", "\u001b[?2004h> "]
[1327.73834, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[1327.738365, "o", "\u001b[?2004h> "]
[1327.738398, "o", "    for name, fn in [\r\n\u001b[?2004l\r"]
[1327.738426, "o", "\u001b[?2004h> "]
[1327.738612, "o", "        ('A2', lambda: kernA2[grid](x, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, 8, num_warps=nw, num_stages=ns)),\r\n\u001b[?2004l\r"]
[1327.738646, "o", "\u001b[?2004h> "]
[1327.738863, "o", "        ('B2', lambda: (split_fn(), kernB2[grid](x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, 8, num_warps=nw, num_stages=ns))),\r\n\u001b[?2004l\r"]
[1327.738893, "o", "\u001b[?2004h>     ]:\r\n\u001b[?2004l\r"]
[1327.738918, "o", "\u001b[?2004h> "]
[1327.738948, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.738974, "o", "> "]
[1327.739007, "o", "            t = bench(fn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1327.739022, "o", "> "]
[1327.739107, "o", "            res.append((t, name, BM, BN, BK, nw, ns))\r\n\u001b[?2004l\r"]
[1327.739133, "o", "\u001b[?2004h> "]
[1327.739282, "o", "            print(f'{name} BM={BM} BN={BN} BK={BK} w={nw} s={ns}: {t:.3f} ms', flush=True)\r\n\u001b[?2004l\r"]
[1327.739309, "o", "\u001b[?2004h> "]
[1327.739351, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[1327.739377, "o", "\u001b[?2004h> "]
[1327.739403, "o", "            pass\r\n\u001b[?2004l\r"]
[1327.739428, "o", "\u001b[?2004h> "]
[1327.739459, "o", "res.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1327.739533, "o", "for r in res[:8]: print('BEST', r, flush=True)\r\n\u001b[?2004l\r"]
[1327.739558, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
