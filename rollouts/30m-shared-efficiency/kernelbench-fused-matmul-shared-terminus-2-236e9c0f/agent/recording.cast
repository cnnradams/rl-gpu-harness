[749.534014, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, triton, itertools\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.empty(N, K, device='cuda').uniform_(-(K**-0.5), K**-0.5)\nbias = torch.zeros(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\nref = torch.nn.functional.linear(x, w, bias)\n\n@triton.jit\ndef kern(A, W, BIAS, C, M, N, K, scale,\n         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    a_ptrs = A + offs_m[:, None] * K + offs_k[None, :]\n    w_ptrs = W + offs_n[:, None] * K + offs_k["]
[749.534062, "i", "None, :]\n    m_mask = offs_m[:, None] < M\n    n_mask = offs_n[:, None] < N\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        k_mask = (k + offs_k)[None, :] < K\n        a = tl.load(a_ptrs, mask=m_mask & k_mask, other=0.0)\n        wt = tl.load(w_ptrs, mask=n_mask & k_mask, other=0.0)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        bb = tl.trans(wt)\n        b_hi = bb.to(tl.float16)\n        b_lo = (bb - b_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, b_hi, acc)\n        acc = tl.dot(a_hi, b_lo, acc)\n        acc = tl.dot(a_lo, b_hi, acc)\n        a_ptrs += BK\n        w_ptrs += BK\n    bv = tl.load(BIAS + offs_n, mask=offs_n < N, other=0.0)\n    c = acc * scale + bv[None, :]\n    c_ptrs = C + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, c, mask=m_mask & (offs_n[None, :] < N))\n\ndef bench(fn, iters=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty((32,1024,1024), dtype=torch.i"]
[749.534101, "i", "nt64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nresults = []\nfor BM, BN, BK, gm, nw, ns in itertools.product([64,128,256],[64,128,256],[32,64,128],[8],[4,8],[3,4,5]):\n    if BM*BN >= 256*256 and nw < 8: continue\n    if BM*BN <= 64*64 and nw > 4: continue\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: kern[grid](x, w, bias, out, M, N, K, 1.5, BM, BN, BK, gm, num_warps=nw, num_stages=ns)\n        t = bench(fn)\n        err = (out - ref).abs().max().item()\n        tf = 6*M*N*K/t/1e9\n        results.append((t, BM, BN, BK, gm, nw, ns, tf, err))\n        print(f'BM={BM} BN={BN} BK={BK} warps={nw} stages={ns}: {t:.3f} ms ({tf:.0f} fp16 TFLOPS) err={err:.2e}', flush=True)\n    except Exception"]
[749.534229, "i", " as ex:\n        print(BM,BN,BK,nw,ns,'fail', str(ex)[:60], flush=True)\nresults.sort()\nprint('BEST:', results[:5])\nEOF\ngpu push sb-ofRh32R16LNz5qnbFtSmpW /workspace/tune.py /workspace/tune.py\n"]
