[1524.265435, "o", "request ID: 82da38ab232f44a7a3a335ced018019e\r\n"]
[1525.888792, "o", "command: 0fe710ede4da41f2a992675d085bb162\r\n"]
[1526.088745, "o", "BEST (2.5036160945892334, 'B2', 128, 256, 32, 8, 3)\r\nBEST (2.6125121116638184, 'B2', 128, 256, 32, 8, 4)\r\nBEST (2.615648031234741, 'B2', 128, 128, 32, 4, 3)\r\nB2 BM=128 BN=256 BK=32 w=8 s=3: 2.504 ms\r\nB2 BM=128 BN=256 BK=32 w=8 s=4: 2.613 ms\r\nB2 BM=128 BN=128 BK=32 w=4 s=3: 2.616 ms\r\nB2 BM=128 BN=128 BK=64 w=8 s=3: 2.715 ms\r\nB2 BM=256 BN=128 BK=32 w=8 s=4: 2.740 ms\r\nB2 BM=256 BN=128 BK=32 w=8 s=3: 2.745 ms\r\nB2 BM=128 BN=128 BK=32 w=8 s=4: 2.781 ms\r\nB2 BM=128 BN=128 BK=32 w=8 s=5: 2.807 ms\r\nB2 BM=128 BN=128 BK=32 w=8 s=2: 2.899 ms\r\n"]
