[1616.894784, "i", "cat > /workspace/tune4.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.empty(N, K, device='cuda').uniform_(-(K**-0.5), K**-0.5)\nbias = torch.zeros(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\nref = torch.nn.functional.linear(x, w, bias) * 1.5\nw_t = w.t().contiguous()\nw_hi = w_t.half()\nw_lo = (w_t - w_hi.float()).half()\n\n@triton.jit\ndef splitk(X, HI, LO, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(X + offs, mask=mask)\n    h = v.to(tl.float16)\n    l = (v - h.to(tl.float32)).to(tl.float16)\n    tl.store(HI + offs, h, mask=mask)\n    tl.store(LO + offs, l, mask=mask)\n\n@triton.jit\ndef kernB2(AH, AL, WH, WL, BIAS, C, M, N, K, scale,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n   "]
[1616.89483, "i", " width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    ah_ptrs = AH + offs_m[:, None] * K + offs_k[None, :]\n    al_ptrs = AL + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        ahi = tl.load(ah_ptrs)\n        alo = tl.load(al_ptrs)\n        bhi = tl.load(wh_ptrs)\n        blo = tl.load(wl_ptrs)\n        acc = tl.dot(ahi, bhi, acc)\n        acc = tl.dot(ahi, blo, acc)\n        acc = tl.dot(alo, bhi, acc)\n        ah_ptrs += BK; al_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\n    bv = tl.load(BIAS + offs_n)\n    c = acc * scale + bv[None, :]\n    tl.st"]
[1616.894837, "i", "ore(C + offs_m[:, None] * N + offs_n[None, :], c)\n\nx_hi = torch.empty(M, K, device='cuda', dtype=torch.float16)\nx_lo = torch.empty(M, K, device='cuda', dtype=torch.float16)\nnumel = M * K\n\ndef bench(fn, iters=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nSB = 4096\nsplit_fn = lambda: splitk[(triton.cdiv(numel, SB),)](x, x_hi, x_lo, numel, SB, num_warps=8)\nsplit_fn(); torch.cuda.synchronize()\n\nfor BM, BN, BK, gm, nw, ns in [\n    (128,256,32,8,8,3),\n    (128,256,32,4,8,3),\n    (128,256,32,16,8,3),\n    (128,256,32,8,16,3),\n    (128,256,64,8,8,3),\n    (128,512,32,8,8,3),\n    (64,512,32,8,8,3),\n    (256,25"]
[1616.894845, "i", "6,32,8,8,3),\n    (128,256,32,32,8,3),\n]:\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: (split_fn(), kernB2[grid](x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, gm, num_warps=nw, num_stages=ns))\n        t = bench(fn)\n        err = (out - ref).abs().max().item()\n        print(f'B2 BM={BM} BN={BN} BK={BK} gm={gm} w={nw} s={ns}: {t:.3f} ms err={err:.2e}', flush=True)\n    except Exception as ex:\n        print(BM,BN,BK,gm,nw,ns,'FAIL',str(ex)[:80], flush=True)\nt = bench(split_fn)\nprint('split alone:', t, flush=True)\nEOF\ngpu push sb-ofRh32R16LNz5qnbFtSmpW /workspace/tune4.py /workspace/tune4.py && gpu exec sb-ofRh32R16LNz5qnbFtSmpW -- bash -c 'cd /tmp && python3 /workspace/tune4.py 2>&1 | tail -12'\n"]
