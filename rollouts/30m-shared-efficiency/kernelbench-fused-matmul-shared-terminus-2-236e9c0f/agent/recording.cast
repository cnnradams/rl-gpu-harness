[384.518234, "o", "        group_id = pid // width\r\n\u001b[?2004l\r"]
[384.518255, "o", "\u001b[?2004h> "]
[384.518371, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[384.518385, "o", "\u001b[?2004h> "]
[384.518482, "o", "        pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[384.518497, "o", "\u001b[?2004h> "]
[384.518574, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[384.518589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[384.518612, "o", "\u001b[?2004h> "]
[384.518701, "o", "        offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.518721, "o", "> "]
[384.518792, "o", "        offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[384.518807, "o", "\u001b[?2004h> "]
[384.518867, "o", "        offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[384.518883, "o", "\u001b[?2004h> "]
[384.518984, "o", "        a_ptrs = A + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[384.518996, "o", "\u001b[?2004h> "]
[384.5191, "o", "        w_ptrs = W + offs_n[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[384.519118, "o", "\u001b[?2004h> "]
[384.51918, "o", "        m_mask = offs_m[:, None] < M\r\n\u001b[?2004l\r"]
[384.519196, "o", "\u001b[?2004h> "]
[384.519269, "o", "        n_mask = offs_n[:, None] < N\r\n\u001b[?2004l\r"]
[384.51928, "o", "\u001b[?2004h> "]
[384.519375, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[384.519391, "o", "\u001b[?2004h> "]
[384.519451, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[384.519469, "o", "\u001b[?2004h> "]
[384.519548, "o", "            k_mask = (k + offs_k)[None, :] < K\r\n\u001b[?2004l\r"]
[384.519563, "o", "\u001b[?2004h> "]
[384.519674, "o", "            a = tl.load(a_ptrs, mask=m_mask & k_mask, other=0.0)\r\n\u001b[?2004l\r"]
[384.519689, "o", "\u001b[?2004h> "]
[384.519799, "o", "            w = tl.load(w_ptrs, mask=n_mask & k_mask, other=0.0)\r\n\u001b[?2004l\r"]
[384.519815, "o", "\u001b[?2004h> "]
[384.519878, "o", "            a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[384.519893, "o", "\u001b[?2004h> "]
[384.519995, "o", "            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[384.52001, "o", "\u001b[?2004h> "]
[384.520062, "o", "            b = tl.trans(w)\r\n\u001b[?2004l\r"]
[384.520078, "o", "\u001b[?2004h> "]
[384.520141, "o", "            b_hi = b.to(tl.float16)\r\n\u001b[?2004l\r"]
[384.520157, "o", "\u001b[?2004h> "]
[384.520258, "o", "            b_lo = (b - b_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[384.520273, "o", "\u001b[?2004h> "]
[384.520352, "o", "            acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[384.520372, "o", "\u001b[?2004h> "]
[384.52044, "o", "            acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[384.520455, "o", "\u001b[?2004h> "]
[384.520528, "o", "            acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[384.520543, "o", "\u001b[?2004h> "]
[384.52059, "o", "            a_ptrs += BK\r\n\u001b[?2004l\r"]
[384.520605, "o", "\u001b[?2004h> "]
[384.520652, "o", "            w_ptrs += BK\r\n\u001b[?2004l\r"]
[384.520668, "o", "\u001b[?2004h> "]
[384.520779, "o", "        bias = tl.load(BIAS + offs_n, mask=offs_n < N, other=0.0)\r\n\u001b[?2004l\r"]
[384.520798, "o", "\u001b[?2004h> "]
[384.520871, "o", "        c = acc * scale + bias[None, :]\r\n\u001b[?2004l\r"]
[384.520886, "o", "\u001b[?2004h> "]
[384.520986, "o", "        c_ptrs = C + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[384.521003, "o", "\u001b[?2004h> "]
[384.521111, "o", "        tl.store(c_ptrs, c, mask=m_mask & (offs_n[None, :] < N))\r\n\u001b[?2004l\r"]
[384.521122, "o", "\u001b[?2004h"]
[384.521134, "o", "> \r\n\u001b[?2004l\r"]
[384.52115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[384.521175, "o", "\u001b[?2004h> "]
[384.521225, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[384.521245, "o", "\u001b[?2004h> "]
[384.521359, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[384.521374, "o", "\u001b[?2004h> "]
[384.521446, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[384.521461, "o", "\u001b[?2004h> "]
[384.521561, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[384.521576, "o", "\u001b[?2004h> "]
[384.521655, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[384.521674, "o", "\u001b[?2004h> "]
[384.521721, "o", "        self._bias_s = None\r\n\u001b[?2004l\r"]
[384.521736, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[384.521758, "o", "\u001b[?2004h> "]
[384.521809, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.521824, "o", "> "]
[384.52188, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.521895, "o", "> "]
[384.521944, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[384.521959, "o", "\u001b[?2004h> "]
[384.522029, "o", "        s = float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[384.522044, "o", "\u001b[?2004h> "]
[384.522193, "o", "        if not (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32 and x.dim() == 2):\r\n\u001b[?2004l\r"]
[384.522209, "o", "\u001b[?2004h> "]
[384.522305, "o", "            y = torch.nn.functional.linear(x, w, b)\r\n\u001b[?2004l\r"]
[384.522325, "o", "\u001b[?2004h> "]
[384.522374, "o", "            return y * s + y\r\n\u001b[?2004l\r"]
[384.522389, "o", "\u001b[?2004h> "]
[384.522505, "o", "        if self._bias_s is None or self._bias_s.device != x.device:\r\n\u001b[?2004l\r"]
[384.522519, "o", "\u001b[?2004h> "]
[384.522616, "o", "            self._bias_s = (b * s).detach().contiguous()\r\n\u001b[?2004l\r"]
[384.522634, "o", "\u001b[?2004h> "]
[384.522674, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[384.522689, "o", "\u001b[?2004h> "]
[384.522733, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r"]
[384.522748, "o", "\u001b[?2004h> "]
[384.522798, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[384.522819, "o", "\u001b[?2004h> "]
[384.522935, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[384.522949, "o", "\u001b[?2004h> "]
[384.523098, "o", "        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r"]
[384.523115, "o", "\u001b[?2004h> "]
[384.523242, "o", "        _gemm_fp16x3[grid](x, w, self._bias_s, out, M, N, K, s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.523297, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.523317, "o", "> EOF\r\n\u001b[?2004l\r"]
[384.524956, "o", "\u001b[?2004hroot@modal:/# "]
[384.524996, "o", "echo written\r\n\u001b[?2004l\rwritten\r\n"]
[384.525015, "o", "\u001b[?2004hroot@modal:/# "]
