[675.645891, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, time\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.empty(N, K, device='cuda').uniform_(-(K**-0.5), K**-0.5)\nb = torch.empty(N, device='cuda').uniform_(-(K**-0.5), K**-0.5)\nref = (torch.nn.functional.linear(x, w, b)) * 1.5\n\ndef bench(fn, iters=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\n# cuBLAS fp32\nt1 = bench(lambda: torch.nn.functional.linear(x, w, b))\nprint('cublas fp32 median/min ms:', t1, 'TFLOPs:', 2*M*N*K/t1[0]/1e9)\n\n# torch.compile\nm = torch.nn.Line"]
[675.645936, "i", "ar(K, N).cuda()\nwith torch.no_grad():\n    m.weight.copy_(w); m.bias.copy_(b)\ncm = torch.compile(m)\nwith torch.no_grad():\n    y = cm(x)\nprint('compile diff:', (y*1.5 - ref).abs().max().item())\nt2 = bench(lambda: cm(x))\nprint('torch.compile fp32 median/min ms:', t2, 'TFLOPs:', 2*M*N*K/t2[0]/1e9)\nEOF\ngpu push sb-ofRh32R16LNz5qnbFtSmpW /workspace/bench.py /workspace/bench.py\n"]
