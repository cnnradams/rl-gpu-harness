[1254.431006, "o", "B BM=256 BN=128 BK=32 w=8 s=4: 2.845 ms err=4.85e-05\r\nA BM=256 BN=128 BK=32 w=8 s=5: 2.518 ms err=2.71e+00\r\nA BM=256 BN=128 BK=64 w=4 s=3: 21.693 ms err=2.71e+00\r\nA BM=256 BN=128 BK=64 w=8 s=3: 2.765 ms err=2.71e+00\r\nBEST (2.37225604057312, 'A', 128, 128, 32, 8, 3, 2.714900016784668)\r\nBEST (2.480448007583618, 'A', 64, 256, 32, 4, 3, 2.714900016784668)\r\nBEST (2.4819839000701904, 'B', 128, 128, 32, 8, 3, 4.851818084716797e-05)\r\nBEST (2.5184640884399414, 'A', 256, 128, 32, 8, 5, 2.714900016784668)\r\nBEST (2.5456318855285645, 'B', 128, 256, 32, 8, 3, 4.851818084716797e-05)\r\nBEST (2.592736005783081, 'B', 128, 256, 32, 8, 4, 4.851818084716797e-05)\r\nBEST (2.600640058517456, 'A', 128, 256, 32, 8, 4, 2.714900016784668)\r\nBEST (2.6322879791259766, 'B', 128, 128, 32, 4, 3, 4.851818084716797e-05)\r\n"]
