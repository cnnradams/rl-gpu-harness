[1327.725976, "i", "cat > /workspace/tune3.py << 'EOF'\nimport torch, triton, itertools\nimport triton.language as tl\n\ntorch.manual_seed(0)\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.empty(N, K, device='cuda').uniform_(-(K**-0.5), K**-0.5)\nbias = torch.zeros(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\nref = torch.nn.functional.linear(x, w, bias) * 1.5\n\nw_t = w.t().contiguous()\nw_hi = w_t.half()\nw_lo = (w_t - w_hi.float()).half()\n\n@triton.jit\ndef kernA2(A, WH, WL, BIAS, C, M, N, K, scale,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    a_ptr"]
[1327.726021, "i", "s = A + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs)\n        bhi = tl.load(wh_ptrs)\n        blo = tl.load(wl_ptrs)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, bhi, acc)\n        acc = tl.dot(a_hi, blo, acc)\n        acc = tl.dot(a_lo, bhi, acc)\n        a_ptrs += BK\n        wh_ptrs += BK * N\n        wl_ptrs += BK * N\n    bv = tl.load(BIAS + offs_n)\n    c = acc * scale + bv[None, :]\n    tl.store(C + offs_m[:, None] * N + offs_n[None, :], c)\n\n@triton.jit\ndef splitk(X, HI, LO, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    v = tl.load(X + offs, mask=mask)\n    h = v.to(tl.float16)\n    l = (v - h.to(tl.float32)).to(tl.float16)\n    tl.store(HI + offs,"]
[1327.726032, "i", " h, mask=mask)\n    tl.store(LO + offs, l, mask=mask)\n\n@triton.jit\ndef kernB2(AH, AL, WH, WL, BIAS, C, M, N, K, scale,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    ah_ptrs = AH + offs_m[:, None] * K + offs_k[None, :]\n    al_ptrs = AL + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        ahi = tl.load(ah_ptrs)\n        alo = tl.load(al_ptrs)\n        bhi = tl.load(wh_ptrs)"]
[1327.726038, "i", "\n        blo = tl.load(wl_ptrs)\n        acc = tl.dot(ahi, bhi, acc)\n        acc = tl.dot(ahi, blo, acc)\n        acc = tl.dot(alo, bhi, acc)\n        ah_ptrs += BK; al_ptrs += BK; wh_ptrs += BK * N; wl_ptrs += BK * N\n    bv = tl.load(BIAS + offs_n)\n    c = acc * scale + bv[None, :]\n    tl.store(C + offs_m[:, None] * N + offs_n[None, :], c)\n\nx_hi = torch.empty(M, K, device='cuda', dtype=torch.float16)\nx_lo = torch.empty(M, K, device='cuda', dtype=torch.float16)\nnumel = M * K\n\ndef bench(fn, iters=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nSB = 4096\nsplit_fn = lambda: splitk[(triton.cdiv(numel, SB),)]"]
[1327.726044, "i", "(x, x_hi, x_lo, numel, SB, num_warps=8)\nsplit_fn()\ntorch.cuda.synchronize()\n\n# verify B2 correctness once\nkernB2[(triton.cdiv(M,128)*triton.cdiv(N,128),)](x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K, 1.5, 128, 128, 32, 8, num_warps=8, num_stages=3)\ntorch.cuda.synchronize()\nprint('B2 err:', (out-ref).abs().max().item(), flush=True)\nkernA2[(triton.cdiv(M,128)*triton.cdiv(N,128),)](x, w_hi, w_lo, bias, out, M, N, K, 1.5, 128, 128, 32, 8, num_warps=8, num_stages=3)\ntorch.cuda.synchronize()\nprint('A2 err:', (out-ref).abs().max().item(), flush=True)\n\nres = []\nfor BM, BN, BK, nw, ns in itertools.product([64,128,256],[64,128,256],[32,64],[4,8],[2,3,4,5]):\n    if BM*BN > 128*256 or BM*BN < 64*128: continue\n    if BK == 64 and BM*BN >= 128*256 and ns > 3: continue\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    for name, fn in [\n        ('A2', lambda: kernA2[grid](x, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, 8, num_warps=nw, num_stages=ns)),\n        ('B2', lambda: (split_fn(), kernB2[grid](x_hi, x_lo, w_hi,"]
[1327.726052, "i", " w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, 8, num_warps=nw, num_stages=ns))),\n    ]:\n        try:\n            t = bench(fn)\n            res.append((t, name, BM, BN, BK, nw, ns))\n            print(f'{name} BM={BM} BN={BN} BK={BK} w={nw} s={ns}: {t:.3f} ms', flush=True)\n        except Exception as ex:\n            pass\nres.sort()\nfor r in res[:8]: print('BEST', r, flush=True)\nEOF\ngpu push sb-ofRh32R16LNz5qnbFtSmpW /workspace/tune3.py /workspace/tune3.py\n"]
