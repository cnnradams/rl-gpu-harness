[1689.806652, "o", "        offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1689.806687, "o", "\u001b[?2004h> "]
[1689.806728, "o", "        offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1689.80676, "o", "\u001b[?2004h> "]
[1689.806847, "o", "        ah_ptrs = AH + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1689.806879, "o", "\u001b[?2004h> "]
[1689.806966, "o", "        al_ptrs = AL + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1689.807001, "o", "\u001b[?2004h> "]
[1689.807088, "o", "        wh_ptrs = WH + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1689.80712, "o", "\u001b[?2004h> "]
[1689.807206, "o", "        wl_ptrs = WL + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1689.807284, "o", "\u001b[?2004h> "]
[1689.807337, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.807366, "o", "> "]
[1689.807429, "o", "        for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.807456, "o", "> "]
[1689.807504, "o", "            ahi = tl.load(ah_ptrs)\r\n\u001b[?2004l\r"]
[1689.807528, "o", "\u001b[?2004h> "]
[1689.807583, "o", "            alo = tl.load(al_ptrs)\r\n\u001b[?2004l\r"]
[1689.807607, "o", "\u001b[?2004h> "]
[1689.80766, "o", "            bhi = tl.load(wh_ptrs)\r\n\u001b[?2004l\r"]
[1689.807685, "o", "\u001b[?2004h> "]
[1689.807734, "o", "            blo = tl.load(wl_ptrs)\r\n\u001b[?2004l\r"]
[1689.807769, "o", "\u001b[?2004h> "]
[1689.807817, "o", "            acc = tl.dot(ahi, bhi, acc)\r\n\u001b[?2004l\r"]
[1689.807842, "o", "\u001b[?2004h> "]
[1689.807907, "o", "            acc = tl.dot(ahi, blo, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.807934, "o", "> "]
[1689.807991, "o", "            acc = tl.dot(alo, bhi, acc)\r\n\u001b[?2004l\r"]
[1689.808022, "o", "\u001b[?2004h> "]
[1689.808062, "o", "            ah_ptrs += BK\r\n\u001b[?2004l\r"]
[1689.808086, "o", "\u001b[?2004h> "]
[1689.808127, "o", "            al_ptrs += BK\r\n\u001b[?2004l\r"]
[1689.808152, "o", "\u001b[?2004h> "]
[1689.808197, "o", "            wh_ptrs += BK * N\r\n\u001b[?2004l\r"]
[1689.808223, "o", "\u001b[?2004h> "]
[1689.808268, "o", "            wl_ptrs += BK * N\r\n\u001b[?2004l\r"]
[1689.808292, "o", "\u001b[?2004h> "]
[1689.808348, "o", "        bv = tl.load(BIAS + offs_n)\r\n\u001b[?2004l\r"]
[1689.808382, "o", "\u001b[?2004h> "]
[1689.808432, "o", "        c = acc * scale + bv[None, :]\r\n\u001b[?2004l\r"]
[1689.808457, "o", "\u001b[?2004h> "]
[1689.80856, "o", "        tl.store(C + offs_m[:, None] * N + offs_n[None, :], c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.808588, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1689.808615, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1689.808678, "o", "_BM, _BN, _BK, _GM = 128, 256, 32, 16\r\n\u001b[?2004l\r"]
[1689.808703, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1689.80873, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1689.808781, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1689.808805, "o", "\u001b[?2004h> "]
[1689.808912, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1689.808936, "o", "\u001b[?2004h> "]
[1689.809006, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[1689.80903, "o", "\u001b[?2004h> "]
[1689.809124, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1689.809154, "o", "\u001b[?2004h> "]
[1689.80922, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1689.809244, "o", "\u001b[?2004h> "]
[1689.809285, "o", "        self._w_hi = None\r\n\u001b[?2004l\r"]
[1689.809309, "o", "\u001b[?2004h> "]
[1689.80935, "o", "        self._w_lo = None\r\n\u001b[?2004l\r"]
[1689.809373, "o", "\u001b[?2004h> "]
[1689.809417, "o", "        self._bias_s = None\r\n\u001b[?2004l\r"]
[1689.809443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1689.8095, "o", "    def _prepare(self, x):\r\n\u001b[?2004l\r"]
[1689.809525, "o", "\u001b[?2004h> "]
[1689.809573, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[1689.809596, "o", "\u001b[?2004h> "]
[1689.809642, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[1689.809674, "o", "\u001b[?2004h> "]
[1689.809727, "o", "        s = float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[1689.809751, "o", "\u001b[?2004h> "]
[1689.809856, "o", "        if (self._w_hi is None or self._w_hi.device != x.device):\r\n\u001b[?2004l\r"]
[1689.80988, "o", "\u001b[?2004h> "]
[1689.809934, "o", "            with torch.no_grad():\r\n\u001b[?2004l\r"]
[1689.809958, "o", "\u001b[?2004h> "]
[1689.810041, "o", "                w_t = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[1689.810074, "o", "\u001b[?2004h> "]
[1689.810126, "o", "                w_hi = w_t.half()\r\n\u001b[?2004l\r"]
[1689.810153, "o", "\u001b[?2004h> "]
[1689.810233, "o", "                w_lo = (w_t - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[1689.810265, "o", "\u001b[?2004h> "]
[1689.810305, "o", "                self._w_hi = w_hi\r\n\u001b[?2004l\r"]
[1689.810336, "o", "\u001b[?2004h> "]
[1689.810377, "o", "                self._w_lo = w_lo\r\n\u001b[?2004l\r"]
[1689.810409, "o", "\u001b[?2004h> "]
[1689.810504, "o", "                self._bias_s = (b.detach() * (1.0 + s)).contiguous()\r\n\u001b[?2004l\r"]
[1689.810537, "o", "\u001b[?2004h> "]
[1689.810605, "o", "        return self._w_hi, self._w_lo, self._bias_s\r\n\u001b[?2004l\r"]
[1689.810632, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.810666, "o", "> "]
[1689.810694, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.810725, "o", "> "]
[1689.810774, "o", "        s = float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[1689.810803, "o", "\u001b[?2004h> "]
[1689.810947, "o", "        if not (_HAS_TRITON and x.is_cuda and x.dtype == torch.float32 and x.dim() == 2):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.810981, "o", "> "]
[1689.811104, "o", "            y = torch.nn.functional.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r"]
[1689.811132, "o", "\u001b[?2004h> "]
[1689.811164, "o", "            return y * s + y\r\n\u001b[?2004l\r"]
[1689.811192, "o", "\u001b[?2004h> "]
[1689.811224, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[1689.811267, "o", "\u001b[?2004h> "]
[1689.811322, "o", "        N = self.matmul.weight.shape[0]\r\n\u001b[?2004l\r"]
[1689.811349, "o", "\u001b[?2004h> "]
[1689.811433, "o", "        if M % _BM != 0 or N % _BN != 0 or K % _BK != 0:\r\n\u001b[?2004l\r"]
[1689.811465, "o", "\u001b[?2004h> "]
[1689.811584, "o", "            y = torch.nn.functional.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r"]
[1689.811616, "o", "\u001b[?2004h> "]
[1689.811649, "o", "            return y * s + y\r\n\u001b[?2004l\r"]
[1689.81168, "o", "\u001b[?2004h> "]
[1689.811747, "o", "        w_hi, w_lo, bias_s = self._prepare(x)\r\n\u001b[?2004l\r"]
[1689.811776, "o", "\u001b[?2004h> "]
[1689.811808, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[1689.81184, "o", "\u001b[?2004h> "]
[1689.811873, "o", "        numel = M * K\r\n\u001b[?2004l\r"]
[1689.811905, "o", "\u001b[?2004h> "]
[1689.812012, "o", "        x_hi = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1689.812044, "o", "> "]
[1689.812144, "o", "        x_lo = torch.empty((M, K), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1689.812177, "o", "\u001b[?2004h> "]
[1689.812204, "o", "        SB = 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1689.81235, "o", "        _split_fp32[(triton.cdiv(numel, SB),)](x, x_hi, x_lo, numel, SB, num_warps=8)\r\n\u001b[?2004l\r"]
[1689.812382, "o", "\u001b[?2004h> "]
[1689.812482, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1689.812514, "o", "\u001b[?2004h> "]
[1689.812596, "o", "        grid = (triton.cdiv(M, _BM) * triton.cdiv(N, _BN),)\r\n\u001b[?2004l\r"]
[1689.812622, "o", "\u001b[?2004h> "]
[1689.812729, "o", "        _gemm_fp16x3[grid](x_hi, x_lo, w_hi, w_lo, bias_s, out, M, N, K,\r\n\u001b[?2004l\r"]
[1689.812761, "o", "\u001b[?2004h> "]
[1689.812887, "o", "                           1.0 + s, _BM, _BN, _BK, _GM, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r"]
[1689.812919, "o", "\u001b[?2004h> "]
[1689.812943, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1689.812976, "o", "EOF\r\n\u001b[?2004l\r"]
