[1546.943886, "i", "cat > /workspace/tune4.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nexec(open('/workspace/tune3.py').read().split('def bench')[0])\n\ndef bench(fn, iters=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    ts = []\n    for _ in range(iters):\n        dummy.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nSB = 4096\nsplit_fn = lambda: splitk[(triton.cdiv(numel, SB),)](x, x_hi, x_lo, numel, SB, num_warps=8)\nsplit_fn(); torch.cuda.synchronize()\n\nfor BM, BN, BK, gm, nw, ns in [\n    (128,256,32,8,8,3),\n    (128,256,32,4,8,3),\n    (128,256,32,16,8,3),\n    (128,256,32,8,16,3),\n    (128,256,64,8,8,3),\n    (128,512,32,8,8,3),\n    (64,512,32,8,8,3),\n    (256,256,32,8,8,3),\n    (128,256,32,32,8,3),\n]"]
[1546.943928, "i", ":\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: (split_fn(), kernB2[grid](x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K, 1.5, BM, BN, BK, gm, num_warps=nw, num_stages=ns))\n        t = bench(fn)\n        print(f'B2 BM={BM} BN={BN} BK={BK} gm={gm} w={nw} s={ns}: {t:.3f} ms', flush=True)\n    except Exception as ex:\n        print(BM,BN,BK,gm,nw,ns,'FAIL',str(ex)[:80], flush=True)\n# split kernel alone\nt = bench(split_fn)\nprint('split alone:', t, flush=True)\nEOF\ngpu push sb-ofRh32R16LNz5qnbFtSmpW /workspace/tune4.py /workspace/tune4.py && gpu exec sb-ofRh32R16LNz5qnbFtSmpW -- bash -c 'cd /tmp && python3 /workspace/tune4.py 2>&1 | tail -15'\n"]
[1546.944188, "o", "cat > /workspace/tune4.py << 'EOF'"]
