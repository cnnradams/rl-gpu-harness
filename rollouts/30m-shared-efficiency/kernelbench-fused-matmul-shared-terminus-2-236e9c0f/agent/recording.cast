[749.537695, "o", "        b_lo = (bb - b_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[749.537718, "o", "\u001b[?2004h> "]
[749.537776, "o", "        acc = tl.dot(a_hi, b_hi, acc)\r\n\u001b[?2004l\r"]
[749.537799, "o", "\u001b[?2004h> "]
[749.537858, "o", "        acc = tl.dot(a_hi, b_lo, acc)\r\n\u001b[?2004l\r"]
[749.537881, "o", "\u001b[?2004h> "]
[749.537941, "o", "        acc = tl.dot(a_lo, b_hi, acc)\r\n\u001b[?2004l\r"]
[749.537964, "o", "\u001b[?2004h> "]
[749.537997, "o", "        a_ptrs += BK\r\n\u001b[?2004l\r"]
[749.538022, "o", "\u001b[?2004h> "]
[749.538049, "o", "        w_ptrs += BK\r\n\u001b[?2004l\r"]
[749.538075, "o", "\u001b[?2004h> "]
[749.53817, "o", "    bv = tl.load(BIAS + offs_n, mask=offs_n < N, other=0.0)\r\n\u001b[?2004l\r"]
[749.538193, "o", "\u001b[?2004h> "]
[749.538246, "o", "    c = acc * scale + bv[None, :]\r\n\u001b[?2004l\r"]
[749.538269, "o", "\u001b[?2004h> "]
[749.538354, "o", "    c_ptrs = C + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[749.538379, "o", "\u001b[?2004h> "]
[749.538472, "o", "    tl.store(c_ptrs, c, mask=m_mask & (offs_n[None, :] < N))\r\n\u001b[?2004l\r"]
[749.538495, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[749.53852, "o", "> "]
[749.538559, "o", "def bench(fn, iters=20):\r\n\u001b[?2004l\r"]
[749.538587, "o", "\u001b[?2004h> "]
[749.538625, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[749.538649, "o", "\u001b[?2004h> "]
[749.538692, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[749.538716, "o", "\u001b[?2004h> "]
[749.538832, "o", "    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[749.538854, "o", "\u001b[?2004h> "]
[749.538878, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.538934, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[749.53896, "o", "\u001b[?2004h> "]
[749.538996, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[749.539019, "o", "\u001b[?2004h> "]
[749.539071, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[749.539093, "o", "\u001b[?2004h> "]
[749.539251, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.539361, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[749.539387, "o", "\u001b[?2004h> "]
[749.539437, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[749.539463, "o", "\u001b[?2004h> "]
[749.53949, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.539515, "o", "> "]
[749.539545, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[749.539568, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[749.539593, "o", "\u001b[?2004h> "]
[749.539619, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.53979, "o", "for BM, BN, BK, gm, nw, ns in itertools.product([64,128,256],[64,128,256],[32,64,128],[8],[4,8],[3,4,5]):\r\n\u001b[?2004l\r"]
[749.539827, "o", "\u001b[?2004h> "]
[749.539887, "o", "    if BM*BN >= 256*256 and nw < 8: continue"]
[749.53991, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.539982, "o", "    if BM*BN <= 64*64 and nw > 4: continue\r\n\u001b[?2004l\r"]
[749.540005, "o", "\u001b[?2004h> "]
[749.540083, "o", "    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[749.540106, "o", "\u001b[?2004h> "]
[749.540131, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[749.540305, "o", "        fn = lambda: kern[grid](x, w, bias, out, M, N, K, 1.5, BM, BN, BK, gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[749.540331, "o", "\u001b[?2004h> "]
[749.540366, "o", "        t = bench(fn)\r\n\u001b[?2004l\r"]
[749.540389, "o", "\u001b[?2004h> "]
[749.540459, "o", "        err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[749.540484, "o", "\u001b[?2004h> "]
[749.540523, "o", "        tf = 6*M*N*K/t/1e9\r\n\u001b[?2004l\r"]
[749.540549, "o", "\u001b[?2004h> "]
[749.540644, "o", "        results.append((t, BM, BN, BK, gm, nw, ns, tf, err))\r\n\u001b[?2004l\r"]
[749.540667, "o", "\u001b[?2004h> "]
[749.540873, "o", "        print(f'BM={BM} BN={BN} BK={BK} warps={nw} stages={ns}: {t:.3f} ms ({tf:.0f} fp16 TFLOPS) err={err:.2e}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.540908, "o", "> "]
[749.540934, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.540959, "o", "> "]
[749.541054, "o", "        print(BM,BN,BK,nw,ns,'fail', str(ex)[:60], flush=True)\r\n\u001b[?2004l\r"]
[749.541079, "o", "\u001b[?2004h> "]
[749.541102, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[749.541128, "o", "> "]
[749.54116, "o", "print('BEST:', results[:5])\r\n\u001b[?2004l\r"]
