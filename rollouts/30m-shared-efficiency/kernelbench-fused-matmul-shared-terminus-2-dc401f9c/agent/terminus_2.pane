    BM,BN,BK,G,w,s = cfg
    o = runp(BM,BN,BK,G,w,s)
    err = (o-ref).abs().max().item()
    for _ in range(3): runp(BM,BN,BK,G,w,s)
    torch.cuda.synchronize()
    ts = []
    for _ in range(10):
        cache.zero_(); torch.cuda.synchronize()
        st, en = torch.cuda.Event(True), torch.cuda.Event(True)
        st.record(); runp(BM,BN,BK,G,w,s); en.record(); torch.cuda.synchronize()
        ts.append(st.elapsed_time(en))
    ts = sorted(ts)[1:]
    print(f"presplit BM{BM} BN{BN} BK{BK} w{w} s{s}: {sum(ts)/len(ts):.3f} ms err {err:.2e}")
