[724.022262, "o", "\u001b[?2004hroot@modal:/# "]
[737.908971, "i", "cat > /workspace/acc8.py << 'EOF'\nimport torch\n\ndef q8(v):\n    amax = v.abs().amax()\n    s = (amax / 448.0).clamp_min(1e-30)\n    q = torch.clamp(v / s, -448, 448).to(torch.float8_e4m3fn)\n    return q, s\n\nfails = 0\nfor seed in [42, 7, 123, 2024, 99999]:\n    torch.manual_seed(seed)\n    M, K, N = 16384, 4096, 4096\n    x = torch.rand(M, K, device='cuda')\n    lin = torch.nn.Linear(K, N).cuda()\n    W = lin.weight.detach(); bias = lin.bias.detach()\n    sf = 0.5\n    ref = (torch.nn.functional.linear(x, W, bias) * sf + torch.nn.functional.linear(x, W, bias))\n    Wt = (W * 1.5).t().contiguous()\n    bs = 1.5 * bias\n    NB = K // 128\n    xb = x.view(M, NB, 128)\n    Wb = Wt.view(NB, 128, N).permute(0, 2, 1)  # NB, N, 128\n    qa, sa = q8(xb)          # M, NB, 128\n    qb, sb = q8(Wb)          # NB, N, 128\n    acc = torch.zeros(M, N, device='cuda')\n    for i in range(NB):\n        acc += (qa[:, i, :].float() @ qb[i].float()) * (sa[:, i:i+1] * sb[i])\n    acc += bs\n    d = (acc - ref).abs()\n    thr = 1e-4 + 1e-4 * ref.abs()\n   "]
[737.909224, "i", " nfail = (d > thr).sum().item()\n    fails += nfail\n    print(f\"seed {seed}: max {d.max().item():.3e} mean {d.mean().item():.3e} viol {nfail}\")\nprint(\"total violations:\", fails)\nEOF\nB64=$(base64 -w0 /workspace/acc8.py) && gpu exec sb-Ee0YD4gATEv6sdRfhskPnn -- bash -c \"echo $B64 | base64 -d > /workspace/acc8.py && python3 /workspace/acc8.py 2>&1 | tail -8\"\n"]
