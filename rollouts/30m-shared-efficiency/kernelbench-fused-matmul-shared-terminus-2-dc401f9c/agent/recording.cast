[292.576229, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef k(A, BH, BL, BIAS, C, M, N, K,\n      sam, sak, sbk, sbn, scm, scn,\n      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP * num_pid_n\n    gid = pid // npg\n    fpm = gid * GROUP\n    gsm = min(num_pid_m - fpm, GROUP)\n    pid_m = fpm + ((pid % npg) % gsm)\n    pid_n = (pid % npg) // gsm\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(Ap)\n        bh = tl.load(BHp)\n        bl = tl.load(BLp)\n        a_hi = a.to(tl.bfloat16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.bfloat16)\n  "]
[292.576279, "i", "      acc = tl.dot(a_hi, bh, acc)\n        acc = tl.dot(a_lo, bh, acc)\n        acc = tl.dot(a_hi, bl, acc)\n        Ap += BK * sak; BHp += BK * sbk; BLp += BK * sbk\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\ndef run(x, wh, wl, b, BM, BN, BK, G, w, s):\n    M, K = x.shape; N = wh.shape[1]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k[grid](x, wh, wl, b, out, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_warps=w, num_stages=s)\n    return out\n\ntorch.manual_seed(0)\nM = N = K = 4096*4 if False else None\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nW = (torch.rand(N, K, device='cuda') - 0.5) * 0.03\nWt = (W * 1.5).t().contiguous()\nwh = Wt.to(torch.bfloat16); wl = (Wt - wh.float()).to(torch.bfloat16)\nb = torch.rand(N, device='cuda') * 1.5\nref = torch.n"]
[292.576573, "i", "n.functional.linear(x, W*1.5, b)\n\ncfgs = [(128,128,64,8,8,3),(128,128,64,8,8,2),(128,128,32,8,8,4),(128,128,32,8,8,5),(128,256,32,8,8,3),(256,128,32,8,8,3),(128,256,32,8,8,4),(64,128,64,8,4,4),(128,64,64,8,4,4),(256,128,64,8,8,2),(128,256,64,8,8,2),(64,256,64,8,8,3),(256,64,32,8,4,4)]\ncache = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\nfor (BM,BN,BK,G,w,s) in cfgs:\n    try:\n        o = run(x, wh, wl, b, BM, BN, BK, G, w, s)\n        err = (o - ref).abs().max().item()\n        # timing\n        for _ in range(3): run(x, wh, wl, b, BM, BN, BK, G, w, s)\n        torch.cuda.synchronize()\n        times = []\n        for _ in range(10):\n            cache.zero_()\n            torch.cuda.synchronize()\n            st, en = torch.cuda.Event(True), torch.cuda.Event(True)\n            st.record(); run(x, wh, wl, b, BM, BN, BK, G, w, s); en.record()\n            torch.cuda.synchronize()\n            times.append(st.elapsed_time(en))\n        times = sorted(times)[1:]\n        print(f\"BM{BM} BN{BN} BK{BK} w{w} s{s}: {"]
[292.576587, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[292.576622, "i", "sum(times)/len(times):.3f} ms  err {err:.2e}\")\n    except Exception as e:\n        print(f\"BM{BM} BN{BN} BK{BK} w{w} s{s}: FAIL {type(e).__name__} {str(e)[:80]}\")\nEOF\n"]
