[1567.087896, "o", "\u001b[?2004h> "]
[1567.087981, "o", "                \".reg .b32 lo32, hi32, tmp0, tmp1;\\n\"\r\n\u001b[?2004l\r"]
[1567.088008, "o", "\u001b[?2004h> "]
[1567.088086, "o", "                \"cvt.rn.bf16x2.f32 lo32, $3, $2;\\n\"\r\n\u001b[?2004l\r"]
[1567.088113, "o", "\u001b[?2004h> "]
[1567.088189, "o", "                \"cvt.rn.bf16x2.f32 hi32, $1, $0;\\n\"\r\n\u001b[?2004l\r"]
[1567.088214, "o", "\u001b[?2004h> "]
[1567.088286, "o", "                \"mov.b32 {tmp0, tmp1}, lo32;\\n\"\r\n\u001b[?2004l\r"]
[1567.088312, "o", "\u001b[?2004h> "]
[1567.088368, "o", "                \"mov.b16 $0, tmp0;\\n\"\r\n\u001b[?2004l\r"]
[1567.088394, "o", "\u001b[?2004h> "]
[1567.088449, "o", "                \"mov.b16 $1, tmp1;\\n\"\r\n\u001b[?2004l\r"]
[1567.088475, "o", "\u001b[?2004h> "]
[1567.088546, "o", "                \"mov.b32 {tmp0, tmp1}, hi32;\\n\"\r\n\u001b[?2004l\r"]
[1567.088572, "o", "\u001b[?2004h> "]
[1567.088628, "o", "                \"mov.b16 $2, tmp0;\\n\"\r\n\u001b[?2004l\r"]
[1567.088654, "o", "\u001b[?2004h> "]
[1567.088709, "o", "                \"mov.b16 $3, tmp1;\\n\"\r\n\u001b[?2004l\r"]
[1567.088734, "o", "\u001b[?2004h> "]
[1567.088777, "o", "                \"}\\n\",\r\n\u001b[?2004l\r"]
[1567.088803, "o", "\u001b[?2004h> "]
[1567.088859, "o", "                \"=h,=h,=h,=h,r,r,r,r\",\r\n\u001b[?2004l\r"]
[1567.088885, "o", "\u001b[?2004h> "]
[1567.088909, "o", "                [a],\r\n\u001b[?2004l\r"]
[1567.088934, "o", "\u001b[?2004h> "]
[1567.089055, "o", "                dtype=(tl.bfloat16, tl.bfloat16, tl.bfloat16, tl.bfloat16),\r\n\u001b[?2004l\r"]
[1567.089081, "o", "\u001b[?2004h> "]
[1567.089124, "o", "                is_pure=True,\r\n\u001b[?2004l\r"]
[1567.089149, "o", "\u001b[?2004h> "]
[1567.089184, "o", "                pack=2,\r\n\u001b[?2004l\r"]
[1567.08921, "o", "\u001b[?2004h> "]
[1567.089238, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.089263, "o", "> "]
[1567.089368, "o", "            a_hi = tl.join(abf[0], abf[1]).permute(0, 2, 1).reshape(BM, BK)\r\n\u001b[?2004l\r"]
[1567.089395, "o", "\u001b[?2004h> "]
[1567.089523, "o", "            a_lo = tl.join(abf[2], abf[3]).permute(0, 2, 1).reshape(BM, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.089549, "o", "> "]
[1567.089604, "o", "            acc = tl.dot(a_hi, bh, acc)\r\n\u001b[?2004l\r"]
[1567.08963, "o", "\u001b[?2004h> "]
[1567.089689, "o", "            acc = tl.dot(a_lo, bh, acc)\r\n\u001b[?2004l\r"]
[1567.089714, "o", "\u001b[?2004h> "]
[1567.089779, "o", "            acc = tl.dot(a_hi, bl, acc)"]
[1567.089807, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1567.089851, "o", "            Ap += BK * sak\r\n\u001b[?2004l\r"]
[1567.089876, "o", "\u001b[?2004h> "]
[1567.089917, "o", "            BHp += BK * sbk\r\n\u001b[?2004l\r"]
[1567.089944, "o", "\u001b[?2004h> "]
[1567.089983, "o", "            BLp += BK * sbk\r\n\u001b[?2004l\r"]
[1567.090009, "o", "\u001b[?2004h> "]
[1567.090059, "o", "        bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[1567.090085, "o", "\u001b[?2004h> "]
[1567.090134, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1567.090167, "o", "\u001b[?2004h> "]
[1567.090242, "o", "        Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1567.090267, "o", "\u001b[?2004h> "]
[1567.090305, "o", "        tl.store(Cp, acc)\r\n\u001b[?2004l\r"]
[1567.09033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.090358, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.090385, "o", "> "]
[1567.090439, "o", "def _split_linear(x, w_hi, w_lo, bias):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.090466, "o", "> "]
