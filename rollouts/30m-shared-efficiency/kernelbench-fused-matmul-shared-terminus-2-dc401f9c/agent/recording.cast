[1567.091782, "o", "\u001b[?2004h> "]
[1567.091818, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1567.091845, "o", "\u001b[?2004h> "]
[1567.091932, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1567.091958, "o", "\u001b[?2004h> "]
[1567.092036, "o", "        self.scaling_factor = float(scaling_factor)\r\n\u001b[?2004l\r"]
[1567.092062, "o", "\u001b[?2004h> "]
[1567.092098, "o", "        self._w_hi = None\r\n\u001b[?2004l\r"]
[1567.092124, "o", "\u001b[?2004h> "]
[1567.092161, "o", "        self._w_lo = None\r\n\u001b[?2004l\r"]
[1567.092187, "o", "\u001b[?2004h> "]
[1567.092224, "o", "        self._bias = None\r\n\u001b[?2004l\r"]
[1567.092249, "o", "\u001b[?2004h> "]
[1567.092287, "o", "        self._w_fb = None\r\n\u001b[?2004l\r"]
[1567.092312, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1567.092338, "o", "\u001b[?2004h> "]
[1567.092381, "o", "    def _prepare(self, device):\r\n\u001b[?2004l\r"]
[1567.092408, "o", "\u001b[?2004h> "]
[1567.092516, "o", "        if self._w_hi is not None and self._w_hi.device == device:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.092542, "o", "> "]
[1567.092567, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.092592, "o", "> "]
[1567.092644, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[1567.09267, "o", "\u001b[?2004h> "]
