[1670.090424, "o", "    def _prepare(self, device):\r\n\u001b[?2004l\r"]
[1670.090448, "o", "\u001b[?2004h> "]
[1670.090557, "o", "        if self._w_hi is not None and self._w_hi.device == device:\r\n\u001b[?2004l\r"]
[1670.090584, "o", "\u001b[?2004h> "]
[1670.090614, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1670.090683, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[1670.090708, "o", "\u001b[?2004h> "]
[1670.090831, "o", "        W = self.matmul.weight.detach().to(device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1670.090855, "o", "\u001b[?2004h> "]
[1670.090973, "o", "        b = self.matmul.bias.detach().to(device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1670.090996, "o", "\u001b[?2004h> "]
[1670.091054, "o", "        Wt = (W * s).t().contiguous()\r\n\u001b[?2004l\r"]
[1670.091078, "o", "\u001b[?2004h> "]
[1670.09113, "o", "        hi = Wt.to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[1670.091153, "o", "\u001b[?2004h> "]
[1670.091245, "o", "        lo = (Wt - hi.to(torch.float32)).to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[1670.091271, "o", "\u001b[?2004h> "]
[1670.091305, "o", "        self._w_hi = hi\r\n\u001b[?2004l\r"]
[1670.091327, "o", "\u001b[?2004h> "]
[1670.091364, "o", "        self._w_lo = lo\r\n\u001b[?2004l\r"]
[1670.091389, "o", "\u001b[?2004h> "]
[1670.091452, "o", "        self._bias = (b * s).contiguous()\r\n\u001b[?2004l\r"]
[1670.091475, "o", "\u001b[?2004h> "]
[1670.091515, "o", "        self._w_fb = W * s\r\n\u001b[?2004l\r"]
[1670.091539, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1670.09157, "o", "> "]
[1670.091605, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1670.091631, "o", "\u001b[?2004h> "]
[1670.091676, "o", "        self._prepare(x.device)\r\n\u001b[?2004l\r"]
[1670.091698, "o", "\u001b[?2004h> "]
[1670.091837, "o", "        if _HAS_TRITON and x.is_cuda and x.shape[0] % 128 == 0 and x.shape[1] % 32 == 0:\r\n\u001b[?2004l\r"]
[1670.091861, "o", "\u001b[?2004h> "]
[1670.091993, "o", "            return _split_linear(x.contiguous(), self._w_hi, self._w_lo, self._bias)\r\n\u001b[?2004l\r"]
[1670.092017, "o", "\u001b[?2004h> "]
[1670.092123, "o", "        return torch.nn.functional.linear(x, self._w_fb, self._bias)\r\n\u001b[?2004l\r"]
[1670.092148, "o", "\u001b[?2004h> EOF\r\n"]
[1670.092173, "o", "\u001b[?2004l\r"]
[1670.094134, "o", "\u001b[?2004hroot@modal:/# "]
