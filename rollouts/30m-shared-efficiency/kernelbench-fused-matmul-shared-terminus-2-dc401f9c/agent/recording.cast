[1084.747047, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndef alloc_fn(size, align, stream):\n    return torch.empty(size, dtype=torch.int8, device='cuda')\ntriton.set_allocator(alloc_fn)\n\n@triton.jit\ndef k_tma(A, BH, BL, BIAS, C, M, N, K,\n          sam, sak, sbk, sbn, scm, scn,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP * num_pid_n\n    gid = pid // npg\n    fpm = gid * GROUP\n    gsm = min(num_pid_m - fpm, GROUP)\n    pid_m = fpm + ((pid % npg) % gsm)\n    pid_n = (pid % npg) // gsm\n    a_desc = tl.make_tensor_descriptor(A, shape=[M, K], strides=[sam, 1], block_shape=[BM, BK])\n    bh_desc = tl.make_tensor_descriptor(BH, shape=[K, N], strides=[sbk, 1], block_shape=[BK, BN])\n    bl_desc = tl.make_tensor_descriptor(BL, shape=[K, N], strides=[sbk, 1], block_shape=[BK, BN])\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for i in range(0, tl.cdiv(K, B"]
[1084.747092, "i", "K)):\n        a = a_desc.load([pid_m * BM, i * BK])\n        bh = bh_desc.load([i * BK, pid_n * BN])\n        bl = bl_desc.load([i * BK, pid_n * BN])\n        a_hi = a.to(tl.bfloat16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.bfloat16)\n        acc = tl.dot(a_hi, bh, acc)\n        acc = tl.dot(a_lo, bh, acc)\n        acc = tl.dot(a_hi, bl, acc)\n    bias = tl.load(BIAS + pid_n * BN + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[scm, 1], block_shape=[BM, BN])\n    c_desc.store([pid_m * BM, pid_n * BN], acc)\n\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nW = (torch.rand(N, K, device='cuda') - 0.5) * 0.03\nWt = (W * 1.5).t().contiguous()\nwh = Wt.to(torch.bfloat16); wl = (Wt - wh.float()).to(torch.bfloat16)\nb = torch.rand(N, device='cuda') * 1.5\nref = torch.nn.functional.linear(x, W*1.5, b)\n\ndef runt(BM,BN,BK,G,w,s):\n    out = torch.empty((M, N), device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),"]
[1084.747103, "i", ")\n    k_tma[grid](x, wh, wl, b, out, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_warps=w, num_stages=s)\n    return out\n\ncache = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\nfor cfg in [(128,128,32,8,8,3),(128,128,64,8,8,3),(128,256,64,8,8,3),(128,128,128,8,8,2),(256,128,64,8,8,3)]:\n    BM,BN,BK,G,w,s = cfg\n    try:\n        o = runt(BM,BN,BK,G,w,s)\n        err = (o-ref).abs().max().item()\n        for _ in range(3): runt(BM,BN,BK,G,w,s)\n        torch.cuda.synchronize()\n        ts = []\n        for _ in range(10):\n            cache.zero_(); torch.cuda.synchronize()\n            st, en = torch.cuda.Event(True), torch.cuda.Event(True)\n            st.record(); runt(BM,BN,BK,G,w,s); en.record(); torch.cuda.synchronize()\n            ts.append(st.elapsed_time(en))\n        ts = sorted(ts)[1:]\n        print(f\"tma BM{BM} BN{BN} BK{BK} w{w} s{s}: {sum(ts)/len(ts):.3f} ms err {err:.2e}\")\n    except Exception as e:\n        print("]
[1084.74725, "i", "f\"tma BM{BM} BN{BN} BK{BK} w{w} s{s}: FAIL {type(e).__name__} {str(e)[:100]}\")\nEOF\nB64=$(base64 -w0 /workspace/bench3.py) && gpu exec sb-Ee0YD4gATEv6sdRfhskPnn -- bash -c \"echo $B64 | base64 -d > /workspace/bench3.py && python3 /workspace/bench3.py 2>&1 | tail -6\"\n"]
