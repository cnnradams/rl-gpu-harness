[1156.435282, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    @triton.jit\n    def _split_mm_kernel(AH, AL, BH, BL, BIAS, C, M, N, K,\n                         sam, sak, sbk, sbn, scm, scn,\n                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                         GROUP: tl.constexpr,\n                         MASK_M: tl.constexpr, MASK_N: tl.constexpr):\n        pid = tl.program_id(0)\n        num_pid_m = tl.cdiv(M, BM)\n        num_pid_n = tl.cdiv(N, BN)\n        num_pid_in_group = GROUP * num_pid_n\n        group_id = pid // num_pid_in_group\n        first_pid_m = group_id * GROUP\n        group_size_m = min(num_pid_m - first_pid_m, GROUP)\n        pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n        pid_n = (pid % num_pid_in_group) // group_size_m\n\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + "]
[1156.435581, "i", "tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n        AHp = AH + rm[:, None] * sam + rk[None, :] * sak\n        ALp = AL + rm[:, None] * sam + rk[None, :] * sak\n        BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n        BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for _ in range(0, tl.cdiv(K, BK)):\n            if MASK_M:\n                ah = tl.load(AHp, mask=rm[:, None] < M, other=0.0)\n                al = tl.load(ALp, mask=rm[:, None] < M, other=0.0)\n            else:\n                ah = tl.load(AHp)\n                al = tl.load(ALp)\n            if MASK_N:\n                bh = tl.load(BHp, mask=rn[None, :] < N, other=0.0)\n                bl = tl.load(BLp, mask=rn[None, :] < N, other=0.0)\n            else:\n                bh = tl.load(BHp)\n                bl = tl.load(BLp)\n            acc = tl.dot(ah, bh, acc)\n            acc = tl.dot(al, bh, acc)\n            acc = tl.dot(ah, bl, acc)\n            AHp += BK * sak\n            ALp += BK * sak"]
[1156.435594, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1156.435633, "i", "\n            BHp += BK * sbk\n            BLp += BK * sbk\n        if MASK_N:\n            bias = tl.load(BIAS + rn, mask=rn < N, other=0.0)\n        else:\n            bias = tl.load(BIAS + rn)\n        acc = acc + bias[None, :]\n        Cp = C + rm[:, None] * scm + rn[None, :] * scn\n        if MASK_M or MASK_N:\n            cmask = (rm[:, None] < M) & (rn[None, :] < N)\n            tl.store(Cp, acc, mask=cmask)\n        else:\n            tl.store(Cp, acc)\n\n\ndef _split_linear(x, w_hi, w_lo, bias):\n    M, K = x.shape\n    N = w_hi.shape[1]\n    x_hi = x.to(torch.bfloat16)\n    x_lo = (x - x_hi.to(torch.float32)).to(torch.bfloat16)\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    BM, BN, BK, GROUP = 128, 256, 32, 8\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    _split_mm_kernel[grid](\n        x_hi, x_lo, w_hi, w_lo, bias, out, M, N, K,\n        x.stride(0), x.stride(1),\n        w_hi.stride(0), w_hi.stride(1),\n        out.stride(0), out.stride(1),\n        BM=BM, BN=BN, BK=BK, GROUP=GROUP,\n  "]
[1156.435664, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1156.435693, "i", "      MASK_M=(M % BM != 0), MASK_N=(N % BN != 0),\n        num_warps=8, num_stages=3,\n    )\n    return out\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = float(scaling_factor)\n        self._w_hi = None\n        self._w_lo = None\n        self._bias = None\n        self._w_fb = None\n\n    def _prepare(self, device):\n        if self._w_hi is not None and self._w_hi.device == device:\n            return\n        s = 1.0 + self.scaling_factor\n        W = self.matmul.weight.detach().to(device=device, dtype=torch.float32)\n        b = self.matmul.bias.detach().to(device=device, dtype=torch.float32)\n        Wt = (W * s).t().contiguous()\n        hi = Wt.to(torch.bfloat16)\n        lo = (Wt - hi.to(torch.float32)).to(torch.bfloat16)\n        self._w_hi = hi\n        self._w_lo = lo\n        self._bias = (b * s).contiguous()\n        self._w_fb = W * s\n\n    def forward("]
[1156.435716, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1156.435749, "i", "self, x):\n        self._prepare(x.device)\n        if _HAS_TRITON and x.is_cuda and (x.shape[1] % 64 == 0):\n            return _split_linear(x.contiguous(), self._w_hi, self._w_lo, self._bias)\n        return torch.nn.functional.linear(x, self._w_fb, self._bias)\nEOF\n"]
