[292.580656, "o", "\u001b[?2004h> "]
[292.580713, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[292.580741, "o", "\u001b[?2004h> "]
[292.580827, "o", "W = (torch.rand(N, K, device='cuda') - 0.5) * 0.03\r\n\u001b[?2004l\r\u001b[?2004h"]
