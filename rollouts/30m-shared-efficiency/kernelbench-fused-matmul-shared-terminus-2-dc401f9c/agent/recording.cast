[1567.090896, "o", "\u001b[?2004h> "]
[1567.090941, "o", "    _split_mm_kernel_v4[grid](\r\n\u001b[?2004l\r"]
[1567.090967, "o", "\u001b[?2004h> "]
[1567.09103, "o", "        x, w_hi, w_lo, bias, out, M, N, K,\r\n\u001b[?2004l\r"]
