[654.060148, "o", "    BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[654.060182, "o", "\u001b[?2004h> "]
[654.06025, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[654.060283, "o", "\u001b[?2004h> "]
[654.060336, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[654.060367, "o", "\u001b[?2004h> "]
[654.060398, "o", "        ah = tl.load(AHp)\r\n\u001b[?2004l\r"]
[654.06043, "o", "\u001b[?2004h> "]
[654.060473, "o", "        al = tl.load(ALp)\r\n\u001b[?2004l\r"]
[654.060504, "o", "\u001b[?2004h> "]
[654.060534, "o", "        bh = tl.load(BHp)\r\n\u001b[?2004l\r"]
[654.060565, "o", "\u001b[?2004h> "]
[654.060602, "o", "        bl = tl.load(BLp)\r\n\u001b[?2004l\r"]
[654.060634, "o", "\u001b[?2004h> "]
[654.060679, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[654.06071, "o", "\u001b[?2004h> "]
[654.060756, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[654.060794, "o", "\u001b[?2004h> "]
[654.060834, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[654.060863, "o", "\u001b[?2004h> "]
[654.060979, "o", "        AHp += BK * sak; ALp += BK * sak; BHp += BK * sbk; BLp += BK * sbk\r\n\u001b[?2004l\r"]
[654.061016, "o", "\u001b[?2004h> "]
[654.061047, "o", "    bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[654.061078, "o", "\u001b[?2004h> "]
[654.061121, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[654.061158, "o", "\u001b[?2004h> "]
[654.061228, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[654.061257, "o", "\u001b[?2004h> "]
[654.061288, "o", "    tl.store(Cp, acc)\r\n\u001b[?2004l\r"]
[654.061322, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[654.061378, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[654.061409, "o", "\u001b[?2004h> "]
[654.061469, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[654.061538, "o", "\u001b[?2004h> "]
[654.061575, "o", "W = (torch.rand(N, K, device='cuda') - 0.5) * 0.03\r\n\u001b[?2004l\r"]
[654.061606, "o", "\u001b[?2004h> "]
[654.061648, "o", "Wt = (W * 1.5).t().contiguous()\r\n\u001b[?2004l\r"]
[654.061679, "o", "\u001b[?2004h> "]
[654.061794, "o", "wh = Wt.to(torch.bfloat16); wl = (Wt - wh.float()).to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[654.061824, "o", "\u001b[?2004h> "]
[654.061925, "o", "xh = x.to(torch.bfloat16); xl = (x - xh.float()).to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[654.061955, "o", "\u001b[?2004h> "]
[654.062009, "o", "b = torch.rand(N, device='cuda') * 1.5\r\n\u001b[?2004l\r"]
[654.062041, "o", "\u001b[?2004h> "]
[654.062108, "o", "ref = torch.nn.functional.linear(x, W*1.5, b)\r\n\u001b[?2004l\r"]
[654.062141, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[654.062176, "o", "> "]
[654.062206, "o", "def runp(BM,BN,BK,G,w,s):\r\n\u001b[?2004l\r\u001b[?2004h"]
[654.062241, "o", "> "]
[654.062333, "o", "    out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[654.062348, "o", "> "]
[654.062441, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[654.062474, "o", "\u001b[?2004h> "]
[654.062788, "o", "    k_presplit[grid](xh, xl, wh, wl, b, out, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[654.062814, "o", "> "]
[654.062852, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[654.062884, "o", "\u001b[?2004h> "]
[654.062988, "o", "cache = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\r\n\u001b[?2004l\r"]
[654.063001, "o", "\u001b[?2004h> "]
[654.063127, "o", "for cfg in [(128,128,32,8,8,3),(128,128,32,8,8,4),(128,256,32,8,8,3)]:\r\n\u001b[?2004l\r"]
[654.063158, "o", "\u001b[?2004h> "]
[654.063187, "o", "    BM,BN,BK,G,w,s = cfg\r\n\u001b[?2004l\r"]
[654.063218, "o", "\u001b[?2004h> "]
[654.063256, "o", "    o = runp(BM,BN,BK,G,w,s)\r\n\u001b[?2004l\r"]
[654.063288, "o", "\u001b[?2004h> "]
[654.063339, "o", "    err = (o-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[654.063368, "o", "\u001b[?2004h> "]
[654.063435, "o", "    for _ in range(3): runp(BM,BN,BK,G,w,s)\r\n\u001b[?2004l\r"]
[654.063477, "o", "\u001b[?2004h> "]
[654.063505, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[654.063543, "o", "    ts = []\r\n\u001b[?2004l\r"]
[654.063571, "o", "\u001b[?2004h> "]
[654.063599, "o", "    for _ in range(10):\r\n\u001b[?2004l\r"]
[654.063626, "o", "\u001b[?2004h> "]
[654.0637, "o", "        cache.zero_(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[654.063727, "o", "\u001b[?2004h> "]
[654.063841, "o", "        st, en = torch.cuda.Event(True), torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[654.063857, "o", "> "]
[654.06399, "o", "        st.record(); runp(BM,BN,BK,G,w,s); en.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[654.064024, "o", "\u001b[?2004h> "]
[654.064073, "o", "        ts.append(st.elapsed_time(en))\r\n\u001b[?2004l\r"]
[654.064088, "o", "\u001b[?2004h> "]
[654.064137, "o", "    ts = sorted(ts)[1:]\r\n\u001b[?2004l\r"]
[654.064172, "o", "\u001b[?2004h> "]
[654.06431, "o", "    print(f\"presplit BM{BM} BN{BN} BK{BK} w{w} s{s}: {sum(ts)/len(ts):.3f} ms err {err:.2e}\")\r\n\u001b[?2004l\r"]
[654.064341, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[654.06619, "o", "\u001b[?2004hroot@modal:/# "]
[654.066529, "o", "B64=$(base64 -w0 /workspace/bench2.py) && gpu exec sb-Ee0YD4gATEv6sdRfhskPnn -- bash -c \"echo $B64 | base64 -d > /workspace/bench2.py && python3 /workspace/bench2.py 2>&1 | tail -5\"\r\n\u001b[?2004l\r"]
[654.161145, "o", "request ID: 637f7302405440938919d62ae64429e8\r\n"]
[655.540429, "o", "command: cc8e59599a524f59adaca290f5f2df19\r\n"]
[660.725899, "o", "presplit BM128 BN128 BK32 w8 s3: 2.447 ms err 4.46e-05\r\npresplit BM128 BN128 BK32 w8 s4: 2.709 ms err 4.46e-05\r\npresplit BM128 BN256 BK32 w8 s3: 2.370 ms err 4.46e-05\r\n"]
[661.765522, "o", "\u001b[?2004hroot@modal:/# "]
