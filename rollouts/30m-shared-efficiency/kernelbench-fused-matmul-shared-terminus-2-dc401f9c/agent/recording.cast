[1567.092823, "o", "\u001b[?2004h> "]
[1567.092939, "o", "        b = self.matmul.bias.detach().to(device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1567.092965, "o", "\u001b[?2004h> "]
[1567.093021, "o", "        Wt = (W * s).t().contiguous()\r\n\u001b[?2004l\r"]
[1567.093047, "o", "\u001b[?2004h> "]
