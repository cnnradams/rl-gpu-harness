[292.58193, "o", "\u001b[?2004h> "]
[292.581962, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[292.582045, "o", "        o = run(x, wh, wl, b, BM, BN, BK, G, w, s)\r\n\u001b[?2004l\r"]
[292.582074, "o", "\u001b[?2004h> "]
