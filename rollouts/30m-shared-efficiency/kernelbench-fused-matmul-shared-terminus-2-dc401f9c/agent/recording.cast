[1567.084086, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    @triton.jit\n    def _split_mm_kernel_v4(A, BH, BL, BIAS, C, M, N, K,\n                            sam, sak, sbk, sbn, scm, scn,\n                            BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                            GROUP: tl.constexpr):\n        pid = tl.program_id(0)\n        num_pid_m = tl.cdiv(M, BM)\n        num_pid_n = tl.cdiv(N, BN)\n        num_pid_in_group = GROUP * num_pid_n\n        group_id = pid // num_pid_in_group\n        first_pid_m = group_id * GROUP\n        group_size_m = min(num_pid_m - first_pid_m, GROUP)\n        pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n        pid_n = (pid % num_pid_in_group) // group_size_m\n\n        rm = pid_m * BM + tl.arange(0, BM)\n        rn = pid_n * BN + tl.arange(0, BN)\n        rk = tl.arange(0, BK)\n        Ap = A "]
[1567.084133, "i", "+ rm[:, None] * sam + rk[None, :] * sak\n        BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n        BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for _ in range(0, tl.cdiv(K, BK)):\n            a = tl.load(Ap)\n            bh = tl.load(BHp)\n            bl = tl.load(BLp)\n            abf = tl.inline_asm_elementwise(\n                \"{\\n\"\n                \".reg .b32 lo32, hi32, tmp0, tmp1;\\n\"\n                \"cvt.rn.bf16x2.f32 lo32, $3, $2;\\n\"\n                \"cvt.rn.bf16x2.f32 hi32, $1, $0;\\n\"\n                \"mov.b32 {tmp0, tmp1}, lo32;\\n\"\n                \"mov.b16 $0, tmp0;\\n\"\n                \"mov.b16 $1, tmp1;\\n\"\n                \"mov.b32 {tmp0, tmp1}, hi32;\\n\"\n                \"mov.b16 $2, tmp0;\\n\"\n                \"mov.b16 $3, tmp1;\\n\"\n                \"}\\n\",\n                \"=h,=h,=h,=h,r,r,r,r\",\n                [a],\n                dtype=(tl.bfloat16, tl.bfloat16, tl.bfloat16, tl.bfloat16),\n                is_pure=True,\n                pack=2,\n  "]
[1567.084234, "i", "          )\n            a_hi = tl.join(abf[0], abf[1]).permute(0, 2, 1).reshape(BM, BK)\n            a_lo = tl.join(abf[2], abf[3]).permute(0, 2, 1).reshape(BM, BK)\n            acc = tl.dot(a_hi, bh, acc)\n            acc = tl.dot(a_lo, bh, acc)\n            acc = tl.dot(a_hi, bl, acc)\n            Ap += BK * sak\n            BHp += BK * sbk\n            BLp += BK * sbk\n        bias = tl.load(BIAS + rn)\n        acc = acc + bias[None, :]\n        Cp = C + rm[:, None] * scm + rn[None, :] * scn\n        tl.store(Cp, acc)\n\n\ndef _split_linear(x, w_hi, w_lo, bias):\n    M, K = x.shape\n    N = w_hi.shape[1]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    BM, BN, BK, GROUP = 128, 128, 32, 8\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    _split_mm_kernel_v4[grid](\n        x, w_hi, w_lo, bias, out, M, N, K,\n        x.stride(0), x.stride(1),\n        w_hi.stride(0), w_hi.stride(1),\n        out.stride(0), out.stride(1),\n        BM=BM, BN=BN, BK=BK, GROUP=GROUP,\n        num_warps=8, num_stages=3,\n"]
[1567.084258, "i", "    )\n    return out\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = float(scaling_factor)\n        self._w_hi = None\n        self._w_lo = None\n        self._bias = None\n        self._w_fb = None\n\n    def _prepare(self, device):\n        if self._w_hi is not None and self._w_hi.device == device:\n            return\n        s = 1.0 + self.scaling_factor\n        W = self.matmul.weight.detach().to(device=device, dtype=torch.float32)\n        b = self.matmul.bias.detach().to(device=device, dtype=torch.float32)\n        Wt = (W * s).t().contiguous()\n        hi = Wt.to(torch.bfloat16)\n        lo = (Wt - hi.to(torch.float32)).to(torch.bfloat16)\n        self._w_hi = hi\n        self._w_lo = lo\n        self._bias = (b * s).contiguous()\n        self._w_fb = W * s\n\n    def forward(self, x):\n        self._prepare(x.device)\n        if _HAS_TRITON and x.is_cuda and x."]
[1567.084282, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[1567.084305, "i", "shape[0] % 128 == 0 and x.shape[1] % 32 == 0:\n            return _split_linear(x.contiguous(), self._w_hi, self._w_lo, self._bias)\n        return torch.nn.functional.linear(x, self._w_fb, self._bias)\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\n"]
[1567.084373, "o", "shape[0] % 128 == 0 and x.shape[1] % \u001b[?2004h> "]
[1567.084443, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1567.084497, "o", "import torch.nn as nn\r\n\u001b[?2004l\rt_\u001b[?2004h> "]
[1567.084537, "o", "\r\n\u001b[?2004l\rl\u001b[?2004h> "]
[1567.084578, "o", "try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.084604, "o", "> "]
[1567.08464, "o", "    import triton\r\n\u001b[?2004l\r"]
[1567.084666, "o", "\u001b[?2004h> "]
[1567.084768, "o", "    import triton.language as tl\r\n\u001b[?2004l\r"]
[1567.084806, "o", "\u001b[?2004h> "]
[1567.084853, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\r"]
[1567.084879, "o", "\u001b[?2004h> "]
[1567.084928, "o", "except Exception:\r\n\u001b[?2004l\rne\u001b[?2004h"]
[1567.084955, "o", "> "]
[1567.085022, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r_"]
[1567.085048, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rb\u001b[?2004h"]
[1567.085077, "o", "> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[1567.085136, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r3 "]
[1567.085162, "o", "\u001b[?2004h> "]
[1567.085202, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[1567.085227, "o", "\u001b[?2004h> "]
[1567.085392, "o", "    def _split_mm_kernel_v4(A, BH, BL, BIAS, C, M, N, K,\r\n\u001b[?2004l\r"]
[1567.085422, "o", "\u001b[?2004h> "]
[1567.085535, "o", "                            sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[1567.085562, "o", "\u001b[?2004h> "]
[1567.085688, "o", "                            BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[1567.085713, "o", "\u001b[?2004h> "]
[1567.085798, "o", "                            GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1567.08583, "o", "\u001b[?2004h> "]
[1567.085871, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1567.085897, "o", "\u001b[?2004h> "]
[1567.08595, "o", "        num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1567.085976, "o", "\u001b[?2004h> "]
[1567.086029, "o", "        num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1567.08606, "o", "\u001b[?2004h> "]
[1567.086127, "o", "        num_pid_in_group = GROUP * num_pid_n\r\n\u001b[?2004l\r"]
[1567.086153, "o", "\u001b[?2004h> "]
[1567.086223, "o", "        group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1567.08625, "o", "\u001b[?2004h> "]
[1567.08631, "o", "        first_pid_m = group_id * GROUP\r\n\u001b[?2004l\r"]
[1567.086338, "o", "\u001b[?2004h> "]
[1567.086427, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP)\r\n\u001b[?2004l\r"]
[1567.086453, "o", "\u001b[?2004h> "]
[1567.086568, "o", "        pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[1567.086594, "o", "\u001b[?2004h> "]
[1567.086681, "o", "        pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1567.086707, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.086734, "o", "> "]
[1567.086799, "o", "        rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1567.086825, "o", "\u001b[?2004h> "]
[1567.086889, "o", "        rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1567.086914, "o", "\u001b[?2004h> "]
[1567.08696, "o", "        rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1567.086985, "o", "\u001b[?2004h"]
[1567.087011, "o", "> "]
[1567.087098, "o", "        Ap = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1567.087125, "o", "\u001b[?2004h> "]
[1567.087208, "o", "        BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1567.087235, "o", "\u001b[?2004h> "]
[1567.087331, "o", "        BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r\u001b[?2004h"]
[1567.087358, "o", "> "]
[1567.087429, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1567.087455, "o", "\u001b[?2004h> "]
[1567.087519, "o", "        for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[1567.087545, "o", "\u001b[?2004h> "]
[1567.087585, "o", "            a = tl.load(Ap)\r\n\u001b[?2004l\r"]
[1567.087611, "o", "\u001b[?2004h> "]
[1567.087655, "o", "            bh = tl.load(BHp)\r\n\u001b[?2004l\r"]
[1567.087681, "o", "\u001b[?2004h> "]
[1567.087723, "o", "            bl = tl.load(BLp)\r\n\u001b[?2004l\r"]
[1567.087753, "o", "\u001b[?2004h> "]
[1567.08782, "o", "            abf = tl.inline_asm_elementwise(\r\n\u001b[?2004l\r"]
[1567.087845, "o", "\u001b[?2004h> "]
