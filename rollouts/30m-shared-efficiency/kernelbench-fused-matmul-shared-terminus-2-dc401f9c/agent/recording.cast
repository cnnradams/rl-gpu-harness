[1156.443753, "o", "\u001b[?2004h> "]
[1156.443786, "o", "            return\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1156.443859, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[1156.443892, "o", "\u001b[?2004h> "]
[1156.444007, "o", "        W = self.matmul.weight.detach().to(device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1156.444041, "o", "\u001b[?2004h> "]
[1156.44415, "o", "        b = self.matmul.bias.detach().to(device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1156.444166, "o", "\u001b[?2004h> "]
[1156.444233, "o", "        Wt = (W * s).t().contiguous()\r\n\u001b[?2004l\r"]
[1156.444267, "o", "\u001b[?2004h> "]
[1156.444309, "o", "        hi = Wt.to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[1156.444343, "o", "\u001b[?2004h> "]
[1156.444426, "o", "        lo = (Wt - hi.to(torch.float32)).to(torch.bfloat16)\r\n\u001b[?2004l\r"]
[1156.444462, "o", "\u001b[?2004h> "]
[1156.444489, "o", "        self._w_hi = hi\r\n\u001b[?2004l\r\u001b[?2004h"]
[1156.444523, "o", "> "]
[1156.444544, "o", "        self._w_lo = lo\r\n\u001b[?2004l\r"]
[1156.444571, "o", "\u001b[?2004h> "]
[1156.444634, "o", "        self._bias = (b * s).contiguous()\r\n\u001b[?2004l\r"]
[1156.444665, "o", "\u001b[?2004h> "]
[1156.444703, "o", "        self._w_fb = W * s\r\n\u001b[?2004l\r"]
[1156.444734, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1156.444767, "o", "> "]
[1156.444801, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1156.444865, "o", "        self._prepare(x.device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1156.444898, "o", "> "]
[1156.444986, "o", "        if _HAS_TRITON and x.is_cuda and (x.shape[1] % 64 == 0):\r\n\u001b[?2004l\r"]
[1156.44502, "o", "\u001b[?2004h> "]
[1156.445148, "o", "            return _split_linear(x.contiguous(), self._w_hi, self._w_lo, self._bias)\r\n\u001b[?2004l\r"]
[1156.445181, "o", "\u001b[?2004h> "]
[1156.445286, "o", "        return torch.nn.functional.linear(x, self._w_fb, self._bias)\r\n\u001b[?2004l\r"]
[1156.445319, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1156.44672, "o", "\u001b[?2004hroot@modal:/# "]
