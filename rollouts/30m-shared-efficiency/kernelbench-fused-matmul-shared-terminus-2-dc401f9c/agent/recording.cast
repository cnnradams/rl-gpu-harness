[654.057528, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef k_presplit(AH, AL, BH, BL, BIAS, C, M, N, K,\n               sam, sak, sbk, sbn, scm, scn,\n               BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP * num_pid_n\n    gid = pid // npg\n    fpm = gid * GROUP\n    gsm = min(num_pid_m - fpm, GROUP)\n    pid_m = fpm + ((pid % npg) % gsm)\n    pid_n = (pid % npg) // gsm\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    AHp = AH + rm[:, None] * sam + rk[None, :] * sak\n    ALp = AL + rm[:, None] * sam + rk[None, :] * sak\n    BHp = BH + rk[:, None] * sbk + rn[None, :] * sbn\n    BLp = BL + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        ah = tl.load(AHp)\n        al = tl.load(ALp)\n        bh = tl.load(BHp)\n  "]
[654.057586, "i", "      bl = tl.load(BLp)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        AHp += BK * sak; ALp += BK * sak; BHp += BK * sbk; BLp += BK * sbk\n    bias = tl.load(BIAS + rn)\n    acc = acc + bias[None, :]\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nW = (torch.rand(N, K, device='cuda') - 0.5) * 0.03\nWt = (W * 1.5).t().contiguous()\nwh = Wt.to(torch.bfloat16); wl = (Wt - wh.float()).to(torch.bfloat16)\nxh = x.to(torch.bfloat16); xl = (x - xh.float()).to(torch.bfloat16)\nb = torch.rand(N, device='cuda') * 1.5\nref = torch.nn.functional.linear(x, W*1.5, b)\n\ndef runp(BM,BN,BK,G,w,s):\n    out = torch.empty((M, N), device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    k_presplit[grid](xh, xl, wh, wl, b, out, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_"]
[654.057695, "i", "warps=w, num_stages=s)\n    return out\n\ncache = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\nfor cfg in [(128,128,32,8,8,3),(128,128,32,8,8,4),(128,256,32,8,8,3)]:\n    BM,BN,BK,G,w,s = cfg\n    o = runp(BM,BN,BK,G,w,s)\n    err = (o-ref).abs().max().item()\n    for _ in range(3): runp(BM,BN,BK,G,w,s)\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(10):\n        cache.zero_(); torch.cuda.synchronize()\n        st, en = torch.cuda.Event(True), torch.cuda.Event(True)\n        st.record(); runp(BM,BN,BK,G,w,s); en.record(); torch.cuda.synchronize()\n        ts.append(st.elapsed_time(en))\n    ts = sorted(ts)[1:]\n    print(f\"presplit BM{BM} BN{BN} BK{BK} w{w} s{s}: {sum(ts)/len(ts):.3f} ms err {err:.2e}\")\nEOF\nB64=$(base64 -w0 /workspace/bench2.py) && gpu exec sb-Ee0YD4gATEv6sdRfhskPnn -- bash -c \"echo $B64 | base64 -d > /workspace/bench2.py && python3 /workspace/bench2.py 2>&1 | tail -5\"\n"]
