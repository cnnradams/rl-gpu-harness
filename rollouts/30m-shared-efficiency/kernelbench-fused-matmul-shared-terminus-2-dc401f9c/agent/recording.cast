[1736.446231, "i", "cat > /workspace/stress_conv.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport importlib.util\nspec = importlib.util.spec_from_file_location('sol454', '/workspace/solution_bf16x3_454.py')\nsol = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(sol)\nModelNew = sol.ModelNew\n\nbad = 0\nfor seed in range(60):\n    torch.manual_seed(seed)\n    m = ModelNew(4096, 4096, 0.5).cuda()\n    torch.manual_seed(1000 + seed)\n    x = torch.rand(16384, 4096, device='cuda')\n    out = m(x)\n    ref = 1.5 * torch.nn.functional.linear(x, m.matmul.weight.detach(), m.matmul.bias.detach())\n    d = (out - ref).abs()\n    thr = 1e-4 + 1e-4 * ref.abs()\n    v = (d > thr).sum().item()\n    if v > 0:\n        bad += 1\n        print(f\"seed {seed}: VIOL {v} max {d.max().item():.4e}\")\nprint(\"done bad:\", bad)\nEOF\nB64=$(base64 -w0 /workspace/stress_conv.py) && gpu exec sb-Ee0YD4gATEv6sdRfhskPnn -- bash -c \"echo $B64 | base64 -d > /workspace/stress_conv.py && python3 /workspace/stress_conv.py 2>&1 | tail -8 && python3 /wor"]
[1736.446273, "i", "kspace/stress.py 2>&1 | tail -3\"\n"]
