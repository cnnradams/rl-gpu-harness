[33.819128, "o", "\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K799\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                # in torchbench, they use both precisions for \u001b[01;31m\u001b[Katol\u001b[m\u001b[K and \u001b[01;31m\u001b[Krtol\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K800\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                # kernelbench v0 and v0.1 uses fp32, \u001b[01;31m\u001b[Katol\u001b[m\u001b[K = \u001b[01;31m\u001b[Krtol\u001b[m\u001b[K = 1e-02\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K804\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                if not torch.\u001b[01;31m\u001b[Kallclose\u001b[m\u001b[K(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/eval.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K805\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                    output, output_new, \u001b[01;31m\u001b[Katol\u001b[m\u001b[K=tolerance, \u001b[01;31m\u001b[Krtol\u001b[m\u001b[K=tolerance\r\n"]
[33.819343, "o", "\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K201\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_cuda_event(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K284\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_do_bench_interface(\r\n"]
[33.819395, "o", "\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K333\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_do_bench_impl(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K433\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef time_execution\u001b[m\u001b[K_with_host_time(\r\n"]
