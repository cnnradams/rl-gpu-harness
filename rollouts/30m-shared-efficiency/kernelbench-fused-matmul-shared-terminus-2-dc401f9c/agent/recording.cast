[292.581707, "o", "cfgs = [(128,128,64,8,8,3),(128,128,64,8,8,2),(128,128,32,8,8,4),(128,128,32,8,8,5),(128,256,32,8,8,3),(256,128,32,8,8,3),(128,256,32,8,8,4),(64,128,64,8,4,4),(128,64,64,8,4,4),(256,128,64,8,8,2),(128,256,64,8,8,2),(64,256,64,8,8,3),(256,64,32,8,4,4)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
