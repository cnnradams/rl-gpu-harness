[?2004la'); bv = torch.rand(N, device='cuda')
nb = N // 16384
M = torch.empty(B*nb, device='cuda'); R = torch.empty(B*nb, device='cuda')
grid = (B*nb,)
print(f"pass1 only: {timeit(lambda: pass1[grid](x, M, R, N, eps, BLOCK=16384, NB=nb, num_warps=16)):.1f}us")
print(f"pass2 only fwd: {timeit(lambda: pass2[grid](y, x, M, R, w, bv, N, REV=False, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)):.1f}us")
print(f"pass2 only rev: {timeit(lambda: pass2[grid](y, x, M, R, w, bv, N, REV=True, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)):.1f}us")

def both(rev):
    pass1[grid](x, M, R, N, eps, BLOCK=16384, NB=nb, num_warps=16)
    pass2[grid](y, x, M, R, w, bv, N, REV=rev, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)
print(f"both fwd: {timeit(lambda: both(False)):.1f}us")
print(f"both rev: {timeit(lambda: both(True)):.1f}us")
for blk, wp in ((8192,8),(32768,32)):
    nb2 = N // blk; g2 = (B*nb2,)
    def b2():
        pass1[g2](x, M, R, N, eps, BLOCK=blk, NB=nb2, num_warps=wp)
        pass2[g2](y, x, M, R, w, bv, N, REV=True, BLOCK=blk, NB=nb2, NBP2=nb2, num_warps=wp)
    print(f"both rev blk={blk} w={wp}: {timeit(b2):.1f}us")
