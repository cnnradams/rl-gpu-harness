[161.454456, "o", "    b = tl.load(Bv + seg * (stride_row // NB) + tl.arange(0, 16384 // 16) * 0 + tl.arange(0, 16384 // 16) * 0)  # placeholder\r\n\u001b[?2004l\r\u001b[?2004h"]
