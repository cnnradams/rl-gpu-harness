[273.669383, "o", "            self.graphs[key] = (g, out)\r\n\u001b[?2004l\r"]
[273.669405, "o", "\u001b[?2004h> "]
[273.669446, "o", "            ent = (g, out)\r\n\u001b[?2004l\r"]
[273.66946, "o", "\u001b[?2004h"]
[273.669472, "o", "> "]
[273.669499, "o", "        g, out = ent\r\n\u001b[?2004l\r"]
[273.669513, "o", "\u001b[?2004h"]
[273.669534, "o", "> "]
[273.669554, "o", "        g.replay()\r\n\u001b[?2004l\r"]
[273.669575, "o", "\u001b[?2004h> "]
[273.669598, "o", "        return out\r\n\u001b[?2004l\r"]
[273.669615, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.669634, "o", "\u001b[?2004h> "]
[273.669687, "o", "def timeit(fn, x, trials=20):\r\n\u001b[?2004l\r"]
[273.6697, "o", "\u001b[?2004h"]
[273.669715, "o", "> "]
[273.669905, "o", "    ts = time_execution_with_cuda_event(fn, [x], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\r\n\u001b[?2004l\r"]
[273.669917, "o", "\u001b[?2004h> "]
[273.669955, "o", "    ts = sorted(ts)\r\n\u001b[?2004l\r"]
[273.669968, "o", "\u001b[?2004h> "]
[273.670043, "o", "    return sum(ts)/len(ts), ts[0], ts[-1]\r\n\u001b[?2004l\r"]
[273.670055, "o", "\u001b[?2004h> "]
[273.670074, "o", "\r\n\u001b[?2004l\r"]
[273.670094, "o", "\u001b[?2004h> "]
[273.670112, "o", "def main():\r\n\u001b[?2004l\r"]
[273.670134, "o", "\u001b[?2004h> "]
[273.670167, "o", "    torch.cuda.init()\r\n\u001b[?2004l\r"]
[273.670181, "o", "\u001b[?2004h> "]
[273.6703, "o", "    x = torch.rand(B,F,D1,D2, device=dev if (dev:='cuda') else 'cuda')\r\n\u001b[?2004l\r"]
[273.670316, "o", "\u001b[?2004h> "]
[273.67038, "o", "    ref = nn.LayerNorm(SHAPE).cuda()\r\n\u001b[?2004l\r"]
[273.670402, "o", "\u001b[?2004h> "]
[273.670442, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r"]
[273.670464, "o", "\u001b[?2004h> "]
[273.670497, "o", "        ref.ln = None\r\n\u001b[?2004l\r"]
[273.670511, "o", "\u001b[?2004h> "]
[273.670576, "o", "    refm = nn.LayerNorm(SHAPE).cuda()\r\n\u001b[?2004l\r"]
[273.670586, "o", "\u001b[?2004h"]
[273.670597, "o", "> "]
[273.670627, "o", "    yref = refm(x)\r\n\u001b[?2004l\r"]
[273.670642, "o", "\u001b[?2004h> "]
[273.670702, "o", "    mean, mn, mx = timeit(refm, x)\r\n\u001b[?2004l\r"]
[273.670719, "o", "\u001b[?2004h> "]
[273.670852, "o", "    print(f\"eager LN: mean={mean*1000:.1f}us min={mn*1000:.1f} max={mx*1000:.1f}\")\r\n\u001b[?2004l\r"]
[273.670867, "o", "\u001b[?2004h"]
[273.67089, "o", "> "]
[273.670927, "o", "    for scratch in (True, False):\r\n\u001b[?2004l\r"]
[273.670942, "o", "\u001b[?2004h> "]
[273.67107, "o", "        for block, warps in ((8192,8),(16384,16),(16384,32),(32768,32)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.671085, "o", "> "]
[273.671184, "o", "            m = TritonLN(SHAPE, block, warps, scratch).cuda()\r\n\u001b[?2004l\r"]
[273.671197, "o", "\u001b[?2004h"]
[273.671214, "o", "> "]
[273.671235, "o", "            y = m(x)\r\n\u001b[?2004l\r"]
[273.671256, "o", "\u001b[?2004h> "]
[273.67133, "o", "            md = (y - yref).abs().max().item()\r\n\u001b[?2004l\r"]
[273.671351, "o", "\u001b[?2004h> "]
[273.671413, "o", "            mean, mn, mx = timeit(m, x)\r\n\u001b[?2004l\r"]
[273.671426, "o", "\u001b[?2004h> "]
[273.671716, "o", "            print(f\"triton scratch={scratch} block={block} warps={warps}: mean={mean*1000:.1f}us min={mn*1000:.1f} max={mx*1000:.1f} maxdiff={md:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.671772, "o", "    for scratch in (True, False):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.67186, "o", "        m = GraphLN(SHAPE, 16384, 16, scratch).cuda()\r\n\u001b[?2004l\r"]
[273.671884, "o", "\u001b[?2004h> "]
[273.67191, "o", "        y = m(x)\r\n\u001b[?2004l\r"]
[273.671925, "o", "\u001b[?2004h> "]
[273.671987, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[273.672005, "o", "\u001b[?2004h"]
[273.672021, "o", "> "]
[273.672036, "o", "        y = m(x)\r\n\u001b[?2004l\r"]
[273.672048, "o", "\u001b[?2004h"]
[273.672072, "o", "> "]
[273.672135, "o", "        md = (y - yref).abs().max().item()\r\n\u001b[?2004l\r"]
[273.672148, "o", "\u001b[?2004h> "]
[273.67221, "o", "        mean, mn, mx = timeit(m, x)\r\n\u001b[?2004l\r"]
[273.672223, "o", "\u001b[?2004h> "]
[273.672426, "o", "        print(f\"graph scratch={scratch}: mean={mean*1000:.1f}us min={mn*1000:.1f} max={mx*1000:.1f} maxdiff={md:.2e}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.672435, "o", "> "]
[273.672451, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.672466, "o", "> "]
[273.672507, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[273.672519, "o", "\u001b[?2004h> "]
[273.672547, "o", "    main()\r\n\u001b[?2004l\r"]
[273.67256, "o", "\u001b[?2004h"]
[273.672572, "o", "> EOF\r\n\u001b[?2004l\r"]
