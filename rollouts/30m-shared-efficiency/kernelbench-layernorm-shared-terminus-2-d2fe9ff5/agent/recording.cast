[362.295135, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_pass1(X, M, R, n_row, eps, BLOCK: tl.constexpr, NB: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % NB\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + row * n_row + off)\n    mu = tl.sum(x) / BLOCK\n    var = tl.sum(x * x) / BLOCK - mu * mu\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(M + pid, mu)\n    tl.store(R + pid, rstd)\n\n\n@triton.jit\ndef _ln_pass2(Y, X, M, R, W, Bv, n_row, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % NB\n    offs = tl.arange(0, NBP2)\n    m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\n    r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\n    mu = tl.sum(m) / NB\n    var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\n    rstd = 1.0 / tl.sqrt(var)\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    w = tl.load(W + "]
[362.295285, "i", "off)\n    b = tl.load(Bv + off)\n    x = tl.load(X + row * n_row + off)\n    y = (x - mu) * rstd * w + b\n    tl.store(Y + row * n_row + off, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.n_row = 1\n        for s in normalized_shape:\n            self.n_row *= s\n        self.block = 16384\n        if self.n_row % self.block != 0:\n            self.block = 4096\n        self.nb = self.n_row // self.block\n        self._stats = {}\n\n    def _get_stats(self, rows, device):\n        key = (rows, device)\n        buf = self._stats.get(key)\n        if buf is None:\n            M = torch.empty(rows * self.nb, device=device, dtype=torch.float32)\n            R = torch.empty(rows * self.nb, device=device, dtype=torch.float32)\n            buf = (M, R)\n            self._stats[key] = buf\n        return buf\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not x.is_contiguous():\n "]
[362.295313, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[362.295338, "i", "           x = x.contiguous()\n        n_row = self.n_row\n        rows = x.numel() // n_row\n        y = torch.empty_like(x)\n        nb = self.nb\n        M, R = self._get_stats(rows, x.device)\n        eps = self.ln.eps\n        _ln_pass1[(rows * nb,)](x, M, R, n_row, eps, BLOCK=self.block, NB=nb, num_warps=16)\n        _ln_pass2[(rows * nb,)](y, x, M, R, self.ln.weight, self.ln.bias, n_row, BLOCK=self.block, NB=nb, NBP2=nb, num_warps=16)\n        return y\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/solution.py').read()); print('ok')\"\n"]
