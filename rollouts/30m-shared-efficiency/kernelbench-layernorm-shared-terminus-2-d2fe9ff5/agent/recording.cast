[616.65287, "o", "\u001b[?2004h> "]
[616.653025, "o", "from kernelbench.timing import time_execution_with_cuda_event as te\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.653061, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.653097, "o", "B,F,D1,D2 = 16,64,256,256\r\n\u001b[?2004l\r"]
[616.653132, "o", "\u001b[?2004h> "]
[616.653168, "o", "SHAPE=(F,D1,D2); N=F*D1*D2\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.653201, "o", "> eps=1e-5\r\n\u001b[?2004l\r"]
[616.653234, "o", "\u001b[?2004h> "]
