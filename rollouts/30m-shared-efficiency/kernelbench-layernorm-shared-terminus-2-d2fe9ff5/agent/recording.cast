[616.65211, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, torch.nn as nn, triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event as te\n\nB,F,D1,D2 = 16,64,256,256\nSHAPE=(F,D1,D2); N=F*D1*D2\neps=1e-5\nx = torch.rand(B,F,D1,D2, device='cuda')\ny = torch.empty_like(x)\n\ndef timeit(fn, trials=20):\n    ts = te(fn, [], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\n    return sum(ts)/len(ts)*1000\n\nprint(f\"torch copy_: {timeit(lambda: y.copy_(x)):.1f}us\")\n\n@triton.jit\ndef copyk(Y, X, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + off, tl.load(X + off))\n\ntotal = x.numel()\nfor blk, wp in ((4096,4),(8192,8),(16384,16)):\n    g = (total // blk,)\n    print(f\"triton copy blk={blk} w={wp}: {timeit(lambda: copyk[g](y, x, total, BLOCK=blk, num_warps=wp)):.1f}us\")\n\n@triton.jit\ndef pass1(X, M, R, n_row, eps, BLOCK: tl.constexpr, NB: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % N"]
[616.652159, "i", "B\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + row * n_row + off)\n    mu = tl.sum(xx) / BLOCK\n    var = tl.sum(xx * xx) / BLOCK - mu * mu\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(M + pid, mu)\n    tl.store(R + pid, rstd)\n\n@triton.jit\ndef pass2(Y, X, M, R, W, Bv, n_row, REV: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % NB\n    if REV:\n        row = tl.num_programs(0) // NB - 1 - row\n        seg = NB - 1 - seg\n    offs = tl.arange(0, NBP2)\n    m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\n    r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\n    mu = tl.sum(m) / NB\n    var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\n    rstd = 1.0 / tl.sqrt(var)\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    w = tl.load(W + off)\n    b = tl.load(Bv + off)\n    xx = tl.load(X + row * n_row + off)\n    tl.store(Y + row * n_row + off, (xx - mu) * rstd * w + b)\n\nw = torch.rand(N, device='cud"]
[616.652273, "i", "a'); bv = torch.rand(N, device='cuda')\nnb = N // 16384\nM = torch.empty(B*nb, device='cuda'); R = torch.empty(B*nb, device='cuda')\ngrid = (B*nb,)\nprint(f\"pass1 only: {timeit(lambda: pass1[grid](x, M, R, N, eps, BLOCK=16384, NB=nb, num_warps=16)):.1f}us\")\nprint(f\"pass2 only fwd: {timeit(lambda: pass2[grid](y, x, M, R, w, bv, N, REV=False, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)):.1f}us\")\nprint(f\"pass2 only rev: {timeit(lambda: pass2[grid](y, x, M, R, w, bv, N, REV=True, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)):.1f}us\")\n\ndef both(rev):\n    pass1[grid](x, M, R, N, eps, BLOCK=16384, NB=nb, num_warps=16)\n    pass2[grid](y, x, M, R, w, bv, N, REV=rev, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)\nprint(f\"both fwd: {timeit(lambda: both(False)):.1f}us\")\nprint(f\"both rev: {timeit(lambda: both(True)):.1f}us\")\nfor blk, wp in ((8192,8),(32768,32)):\n    nb2 = N // blk; g2 = (B*nb2,)\n    def b2():\n        pass1[g2](x, M, R, N, eps, BLOCK=blk, NB=nb2, num_warps=wp)\n        pass2[g2](y, x, M, R, w, bv, N, REV=True, BLOCK=b"]
