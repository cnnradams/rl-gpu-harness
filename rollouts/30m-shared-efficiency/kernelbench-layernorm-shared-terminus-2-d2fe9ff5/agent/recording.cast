[811.577421, "o", "> \r\n\u001b[?2004l\r"]
[811.577457, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.577482, "o", "> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.577508, "o", "> "]
[811.577622, "o", "def _ln_pass1(X, M, R, n_row, eps, BLOCK: tl.constexpr, NB: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.57768, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.577727, "o", ">     row = pid // NB\r\n\u001b[?2004l\r"]
[811.577758, "o", "\u001b[?2004h> "]
[811.577791, "o", "    seg = pid % NB\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.577821, "o", "> "]
[811.577873, "o", "    off = seg * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[811.577905, "o", "\u001b[?2004h> "]
[811.577956, "o", "    x = tl.load(X + row * n_row + off)\r\n\u001b[?2004l\r"]
[811.577987, "o", "\u001b[?2004h> "]
[811.578018, "o", "    mu = tl.sum(x) / BLOCK\r\n\u001b[?2004l\r"]
[811.578049, "o", "\u001b[?2004h> "]
[811.578107, "o", "    var = tl.sum(x * x) / BLOCK - mu * mu\r\n\u001b[?2004l\r"]
[811.57814, "o", "\u001b[?2004h> "]
[811.579196, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(M + pid, mu)\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(R + pid, rstd)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def _ln_pass2(Y, X, M, R, W, Bv, n_row, TRIVIAL: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     row = pid // NB\r\n\u001b[?2004l\r\u001b[?2004h>     seg = pid % NB\r\n\u001b[?2004l\r\u001b[?2004h>     offs = tl.arange(0, NBP2)\r\n\u001b[?2004l\r\u001b[?2004h>     m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h>     r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\r\n\u001b[?2004l\r\u001b[?2004h>     mu = tl.sum(m) / NB\r\n\u001b[?2004l\r\u001b[?2004h>     var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.579234, "o", "    rstd = 1.0 / tl.sqrt(var)\r\n\u001b[?2004l\r"]
[811.579261, "o", "\u001b[?2004h> "]
[811.579304, "o", "    off = seg * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.579338, "o", "> "]
[811.579379, "o", "    x = tl.load(X + row * n_row + off)\r\n\u001b[?2004l\r"]
[811.57941, "o", "\u001b[?2004h> "]
[811.579438, "o", "    if TRIVIAL:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.57949, "o", "        y = (x - mu) * rstd\r\n\u001b[?2004l\r"]
[811.579519, "o", "\u001b[?2004h> "]
[811.579549, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.579591, "o", "        w = tl.load(W + off)\r\n\u001b[?2004l\r"]
[811.579621, "o", "\u001b[?2004h> "]
[811.579659, "o", "        b = tl.load(Bv + off)\r\n\u001b[?2004l\r"]
[811.57969, "o", "\u001b[?2004h> "]
[811.579737, "o", "        y = (x - mu) * rstd * w + b\r\n\u001b[?2004l\r"]
[811.579767, "o", "\u001b[?2004h> "]
[811.579819, "o", "    tl.store(Y + row * n_row + off, y)\r\n\u001b[?2004l\r"]
[811.579854, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.579882, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.579923, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[811.579952, "o", "\u001b[?2004h> "]
[811.580015, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[811.580047, "o", "\u001b[?2004h> "]
[811.580078, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[811.580109, "o", "\u001b[?2004h> "]
[811.580213, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.580247, "o", "> "]
[811.580278, "o", "        self.n_row = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.580331, "o", "        for s in normalized_shape:\r\n\u001b[?2004l\r"]
[811.580362, "o", "\u001b[?2004h> "]
[811.580393, "o", "            self.n_row *= s\r\n\u001b[?2004l\r"]
[811.580424, "o", "\u001b[?2004h> "]
[811.580454, "o", "        self.block = 16384\r\n\u001b[?2004l\r"]
[811.580484, "o", "\u001b[?2004h> "]
[811.580544, "o", "        if self.n_row % self.block != 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.580573, "o", "> "]
[811.580608, "o", "            self.block = 4096\r\n\u001b[?2004l\r"]
[811.580645, "o", "\u001b[?2004h> "]
[811.580694, "o", "        self.nb = self.n_row // self.block\r\n\u001b[?2004l\r"]
[811.580725, "o", "\u001b[?2004h> "]
[811.580756, "o", "        self._stats = {}\r\n\u001b[?2004l\r"]
[811.580787, "o", "\u001b[?2004h> "]
[811.580821, "o", "        self._trivial = None\r\n\u001b[?2004l\r"]
[811.580849, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.58088, "o", "> "]
[811.580925, "o", "    def _get_stats(self, rows, device):\r\n\u001b[?2004l\r"]
[811.58097, "o", "\u001b[?2004h> "]
[811.581023, "o", "        key = (rows, device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.581077, "o", "        buf = self._stats.get(key)\r\n\u001b[?2004l\r"]
[811.581101, "o", "\u001b[?2004h> "]
[811.581125, "o", "        if buf is None:\r\n\u001b[?2004l\r"]
[811.581149, "o", "\u001b[?2004h> "]
[811.581288, "o", "            M = torch.empty(rows * self.nb, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.581428, "o", "            R = torch.empty(rows * self.nb, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.581464, "o", "> "]
[811.581492, "o", "            buf = (M, R)\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.581523, "o", "> "]
[811.581554, "o", "            self._stats[key] = buf\r\n\u001b[?2004l\r"]
[811.581585, "o", "\u001b[?2004h> "]
[811.581616, "o", "        return buf\r\n\u001b[?2004l\r"]
[811.581647, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.581699, "o", "    def _check_trivial(self):\r\n\u001b[?2004l\r"]
[811.58173, "o", "\u001b[?2004h> "]
[811.581758, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r"]
[811.581789, "o", "\u001b[?2004h> "]
[811.58182, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.581851, "o", "> "]
[811.581959, "o", "        triv = bool((w == 1.0).all().item()) and bool((b == 0.0).all().item())\r\n\u001b[?2004l\r"]
[811.581989, "o", "\u001b[?2004h> "]
[811.582021, "o", "        self._trivial = triv\r\n\u001b[?2004l\r"]
[811.582052, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.582083, "o", "> "]
[811.582152, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[811.582182, "o", "\u001b[?2004h> "]
[811.582229, "o", "        if self._trivial is None:\r\n\u001b[?2004l\r"]
[811.582261, "o", "\u001b[?2004h> "]
[811.5823, "o", "            self._check_trivial()\r\n\u001b[?2004l\r"]
[811.582331, "o", "\u001b[?2004h> "]
[811.582372, "o", "        if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[811.582403, "o", "\u001b[?2004h> "]
[811.582439, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r"]
[811.582471, "o", "\u001b[?2004h> "]
[811.582502, "o", "        n_row = self.n_row\r\n\u001b[?2004l\r"]
[811.582534, "o", "\u001b[?2004h> "]
[811.582574, "o", "        rows = x.numel() // n_row\r\n\u001b[?2004l\r"]
[811.5826, "o", "\u001b[?2004h> "]
[811.582648, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[811.582677, "o", "\u001b[?2004h> "]
[811.582709, "o", "        nb = self.nb\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.58274, "o", "> "]
[811.582796, "o", "        M, R = self._get_stats(rows, x.device)\r\n\u001b[?2004l\r"]
[811.582826, "o", "\u001b[?2004h> "]
[811.582854, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r"]
[811.582885, "o", "\u001b[?2004h> "]
[811.583023, "o", "        _ln_pass1[(rows * nb,)](x, M, R, n_row, eps, BLOCK=self.block, NB=nb, num_warps=16)\r\n\u001b[?2004l\r"]
[811.583054, "o", "\u001b[?2004h> "]
[811.583295, "o", "        _ln_pass2[(rows * nb,)](y, x, M, R, self.ln.weight, self.ln.bias, n_row, TRIVIAL=self._trivial, BLOCK=self.block, NB=nb, NBP2=nb, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.583332, "o", "> "]
[811.583363, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[811.586029, "o", "\u001b[?2004hroot@modal:/# "]
