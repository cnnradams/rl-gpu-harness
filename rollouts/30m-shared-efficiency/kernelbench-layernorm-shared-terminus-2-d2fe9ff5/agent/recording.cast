[362.295478, "o", " * nb,)](x, M, R, n_row, eps, BLOCK=self.block, NB=nb, num_warps=16)\r\n        _ln_pass2[(rows * nb,)](y, x, M, R, self.ln.weig"]
[362.295496, "o", "ht, self.ln.bias, n_row, BLOCK=se"]
