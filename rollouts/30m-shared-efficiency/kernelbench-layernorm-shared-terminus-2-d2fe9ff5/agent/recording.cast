[616.652305, "i", "lk, NB=nb2, NBP2=nb2, num_warps=wp)\n    print(f\"both rev blk={blk} w={wp}: {timeit(b2):.1f}us\")\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/bench2.py').read()); print('ok')\"\n"]
