[161.453833, "o", "    m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\r\n\u001b[?2004l\r"]
[161.45386, "o", "\u001b[?2004h> "]
[161.453955, "o", "    r = tl.load(R + row * NB + offs, mask=offs < NB, other=0.0)\r\n\u001b[?2004l\r"]
[161.453986, "o", "\u001b[?2004h> "]
[161.454027, "o", "    mean = tl.sum(m, axis=0) / NB\r\n\u001b[?2004l\r"]
[161.454051, "o", "\u001b[?2004h> "]
