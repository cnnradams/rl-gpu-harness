[161.453539, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[161.453565, "o", "\u001b[?2004h> "]
[161.453615, "o", "    row = pid // NB\r\n\u001b[?2004l\r\u001b[?2004h> "]
[161.453645, "o", "    seg = pid % NB\r\n\u001b[?2004l\r"]
[161.45367, "o", "\u001b[?2004h> "]
