[273.659943, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, torch.nn as nn, torch.nn.functional as F, triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event\n\nB,F,D1,D2 = 16,64,256,256\nSHAPE=(F,D1,D2); N=F*D1*D2\neps=1e-5\n\n@triton.jit\ndef pass1(X, M, R, YS, W, n_row, eps, BLOCK: tl.constexpr, NB: tl.constexpr, APPLY_W: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % NB\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + row * n_row + off)\n    mu = tl.sum(x) / BLOCK\n    var = tl.sum(x * x) / BLOCK - mu * mu\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(M + pid, mu)\n    tl.store(R + pid, rstd)\n    if APPLY_W:\n        w = tl.load(W + off)\n        tl.store(YS + row * n_row + off, (x - mu) * rstd * w)\n\n@triton.jit\ndef pass2(Y, X, YS, M, R, W, Bv, n_row, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr, USE_SCRATCH: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % NB\n    offs = tl.arange(0, NBP2)\n    m = tl.lo"]
[273.659996, "i", "ad(M + row * NB + offs, mask=offs < NB, other=0.0)\n    r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\n    mu = tl.sum(m) / NB\n    var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\n    rstd = 1.0 / tl.sqrt(var)\n    c = tl.sum(tl.where(offs == seg, rstd / r, 0.0))\n    ms = tl.sum(tl.where(offs == seg, m, 0.0))\n    d = (ms - mu) * rstd\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    w = tl.load(W + off)\n    b = tl.load(Bv + off)\n    if USE_SCRATCH:\n        yp = tl.load(YS + row * n_row + off)\n        y = yp * c + d * w + b\n    else:\n        x = tl.load(X + row * n_row + off)\n        y = (x - mu) * rstd * w + b\n    tl.store(Y + row * n_row + off, y)\n\nclass TritonLN(nn.Module):\n    def __init__(self, shape, block=16384, warps=16, scratch=True):\n        super().__init__()\n        self.ln = nn.LayerNorm(shape)\n        self.block = block; self.warps = warps; self.scratch = scratch\n        self.n_row = N; self.nb = N // block\n    def forward(self, x):\n        x = x.contiguous()\n        y = torch.empty_li"]
[273.660007, "i", "ke(x)\n        nb = self.nb\n        M = torch.empty(B * nb, device=x.device, dtype=torch.float32)\n        R = torch.empty_like(M)\n        if self.scratch:\n            YS = torch.empty_like(x)\n            pass1[(B * nb,)](x, M, R, YS, self.ln.weight, self.n_row, eps, BLOCK=self.block, NB=nb, APPLY_W=True, num_warps=self.warps)\n            pass2[(B * nb,)](y, x, YS, M, R, self.ln.weight, self.ln.bias, self.n_row, BLOCK=self.block, NB=nb, NBP2=nb, USE_SCRATCH=True, num_warps=self.warps)\n        else:\n            pass1[(B * nb,)](x, M, R, x, self.ln.weight, self.n_row, eps, BLOCK=self.block, NB=nb, APPLY_W=False, num_warps=self.warps)\n            pass2[(B * nb,)](y, x, x, M, R, self.ln.weight, self.ln.bias, self.n_row, BLOCK=self.block, NB=nb, NBP2=nb, USE_SCRATCH=False, num_warps=self.warps)\n        return y\n\nclass GraphLN(nn.Module):\n    def __init__(self, shape, block=16384, warps=16, scratch=True):\n        super().__init__()\n        self.inner = TritonLN(shape, block, warps, scratch)\n        self.ln = self.inn"]
[273.660013, "i", "er.ln\n        self.graphs = {}\n    def forward(self, x):\n        key = (x.data_ptr(), tuple(x.shape))\n        ent = self.graphs.get(key)\n        if ent is None:\n            s = torch.cuda.Stream()\n            s.wait_stream(torch.cuda.current_stream())\n            with torch.cuda.stream(s):\n                self.inner(x)\n            torch.cuda.current_stream().wait_stream(s)\n            g = torch.cuda.CUDAGraph()\n            with torch.cuda.graph(g):\n                out = self.inner(x)\n            self.graphs[key] = (g, out)\n            ent = (g, out)\n        g, out = ent\n        g.replay()\n        return out\n\ndef timeit(fn, x, trials=20):\n    ts = time_execution_with_cuda_event(fn, [x], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\n    ts = sorted(ts)\n    return sum(ts)/len(ts), ts[0], ts[-1]\n\ndef main():\n    torch.cuda.init()\n    x = torch.rand(B,F,D1,D2, device=dev if (dev:='cuda') else 'cuda')\n    ref = nn.LayerNorm(SHAPE).cuda()\n    with torch.no_grad():\n        ref.ln = None\n "]
[273.660112, "i", "   refm = nn.LayerNorm(SHAPE).cuda()\n    yref = refm(x)\n    mean, mn, mx = timeit(refm, x)\n    print(f\"eager LN: mean={mean*1000:.1f}us min={mn*1000:.1f} max={mx*1000:.1f}\")\n    for scratch in (True, False):\n        for block, warps in ((8192,8),(16384,16),(16384,32),(32768,32)):\n            m = TritonLN(SHAPE, block, warps, scratch).cuda()\n            y = m(x)\n            md = (y - yref).abs().max().item()\n            mean, mn, mx = timeit(m, x)\n            print(f\"triton scratch={scratch} block={block} warps={warps}: mean={mean*1000:.1f}us min={mn*1000:.1f} max={mx*1000:.1f} maxdiff={md:.2e}\")\n    for scratch in (True, False):\n        m = GraphLN(SHAPE, 16384, 16, scratch).cuda()\n        y = m(x)\n        torch.cuda.synchronize()\n        y = m(x)\n        md = (y - yref).abs().max().item()\n        mean, mn, mx = timeit(m, x)\n        print(f\"graph scratch={scratch}: mean={mean*1000:.1f}us min={mn*1000:.1f} max={mx*1000:.1f} maxdiff={md:.2e}\")\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 -c \"import ast; "]
[273.660227, "i", "ast.parse(open('/workspace/bench.py').read()); print('syntax ok')\"\n"]
