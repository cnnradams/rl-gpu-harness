[616.653714, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[616.653747, "o", "> "]
[616.653821, "o", "print(f\"torch copy_: {timeit(lambda: y.copy_(x)):.1f}us\")\r\n\u001b[?2004l\r"]
[616.653855, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.653881, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[616.653914, "o", "\u001b[?2004h> "]
[616.653971, "o", "def copyk(Y, X, n, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[616.653997, "o", "\u001b[?2004h> "]
[616.654042, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[616.654068, "o", "\u001b[?2004h> "]
[616.654135, "o", "    off = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[616.654169, "o", "\u001b[?2004h> "]
[616.654222, "o", "    tl.store(Y + off, tl.load(X + off))\r\n\u001b[?2004l\r"]
[616.654257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.654292, "o", "total = x.numel()\r\n\u001b[?2004l\r"]
[616.654327, "o", "\u001b[?2004h> "]
[616.65439, "o", "for blk, wp in ((4096,4),(8192,8),(16384,16)):\r\n\u001b[?2004l\r"]
[616.654423, "o", "\u001b[?2004h> "]
[616.654463, "o", "    g = (total // blk,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.654667, "o", "    print(f\"triton copy blk={blk} w={wp}: {timeit(lambda: copyk[g](y, x, total, BLOCK=blk, num_warps=wp)):.1f}us\")\r\n\u001b[?2004l\r"]
[616.654693, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[616.654731, "o", "\u001b[?2004h> "]
[616.654758, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.654862, "o", "def pass1(X, M, R, n_row, eps, BLOCK: tl.constexpr, NB: tl.constexpr):\r\n\u001b[?2004l\r"]
[616.654895, "o", "\u001b[?2004h> "]
[616.654932, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.654965, "o", "> "]
[616.654992, "o", "    row = pid // NB\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.655026, "o", ">     seg = pid % NB\r\n\u001b[?2004l\r"]
[616.655052, "o", "\u001b[?2004h> "]
[616.655126, "o", "    off = seg * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[616.655158, "o", "\u001b[?2004h> "]
[616.655212, "o", "    xx = tl.load(X + row * n_row + off)\r\n\u001b[?2004l\r"]
[616.655238, "o", "\u001b[?2004h> "]
[616.655281, "o", "    mu = tl.sum(xx) / BLOCK\r\n\u001b[?2004l\r"]
[616.655308, "o", "\u001b[?2004h> "]
[616.655373, "o", "    var = tl.sum(xx * xx) / BLOCK - mu * mu\r\n\u001b[?2004l\r"]
[616.655408, "o", "\u001b[?2004h> "]
[616.655458, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[616.655493, "o", "\u001b[?2004h> "]
[616.655537, "o", "    tl.store(M + pid, mu)\r\n\u001b[?2004l\r"]
[616.655568, "o", "\u001b[?2004h> "]
[616.655597, "o", "    tl.store(R + pid, rstd)\r\n\u001b[?2004l\r"]
[616.655627, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[616.655657, "o", "\u001b[?2004h> "]
[616.655689, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.65572, "o", "> "]
[616.655873, "o", "def pass2(Y, X, M, R, W, Bv, n_row, REV: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.655905, "o", "> "]
[616.655931, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[616.655957, "o", "\u001b[?2004h> "]
[616.655988, "o", "    row = pid // NB\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.65602, "o", "> "]
[616.656047, "o", "    seg = pid % NB\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.656079, "o", "    if REV:\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.656111, "o", "> "]
[616.656173, "o", "        row = tl.num_programs(0) // NB - 1 - row\r\n\u001b[?2004l\r"]
[616.656202, "o", "\u001b[?2004h> "]
[616.656233, "o", "        seg = NB - 1 - seg\r\n\u001b[?2004l\r"]
[616.656265, "o", "\u001b[?2004h> "]
[616.656305, "o", "    offs = tl.arange(0, NBP2)\r\n\u001b[?2004l\r"]
[616.656336, "o", "\u001b[?2004h> "]
[616.656428, "o", "    m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\r\n\u001b[?2004l\r"]
[616.656464, "o", "\u001b[?2004h> "]
[616.656554, "o", "    r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\r\n\u001b[?2004l\r"]
[616.656585, "o", "\u001b[?2004h> "]
[616.656624, "o", "    mu = tl.sum(m) / NB\r\n\u001b[?2004l\r"]
[616.656656, "o", "\u001b[?2004h> "]
[616.656731, "o", "    var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\r\n\u001b[?2004l\r"]
[616.656762, "o", "\u001b[?2004h> "]
[616.6568, "o", "    rstd = 1.0 / tl.sqrt(var)\r\n\u001b[?2004l\r"]
[616.656831, "o", "\u001b[?2004h> "]
[616.65689, "o", "    off = seg * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[616.656921, "o", "\u001b[?2004h> "]
[616.656952, "o", "    w = tl.load(W + off)\r\n\u001b[?2004l\r"]
[616.656993, "o", "\u001b[?2004h> "]
[616.657018, "o", "    b = tl.load(Bv + off)\r\n\u001b[?2004l\r"]
[616.65705, "o", "\u001b[?2004h> "]
[616.657108, "o", "    xx = tl.load(X + row * n_row + off)\r\n\u001b[?2004l\r"]
[616.657139, "o", "\u001b[?2004h> "]
[616.657227, "o", "    tl.store(Y + row * n_row + off, (xx - mu) * rstd * w + b)\r\n\u001b[?2004l\r"]
[616.657258, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[616.65729, "o", "> "]
[616.657379, "o", "w = torch.rand(N, device='cuda'); bv = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[616.657465, "o", "\u001b[?2004h> "]
[616.657506, "o", "nb = N // 16384\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.657537, "o", "> "]
[616.657639, "o", "M = torch.empty(B*nb, device='cuda'); R = torch.empty(B*nb, device='cuda')\r\n\u001b[?2004l\r"]
[616.65767, "o", "\u001b[?2004h> "]
[616.657696, "o", "grid = (B*nb,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.657879, "o", "print(f\"pass1 only: {timeit(lambda: pass1[grid](x, M, R, N, eps, BLOCK=16384, NB=nb, num_warps=16)):.1f}us\")\r\n\u001b[?2004l\r"]
[616.657914, "o", "\u001b[?2004h> "]
[616.658119, "o", "print(f\"pass2 only fwd: {timeit(lambda: pass2[grid](y, x, M, R, w, bv, N, REV=False, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)):.1f}us\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.658157, "o", "> "]
[616.658359, "o", "print(f\"pass2 only rev: {timeit(lambda: pass2[grid](y, x, M, R, w, bv, N, REV=True, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)):.1f}us\")\r\n\u001b[?2004l\r"]
[616.658391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[616.658424, "o", "> def both(rev):\r\n\u001b[?2004l\r"]
[616.658454, "o", "\u001b[?2004h> "]
[616.658564, "o", "    pass1[grid](x, M, R, N, eps, BLOCK=16384, NB=nb, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.658581, "o", "> "]
[616.658729, "o", "    pass2[grid](y, x, M, R, w, bv, N, REV=rev, BLOCK=16384, NB=nb, NBP2=nb, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.658758, "o", "> "]
[616.658837, "o", "print(f\"both fwd: {timeit(lambda: both(False)):.1f}us\")\r\n\u001b[?2004l\r"]
[616.658866, "o", "\u001b[?2004h> "]
[616.658942, "o", "print(f\"both rev: {timeit(lambda: both(True)):.1f}us\")\r\n\u001b[?2004l\r"]
[616.658974, "o", "\u001b[?2004h> "]
[616.659024, "o", "for blk, wp in ((8192,8),(32768,32)):\r\n\u001b[?2004l\r"]
[616.659055, "o", "\u001b[?2004h> "]
[616.659099, "o", "    nb2 = N // blk; g2 = (B*nb2,)\r\n\u001b[?2004l\r"]
[616.65913, "o", "\u001b[?2004h> "]
[616.659163, "o", "    def b2():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[616.659271, "o", "        pass1[g2](x, M, R, N, eps, BLOCK=blk, NB=nb2, num_warps=wp)\r\n\u001b[?2004l\r"]
[616.659302, "o", "\u001b[?2004h> "]
[616.659437, "o", "        pass2[g2](y, x, M, R, w, bv, N, REV=True, BLOCK=blk, NB=nb2, NBP2=nb2, num_warps=wp)\r\n\u001b[?2004l\r"]
[616.659469, "o", "\u001b[?2004h> "]
[616.659562, "o", "    print(f\"both rev blk={blk} w={wp}: {timeit(b2):.1f}us\")\r\n\u001b[?2004l\r"]
[616.659595, "o", "\u001b[?2004h> "]
[616.659626, "o", "EOF\r\n\u001b[?2004l\r"]
[616.666961, "o", "\u001b[?2004hroot@modal:/# "]
[616.667111, "o", "python3 -c \"import ast; ast.parse(open('/workspace/bench2.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[616.677779, "o", "ok\r\n"]
[616.679802, "o", "\u001b[?2004hroot@modal:/# "]
[618.479063, "i", "gpu push sb-0ZkvjPFSrkJAFV0aMj7yLP /workspace/bench2.py /workspace/bench2.py && gpu exec sb-0ZkvjPFSrkJAFV0aMj7yLP -- python3 /workspace/bench2.py\n"]
[618.479457, "o", "gpu push sb-0ZkvjPFSrkJAFV0aMj7yLP /workspace/bench2.py /workspace/bench2.py && gpu exec sb-0ZkvjPFSrkJAFV0aMj7yLP -- python3 /workspace/bench2.py \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Ky\r\n\u001b[?2004l\r"]
[619.89619, "o", "{\r\n  \"bytes\": 3132,\r\n  \"sha256\": \"40461010c1f3fd7c9eb718ee1d68ac5f20d2a9d1c28cdb40d7ee57223f56fddb\"\r\n}\r\n"]
[620.006058, "o", "request ID: 0ada483b61ee4c3bbe749e0358bce02b\r\n"]
[621.342549, "o", "command: dd443974ba8d43ada82031b104632f2c\r\n"]
[626.301525, "o", "[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\ntorch copy_: 181.6us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\ntriton copy blk=4096 w=4: 184.5us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\ntriton copy blk=8192 w=8: 183.9us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\ntriton copy blk=16384 w=16: 184.0us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\npass1 only: 98.4us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\npass2 only fwd: 351.3us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\npass2 only rev: 351.4us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\nboth fwd: 441.9us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\nboth rev: 439.0us\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\nboth rev blk=8192 w=8: 438.3us\r\n[Profiling] Using device:"]
[626.301587, "o", " 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\nboth rev blk=32768 w=32: 441.2us\r\n"]
[627.157277, "o", "\u001b[?2004hroot@modal:/# "]
[727.589042, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import time_execution_with_cuda_event as te\n\nB,F,D1,D2 = 16,64,256,256\nN=F*D1*D2\neps=1e-5\nx = torch.rand(B,F,D1,D2, device='cuda')\ny = torch.empty_like(x)\n\ndef timeit(fn, trials=20):\n    ts = te(fn, [], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\n    return sum(ts)/len(ts)*1000\n\n@triton.jit\ndef readk(Y, X, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLOCK + tl.arange(0, BLOCK)\n    v = tl.load(X + off)\n    s = tl.sum(v)\n    if s > 1e30:\n        tl.store(Y + pid, s)\n\n@triton.jit\ndef writek(Y, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + off, tl.zeros([BLOCK], dtype=tl.float32) + 1.0)\n\ntotal = x.numel()\ng = (total // 16384,)\nprint(f\"pure read: {timeit(lambda: readk[g](y, x, BLOCK=16384, num_warps=16)):.1f}us\")\nprint(f\"pure write: {timeit(lambda: writek[g](y, BLOCK=16384, num_warps=16)):.1f}us\")\n"]
[727.58923, "i", "\n@triton.jit\ndef pass2v(Y, X, M, R, W, Bv, n_row, TRIVIAL: tl.constexpr, CS: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NB\n    seg = pid % NB\n    offs = tl.arange(0, NBP2)\n    m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\n    r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\n    mu = tl.sum(m) / NB\n    var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\n    rstd = 1.0 / tl.sqrt(var)\n    off = seg * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + row * n_row + off)\n    if TRIVIAL:\n        yy = (xx - mu) * rstd\n    else:\n        w = tl.load(W + off)\n        b = tl.load(Bv + off)\n        yy = (xx - mu) * rstd * w + b\n    if CS:\n        tl.store(Y + row * n_row + off, yy, cache_modifier='.cs')\n    else:\n        tl.store(Y + row * n_row + off, yy)\n\nw = torch.rand(N, device='cuda'); bv = torch.rand(N, device='cuda')\nfor blk, wp in ((8192,8),(16384,16),(32768,32),(65536,32),(65536,64)):\n    nb = N // blk; gr = (B*nb,)\n"]
[727.589254, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.589301, "i", "    M = torch.empty(B*nb, device='cuda'); R = torch.empty(B*nb, device='cuda')\n    for tri in (True, False):\n        for cs in (False, True):\n            t = timeit(lambda: pass2v[gr](y, x, M, R, w, bv, N, TRIVIAL=tri, CS=cs, BLOCK=blk, NB=nb, NBP2=nb, num_warps=wp))\n            print(f\"pass2 blk={blk} w={wp} trivial={tri} cs={cs}: {t:.1f}us\")\nEOF\npython3 -c \"import ast; ast.parse(open('/workspace/bench3.py').read()); print('ok')\"\n"]
[727.589325, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[727.589348, "o", "\u001b[?2004h> "]
[727.589457, "o", "from kernelbench.timing import time_execution_with_cuda_event as te\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.589491, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.58953, "o", "B,F,D1,D2 = 16,64,256,256\r\n\u001b[?2004l\r"]
[727.589563, "o", "\u001b[?2004h> N=F*D1*D2\r\n\u001b[?2004l\r"]
[727.589593, "o", "\u001b[?2004h> eps=1e-5\r\n\u001b[?2004l\r"]
[727.589623, "o", "\u001b[?2004h> "]
[727.589679, "o", "x = torch.rand(B,F,D1,D2, device='cuda')\r\n\u001b[?2004l\r"]
[727.589713, "o", "\u001b[?2004h> "]
[727.589744, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.589773, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.589816, "o", "def timeit(fn, trials=20):\r\n\u001b[?2004l\r"]
[727.589844, "o", "\u001b[?2004h> "]
[727.589991, "o", "    ts = te(fn, [], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.590021, "o", "> "]
[727.590053, "o", "    return sum(ts)/len(ts)*1000\r\n\u001b[?2004l\r"]
[727.590084, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.590116, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.590147, "o", "> "]
[727.590185, "o", "def readk(Y, X, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[727.590215, "o", "\u001b[?2004h> "]
[727.590246, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[727.590275, "o", "\u001b[?2004h> "]
[727.590338, "o", "    off = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[727.590368, "o", "\u001b[?2004h> "]
[727.590398, "o", "    v = tl.load(X + off)\r\n\u001b[?2004l\r"]
[727.590429, "o", "\u001b[?2004h> "]
[727.590459, "o", "    s = tl.sum(v)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.59049, "o", "    if s > 1e30:\r\n\u001b[?2004l\r"]
[727.59052, "o", "\u001b[?2004h> "]
[727.59055, "o", "        tl.store(Y + pid, s)\r\n\u001b[?2004l\r"]
[727.59058, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.590609, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.590639, "o", "> "]
[727.590679, "o", "def writek(Y, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[727.590709, "o", "\u001b[?2004h> "]
[727.59074, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[727.590771, "o", "\u001b[?2004h> "]
[727.590827, "o", "    off = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[727.590857, "o", "\u001b[?2004h> "]
[727.590953, "o", "    tl.store(Y + off, tl.zeros([BLOCK], dtype=tl.float32) + 1.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.590979, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.591017, "o", "total = x.numel()\r\n\u001b[?2004l\r"]
[727.591047, "o", "\u001b[?2004h> "]
[727.591078, "o", "g = (total // 16384,)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.591228, "o", "print(f\"pure read: {timeit(lambda: readk[g](y, x, BLOCK=16384, num_warps=16)):.1f}us\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.59126, "o", "> "]
[727.591382, "o", "print(f\"pure write: {timeit(lambda: writek[g](y, BLOCK=16384, num_warps=16)):.1f}us\")\r\n\u001b[?2004l\r"]
[727.591412, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.591442, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.591473, "o", "> "]
[727.591676, "o", "def pass2v(Y, X, M, R, W, Bv, n_row, TRIVIAL: tl.constexpr, CS: tl.constexpr, BLOCK: tl.constexpr, NB: tl.constexpr, NBP2: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.591707, "o", "> "]
[727.591738, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.591769, "o", "> "]
[727.5918, "o", "    row = pid // NB\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.59183, "o", "    seg = pid % NB\r\n\u001b[?2004l\r"]
[727.59186, "o", "\u001b[?2004h> "]
[727.591891, "o", "    offs = tl.arange(0, NBP2)\r\n\u001b[?2004l\r"]
[727.591921, "o", "\u001b[?2004h> "]
[727.592012, "o", "    m = tl.load(M + row * NB + offs, mask=offs < NB, other=0.0)\r\n\u001b[?2004l\r"]
[727.592043, "o", "\u001b[?2004h> "]
[727.592137, "o", "    r = tl.load(R + row * NB + offs, mask=offs < NB, other=1.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.592183, "o", "    mu = tl.sum(m) / NB\r\n\u001b[?2004l\r"]
[727.592214, "o", "\u001b[?2004h> "]
[727.592291, "o", "    var = tl.sum(1.0 / (r * r) + m * m) / NB - mu * mu\r\n\u001b[?2004l\r"]
[727.592322, "o", "\u001b[?2004h> "]
[727.592364, "o", "    rstd = 1.0 / tl.sqrt(var)\r\n\u001b[?2004l\r"]
[727.592394, "o", "\u001b[?2004h> "]
[727.59245, "o", "    off = seg * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[727.59248, "o", "\u001b[?2004h> "]
[727.592531, "o", "    xx = tl.load(X + row * n_row + off)\r\n\u001b[?2004l\r"]
[727.592563, "o", "\u001b[?2004h> "]
[727.592592, "o", "    if TRIVIAL:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.592652, "o", "        yy = (xx - mu) * rstd\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.592683, "o", ">     else:\r\n\u001b[?2004l\r"]
[727.592714, "o", "\u001b[?2004h> "]
[727.592745, "o", "        w = tl.load(W + off)\r\n\u001b[?2004l\r"]
[727.592776, "o", "\u001b[?2004h> "]
[727.592814, "o", "        b = tl.load(Bv + off)\r\n\u001b[?2004l\r"]
[727.592845, "o", "\u001b[?2004h> "]
[727.592892, "o", "        yy = (xx - mu) * rstd * w + b\r\n\u001b[?2004l\r"]
[727.59292, "o", "\u001b[?2004h>     if CS:\r\n\u001b[?2004l\r"]
[727.592951, "o", "\u001b[?2004h> "]
[727.59306, "o", "        tl.store(Y + row * n_row + off, yy, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[727.593087, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[727.593112, "o", "\u001b[?2004h> "]
[727.593192, "o", "        tl.store(Y + row * n_row + off, yy)\r\n\u001b[?2004l\r\u001b[?2004h"]
[727.593217, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[727.593335, "o", "w = torch.rand(N, device='cuda'); bv = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[727.593369, "o", "\u001b[?2004h> "]
[727.593463, "o", "for blk, wp in ((8192,8),(16384,16),(32768,32),(65536,32),(65536,64)):\r\n\u001b[?2004l\r"]
[727.593498, "o", "\u001b[?2004h> "]
[727.593528, "o", "    nb = N // blk; gr = (B*nb,)\r\n\u001b[?2004l\r"]
[727.593559, "o", "\u001b[?2004h> "]
[727.593673, "o", "    M = torch.empty(B*nb, device='cuda'); R = torch.empty(B*nb, device='cuda')\r\n\u001b[?2004l\r"]
[727.593708, "o", "\u001b[?2004h> "]
[727.593739, "o", "    for tri in (True, False):\r\n\u001b[?2004l\r"]
[727.59377, "o", "\u001b[?2004h> "]
[727.59381, "o", "        for cs in (False, True):\r\n\u001b[?2004l\r"]
[727.59384, "o", "\u001b[?2004h> "]
[727.594027, "o", "            t = timeit(lambda: pass2v[gr](y, x, M, R, w, bv, N, TRIVIAL=tri, CS=cs, BLOCK=blk, NB=nb, NBP2=nb, num_warps=wp))\r\n\u001b[?2004l\r"]
[727.594064, "o", "\u001b[?2004h> "]
[727.594169, "o", "            print(f\"pass2 blk={blk} w={wp} trivial={tri} cs={cs}: {t:.1f}us\")\r\n\u001b[?2004l\r"]
[727.594197, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[727.596637, "o", "\u001b[?2004hroot@modal:/# "]
[727.596782, "o", "python3 -c \"import ast; ast.parse(open('/workspace/bench3.py').read()); print('ok')\"\r\n\u001b[?2004l\r"]
[727.607416, "o", "ok\r\n"]
