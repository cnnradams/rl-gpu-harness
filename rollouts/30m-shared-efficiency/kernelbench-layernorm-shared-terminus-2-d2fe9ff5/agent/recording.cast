[738.736778, "o", "Traceback (most recent call last):\r\n  File \"/workspace/bench3.py\", line 64, in <module>\r\n    t = timeit(lambda: pass2v[gr](y, x, M, R, w, bv, N, TRIVIAL=tri, CS=cs, BLOCK=blk, NB=nb, NBP2=nb, num_warps=wp))\r\n  File \"/workspace/bench3.py\", line 11, in timeit\r\n    ts = te(fn, [], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\r\n  File \"/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\", line 240, in time_execution_with_cuda_event\r\n    kernel_fn(*args)\r\n  File \"/workspace/bench3.py\", line 64, in <lambda>\r\n    t = timeit(lambda: pass2v[gr](y, x, M, R, w, bv, N, TRIVIAL=tri, CS=cs, BLOCK=blk, NB=nb, NBP2=nb, num_warps=wp))\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 419, in <lambda>\r\n    return lambda *args, **kwargs: self.run(grid=grid, warmup=False, *args, **kwargs)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 756, in run\r\n    launch_metadata = kernel.launch_metadata(grid, stream, *bound_args.values())\r\n  Fi"]
