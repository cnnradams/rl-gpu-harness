[616.653409, "o", "\u001b[?2004h> "]
[616.65345, "o", "def timeit(fn, trials=20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[616.653483, "o", "> "]
[616.653637, "o", "    ts = te(fn, [], num_warmup=3, num_trials=trials, discard_first=1, verbose=False, device=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
