[362.2986, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[362.298615, "o", "\u001b[?2004h> "]
[362.298722, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[362.298738, "o", "\u001b[?2004h> "]
[362.298776, "o", "        self.n_row = 1\r\n\u001b[?2004l\r"]
[362.298791, "o", "\u001b[?2004h> "]
[362.298849, "o", "        for s in normalized_shape:\r\n\u001b[?2004l\r"]
[362.298863, "o", "\u001b[?2004h> "]
[362.298914, "o", "            self.n_row *= s\r\n\u001b[?2004l\r"]
[362.298934, "o", "\u001b[?2004h> "]
[362.298975, "o", "        self.block = 16384\r\n\u001b[?2004l\r"]
[362.298989, "o", "\u001b[?2004h> "]
[362.299057, "o", "        if self.n_row % self.block != 0:\r\n\u001b[?2004l\r"]
[362.299076, "o", "\u001b[?2004h> "]
[362.299122, "o", "            self.block = 4096\r\n\u001b[?2004l\r"]
[362.29914, "o", "\u001b[?2004h> "]
[362.299207, "o", "        self.nb = self.n_row // self.block\r\n\u001b[?2004l\r"]
[362.299225, "o", "\u001b[?2004h> "]
[362.299265, "o", "        self._stats = {}\r\n\u001b[?2004l\r"]
[362.299285, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[362.299304, "o", "\u001b[?2004h> "]
[362.299364, "o", "    def _get_stats(self, rows, device):\r\n\u001b[?2004l\r"]
[362.299378, "o", "\u001b[?2004h> "]
[362.299428, "o", "        key = (rows, device)\r\n\u001b[?2004l\r"]
[362.299447, "o", "\u001b[?2004h> "]
[362.299501, "o", "        buf = self._stats.get(key)\r\n\u001b[?2004l\r"]
[362.299516, "o", "\u001b[?2004h> "]
[362.299557, "o", "        if buf is None:\r\n\u001b[?2004l\r"]
[362.299576, "o", "\u001b[?2004h> "]
[362.2997, "o", "            M = torch.empty(rows * self.nb, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[362.299715, "o", "\u001b[?2004h> "]
[362.299843, "o", "            R = torch.empty(rows * self.nb, device=device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[362.299864, "o", "\u001b[?2004h> "]
[362.299911, "o", "            buf = (M, R)\r\n\u001b[?2004l\r"]
[362.299926, "o", "\u001b[?2004h> "]
[362.299984, "o", "            self._stats[key] = buf\r\n\u001b[?2004l\r"]
[362.300003, "o", "\u001b[?2004h> "]
[362.300032, "o", "        return buf\r\n\u001b[?2004l\r"]
[362.300047, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[362.300065, "o", "\u001b[?2004h> "]
[362.300155, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[362.300177, "o", "\u001b[?2004h> "]
[362.300227, "o", "        if not x.is_contiguous():\r\n\u001b[?2004l\r"]
[362.300244, "o", "\u001b[?2004h> "]
[362.300295, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r"]
[362.30031, "o", "\u001b[?2004h> "]
[362.300356, "o", "        n_row = self.n_row\r\n\u001b[?2004l\r"]
[362.300377, "o", "\u001b[?2004h> "]
[362.300426, "o", "        rows = x.numel() // n_row\r\n\u001b[?2004l\r"]
[362.300441, "o", "\u001b[?2004h> "]
[362.300499, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[362.300514, "o", "\u001b[?2004h> "]
[362.30055, "o", "        nb = self.nb\r\n\u001b[?2004l\r"]
[362.300566, "o", "\u001b[?2004h> "]
[362.300642, "o", "        M, R = self._get_stats(rows, x.device)\r\n\u001b[?2004l\r"]
[362.300662, "o", "\u001b[?2004h> "]
[362.300703, "o", "        eps = self.ln.eps\r\n\u001b[?2004l\r"]
[362.300718, "o", "\u001b[?2004h> "]
[362.300865, "o", "        _ln_pass1[(rows * nb,)](x, M, R, n_row, eps, BLOCK=self.block, NB=nb, num_warps=16)\r\n\u001b[?2004l\r"]
[362.30088, "o", "\u001b[?2004h> "]
[362.301103, "o", "        _ln_pass2[(rows * nb,)](y, x, M, R, self.ln.weight, self.ln.bias, n_row, BLOCK=self.block, NB=nb, NBP2=nb, num_warps=16)\r\n\u001b[?2004l\r"]
[362.30112, "o", "\u001b[?2004h> "]
[362.30115, "o", "        return y\r\n\u001b[?2004l\r"]
[362.301165, "o", "\u001b[?2004h> "]
[362.301183, "o", "EOF\r\n\u001b[?2004l\r"]
