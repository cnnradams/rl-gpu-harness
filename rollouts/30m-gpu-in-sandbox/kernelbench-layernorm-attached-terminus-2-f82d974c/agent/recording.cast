[572.030135, "i", "cat > /workspace/repro2.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\nfrom kernelbench import timing\n\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nm = ModelNew((64, 256, 256)).to(dev)\nref = torch.nn.LayerNorm((64, 256, 256)).to(dev)\n\n# mimic correctness phase\nfor t in range(2):\n    x = torch.rand(16, 64, 256, 256, device=dev)\n    with torch.no_grad():\n        y = m(x)\n        r = ref(x)\n    print('trial', t, 'err', (y - r).abs().max().item())\n\ntorch.cuda.synchronize()\nx = torch.rand(16, 64, 256, 256, device=dev)\ntorch.cuda.synchronize()\nprint('timing candidate...')\ntimes = timing.time_execution_with_cuda_event(m, [x], num_warmup=3, num_trials=5, verbose=True, device=dev)\nprint('times', times)\nEOF\nCUDA_LAUNCH_BLOCKING=1 python3 /workspace/repro2.py 2>&1 | tail -25\n"]
