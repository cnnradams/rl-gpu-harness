[329.347087, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, sys, importlib\nsys.path.insert(0, '/workspace')\nimport solution\nimport numpy as np\n\ndev = 'cuda'\nm = solution.ModelNew((64, 256, 256)).to(dev)\nref = torch.nn.LayerNorm((64, 256, 256)).to(dev)\nx = torch.rand(16, 64, 256, 256, device=dev)\nwith torch.no_grad():\n    r = ref(x)\nbuf = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)\nst = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\n\nfor C in [32, 64, 128, 256]:\n    for BLOCK in [4096, 8192, 16384]:\n        chunk = 64*256*256 // C\n        if chunk % BLOCK != 0:\n            continue\n        for ws in [4, 8]:\n            for wa in [8, 16]:\n                m._C = C; m._BLOCK = BLOCK; m._warps_stats = ws; m._warps_apply = wa\n                m._graphs = {}; m._seen = {}\n                try:\n                    for _ in range(4):\n                        y = m(x)\n                    torch.cuda.synchronize()\n                    err = (y - r).abs().max().item()\n                 "]
[329.347452, "i", "   if err > 1e-4:\n                        print(C, BLOCK, ws, wa, 'ERR', err); continue\n                    times = []\n                    for _ in range(10):\n                        torch.cuda.synchronize(); buf.zero_()\n                        st.record(); y = m(x); en.record()\n                        torch.cuda.synchronize()\n                        times.append(st.elapsed_time(en))\n                    print(C, BLOCK, ws, wa, f'{np.mean(times):.4f}', f'{np.min(times):.4f}')\n                except Exception as e:\n                    print(C, BLOCK, ws, wa, 'EXC', type(e).__name__)\nEOF\npython3 /workspace/sweep.py\n"]
