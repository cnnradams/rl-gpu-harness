[264.792776, "o", "                return self.ln(x)\r\n\u001b[?2004l\r"]
[264.792908, "o", "\u001b[?2004h> "]
[264.793204, "o", "            chunk = N // C\r\n\u001b[?2004l\r"]
[264.79333, "o", "\u001b[?2004h> "]
[264.793735, "o", "            key = (x.data_ptr(), x.shape)\r\n\u001b[?2004l\r"]
[264.793879, "o", "\u001b[?2004h> "]
[264.794272, "o", "            ent = self._graphs.get(key)\r\n\u001b[?2004l\r"]
[264.794417, "o", "\u001b[?2004h> "]
[264.79476, "o", "            if ent is not None:\r\n\u001b[?2004l\r"]
[264.794907, "o", "\u001b[?2004h> "]
[264.79519, "o", "                g, y = ent\r\n\u001b[?2004l\r"]
[264.79534, "o", "\u001b[?2004h> "]
[264.795612, "o", "                g.replay()\r\n\u001b[?2004l\r"]
[264.795732, "o", "\u001b[?2004h"]
[264.795846, "o", "> "]
[264.795999, "o", "                return y\r\n\u001b[?2004l\r"]
[264.796089, "o", "\u001b[?2004h"]
[264.796204, "o", "> "]
[264.79671, "o", "            cnt = self._seen.get(key, 0) + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.796755, "o", "> "]
[264.797189, "o", "            self._seen[key] = cnt\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.797236, "o", "> "]
[264.797546, "o", "            if cnt >= 2:\r\n\u001b[?2004l\r"]
[264.797596, "o", "\u001b[?2004h"]
[264.797719, "o", "> "]
[264.79832, "o", "                g, y = self._build_graph(x, rows, N, C, chunk)\r\n\u001b[?2004l\r"]
[264.798499, "o", "\u001b[?2004h> "]
[264.798886, "o", "                self._graphs[key] = (g, y)\r\n\u001b[?2004l\r"]
[264.798932, "o", "\u001b[?2004h"]
[264.799032, "o", "> "]
[264.799327, "o", "                g.replay()\r\n\u001b[?2004l\r"]
[264.799482, "o", "\u001b[?2004h> "]
