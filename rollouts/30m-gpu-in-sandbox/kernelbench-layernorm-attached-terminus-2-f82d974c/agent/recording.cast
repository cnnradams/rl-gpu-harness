[94.109073, "o", "\u001b[32m\u001b[K408\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype = torch.float32,\r\n\u001b[32m\u001b[K409\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K410\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Guard against potential reward hacking [optional but ongoing enhancement]\r\n\u001b[32m\u001b[K411\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    check_for_\u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup: bool = True,\r\n\u001b[32m\u001b[K412\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup_threshold: float = 10, # flag if the kernel is more than <\u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup_threshold>x faster than the reference\r\n"]
[94.109291, "o", "\u001b[32m\u001b[K413\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K) -> KernelExecResult:\r\n\u001b[32m\u001b[K414\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K415\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Evaluate the custom kernel against the original model\r\n\u001b[32m\u001b[K416\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K417\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    NOTE: we are thinking about refactor this to be more modularized \r\n\u001b[32m\u001b[K418\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    and we can add more checks as our other ongiong PRs are working on\r\n\u001b[32m\u001b[K419\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K420\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_correct_trials: number of trials to initialize different random inputs; correctness pass only if all trials pass\r\n\u001b[32m\u001b[K421\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    num_perf_trials: run the evalutation many times to take the average\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    device: GPU (cuda) device to run the evalutation on\r\n\u001b[32m\u001b[K423\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    backend: str, one of 'cuda', 'triton', 'tilelang', or 'cute'\r\n\u001b[32m\u001b[K424\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    precision: torch.dtype for computation (note: tilelang only supports fp16)\r\n\u001b[3"]
[94.109343, "o", "2m\u001b[K425\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    timing_method: str, method to time kernel, see timing.py for more details \r\n\u001b[32m\u001b[K426\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K427\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ONGOING EFFORT to refactor and modularize this, and adding more tests for eval.\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K648\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ###############################################################\r\n\u001b[32m\u001b[K649\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # [Experimental] to be modularized\r\n\u001b[32m\u001b[K650\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Condition: custom kernel ModelNew is correct and we are able to time it correctly with kernel_exec_result\r\n\u001b[32m\u001b[K651\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    # We are working on preventing \u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K speedup issues\r\n\u001b[32m\u001b[K652\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    ##############################################################\r\n\u001b[32m\u001b[K653\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K654\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    if measure_performance and check_for_\u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup:  # experimental: hence able to shut off codepath if needed\r\n\u001b[32m\u001b[K655\u001b[m\u001b"]
[94.109367, "o", "[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K656\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if verbose:\r\n\u001b[32m\u001b[K657\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(\"[Eval] Additional checks to flag \u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K speedup\")\r\n\u001b[32m\u001b[K658\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K659\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.cuda.synchronize(device=device)\r\n\u001b[32m\u001b[K660\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        set_seed(seed_num)\r\n\u001b[32m\u001b[K661\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        inputs = get_inputs()\r\n\u001b[32m\u001b[K662\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # Convert inputs for performance measurement\r\n\u001b[32m\u001b[K663\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        inputs = [_process_input_tensor(x, device, backend, precision) for x in inputs]\r\n\u001b[32m\u001b[K664\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \r\n\u001b[32m\u001b[K665\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        model_new = custom_model.to(device=device, dtype=precision)\r\n\u001b[32m\u001b[K666\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.cuda.synchronize(device=device)\r\n\u001b[32m\u001b[K667\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
[94.10957, "o", "\u001b[32m\u001b[K668\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # time PyTorch reference function\r\n\u001b[32m\u001b[K669\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # same timing_fn as specified from before\r\n\u001b[32m\u001b[K670\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        timing_fn = timing.get_timing_function(timing_method)\r\n"]
[94.109679, "o", "\u001b[32m\u001b[K671\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        reference_elapsed_times = timing_fn(\r\n\u001b[32m\u001b[K672\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            original_model,\r\n\u001b[36m\u001b[K--\u001b[m\u001b[K\r\n\u001b[32m\u001b[K688\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if verbose:\r\n\u001b[32m\u001b[K689\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            print(f\"[Eval] Effective Speedup is {effective_speedup:.2f}x using timing method {timing_method}\")\r\n\u001b[32m\u001b[K690\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K691\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        if effective_speedup > \u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup_threshold:\r\n\u001b[32m\u001b[K692\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            kernel_exec_result.metadata[\"\u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup\"] = True\r\n\u001b[32m\u001b[K693\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            \r\n\u001b[32m\u001b[K694\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K            print(f\"[WARNING] Excessive speedup {effective_speedup:.2f}x over {\u001b[01;31m\u001b[Kexcessive\u001b[m\u001b[K_speedup_threshold}x threshold detected\")\r\n\u001b[32m\u001b[K695\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            print(f\"[WARNING] Double check your kernel carefully to ensure it is not reward hacking.\")\r\n\u001b[32m\u001b[K696\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K697\u001b"]
[94.10982, "o", "[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K698\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    graceful_eval_cleanup(context, device, tempfile)\r\n\u001b[32m\u001b[K699\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    return kernel_exec_result\r\n\u001b[32m\u001b[K700\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K701\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K702\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kdef register_and_format_exception(\r\n\u001b[32m\u001b[K703\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    exception_type: str,\r\n\u001b[32m\u001b[K704\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    exception_msg: Exception | str,\r\n\u001b[32m\u001b[K705\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    metadata: dict,\r\n\u001b[32m\u001b[K706\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    verbose: bool = False,\r\n\u001b[32m\u001b[K707\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    truncate=False,\r\n\u001b[32m\u001b[K708\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    max_length=200,\r\n\u001b[32m\u001b[K709\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K):\r\n"]
