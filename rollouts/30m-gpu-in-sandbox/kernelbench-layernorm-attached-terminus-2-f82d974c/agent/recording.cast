[264.739419, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_stats(x_ptr, ps_ptr, psq_ptr, N, chunk, C,\n              BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    ch = pid % C\n    start = row * N + ch * chunk\n    s = tl.zeros((), dtype=tl.float32)\n    sq = tl.zeros((), dtype=tl.float32)\n    for off in range(0, chunk, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        s += tl.sum(v)\n        sq += tl.sum(v * v)\n    tl.store(ps_ptr + pid, s)\n    tl.store(psq_ptr + pid, sq)\n\n\n@triton.jit\ndef _ln_apply(x_ptr, w_ptr, b_ptr, y_ptr, ps_ptr, psq_ptr,\n              N, chunk, C, eps,\n              BLOCK: tl.constexpr, CB: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    ch = pid % C\n    co = tl.arange(0, CB)\n    cmask = co < C\n    s = tl.sum(tl.load(ps_ptr + row * C + co, mask=cmask, other=0.0))\n    sq = tl.sum(tl.load(psq_ptr + row * C + co, mask=cmask, ot"]
[264.739839, "i", "her=0.0))\n    mean = s / N\n    var = sq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    wrow = ch * chunk\n    xrow = row * N + ch * chunk\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + xrow + idx)\n        w = tl.load(w_ptr + wrow + idx)\n        b = tl.load(b_ptr + wrow + idx)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + xrow + idx, y)\n\n\ndef _next_pow2(n):\n    p = 1\n    while p < n:\n        p *= 2\n    return p\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self._graphs = {}\n        self._seen = {}\n        self._C = 64\n        self._BLOCK = 8192\n        self._warps_stats = 8\n        self._warps_apply = 8\n\n    def _run_kernels(self, x, y, ps, psq, w, b, rows, N, C, chunk, eps):\n        grid = (rows * C,)\n        _ln_stats[grid](x, ps, psq, N, chunk, C,\n                        BLOCK=self._BLOCK, n"]
[264.740072, "i", "um_warps=self._warps_stats)\n        _ln_apply[grid](x, w, b, y, ps, psq, N, chunk, C, eps,\n                        BLOCK=self._BLOCK, CB=_next_pow2(C),\n                        num_warps=self._warps_apply)\n\n    def _build_graph(self, x, rows, N, C, chunk):\n        dev = x.device\n        y = torch.empty_like(x)\n        ps = torch.empty(rows * C, device=dev, dtype=torch.float32)\n        psq = torch.empty(rows * C, device=dev, dtype=torch.float32)\n        w = self.ln.weight.detach().reshape(-1)\n        b = self.ln.bias.detach().reshape(-1)\n        eps = self.ln.eps\n        torch.cuda.synchronize(dev)\n        s = torch.cuda.Stream(device=dev)\n        s.wait_stream(torch.cuda.current_stream(dev))\n        with torch.cuda.stream(s):\n            for _ in range(3):\n                self._run_kernels(x, y, ps, psq, w, b, rows, N, C, chunk, eps)\n        torch.cuda.current_stream(dev).wait_stream(s)\n        torch.cuda.synchronize(dev)\n        g = torch.cuda.CUDAGraph()\n        with torch.cuda.graph(g):\n            self._ru"]
[264.740166, "i", "n_kernels(x, y, ps, psq, w, b, rows, N, C, chunk, eps)\n        return (g, y)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        with torch.no_grad():\n            if (not x.is_cuda) or x.dtype != torch.float32:\n                return self.ln(x)\n            x = x.contiguous()\n            N = self.ln.weight.numel()\n            rows = x.numel() // N\n            C = self._C\n            if N % C != 0 or (N // C) % self._BLOCK != 0:\n                return self.ln(x)\n            chunk = N // C\n            key = (x.data_ptr(), x.shape)\n            ent = self._graphs.get(key)\n            if ent is not None:\n                g, y = ent\n                g.replay()\n                return y\n            cnt = self._seen.get(key, 0) + 1\n            self._seen[key] = cnt\n            if cnt >= 2:\n                g, y = self._build_graph(x, rows, N, C, chunk)\n                self._graphs[key] = (g, y)\n                g.replay()\n                return y\n            y = torch.empty_like(x)\n            ps = torch.empty"]
