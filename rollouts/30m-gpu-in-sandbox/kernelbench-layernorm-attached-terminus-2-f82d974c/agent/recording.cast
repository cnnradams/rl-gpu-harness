[264.799853, "o", "\u001b[?2004h> "]
[264.800237, "o", "            y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[264.800358, "o", "\u001b[?2004h> "]
[264.801164, "o", "            ps = torch.empty(rows * C, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[264.801287, "o", "\u001b[?2004h"]
[264.801325, "o", "> "]
[264.802115, "o", "            psq = torch.empty(rows * C, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[264.802225, "o", "\u001b[?2004h"]
[264.802362, "o", "> "]
[264.802886, "o", "            self._run_kernels(x, y, ps, psq,\r\n\u001b[?2004l\r"]
[264.803025, "o", "\u001b[?2004h"]
[264.803157, "o", "> "]
[264.803841, "o", "                              self.ln.weight.detach().reshape(-1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.803879, "o", "> "]
[264.804584, "o", "                              self.ln.bias.detach().reshape(-1),\r\n\u001b[?2004l\r"]
[264.804631, "o", "\u001b[?2004h"]
[264.804765, "o", "> "]
[264.805387, "o", "                              rows, N, C, chunk, self.ln.eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[264.805449, "o", "> "]
[264.805712, "o", "            return y\r\n\u001b[?2004l\r"]
[264.80582, "o", "\u001b[?2004h"]
[264.805917, "o", "> EOF\r\n\u001b[?2004l\r"]
