[265.15773, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\nimport triton\n\ntorch.manual_seed(0)\ndev = 'cuda'\nm = ModelNew((64, 256, 256)).to(dev)\nref = torch.nn.LayerNorm((64, 256, 256)).to(dev)\nx = torch.rand(16, 64, 256, 256, device=dev)\n\nwith torch.no_grad():\n    r = ref(x)\nfor it in range(4):\n    y = m(x)\ntorch.cuda.synchronize()\nerr = (y - r).abs().max().item()\nprint('max err', err)\nassert err < 1e-4, 'FAIL'\n\n# time graph replay with L2 clear like evaluator\nbuf = torch.empty(256*1024*1024//4, device=dev, dtype=torch.float32)\ndef clear_l2():\n    buf.zero_()\n\nfor _ in range(3):\n    y = m(x)\ntorch.cuda.synchronize()\nimport time\nst = torch.cuda.Event(enable_timing=True); en = torch.cuda.Event(enable_timing=True)\ntimes = []\nfor _ in range(20):\n    torch.cuda.synchronize()\n    clear_l2()\n    st.record()\n    y = m(x)\n    en.record()\n    torch.cuda.synchronize()\n    times.append(st.elapsed_time(en))\nimport numpy as np\nprint('ours ms:', np.mean(times), np.mi"]
[265.157995, "i", "n(times))\n\nfor _ in range(3):\n    r = ref(x)\ntorch.cuda.synchronize()\ntimes = []\nfor _ in range(20):\n    torch.cuda.synchronize()\n    clear_l2()\n    st.record()\n    r = ref(x)\n    en.record()\n    torch.cuda.synchronize()\n    times.append(st.elapsed_time(en))\nprint('ref ms:', np.mean(times), np.min(times))\nEOF\npython3 /workspace/bench.py\n"]
