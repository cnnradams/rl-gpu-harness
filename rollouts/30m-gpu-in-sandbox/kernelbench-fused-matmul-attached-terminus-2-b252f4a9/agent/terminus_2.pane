[?2004l[?2004h>     with torch.cuda.stream(s):
[?2004l[?2004h>         for _ in range(3):
[?2004l[?2004h>             y2 = new(x)
[?2004l[?2004h>     torch.cuda.current_stream().wait_stream(s)
[?2004l[?2004h>     g = torch.cuda.CUDAGraph()
