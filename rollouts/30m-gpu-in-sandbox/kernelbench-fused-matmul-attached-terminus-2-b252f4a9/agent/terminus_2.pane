[?2004l[?2004h>     _gemm_kernel[grid](x, w_t, out, bias, M, N, K,
[?2004l[?2004h>                        x.stride(0), x.stride(1),
[?2004l[?2004h>                        w_t.stride(0), w_t.stride(1),
[?2004l[?2004h>                        out.stride(0), out.stride(1),
[?2004l[?2004h>                        EVEN=even)
[?2004l[?2004h>     return out
