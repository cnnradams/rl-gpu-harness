[?2004l[?2004h>     torch.cuda.synchronize()
[?2004l[?2004h>     st = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>     st.record()
[?2004l[?2004h>     for _ in range(n): fn()
[?2004l[?2004h>     e.record(); torch.cuda.synchronize()
[?2004l[?2004h>     return st.elapsed_time(e)/n
[?2004l[?2004h> 
[?2004l[?2004h> with torch.no_grad():
[?2004l[?2004h>     t_normal = timeit(lambda: new(x))
[?2004l[?2004h>     t_graph = timeit(lambda: g.replay())
[?2004l[?2004h> print(f'normal: {t_normal:.3f} ms, graph: {t_graph:.3f} ms')
