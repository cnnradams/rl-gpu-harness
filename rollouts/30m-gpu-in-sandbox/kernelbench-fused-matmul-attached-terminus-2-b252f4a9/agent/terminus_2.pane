[?2004l[?2004h> import torch, triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _k2(a_ptr, bh_ptr, c_ptr, bias_ptr, M, N, K,
[?2004l[?2004h>         sam, sak, sbk, sbn, scm, scn,
[?2004l[?2004h>         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GROUP * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)
[?2004l[?2004h>     pid_m = group_id * GROUP + (pid % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     rn = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     rk = tl.arange(0, BK)
[?2004l[?2004h>     a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak
[?2004l[?2004h>     bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, tl.cdiv(K, BK)):
[?2004l[?2004h>         a = tl.load(a_ptrs)
[?2004l[?2004h>         ah = a.to(tl.float16)
[?2004l[?2004h>         al = (a - ah.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>         bh = tl.load(bh_ptrs)
[?2004l[?2004h>         acc = tl.dot(ah, bh, acc)
[?2004l[?2004h>         acc = tl.dot(al, bh, acc)
[?2004l[?2004h>         a_ptrs += BK * sak
[?2004l[?2004h>         bh_ptrs += BK * sbk
[?2004l[?2004h>     bias = tl.load(bias_ptr + rn)
[?2004l[?2004h>     acc = acc + bias[None, :]
[?2004l[?2004h>     c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn
[?2004l[?2004h>     tl.store(c_ptrs, acc)
[?2004l[?2004h> 
[?2004l[?2004h> M, N, K = 16384, 4096, 4096
[?2004l[?2004h> worse = 0
[?2004l[?2004h> for seed in range(5):
[?2004l[?2004h>     torch.manual_seed(seed)
[?2004l[?2004h>     x = torch.rand(M, K, device='cuda')
[?2004l[?2004h>     w = torch.nn.Linear(K, N, device='cuda')
[?2004l[?2004h>     ref = torch.nn.functional.linear(x, w.weight, w.bias)
[?2004l[?2004h>     wt = w.weight.t().contiguous()
[?2004l[?2004h>     wh = wt.half()
[?2004l[?2004h>     out = torch.empty(M, N, device='cuda')
[?2004l[?2004h>     BM, BN, BK, G, s, wp = 128, 128, 16, 16, 5, 4
[?2004l[?2004h>     grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
[?2004l[?2004h>     _k2[grid](x, wh, out, w.bias, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)
[?2004l[?2004h>     torch.cuda.synchronize()
[?2004l[?2004h>     d = (out - ref).abs()
[?2004l[?2004h>     thr = 1e-4 + 1e-4 * ref.abs()
[?2004l[?2004h>     viol = (d > thr).sum().item()
[?2004l[?2004h>     print(f'seed {seed}: maxdiff {d.max().item():.3e} viol {viol}')
[?2004l[?2004h>     worse = max(worse, d.max().item())
[?2004l[?2004h> 
[?2004l[?2004h> def timeit(fn, n=50):
[?2004l[?2004h>     for _ in range(10): fn()
[?2004l[?2004h>     torch.cuda.synchronize()
[?2004l[?2004h>     st = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>     st.record()
[?2004l[?2004h>     for _ in range(n): fn()
[?2004l[?2004h>     e.record(); torch.cuda.synchronize()
[?2004l[?2004h>     return st.elapsed_time(e)/n
[?2004l[?2004h> print('2-dot time ms:', timeit(lambda: _k2[grid](x, wh, out, w.bias, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)))
