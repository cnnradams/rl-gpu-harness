[1456.236933, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton\nM, K, N = 16384, 4096, 4096\nx16 = torch.rand(M, K, device='cuda').half()\nw16 = torch.rand(K, N, device='cuda').half()\nx32 = torch.rand(M, K, device='cuda')\n\ndef timeit(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\ny = torch.empty(M, N, device='cuda', dtype=torch.half)\nprint('fp16 cuBLAS mm ms:', timeit(lambda: torch.mm(x16, w16, out=y)))\ny32 = torch.empty(M, N, device='cuda')\n# fp16 mm with fp32 out via addmm? torch.mm requires same dtype. Try torch._addmm_activation? Use matmul with out dtype fp16\nprint('3x fp16 cuBLAS mm ms:', timeit(lambda: (torch.mm(x16, w16, out=y), torch.mm(x16, w16, out=y), torch.mm(x16, w16, out=y))))\nEOF\npython3 /workspace/bench3.py\n"]
