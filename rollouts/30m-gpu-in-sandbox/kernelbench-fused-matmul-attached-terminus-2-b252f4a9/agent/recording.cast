[186.101406, "i", "cat > /workspace/smoke.py << 'EOF'\nimport sys, torch\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).cuda()\ntorch.manual_seed(42)\nnew = ModelNew(*get_init_inputs()).cuda()\nprint('weight equal:', torch.equal(ref.matmul.weight, new.matmul.weight))\n\ntorch.manual_seed(123)\nx = torch.rand(16384, 4096, device='cuda')\nwith torch.no_grad():\n    y_ref = ref(x)\n    y_new = new(x)\nprint('shape:', y_ref.shape, y_new.shape)\nd = (y_ref - y_new).abs()\nprint('max diff:', d.max().item(), 'mean diff:', d.mean().item())\nok = torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4)\nprint('allclose 1e-4:', ok)\n\n# rough timing\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    retu"]
[186.101583, "i", "rn s.elapsed_time(e)/n\n\nwith torch.no_grad():\n    t_ref = timeit(lambda: ref(x))\n    t_new = timeit(lambda: new(x))\nprint(f'ref: {t_ref:.3f} ms, new: {t_new:.3f} ms, speedup: {t_ref/t_new:.2f}x')\nEOF\npython3 /workspace/smoke.py\n"]
