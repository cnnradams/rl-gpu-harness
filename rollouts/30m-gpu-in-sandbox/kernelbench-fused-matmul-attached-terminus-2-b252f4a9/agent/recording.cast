[869.658793, "o", "\u001b[?2004h"]
[869.658847, "o", "> "]
[869.659028, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[869.659117, "o", "\u001b[?2004h> "]
