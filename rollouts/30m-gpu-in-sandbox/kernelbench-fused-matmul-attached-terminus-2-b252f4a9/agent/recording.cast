[177.339669, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\n\ndef _split_tf32(t):\n    # Split fp32 tensor into hi (10 mantissa bits, TF32-exact) and lo parts\n    ti = t.view(torch.int32)\n    hi = (ti & -8192).view(torch.float32)\n    lo = t - hi\n    return hi, lo\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        # Must match reference RNG consumption exactly: same Linear created first\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        with torch.no_grad():\n            f = 1.0 + float(scaling_factor)  # ref: y = linear(x)*s + linear(x) = (1+s)*linear(x)\n            ws = self.matmul.weight * f\n            bs = self.matmul.bias * f\n            ws_hi, ws_lo = _split_tf32(ws)\n            self.register_buffer(\"ws_hi_t\", ws_hi.t().contiguous())\n            self.register_buffer(\"ws_lo_t\", ws_lo.t().contiguous())\n            self.register_buffer(\"bs\", b"]
[177.339978, "i", "s)\n        torch.backends.cuda.matmul.allow_tf32 = True\n\n    def forward(self, x):\n        torch.backends.cuda.matmul.allow_tf32 = True\n        x = x.contiguous()\n        x_hi, x_lo = _split_tf32(x)\n        y = torch.addmm(self.bs, x_hi, self.ws_hi_t)\n        y.addmm_(x_hi, self.ws_lo_t)\n        y.addmm_(x_lo, self.ws_hi_t)\n        return y\nEOF\n"]
