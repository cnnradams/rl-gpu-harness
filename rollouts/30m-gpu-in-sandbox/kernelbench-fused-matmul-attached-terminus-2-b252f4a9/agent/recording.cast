[290.416875, "i", "cat > /workspace/dbg.py << 'EOF'\nimport torch, time\ntorch.manual_seed(0)\nM = N = K = 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(K, N, device='cuda') - 0.5) / 8\n\ny64 = (x.double() @ w.double())\n\ndef err(y):\n    return (y.double() - y64).abs().max().item()\n\n# fp32\ntorch.backends.cuda.matmul.allow_tf32 = False\ny = x @ w\nprint('fp32 err:', err(y))\n\n# tf32\ntorch.backends.cuda.matmul.allow_tf32 = True\nprint('fp32_precision:', torch.backends.cuda.matmul.fp32_precision)\ny = x @ w\nprint('tf32 err:', err(y))\n\ndef split(t):\n    ti = t.view(torch.int32)\n    hi = (ti & -8192).view(torch.float32)\n    return hi, t - hi\n\nxh, xl = split(x)\nwh, wl = split(w)\ny3 = xh @ wh + xh @ wl + xl @ wh\nprint('3xtf32 err:', err(y3))\n\ndef timeit(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\ntorch.backends"]
[290.417153, "i", ".cuda.matmul.allow_tf32 = False\nprint('fp32 mm ms:', timeit(lambda: x @ w))\ntorch.backends.cuda.matmul.allow_tf32 = True\nprint('tf32 mm ms:', timeit(lambda: x @ w))\nprint('tf32 mm ms (new api):', torch.backends.cuda.matmul.fp32_precision)\nEOF\npython3 /workspace/dbg.py\n"]
