[869.652938, "o", "\u001b[?2004h"]
[869.652998, "o", "> "]
[869.653152, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[869.653199, "o", "\u001b[?2004h"]
[869.653221, "o", "> "]
