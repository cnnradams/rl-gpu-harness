[1550.615079, "o", "    \"max_difference\": [\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\"\r\n    ],\r\n    \"avg_difference\": [\r\n      \"nan\",\r\n      \"nan\",\r\n      \"nan\"\r\n    ],\r\n    \"correctness_issue\": \"Output mismatch\",\r\n    \"correctness_trials\": \"(2 / 5)\"\r\n  },\r\n  \"runtime\": -1.0,\r\n  \"runtime_stats\": {},\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0149,\r\n    \"min\": 11.3,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"d9fd21619c8b8b1bf6dc70064e03276d649ec8a113ae5a792b925bd0e2d18436\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 0.0\r\n}\r\n"]
