[1010.665847, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _split_kernel(x_ptr, hi_ptr, lo_ptr, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLOCK + tl.arange(0, BLOCK)\n    m = off < n\n    x = tl.load(x_ptr + off, mask=m)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    tl.store(hi_ptr + off, hi, mask=m)\n    tl.store(lo_ptr + off, lo, mask=m)\n\n\ndef _split_fp16(x):\n    hi = torch.empty_like(x, dtype=torch.float16)\n    lo = torch.empty_like(x, dtype=torch.float16)\n    n = x.numel()\n    BLOCK = 8192\n    _split_kernel[(triton.cdiv(n, BLOCK),)](x, hi, lo, n, BLOCK=BLOCK, num_warps=8)\n    return hi, lo\n\n\n_CONFIGS = [\n    triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n    triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=3, num_warps=8),\n    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=3, num_warps=8),\n  "]
[1010.66604, "i", "  triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n    triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n    triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP': 8}, num_stages=3, num_warps=8),\n    triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GROUP': 8}, num_stages=3, num_warps=8),\n    triton.Config({'BM': 256, 'BN': 64, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n    triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n]\n\n\n@triton.autotune(configs=_CONFIGS, key=['M', 'N', 'K'])\n@triton.jit\ndef _gemm3_fusedsplit(a_ptr, bh_ptr, bl_ptr, c_ptr, bias_ptr, M, N, K,\n                      sam, sak, sbk, sbn, scm, scn,\n                      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_i"]
[1010.66615, "i", "d * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    bl_ptrs = bl_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptrs)\n        bl = tl.load(bl_ptrs)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        a_ptrs += BK * sak\n        bh_ptrs += BK * sbk\n        bl_ptrs += BK * sbk\n    bias = tl.load(bias_ptr + rn)\n    acc = acc + bias[None, :]\n    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc)\n\n\ndef _linear(x, wh_t, wl_t, bias):\n    M"]
[1010.666277, "i", ", K = x.shape\n    N = wh_t.shape[1]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    _gemm3_fusedsplit[grid](x, wh_t, wl_t, out, bias, M, N, K,\n                            x.stride(0), x.stride(1),\n                            wh_t.stride(0), wh_t.stride(1),\n                            out.stride(0), out.stride(1))\n    return out\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        # Match reference RNG consumption exactly\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        with torch.no_grad():\n            f = 1.0 + float(scaling_factor)  # ref: y*scaling + y == (1+scaling)*y\n            ws = self.matmul.weight * f\n            self.register_buffer(\"w_t32\", ws.t().contiguous())\n            self.register_buffer(\"b\", (self.matmul.bias * f).clone())\n          "]
[1010.666327, "i", "  self._rebuild_fp16()\n\n    @torch.no_grad()\n    def _rebuild_fp16(self):\n        ws_t = self.w_t32\n        wh = ws_t.to(torch.float16)\n        wl = (ws_t - wh.to(torch.float32)).to(torch.float16)\n        self.wh_t = wh.contiguous()\n        self.wl_t = wl.contiguous()\n\n    def forward(self, x):\n        # The evaluator may call .to(dtype=torch.float32) which would convert our\n        # fp16 splits; rebuild them lazily (no-op after first call).\n        if self.wh_t.dtype != torch.float16 or self.wh_t.device != x.device:\n            self._rebuild_fp16()\n        x = x.contiguous()\n        return _linear(x, self.wh_t, self.wl_t, self.b)\nEOF\npython3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report2.json 2>&1 | tail -30\n"]
