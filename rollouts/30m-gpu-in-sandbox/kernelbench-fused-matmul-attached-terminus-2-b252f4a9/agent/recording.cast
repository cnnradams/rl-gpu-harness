[398.199143, "i", "cat > /workspace/dbg2.py << 'EOF'\nimport torch\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\n\ny64 = x.double() @ w.double()\ny32 = x @ w  # fp32 reference (allow_tf32 False by default)\nprint('fp32 err vs exact:', (y32.double()-y64).abs().max().item())\n\ndef err(y):\n    d = (y.double() - y64).abs()\n    return d.max().item(), d.mean().item()\n\ndef split_tr(t):\n    ti = t.view(torch.int32)\n    hi = (ti & -8192).view(torch.float32)\n    return hi, t - hi\n\ndef split_dk(t):\n    c = t * 8193.0\n    hi = c - (c - t)\n    return hi, t - hi\n\ntorch.backends.cuda.matmul.allow_tf32 = True\n\nfor name, sp in [('trunc', split_tr), ('dekker', split_dk)]:\n    xh, xl = sp(x)\n    wh, wl = sp(w)\n    y3 = xh @ wh\n    y3 += xh @ wl\n    y3 += xl @ wh\n    print(name, '3gemm err vs exact:', err(y3))\n    d3 = (y3 - y32).abs()\n    thr = 1e-4 + 1e-4 * y32.abs()\n    print(name, '3gemm vs ref fp32: max', d3.max().item(), 'viol_frac', (d3 > thr).float().mean("]
[398.199345, "i", ").item())\n    y4 = y3 + xl @ wl\n    print(name, '4gemm err vs exact:', err(y4))\n    d4 = (y4 - y32).abs()\n    print(name, '4gemm vs ref fp32: max', d4.max().item(), 'viol_frac', (d4 > thr).float().mean().item())\n\ndef timeit(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\nwt = w.t().contiguous()\nxh, xl = split_dk(x)\nwh, wl = split_dk(w)\nwht, wlt = wh.t().contiguous(), wl.t().contiguous()\nprint('1 tf32 mm ms:', timeit(lambda: xh @ wht))\ndef f3():\n    y = xh @ wht\n    y += xh @ wlt\n    y += xl @ wht\n    return y\nprint('3 tf32 mm ms:', timeit(f3))\ndef full():\n    xh, xl = split_dk(x)\n    y = torch.mm(xh, wht)\n    y += torch.mm(xh, wlt)\n    y += torch.mm(xl, wht)\n    return y\nprint('split+3mm ms:', timeit(full))\nEOF\npython3 /workspace/dbg2.py\n"]
