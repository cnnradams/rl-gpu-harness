[1772.593443, "i", "cat > /workspace/test2dot.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\n\n@triton.jit\ndef _k2(a_ptr, bh_ptr, c_ptr, bias_ptr, M, N, K,\n        sam, sak, sbk, sbn, scm, scn,\n        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptrs)\n        acc "]
[1772.593631, "i", "= tl.dot(ah, bh, acc)\n        acc = tl.dot(al, bh, acc)\n        a_ptrs += BK * sak\n        bh_ptrs += BK * sbk\n    bias = tl.load(bias_ptr + rn)\n    acc = acc + bias[None, :]\n    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc)\n\nM, N, K = 16384, 4096, 4096\nworse = 0\nfor seed in range(5):\n    torch.manual_seed(seed)\n    x = torch.rand(M, K, device='cuda')\n    w = torch.nn.Linear(K, N, device='cuda')\n    ref = torch.nn.functional.linear(x, w.weight, w.bias)\n    wt = w.weight.t().contiguous()\n    wh = wt.half()\n    out = torch.empty(M, N, device='cuda')\n    BM, BN, BK, G, s, wp = 128, 128, 16, 16, 5, 4\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    _k2[grid](x, wh, out, w.bias, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)\n    torch.cuda.synchronize()\n    d = (out - ref).abs()\n    thr = 1e-4 + 1e-4 * ref.abs()\n    viol = (d > thr).sum().item()\n    print(f'seed {seed}"]
[1772.593718, "i", ": maxdiff {d.max().item():.3e} viol {viol}')\n    worse = max(worse, d.max().item())\n\ndef timeit(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    st = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return st.elapsed_time(e)/n\nprint('2-dot time ms:', timeit(lambda: _k2[grid](x, wh, out, w.bias, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)))\nEOF\npython3 /workspace/test2dot.py\n"]
