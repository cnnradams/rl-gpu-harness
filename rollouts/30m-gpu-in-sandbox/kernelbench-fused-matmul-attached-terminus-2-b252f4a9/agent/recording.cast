[58.302094, "o", "to run the evalutation on\r\n423:    backend: str, one of 'cuda', 'triton', 'tilelang', or 'cute'\r\n430:    assert torch.cuda.is_available(), \"CUDA is not available, cannot run Eval\"\r\n439:    # cuda/cute/thunderkittens are NVIDIA-only (triton/tilelang work on both)\r\n440:    if backend_lower in [\"cuda\", \"cute\", \"thunderkittens\"] and vendor == \"amd\":\r\n454:    torch.cuda.set_device(device)\r\n461:    metadata[\"hardware\"] = torch.cuda.get_device_name(device=device)\r\n470:                device.type == \"cuda\"\r\n491:    set_seed(seed_num)  # set seed for reproducible input\r\n498:        set_seed(seed_num)  # set seed for reproducible weights\r\n523:        torch.cuda.synchronize(device=device)  # not sure if this is too much\r\n561:            set_seed(seed_num)  # set seed for reproducible weights\r\n564:            original_model = original_model.to(device=device, dtype=precision)\r\n565:            custom_model = custom_model.to(device=device, dtype=precision)\r\n566:            torch.cuda.synchronize(device=device)\r\n594:        "]
[58.30221, "o", "    seed=seed_num,\r\n614:                torch.cuda.synchronize(device=device)\r\n615:                set_seed(seed_num)\r\n620:                model_new = custom_model.to(device=device, dtype=precision)\r\n621:                torch.cuda.synchronize(device=device)\r\n659:        torch.cuda.synchronize(device=device)\r\n660:        set_seed(seed_num)\r\n665:        model_new = custom_model.to(device=device, dtype=precision)\r\n666:        torch.cuda.synchronize(device=device)\r\n673:            inputs, # ideally cloned for extra safety but handled already in correctness check\r\n"]
