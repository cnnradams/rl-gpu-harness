[626.853866, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 32, 'GROUP': 8}, num_stages=4, num_warps=4),\n        triton.Config({'BM': 256, 'BN': 64, 'BK': 32, 'GROUP': 8}, num_stages=4, num_warps=4),\n        triton.Config({'BM': 64, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=4),\n        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _gemm_kernel(a_ptr, b_ptr, c_ptr, bias_ptr, M, N, K,\n       "]
[626.853951, "i", "          sam, sak, sbk, sbn, scm, scn,\n                 EVEN: tl.constexpr,\n                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\n    b_ptrs = b_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        if EVEN:\n            a = tl.load(a_ptrs)\n            b = tl.load(b_ptrs)\n        else:\n            kmask = rk[None, :] < K - k * BK\n            a = tl.load(a_ptrs, mask=(rm[:, None] < M) & kmask, other=0.0)\n            b = tl.load(b_ptrs, mask=(rk"]
[626.854116, "i", "[:, None] < K - k * BK)[:, None] & (rn[None, :] < N), other=0.0)\n        acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\n        a_ptrs += BK * sak\n        b_ptrs += BK * sbk\n    if EVEN:\n        bias = tl.load(bias_ptr + rn)\n    else:\n        bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0)\n    acc = acc + bias[None, :]\n    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\n    if EVEN:\n        tl.store(c_ptrs, acc)\n    else:\n        tl.store(c_ptrs, acc, mask=(rm[:, None] < M) & (rn[None, :] < N))\n\n\ndef _linear(x, w_t, bias):\n    M, K = x.shape\n    N = w_t.shape[1]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    even = (M % 256 == 0) and (N % 256 == 0) and (K % 64 == 0)\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    _gemm_kernel[grid](x, w_t, out, bias, M, N, K,\n                       x.stride(0), x.stride(1),\n                       w_t.stride(0), w_t.stride(1),\n                       out.stride(0), out.stride(1),\n                   "]
[626.854208, "i", "    EVEN=even)\n    return out\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        # Match reference RNG consumption exactly\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        with torch.no_grad():\n            f = 1.0 + float(scaling_factor)  # ref: y*scaling + y == (1+scaling)*y\n            self.register_buffer(\"w_t\", (self.matmul.weight * f).t().contiguous())\n            self.register_buffer(\"b\", self.matmul.bias * f)\n\n    def forward(self, x):\n        x = x.contiguous()\n        return _linear(x, self.w_t, self.b)\nEOF\ncat > /workspace/test2.py << 'EOF'\nimport sys, torch\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_init_inputs\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).cuda()\ntorch.manual_seed(42)\nnew = ModelNew(*get_init_inputs()).cuda()\nprint('weight equal:', tor"]
[626.854228, "i", "ch.equal(ref.matmul.weight, new.matmul.weight))\n\ntorch.manual_seed(123)\nx = torch.rand(16384, 4096, device='cuda')\nwith torch.no_grad():\n    y_ref = ref(x)\n    y_new = new(x)\nd = (y_ref - y_new).abs()\nthr = 1e-4 + 1e-4 * y_ref.abs()\nprint('max diff:', d.max().item(), 'viol:', (d > thr).sum().item(), 'allclose:', torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4))\n\ndef timeit(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\nwith torch.no_grad():\n    t_ref = timeit(lambda: ref(x))\n    t_new = timeit(lambda: new(x))\nprint(f'ref: {t_ref:.3f} ms, new: {t_new:.3f} ms, speedup: {t_ref/t_new:.2f}x')\nprint('allow_tf32 after:', torch.backends.cuda.matmul.allow_tf32)\nEOF\npython3 /workspace/test2.py\n"]
