[1303.163372, "i", "python3 - << 'EOF'\n# make sweep.py importable: guard the search part\nsrc = open('/workspace/sweep.py').read()\nhead, tail = src.split('results = []', 1)\ntail = 'results = []' + tail\ntail = '\\n'.join('    ' + l for l in tail.splitlines())\nopen('/workspace/sweep.py', 'w').write(head + 'if __name__ == \"__main__\":\\n' + tail + '\\n')\nEOF\ncat > /workspace/sweep2.py << 'EOF'\nimport sys\nsys.path.insert(0, '/workspace')\nfrom sweep import bench\nresults = []\nfor BM, BN in [(128, 128), (128, 64), (64, 128), (128, 256)]:\n    for BK in [16, 32, 64]:\n        for stages in [3, 4, 5, 6]:\n            for warps in [4, 8]:\n                for G in [4, 8, 16]:\n                    smem = (BM*BK*4 + 2*BN*BK*2) * stages\n                    if smem > 227*1024: continue\n                    ms = bench((BM, BN, BK, G), stages, warps)\n                    if ms is not None:\n                        results.append((ms, BM, BN, BK, stages, warps, G))\nresults.sort()\nfor r in results[:12]:\n    print(r)\nEOF\npython3 /workspace/sweep2.py\n"]
