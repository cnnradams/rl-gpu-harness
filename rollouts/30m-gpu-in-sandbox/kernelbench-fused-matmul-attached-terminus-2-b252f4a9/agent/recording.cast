[1010.672196, "o", "\u001b[?2004h> "]
[1010.672767, "o", "    _split_kernel[(triton.cdiv(n, BLOCK),)](x, hi, lo, n, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[1010.672829, "o", "\u001b[?2004h> "]
[1010.672964, "o", "    return hi, lo\r\n\u001b[?2004l\r"]
[1010.673118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1010.673254, "o", "\u001b[?2004h"]
[1010.673341, "o", "> "]
[1010.673383, "o", "_CONFIGS = [\r\n"]
[1010.673455, "o", "\u001b[?2004l\r"]
[1010.673495, "o", "\u001b[?2004h> "]
[1010.674054, "o", "    triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.674212, "o", "\u001b[?2004h> "]
[1010.674771, "o", "    triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.675343, "o", "    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.675364, "o", "\u001b[?2004h"]
[1010.675392, "o", "> "]
[1010.67602, "o", "    triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.676587, "o", "    triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.676611, "o", "\u001b[?2004h"]
[1010.676707, "o", "> "]
[1010.677235, "o", "    triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.677258, "o", "\u001b[?2004h"]
[1010.677351, "o", "> "]
[1010.677878, "o", "    triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GROUP': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.6779, "o", "\u001b[?2004h"]
[1010.678027, "o", "> "]
[1010.678539, "o", "    triton.Config({'BM': 256, 'BN': 64, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.678595, "o", "\u001b[?2004h"]
[1010.678643, "o", "> "]
[1010.679211, "o", "    triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r"]
[1010.6793, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[1010.679364, "o", "\u001b[?2004h"]
[1010.679427, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1010.679495, "o", "> \r\n\u001b[?2004l\r"]
[1010.679531, "o", "\u001b[?2004h"]
[1010.679544, "o", "> "]
[1010.679994, "o", "@triton.autotune(configs=_CONFIGS, key=['M', 'N', 'K'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.680063, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1010.680182, "o", "\u001b[?2004h> "]
[1010.680628, "o", "def _gemm3_fusedsplit(a_ptr, bh_ptr, bl_ptr, c_ptr, bias_ptr, M, N, K,\r\n\u001b[?2004l\r"]
[1010.680688, "o", "\u001b[?2004h> "]
[1010.681102, "o", "                      sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.681791, "o", "                      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.682058, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.682251, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1010.682277, "o", "\u001b[?2004h"]
[1010.682384, "o", "> "]
[1010.682524, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1010.682614, "o", "\u001b[?2004h> "]
[1010.682851, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.683044, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1010.683149, "o", "\u001b[?2004h> "]
[1010.683591, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.683936, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r"]
[1010.68396, "o", "\u001b[?2004h"]
[1010.684021, "o", "> "]
[1010.684279, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1010.684305, "o", "\u001b[?2004h"]
[1010.684427, "o", "> "]
[1010.684684, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.684942, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1010.685, "o", "\u001b[?2004h"]
[1010.685017, "o", "> "]
[1010.6852, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[1010.685248, "o", "\u001b[?2004h"]
[1010.685273, "o", "> "]
[1010.685683, "o", "    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1010.685768, "o", "\u001b[?2004h> "]
[1010.686154, "o", "    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1010.686255, "o", "\u001b[?2004h> "]
[1010.68662, "o", "    bl_ptrs = bl_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1010.686716, "o", "\u001b[?2004h> "]
[1010.687008, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1010.687032, "o", "\u001b[?2004h"]
[1010.68714, "o", "> "]
[1010.687341, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[1010.687457, "o", "\u001b[?2004h> "]
[1010.687622, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[1010.687773, "o", "\u001b[?2004h> "]
[1010.687909, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1010.687996, "o", "\u001b[?2004h> "]
[1010.688335, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1010.688442, "o", "\u001b[?2004h> "]
[1010.688607, "o", "        bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r"]
[1010.688669, "o", "\u001b[?2004h> "]
[1010.688928, "o", "        bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.689126, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[1010.689171, "o", "\u001b[?2004h"]
[1010.689193, "o", "> "]
[1010.689401, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[1010.689487, "o", "\u001b[?2004h> "]
[1010.689678, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[1010.689729, "o", "\u001b[?2004h"]
[1010.689795, "o", "> "]
[1010.689977, "o", "        a_ptrs += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.690151, "o", "        bh_ptrs += BK * sbk\r\n\u001b[?2004l\r"]
[1010.690234, "o", "\u001b[?2004h> "]
[1010.690384, "o", "        bl_ptrs += BK * sbk\r\n\u001b[?2004l\r"]
[1010.690465, "o", "\u001b[?2004h> "]
[1010.69067, "o", "    bias = tl.load(bias_ptr + rn)\r\n\u001b[?2004l\r"]
[1010.690763, "o", "\u001b[?2004h> "]
[1010.690911, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1010.690995, "o", "\u001b[?2004h> "]
[1010.691393, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.691543, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[1010.691594, "o", "\u001b[?2004h"]
[1010.69161, "o", "> \r\n"]
[1010.691658, "o", "\u001b[?2004l\r"]
[1010.691716, "o", "\u001b[?2004h> "]
[1010.691734, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1010.691804, "o", "> "]
[1010.691984, "o", "def _linear(x, wh_t, wl_t, bias):\r\n\u001b[?2004l\r"]
[1010.692074, "o", "\u001b[?2004h> "]
[1010.692173, "o", "    M, K = x.shape\r\n\u001b[?2004l\r"]
[1010.692252, "o", "\u001b[?2004h> "]
[1010.692379, "o", "    N = wh_t.shape[1]\r\n\u001b[?2004l\r"]
[1010.692467, "o", "\u001b[?2004h> "]
[1010.692847, "o", "    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1010.692868, "o", "\u001b[?2004h"]
[1010.692998, "o", "> "]
[1010.69345, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.693783, "o", "    _gemm3_fusedsplit[grid](x, wh_t, wl_t, out, bias, M, N, K,\r\n\u001b[?2004l\r"]
[1010.693804, "o", "\u001b[?2004h"]
[1010.693878, "o", "> "]
[1010.694189, "o", "                            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.694493, "o", "                            wh_t.stride(0), wh_t.stride(1),\r\n\u001b[?2004l\r"]
[1010.694642, "o", "\u001b[?2004h> "]
[1010.694876, "o", "                            out.stride(0), out.stride(1))\r\n\u001b[?2004l\r"]
[1010.694896, "o", "\u001b[?2004h"]
[1010.695018, "o", ">     return out\r\n\u001b[?2004l\r"]
[1010.695038, "o", "\u001b[?2004h"]
[1010.695121, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.695139, "o", "\r\n\u001b[?2004l\r"]
[1010.695196, "o", "\u001b[?2004h> "]
[1010.695345, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1010.695427, "o", "\u001b[?2004h> "]
[1010.695761, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1010.69578, "o", "\u001b[?2004h"]
[1010.695845, "o", "> "]
[1010.696039, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[1010.69606, "o", "\u001b[?2004h"]
[1010.696181, "o", "> "]
[1010.696378, "o", "        # Match reference RNG consumption exactly\r\n\u001b[?2004l\r"]
[1010.696465, "o", "\u001b[?2004h> "]
[1010.696748, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1010.696769, "o", "\u001b[?2004h"]
[1010.696898, "o", "> "]
[1010.697051, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1010.697099, "o", "\u001b[?2004h"]
[1010.697154, "o", "> "]
[1010.697285, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[1010.697321, "o", "\u001b[?2004h"]
[1010.697345, "o", "> "]
[1010.697791, "o", "            f = 1.0 + float(scaling_factor)  # ref: y*scaling + y == (1+scaling)*y\r\n\u001b[?2004l\r"]
[1010.69781, "o", "\u001b[?2004h"]
[1010.6979, "o", "> "]
[1010.698124, "o", "            ws = self.matmul.weight * f\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.6985, "o", "            self.register_buffer(\"w_t32\", ws.t().contiguous())\r\n\u001b[?2004l\r"]
[1010.698555, "o", "\u001b[?2004h"]
[1010.698622, "o", "> "]
[1010.698978, "o", "            self.register_buffer(\"b\", (self.matmul.bias * f).clone())\r\n\u001b[?2004l\r"]
[1010.699, "o", "\u001b[?2004h"]
[1010.699126, "o", "> "]
[1010.69931, "o", "            self._rebuild_fp16()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1010.699336, "o", "\u001b[?2004h"]
[1010.69946, "o", "> "]
[1010.699525, "o", "    @torch.no_grad()\r\n\u001b[?2004l\r"]
[1010.69959, "o", "\u001b[?2004h> "]
[1010.69976, "o", "    def _rebuild_fp16(self):\r\n\u001b[?2004l\r"]
[1010.699794, "o", "\u001b[?2004h"]
[1010.69985, "o", "> "]
[1010.699987, "o", "        ws_t = self.w_t32\r\n\u001b[?2004l\r"]
[1010.700073, "o", "\u001b[?2004h> "]
[1010.700336, "o", "        wh = ws_t.to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.700697, "o", "        wl = (ws_t - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[1010.70072, "o", "\u001b[?2004h"]
[1010.70081, "o", "> "]
[1010.700959, "o", "        self.wh_t = wh.contiguous()\r\n\u001b[?2004l\r"]
[1010.70098, "o", "\u001b[?2004h"]
[1010.7011, "o", "> "]
[1010.701245, "o", "        self.wl_t = wl.contiguous()\r\n\u001b[?2004l\r"]
[1010.701325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1010.701363, "o", "\u001b[?2004h"]
[1010.701436, "o", "> "]
[1010.70156, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1010.701709, "o", "\u001b[?2004h> "]
[1010.702103, "o", "        # The evaluator may call .to(dtype=torch.float32) which would convert our\r\n\u001b[?2004l\r"]
[1010.702194, "o", "\u001b[?2004h> "]
[1010.702641, "o", "        # fp16 splits; rebuild them lazily (no-op after first call).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.703142, "o", "        if self.wh_t.dtype != torch.float16 or self.wh_t.device != x.device:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.703395, "o", "            self._rebuild_fp16()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.703625, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1010.703947, "o", "        return _linear(x, self.wh_t, self.wl_t, self.b)\r\n\u001b[?2004l\r"]
[1010.704031, "o", "\u001b[?2004h> EOF"]
[1010.704052, "o", "\r\n\u001b[?2004l\r"]
[1010.708293, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1010.708934, "o", "python3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report2.json 2>&1 | tail -30\r\n\u001b[?2004l\r"]
[1026.121171, "o", "  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.66,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.66,\r\n    \"std\": 0.102,\r\n    \"min\": 2.58,\r\n    \"max\": 2.84,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.00875,\r\n    \"min\": 11.4,\r\n    \"max\": 11.4,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"734cd9292934340de3528b41ec76a99ac4ccf793e6c0b28bdc2b3c0b9985d046\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.285714285714286\r\n}\r\n"]
[1026.198607, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1080.780015, "i", "cat > /workspace/test_graph.py << 'EOF'\nimport sys, torch\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nimport solution\nfrom solution import ModelNew, _gemm3_fusedsplit\nimport triton\n\ntorch.manual_seed(42)\nnew = ModelNew(4096, 4096, 0.5).cuda()\nx = torch.rand(16384, 4096, device='cuda')\n# trigger autotune\nwith torch.no_grad():\n    y = new(x)\nprint('best config:', _gemm3_fusedsplit.best_config)\n\nwith torch.no_grad():\n    # warm up side stream\n    s = torch.cuda.Stream()\n    s.wait_stream(torch.cuda.current_stream())\n    with torch.cuda.stream(s):\n        for _ in range(3):\n            y2 = new(x)\n    torch.cuda.current_stream().wait_stream(s)\n    g = torch.cuda.CUDAGraph()\n    with torch.cuda.graph(g):\n        out = new(x)\n\ndef timeit(fn, n=50):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    st = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return st.elaps"]
[1080.780247, "i", "ed_time(e)/n\n\nwith torch.no_grad():\n    t_normal = timeit(lambda: new(x))\n    t_graph = timeit(lambda: g.replay())\nprint(f'normal: {t_normal:.3f} ms, graph: {t_graph:.3f} ms')\n# verify graph output correctness\ntorch.cuda.synchronize()\nprint('diff normal vs graph:', (out - y).abs().max().item())\nEOF\npython3 /workspace/test_graph.py\n"]
[1080.780422, "o", "cat > /workspace/test_graph.py << 'EOF'\r\n\u001b[?2004l\r"]
[1080.780549, "o", "\u001b[?2004h"]
[1080.780657, "o", "> "]
[1080.780708, "o", "import sys, torch\r\n\u001b[?2004l\r"]
[1080.780811, "o", "\u001b[?2004h> "]
[1080.781036, "o", "sys.path.insert(0, '/opt/task')\r\n\u001b[?2004l\r"]
[1080.78106, "o", "\u001b[?2004h"]
[1080.781186, "o", "> "]
[1080.781393, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.781521, "o", "import solution\r\n\u001b[?2004l\r"]
[1080.781628, "o", "\u001b[?2004h> "]
[1080.781981, "o", "from solution import ModelNew, _gemm3_fusedsplit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.782092, "o", "import triton\r\n\u001b[?2004l\r"]
[1080.782123, "o", "\u001b[?2004h"]
[1080.782249, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.782393, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[1080.782488, "o", "\u001b[?2004h> "]
[1080.782804, "o", "new = ModelNew(4096, 4096, 0.5).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.783094, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[1080.783119, "o", "\u001b[?2004h"]
[1080.783214, "o", "> "]
[1080.783324, "o", "# trigger autotune\r\n\u001b[?2004l\r"]
[1080.783346, "o", "\u001b[?2004h"]
[1080.783358, "o", "> "]
[1080.783532, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[1080.78365, "o", "\u001b[?2004h> "]
[1080.783706, "o", "    y = new(x)\r\n\u001b[?2004l\r"]
[1080.783843, "o", "\u001b[?2004h> "]
[1080.784194, "o", "print('best config:', _gemm3_fusedsplit.best_config)\r\n\u001b[?2004l\r"]
[1080.784221, "o", "\u001b[?2004h"]
[1080.784311, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1080.784329, "o", "> "]
[1080.784509, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[1080.784609, "o", "\u001b[?2004h> "]
[1080.784811, "o", "    # warm up side stream\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.785007, "o", "    s = torch.cuda.Stream()\r\n\u001b[?2004l\r"]
[1080.785108, "o", "\u001b[?2004h> "]
[1080.785481, "o", "    s.wait_stream(torch.cuda.current_stream())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.785758, "o", "    with torch.cuda.stream(s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.786001, "o", "        for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.786178, "o", "            y2 = new(x)\r\n\u001b[?2004l\r"]
[1080.786326, "o", "\u001b[?2004h> "]
[1080.786561, "o", "    torch.cuda.current_stream().wait_stream(s)\r\n\u001b[?2004l\r"]
[1080.786689, "o", "\u001b[?2004h> "]
[1080.786906, "o", "    g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.787177, "o", "    with torch.cuda.graph(g):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.787338, "o", "        out = new(x)\r\n\u001b[?2004l\r"]
[1080.787362, "o", "\u001b[?2004h"]
[1080.787485, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.787696, "o", "def timeit(fn, n=50):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.787894, "o", "    for _ in range(10): fn()\r\n\u001b[?2004l\r"]
[1080.787984, "o", "\u001b[?2004h> "]
[1080.788172, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1080.788197, "o", "\u001b[?2004h"]
[1080.788302, "o", "> "]
[1080.788855, "o", "    st = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.788946, "o", "    st.record()\r\n\u001b[?2004l\r"]
[1080.789029, "o", "\u001b[?2004h> "]
[1080.789204, "o", "    for _ in range(n): fn()\r\n\u001b[?2004l\r"]
[1080.789301, "o", "\u001b[?2004h> "]
[1080.789537, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1080.789621, "o", "\u001b[?2004h> "]
[1080.789812, "o", "    return st.elapsed_time(e)/n\r\n\u001b[?2004l\r"]
[1080.7899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1080.789925, "o", "\u001b[?2004h"]
[1080.790046, "o", "> "]
[1080.790136, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1080.790158, "o", "> "]
[1080.7905, "o", "    t_normal = timeit(lambda: new(x))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.790756, "o", "    t_graph = timeit(lambda: g.replay())\r\n\u001b[?2004l\r"]
[1080.79081, "o", "\u001b[?2004h"]
[1080.790826, "o", "> "]
[1080.791213, "o", "print(f'normal: {t_normal:.3f} ms, graph: {t_graph:.3f} ms')\r\n\u001b[?2004l\r"]
[1080.791236, "o", "\u001b[?2004h"]
[1080.791362, "o", "> "]
[1080.791522, "o", "# verify graph output correctness\r\n\u001b[?2004l\r\u001b[?2004h"]
[1080.791614, "o", "> "]
[1080.791787, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1080.792161, "o", "print('diff normal vs graph:', (out - y).abs().max().item())\r\n\u001b[?2004l\r"]
[1080.792216, "o", "\u001b[?2004h> "]
[1080.792274, "o", "EOF\r\n\u001b[?2004l\r"]
[1080.796433, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1080.796645, "o", "python3 /workspace/test_graph.py\r\n\u001b[?2004l\r"]
[1083.584962, "o", "best config: BM: 256, BN: 128, BK: 64, GROUP: 8, num_warps: 8, num_ctas: 1, num_stages: 3, maxnreg: None\r\n"]
[1083.940141, "o", "normal: 2.902 ms, graph: 2.839 ms\r\n"]
[1083.956003, "o", "diff normal vs graph: 0.0\r\n"]
[1084.314153, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1162.917303, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, triton, itertools\nimport triton.language as tl\n\n@triton.jit\ndef _k(a_ptr, bh_ptr, bl_ptr, c_ptr, bias_ptr, M, N, K,\n       sam, sak, sbk, sbn, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    bl_ptrs = bl_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        a = tl.load(a_ptrs)\n        ah = a.to(tl.float16)\n        al = (a - ah"]
[1162.917379, "i", ".to(tl.float32)).to(tl.float16)\n        bh = tl.load(bh_ptrs)\n        bl = tl.load(bl_ptrs)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        a_ptrs += BK * sak\n        bh_ptrs += BK * sbk\n        bl_ptrs += BK * sbk\n    bias = tl.load(bias_ptr + rn)\n    acc = acc + bias[None, :]\n    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc)\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nwt = w.t().contiguous()\nwh = wt.half(); wl = (wt - wh.float()).half()\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\n\ndef bench(cfg, stages, warps):\n    BM, BN, BK, G = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    try:\n        fn = lambda: _k[grid](x, wh, wl, out, b, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=stages, num_warps=warps)\n        fn()\n        torch.c"]
[1162.917406, "i", "uda.synchronize()\n        ms = triton.testing.do_bench(fn, warmup=10, rep=30)\n        return ms\n    except Exception as e:\n        return None\n\nresults = []\nfor BM in [128, 256]:\n    for BN in [128, 256]:\n        for BK in [32, 64, 128]:\n            for stages in [3, 4, 5]:\n                for warps in [8]:\n                    smem = (BM*BK*4 + 2*BN*BK*2) * stages\n                    if smem > 227*1024: continue\n                    ms = bench((BM, BN, BK, 8), stages, warps)\n                    if ms is not None:\n                        results.append((ms, BM, BN, BK, stages, warps))\nresults.sort()\nfor r in results[:10]:\n    print(r)\nEOF\npython3 /workspace/sweep.py\n"]
[1162.917694, "o", "cat > /workspace/sweep.py << 'EOF'\r\n\u001b[?2004l\r"]
