[869.653672, "o", "\u001b[?2004h"]
[869.653756, "o", "> "]
[869.653938, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.654359, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.654719, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.655007, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.655271, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.655523, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.655662, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[869.65571, "o", "\u001b[?2004h"]
[869.655724, "o", "> "]
[869.656049, "o", "    ah_ptrs = ah_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
