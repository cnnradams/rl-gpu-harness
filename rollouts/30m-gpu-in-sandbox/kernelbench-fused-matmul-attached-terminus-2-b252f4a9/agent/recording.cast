[1234.081772, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch, triton\nexec(open('/workspace/sweep.py').read().split('results = []')[0])\nresults = []\nfor BM, BN in [(128, 128), (128, 64), (64, 128), (128, 256)]:\n    for BK in [16, 32, 64]:\n        for stages in [3, 4, 5, 6]:\n            for warps in [4, 8]:\n                for G in [4, 8, 16]:\n                    smem = (BM*BK*4 + 2*BN*BK*2) * stages\n                    if smem > 227*1024: continue\n                    ms = bench((BM, BN, BK, G), stages, warps)\n                    if ms is not None:\n                        results.append((ms, BM, BN, BK, stages, warps, G))\nresults.sort()\nfor r in results[:12]:\n    print(r)\nEOF\npython3 /workspace/sweep2.py\n"]
