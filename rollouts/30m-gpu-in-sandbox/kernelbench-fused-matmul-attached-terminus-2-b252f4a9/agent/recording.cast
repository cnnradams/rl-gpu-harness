[1538.105451, "o", "\u001b[?2004h"]
[1538.105584, "o", "> "]
[1538.1058, "o", "        self.wl_t = wl.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1538.105823, "o", "\r\n\u001b[?2004l\r"]
[1538.105947, "o", "\u001b[?2004h> "]
[1538.106071, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1538.106214, "o", "\u001b[?2004h> "]
[1538.106787, "o", "        # The evaluator may call .to(dtype=torch.float32) which would convert our\r\n\u001b[?2004l\r\u001b[?2004h"]
[1538.106871, "o", "> "]
[1538.107299, "o", "        # fp16 splits; rebuild them lazily (no-op after first call).\r\n\u001b[?2004l\r"]
[1538.107322, "o", "\u001b[?2004h"]
[1538.107402, "o", "> "]
[1538.107956, "o", "        if self.wh_t.dtype != torch.float16 or self.wh_t.device != x.device:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1538.108181, "o", "            self._rebuild_fp16()\r\n\u001b[?2004l\r"]
[1538.108284, "o", "\u001b[?2004h> "]
[1538.108451, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[1538.108525, "o", "\u001b[?2004h"]
[1538.10855, "o", "> "]
[1538.108899, "o", "        return _linear(x, self.wh_t, self.wl_t, self.b)\r\n\u001b[?2004l\r"]
[1538.109006, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1538.111884, "o", "\u001b[?2004h"]
