[767.70076, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _split_kernel(x_ptr, hi_ptr, lo_ptr, n, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    off = pid * BLOCK + tl.arange(0, BLOCK)\n    m = off < n\n    x = tl.load(x_ptr + off, mask=m)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    tl.store(hi_ptr + off, hi, mask=m)\n    tl.store(lo_ptr + off, lo, mask=m)\n\n\ndef _split_fp16(x):\n    hi = torch.empty_like(x, dtype=torch.float16)\n    lo = torch.empty_like(x, dtype=torch.float16)\n    n = x.numel()\n    BLOCK = 4096\n    _split_kernel[(triton.cdiv(n, BLOCK),)](x, hi, lo, n, BLOCK=BLOCK, num_warps=4)\n    return hi, lo\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP': 8},"]
[767.700847, "i", " num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=4),\n        triton.Config({'BM': 256, 'BN': 64, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=4),\n        triton.Config({'BM': 64, 'BN': 128, 'BK': 64, 'GROUP': 8}, num_stages=4, num_warps=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _gemm3_kernel(ah_ptr, al_ptr, bh_ptr, bl_ptr, c_ptr, bias_ptr, M, N, K,\n                  sam, sak, sbk, sbn, scm, scn,\n                  BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\n    pid_m = group_id * GROUP + (pid % group_size)\n    p"]
[767.701007, "i", "id_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    ah_ptrs = ah_ptr + rm[:, None] * sam + rk[None, :] * sak\n    al_ptrs = al_ptr + rm[:, None] * sam + rk[None, :] * sak\n    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    bl_ptrs = bl_ptr + rk[:, None] * sbk + rn[None, :] * sbn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BK)):\n        ah = tl.load(ah_ptrs)\n        al = tl.load(al_ptrs)\n        bh = tl.load(bh_ptrs)\n        bl = tl.load(bl_ptrs)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        ah_ptrs += BK * sak\n        al_ptrs += BK * sak\n        bh_ptrs += BK * sbk\n        bl_ptrs += BK * sbk\n    bias = tl.load(bias_ptr + rn)\n    acc = acc + bias[None, :]\n    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(c_ptrs, acc)\n\n\ndef _linear(x, wh_t, wl_t, bias):\n    M, K = x.shape\n    N = wh_t.sha"]
[767.701102, "i", "pe[1]\n    xh, xl = _split_fp16(x)\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n    _gemm3_kernel[grid](xh, xl, wh_t, wl_t, out, bias, M, N, K,\n                        xh.stride(0), xh.stride(1),\n                        wh_t.stride(0), wh_t.stride(1),\n                        out.stride(0), out.stride(1))\n    return out\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        # Match reference RNG consumption exactly\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        with torch.no_grad():\n            f = 1.0 + float(scaling_factor)  # ref: y*scaling + y == (1+scaling)*y\n            ws = self.matmul.weight * f\n            wh = ws.to(torch.float16)\n            wl = (ws - wh.to(torch.float32)).to(torch.float16)\n            self.register_buffer(\"wh_t\", wh.t().conti"]
[767.701128, "i", "guous())\n            self.register_buffer(\"wl_t\", wl.t().contiguous())\n            self.register_buffer(\"b\", (self.matmul.bias * f).clone())\n\n    def forward(self, x):\n        x = x.contiguous()\n        return _linear(x, self.wh_t, self.wl_t, self.b)\nEOF\npython3 /workspace/test2.py\n"]
