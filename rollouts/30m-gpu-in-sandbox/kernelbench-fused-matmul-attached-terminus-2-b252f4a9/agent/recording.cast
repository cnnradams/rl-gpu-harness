[626.893686, "o", "\u001b[?2004h"]
[626.893779, "o", "> "]
[626.894293, "o", "    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
