[869.65985, "o", "\u001b[?2004h"]
[869.659884, "o", "> "]
[869.660054, "o", "        al_ptrs += BK * sak\r\n\u001b[?2004l\r"]
[869.660196, "o", "\u001b[?2004h> "]
[869.660302, "o", "        bh_ptrs += BK * sbk\r\n\u001b[?2004l\r"]
[869.660324, "o", "\u001b[?2004h"]
[869.660446, "o", "> "]
