[466.213535, "i", "cat > /workspace/dbg3.py << 'EOF'\nimport torch\ntorch.manual_seed(0)\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.nn.Linear(K, N).cuda()\n\ndef timeit(fn, n=30):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(n): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/n\n\nprint('fp32_precision default:', torch.backends.cuda.matmul.fp32_precision)\nprint('fp32 linear ms:', timeit(lambda: torch.nn.functional.linear(x, w.weight, w.bias)))\n\ndef ref_fwd(x):\n    y = torch.nn.functional.linear(x, w.weight, w.bias)\n    o = y.clone()\n    y = y * 0.5\n    y = y + o\n    return y\nprint('ref forward ms:', timeit(lambda: ref_fwd(x)))\n\nimport torch\nf = torch.nn.functional.linear\ncm = torch.compile(lambda x: f(x, w.weight, w.bias), mode='max-autotune', fullgraph=True)\nprint('compiled fp32 linear ms:', timeit(lambda: cm(x)))\nEOF\npython3 /workspace/dbg3.py"]
[466.213762, "i", "\n"]
