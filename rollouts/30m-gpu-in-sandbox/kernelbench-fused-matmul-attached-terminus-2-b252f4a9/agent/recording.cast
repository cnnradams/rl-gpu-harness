[1614.964041, "i", "cat > /workspace/cfgtest.py << 'EOF'\nimport sys, torch, triton\nsys.path.insert(0, '/workspace')\nimport triton.language as tl\nfrom sweep import _k  # non-autotuned raw kernel\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(7)\nx = torch.rand(M, K, device='cuda')\nw = (torch.rand(N, K, device='cuda') * 2 - 1) / 64\nwt = w.t().contiguous()\nwh = wt.half(); wl = (wt - wh.float()).half()\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\nref = torch.nn.functional.linear(x, w, b)\n\ncfgs = [\n    (128, 128, 32, 4, 3, 8),\n    (128, 128, 16, 16, 5, 4),\n    (128, 128, 16, 4, 5, 4),\n    (128, 128, 16, 8, 3, 8),\n    (128, 128, 32, 8, 3, 8),\n    (128, 128, 16, 16, 6, 8),\n    (128, 128, 32, 4, 4, 8),\n    (256, 128, 32, 8, 4, 8),\n    (128, 256, 32, 8, 3, 8),\n    (64, 256, 64, 8, 4, 8),\n]\nfor (BM, BN, BK, G, s, wp) in cfgs:\n    out.fill_(float('nan'))\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    try:\n        _k[grid](x, wh, wl, out, b, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), "]
[1614.964248, "i", "out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)\n        torch.cuda.synchronize()\n        d = (out - ref).abs().max().item()\n        print(BM, BN, BK, G, s, wp, 'maxdiff:', d)\n    except Exception as e:\n        print(BM, BN, BK, G, s, wp, 'EXC:', str(e)[:100])\nEOF\npython3 /workspace/cfgtest.py\n"]
