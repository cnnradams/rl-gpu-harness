[1698.35403, "o", "[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.48,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.48,\r\n    \"std\": 0.0103,\r\n    \"min\": 2.46,\r\n    \"max\": 2.51,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0531,\r\n    \"min\": 11.4,\r\n    \"max\": 11.6,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"766ef9c01402b2aa2ffc26a677da5743c2714790bb33d36ece0f99e66cbc4d00\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.596774193548387\r\n}\r\n"]
