[869.66288, "o", "\u001b[?2004h"]
[869.662932, "o", "> "]
[869.663215, "o", "                      sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[869.663253, "o", "\u001b[?2004h"]
[869.663265, "o", "> "]
[869.663831, "o", "                      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP: tl.constexpr):\r\n\u001b[?2004l\r"]
[869.663974, "o", "\u001b[?2004h> "]
[869.664078, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.664146, "o", "> "]
[869.664355, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.664519, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[869.6646, "o", "\u001b[?2004h> "]
[869.664756, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[869.66484, "o", "\u001b[?2004h> "]
[869.664993, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[869.665015, "o", "\u001b[?2004h"]
[869.665105, "o", "> "]
[869.665419, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[869.665441, "o", "\u001b[?2004h"]
[869.665516, "o", "> "]
[869.665836, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.666119, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.666366, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[869.666468, "o", "\u001b[?2004h> "]
[869.666673, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[869.666719, "o", "\u001b[?2004h"]
[869.666783, "o", "> "]
[869.666925, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[869.666947, "o", "\u001b[?2004h"]
[869.667075, "o", "> "]
[869.667357, "o", "    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[869.667381, "o", "\u001b[?2004h"]
[869.667471, "o", "> "]
[869.667805, "o", "    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[869.667902, "o", "\u001b[?2004h> "]
[869.668245, "o", "    bl_ptrs = bl_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[869.668334, "o", "\u001b[?2004h> "]
[869.668596, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[869.668683, "o", "\u001b[?2004h> "]
[869.668947, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.669146, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.669169, "o", "> "]
[869.66942, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.669716, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[869.669866, "o", "\u001b[?2004h> "]
[869.669972, "o", "        bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r"]
[869.669994, "o", "\u001b[?2004h"]
[869.670075, "o", "> "]
[869.670267, "o", "        bl = tl.load(bl_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.670466, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[869.670589, "o", "\u001b[?2004h> "]
[869.670735, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[869.670782, "o", "\u001b[?2004h"]
[869.670803, "o", "> "]
[869.671064, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.671294, "o", "        a_ptrs += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.671457, "o", "        bh_ptrs += BK * sbk\r\n\u001b[?2004l\r"]
[869.671481, "o", "\u001b[?2004h"]
[869.671549, "o", "> "]
[869.671699, "o", "        bl_ptrs += BK * sbk\r\n\u001b[?2004l\r"]
[869.67178, "o", "\u001b[?2004h> "]
[869.672023, "o", "    bias = tl.load(bias_ptr + rn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.672267, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.672606, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[869.672663, "o", "\u001b[?2004h> "]
[869.672823, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[869.672912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[869.672977, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[869.673026, "o", "\u001b[?2004h"]
[869.67305, "o", "> "]
[869.673237, "o", "USE_FUSED_SPLIT = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[869.67332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[869.67336, "o", "\u001b[?2004h"]
[869.673414, "o", "> "]
[869.673657, "o", "def _linear(x, wh_t, wl_t, bias):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.673771, "o", "    M, K = x.shape\r\n\u001b[?2004l\r"]
[869.673886, "o", "\u001b[?2004h> "]
[869.674, "o", "    N = wh_t.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.674074, "o", "> "]
[869.674488, "o", "    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.674955, "o", "    grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[869.674978, "o", "\u001b[?2004h"]
[869.675105, "o", "> "]
[869.675193, "o", "    if USE_FUSED_SPLIT:\r\n\u001b[?2004l\r\u001b[?2004h"]
[869.675238, "o", "> "]
[869.675622, "o", "        _gemm3_fusedsplit[grid](x, wh_t, wl_t, out, bias, M, N, K,\r\n\u001b[?2004l\r"]
[869.675648, "o", "\u001b[?2004h"]
[869.675769, "o", "> "]
[869.676079, "o", "                                x.stride(0), x.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[869.676442, "o", "                                wh_t.stride(0), wh_t.stride(1),\r\n\u001b[?2004l\r"]
[869.676487, "o", "\u001b[?2004h"]
[869.676553, "o", "> "]
[869.676873, "o", "                                out.stride(0), out.stride(1))\r\n\u001b[?2004l\r"]
[869.676896, "o", "\u001b[?2004h"]
[869.67702, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
