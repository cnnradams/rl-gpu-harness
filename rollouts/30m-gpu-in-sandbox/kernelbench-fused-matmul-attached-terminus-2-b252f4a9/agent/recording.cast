[1772.597079, "o", "\u001b[?2004h> "]
[1772.597249, "o", "    width = GROUP * grid_n\r\n\u001b[?2004l\r"]
[1772.597366, "o", "\u001b[?2004h> "]
[1772.597537, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1772.597561, "o", "\u001b[?2004h"]
[1772.597695, "o", "> "]
[1772.597999, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP, GROUP)\r\n\u001b[?2004l\r"]
[1772.598139, "o", "\u001b[?2004h> "]
[1772.598496, "o", "    pid_m = group_id * GROUP + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.598837, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.599114, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1772.599141, "o", "\u001b[?2004h"]
[1772.599228, "o", "> "]
[1772.599458, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[1772.59955, "o", "\u001b[?2004h> "]
[1772.599783, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.600192, "o", "    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1772.600257, "o", "\u001b[?2004h"]
[1772.600279, "o", "> "]
[1772.600682, "o", "    bh_ptrs = bh_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1772.600785, "o", "\u001b[?2004h> "]
[1772.601074, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1772.601141, "o", "\u001b[?2004h> "]
[1772.60149, "o", "    for k in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.601698, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[1772.601788, "o", "\u001b[?2004h> "]
[1772.602043, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.602409, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1772.602437, "o", "\u001b[?2004h"]
[1772.602558, "o", "> "]
[1772.602761, "o", "        bh = tl.load(bh_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.60301, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[1772.603036, "o", "\u001b[?2004h"]
[1772.603123, "o", "> "]
[1772.603331, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[1772.603427, "o", "\u001b[?2004h> "]
[1772.603662, "o", "        a_ptrs += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.603867, "o", "        bh_ptrs += BK * sbk\r\n\u001b[?2004l\r"]
[1772.603961, "o", "\u001b[?2004h> "]
[1772.604243, "o", "    bias = tl.load(bias_ptr + rn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.604458, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1772.604522, "o", "\u001b[?2004h"]
[1772.604594, "o", "> "]
[1772.604944, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1772.605048, "o", "\u001b[?2004h> "]
[1772.605204, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[1772.605298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1772.605371, "o", "\u001b[?2004h> "]
[1772.605564, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[1772.605661, "o", "\u001b[?2004h> "]
[1772.605733, "o", "worse = 0\r\n\u001b[?2004l\r"]
[1772.605792, "o", "\u001b[?2004h> "]
[1772.606015, "o", "for seed in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.606217, "o", "    torch.manual_seed(seed)\r\n\u001b[?2004l\r"]
[1772.606315, "o", "\u001b[?2004h> "]
[1772.60663, "o", "    x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.607001, "o", "    w = torch.nn.Linear(K, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.607397, "o", "    ref = torch.nn.functional.linear(x, w.weight, w.bias)\r\n\u001b[?2004l\r"]
[1772.607486, "o", "\u001b[?2004h> "]
[1772.607728, "o", "    wt = w.weight.t().contiguous()\r\n\u001b[?2004l\r"]
[1772.607751, "o", "\u001b[?2004h"]
[1772.607852, "o", "> "]
[1772.607988, "o", "    wh = wt.half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1772.608013, "o", "> "]
[1772.608298, "o", "    out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r"]
[1772.608395, "o", "\u001b[?2004h> "]
[1772.608728, "o", "    BM, BN, BK, G, s, wp = 128, 128, 16, 16, 5, 4\r\n\u001b[?2004l\r"]
[1772.60882, "o", "\u001b[?2004h> "]
[1772.609166, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1772.609185, "o", "\u001b[?2004h"]
[1772.609226, "o", "> "]
[1772.610399, "o", "    _k2[grid](x, wh, out, w.bias, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)\r\n\u001b[?2004l\r"]
[1772.610476, "o", "\u001b[?2004h> "]
[1772.610677, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1772.610767, "o", "\u001b[?2004h> "]
[1772.610925, "o", "    d = (out - ref).abs()\r\n\u001b[?2004l\r"]
[1772.611041, "o", "\u001b[?2004h> "]
[1772.611231, "o", "    thr = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[1772.611321, "o", "\u001b[?2004h> "]
[1772.611593, "o", "    viol = (d > thr).sum().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.612034, "o", "    print(f'seed {seed}: maxdiff {d.max().item():.3e} viol {viol}')\r\n\u001b[?2004l\r"]
[1772.612058, "o", "\u001b[?2004h"]
[1772.612151, "o", "> "]
[1772.61237, "o", "    worse = max(worse, d.max().item())\r\n\u001b[?2004l\r"]
[1772.61252, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.612673, "o", "def timeit(fn, n=50):\r\n\u001b[?2004l\r"]
[1772.612779, "o", "\u001b[?2004h> "]
[1772.612942, "o", "    for _ in range(10): fn()\r\n\u001b[?2004l\r"]
[1772.613086, "o", "\u001b[?2004h> "]
[1772.613273, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.61385, "o", "    st = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1772.613874, "o", "\u001b[?2004h"]
[1772.614001, "o", "> "]
[1772.614049, "o", "    st.record()\r\n\u001b[?2004l\r"]
[1772.61412, "o", "\u001b[?2004h"]
[1772.614186, "o", "> "]
[1772.614304, "o", "    for _ in range(n): fn()\r\n\u001b[?2004l\r"]
[1772.614392, "o", "\u001b[?2004h> "]
[1772.614715, "o", "    e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.615004, "o", "    return st.elapsed_time(e)/n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1772.616467, "o", "print('2-dot time ms:', timeit(lambda: _k2[grid](x, wh, out, w.bias, M, N, K, x.stride(0), x.stride(1), wh.stride(0), wh.stride(1), out.stride(0), out.stride(1), BM=BM, BN=BN, BK=BK, GROUP=G, num_stages=s, num_warps=wp)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
