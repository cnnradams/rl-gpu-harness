[?2004l[?2004h>     __shared__ float sh[2][32];
[?2004l[?2004h>     int lane = tid & 31, wid = tid >> 5;
[?2004l[?2004h>     int nwarps = nthreads >> 5;
[?2004l[?2004h>     if (lane == 0) { sh[0][wid] = s1; sh[1][wid] = s2; }
[?2004l[?2004h>     __syncthreads();
[?2004l[?2004h>     if (wid == 0) {
[?2004l[?2004h>         s1 = (lane < nwarps) ? sh[0][lane] : 0.f;
[?2004l[?2004h>         s2 = (lane < nwarps) ? sh[1][lane] : 0.f;
