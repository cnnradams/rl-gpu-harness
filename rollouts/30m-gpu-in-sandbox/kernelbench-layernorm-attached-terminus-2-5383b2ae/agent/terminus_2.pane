[?2004l[?2004h> #define FULL_MASK 0xffffffffu
[?2004l[?2004h> 
[?2004l[?2004h> __global__ void ln_fused_kernel(const float4* __restrict__ x,
[?2004l[?2004h>                                 const float4* __restrict__ w,
[?2004l[?2004h>                                 const float4* __restrict__ b,
