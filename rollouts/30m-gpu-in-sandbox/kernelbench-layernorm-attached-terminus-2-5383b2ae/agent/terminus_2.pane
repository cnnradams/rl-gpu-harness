[?2004l[?2004h> 
[?2004l[?2004h> #define FULL_MASK 0xffffffffu
[?2004l[?2004h> 
[?2004l[?2004h> // mode: 0 = full fused, 1 = stats+barrier only, 2 = no barrier (wrong), 3 = full fused streaming loads
[?2004l[?2004h> template <int MODE>
[?2004l[?2004h> __global__ void ln_var_kernel(const float4* __restrict__ x,
[?2004l[?2004h>                               const float4* __restrict__ w,
[?2004l[?2004h>                               const float4* __restrict__ b,
[?2004l[?2004h>                               float4* __restrict__ out,
[?2004l[?2004h>                               float* __restrict__ partials,
[?2004l[?2004h>                               unsigned int* __restrict__ barCount,
