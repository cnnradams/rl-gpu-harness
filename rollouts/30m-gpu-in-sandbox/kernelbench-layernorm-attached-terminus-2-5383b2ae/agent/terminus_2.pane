[?2004l[?2004h> 
[?2004l[?2004h> tot = M*N
[?2004l[?2004h> g2 = (tot // CHUNK,)
[?2004l[?2004h> print('copy only:', timeit(lambda: _copy[g2](x, out, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)))
[?2004l[?2004h> print('stats only:', timeit(lambda: _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)))
[?2004l[?2004h> print('norm only:', timeit(lambda: _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W)))
[?2004l[?2004h> print('both:', timeit(lambda: (_ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W), _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W))))
