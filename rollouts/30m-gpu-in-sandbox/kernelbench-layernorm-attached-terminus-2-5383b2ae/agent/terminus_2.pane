[?2004l[?2004h>             partials[(m * S + s) * 2] = s1;
[?2004l[?2004h>             partials[(m * S + s) * 2 + 1] = s2;
[?2004l[?2004h>             __threadfence();
[?2004l[?2004h>             unsigned int old = atomicAdd(barCount, 1u);
[?2004l[?2004h>             if (old == gridDim.x - 1) {
[?2004l[?2004h>                 *barCount = 0u;
[?2004l[?2004h>                 __threadfence();
[?2004l[?2004h>                 atomicExch(barCount + 1, 1u);
[?2004l[?2004h>             }
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     if (tid == 0) {
[?2004l[?2004h>         volatile unsigned int* flag = barCount + 1;
[?2004l[?2004h>         while (*flag == 0u) { __nanosleep(64); }
[?2004l[?2004h>     }
[?2004l[?2004h>     __syncthreads();
[?2004l[?2004h>     __shared__ float smean, srstd;
[?2004l[?2004h>     if (wid == 0) {
[?2004l[?2004h>         const float* pr = partials + m * S * 2;
[?2004l[?2004h>         float t1 = 0.f, t2 = 0.f;
[?2004l[?2004h>         for (int i = lane; i < S; i += 32) {
[?2004l[?2004h>             t1 += pr[i * 2];
[?2004l[?2004h>             t2 += pr[i * 2 + 1];
[?2004l[?2004h>         }
[?2004l[?2004h>         for (int off = 16; off > 0; off >>= 1) {
[?2004l[?2004h>             t1 += __shfl_down_sync(FULL_MASK, t1, off);
[?2004l[?2004h>             t2 += __shfl_down_sync(FULL_MASK, t2, off);
[?2004l[?2004h>         }
[?2004l[?2004h>         if (lane == 0) {
[?2004l[?2004h>             float mean = t1 / N;
[?2004l[?2004h>             float var = t2 / N - mean * mean;
[?2004l[?2004h>             var = var < 0.f ? 0.f : var;
[?2004l[?2004h>             smean = mean;
[?2004l[?2004h>             srstd = rsqrtf(var + eps);
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     __syncthreads();
[?2004l[?2004h>     float mean = smean, rstd = srstd;
[?2004l[?2004h>     const float4* wr = w + s * n4;
[?2004l[?2004h>     const float4* br = b + s * n4;
[?2004l[?2004h>     float4* op = out + (long)m * (N / 4) + s * n4;
[?2004l[?2004h>     for (int i = tid; i < n4; i += nthreads) {
[?2004l[?2004h>         float4 v = xr[i];
[?2004l[?2004h>         float4 wv = wr[i];
[?2004l[?2004h>         float4 bv = br[i];
[?2004l[?2004h>         float4 o;
[?2004l[?2004h>         o.x = (v.x - mean) * rstd * wv.x + bv.x;
[?2004l[?2004h>         o.y = (v.y - mean) * rstd * wv.y + bv.y;
[?2004l[?2004h>         o.z = (v.z - mean) * rstd * wv.z + bv.z;
[?2004l[?2004h>         o.w = (v.w - mean) * rstd * wv.w + bv.w;
[?2004l[?2004h>         op[i] = o;
[?2004l[?2004h>     }
[?2004l[?2004h> }
