[?2004l[?2004h>     else if (mode == 2) ln_var_kernel<2><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);
[?2004l[?2004h>     else ln_var_kernel<3><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);
[?2004l[?2004h> }
