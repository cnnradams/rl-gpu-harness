[?2004l[?2004h>     int s = pid % S;
[?2004l[?2004h>     int n4 = N / 4 / S;
[?2004l[?2004h>     int tid = threadIdx.x;
[?2004l[?2004h>     int nthreads = blockDim.x;
[?2004l[?2004h>     const float4* xr = x + (long)m * (N / 4) + s * n4;
[?2004l[?2004h>     float s1 = 0.f, s2 = 0.f;
[?2004l[?2004h>     for (int i = tid; i < n4; i += nthreads) {
[?2004l[?2004h>         float4 v;
[?2004l[?2004h>         if (MODE == 3) v = __ldcs(&xr[i]); else v = xr[i];
[?2004l[?2004h>         s1 += v.x + v.y + v.z + v.w;
[?2004l[?2004h>         s2 += v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w;
[?2004l[?2004h>     }
