[?2004l[?2004h> N = 64*256*256
[?2004l[?2004h> M = 16
[?2004l[?2004h> S, BLOCK, W = 16, 8192, 8
[?2004l[?2004h> CHUNK = N // S
[?2004l[?2004h> part = torch.empty(M*S*2, dtype=torch.float32, device=dev)
[?2004l[?2004h> out = torch.empty_like(x)
[?2004l[?2004h> grid = (M*S,)
[?2004l[?2004h> w = ref.weight.contiguous(); b = ref.bias.contiguous()
[?2004l[?2004h> _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)
[?2004l[?2004h> _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W)
[?2004l[?2004h> torch.cuda.synchronize()
[?2004l[?2004h> # check stats accuracy
[?2004l[?2004h> p = part.view(M, S, 2).double()
[?2004l[?2004h> my_mean = p[...,0].sum(1) / N
[?2004l[?2004h> my_var = p[...,1].sum(1) / N - my_mean*my_mean
[?2004l[?2004h> tm = x.double().view(M, -1).mean(1)
[?2004l[?2004h> tv = x.double().view(M, -1).var(1, unbiased=False)
[?2004l[?2004h> print('mean err', (my_mean - tm).abs().max().item())
[?2004l[?2004h> print('var err', (my_var - tv).abs().max().item(), 'var', tv[0].item())
[?2004l[?2004h> # elementwise pipeline check with exact stats
[?2004l[?2004h> y = (x.double().view(M,-1) - tm[:,None]) / tv[:,None].sqrt()
[?2004l[?2004h> print('fp64 pipeline vs ref fp32:', (y.float().view(shape) - ref(x)).abs().max().item())
[?2004l[?2004h> # my out vs fp64 pipeline with MY mean/var
[?2004l[?2004h> y2 = (x.double().view(M,-1) - my_mean[:,None]) / my_var[:,None].sqrt()
[?2004l[?2004h> print('my stats fp64 pipe vs my out:', (y2.float().view(shape) - out).abs().max().item())
[?2004l[?2004h> 
[?2004l[?2004h> dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)
[?2004l[?2004h> def timeit(fn, n=20):
[?2004l[?2004h>     for _ in range(3):
[?2004l[?2004h>         fn(); torch.cuda.synchronize()
[?2004l[?2004h>     evs = []
[?2004l[?2004h>     for i in range(n):
[?2004l[?2004h>         torch.cuda.synchronize()
[?2004l[?2004h>         dummy.fill_(42)
[?2004l[?2004h>         s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>         s.record(); fn(); e.record()
[?2004l[?2004h>         torch.cuda.synchronize()
[?2004l[?2004h>         evs.append(s.elapsed_time(e))
[?2004l[?2004h>     return statistics.mean(evs)
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _copy(x_ptr, o_ptr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
