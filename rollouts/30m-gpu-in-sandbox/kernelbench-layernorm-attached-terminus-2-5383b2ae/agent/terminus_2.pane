[?2004l[?2004h>         if st is None:
[?2004l[?2004h>             self._state[key] = 1
[?2004l[?2004h>             return self._forward_eager(x, M, N)
[?2004l[?2004h>         if st == 'no_graph':
[?2004l[?2004h>             return self._forward_eager(x, M, N)
[?2004l[?2004h>         if st == 'graph':
[?2004l[?2004h>             g, out = self._state[('g', key)]
