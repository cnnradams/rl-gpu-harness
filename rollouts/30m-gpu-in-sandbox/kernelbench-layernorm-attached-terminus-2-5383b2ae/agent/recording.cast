[1047.956138, "i", "mkdir -p /workspace/ext && cat > /workspace/ext/ln_fused.cu <<'EOF'\n#include <torch/extension.h>\n#include <ATen/cuda/CUDAContext.h>\n#include <cuda_runtime.h>\n\n#define FULL_MASK 0xffffffffu\n\n__global__ void ln_fused_kernel(const float4* __restrict__ x,\n                                const float4* __restrict__ w,\n                                const float4* __restrict__ b,\n                                float4* __restrict__ out,\n                                float* __restrict__ partials,\n                                unsigned int* __restrict__ barCount,\n                                int N, int S, float eps) {\n    int pid = blockIdx.x;\n    int m = pid / S;\n    int s = pid % S;\n    int n4 = N / 4 / S;\n    int tid = threadIdx.x;\n    int nthreads = blockDim.x;\n    const float4* xr = x + (long)m * (N / 4) + s * n4;\n    float s1 = 0.f, s2 = 0.f;\n    for (int i = tid; i < n4; i += nthreads) {\n        float4 v = xr[i];\n        s1 += v.x + v.y + v.z + v.w;\n        s2 += v.x * v.x + v.y * v.y + v.z * v.z + v.w *"]
[1047.956385, "i", " v.w;\n    }\n    for (int off = 16; off > 0; off >>= 1) {\n        s1 += __shfl_down_sync(FULL_MASK, s1, off);\n        s2 += __shfl_down_sync(FULL_MASK, s2, off);\n    }\n    __shared__ float sh[2][32];\n    int lane = tid & 31, wid = tid >> 5;\n    int nwarps = nthreads >> 5;\n    if (lane == 0) { sh[0][wid] = s1; sh[1][wid] = s2; }\n    __syncthreads();\n    if (wid == 0) {\n        s1 = (lane < nwarps) ? sh[0][lane] : 0.f;\n        s2 = (lane < nwarps) ? sh[1][lane] : 0.f;\n        for (int off = 16; off > 0; off >>= 1) {\n            s1 += __shfl_down_sync(FULL_MASK, s1, off);\n            s2 += __shfl_down_sync(FULL_MASK, s2, off);\n        }\n        if (lane == 0) {\n            partials[(m * S + s) * 2] = s1;\n            partials[(m * S + s) * 2 + 1] = s2;\n            __threadfence();\n            unsigned int old = atomicAdd(barCount, 1u);\n            if (old == gridDim.x - 1) {\n                *barCount = 0u;\n                __threadfence();\n                atomicExch(barCount + 1, 1u);\n            }\n        }\n    }\n"]
[1047.95647, "i", "    if (tid == 0) {\n        volatile unsigned int* flag = barCount + 1;\n        while (*flag == 0u) { __nanosleep(64); }\n    }\n    __syncthreads();\n    __shared__ float smean, srstd;\n    if (wid == 0) {\n        const float* pr = partials + m * S * 2;\n        float t1 = 0.f, t2 = 0.f;\n        for (int i = lane; i < S; i += 32) {\n            t1 += pr[i * 2];\n            t2 += pr[i * 2 + 1];\n        }\n        for (int off = 16; off > 0; off >>= 1) {\n            t1 += __shfl_down_sync(FULL_MASK, t1, off);\n            t2 += __shfl_down_sync(FULL_MASK, t2, off);\n        }\n        if (lane == 0) {\n            float mean = t1 / N;\n            float var = t2 / N - mean * mean;\n            var = var < 0.f ? 0.f : var;\n            smean = mean;\n            srstd = rsqrtf(var + eps);\n        }\n    }\n    __syncthreads();\n    float mean = smean, rstd = srstd;\n    const float4* wr = w + s * n4;\n    const float4* br = b + s * n4;\n    float4* op = out + (long)m * (N / 4) + s * n4;\n    for (int i = tid; i < n4; i += nthreads) "]
[1047.956506, "i", "{\n        float4 v = xr[i];\n        float4 wv = wr[i];\n        float4 bv = br[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        op[i] = o;\n    }\n}\n\nint64_t ln_max_blocks(int64_t threads) {\n    int numBlocksPerSm = 0;\n    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&numBlocksPerSm, ln_fused_kernel, (int)threads, 0);\n    int smcount = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;\n    return (int64_t)numBlocksPerSm * smcount;\n}\n\nvoid ln_fused(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor out,\n              torch::Tensor partials, torch::Tensor bar, int64_t S, int64_t threads, double eps) {\n    int N = (int)w.numel();\n    long M = x.numel() / N;\n    dim3 grid((unsigned)(M * S));\n    auto stream = at::cuda::getCurrentCUDAStream();\n    ln_fused_kernel<<<grid, (int)threads, 0, stream>>>(\n        reinterpret_"]
[1047.956516, "i", "cast<const float4*>(x.data_ptr<float>()),\n        reinterpret_cast<const float4*>(w.data_ptr<float>()),\n        reinterpret_cast<const float4*>(b.data_ptr<float>()),\n        reinterpret_cast<float4*>(out.data_ptr<float>()),\n        partials.data_ptr<float>(),\n        reinterpret_cast<unsigned int*>(bar.data_ptr<int>()),\n        N, (int)S, (float)eps);\n}\n\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n    m.def(\"ln_fused\", &ln_fused, \"fused layernorm\");\n    m.def(\"ln_max_blocks\", &ln_max_blocks, \"occupancy\");\n}\nEOF\ncat > /workspace/test_cuda.py <<'EOF'\nimport torch, statistics, time\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load\nt0 = time.time()\next = load(name='ln_fused_ext', sources=['/workspace/ext/ln_fused.cu'],\n           extra_cuda_cflags=['-O3', '--use_fast_math'], build_directory='/workspace/ext/build', verbose=False)\nprint('build took', time.time() - t0)\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*25"]
[1047.956524, "i", "6*256\nM = 16\nw = ref.weight.contiguous(); b = ref.bias.contiguous()\nwith torch.no_grad():\n    a = ref(x)\nfor threads in [512, 1024]:\n    mb = ext.ln_max_blocks(threads)\n    print('threads', threads, 'max co-resident blocks', mb)\n    for S in [8, 16, 32]:\n        if M*S > mb: \n            print(f'  S={S}: too many blocks ({M*S})')\n            continue\n        partials = torch.empty(M*S*2, dtype=torch.float32, device=dev)\n        bar = torch.zeros(2, dtype=torch.int32, device=dev)\n        out = torch.empty_like(x)\n        ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5)\n        torch.cuda.synchronize()\n        err = (out - a).abs().max().item()\n        dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\n        def timeit(fn, n=15):\n            for _ in range(3):\n                fn(); torch.cuda.synchronize()\n            evs = []\n            for i in range(n):\n                torch.cuda.synchronize()\n                dummy.fill_(42)\n                s = torch.cuda.Event(enable_timing=T"]
[1047.956678, "i", "rue); e = torch.cuda.Event(enable_timing=True)\n                s.record(); fn(); e.record()\n                torch.cuda.synchronize()\n                evs.append(s.elapsed_time(e))\n            return statistics.mean(evs)\n        t = timeit(lambda: ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5))\n        # graph timing\n        g = torch.cuda.CUDAGraph()\n        bar.zero_()\n        with torch.cuda.graph(g):\n            ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5)\n        tg = timeit(lambda: g.replay())\n        torch.cuda.synchronize()\n        errg = (out - a).abs().max().item()\n        print(f'  S={S} threads={threads}: t={t:.4f} ms graph={tg:.4f} ms err={err:.2e} errg={errg:.2e}')\nEOF\npython3 /workspace/test_cuda.py\n"]
