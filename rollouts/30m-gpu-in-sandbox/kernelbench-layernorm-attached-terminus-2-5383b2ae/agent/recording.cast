[508.024592, "i", "cat > /workspace/bench2.py <<'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nimport triton, triton.language as tl\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_stats, _ln_norm\n\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*256*256\nM = 16\nS, BLOCK, W = 16, 8192, 8\nCHUNK = N // S\npart = torch.empty(M*S*2, dtype=torch.float32, device=dev)\nout = torch.empty_like(x)\ngrid = (M*S,)\nw = ref.weight.contiguous(); b = ref.bias.contiguous()\n_ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)\n_ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W)\ntorch.cuda.synchronize()\n# check stats accuracy\np = part.view(M, S, 2).double()\nmy_mean = p[...,0].sum(1) / N\nmy_var = p[...,1].sum(1) / N - my_mean*my_mean\ntm = x.double().view(M, -1).mean(1)\ntv = x.double().view(M, -1).var(1, unbiased=False)\nprint('mean err', (my_mean - tm).abs().max().item())\nprint('var err', (my_var - tv).abs()."]
[508.024686, "i", "max().item(), 'var', tv[0].item())\n# elementwise pipeline check with exact stats\ny = (x.double().view(M,-1) - tm[:,None]) / tv[:,None].sqrt()\nprint('fp64 pipeline vs ref fp32:', (y.float().view(shape) - ref(x)).abs().max().item())\n# my out vs fp64 pipeline with MY mean/var\ny2 = (x.double().view(M,-1) - my_mean[:,None]) / my_var[:,None].sqrt()\nprint('my stats fp64 pipe vs my out:', (y2.float().view(shape) - out).abs().max().item())\n\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\n\n@triton.jit\ndef _copy(x_ptr, o_ptr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    "]
[508.024867, "i", "base = pid.to(tl.int64) * CHUNK\n    for i in range(0, CHUNK, BLOCK):\n        v = tl.load(x_ptr + base + i + tl.arange(0, BLOCK))\n        tl.store(o_ptr + base + i + tl.arange(0, BLOCK), v)\n\ntot = M*N\ng2 = (tot // CHUNK,)\nprint('copy only:', timeit(lambda: _copy[g2](x, out, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)))\nprint('stats only:', timeit(lambda: _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)))\nprint('norm only:', timeit(lambda: _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W)))\nprint('both:', timeit(lambda: (_ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W), _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W))))\nprint('torch x*2+1:', timeit(lambda: torch.add(x, 1, out=out)))\nEOF\npython3 /workspace/bench2.py\n"]
