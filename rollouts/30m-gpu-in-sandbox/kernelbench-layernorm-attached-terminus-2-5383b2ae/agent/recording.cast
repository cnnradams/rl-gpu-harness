[1370.32819, "o", "    print(f'S={S:4d} threads={threads:4d} smem={smem//1024:4d}KB blocks={M*S}/{mb}: t={t:.4f} ms hot={th:.4f} err={err:.2e}')\r\n\u001b[?2004l\r"]
