[411.99926, "o", "\u001b[?2004h> "]
[411.99938, "o", "            def run():\r\n\u001b[?2004l\r"]
[411.99941, "o", "\u001b[?2004h"]
[411.999561, "o", "> "]
[411.999966, "o", "                _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)\r\n\u001b[?2004l\r"]
[411.999995, "o", "\u001b[?2004h"]
[412.000101, "o", "> "]
[412.00072, "o", "                _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.000906, "o", "            t = timeit(run)\r\n\u001b[?2004l\r"]
[412.000978, "o", "\u001b[?2004h"]
[412.001064, "o", "> "]
[412.001436, "o", "            err = (out.double()-truth).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.001795, "o", "            dref = (out-a).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.002439, "o", "            print(f'S={S:4d} BLOCK={BLOCK:6d} W={W:2d} t={t:.4f}ms err64={err:.2e} dref={dref:.2e}')\r\n\u001b[?2004l\r"]
[412.002471, "o", "\u001b[?2004h"]
[412.002561, "o", "> EOF\r\n\u001b[?2004l\r"]
