[1296.636324, "o", "mkdir -p /workspace/ext/build2 && cat > /workspace/test_var.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.636446, "o", "import torch, statistics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.636636, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.636968, "o", "from torch.utils.cpp_extension import load\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.637193, "o", "ext = load(name='ln_var_ext', sources=['/workspace/ext/ln_variants.cu'],\r\n\u001b[?2004l\r"]
[1296.637216, "o", "\u001b[?2004h"]
[1296.637296, "o", "> "]
[1296.637789, "o", "           extra_cuda_cflags=['-O3', '--use_fast_math'], build_directory='/workspace/ext/build2', verbose=False)\r\n\u001b[?2004l\r"]
[1296.637816, "o", "\u001b[?2004h"]
[1296.637904, "o", "> "]
[1296.63792, "o", "dev = 'cuda'\r\n\u001b[?2004l\r"]
[1296.637964, "o", "\u001b[?2004h"]
[1296.638031, "o", "> "]
[1296.638164, "o", "shape = (16, 64, 256, 256)\r\n\u001b[?2004l\r"]
[1296.638191, "o", "\u001b[?2004h> "]
[1296.638326, "o", "ns = (64, 256, 256)\r\n\u001b[?2004l\r"]
[1296.63834, "o", "\u001b[?2004h"]
[1296.638432, "o", "> "]
[1296.638702, "o", "ref = nn.LayerNorm(ns).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.638803, "o", "x = torch.rand(*shape, device=dev)\r\n\u001b[?2004l\r"]
[1296.638823, "o", "\u001b[?2004h"]
[1296.638834, "o", "> "]
[1296.639206, "o", "N = 64*256*256; M = 16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.63926, "o", "w = ref.weight.contiguous(); b = ref.bias.contiguous()\r\n\u001b[?2004l\r"]
[1296.639326, "o", "\u001b[?2004h> "]
[1296.639427, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[1296.639519, "o", "\u001b[?2004h> "]
[1296.639565, "o", "    a = ref(x)\r\n\u001b[?2004l\r"]
[1296.639585, "o", "\u001b[?2004h"]
[1296.639655, "o", "> "]
[1296.639948, "o", "dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r"]
[1296.639968, "o", "\u001b[?2004h"]
[1296.640114, "o", "> "]
[1296.640238, "o", "def timeit(fn, n=15, thrash=True):\r\n\u001b[?2004l\r"]
[1296.64026, "o", "\u001b[?2004h"]
[1296.640276, "o", "> "]
[1296.64043, "o", "    for _ in range(3):\r\n\u001b[?2004l\r"]
[1296.640506, "o", "\u001b[?2004h> "]
[1296.640694, "o", "        fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1296.64072, "o", "\u001b[?2004h"]
[1296.640731, "o", "> "]
[1296.640908, "o", "    evs = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.640991, "o", "    for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.641023, "o", "> "]
[1296.641473, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h>         if thrash: dummy.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.642066, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.642162, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.642467, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.642709, "o", "        evs.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1296.642778, "o", "\u001b[?2004h"]
[1296.642799, "o", "> "]
[1296.643116, "o", "    return statistics.mean(evs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.64318, "o", "S, threads = 64, 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.643243, "o", "> "]
[1296.643787, "o", "partials = torch.empty(M*S*2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.643858, "o", "bar = torch.zeros(2, dtype=torch.int32, device=dev)\r\n\u001b[?2004l\r"]
[1296.643964, "o", "\u001b[?2004h> "]
[1296.644082, "o", "out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1296.644144, "o", "\u001b[?2004h> "]
[1296.6445, "o", "names = {0:'full', 1:'stats+bar', 2:'nobar', 3:'full+ldcs'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.644625, "o", "for mode in [0, 1, 2, 3]:\r\n\u001b[?2004l\r"]
[1296.644719, "o", "\u001b[?2004h> "]
[1296.645275, "o", "    bar.zero_(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h>     ext.ln_var(x, w, b, out, partials, bar, S, threads, 1e-5, mode)\r\n\u001b[?2004l\r"]
[1296.645342, "o", "\u001b[?2004h> "]
[1296.645528, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.645567, "o", "> "]
[1296.645782, "o", "    err = (out - a).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.64634, "o", "    t = timeit(lambda: ext.ln_var(x, w, b, out, partials, bar, S, threads, 1e-5, mode))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.646861, "o", "    th = timeit(lambda: ext.ln_var(x, w, b, out, partials, bar, S, threads, 1e-5, mode), thrash=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.647558, "o", "    print(f'mode={names[mode]:10s}: t={t:.4f} ms hot={th:.4f} ms err={err:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1296.654206, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1296.654341, "o", "python3 /workspace/test_var.py\r\n\u001b[?2004l\r"]
[1336.94999, "o", "mode=full      : t=0.3253 ms hot=0.3352 ms err=3.22e-06\r\n"]
[1336.967833, "o", "mode=stats+bar : t=0.1041 ms hot=0.1148 ms err=3.22e-06\r\n"]
[1336.982696, "o", "mode=nobar     : t=0.3271 ms hot=0.3271 ms err=3.22e-06\r\n"]
[1336.997649, "o", "mode=full+ldcs : t=0.3216 ms hot=0.3233 ms err=3.22e-06\r\n"]
[1337.46406, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1370.264705, "i", "cat > /workspace/ext/ln_smem.cu <<'EOF'\n#include <torch/extension.h>\n#include <ATen/cuda/CUDAContext.h>\n#include <cuda_runtime.h>\n\n#define FULL_MASK 0xffffffffu\n\n__global__ void ln_smem_kernel(const float4* __restrict__ x,\n                               const float4* __restrict__ w,\n                               const float4* __restrict__ b,\n                               float4* __restrict__ out,\n                               float* __restrict__ partials,\n                               unsigned int* __restrict__ barCount,\n                               int N, int S, float eps) {\n    extern __shared__ float4 sm[];\n    int pid = blockIdx.x;\n    int m = pid / S;\n    int s = pid % S;\n    int n4 = N / 4 / S;\n    int tid = threadIdx.x;\n    int nthreads = blockDim.x;\n    const float4* xr = x + (long)m * (N / 4) + s * n4;\n    float s1 = 0.f, s2 = 0.f;\n    for (int i = tid; i < n4; i += nthreads) {\n        float4 v = xr[i];\n        sm[i] = v;\n        s1 += v.x + v.y + v.z + v.w;\n        s2 += v.x * v.x + v.y * v.y "]
[1370.26503, "i", "+ v.z * v.z + v.w * v.w;\n    }\n    for (int off = 16; off > 0; off >>= 1) {\n        s1 += __shfl_down_sync(FULL_MASK, s1, off);\n        s2 += __shfl_down_sync(FULL_MASK, s2, off);\n    }\n    __shared__ float sh[2][32];\n    int lane = tid & 31, wid = tid >> 5;\n    int nwarps = nthreads >> 5;\n    if (lane == 0) { sh[0][wid] = s1; sh[1][wid] = s2; }\n    __syncthreads();\n    if (wid == 0) {\n        s1 = (lane < nwarps) ? sh[0][lane] : 0.f;\n        s2 = (lane < nwarps) ? sh[1][lane] : 0.f;\n        for (int off = 16; off > 0; off >>= 1) {\n            s1 += __shfl_down_sync(FULL_MASK, s1, off);\n            s2 += __shfl_down_sync(FULL_MASK, s2, off);\n        }\n        if (lane == 0) {\n            partials[(m * S + s) * 2] = s1;\n            partials[(m * S + s) * 2 + 1] = s2;\n            __threadfence();\n            unsigned int old = atomicAdd(barCount, 1u);\n            if (old == gridDim.x - 1) {\n                *barCount = 0u;\n                __threadfence();\n                atomicExch(barCount + 1, 1u);\n           "]
[1370.265273, "i", " }\n        }\n    }\n    if (tid == 0) {\n        volatile unsigned int* flag = barCount + 1;\n        while (*flag == 0u) { __nanosleep(32); }\n    }\n    __syncthreads();\n    __shared__ float smean, srstd;\n    if (wid == 0) {\n        const float* pr = partials + m * S * 2;\n        float t1 = 0.f, t2 = 0.f;\n        for (int i = lane; i < S; i += 32) {\n            t1 += pr[i * 2];\n            t2 += pr[i * 2 + 1];\n        }\n        for (int off = 16; off > 0; off >>= 1) {\n            t1 += __shfl_down_sync(FULL_MASK, t1, off);\n            t2 += __shfl_down_sync(FULL_MASK, t2, off);\n        }\n        if (lane == 0) {\n            float mean = t1 / N;\n            float var = t2 / N - mean * mean;\n            var = var < 0.f ? 0.f : var;\n            smean = mean;\n            srstd = rsqrtf(var + eps);\n        }\n    }\n    __syncthreads();\n    float mean = smean, rstd = srstd;\n    const float4* wr = w + s * n4;\n    const float4* br = b + s * n4;\n    float4* op = out + (long)m * (N / 4) + s * n4;\n    for (int i = tid; i < "]
[1370.265357, "o", "cat > /workspace/ext/ln_smem.cu <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1370.265416, "i", "n4; i += nthreads) {\n        float4 v = sm[i];\n        float4 wv = wr[i];\n        float4 bv = br[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        op[i] = o;\n    }\n}\n\nint64_t smem_max_blocks(int64_t threads, int64_t smem) {\n    cudaFuncSetAttribute(ln_smem_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, (int)smem);\n    int numBlocksPerSm = 0;\n    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&numBlocksPerSm, ln_smem_kernel, (int)threads, (int)smem);\n    int smcount = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;\n    return (int64_t)numBlocksPerSm * smcount;\n}\n\nvoid ln_smem(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor out,\n             torch::Tensor partials, torch::Tensor bar, int64_t S, int64_t threads, double eps) {\n    int N = (int)w.numel();\n    long M = x.numel() / N;\n    dim3 grid((unsigned)"]
[1370.265535, "i", "(M * S));\n    int smem = (int)(N / S) * 4;\n    cudaFuncSetAttribute(ln_smem_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem);\n    auto stream = at::cuda::getCurrentCUDAStream();\n    ln_smem_kernel<<<grid, (int)threads, smem, stream>>>(\n        reinterpret_cast<const float4*>(x.data_ptr<float>()),\n        reinterpret_cast<const float4*>(w.data_ptr<float>()),\n        reinterpret_cast<const float4*>(b.data_ptr<float>()),\n        reinterpret_cast<float4*>(out.data_ptr<float>()),\n        partials.data_ptr<float>(),\n        reinterpret_cast<unsigned int*>(bar.data_ptr<int>()),\n        N, (int)S, (float)eps);\n}\n\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n    m.def(\"ln_smem\", &ln_smem, \"smem fused\");\n    m.def(\"smem_max_blocks\", &smem_max_blocks, \"occupancy\");\n}\nEOF\nmkdir -p /workspace/ext/build3 && cat > /workspace/test_smem.py <<'EOF'\nimport torch, statistics\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load\next = load(name='ln_smem_ext', sources=['/workspace/ext/ln_smem.cu'],\n           ex"]
