[1296.618498, "o", "            t1 += __shfl_down_sync(FULL_MASK, t1, off);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.618764, "o", "            t2 += __shfl_down_sync(FULL_MASK, t2, off);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.618803, "o", "> "]
[1296.619082, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>         if (lane == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.619366, "o", "            float mean = t1 / N;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.61959, "o", "            float var = t2 / N - mean * mean;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.619803, "o", "            var = var < 0.f ? 0.f : var;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.619984, "o", ">             smean = mean;\r\n\u001b[?2004l\r"]
[1296.620028, "o", "\u001b[?2004h> "]
[1296.62041, "o", "            srstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[1296.620448, "o", "\u001b[?2004h> "]
[1296.620599, "o", "    __syncthreads();\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.620632, "o", "> "]
[1296.621092, "o", "    float mean = smean, rstd = srstd;\r\n\u001b[?2004l\r\u001b[?2004h>     const float4* wr = w + s * n4;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.621345, "o", "    const float4* br = b + s * n4;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.621884, "o", "    float4* op = out + (long)m * (N / 4) + s * n4;\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = tid; i < n4; i += nthreads) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.621921, "o", "> "]
[1296.622044, "o", "        float4 v;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.622075, "o", "> "]
[1296.622561, "o", "        if (MODE == 3) v = __ldcs(&xr[i]); else v = xr[i];\r\n\u001b[?2004l\r\u001b[?2004h>         float4 wv = wr[i];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.622599, "o", "> "]
[1296.622853, "o", "        float4 bv = br[i];\r\n\u001b[?2004l\r\u001b[?2004h>         float4 o;"]
[1296.622882, "o", "\r\n\u001b[?2004l\r"]
[1296.623099, "o", "\u001b[?2004h> "]
[1296.623302, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.623897, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r\u001b[?2004h>         o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.62419, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.624352, "o", "        op[i] = o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.62438, "o", "    }\r\n\u001b[?2004l\r"]
[1296.624398, "o", "\u001b[?2004h"]
[1296.624527, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.624556, "o", "> "]
[1296.625142, "o", "void ln_var(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.625953, "o", "            torch::Tensor partials, torch::Tensor bar, int64_t S, int64_t threads, double eps, int64_t mode) {\r\n\u001b[?2004l\r\u001b[?2004h>     int N = (int)w.numel();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.626173, "o", "    long M = x.numel() / N;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.6263, "o", "    dim3 grid((unsigned)(M * S));\r\n\u001b[?2004l\r"]
[1296.626462, "o", "\u001b[?2004h> "]
[1296.626963, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.627166, "o", "    auto xp = reinterpret_cast<const float4*>(x.data_ptr<float>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.6277, "o", "    auto wp = reinterpret_cast<const float4*>(w.data_ptr<float>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.627937, "o", "    auto bp = reinterpret_cast<const float4*>(b.data_ptr<float>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.628431, "o", "    auto op = reinterpret_cast<float4*>(out.data_ptr<float>());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.628619, "o", "    auto pp = partials.data_ptr<float>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.62901, "o", "    auto barp = reinterpret_cast<unsigned int*>(bar.data_ptr<int>());\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.629049, "o", "> "]
[1296.629889, "o", "    if (mode == 0) ln_var_kernel<0><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.630611, "o", "    else if (mode == 1) ln_var_kernel<1><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.631379, "o", "    else if (mode == 2) ln_var_kernel<2><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1296.631807, "o", "    else ln_var_kernel<3><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\r\n\u001b[?2004l\r"]
[1296.631853, "o", "\u001b[?2004h> "]
[1296.631957, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
