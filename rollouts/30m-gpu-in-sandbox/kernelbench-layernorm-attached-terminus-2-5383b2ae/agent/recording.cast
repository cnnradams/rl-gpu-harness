[1047.979715, "o", "    int numBlocksPerSm = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.980461, "o", "    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&numBlocksPerSm, ln_fused_kernel, (int)threads, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.981092, "o", "    int smcount = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;\r\n\u001b[?2004l\r\u001b[?2004h>     return (int64_t)numBlocksPerSm * smcount;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1047.981241, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1047.981827, "o", "void ln_fused(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.982402, "o", "              torch::Tensor partials, torch::Tensor bar, int64_t S, int64_t threads, double eps) {\r\n\u001b[?2004l\r\u001b[?2004h>     int N = (int)w.numel();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.982549, "o", "    long M = x.numel() / N;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.982583, "o", "> "]
[1047.983078, "o", "    dim3 grid((unsigned)(M * S));\r\n\u001b[?2004l\r\u001b[?2004h>     auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.98344, "o", "    ln_fused_kernel<<<grid, (int)threads, 0, stream>>>(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.983803, "o", "        reinterpret_cast<const float4*>(x.data_ptr<float>()),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.984405, "o", "        reinterpret_cast<const float4*>(w.data_ptr<float>()),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.985173, "o", "        reinterpret_cast<const float4*>(b.data_ptr<float>()),\r\n\u001b[?2004l\r\u001b[?2004h>         reinterpret_cast<float4*>(out.data_ptr<float>()),\r\n"]
[1047.985209, "o", "\u001b[?2004l\r"]
[1047.985223, "o", "\u001b[?2004h"]
[1047.985392, "o", "> "]
[1047.98566, "o", "        partials.data_ptr<float>(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.986151, "o", "        reinterpret_cast<unsigned int*>(bar.data_ptr<int>()),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.986334, "o", "> "]
[1047.987303, "o", "        N, (int)S, (float)eps);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.987591, "o", "PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.987783, "o", "    m.def(\"ln_fused\", &ln_fused, \"fused layernorm\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.987814, "o", "> "]
[1047.988228, "o", "    m.def(\"ln_max_blocks\", &ln_max_blocks, \"occupancy\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1047.994217, "o", "\u001b[?2004h"]
