[411.986117, "i", "cat > /workspace/tune.py <<'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\nimport solution\nfrom solution import ModelNew, _ln_stats, _ln_norm\n\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*256*256\nM = 16\nwith torch.no_grad():\n    a = ref(x)\n    truth = nn.functional.layer_norm(x.double(), ns, ref.weight.double(), ref.bias.double())\nprint('ref err vs fp64:', (a.double()-truth).abs().max().item())\n\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\n\ndef timeit(fn, n=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\n\nw = ref.weight."]
[411.986385, "i", "contiguous(); b = ref.bias.contiguous()\nfor S in [16, 32, 64, 128]:\n    for BLOCK in [4096, 8192, 16384]:\n        CHUNK = N // S\n        if CHUNK % BLOCK: continue\n        for W in [4, 8, 16]:\n            if BLOCK // (W*32) < 1: continue\n            part = torch.empty(M*S*2, dtype=torch.float32, device=dev)\n            out = torch.empty_like(x)\n            grid = (M*S,)\n            def run():\n                _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)\n                _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=W)\n            t = timeit(run)\n            err = (out.double()-truth).abs().max().item()\n            dref = (out-a).abs().max().item()\n            print(f'S={S:4d} BLOCK={BLOCK:6d} W={W:2d} t={t:.4f}ms err64={err:.2e} dref={dref:.2e}')\nEOF\npython3 /workspace/tune.py\n"]
