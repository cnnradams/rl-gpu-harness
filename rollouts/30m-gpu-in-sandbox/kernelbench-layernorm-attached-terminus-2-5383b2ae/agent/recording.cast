[1370.319752, "o", "        if thrash: dummy.fill_(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1370.320393, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1370.320647, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
