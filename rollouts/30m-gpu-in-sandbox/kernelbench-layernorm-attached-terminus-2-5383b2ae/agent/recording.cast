[635.78831, "i", "cat > /workspace/tune3.py <<'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_stats, _ln_norm, ModelNew\n\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*256*256\nM = 16\nw = ref.weight.contiguous(); b = ref.bias.contiguous()\nwith torch.no_grad():\n    a = ref(x)\n\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=15):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\n\n# correctness with eps fix\nnew = ModelNew(ns).to(dev)\nwith torch.no_grad():\n    o = new(x)\nprint('maxdiff vs ref:', (o - a).abs().max("]
[635.788484, "i", ").item(), 'allclose:', torch.allclose(o, a, atol=1e-4, rtol=1e-4))\n\nfor S in [16, 32]:\n    CHUNK = N // S\n    for BLOCK in [4096, 8192]:\n        for W in [4, 8]:\n            for ns_ in [1, 2, 4]:\n                grid = (M*S,)\n                part = torch.empty(M*S*2, dtype=torch.float32, device=dev)\n                out = torch.empty_like(x)\n                t1 = timeit(lambda: _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W, num_stages=ns_))\n                t2 = timeit(lambda: _ln_norm[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, EPS=1e-5, num_warps=W, num_stages=ns_))\n                print(f'S={S} BLOCK={BLOCK} W={W} stages={ns_}: stats={t1:.4f} norm={t2:.4f}')\nEOF\npython3 /workspace/tune3.py\n"]
