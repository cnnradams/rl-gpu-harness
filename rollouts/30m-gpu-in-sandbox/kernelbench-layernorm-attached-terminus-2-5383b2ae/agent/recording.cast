[1047.994438, "o", "cat > /workspace/test_cuda.py <<'EOF'\r\n\u001b[?2004l\r"]
[1047.99447, "o", "\u001b[?2004h"]
[1047.994647, "o", "> import torch, statistics, time\r\n\u001b[?2004l\r"]
[1047.994675, "o", "\u001b[?2004h"]
[1047.994794, "o", "> "]
[1047.994825, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[1047.994907, "o", "\u001b[?2004h> "]
[1047.995176, "o", "from torch.utils.cpp_extension import load\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.995304, "o", "t0 = time.time()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.995324, "o", "> "]
[1047.995713, "o", "ext = load(name='ln_fused_ext', sources=['/workspace/ext/ln_fused.cu'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.99632, "o", "           extra_cuda_cflags=['-O3', '--use_fast_math'], build_directory='/workspace/ext/build', verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.996569, "o", "print('build took', time.time() - t0)\r\n\u001b[?2004l\r\u001b[?2004h> dev = 'cuda'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.996592, "o", "> "]
[1047.996799, "o", "shape = (16, 64, 256, 256)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.996971, "o", "ns = (64, 256, 256)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.997119, "o", "ref = nn.LayerNorm(ns).to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.997374, "o", "x = torch.rand(*shape, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.997519, "o", "N = 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.997576, "o", "M = 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[1047.997595, "o", "> "]
[1047.998191, "o", "w = ref.weight.contiguous(); b = ref.bias.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     a = ref(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.998417, "o", "for threads in [512, 1024]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.99869, "o", "    mb = ext.ln_max_blocks(threads)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.999291, "o", "    print('threads', threads, 'max co-resident blocks', mb)\r\n\u001b[?2004l\r\u001b[?2004h>     for S in [8, 16, 32]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.999358, "o", "        if M*S > mb: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1047.999897, "o", "            print(f'  S={S}: too many blocks ({M*S})')\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.000391, "o", "        partials = torch.empty(M*S*2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.000883, "o", "        bar = torch.zeros(2, dtype=torch.int32, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h>         out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.001425, "o", "        ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h>         torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1048.001462, "o", "\u001b[?2004h> "]
[1048.001945, "o", "        err = (out - a).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.002178, "o", "        dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.002391, "o", "        def timeit(fn, n=15):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.002781, "o", "            for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.00286, "o", "                fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1048.002929, "o", "> "]
[1048.003055, "o", "            evs = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[1048.003129, "o", "> "]
[1048.003324, "o", "            for i in range(n):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1048.003392, "o", "> "]
[1048.003565, "o", "                torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1048.003643, "o", "\u001b[?2004h> "]
[1048.003778, "o", "                dummy.fill_(42)\r\n\u001b[?2004l\r"]
[1048.003803, "o", "\u001b[?2004h"]
[1048.003884, "o", "> "]
[1048.004373, "o", "                s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.004869, "o", "                s.record(); fn(); e.record()\r\n\u001b[?2004l\r\u001b[?2004h>                 torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1048.004919, "o", "> "]
[1048.005188, "o", "                evs.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.005366, "o", "            return statistics.mean(evs)\r\n\u001b[?2004l\r"]
[1048.005548, "o", "\u001b[?2004h> "]
[1048.006035, "o", "        t = timeit(lambda: ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.006132, "o", "        # graph timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.00639, "o", "        g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.00666, "o", "        bar.zero_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.006683, "o", "        with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[1048.006833, "o", "\u001b[?2004h> "]
[1048.007193, "o", "            ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.00737, "o", "        tg = timeit(lambda: g.replay())\r\n\u001b[?2004l\r"]
[1048.007502, "o", "\u001b[?2004h> "]
[1048.007698, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.008031, "o", "        errg = (out - a).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1048.008715, "o", "        print(f'  S={S} threads={threads}: t={t:.4f} ms graph={tg:.4f} ms err={err:.2e} errg={errg:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1048.011631, "o", "\u001b[?2004hroot@modal:/workspace# python3 /workspace/test_cuda.py\r\n\u001b[?2004l\r"]
[1049.292186, "o", "Traceback (most recent call last):\r\n  File \"/workspace/test_cuda.py\", line 5, in <module>\r\n    ext = load(name='ln_fused_ext', sources=['/workspace/ext/ln_fused.cu'],\r\n  File \"/usr/local/lib/python3.10/dist-packages/torch/utils/cpp_extension.py\", line 1692, in load\r\n"]
[1049.292474, "o", "    return _jit_compile(\r\n  File \"/usr/local/lib/python3.10/dist-packages/torch/utils/cpp_extension.py\", line 2108, in _jit_compile\r\n    if baton.try_acquire():\r\n  File \"/usr/local/lib/python3.10/dist-packages/torch/utils/file_baton.py\", line 34, in try_acquire\r\n"]
[1049.292509, "o", "    self.fd = os.open(self.lock_file_path, os.O_CREAT | os.O_EXCL)\r\nFileNotFoundError: [Errno 2] No such file or directory: '/workspace/ext/build/lock'\r\n"]
[1049.502336, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1112.163651, "i", "mkdir -p /workspace/ext/build && python3 /workspace/test_cuda.py\n"]
[1112.164098, "o", "mkdir -p /workspace/ext/build && python3 /workspace/test_cuda.py\r\n\u001b[?2004l\r"]
[1153.717972, "o", "build took 40.335349321365356\r\n"]
[1153.925777, "o", "threads 512 max co-resident blocks 264\r\n"]
[1154.019454, "o", "  S=8 threads=512: t=0.3396 ms graph=0.3415 ms err=3.58e-06 errg=3.58e-06\r\n"]
[1154.039006, "o", "  S=16 threads=512: t=0.3264 ms graph=0.3247 ms err=3.58e-06 errg=3.58e-06\r\n  S=32: too many blocks (512)\r\nthreads 1024 max co-resident blocks 132\r\n"]
[1154.061774, "o", "  S=8 threads=1024: t=0.3216 ms graph=0.3213 ms err=3.58e-06 errg=3.58e-06\r\n  S=16: too many blocks (256)\r\n  S=32: too many blocks (512)\r\n"]
[1154.569181, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1180.170711, "i", "cat > /workspace/test_cuda2.py <<'EOF'\nimport torch, statistics\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load\next = load(name='ln_fused_ext', sources=['/workspace/ext/ln_fused.cu'],\n           extra_cuda_cflags=['-O3', '--use_fast_math'], build_directory='/workspace/ext/build', verbose=False)\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*256*256\nM = 16\nw = ref.weight.contiguous(); b = ref.bias.contiguous()\nwith torch.no_grad():\n    a = ref(x)\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=15):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean"]
[1180.170774, "i", "(evs)\nfor threads in [128, 256, 512]:\n    mb = ext.ln_max_blocks(threads)\n    for S in [8, 16, 32, 64, 128]:\n        if M*S > mb: continue\n        partials = torch.empty(M*S*2, dtype=torch.float32, device=dev)\n        bar = torch.zeros(2, dtype=torch.int32, device=dev)\n        out = torch.empty_like(x)\n        ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5)\n        torch.cuda.synchronize()\n        err = (out - a).abs().max().item()\n        t = timeit(lambda: ext.ln_fused(x, w, b, out, partials, bar, S, threads, 1e-5))\n        bw = (2*M*N*4 + 3*S*N*4)/t*1e-6\n        print(f'threads={threads:5d} S={S:4d} blocks={M*S:5d}/{mb:5d}: t={t:.4f} ms bw={bw:.0f} GB/s err={err:.2e}')\nEOF\npython3 /workspace/test_cuda2.py\n"]
[1180.171082, "o", "cat > /workspace/test_cuda2.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
