[1570.639702, "i", "cat > /workspace/e2e.py <<'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\nimport triton, triton.language as tl\nfrom solution import _ln_stats\nfrom tune5 import _ln_norm_m\nfrom torch.utils.cpp_extension import load\next = load(name='ln_var_ext', sources=['/workspace/ext/ln_variants.cu'],\n           extra_cuda_cflags=['-O3', '--use_fast_math'], build_directory='/workspace/ext/build2', verbose=False)\n\ndev='cuda'\nshape=(16,64,256,256)\nx = torch.rand(*shape, device=dev)\nN=64*256*256; M=16\nw = torch.ones(ns := (64,256,256), device=dev); b = torch.zeros(ns, device=dev)\ndummy = torch.empty((32,1024,1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=20):\n    for _ in range(3): fn(); torch.cuda.synchronize()\n    evs=[]\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.e"]
[1570.639791, "i", "lapsed_time(e))\n    return statistics.mean(evs)\n\nS, BLOCK, W = 16, 8192, 8\nCHUNK = N//S\ngrid=(M*S,)\npart = torch.empty(M*S*2, dtype=torch.float32, device=dev)\nout = torch.empty_like(x)\ndef triton_run():\n    _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)\n    _ln_norm_m[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, EPS=1e-5, MIRROR=True, num_warps=W)\nprint('triton eager launches:', timeit(triton_run))\ng = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g):\n    triton_run()\nprint('triton graph replay:', timeit(lambda: g.replay()))\n\nSc, th = 64, 128\npartials = torch.empty(M*Sc*2, dtype=torch.float32, device=dev)\nbar = torch.zeros(2, dtype=torch.int32, device=dev)\ndef cuda_run():\n    ext.ln_var(x, w, b, out, partials, bar, Sc, th, 1e-5, 3)\nprint('cuda fused eager:', timeit(cuda_run))\nbar.zero_(); torch.cuda.synchronize()\ng2 = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g2):\n    cuda_run()\nprint('cuda fused graph replay:', timeit(lambda: g2.replay()))\nEOF\npython3 /workspace/e2e.py\n"]
