[411.99768, "o", "        for W in [4, 8, 16]:\r\n\u001b[?2004l\r"]
[411.997771, "o", "\u001b[?2004h> "]
[411.998047, "o", "            if BLOCK // (W*32) < 1: continue\r\n\u001b[?2004l\r"]
[411.998109, "o", "\u001b[?2004h> "]
[411.998565, "o", "            part = torch.empty(M*S*2, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[411.998639, "o", "\u001b[?2004h"]
[411.998697, "o", "> "]
[411.99893, "o", "            out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[411.998966, "o", "> "]
