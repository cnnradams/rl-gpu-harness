[290.699471, "o", "    def _launch(self, x, out, part, M, N):\r\n\u001b[?2004l\r\u001b[?2004h>         S = _S\r\n\u001b[?2004l\r\u001b[?2004h>         BLOCK = _BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
