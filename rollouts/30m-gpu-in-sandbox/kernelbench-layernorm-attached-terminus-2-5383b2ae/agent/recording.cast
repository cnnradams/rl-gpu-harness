[508.038624, "o", "    base = pid.to(tl.int64) * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r"]
[508.038736, "o", "\u001b[?2004h> "]
[508.039199, "o", "        v = tl.load(x_ptr + base + i + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r\u001b[?2004h> "]
