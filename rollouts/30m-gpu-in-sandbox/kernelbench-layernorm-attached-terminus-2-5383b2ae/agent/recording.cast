[1501.552932, "i", "cat > /workspace/tune5.py <<'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nimport triton, triton.language as tl\nsys.path.insert(0, '/workspace')\nfrom solution import _ln_stats\n\n@triton.jit\ndef _ln_norm_m(x_ptr, w_ptr, b_ptr, part_ptr, out_ptr,\n               N: tl.constexpr, CHUNK: tl.constexpr, S: tl.constexpr, BLOCK: tl.constexpr, EPS: tl.constexpr, MIRROR: tl.constexpr):\n    pid = tl.program_id(0)\n    if MIRROR:\n        pid = tl.num_programs(0) - 1 - pid\n    m = pid // S\n    soffs = tl.arange(0, S)\n    ps = tl.load(part_ptr + (m * S + soffs) * 2 + 0)\n    ps2 = tl.load(part_ptr + (m * S + soffs) * 2 + 1)\n    total = tl.sum(ps)\n    total2 = tl.sum(ps2)\n    mean = total / N\n    var = total2 / N - mean * mean\n    var = tl.maximum(var, 0.0) + EPS\n    rstd = 1.0 / tl.sqrt(var)\n    base = pid.to(tl.int64) * CHUNK\n    row_base = m.to(tl.int64) * N\n    for i in range(0, CHUNK, BLOCK):\n        idx = i + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        w = tl.load(w_ptr + (base - row_bas"]
[1501.553012, "i", "e) + idx)\n        b = tl.load(b_ptr + (base - row_base) + idx)\n        y = (v - mean) * rstd * w + b\n        tl.store(out_ptr + base + idx, y)\n\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*256*256; M = 16\nw = ref.weight.contiguous(); b = ref.bias.contiguous()\nwith torch.no_grad():\n    a = ref(x)\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\n\nfor S in [16, 32]:\n    CHUNK = N // S\n    for BLOCK in [8192]:\n        for W in [8]:\n            grid = (M*S,)\n            part = torch.empty(M*S*2, dtype=torch."]
[1501.553036, "i", "float32, device=dev)\n            out = torch.empty_like(x)\n            def run(mirror):\n                _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W)\n                _ln_norm_m[grid](x, w, b, part, out, N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, EPS=1e-5, MIRROR=mirror, num_warps=W)\n            t0 = timeit(lambda: run(False))\n            t1 = timeit(lambda: run(True))\n            torch.cuda.synchronize()\n            err = (out - a).abs().max().item()\n            print(f'S={S} BLOCK={BLOCK} W={W}: nomirror={t0:.4f} mirror={t1:.4f} err={err:.2e}')\nEOF\npython3 /workspace/tune5.py\n"]
