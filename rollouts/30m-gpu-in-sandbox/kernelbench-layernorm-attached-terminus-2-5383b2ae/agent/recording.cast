[290.700411, "o", "        _ln_stats[grid](x, part, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=_NUM_WARPS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.700653, "o", "        _ln_norm[grid](x, self.weight, self.bias, part, out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.701201, "o", "                       N=N, CHUNK=CHUNK, S=S, BLOCK=BLOCK, num_warps=_NUM_WARPS)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.701384, "o", "    def _forward_eager(self, x, M, N):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.701708, "o", "        out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.701955, "o", "        S = _S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.702416, "o", "        if self._part is None or self._part.numel() < M * S * 2 or self._part.device != x.device:\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.702459, "o", "> "]
[290.702892, "o", "            self._part = torch.empty(M * S * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.70298, "o", "> "]
[290.703475, "o", "        self._launch(x, out, self._part, M, N)\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.703686, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[290.703709, "o", "\u001b[?2004h"]
[290.703831, "o", ">         N = self._N\r\n\u001b[?2004l\r"]
[290.703854, "o", "\u001b[?2004h"]
[290.704076, "o", "> "]
[290.704316, "o", "        if not (x.is_cuda and x.dtype == torch.float32 and x.is_contiguous()):\r\n\u001b[?2004l\r"]
[290.704341, "o", "\u001b[?2004h> "]
[290.704936, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias)\r\n\u001b[?2004l\r\u001b[?2004h>         M = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.704973, "o", "> "]
[290.705259, "o", "        if (N % (_S * _BLOCK)) != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.705719, "o", "            return F.layer_norm(x, self.normalized_shape, self.weight, self.bias)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.706086, "o", "        key = (x.data_ptr(), tuple(x.shape), x.device.index)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.70629, "o", "        st = self._state.get(key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.706452, "o", "        if st is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.706487, "o", "> "]
[290.706683, "o", "            self._state[key] = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.707065, "o", "            return self._forward_eager(x, M, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.707101, "o", "        if st == 'graph':\r\n\u001b[?2004l\r"]
[290.707268, "o", "\u001b[?2004h> "]
[290.707385, "o", "            g, out = self._state[('g', key)]\r\n\u001b[?2004l\r"]
[290.707407, "o", "\u001b[?2004h"]
[290.707598, "o", "> "]
[290.707617, "o", "            g.replay()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.707884, "o", "            return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.707923, "o", "        if st == 'no_graph':\r\n\u001b[?2004l\r"]
[290.708137, "o", "\u001b[?2004h> "]
[290.708289, "o", "            return self._forward_eager(x, M, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.708893, "o", "        # second time seeing this pointer: capture a CUDA graph\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             S = _S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.709679, "o", "            if self._part is None or self._part.numel() < M * S * 2 or self._part.device != x.device:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.709886, "o", "                self._part = torch.empty(M * S * 2, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.710074, "o", "            out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.710093, "o", "> "]
[290.710665, "o", "            g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r\u001b[?2004h>             with torch.cuda.graph(g):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.711301, "o", "                self._launch(x, out, self._part, M, N)\r\n\u001b[?2004l\r\u001b[?2004h>             g.replay()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.711332, "o", "            self._state[key] = 'graph'\r\n\u001b[?2004l\r"]
[290.711472, "o", "\u001b[?2004h> "]
[290.711645, "o", "            self._state[('g', key)] = (g, out)\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.711677, "o", "> "]
[290.711878, "o", "            return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.712036, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[290.712208, "o", "            self._state[key] = 'no_graph'\r\n\u001b[?2004l\r\u001b[?2004h"]
[290.71223, "o", "> "]
[290.712735, "o", "            return self._forward_eager(x, M, N)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[290.715384, "o", "\u001b[?2004hroot@modal:/workspace# "]
