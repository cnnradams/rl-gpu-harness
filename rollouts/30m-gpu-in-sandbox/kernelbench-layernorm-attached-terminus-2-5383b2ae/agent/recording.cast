[290.718894, "o", "total 5\r\ndrwxr-xr-x 1 root root   60 Nov  3 07:14 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwxr-xr-x 1 root root  160 Nov  3 07:14 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root 4126 Nov  3 07:14 solution.py\r\n"]
[290.7191, "o", "\u001b[?2004hroot@modal:/workspace# "]
[291.360109, "i", "cat > /workspace/bench.py <<'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nsys.path.insert(0, '/workspace')\nimport solution\nfrom solution import ModelNew\n\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nnew = ModelNew(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nwith torch.no_grad():\n    a = ref(x)\n    b = new(x)\n    print('maxdiff', (a - b).abs().max().item())\n    print('allclose', torch.allclose(a, b, atol=1e-4, rtol=1e-4))\n\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\n\ndef timeit(fn, n=30):\n    for _ in range(5):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n + 1):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        if i >= 1:\n            evs.append(s.elapsed_time(e))\n    return statistics.mean(evs), min(evs)\n\nwith torch.no_grad():"]
[291.360146, "i", "\n    m1 = timeit(lambda: ref(x))\n    m2 = timeit(lambda: new(x))\nprint(f'ref mean {m1[0]:.4f} ms min {m1[1]:.4f}')\nprint(f'new mean {m2[0]:.4f} ms min {m2[1]:.4f}')\nprint(f'speedup {m1[0]/m2[0]:.2f}x')\nEOF\npython3 /workspace/bench.py\n"]
