[828.351523, "i", "cat > /workspace/tune4.py <<'EOF'\nimport torch, statistics\nimport triton, triton.language as tl\ndev='cuda'\nN = 64*256*256\nM = 16\ntot = M*N\nx = torch.rand(tot, device=dev)\nout = torch.empty_like(x)\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=15):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\n\n@triton.jit\ndef _copy(x_ptr, o_ptr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid.to(tl.int64) * CHUNK\n    for i in range(0, CHUNK, BLOCK):\n        v = tl.load(x_ptr + base + i + tl.arange(0, BLOCK))\n        tl.store(o_ptr + base + i + tl.arange(0, BLOCK), v)\n\nfor CHUNK in [4096, 8192, 16384, 32768, 65536, 13"]
[828.351604, "i", "1072, 262144]:\n    grid = (tot // CHUNK,)\n    for BLOCK in [2048, 4096, 8192]:\n        if BLOCK > CHUNK: continue\n        for W in [4, 8]:\n            t = timeit(lambda: _copy[grid](x, out, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=W))\n            bw = 2*tot*4/t*1e-9/1000\n            print(f'grid={grid[0]:6d} CHUNK={CHUNK:7d} BLOCK={BLOCK:5d} W={W}: {t:.4f} ms {bw:.2f} TB/s')\nEOF\npython3 /workspace/tune4.py\n"]
