[711.989216, "i", "cat > /workspace/bwtest.py <<'EOF'\nimport torch, statistics\ndev='cuda'\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=15):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\nfor mb in [64, 256, 1024]:\n    a = torch.rand(mb*1024*1024//4, device=dev)\n    o = torch.empty_like(a)\n    t = timeit(lambda: o.copy_(a))\n    print(f'{mb}MB copy: {t:.4f} ms -> {2*mb/t*1000/1024:.2f} TB/s (rd+wr)')\n# small tensor repeated - kernel launch floor\na = torch.rand(16*1024*1024//4, device=dev)\no = torch.empty_like(a)\nt = timeit(lambda: o.copy_(a), n=30)\nprint(f'16MB copy: {t:.4f} ms -> {2*16/t*1000/1024:.2f} TB/s')\nEOF\npython3 /workspace/bwtest.py\n"]
[711.989441, "o", "cat > /workspace/bwtest.py <<'EOF'\r\n\u001b[?2004l\r"]
