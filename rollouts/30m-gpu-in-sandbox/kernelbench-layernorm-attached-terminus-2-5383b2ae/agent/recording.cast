[1296.597474, "i", "cat > /workspace/ext/ln_variants.cu <<'EOF'\n#include <torch/extension.h>\n#include <ATen/cuda/CUDAContext.h>\n#include <cuda_runtime.h>\n\n#define FULL_MASK 0xffffffffu\n\n// mode: 0 = full fused, 1 = stats+barrier only, 2 = no barrier (wrong), 3 = full fused streaming loads\ntemplate <int MODE>\n__global__ void ln_var_kernel(const float4* __restrict__ x,\n                              const float4* __restrict__ w,\n                              const float4* __restrict__ b,\n                              float4* __restrict__ out,\n                              float* __restrict__ partials,\n                              unsigned int* __restrict__ barCount,\n                              int N, int S, float eps) {\n    int pid = blockIdx.x;\n    int m = pid / S;\n    int s = pid % S;\n    int n4 = N / 4 / S;\n    int tid = threadIdx.x;\n    int nthreads = blockDim.x;\n    const float4* xr = x + (long)m * (N / 4) + s * n4;\n    float s1 = 0.f, s2 = 0.f;\n    for (int i = tid; i < n4; i += nthreads) {\n        float4 v;\n        if (MO"]
[1296.597795, "i", "DE == 3) v = __ldcs(&xr[i]); else v = xr[i];\n        s1 += v.x + v.y + v.z + v.w;\n        s2 += v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w;\n    }\n    for (int off = 16; off > 0; off >>= 1) {\n        s1 += __shfl_down_sync(FULL_MASK, s1, off);\n        s2 += __shfl_down_sync(FULL_MASK, s2, off);\n    }\n    __shared__ float sh[2][32];\n    int lane = tid & 31, wid = tid >> 5;\n    int nwarps = nthreads >> 5;\n    if (lane == 0) { sh[0][wid] = s1; sh[1][wid] = s2; }\n    __syncthreads();\n    if (wid == 0) {\n        s1 = (lane < nwarps) ? sh[0][lane] : 0.f;\n        s2 = (lane < nwarps) ? sh[1][lane] : 0.f;\n        for (int off = 16; off > 0; off >>= 1) {\n            s1 += __shfl_down_sync(FULL_MASK, s1, off);\n            s2 += __shfl_down_sync(FULL_MASK, s2, off);\n        }\n        if (lane == 0) {\n            partials[(m * S + s) * 2] = s1;\n            partials[(m * S + s) * 2 + 1] = s2;\n            __threadfence();\n            unsigned int old = atomicAdd(barCount, 1u);\n            if (old == gridDim.x - 1) {\n    "]
[1296.59787, "o", "cat > /workspace/ext/ln_variants.cu <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[1296.598026, "i", "            *barCount = 0u;\n                __threadfence();\n                atomicExch(barCount + 1, 1u);\n            }\n        }\n    }\n    if (MODE == 1) return;\n    if (MODE != 2) {\n        if (tid == 0) {\n            volatile unsigned int* flag = barCount + 1;\n            while (*flag == 0u) { __nanosleep(64); }\n        }\n        __syncthreads();\n    }\n    __shared__ float smean, srstd;\n    if (wid == 0) {\n        const float* pr = partials + m * S * 2;\n        float t1 = 0.f, t2 = 0.f;\n        for (int i = lane; i < S; i += 32) {\n            t1 += pr[i * 2];\n            t2 += pr[i * 2 + 1];\n        }\n        for (int off = 16; off > 0; off >>= 1) {\n            t1 += __shfl_down_sync(FULL_MASK, t1, off);\n            t2 += __shfl_down_sync(FULL_MASK, t2, off);\n        }\n        if (lane == 0) {\n            float mean = t1 / N;\n            float var = t2 / N - mean * mean;\n            var = var < 0.f ? 0.f : var;\n            smean = mean;\n            srstd = rsqrtf(var + eps);\n        }\n    }\n    __syncthre"]
[1296.5981, "o", "> "]
[1296.598139, "i", "ads();\n    float mean = smean, rstd = srstd;\n    const float4* wr = w + s * n4;\n    const float4* br = b + s * n4;\n    float4* op = out + (long)m * (N / 4) + s * n4;\n    for (int i = tid; i < n4; i += nthreads) {\n        float4 v;\n        if (MODE == 3) v = __ldcs(&xr[i]); else v = xr[i];\n        float4 wv = wr[i];\n        float4 bv = br[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        op[i] = o;\n    }\n}\n\nvoid ln_var(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor out,\n            torch::Tensor partials, torch::Tensor bar, int64_t S, int64_t threads, double eps, int64_t mode) {\n    int N = (int)w.numel();\n    long M = x.numel() / N;\n    dim3 grid((unsigned)(M * S));\n    auto stream = at::cuda::getCurrentCUDAStream();\n    auto xp = reinterpret_cast<const float4*>(x.data_ptr<float>());\n    auto wp = reinterpret_cast<cons"]
[1296.598151, "i", "t float4*>(w.data_ptr<float>());\n    auto bp = reinterpret_cast<const float4*>(b.data_ptr<float>());\n    auto op = reinterpret_cast<float4*>(out.data_ptr<float>());\n    auto pp = partials.data_ptr<float>();\n    auto barp = reinterpret_cast<unsigned int*>(bar.data_ptr<int>());\n    if (mode == 0) ln_var_kernel<0><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\n    else if (mode == 1) ln_var_kernel<1><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\n    else if (mode == 2) ln_var_kernel<2><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\n    else ln_var_kernel<3><<<grid, (int)threads, 0, stream>>>(xp, wp, bp, op, pp, barp, N, (int)S, (float)eps);\n}\n\nPYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {\n    m.def(\"ln_var\", &ln_var, \"variants\");\n}\nEOF\nmkdir -p /workspace/ext/build2 && cat > /workspace/test_var.py <<'EOF'\nimport torch, statistics\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load\next = lo"]
[1296.598159, "i", "ad(name='ln_var_ext', sources=['/workspace/ext/ln_variants.cu'],\n           extra_cuda_cflags=['-O3', '--use_fast_math'], build_directory='/workspace/ext/build2', verbose=False)\ndev = 'cuda'\nshape = (16, 64, 256, 256)\nns = (64, 256, 256)\nref = nn.LayerNorm(ns).to(dev)\nx = torch.rand(*shape, device=dev)\nN = 64*256*256; M = 16\nw = ref.weight.contiguous(); b = ref.bias.contiguous()\nwith torch.no_grad():\n    a = ref(x)\ndummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=dev)\ndef timeit(fn, n=15, thrash=True):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    evs = []\n    for i in range(n):\n        torch.cuda.synchronize()\n        if thrash: dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        evs.append(s.elapsed_time(e))\n    return statistics.mean(evs)\nS, threads = 64, 128\npartials = torch.empty(M*S*2, dtype=torch.float32, device=dev)\nbar = torch.zeros(2,"]
[1296.59817, "i", " dtype=torch.int32, device=dev)\nout = torch.empty_like(x)\nnames = {0:'full', 1:'stats+bar', 2:'nobar', 3:'full+ldcs'}\nfor mode in [0, 1, 2, 3]:\n    bar.zero_(); torch.cuda.synchronize()\n    ext.ln_var(x, w, b, out, partials, bar, S, threads, 1e-5, mode)\n    torch.cuda.synchronize()\n    err = (out - a).abs().max().item()\n    t = timeit(lambda: ext.ln_var(x, w, b, out, partials, bar, S, threads, 1e-5, mode))\n    th = timeit(lambda: ext.ln_var(x, w, b, out, partials, bar, S, threads, 1e-5, mode), thrash=False)\n    print(f'mode={names[mode]:10s}: t={t:.4f} ms hot={th:.4f} ms err={err:.2e}')\nEOF\npython3 /workspace/test_var.py\n"]
