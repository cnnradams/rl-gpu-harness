[?2004l[?2004h> __global__ void ln_kernel(const float4* __restrict__ x4,
[?2004l[?2004h>                           const float4* __restrict__ w4,
[?2004l[?2004h>                           const float4* __restrict__ b4,
[?2004l[?2004h>                           float4* __restrict__ y4,
[?2004l[?2004h>                           float* __restrict__ g_sum,
[?2004l[?2004h>                           float* __restrict__ g_sumsq,
[?2004l[?2004h>                           float* __restrict__ g_mean,
[?2004l[?2004h>                           float* __restrict__ g_rstd,
[?2004l[?2004h>                           unsigned int* __restrict__ counters,
[?2004l[?2004h>                           unsigned int* __restrict__ flags,
[?2004l[?2004h>                           int n4, int chunks, float eps) {
[?2004l[?2004h>     int row = blockIdx.y;
[?2004l[?2004h>     int chunk = blockIdx.x;
[?2004l[?2004h>     int chunk_size = (n4 + chunks - 1) / chunks;
[?2004l[?2004h>     int start = chunk * chunk_size;
[?2004l[?2004h>     int end = min(start + chunk_size, n4);
[?2004l[?2004h>     const float4* xr = x4 + (long)row * (long)n4;
[?2004l[?2004h>     float s = 0.f, sq = 0.f;
[?2004l[?2004h>     for (int i = start + threadIdx.x; i < end; i += blockDim.x) {
[?2004l[?2004h>         float4 v = xr[i];
[?2004l[?2004h>         s += v.x + v.y + v.z + v.w;
[?2004l[?2004h>         sq += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;
[?2004l[?2004h>     }
[?2004l[?2004h>     __shared__ float sh_s[32];
[?2004l[?2004h>     __shared__ float sh_q[32];
[?2004l[?2004h>     for (int off = 16; off > 0; off >>= 1) {
[?2004l[?2004h>         s += __shfl_down_sync(FULL_MASK, s, off);
[?2004l[?2004h>         sq += __shfl_down_sync(FULL_MASK, sq, off);
[?2004l[?2004h>     }
