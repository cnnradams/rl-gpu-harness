[130.385309, "o", "\u001b[?2004h"]
[130.385369, "o", "> "]
[130.38575, "o", "    assert torch.allclose(ref, out, atol=1e-4, rtol=1e-4), 'MISMATCH'\r\n\u001b[?2004l\r"]
[130.38577, "o", "\u001b[?2004h"]
