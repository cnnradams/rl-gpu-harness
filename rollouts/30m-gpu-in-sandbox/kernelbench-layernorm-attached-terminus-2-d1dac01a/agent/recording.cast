[822.416818, "o", "\u001b[?2004h"]
[822.416842, "o", "> "]
[822.417271, "o", "            int64_t ps, int64_t psq, int64_t M, int64_t N,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.417821, "o", "            double eps, int64_t chunks, int64_t blockA, int64_t blockB, int64_t stream) {\r\n\u001b[?2004l\r"]
[822.417878, "o", "\u001b[?2004h> "]
[822.418053, "o", "    int n4 = (int)(N / 4);\r\n\u001b[?2004l\r"]
[822.418103, "o", "\u001b[?2004h> "]
[822.418401, "o", "    dim3 grid((unsigned)chunks, (unsigned)M);\r\n\u001b[?2004l\r"]
[822.418492, "o", "\u001b[?2004h> "]
[822.418729, "o", "    cudaStream_t s = (cudaStream_t)stream;\r\n\u001b[?2004l\r"]
[822.418803, "o", "\u001b[?2004h> "]
[822.419494, "o", "    partial_kernel<<<grid, (int)blockA, 0, s>>>((const float4*)x, (float*)ps, (float*)psq, n4, (int)chunks);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.420038, "o", "    norm_kernel<<<grid, (int)blockB, 0, s>>>((const float4*)x, (const float4*)w, (const float4*)b,\r\n\u001b[?2004l\r"]
[822.420058, "o", "\u001b[?2004h"]
[822.420138, "o", "> "]
[822.420762, "o", "                                             (float4*)y, (const float*)ps, (const float*)psq, n4, (int)chunks, (float)eps);\r\n\u001b[?2004l\r"]
[822.420783, "o", "\u001b[?2004h"]
