[130.38059, "o", "> "]
[130.380935, "o", "    psq = torch.empty((Mrows, S), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[130.381028, "o", "\u001b[?2004h> "]
[130.381157, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[130.381242, "o", "\u001b[?2004h> "]
[130.381617, "o", "    _partial_sums_kernel[(Mrows, S)](x, ps, psq, Nn, S, BLOCK=BLOCK)\r\n\u001b[?2004l\r"]
[130.381732, "o", "\u001b[?2004h> "]
[130.382223, "o", "    _normalize_kernel[(Mrows, S)](x, y, w, b, ps, psq, Nn, S, eps, BLOCK=BLOCK, NS=NS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.382332, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.38242, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
