[485.4113, "o", "    float4* yr = y4 + (long)row * (long)n4;\r\n\u001b[?2004l\r"]
[485.41134, "o", "\u001b[?2004h"]
[485.411386, "o", "> "]
[485.41182, "o", "    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.411973, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r"]
[485.412018, "o", "\u001b[?2004h"]
[485.412081, "o", "> "]
[485.412221, "o", "        float4 wv = w4[i];\r\n\u001b[?2004l\r"]
[485.412292, "o", "\u001b[?2004h> "]
[485.41246, "o", "        float4 bv = b4[i];\r\n\u001b[?2004l\r"]
[485.41255, "o", "\u001b[?2004h> "]
[485.41271, "o", "        float4 o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.413069, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.413371, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[485.41343, "o", "\u001b[?2004h"]
[485.413486, "o", "> "]
[485.413745, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[485.413886, "o", "\u001b[?2004h> "]
[485.414107, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[485.4142, "o", "\u001b[?2004h> "]
[485.414298, "o", "        yr[i] = o;\r\n\u001b[?2004l\r"]
[485.41436, "o", "\u001b[?2004h"]
[485.414376, "o", "> "]
[485.414426, "o", "    }\r\n\u001b[?2004l\r"]
[485.414514, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[485.414534, "o", "\u001b[?2004h"]
[485.414637, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.415105, "o", "torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b,\r\n\u001b[?2004l\r"]
[485.415127, "o", "\u001b[?2004h"]
[485.41522, "o", "> "]
[485.4157, "o", "                         torch::Tensor ws, double eps, int64_t chunks_req) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.415968, "o", "    auto y = torch::empty_like(x);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.416139, "o", "    int64_t M = x.size(0);\r\n\u001b[?2004l\r"]
[485.416286, "o", "\u001b[?2004h> "]
[485.416472, "o", "    int64_t N = x.numel() / M;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.416641, "o", "    int n4 = (int)(N / 4);\r\n\u001b[?2004l\r"]
[485.416662, "o", "\u001b[?2004h"]
[485.416783, "o", "> "]
[485.41697, "o", "    float* fws = (float*)ws.data_ptr<int>();\r\n\u001b[?2004l\r"]
[485.417014, "o", "\u001b[?2004h"]
[485.417098, "o", "> "]
[485.417469, "o", "    unsigned int* iws = (unsigned int*)ws.data_ptr<int>();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.417619, "o", "    float* g_sum = fws;\r\n\u001b[?2004l\r"]
[485.417668, "o", "\u001b[?2004h"]
[485.417683, "o", "> "]
[485.417874, "o", "    float* g_sumsq = fws + M;\r\n\u001b[?2004l\r"]
[485.417929, "o", "\u001b[?2004h"]
[485.417949, "o", "> "]
[485.41814, "o", "    float* g_mean = fws + 2*M;\r\n\u001b[?2004l\r"]
[485.4182, "o", "\u001b[?2004h> "]
[485.418408, "o", "    float* g_rstd = fws + 3*M;\r\n\u001b[?2004l\r"]
[485.41849, "o", "\u001b[?2004h> "]
[485.418776, "o", "    unsigned int* counters = iws + 4*M;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.419008, "o", "    unsigned int* flags = iws + 5*M;\r\n\u001b[?2004l\r"]
[485.419031, "o", "\u001b[?2004h"]
[485.41915, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.419418, "o", "    int dev; cudaGetDevice(&dev);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.419966, "o", "    int numSMs; cudaDeviceGetAttribute(&numSMs, cudaDevAttrMultiProcessorCount, dev);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.420101, "o", "    int blocksPerSM = 0;\r\n\u001b[?2004l\r"]
[485.420143, "o", "\u001b[?2004h"]
[485.420193, "o", "> "]
[485.420728, "o", "    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocksPerSM, (const void*)ln_kernel, 256, 0);\r\n\u001b[?2004l\r"]
[485.420749, "o", "\u001b[?2004h"]
[485.420833, "o", "> "]
[485.421205, "o", "    int64_t maxResident = (int64_t)numSMs * std::max(blocksPerSM, 1);\r\n\u001b[?2004l\r"]
[485.421226, "o", "\u001b[?2004h"]
[485.421291, "o", "> "]
[485.421458, "o", "    int64_t chunks = chunks_req;\r\n\u001b[?2004l\r"]
[485.421481, "o", "\u001b[?2004h"]
[485.421575, "o", "> "]
[485.422045, "o", "    if (chunks * M > maxResident) chunks = std::max<int64_t>(1, maxResident / M);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[485.422133, "o", "\u001b[?2004h> "]
[485.422384, "o", "    dim3 grid((unsigned)chunks, (unsigned)M);\r\n\u001b[?2004l\r"]
[485.422472, "o", "\u001b[?2004h> "]
[485.42277, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[485.422792, "o", "\u001b[?2004h"]
[485.422878, "o", "> "]
[485.423133, "o", "    ln_kernel<<<grid, 256, 0, stream>>>(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.42345, "o", "        (const float4*)x.data_ptr<float>(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.423704, "o", "        (const float4*)w.data_ptr<float>(),\r\n\u001b[?2004l\r"]
[485.423725, "o", "\u001b[?2004h"]
[485.423848, "o", "> "]
[485.424012, "o", "        (const float4*)b.data_ptr<float>(),\r\n\u001b[?2004l\r"]
[485.424054, "o", "\u001b[?2004h"]
[485.424075, "o", "> "]
[485.424309, "o", "        (float4*)y.data_ptr<float>(),\r\n\u001b[?2004l\r"]
[485.424363, "o", "\u001b[?2004h"]
[485.424381, "o", "> "]
[485.424708, "o", "        g_sum, g_sumsq, g_mean, g_rstd, counters, flags,\r\n\u001b[?2004l\r"]
[485.42473, "o", "\u001b[?2004h"]
[485.424852, "o", "> "]
[485.425055, "o", "        n4, (int)chunks, (float)eps);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.425181, "o", "    return y;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.425234, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[485.425293, "o", "> '''\r\n\u001b[?2004l\r"]
[485.425348, "o", "\u001b[?2004h"]
[485.425397, "o", "> \r\n\u001b[?2004l\r"]
[485.425417, "o", "\u001b[?2004h"]
[485.425533, "o", "> "]
[485.426227, "o", "cpp_src = 'torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ws, double eps, int64_t chunks_req);'\r\n\u001b[?2004l\r"]
[485.426251, "o", "\u001b[?2004h"]
[485.426356, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.426908, "o", "mod = load_inline(name='ln_split_cuda', cpp_sources=cpp_src, cuda_sources=cuda_src,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.427388, "o", "                  functions=['ln_forward'], extra_cuda_cflags=['-O3'], verbose=False)\r\n\u001b[?2004l\r"]
[485.427441, "o", "\u001b[?2004h"]
[485.427459, "o", "> \r\n\u001b[?2004l\r"]
[485.427504, "o", "\u001b[?2004h"]
[485.427521, "o", "> "]
[485.427719, "o", "B, F, D1, D2 = 16, 64, 256, 256\r\n\u001b[?2004l\r"]
[485.427739, "o", "\u001b[?2004h"]
[485.427819, "o", "> "]
[485.427938, "o", "N = F * D1 * D2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[485.427986, "o", "\u001b[?2004h"]
[485.428, "o", "> "]
[485.428234, "o", "def cuda_fn(x, w, b, eps, ws, chunks):\r\n\u001b[?2004l\r"]
[485.428322, "o", "\u001b[?2004h> "]
[485.428385, "o", "    ws.zero_()\r\n\u001b[?2004l\r"]
[485.428466, "o", "\u001b[?2004h> "]
[485.428751, "o", "    return mod.ln_forward(x, w, b, ws, eps, chunks)\r\n\u001b[?2004l\r"]
[485.428835, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[485.428878, "o", "\u001b[?2004h> "]
[485.428966, "o", "def main():\r\n\u001b[?2004l\r"]
[485.429058, "o", "\u001b[?2004h> "]
[485.429249, "o", "    torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.429527, "o", "    x = torch.rand(B, F, D1, D2, device='cuda')\r\n\u001b[?2004l\r"]
[485.429609, "o", "\u001b[?2004h> "]
[485.429828, "o", "    ln = nn.LayerNorm((F, D1, D2)).cuda()\r\n\u001b[?2004l\r"]
[485.429917, "o", "\u001b[?2004h> "]
[485.430135, "o", "    w, b, eps = ln.weight, ln.bias, ln.eps\r\n\u001b[?2004l\r"]
[485.430178, "o", "\u001b[?2004h"]
[485.430228, "o", "> "]
[485.430344, "o", "    ref = ln(x)\r\n\u001b[?2004l\r"]
[485.430411, "o", "\u001b[?2004h> "]
[485.430792, "o", "    ws = torch.zeros(6 * B, dtype=torch.int32, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.43097, "o", "    for chunks in [16, 32, 64]:\r\n\u001b[?2004l\r"]
[485.431018, "o", "\u001b[?2004h"]
[485.431039, "o", "> "]
[485.431333, "o", "        out = cuda_fn(x, w, b, eps, ws, chunks)\r\n\u001b[?2004l\r"]
[485.431383, "o", "\u001b[?2004h> "]
[485.431649, "o", "        diff = (ref - out).abs().max().item()\r\n\u001b[?2004l\r"]
[485.431733, "o", "\u001b[?2004h> "]
[485.432054, "o", "        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[485.432073, "o", "\u001b[?2004h"]
[485.432163, "o", "> "]
[485.432678, "o", "        ms = triton.testing.do_bench(lambda: cuda_fn(x, w, b, eps, ws, chunks), warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[485.432726, "o", "\u001b[?2004h> "]
[485.433228, "o", "        print(f'chunks={chunks}: diff={diff:.3e} ok={ok} time={ms:.4f} ms')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[485.433641, "o", "    ms_native = triton.testing.do_bench(lambda: ln(x), warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[485.433688, "o", "\u001b[?2004h"]
[485.433716, "o", "> "]
[485.43394, "o", "    print(f'native: {ms_native:.4f} ms')\r\n\u001b[?2004l\r"]
[485.433989, "o", "\u001b[?2004h"]
[485.434009, "o", "> \r\n\u001b[?2004l\r"]
[485.434056, "o", "\u001b[?2004h"]
[485.434107, "o", "> "]
[485.434237, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[485.434331, "o", "\u001b[?2004h> "]
[485.43439, "o", "    main()\r\n\u001b[?2004l\r"]
[485.434405, "o", "\u001b[?2004h"]
[485.434467, "o", "> "]
[485.434485, "o", "EOF\r\n\u001b[?2004l\r"]
[485.442629, "o", "\u001b[?2004h"]
[485.442695, "o", "root@modal:/workspace# "]
[485.442911, "o", "cd /workspace/dev && python3 bench3.py\r\n\u001b[?2004l\r"]
[526.922182, "o", "chunks=16: diff=3.576e-06 ok=True time=0.3823 ms\r\n"]
[526.986961, "o", "chunks=32: diff=3.695e-06 ok=True time=0.3173 ms\r\n"]
