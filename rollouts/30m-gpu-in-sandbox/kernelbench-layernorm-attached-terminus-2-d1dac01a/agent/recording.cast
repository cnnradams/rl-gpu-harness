[130.378641, "o", "        tl.store(y_ptr + row * N + idx, y, mask=mask)\r\n\u001b[?2004l\r"]
[130.378741, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[130.37877, "o", "> "]
[130.378987, "o", "def triton_ln(x, w, b, eps=1e-5):\r\n\u001b[?2004l\r"]
[130.379009, "o", "\u001b[?2004h"]
[130.379092, "o", "> "]
[130.379192, "o", "    Mrows = x.shape[0]\r\n\u001b[?2004l\r"]
