[592.40716, "o", "\u001b[?2004h> "]
[592.407435, "o", "    auto out = torch::zeros({1}, x.options());\r\n\u001b[?2004l\r"]
[592.407602, "o", "\u001b[?2004h> "]
[592.407768, "o", "    long n4tot = x.numel() / 4;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.408085, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[592.408224, "o", "\u001b[?2004h> "]
[592.408824, "o", "    read_kernel<<<4096, 256, 0, stream>>>((const float4*)x.data_ptr<float>(), out.data_ptr<float>(), n4tot);\r\n\u001b[?2004l\r"]
[592.408852, "o", "\u001b[?2004h"]
[592.408863, "o", "> "]
