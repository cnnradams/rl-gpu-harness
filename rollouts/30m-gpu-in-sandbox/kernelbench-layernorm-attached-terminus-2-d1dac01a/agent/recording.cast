[750.977224, "o", "\u001b[?2004h> "]
[750.97762, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[750.977704, "o", "\u001b[?2004h> "]
