[750.978095, "o", "\u001b[?2004h"]
[750.978164, "o", "> "]
[750.978334, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.978482, "o", "        self._ws = None\r\n\u001b[?2004l\r"]
[750.978523, "o", "\u001b[?2004h"]
[750.978571, "o", "> "]
