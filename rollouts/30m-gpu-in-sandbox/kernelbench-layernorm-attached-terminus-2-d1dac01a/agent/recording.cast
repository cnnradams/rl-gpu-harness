[130.379802, "o", "\u001b[?2004h> "]
[130.380002, "o", "    NS = triton.next_power_of_2(S)\r\n\u001b[?2004l\r"]
[130.380141, "o", "\u001b[?2004h> "]
[130.380474, "o", "    ps = torch.empty((Mrows, S), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
