[592.409347, "o", "\u001b[?2004h"]
[592.409408, "o", "> "]
[592.41077, "o", "cpp_src = 'torch::Tensor ln_two(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor psq, double eps, int64_t chunks, int64_t blockA, int64_t blockB, int64_t rev);\\ntorch::Tensor read_bw(torch::Tensor x);'\r\n\u001b[?2004l\r"]
[592.41086, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[592.410883, "o", "\u001b[?2004h"]
[592.410941, "o", "> "]
[592.411416, "o", "mod = load_inline(name='ln_two_cuda', cpp_sources=cpp_src, cuda_sources=cuda_src,\r\n\u001b[?2004l\r"]
[592.411497, "o", "\u001b[?2004h> "]
[592.412094, "o", "                  functions=['ln_two', 'read_bw'], extra_cuda_cflags=['-O3'], verbose=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[592.412201, "o", "\u001b[?2004h> "]
[592.412429, "o", "B, F, D1, D2 = 16, 64, 256, 256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.412539, "o", "N = F * D1 * D2\r\n\u001b[?2004l\r"]
[592.41266, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[592.412684, "o", "\u001b[?2004h"]
[592.412806, "o", "> def main():\r\n\u001b[?2004l\r"]
[592.412843, "o", "\u001b[?2004h"]
[592.412895, "o", "> "]
[592.413096, "o", "    torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.41347, "o", "    x = torch.rand(B, F, D1, D2, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.413723, "o", "    ln = nn.LayerNorm((F, D1, D2)).cuda()\r\n\u001b[?2004l\r"]
[592.413831, "o", "\u001b[?2004h> "]
[592.414042, "o", "    w, b, eps = ln.weight, ln.bias, ln.eps\r\n\u001b[?2004l\r"]
[592.414085, "o", "\u001b[?2004h"]
[592.414107, "o", "> "]
[592.414214, "o", "    ref = ln(x)\r\n\u001b[?2004l\r"]
[592.414299, "o", "\u001b[?2004h> "]
[592.414456, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.414724, "o", "    for chunks in [32, 64, 128]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.41505, "o", "        ps = torch.empty((B, chunks), device='cuda')\r\n\u001b[?2004l\r"]
[592.415097, "o", "\u001b[?2004h"]
[592.415115, "o", "> "]
[592.415533, "o", "        psq = torch.empty((B, chunks), device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.415699, "o", "        for bA in [256, 512]:\r\n\u001b[?2004l\r"]
[592.415797, "o", "\u001b[?2004h> "]
[592.416034, "o", "            for bB in [256, 512]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.416256, "o", "                for rev in [0, 1]:\r\n\u001b[?2004l\r"]
[592.41633, "o", "\u001b[?2004h> "]
[592.416851, "o", "                    fn = lambda: mod.ln_two(x, w, b, ps, psq, eps, chunks, bA, bB, rev)\r\n\u001b[?2004l\r"]
[592.416938, "o", "\u001b[?2004h> "]
[592.41714, "o", "                    out = fn()\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.417242, "o", "> "]
[592.417618, "o", "                    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[592.417641, "o", "\u001b[?2004h"]
[592.417739, "o", "> "]
[592.417874, "o", "                    if not ok:\r\n\u001b[?2004l\r"]
[592.417991, "o", "\u001b[?2004h> "]
[592.418337, "o", "                        print('FAIL', chunks, bA, bB, rev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.418442, "o", "> "]
[592.418575, "o", "                        continue\r\n\u001b[?2004l\r"]
[592.418603, "o", "\u001b[?2004h"]
[592.418665, "o", "> "]
[592.419044, "o", "                    ms = triton.testing.do_bench(fn, warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[592.4191, "o", "\u001b[?2004h"]
[592.419124, "o", "> "]
[592.419534, "o", "                    results.append((ms, chunks, bA, bB, rev))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.419694, "o", "    results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.419862, "o", "    for r in results[:10]:\r\n\u001b[?2004l\r"]
[592.419883, "o", "\u001b[?2004h"]
[592.419952, "o", "> "]
[592.420416, "o", "        print(f'{r[0]:.4f} ms chunks={r[1]} blockA={r[2]} blockB={r[3]} rev={r[4]}')\r\n\u001b[?2004l\r"]
[592.420484, "o", "\u001b[?2004h> "]
[592.420928, "o", "    ms_read = triton.testing.do_bench(lambda: mod.read_bw(x), warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[592.420949, "o", "\u001b[?2004h"]
[592.421081, "o", "> "]
[592.421485, "o", "    print(f'pure read 268MB: {ms_read:.4f} ms -> {268.4/ms_read:.0f} GB/s')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.421898, "o", "    ms_native = triton.testing.do_bench(lambda: ln(x), warmup=10, rep=50)\r\n\u001b[?2004l\r"]
[592.421937, "o", "\u001b[?2004h"]
[592.421957, "o", "> "]
[592.4222, "o", "    print(f'native: {ms_native:.4f} ms')\r\n\u001b[?2004l\r"]
[592.422222, "o", "\u001b[?2004h"]
[592.422332, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.422553, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
