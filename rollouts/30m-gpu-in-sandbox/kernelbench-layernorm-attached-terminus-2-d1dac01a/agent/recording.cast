[130.385906, "o", "> "]
[130.386304, "o", "    ms_native = triton.testing.do_bench(lambda: ln(x), warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[130.386377, "o", "\u001b[?2004h> "]
[130.386928, "o", "    ms_f = triton.testing.do_bench(lambda: F.layer_norm(x, NORM, w, b, eps), warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[130.386948, "o", "\u001b[?2004h"]
[130.387077, "o", "> "]
[130.387536, "o", "    ms_triton = triton.testing.do_bench(lambda: triton_ln(x, w, b, eps), warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[130.387677, "o", "\u001b[?2004h> "]
[130.387924, "o", "    print(f'native nn.LayerNorm: {ms_native:.4f} ms')\r\n\u001b[?2004l\r"]
[130.387945, "o", "\u001b[?2004h"]
[130.388036, "o", "> "]
[130.388286, "o", "    print(f'F.layer_norm:        {ms_f:.4f} ms')\r\n\u001b[?2004l\r"]
[130.388339, "o", "\u001b[?2004h"]
[130.388357, "o", "> "]
[130.388758, "o", "    print(f'triton split:        {ms_triton:.4f} ms')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
