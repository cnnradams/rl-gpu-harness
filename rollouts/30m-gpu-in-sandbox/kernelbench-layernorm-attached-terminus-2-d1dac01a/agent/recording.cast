[750.950684, "o", "> "]
[750.951002, "o", "        sq += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\r\n\u001b[?2004l\r"]
[750.951023, "o", "\u001b[?2004h"]
[750.951112, "o", ">     }\r\n\u001b[?2004l\r"]
[750.951133, "o", "\u001b[?2004h"]
[750.951195, "o", "> "]
