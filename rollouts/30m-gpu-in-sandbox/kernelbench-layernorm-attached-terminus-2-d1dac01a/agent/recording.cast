[362.279555, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\n\n@triton.jit\ndef _ps(x_ptr, ps_ptr, psq_ptr, Nn, S, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    chunk_size = tl.cdiv(Nn, S)\n    start = chunk * chunk_size\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    end = tl.minimum(start + chunk_size, Nn)\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < end\n        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\n        acc += v\n        acc2 += v * v\n    tl.store(ps_ptr + row * S + chunk, tl.sum(acc))\n    tl.store(psq_ptr + row * S + chunk, tl.sum(acc2))\n\n@triton.jit\ndef _nm(x_ptr, y_ptr, w_ptr, b_ptr, ps_ptr, psq_ptr, Nn, S, eps,\n        BLOCK: tl.constexpr, NS: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    chunk_size = tl."]
[362.279824, "i", "cdiv(Nn, S)\n    start = chunk * chunk_size\n    sidx = tl.arange(0, NS)\n    smask = sidx < S\n    ps = tl.load(ps_ptr + row * S + sidx, mask=smask, other=0.0)\n    psq = tl.load(psq_ptr + row * S + sidx, mask=smask, other=0.0)\n    total = tl.sum(ps)\n    totalsq = tl.sum(psq)\n    mean = total / Nn\n    var = totalsq / Nn - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    end = tl.minimum(start + chunk_size, Nn)\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < end\n        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\n        w = tl.load(w_ptr + idx, mask=mask, other=0.0)\n        b = tl.load(b_ptr + idx, mask=mask, other=0.0)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + row * Nn + idx, y, mask=mask)\n\n@triton.jit\ndef _copy(x_ptr, y_ptr, total, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    idx = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = idx < total\n    v = tl.load(x_ptr + idx, mask=mask)\n    tl.store(y_ptr + idx,"]
[362.279943, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[362.28003, "i", " v, mask=mask)\n\ndef fn(x, w, b, eps, S=256, BA=4096, BB=2048, WA=4, WB=4):\n    M = x.shape[0]\n    NS = triton.next_power_of_2(S)\n    ps = torch.empty((M, S), device=x.device, dtype=torch.float32)\n    psq = torch.empty((M, S), device=x.device, dtype=torch.float32)\n    y = torch.empty_like(x)\n    _ps[(M, S)](x, ps, psq, N, S, BLOCK=BA, num_warps=WA)\n    _nm[(M, S)](x, y, w, b, ps, psq, N, S, eps, BLOCK=BB, NS=NS, num_warps=WB)\n    return y\n\ndef main():\n    torch.manual_seed(0)\n    x = torch.rand(B, F, D1, D2, device='cuda')\n    ln = nn.LayerNorm((F, D1, D2)).cuda()\n    w, b, eps = ln.weight, ln.bias, ln.eps\n    ref = ln(x)\n    out = fn(x, w, b, eps)\n    print('max diff:', (ref - out).abs().max().item())\n    assert torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n\n    y = torch.empty_like(x)\n    total = x.numel()\n    ms_copy = triton.testing.do_bench(lambda: _copy[(triton.cdiv(total, 4096),)](x, y, total, BLOCK=4096), warmup=10, rep=50)\n    S, BA, BB, WA, WB = 256, 4096, 2048, 4, 4\n    ps = torch.empty((B, S), dev"]
[362.280117, "o", "\u001b[?2004h> "]
[362.28016, "i", "ice='cuda')\n    psq = torch.empty((B, S), device='cuda')\n    ms_a = triton.testing.do_bench(lambda: _ps[(B, S)](x, ps, psq, N, S, BLOCK=BA, num_warps=WA), warmup=10, rep=50)\n    ms_b = triton.testing.do_bench(lambda: _nm[(B, S)](x, y, w, b, ps, psq, N, S, eps, BLOCK=BB, NS=triton.next_power_of_2(S), num_warps=WB), warmup=10, rep=50)\n    ms_full = triton.testing.do_bench(lambda: fn(x, w, b, eps), warmup=10, rep=50)\n    print(f'copy floor (536MB): {ms_copy:.4f} ms')\n    print(f'kernel A (268MB):   {ms_a:.4f} ms')\n    print(f'kernel B (568MB):   {ms_b:.4f} ms')\n    print(f'full triton:        {ms_full:.4f} ms')\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 /workspace/bench2.py\n"]
