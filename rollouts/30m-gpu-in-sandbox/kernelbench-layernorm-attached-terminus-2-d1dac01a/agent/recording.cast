[822.420994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[822.421046, "o", "> "]
[822.422261, "o", "_cpp_src = '#include <cstdint>\\nvoid ln_two(int64_t x, int64_t w, int64_t b, int64_t y, int64_t ps, int64_t psq, int64_t M, int64_t N, double eps, int64_t chunks, int64_t blockA, int64_t blockB, int64_t stream);'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[822.422281, "o", "\u001b[?2004h"]
[822.422374, "o", "> "]
[822.422799, "o", "_mod = load_inline(name='ln_split_eval2', cpp_sources=_cpp_src, cuda_sources=_cuda_src,\r\n\u001b[?2004l\r"]
[822.422817, "o", "\u001b[?2004h"]
[822.422873, "o", "> "]
[822.423275, "o", "                   functions=['ln_two'], extra_cuda_cflags=['-O3'], verbose=False)\r\n\u001b[?2004l\r"]
[822.423296, "o", "\u001b[?2004h"]
[822.423361, "o", "> \r\n\u001b[?2004l\r"]
