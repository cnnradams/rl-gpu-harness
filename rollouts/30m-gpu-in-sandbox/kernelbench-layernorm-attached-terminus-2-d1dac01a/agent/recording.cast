[682.578661, "o", "{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\",\r\n    \"excessive_speedup\": true\r\n  },\r\n  \"runtime\": 0.319,\r\n  \"runtime_stats\": {\r\n    \"mean\": 0.319,\r\n    \"std\": 0.00645,\r\n    \"min\": 0.316,\r\n    \"max\": 0.347,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 8.06,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 8.06,\r\n    \"std\": 0.00388,\r\n    \"min\": 8.05,\r\n    \"max\": 8.07,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"c261c4c82f5a498a7f48eaadaddf9b034a25d3ab2c8b44fa839daaa4355dc7ed\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 25.266457680250785\r\n}\r\n"]
