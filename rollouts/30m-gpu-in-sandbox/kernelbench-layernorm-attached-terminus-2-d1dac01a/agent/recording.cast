[750.943368, "i", "cat > /workspace/solution_cuda.py << 'EOF'\nimport torch\nimport torch.nn as nn\nfrom torch.utils.cpp_extension import load_inline\n\n_cuda_src = r'''\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <ATen/cuda/CUDAContext.h>\n\n#define FULL_MASK 0xffffffffu\n\n__global__ void partial_kernel(const float4* __restrict__ x4,\n                               float* __restrict__ ps,\n                               float* __restrict__ psq,\n                               int n4, int chunks) {\n    int row = blockIdx.y;\n    int chunk = blockIdx.x;\n    int chunk_size = (n4 + chunks - 1) / chunks;\n    int start = chunk * chunk_size;\n    int end = min(start + chunk_size, n4);\n    const float4* xr = x4 + (long)row * (long)n4;\n    float s = 0.f, sq = 0.f;\n    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\n        float4 v = xr[i];\n        s += v.x + v.y + v.z + v.w;\n        sq += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n    __shared__ float sh_s[32];\n    __shared__ float sh_q[32];\n    for (int off = 1"]
[750.943578, "i", "6; off > 0; off >>= 1) {\n        s += __shfl_down_sync(FULL_MASK, s, off);\n        sq += __shfl_down_sync(FULL_MASK, sq, off);\n    }\n    int lane = threadIdx.x & 31;\n    int warp = threadIdx.x >> 5;\n    if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\n    __syncthreads();\n    int nwarp = (blockDim.x + 31) >> 5;\n    if (warp == 0) {\n        s = (lane < nwarp) ? sh_s[lane] : 0.f;\n        sq = (lane < nwarp) ? sh_q[lane] : 0.f;\n        for (int off = 16; off > 0; off >>= 1) {\n            s += __shfl_down_sync(FULL_MASK, s, off);\n            sq += __shfl_down_sync(FULL_MASK, sq, off);\n        }\n        if (lane == 0) {\n            ps[row * chunks + chunk] = s;\n            psq[row * chunks + chunk] = sq;\n        }\n    }\n}\n\n__global__ void norm_kernel(const float4* __restrict__ x4,\n                            const float4* __restrict__ w4,\n                            const float4* __restrict__ b4,\n                            float4* __restrict__ y4,\n                            const float* __restrict__ ps,\n     "]
[750.943645, "i", "                       const float* __restrict__ psq,\n                            int n4, int chunks, float eps) {\n    int row = blockIdx.y;\n    int chunk = (int)blockIdx.x;\n    int chunk_size = (n4 + chunks - 1) / chunks;\n    int start = chunk * chunk_size;\n    int end = min(start + chunk_size, n4);\n    __shared__ float s_mean, s_rstd;\n    if (threadIdx.x == 0) {\n        float total = 0.f, totalsq = 0.f;\n        for (int c = 0; c < chunks; ++c) {\n            total += ps[row * chunks + c];\n            totalsq += psq[row * chunks + c];\n        }\n        float n = (float)n4 * 4.0f;\n        float mean = total / n;\n        float var = totalsq / n - mean * mean;\n        s_mean = mean;\n        s_rstd = rsqrtf(var + eps);\n    }\n    __syncthreads();\n    float mean = s_mean;\n    float rstd = s_rstd;\n    const float4* xr = x4 + (long)row * (long)n4;\n    float4* yr = y4 + (long)row * (long)n4;\n    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\n        float4 v = xr[i];\n        float4 wv = w4[i];\n        f"]
[750.943746, "i", "loat4 bv = b4[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        yr[i] = o;\n    }\n}\n\nvoid ln_two(const float* x, const float* w, const float* b, float* y,\n            float* ps, float* psq, long M, long N,\n            double eps, int chunks, int blockA, int blockB, cudaStream_t stream) {\n    int n4 = (int)(N / 4);\n    dim3 grid((unsigned)chunks, (unsigned)M);\n    partial_kernel<<<grid, blockA, 0, stream>>>((const float4*)x, ps, psq, n4, chunks);\n    norm_kernel<<<grid, blockB, 0, stream>>>((const float4*)x, (const float4*)w, (const float4*)b,\n                                             (float4*)y, ps, psq, n4, chunks, (float)eps);\n}\n'''\n\n_cpp_src = 'void ln_two(const float* x, const float* w, const float* b, float* y, float* ps, float* psq, long M, long N, double eps, int chunks, int blockA, int blockB, cudaStream_t stream);'\n\n_mod = lo"]
[750.943863, "i", "ad_inline(name='ln_split_eval', cpp_sources=_cpp_src, cuda_sources=_cuda_src,\n                   functions=['ln_two'], extra_cuda_cflags=['-O3'], verbose=False)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n        self.eps = 1e-5\n        self._ws = None\n        self._out = None\n        self._chunks = 32\n\n    def _lazy(self, x, M, N):\n        if self._ws is None or self._ws.device != x.device:\n            self._ws = torch.empty((M, 2 * self._chunks), device=x.device, dtype=torch.float32)\n        if self._out is None or self._out.shape != x.shape or self._out.device != x.device:\n            self._out = torch.empty_like(x.contiguous())\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not (x.is_cuda and x.dtype == torch.float32):\n            re"]
[750.943906, "o", "cat > /workspace/solution_cuda.py << 'EOF'\r\n\u001b[?2004l\r"]
[750.944005, "i", "turn torch.nn.functional.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\n        xs = x.shape\n        nn_dim = len(self.normalized_shape)\n        lead = 1\n        if len(xs) > nn_dim:\n            for d in xs[:-nn_dim]:\n                lead *= d\n        N = 1\n        for d in self.normalized_shape:\n            N *= d\n        xc = x.contiguous()\n        self._lazy(xc, lead, N)\n        ws = self._ws\n        out = self._out\n        stream = torch.cuda.current_stream(x.device).cuda_stream\n        w = self.weight.contiguous()\n        b = self.bias.contiguous()\n        _mod.ln_two(xc.data_ptr(), w.data_ptr(), b.data_ptr(), out.data_ptr(),\n                    ws.data_ptr(), ws[:, self._chunks:].data_ptr(), lead, N,\n                    self.eps, self._chunks, 512, 256, stream)\n        return out\nEOF\ncd /workspace && python3 /opt/task/evaluate.py /workspace/solution_cuda.py\n"]
[750.944093, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
