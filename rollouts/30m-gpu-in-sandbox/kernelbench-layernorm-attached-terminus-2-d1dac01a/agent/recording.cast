[822.404086, "o", "\u001b[?2004h> "]
[822.404491, "o", "                            const float4* __restrict__ w4,\r\n\u001b[?2004l\r"]
[822.404636, "o", "\u001b[?2004h> "]
[822.404938, "o", "                            const float4* __restrict__ b4,\r\n\u001b[?2004l\r"]
[822.404961, "o", "\u001b[?2004h"]
[822.405087, "o", "> "]
[822.4054, "o", "                            float4* __restrict__ y4,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.405769, "o", "                            const float* __restrict__ ps,\r\n\u001b[?2004l\r"]
[822.405824, "o", "\u001b[?2004h> "]
[822.406268, "o", "                            const float* __restrict__ psq,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.40664, "o", "                            int n4, int chunks, float eps) {\r\n\u001b[?2004l\r"]
[822.40675, "o", "\u001b[?2004h> "]
[822.406882, "o", "    int row = blockIdx.y;\r\n\u001b[?2004l\r"]
[822.406903, "o", "\u001b[?2004h"]
[822.406938, "o", "> "]
[822.407198, "o", "    int chunk = (int)blockIdx.x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.407511, "o", "    int chunk_size = (n4 + chunks - 1) / chunks;\r\n\u001b[?2004l\r"]
[822.407592, "o", "\u001b[?2004h> "]
[822.407852, "o", "    int start = chunk * chunk_size;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.408122, "o", "    int end = min(start + chunk_size, n4);\r\n\u001b[?2004l\r"]
[822.408195, "o", "\u001b[?2004h> "]
[822.408475, "o", "    __shared__ float s_mean, s_rstd;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.408647, "o", "    if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[822.408698, "o", "\u001b[?2004h"]
[822.408744, "o", "> "]
[822.409004, "o", "        float total = 0.f, totalsq = 0.f;\r\n\u001b[?2004l\r"]
[822.409103, "o", "\u001b[?2004h> "]
[822.409346, "o", "        for (int c = 0; c < chunks; ++c) {\r\n\u001b[?2004l\r"]
[822.40937, "o", "\u001b[?2004h"]
[822.40949, "o", "> "]
[822.409732, "o", "            total += ps[row * chunks + c];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.410012, "o", "            totalsq += psq[row * chunks + c];\r\n\u001b[?2004l\r"]
[822.410154, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[822.410207, "o", "\u001b[?2004h> "]
[822.41045, "o", "        float n = (float)n4 * 4.0f;\r\n\u001b[?2004l\r"]
[822.410473, "o", "\u001b[?2004h"]
[822.410565, "o", "> "]
[822.410764, "o", "        float mean = total / n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.411061, "o", "        float var = totalsq / n - mean * mean;\r\n\u001b[?2004l\r"]
[822.411111, "o", "\u001b[?2004h> "]
[822.411273, "o", "        s_mean = mean;\r\n\u001b[?2004l\r"]
[822.411367, "o", "\u001b[?2004h> "]
[822.411628, "o", "        s_rstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.41167, "o", "    }\r\n\u001b[?2004l\r"]
[822.411711, "o", "\u001b[?2004h"]
[822.411778, "o", "> "]
[822.411921, "o", "    __syncthreads();\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.411975, "o", "> "]
[822.412097, "o", "    float mean = s_mean;\r\n\u001b[?2004l\r"]
[822.412147, "o", "\u001b[?2004h"]
[822.412168, "o", "> "]
[822.41234, "o", "    float rstd = s_rstd;\r\n\u001b[?2004l\r"]
[822.412364, "o", "\u001b[?2004h"]
[822.412446, "o", "> "]
[822.412705, "o", "    const float4* xr = x4 + (long)row * (long)n4;\r\n\u001b[?2004l\r"]
[822.41282, "o", "\u001b[?2004h> "]
[822.41305, "o", "    float4* yr = y4 + (long)row * (long)n4;\r\n\u001b[?2004l\r"]
[822.413104, "o", "\u001b[?2004h> "]
[822.413578, "o", "    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.413805, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.41403, "o", "        float4 wv = w4[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.414202, "o", "        float4 bv = b4[i];\r\n\u001b[?2004l\r"]
[822.414296, "o", "\u001b[?2004h> "]
[822.414398, "o", "        float4 o;\r\n\u001b[?2004l\r"]
[822.414454, "o", "\u001b[?2004h"]
[822.414474, "o", "> "]
[822.414773, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[822.414795, "o", "\u001b[?2004h"]
[822.41488, "o", "> "]
[822.415198, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.415564, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.415853, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[822.4159, "o", "\u001b[?2004h"]
[822.415953, "o", "> "]
[822.416131, "o", "        yr[i] = o;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.416157, "o", "    }\r\n\u001b[?2004l\r"]
[822.416277, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.4163, "o", "> \r\n\u001b[?2004l\r"]
