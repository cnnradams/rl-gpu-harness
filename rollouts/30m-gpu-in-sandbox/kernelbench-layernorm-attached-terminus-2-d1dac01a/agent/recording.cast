[822.398379, "o", "        sq += __shfl_down_sync(FULL_MASK, sq, off);\r\n\u001b[?2004l\r"]
[822.398401, "o", "\u001b[?2004h"]
[822.398487, "o", ">     }\r\n\u001b[?2004l\r"]
[822.398547, "o", "\u001b[?2004h> "]
[822.398819, "o", "    int lane = threadIdx.x & 31;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.399031, "o", "    int warp = threadIdx.x >> 5;\r\n\u001b[?2004l\r"]
[822.399137, "o", "\u001b[?2004h> "]
[822.399506, "o", "    if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.399631, "o", "    __syncthreads();\r\n\u001b[?2004l\r"]
[822.399675, "o", "\u001b[?2004h"]
[822.399698, "o", "> "]
[822.399938, "o", "    int nwarp = (blockDim.x + 31) >> 5;\r\n\u001b[?2004l\r"]
[822.400022, "o", "\u001b[?2004h> "]
[822.400145, "o", "    if (warp == 0) {\r\n\u001b[?2004l\r"]
[822.400168, "o", "\u001b[?2004h"]
[822.400302, "o", "> "]
[822.400562, "o", "        s = (lane < nwarp) ? sh_s[lane] : 0.f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.40093, "o", "        sq = (lane < nwarp) ? sh_q[lane] : 0.f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.401292, "o", "        for (int off = 16; off > 0; off >>= 1) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.401629, "o", "            s += __shfl_down_sync(FULL_MASK, s, off);\r\n\u001b[?2004l\r"]
[822.401651, "o", "\u001b[?2004h"]
[822.401744, "o", "> "]
[822.402072, "o", "            sq += __shfl_down_sync(FULL_MASK, sq, off);\r\n\u001b[?2004l\r"]
[822.402177, "o", "\u001b[?2004h> "]
[822.402233, "o", "        }\r\n\u001b[?2004l\r"]
[822.402293, "o", "\u001b[?2004h> "]
[822.402475, "o", "        if (lane == 0) {\r\n\u001b[?2004l\r"]
[822.402616, "o", "\u001b[?2004h> "]
[822.402803, "o", "            ps[row * chunks + chunk] = s;\r\n\u001b[?2004l\r"]
[822.402861, "o", "\u001b[?2004h> "]
[822.403151, "o", "            psq[row * chunks + chunk] = sq;\r\n\u001b[?2004l\r"]
[822.403299, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[822.403363, "o", "\u001b[?2004h> "]
[822.403446, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.403502, "o", "> }\r\n\u001b[?2004l\r"]
