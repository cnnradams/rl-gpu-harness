[135.603807, "o", "\u001b[?2004hroot@modal:/workspace# "]
[207.825559, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, itertools\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\n\n@triton.jit\ndef _ps(x_ptr, ps_ptr, psq_ptr, Nn, S, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    chunk_size = tl.cdiv(Nn, S)\n    start = chunk * chunk_size\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    end = tl.minimum(start + chunk_size, Nn)\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < end\n        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\n        acc += v\n        acc2 += v * v\n    tl.store(ps_ptr + row * S + chunk, tl.sum(acc))\n    tl.store(psq_ptr + row * S + chunk, tl.sum(acc2))\n\n@triton.jit\ndef _nm(x_ptr, y_ptr, w_ptr, b_ptr, ps_ptr, psq_ptr, Nn, S, eps,\n        BLOCK: tl.constexpr, NS: tl.constexpr, D1C: tl.constexpr, D2C: tl.constexpr):\n    row = tl.program_id(0)\n "]
[207.825759, "i", "   chunk = tl.program_id(1)\n    chunk_size = tl.cdiv(Nn, S)\n    start = chunk * chunk_size\n    sidx = tl.arange(0, NS)\n    smask = sidx < S\n    ps = tl.load(ps_ptr + row * S + sidx, mask=smask, other=0.0)\n    psq = tl.load(psq_ptr + row * S + sidx, mask=smask, other=0.0)\n    total = tl.sum(ps)\n    totalsq = tl.sum(psq)\n    mean = total / Nn\n    var = totalsq / Nn - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    end = tl.minimum(start + chunk_size, Nn)\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < end\n        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\n        f = idx // (D1C * D2C)\n        rem = idx % (D1C * D2C)\n        d1 = rem // D2C\n        d2 = rem % D2C\n        widx = f * D1C * D2C + d1 * D2C + d2\n        w = tl.load(w_ptr + widx, mask=mask, other=0.0)\n        b = tl.load(b_ptr + widx, mask=mask, other=0.0)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + row * Nn + idx, y, mask=mask)\n\ndef make_fn(S, BLOC"]
[207.825898, "i", "K_A, BLOCK_B, WA, WB):\n    NS = triton.next_power_of_2(S)\n    def fn(x, w, b, eps):\n        M = x.shape[0]\n        ps = torch.empty((M, S), device=x.device, dtype=torch.float32)\n        psq = torch.empty((M, S), device=x.device, dtype=torch.float32)\n        y = torch.empty_like(x)\n        _ps[(M, S)](x, ps, psq, N, S, BLOCK=BLOCK_A, num_warps=WA)\n        _nm[(M, S)](x, y, w, b, ps, psq, N, S, eps, BLOCK=BLOCK_B, NS=NS, D1C=D1, D2C=D2, num_warps=WB)\n        return y\n    return fn\n\ndef main():\n    torch.manual_seed(0)\n    x = torch.rand(B, F, D1, D2, device='cuda')\n    ln = nn.LayerNorm((F, D1, D2)).cuda()\n    w, b, eps = ln.weight, ln.bias, ln.eps\n    ref = ln(x)\n    results = []\n    for S in [32, 64, 128, 256]:\n        for BA in [2048, 4096, 8192]:\n            for WA in [4, 8]:\n                for BB in [2048, 4096, 8192]:\n                    for WB in [4, 8]:\n                        fn = make_fn(S, BA, BB, WA, WB)\n                        out = fn(x, w, b, eps)\n                        if not torch.allclose(re"]
[207.825974, "o", "cat > /workspace/sweep.py << 'EOF'\r\n\u001b[?2004l\r"]
[207.82604, "i", "f, out, atol=1e-4, rtol=1e-4):\n                            print('FAIL', S, BA, BB, WA, WB)\n                            continue\n                        ms = triton.testing.do_bench(lambda: fn(x, w, b, eps), warmup=10, rep=50)\n                        results.append((ms, S, BA, BB, WA, WB))\n    results.sort()\n    for r in results[:12]:\n        print(f'{r[0]:.4f} ms  S={r[1]} BA={r[2]} BB={r[3]} WA={r[4]} WB={r[5]}')\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 /workspace/sweep.py\n"]
