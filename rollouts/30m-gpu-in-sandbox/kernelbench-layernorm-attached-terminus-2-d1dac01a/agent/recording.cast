[750.949167, "o", "> "]
[750.949434, "o", "    const float4* xr = x4 + (long)row * (long)n4;\r\n\u001b[?2004l\r"]
[750.949522, "o", "\u001b[?2004h> "]
[750.949674, "o", "    float s = 0.f, sq = 0.f;\r\n\u001b[?2004l\r"]
