[822.423504, "o", "> "]
[822.423635, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[822.423703, "o", "\u001b[?2004h> "]
[822.423987, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[822.424009, "o", "\u001b[?2004h"]
[822.42408, "o", "> "]
[822.424216, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[822.424237, "o", "\u001b[?2004h"]
[822.424339, "o", "> "]
[822.424598, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[822.424621, "o", "\u001b[?2004h"]
[822.424705, "o", "> "]
[822.425055, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[822.425138, "o", "\u001b[?2004h> "]
[822.425518, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[822.425539, "o", "\u001b[?2004h"]
[822.425667, "o", "> "]
[822.425752, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.425772, "o", "> "]
[822.425927, "o", "        self._ps = None\r\n\u001b[?2004l\r"]
[822.426066, "o", "\u001b[?2004h> "]
[822.426147, "o", "        self._psq = None\r\n\u001b[?2004l\r"]
[822.426168, "o", "\u001b[?2004h"]
[822.426266, "o", "> "]
[822.426407, "o", "        self._out = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.426562, "o", "        self._chunks = 32\r\n\u001b[?2004l\r"]
[822.426671, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[822.426684, "o", "> "]
[822.426866, "o", "    def _lazy(self, x, lead):\r\n\u001b[?2004l\r"]
[822.426949, "o", "\u001b[?2004h> "]
[822.427438, "o", "        if self._ps is None or self._ps.device != x.device or self._ps.shape[0] != lead:\r\n\u001b[?2004l\r"]
[822.427459, "o", "\u001b[?2004h"]
[822.427542, "o", "> "]
[822.428031, "o", "            self._ps = torch.empty((lead, self._chunks), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[822.428052, "o", "\u001b[?2004h"]
[822.428185, "o", "> "]
[822.428639, "o", "            self._psq = torch.empty((lead, self._chunks), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[822.428659, "o", "\u001b[?2004h"]
[822.428785, "o", "> "]
[822.429259, "o", "        if self._out is None or self._out.shape != x.shape or self._out.device != x.device:\r\n\u001b[?2004l\r"]
[822.429282, "o", "\u001b[?2004h"]
[822.429414, "o", "> "]
[822.429687, "o", "            self._out = torch.empty_like(x.contiguous())\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.429729, "o", "> \r\n\u001b[?2004l\r"]
[822.429796, "o", "\u001b[?2004h> "]
[822.430213, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.430615, "o", "        if not (x.is_cuda and x.dtype == torch.float32):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.431288, "o", "            return torch.nn.functional.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[822.431357, "o", "\u001b[?2004h"]
[822.431389, "o", "> "]
[822.431521, "o", "        xs = x.shape\r\n\u001b[?2004l\r"]
[822.43163, "o", "\u001b[?2004h> "]
[822.43189, "o", "        nn_dim = len(self.normalized_shape)\r\n\u001b[?2004l\r"]
[822.431913, "o", "\u001b[?2004h"]
[822.432034, "o", "> "]
[822.432098, "o", "        lead = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.432138, "o", "> "]
[822.432327, "o", "        if len(xs) > nn_dim:\r\n\u001b[?2004l\r"]
[822.432432, "o", "\u001b[?2004h> "]
[822.432674, "o", "            for d in xs[:-nn_dim]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.432845, "o", "                lead *= d\r\n\u001b[?2004l\r"]
[822.43294, "o", "\u001b[?2004h> "]
[822.433025, "o", "        N = 1\r\n\u001b[?2004l\r"]
[822.433048, "o", "\u001b[?2004h"]
[822.43309, "o", "> "]
[822.433342, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[822.433362, "o", "\u001b[?2004h"]
[822.433485, "o", "> "]
[822.433533, "o", "            N *= d\r\n\u001b[?2004l\r"]
[822.433585, "o", "\u001b[?2004h> "]
[822.433775, "o", "        xc = x.contiguous()\r\n\u001b[?2004l\r"]
[822.433859, "o", "\u001b[?2004h> "]
[822.43403, "o", "        self._lazy(xc, lead)\r\n\u001b[?2004l\r"]
[822.434052, "o", "\u001b[?2004h"]
[822.434141, "o", "> "]
[822.434247, "o", "        out = self._out\r\n\u001b[?2004l\r"]
[822.434292, "o", "\u001b[?2004h"]
[822.43435, "o", "> "]
[822.434795, "o", "        stream = torch.cuda.current_stream(x.device).cuda_stream\r\n\u001b[?2004l\r\u001b[?2004h> "]
[822.435015, "o", "        w = self.weight.contiguous()\r\n\u001b[?2004l\r"]
[822.435113, "o", "\u001b[?2004h> "]
[822.435308, "o", "        b = self.bias.contiguous()\r\n\u001b[?2004l\r"]
[822.435361, "o", "\u001b[?2004h"]
[822.435418, "o", "> "]
[822.435866, "o", "        _mod.ln_two(xc.data_ptr(), w.data_ptr(), b.data_ptr(), out.data_ptr(),\r\n\u001b[?2004l\r"]
[822.435887, "o", "\u001b[?2004h"]
[822.43597, "o", "> "]
[822.436372, "o", "                    self._ps.data_ptr(), self._psq.data_ptr(), lead, N,\r\n\u001b[?2004l\r"]
[822.436395, "o", "\u001b[?2004h"]
[822.436474, "o", "> "]
[822.436813, "o", "                    self.eps, self._chunks, 512, 256, stream)\r\n\u001b[?2004l\r"]
[822.436834, "o", "\u001b[?2004h"]
[822.436908, "o", "> "]
[822.437037, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[822.437058, "o", "> "]
[822.437084, "o", "EOF\r\n\u001b[?2004l\r"]
