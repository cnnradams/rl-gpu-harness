[750.961823, "o", "\u001b[?2004h"]
[750.961883, "o", "> "]
[750.962124, "o", "    __shared__ float s_mean, s_rstd;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.962294, "o", "    if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[750.962362, "o", "\u001b[?2004h> "]
[750.962663, "o", "        float total = 0.f, totalsq = 0.f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.962968, "o", "        for (int c = 0; c < chunks; ++c) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.963224, "o", "            total += ps[row * chunks + c];\r\n\u001b[?2004l\r"]
[750.963246, "o", "\u001b[?2004h"]
[750.963337, "o", "> "]
[750.963562, "o", "            totalsq += psq[row * chunks + c];\r\n\u001b[?2004l\r"]
[750.963584, "o", "\u001b[?2004h"]
[750.963674, "o", ">         }\r\n\u001b[?2004l\r"]
[750.963741, "o", "\u001b[?2004h> "]
[750.96396, "o", "        float n = (float)n4 * 4.0f;\r\n\u001b[?2004l\r"]
[750.963981, "o", "\u001b[?2004h"]
[750.964076, "o", "> "]
[750.964269, "o", "        float mean = total / n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.964553, "o", "        float var = totalsq / n - mean * mean;\r\n\u001b[?2004l\r"]
[750.964641, "o", "\u001b[?2004h> "]
[750.964813, "o", "        s_mean = mean;\r\n\u001b[?2004l\r\u001b[?2004h> "]
