[750.953367, "o", "\u001b[?2004h"]
[750.953429, "o", "> "]
[750.953781, "o", "    if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.953964, "o", "    __syncthreads();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.954268, "o", "    int nwarp = (blockDim.x + 31) >> 5;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.954403, "o", "    if (warp == 0) {\r\n\u001b[?2004l\r"]
[750.954484, "o", "\u001b[?2004h> "]
[750.954741, "o", "        s = (lane < nwarp) ? sh_s[lane] : 0.f;\r\n\u001b[?2004l\r"]
[750.954881, "o", "\u001b[?2004h> "]
[750.95509, "o", "        sq = (lane < nwarp) ? sh_q[lane] : 0.f;\r\n\u001b[?2004l\r"]
[750.955112, "o", "\u001b[?2004h"]
[750.955233, "o", "> "]
[750.955443, "o", "        for (int off = 16; off > 0; off >>= 1) {\r\n\u001b[?2004l\r"]
[750.955547, "o", "\u001b[?2004h> "]
[750.955882, "o", "            s += __shfl_down_sync(FULL_MASK, s, off);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.956202, "o", "            sq += __shfl_down_sync(FULL_MASK, sq, off);\r\n\u001b[?2004l\r"]
[750.956291, "o", "\u001b[?2004h> "]
[750.956344, "o", "        }\r\n\u001b[?2004l\r"]
[750.956466, "o", "\u001b[?2004h> "]
[750.956613, "o", "        if (lane == 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.956922, "o", "            ps[row * chunks + chunk] = s;\r\n\u001b[?2004l\r\u001b[?2004h> "]
