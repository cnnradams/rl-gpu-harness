[130.37693, "o", "\u001b[?2004h"]
[130.376947, "o", "> "]
[130.3774, "o", "        w = tl.load(w_ptr + f * D1 * D2 + d1 * D2 + d2, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[130.377425, "o", "\u001b[?2004h"]
[130.377557, "o", "> "]
[130.377934, "o", "        b = tl.load(b_ptr + f * D1 * D2 + d1 * D2 + d2, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[130.377965, "o", "\u001b[?2004h"]
[130.378016, "o", "> "]
