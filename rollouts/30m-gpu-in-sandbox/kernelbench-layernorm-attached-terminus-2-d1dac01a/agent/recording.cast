[750.967758, "o", "\u001b[?2004h> "]
[750.968036, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r"]
[750.968076, "o", "\u001b[?2004h"]
[750.968137, "o", "> "]
[750.968394, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[750.968478, "o", "\u001b[?2004h> "]
[750.968737, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r"]
[750.968783, "o", "\u001b[?2004h> "]
[750.969084, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[750.969144, "o", "\u001b[?2004h"]
[750.9692, "o", "> "]
