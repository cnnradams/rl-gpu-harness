[130.375588, "o", "        v = tl.load(x_ptr + row * N + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[130.37564, "o", "\u001b[?2004h"]
[130.375664, "o", "> "]
[130.375937, "o", "        # index within row: idx -> (f, d1, d2)\r\n\u001b[?2004l\r"]
[130.375959, "o", "\u001b[?2004h"]
[130.376086, "o", "> "]
[130.376202, "o", "        f = idx // (D1 * D2)\r\n\u001b[?2004l\r"]
[130.376216, "o", "\u001b[?2004h"]
[130.37627, "o", "> "]
[130.376507, "o", "        rem = idx % (D1 * D2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.376663, "o", "        d1 = rem // D2\r\n\u001b[?2004l\r"]
