[592.403931, "o", "> "]
[592.404481, "o", "__global__ void read_kernel(const float4* __restrict__ x4, float* __restrict__ out, long n4tot) {\r\n\u001b[?2004l\r"]
[592.404532, "o", "\u001b[?2004h"]
[592.404584, "o", "> "]
[592.405765, "o", "    long i = (long)blockIdx.x * blockDim.x + threadIdx.x;\r\n\u001b[?2004l\r\u001b[?2004h>     long stride = (long)gridDim.x * blockDim.x;\r\n\u001b[?2004l\r\u001b[?2004h>     float s = 0.f;\r\n\u001b[?2004l\r\u001b[?2004h>     for (; i < n4tot; i += stride) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.40673, "o", "        float4 v = x4[i];\r\n\u001b[?2004l\r\u001b[?2004h>         s += v.x + v.y + v.z + v.w;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (s == 12345.678f) out[0] = s;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[592.406808, "o", "\u001b[?2004h> "]
