[962.597762, "i", "cat > /workspace/sanity.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\nm = ModelNew((64, 256, 256)).cuda()\nx = torch.rand(16, 64, 256, 256, device='cuda')\nref = torch.nn.functional.layer_norm(x, (64,256,256), m.weight, m.bias, 1e-5)\nout = m(x)\nprint('cuda basic ok:', torch.allclose(ref, out, atol=1e-4, rtol=1e-4))\n\n# non-contiguous input\nxt = torch.rand(16, 64, 256, 512, device='cuda')[..., ::2]\nreft = torch.nn.functional.layer_norm(xt, (64,256,256), m.weight, m.bias, 1e-5)\noutt = m(xt)\nprint('non-contig ok:', torch.allclose(reft, outt, atol=1e-4, rtol=1e-4))\n\n# CPU fallback\nmc = ModelNew((64, 256, 256))\nxc = torch.rand(2, 64, 256, 256)\nprint('cpu ok:', torch.allclose(torch.nn.functional.layer_norm(xc, (64,256,256), mc.weight, mc.bias, 1e-5), mc(xc), atol=1e-4, rtol=1e-4))\n\n# different batch size\nm2 = ModelNew((64, 256, 256)).cuda()\nx2 = torch.rand(4, 64, 256, 256, device='cuda')\nprint('batch4 ok:', torch.allclose(torch.nn.functional.layer_norm(x2, (64,256,256), "]
[962.597959, "i", "m2.weight, m2.bias, 1e-5), m2(x2), atol=1e-4, rtol=1e-4))\n\n# back-to-back calls return consistent latest output\na = m(x)\nb = m(x)\nprint('repeat deterministic:', torch.equal(a, b))\nEOF\npython3 /workspace/sanity.py\n"]
