[674.624589, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ps_kernel(x_ptr, ps_ptr, psq_ptr, Nn, S, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    chunk_size = tl.cdiv(Nn, S)\n    start = chunk * chunk_size\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    end = tl.minimum(start + chunk_size, Nn)\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < end\n        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\n        acc += v\n        acc2 += v * v\n    tl.store(ps_ptr + row * S + chunk, tl.sum(acc))\n    tl.store(psq_ptr + row * S + chunk, tl.sum(acc2))\n\n\n@triton.jit\ndef _nm_kernel(x_ptr, y_ptr, w_ptr, b_ptr, ps_ptr, psq_ptr, Nn, S, eps,\n               BLOCK: tl.constexpr, NS: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    chunk_size = tl.cdiv(Nn, S)\n    start = "]
[674.624761, "i", "chunk * chunk_size\n    sidx = tl.arange(0, NS)\n    smask = sidx < S\n    ps = tl.load(ps_ptr + row * S + sidx, mask=smask, other=0.0)\n    psq = tl.load(psq_ptr + row * S + sidx, mask=smask, other=0.0)\n    total = tl.sum(ps)\n    totalsq = tl.sum(psq)\n    mean = total / Nn\n    var = totalsq / Nn - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    end = tl.minimum(start + chunk_size, Nn)\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < end\n        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\n        w = tl.load(w_ptr + idx, mask=mask, other=0.0)\n        b = tl.load(b_ptr + idx, mask=mask, other=0.0)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + row * Nn + idx, y, mask=mask)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias "]
[674.624932, "i", "= nn.Parameter(torch.zeros(self.normalized_shape))\n        self.eps = 1e-5\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not (x.is_cuda and x.dtype == torch.float32):\n            return torch.nn.functional.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\n        xs = x.shape\n        nn_dim = len(self.normalized_shape)\n        if len(xs) == nn_dim:\n            lead = 1\n        else:\n            lead = 1\n            for d in xs[:-nn_dim]:\n                lead *= d\n        N = 1\n        for d in self.normalized_shape:\n            N *= d\n        xc = x.contiguous()\n        x2 = xc.view(lead, N)\n        S = 256 if N >= 65536 else max(1, min(256, triton.cdiv(N, 1024)))\n        BA, BB = 4096, 2048\n        NS = triton.next_power_of_2(S)\n        w = self.weight.contiguous().view(-1)\n        b = self.bias.contiguous().view(-1)\n        ps = torch.empty((lead, S), device=x.device, dtype=torch.float32)\n        psq = torch.empty((lead, S), device=x.device, dtype=torch.float32)\n  "]
[674.624967, "i", "      y = torch.empty_like(xc)\n        _ps_kernel[(lead, S)](x2, ps, psq, N, S, BLOCK=BA, num_warps=4)\n        _nm_kernel[(lead, S)](x2, y.view(lead, N), w, b, ps, psq, N, S, self.eps,\n                              BLOCK=BB, NS=NS, num_warps=4)\n        return y.view(xs)\nEOF\npython3 /opt/task/evaluate.py /workspace/solution.py\n"]
[674.625118, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.625155, "o", "> "]
[674.625346, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.625546, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.625683, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.625711, "o", "> "]
[674.625907, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[674.625931, "o", "\u001b[?2004h"]
[674.626045, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[674.626116, "o", "\u001b[?2004h> "]
[674.626208, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[674.626249, "o", "\u001b[?2004h> "]
[674.626737, "o", "def _ps_kernel(x_ptr, ps_ptr, psq_ptr, Nn, S, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.626905, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[674.626932, "o", "\u001b[?2004h"]
[674.627027, "o", "> "]
[674.627154, "o", "    chunk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[674.627215, "o", "\u001b[?2004h> "]
[674.627435, "o", "    chunk_size = tl.cdiv(Nn, S)\r\n\u001b[?2004l\r"]
[674.627459, "o", "\u001b[?2004h"]
[674.627552, "o", "> "]
[674.627702, "o", "    start = chunk * chunk_size\r\n\u001b[?2004l\r"]
[674.627751, "o", "\u001b[?2004h> "]
[674.628111, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.6284, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[674.6285, "o", "\u001b[?2004h> "]
[674.628738, "o", "    end = tl.minimum(start + chunk_size, Nn)\r\n\u001b[?2004l\r"]
[674.628778, "o", "\u001b[?2004h"]
[674.628833, "o", "> "]
[674.629111, "o", "    for off in range(0, chunk_size, BLOCK):\r\n\u001b[?2004l\r"]
[674.629134, "o", "\u001b[?2004h"]
[674.629229, "o", "> "]
[674.629512, "o", "        idx = start + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[674.629538, "o", "\u001b[?2004h"]
[674.629629, "o", "> "]
[674.629744, "o", "        mask = idx < end\r\n\u001b[?2004l\r"]
[674.629827, "o", "\u001b[?2004h> "]
[674.630308, "o", "        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.630467, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.630512, "o", "> "]
[674.630658, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[674.630767, "o", "\u001b[?2004h> "]
[674.631094, "o", "    tl.store(ps_ptr + row * S + chunk, tl.sum(acc))\r\n\u001b[?2004l\r"]
[674.63116, "o", "\u001b[?2004h> "]
[674.631589, "o", "    tl.store(psq_ptr + row * S + chunk, tl.sum(acc2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[674.631675, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[674.631798, "o", "\u001b[?2004h> "]
[674.631897, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.631934, "o", "> "]
[674.632455, "o", "def _nm_kernel(x_ptr, y_ptr, w_ptr, b_ptr, ps_ptr, psq_ptr, Nn, S, eps,\r\n\u001b[?2004l\r"]
[674.632564, "o", "\u001b[?2004h> "]
[674.63291, "o", "               BLOCK: tl.constexpr, NS: tl.constexpr):\r\n\u001b[?2004l\r"]
[674.632935, "o", "\u001b[?2004h"]
[674.633029, "o", "> "]
[674.633194, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[674.633293, "o", "\u001b[?2004h> "]
[674.633456, "o", "    chunk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[674.633522, "o", "\u001b[?2004h> "]
[674.633755, "o", "    chunk_size = tl.cdiv(Nn, S)\r\n\u001b[?2004l\r"]
[674.633854, "o", "\u001b[?2004h> "]
[674.634041, "o", "    start = chunk * chunk_size\r\n\u001b[?2004l\r"]
[674.634094, "o", "\u001b[?2004h"]
[674.634116, "o", "> "]
[674.634312, "o", "    sidx = tl.arange(0, NS)\r\n\u001b[?2004l\r"]
[674.634371, "o", "\u001b[?2004h"]
[674.634429, "o", "> "]
[674.634606, "o", "    smask = sidx < S\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.635045, "o", "    ps = tl.load(ps_ptr + row * S + sidx, mask=smask, other=0.0)\r\n\u001b[?2004l\r"]
[674.635072, "o", "\u001b[?2004h"]
[674.635238, "o", "> "]
[674.635647, "o", "    psq = tl.load(psq_ptr + row * S + sidx, mask=smask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.635818, "o", "    total = tl.sum(ps)\r\n\u001b[?2004l\r"]
[674.635844, "o", "\u001b[?2004h"]
[674.635856, "o", "> "]
[674.636051, "o", "    totalsq = tl.sum(psq)\r\n\u001b[?2004l\r"]
[674.636077, "o", "\u001b[?2004h"]
[674.636168, "o", "> "]
[674.636275, "o", "    mean = total / Nn\r\n\u001b[?2004l\r"]
[674.636408, "o", "\u001b[?2004h> "]
[674.636669, "o", "    var = totalsq / Nn - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.636982, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.637297, "o", "    end = tl.minimum(start + chunk_size, Nn)\r\n\u001b[?2004l\r"]
[674.637374, "o", "\u001b[?2004h> "]
[674.637724, "o", "    for off in range(0, chunk_size, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.638097, "o", "        idx = start + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.638263, "o", "        mask = idx < end\r\n\u001b[?2004l\r"]
[674.638398, "o", "\u001b[?2004h> "]
[674.638793, "o", "        v = tl.load(x_ptr + row * Nn + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[674.63886, "o", "\u001b[?2004h"]
[674.638884, "o", "> "]
[674.639244, "o", "        w = tl.load(w_ptr + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[674.639332, "o", "\u001b[?2004h> "]
[674.63972, "o", "        b = tl.load(b_ptr + idx, mask=mask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.639744, "o", "> "]
[674.63998, "o", "        y = (v - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[674.640124, "o", "\u001b[?2004h> "]
[674.640395, "o", "        tl.store(y_ptr + row * Nn + idx, y, mask=mask)\r\n\u001b[?2004l\r"]
[674.64049, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[674.640547, "o", "> \r\n\u001b[?2004l\r"]
[674.640608, "o", "\u001b[?2004h> "]
[674.640781, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[674.640849, "o", "\u001b[?2004h> "]
[674.641142, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[674.641223, "o", "\u001b[?2004h> "]
[674.641391, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[674.641416, "o", "\u001b[?2004h"]
[674.641499, "o", "> "]
[674.641861, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.642301, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r"]
[674.642416, "o", "\u001b[?2004h> "]
[674.64285, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.643056, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[674.643166, "o", "\u001b[?2004h> "]
[674.64354, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.643889, "o", "        if not (x.is_cuda and x.dtype == torch.float32):\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.643954, "o", "> "]
[674.644564, "o", "            return torch.nn.functional.layer_norm(x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r"]
[674.644647, "o", "\u001b[?2004h> "]
[674.644751, "o", "        xs = x.shape\r\n\u001b[?2004l\r"]
[674.644835, "o", "\u001b[?2004h"]
[674.644856, "o", "> "]
[674.645074, "o", "        nn_dim = len(self.normalized_shape)\r\n\u001b[?2004l\r"]
[674.645103, "o", "\u001b[?2004h"]
[674.645123, "o", "> "]
[674.645404, "o", "        if len(xs) == nn_dim:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.645564, "o", "            lead = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[674.645589, "o", "> "]
[674.645682, "o", "        else:\r\n\u001b[?2004l\r"]
[674.64574, "o", "\u001b[?2004h> "]
[674.645865, "o", "            lead = 1\r\n\u001b[?2004l\r"]
[674.645919, "o", "\u001b[?2004h"]
[674.645944, "o", "> "]
[674.646202, "o", "            for d in xs[:-nn_dim]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.646358, "o", "                lead *= d\r\n\u001b[?2004l\r"]
[674.646405, "o", "\u001b[?2004h"]
[674.646426, "o", "> "]
[674.646514, "o", "        N = 1\r\n\u001b[?2004l\r"]
[674.646611, "o", "\u001b[?2004h> "]
[674.646814, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[674.646906, "o", "\u001b[?2004h> "]
[674.646997, "o", "            N *= d\r\n\u001b[?2004l\r"]
[674.647085, "o", "\u001b[?2004h> "]
[674.647232, "o", "        xc = x.contiguous()\r\n\u001b[?2004l\r"]
[674.647256, "o", "\u001b[?2004h"]
[674.647335, "o", "> "]
[674.647477, "o", "        x2 = xc.view(lead, N)\r\n\u001b[?2004l\r"]
[674.647645, "o", "\u001b[?2004h> "]
[674.64803, "o", "        S = 256 if N >= 65536 else max(1, min(256, triton.cdiv(N, 1024)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.648245, "o", "        BA, BB = 4096, 2048\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.64853, "o", "        NS = triton.next_power_of_2(S)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.648864, "o", "        w = self.weight.contiguous().view(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.649211, "o", "        b = self.bias.contiguous().view(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.649668, "o", "        ps = torch.empty((lead, S), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[674.64969, "o", "\u001b[?2004h"]
[674.649843, "o", "> "]
[674.650193, "o", "        psq = torch.empty((lead, S), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[674.650256, "o", "\u001b[?2004h> "]
[674.650474, "o", "        y = torch.empty_like(xc)\r\n\u001b[?2004l\r"]
[674.650504, "o", "\u001b[?2004h"]
[674.650593, "o", "> "]
[674.651017, "o", "        _ps_kernel[(lead, S)](x2, ps, psq, N, S, BLOCK=BA, num_warps=4)\r\n\u001b[?2004l\r"]
[674.651118, "o", "\u001b[?2004h> "]
[674.651681, "o", "        _nm_kernel[(lead, S)](x2, y.view(lead, N), w, b, ps, psq, N, S, self.eps,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[674.652056, "o", "                              BLOCK=BB, NS=NS, num_warps=4)\r\n\u001b[?2004l\r"]
[674.65208, "o", "\u001b[?2004h"]
[674.652211, "o", "> "]
[674.652303, "o", "        return y.view(xs)\r\n\u001b[?2004l\r"]
[674.652364, "o", "\u001b[?2004h> "]
[674.652392, "o", "EOF\r\n\u001b[?2004l\r"]
[674.655501, "o", "\u001b[?2004h"]
