[750.959979, "o", "\u001b[?2004h"]
[750.960053, "o", "> "]
[750.96038, "o", "                            int n4, int chunks, float eps) {\r\n\u001b[?2004l\r"]
[750.960467, "o", "\u001b[?2004h> "]
[750.960601, "o", "    int row = blockIdx.y;\r\n\u001b[?2004l\r"]
[750.960741, "o", "\u001b[?2004h> "]
[750.960915, "o", "    int chunk = (int)blockIdx.x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.961197, "o", "    int chunk_size = (n4 + chunks - 1) / chunks;\r\n\u001b[?2004l\r"]
[750.961263, "o", "\u001b[?2004h> "]
