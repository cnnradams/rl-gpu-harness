[130.359982, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\nB, M_feat, D1, D2 = 16, 64, 256, 256\nNORM = (M_feat, D1, D2)\nM = B  # rows\nN = M_feat * D1 * D2  # 4_194_304 per row\n\n@triton.jit\ndef _partial_sums_kernel(x_ptr, ps_ptr, psq_ptr, N, S, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    # chunk size = ceil(N / S); passed via grid computation\n    chunk_size = tl.cdiv(N, S)\n    start = chunk * chunk_size\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    base = row * N + start\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < tl.minimum(start + chunk_size, N)\n        v = tl.load(x_ptr + row * N + idx, mask=mask, other=0.0)\n        acc += v\n        acc2 += v * v\n    tl.store(ps_ptr + row * S + chunk, tl.sum(acc))\n    tl.store(psq_ptr + row * S + chunk, tl.sum(acc2))\n\n@triton.jit\ndef"]
[130.360065, "i", " _normalize_kernel(x_ptr, y_ptr, w_ptr, b_ptr, ps_ptr, psq_ptr,\n                      N, S, eps, BLOCK: tl.constexpr, NS: tl.constexpr):\n    row = tl.program_id(0)\n    chunk = tl.program_id(1)\n    chunk_size = tl.cdiv(N, S)\n    start = chunk * chunk_size\n    # reduce partials\n    sidx = tl.arange(0, NS)\n    smask = sidx < S\n    ps = tl.load(ps_ptr + row * S + sidx, mask=smask, other=0.0)\n    psq = tl.load(psq_ptr + row * S + sidx, mask=smask, other=0.0)\n    total = tl.sum(ps)\n    totalsq = tl.sum(psq)\n    mean = total / N\n    var = totalsq / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    D1: tl.constexpr = 256\n    D2: tl.constexpr = 256\n    for off in range(0, chunk_size, BLOCK):\n        idx = start + off + tl.arange(0, BLOCK)\n        mask = idx < tl.minimum(start + chunk_size, N)\n        v = tl.load(x_ptr + row * N + idx, mask=mask, other=0.0)\n        # index within row: idx -> (f, d1, d2)\n        f = idx // (D1 * D2)\n        rem = idx % (D1 * D2)\n        d1 = rem // D2\n        d2 = rem % D2\n       "]
[130.360217, "i", " w = tl.load(w_ptr + f * D1 * D2 + d1 * D2 + d2, mask=mask, other=0.0)\n        b = tl.load(b_ptr + f * D1 * D2 + d1 * D2 + d2, mask=mask, other=0.0)\n        y = (v - mean) * rstd * w + b\n        tl.store(y_ptr + row * N + idx, y, mask=mask)\n\ndef triton_ln(x, w, b, eps=1e-5):\n    Mrows = x.shape[0]\n    Nn = x[0].numel()\n    S = 128\n    BLOCK = 4096\n    NS = triton.next_power_of_2(S)\n    ps = torch.empty((Mrows, S), device=x.device, dtype=torch.float32)\n    psq = torch.empty((Mrows, S), device=x.device, dtype=torch.float32)\n    y = torch.empty_like(x)\n    _partial_sums_kernel[(Mrows, S)](x, ps, psq, Nn, S, BLOCK=BLOCK)\n    _normalize_kernel[(Mrows, S)](x, y, w, b, ps, psq, Nn, S, eps, BLOCK=BLOCK, NS=NS)\n    return y\n\ndef main():\n    torch.manual_seed(0)\n    dev = 'cuda'\n    x = torch.rand(B, M_feat, D1, D2, device=dev)\n    ln = nn.LayerNorm(NORM).to(dev)\n    w = ln.ln.weight if hasattr(ln, 'ln') else ln.weight\n    b = ln.bias\n    eps = ln.eps\n    ref = ln(x)\n    out = triton_ln(x, w, b, eps)\n    diff = (ref - "]
[130.360285, "i", "out).abs().max().item()\n    print('max diff triton vs native:', diff)\n    assert torch.allclose(ref, out, atol=1e-4, rtol=1e-4), 'MISMATCH'\n\n    ms_native = triton.testing.do_bench(lambda: ln(x), warmup=25, rep=100)\n    ms_f = triton.testing.do_bench(lambda: F.layer_norm(x, NORM, w, b, eps), warmup=25, rep=100)\n    ms_triton = triton.testing.do_bench(lambda: triton_ln(x, w, b, eps), warmup=25, rep=100)\n    print(f'native nn.LayerNorm: {ms_native:.4f} ms')\n    print(f'F.layer_norm:        {ms_f:.4f} ms')\n    print(f'triton split:        {ms_triton:.4f} ms')\n\nif __name__ == '__main__':\n    main()\nEOF\npython3 /workspace/bench.py\n"]
