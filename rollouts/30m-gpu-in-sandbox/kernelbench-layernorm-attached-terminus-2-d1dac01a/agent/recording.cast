[592.364798, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[592.364884, "o", "> "]
[592.364935, "o", "cuda_src = r'''\r\n\u001b[?2004l\r"]
[592.36496, "o", "\u001b[?2004h"]
[592.365091, "o", "> "]
[592.365192, "o", "#include <torch/extension.h>\r\n\u001b[?2004l\r"]
[592.365217, "o", "\u001b[?2004h"]
[592.36527, "o", "> "]
[592.365414, "o", "#include <cuda_runtime.h>\r\n\u001b[?2004l\r"]
[592.365501, "o", "\u001b[?2004h> "]
[592.3657, "o", "#include <ATen/cuda/CUDAContext.h>\r\n\u001b[?2004l\r"]
[592.365727, "o", "\u001b[?2004h"]
[592.36583, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[592.365853, "o", "> "]
[592.366016, "o", "#define FULL_MASK 0xffffffffu\r\n\u001b[?2004l\r"]
[592.366095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[592.366133, "o", "\u001b[?2004h"]
[592.3662, "o", "> "]
[592.366436, "o", "// Kernel A: partial sums per (row, chunk)\r\n\u001b[?2004l\r"]
[592.366524, "o", "\u001b[?2004h> "]
[592.366913, "o", "__global__ void partial_kernel(const float4* __restrict__ x4,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.367259, "o", "                               float* __restrict__ ps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.3673, "o", "> "]
[592.367697, "o", "                               float* __restrict__ psq,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.368084, "o", "                               int n4, int chunks) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.368251, "o", "    int row = blockIdx.y;\r\n\u001b[?2004l\r"]
[592.368325, "o", "\u001b[?2004h"]
[592.368378, "o", "> "]
[592.368508, "o", "    int chunk = blockIdx.x;\r\n\u001b[?2004l\r"]
[592.368636, "o", "\u001b[?2004h> "]
[592.368892, "o", "    int chunk_size = (n4 + chunks - 1) / chunks;\r\n\u001b[?2004l\r"]
[592.368952, "o", "\u001b[?2004h> "]
[592.369189, "o", "    int start = chunk * chunk_size;\r\n\u001b[?2004l\r"]
[592.369273, "o", "\u001b[?2004h> "]
[592.36953, "o", "    int end = min(start + chunk_size, n4);\r\n\u001b[?2004l\r"]
[592.369617, "o", "\u001b[?2004h> "]
[592.369914, "o", "    const float4* xr = x4 + (long)row * (long)n4;\r\n\u001b[?2004l\r"]
[592.369961, "o", "\u001b[?2004h"]
[592.369982, "o", "> "]
[592.370172, "o", "    float s = 0.f, sq = 0.f;\r\n\u001b[?2004l\r"]
[592.370197, "o", "\u001b[?2004h"]
[592.370277, "o", "> "]
[592.37072, "o", "    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.370888, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r"]
[592.370978, "o", "\u001b[?2004h> "]
[592.371184, "o", "        s += v.x + v.y + v.z + v.w;\r\n\u001b[?2004l\r"]
[592.371241, "o", "\u001b[?2004h> "]
[592.37164, "o", "        sq += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.371723, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.371799, "o", "> "]
[592.371955, "o", "    __shared__ float sh_s[32];\r\n\u001b[?2004l\r"]
[592.371994, "o", "\u001b[?2004h"]
[592.372062, "o", "> "]
[592.372293, "o", "    __shared__ float sh_q[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.372631, "o", "    for (int off = 16; off > 0; off >>= 1) {\r\n\u001b[?2004l\r"]
[592.372685, "o", "\u001b[?2004h"]
[592.372709, "o", "> "]
[592.373034, "o", "        s += __shfl_down_sync(FULL_MASK, s, off);\r\n\u001b[?2004l\r"]
[592.373059, "o", "\u001b[?2004h"]
[592.373162, "o", "> "]
[592.373434, "o", "        sq += __shfl_down_sync(FULL_MASK, sq, off);\r\n\u001b[?2004l\r"]
[592.373537, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[592.373601, "o", "\u001b[?2004h> "]
[592.373894, "o", "    int lane = threadIdx.x & 31;\r\n\u001b[?2004l\r"]
[592.373982, "o", "\u001b[?2004h> "]
[592.374188, "o", "    int warp = threadIdx.x >> 5;\r\n\u001b[?2004l\r"]
[592.374329, "o", "\u001b[?2004h> "]
[592.374622, "o", "    if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\r\n\u001b[?2004l\r"]
[592.374746, "o", "\u001b[?2004h> "]
[592.374835, "o", "    __syncthreads();\r\n\u001b[?2004l\r"]
[592.374855, "o", "\u001b[?2004h"]
[592.374922, "o", "> "]
[592.375148, "o", "    int nwarp = (blockDim.x + 31) >> 5;\r\n\u001b[?2004l\r"]
[592.375218, "o", "\u001b[?2004h> "]
[592.375367, "o", "    if (warp == 0) {\r\n\u001b[?2004l\r"]
[592.375448, "o", "\u001b[?2004h> "]
[592.375732, "o", "        s = (lane < nwarp) ? sh_s[lane] : 0.f;\r\n\u001b[?2004l\r"]
[592.375875, "o", "\u001b[?2004h> "]
[592.376099, "o", "        sq = (lane < nwarp) ? sh_q[lane] : 0.f;\r\n\u001b[?2004l\r"]
[592.376212, "o", "\u001b[?2004h> "]
[592.37648, "o", "        for (int off = 16; off > 0; off >>= 1) {\r\n\u001b[?2004l\r"]
[592.376583, "o", "\u001b[?2004h> "]
[592.376892, "o", "            s += __shfl_down_sync(FULL_MASK, s, off);\r\n\u001b[?2004l\r"]
[592.376918, "o", "\u001b[?2004h"]
[592.377004, "o", "> "]
[592.377307, "o", "            sq += __shfl_down_sync(FULL_MASK, sq, off);\r\n\u001b[?2004l\r"]
[592.377367, "o", "\u001b[?2004h> "]
[592.377447, "o", "        }\r\n\u001b[?2004l\r"]
[592.377538, "o", "\u001b[?2004h> "]
[592.377675, "o", "        if (lane == 0) {\r\n\u001b[?2004l\r"]
[592.377763, "o", "\u001b[?2004h> "]
[592.378011, "o", "            ps[row * chunks + chunk] = s;\r\n\u001b[?2004l\r"]
[592.378034, "o", "\u001b[?2004h"]
[592.378139, "o", "> "]
[592.378359, "o", "            psq[row * chunks + chunk] = sq;\r\n\u001b[?2004l\r"]
[592.378504, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[592.378524, "o", "\u001b[?2004h"]
[592.378574, "o", "> "]
[592.378593, "o", "    }\r\n\u001b[?2004l\r"]
[592.378668, "o", "\u001b[?2004h"]
[592.378723, "o", "> }\r\n\u001b[?2004l\r"]
[592.378747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[592.378798, "o", "\u001b[?2004h"]
[592.378849, "o", "> "]
[592.379359, "o", "// Kernel B: finalize + normalize. reverse=1 remaps chunks to hit L2-warm tail first.\r\n\u001b[?2004l\r"]
[592.379451, "o", "\u001b[?2004h> "]
[592.379633, "o", "template<int REVERSE>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.380006, "o", "__global__ void norm_kernel(const float4* __restrict__ x4,\r\n\u001b[?2004l\r"]
[592.380029, "o", "\u001b[?2004h"]
[592.380122, "o", "> "]
[592.380437, "o", "                            const float4* __restrict__ w4,\r\n\u001b[?2004l\r"]
[592.38053, "o", "\u001b[?2004h> "]
[592.380925, "o", "                            const float4* __restrict__ b4,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.381251, "o", "                            float4* __restrict__ y4,\r\n\u001b[?2004l\r"]
[592.381396, "o", "\u001b[?2004h> "]
[592.381679, "o", "                            const float* __restrict__ ps,\r\n\u001b[?2004l\r"]
[592.381769, "o", "\u001b[?2004h> "]
[592.38212, "o", "                            const float* __restrict__ psq,\r\n\u001b[?2004l\r"]
[592.382143, "o", "\u001b[?2004h"]
[592.382277, "o", "> "]
[592.382553, "o", "                            float* __restrict__ mean_out,\r\n\u001b[?2004l\r"]
[592.382613, "o", "\u001b[?2004h> "]
[592.382966, "o", "                            float* __restrict__ rstd_out,\r\n\u001b[?2004l\r"]
[592.382987, "o", "\u001b[?2004h"]
[592.383062, "o", "> "]
[592.383406, "o", "                            int n4, int chunks, float eps) {\r\n\u001b[?2004l\r"]
[592.38343, "o", "\u001b[?2004h"]
[592.383532, "o", "> "]
[592.383636, "o", "    int row = blockIdx.y;\r\n\u001b[?2004l\r"]
[592.383718, "o", "\u001b[?2004h> "]
[592.384189, "o", "    int chunk = REVERSE ? (gridDim.x - 1 - (int)blockIdx.x) : (int)blockIdx.x;\r\n\u001b[?2004l\r"]
[592.384212, "o", "\u001b[?2004h"]
[592.384294, "o", "> "]
[592.384571, "o", "    int chunk_size = (n4 + chunks - 1) / chunks;\r\n\u001b[?2004l\r"]
[592.38464, "o", "\u001b[?2004h> "]
[592.384867, "o", "    int start = chunk * chunk_size;\r\n\u001b[?2004l\r"]
[592.38492, "o", "\u001b[?2004h"]
[592.384972, "o", "> "]
[592.385227, "o", "    int end = min(start + chunk_size, n4);\r\n\u001b[?2004l\r"]
[592.385314, "o", "\u001b[?2004h"]
[592.385384, "o", "> "]
[592.385584, "o", "    __shared__ float s_mean, s_rstd;\r\n\u001b[?2004l\r"]
[592.385607, "o", "\u001b[?2004h"]
[592.385688, "o", "> "]
[592.385826, "o", "    if (threadIdx.x == 0) {\r\n\u001b[?2004l\r"]
[592.385919, "o", "\u001b[?2004h> "]
[592.386153, "o", "        float total = 0.f, totalsq = 0.f;\r\n\u001b[?2004l\r"]
[592.386195, "o", "\u001b[?2004h"]
[592.386254, "o", "> "]
[592.386567, "o", "        for (int c = 0; c < chunks; ++c) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.386886, "o", "            total += ps[row * chunks + c];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.387185, "o", "            totalsq += psq[row * chunks + c];\r\n\u001b[?2004l\r"]
[592.387251, "o", "\u001b[?2004h> "]
[592.387337, "o", "        }\r\n\u001b[?2004l\r"]
[592.387394, "o", "\u001b[?2004h> "]
[592.387683, "o", "        float n = (float)n4 * 4.0f;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.387882, "o", "        float mean = total / n;\r\n\u001b[?2004l\r"]
[592.387903, "o", "\u001b[?2004h"]
[592.388001, "o", "> "]
[592.388287, "o", "        float var = totalsq / n - mean * mean;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.388429, "o", "        s_mean = mean;\r\n\u001b[?2004l\r"]
[592.388483, "o", "\u001b[?2004h"]
[592.38854, "o", "> "]
[592.388713, "o", "        s_rstd = rsqrtf(var + eps);\r\n\u001b[?2004l\r"]
[592.388757, "o", "\u001b[?2004h"]
[592.38881, "o", ">     }\r\n"]
[592.388828, "o", "\u001b[?2004l\r"]
[592.388881, "o", "\u001b[?2004h> "]
[592.389049, "o", "    __syncthreads();\r\n\u001b[?2004l\r"]
[592.389108, "o", "\u001b[?2004h> "]
[592.389282, "o", "    float mean = s_mean;\r\n\u001b[?2004l\r"]
[592.389407, "o", "\u001b[?2004h> "]
[592.389533, "o", "    float rstd = s_rstd;\r\n\u001b[?2004l\r"]
[592.389552, "o", "\u001b[?2004h"]
[592.389608, "o", "> "]
[592.389959, "o", "    const float4* xr = x4 + (long)row * (long)n4;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.390288, "o", "    float4* yr = y4 + (long)row * (long)n4;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.390767, "o", "    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.390997, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.391161, "o", "        float4 wv = w4[i];\r\n\u001b[?2004l\r"]
[592.391213, "o", "\u001b[?2004h"]
[592.391264, "o", "> "]
[592.391469, "o", "        float4 bv = b4[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.391587, "o", "        float4 o;\r\n\u001b[?2004l\r"]
[592.391636, "o", "\u001b[?2004h"]
[592.391656, "o", "> "]
[592.392022, "o", "        o.x = (v.x - mean) * rstd * wv.x + bv.x;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.392324, "o", "        o.y = (v.y - mean) * rstd * wv.y + bv.y;\r\n\u001b[?2004l\r"]
[592.392374, "o", "\u001b[?2004h"]
[592.392394, "o", "> "]
[592.392746, "o", "        o.z = (v.z - mean) * rstd * wv.z + bv.z;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.393049, "o", "        o.w = (v.w - mean) * rstd * wv.w + bv.w;\r\n\u001b[?2004l\r"]
[592.393072, "o", "\u001b[?2004h"]
[592.393163, "o", "> "]
[592.393254, "o", "        yr[i] = o;\r\n\u001b[?2004l\r"]
[592.393277, "o", "\u001b[?2004h"]
[592.3934, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.393485, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[592.393528, "o", "> \r\n\u001b[?2004l\r"]
[592.393576, "o", "\u001b[?2004h"]
[592.393676, "o", "> "]
[592.394138, "o", "torch::Tensor ln_two(torch::Tensor x, torch::Tensor w, torch::Tensor b,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.394504, "o", "                     torch::Tensor ps, torch::Tensor psq,\r\n\u001b[?2004l\r"]
[592.39461, "o", "\u001b[?2004h> "]
[592.395198, "o", "                     double eps, int64_t chunks, int64_t blockA, int64_t blockB, int64_t rev) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.395492, "o", "    auto y = torch::empty_like(x);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.395708, "o", "    int64_t M = x.size(0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.395909, "o", "    int64_t N = x.numel() / M;\r\n\u001b[?2004l\r"]
[592.395929, "o", "\u001b[?2004h"]
[592.396052, "o", "> "]
[592.396197, "o", "    int n4 = (int)(N / 4);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.396487, "o", "    dim3 grid((unsigned)chunks, (unsigned)M);\r\n\u001b[?2004l\r"]
[592.396572, "o", "\u001b[?2004h> "]
[592.396863, "o", "    auto stream = at::cuda::getCurrentCUDAStream();\r\n\u001b[?2004l\r"]
[592.396963, "o", "\u001b[?2004h> "]
[592.397261, "o", "    partial_kernel<<<grid, (int)blockA, 0, stream>>>(\r\n\u001b[?2004l\r"]
[592.397357, "o", "\u001b[?2004h> "]
[592.397962, "o", "        (const float4*)x.data_ptr<float>(), ps.data_ptr<float>(), psq.data_ptr<float>(), n4, (int)chunks);\r\n\u001b[?2004l\r"]
[592.398047, "o", "\u001b[?2004h> "]
[592.398194, "o", "    if (rev) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.398605, "o", "        norm_kernel<1><<<grid, (int)blockB, 0, stream>>>(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[592.398973, "o", "            (const float4*)x.data_ptr<float>(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
