[592.36307, "i", "cat > /workspace/dev/bench4.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nfrom torch.utils.cpp_extension import load_inline\n\ncuda_src = r'''\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <ATen/cuda/CUDAContext.h>\n\n#define FULL_MASK 0xffffffffu\n\n// Kernel A: partial sums per (row, chunk)\n__global__ void partial_kernel(const float4* __restrict__ x4,\n                               float* __restrict__ ps,\n                               float* __restrict__ psq,\n                               int n4, int chunks) {\n    int row = blockIdx.y;\n    int chunk = blockIdx.x;\n    int chunk_size = (n4 + chunks - 1) / chunks;\n    int start = chunk * chunk_size;\n    int end = min(start + chunk_size, n4);\n    const float4* xr = x4 + (long)row * (long)n4;\n    float s = 0.f, sq = 0.f;\n    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\n        float4 v = xr[i];\n        s += v.x + v.y + v.z + v.w;\n        sq += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n    __shared__ float sh_s[32]"]
[592.363311, "i", ";\n    __shared__ float sh_q[32];\n    for (int off = 16; off > 0; off >>= 1) {\n        s += __shfl_down_sync(FULL_MASK, s, off);\n        sq += __shfl_down_sync(FULL_MASK, sq, off);\n    }\n    int lane = threadIdx.x & 31;\n    int warp = threadIdx.x >> 5;\n    if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\n    __syncthreads();\n    int nwarp = (blockDim.x + 31) >> 5;\n    if (warp == 0) {\n        s = (lane < nwarp) ? sh_s[lane] : 0.f;\n        sq = (lane < nwarp) ? sh_q[lane] : 0.f;\n        for (int off = 16; off > 0; off >>= 1) {\n            s += __shfl_down_sync(FULL_MASK, s, off);\n            sq += __shfl_down_sync(FULL_MASK, sq, off);\n        }\n        if (lane == 0) {\n            ps[row * chunks + chunk] = s;\n            psq[row * chunks + chunk] = sq;\n        }\n    }\n}\n\n// Kernel B: finalize + normalize. reverse=1 remaps chunks to hit L2-warm tail first.\ntemplate<int REVERSE>\n__global__ void norm_kernel(const float4* __restrict__ x4,\n                            const float4* __restrict__ w4,\n              "]
[592.363467, "i", "              const float4* __restrict__ b4,\n                            float4* __restrict__ y4,\n                            const float* __restrict__ ps,\n                            const float* __restrict__ psq,\n                            float* __restrict__ mean_out,\n                            float* __restrict__ rstd_out,\n                            int n4, int chunks, float eps) {\n    int row = blockIdx.y;\n    int chunk = REVERSE ? (gridDim.x - 1 - (int)blockIdx.x) : (int)blockIdx.x;\n    int chunk_size = (n4 + chunks - 1) / chunks;\n    int start = chunk * chunk_size;\n    int end = min(start + chunk_size, n4);\n    __shared__ float s_mean, s_rstd;\n    if (threadIdx.x == 0) {\n        float total = 0.f, totalsq = 0.f;\n        for (int c = 0; c < chunks; ++c) {\n            total += ps[row * chunks + c];\n            totalsq += psq[row * chunks + c];\n        }\n        float n = (float)n4 * 4.0f;\n        float mean = total / n;\n        float var = totalsq / n - mean * mean;\n        s_mean = mean;\n        s_rs"]
[592.3635, "o", "cat > /workspace/dev/bench4.py << 'EOF'\r\n"]
[592.363534, "i", "td = rsqrtf(var + eps);\n    }\n    __syncthreads();\n    float mean = s_mean;\n    float rstd = s_rstd;\n    const float4* xr = x4 + (long)row * (long)n4;\n    float4* yr = y4 + (long)row * (long)n4;\n    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\n        float4 v = xr[i];\n        float4 wv = w4[i];\n        float4 bv = b4[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        yr[i] = o;\n    }\n}\n\ntorch::Tensor ln_two(torch::Tensor x, torch::Tensor w, torch::Tensor b,\n                     torch::Tensor ps, torch::Tensor psq,\n                     double eps, int64_t chunks, int64_t blockA, int64_t blockB, int64_t rev) {\n    auto y = torch::empty_like(x);\n    int64_t M = x.size(0);\n    int64_t N = x.numel() / M;\n    int n4 = (int)(N / 4);\n    dim3 grid((unsigned)chunks, (unsigned)M);\n    auto stream = at::cuda::getCurrentCUDAStream("]
[592.363545, "o", "\u001b[?2004l\r"]
[592.363682, "i", ");\n    partial_kernel<<<grid, (int)blockA, 0, stream>>>(\n        (const float4*)x.data_ptr<float>(), ps.data_ptr<float>(), psq.data_ptr<float>(), n4, (int)chunks);\n    if (rev) {\n        norm_kernel<1><<<grid, (int)blockB, 0, stream>>>(\n            (const float4*)x.data_ptr<float>(),\n            (const float4*)w.data_ptr<float>(),\n            (const float4*)b.data_ptr<float>(),\n            (float4*)y.data_ptr<float>(),\n            ps.data_ptr<float>(), psq.data_ptr<float>(), nullptr, nullptr, n4, (int)chunks, (float)eps);\n    } else {\n        norm_kernel<0><<<grid, (int)blockB, 0, stream>>>(\n            (const float4*)x.data_ptr<float>(),\n            (const float4*)w.data_ptr<float>(),\n            (const float4*)b.data_ptr<float>(),\n            (float4*)y.data_ptr<float>(),\n            ps.data_ptr<float>(), psq.data_ptr<float>(), nullptr, nullptr, n4, (int)chunks, (float)eps);\n    }\n    return y;\n}\n\n__global__ void read_kernel(const float4* __restrict__ x4, float* __restrict__ out, long n4tot) {\n    long i = "]
[592.363716, "o", "\u001b[?2004h> "]
[592.363766, "i", "(long)blockIdx.x * blockDim.x + threadIdx.x;\n    long stride = (long)gridDim.x * blockDim.x;\n    float s = 0.f;\n    for (; i < n4tot; i += stride) {\n        float4 v = x4[i];\n        s += v.x + v.y + v.z + v.w;\n    }\n    if (s == 12345.678f) out[0] = s;\n}\n\ntorch::Tensor read_bw(torch::Tensor x) {\n    auto out = torch::zeros({1}, x.options());\n    long n4tot = x.numel() / 4;\n    auto stream = at::cuda::getCurrentCUDAStream();\n    read_kernel<<<4096, 256, 0, stream>>>((const float4*)x.data_ptr<float>(), out.data_ptr<float>(), n4tot);\n    return out;\n}\n'''\n\ncpp_src = 'torch::Tensor ln_two(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ps, torch::Tensor psq, double eps, int64_t chunks, int64_t blockA, int64_t blockB, int64_t rev);\\ntorch::Tensor read_bw(torch::Tensor x);'\n\nmod = load_inline(name='ln_two_cuda', cpp_sources=cpp_src, cuda_sources=cuda_src,\n                  functions=['ln_two', 'read_bw'], extra_cuda_cflags=['-O3'], verbose=False)\n\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\n\nd"]
[592.363786, "i", "ef main():\n    torch.manual_seed(0)\n    x = torch.rand(B, F, D1, D2, device='cuda')\n    ln = nn.LayerNorm((F, D1, D2)).cuda()\n    w, b, eps = ln.weight, ln.bias, ln.eps\n    ref = ln(x)\n    results = []\n    for chunks in [32, 64, 128]:\n        ps = torch.empty((B, chunks), device='cuda')\n        psq = torch.empty((B, chunks), device='cuda')\n        for bA in [256, 512]:\n            for bB in [256, 512]:\n                for rev in [0, 1]:\n                    fn = lambda: mod.ln_two(x, w, b, ps, psq, eps, chunks, bA, bB, rev)\n                    out = fn()\n                    ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n                    if not ok:\n                        print('FAIL', chunks, bA, bB, rev)\n                        continue\n                    ms = triton.testing.do_bench(fn, warmup=10, rep=50)\n                    results.append((ms, chunks, bA, bB, rev))\n    results.sort()\n    for r in results[:10]:\n        print(f'{r[0]:.4f} ms chunks={r[1]} blockA={r[2]} blockB={r[3]} rev={r[4]}')\n    "]
[592.363798, "i", "ms_read = triton.testing.do_bench(lambda: mod.read_bw(x), warmup=10, rep=50)\n    print(f'pure read 268MB: {ms_read:.4f} ms -> {268.4/ms_read:.0f} GB/s')\n    ms_native = triton.testing.do_bench(lambda: ln(x), warmup=10, rep=50)\n    print(f'native: {ms_native:.4f} ms')\n\nif __name__ == '__main__':\n    main()\nEOF\ncd /workspace/dev && python3 bench4.py\n"]
[592.363808, "o", "import torch\r\n"]
[592.363822, "o", "\u001b[?2004l\r"]
[592.363962, "o", "\u001b[?2004h> "]
