[485.387115, "i", "mkdir -p /workspace/dev && cat > /workspace/dev/bench3.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nfrom torch.utils.cpp_extension import load_inline\n\ncuda_src = r'''\n#include <torch/extension.h>\n#include <cuda_runtime.h>\n#include <ATen/cuda/CUDAContext.h>\n\n#define FULL_MASK 0xffffffffu\n\n__global__ void ln_kernel(const float4* __restrict__ x4,\n                          const float4* __restrict__ w4,\n                          const float4* __restrict__ b4,\n                          float4* __restrict__ y4,\n                          float* __restrict__ g_sum,\n                          float* __restrict__ g_sumsq,\n                          float* __restrict__ g_mean,\n                          float* __restrict__ g_rstd,\n                          unsigned int* __restrict__ counters,\n                          unsigned int* __restrict__ flags,\n                          int n4, int chunks, float eps) {\n    int row = blockIdx.y;\n    int chunk = blockIdx.x;\n    int chunk_size = (n4 + chunks - 1) / chun"]
[485.387387, "i", "ks;\n    int start = chunk * chunk_size;\n    int end = min(start + chunk_size, n4);\n    const float4* xr = x4 + (long)row * (long)n4;\n    float s = 0.f, sq = 0.f;\n    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\n        float4 v = xr[i];\n        s += v.x + v.y + v.z + v.w;\n        sq += v.x*v.x + v.y*v.y + v.z*v.z + v.w*v.w;\n    }\n    __shared__ float sh_s[32];\n    __shared__ float sh_q[32];\n    for (int off = 16; off > 0; off >>= 1) {\n        s += __shfl_down_sync(FULL_MASK, s, off);\n        sq += __shfl_down_sync(FULL_MASK, sq, off);\n    }\n    int lane = threadIdx.x & 31;\n    int warp = threadIdx.x >> 5;\n    if (lane == 0) { sh_s[warp] = s; sh_q[warp] = sq; }\n    __syncthreads();\n    int nwarp = (blockDim.x + 31) >> 5;\n    if (warp == 0) {\n        s = (lane < nwarp) ? sh_s[lane] : 0.f;\n        sq = (lane < nwarp) ? sh_q[lane] : 0.f;\n        for (int off = 16; off > 0; off >>= 1) {\n            s += __shfl_down_sync(FULL_MASK, s, off);\n            sq += __shfl_down_sync(FULL_MASK, sq, off);\n  "]
[485.387443, "i", "      }\n        if (lane == 0) {\n            atomicAdd(&g_sum[row], s);\n            atomicAdd(&g_sumsq[row], sq);\n            __threadfence();\n            unsigned int done = atomicAdd(&counters[row], 1u);\n            if (done == (unsigned int)(chunks - 1)) {\n                float n = (float)n4 * 4.0f;\n                float mean = g_sum[row] / n;\n                float var = g_sumsq[row] / n - mean * mean;\n                float rstd = rsqrtf(var + eps);\n                g_mean[row] = mean;\n                g_rstd[row] = rstd;\n                __threadfence();\n                atomicExch(&flags[row], 1u);\n            }\n        }\n    }\n    __shared__ float s_mean, s_rstd;\n    if (threadIdx.x == 0) {\n        volatile unsigned int* vf = (volatile unsigned int*)flags;\n        while (vf[row] == 0u) { __nanosleep(64); }\n        __threadfence();\n        s_mean = g_mean[row];\n        s_rstd = g_rstd[row];\n    }\n    __syncthreads();\n    float mean = s_mean;\n    float rstd = s_rstd;\n    float4* yr = y4 + (long)row * (long)n4"]
[485.387498, "i", ";\n    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\n        float4 v = xr[i];\n        float4 wv = w4[i];\n        float4 bv = b4[i];\n        float4 o;\n        o.x = (v.x - mean) * rstd * wv.x + bv.x;\n        o.y = (v.y - mean) * rstd * wv.y + bv.y;\n        o.z = (v.z - mean) * rstd * wv.z + bv.z;\n        o.w = (v.w - mean) * rstd * wv.w + bv.w;\n        yr[i] = o;\n    }\n}\n\ntorch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b,\n                         torch::Tensor ws, double eps, int64_t chunks_req) {\n    auto y = torch::empty_like(x);\n    int64_t M = x.size(0);\n    int64_t N = x.numel() / M;\n    int n4 = (int)(N / 4);\n    float* fws = (float*)ws.data_ptr<int>();\n    unsigned int* iws = (unsigned int*)ws.data_ptr<int>();\n    float* g_sum = fws;\n    float* g_sumsq = fws + M;\n    float* g_mean = fws + 2*M;\n    float* g_rstd = fws + 3*M;\n    unsigned int* counters = iws + 4*M;\n    unsigned int* flags = iws + 5*M;\n\n    int dev; cudaGetDevice(&dev);\n    int numSMs; cudaDeviceGet"]
[485.387621, "i", "Attribute(&numSMs, cudaDevAttrMultiProcessorCount, dev);\n    int blocksPerSM = 0;\n    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocksPerSM, (const void*)ln_kernel, 256, 0);\n    int64_t maxResident = (int64_t)numSMs * std::max(blocksPerSM, 1);\n    int64_t chunks = chunks_req;\n    if (chunks * M > maxResident) chunks = std::max<int64_t>(1, maxResident / M);\n\n    dim3 grid((unsigned)chunks, (unsigned)M);\n    auto stream = at::cuda::getCurrentCUDAStream();\n    ln_kernel<<<grid, 256, 0, stream>>>(\n        (const float4*)x.data_ptr<float>(),\n        (const float4*)w.data_ptr<float>(),\n        (const float4*)b.data_ptr<float>(),\n        (float4*)y.data_ptr<float>(),\n        g_sum, g_sumsq, g_mean, g_rstd, counters, flags,\n        n4, (int)chunks, (float)eps);\n    return y;\n}\n'''\n\ncpp_src = 'torch::Tensor ln_forward(torch::Tensor x, torch::Tensor w, torch::Tensor b, torch::Tensor ws, double eps, int64_t chunks_req);'\n\nmod = load_inline(name='ln_split_cuda', cpp_sources=cpp_src, cuda_sources=cuda_src,\n          "]
[485.387653, "i", "        functions=['ln_forward'], extra_cuda_cflags=['-O3'], verbose=False)\n\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\n\ndef cuda_fn(x, w, b, eps, ws, chunks):\n    ws.zero_()\n    return mod.ln_forward(x, w, b, ws, eps, chunks)\n\ndef main():\n    torch.manual_seed(0)\n    x = torch.rand(B, F, D1, D2, device='cuda')\n    ln = nn.LayerNorm((F, D1, D2)).cuda()\n    w, b, eps = ln.weight, ln.bias, ln.eps\n    ref = ln(x)\n    ws = torch.zeros(6 * B, dtype=torch.int32, device='cuda')\n    for chunks in [16, 32, 64]:\n        out = cuda_fn(x, w, b, eps, ws, chunks)\n        diff = (ref - out).abs().max().item()\n        ok = torch.allclose(ref, out, atol=1e-4, rtol=1e-4)\n        ms = triton.testing.do_bench(lambda: cuda_fn(x, w, b, eps, ws, chunks), warmup=10, rep=50)\n        print(f'chunks={chunks}: diff={diff:.3e} ok={ok} time={ms:.4f} ms')\n    ms_native = triton.testing.do_bench(lambda: ln(x), warmup=10, rep=50)\n    print(f'native: {ms_native:.4f} ms')\n\nif __name__ == '__main__':\n    main()\nEOF\ncd /workspace/dev && pyt"]
[485.387752, "i", "hon3 bench3.py\n"]
