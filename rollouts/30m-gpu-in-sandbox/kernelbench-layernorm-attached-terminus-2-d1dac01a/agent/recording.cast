[750.966492, "o", "    float4* yr = y4 + (long)row * (long)n4;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.966915, "o", "    for (int i = start + threadIdx.x; i < end; i += blockDim.x) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.96713, "o", "        float4 v = xr[i];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[750.96729, "o", "        float4 wv = w4[i];\r\n\u001b[?2004l\r"]
[750.967354, "o", "\u001b[?2004h> "]
