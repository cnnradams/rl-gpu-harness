[418.389877, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.390213, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
