[737.547832, "i", "cat > /workspace/bench4.py <<'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef ksplit(A, A1, A2, M, K, sam, sak, BM: tl.constexpr, BK: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_n = tl.cdiv(K, BK)\n    pid_m = pid // grid_n\n    pid_n = pid % grid_n\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_k = pid_n * BK + tl.arange(0, BK)\n    a = tl.load(A + offs_m[:, None]*sam + offs_k[None, :]*sak)\n    a1 = a.to(tl.float16)\n    a2 = (a - a1.to(tl.float32)).to(tl.float16)\n    tl.store(A1 + offs_m[:, None]*K + offs_k[None, :], a1)\n    tl.store(A2 + offs_m[:, None]*K + offs_k[None, :], a2)\n\n@triton.jit\ndef k3(A1, A2, W1, W2, Bias, C, M, N, K,\n       swk, swn, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % g"]
[737.548064, "i", "roup_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    a1_ptrs = A1 + offs_m[:, None] * K + offs_k[None, :]\n    a2_ptrs = A2 + offs_m[:, None] * K + offs_k[None, :]\n    w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\n    w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for kk in range(0, K, BK):\n        a1 = tl.load(a1_ptrs)\n        a2 = tl.load(a2_ptrs)\n        w1 = tl.load(w1_ptrs)\n        w2 = tl.load(w2_ptrs)\n        acc = tl.dot(a1, w1, acc)\n        acc = tl.dot(a1, w2, acc)\n        acc = tl.dot(a2, w1, acc)\n        a1_ptrs += BK\n        a2_ptrs += BK\n        w1_ptrs += BK * swk\n        w2_ptrs += BK * swk\n    bias = tl.load(Bias + offs_n)\n    acc = acc + bias[None, :]\n    tl.store(C + offs_m[:, None] * scm + offs_n[None, :] * scn, acc)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nA = torch.rand(M, K, device='c"]
[737.548144, "i", "uda')\nW = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\nw1 = W.half(); w2 = (W - w1.float()).half()\nbias = torch.rand(N, device='cuda')/10\nref = A @ W + bias\nC = torch.empty(M, N, device='cuda')\nA1 = torch.empty(M, K, device='cuda', dtype=torch.float16)\nA2 = torch.empty(M, K, device='cuda', dtype=torch.float16)\n\nfor BM,BN,BK,wp,st in [(256,128,32,8,4),(256,128,32,16,4),(256,128,64,8,2),(128,128,64,8,3),(256,128,64,8,3),(256,64,32,8,4),(256,128,32,4,4)]:\n    try:\n        def run():\n            ksplit[(triton.cdiv(M,128)*triton.cdiv(K,64),)](A, A1, A2, M, K, A.stride(0), A.stride(1), BM=128, BK=64, num_warps=8)\n            k3[(triton.cdiv(M,BM)*triton.cdiv(N,BN),)](A1, A2, w1, w2, bias, C, M, N, K,\n                w1.stride(0), w1.stride(1), C.stride(0), C.stride(1),\n                BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=wp, num_stages=st)\n        run(); torch.cuda.synchronize()\n        err = (C - ref).abs().max().item()\n        st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)\n        for _ in ra"]
[737.548177, "o", "cat > /workspace/bench4.py <<'EOF'\r\n\u001b[?2004l\r"]
[737.548301, "i", "nge(5): run()\n        torch.cuda.synchronize(); st_ev.record()\n        for _ in range(20): run()\n        en.record(); torch.cuda.synchronize()\n        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: {st_ev.elapsed_time(en)/20:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: FAIL {type(e).__name__} {e}')\nEOF\npython3 /workspace/bench4.py\n"]
