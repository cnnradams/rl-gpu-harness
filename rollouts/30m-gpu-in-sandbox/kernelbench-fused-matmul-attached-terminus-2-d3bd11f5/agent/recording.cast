[829.597906, "i", "cat > /workspace/bench5.py <<'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef k_tma(A, W1, W2, Bias, C, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    a_desc = tl.make_tensor_descriptor(A, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    w1_desc = tl.make_tensor_descriptor(W1, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    w2_desc = tl.make_tensor_descriptor(W2, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for kk in range(0, K, BK):\n        a = a_desc.load([pid_m * BM, kk])\n        "]
[829.598111, "i", "w1 = w1_desc.load([kk, pid_n * BN])\n        w2 = w2_desc.load([kk, pid_n * BN])\n        a1 = a.to(tl.float16)\n        a2 = (a - a1.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a1, w1, acc)\n        acc = tl.dot(a1, w2, acc)\n        acc = tl.dot(a2, w1, acc)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    bias = tl.load(Bias + offs_n)\n    acc = acc + bias[None, :]\n    c_desc.store([pid_m * BM, pid_n * BN], acc)\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nA = torch.rand(M, K, device='cuda')\nW = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\nw1 = W.half(); w2 = (W - w1.float()).half()\nbias = torch.rand(N, device='cuda')/10\nref = A @ W + bias\nC = torch.empty(M, N, device='cuda')\n\nfor BM,BN,BK,wp,st in [(256,128,32,8,4),(256,128,64,8,3),(128,128,64,8,3),(256,128,32,8,3),(128,256,64,8,3),(256,256,32,8,2)]:\n    try:\n        def run():\n            k_tma[(triton.cdiv(M,BM)*tri"]
[829.598232, "i", "ton.cdiv(N,BN),)](A, w1, w2, bias, C, M, N, K,\n                BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=wp, num_stages=st)\n        run(); torch.cuda.synchronize()\n        err = (C - ref).abs().max().item()\n        st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)\n        for _ in range(5): run()\n        torch.cuda.synchronize(); st_ev.record()\n        for _ in range(20): run()\n        en.record(); torch.cuda.synchronize()\n        print(f'TMA BM{BM} BN{BN} BK{BK} w{wp} s{st}: {st_ev.elapsed_time(en)/20:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'TMA BM{BM} BN{BN} BK{BK} w{wp} s{st}: FAIL {type(e).__name__}: {str(e)[:120]}')\nEOF\npython3 /workspace/bench5.py\n"]
