[982.308088, "o", "\u001b[?2004h"]
[982.30814, "o", "> "]
[982.308483, "o", "            a2 = (a - a1.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.308722, "o", "            acc = tl.dot(a1, w1, acc)\r\n\u001b[?2004l\r"]
[982.308777, "o", "\u001b[?2004h> "]
[982.309049, "o", "            acc = tl.dot(a1, w2, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.30925, "o", "            acc = tl.dot(a2, w1, acc)\r\n\u001b[?2004l\r"]
[982.309309, "o", "\u001b[?2004h"]
[982.309327, "o", "> "]
[982.309466, "o", "            a_ptrs += BK * sak\r\n\u001b[?2004l\r"]
[982.309537, "o", "\u001b[?2004h> "]
