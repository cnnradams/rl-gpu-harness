[982.299928, "o", "> "]
[982.300018, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[982.300105, "o", "\u001b[?2004h> "]
[982.300327, "o", "    def _split_fp16_gemm(A, W1, W2, Bias, C,\r\n\u001b[?2004l\r"]
[982.300425, "o", "\u001b[?2004h> "]
[982.300569, "o", "                         M, N, K,\r\n\u001b[?2004l\r"]
[982.300613, "o", "\u001b[?2004h"]
[982.300657, "o", "> "]
[982.300926, "o", "                         sam, sak, swk, swn, scm, scn,\r\n\u001b[?2004l\r"]
[982.30095, "o", "\u001b[?2004h"]
[982.301024, "o", "> "]
[982.301382, "o", "                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[982.301447, "o", "\u001b[?2004h> "]
[982.301691, "o", "                         GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[982.301733, "o", "\u001b[?2004h"]
[982.301753, "o", "> "]
[982.301929, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[982.301955, "o", "\u001b[?2004h"]
[982.302047, "o", "> "]
[982.302159, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[982.302204, "o", "\u001b[?2004h> "]
[982.302446, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.302626, "o", "        width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[982.302654, "o", "\u001b[?2004h"]
[982.302794, "o", "> "]
[982.302957, "o", "        group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.30337, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.303755, "o", "        pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[982.30379, "o", "\u001b[?2004h"]
