[982.306938, "o", "\u001b[?2004h> "]
[982.307097, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[982.307193, "o", "\u001b[?2004h> "]
[982.307326, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
