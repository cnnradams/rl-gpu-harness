[982.314402, "o", "\u001b[?2004h> "]
[982.314767, "o", "            Ws = (self.matmul.weight.detach() * s).t().contiguous()  # [K, N]\r\n\u001b[?2004l\r"]
[982.314905, "o", "\u001b[?2004h> "]
