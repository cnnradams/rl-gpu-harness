[982.304295, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.30434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[982.304352, "o", "> "]
[982.304682, "o", "        offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.304981, "o", "        offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.30522, "o", "        offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[982.30532, "o", "\u001b[?2004h"]
[982.305401, "o", "> "]
[982.30565, "o", "        a_ptrs = A + offs_m[:, None] * sam + offs_k[None, :] * sak\r\n\u001b[?2004l\r"]
[982.305684, "o", "\u001b[?2004h"]
[982.305696, "o", "> "]
[982.306061, "o", "        w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r"]
[982.306091, "o", "\u001b[?2004h"]
[982.306179, "o", "> "]
[982.306541, "o", "        w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[982.306566, "o", "\u001b[?2004h"]
[982.306704, "o", "> "]
