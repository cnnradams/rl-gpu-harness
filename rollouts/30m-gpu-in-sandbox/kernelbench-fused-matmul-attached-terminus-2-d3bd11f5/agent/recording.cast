[342.542052, "o", "            a2 = (a - a1.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[342.542077, "o", "\u001b[?2004h"]
[342.542201, "o", "> "]
[342.542363, "o", "            acc = tl.dot(a1, w1, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.542565, "o", "            acc = tl.dot(a1, w2, acc)\r\n\u001b[?2004l\r"]
[342.542613, "o", "\u001b[?2004h"]
[342.542663, "o", "> "]
[342.542832, "o", "            acc = tl.dot(a2, w1, acc)\r\n\u001b[?2004l\r"]
[342.542918, "o", "\u001b[?2004h> "]
[342.543105, "o", "            a_ptrs += BK * sak\r\n\u001b[?2004l\r"]
[342.543178, "o", "\u001b[?2004h> "]
[342.543332, "o", "            w1_ptrs += BK * swk\r\n\u001b[?2004l\r"]
[342.543397, "o", "\u001b[?2004h> "]
[342.543623, "o", "            w2_ptrs += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[342.543661, "o", "\u001b[?2004h"]
[342.543678, "o", "> "]
[342.543885, "o", "        bias = tl.load(Bias + offs_n)\r\n"]
[342.543906, "o", "\u001b[?2004l\r"]
[342.544029, "o", "\u001b[?2004h> "]
[342.544257, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.544655, "o", "        c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.544673, "o", "> "]
[342.544907, "o", "        tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.54495, "o", "> \r\n\u001b[?2004l\r"]
[342.544988, "o", "\u001b[?2004h"]
[342.545057, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[342.545084, "o", "> "]
[342.545265, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[342.54536, "o", "\u001b[?2004h"]
[342.545424, "o", "> "]
[342.545882, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[342.545925, "o", "\u001b[?2004h> "]
[342.546221, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.546611, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.546857, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[342.54688, "o", "\u001b[?2004h"]
[342.546953, "o", "> "]
[342.547132, "o", "        self.in_features = in_features\r\n\u001b[?2004l\r"]
[342.547198, "o", "\u001b[?2004h> "]
[342.547479, "o", "        self.out_features = out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.547686, "o", "        s = 1.0 + scaling_factor\r\n\u001b[?2004l\r"]
[342.547796, "o", "\u001b[?2004h> "]
[342.54793, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[342.547996, "o", "\u001b[?2004h> "]
[342.548405, "o", "            Ws = (self.matmul.weight.detach() * s).t().contiguous()  # [K, N]\r\n\u001b[?2004l\r"]
[342.548562, "o", "\u001b[?2004h> "]
[342.548626, "o", "            w1 = Ws.half()\r\n\u001b[?2004l\r"]
[342.548753, "o", "\u001b[?2004h"]
[342.548775, "o", "> "]
[342.549214, "o", "            w2 = (Ws - w1.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.549248, "o", "> "]
[342.549967, "o", "            self.register_buffer(\"_w1_i16\", w1.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r"]
[342.550031, "o", "\u001b[?2004h"]
[342.550088, "o", "> "]
[342.550995, "o", "            self.register_buffer(\"_w2_i16\", w2.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.551852, "o", "            self.register_buffer(\"_bias_s\", (self.matmul.bias.detach() * s).contiguous(), persistent=False)\r\n\u001b[?2004l\r"]
[342.551873, "o", "\u001b[?2004h"]
[342.552014, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.552154, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[342.552217, "o", "\u001b[?2004h> "]
[342.552585, "o", "        if (not _HAS_TRITON) or (not x.is_cuda):\r\n\u001b[?2004l\r"]
[342.55273, "o", "\u001b[?2004h> "]
[342.552958, "o", "            s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[342.552987, "o", "\u001b[?2004h"]
[342.552998, "o", "> "]
[342.553491, "o", "            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.553607, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[342.553663, "o", "\u001b[?2004h"]
[342.55368, "o", "> "]
[342.553937, "o", "        N = self.out_features\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.554064, "o", "> "]
[342.554306, "o", "        BM, BN, BK, GROUP_M = 128, 256, 64, 8\r\n\u001b[?2004l\r"]
[342.554364, "o", "\u001b[?2004h"]
[342.554416, "o", "> "]
[342.554718, "o", "        if M % BM != 0 or N % BN != 0 or K % BK != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.55498, "o", "            s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[342.55504, "o", "\u001b[?2004h> "]
[342.555475, "o", "            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\r\n\u001b[?2004l\r"]
[342.555526, "o", "\u001b[?2004h> "]
[342.555683, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[342.555737, "o", "\u001b[?2004h"]
[342.555757, "o", "> "]
[342.556099, "o", "        w1 = self._w1_i16.view(torch.float16)\r\n\u001b[?2004l\r"]
[342.556125, "o", "\u001b[?2004h"]
[342.556135, "o", "> "]
[342.556384, "o", "        w2 = self._w2_i16.view(torch.float16)\r\n\u001b[?2004l\r"]
[342.556472, "o", "\u001b[?2004h> "]
[342.556652, "o", "        if w1.device != x.device:\r\n\u001b[?2004l\r"]
[342.556767, "o", "\u001b[?2004h> "]
[342.556921, "o", "            w1 = w1.to(x.device)\r\n\u001b[?2004l\r"]
[342.556988, "o", "\u001b[?2004h> "]
[342.557152, "o", "            w2 = w2.to(x.device)\r\n\u001b[?2004l\r"]
[342.557196, "o", "\u001b[?2004h> "]
[342.557498, "o", "            b = self._bias_s.to(x.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.55762, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.557665, "o", "> "]
[342.557803, "o", "            b = self._bias_s\r\n\u001b[?2004l\r"]
[342.557852, "o", "\u001b[?2004h> "]
[342.558366, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[342.558423, "o", "\u001b[?2004h> "]
[342.559657, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h>         _split_fp16_gemm[grid](\r\n\u001b[?2004l\r\u001b[?2004h>             x, w1, w2, b, out,\r\n\u001b[?2004l\r\u001b[?2004h>             M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.559997, "o", "            x.stride(0), x.stride(1), w1.stride(0), w1.stride(1),\r\n\u001b[?2004l\r"]
[342.560169, "o", "\u001b[?2004h> "]
[342.560408, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[342.560783, "o", "            BM=BM, BN=BN, BK=BK, GROUP_M=GROUP_M,\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.560843, "o", "> "]
[342.561014, "o", "            num_warps=8, num_stages=4,\r\n\u001b[?2004l\r"]
[342.561129, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[342.561193, "o", "\u001b[?2004h> "]
[342.561322, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[342.561423, "o", "> EOF\r\n\u001b[?2004l\r"]
[342.564981, "o", "\u001b[?2004h"]
[342.565071, "o", "root@modal:/workspace# "]
[343.479909, "i", "cat > /workspace/test_local.py <<'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\nclass RefModel(torch.nn.Module):\n    def __init__(self, inf, outf, s):\n        super().__init__()\n        self.matmul = torch.nn.Linear(inf, outf)\n        self.scaling_factor = s\n    def forward(self, x):\n        x = self.matmul(x)\n        o = x.clone().detach()\n        return x * self.scaling_factor + o\n\ntorch.manual_seed(42); torch.cuda.manual_seed(42)\nref = RefModel(4096, 4096, 0.5)\ntorch.manual_seed(42); torch.cuda.manual_seed(42)\nnew = ModelNew(4096, 4096, 0.5)\nref = ref.cuda(); new = new.cuda()\nmaxerrs = []\nfor t in range(5):\n    torch.manual_seed(1000+t)\n    x = torch.rand(16384, 4096, device='cuda')\n    with torch.no_grad():\n        y_ref = ref(x)\n        y_new = new(x)\n    err = (y_ref - y_new).abs().max().item()\n    ok = torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4)\n    maxerrs.append(err)\n    print(f'trial {t}: max_err={err:.3e} allclose={ok}')\nimport time\ntorch.cuda.synchro"]
[343.480196, "i", "nize()\nfor m, name in [(ref,'ref'),(new,'new')]:\n    for _ in range(3): m(x)\n    torch.cuda.synchronize()\n    st = torch.cuda.Event(True); en = torch.cuda.Event(True)\n    st.record()\n    for _ in range(10): m(x)\n    en.record(); torch.cuda.synchronize()\n    print(name, st.elapsed_time(en)/10, 'ms')\nEOF\npython3 /workspace/test_local.py\n"]
