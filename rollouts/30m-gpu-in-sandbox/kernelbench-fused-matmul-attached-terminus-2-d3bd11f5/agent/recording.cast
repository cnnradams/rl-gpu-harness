[897.815012, "i", "cat > /workspace/bench6.py <<'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef k(A, W1, W2, Bias, C, M, N, K,\n      sam, sak, swk, swn, scm, scn,\n      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    a_ptrs = A + offs_m[:, None] * sam + offs_k[None, :] * sak\n    w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\n    w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for kk in range(0, K, BK):\n        a = tl.load(a_ptrs)\n        w1 = tl.load(w1_ptrs)\n        w2 = tl.load(w2_ptrs)\n       "]
[897.815205, "i", " a1 = a.to(tl.float16)\n        a2 = (a - a1.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a1, w1, acc)\n        acc = tl.dot(a1, w2, acc)\n        acc = tl.dot(a2, w1, acc)\n        a_ptrs += BK * sak\n        w1_ptrs += BK * swk\n        w2_ptrs += BK * swk\n    bias = tl.load(Bias + offs_n)\n    acc = acc + bias[None, :]\n    tl.store(C + offs_m[:, None] * scm + offs_n[None, :] * scn, acc)\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nA = torch.rand(M, K, device='cuda')\nW = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\nw1 = W.half(); w2 = (W - w1.float()).half()\nbias = torch.rand(N, device='cuda')/10\nref = A @ W + bias\nC = torch.empty(M, N, device='cuda')\n\nfor BM,BN,BK,gm,wp,st in [\n    (256,128,32,4,8,4),(256,128,32,16,8,4),(256,128,32,1,8,4),\n    (256,128,32,8,8,5),(256,128,16,8,8,4),(256,128,64,8,2),\n    (128,128,32,8,8,5),(64,128,64,8,4,3),(256,128,32,32,8,4),\n]:\n    try:\n        def run():\n            k[(triton.cdiv(M,BM)*triton.cdiv(N,BN),)](A, w1, w2, bias, C, M, N, K,\n                A.stride(0),"]
[897.815373, "i", " A.stride(1), w1.stride(0), w1.stride(1),\n                C.stride(0), C.stride(1),\n                BM=BM, BN=BN, BK=BK, GROUP_M=gm, num_warps=wp, num_stages=st)\n        run(); torch.cuda.synchronize()\n        err = (C - ref).abs().max().item()\n        st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)\n        for _ in range(5): run()\n        torch.cuda.synchronize(); st_ev.record()\n        for _ in range(30): run()\n        en.record(); torch.cuda.synchronize()\n        print(f'BM{BM} BN{BN} BK{BK} g{gm} w{wp} s{st}: {st_ev.elapsed_time(en)/30:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} g{gm} w{wp} s{st}: FAIL {type(e).__name__}')\nEOF\npython3 /workspace/bench6.py\n"]
