[196.78228, "o", "370:def _process_input_tensor(input, device, backend=\"cuda\", precision=torch.float32):\r\n371-    \"\"\"\r\n372-    Helper function to move tensors to the correct device and apply backend-specific dtype casting.\r\n373-    \r\n374-    Args:\r\n375-        input: Input tensor or non-tensor value\r\n376-        device: Target CUDA device\r\n377-        backend: Backend type (e.g., 'cuda', 'triton', 'cute')\r\n378-        precision: torch.dtype \r\n379-    Returns:\r\n380-        Processed tensor on correct device with correct dtype, or original value if not a tensor\r\n381-    \"\"\"\r\n382-\r\n383-    # sometimes things like init inputs are floats (like in the case of labels / targets, classification losses, etc.) \r\n384-    if not isinstance(input, torch.Tensor):\r\n385-        return input\r\n386-    \r\n387-    # cast to the desired percision dtype for activations\r\n388-    input_tensor = input.to(dtype=precision)\r\n389-    \r\n390-    # Default for all other backends and float types\r\n391-    return input_tensor.to(device=device)\r\n392-\r\n393-\r\n394-de"]
[196.782318, "o", "f eval_kernel_against_ref(\r\n395-    original_model_src: str,\r\n396-    custom_model_src: str,\r\n397-    seed_num: int = 42,\r\n398-    num_correct_trials: int = 1,\r\n399-    num_perf_trials: int = 10,\r\n400-    measure_performance: bool = False,\r\n--\r\n495:    init_inputs = [_process_input_tensor(x, device, backend, precision) for x in init_inputs]\r\n496-    \r\n497-    with torch.no_grad():\r\n498-        set_seed(seed_num)  # set seed for reproducible weights\r\n499-        original_model = Model(*init_inputs)\r\n500-        assert hasattr(original_model, \"forward\")\r\n501-        if verbose:\r\n502-            print(\"[Eval] Original Model Loaded\")\r\n503-    \r\n504-    if verbose:\r\n505-        print(\"[Eval] Loading and Compiling New Model with Custom CUDA Kernel\")\r\n506-\r\n507-    # this is where compilation happens\r\n508-    try:\r\n509-        os.environ[\"TORCH_USE_CUDA_DSA\"] = \"1\"  # compile with device side assertion\r\n510-        tempfile = None\r\n511-        # add hash for later to distinguish between multi-turn kernels\r\n512-     "]
[196.78233, "o", "   \r\n513-        backend_lower = backend.lower()\r\n514-        if backend_lower in [\"triton\", \"tilelang\", \"cute\"]:\r\n515-            # Use tempfile approach for triton, tilelang, and cute\r\n516-            # These DSLs require proper module import for JIT decorators to work\r\n517-            ModelNew, tempfile = load_custom_model_with_tempfile(\r\n518-                custom_model_src, entry_point=\"ModelNew\"\r\n519-            )\r\n520-        else:\r\n521-            # Default CUDA backend\r\n522-            ModelNew = load_custom_model(custom_model_src, context, build_dir)\r\n"]
