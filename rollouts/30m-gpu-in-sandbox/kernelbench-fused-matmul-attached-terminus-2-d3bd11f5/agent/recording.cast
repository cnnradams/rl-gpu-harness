[418.407462, "o", "> EOF\r\n\u001b[?2004l\r"]
[418.41075, "o", "\u001b[?2004hroot@modal:/workspace# "]
[418.410989, "o", "python3 /workspace/bench.py\r\n\u001b[?2004l\r"]
