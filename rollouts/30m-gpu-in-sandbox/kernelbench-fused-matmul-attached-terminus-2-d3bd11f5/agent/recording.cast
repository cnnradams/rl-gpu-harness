[991.760326, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.72,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.72,\r\n    \"std\": 0.111,\r\n    \"min\": 2.5,\r\n    \"max\": 2.89,\r\n    \"num_trials\": 100\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.048,\r\n    \"min\": 11.2,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 100\r\n  },\r\n  \"solution_sha256\": \"442fb44159a5219c254acbeecfe95ef55c36d8e888271e95450701b779621a9e\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 100,\r\n  \"speedup\": 4.1911764705882355\r\n}\r\n"]
