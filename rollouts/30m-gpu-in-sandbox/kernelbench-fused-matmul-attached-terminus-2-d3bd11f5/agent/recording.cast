[418.392163, "o", "> "]
[418.39254, "o", "    w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.392877, "o", "    w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r"]
[418.392909, "o", "\u001b[?2004h"]
[418.392921, "o", "> "]
[418.393171, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[418.393221, "o", "\u001b[?2004h"]
[418.393244, "o", "> "]
[418.393422, "o", "    for kk in range(0, K, BK):\r\n\u001b[?2004l\r"]
[418.393448, "o", "\u001b[?2004h"]
[418.39346, "o", "> "]
[418.39362, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[418.393672, "o", "\u001b[?2004h> "]
[418.393942, "o", "        w1 = tl.load(w1_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.39418, "o", "        w2 = tl.load(w2_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.394377, "o", "        a1 = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[418.394551, "o", "\u001b[?2004h> "]
[418.394771, "o", "        a2 = (a - a1.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[418.394848, "o", "\u001b[?2004h"]
[418.394903, "o", "> "]
[418.395053, "o", "        acc = tl.dot(a1, w1, acc)\r\n\u001b[?2004l\r"]
[418.395114, "o", "\u001b[?2004h> "]
[418.395364, "o", "        acc = tl.dot(a1, w2, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.395556, "o", "        acc = tl.dot(a2, w1, acc)\r\n\u001b[?2004l\r"]
[418.395583, "o", "\u001b[?2004h"]
[418.395648, "o", "> "]
[418.395776, "o", "        a_ptrs += BK * sak\r\n\u001b[?2004l\r"]
[418.395804, "o", "\u001b[?2004h"]
[418.395936, "o", "> "]
[418.396008, "o", "        w1_ptrs += BK * swk\r\n\u001b[?2004l\r"]
[418.396025, "o", "\u001b[?2004h"]
[418.396086, "o", "> "]
[418.396289, "o", "        w2_ptrs += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.396549, "o", "    bias = tl.load(Bias + offs_n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.396855, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[418.396925, "o", "\u001b[?2004h"]
[418.396951, "o", "> "]
[418.39727, "o", "    c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\r\n\u001b[?2004l\r"]
[418.3973, "o", "\u001b[?2004h"]
[418.397405, "o", "> "]
[418.397531, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[418.397589, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[418.397664, "o", "> "]
[418.397782, "o", "M=N=K=4096; M=16384\r\n\u001b[?2004l\r\u001b[?2004h"]
[418.397869, "o", "> "]
[418.397966, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[418.398026, "o", "> "]
[418.398225, "o", "A = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[418.398251, "o", "\u001b[?2004h"]
[418.39834, "o", "> "]
[418.398642, "o", "W = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.398879, "o", "w1 = W.half(); w2 = (W - w1.float()).half()\r\n\u001b[?2004l\r"]
[418.398907, "o", "\u001b[?2004h"]
[418.399033, "o", "> "]
[418.39917, "o", "bias = torch.rand(N, device='cuda')/10\r\n\u001b[?2004l\r"]
[418.399198, "o", "\u001b[?2004h"]
[418.399263, "o", "> "]
[418.39944, "o", "ref = A @ W + bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.399678, "o", "C = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[418.399763, "o", "\u001b[?2004h> "]
[418.399819, "o", "configs = [\r\n\u001b[?2004l\r"]
[418.399877, "o", "\u001b[?2004h> "]
[418.400352, "o", "    (128,256,64,8,2), (128,128,64,8,3), (128,128,32,4,4), (256,128,32,8,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.400782, "o", "    (64,256,64,4,2), (128,256,32,8,3), (256,64,64,8,3), (128,64,64,4,4),\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[418.400937, "o", "\u001b[?2004h> "]
[418.401151, "o", "for BM,BN,BK,wp,st in configs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.401178, "o", "    try:\r\n\u001b[?2004l\r"]
[418.401263, "o", "\u001b[?2004h> "]
[418.401535, "o", "        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r"]
[418.401565, "o", "\u001b[?2004h"]
[418.401578, "o", "> "]
[418.401709, "o", "        def run():\r\n\u001b[?2004l\r"]
[418.401747, "o", "\u001b[?2004h"]
[418.401772, "o", "> "]
[418.40211, "o", "            k[grid](A, w1, w2, bias, C, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.402485, "o", "                    A.stride(0), A.stride(1), w1.stride(0), w1.stride(1),\r\n\u001b[?2004l\r"]
[418.402511, "o", "\u001b[?2004h"]
[418.402579, "o", "> "]
[418.402824, "o", "                    C.stride(0), C.stride(1),\r\n\u001b[?2004l\r"]
[418.402858, "o", "\u001b[?2004h> "]
[418.403306, "o", "                    BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r"]
[418.403372, "o", "\u001b[?2004h> "]
[418.403589, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[418.403625, "o", "\u001b[?2004h"]
[418.403694, "o", "> "]
[418.403966, "o", "        err = (C - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.404334, "o", "        st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[418.404422, "o", "\u001b[?2004h> "]
[418.404635, "o", "        for _ in range(5): run()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.404969, "o", "        torch.cuda.synchronize(); st_ev.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.405153, "o", "        for _ in range(20): run()\r\n\u001b[?2004l\r"]
[418.405236, "o", "\u001b[?2004h> "]
[418.405474, "o", "        en.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[418.405555, "o", "\u001b[?2004h> "]
[418.405753, "o", "        ms = st_ev.elapsed_time(en)/20\r\n\u001b[?2004l\r"]
[418.405826, "o", "\u001b[?2004h> "]
[418.406019, "o", "        tflops = 3*2*M*N*K/ms/1e9\r\n\u001b[?2004l\r"]
[418.406043, "o", "\u001b[?2004h"]
[418.406161, "o", "> "]
[418.406597, "o", "        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: {ms:.3f} ms  {tflops:.0f} TF  err={err:.2e}')\r\n\u001b[?2004l\r"]
[418.406679, "o", "\u001b[?2004h> "]
[418.406824, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[418.406885, "o", "\u001b[?2004h"]
[418.406918, "o", "> "]
