[982.31633, "o", "            self.register_buffer(\"_w1_i16\", w1.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r"]
[982.316456, "o", "\u001b[?2004h> "]
[982.316878, "o", "            self.register_buffer(\"_w2_i16\", w2.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
