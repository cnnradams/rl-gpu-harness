[505.452666, "i", "cat > /workspace/bench2.py <<'EOF'\nimport torch, triton, triton.language as tl\nexec(open('/workspace/bench.py').read().split('configs =')[0].split('import torch, triton')[1].replace('import triton.language as tl','',1).join(['import torch, triton, triton.language as tl\\n','']) if False else '')\nEOF\ncat > /workspace/bench2.py <<'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef k(A, W1, W2, Bias, C, M, N, K,\n      sam, sak, swk, swn, scm, scn,\n      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    a_ptrs = A + offs_m[:, None] * sam + offs_k[None, :] * sak\n   "]
[505.452858, "i", " w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\n    w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for kk in range(0, K, BK):\n        a = tl.load(a_ptrs)\n        w1 = tl.load(w1_ptrs)\n        w2 = tl.load(w2_ptrs)\n        a1 = a.to(tl.float16)\n        a2 = (a - a1.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a1, w1, acc)\n        acc = tl.dot(a1, w2, acc)\n        acc = tl.dot(a2, w1, acc)\n        a_ptrs += BK * sak\n        w1_ptrs += BK * swk\n        w2_ptrs += BK * swk\n    bias = tl.load(Bias + offs_n)\n    acc = acc + bias[None, :]\n    c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\n    tl.store(c_ptrs, acc)\n\nM=N=K=4096; M=16384\ntorch.manual_seed(0)\nA = torch.rand(M, K, device='cuda')\nW = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\nw1 = W.half(); w2 = (W - w1.float()).half()\nbias = torch.rand(N, device='cuda')/10\nref = A @ W + bias\nC = torch.empty(M, N, device='cuda')\n\nconfigs = [\n    (256,128,64,8,2), (256,128"]
[505.452973, "i", ",32,8,4), (256,256,32,8,2), (256,256,32,8,3),\n    (256,128,32,8,2), (128,128,64,8,4), (256,128,64,8,3), (128,256,64,8,3),\n]\nfor BM,BN,BK,wp,st in configs:\n    try:\n        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        def run():\n            k[grid](A, w1, w2, bias, C, M, N, K,\n                    A.stride(0), A.stride(1), w1.stride(0), w1.stride(1),\n                    C.stride(0), C.stride(1),\n                    BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=wp, num_stages=st)\n        run(); torch.cuda.synchronize()\n        err = (C - ref).abs().max().item()\n        st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)\n        for _ in range(5): run()\n        torch.cuda.synchronize(); st_ev.record()\n        for _ in range(20): run()\n        en.record(); torch.cuda.synchronize()\n        ms = st_ev.elapsed_time(en)/20\n        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: {ms:.3f} ms  err={err:.2e}')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: FAIL {type(e).__name__}')\nEOF"]
[505.452993, "i", "\npython3 /workspace/bench2.py\n"]
[505.453134, "o", "cat > /workspace/bench2.py <<'EOF'\r\n\u001b[?2004l\r"]
[505.453293, "o", "\u001b[?2004h> "]
[505.453595, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.454797, "o", "exec(open('/workspace/bench.py').read().split('configs =')[0].split('import torch, triton')[1].replace('import triton.language as tl','',1).join(['import torch, triton, triton.language as tl\\n','']) if False else '')\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.45483, "o", "> EOF\r\n"]
[505.454844, "o", "\u001b[?2004l\r"]
[505.458079, "o", "\u001b[?2004hroot@modal:/workspace# "]
[505.458416, "o", "cat > /workspace/bench2.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.45852, "o", "> "]
[505.45871, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[505.458746, "o", "\u001b[?2004h> "]
[505.458762, "o", "\r\n\u001b[?2004l\r"]
[505.458815, "o", "\u001b[?2004h"]
[505.458839, "o", "> "]
[505.458949, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.459065, "o", "> "]
[505.4592, "o", "def k(A, W1, W2, Bias, C, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.45924, "o", "> "]
[505.459458, "o", "      sam, sak, swk, swn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.459517, "o", "> "]
[505.460021, "o", "      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.460207, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.460496, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[505.460522, "o", "\u001b[?2004h"]
[505.460646, "o", "> "]
[505.460781, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.460823, "o", "> "]
[505.460979, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[505.46101, "o", "\u001b[?2004h"]
[505.461022, "o", "> "]
[505.461386, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[505.461414, "o", "\u001b[?2004h"]
[505.461541, "o", "> "]
[505.461729, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[505.461802, "o", "\u001b[?2004h"]
[505.461883, "o", "> "]
[505.462045, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[505.462128, "o", "\u001b[?2004h> "]
[505.46233, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[505.46239, "o", "\u001b[?2004h> "]
[505.462641, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[505.462672, "o", "\u001b[?2004h"]
[505.462686, "o", "> "]
[505.462868, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[505.462944, "o", "\u001b[?2004h"]
[505.462973, "o", "> "]
[505.463314, "o", "    a_ptrs = A + offs_m[:, None] * sam + offs_k[None, :] * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.46371, "o", "    w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.464035, "o", "    w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r"]
[505.464107, "o", "\u001b[?2004h> "]
[505.464354, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[505.464417, "o", "\u001b[?2004h> "]
[505.464613, "o", "    for kk in range(0, K, BK):\r\n\u001b[?2004l\r"]
[505.464658, "o", "\u001b[?2004h"]
[505.464722, "o", "> "]
[505.464934, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.465163, "o", "        w1 = tl.load(w1_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.465365, "o", "        w2 = tl.load(w2_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.465581, "o", "        a1 = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.46593, "o", "        a2 = (a - a1.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.466107, "o", "        acc = tl.dot(a1, w1, acc)\r\n\u001b[?2004l\r"]
[505.466176, "o", "\u001b[?2004h> "]
[505.466421, "o", "        acc = tl.dot(a1, w2, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.466613, "o", "        acc = tl.dot(a2, w1, acc)\r\n\u001b[?2004l\r"]
[505.466635, "o", "\u001b[?2004h"]
[505.466645, "o", "> "]
[505.466883, "o", "        a_ptrs += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.467029, "o", "        w1_ptrs += BK * swk\r\n\u001b[?2004l\r"]
[505.467072, "o", "\u001b[?2004h"]
[505.467095, "o", "> "]
[505.467257, "o", "        w2_ptrs += BK * swk\r\n\u001b[?2004l\r"]
[505.467285, "o", "\u001b[?2004h"]
[505.467349, "o", "> "]
[505.467511, "o", "    bias = tl.load(Bias + offs_n)\r\n\u001b[?2004l\r"]
[505.467542, "o", "\u001b[?2004h"]
[505.467556, "o", "> "]
[505.467737, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[505.467824, "o", "\u001b[?2004h> "]
[505.468211, "o", "    c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\r\n\u001b[?2004l\r"]
[505.468295, "o", "\u001b[?2004h"]
[505.468351, "o", "> "]
[505.468455, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[505.468481, "o", "\u001b[?2004h"]
[505.46855, "o", "> \r\n\u001b[?2004l\r"]
[505.468596, "o", "\u001b[?2004h"]
[505.468673, "o", "> "]
[505.468731, "o", "M=N=K=4096; M=16384\r\n\u001b[?2004l\r"]
[505.468755, "o", "\u001b[?2004h"]
[505.468823, "o", "> "]
[505.468926, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[505.468993, "o", "\u001b[?2004h> "]
[505.469174, "o", "A = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[505.469251, "o", "\u001b[?2004h> "]
[505.469527, "o", "W = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\r\n\u001b[?2004l\r"]
[505.469554, "o", "\u001b[?2004h"]
[505.46957, "o", "> "]
[505.469828, "o", "w1 = W.half(); w2 = (W - w1.float()).half()\r\n\u001b[?2004l\r"]
[505.469899, "o", "\u001b[?2004h> "]
[505.470114, "o", "bias = torch.rand(N, device='cuda')/10\r\n\u001b[?2004l\r"]
[505.470137, "o", "\u001b[?2004h"]
[505.470227, "o", "> "]
[505.470288, "o", "ref = A @ W + bias\r\n\u001b[?2004l\r"]
[505.470311, "o", "\u001b[?2004h"]
[505.470382, "o", "> "]
[505.470642, "o", "C = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[505.470672, "o", "> "]
[505.470783, "o", "configs = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.470876, "o", "> "]
[505.471281, "o", "    (256,128,64,8,2), (256,128,32,8,4), (256,256,32,8,2), (256,256,32,8,3),\r\n\u001b[?2004l\r"]
[505.47131, "o", "\u001b[?2004h"]
[505.471377, "o", "> "]
[505.471768, "o", "    (256,128,32,8,2), (128,128,64,8,4), (256,128,64,8,3), (128,256,64,8,3),\r\n\u001b[?2004l\r"]
[505.471793, "o", "\u001b[?2004h"]
[505.471866, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.47192, "o", "> "]
[505.472096, "o", "for BM,BN,BK,wp,st in configs:\r\n\u001b[?2004l\r"]
[505.472123, "o", "\u001b[?2004h"]
[505.472133, "o", "> "]
[505.472224, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.472287, "o", "> "]
[505.472647, "o", "        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.472751, "o", "        def run():\r\n\u001b[?2004l\r"]
[505.472831, "o", "\u001b[?2004h> "]
[505.473157, "o", "            k[grid](A, w1, w2, bias, C, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.473599, "o", "                    A.stride(0), A.stride(1), w1.stride(0), w1.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.473901, "o", "                    C.stride(0), C.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[505.473949, "o", "> "]
[505.474361, "o", "                    BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r"]
[505.474422, "o", "\u001b[?2004h> "]
[505.474706, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.474935, "o", "        err = (C - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[505.474995, "o", "\u001b[?2004h"]
[505.475056, "o", "> "]
[505.475407, "o", "        st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[505.475441, "o", "\u001b[?2004h> "]
[505.475621, "o", "        for _ in range(5): run()\r\n\u001b[?2004l\r"]
[505.475687, "o", "\u001b[?2004h> "]
[505.476027, "o", "        torch.cuda.synchronize(); st_ev.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.476259, "o", "        for _ in range(20): run()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[505.476494, "o", "        en.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[505.476573, "o", "\u001b[?2004h> "]
[505.476773, "o", "        ms = st_ev.elapsed_time(en)/20\r\n\u001b[?2004l\r"]
[505.476805, "o", "\u001b[?2004h"]
[505.476817, "o", "> "]
[505.477258, "o", "        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: {ms:.3f} ms  err={err:.2e}')\r\n\u001b[?2004l\r"]
[505.477318, "o", "\u001b[?2004h> "]
[505.477494, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[505.477525, "o", "\u001b[?2004h> "]
[505.478009, "o", "        print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: FAIL {type(e).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[505.482732, "o", "\u001b[?2004hroot@modal:/workspace# "]
[505.482878, "o", "python3 /workspace/bench2.py\r\n\u001b[?2004l\r"]
[508.49723, "o", "BM256 BN128 BK64 w8 s2: 3.475 ms  err=3.06e-05\r\n"]
[509.019016, "o", "BM256 BN128 BK32 w8 s4: 2.631 ms  err=3.04e-05\r\n"]
[511.201874, "o", "BM256 BN256 BK32 w8 s2: 41.813 ms  err=3.04e-05\r\n"]
[513.348798, "o", "BM256 BN256 BK32 w8 s3: 41.532 ms  err=3.04e-05\r\n"]
[513.883427, "o", "BM256 BN128 BK32 w8 s2: 3.601 ms  err=3.04e-05\r\n"]
[514.322549, "o", "BM128 BN128 BK64 w8 s4: 2.886 ms  err=3.06e-05\r\n"]
[515.001811, "o", "BM256 BN128 BK64 w8 s3: 2.646 ms  err=3.06e-05\r\n"]
[515.654253, "o", "BM128 BN256 BK64 w8 s3: FAIL OutOfResources\r\n"]
[516.05193, "o", "\u001b[?2004hroot@modal:/workspace# "]
[574.260885, "i", "cat > /workspace/solution.py <<'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\nif _HAS_TRITON:\n    @triton.jit\n    def _split_fp16_gemm(A, W1, W2, Bias, C,\n                         M, N, K,\n                         sam, sak, swk, swn, scm, scn,\n                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                         GROUP_M: tl.constexpr):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GROUP_M * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n        pid_m = group_id * GROUP_M + (pid % group_size)\n        pid_n = (pid % width) // group_size\n\n        offs_m = pid_m * BM + tl.arange(0, BM)\n        offs_n = pid_n * BN + tl.arange(0, BN)\n        offs_k = tl.arange(0, BK)\n\n        a_ptrs = A + offs_m[:, None] * sam "]
[574.26114, "i", "+ offs_k[None, :] * sak\n        w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\n        w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\n\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            a = tl.load(a_ptrs)\n            w1 = tl.load(w1_ptrs)\n            w2 = tl.load(w2_ptrs)\n            a1 = a.to(tl.float16)\n            a2 = (a - a1.to(tl.float32)).to(tl.float16)\n            acc = tl.dot(a1, w1, acc)\n            acc = tl.dot(a1, w2, acc)\n            acc = tl.dot(a2, w1, acc)\n            a_ptrs += BK * sak\n            w1_ptrs += BK * swk\n            w2_ptrs += BK * swk\n\n        bias = tl.load(Bias + offs_n)\n        acc = acc + bias[None, :]\n        c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\n        tl.store(c_ptrs, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        sel"]
[574.261343, "i", "f.scaling_factor = scaling_factor\n        self.in_features = in_features\n        self.out_features = out_features\n        s = 1.0 + scaling_factor\n        with torch.no_grad():\n            Ws = (self.matmul.weight.detach() * s).t().contiguous()  # [K, N]\n            w1 = Ws.half()\n            w2 = (Ws - w1.float()).half()\n            self.register_buffer(\"_w1_i16\", w1.view(torch.int16), persistent=False)\n            self.register_buffer(\"_w2_i16\", w2.view(torch.int16), persistent=False)\n            self.register_buffer(\"_bias_s\", (self.matmul.bias.detach() * s).contiguous(), persistent=False)\n\n    def forward(self, x):\n        s = 1.0 + self.scaling_factor\n        if (not _HAS_TRITON) or (not x.is_cuda):\n            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\n        M, K = x.shape\n        N = self.out_features\n        BM, BN, BK = 256, 128, 32\n        if M % BM != 0 or N % BN != 0 or K % BK != 0:\n            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\n        x = x.c"]
[574.261426, "o", "cat > /workspace/solution.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.261537, "i", "ontiguous()\n        w1 = self._w1_i16.view(torch.float16)\n        w2 = self._w2_i16.view(torch.float16)\n        if w1.device != x.device:\n            w1 = w1.to(x.device)\n            w2 = w2.to(x.device)\n            b = self._bias_s.to(x.device)\n        else:\n            b = self._bias_s\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        _split_fp16_gemm[grid](\n            x, w1, w2, b, out,\n            M, N, K,\n            x.stride(0), x.stride(1), w1.stride(0), w1.stride(1),\n            out.stride(0), out.stride(1),\n            BM=BM, BN=BN, BK=BK, GROUP_M=8,\n            num_warps=8, num_stages=4,\n        )\n        return out\nEOF\npython3 /opt/task/evaluate.py /workspace/solution.py 2>&1 | tail -40\n"]
[574.261651, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.261777, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.262019, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[574.262048, "o", "\u001b[?2004h"]
[574.262145, "o", "> try:\r\n\u001b[?2004l\r"]
[574.262167, "o", "\u001b[?2004h> "]
[574.262293, "o", "    import triton\r\n\u001b[?2004l\r"]
[574.262322, "o", "\u001b[?2004h"]
[574.2624, "o", "> "]
[574.262551, "o", "    import triton.language as tl\r\n\u001b[?2004l\r"]
[574.26258, "o", "\u001b[?2004h"]
[574.262717, "o", "> "]
[574.262752, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\r"]
[574.262802, "o", "\u001b[?2004h"]
[574.262883, "o", "> "]
[574.26299, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[574.263066, "o", "> "]
[574.26321, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[574.263249, "o", "> \r\n\u001b[?2004l\r"]
[574.263321, "o", "\u001b[?2004h> "]
[574.26342, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r"]
[574.263498, "o", "\u001b[?2004h> "]
[574.263608, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[574.263662, "o", "\u001b[?2004h> "]
[574.263953, "o", "    def _split_fp16_gemm(A, W1, W2, Bias, C,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.264128, "o", "                         M, N, K,\r\n\u001b[?2004l\r"]
[574.264184, "o", "\u001b[?2004h> "]
[574.264547, "o", "                         sam, sak, swk, swn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.264971, "o", "                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[574.265001, "o", "\u001b[?2004h"]
[574.265015, "o", "> "]
[574.265303, "o", "                         GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[574.265333, "o", "\u001b[?2004h"]
[574.265463, "o", "> "]
[574.265533, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[574.265606, "o", "\u001b[?2004h> "]
[574.265833, "o", "        grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.266074, "o", "        grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.266256, "o", "        width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[574.26632, "o", "\u001b[?2004h> "]
[574.266566, "o", "        group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.266934, "o", "        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[574.266963, "o", "\u001b[?2004h"]
[574.266977, "o", "> "]
[574.267294, "o", "        pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[574.267316, "o", "\u001b[?2004h"]
[574.267369, "o", "> "]
[574.267639, "o", "        pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[574.26766, "o", "\u001b[?2004h"]
[574.267754, "o", "> "]
[574.267962, "o", "        offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[574.268037, "o", "\u001b[?2004h"]
[574.268059, "o", "> "]
[574.268289, "o", "        offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[574.268363, "o", "\u001b[?2004h> "]
[574.268545, "o", "        offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[574.268627, "o", "\u001b[?2004h"]
[574.26865, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[574.268672, "o", "> "]
[574.269051, "o", "        a_ptrs = A + offs_m[:, None] * sam + offs_k[None, :] * sak\r\n\u001b[?2004l\r"]
[574.269161, "o", "\u001b[?2004h> "]
[574.269498, "o", "        w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r"]
[574.269533, "o", "\u001b[?2004h"]
[574.269599, "o", "> "]
[574.269948, "o", "        w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\r\n\u001b[?2004l\r"]
[574.270033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[574.270093, "o", "\u001b[?2004h"]
[574.270115, "o", "> "]
[574.270372, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[574.270474, "o", "\u001b[?2004h> "]
[574.270706, "o", "        for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.270888, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[574.270917, "o", "\u001b[?2004h"]
[574.27105, "o", "> "]
[574.27115, "o", "            w1 = tl.load(w1_ptrs)\r\n\u001b[?2004l\r"]
[574.271213, "o", "\u001b[?2004h"]
[574.271279, "o", "> "]
[574.271409, "o", "            w2 = tl.load(w2_ptrs)\r\n\u001b[?2004l\r"]
[574.271434, "o", "\u001b[?2004h"]
[574.271505, "o", "> "]
[574.271677, "o", "            a1 = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[574.271704, "o", "\u001b[?2004h"]
[574.271836, "o", "> "]
[574.272055, "o", "            a2 = (a - a1.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[574.272082, "o", "\u001b[?2004h"]
[574.272184, "o", "> "]
[574.272348, "o", "            acc = tl.dot(a1, w1, acc)\r\n\u001b[?2004l\r"]
[574.272424, "o", "\u001b[?2004h"]
[574.272491, "o", "> "]
[574.272671, "o", "            acc = tl.dot(a1, w2, acc)\r\n\u001b[?2004l\r"]
[574.27271, "o", "\u001b[?2004h"]
[574.272846, "o", "> "]
[574.273012, "o", "            acc = tl.dot(a2, w1, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[574.273038, "o", "> "]
[574.273277, "o", "            a_ptrs += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.27351, "o", "            w1_ptrs += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.273736, "o", "            w2_ptrs += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[574.273767, "o", "\u001b[?2004h"]
[574.273855, "o", "> "]
[574.274072, "o", "        bias = tl.load(Bias + offs_n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.274242, "o", "        acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[574.274293, "o", "\u001b[?2004h"]
[574.27438, "o", "> "]
[574.274682, "o", "        c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\r\n\u001b[?2004l\r"]
[574.274709, "o", "\u001b[?2004h"]
[574.274853, "o", "> "]
[574.274927, "o", "        tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[574.275027, "o", "\u001b[?2004h"]
[574.275076, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[574.27509, "o", "\u001b[?2004h"]
[574.275135, "o", "> "]
[574.27535, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.275697, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[574.275774, "o", "\u001b[?2004h"]
[574.275835, "o", "> "]
[574.275997, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[574.276024, "o", "\u001b[?2004h"]
[574.276125, "o", "> "]
[574.276385, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[574.276469, "o", "\u001b[?2004h"]
[574.276495, "o", "> "]
[574.276747, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.276944, "o", "        self.in_features = in_features\r\n\u001b[?2004l\r"]
[574.277009, "o", "\u001b[?2004h"]
[574.2771, "o", "> "]
[574.277321, "o", "        self.out_features = out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.277559, "o", "        s = 1.0 + scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.277714, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[574.277791, "o", "\u001b[?2004h"]
[574.277817, "o", "> "]
[574.278207, "o", "            Ws = (self.matmul.weight.detach() * s).t().contiguous()  # [K, N]\r\n\u001b[?2004l\r"]
[574.278266, "o", "\u001b[?2004h> "]
[574.278429, "o", "            w1 = Ws.half()\r\n\u001b[?2004l\r"]
[574.278454, "o", "\u001b[?2004h"]
[574.278465, "o", "> "]
[574.278753, "o", "            w2 = (Ws - w1.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.279255, "o", "            self.register_buffer(\"_w1_i16\", w1.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.279716, "o", "            self.register_buffer(\"_w2_i16\", w2.view(torch.int16), persistent=False)\r\n\u001b[?2004l\r"]
[574.279782, "o", "\u001b[?2004h> "]
[574.280346, "o", "            self.register_buffer(\"_bias_s\", (self.matmul.bias.detach() * s).contiguous(), persistent=False)\r\n\u001b[?2004l\r"]
[574.280373, "o", "\u001b[?2004h"]
[574.280452, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[574.280523, "o", "> "]
[574.280641, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[574.280726, "o", "\u001b[?2004h"]
[574.280747, "o", "> "]
[574.280984, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.281294, "o", "        if (not _HAS_TRITON) or (not x.is_cuda):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.281742, "o", "            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.281924, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.282081, "o", "        N = self.out_features\r\n\u001b[?2004l\r"]
[574.282107, "o", "\u001b[?2004h"]
[574.282167, "o", "> "]
[574.282324, "o", "        BM, BN, BK = 256, 128, 32\r\n\u001b[?2004l\r"]
[574.282363, "o", "\u001b[?2004h"]
[574.282381, "o", "> "]
[574.282728, "o", "        if M % BM != 0 or N % BN != 0 or K % BK != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.283117, "o", "            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\r\n\u001b[?2004l\r"]
[574.283208, "o", "\u001b[?2004h> "]
[574.283372, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[574.283421, "o", "\u001b[?2004h"]
[574.283495, "o", "> "]
[574.283773, "o", "        w1 = self._w1_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.284084, "o", "        w2 = self._w2_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.284269, "o", "        if w1.device != x.device:\r\n\u001b[?2004l\r"]
[574.284332, "o", "\u001b[?2004h"]
[574.284397, "o", "> "]
[574.284575, "o", "            w1 = w1.to(x.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.284748, "o", "            w2 = w2.to(x.device)\r\n\u001b[?2004l\r"]
[574.284846, "o", "\u001b[?2004h> "]
[574.285094, "o", "            b = self._bias_s.to(x.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.28527, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.285398, "o", "            b = self._bias_s\r\n\u001b[?2004l\r"]
[574.28546, "o", "\u001b[?2004h"]
[574.28549, "o", "> "]
[574.285853, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[574.285878, "o", "\u001b[?2004h"]
[574.285974, "o", "> "]
[574.286235, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[574.286265, "o", "\u001b[?2004h"]
[574.286404, "o", "> "]
[574.286478, "o", "        _split_fp16_gemm[grid](\r\n\u001b[?2004l\r"]
[574.286533, "o", "\u001b[?2004h> "]
[574.286783, "o", "            x, w1, w2, b, out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.286902, "o", "            M, N, K,\r\n\u001b[?2004l\r"]
[574.286978, "o", "\u001b[?2004h> "]
[574.287366, "o", "            x.stride(0), x.stride(1), w1.stride(0), w1.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.287665, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[574.28792, "o", "            BM=BM, BN=BN, BK=BK, GROUP_M=8,\r\n\u001b[?2004l\r"]
[574.287975, "o", "\u001b[?2004h"]
[574.287997, "o", "> "]
[574.288192, "o", "            num_warps=8, num_stages=4,\r\n\u001b[?2004l\r"]
[574.288293, "o", "\u001b[?2004h> "]
[574.288319, "o", "        )\r\n\u001b[?2004l\r"]
[574.288377, "o", "\u001b[?2004h> "]
[574.288505, "o", "        return out\r\n\u001b[?2004l\r"]
[574.288531, "o", "\u001b[?2004h"]
[574.288594, "o", "> EOF\r\n\u001b[?2004l\r"]
[574.293525, "o", "\u001b[?2004hroot@modal:/workspace# "]
[574.293927, "o", "python3 /opt/task/evaluate.py /workspace/solution.py 2>&1 | tail -40\r\n\u001b[?2004l\r"]
[583.116212, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.54,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.54,\r\n    \"std\": 0.0465,\r\n    \"min\": 2.51,\r\n    \"max\": 2.7,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0345,\r\n    \"min\": 11.4,\r\n    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"9ffdcf959d3d9ba51b4f300b11fea6b700c31103da2eff589ed41ff4189a47a3\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.488188976377953\r\n}\r\n"]
[583.201378, "o", "\u001b[?2004hroot@modal:/workspace# "]
[648.674598, "i", "cat > /workspace/bench3.py <<'EOF'\nimport torch\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nA = torch.rand(M, K, device='cuda')\nW = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\nbias = torch.rand(N, device='cuda')/10\nref = A @ W + bias\nw1 = W.half(); w2 = (W - w1.float()).half()\na1 = A.half(); a2 = (A - a1.float()).half()\n\n# approach: fp16 cublas GEMMs with fp32 accumulate via out dtype fp32?\n# torch.matmul fp16 x fp16 -> fp16 (acc fp32 internally, output rounded)\n# use torch.addmm with fp32 out? mixed dtypes not allowed.\n# Instead: C = (a1@w1).float() + (a1@w2).float() + (a2@w1).float() -- extra elementwise passes\n\ndef run_torch():\n    c = torch.matmul(a1, w1, out=None)\n    c2 = torch.matmul(a1, w2)\n    c3 = torch.matmul(a2, w1)\n    return c.float() + c2.float() + c3.float() + bias\n\nout = run_torch()\nerr = (out - ref).abs().max().item()\nprint('torch fp16 x3 err', err)\nst = torch.cuda.Event(True); en = torch.cuda.Event(True)\nfor _ in range(5): run_torch()\ntorch.cuda.synchronize(); st.record()\nfor _ in r"]
[648.674807, "i", "ange(20): run_torch()\nen.record(); torch.cuda.synchronize()\nprint('torch fp16 x3:', st.elapsed_time(en)/20, 'ms')\n\n# pure fp16 single gemm lower bound\ndef run1():\n    return torch.matmul(a1, w1)\nfor _ in range(5): run1()\ntorch.cuda.synchronize(); st.record()\nfor _ in range(20): run1()\nen.record(); torch.cuda.synchronize()\nprint('single fp16 gemm:', st.elapsed_time(en)/20, 'ms')\n\n# fp32 cublas baseline\nAf = A; Wf = W\ndef run32():\n    return torch.matmul(Af, Wf)\nfor _ in range(5): run32()\ntorch.cuda.synchronize(); st.record()\nfor _ in range(20): run32()\nen.record(); torch.cuda.synchronize()\nprint('fp32 gemm:', st.elapsed_time(en)/20, 'ms')\n\n# tf32\ntorch.backends.cuda.matmul.allow_tf32 = True\ndef runt():\n    return torch.matmul(Af, Wf)\nfor _ in range(5): runt()\ntorch.cuda.synchronize(); st.record()\nfor _ in range(20): runt()\nen.record(); torch.cuda.synchronize()\nerrt = (runt() - ref).abs().max().item()\nprint('tf32 gemm:', st.elapsed_time(en)/20, 'ms err', errt)\nEOF\npython3 /workspace/bench3.py\n"]
[648.675004, "o", "cat > /workspace/bench3.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.675043, "o", "> "]
[648.675186, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.675227, "o", "> "]
[648.675405, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[648.675445, "o", "\u001b[?2004h> "]
[648.675613, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[648.675686, "o", "> "]
[648.675858, "o", "A = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[648.675887, "o", "\u001b[?2004h"]
[648.675899, "o", "> "]
[648.676175, "o", "W = (torch.rand(K, N, device='cuda') * 2 - 1) / 64\r\n\u001b[?2004l\r"]
[648.676351, "o", "\u001b[?2004h> "]
[648.676467, "o", "bias = torch.rand(N, device='cuda')/10\r\n\u001b[?2004l\r"]
[648.676497, "o", "\u001b[?2004h> "]
[648.67669, "o", "ref = A @ W + bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.676995, "o", "w1 = W.half(); w2 = (W - w1.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.677239, "o", "a1 = A.half(); a2 = (A - a1.float()).half()\r\n\u001b[?2004l\r"]
[648.677307, "o", "\u001b[?2004h"]
[648.67735, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.677748, "o", "# approach: fp16 cublas GEMMs with fp32 accumulate via out dtype fp32?\r\n\u001b[?2004l\r"]
[648.677828, "o", "\u001b[?2004h"]
[648.677849, "o", "> "]
[648.678222, "o", "# torch.matmul fp16 x fp16 -> fp16 (acc fp32 internally, output rounded)\r\n\u001b[?2004l\r"]
[648.67825, "o", "\u001b[?2004h"]
[648.678329, "o", "> "]
[648.678619, "o", "# use torch.addmm with fp32 out? mixed dtypes not allowed.\r\n\u001b[?2004l\r"]
[648.678698, "o", "\u001b[?2004h"]
[648.67873, "o", "> "]
[648.679208, "o", "# Instead: C = (a1@w1).float() + (a1@w2).float() + (a2@w1).float() -- extra elementwise passes\r\n\u001b[?2004l\r"]
[648.679235, "o", "\u001b[?2004h"]
[648.679359, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.679466, "o", "def run_torch():\r\n\u001b[?2004l\r"]
[648.679524, "o", "\u001b[?2004h"]
[648.679592, "o", "> "]
[648.679749, "o", "    c = torch.matmul(a1, w1, out=None)\r\n\u001b[?2004l\r"]
[648.679776, "o", "\u001b[?2004h"]
[648.679836, "o", "> "]
[648.679986, "o", "    c2 = torch.matmul(a1, w2)\r\n\u001b[?2004l\r"]
[648.680049, "o", "\u001b[?2004h> "]
[648.680284, "o", "    c3 = torch.matmul(a2, w1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[648.680576, "o", "    return c.float() + c2.float() + c3.float() + bias\r\n\u001b[?2004l\r"]
[648.680604, "o", "\u001b[?2004h"]
