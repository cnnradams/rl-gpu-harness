[982.298671, "o", "\u001b[?2004h> "]
[982.298689, "o", "try:\r\n\u001b[?2004l\r"]
[982.298729, "o", "\u001b[?2004h"]
[982.298747, "o", "> "]
[982.298861, "o", "    import triton\r\n\u001b[?2004l\r"]
[982.298923, "o", "\u001b[?2004h> "]
[982.299145, "o", "    import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[982.299241, "o", "> "]
[982.299297, "o", "    _HAS_TRITON = True\r\n\u001b[?2004l\r"]
[982.299356, "o", "\u001b[?2004h> "]
[982.299506, "o", "except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.299693, "o", "    _HAS_TRITON = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[982.299788, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
