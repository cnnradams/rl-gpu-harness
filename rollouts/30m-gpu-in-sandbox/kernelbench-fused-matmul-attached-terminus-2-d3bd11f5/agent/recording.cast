[418.391138, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[418.391217, "o", "\u001b[?2004h"]
[418.391245, "o", "> "]
[418.391501, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
