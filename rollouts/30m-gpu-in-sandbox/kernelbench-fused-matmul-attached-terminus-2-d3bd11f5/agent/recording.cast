[418.388367, "o", "      sam, sak, swk, swn, scm, scn,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[418.388858, "o", "      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
