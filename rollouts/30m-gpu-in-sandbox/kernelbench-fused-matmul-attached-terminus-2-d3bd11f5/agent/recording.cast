[342.530395, "i", "cat > /workspace/solution.py <<'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\nif _HAS_TRITON:\n    @triton.jit\n    def _split_fp16_gemm(A, W1, W2, Bias, C,\n                         M, N, K,\n                         sam, sak, swk, swn, scm, scn,\n                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                         GROUP_M: tl.constexpr):\n        pid = tl.program_id(0)\n        grid_m = tl.cdiv(M, BM)\n        grid_n = tl.cdiv(N, BN)\n        width = GROUP_M * grid_n\n        group_id = pid // width\n        group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n        pid_m = group_id * GROUP_M + (pid % group_size)\n        pid_n = (pid % width) // group_size\n\n        offs_m = pid_m * BM + tl.arange(0, BM)\n        offs_n = pid_n * BN + tl.arange(0, BN)\n        offs_k = tl.arange(0, BK)\n\n        a_ptrs = A + offs_m[:, None] * sam "]
[342.530613, "i", "+ offs_k[None, :] * sak\n        w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn\n        w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn\n\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for k in range(0, K, BK):\n            a = tl.load(a_ptrs)\n            w1 = tl.load(w1_ptrs)\n            w2 = tl.load(w2_ptrs)\n            a1 = a.to(tl.float16)\n            a2 = (a - a1.to(tl.float32)).to(tl.float16)\n            acc = tl.dot(a1, w1, acc)\n            acc = tl.dot(a1, w2, acc)\n            acc = tl.dot(a2, w1, acc)\n            a_ptrs += BK * sak\n            w1_ptrs += BK * swk\n            w2_ptrs += BK * swk\n\n        bias = tl.load(Bias + offs_n)\n        acc = acc + bias[None, :]\n        c_ptrs = C + offs_m[:, None] * scm + offs_n[None, :] * scn\n        tl.store(c_ptrs, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        sel"]
[342.530659, "i", "f.scaling_factor = scaling_factor\n        self.in_features = in_features\n        self.out_features = out_features\n        s = 1.0 + scaling_factor\n        with torch.no_grad():\n            Ws = (self.matmul.weight.detach() * s).t().contiguous()  # [K, N]\n            w1 = Ws.half()\n            w2 = (Ws - w1.float()).half()\n            self.register_buffer(\"_w1_i16\", w1.view(torch.int16), persistent=False)\n            self.register_buffer(\"_w2_i16\", w2.view(torch.int16), persistent=False)\n            self.register_buffer(\"_bias_s\", (self.matmul.bias.detach() * s).contiguous(), persistent=False)\n\n    def forward(self, x):\n        if (not _HAS_TRITON) or (not x.is_cuda):\n            s = 1.0 + self.scaling_factor\n            return F.linear(x, self.matmul.weight * s, self.matmul.bias * s)\n        M, K = x.shape\n        N = self.out_features\n        BM, BN, BK, GROUP_M = 128, 256, 64, 8\n        if M % BM != 0 or N % BN != 0 or K % BK != 0:\n            s = 1.0 + self.scaling_factor\n            return F.linear(x, sel"]
[342.530698, "i", "f.matmul.weight * s, self.matmul.bias * s)\n        x = x.contiguous()\n        w1 = self._w1_i16.view(torch.float16)\n        w2 = self._w2_i16.view(torch.float16)\n        if w1.device != x.device:\n            w1 = w1.to(x.device)\n            w2 = w2.to(x.device)\n            b = self._bias_s.to(x.device)\n        else:\n            b = self._bias_s\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        _split_fp16_gemm[grid](\n            x, w1, w2, b, out,\n            M, N, K,\n            x.stride(0), x.stride(1), w1.stride(0), w1.stride(1),\n            out.stride(0), out.stride(1),\n            BM=BM, BN=BN, BK=BK, GROUP_M=GROUP_M,\n            num_warps=8, num_stages=4,\n        )\n        return out\nEOF\n"]
