[?2004hroot@modal:/workspace# cat > /workspace/bench3.py <<'EOF'
[?2004l[?2004h> import torch
[?2004l[?2004h> M, N, K = 16384, 4096, 4096
[?2004l[?2004h> torch.manual_seed(0)
[?2004l[?2004h> A = torch.rand(M, K, device='cuda')
[?2004l[?2004h> W = (torch.rand(K, N, device='cuda') * 2 - 1) / 64
[?2004l[?2004h> bias = torch.rand(N, device='cuda')/10
[?2004l[?2004h> ref = A @ W + bias
[?2004l[?2004h> w1 = W.half(); w2 = (W - w1.float()).half()
[?2004l[?2004h> a1 = A.half(); a2 = (A - a1.float()).half()
[?2004l[?2004h> 
[?2004l[?2004h> # approach: fp16 cublas GEMMs with fp32 accumulate via out dtype fp32?
[?2004l[?2004h> # torch.matmul fp16 x fp16 -> fp16 (acc fp32 internally, output rounded)
[?2004l[?2004h> # use torch.addmm with fp32 out? mixed dtypes not allowed.
[?2004l[?2004h> # Instead: C = (a1@w1).float() + (a1@w2).float() + (a2@w1).float() -- extra elementwise passes
[?2004l[?2004h> 
[?2004l[?2004h> def run_torch():
[?2004l[?2004h>     c = torch.matmul(a1, w1, out=None)
