[?2004l[?2004h>     try:
[?2004l[?2004h>         def run():
[?2004l[?2004h>             ksplit[(triton.cdiv(M,128)*triton.cdiv(K,64),)](A, A1, A2, M, K, A.stride(0), A.stride(1), BM=128, BK=64, num_warps=8)
[?2004l[?2004h>             k3[(triton.cdiv(M,BM)*triton.cdiv(N,BN),)](A1, A2, w1, w2, bias, C, M, N, K,
[?2004l[?2004h>                 w1.stride(0), w1.stride(1), C.stride(0), C.stride(1),
[?2004l[?2004h>                 BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=wp, num_stages=st)
[?2004l[?2004h>         run(); torch.cuda.synchronize()
[?2004l[?2004h>         err = (C - ref).abs().max().item()
[?2004l[?2004h>         st_ev = torch.cuda.Event(True); en = torch.cuda.Event(True)
[?2004l[?2004h>         for _ in range(5): run()
[?2004l[?2004h>         torch.cuda.synchronize(); st_ev.record()
[?2004l[?2004h>         for _ in range(20): run()
[?2004l[?2004h>         en.record(); torch.cuda.synchronize()
[?2004l[?2004h>         print(f'BM{BM} BN{BN} BK{BK} w{wp} s{st}: {st_ev.elapsed_time(en)/20:.3f} ms err={err:.2e}')
