[?2004l[?2004h> import torch, triton, triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def ksplit(A, A1, A2, M, K, sam, sak, BM: tl.constexpr, BK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_n = tl.cdiv(K, BK)
[?2004l[?2004h>     pid_m = pid // grid_n
[?2004l[?2004h>     pid_n = pid % grid_n
[?2004l[?2004h>     offs_m = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     offs_k = pid_n * BK + tl.arange(0, BK)
[?2004l[?2004h>     a = tl.load(A + offs_m[:, None]*sam + offs_k[None, :]*sak)
[?2004l[?2004h>     a1 = a.to(tl.float16)
[?2004l[?2004h>     a2 = (a - a1.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>     tl.store(A1 + offs_m[:, None]*K + offs_k[None, :], a1)
[?2004l[?2004h>     tl.store(A2 + offs_m[:, None]*K + offs_k[None, :], a2)
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def k3(A1, A2, W1, W2, Bias, C, M, N, K,
[?2004l[?2004h>        swk, swn, scm, scn,
[?2004l[?2004h>        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GROUP_M * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)
[?2004l[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h>     offs_m = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     offs_n = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     offs_k = tl.arange(0, BK)
[?2004l[?2004h>     a1_ptrs = A1 + offs_m[:, None] * K + offs_k[None, :]
[?2004l[?2004h>     a2_ptrs = A2 + offs_m[:, None] * K + offs_k[None, :]
[?2004l[?2004h>     w1_ptrs = W1 + offs_k[:, None] * swk + offs_n[None, :] * swn
[?2004l[?2004h>     w2_ptrs = W2 + offs_k[:, None] * swk + offs_n[None, :] * swn
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for kk in range(0, K, BK):
[?2004l[?2004h>         a1 = tl.load(a1_ptrs)
[?2004l[?2004h>         a2 = tl.load(a2_ptrs)
[?2004l[?2004h>         w1 = tl.load(w1_ptrs)
[?2004l[?2004h>         w2 = tl.load(w2_ptrs)
[?2004l[?2004h>         acc = tl.dot(a1, w1, acc)
[?2004l[?2004h>         acc = tl.dot(a1, w2, acc)
[?2004l[?2004h>         acc = tl.dot(a2, w1, acc)
[?2004l[?2004h>         a1_ptrs += BK
[?2004l[?2004h>         a2_ptrs += BK
[?2004l[?2004h>         w1_ptrs += BK * swk
[?2004l[?2004h>         w2_ptrs += BK * swk
[?2004l[?2004h>     bias = tl.load(Bias + offs_n)
[?2004l[?2004h>     acc = acc + bias[None, :]
[?2004l[?2004h>     tl.store(C + offs_m[:, None] * scm + offs_n[None, :] * scn, acc)
[?2004l[?2004h> 
[?2004l[?2004h> M, N, K = 16384, 4096, 4096
[?2004l[?2004h> torch.manual_seed(0)
[?2004l[?2004h> A = torch.rand(M, K, device='cuda')
[?2004l[?2004h> W = (torch.rand(K, N, device='cuda') * 2 - 1) / 64
[?2004l[?2004h> w1 = W.half(); w2 = (W - w1.float()).half()
[?2004l[?2004h> bias = torch.rand(N, device='cuda')/10
[?2004l[?2004h> ref = A @ W + bias
[?2004l[?2004h> C = torch.empty(M, N, device='cuda')
[?2004l[?2004h> A1 = torch.empty(M, K, device='cuda', dtype=torch.float16)
[?2004l[?2004h> A2 = torch.empty(M, K, device='cuda', dtype=torch.float16)
[?2004l[?2004h> 
