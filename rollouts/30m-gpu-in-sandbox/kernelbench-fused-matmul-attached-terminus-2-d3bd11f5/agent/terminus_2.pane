[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super(ModelNew, self).__init__()
[?2004l[?2004h>         self.matmul = nn.Linear(in_features, out_features)
[?2004l[?2004h>         self.scaling_factor = scaling_factor
[?2004l[?2004h>         self.in_features = in_features
[?2004l[?2004h>         self.out_features = out_features
[?2004l[?2004h>         s = 1.0 + scaling_factor
[?2004l[?2004h>         with torch.no_grad():
[?2004l[?2004h>             Ws = (self.matmul.weight.detach() * s).t().contiguous()  # [K, N]
[?2004l[?2004h>             w1 = Ws.half()
[?2004l[?2004h>             w2 = (Ws - w1.float()).half()
[?2004l[?2004h>             self.register_buffer("_w1_i16", w1.view(torch.int16), persistent=False)
[?2004l[?2004h>             self.register_buffer("_w2_i16", w2.view(torch.int16), persistent=False)
[?2004l[?2004h>             self.register_buffer("_bias_s", (self.matmul.bias.detach() * s).contiguous(), persistent=False)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         s = 1.0 + self.scaling_factor
[?2004l[?2004h>         if (not _HAS_TRITON) or (not x.is_cuda):
