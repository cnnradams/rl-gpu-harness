[622.246243, "i", "cat > /workspace/scratch/tri3.py << 'EOF'\nimport torch, statistics\nimport triton\nimport triton.language as tl\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\n_l2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\n\ndef time_fn(fn, warmup=3, trials=30):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        _l2.zero_()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\n@triton.jit\ndef _copy_v(x_ptr, y_ptr, BLOCK: tl.constexpr, LEV: tl.constexpr, SEV: tl.constexpr, SCM: tl.constexpr, LCM: tl.constexpr):\n    pid = tl.program_id(0)\n    idx = pid * BLOCK + tl.arange(0, BLOCK)\n    v = tl.load(x_ptr + idx, eviction_policy=LEV, cache_modifier=LCM)\n    tl.store(y_ptr + idx, v, eviction_policy=SEV, cache_modifie"]
[622.246325, "i", "r=SCM)\n\ndef tri_copy(BLOCK=4096, nw=8, lev='', sev='', scm='', lcm=''):\n    y = torch.empty_like(x)\n    N = x.numel()\n    _copy_v[(N//BLOCK,)](x, y, BLOCK=BLOCK, LEV=lev, SEV=sev, SCM=scm, LCM=lcm, num_warps=nw)\n    return y\n\nvariants = [\n    dict(),\n    dict(lev='evict_first', sev='evict_first'),\n    dict(sev='evict_first'),\n    dict(lev='evict_first'),\n    dict(scm='.cs'),\n    dict(scm='.wt'),\n    dict(scm='.cs', lcm='.cv'),\n    dict(scm='.cs', lcm='.cg'),\n    dict(lev='evict_first', sev='evict_first', scm='.cs'),\n    dict(lev='evict_last', sev='evict_first'),\n]\nfor v in variants:\n    for BLOCK in [4096]:\n        for nw in [8]:\n            r = time_fn(lambda: tri_copy(BLOCK, nw, **v))\n            print(f'{str(v):70s} BLOCK={BLOCK} nw={nw}: {r[0]:.4f} {r[1]:.4f}')\nEOF\npython3 /workspace/scratch/tri3.py\n"]
