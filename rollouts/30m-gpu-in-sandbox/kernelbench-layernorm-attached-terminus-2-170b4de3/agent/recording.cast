[44.304538, "o", "cuda streams yet.\r\n\u001b[32m\u001b[K216\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    It assumes computation is done on the current stream for current device. \r\n\u001b[32m\u001b[K217\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Stay tuned for future PRs. \r\n\u001b[32m\u001b[K218\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K219\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Args:\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        kernel_fn: Function to time\r\n\u001b[32m\u001b[K221\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        args: Arguments to pass to kernel_fn\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        num_warmup: Number of warmup iterations before timing\r\n\u001b[32m\u001b[K223\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        num_trials: Number of timing trials to run\r\n\u001b[32m\u001b[K224\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        discard_first: Number of first trials to discard, for consistency with host_time, set to 0 to disable\r\n\u001b[32m\u001b[K225\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        verbose: Whether to print per-trial timing info\r\n\u001b[32m\u001b[K226\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        device: CUDA device to use, defaults to current device\r\n\u001b[32m\u001b[K227\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K228\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Returns:\r\n\u001b[32m\u001b[K229\u001b[m\u001b[K\u001b"]
[44.304553, "o", "[36m\u001b[K-\u001b[m\u001b[K        List of elapsed times in milliseconds (length = num_trials)\r\n\u001b[32m\u001b[K230\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K231\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    if device is None:\r\n\u001b[32m\u001b[K232\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        if verbose:\r\n\u001b[32m\u001b[K233\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            print(f\"Using current device: {torch.cuda.current_device()}\")\r\n\u001b[32m\u001b[K234\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        device = torch.cuda.current_device()\r\n\u001b[32m\u001b[K235\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K236\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    with torch.cuda.device(device):\r\n\u001b[32m\u001b[K237\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \r\n\u001b[32m\u001b[K238\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # Warm ups\r\n\u001b[32m\u001b[K239\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for _ in range(num_warmup):\r\n\u001b[32m\u001b[K240\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            kernel_fn(*args)\r\n\u001b[32m\u001b[K241\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            torch.cuda.synchronize(device=device)\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \r\n\u001b[32m\u001b[K243\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # note this only release PyTorch’s CUDA caching allocator, not necessarily clearing device's L2 cache\r\n\u001b[32m\u001b[K"]
[44.304672, "o", "244\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        torch.cuda.empty_cache()\r\n\u001b[32m\u001b[K245\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        \r\n\u001b[32m\u001b[K246\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        print(f\"[Profiling] Using device: {device} {torch.cuda.get_device_name(device)}, warm up {num_warmup}, trials {num_trials}\"\r\n\u001b[32m\u001b[K247\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        )\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K249\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        elapsed_times: list[float] = [] # in ms\r\n\u001b[32m\u001b[K250\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K251\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # Timing trials\r\n\u001b[32m\u001b[K252\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        for trial in range(num_trials + discard_first):\r\n\u001b[32m\u001b[K253\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            torch.cuda.synchronize(device=device) # block on all streams\r\n\u001b[32m\u001b[K254\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K255\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # create event marker default is not interprocess\r\n\u001b[32m\u001b[K256\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            start_event = torch.cuda.Event(enable_timing=True)\r\n\u001b[32m\u001b[K257\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            end_event = torch.cuda.Event(enable_timing=Tru"]
[44.304713, "o", "e)\r\n\u001b[32m\u001b[K258\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            \r\n\u001b[32m\u001b[K259\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            clear_l2_cache(device=device) # measuring cold cache performance\r\n\u001b[32m\u001b[K260\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K261\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # note cuda events mark event on current stream\r\n\u001b[32m\u001b[K262\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            start_event.record()\r\n\u001b[32m\u001b[K263\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            _ = kernel_fn(*args)\r\n\u001b[32m\u001b[K264\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            end_event.record() \r\n\u001b[32m\u001b[K265\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K266\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # waits for all streams on that device\r\n\u001b[32m\u001b[K267\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # though it is important to note the events only record time between on current stream\r\n\u001b[32m\u001b[K268\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # TODO: find ways to check hacks by launching work on additional stream\r\n\u001b[32m\u001b[K269\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            torch.cuda.synchronize(device=device)\r\n\u001b[32m\u001b[K270\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K271\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            # Calculate "]
[44.304727, "o", "the elapsed time in milliseconds\r\n\u001b[32m\u001b[K272\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            elapsed_time_ms = start_event.elapsed_time(end_event)\r\n\u001b[32m\u001b[K273\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            \r\n\u001b[32m\u001b[K274\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K            if trial >= discard_first:\r\n\u001b[32m\u001b[K275\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                if verbose:\r\n\u001b[32m\u001b[K276\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    logical_idx = trial - discard_first + 1\r\n\u001b[32m\u001b[K277\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                    print(f\"Trial {logical_idx}: {elapsed_time_ms:.3g} ms\")\r\n\u001b[32m\u001b[K278\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K                elapsed_times.append(elapsed_time_ms)\r\n\u001b[32m\u001b[K279\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n"]
