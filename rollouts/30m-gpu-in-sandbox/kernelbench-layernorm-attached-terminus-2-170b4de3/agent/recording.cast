[922.50023, "o", "    mean = t1 / N\r\n\u001b[?2004l\r"]
[922.500289, "o", "\u001b[?2004h> "]
[922.500474, "o", "    var = t2 / N - mean * mean\r\n\u001b[?2004l\r"]
[922.500497, "o", "\u001b[?2004h"]
[922.500588, "o", "> "]
[922.500749, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[922.500807, "o", "\u001b[?2004h> "]
[922.501138, "o", "    base = row.to(tl.int64) * N + pid * CHUNK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.50143, "o", "    for off in tl.range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.501694, "o", "        idx = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[922.501719, "o", "\u001b[?2004h"]
[922.501792, "o", "> "]
[922.502122, "o", "        v = tl.load(x_ptr + idx, eviction_policy=EVL)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.502501, "o", "        tl.store(y_ptr + idx, (v - mean) * rstd, eviction_policy=EVS)\r\n\u001b[?2004l\r"]
[922.502523, "o", "\u001b[?2004h"]
[922.502572, "o", "> \r\n\u001b[?2004l\r"]
[922.502623, "o", "\u001b[?2004h> "]
[922.502754, "o", "M, N = 16, 4194304\r\n\u001b[?2004l\r"]
[922.502799, "o", "\u001b[?2004h> "]
[922.503312, "o", "def run(S, BLOCK, nw1, nw2, rev=False, ev='', evl='', evs='', y=None, p=None):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.503412, "o", "    CHUNK = N // S\r\n\u001b[?2004l\r"]
[922.503434, "o", "\u001b[?2004h"]
[922.503533, "o", "> "]
[922.503993, "o", "    if p is None: p = torch.empty(2*M*S, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.504234, "o", "    if y is None: y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[922.50426, "o", "\u001b[?2004h"]
[922.504359, "o", "> "]
[922.504762, "o", "    _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, EV=ev, num_warps=nw1)\r\n\u001b[?2004l\r"]
[922.504808, "o", "\u001b[?2004h> "]
[922.505682, "o", "    _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=1e-5, BLOCK=BLOCK, SBLOCK=triton.next_power_of_2(S), REV=rev, EVL=evl, EVS=evs, num_warps=nw2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.505795, "o", "    return y\r\n\u001b[?2004l\r\u001b[?2004h"]
[922.505848, "o", "> \r\n\u001b[?2004l\r"]
[922.505872, "o", "\u001b[?2004h> "]
[922.505953, "o", "cfgs = [\r\n\u001b[?2004l\r"]
[922.506021, "o", "\u001b[?2004h> "]
[922.506265, "o", "    dict(S=128, BLOCK=4096, nw1=8, nw2=8),\r\n\u001b[?2004l\r"]
[922.506291, "o", "\u001b[?2004h"]
[922.506364, "o", "> "]
[922.506696, "o", "    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.507135, "o", "    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True, evl='evict_first'),\r\n\u001b[?2004l\r"]
[922.507164, "o", "\u001b[?2004h"]
[922.507238, "o", "> "]
[922.507587, "o", "    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True, ev='evict_last'),\r\n\u001b[?2004l\r"]
[922.507673, "o", "\u001b[?2004h> "]
[922.50814, "o", "    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True, ev='evict_last', evl='evict_first'),\r\n\u001b[?2004l\r"]
[922.508162, "o", "\u001b[?2004h"]
[922.508286, "o", "> "]
[922.508499, "o", "    dict(S=256, BLOCK=4096, nw1=8, nw2=8, rev=True),\r\n\u001b[?2004l\r"]
[922.508572, "o", "\u001b[?2004h"]
[922.508598, "o", "> "]
[922.508875, "o", "    dict(S=64, BLOCK=4096, nw1=8, nw2=8, rev=True),\r\n\u001b[?2004l\r"]
[922.508938, "o", "\u001b[?2004h"]
[922.509004, "o", "> "]
[922.509315, "o", "    dict(S=128, BLOCK=8192, nw1=16, nw2=16, rev=True),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.509684, "o", "    dict(S=128, BLOCK=2048, nw1=4, nw2=4, rev=True),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.509977, "o", "    dict(S=32, BLOCK=8192, nw1=8, nw2=8, rev=True),\r\n\u001b[?2004l\r"]
[922.510001, "o", "\u001b[?2004h"]
[922.510121, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.510226, "o", "for c in cfgs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[922.510244, "o", "> "]
[922.510347, "o", "    y = run(**c)\r\n\u001b[?2004l\r"]
[922.510418, "o", "\u001b[?2004h> "]
[922.510748, "o", "    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[922.510806, "o", "\u001b[?2004h"]
[922.510831, "o", "> "]
[922.511117, "o", "    mean, mn = time_fn(lambda: run(**c))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[922.511535, "o", "    print(f'{str(c):90s} ok={ok} mean={mean:.4f} min={mn:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
