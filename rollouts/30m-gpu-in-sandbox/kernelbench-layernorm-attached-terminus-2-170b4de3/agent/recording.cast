[823.675954, "o", "sed -n '130,155p' /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\r\n\u001b[?2004l\r"]
[823.679396, "o", "    https://github.com/gpu-mode/reference-kernels/commit/7c15075a39286e88939d99d3f3a60be88b8e6223#diff-3a30a71cbf8db2badd224f4d92f9a2546925a5b522632a31d353526b7a5f3338R158-R163\r\n    \"\"\"\r\n    # don't reserve space for persisting lines\r\n    # cp.cuda.runtime.cudaDeviceSetLimit(cp.cuda.runtime.cudaLimitPersistingL2CacheSize, 0)\r\n    \r\n    # Thrash L2 cache by creating a larger dummy tensor, effectively flushing the cache\r\n    # 32 * 1024 * 1024 * 8B = 256MB \r\n    # NOTE: we can make this more adaptive based on device\r\n    # L2 cache sizes: A100=40MB, H100=50MB, H200=90MB, RTX4090=72MB, L40S=48MB, Blackwell≈192MB → overwrite >200MB to fully thrash L2\r\n    dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\r\n    # write to tensor with inplace fill\r\n    dummy.fill_(42) \r\n    del dummy\r\n\r\ndef clear_l2_cache_triton(cache=None, device: str = \"cuda\"):\r\n    \"\"\"\r\n    Thrash the cache by making a large dummy tensor, using triton runtime's functionality\r\n    \"\"\"\r\n    from triton import runtime as tr"]
[823.679471, "o", "iton_runtime\r\n    with torch.cuda.device(device):\r\n        cache = triton_runtime.driver.active.get_empty_cache_for_benchmark()\r\n        # this effectively thrashes L2 cache under the hood too\r\n        triton_runtime.driver.active.clear_cache(cache)\r\n\r\n"]
[823.679577, "o", "\r\ndef get_timing_function(\r\n"]
[823.680148, "o", "\u001b[?2004h"]
[823.680244, "o", "root@modal:/workspace# "]
[824.010571, "i", "cat > /workspace/scratch/dirty.py << 'EOF'\nimport torch, statistics\ndev='cuda'\nx = torch.rand(16,64,256,256, device=dev)\ny = torch.empty_like(x)\nl2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\n\ndef one(clear_mode):\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    if clear_mode=='zero':\n        l2.zero_()\n    elif clear_mode=='zero_then_absorb':\n        l2.zero_()\n        # absorb: read+write a separate 256MB buffer to force writeback of dirty zeros outside timed region\n        l2.sum()\n    elif clear_mode=='none':\n        pass\n    torch.cuda.synchronize()\n    s.record(); y.copy_(x); e.record()\n    torch.cuda.synchronize()\n    return s.elapsed_time(e)\n\nfor mode in ['none','zero','zero_then_absorb']:\n    for _ in range(3): one(mode)\n    ts=[one(mode) for _ in range(20)]\n    print(mode, f'{statistics.mean(ts):.4f} ms')\nEOF\npython3 /workspace/scratch/dirty.py\n"]
