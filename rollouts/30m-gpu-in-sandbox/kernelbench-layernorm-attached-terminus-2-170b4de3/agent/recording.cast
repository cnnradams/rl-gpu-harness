[346.955775, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.955854, "o", "> "]
[346.95646, "o", "def _norm(x_ptr, y_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, eps, BLOCK: tl.constexpr, SBLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[346.956484, "o", "\u001b[?2004h"]
[346.95663, "o", "> "]
[346.956767, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.9569, "o", "    pid = tl.program_id(1)\r\n\u001b[?2004l\r"]
[346.957015, "o", "\u001b[?2004h> "]
[346.957239, "o", "    offs = tl.arange(0, SBLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.957314, "o", "    m1 = offs < S\r\n\u001b[?2004l\r"]
[346.957385, "o", "\u001b[?2004h"]
[346.957458, "o", "> "]
[346.957759, "o", "    p1 = tl.load(p_ptr + row * S + offs, mask=m1, other=0.0)\r\n\u001b[?2004l\r"]
[346.957785, "o", "\u001b[?2004h"]
[346.957854, "o", "> "]
[346.958266, "o", "    p2 = tl.load(p_ptr + 16 * S + row * S + offs, mask=m1, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.958372, "o", "    t1 = tl.sum(p1)\r\n\u001b[?2004l\r"]
[346.95848, "o", "\u001b[?2004h> "]
[346.958617, "o", "    t2 = tl.sum(p2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.958762, "o", "    mean = t1 / N\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.958833, "o", "> "]
[346.958963, "o", "    var = t2 / N - mean * mean\r\n\u001b[?2004l\r"]
[346.95903, "o", "\u001b[?2004h> "]
[346.959317, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.959475, "o", "    base = row * N + pid * CHUNK\r\n\u001b[?2004l\r"]
[346.959548, "o", "\u001b[?2004h> "]
[346.959849, "o", "    for off in tl.range(0, CHUNK, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.960193, "o", "        idx = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.960366, "o", "        v = tl.load(x_ptr + idx)\r\n\u001b[?2004l\r"]
[346.960442, "o", "\u001b[?2004h> "]
[346.960774, "o", "        tl.store(y_ptr + idx, (v - mean) * rstd)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[346.96086, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[346.961211, "o", "def ln_split(x, eps=1e-5, S=128, BLOCK=2048, nw1=8, nw2=8):\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.961268, "o", "> "]
[346.961366, "o", "    M = x.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.961425, "o", "> "]
[346.961519, "o", "    N = x[0].numel()\r\n\u001b[?2004l\r"]
[346.961586, "o", "\u001b[?2004h"]
[346.961669, "o", "> "]
[346.9617, "o", "    CHUNK = N // S\r\n\u001b[?2004l\r"]
[346.961769, "o", "\u001b[?2004h> "]
[346.962192, "o", "    p = torch.empty(2 * M * S, dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.962332, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[346.962353, "o", "\u001b[?2004h"]
[346.962451, "o", "> "]
[346.96291, "o", "    _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=nw1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.963595, "o", "    _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=eps, BLOCK=BLOCK, SBLOCK=triton.next_power_of_2(S), num_warps=nw2)\r\n\u001b[?2004l\r\u001b[?2004h>     return y\r\n\u001b[?2004l\r"]
[346.963636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[346.963852, "o", "\u001b[?2004h> dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[346.963966, "o", "\u001b[?2004h> "]
[346.96424, "o", "x = torch.rand(16, 64, 256, 256, device=dev)\r\n\u001b[?2004l\r"]
[346.964264, "o", "\u001b[?2004h"]
[346.964391, "o", "> "]
[346.964681, "o", "ref = F.layer_norm(x, (64, 256, 256), None, None, 1e-5)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[346.964748, "o", "\u001b[?2004h"]
[346.964819, "o", "> "]
[346.96515, "o", "_l2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r"]
[346.965246, "o", "\u001b[?2004h> "]
[346.965432, "o", "def time_fn(fn, warmup=3, trials=20):\r\n\u001b[?2004l\r"]
[346.965459, "o", "\u001b[?2004h"]
[346.965571, "o", "> "]
[346.965682, "o", "    for _ in range(warmup):\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.965757, "o", "> "]
[346.965955, "o", "        fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[346.966032, "o", "\u001b[?2004h"]
[346.966155, "o", ">     ts=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.966373, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.966567, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.966597, "o", "> "]
[346.967138, "o", "        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.967257, "o", "        _l2.zero_()\r\n\u001b[?2004l\r"]
[346.967279, "o", "\u001b[?2004h"]
[346.96729, "o", "> "]
[346.9675, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[346.967561, "o", "\u001b[?2004h"]
[346.967583, "o", "> "]
[346.967752, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[346.967863, "o", "\u001b[?2004h> "]
[346.968031, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[346.968053, "o", "\u001b[?2004h"]
[346.96814, "o", "> "]
[346.968334, "o", "    return statistics.mean(ts), min(ts)\r\n\u001b[?2004l\r"]
[346.968424, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[346.96847, "o", "> "]
[346.968615, "o", "for S in [32, 64, 128, 256]:\r\n\u001b[?2004l\r"]
[346.968663, "o", "\u001b[?2004h"]
[346.968734, "o", "> "]
[346.968966, "o", "    for BLOCK in [1024, 2048, 4096]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.969111, "o", "        for nw in [4, 8]:\r\n\u001b[?2004l\r"]
[346.96922, "o", "\u001b[?2004h> "]
[346.969488, "o", "            if (x[0].numel() // S) % BLOCK: continue\r\n\u001b[?2004l\r"]
[346.969514, "o", "\u001b[?2004h"]
[346.969634, "o", "> "]
[346.969991, "o", "            y = ln_split(x, S=S, BLOCK=BLOCK, nw1=nw, nw2=nw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.970622, "o", "            ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.970697, "o", "> "]
[346.971101, "o", "            md = (ref - y).abs().max().item()\r\n\u001b[?2004l\r"]
[346.971239, "o", "\u001b[?2004h"]
[346.971314, "o", "> "]
[346.972043, "o", "            mean, mn = time_fn(lambda: ln_split(x, S=S, BLOCK=BLOCK, nw1=nw, nw2=nw))\r\n\u001b[?2004l\r"]
[346.972204, "o", "\u001b[?2004h> "]
[346.973094, "o", "            print(f'S={S:4d} BLOCK={BLOCK:5d} nw={nw} ok={ok} maxdiff={md:.2e} mean={mean:.4f}ms min={mn:.4f}ms')\r\n\u001b[?2004l\r\u001b[?2004h"]
[346.973205, "o", "> EOF\r\n\u001b[?2004l\r"]
[346.977434, "o", "\u001b[?2004hroot@modal:/workspace# "]
[346.977774, "o", "python3 /workspace/scratch/tri.py\r\n\u001b[?2004l\r"]
