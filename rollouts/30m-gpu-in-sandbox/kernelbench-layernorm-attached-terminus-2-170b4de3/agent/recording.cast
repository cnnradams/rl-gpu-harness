[346.949421, "i", "cat > /workspace/scratch/tri.py << 'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _part(x_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    pid = tl.program_id(1)\n    base = row * N + pid * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, CHUNK, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        acc += v\n        acc2 += v * v\n    tl.store(p_ptr + row * S + pid, tl.sum(acc))\n    tl.store(p_ptr + 16 * S + row * S + pid, tl.sum(acc2))\n\n@triton.jit\ndef _norm(x_ptr, y_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, eps, BLOCK: tl.constexpr, SBLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    pid = tl.program_id(1)\n    offs = tl.arange(0, SBLOCK)\n    m1 = offs < S\n    p1 = tl.load(p_ptr + row * S + offs, mask=m1, other=0.0)\n    p2 ="]
[346.949497, "i", " tl.load(p_ptr + 16 * S + row * S + offs, mask=m1, other=0.0)\n    t1 = tl.sum(p1)\n    t2 = tl.sum(p2)\n    mean = t1 / N\n    var = t2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + pid * CHUNK\n    for off in tl.range(0, CHUNK, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        tl.store(y_ptr + idx, (v - mean) * rstd)\n\ndef ln_split(x, eps=1e-5, S=128, BLOCK=2048, nw1=8, nw2=8):\n    M = x.shape[0]\n    N = x[0].numel()\n    CHUNK = N // S\n    p = torch.empty(2 * M * S, dtype=torch.float32, device=x.device)\n    y = torch.empty_like(x)\n    _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=nw1)\n    _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=eps, BLOCK=BLOCK, SBLOCK=triton.next_power_of_2(S), num_warps=nw2)\n    return y\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\nref = F.layer_norm(x, (64, 256, 256), None, None, 1e-5)\n\n_l2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\ndef time_fn("]
[346.949677, "i", "fn, warmup=3, trials=20):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        _l2.zero_()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\nfor S in [32, 64, 128, 256]:\n    for BLOCK in [1024, 2048, 4096]:\n        for nw in [4, 8]:\n            if (x[0].numel() // S) % BLOCK: continue\n            y = ln_split(x, S=S, BLOCK=BLOCK, nw1=nw, nw2=nw)\n            ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n            md = (ref - y).abs().max().item()\n            mean, mn = time_fn(lambda: ln_split(x, S=S, BLOCK=BLOCK, nw1=nw, nw2=nw))\n            print(f'S={S:4d} BLOCK={BLOCK:5d} nw={nw} ok={ok} maxdiff={md:.2e} mean={mean:.4f}ms min={mn:.4f}ms')\nEOF\npython3 /workspace/scratch/tri.py\n"]
