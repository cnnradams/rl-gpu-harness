[1124.140171, "i", "cat > /workspace/scratch/tri6.py << 'EOF'\nimport torch, statistics\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\nref = F.layer_norm(x, (64,256,256), None, None, 1e-5)\nl2buf = torch.empty((32,1024,1024), dtype=torch.int64, device=dev)\n\ndef time_fn(fn, warmup=3, trials=30):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        l2buf.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\n@triton.jit\ndef _ln_coop(x_ptr, y_ptr, sum_ptr, ssq_ptr, cnt_ptr, N, eps,\n             SEG: tl.constexpr, BLOCK: tl.constexpr, M: tl.constexpr):\n    row = tl.program_id(0).to(tl.int64)\n    base = row * N\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n  "]
[1124.140254, "i", "  acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, N, SEG):\n        idx = base + off + tl.arange(0, BLOCK)\n        # inner loop over SEG in BLOCK steps\n        for o in tl.static_range(0, SEG, BLOCK):\n            v = tl.load(x_ptr + idx + o, eviction_policy='evict_last')\n            acc += v\n            acc2 += v * v\n    s1 = tl.sum(acc)\n    s2 = tl.sum(acc2)\n    tl.atomic_add(sum_ptr + row, s1, sem='release')\n    tl.atomic_add(ssq_ptr + row, s2, sem='release')\n    tl.atomic_add(cnt_ptr + row, 1, sem='release')\n    # spin\n    while tl.atomic_add(cnt_ptr + row, 0, sem='acquire') < M:\n        pass\n    t1 = tl.atomic_add(sum_ptr + row, 0.0, sem='acquire')\n    t2 = tl.atomic_add(ssq_ptr + row, 0.0, sem='acquire')\n    mean = t1 / N\n    var = t2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    for off in tl.range(0, N, SEG):\n        idx = base + off + tl.arange(0, BLOCK)\n        for o in tl.static_range(0, SEG, BLOCK):\n            v = tl.load(x_ptr + idx + o, eviction_policy='evict_fir"]
[1124.140292, "i", "st')\n            tl.store(y_ptr + idx + o, (v - mean) * rstd)\n\nM, N = 16, 4194304\ndef run_coop(SEG=262144, BLOCK=8192, nw=16, sums=None, cnt=None, y=None):\n    if sums is None: sums = torch.zeros(2*M, dtype=torch.float32, device=dev)\n    else: sums.zero_()\n    if cnt is None: cnt = torch.zeros(M, dtype=torch.int32, device=dev)\n    else: cnt.zero_()\n    if y is None: y = torch.empty_like(x)\n    _ln_coop[(M,)](x, y, sums, sums[M:], cnt, N, 1e-5, SEG=SEG, BLOCK=BLOCK, M=M, num_warps=nw)\n    return y, sums, cnt\n\nfor SEG, BLOCK, nw in [(131072, 4096, 8), (262144, 4096, 8), (262144, 8192, 16), (524288, 8192, 16), (1048576, 8192, 16), (262144, 2048, 4)]:\n    try:\n        y, sums, cnt = run_coop(SEG, BLOCK, nw)\n        torch.cuda.synchronize()\n        ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n        md = (ref-y).abs().max().item()\n        holder = {}\n        def fn():\n            holder['r'] = run_coop(SEG, BLOCK, nw, sums=sums, cnt=cnt, y=y)\n        mean, mn = time_fn(fn)\n        print(f'SEG={SEG:8d} BLOCK="]
[1124.140523, "i", "{BLOCK:5d} nw={nw:2d} ok={ok} maxdiff={md:.2e} mean={mean:.4f} min={mn:.4f}')\n    except Exception as e:\n        print(f'SEG={SEG} BLOCK={BLOCK} nw={nw} FAILED: {type(e).__name__} {e}')\nEOF\npython3 /workspace/scratch/tri6.py\n"]
