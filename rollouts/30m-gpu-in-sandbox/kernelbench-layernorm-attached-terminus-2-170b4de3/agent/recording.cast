[1046.341642, "i", "cat > /workspace/scratch/tri5.py << 'EOF'\nimport torch, statistics\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\nref = F.layer_norm(x, (64,256,256), None, None, 1e-5)\nl2buf = torch.empty((32,1024,1024), dtype=torch.int64, device=dev)\n\ndef time_fn(fn, warmup=3, trials=30):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        l2buf.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\n@triton.jit\ndef _part(x_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    pid = tl.program_id(1)\n    base = row.to(tl.int64) * N + pid * CHUNK\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc"]
[1046.341905, "i", "2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, CHUNK, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        acc += v\n        acc2 += v * v\n    tl.store(p_ptr + row * S + pid, tl.sum(acc))\n    tl.store(p_ptr + 16 * S + row * S + pid, tl.sum(acc2))\n\n@triton.jit\ndef _norm(x_ptr, y_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, eps, BLOCK: tl.constexpr, SBLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    pid = S - 1 - tl.program_id(1)\n    offs = tl.arange(0, SBLOCK)\n    m1 = offs < S\n    p1 = tl.load(p_ptr + row * S + offs, mask=m1, other=0.0)\n    p2 = tl.load(p_ptr + 16 * S + row * S + offs, mask=m1, other=0.0)\n    t1 = tl.sum(p1)\n    t2 = tl.sum(p2)\n    mean = t1 / N\n    var = t2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + pid * CHUNK\n    for off in tl.range(0, CHUNK, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx)\n        tl.store(y_ptr + idx, (v - mean) * rs"]
[1046.341973, "i", "td)\n\nM, N = 16, 4194304\nS, BLOCK, NW = 256, 4096, 8\nCHUNK = N // S\np = torch.empty(2*M*S, dtype=torch.float32, device=dev)\ny = torch.empty_like(x)\nSBLOCK = triton.next_power_of_2(S)\n\ndef eager():\n    _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n    _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=1e-5, BLOCK=BLOCK, SBLOCK=SBLOCK, num_warps=NW)\n    return y\n\nprint('eager 2-kernel:', time_fn(eager))\nprint('part only     :', time_fn(lambda: _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)))\nprint('norm only     :', time_fn(lambda: _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=1e-5, BLOCK=BLOCK, SBLOCK=SBLOCK, num_warps=NW)))\n\n# CUDA graph\neager(); torch.cuda.synchronize()\ng = torch.cuda.CUDAGraph()\nwith torch.cuda.graph(g):\n    _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, num_warps=NW)\n    _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=1e-5, BLOCK=BLOCK, SBLOCK=SBLOCK, num_warps=NW)\nprint('graph replay  :', time_fn(lambda: g.replay()))\ng.replay(); torch.cuda.s"]
[1046.341999, "i", "ynchronize()\nprint('graph ok:', torch.allclose(ref, y, atol=1e-4, rtol=1e-4))\nEOF\npython3 /workspace/scratch/tri5.py\n"]
