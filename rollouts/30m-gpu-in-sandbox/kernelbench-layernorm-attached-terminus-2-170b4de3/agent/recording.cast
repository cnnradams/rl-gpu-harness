[350.283374, "o", "S=  32 BLOCK= 2048 nw=4 ok=True maxdiff=3.22e-06 mean=0.2850ms min=0.2823ms\r\n"]
[350.47368, "o", "S=  32 BLOCK= 2048 nw=8 ok=True maxdiff=3.22e-06 mean=0.2977ms min=0.2844ms\r\n"]
[350.719963, "o", "S=  32 BLOCK= 4096 nw=4 ok=True maxdiff=3.22e-06 mean=0.2956ms min=0.2805ms\r\n"]
[350.920705, "o", "S=  32 BLOCK= 4096 nw=8 ok=True maxdiff=3.22e-06 mean=0.2832ms min=0.2807ms\r\n"]
[351.100291, "o", "S=  64 BLOCK= 1024 nw=4 ok=True maxdiff=3.58e-06 mean=0.2859ms min=0.2843ms\r\n"]
[351.273376, "o", "S=  64 BLOCK= 1024 nw=8 ok=True maxdiff=2.98e-06 mean=0.2851ms min=0.2829ms\r\n"]
[351.469506, "o", "S=  64 BLOCK= 2048 nw=4 ok=True maxdiff=3.22e-06 mean=0.4658ms min=0.2830ms\r\n"]
[351.645686, "o", "S=  64 BLOCK= 2048 nw=8 ok=True maxdiff=3.46e-06 mean=0.2862ms min=0.2842ms\r\n"]
[351.857458, "o", "S=  64 BLOCK= 4096 nw=4 ok=True maxdiff=2.98e-06 mean=0.2837ms min=0.2819ms\r\n"]
[352.04568, "o", "S=  64 BLOCK= 4096 nw=8 ok=True maxdiff=3.58e-06 mean=0.2834ms min=0.2823ms\r\n"]
[352.220206, "o", "S= 128 BLOCK= 1024 nw=4 ok=True maxdiff=2.98e-06 mean=0.2868ms min=0.2849ms\r\n"]
[352.40024, "o", "S= 128 BLOCK= 1024 nw=8 ok=True maxdiff=2.98e-06 mean=0.2841ms min=0.2825ms\r\n"]
[352.591154, "o", "S= 128 BLOCK= 2048 nw=4 ok=True maxdiff=2.98e-06 mean=0.2845ms min=0.2824ms\r\n"]
[352.770225, "o", "S= 128 BLOCK= 2048 nw=8 ok=True maxdiff=2.98e-06 mean=0.2839ms min=0.2829ms\r\n"]
