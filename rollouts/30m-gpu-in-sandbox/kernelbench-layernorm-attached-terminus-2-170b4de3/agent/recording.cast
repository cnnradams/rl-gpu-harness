[1124.159886, "o", "    if sums is None: sums = torch.zeros(2*M, dtype=torch.float32, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1124.160041, "o", "    else: sums.zero_()\r\n\u001b[?2004l\r"]
[1124.160067, "o", "\u001b[?2004h"]
[1124.160178, "o", "> "]
[1124.160509, "o", "    if cnt is None: cnt = torch.zeros(M, dtype=torch.int32, device=dev)\r\n\u001b[?2004l\r"]
[1124.160541, "o", "\u001b[?2004h"]
[1124.160619, "o", "> "]
[1124.160703, "o", "    else: cnt.zero_()\r\n\u001b[?2004l\r"]
[1124.160813, "o", "\u001b[?2004h> "]
[1124.161, "o", "    if y is None: y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[1124.161057, "o", "\u001b[?2004h"]
[1124.161085, "o", "> "]
[1124.16159, "o", "    _ln_coop[(M,)](x, y, sums, sums[M:], cnt, N, 1e-5, SEG=SEG, BLOCK=BLOCK, M=M, num_warps=nw)\r\n\u001b[?2004l\r"]
[1124.161651, "o", "\u001b[?2004h> "]
[1124.161906, "o", "    return y, sums, cnt\r\n\u001b[?2004l\r"]
[1124.161967, "o", "\u001b[?2004h"]
[1124.162065, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1124.162134, "o", "> "]
[1124.163269, "o", "for SEG, BLOCK, nw in [(131072, 4096, 8), (262144, 4096, 8), (262144, 8192, 16), (524288, 8192, 16), (1048576, 8192, 16), (262144, 2048, 4)]:\r\n\u001b[?2004l\r"]
[1124.163372, "o", "\u001b[?2004h> "]
[1124.163471, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1124.163541, "o", "> "]
[1124.163976, "o", "        y, sums, cnt = run_coop(SEG, BLOCK, nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1124.164052, "o", "> "]
[1124.164382, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1124.164462, "o", "> "]
[1124.164915, "o", "        ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1124.164946, "o", "\u001b[?2004h"]
[1124.16507, "o", "> "]
[1124.165385, "o", "        md = (ref-y).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1124.16545, "o", "> "]
[1124.165605, "o", "        holder = {}\r\n\u001b[?2004l\r"]
[1124.165626, "o", "\u001b[?2004h"]
[1124.165693, "o", "> "]
[1124.165852, "o", "        def fn():\r\n\u001b[?2004l\r"]
[1124.165975, "o", "\u001b[?2004h> "]
[1124.166564, "o", "            holder['r'] = run_coop(SEG, BLOCK, nw, sums=sums, cnt=cnt, y=y)\r\n\u001b[?2004l\r"]
[1124.166595, "o", "\u001b[?2004h"]
[1124.16673, "o", "> "]
[1124.166912, "o", "        mean, mn = time_fn(fn)\r\n\u001b[?2004l\r"]
[1124.166987, "o", "\u001b[?2004h> "]
[1124.167901, "o", "        print(f'SEG={SEG:8d} BLOCK={BLOCK:5d} nw={nw:2d} ok={ok} maxdiff={md:.2e} mean={mean:.4f} min={mn:.4f}')\r\n\u001b[?2004l\r"]
[1124.16793, "o", "\u001b[?2004h"]
[1124.168024, "o", "> "]
[1124.168214, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[1124.168299, "o", "\u001b[?2004h> "]
[1124.168998, "o", "        print(f'SEG={SEG} BLOCK={BLOCK} nw={nw} FAILED: {type(e).__name__} {e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1124.169032, "o", "EOF\r\n\u001b[?2004l\r"]
