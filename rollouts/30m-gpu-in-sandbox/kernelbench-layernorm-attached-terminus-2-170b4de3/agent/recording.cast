[353.208138, "o", "S= 128 BLOCK= 4096 nw=8 ok=True maxdiff=2.98e-06 mean=0.2810ms min=0.2796ms\r\n"]
[353.393179, "o", "S= 256 BLOCK= 1024 nw=4 ok=True maxdiff=2.98e-06 mean=0.2831ms min=0.2817ms\r\n"]
[353.615896, "o", "S= 256 BLOCK= 1024 nw=8 ok=True maxdiff=3.10e-06 mean=0.2809ms min=0.2792ms\r\n"]
[353.838019, "o", "S= 256 BLOCK= 2048 nw=4 ok=True maxdiff=2.98e-06 mean=0.3059ms min=0.2794ms\r\n"]
[354.0553, "o", "S= 256 BLOCK= 2048 nw=8 ok=True maxdiff=2.98e-06 mean=0.2808ms min=0.2794ms\r\n"]
[354.263159, "o", "S= 256 BLOCK= 4096 nw=4 ok=True maxdiff=2.98e-06 mean=0.2799ms min=0.2778ms\r\n"]
