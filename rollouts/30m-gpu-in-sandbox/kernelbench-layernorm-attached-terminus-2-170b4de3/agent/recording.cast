[354.896095, "o", "\u001b[?2004hroot@modal:/workspace# "]
[413.569282, "i", "cat > /workspace/scratch/floor.py << 'EOF'\nimport torch, statistics\nimport triton\nimport triton.language as tl\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\n_l2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\n\ndef time_fn(fn, warmup=3, trials=20):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        _l2.zero_()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\ny = torch.empty_like(x)\nprint('clone :', time_fn(lambda: y.copy_(x)))\nprint('add0  :', time_fn(lambda: torch.add(x, 0.0, out=y)))\n\n# launch overhead: tiny kernel\nz = torch.zeros(8, device=dev)\nprint('tiny  :', time_fn(lambda: z.add_(1)))\n\n# two tiny kernels\nprint('tiny2 :', time_fn(lambda: (z.add_(1), z.add_(2))))\nEOF\npython3 /workspace/"]
[413.569439, "i", "scratch/floor.py\n"]
