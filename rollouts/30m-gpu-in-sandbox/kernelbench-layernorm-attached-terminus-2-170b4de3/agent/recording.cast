[252.742833, "i", "mkdir -p /workspace/scratch && cat > /workspace/scratch/bench.py << 'EOF'\nimport torch, statistics, sys\nimport torch.nn as nn\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\n\ndev = torch.device('cuda')\nm = Model(*get_init_inputs()[0]).to(dev)\nx = get_inputs()[0].to(dev)\nprint('input', x.shape, x.dtype, x.is_contiguous())\n\n_l2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\n\ndef time_fn(fn, args, warmup=3, trials=20):\n    for _ in range(warmup):\n        fn(*args); torch.cuda.synchronize()\n    times=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        _l2.zero_()\n        s.record(); fn(*args); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    return statistics.mean(times), min(times)\n\nmean, mn = time_fn(m, [x])\nprint(f'reference LayerNorm: mean {mean:.4f} ms  min {mn:.4f} ms')\n\n# check what reshape looks like\nxv "]
[252.743042, "i", "= x.view(16, -1)\nprint('rows', xv.shape)\nEOF\npython3 /workspace/scratch/bench.py\n"]
