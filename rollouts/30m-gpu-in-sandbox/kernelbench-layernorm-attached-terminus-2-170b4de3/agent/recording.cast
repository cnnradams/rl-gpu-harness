[516.503458, "i", "cat > /workspace/scratch/tri2.py << 'EOF'\nimport torch, statistics\nimport triton\nimport triton.language as tl\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\n_l2 = torch.empty(256*1024*1024//4, dtype=torch.float32, device=dev)\n\ndef time_fn(fn, warmup=3, trials=30):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        _l2.zero_()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\n@triton.jit\ndef _copy(x_ptr, y_ptr, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    idx = pid * BLOCK + tl.arange(0, BLOCK)\n    tl.store(y_ptr + idx, tl.load(x_ptr + idx))\n\ndef tri_copy(BLOCK=4096, nw=8):\n    y = torch.empty_like(x)\n    N = x.numel()\n    _copy[(N//BLOCK,)](x, y, N, BLOCK=BLOCK, num_warps=nw)\n    return y\n\nfor BLOC"]
[516.503699, "i", "K in [2048, 4096, 8192]:\n    for nw in [4, 8, 16]:\n        print(f'copy BLOCK={BLOCK} nw={nw}:', time_fn(lambda: tri_copy(BLOCK, nw)))\nEOF\npython3 /workspace/scratch/tri2.py\n"]
