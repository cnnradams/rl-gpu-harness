[922.485082, "i", "cat > /workspace/scratch/tri4.py << 'EOF'\nimport torch, statistics\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\ndev = torch.device('cuda')\nx = torch.rand(16, 64, 256, 256, device=dev)\nref = F.layer_norm(x, (64,256,256), None, None, 1e-5)\nl2buf = torch.empty((32,1024,1024), dtype=torch.int64, device=dev)\n\ndef time_fn(fn, warmup=3, trials=30):\n    for _ in range(warmup):\n        fn(); torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        l2buf.fill_(42)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts), min(ts)\n\n@triton.jit\ndef _part(x_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0)\n    pid = tl.program_id(1)\n    base = row.to(tl.int64) * N + pid * CHUNK\n    acc = tl.zeros([BLOCK], dtype=t"]
[922.485309, "i", "l.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in tl.range(0, CHUNK, BLOCK):\n        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx, eviction_policy=EV)\n        acc += v\n        acc2 += v * v\n    tl.store(p_ptr + row * S + pid, tl.sum(acc))\n    tl.store(p_ptr + 16 * S + row * S + pid, tl.sum(acc2))\n\n@triton.jit\ndef _norm(x_ptr, y_ptr, p_ptr, N, S: tl.constexpr, CHUNK: tl.constexpr, eps, BLOCK: tl.constexpr, SBLOCK: tl.constexpr, REV: tl.constexpr, EVL: tl.constexpr, EVS: tl.constexpr):\n    row = tl.program_id(0)\n    pid = tl.program_id(1)\n    if REV:\n        pid = S - 1 - pid\n    offs = tl.arange(0, SBLOCK)\n    m1 = offs < S\n    p1 = tl.load(p_ptr + row * S + offs, mask=m1, other=0.0)\n    p2 = tl.load(p_ptr + 16 * S + row * S + offs, mask=m1, other=0.0)\n    t1 = tl.sum(p1)\n    t2 = tl.sum(p2)\n    mean = t1 / N\n    var = t2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + pid * CHUNK\n    for off in tl.range(0, CHUNK, BLOCK):\n"]
[922.485387, "i", "        idx = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + idx, eviction_policy=EVL)\n        tl.store(y_ptr + idx, (v - mean) * rstd, eviction_policy=EVS)\n\nM, N = 16, 4194304\ndef run(S, BLOCK, nw1, nw2, rev=False, ev='', evl='', evs='', y=None, p=None):\n    CHUNK = N // S\n    if p is None: p = torch.empty(2*M*S, dtype=torch.float32, device=dev)\n    if y is None: y = torch.empty_like(x)\n    _part[(M, S)](x, p, N, S=S, CHUNK=CHUNK, BLOCK=BLOCK, EV=ev, num_warps=nw1)\n    _norm[(M, S)](x, y, p, N, S=S, CHUNK=CHUNK, eps=1e-5, BLOCK=BLOCK, SBLOCK=triton.next_power_of_2(S), REV=rev, EVL=evl, EVS=evs, num_warps=nw2)\n    return y\n\ncfgs = [\n    dict(S=128, BLOCK=4096, nw1=8, nw2=8),\n    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True),\n    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True, evl='evict_first'),\n    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True, ev='evict_last'),\n    dict(S=128, BLOCK=4096, nw1=8, nw2=8, rev=True, ev='evict_last', evl='evict_first'),\n    dict(S=256, BLOCK=4096, nw1=8, nw2=8, "]
[922.485495, "i", "rev=True),\n    dict(S=64, BLOCK=4096, nw1=8, nw2=8, rev=True),\n    dict(S=128, BLOCK=8192, nw1=16, nw2=16, rev=True),\n    dict(S=128, BLOCK=2048, nw1=4, nw2=4, rev=True),\n    dict(S=32, BLOCK=8192, nw1=8, nw2=8, rev=True),\n]\nfor c in cfgs:\n    y = run(**c)\n    ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)\n    mean, mn = time_fn(lambda: run(**c))\n    print(f'{str(c):90s} ok={ok} mean={mean:.4f} min={mn:.4f}')\nEOF\npython3 /workspace/scratch/tri4.py\n"]
