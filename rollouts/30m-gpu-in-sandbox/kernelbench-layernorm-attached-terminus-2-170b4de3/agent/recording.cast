[756.091957, "o", "\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef clear_l2_cache\u001b[m\u001b[K(device: torch.device | str = \"cuda\"):\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Clear L2 Cache line by thrashing with a large tensor\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Acknowledge GPU mode reference kernel repo:\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    https://github.com/gpu-mode/reference-kernels/commit/7c15075a39286e88939d99d3f3a60be88b8e6223#diff-3a30a71cbf8db2badd224f4d92f9a2546925a5b522632a31d353526b7a5f3338R158-R163\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packag"]
[756.092168, "o", "es/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # don't reserve space for persisting lines\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # cp.cuda.runtime.cudaDeviceSetLimit(cp.cuda.runtime.cudaLimitPersistingL2CacheSize, 0)\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Thrash L2 cache by creating a larger dummy tensor, effectively flushing the cache\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # 32 * 1024 * 1024 * 8B = 256MB \r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernel"]
[756.092305, "o", "bench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # NOTE: we can make this more adaptive based on device\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # L2 cache sizes: A100=40MB, H100=50MB, H200=90MB, RTX4090=72MB, L40S=48MB, Blackwell≈192MB → overwrite >200MB to fully thrash L2\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # write to tensor with inplace fill\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    dummy.fill_(42) \r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    del"]
[756.092348, "o", " dummy\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef clear_l2_cache\u001b[m\u001b[K_triton(cache=None, device: str = \"cuda\"):\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Thrash the cache by making a large dummy tensor, using triton runtime's functionality\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    from triton import runtime as triton_runtime\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packa"]
[756.092406, "o", "ges/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    with torch.cuda.device(device):\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        cache = triton_runtime.driver.active.get_empty_cache_for_benchmark()\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # this effectively thrashes L2 cache under the hood too\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        triton_runtime.driver.active.clear_cache(cache)\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m"]
[756.092426, "o", "\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kdef get_timing_function(\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    method: str = \"cuda_event\", # by default \r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K) -> callable:\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Get timing function by method name.\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Available methods:\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K16"]
[756.092523, "o", "2\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        - \"cuda_event\": torch.cuda.event timing (default, explicit trial control)\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        - \"do_bench\": Use triton's do_bench (adaptive trial count based on time budget)\r\n\u001b[35m\u001b[K/usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        - \"do_bench_impl\": Mirrors Triton's do_bench implementation (explicit control)\r\n"]
[756.09319, "o", "\u001b[?2004hroot@modal:/workspace# "]
[756.582498, "i", "cat > /workspace/scratch/bw.py << 'EOF'\nimport torch, statistics\ndev='cuda'\ndef timeit(fn, trials=20, clear=False, l2=None):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        if clear: l2.zero_()\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return statistics.mean(ts)\n\nfor mb in [128, 256, 512, 1024]:\n    n = mb*1024*1024//8\n    a = torch.rand(n, device=dev); b = torch.empty_like(a)\n    t = timeit(lambda: b.copy_(a))\n    print(f'{mb}MB buffer copy: {t:.4f} ms -> {2*mb/1024/ (t/1000):.2f} GB/s eff {mb*2/t:.1f}')\nEOF\npython3 /workspace/scratch/bw.py\n"]
[756.582837, "o", "cat > /workspace/scratch/bw.py << 'EOF'\r\n\u001b[?2004l\r"]
