def build_compile_cache_with_capturing(
[?2004hroot@modal:/workspace# cat /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py
[?2004limport torch
import json
import numpy as np
import time
from typing import Any, Optional, Union
