[?2004l[?2004h> import torch, statistics
[?2004l[?2004h> import torch.nn.functional as F
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> dev = torch.device('cuda')
[?2004l[?2004h> x = torch.rand(16, 64, 256, 256, device=dev)
[?2004l[?2004h> ref = F.layer_norm(x, (64,256,256), None, None, 1e-5)
[?2004l[?2004h> l2buf = torch.empty((32,1024,1024), dtype=torch.int64, device=dev)
[?2004l[?2004h> 
[?2004l[?2004h> def time_fn(fn, warmup=3, trials=30):
[?2004l[?2004h>     for _ in range(warmup):
[?2004l[?2004h>         fn(); torch.cuda.synchronize()
[?2004l[?2004h>     ts=[]
[?2004l[?2004h>     for _ in range(trials):
[?2004l[?2004h>         torch.cuda.synchronize()
[?2004l[?2004h>         s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)
[?2004l[?2004h>         l2buf.fill_(42)
[?2004l[?2004h>         s.record(); fn(); e.record()
[?2004l[?2004h>         torch.cuda.synchronize()
[?2004l[?2004h>         ts.append(s.elapsed_time(e))
[?2004l[?2004h>     return statistics.mean(ts), min(ts)
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_coop(x_ptr, y_ptr, sum_ptr, ssq_ptr, cnt_ptr, N, eps,
[?2004l[?2004h>              SEG: tl.constexpr, BLOCK: tl.constexpr, M: tl.constexpr):
[?2004l[?2004h>     row = tl.program_id(0).to(tl.int64)
[?2004l[?2004h>     base = row * N
[?2004l[?2004h>     acc = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     for off in tl.range(0, N, SEG):
[?2004l[?2004h>         idx = base + off + tl.arange(0, BLOCK)
[?2004l[?2004h>         # inner loop over SEG in BLOCK steps
[?2004l[?2004h>         for o in tl.static_range(0, SEG, BLOCK):
[?2004l[?2004h>             v = tl.load(x_ptr + idx + o, eviction_policy='evict_last')
[?2004l[?2004h>             acc += v
[?2004l[?2004h>             acc2 += v * v
[?2004l[?2004h>     s1 = tl.sum(acc)
[?2004l[?2004h>     s2 = tl.sum(acc2)
[?2004l[?2004h>     tl.atomic_add(sum_ptr + row, s1, sem='release')
[?2004l[?2004h>     tl.atomic_add(ssq_ptr + row, s2, sem='release')
[?2004l[?2004h>     tl.atomic_add(cnt_ptr + row, 1, sem='release')
[?2004l[?2004h>     # spin
[?2004l[?2004h>     while tl.atomic_add(cnt_ptr + row, 0, sem='acquire') < M:
[?2004l[?2004h>         pass
[?2004l[?2004h>     t1 = tl.atomic_add(sum_ptr + row, 0.0, sem='acquire')
[?2004l[?2004h>     t2 = tl.atomic_add(ssq_ptr + row, 0.0, sem='acquire')
[?2004l[?2004h>     mean = t1 / N
[?2004l[?2004h>     var = t2 / N - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     for off in tl.range(0, N, SEG):
[?2004l[?2004h>         idx = base + off + tl.arange(0, BLOCK)
[?2004l[?2004h>         for o in tl.static_range(0, SEG, BLOCK):
[?2004l[?2004h>             v = tl.load(x_ptr + idx + o, eviction_policy='evict_first')
[?2004l[?2004h>             tl.store(y_ptr + idx + o, (v - mean) * rstd)
[?2004l[?2004h> 
[?2004l[?2004h> M, N = 16, 4194304
[?2004l[?2004h> def run_coop(SEG=262144, BLOCK=8192, nw=16, sums=None, cnt=None, y=None):
[?2004l[?2004h>     if sums is None: sums = torch.zeros(2*M, dtype=torch.float32, device=dev)
[?2004l[?2004h>     else: sums.zero_()
[?2004l[?2004h>     if cnt is None: cnt = torch.zeros(M, dtype=torch.int32, device=dev)
[?2004l[?2004h>     else: cnt.zero_()
[?2004l[?2004h>     if y is None: y = torch.empty_like(x)
[?2004l[?2004h>     _ln_coop[(M,)](x, y, sums, sums[M:], cnt, N, 1e-5, SEG=SEG, BLOCK=BLOCK, M=M, num_warps=nw)
[?2004l[?2004h>     return y, sums, cnt
[?2004l[?2004h> 
[?2004l[?2004h> for SEG, BLOCK, nw in [(131072, 4096, 8), (262144, 4096, 8), (262144, 8192, 16), (524288, 8192, 16), (1048576, 8192, 16), (262144, 2048, 4)]:
[?2004l[?2004h>     try:
[?2004l[?2004h>         y, sums, cnt = run_coop(SEG, BLOCK, nw)
[?2004l[?2004h>         torch.cuda.synchronize()
[?2004l[?2004h>         ok = torch.allclose(ref, y, atol=1e-4, rtol=1e-4)
[?2004l[?2004h>         md = (ref-y).abs().max().item()
[?2004l[?2004h>         holder = {}
[?2004l[?2004h>         def fn():
[?2004l[?2004h>             holder['r'] = run_coop(SEG, BLOCK, nw, sums=sums, cnt=cnt, y=y)
[?2004l[?2004h>         mean, mn = time_fn(fn)
[?2004l[?2004h>         print(f'SEG={SEG:8d} BLOCK={BLOCK:5d} nw={nw:2d} ok={ok} maxdiff={md:.2e} mean={mean:.4f} min={mn:.4f}')
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'SEG={SEG} BLOCK={BLOCK} nw={nw} FAILED: {type(e).__name__} {e}')
