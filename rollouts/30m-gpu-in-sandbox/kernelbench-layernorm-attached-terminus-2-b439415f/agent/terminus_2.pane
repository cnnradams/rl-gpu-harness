[?2004l[?2004h> def stats_v2(x_ptr, part_ptr, N, B: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr, EV: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
