[?2004l[?2004h> def apply_v2(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, eps,
[?2004l[?2004h>              B: tl.constexpr, BLOCK: tl.constexpr, SWAP: tl.constexpr):
