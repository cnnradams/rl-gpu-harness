[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_stats(x_ptr, part_ptr, N, R,
[?2004l[?2004h>               B: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     row = tl.program_id(1)
[?2004l[?2004h>     base = row * N + pid * (BLOCK * ITERS)
[?2004l[?2004h>     offs = tl.arange(0, BLOCK)
[?2004l[?2004h>     acc1 = tl.zeros((BLOCK,), dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros((BLOCK,), dtype=tl.float32)
[?2004l[?2004h>     for i in tl.static_range(ITERS):
[?2004l[?2004h>         x = tl.load(x_ptr + base + i * BLOCK + offs, eviction_policy='evict_first')
[?2004l[?2004h>         acc1 += x
[?2004l[?2004h>         acc2 += x * x
[?2004l[?2004h>     s1 = tl.sum(acc1, axis=0)
[?2004l[?2004h>     s2 = tl.sum(acc2, axis=0)
[?2004l[?2004h>     tl.store(part_ptr + row * B + pid, s1)
[?2004l[?2004h>     tl.store(part_ptr + R * B + row * B + pid, s2)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, R, eps,
[?2004l[?2004h>               B: tl.constexpr, BLOCK: tl.constexpr):
[?2004l[?2004h>     # grid = (R, N // BLOCK): consecutive blocks share the same w/b tile
[?2004l[?2004h>     row = tl.program_id(0)
[?2004l[?2004h>     pid = tl.program_id(1)
[?2004l[?2004h>     bidx = tl.arange(0, B)
[?2004l[?2004h>     s1 = tl.sum(tl.load(part_ptr + row * B + bidx), axis=0)
[?2004l[?2004h>     s2 = tl.sum(tl.load(part_ptr + R * B + row * B + bidx), axis=0)
[?2004l[?2004h>     mean = s1 / N
[?2004l[?2004h>     var = s2 / N - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     offs = row * N + pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     woffs = pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     x = tl.load(x_ptr + offs, eviction_policy='evict_first')
[?2004l[?2004h>     w = tl.load(w_ptr + woffs, eviction_policy='evict_last')
[?2004l[?2004h>     bb = tl.load(b_ptr + woffs, eviction_policy='evict_last')
[?2004l[?2004h>     y = (x - mean) * rstd * w + bb
[?2004l[?2004h>     tl.store(y_ptr + offs, y, eviction_policy='evict_first')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, normalized_shape):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.normalized_shape = tuple(normalized_shape)
[?2004l[?2004h>         self.weight = nn.Parameter(torch.ones(self.normalized_shape))
[?2004l[?2004h>         self.bias = nn.Parameter(torch.zeros(self.normalized_shape))
[?2004l[?2004h>         self.eps = 1e-5
[?2004l[?2004h>         N = 1
[?2004l[?2004h>         for s in self.normalized_shape:
[?2004l[?2004h>             N *= s
[?2004l[?2004h>         self.N = N
[?2004l[?2004h>         self.B = 128
[?2004l[?2004h>         self.SBLOCK = 4096
[?2004l[?2004h>         self.ITERS = max(1, N // (self.B * self.SBLOCK))
[?2004l[?2004h>         self.ABLOCK = 4096
[?2004l[?2004h>         self._ok = (self.B * self.SBLOCK * self.ITERS == N and N % self.ABLOCK == 0)
[?2004l[?2004h>         self._part = None
[?2004l[?2004h>         self._y = None
[?2004l[?2004h>         self._R = -1
[?2004l[?2004h>         self._graph = None
[?2004l[?2004h>         self._graph_key = None
[?2004l[?2004h> 
[?2004l[?2004h>     def _launch(self, x):
[?2004l[?2004h>         N = self.N
[?2004l[?2004h>         R = self._R
[?2004l[?2004h>         _ln_stats[(self.B, R)](x, self._part, N, R, B=self.B, BLOCK=self.SBLOCK,
[?2004l[?2004h>                                ITERS=self.ITERS, num_warps=16)
[?2004l[?2004h>         _ln_apply[(R, N // self.ABLOCK)](x, self._y, self.weight, self.bias,
[?2004l[?2004h>                                          self._part, N, R, self.eps,
[?2004l[?2004h>                                          B=self.B, BLOCK=self.ABLOCK, num_warps=1)
[?2004l[?2004h> 
[?2004l[?2004h>     def _prepare(self, x, R):
[?2004l[?2004h>         if self._R != R or self._part is None or self._part.device != x.device:
[?2004l[?2004h>             self._part = torch.empty((2, R, self.B), dtype=torch.float32, device=x.device)
[?2004l[?2004h>             self._y = torch.empty_like(x)
[?2004l[?2004h>             self._R = R
[?2004l[?2004h>             self._graph = None
[?2004l[?2004h>             self._graph_key = None
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         if (not self._ok or x.dtype != torch.float32 or not x.is_contiguous()
[?2004l[?2004h>                 or x.requires_grad or not x.is_cuda):
[?2004l[?2004h>             return torch.nn.functional.layer_norm(
[?2004l[?2004h>                 x, self.normalized_shape, self.weight, self.bias, self.eps)
[?2004l[?2004h>         R = x.numel() // self.N
[?2004l[?2004h>         self._prepare(x, R)
[?2004l[?2004h>         key = (x.data_ptr(), self.weight.data_ptr(), self.bias.data_ptr())
[?2004l[?2004h>         if self._graph is None or self._graph_key != key:
[?2004l[?2004h>             self._launch(x)
[?2004l[?2004h>             torch.cuda.synchronize()
[?2004l[?2004h>             g = torch.cuda.CUDAGraph()
[?2004l[?2004h>             with torch.cuda.graph(g):
[?2004l[?2004h>                 self._launch(x)
[?2004l[?2004h>             self._graph = g
[?2004l[?2004h>             self._graph_key = key
