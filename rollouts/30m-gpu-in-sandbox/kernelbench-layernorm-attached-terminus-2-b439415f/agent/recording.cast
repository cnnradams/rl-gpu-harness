[623.074858, "i", "cat > /workspace/tune3.py << 'EOF'\nimport sys, itertools, torch, numpy as np\nsys.path.insert(0, '/workspace')\nfrom bench import bench\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(42)\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64*256*256\nR = 16\nw = torch.ones((64,256,256), device='cuda')\nb = torch.zeros((64,256,256), device='cuda')\ny = torch.empty_like(x)\neps = 1e-5\n\n@triton.jit\ndef stats_v2(x_ptr, part_ptr, N, B: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row * N + pid * (BLOCK * ITERS)\n    offs = tl.arange(0, BLOCK)\n    acc1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for i in tl.static_range(ITERS):\n        x = tl.load(x_ptr + base + i * BLOCK + offs, eviction_policy=EV)\n        acc1 += x\n        acc2 += x * x\n    s1 = tl.sum(acc1, axis=0)\n    s2 = tl.sum(acc2, axis=0)\n    R = tl.num_programs(1)\n    tl.store(part_ptr + "]
[623.074943, "i", "row * B + pid, s1)\n    tl.store(part_ptr + R * B + row * B + pid, s2)\n\nfor B in [64, 128]:\n    part = torch.empty((2, R, B), dtype=torch.float32, device='cuda')\n    for SBLOCK, ITERS, warps in [(4096, 8, 16), (4096, 8, 32), (2048, 16, 32), (8192, 4, 32), (1024, 32, 16), (512, 64, 8), (4096, 8, 8)]:\n        if SBLOCK*ITERS*B != N: continue\n        for EV in ['', 'evict_first']:\n            try:\n                fn = lambda a: stats_v2[(B, R)](a, part, N, B=B, BLOCK=SBLOCK, ITERS=ITERS, EV=EV, num_warps=warps)\n                m, mn, mx = bench(fn, [x], num_trials=10)\n                print(f\"B={B} SBLOCK={SBLOCK} ITERS={ITERS} warps={warps} EV='{EV}': mean={m:.4f} min={mn:.4f}\")\n            except Exception as ex:\n                print(f\"B={B} SBLOCK={SBLOCK} ITERS={ITERS} warps={warps} EV='{EV}': FAIL {str(ex)[:60]}\")\nEOF\npython3 /workspace/tune3.py 2>&1 | tail -25\n"]
