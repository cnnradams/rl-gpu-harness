[64.973114, "o", "31m\u001b[Kdef \u001b[m\u001b[K_cleanup_cuda_extensions():\r\n\u001b[32m\u001b[K222\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kgraceful_eval_cleanup(\r\n\u001b[32m\u001b[K248\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_compile_cache_legacy(\r\n\u001b[32m\u001b[K289\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_compile_cache(\r\n\u001b[32m\u001b[K330\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kbuild_compile_cache_with_capturing(\r\n"]
[64.973207, "o", "\u001b[32m\u001b[K370\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[K_process_input_tensor(input, device, backend=\"cuda\", precision=torch.float32):\r\n\u001b[32m\u001b[K394\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Keval_kernel_against_ref(\r\n\u001b[32m\u001b[K702\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kregister_and_format_exception(\r\n\u001b[32m\u001b[K727\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Krun_and_check_correctness(\r\n\u001b[32m\u001b[K851\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcheck_metadata_serializable(metadata: dict):\r\n\u001b[32m\u001b[K880\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kcheck_metadata_serializable_all_types(metadata: dict):\r\n\u001b[32m\u001b[K886\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K    \u001b[01;31m\u001b[Kdef \u001b[m\u001b[Kconvert_to_serializable(obj):\r\n"]
