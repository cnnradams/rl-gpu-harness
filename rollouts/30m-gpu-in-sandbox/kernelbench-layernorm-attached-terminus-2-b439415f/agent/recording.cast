[307.545133, "i", "cat > /workspace/tune.py << 'EOF'\nimport sys, itertools, torch, numpy as np\nsys.path.insert(0, '/workspace')\nfrom bench import bench\nimport triton\nfrom solution import _ln_stats, _ln_apply\n\ntorch.manual_seed(42)\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64*256*256\nR = 16\nB = 128\nw = torch.ones((64,256,256), device='cuda')\nb = torch.zeros((64,256,256), device='cuda')\npart = torch.empty((2, R, B), dtype=torch.float32, device='cuda')\ny = torch.empty_like(x)\neps = 1e-5\n\nprint('--- stats kernel ---')\nfor SBLOCK, ITERS, warps in itertools.product([2048, 4096, 8192, 16384], [1,2,4,8,16], [4,8,16]):\n    if SBLOCK*ITERS*B != N: continue\n    if SBLOCK*ITERS < 4096: continue\n    try:\n        fn = lambda a: _ln_stats[(B, R)](a, part, N, B=B, BLOCK=SBLOCK, ITERS=ITERS, num_warps=warps)\n        m, mn, mx = bench(fn, [x], num_trials=10)\n        print(f\"SBLOCK={SBLOCK} ITERS={ITERS} warps={warps}: mean={m:.4f} min={mn:.4f}\")\n    except Exception as ex:\n        print(f\"SBLOCK={SBLOCK} ITERS={ITE"]
[307.545388, "i", "RS} warps={warps}: FAIL {ex}\")\nEOF\npython3 /workspace/tune.py 2>&1 | tail -40\n"]
