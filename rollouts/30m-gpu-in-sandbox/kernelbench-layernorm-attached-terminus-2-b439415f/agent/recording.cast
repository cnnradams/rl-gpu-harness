[212.328657, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch, time\nsys.path.insert(0, '/workspace')\n\ndef clear_l2(device='cuda'):\n    dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\n    dummy.fill_(42)\n    del dummy\n\ndef bench(fn, args, num_warmup=3, num_trials=20, discard_first=1):\n    device = 'cuda'\n    with torch.cuda.device(device):\n        for _ in range(num_warmup):\n            fn(*args)\n            torch.cuda.synchronize()\n        torch.cuda.empty_cache()\n        times = []\n        for t in range(num_trials + discard_first):\n            torch.cuda.synchronize()\n            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n            clear_l2(device)\n            s.record()\n            fn(*args)\n            e.record()\n            torch.cuda.synchronize()\n            if t >= discard_first:\n                times.append(s.elapsed_time(e))\n    import numpy as np\n    return np.mean(times), np.min(times), np.max(times)\n\ntorch.manual_seed(42)\nx = torch.rand(16,"]
[212.328761, "i", " 64, 256, 256, device='cuda', dtype=torch.float32)\n\nimport torch.nn as nn\nref = nn.LayerNorm((64, 256, 256)).cuda()\nwith torch.no_grad():\n    m, mn, mx = bench(lambda a: ref(a), [x])\nprint(f\"torch eager LN: mean={m:.4f} ms min={mn:.4f} max={mx:.4f}\")\n\nfrom solution import ModelNew\nsol = ModelNew((64, 256, 256)).cuda()\nwith torch.no_grad():\n    out_ref = ref(x)\n    out_new = sol(x)\n    print('max diff:', (out_ref - out_new).abs().max().item())\n    m, mn, mx = bench(lambda a: sol(a), [x])\nprint(f\"triton LN:      mean={m:.4f} ms min={mn:.4f} max={mx:.4f}\")\nEOF\npython3 /workspace/bench.py\n"]
