[483.861557, "o", "        self._prepare(x, R)\r\n\u001b[?2004l\r"]
[483.861708, "o", "\u001b[?2004h> "]
[483.862166, "o", "        key = (x.data_ptr(), self.weight.data_ptr(), self.bias.data_ptr())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.86253, "o", "        if self._graph is None or self._graph_key != key:\r\n\u001b[?2004l\r"]
[483.862569, "o", "\u001b[?2004h"]
[483.862584, "o", "> "]
[483.862936, "o", "            # warmup (compiles kernels) then capture\r\n\u001b[?2004l\r"]
[483.862963, "o", "\u001b[?2004h"]
[483.863043, "o", "> "]
[483.863215, "o", "            self._launch(x)\r\n\u001b[?2004l\r"]
[483.863242, "o", "\u001b[?2004h"]
[483.863335, "o", "> "]
[483.863558, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[483.863587, "o", "\u001b[?2004h"]
[483.863723, "o", "> "]
[483.86389, "o", "            g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r"]
[483.86404, "o", "\u001b[?2004h> "]
[483.864222, "o", "            with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[483.864251, "o", "\u001b[?2004h"]
[483.864341, "o", "> "]
[483.864548, "o", "                self._launch(x)\r\n\u001b[?2004l\r"]
[483.864577, "o", "\u001b[?2004h"]
[483.864679, "o", "> "]
[483.86482, "o", "            self._graph = g\r\n\u001b[?2004l\r"]
[483.864852, "o", "\u001b[?2004h"]
[483.864938, "o", "> "]
[483.86521, "o", "            self._graph_key = key\r\n\u001b[?2004l\r"]
[483.865345, "o", "\u001b[?2004h> "]
[483.865541, "o", "        self._graph.replay()\r\n\u001b[?2004l\r"]
[483.865655, "o", "\u001b[?2004h> "]
[483.865845, "o", "        return self._y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.865915, "o", "EOF\r\n\u001b[?2004l\r"]
[483.872049, "o", "\u001b[?2004hroot@modal:/workspace# "]
[483.872391, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.872688, "o", "import sys, torch, numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.872764, "o", "> "]
[483.872966, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r"]
[483.873083, "o", "\u001b[?2004h> "]
[483.873292, "o", "from bench import bench\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.873546, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[483.873584, "o", "\u001b[?2004h"]
[483.873689, "o", "> "]
[483.873825, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[483.87386, "o", "\u001b[?2004h"]
[483.873873, "o", "> "]
[483.874444, "o", "x = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.874763, "o", "ref = nn.LayerNorm((64, 256, 256)).cuda()\r\n\u001b[?2004l\r"]
[483.874807, "o", "\u001b[?2004h> "]
[483.875045, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[483.875115, "o", "\u001b[?2004h> "]
[483.875453, "o", "sol = ModelNew((64, 256, 256)).cuda()\r\n\u001b[?2004l\r"]
[483.875561, "o", "\u001b[?2004h> "]
[483.87569, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[483.875762, "o", "\u001b[?2004h> "]
[483.875941, "o", "    out_ref = ref(x)\r\n\u001b[?2004l\r"]
[483.876042, "o", "\u001b[?2004h> "]
[483.876265, "o", "    out_new = sol(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.876786, "o", "    print('max diff:', (out_ref - out_new).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.877158, "o", "    # second call returns new values for new input\r\n\u001b[?2004l\r"]
[483.877189, "o", "\u001b[?2004h"]
[483.877305, "o", "> "]
[483.877661, "o", "    x2 = torch.rand(16, 64, 256, 256, device='cuda')\r\n\u001b[?2004l\r"]
[483.877702, "o", "\u001b[?2004h"]
[483.877715, "o", "> "]
[483.877919, "o", "    out2 = sol(x2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[483.877954, "o", "> "]
[483.878451, "o", "    print('max diff2:', (ref(x2) - out2).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[483.87878, "o", "    m, mn, mx = bench(lambda a: sol(a), [x])\r\n\u001b[?2004l\r"]
[483.878814, "o", "\u001b[?2004h"]
[483.878921, "o", "> "]
[483.879331, "o", "print(f\"triton graph LN: mean={m:.4f} min={mn:.4f} max={mx:.4f}\")\r\n\u001b[?2004l\r"]
[483.879423, "o", "\u001b[?2004h> "]
[483.879504, "o", "EOF\r\n\u001b[?2004l\r"]
[483.883018, "o", "\u001b[?2004h"]
[483.883107, "o", "root@modal:/workspace# "]
[483.883472, "o", "python3 /workspace/bench2.py 2>&1 | tail -5\r\n\u001b[?2004l\r"]
[486.973124, "o", "max diff: 3.4570693969726562e-06\r\ntriton LN:      mean=0.4450 ms min=0.4440 max=0.4460\r\nmax diff: 3.4570693969726562e-06\r\nmax diff2: 2.86102294921875e-06\r\ntriton graph LN: mean=0.4453 min=0.4440 max=0.4467\r\n"]
