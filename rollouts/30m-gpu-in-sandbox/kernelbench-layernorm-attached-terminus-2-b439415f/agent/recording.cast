[376.639639, "i", "cat > /workspace/tune2.py << 'EOF'\nimport sys, itertools, torch, numpy as np\nsys.path.insert(0, '/workspace')\nfrom bench import bench\nimport triton\nfrom solution import _ln_apply\n\ntorch.manual_seed(42)\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64*256*256\nR = 16\nB = 128\nw = torch.ones((64,256,256), device='cuda')\nb = torch.zeros((64,256,256), device='cuda')\npart = torch.zeros((2, R, B), dtype=torch.float32, device='cuda')\ny = torch.empty_like(x)\neps = 1e-5\n\nm, mn, mx = bench(lambda a: y.copy_(a), [x], num_trials=10)\nprint(f\"copy 512MB: mean={m:.4f} min={mn:.4f}\")\n\nprint('--- apply kernel ---')\nfor ABLOCK, warps in itertools.product([1024, 2048, 4096, 8192, 16384], [1,2,4,8]):\n    if N % ABLOCK: continue\n    if ABLOCK//(warps*32) < 4: continue\n    try:\n        fn = lambda a: _ln_apply[(N//ABLOCK, R)](a, y, w, b, part, N, eps, B=B, BLOCK=ABLOCK, num_warps=warps)\n        m, mn, mx = bench(fn, [x], num_trials=10)\n        print(f\"ABLOCK={ABLOCK} warps={warps}: mean={m:.4f} min={mn:.4f"]
[376.639923, "i", "}\")\n    except Exception as ex:\n        print(f\"ABLOCK={ABLOCK} warps={warps}: FAIL {str(ex)[:80]}\")\nEOF\npython3 /workspace/tune2.py 2>&1 | tail -30\n"]
