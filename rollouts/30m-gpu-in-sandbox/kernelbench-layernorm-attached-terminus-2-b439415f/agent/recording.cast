[704.755437, "o", "torch eager LN: mean=8.1146 ms min=8.0984 max=8.1312\r\nmax diff: 3.4570693969726562e-06\r\ntriton LN:      mean=0.4452 ms min=0.4443 max=0.4462\r\nSWAP=False ABLOCK=1024 warps=1: mean=0.3450 min=0.3444\r\nSWAP=False ABLOCK=2048 warps=2: mean=0.3433 min=0.3427\r\nSWAP=False ABLOCK=4096 warps=4: mean=0.3450 min=0.3442\r\nSWAP=False ABLOCK=4096 warps=1: mean=0.3450 min=0.3438\r\nSWAP=False ABLOCK=8192 warps=8: mean=0.3485 min=0.3475\r\nSWAP=False ABLOCK=2048 warps=1: mean=0.3485 min=0.3479\r\nSWAP=True ABLOCK=1024 warps=1: mean=0.2074 min=0.2069\r\nSWAP=True ABLOCK=2048 warps=2: mean=0.2110 min=0.2084\r\nSWAP=True ABLOCK=4096 warps=4: mean=0.2085 min=0.2080\r\nSWAP=True ABLOCK=4096 warps=1: mean=0.2055 min=0.2050\r\nSWAP=True ABLOCK=8192 warps=8: mean=0.2078 min=0.2072\r\nSWAP=True ABLOCK=2048 warps=1: mean=0.2128 min=0.2121\r\n"]
