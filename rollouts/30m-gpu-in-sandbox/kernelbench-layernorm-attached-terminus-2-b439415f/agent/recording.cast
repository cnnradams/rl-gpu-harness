[770.18686, "o", "\u001b[?2004l\r"]
[770.187037, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.187201, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.18769, "o", "def _ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, R, eps,\r\n\u001b[?2004l\r"]
[770.18776, "o", "\u001b[?2004h> "]
[770.188162, "o", "              B: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[770.188189, "o", "\u001b[?2004h"]
[770.188285, "o", "> "]
[770.188771, "o", "    # grid = (R, N // BLOCK): consecutive blocks share the same w/b tile\r\n\u001b[?2004l\r"]
[770.18881, "o", "\u001b[?2004h"]
[770.188824, "o", "> "]
[770.189135, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.18934, "o", "    pid = tl.program_id(1)\r\n\u001b[?2004l\r"]
[770.189389, "o", "\u001b[?2004h"]
[770.189407, "o", "> "]
[770.189676, "o", "    bidx = tl.arange(0, B)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.190095, "o", "    s1 = tl.sum(tl.load(part_ptr + row * B + bidx), axis=0)\r\n\u001b[?2004l\r"]
[770.190132, "o", "\u001b[?2004h"]
[770.190219, "o", "> "]
[770.190762, "o", "    s2 = tl.sum(tl.load(part_ptr + R * B + row * B + bidx), axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.190792, "o", "> "]
[770.191012, "o", "    mean = s1 / N\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.191113, "o", "> "]
[770.191272, "o", "    var = s2 / N - mean * mean\r\n\u001b[?2004l\r"]
[770.191306, "o", "\u001b[?2004h"]
[770.191397, "o", "> "]
[770.191654, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[770.191684, "o", "\u001b[?2004h"]
[770.191811, "o", "> "]
[770.19215, "o", "    offs = row * N + pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[770.192236, "o", "\u001b[?2004h> "]
[770.192629, "o", "    woffs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.19308, "o", "    x = tl.load(x_ptr + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[770.193114, "o", "\u001b[?2004h"]
[770.193211, "o", "> "]
[770.193609, "o", "    w = tl.load(w_ptr + woffs, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[770.193686, "o", "\u001b[?2004h"]
[770.193777, "o", "> "]
[770.194152, "o", "    bb = tl.load(b_ptr + woffs, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[770.194229, "o", "\u001b[?2004h"]
[770.194263, "o", "> "]
[770.194579, "o", "    y = (x - mean) * rstd * w + bb\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.195014, "o", "    tl.store(y_ptr + offs, y, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[770.19505, "o", "\u001b[?2004h"]
[770.195138, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[770.195212, "o", "> \r\n\u001b[?2004l\r"]
[770.195324, "o", "\u001b[?2004h> "]
[770.195523, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[770.195604, "o", "\u001b[?2004h> "]
[770.195899, "o", "    def __init__(self, normalized_shape):\r\n\u001b[?2004l\r"]
[770.19593, "o", "\u001b[?2004h"]
[770.196069, "o", "> "]
[770.196249, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.196647, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[770.196676, "o", "\u001b[?2004h"]
[770.196821, "o", "> "]
[770.197275, "o", "        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.197767, "o", "        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\r\n\u001b[?2004l\r"]
[770.197899, "o", "\u001b[?2004h"]
[770.197927, "o", "> "]
[770.198037, "o", "        self.eps = 1e-5\r\n\u001b[?2004l\r"]
[770.198071, "o", "\u001b[?2004h"]
[770.198174, "o", "> "]
[770.198262, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.198326, "o", "> "]
[770.198687, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.198827, "o", "            N *= s\r\n\u001b[?2004l\r"]
[770.198954, "o", "\u001b[?2004h> "]
[770.199127, "o", "        self.N = N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.199303, "o", "        self.B = 128\r\n\u001b[?2004l\r"]
[770.199337, "o", "\u001b[?2004h"]
[770.199427, "o", "> "]
[770.199605, "o", "        self.SBLOCK = 4096\r\n\u001b[?2004l\r"]
[770.199638, "o", "\u001b[?2004h"]
[770.199782, "o", "> "]
[770.200167, "o", "        self.ITERS = max(1, N // (self.B * self.SBLOCK))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.200391, "o", "        self.ABLOCK = 4096\r\n\u001b[?2004l\r"]
[770.200419, "o", "\u001b[?2004h"]
[770.200555, "o", "> "]
[770.201035, "o", "        self._ok = (self.B * self.SBLOCK * self.ITERS == N and N % self.ABLOCK == 0)\r\n\u001b[?2004l\r"]
[770.20114, "o", "\u001b[?2004h"]
[770.201248, "o", "> "]
[770.201332, "o", "        self._part = None\r\n\u001b[?2004l\r"]
[770.201424, "o", "\u001b[?2004h> "]
[770.201651, "o", "        self._y = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.201825, "o", "        self._R = -1\r\n\u001b[?2004l\r"]
[770.201852, "o", "\u001b[?2004h"]
[770.201928, "o", "> "]
[770.20211, "o", "        self._graph = None\r\n\u001b[?2004l\r"]
[770.202215, "o", "\u001b[?2004h"]
[770.202242, "o", "> "]
[770.202423, "o", "        self._graph_key = None\r\n\u001b[?2004l\r"]
[770.202555, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[770.202573, "o", "> "]
[770.202782, "o", "    def _launch(self, x):\r\n\u001b[?2004l\r"]
[770.202819, "o", "\u001b[?2004h"]
[770.202834, "o", "> "]
[770.203048, "o", "        N = self.N\r\n\u001b[?2004l\r\u001b[?2004h"]
[770.203073, "o", "> "]
[770.20323, "o", "        R = self._R\r\n\u001b[?2004l\r"]
[770.203264, "o", "\u001b[?2004h"]
[770.203395, "o", "> "]
[770.203899, "o", "        _ln_stats[(self.B, R)](x, self._part, N, R, B=self.B, BLOCK=self.SBLOCK,\r\n\u001b[?2004l\r"]
[770.203932, "o", "\u001b[?2004h"]
[770.204081, "o", "> "]
[770.204463, "o", "                               ITERS=self.ITERS, num_warps=16)\r\n\u001b[?2004l\r"]
[770.204497, "o", "\u001b[?2004h"]
[770.204588, "o", "> "]
[770.205097, "o", "        _ln_apply[(R, N // self.ABLOCK)](x, self._y, self.weight, self.bias,\r\n\u001b[?2004l\r"]
[770.205131, "o", "\u001b[?2004h"]
[770.205287, "o", "> "]
[770.205691, "o", "                                         self._part, N, R, self.eps,\r\n\u001b[?2004l\r"]
[770.205723, "o", "\u001b[?2004h"]
[770.205834, "o", "> "]
[770.206385, "o", "                                         B=self.B, BLOCK=self.ABLOCK, num_warps=1)\r\n\u001b[?2004l\r"]
[770.206419, "o", "\u001b[?2004h"]
[770.206434, "o", "> "]
[770.206451, "o", "\r\n\u001b[?2004l\r"]
[770.206612, "o", "\u001b[?2004h> "]
[770.206868, "o", "    def _prepare(self, x, R):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.207429, "o", "        if self._R != R or self._part is None or self._part.device != x.device:\r\n\u001b[?2004l\r"]
[770.20752, "o", "\u001b[?2004h> "]
[770.208147, "o", "            self._part = torch.empty((2, R, self.B), dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r"]
[770.208263, "o", "\u001b[?2004h> "]
[770.208624, "o", "            self._y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.208825, "o", "            self._R = R\r\n\u001b[?2004l\r"]
[770.208865, "o", "\u001b[?2004h"]
[770.208879, "o", "> "]
[770.209186, "o", "            self._graph = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.209527, "o", "            self._graph_key = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[770.209608, "o", "\u001b[?2004h> "]
[770.209893, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.210437, "o", "        if (not self._ok or x.dtype != torch.float32 or not x.is_contiguous()\r\n\u001b[?2004l\r"]
[770.210468, "o", "\u001b[?2004h"]
[770.210566, "o", "> "]
[770.210975, "o", "                or x.requires_grad or not x.is_cuda):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.211346, "o", "            return torch.nn.functional.layer_norm(\r\n\u001b[?2004l\r"]
[770.211392, "o", "\u001b[?2004h"]
[770.211413, "o", "> "]
[770.212021, "o", "                x, self.normalized_shape, self.weight, self.bias, self.eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.212277, "o", "        R = x.numel() // self.N\r\n\u001b[?2004l\r"]
[770.212305, "o", "\u001b[?2004h"]
[770.21243, "o", "> "]
[770.212609, "o", "        self._prepare(x, R)\r\n\u001b[?2004l\r"]
[770.212634, "o", "\u001b[?2004h"]
[770.212742, "o", "> "]
[770.213221, "o", "        key = (x.data_ptr(), self.weight.data_ptr(), self.bias.data_ptr())\r\n\u001b[?2004l\r"]
[770.213249, "o", "\u001b[?2004h"]
[770.213391, "o", "> "]
[770.213742, "o", "        if self._graph is None or self._graph_key != key:\r\n\u001b[?2004l\r"]
[770.21377, "o", "\u001b[?2004h"]
[770.213864, "o", "> "]
[770.214147, "o", "            self._launch(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.214487, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.21485, "o", "            g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.215206, "o", "            with torch.cuda.graph(g):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.215536, "o", "                self._launch(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[770.215748, "o", "            self._graph = g\r\n\u001b[?2004l\r"]
[770.215777, "o", "\u001b[?2004h"]
[770.215917, "o", "> "]
[770.216094, "o", "            self._graph_key = key\r\n\u001b[?2004l\r"]
[770.216203, "o", "\u001b[?2004h> "]
[770.216428, "o", "        self._graph.replay()\r\n\u001b[?2004l\r"]
[770.216576, "o", "\u001b[?2004h> "]
[770.216696, "o", "        return self._y\r\n\u001b[?2004l\r"]
[770.216813, "o", "\u001b[?2004h> EOF\r\n"]
[770.216877, "o", "\u001b[?2004l\r"]
[770.221201, "o", "\u001b[?2004hroot@modal:/workspace# "]
[770.221636, "o", "python3 /workspace/bench2.py 2>&1 | tail -4\r\n\u001b[?2004l\r"]
[774.625879, "o", "triton LN:      mean=0.2982 ms min=0.2975 max=0.2996\r\nmax diff: 3.4570693969726562e-06\r\nmax diff2: 2.86102294921875e-06\r\ntriton graph LN: mean=0.2989 min=0.2979 max=0.3000\r\n"]
[774.772778, "o", "\u001b[?2004hroot@modal:/workspace# "]
[847.970322, "i", "python3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report2.json 2>&1 | tail -14\n"]
[847.971207, "o", "python3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report2.json 2>&1 | tail -14\r\n\u001b[?2004l\r"]
[857.336041, "o", "  \"ref_runtime_stats\": {\r\n    \"mean\": 8.09,\r\n    \"std\": 0.00734,\r\n    \"min\": 8.07,\r\n    \"max\": 8.1,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"bc51809f6b49a2fe60cdf1f93f7a96b9ac1f0425bacb947f7eddac3568ceda84\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 26.877076411960132\r\n}\r\n"]
[857.435779, "o", "\u001b[?2004hroot@modal:/workspace# "]
[933.235865, "i", "cat > /workspace/tune5.py << 'EOF'\nimport sys, itertools, torch, numpy as np\nsys.path.insert(0, '/workspace')\nfrom bench import bench\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(42)\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64*256*256\nR = 16\nB = 128\nw = torch.ones((64,256,256), device='cuda')\nb = torch.zeros((64,256,256), device='cuda')\npart = torch.zeros((2, R, B), dtype=torch.float32, device='cuda')\ny = torch.empty_like(x)\neps = 1e-5\n\n@triton.jit\ndef apply_mr(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, R, eps,\n             B: tl.constexpr, BLOCK: tl.constexpr, RPB: tl.constexpr):\n    rg = tl.program_id(0)   # row group\n    pid = tl.program_id(1)  # column tile\n    woffs = pid * BLOCK + tl.arange(0, BLOCK)\n    wv = tl.load(w_ptr + woffs, eviction_policy='evict_last')\n    bv = tl.load(b_ptr + woffs, eviction_policy='evict_last')\n    bidx = tl.arange(0, B)\n    for r in tl.static_range(RPB):\n        row = rg * RPB + r\n        s1 = tl.sum(tl.load(part_ptr + row * B +"]
[933.236173, "i", " bidx), axis=0)\n        s2 = tl.sum(tl.load(part_ptr + R * B + row * B + bidx), axis=0)\n        mean = s1 / N\n        var = s2 / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        offs = row * N + woffs\n        x = tl.load(x_ptr + offs, eviction_policy='evict_first')\n        yv = (x - mean) * rstd * wv + bv\n        tl.store(y_ptr + offs, yv, eviction_policy='evict_first')\n\nfor RPB in [2, 4, 8, 16]:\n    for ABLOCK, warps in [(1024, 1), (2048, 1), (2048, 2), (4096, 1), (4096, 2), (4096, 4), (8192, 4), (8192, 8)]:\n        grid = (R // RPB, N // ABLOCK)\n        try:\n            fn = lambda a: apply_mr[grid](a, y, w, b, part, N, R, eps, B=B, BLOCK=ABLOCK, RPB=RPB, num_warps=warps)\n            m, mn, mx = bench(fn, [x], num_trials=10)\n            print(f\"RPB={RPB} ABLOCK={ABLOCK} warps={warps}: mean={m:.4f} min={mn:.4f}\")\n        except Exception as ex:\n            print(f\"RPB={RPB} ABLOCK={ABLOCK} warps={warps}: FAIL {str(ex)[:60]}\")\nEOF\npython3 /workspace/tune5.py 2>&1 | tail -35\n"]
[933.236349, "o", "cat > /workspace/tune5.py << 'EOF'\r\n\u001b[?2004l\r"]
[933.236652, "o", "\u001b[?2004h> "]
[933.237017, "o", "import sys, itertools, torch, numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.237363, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.237567, "o", "from bench import bench\r\n\u001b[?2004l\r"]
[933.23759, "o", "\u001b[?2004h"]
[933.237739, "o", "> import triton\r\n\u001b[?2004l\r"]
[933.237887, "o", "\u001b[?2004h> "]
[933.238084, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[933.238236, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.238421, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[933.238499, "o", "\u001b[?2004h> "]
[933.238985, "o", "x = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[933.239019, "o", "\u001b[?2004h"]
[933.239162, "o", "> N = 64*256*256"]
[933.239243, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[933.23927, "o", "> "]
[933.239359, "o", "R = 16\r\n\u001b[?2004l\r"]
[933.239474, "o", "\u001b[?2004h> "]
[933.239578, "o", "B = 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[933.239668, "o", "> "]
[933.23994, "o", "w = torch.ones((64,256,256), device='cuda')\r\n\u001b[?2004l\r"]
[933.239973, "o", "\u001b[?2004h"]
[933.240087, "o", "> "]
[933.24044, "o", "b = torch.zeros((64,256,256), device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.240927, "o", "part = torch.zeros((2, R, B), dtype=torch.float32, device='cuda')\r\n\u001b[?2004l\r"]
[933.241029, "o", "\u001b[?2004h"]
[933.24106, "o", "> "]
[933.24124, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[933.241348, "o", "\u001b[?2004h> "]
[933.241461, "o", "eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.241486, "o", "\r\n\u001b[?2004l\r"]
[933.241587, "o", "\u001b[?2004h> "]
[933.241689, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[933.241714, "o", "\u001b[?2004h"]
[933.241836, "o", "> "]
[933.242237, "o", "def apply_mr(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, R, eps,\r\n\u001b[?2004l\r"]
[933.242273, "o", "\u001b[?2004h"]
[933.242374, "o", "> "]
[933.24284, "o", "             B: tl.constexpr, BLOCK: tl.constexpr, RPB: tl.constexpr):\r\n\u001b[?2004l\r"]
[933.242874, "o", "\u001b[?2004h"]
[933.243012, "o", "> "]
[933.243229, "o", "    rg = tl.program_id(0)   # row group\r\n\u001b[?2004l\r"]
[933.243311, "o", "\u001b[?2004h"]
[933.24346, "o", "> "]
[933.243639, "o", "    pid = tl.program_id(1)  # column tile\r\n\u001b[?2004l\r"]
[933.243666, "o", "\u001b[?2004h"]
[933.243773, "o", "> "]
[933.244119, "o", "    woffs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.244566, "o", "    wv = tl.load(w_ptr + woffs, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[933.244676, "o", "\u001b[?2004h> "]
[933.245099, "o", "    bv = tl.load(b_ptr + woffs, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[933.245136, "o", "\u001b[?2004h"]
[933.245265, "o", "> "]
[933.245414, "o", "    bidx = tl.arange(0, B)\r\n\u001b[?2004l\r"]
[933.245446, "o", "\u001b[?2004h"]
[933.24557, "o", "> "]
[933.245819, "o", "    for r in tl.static_range(RPB):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.246044, "o", "        row = rg * RPB + r\r\n\u001b[?2004l\r"]
[933.24608, "o", "\u001b[?2004h"]
[933.246191, "o", "> "]
[933.246595, "o", "        s1 = tl.sum(tl.load(part_ptr + row * B + bidx), axis=0)\r\n\u001b[?2004l\r"]
[933.246672, "o", "\u001b[?2004h"]
[933.246752, "o", "> "]
[933.247278, "o", "        s2 = tl.sum(tl.load(part_ptr + R * B + row * B + bidx), axis=0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.24747, "o", "        mean = s1 / N\r\n\u001b[?2004l\r"]
[933.247503, "o", "\u001b[?2004h"]
[933.247581, "o", "> "]
[933.247913, "o", "        var = s2 / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[933.248221, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[933.248281, "o", "\u001b[?2004h"]
[933.248381, "o", "> "]
[933.248551, "o", "        offs = row * N + woffs\r\n\u001b[?2004l\r"]
[933.248622, "o", "\u001b[?2004h"]
[933.248651, "o", "> "]
[933.249114, "o", "        x = tl.load(x_ptr + offs, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[933.249153, "o", "\u001b[?2004h"]
[933.249289, "o", "> "]
[933.249521, "o", "        yv = (x - mean) * rstd * wv + bv\r\n\u001b[?2004l\r"]
[933.249552, "o", "\u001b[?2004h"]
[933.249648, "o", "> "]
[933.250067, "o", "        tl.store(y_ptr + offs, yv, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[933.250159, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[933.250322, "o", "\u001b[?2004h> "]
[933.250492, "o", "for RPB in [2, 4, 8, 16]:\r\n\u001b[?2004l\r"]
[933.250595, "o", "\u001b[?2004h> "]
[933.25139, "o", "    for ABLOCK, warps in [(1024, 1), (2048, 1), (2048, 2), (4096, 1), (4096, 2), (4096, 4), (8192, 4), (8192, 8)]:\r\n\u001b[?2004l\r"]
[933.251426, "o", "\u001b[?2004h"]
[933.251578, "o", "> "]
[933.251817, "o", "        grid = (R // RPB, N // ABLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[933.251887, "o", "> "]
[933.251964, "o", "        try:\r\n\u001b[?2004l\r"]
[933.252062, "o", "\u001b[?2004h> "]
[933.252879, "o", "            fn = lambda a: apply_mr[grid](a, y, w, b, part, N, R, eps, B=B, BLOCK=ABLOCK, RPB=RPB, num_warps=warps)\r\n\u001b[?2004l\r"]
[933.252912, "o", "\u001b[?2004h"]
[933.253013, "o", "> "]
[933.253379, "o", "            m, mn, mx = bench(fn, [x], num_trials=10)\r\n\u001b[?2004l\r"]
[933.25341, "o", "\u001b[?2004h"]
[933.25351, "o", "> "]
[933.254087, "o", "            print(f\"RPB={RPB} ABLOCK={ABLOCK} warps={warps}: mean={m:.4f} min={mn:.4f}\")\r\n\u001b[?2004l\r"]
[933.254197, "o", "\u001b[?2004h> "]
[933.254444, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[933.254519, "o", "\u001b[?2004h"]
[933.254592, "o", "> "]
[933.255139, "o", "            print(f\"RPB={RPB} ABLOCK={ABLOCK} warps={warps}: FAIL {str(ex)[:60]}\")\r\n\u001b[?2004l\r"]
[933.25518, "o", "\u001b[?2004h> "]
[933.255345, "o", "EOF\r\n\u001b[?2004l\r"]
[933.259271, "o", "\u001b[?2004hroot@modal:/workspace# "]
[933.259613, "o", "python3 /workspace/tune5.py 2>&1 | tail -35\r\n\u001b[?2004l\r"]
