[699.094127, "i", "cat > /workspace/tune4.py << 'EOF'\nimport sys, itertools, torch, numpy as np\nsys.path.insert(0, '/workspace')\nfrom bench import bench\nimport triton\nimport triton.language as tl\n\ntorch.manual_seed(42)\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nN = 64*256*256\nR = 16\nB = 128\nw = torch.ones((64,256,256), device='cuda')\nb = torch.zeros((64,256,256), device='cuda')\npart = torch.zeros((2, R, B), dtype=torch.float32, device='cuda')\ny = torch.empty_like(x)\neps = 1e-5\n\n@triton.jit\ndef apply_v2(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, eps,\n             B: tl.constexpr, BLOCK: tl.constexpr, SWAP: tl.constexpr):\n    if SWAP:\n        row = tl.program_id(0)\n        pid = tl.program_id(1)\n    else:\n        pid = tl.program_id(0)\n        row = tl.program_id(1)\n    bidx = tl.arange(0, B)\n    s1 = tl.sum(tl.load(part_ptr + row * B + bidx), axis=0)\n    s2 = tl.sum(tl.load(part_ptr + tl.num_programs(0 if not SWAP else 1) * B + row * B + bidx), axis=0)\n    mean = s1 / N\n    var = s2 / N - mean * mean\n    "]
[699.094391, "i", "rstd = 1.0 / tl.sqrt(var + eps)\n    offs = row * N + pid * BLOCK + tl.arange(0, BLOCK)\n    woffs = pid * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(x_ptr + offs, eviction_policy='evict_first')\n    wv = tl.load(w_ptr + woffs, eviction_policy='evict_last')\n    bv = tl.load(b_ptr + woffs, eviction_policy='evict_last')\n    yv = (x - mean) * rstd * wv + bv\n    tl.store(y_ptr + offs, yv, eviction_policy='evict_first')\n\nfor SWAP in [False, True]:\n    for ABLOCK, warps in [(1024, 1), (2048, 2), (4096, 4), (4096, 1), (8192, 8), (2048, 1)]:\n        grid = (R, N // ABLOCK) if SWAP else (N // ABLOCK, R)\n        try:\n            fn = lambda a: apply_v2[grid](a, y, w, b, part, N, eps, B=B, BLOCK=ABLOCK, SWAP=SWAP, num_warps=warps)\n            m, mn, mx = bench(fn, [x], num_trials=10)\n            print(f\"SWAP={SWAP} ABLOCK={ABLOCK} warps={warps}: mean={m:.4f} min={mn:.4f}\")\n        except Exception as ex:\n            print(f\"SWAP={SWAP} ABLOCK={ABLOCK} warps={warps}: FAIL {str(ex)[:60]}\")\nEOF\npython3 /workspace/tune4.py 2>"]
[699.094487, "i", "&1 | tail -15\n"]
