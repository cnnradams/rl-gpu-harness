[212.335561, "o", "            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.33579, "o", "            clear_l2(device)\r\n\u001b[?2004l\r"]
[212.335818, "o", "\u001b[?2004h"]
[212.3359, "o", "> "]
[212.336154, "o", "            s.record()\r\n\u001b[?2004l\r\u001b[?2004h"]
[212.336239, "o", "> "]
[212.336377, "o", "            fn(*args)\r\n\u001b[?2004l\r"]
[212.336476, "o", "\u001b[?2004h> "]
[212.336623, "o", "            e.record()\r\n\u001b[?2004l\r"]
[212.336775, "o", "\u001b[?2004h> "]
[212.336967, "o", "            torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[212.336993, "o", "\u001b[?2004h"]
[212.337118, "o", "> "]
[212.337349, "o", "            if t >= discard_first:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.337761, "o", "                times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.338013, "o", "    import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.338507, "o", "    return np.mean(times), np.min(times), np.max(times)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[212.338541, "o", "\r\n\u001b[?2004l\r"]
[212.338701, "o", "\u001b[?2004h> "]
[212.338784, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[212.338837, "o", "\u001b[?2004h"]
[212.338914, "o", "> "]
[212.339375, "o", "x = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[212.339403, "o", "> \r\n\u001b[?2004l\r"]
