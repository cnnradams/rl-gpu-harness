[212.339664, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[212.339693, "o", "\u001b[?2004h"]
[212.339794, "o", "> "]
[212.340039, "o", "ref = nn.LayerNorm((64, 256, 256)).cuda()\r\n\u001b[?2004l\r"]
[212.340115, "o", "\u001b[?2004h"]
[212.340147, "o", "> "]
[212.340275, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[212.340402, "o", "\u001b[?2004h> "]
