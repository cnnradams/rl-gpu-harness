[483.83057, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_stats(x_ptr, part_ptr, N, B: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row * N + pid * (BLOCK * ITERS)\n    offs = tl.arange(0, BLOCK)\n    acc1 = tl.zeros((BLOCK,), dtype=tl.float32)\n    acc2 = tl.zeros((BLOCK,), dtype=tl.float32)\n    for i in tl.static_range(ITERS):\n        x = tl.load(x_ptr + base + i * BLOCK + offs)\n        acc1 += x\n        acc2 += x * x\n    s1 = tl.sum(acc1, axis=0)\n    s2 = tl.sum(acc2, axis=0)\n    R = tl.num_programs(1)\n    tl.store(part_ptr + row * B + pid, s1)\n    tl.store(part_ptr + R * B + row * B + pid, s2)\n\n\n@triton.jit\ndef _ln_apply(x_ptr, y_ptr, w_ptr, b_ptr, part_ptr, N, eps,\n              B: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    bidx = tl.arange(0, B)\n    s1 = tl.sum(tl.load(part_ptr + row * B + bidx), axis="]
[483.830904, "i", "0)\n    s2 = tl.sum(tl.load(part_ptr + tl.num_programs(1) * B + row * B + bidx), axis=0)\n    mean = s1 / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = row * N + pid * BLOCK + tl.arange(0, BLOCK)\n    woffs = pid * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(x_ptr + offs)\n    w = tl.load(w_ptr + woffs)\n    bb = tl.load(b_ptr + woffs)\n    y = (x - mean) * rstd * w + bb\n    tl.store(y_ptr + offs, y)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.weight = nn.Parameter(torch.ones(self.normalized_shape))\n        self.bias = nn.Parameter(torch.zeros(self.normalized_shape))\n        self.eps = 1e-5\n        N = 1\n        for s in self.normalized_shape:\n            N *= s\n        self.N = N\n        self.B = 128\n        self.SBLOCK = 4096\n        self.ITERS = max(1, N // (self.B * self.SBLOCK))\n        self.ABLOCK = 4096\n        self._ok = (self.B * self.SBLOCK * self.ITE"]
[483.831116, "i", "RS == N and N % self.ABLOCK == 0)\n        self._part = None\n        self._y = None\n        self._R = -1\n        self._graph = None\n        self._graph_key = None\n\n    def _launch(self, x):\n        N = self.N\n        R = self._R\n        _ln_stats[(self.B, R)](x, self._part, N, B=self.B, BLOCK=self.SBLOCK,\n                               ITERS=self.ITERS, num_warps=16)\n        _ln_apply[(N // self.ABLOCK, R)](x, self._y, self.weight, self.bias,\n                                         self._part, N, self.eps,\n                                         B=self.B, BLOCK=self.ABLOCK, num_warps=1)\n\n    def _prepare(self, x, R):\n        if self._R != R or self._part is None or self._part.device != x.device:\n            self._part = torch.empty((2, R, self.B), dtype=torch.float32, device=x.device)\n            self._y = torch.empty_like(x)\n            self._R = R\n            self._graph = None\n            self._graph_key = None\n\n    def forward(self, x):\n        if (not self._ok or x.dtype != torch.float32 or not x.is_con"]
[483.831144, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[483.831302, "i", "tiguous()\n                or x.requires_grad or not x.is_cuda):\n            return torch.nn.functional.layer_norm(\n                x, self.normalized_shape, self.weight, self.bias, self.eps)\n        R = x.numel() // self.N\n        self._prepare(x, R)\n        key = (x.data_ptr(), self.weight.data_ptr(), self.bias.data_ptr())\n        if self._graph is None or self._graph_key != key:\n            # warmup (compiles kernels) then capture\n            self._launch(x)\n            torch.cuda.synchronize()\n            g = torch.cuda.CUDAGraph()\n            with torch.cuda.graph(g):\n                self._launch(x)\n            self._graph = g\n            self._graph_key = key\n        self._graph.replay()\n        return self._y\nEOF\ncat > /workspace/bench2.py << 'EOF'\nimport sys, torch, numpy as np\nsys.path.insert(0, '/workspace')\nfrom bench import bench\nimport torch.nn as nn\n\ntorch.manual_seed(42)\nx = torch.rand(16, 64, 256, 256, device='cuda', dtype=torch.float32)\nref = nn.LayerNorm((64, 256, 256)).cuda()\nfrom solution i"]
[483.831393, "o", "\u001b[?2004h> "]
[483.831425, "i", "mport ModelNew\nsol = ModelNew((64, 256, 256)).cuda()\nwith torch.no_grad():\n    out_ref = ref(x)\n    out_new = sol(x)\n    print('max diff:', (out_ref - out_new).abs().max().item())\n    # second call returns new values for new input\n    x2 = torch.rand(16, 64, 256, 256, device='cuda')\n    out2 = sol(x2)\n    print('max diff2:', (ref(x2) - out2).abs().max().item())\n    m, mn, mx = bench(lambda a: sol(a), [x])\nprint(f\"triton graph LN: mean={m:.4f} min={mn:.4f} max={mx:.4f}\")\nEOF\npython3 /workspace/bench2.py 2>&1 | tail -5\n"]
