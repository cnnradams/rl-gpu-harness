[?2004l[?2004h> # ---- in-kernel split, dual acc ----
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def k_inl(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,
[?2004l[?2004h>           sxm, sxk, swn, swk, som, son, scale,
[?2004l[?2004h>           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):
