[?2004l[?2004h>     gid = pid // npg
[?2004l[?2004h>     fm = gid * GROUP_M
[?2004l[?2004h>     gs = min(num_pid_m - fm, GROUP_M)
[?2004l[?2004h>     pid_m = fm + ((pid % npg) % gs)
[?2004l[?2004h>     pid_n = (pid % npg) // gs
[?2004l[?2004h>     offs_m = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     offs_n = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     offs_k = tl.arange(0, BK)
[?2004l[?2004h>     xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk
[?2004l[?2004h>     wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk
[?2004l[?2004h>     acch = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     accl = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for _ in range(0, tl.cdiv(K, BK)):
[?2004l[?2004h>         a = tl.load(xp)
[?2004l[?2004h>         bb = tl.load(wp)
[?2004l[?2004h>         ah = a.to(tl.float16)
