[1058.887595, "o", "    ((128,128,64,8),8,3), ((128,128,16,8),8,6),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1058.887896, "o", "    ((64,128,32,8),4,5), ((128,64,32,8),4,5),\r\n\u001b[?2004l\r"]
