[401.692752, "i", "cat > /tmp/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport triton.testing\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\n\n@triton.jit\ndef k_split_inplace(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n                    sxm, sxk, swn, swk, som, son, scale,\n                    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                    GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\n    wp = w_ptr + offs_n[None, :] * swn + "]
[401.693054, "i", "offs_k[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb = tl.load(wp)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = bb.to(tl.float16)\n        bl = (bb - bh.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah, bh, acc)\n        acc = tl.dot(ah, bl, acc)\n        acc = tl.dot(al, bh, acc)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\ndef run1(cfg, warps, stages):\n    BM, BN, BK, GM = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k_split_inplace[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, num_warps=warps, num_stages=stages)\n    return f\n\ncfgs = [\n    ((128,128,64,8), 8, 3),\n    ((128,128,64,8), 8, 2"]
[401.693097, "o", "cat > /tmp/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[401.693118, "i", "),\n    ((128,256,64,8), 8, 2),\n    ((256,128,64,8), 8, 2),\n    ((256,256,32,8), 8, 3),\n    ((256,256,64,8), 16, 2),\n    ((128,128,32,8), 8, 4),\n    ((128,256,32,8), 8, 3),\n]\nfor cfg, wp, st in cfgs:\n    try:\n        f = run1(cfg, wp, st)\n        f()\n        torch.cuda.synchronize()\n        ms = triton.testing.do_bench(f, warmup=10, rep=30)\n        print(f\"fp16split-inplace {cfg} w{wp} s{st}: {ms:.3f} ms\")\n    except Exception as e:\n        print(f\"fp16split-inplace {cfg} w{wp} s{st}: FAIL {str(e)[:100]}\")\n\n# accuracy of best inplace variant\ny64 = (x.double() @ w.double().t() + b.double()) * 1.5\nf = run1((128,128,64,8), 8, 3)\nf(); torch.cuda.synchronize()\nprint(\"inplace err vs fp64:\", (out.double()-y64).abs().max().item())\nEOF\npython3 /tmp/bench2.py 2>/dev/null | grep -v Warning\n"]
