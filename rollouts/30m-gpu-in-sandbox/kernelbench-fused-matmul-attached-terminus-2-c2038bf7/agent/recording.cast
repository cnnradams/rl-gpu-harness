[118.468379, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\ndef _configs():\n    return [\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=5),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n    ]\n\n\n@triton.autotune(configs=_configs(), key=['M', 'N', 'K'])\n@triton.jit\ndef _linear_scale_kernel(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n                         stride_xm, stride_xk,\n    "]
[118.468671, "i", "                     stride_wn, stride_wk,\n                         stride_om, stride_on,\n                         scale,\n                         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                         GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n\n    x_ptrs = x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :] * stride_xk\n    w_ptrs = w_ptr + offs_n[None, :] * stride_wn + offs_k[:, None] * stride_wk\n\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(x_ptr"]
[118.468846, "i", "s)\n        b = tl.load(w_ptrs)\n        acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\n        x_ptrs += BK * stride_xk\n        w_ptrs += BK * stride_wk\n\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n\n    out_ptrs = out_ptr + offs_m[:, None] * stride_om + offs_n[None, :] * stride_on\n    tl.store(out_ptrs, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = float(scaling_factor)\n\n    def forward(self, x):\n        w = self.matmul.weight\n        bias = self.matmul.bias\n        M, K = x.shape\n        N = w.shape[0]\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n        _linear_scale_kernel[grid](\n            x, w, bias, out, M, N, K,\n            x.stride(0), x.stride(1),\n            w.stride(0), w"]
[118.468983, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[118.469166, "i", ".stride(1),\n            out.stride(0), out.stride(1),\n            1.0 + self.scaling_factor,\n        )\n        return out\nEOF\n"]
