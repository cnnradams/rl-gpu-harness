[886.362786, "o", "> "]
[886.36304, "o", "lin = torch.nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.363219, "o", "worst_ratio = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.363407, "o", "worst_diff = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
