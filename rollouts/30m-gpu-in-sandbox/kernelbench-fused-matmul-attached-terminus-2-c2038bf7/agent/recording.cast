[886.352794, "o", "\u001b[?2004h"]
[886.352864, "o", "> "]
[886.353026, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[886.353083, "o", "\u001b[?2004h"]
[886.353106, "o", "> "]
[886.353307, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[886.353333, "o", "\u001b[?2004h"]
[886.353478, "o", "> "]
[886.353626, "o", "    npg = GROUP_M * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.353776, "o", "    gid = pid // npg\r\n\u001b[?2004l\r"]
[886.353844, "o", "\u001b[?2004h"]
[886.353862, "o", "> "]
[886.354063, "o", "    fm = gid * GROUP_M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.35432, "o", "    gs = min(num_pid_m - fm, GROUP_M)\r\n\u001b[?2004l\r"]
[886.354349, "o", "\u001b[?2004h"]
[886.354464, "o", "> "]
[886.354686, "o", "    pid_m = fm + ((pid % npg) % gs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.354888, "o", "    pid_n = (pid % npg) // gs\r\n\u001b[?2004l\r"]
