[273.210722, "i", "cat > /tmp/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport triton.testing\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\n\n@triton.jit\ndef k_fn(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n         sxm, sxk, swn, swk, som, son, scale,\n         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n         GROUP_M: tl.constexpr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\n    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range"]
[273.210901, "i", "(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb = tl.load(wp)\n        acc = tl.dot(a, bb, acc, input_precision=IP)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\nout = torch.empty(M, N, device='cuda')\n\ndef run(cfg, ip, warps, stages):\n    BM, BN, BK, GM = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k_fn[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, ip, num_warps=warps, num_stages=stages)\n    return f\n\ncfgs = [\n    ((128,128,64,8), 8, 4),\n    ((128,256,64,8), 8, 4),\n    ((256,128,64,8), 8, 4),\n    ((256,256,32,8), 8, 3),\n    ((256,256,64,8), 16, 3),\n    ((128,256,128,8), 8, 3),\n    ((256,128,128,8), 16, 3),\n    ((128,128,128,8), 8, 4),\n    ((256,64,64,8), 8, 4),\n    ((64,256,64,8), 8, 4),\n]\nfor cfg, wp, st in cfgs:\n    try:\n"]
[273.210987, "i", "        f = run(cfg, \"tf32x3\", wp, st)\n        ms = triton.testing.do_bench(f, warmup=10, rep=30)\n        fl = 2*M*N*K*3/ms*1e-9\n        print(f\"tf32x3 {cfg} w{wp} s{st}: {ms:.3f} ms ({fl:.0f} TF)\")\n    except Exception as e:\n        print(f\"tf32x3 {cfg} w{wp} s{st}: FAIL {str(e)[:80]}\")\n\nfor cfg, wp, st in cfgs[:4]:\n    try:\n        f = run(cfg, \"tf32\", wp, st)\n        ms = triton.testing.do_bench(f, warmup=10, rep=30)\n        print(f\"tf32   {cfg} w{wp} s{st}: {ms:.3f} ms\")\n    except Exception as e:\n        print(f\"tf32   {cfg} w{wp} s{st}: FAIL {str(e)[:80]}\")\n\n# torch baselines\nms = triton.testing.do_bench(lambda: torch.mm(x, w.t()), warmup=10, rep=30)\nprint(f\"cublas fp32 mm: {ms:.3f} ms\")\ntorch.backends.cuda.matmul.allow_tf32 = True\nms = triton.testing.do_bench(lambda: torch.mm(x, w.t()), warmup=10, rep=30)\nprint(f\"cublas tf32 mm: {ms:.3f} ms\")\ntorch.backends.cuda.matmul.allow_tf32 = False\n# full ref forward\nlin = torch.nn.Linear(K, N).cuda()\nwith torch.no_grad():\n    lin.weight.copy_(w); lin.bias.copy_("]
[273.211016, "i", "b)\ndef reffwd():\n    y = lin(x)\n    o = y.clone().detach()\n    return y * 0.5 + o\nms = triton.testing.do_bench(reffwd, warmup=10, rep=30)\nprint(f\"ref fwd: {ms:.3f} ms\")\nEOF\npython3 /tmp/bench.py\n"]
[273.211224, "o", "cat > /tmp/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[273.211314, "o", "\u001b[?2004h"]
[273.211477, "o", "> "]
[273.211767, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[273.211894, "o", "\u001b[?2004h> "]
[273.212085, "o", "import triton.testing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.212111, "o", "\r\n\u001b[?2004l\r"]
[273.212183, "o", "\u001b[?2004h> "]
[273.21239, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[273.21243, "o", "\u001b[?2004h"]
[273.212446, "o", "> "]
[273.212766, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.213021, "o", "w = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[273.21309, "o", "\u001b[?2004h> "]
[273.213386, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[273.213471, "o", "\u001b[?2004h> "]
[273.213593, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.213686, "o", "> "]
[273.213972, "o", "def k_fn(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\r\n\u001b[?2004l\r"]
[273.214019, "o", "\u001b[?2004h> "]
[273.214397, "o", "         sxm, sxk, swn, swk, som, son, scale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.214819, "o", "         BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[273.21485, "o", "\u001b[?2004h"]
[273.215011, "o", "> "]
[273.215258, "o", "         GROUP_M: tl.constexpr, IP: tl.constexpr):\r\n\u001b[?2004l\r"]
[273.215349, "o", "\u001b[?2004h> "]
