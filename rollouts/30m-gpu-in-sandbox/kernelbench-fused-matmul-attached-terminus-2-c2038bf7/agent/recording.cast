[688.321376, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.32151, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[688.321553, "o", "\u001b[?2004h"]
[688.321602, "o", "> "]
[688.321827, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[688.321907, "o", "\u001b[?2004h"]
[688.321927, "o", "> "]
[688.322127, "o", "w = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[688.322191, "o", "\u001b[?2004h> "]
[688.322423, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[688.322448, "o", "\u001b[?2004h"]
[688.32257, "o", "> "]
[688.323435, "o", "for cfg, wp, st in [((128,128,64,8),8,4), ((128,256,64,8),8,3), ((256,128,64,8),8,3), ((128,128,64,8),8,3), ((128,256,32,8),8,4), ((64,256,64,8),4,4)]:\r\n\u001b[?2004l\r"]
[688.323475, "o", "\u001b[?2004h"]
[688.323486, "o", "> "]
[688.323575, "o", "    try:\r\n\u001b[?2004l\r"]
[688.323593, "o", "\u001b[?2004h"]
[688.323645, "o", "> "]
[688.323938, "o", "        f = make(x, w, b, cfg, wp, st, \"tf32\")\r\n\u001b[?2004l\r"]
[688.324023, "o", "\u001b[?2004h> "]
[688.324314, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.324688, "o", "        ms = triton.testing.do_bench(f, warmup=10, rep=30)\r\n\u001b[?2004l\r"]
[688.324797, "o", "\u001b[?2004h> "]
[688.325107, "o", "        print(f\"tf32 {cfg} w{wp} s{st}: {ms:.3f} ms\")\r\n\u001b[?2004l\r"]
[688.325142, "o", "\u001b[?2004h"]
[688.325156, "o", "> "]
[688.325352, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[688.325415, "o", "\u001b[?2004h"]
[688.325466, "o", "> "]
[688.325816, "o", "        print(f\"tf32 {cfg} w{wp} s{st}: FAIL {str(e)[:90]}\")\r\n\u001b[?2004l\r"]
[688.325845, "o", "\u001b[?2004h"]
[688.325944, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[688.325963, "o", "> "]
[688.326257, "o", "# accuracy vs fp32 reference over many seeds\r\n\u001b[?2004l\r"]
[688.326319, "o", "\u001b[?2004h"]
[688.326385, "o", "> "]
[688.326567, "o", "lin = torch.nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[688.326644, "o", "\u001b[?2004h> "]
[688.326757, "o", "worst_ratio = 0.0\r\n\u001b[?2004l\r"]
[688.326802, "o", "\u001b[?2004h"]
[688.326865, "o", "> "]
[688.327034, "o", "worst_diff = 0.0\r\n\u001b[?2004l\r"]
[688.327125, "o", "\u001b[?2004h"]
[688.327205, "o", "> "]
[688.32733, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[688.327401, "o", "> "]
[688.327542, "o", "    for s in range(100):\r\n\u001b[?2004l\r"]
[688.32757, "o", "\u001b[?2004h"]
[688.327675, "o", "> "]
[688.327855, "o", "        torch.manual_seed(1000 + s)\r\n\u001b[?2004l\r"]
[688.327881, "o", "\u001b[?2004h"]
[688.327957, "o", "> "]
[688.328223, "o", "        xs = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[688.328311, "o", "\u001b[?2004h> "]
[688.328587, "o", "        ws = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[688.328614, "o", "\u001b[?2004h"]
[688.328745, "o", "> "]
[688.328956, "o", "        bs = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[688.329112, "o", "\u001b[?2004h> "]
[688.329355, "o", "        lin.weight.copy_(ws); lin.bias.copy_(bs)\r\n\u001b[?2004l\r"]
[688.329434, "o", "\u001b[?2004h> "]
[688.330045, "o", "        y_ref = lin(xs) * 0.5 + lin(xs).clone().detach()  # emulate ref numerics roughly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.330327, "o", "        y_ref = (lin(xs) * 1.5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.330713, "o", "        f = make(xs, ws, bs, (128, 256, 64, 8), 8, 3, \"tf32\")\r\n\u001b[?2004l\r"]
[688.330776, "o", "\u001b[?2004h> "]
[688.331085, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.331342, "o", "        y_new = out.clone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.331565, "o", "        d = (y_ref - y_new).abs()\r\n\u001b[?2004l\r"]
[688.331624, "o", "\u001b[?2004h"]
[688.331682, "o", "> "]
[688.331912, "o", "        tol = 1e-4 + 1e-4 * y_ref.abs()\r\n\u001b[?2004l\r"]
[688.331937, "o", "\u001b[?2004h"]
[688.332037, "o", "> "]
[688.332231, "o", "        ratio = (d / tol).max().item()\r\n\u001b[?2004l\r"]
[688.332314, "o", "\u001b[?2004h"]
[688.33237, "o", "> "]
[688.332607, "o", "        worst_ratio = max(worst_ratio, ratio)\r\n\u001b[?2004l\r"]
[688.332634, "o", "\u001b[?2004h"]
[688.332739, "o", "> "]
[688.333079, "o", "        worst_diff = max(worst_diff, d.max().item())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[688.333685, "o", "print(f\"tf32 worst (diff/tol) over 100 seeds: {worst_ratio:.4f}, worst diff: {worst_diff:.3e}\")\r\n\u001b[?2004l\r"]
[688.333766, "o", "\u001b[?2004h> "]
[688.333811, "o", "EOF\r\n\u001b[?2004l\r"]
[688.337185, "o", "\u001b[?2004hroot@modal:/workspace# "]
[688.337587, "o", "python3 /tmp/tf32test.py 2>/dev/null | grep -v Warning\r\n\u001b[?2004l\r"]
[693.763952, "o", "tf32 (128, 128, 64, 8) w8 s4: FAIL out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block s\r\ntf32 (128, 256, 64, 8) w8 s3: FAIL out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block s\r\ntf32 (256, 128, 64, 8) w8 s3: FAIL out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block s\r\ntf32 (128, 128, 64, 8) w8 s3: 1.800 ms\r\ntf32 (128, 256, 32, 8) w8 s4: 1.669 ms\r\ntf32 (64, 256, 64, 8) w4 s4: FAIL out of resource: shared memory, Required: 327680, Hardware limit: 232448. Reducing block s\r\n"]
[694.188816, "o", "\u001b[?2004hroot@modal:/workspace# "]
[818.153718, "i", "python3 /tmp/tf32test.py > /tmp/tf32.log 2>&1; tail -3 /tmp/tf32.log\n"]
[818.154267, "o", "python3 /tmp/tf32test.py > /tmp/tf32.log 2>&1; tail -3 /tmp/tf32.log\r\n\u001b[?2004l\r"]
[821.075491, "o", "  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\", line 456, in raise_\r\n    raise err\r\ntriton.runtime.errors.OutOfResources: out of resource: shared memory, Required: 294912, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\n"]
[821.075749, "o", "\u001b[?2004h"]
[821.075874, "o", "root@modal:/workspace# "]
[886.349041, "i", "cat > /tmp/tf32acc.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nM, N, K = 16384, 4096, 4096\nout = torch.empty(M, N, device='cuda')\n\n@triton.jit\ndef k_tf32(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n           sxm, sxk, swn, swk, som, son, scale,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n           GROUP_M: tl.constexpr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\n    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb = tl.load(wp)\n        "]
[886.349229, "i", "acc = tl.dot(a, bb, acc, input_precision=IP)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\nBM, BN, BK, GM = 128, 256, 32, 8\ngrid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n\ndef run_new(x, w, b, ip):\n    k_tf32[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, ip, num_warps=8, num_stages=4)\n    return out\n\nlin = torch.nn.Linear(K, N).cuda()\nworst_ratio = 0.0\nworst_diff = 0.0\nnfail = 0\nwith torch.no_grad():\n    for s in range(200):\n        torch.manual_seed(2000 + s)\n        xs = torch.rand(M, K, device='cuda')\n        ws = torch.rand(N, K, device='cuda')\n        bs = torch.rand(N, device='cuda')\n        lin.weight.copy_(ws); lin.bias.copy_(bs)\n        # exact reference numerics\n        y = lin(xs)\n        o = y.clone().detach()\n        y_ref = y * 0.5 + o\n        run_"]
[886.34932, "i", "new(xs, ws, bs, \"tf32\")\n        torch.cuda.synchronize()\n        y_new = out.clone()\n        d = (y_ref - y_new).abs()\n        tol = 1e-4 + 1e-4 * y_ref.abs()\n        bad = (d > tol).sum().item()\n        nfail += bad\n        ratio = (d / tol).max().item()\n        if ratio > worst_ratio:\n            worst_ratio = ratio\n            worst_diff = d.max().item()\nprint(f\"tf32: worst ratio={worst_ratio:.4f} worst_diff={worst_diff:.3e} total_violations={nfail}\")\nEOF\npython3 /tmp/tf32acc.py 2>/dev/null | tail -2\n"]
[886.34949, "o", "cat > /tmp/tf32acc.py << 'EOF'\r\n\u001b[?2004l\r"]
[886.349516, "o", "\u001b[?2004h"]
[886.349561, "o", "> "]
