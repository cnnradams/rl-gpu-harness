[401.70507, "o", "        bh = bb.to(tl.float16)\r\n\u001b[?2004l\r"]
[401.705142, "o", "\u001b[?2004h"]
[401.705179, "o", "> "]
[401.705509, "o", "        bl = (bb - bh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[401.705614, "o", "\u001b[?2004h"]
[401.705691, "o", "> "]
[401.705814, "o", "        acc = tl.dot(ah, bh, acc)\r\n\u001b[?2004l\r"]
[401.705841, "o", "\u001b[?2004h"]
[401.705967, "o", "> "]
[401.706121, "o", "        acc = tl.dot(ah, bl, acc)\r\n\u001b[?2004l\r"]
[401.706214, "o", "\u001b[?2004h> "]
[401.706438, "o", "        acc = tl.dot(al, bh, acc)\r\n\u001b[?2004l\r"]
[401.706523, "o", "\u001b[?2004h"]
[401.706548, "o", "> "]
[401.706708, "o", "        xp += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h"]
[401.706774, "o", "> "]
[401.706917, "o", "        wp += BK * swk\r\n\u001b[?2004l\r"]
[401.706949, "o", "\u001b[?2004h"]
[401.707027, "o", "> "]
[401.707231, "o", "    bias = tl.load(b_ptr + offs_n)\r\n\u001b[?2004l\r"]
[401.707261, "o", "\u001b[?2004h"]
[401.707323, "o", "> "]
[401.707588, "o", "    acc = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r"]
[401.707621, "o", "\u001b[?2004h"]
[401.70773, "o", "> "]
[401.708148, "o", "    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.708393, "o", "    tl.store(op, acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[401.708543, "o", "\u001b[?2004h> "]
[401.708735, "o", "def run1(cfg, warps, stages):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.708977, "o", "    BM, BN, BK, GM = cfg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.709338, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[401.709478, "o", "\u001b[?2004h> "]
[401.709573, "o", "    def f():\r\n\u001b[?2004l\r"]
[401.709616, "o", "\u001b[?2004h> "]
[401.710804, "o", "        k_split_inplace[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[401.710843, "o", "\u001b[?2004h"]
[401.710857, "o", "> "]
[401.710994, "o", "    return f\r\n\u001b[?2004l\r\u001b[?2004h"]
[401.711088, "o", "> \r\n\u001b[?2004l\r"]
[401.711159, "o", "\u001b[?2004h> "]
[401.711259, "o", "cfgs = [\r\n\u001b[?2004l\r"]
[401.711359, "o", "\u001b[?2004h> "]
[401.711547, "o", "    ((128,128,64,8), 8, 3),\r\n\u001b[?2004l\r"]
[401.71164, "o", "\u001b[?2004h> "]
[401.711848, "o", "    ((128,128,64,8), 8, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[401.711928, "o", "> "]
[401.712095, "o", "    ((128,256,64,8), 8, 2),\r\n\u001b[?2004l\r"]
[401.712123, "o", "\u001b[?2004h"]
[401.712192, "o", "> "]
[401.712433, "o", "    ((256,128,64,8), 8, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.712636, "o", "    ((256,256,32,8), 8, 3),\r\n\u001b[?2004l\r"]
[401.712669, "o", "\u001b[?2004h"]
[401.712806, "o", "> "]
[401.712993, "o", "    ((256,256,64,8), 16, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.713256, "o", "    ((128,128,32,8), 8, 4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[401.713355, "o", "> "]
[401.713517, "o", "    ((128,256,32,8), 8, 3),\r\n\u001b[?2004l\r"]
[401.713549, "o", "\u001b[?2004h"]
[401.713681, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.713863, "o", "for cfg, wp, st in cfgs:\r\n\u001b[?2004l\r"]
[401.71393, "o", "\u001b[?2004h"]
[401.713961, "o", "> "]
[401.714061, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.71435, "o", "        f = run1(cfg, wp, st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.714489, "o", "        f()\r\n\u001b[?2004l\r\u001b[?2004h"]
[401.714565, "o", "> "]
[401.714814, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.715257, "o", "        ms = triton.testing.do_bench(f, warmup=10, rep=30)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.715704, "o", "        print(f\"fp16split-inplace {cfg} w{wp} s{st}: {ms:.3f} ms\")\r\n\u001b[?2004l\r"]
[401.715779, "o", "\u001b[?2004h"]
[401.715812, "o", "> "]
[401.715978, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[401.716004, "o", "\u001b[?2004h"]
[401.716114, "o", "> "]
[401.716551, "o", "        print(f\"fp16split-inplace {cfg} w{wp} s{st}: FAIL {str(e)[:100]}\")\r\n\u001b[?2004l\r"]
[401.716581, "o", "\u001b[?2004h"]
[401.716709, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.717007, "o", "# accuracy of best inplace variant\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.717436, "o", "y64 = (x.double() @ w.double().t() + b.double()) * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.717708, "o", "f = run1((128,128,64,8), 8, 3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.717933, "o", "f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[401.718029, "o", "\u001b[?2004h> "]
[401.718515, "o", "print(\"inplace err vs fp64:\", (out.double()-y64).abs().max().item())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.718612, "o", "EOF\r\n\u001b[?2004l\r"]
[401.723392, "o", "\u001b[?2004hroot@modal:/workspace# "]
