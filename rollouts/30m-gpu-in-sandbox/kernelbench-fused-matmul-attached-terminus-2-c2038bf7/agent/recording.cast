[1335.971821, "o", "> "]
[1335.972476, "o", "        k_tma[grid](x, w, b, out, M, N, K, 1.5, BM, BN, BK, GM, NSM=132, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r"]
[1335.972504, "o", "\u001b[?2004h"]
