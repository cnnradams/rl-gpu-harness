[1058.888334, "o", "    ((256,256,16,8),8,3), ((128,256,16,8),8,4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1058.888385, "o", "]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1058.888453, "o", "> "]
