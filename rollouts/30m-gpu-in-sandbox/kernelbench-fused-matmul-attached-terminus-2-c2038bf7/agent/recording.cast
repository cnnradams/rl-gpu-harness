[886.360076, "o", "\u001b[?2004h> "]
[886.360198, "o", "    tl.store(op, acc)\r\n\u001b[?2004l\r"]
[886.360224, "o", "\u001b[?2004h"]
[886.360297, "o", "> \r\n\u001b[?2004l\r"]
[886.360324, "o", "\u001b[?2004h"]
[886.360336, "o", "> "]
[886.360564, "o", "BM, BN, BK, GM = 128, 256, 32, 8\r\n\u001b[?2004l\r"]
[886.360611, "o", "\u001b[?2004h"]
[886.36066, "o", "> "]
[886.360966, "o", "grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[886.36099, "o", "\u001b[?2004h"]
[886.361111, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.361284, "o", "def run_new(x, w, b, ip):\r\n\u001b[?2004l\r"]
