[886.36242, "o", "    k_tf32[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, ip, num_warps=8, num_stages=4)\r\n\u001b[?2004l\r"]
