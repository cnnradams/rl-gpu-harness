[1335.970912, "o", "for cfg, wp, st in [((128,128,64,8),8,3), ((128,128,64,8),8,4), ((128,256,64,8),8,3), ((256,128,64,8),8,3), ((128,128,32,8),8,4)]:\r\n\u001b[?2004l\r"]
