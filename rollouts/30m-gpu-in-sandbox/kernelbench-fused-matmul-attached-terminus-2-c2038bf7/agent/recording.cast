[1251.768559, "i", "cat > /tmp/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport triton.testing\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\ny64 = (x.double() @ w.double().t() + b.double()) * 1.5\n\n# ---- in-kernel split, dual acc ----\n@triton.jit\ndef k_inl(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n          sxm, sxk, swn, swk, som, son, scale,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk"]
[1251.768746, "i", "\n    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\n    acch = tl.zeros((BM, BN), dtype=tl.float32)\n    accl = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb = tl.load(wp)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        bh = bb.to(tl.float16)\n        bl = (bb - bh.to(tl.float32)).to(tl.float16)\n        acch = tl.dot(ah, bh, acch)\n        accl = tl.dot(ah, bl, accl)\n        accl = tl.dot(al, bh, accl)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acch + accl + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\nfor cfg, wp, st in [((128,128,64,8),8,3), ((128,128,64,8),8,2), ((128,256,64,8),8,2), ((64,256,64,8),8,3), ((128,128,32,8),8,4), ((128,64,64,8),8,3), ((64,128,64,8),8,3)]:\n    BM, BN, BK, GM = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k_inl[grid](x"]
[1251.768906, "i", ", w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, num_warps=wp, num_stages=st)\n    try:\n        f(); torch.cuda.synchronize()\n        err = (out.double()-y64).abs().max().item()\n        ms = triton.testing.do_bench(f, warmup=10, rep=30)\n        print(f\"inl {cfg} w{wp} s{st}: {ms:.3f} ms err={err:.2e}\")\n    except Exception as e:\n        print(f\"inl {cfg} w{wp} s{st}: FAIL {str(e)[:60]}\")\nEOF\npython3 /tmp/bench5.py > /tmp/bench5.log 2>&1; grep -E \"^inl\" /tmp/bench5.log\n"]
[1251.768945, "o", "cat > /tmp/bench5.py << 'EOF'\r\n\u001b[?2004l\r"]
[1251.76914, "o", "\u001b[?2004h> "]
[1251.769368, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[1251.769401, "o", "\u001b[?2004h"]
[1251.76953, "o", "> "]
[1251.769603, "o", "import triton.testing\r\n\u001b[?2004l\r"]
[1251.769628, "o", "\u001b[?2004h"]
[1251.769733, "o", "> "]
[1251.769849, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[1251.769936, "o", "\u001b[?2004h> "]
[1251.770082, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[1251.770104, "o", "\u001b[?2004h"]
[1251.770174, "o", "> "]
[1251.770373, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[1251.770459, "o", "\u001b[?2004h> "]
[1251.77068, "o", "w = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[1251.770706, "o", "\u001b[?2004h"]
[1251.770778, "o", "> "]
[1251.770964, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[1251.770992, "o", "\u001b[?2004h"]
[1251.771085, "o", "> "]
[1251.771348, "o", "out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.771759, "o", "y64 = (x.double() @ w.double().t() + b.double()) * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1251.77182, "o", "\u001b[?2004h"]
[1251.77189, "o", "> "]
[1251.772085, "o", "# ---- in-kernel split, dual acc ----\r\n\u001b[?2004l\r"]
[1251.772112, "o", "\u001b[?2004h"]
[1251.772252, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1251.772299, "o", "\u001b[?2004h"]
[1251.772358, "o", "> "]
[1251.772649, "o", "def k_inl(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\r\n\u001b[?2004l\r"]
[1251.772675, "o", "\u001b[?2004h"]
[1251.772802, "o", "> "]
[1251.773072, "o", "          sxm, sxk, swn, swk, som, son, scale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.773623, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1251.773674, "o", "\u001b[?2004h"]
[1251.773699, "o", "> "]
[1251.773873, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1251.774021, "o", "\u001b[?2004h> "]
[1251.774221, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1251.77429, "o", "\u001b[?2004h"]
[1251.774352, "o", "> "]
[1251.77454, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1251.774662, "o", "\u001b[?2004h> "]
[1251.774873, "o", "    npg = GROUP_M * num_pid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.775048, "o", "    gid = pid // npg\r\n\u001b[?2004l\r"]
[1251.775146, "o", "\u001b[?2004h> "]
[1251.775269, "o", "    fm = gid * GROUP_M\r\n\u001b[?2004l\r"]
[1251.775432, "o", "\u001b[?2004h> "]
[1251.77571, "o", "    gs = min(num_pid_m - fm, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.775939, "o", "    pid_m = fm + ((pid % npg) % gs)\r\n\u001b[?2004l\r"]
[1251.776066, "o", "\u001b[?2004h"]
[1251.776098, "o", "> "]
[1251.776323, "o", "    pid_n = (pid % npg) // gs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.776606, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1251.776688, "o", "\u001b[?2004h> "]
[1251.777065, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1251.777117, "o", "> "]
[1251.777488, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1251.777563, "o", "> "]
[1251.77806, "o", "    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\r\n\u001b[?2004l\r\u001b[?2004h"]
[1251.778137, "o", "> "]
[1251.778666, "o", "    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\r\n\u001b[?2004l\r\u001b[?2004h"]
[1251.778748, "o", "> "]
[1251.779088, "o", "    acch = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.7794, "o", "    accl = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1251.779475, "o", "\u001b[?2004h> "]
[1251.779727, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[1251.779775, "o", "\u001b[?2004h"]
[1251.779847, "o", "> "]
[1251.779974, "o", "        a = tl.load(xp)\r\n\u001b[?2004l\r"]
[1251.780001, "o", "\u001b[?2004h"]
[1251.780128, "o", "> "]
[1251.780218, "o", "        bb = tl.load(wp)\r\n\u001b[?2004l\r"]
[1251.780245, "o", "\u001b[?2004h"]
[1251.780298, "o", "> "]
[1251.780554, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.780888, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1251.780914, "o", "\u001b[?2004h"]
[1251.781036, "o", "> "]
[1251.781171, "o", "        bh = bb.to(tl.float16)\r\n\u001b[?2004l\r"]
[1251.781195, "o", "\u001b[?2004h"]
[1251.781283, "o", "> "]
[1251.781629, "o", "        bl = (bb - bh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1251.781749, "o", "\u001b[?2004h> "]
[1251.782018, "o", "        acch = tl.dot(ah, bh, acch)\r\n\u001b[?2004l\r"]
[1251.782089, "o", "\u001b[?2004h"]
[1251.782115, "o", "> "]
[1251.782369, "o", "        accl = tl.dot(ah, bl, accl)\r\n\u001b[?2004l\r"]
[1251.782479, "o", "\u001b[?2004h> "]
[1251.782685, "o", "        accl = tl.dot(al, bh, accl)\r\n\u001b[?2004l\r"]
[1251.782712, "o", "\u001b[?2004h"]
[1251.782813, "o", "> "]
[1251.782917, "o", "        xp += BK * sxk\r\n\u001b[?2004l\r"]
[1251.782979, "o", "\u001b[?2004h> "]
[1251.783207, "o", "        wp += BK * swk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.783505, "o", "    bias = tl.load(b_ptr + offs_n)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.783818, "o", "    acc = (acch + accl + bias[None, :]) * scale\r\n\u001b[?2004l\r"]
[1251.783891, "o", "\u001b[?2004h> "]
[1251.78437, "o", "    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.784581, "o", "    tl.store(op, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.784639, "o", "\r\n\u001b[?2004l\r"]
[1251.784656, "o", "\u001b[?2004h> "]
[1251.785761, "o", "for cfg, wp, st in [((128,128,64,8),8,3), ((128,128,64,8),8,2), ((128,256,64,8),8,2), ((64,256,64,8),8,3), ((128,128,32,8),8,4), ((128,64,64,8),8,3), ((64,128,64,8),8,3)]:\r\n\u001b[?2004l\r"]
[1251.785874, "o", "\u001b[?2004h> "]
[1251.786014, "o", "    BM, BN, BK, GM = cfg\r\n\u001b[?2004l\r"]
[1251.786043, "o", "\u001b[?2004h"]
[1251.786061, "o", "> "]
[1251.786507, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[1251.787876, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.789055, "o", "        k_inl[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1251.78915, "o", "> "]
[1251.789205, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1251.78923, "o", "> "]
[1251.789542, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.789927, "o", "        err = (out.double()-y64).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1251.790322, "o", "        ms = triton.testing.do_bench(f, warmup=10, rep=30)\r\n\u001b[?2004l\r"]
[1251.790357, "o", "\u001b[?2004h"]
[1251.79037, "o", "> "]
[1251.790812, "o", "        print(f\"inl {cfg} w{wp} s{st}: {ms:.3f} ms err={err:.2e}\")\r\n\u001b[?2004l\r"]
[1251.790865, "o", "\u001b[?2004h"]
[1251.790923, "o", "> "]
[1251.791073, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[1251.791098, "o", "\u001b[?2004h"]
[1251.791226, "o", "> "]
[1251.791531, "o", "        print(f\"inl {cfg} w{wp} s{st}: FAIL {str(e)[:60]}\")\r\n\u001b[?2004l\r"]
[1251.791557, "o", "\u001b[?2004h"]
[1251.791683, "o", "> EOF\r\n\u001b[?2004l\r"]
[1251.795068, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1251.795562, "o", "python3 /tmp/bench5.py > /tmp/bench5.log 2>&1; grep -E \"^inl\" /tmp/bench5.log\r\n\u001b[?2004l\r"]
[1259.727258, "o", "\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (128, 128, 64, 8) w8 s3: 3.700 ms err=4.22e-02\r\n\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (128, 128, 64, 8) w8 s2: 4.740 ms err=4.22e-02\r\n\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (128, 256, 64, 8) w8 s2: 21.555 ms err=4.22e-02\r\n\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (64, 256, 64, 8) w8 s3: 22.391 ms err=4.22e-02\r\n\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (128, 128, 32, 8) w8 s4: 4.087 ms err=4.22e-02\r\n\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (128, 64, 64, 8) w8 s3: 4.813 ms err=4.22e-02\r\n\u001b[01;31m\u001b[Kinl\u001b[m\u001b[K (64, 128, 64, 8) w8 s3: 14.427 ms err=4.22e-02\r\n"]
[1259.72767, "o", "\u001b[?2004h"]
[1259.727791, "o", "root@modal:/workspace# "]
[1335.956593, "i", "cat > /tmp/tma.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport triton.testing\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\ny64 = (x.double() @ w.double().t() + b.double()) * 1.5\n\n@triton.jit\ndef k_tma(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K, scale,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr, NSM: tl.constexpr):\n    x_desc = tl.make_tensor_descriptor(x_ptr, [M, K], [K, 1], [BM, BK])\n    w_desc = tl.make_tensor_descriptor(w_ptr, [N, K], [K, 1], [BN, BK])\n    o_desc = tl.make_tensor_descriptor(out_ptr, [M, N], [N, 1], [BM, BN])\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    om = pid_m * BM\n  "]
[1335.956865, "i", "  on = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = x_desc.load([om, k])\n        bb = w_desc.load([on, k])\n        acc = tl.dot(a, bb.T, acc, input_precision=\"tf32x3\")\n    bias = tl.load(b_ptr + on + tl.arange(0, BN))\n    acc = (acc + bias[None, :]) * scale\n    o_desc.store([om, on], acc)\n\ndef alloc_fn(size, alignment, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\nfor cfg, wp, st in [((128,128,64,8),8,3), ((128,128,64,8),8,4), ((128,256,64,8),8,3), ((256,128,64,8),8,3), ((128,128,32,8),8,4)]:\n    BM, BN, BK, GM = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k_tma[grid](x, w, b, out, M, N, K, 1.5, BM, BN, BK, GM, NSM=132, num_warps=wp, num_stages=st)\n    try:\n        f(); torch.cuda.synchronize()\n        err = (out.double()-y64).abs().max().item()\n        ms = triton.testing.do_bench(f, warmup=10, rep=30)\n        print(f\"tma {cfg} w{wp} s{st}: {ms:.3f} ms err={err:.2"]
[1335.95689, "i", "e}\")\n    except Exception as e:\n        print(f\"tma {cfg} w{wp} s{st}: FAIL {str(e)[:80]}\")\nEOF\npython3 /tmp/tma.py > /tmp/tma.log 2>&1; grep -E \"^tma\" /tmp/tma.log\n"]
[1335.956975, "o", "cat > /tmp/tma.py << 'EOF'\r\n"]
[1335.956996, "o", "\u001b[?2004l\r"]
[1335.957192, "o", "\u001b[?2004h> "]
[1335.957495, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[1335.957663, "o", "\u001b[?2004h> "]
[1335.957787, "o", "import triton.testing\r\n\u001b[?2004l\r"]
[1335.957819, "o", "\u001b[?2004h"]
[1335.957833, "o", "> "]
[1335.958046, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[1335.958082, "o", "\u001b[?2004h"]
[1335.958096, "o", "> "]
[1335.958275, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[1335.958309, "o", "\u001b[?2004h"]
[1335.958381, "o", "> "]
[1335.958642, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.958903, "o", "w = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[1335.958982, "o", "\u001b[?2004h"]
[1335.959047, "o", "> "]
[1335.959263, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.959293, "o", "> "]
[1335.959535, "o", "out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r"]
[1335.959564, "o", "\u001b[?2004h"]
[1335.959647, "o", "> "]
[1335.959967, "o", "y64 = (x.double() @ w.double().t() + b.double()) * 1.5\r\n\u001b[?2004l\r"]
[1335.960001, "o", "\u001b[?2004h"]
[1335.960127, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.96025, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.960361, "o", "> "]
[1335.960669, "o", "def k_tma(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1335.960757, "o", "\u001b[?2004h> "]
[1335.961488, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr, NSM: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.962016, "o", "    x_desc = tl.make_tensor_descriptor(x_ptr, [M, K], [K, 1], [BM, BK])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.962497, "o", "    w_desc = tl.make_tensor_descriptor(w_ptr, [N, K], [K, 1], [BN, BK])\r\n\u001b[?2004l\r"]
[1335.962533, "o", "\u001b[?2004h"]
[1335.962546, "o", "> "]
[1335.963094, "o", "    o_desc = tl.make_tensor_descriptor(out_ptr, [M, N], [N, 1], [BM, BN])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.963288, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1335.963315, "o", "\u001b[?2004h"]
[1335.963449, "o", "> "]
[1335.963578, "o", "    num_pid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1335.963658, "o", "\u001b[?2004h"]
[1335.963685, "o", "> "]
[1335.963881, "o", "    num_pid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1335.963924, "o", "\u001b[?2004h> "]
[1335.964145, "o", "    npg = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[1335.964248, "o", "\u001b[?2004h"]
[1335.964322, "o", "> "]
[1335.964361, "o", "    gid = pid // npg\r\n\u001b[?2004l\r"]
[1335.964431, "o", "\u001b[?2004h"]
[1335.964507, "o", "> "]
[1335.964657, "o", "    fm = gid * GROUP_M\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.964712, "o", "> "]
[1335.964946, "o", "    gs = min(num_pid_m - fm, GROUP_M)\r\n\u001b[?2004l\r"]
[1335.965003, "o", "\u001b[?2004h"]
[1335.965097, "o", "> "]
[1335.965296, "o", "    pid_m = fm + ((pid % npg) % gs)\r\n\u001b[?2004l\r"]
[1335.965332, "o", "\u001b[?2004h"]
[1335.965345, "o", "> "]
[1335.965628, "o", "    pid_n = (pid % npg) // gs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.965765, "o", "    om = pid_m * BM\r\n\u001b[?2004l\r"]
[1335.96583, "o", "\u001b[?2004h"]
[1335.96586, "o", "> "]
[1335.965997, "o", "    on = pid_n * BN\r\n\u001b[?2004l\r"]
[1335.966087, "o", "\u001b[?2004h> "]
[1335.966406, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1335.966499, "o", "\u001b[?2004h"]
[1335.966563, "o", "> "]
[1335.966681, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1335.966742, "o", "\u001b[?2004h"]
[1335.966806, "o", "> "]
[1335.966993, "o", "        a = x_desc.load([om, k])\r\n\u001b[?2004l\r"]
[1335.967018, "o", "\u001b[?2004h"]
[1335.967094, "o", "> "]
