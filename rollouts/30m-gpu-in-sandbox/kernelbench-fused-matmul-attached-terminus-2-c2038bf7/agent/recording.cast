[118.483388, "o", "> "]
[118.483583, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.483678, "o", "\u001b[?2004h> "]
[118.484168, "o", "    x_ptrs = x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :] * stride_xk\r\n\u001b[?2004l\r"]
[118.484205, "o", "\u001b[?2004h"]
[118.484225, "o", "> "]
[118.484744, "o", "    w_ptrs = w_ptr + offs_n[None, :] * stride_wn + offs_k[:, None] * stride_wk\r\n\u001b[?2004l\r"]
[118.484776, "o", "\u001b[?2004h"]
[118.484791, "o", "> "]
[118.484802, "o", "\r\n\u001b[?2004l\r"]
[118.484926, "o", "\u001b[?2004h> "]
[118.485202, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[118.485233, "o", "\u001b[?2004h"]
[118.485316, "o", "> "]
[118.485552, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[118.485585, "o", "\u001b[?2004h"]
[118.485668, "o", "> "]
[118.485841, "o", "        a = tl.load(x_ptrs)\r\n\u001b[?2004l\r"]
[118.485873, "o", "\u001b[?2004h"]
[118.486008, "o", "> "]
[118.486093, "o", "        b = tl.load(w_ptrs)\r\n\u001b[?2004l\r"]
[118.486176, "o", "\u001b[?2004h> "]
[118.486634, "o", "        acc = tl.dot(a, b, acc, input_precision=\"tf32x3\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.48692, "o", "        x_ptrs += BK * stride_xk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.487209, "o", "        w_ptrs += BK * stride_wk\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.487244, "o", "\u001b[?2004h"]
[118.487312, "o", "> "]
[118.48755, "o", "    bias = tl.load(b_ptr + offs_n)\r\n\u001b[?2004l\r"]
[118.48758, "o", "\u001b[?2004h"]
[118.487663, "o", "> "]
[118.487951, "o", "    acc = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[118.488023, "o", "\u001b[?2004h"]
[118.488057, "o", "> "]
[118.48864, "o", "    out_ptrs = out_ptr + offs_m[:, None] * stride_om + offs_n[None, :] * stride_on\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.488848, "o", "    tl.store(out_ptrs, acc)\r\n\u001b[?2004l\r"]
[118.488877, "o", "\u001b[?2004h"]
[118.48895, "o", "> \r\n\u001b[?2004l\r"]
[118.489017, "o", "\u001b[?2004h"]
[118.489093, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.489349, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.489769, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[118.4898, "o", "\u001b[?2004h"]
[118.489926, "o", "> "]
[118.490105, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[118.490168, "o", "\u001b[?2004h> "]
[118.490572, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[118.490602, "o", "\u001b[?2004h"]
[118.490686, "o", "> "]
[118.490996, "o", "        self.scaling_factor = float(scaling_factor)\r\n\u001b[?2004l\r"]
[118.491029, "o", "\u001b[?2004h"]
[118.491146, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.491324, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[118.491383, "o", "\u001b[?2004h"]
[118.491412, "o", "> "]
[118.491629, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[118.491659, "o", "\u001b[?2004h"]
[118.49175, "o", "> "]
[118.491922, "o", "        bias = self.matmul.bias\r\n\u001b[?2004l\r"]
[118.492069, "o", "\u001b[?2004h> "]
[118.492138, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[118.49219, "o", "\u001b[?2004h"]
[118.492206, "o", "> "]
[118.492379, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r"]
[118.492449, "o", "\u001b[?2004h> "]
[118.492974, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.493531, "o", "        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r"]
[118.493559, "o", "\u001b[?2004h"]
[118.49367, "o", "> "]
[118.493905, "o", "        _linear_scale_kernel[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.494162, "o", "            x, w, bias, out, M, N, K,\r\n\u001b[?2004l\r"]
[118.494243, "o", "\u001b[?2004h"]
[118.494315, "o", "> "]
[118.494498, "o", "            x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[118.494566, "o", "\u001b[?2004h> "]
[118.494889, "o", "            w.stride(0), w.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.495223, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.495488, "o", "            1.0 + self.scaling_factor,\r\n\u001b[?2004l\r"]
[118.495519, "o", "\u001b[?2004h"]
[118.49562, "o", ">         )\r\n\u001b[?2004l\r"]
[118.495689, "o", "\u001b[?2004h> "]
[118.49584, "o", "        return out\r\n\u001b[?2004l\r"]
[118.495869, "o", "\u001b[?2004h"]
[118.495951, "o", "> EOF\r\n\u001b[?2004l\r"]
[118.49953, "o", "\u001b[?2004h"]
