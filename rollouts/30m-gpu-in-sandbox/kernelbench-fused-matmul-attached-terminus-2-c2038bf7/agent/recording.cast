[1178.28394, "o", "\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 8) w8 s2: 6.579 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 8) w8 s4: FAIL out of resource: shared memory, Required: 262144, Hardware l\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 4) w8 s3: 5.793 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 12) w8 s3: 5.796 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 16) w8 s3: 5.800 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 8) w4 s3: 18.339 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (256, 128, 64, 8) w8 s2: 10.563 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (256, 128, 64, 8) w8 s3: FAIL out of resource: shared memory, Required: 262144, Hardware l\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (64, 256, 64, 8) w8 s3: FAIL out of resource: shared memory, Required: 294912, Hardware l\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (64, 256, 64, 8) w4 s3: FAIL out of resource: shared memory, Required: 294912, Hardware l\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 128, 8) w8 s2: FAIL out of resource: shared memory, Required: 262144, Hardware l\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (64, 128, 64, 8) w4 s4: 8.330 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128,"]
[1178.284018, "o", " 256, 64, 8) w8 s2: 11.526 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (256, 64, 64, 8) w8 s3: 9.948 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (64, 64, 64, 8) w4 s4: 10.409 ms\r\n\u001b[01;31m\u001b[KBEST\u001b[m\u001b[K: (5.792652797698975, (128, 128, 64, 4), 8, 3)\r\n"]
