[956.876738, "i", "cat > /tmp/dbg.py << 'EOF'\nimport torch, triton, triton.language as tl\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\n\n@triton.jit\ndef k_tf32(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n           sxm, sxk, swn, swk, som, son, scale,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n           GROUP_M: tl.constexpr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\n    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\n    acc = tl.zeros((BM"]
[956.877024, "i", ", BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb = tl.load(wp)\n        acc = tl.dot(a, bb, acc, input_precision=IP)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\nBM, BN, BK, GM = 128, 256, 32, 8\ngrid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\nprint('grid', grid)\nk_tf32[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, \"tf32\", num_warps=8, num_stages=4)\ntorch.cuda.synchronize()\ny_ref = (torch.nn.functional.linear(x, w, b)) * 1.5\nd = (y_ref - out).abs()\nprint('max diff:', d.max().item(), 'mean:', d.mean().item())\ntol = 1e-4 + 1e-4 * y_ref.abs()\nprint('violations:', (d > tol).sum().item(), '/', d.numel())\nprint('sample ref:', y_ref[0, :4].tolist())\nprint('sample new:', out[0, :4].tolist())\nEOF\npython3 /tmp/dbg.py 2>/dev/"]
