[118.968396, "i", "cat > /tmp/sanity.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\n\ntorch.manual_seed(42)\ninit = get_init_inputs()\nref = Model(*init).cuda()\ntorch.manual_seed(42)\nnew = ModelNew(*init).cuda()\n\nfor t in range(5):\n    torch.manual_seed(100 + t)\n    x = torch.rand(16384, 4096, device='cuda')\n    with torch.no_grad():\n        y_ref = ref(x)\n        y_new = new(x)\n        y64 = ((x.double() @ ref.matmul.weight.double().t() + ref.matmul.bias.double()) * 1.5)\n    d = (y_ref - y_new).abs()\n    err64 = (y_new.double() - y64).abs().max().item()\n    tol = 1e-4 + 1e-4 * y_ref.abs()\n    print(f\"trial {t}: max_diff={d.max().item():.3e} allclose={bool((d <= tol).all())} vs_fp64={err64:.3e}\")\nEOF\npython3 /tmp/sanity.py\n"]
