[1073.158304, "o", "\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 32, 8) w8 s4: 6.863 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 32, 8) w8 s5: 6.696 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 32, 8) w8 s6: 6.666 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 256, 32, 8) w8 s3: 9.784 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 256, 32, 8) w8 s4: 9.842 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 256, 32, 4) w8 s3: 9.785 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (256, 128, 32, 8) w8 s3: 11.901 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (256, 128, 32, 8) w8 s4: 11.778 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 64, 8) w8 s3: 5.793 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 128, 16, 8) w8 s6: 9.183 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (64, 128, 32, 8) w4 s5: 10.284 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 64, 32, 8) w4 s5: 6.697 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (256, 256, 16, 8) w8 s3: 131.233 ms\r\n\u001b[01;31m\u001b[Ktf32x3\u001b[m\u001b[K (128, 256, 16, 8) w8 s4: 12.337 ms\r\n\u001b[01;31m\u001b[KBEST\u001b[m\u001b[K: (5.793177604675293, (128, 128, 64, 8), 8, 3)\r\n"]
[1073.158888, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1160.307747, "i", "cat > /tmp/sweep4.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport triton.testing\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nout = torch.empty(M, N, device='cuda')\n\n@triton.jit\ndef k3(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n       sxm, sxk, swn, swk, som, son, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n       GROUP_M: tl.constexpr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\n    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\n    acc = tl."]
[1160.308021, "i", "zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb = tl.load(wp)\n        acc = tl.dot(a, bb, acc, input_precision=IP)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\nresults = []\nfor cfg, wp, st in [\n    ((128,128,64,8),8,2), ((128,128,64,8),8,4), ((128,128,64,4),8,3), ((128,128,64,12),8,3), ((128,128,64,16),8,3),\n    ((128,128,64,8),4,3), ((256,128,64,8),8,2), ((256,128,64,8),8,3), ((64,256,64,8),8,3), ((64,256,64,8),4,3),\n    ((128,128,128,8),8,2), ((64,128,64,8),4,4), ((128,256,64,8),8,2), ((256,64,64,8),8,3), ((64,64,64,8),4,4),\n]:\n    BM, BN, BK, GM = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k3[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, \"tf32x3\", num_warps=wp, num_s"]
[1160.308095, "i", "tages=st)\n    try:\n        f(); torch.cuda.synchronize()\n        ms = triton.testing.do_bench(f, warmup=10, rep=30)\n        results.append((ms, cfg, wp, st))\n        print(f\"tf32x3 {cfg} w{wp} s{st}: {ms:.3f} ms\")\n    except Exception as e:\n        print(f\"tf32x3 {cfg} w{wp} s{st}: FAIL {str(e)[:60]}\")\nresults.sort()\nprint('BEST:', results[0] if results else None)\nEOF\npython3 /tmp/sweep4.py > /tmp/sweep4.log 2>&1; grep -E \"tf32x3|BEST\" /tmp/sweep4.log\n"]
