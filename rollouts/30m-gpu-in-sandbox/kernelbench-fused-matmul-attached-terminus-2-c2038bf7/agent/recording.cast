[886.355048, "o", "> "]
[886.355241, "o", "    offs_m = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[886.355344, "o", "\u001b[?2004h> "]
[886.355603, "o", "    offs_n = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[886.355628, "o", "\u001b[?2004h"]
[886.355717, "o", "> "]
[886.355875, "o", "    offs_k = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[886.355939, "o", "\u001b[?2004h> "]
[886.356343, "o", "    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\r\n\u001b[?2004l\r"]
[886.356383, "o", "\u001b[?2004h"]
[886.356448, "o", "> "]
[886.35682, "o", "    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\r\n\u001b[?2004l\r"]
[886.356846, "o", "\u001b[?2004h"]
[886.356944, "o", "> "]
[886.357197, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[886.357224, "o", "\u001b[?2004h"]
[886.357282, "o", "> "]
[886.357527, "o", "    for _ in range(0, tl.cdiv(K, BK)):\r\n\u001b[?2004l\r"]
[886.357553, "o", "\u001b[?2004h"]
[886.357638, "o", "> "]
[886.357761, "o", "        a = tl.load(xp)\r\n\u001b[?2004l\r"]
[886.357787, "o", "\u001b[?2004h"]
