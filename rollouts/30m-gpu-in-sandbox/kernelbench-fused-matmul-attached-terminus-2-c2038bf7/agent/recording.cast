[886.363563, "o", "\u001b[?2004h> "]
[886.363697, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[886.363721, "o", "\u001b[?2004h"]
[886.363806, "o", "> "]
[886.363938, "o", "    for s in range(200):\r\n\u001b[?2004l\r"]
[886.363965, "o", "\u001b[?2004h"]
[886.364053, "o", "> "]
[886.364244, "o", "        torch.manual_seed(2000 + s)\r\n\u001b[?2004l\r"]
[886.364314, "o", "\u001b[?2004h"]
[886.364338, "o", "> "]
[886.364608, "o", "        xs = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[886.364634, "o", "\u001b[?2004h"]
[886.364724, "o", "> "]
[886.364961, "o", "        ws = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[886.365017, "o", "\u001b[?2004h"]
[886.365069, "o", "> "]
[886.365304, "o", "        bs = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[886.365363, "o", "\u001b[?2004h> "]
[886.365684, "o", "        lin.weight.copy_(ws); lin.bias.copy_(bs)\r\n\u001b[?2004l\r"]
[886.365732, "o", "\u001b[?2004h"]
[886.365781, "o", "> "]
[886.365989, "o", "        # exact reference numerics\r\n\u001b[?2004l\r"]
[886.366048, "o", "\u001b[?2004h"]
[886.366103, "o", "> "]
[886.3662, "o", "        y = lin(xs)\r\n\u001b[?2004l\r"]
[886.36626, "o", "\u001b[?2004h> "]
[886.366474, "o", "        o = y.clone().detach()\r\n\u001b[?2004l\r"]
[886.366499, "o", "\u001b[?2004h"]
[886.366589, "o", "> "]
[886.366731, "o", "        y_ref = y * 0.5 + o\r\n\u001b[?2004l\r"]
[886.366756, "o", "\u001b[?2004h"]
[886.366855, "o", "> "]
[886.367098, "o", "        run_new(xs, ws, bs, \"tf32\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.367321, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[886.36735, "o", "\u001b[?2004h"]
[886.367464, "o", "> "]
[886.367575, "o", "        y_new = out.clone()\r\n\u001b[?2004l\r"]
[886.367678, "o", "\u001b[?2004h> "]
[886.367867, "o", "        d = (y_ref - y_new).abs()\r\n\u001b[?2004l\r"]
[886.367942, "o", "\u001b[?2004h> "]
[886.368258, "o", "        tol = 1e-4 + 1e-4 * y_ref.abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.368499, "o", "        bad = (d > tol).sum().item()\r\n\u001b[?2004l\r"]
[886.368525, "o", "\u001b[?2004h"]
[886.368622, "o", "> "]
[886.368711, "o", "        nfail += bad\r\n\u001b[?2004l\r"]
[886.368779, "o", "\u001b[?2004h> "]
[886.369092, "o", "        ratio = (d / tol).max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.369363, "o", "        if ratio > worst_ratio:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.369581, "o", "            worst_ratio = ratio\r\n\u001b[?2004l\r"]
[886.369632, "o", "\u001b[?2004h"]
[886.369654, "o", "> "]
[886.369977, "o", "            worst_diff = d.max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[886.370611, "o", "print(f\"tf32: worst ratio={worst_ratio:.4f} worst_diff={worst_diff:.3e} total_violations={nfail}\")\r\n\u001b[?2004l\r"]
[886.370637, "o", "\u001b[?2004h"]
[886.370728, "o", "> EOF\r\n\u001b[?2004l\r"]
[886.373999, "o", "\u001b[?2004h"]
[886.37406, "o", "root@modal:/workspace# "]
