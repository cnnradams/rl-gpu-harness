[688.307132, "i", "cat > /tmp/tf32test.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport triton.testing\n\nM, N, K = 16384, 4096, 4096\nout = torch.empty(M, N, device='cuda')\n\n@triton.jit\ndef k_tf32(x_ptr, w_ptr, b_ptr, out_ptr, M, N, K,\n           sxm, sxk, swn, swk, som, son, scale,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n           GROUP_M: tl.constexpr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM)\n    num_pid_n = tl.cdiv(N, BN)\n    npg = GROUP_M * num_pid_n\n    gid = pid // npg\n    fm = gid * GROUP_M\n    gs = min(num_pid_m - fm, GROUP_M)\n    pid_m = fm + ((pid % npg) % gs)\n    pid_n = (pid % npg) // gs\n    offs_m = pid_m * BM + tl.arange(0, BM)\n    offs_n = pid_n * BN + tl.arange(0, BN)\n    offs_k = tl.arange(0, BK)\n    xp = x_ptr + offs_m[:, None] * sxm + offs_k[None, :] * sxk\n    wp = w_ptr + offs_n[None, :] * swn + offs_k[:, None] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K, BK)):\n        a = tl.load(xp)\n        bb"]
[688.307427, "i", " = tl.load(wp)\n        acc = tl.dot(a, bb, acc, input_precision=IP)\n        xp += BK * sxk\n        wp += BK * swk\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    op = out_ptr + offs_m[:, None] * som + offs_n[None, :] * son\n    tl.store(op, acc)\n\ndef make(x, w, b, cfg, warps, stages, ip):\n    BM, BN, BK, GM = cfg\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k_tf32[grid](x, w, b, out, M, N, K, x.stride(0), x.stride(1), w.stride(0), w.stride(1), out.stride(0), out.stride(1), 1.5, BM, BN, BK, GM, ip, num_warps=warps, num_stages=stages)\n    return f\n\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nfor cfg, wp, st in [((128,128,64,8),8,4), ((128,256,64,8),8,3), ((256,128,64,8),8,3), ((128,128,64,8),8,3), ((128,256,32,8),8,4), ((64,256,64,8),4,4)]:\n    try:\n        f = make(x, w, b, cfg, wp, st, \"tf32\")\n        f(); torch.cuda.synchronize()\n        ms = triton.testing.do_bench(f,"]
[688.307539, "o", "cat > /tmp/tf32test.py << 'EOF'\r\n\u001b[?2004l\r"]
[688.307628, "i", " warmup=10, rep=30)\n        print(f\"tf32 {cfg} w{wp} s{st}: {ms:.3f} ms\")\n    except Exception as e:\n        print(f\"tf32 {cfg} w{wp} s{st}: FAIL {str(e)[:90]}\")\n\n# accuracy vs fp32 reference over many seeds\nlin = torch.nn.Linear(K, N).cuda()\nworst_ratio = 0.0\nworst_diff = 0.0\nwith torch.no_grad():\n    for s in range(100):\n        torch.manual_seed(1000 + s)\n        xs = torch.rand(M, K, device='cuda')\n        ws = torch.rand(N, K, device='cuda')\n        bs = torch.rand(N, device='cuda')\n        lin.weight.copy_(ws); lin.bias.copy_(bs)\n        y_ref = lin(xs) * 0.5 + lin(xs).clone().detach()  # emulate ref numerics roughly\n        y_ref = (lin(xs) * 1.5)\n        f = make(xs, ws, bs, (128, 256, 64, 8), 8, 3, \"tf32\")\n        f(); torch.cuda.synchronize()\n        y_new = out.clone()\n        d = (y_ref - y_new).abs()\n        tol = 1e-4 + 1e-4 * y_ref.abs()\n        ratio = (d / tol).max().item()\n        worst_ratio = max(worst_ratio, ratio)\n        worst_diff = max(worst_diff, d.max().item())\nprint(f\"tf32 worst (d"]
[688.307739, "o", "\u001b[?2004h"]
[688.307787, "i", "iff/tol) over 100 seeds: {worst_ratio:.4f}, worst diff: {worst_diff:.3e}\")\nEOF\npython3 /tmp/tf32test.py 2>/dev/null | grep -v Warning\n"]
