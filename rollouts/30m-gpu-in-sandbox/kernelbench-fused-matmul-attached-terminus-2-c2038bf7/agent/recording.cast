[519.492655, "i", "cat > /tmp/acc.py << 'EOF'\nimport torch\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(0)\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\ny64 = (x.double() @ w.double().t() + b.double()) * 1.5\nxh = x.half(); xl = (x - xh.float()).half()\nwh = w.half(); wl = (w - wh.float()).half()\nprint('xl rel mag:', (xl.abs().max()/x.abs().max()).item())\ny1 = torch.mm(xh, wh.t()).float()\ny2 = torch.mm(xh, wl.t()).float()\ny3 = torch.mm(xl, wh.t()).float()\ny4 = torch.mm(xl, wl.t()).float()\ny = (y1 + y2 + y3 + b.float()) * 1.5\nprint('3-term err:', ((y1+y2+y3+b.float())*1.5).double().sub(y64).abs().max().item())\ny = (y1 + y2 + y3 + y4 + b.float()) * 1.5\nprint('4-term err:', (y.double()-y64).abs().max().item())\nEOF\npython3 /tmp/acc.py\n"]
