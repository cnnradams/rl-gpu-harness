[1028.866912, "i", "cat > /tmp/emu.py << 'EOF'\nimport torch\ntry:\n    from torch.backends.cuda.matmul import fp32_precision\n    print('fp32_precision available')\nexcept Exception as e:\n    print('no fp32_precision:', e)\ntry:\n    from torch.backends.cuda import SDPAParams\nexcept Exception:\n    pass\ntry:\n    import torch.backends.cuda as bc\n    print([a for a in dir(bc.matmul) if not a.startswith('_')])\nexcept Exception as e:\n    print(e)\ntry:\n    from torch.backends import cublas\n    print([a for a in dir(cublas) if not a.startswith('_')])\nexcept Exception as e:\n    print('no cublas backend module:', e)\nEOF\npython3 /tmp/emu.py\n"]
