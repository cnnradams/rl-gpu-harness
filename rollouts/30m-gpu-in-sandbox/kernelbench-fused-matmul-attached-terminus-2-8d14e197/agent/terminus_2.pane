[?2004hroot@modal:/workspace# cat > /workspace/t4.py << 'EOF'
[?2004l[?2004h> import torch
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _k2(
[?2004l[?2004h>     X, WH, WL, BIAS, OUT,
[?2004l[?2004h>     M, N, K,
[?2004l[?2004h>     sxm, swn, scale,
[?2004l[?2004h>     BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
[?2004l[?2004h>     GROUP_M: tl.constexpr,
[?2004l[?2004h> ):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GROUP_M * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)
[?2004l[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     rn = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     rk = tl.arange(0, BK)
[?2004l[?2004h>     Xp = X + rm[:, None] * sxm + rk[None, :]
[?2004l[?2004h>     WHp = WH + rk[:, None] * swn + rn[None, :]
[?2004l[?2004h>     WLp = WL + rk[:, None] * swn + rn[None, :]
[?2004l[?2004h>     acc1 = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, K, BK):
[?2004l[?2004h>         x = tl.load(Xp)
[?2004l[?2004h>         xh = x.to(tl.float16)
[?2004l[?2004h>         xl = (x - xh.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>         wh = tl.load(WHp)
[?2004l[?2004h>         wl = tl.load(WLp)
[?2004l[?2004h>         acc1 = tl.dot(xh, wh, acc1)
[?2004l[?2004h>         acc1 = tl.dot(xl, wh + wl, acc1)
[?2004l[?2004h>         acc2 = tl.dot(xh, wh, acc2)
[?2004l[?2004h>         Xp += BK
[?2004l[?2004h>         WHp += BK * swn
[?2004l[?2004h>         WLp += BK * swn
[?2004l[?2004h>     bias = tl.load(BIAS + rn)
[?2004l[?2004h>     out = acc1 * scale + (bias - acc2 * scale)
[?2004l[?2004h>     Op = OUT + rm[:, None] * N + rn[None, :]
[?2004l[?2004h>     tl.store(Op, out)
[?2004l[?2004h> 
[?2004l[?2004h> torch.manual_seed(0)
[?2004l[?2004h> dev = 'cuda'
[?2004l[?2004h> M = N = K = 4096; M = 16384
[?2004l[?2004h> x = torch.rand(M, K, device=dev)
[?2004l[?2004h> W = (torch.rand(N, K, device=dev) * 2 - 1) / (K ** 0.5)
[?2004l[?2004h> b = (torch.rand(N, device=dev) * 2 - 1) / (K ** 0.5)
[?2004l[?2004h> scale = 1.5
[?2004l[?2004h> wt = W.t().contiguous()
[?2004l[?2004h> wh = wt.half()
[?2004l[?2004h> wl = (wt - wh.float()).half()
[?2004l[?2004h> bias = b * scale
[?2004l[?2004h> 
[?2004l[?2004h> def run(x, BM=128, BN=128, BK=64, warps=8, stages=4):
[?2004l[?2004h>     out = torch.empty((x.shape[0], N), device=dev, dtype=torch.float32)
[?2004l[?2004h>     grid = (triton.cdiv(x.shape[0], BM) * triton.cdiv(N, BN),)
[?2004l[?2004h>     _k2[grid](x, wh, wl, bias, out, x.shape[0], N, K, x.stride(0), wh.stride(0), scale, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=warps, num_stages=stages)
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> worst = 0.0
[?2004l[?2004h> for seed in range(10):
[?2004l[?2004h>     torch.manual_seed(seed)
[?2004l[?2004h>     x = torch.rand(M, K, device=dev)
[?2004l[?2004h>     y_ref = torch.nn.functional.linear(x, W, b)
[?2004l[?2004h>     y_ref = y_ref * 1.5
[?2004l[?2004h>     y = run(x)
[?2004l[?2004h>     d = (y - y_ref).abs()
