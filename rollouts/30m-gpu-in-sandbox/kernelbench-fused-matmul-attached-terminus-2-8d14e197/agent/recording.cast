[618.73256, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[618.73259, "o", "\u001b[?2004h"]
[618.732687, "o", "> "]
[618.732811, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[618.732835, "o", "\u001b[?2004h"]
