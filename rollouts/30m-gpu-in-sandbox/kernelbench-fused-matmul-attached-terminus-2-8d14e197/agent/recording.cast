[618.733285, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[618.733347, "o", "\u001b[?2004h"]
[618.733388, "o", "> "]
[618.733666, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[618.7337, "o", "\u001b[?2004h"]
[618.733714, "o", "> "]
[618.734004, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[618.734063, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[618.734144, "o", "\u001b[?2004h> "]
[618.734419, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
