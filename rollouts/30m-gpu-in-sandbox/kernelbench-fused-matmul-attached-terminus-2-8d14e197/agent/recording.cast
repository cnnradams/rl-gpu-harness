[618.735122, "o", "> "]
[618.735504, "o", "    Xp = X + rm[:, None] * sxm + rk[None, :] * sxk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.73579, "o", "    WHp = WH + rk[:, None] * swn + rn[None, :]\r\n\u001b[?2004l\r"]
[618.735816, "o", "\u001b[?2004h"]
