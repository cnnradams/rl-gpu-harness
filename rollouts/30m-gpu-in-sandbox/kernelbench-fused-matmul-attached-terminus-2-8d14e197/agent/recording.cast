[1249.63567, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1249.636206, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1249.636599, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1249.636854, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1249.637125, "o", "    ts.sort(); return ts[len(ts)//2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1249.637158, "o", "\u001b[?2004h"]
[1249.637173, "o", "> "]
[1249.637448, "o", "xx = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1249.637713, "o", "y_ref = torch.nn.functional.linear(xx, W, b) * 1.5\r\n\u001b[?2004l\r"]
[1249.637737, "o", "\u001b[?2004h"]
[1249.637841, "o", "> "]
[1249.638238, "o", "for cfg in [(128,128,32,8,4),(128,128,32,8,3),(128,128,64,8,3),(64,128,32,4,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1249.63827, "o", "> "]
[1249.638423, "o", "    BM,BN,BK,w,s = cfg\r\n\u001b[?2004l\r"]
[1249.638451, "o", "\u001b[?2004h"]
[1249.638569, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1249.638633, "o", "> "]
[1249.63883, "o", "        y = run(xx, BM,BN,BK,w,s)\r\n\u001b[?2004l\r"]
[1249.638853, "o", "\u001b[?2004h"]
[1249.638956, "o", "> "]
[1249.639235, "o", "        d = (y - y_ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1249.639517, "o", "        t = bench(lambda: run(xx, BM,BN,BK,w,s))\r\n\u001b[?2004l\r"]
[1249.639595, "o", "\u001b[?2004h> "]
