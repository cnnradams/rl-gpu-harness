[509.862956, "o", "cat > /workspace/test_sol.py << 'EOF'\r\n\u001b[?2004l\r"]
[509.862997, "o", "\u001b[?2004h"]
[509.863114, "o", "> "]
[509.863183, "o", "import torch, sys\r\n\u001b[?2004l\r\u001b[?2004h"]
[509.863266, "o", "> "]
[509.86348, "o", "sys.path.insert(0, '/workspace')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.863652, "o", "from solution import ModelNew\r\n\u001b[?2004l\r"]
[509.863795, "o", "\u001b[?2004h> "]
[509.863902, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[509.863977, "o", "\u001b[?2004h"]
[509.863999, "o", "> "]
[509.864126, "o", "dev = 'cuda'\r\n\u001b[?2004l\r"]
[509.864157, "o", "\u001b[?2004h"]
[509.86429, "o", "> "]
[509.864457, "o", "model = ModelNew(4096, 4096, 0.5).to(dev)\r\n\u001b[?2004l\r"]
[509.864548, "o", "\u001b[?2004h> "]
[509.864679, "o", "print('autotuning...')\r\n\u001b[?2004l\r"]
[509.86473, "o", "\u001b[?2004h"]
[509.864779, "o", "> "]
[509.864965, "o", "for trial in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.865252, "o", "    x = torch.rand(16384, 4096, device=dev)\r\n\u001b[?2004l\r"]
[509.865276, "o", "\u001b[?2004h"]
[509.865373, "o", "> "]
[509.865626, "o", "    W = model.matmul.weight; b = model.matmul.bias\r\n\u001b[?2004l\r"]
[509.865699, "o", "\u001b[?2004h"]
[509.865734, "o", "> "]
[509.865991, "o", "    y_ref = torch.nn.functional.linear(x, W, b)\r\n\u001b[?2004l\r"]
[509.866016, "o", "\u001b[?2004h"]
[509.866134, "o", "> "]
[509.86626, "o", "    y_ref = y_ref * 1.5\r\n\u001b[?2004l\r"]
[509.866283, "o", "\u001b[?2004h"]
[509.866349, "o", "> "]
[509.866532, "o", "    y_new = model(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.866733, "o", "    diff = (y_ref - y_new).abs()\r\n\u001b[?2004l\r"]
[509.866803, "o", "\u001b[?2004h> "]
[509.867218, "o", "    ok = torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.867734, "o", "    exact = (x.double() @ W.double().t() + b.double()) * 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.868092, "o", "    err_ref = (y_ref.double() - exact).abs().mean().item()\r\n\u001b[?2004l\r"]
[509.868136, "o", "\u001b[?2004h"]
[509.86815, "o", "> "]
[509.868493, "o", "    err_new = (y_new.double() - exact).abs().mean().item()\r\n\u001b[?2004l\r"]
[509.868564, "o", "\u001b[?2004h> "]
[509.869375, "o", "    print(f'trial {trial}: max={diff.max().item():.3e} avg={diff.mean().item():.3e} allclose={ok} err_ref={err_ref:.3e} err_new={err_new:.3e}')\r\n\u001b[?2004l\r"]
[509.869467, "o", "\u001b[?2004h"]
[509.869532, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.869656, "o", "def bench(fn, n=20):\r\n\u001b[?2004l\r"]
[509.869678, "o", "\u001b[?2004h"]
[509.869745, "o", "> "]
[509.869847, "o", "    for _ in range(5):\r\n\u001b[?2004l\r"]
[509.869938, "o", "\u001b[?2004h> "]
[509.87, "o", "        fn()\r\n\u001b[?2004l\r"]
[509.870115, "o", "\u001b[?2004h> "]
[509.870257, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[509.870323, "o", "\u001b[?2004h> "]
[509.870477, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.870594, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[509.870686, "o", "\u001b[?2004h> "]
[509.870915, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.871427, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[509.871489, "o", "\u001b[?2004h> "]
[509.871698, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[509.871731, "o", "\u001b[?2004h"]
[509.871852, "o", "> "]
[509.872019, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.872214, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[509.872283, "o", "\u001b[?2004h> "]
[509.872369, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[509.872395, "o", "\u001b[?2004h"]
[509.872461, "o", "> "]
[509.872629, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[509.872699, "o", "\u001b[?2004h> "]
[509.872922, "o", "x = torch.rand(16384, 4096, device=dev)\r\n\u001b[?2004l\r"]
[509.872954, "o", "\u001b[?2004h"]
[509.872966, "o", "> "]
[509.873349, "o", "print(f'triton split-fp16: {bench(lambda: model(x)):.3f} ms')\r\n\u001b[?2004l\r"]
[509.873413, "o", "\u001b[?2004h"]
[509.87345, "o", "> "]
[509.87368, "o", "print('best config:', _best := None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[509.874057, "o", "import solution\r\n\u001b[?2004l\r\u001b[?2004h"]
[509.874288, "o", "> "]
[509.87452, "o", "print(solution._split_fp16_gemm.best_config)\r\n\u001b[?2004l\r\u001b[?2004h"]
[509.874551, "o", "> "]
[509.874721, "o", "EOF\r\n\u001b[?2004l\r"]
[509.879132, "o", "\u001b[?2004hroot@modal:/workspace# "]
[509.879337, "o", "python3 /workspace/test_sol.py\r\n\u001b[?2004l\r"]
[512.051534, "o", "autotuning...\r\n"]
[516.722487, "o", "trial 0: max=5.293e-05 avg=5.869e-06 allclose=True err_ref=4.057e-07 err_new=5.865e-06\r\n"]
[516.751164, "o", "trial 1: max=4.709e-05 avg=5.869e-06 allclose=True err_ref=4.057e-07 err_new=5.865e-06\r\n"]
[516.779927, "o", "trial 2: max=5.019e-05 avg=5.870e-06 allclose=True err_ref=4.058e-07 err_new=5.866e-06\r\n"]
[516.84727, "o", "triton split-fp16: 2.724 ms\r\n"]
[516.84731, "o", "best config: None\r\n"]
[516.847455, "o", "BM: 128, BN: 128, BK: 32, GROUP_M: 8, num_warps: 8, num_ctas: 1, num_stages: 4, maxnreg: None\r\n"]
[517.277254, "o", "\u001b[?2004hroot@modal:/workspace# "]
[618.720527, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=3),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=5),\n        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8}, num_warps=4, num_stag"]
[618.720867, "i", "es=4),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=16, num_stages=3),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _split_fp16_gemm(\n    X, WH, WL, BIAS, OUT,\n    M, N, K,\n    sxm, sxk, swn, scale,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n\n    Xp = X + rm[:, None] * sxm + rk[None, :] * sxk\n    WHp = WH + rk[:, None] * swn + rn[None, :]\n    WLp = WL + rk[:, None] * swn + rn[None, :]\n\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n   "]
[618.721046, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.721216, "i", " for k in range(0, K, BK):\n        x = tl.load(Xp)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        wh = tl.load(WHp)\n        wl = tl.load(WLp)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xl, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        Xp += BK * sxk\n        WHp += BK * swn\n        WLp += BK * swn\n\n    bias = tl.load(BIAS + rn)\n    out = acc * scale + bias\n    Op = OUT + rm[:, None] * N + rn[None, :]\n    tl.store(Op, out)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n\n    def _prepare(self):\n        if getattr(self, '_ready', False):\n            return\n        w = self.matmul.weight\n        b = self.matmul.bias\n        s = 1.0 + self.scaling_factor\n        wt = w.t().contiguous()\n        wh = wt.half()\n        wl = (wt - wh.float()).half()\n        self._wh = wh.contiguous()"]
[618.721263, "o", "> "]
[618.721402, "i", "\n        self._wl = wl.contiguous()\n        self._bias = (b * s).contiguous()\n        self._scale = s\n        self._ready = True\n\n    def forward(self, x):\n        self._prepare()\n        if x.dtype != torch.float32 or not x.is_cuda:\n            y = torch.nn.functional.linear(x, self.matmul.weight, self.matmul.bias)\n            return y * self.scaling_factor + y\n        x = x.contiguous()\n        M, K = x.shape\n        N = self._wh.shape[1]\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n        _split_fp16_gemm[grid](\n            x, self._wh, self._wl, self._bias, out,\n            M, N, K,\n            x.stride(0), x.stride(1), self._wh.stride(0), self._scale,\n        )\n        return out\nEOF\npython3 /workspace/test_sol.py\n"]
