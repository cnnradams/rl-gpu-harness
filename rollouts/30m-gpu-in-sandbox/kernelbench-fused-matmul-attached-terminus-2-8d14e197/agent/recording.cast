[771.836081, "i", "cat > /workspace/t4.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _k2(\n    X, WH, WL, BIAS, OUT,\n    M, N, K,\n    sxm, swn, scale,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Xp = X + rm[:, None] * sxm + rk[None, :]\n    WHp = WH + rk[:, None] * swn + rn[None, :]\n    WLp = WL + rk[:, None] * swn + rn[None, :]\n    acc1 = tl.zeros((BM, BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        x = tl.load(Xp)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.fl"]
[771.836424, "i", "oat16)\n        wh = tl.load(WHp)\n        wl = tl.load(WLp)\n        acc1 = tl.dot(xh, wh, acc1)\n        acc1 = tl.dot(xl, wh + wl, acc1)\n        acc2 = tl.dot(xh, wh, acc2)\n        Xp += BK\n        WHp += BK * swn\n        WLp += BK * swn\n    bias = tl.load(BIAS + rn)\n    out = acc1 * scale + (bias - acc2 * scale)\n    Op = OUT + rm[:, None] * N + rn[None, :]\n    tl.store(Op, out)\n\ntorch.manual_seed(0)\ndev = 'cuda'\nM = N = K = 4096; M = 16384\nx = torch.rand(M, K, device=dev)\nW = (torch.rand(N, K, device=dev) * 2 - 1) / (K ** 0.5)\nb = (torch.rand(N, device=dev) * 2 - 1) / (K ** 0.5)\nscale = 1.5\nwt = W.t().contiguous()\nwh = wt.half()\nwl = (wt - wh.float()).half()\nbias = b * scale\n\ndef run(x, BM=128, BN=128, BK=64, warps=8, stages=4):\n    out = torch.empty((x.shape[0], N), device=dev, dtype=torch.float32)\n    grid = (triton.cdiv(x.shape[0], BM) * triton.cdiv(N, BN),)\n    _k2[grid](x, wh, wl, bias, out, x.shape[0], N, K, x.stride(0), wh.stride(0), scale, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_warps=warps, num_stages=st"]
[771.83652, "o", "cat > /workspace/t4.py << 'EOF'\r\n\u001b[?2004l\r"]
[771.836766, "i", "ages)\n    return out\n\nworst = 0.0\nfor seed in range(10):\n    torch.manual_seed(seed)\n    x = torch.rand(M, K, device=dev)\n    y_ref = torch.nn.functional.linear(x, W, b)\n    y_ref = y_ref * 1.5\n    y = run(x)\n    d = (y - y_ref).abs()\n    tol = 1e-4 + 1e-4 * y_ref.abs()\n    margin = (d / tol).max().item()\n    worst = max(worst, margin)\n    print(f'seed {seed}: maxdiff={d.max().item():.3e} worst_ratio_to_tol={margin:.3f}')\nprint('worst ratio (must be < 1):', worst)\n\ndef bench(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nx = torch.rand(M, K, device=dev)\nfor cfg in [(128,128,32,8,4),(128,128,64,8,4),(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3)]:\n    BM,BN,BK,w,s = cfg\n    tr"]
[771.836864, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[771.837226, "i", "y:\n        t = bench(lambda: run(x, BM,BN,BK,w,s))\n        print(f'2dot cfg {cfg}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'cfg {cfg} failed: {type(ex).__name__}')\nEOF\npython3 /workspace/t4.py 2>&1 | grep -v Warning | tail -30\n"]
