[1402.731987, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 100\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.71,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.71,\r\n    \"std\": 0.159,\r\n"]
