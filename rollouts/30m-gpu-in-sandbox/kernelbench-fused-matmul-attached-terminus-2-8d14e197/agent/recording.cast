[1103.344685, "i", "cat > /workspace/t7.py << 'EOF'\nimport torch\ntorch.backends.cuda.matmul.allow_tf32 = True\ndev = 'cuda'\ntorch.manual_seed(123)\nM, K, N = 16384, 4096, 4096\nW = (torch.rand(N, K, device=dev) * 2 - 1) / (K ** 0.5)\nb = (torch.rand(N, device=dev) * 2 - 1) / (K ** 0.5)\nworst = 0\nfor seed in range(20):\n    torch.manual_seed(seed)\n    x = torch.rand(M, K, device=dev)\n    y_tf32 = torch.nn.functional.linear(x, W, b) * 1.5\n    torch.backends.cuda.matmul.allow_tf32 = False\n    y_ref = torch.nn.functional.linear(x, W, b) * 1.5\n    torch.backends.cuda.matmul.allow_tf32 = True\n    d = (y_tf32 - y_ref).abs()\n    tol = 1e-4 + 1e-4 * y_ref.abs()\n    r = (d / tol).max().item()\n    worst = max(worst, r)\nprint('TF32 worst ratio over 20 seeds:', worst)\nEOF\npython3 /workspace/t7.py\n"]
