[509.829818, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_warps=8, num_stages=4),\n        triton.Config({'BM': 64, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8}, num_warps=4, num_stages=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _split_fp16_gemm(\n    X, WH, WL, BIAS, OUT,\n    M, N, K,\n    sxm, sxk, swn, scale,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n ="]
[509.830037, "i", " tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n\n    Xp = X + rm[:, None] * sxm + rk[None, :] * sxk\n    WHp = WH + rk[:, None] * swn + rn[None, :]\n    WLp = WL + rk[:, None] * swn + rn[None, :]\n\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        x = tl.load(Xp)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        wh = tl.load(WHp)\n        wl = tl.load(WLp)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xl, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        Xp += BK * sxk\n        WHp += BK * swn\n        WLp += BK * swn\n\n    bias = tl.load(BIAS + rn)\n    out = acc * scale + bias\n    Op = OUT + rm[:, None] * N + rn[None, :]\n    tl.store(Op, out)\n\n\nclas"]
[509.830308, "i", "s ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n\n    def _prepare(self):\n        if getattr(self, '_ready', False):\n            return\n        w = self.matmul.weight\n        b = self.matmul.bias\n        s = 1.0 + self.scaling_factor\n        wt = w.t().contiguous()\n        wh = wt.half()\n        wl = (wt - wh.float()).half()\n        self._wh = wh.contiguous()\n        self._wl = wl.contiguous()\n        self._bias = (b * s).contiguous()\n        self._scale = s\n        self._ready = True\n\n    def forward(self, x):\n        self._prepare()\n        if x.dtype != torch.float32 or not x.is_cuda:\n            y = torch.nn.functional.linear(x, self.matmul.weight, self.matmul.bias)\n            return y * self.scaling_factor + y\n        x = x.contiguous()\n        M, K = x.shape\n        N = self._wh.shape[1]\n        out = torch.empty((M, N), device=x.dev"]
[509.830353, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[509.830555, "i", "ice, dtype=torch.float32)\n        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\n        _split_fp16_gemm[grid](\n            x, self._wh, self._wl, self._bias, out,\n            M, N, K,\n            x.stride(0), x.stride(1), self._wh.stride(0), self._scale,\n        )\n        return out\nEOF\ncat > /workspace/test_sol.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\ntorch.manual_seed(42)\ndev = 'cuda'\nmodel = ModelNew(4096, 4096, 0.5).to(dev)\nprint('autotuning...')\nfor trial in range(3):\n    x = torch.rand(16384, 4096, device=dev)\n    W = model.matmul.weight; b = model.matmul.bias\n    y_ref = torch.nn.functional.linear(x, W, b)\n    y_ref = y_ref * 1.5\n    y_new = model(x)\n    diff = (y_ref - y_new).abs()\n    ok = torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4)\n    exact = (x.double() @ W.double().t() + b.double()) * 1.5\n    err_ref = (y_ref.double() - exact).abs().mean().item()\n    err_new = (y_new.double() - exact).abs().mean().item()\n"]
[509.830582, "o", "\u001b[?2004h> "]
[509.830716, "i", "    print(f'trial {trial}: max={diff.max().item():.3e} avg={diff.mean().item():.3e} allclose={ok} err_ref={err_ref:.3e} err_new={err_new:.3e}')\n\ndef bench(fn, n=20):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\nx = torch.rand(16384, 4096, device=dev)\nprint(f'triton split-fp16: {bench(lambda: model(x)):.3f} ms')\nprint('best config:', _best := None)\nimport solution\nprint(solution._split_fp16_gemm.best_config)\nEOF\npython3 /workspace/test_sol.py\n"]
