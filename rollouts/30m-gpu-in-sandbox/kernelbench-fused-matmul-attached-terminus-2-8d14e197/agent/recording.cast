[849.296449, "o", "    print(f'cublas out= chaining: {bench(lambda: run_cublas(xx)):.3f} ms')\r\n  File \"/workspace/t5.py\", line 44, in bench\r\n    for _ in range(5): fn()\r\n  File \"/workspace/t5.py\", line 55, in <lambda>\r\n    print(f'cublas out= chaining: {bench(lambda: run_cublas(xx)):.3f} ms')\r\n  File \"/workspace/t5.py\", line 18, in run_cublas\r\n    torch.mm(xl, wh, out=acc, beta=1.0, alpha=1.0)\r\nTypeError: mm() received an invalid combination of arguments - got (Tensor, Tensor, alpha=float, beta=float, out=Tensor), but expected one of:\r\n * (Tensor input, Tensor mat2, *, Tensor out = None)\r\n * (Tensor input, Tensor mat2, torch.dtype out_dtype, *, Tensor out = None)\r\n      didn't match because some of the keywords were incorrect: alpha, beta, out\r\n\r\n"]
