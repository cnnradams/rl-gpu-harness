[618.734598, "o", "> "]
[618.734744, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[618.73478, "o", "\u001b[?2004h"]
[618.734791, "o", "> "]
