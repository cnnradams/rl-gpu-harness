[436.920122, "i", "cat > /workspace/t3.py << 'EOF'\nimport torch\ntorch.manual_seed(0)\ndev = 'cuda'\nx = torch.rand(16384, 4096, device=dev)\nW = (torch.rand(4096, 4096, device=dev) * 2 - 1) / (4096 ** 0.5)\nxh = x.half(); Wh = W.half()\nxb = x.bfloat16(); Wb = W.bfloat16()\n\ndef bench(fn, n=20):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nflops = 2 * 16384 * 4096 * 4096 / 1e12\nprint(f'fp16 mm: {bench(lambda: torch.mm(xh, Wh.t())):.3f} ms -> {flops / bench(lambda: torch.mm(xh, Wh.t())) * 1e3:.1f} TFLOPS')\nprint(f'bf16 mm: {bench(lambda: torch.mm(xb, Wb.t())):.3f} ms')\ntry:\n    torch.backends.cuda.matmul.fp32_precision = 'bf16x9'\n    print('bf16x9 set ok')\n    print(f'fp32 emu mm: {bench(lambda: torch.mm(x, W.t())"]
[436.920203, "i", "):.3f} ms')\nexcept Exception as ex:\n    print('bf16x9 failed:', ex)\nEOF\npython3 /workspace/t3.py\n"]
