[915.391387, "o", "seed 0: maxdiff=2.756e-03 ratio=9.165\r\nseed 1: maxdiff=2.564e-03 ratio=8.495\r\nseed 2: maxdiff=2.649e-03 ratio=8.538\r\nseed 3: maxdiff=2.666e-03 ratio=8.796\r\nseed 4: maxdiff=2.802e-03 ratio=9.272\r\nworst ratio: 9.272212982177734\r\ncublas addmm out= chaining: 3.285 ms\r\n3 mms only: 2.426 ms\r\nsplit only: 0.880 ms\r\n"]
[915.528375, "o", "\u001b[?2004hroot@modal:/workspace# "]
[985.895031, "i", "cat > /workspace/t6.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _k3(\n    X, WH, WL, BIAS, OUT,\n    M, N, K,\n    sxm, swn, scale,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n    GROUP_M: tl.constexpr, EV: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Xp = X + rm[:, None] * sxm + rk[None, :]\n    WHp = WH + rk[:, None] * swn + rn[None, :]\n    WLp = WL + rk[:, None] * swn + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        x = tl.load(Xp)\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        wh = tl.load(WHp"]
[985.895276, "i", ")\n        wl = tl.load(WLp)\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xl, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n        Xp += BK\n        WHp += BK * swn\n        WLp += BK * swn\n    bias = tl.load(BIAS + rn)\n    out = acc * scale + bias\n    Op = OUT + rm[:, None] * N + rn[None, :]\n    tl.store(Op, out)\n\ntorch.manual_seed(0)\ndev = 'cuda'\nM, K, N = 16384, 4096, 4096\nW = (torch.rand(N, K, device=dev) * 2 - 1) / (K ** 0.5)\nb = (torch.rand(N, device=dev) * 2 - 1) / (K ** 0.5)\nscale = 1.5\nwt = W.t().contiguous()\nwh = wt.half()\nwl = (wt - wh.float()).half()\nbias = b * scale\n\ndef run(x, BM, BN, BK, warps, stages, GM=8):\n    out = torch.empty((x.shape[0], N), device=dev, dtype=torch.float32)\n    grid = (triton.cdiv(x.shape[0], BM) * triton.cdiv(N, BN),)\n    _k3[grid](x, wh, wl, bias, out, x.shape[0], N, K, x.stride(0), wh.stride(0), scale, BM=BM, BN=BN, BK=BK, GROUP_M=GM, EV=0, num_warps=warps, num_stages=stages)\n    return out\n\ndef bench(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchroni"]
[985.895346, "i", "ze()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nxx = torch.rand(M, K, device=dev)\nresults = []\nfor cfg in [(128,128,32,8,4,8),(128,128,32,8,3,8),(128,128,32,8,5,8),(128,128,32,8,6,8),(128,128,32,4,4,8),(128,128,64,8,4,8),(64,128,32,4,4,8),(128,64,32,4,4,8),(128,128,32,8,4,4),(128,128,32,8,4,16),(256,128,32,8,4,8),(128,256,32,8,4,8)]:\n    BM,BN,BK,w,s,gm = cfg\n    try:\n        t = bench(lambda: run(xx, BM,BN,BK,w,s,gm))\n        results.append((t, cfg))\n        print(f'cfg {cfg}: {t:.3f} ms')\n    except Exception as ex:\n        print(f'cfg {cfg} failed: {type(ex).__name__}')\nresults.sort()\nprint('BEST:', results[0])\nEOF\npython3 /workspace/t6.py 2>&1 | tail -16\n"]
