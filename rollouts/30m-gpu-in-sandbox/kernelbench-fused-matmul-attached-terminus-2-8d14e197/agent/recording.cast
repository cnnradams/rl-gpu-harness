[296.232525, "i", "cat > /workspace/t2.py << 'EOF'\nimport torch, time\ntorch.manual_seed(0)\ndev = 'cuda'\nx = torch.rand(16384, 4096, device=dev)\nW = (torch.rand(4096, 4096, device=dev) * 2 - 1) / (4096 ** 0.5)\nb = (torch.rand(4096, device=dev) * 2 - 1) / (4096 ** 0.5)\nWt = W.t().contiguous()\n\ndef bench(fn, n=20):\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nflops = 2 * 16384 * 4096 * 4096 / 1e12  # TFLOP\nfor name, fn in [\n    ('mm NT x@W.t()', lambda: torch.mm(x, W.t())),\n    ('mm NN x@Wt', lambda: torch.mm(x, Wt)),\n    ('linear', lambda: torch.nn.functional.linear(x, W, b)),\n    ('addmm alpha1', lambda: torch.addmm(b, x, W.t())),\n    ('addmm alpha1.5', lambda: torch.addmm(b, x, W.t(), alpha=1.5)),\n    ('ful"]
[296.232596, "i", "l ref', lambda: (lambda y: y * 1.5 + y * 0.0 + y * 0.0)(torch.nn.functional.linear(x, W, b))),\n    ('prescale+addmm', lambda: torch.addmm(b * 1.5, x, (W * 1.5).t())),\n]:\n    t = bench(fn)\n    print(f'{name:24s} {t:8.3f} ms  {flops / t * 1e3:7.1f} TFLOPS')\nprint([a for a in dir(torch.backends.cuda.matmul) if not a.startswith('_')])\nEOF\npython3 /workspace/t2.py\n"]
