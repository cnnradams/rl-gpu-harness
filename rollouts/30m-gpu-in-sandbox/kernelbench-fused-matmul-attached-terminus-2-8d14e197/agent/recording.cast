[846.91348, "i", "cat > /workspace/t5.py << 'EOF'\nimport torch\ntorch.manual_seed(0)\ndev = 'cuda'\nM, K, N = 16384, 4096, 4096\nx = torch.rand(M, K, device=dev)\nW = (torch.rand(N, K, device=dev) * 2 - 1) / (K ** 0.5)\nb = (torch.rand(N, device=dev) * 2 - 1) / (K ** 0.5)\nscale = 1.5\nwt = W.t().contiguous()\nwh = wt.half()\nwl = (wt - wh.float()).half()\nbias = b * scale\n\ndef run_cublas(x):\n    xh = x.half()\n    xl = (x - xh.float()).half()\n    acc = torch.mm(xh, wh)\n    torch.mm(xl, wh, out=acc, beta=1.0, alpha=1.0)\n    torch.mm(xh, wl, out=acc, beta=1.0, alpha=1.0)\n    return acc.mul_(scale).add_(bias)\n\ndef run_cublas_addmm(x):\n    xh = x.half()\n    xl = (x - xh.float()).half()\n    acc = torch.mm(xh, wh)\n    acc.addmm_(xl, wh)\n    acc.addmm_(xh, wl)\n    return acc.mul_(scale).add_(bias)\n\nworst = 0.0\nfor seed in range(5):\n    torch.manual_seed(seed)\n    xx = torch.rand(M, K, device=dev)\n    y_ref = torch.nn.functional.linear(xx, W, b) * 1.5\n    y = run_cublas_addmm(xx)\n    d = (y - y_ref).abs()\n    tol = 1e-4 + 1e-4 * y_ref.abs()\n    "]
[846.913595, "i", "r = (d / tol).max().item()\n    worst = max(worst, r)\n    print(f'seed {seed}: maxdiff={d.max().item():.3e} ratio={r:.3f}')\nprint('worst ratio:', worst)\n\ndef bench(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nxx = torch.rand(M, K, device=dev)\nprint(f'cublas out= chaining: {bench(lambda: run_cublas(xx)):.3f} ms')\nprint(f'cublas addmm_: {bench(lambda: run_cublas_addmm(xx)):.3f} ms')\n# just the 3 mms alone\nxh = xx.half(); xl = (xx - xh.float()).half()\nacc = torch.mm(xh, wh)\ndef three_mms():\n    torch.mm(xh, wh, out=acc)\n    torch.mm(xl, wh, out=acc, beta=1.0)\n    torch.mm(xh, wl, out=acc, beta=1.0)\nprint(f'3 mms only: {bench(three_mms):.3f} ms')\nEOF\npython3 /workspace/t5.py 2>&1 | tail -12\n"]
