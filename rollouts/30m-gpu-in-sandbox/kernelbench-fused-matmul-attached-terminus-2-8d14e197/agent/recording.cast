[203.521309, "i", "cat > /workspace/t1.py << 'EOF'\nimport torch\ntorch.manual_seed(0)\ndev = 'cuda'\nprint('allow_tf32:', torch.backends.cuda.matmul.allow_tf32)\nprint('matmul precision:', torch.get_float32_matmul_precision())\ntry:\n    print('fp32_precision:', torch.backends.cuda.matmul.fp32_precision)\nexcept Exception as e:\n    print('fp32_precision attr error:', e)\nx = torch.rand(16384, 4096, device=dev)\nW = (torch.rand(4096, 4096, device=dev) * 2 - 1) / (4096 ** 0.5)\nb = (torch.rand(4096, device=dev) * 2 - 1) / (4096 ** 0.5)\nref = torch.nn.functional.linear(x, W, b)\nref_scaled = ref * 1.5\nmine = torch.addmm(b, x, W.t(), alpha=1.5)\nprint('linear vs addmm(alpha=1) maxdiff:', (ref - torch.addmm(b, x, W.t())).abs().max().item())\nprint('ref*1.5 vs addmm(alpha=1.5) maxdiff:', (ref_scaled - mine).abs().max().item())\nprint('ref*1.5 vs addmm(alpha=1.5) avgdiff:', (ref_scaled - mine).abs().mean().item())\nexact = (x.double() @ W.double().t() + b.double())\nprint('ref vs exact maxdiff:', (ref.double() - exact).abs().max().item())\nprint('ref "]
[203.521563, "i", "vs exact avgdiff:', (ref.double() - exact).abs().mean().item())\nprint('mine/1.5 vs exact avgdiff:', (mine.double() / 1.5 - exact).abs().mean().item())\nprint('output std:', ref.std().item(), 'mean abs:', ref.abs().mean().item())\nEOF\npython3 /workspace/t1.py\n"]
