[912.741393, "o", "> "]
[912.74166, "o", "    xx = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r"]
[912.741792, "o", "\u001b[?2004h> "]
[912.742149, "o", "    y_ref = torch.nn.functional.linear(xx, W, b) * 1.5\r\n\u001b[?2004l\r"]
[912.742298, "o", "\u001b[?2004h> "]
[912.742431, "o", "    y = run_cublas(xx)\r\n\u001b[?2004l\r"]
[912.742533, "o", "\u001b[?2004h> "]
[912.742778, "o", "    d = (y - y_ref).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.743061, "o", "    tol = 1e-4 + 1e-4 * y_ref.abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.743276, "o", "    r = (d / tol).max().item()\r\n\u001b[?2004l\r"]
[912.74331, "o", "\u001b[?2004h"]
[912.743424, "o", "> "]
[912.743551, "o", "    worst = max(worst, r)\r\n\u001b[?2004l\r\u001b[?2004h"]
[912.743654, "o", "> "]
[912.744107, "o", "    print(f'seed {seed}: maxdiff={d.max().item():.3e} ratio={r:.3f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.744286, "o", "print('worst ratio:', worst)\r\n\u001b[?2004l\r"]
[912.744351, "o", "\u001b[?2004h> \r\n"]
[912.74437, "o", "\u001b[?2004l\r"]
[912.744437, "o", "\u001b[?2004h> "]
[912.744654, "o", "def bench(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.744842, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[912.744923, "o", "\u001b[?2004h> "]
[912.745127, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[912.745224, "o", "\u001b[?2004h"]
[912.745287, "o", ">     ts = []\r\n\u001b[?2004l\r"]
[912.745383, "o", "\u001b[?2004h> "]
[912.745535, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[912.745641, "o", "\u001b[?2004h> "]
[912.745836, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[912.745948, "o", "\u001b[?2004h> "]
[912.74649, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[912.74658, "o", "\u001b[?2004h> "]
[912.747004, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.747239, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[912.747268, "o", "\u001b[?2004h"]
[912.747281, "o", "> "]
[912.747535, "o", "    ts.sort(); return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[912.74763, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[912.747651, "o", "\u001b[?2004h"]
[912.747774, "o", "> "]
[912.747981, "o", "xx = torch.rand(M, K, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.748508, "o", "print(f'cublas addmm out= chaining: {bench(lambda: run_cublas(xx)):.3f} ms')\r\n\u001b[?2004l\r"]
[912.74854, "o", "\u001b[?2004h"]
[912.748621, "o", "> "]
[912.748877, "o", "xh = xx.half(); xl = (xx - xh.float()).half()\r\n\u001b[?2004l\r"]
[912.748906, "o", "\u001b[?2004h"]
[912.748921, "o", "> "]
[912.749119, "o", "acc = torch.mm(xh, wh)\r\n\u001b[?2004l\r\u001b[?2004h"]
[912.749192, "o", "> "]
[912.749335, "o", "def three_mms():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.749548, "o", "    torch.mm(xh, wh, out=acc)\r\n\u001b[?2004l\r"]
[912.749574, "o", "\u001b[?2004h"]
[912.749671, "o", "> "]
[912.749866, "o", "    torch.addmm(acc, xl, wh, out=acc)\r\n\u001b[?2004l\r"]
[912.749921, "o", "\u001b[?2004h"]
[912.749982, "o", "> "]
[912.750207, "o", "    torch.addmm(acc, xh, wl, out=acc)\r\n\u001b[?2004l\r"]
[912.750241, "o", "\u001b[?2004h"]
[912.750257, "o", "> "]
[912.75061, "o", "print(f'3 mms only: {bench(three_mms):.3f} ms')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[912.751093, "o", "print(f'split only: {bench(lambda: (xx.half(), (xx - xx.half().float()).half())):.3f} ms')\r\n\u001b[?2004l\r"]
[912.751226, "o", "\u001b[?2004h> "]
[912.751316, "o", "EOF\r\n\u001b[?2004l\r"]
