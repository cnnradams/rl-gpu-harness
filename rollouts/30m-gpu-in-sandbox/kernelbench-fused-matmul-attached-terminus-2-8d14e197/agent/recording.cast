[618.736209, "o", "    WLp = WL + rk[:, None] * swn + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[618.736243, "o", "\u001b[?2004h"]
[618.736257, "o", "> "]
[618.736621, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.736859, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.737071, "o", "        x = tl.load(Xp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.737278, "o", "        xh = x.to(tl.float16)\r\n\u001b[?2004l\r"]
[618.737373, "o", "\u001b[?2004h> "]
[618.737709, "o", "        xl = (x - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[618.737792, "o", "\u001b[?2004h> "]
[618.737958, "o", "        wh = tl.load(WHp)\r\n\u001b[?2004l\r"]
[618.738046, "o", "\u001b[?2004h> "]
[618.738206, "o", "        wl = tl.load(WLp)\r\n\u001b[?2004l\r"]
[618.738276, "o", "\u001b[?2004h"]
[618.738334, "o", "> "]
[618.73855, "o", "        acc = tl.dot(xh, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.738729, "o", "        acc = tl.dot(xl, wh, acc)\r\n\u001b[?2004l\r"]
[618.738845, "o", "\u001b[?2004h> "]
[618.739063, "o", "        acc = tl.dot(xh, wl, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.739275, "o", "        Xp += BK * sxk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.739423, "o", "        WHp += BK * swn\r\n\u001b[?2004l\r"]
[618.73945, "o", "\u001b[?2004h"]
[618.739583, "o", "> "]
[618.739699, "o", "        WLp += BK * swn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.739724, "o", "\r\n\u001b[?2004l\r"]
[618.739794, "o", "\u001b[?2004h> "]
[618.739962, "o", "    bias = tl.load(BIAS + rn)\r\n\u001b[?2004l\r"]
[618.740025, "o", "\u001b[?2004h"]
[618.740118, "o", "> "]
[618.7402, "o", "    out = acc * scale + bias\r\n\u001b[?2004l\r"]
[618.740251, "o", "\u001b[?2004h"]
[618.740328, "o", "> "]
[618.740612, "o", "    Op = OUT + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.74075, "o", "    tl.store(Op, out)\r\n\u001b[?2004l\r"]
[618.740778, "o", "\u001b[?2004h"]
[618.740873, "o", "> \r\n\u001b[?2004l\r"]
[618.74095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.740979, "o", "> "]
[618.741195, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.741535, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[618.741557, "o", "\u001b[?2004h"]
[618.74165, "o", "> "]
[618.741789, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.741819, "o", "> "]
[618.742244, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.742537, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[618.742607, "o", "\u001b[?2004h"]
[618.742648, "o", "> \r\n\u001b[?2004l\r"]
[618.742713, "o", "\u001b[?2004h> "]
[618.74286, "o", "    def _prepare(self):\r\n\u001b[?2004l\r"]
[618.742878, "o", "\u001b[?2004h"]
[618.742927, "o", "> "]
[618.743243, "o", "        if getattr(self, '_ready', False):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.743372, "o", "            return\r\n\u001b[?2004l\r"]
[618.743443, "o", "\u001b[?2004h> "]
[618.743689, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.743893, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.743948, "o", "> "]
[618.744233, "o", "        s = 1.0 + self.scaling_factor\r\n\u001b[?2004l\r"]
[618.744343, "o", "\u001b[?2004h> "]
[618.744571, "o", "        wt = w.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.74477, "o", "        wh = wt.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.745063, "o", "        wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.745343, "o", "        self._wh = wh.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.745626, "o", "        self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[618.745775, "o", "\u001b[?2004h> "]
[618.74603, "o", "        self._bias = (b * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.746263, "o", "        self._scale = s\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.746492, "o", "        self._ready = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[618.746517, "o", "\u001b[?2004l\r"]
[618.74659, "o", "\u001b[?2004h"]
[618.746696, "o", "> "]
[618.746888, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.74712, "o", "        self._prepare()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.747405, "o", "        if x.dtype != torch.float32 or not x.is_cuda:\r\n\u001b[?2004l\r"]
[618.747437, "o", "\u001b[?2004h"]
[618.747454, "o", "> "]
[618.748027, "o", "            y = torch.nn.functional.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.748293, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r"]
[618.748435, "o", "\u001b[?2004h> "]
[618.748582, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.748724, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[618.748769, "o", "\u001b[?2004h> "]
[618.74896, "o", "        N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[618.749037, "o", "\u001b[?2004h> "]
[618.749439, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[618.749461, "o", "\u001b[?2004h"]
[618.749563, "o", "> "]
[618.749983, "o", "        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[618.750011, "o", "\u001b[?2004h"]
[618.750024, "o", "> "]
[618.750235, "o", "        _split_fp16_gemm[grid](\r\n\u001b[?2004l\r"]
[618.7503, "o", "\u001b[?2004h> "]
[618.750658, "o", "            x, self._wh, self._wl, self._bias, out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.750826, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.751226, "o", "            x.stride(0), x.stride(1), self._wh.stride(0), self._scale,\r\n\u001b[?2004l\r"]
[618.751261, "o", "\u001b[?2004h> "]
[618.751375, "o", "        )\r\n\u001b[?2004l\r"]
[618.751419, "o", "\u001b[?2004h> "]
[618.751554, "o", "        return out\r\n\u001b[?2004l\r"]
[618.75164, "o", "\u001b[?2004h> "]
[618.751749, "o", "EOF\r\n\u001b[?2004l\r"]
