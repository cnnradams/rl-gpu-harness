[1173.704655, "i", "cat > /workspace/t8.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _k3_tma(\n    xd, whd, wld, bd, od,\n    M, N, K, scale,\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    om = pid_m * BM\n    on = pid_n * BN\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        x = xd.load([om, k])\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        wh = whd.load([k, on])\n        wl = wld.load([k, on])\n        acc = tl.dot(xh, wh, acc)\n        acc = tl.dot(xl, wh, acc)\n        acc = tl.dot(xh, wl, acc)\n    bias = bd.load([on])\n    out = acc * scale + bias\n    od.store([om, on], out)\n\ntor"]
[1173.7049, "i", "ch.manual_seed(0)\ndev = 'cuda'\nM, K, N = 16384, 4096, 4096\nW = (torch.rand(N, K, device=dev) * 2 - 1) / (K ** 0.5)\nb = (torch.rand(N, device=dev) * 2 - 1) / (K ** 0.5)\nscale = 1.5\nwt = W.t().contiguous()\nwh = wt.half().contiguous()\nwl = (wt - wh.float()).half().contiguous()\nbias = (b * scale).contiguous()\n\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\ndef run(x, BM, BN, BK, warps, stages, GM=8):\n    out = torch.empty((x.shape[0], N), device=dev, dtype=torch.float32)\n    xd = TensorDescriptor.from_tensor(x, [BM, BK])\n    whd = TensorDescriptor.from_tensor(wh, [BK, BN])\n    wld = TensorDescriptor.from_tensor(wl, [BK, BN])\n    bd = TensorDescriptor.from_tensor(bias, [BN])\n    od = TensorDescriptor.from_tensor(out, [BM, BN])\n    grid = (triton.cdiv(x.shape[0], BM) * triton.cdiv(N, BN),)\n    _k3_tma[grid](xd, whd, wld, bd, od, x.shape[0], N, K, scale, BM=BM, BN=BN, BK=BK, GROUP_M=GM, num_warps=warps, num_stages=stages)\n    return out\n\ndef bench(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.s"]
[1173.704998, "o", "cat > /workspace/t8.py << 'EOF'\r\n\u001b[?2004l\r"]
[1173.705151, "i", "ynchronize()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort(); return ts[len(ts)//2]\n\nxx = torch.rand(M, K, device=dev)\ny_ref = torch.nn.functional.linear(xx, W, b) * 1.5\nfor cfg in [(128,128,32,8,4),(128,128,64,8,4),(128,128,64,8,3),(128,256,64,8,3),(256,128,64,8,3),(128,128,128,8,3)]:\n    BM,BN,BK,w,s = cfg\n    try:\n        y = run(xx, BM,BN,BK,w,s)\n        d = (y - y_ref).abs().max().item()\n        t = bench(lambda: run(xx, BM,BN,BK,w,s))\n        print(f'TMA cfg {cfg}: {t:.3f} ms  maxdiff={d:.2e}')\n    except Exception as ex:\n        import traceback; traceback.print_exc()\n        print(f'TMA cfg {cfg} failed: {type(ex).__name__}: {ex}')\nEOF\npython3 /workspace/t8.py 2>&1 | tail -10\n"]
