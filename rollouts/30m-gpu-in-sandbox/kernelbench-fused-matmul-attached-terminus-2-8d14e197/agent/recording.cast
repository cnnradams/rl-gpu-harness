[618.729954, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.730091, "o", "def _split_fp16_gemm(\r\n\u001b[?2004l\r"]
[618.730131, "o", "\u001b[?2004h"]
