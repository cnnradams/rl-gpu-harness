[1462.461332, "o", "    od.store([om, on], out)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1462.461413, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1462.461445, "o", "\u001b[?2004h"]
[1462.461461, "o", "> "]
[1462.461622, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1462.461697, "o", "\u001b[?2004h> "]
[1462.462059, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1462.46209, "o", "\u001b[?2004h> "]
[1462.462282, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[1462.462308, "o", "\u001b[?2004h"]
[1462.462464, "o", "> "]
[1462.462687, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1462.462748, "o", "\u001b[?2004h> "]
[1462.463, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1462.463026, "o", "\u001b[?2004h"]
[1462.463143, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.463262, "o", "    def _prepare(self):\r\n\u001b[?2004l\r"]
[1462.463335, "o", "\u001b[?2004h> "]
[1462.463567, "o", "        if getattr(self, '_ready', False):\r\n\u001b[?2004l\r"]
[1462.463594, "o", "\u001b[?2004h"]
[1462.463605, "o", "> "]
[1462.46372, "o", "            return\r\n\u001b[?2004l\r"]
[1462.463745, "o", "\u001b[?2004h"]
[1462.463829, "o", "> "]
[1462.464028, "o", "        w = self.matmul.weight.detach()\r\n\u001b[?2004l\r"]
[1462.464055, "o", "\u001b[?2004h"]
[1462.464167, "o", "> "]
[1462.464325, "o", "        b = self.matmul.bias.detach()\r\n\u001b[?2004l\r"]
[1462.464402, "o", "\u001b[?2004h> "]
[1462.464693, "o", "        s = float(1.0 + self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.464855, "o", "        wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[1462.464886, "o", "\u001b[?2004h"]
[1462.464904, "o", "> "]
[1462.465113, "o", "        wh = wt.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.465309, "o", "        wl = (wt - wh.float()).half()\r\n\u001b[?2004l\r"]
[1462.465397, "o", "\u001b[?2004h> "]
[1462.465667, "o", "        self._wh = wh.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.465941, "o", "        self._wl = wl.contiguous()\r\n\u001b[?2004l\r"]
[1462.466069, "o", "\u001b[?2004h> "]
[1462.46637, "o", "        self._bias = (b * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.466536, "o", "        self._scale = s\r\n\u001b[?2004l\r"]
[1462.466565, "o", "\u001b[?2004h"]
[1462.466721, "o", "> "]
[1462.466815, "o", "        self._ready = True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1462.466938, "o", "\u001b[?2004h> "]
[1462.467133, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.46746, "o", "        if x.dtype != torch.float32 or not x.is_cuda:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.467896, "o", "            y = torch.nn.functional.linear(x, self.matmul.weight, self.matmul.bias)\r\n\u001b[?2004l\r"]
[1462.467928, "o", "\u001b[?2004h"]
[1462.467943, "o", "> "]
[1462.468283, "o", "            return y * self.scaling_factor + y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.468421, "o", "        self._prepare()\r\n\u001b[?2004l\r"]
[1462.46845, "o", "\u001b[?2004h"]
[1462.46846, "o", "> "]
[1462.468678, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.468796, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[1462.468874, "o", "\u001b[?2004h> "]
[1462.469039, "o", "        N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[1462.469067, "o", "\u001b[?2004h"]
[1462.469171, "o", "> "]
[1462.469568, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.469877, "o", "        xd = TensorDescriptor.from_tensor(x, [128, 32])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1462.469906, "o", "> "]
[1462.470273, "o", "        whd = TensorDescriptor.from_tensor(self._wh, [32, 128])\r\n\u001b[?2004l\r"]
[1462.470301, "o", "\u001b[?2004h"]
[1462.470314, "o", "> "]
[1462.470714, "o", "        wld = TensorDescriptor.from_tensor(self._wl, [32, 128])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.471109, "o", "        bd = TensorDescriptor.from_tensor(self._bias, [128])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.47139, "o", "        od = TensorDescriptor.from_tensor(out, [128, 128])\r\n\u001b[?2004l\r"]
[1462.47149, "o", "\u001b[?2004h> "]
[1462.471931, "o", "        grid = lambda META: (triton.cdiv(M, META['BM']) * triton.cdiv(N, META['BN']),)\r\n\u001b[?2004l\r"]
[1462.471965, "o", "\u001b[?2004h> "]
[1462.472461, "o", "        _split_fp16_gemm_tma[grid](xd, whd, wld, bd, od, M, N, K, self._scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1462.472629, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[1462.472656, "o", "\u001b[?2004l\r"]
[1462.476019, "o", "\u001b[?2004hroot@modal:/workspace# "]
