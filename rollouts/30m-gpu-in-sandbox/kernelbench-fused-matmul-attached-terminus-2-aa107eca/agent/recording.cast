[643.09053, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch, triton, triton.language as tl, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import get_inputs\n\ndevice='cuda'\ntorch.manual_seed(42)\nx = get_inputs()[0].to(device)\nK=4096; N=4096; M=16384\nws = (torch.randn(N, K, device=device)*0.02*1.5).t().contiguous()\nsh = ws.half(); sl = (ws - sh.float()).half()\nbias = torch.randn(N, device=device)*0.02\n\n@triton.jit\ndef k1(X, SH, SL, Bias, Out, M, N, K, sxm, sxk, ssk, ssn, som, son,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    nig = GROUP_M * num_pid_n\n    gid = pid // nig; fpm = gid * GROUP_M\n    gsm = min(num_pid_m - fpm, GROUP_M)\n    pid_m = fpm + ((pid % nig) % gsm); pid_n = (pid % nig) // gsm\n    rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)\n    Xp = X + rm[:,None]*sxm + rk[None,:]*sxk\n    SHp = SH + rk[:,None]*ssk + rn[None,:]*ssn\n    SLp = SL + "]
[643.090789, "i", "rk[:,None]*ssk + rn[None,:]*ssn\n    acc = tl.zeros((BM,BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K,BK)):\n        xx = tl.load(Xp); h = tl.load(SHp); l = tl.load(SLp)\n        xh = xx.to(tl.float16); xl = (xx - xh.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(xh, h, acc); acc = tl.dot(xl, h, acc); acc = tl.dot(xh, l, acc)\n        Xp += BK*sxk; SHp += BK*ssk; SLp += BK*ssk\n    b = tl.load(Bias+rn); acc = acc + b[None,:]\n    tl.store(Out + rm[:,None]*som + rn[None,:]*son, acc)\n\n@triton.jit\ndef k2(X, SH, SL, Bias, Out, M, N, K, sxm, sxk, ssk, ssn, som, son,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)\n    nig = GROUP_M * num_pid_n\n    gid = pid // nig; fpm = gid * GROUP_M\n    gsm = min(num_pid_m - fpm, GROUP_M)\n    pid_m = fpm + ((pid % nig) % gsm); pid_n = (pid % nig) // gsm\n    rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)\n    Xp ="]
[643.09098, "i", " X + rm[:,None]*sxm + rk[None,:]*sxk\n    SHp = SH + rk[:,None]*ssk + rn[None,:]*ssn\n    SLp = SL + rk[:,None]*ssk + rn[None,:]*ssn\n    acc1 = tl.zeros((BM,BN), dtype=tl.float32)\n    acc2 = tl.zeros((BM,BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K,BK)):\n        xx = tl.load(Xp); h = tl.load(SHp); l = tl.load(SLp)\n        xh = xx.to(tl.float16); xl = (xx - xh.to(tl.float32)).to(tl.float16)\n        acc1 = tl.dot(xh, h, acc1); acc2 = tl.dot(xl, h, acc2); acc1 = tl.dot(xh, l, acc1)\n        Xp += BK*sxk; SHp += BK*ssk; SLp += BK*ssk\n    b = tl.load(Bias+rn); acc = acc1 + acc2 + b[None,:]\n    tl.store(Out + rm[:,None]*som + rn[None,:]*son, acc)\n\nout = torch.empty((M,N), device=device)\n\ndef bench(kern, BM,BN,BK,GM,w,s):\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: kern[grid](x, sh, sl, bias, out, M, N, K,\n            x.stride(0), x.stride(1), sh.stride(0), sh.stride(1), out.stride(0), out.stride(1),\n            BM=BM, BN=BN, BK=BK, GROUP_M=GM, num_warps=w, num_stages=s)\n  "]
[643.091014, "o", "cat > /workspace/sweep2.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[643.091155, "i", "      fn(); torch.cuda.synchronize()\n    except Exception as ex:\n        return None\n    times=[]\n    for _ in range(20):\n        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize(); st.record(); fn(); en.record(); torch.cuda.synchronize()\n        times.append(st.elapsed_time(en))\n    times.sort()\n    return times[10]\n\nresults=[]\nfor kern,name in [(k1,'one-acc'),(k2,'two-acc')]:\n    for BM,BN,BK in [(128,128,64),(128,256,64),(256,128,64),(256,256,64),(128,128,128),(64,256,64),(256,64,64),(128,64,64),(64,128,64),(256,128,32),(128,256,32)]:\n        for w in [4,8]:\n            for s in [2,3,4,5]:\n                t = bench(kern,BM,BN,BK,8,w,s)\n                if t is not None:\n                    results.append((t, name, BM,BN,BK,w,s))\nresults.sort()\nfor r in results[:15]:\n    print(r)\nEOF\npython3 /workspace/sweep2.py\n"]
