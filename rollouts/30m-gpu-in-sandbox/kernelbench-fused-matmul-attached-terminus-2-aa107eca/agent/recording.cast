[1011.381523, "o", "(2.585344076156616, 'one-acc', 256, 128, 32, 8, 3)\r\n(2.7189760208129883, 'one-acc', 256, 128, 64, 8, 3)\r\n(2.7389440536499023, 'one-acc', 128, 256, 32, 8, 3)\r\n(2.747488021850586, 'one-acc', 128, 128, 64, 8, 3)\r\n(2.7721920013427734, 'two-acc', 128, 128, 64, 8, 3)\r\n(2.8586559295654297, 'one-acc', 256, 128, 32, 8, 5)\r\n(2.9173760414123535, 'one-acc', 128, 128, 64, 4, 2)\r\n"]
