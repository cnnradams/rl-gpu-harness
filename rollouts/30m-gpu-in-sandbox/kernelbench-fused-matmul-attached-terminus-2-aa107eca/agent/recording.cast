[304.497104, "o", "    def _prepare(self, device):\r\n\u001b[?2004l\r"]
[304.497135, "o", "\u001b[?2004h"]
[304.497147, "o", "> "]
[304.497374, "o", "        w = self.matmul.weight.detach()\r\n\u001b[?2004l\r"]
[304.497436, "o", "\u001b[?2004h"]
[304.497493, "o", "> "]
[304.497666, "o", "        if w.device != device:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.497881, "o", "            w = w.to(device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.498109, "o", "        s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[304.498133, "o", "\u001b[?2004h"]
[304.498233, "o", "> "]
[304.498584, "o", "        ws = (w * s).t().contiguous()          # (K, N) fp32, scaled\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.498823, "o", "        sh = ws.to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.499183, "o", "        sl = (ws - sh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.499604, "o", "        b = (self.matmul.bias.detach().to(device) * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.49992, "o", "        self._prepared[device] = (sh, sl, b)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[304.499947, "o", "\u001b[?2004h"]
[304.500047, "o", "> "]
[304.500157, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[304.500206, "o", "\u001b[?2004h> "]
[304.500333, "o", "        device = x.device\r\n\u001b[?2004l\r"]
[304.500359, "o", "\u001b[?2004h"]
[304.500489, "o", "> "]
[304.500692, "o", "        entry = self._prepared.get(device)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.501072, "o", "        if entry is None or entry[0].device != self.matmul.weight.device:\r\n\u001b[?2004l\r"]
[304.501143, "o", "\u001b[?2004h> "]
[304.501318, "o", "            self._prepare(device)\r\n\u001b[?2004l\r"]
[304.50138, "o", "\u001b[?2004h> "]
[304.501595, "o", "            entry = self._prepared[device]\r\n\u001b[?2004l\r"]
[304.501648, "o", "\u001b[?2004h"]
[304.501673, "o", "> "]
[304.501795, "o", "        sh, sl, b = entry\r\n\u001b[?2004l\r"]
[304.50185, "o", "\u001b[?2004h"]
[304.501864, "o", "> \r\n\u001b[?2004l\r"]
[304.501904, "o", "\u001b[?2004h> "]
[304.502036, "o", "        M, K = x.shape\r\n\u001b[?2004l\r"]
[304.502128, "o", "\u001b[?2004h> "]
[304.502224, "o", "        N = sh.shape[1]\r\n\u001b[?2004l\r"]
[304.502279, "o", "\u001b[?2004h"]
[304.502318, "o", "> "]
[304.502545, "o", "        if not x.is_contiguous():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.502721, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r"]
[304.502742, "o", "\u001b[?2004h"]
[304.502849, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.503252, "o", "        out = torch.empty((M, N), device=device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.503758, "o", "        grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.50396, "o", "        _split_gemm[grid](\r\n\u001b[?2004l\r"]
[304.504009, "o", "\u001b[?2004h"]
[304.504073, "o", "> "]
[304.50425, "o", "            x, sh, sl, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[304.50429, "o", "\u001b[?2004h"]
[304.504346, "o", "> "]
[304.504716, "o", "            x.stride(0), x.stride(1), sh.stride(0), sh.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.504988, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.505038, "o", "        )\r\n\u001b[?2004l\r"]
[304.505077, "o", "\u001b[?2004h"]
[304.505113, "o", "> "]
[304.505207, "o", "        return out\r\n\u001b[?2004l\r"]
[304.505249, "o", "\u001b[?2004h> "]
[304.505302, "o", "EOF\r\n\u001b[?2004l\r"]
[304.508144, "o", "\u001b[?2004h"]
[304.508165, "o", "root@modal:/workspace# "]
