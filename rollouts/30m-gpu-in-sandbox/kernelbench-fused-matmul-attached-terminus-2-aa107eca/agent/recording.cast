[547.22611, "i", "cat > /workspace/sweep.py << 'EOF'\nimport sys, torch, triton, triton.language as tl, itertools, time\nsys.path.insert(0, '/opt/task'); sys.path.insert(0, '/workspace')\nfrom reference import get_inputs\nimport importlib\nimport solution\n\ndevice='cuda'\nx = get_inputs()[0].to(device)\nm = solution.ModelNew(4096, 4096, 0.5).to(device)\nwith torch.no_grad():\n    m(x)  # trigger prep + autotune\n    torch.cuda.synchronize()\n    # check which config won\n    print('best config:', solution._split_gemm.best_config)\n    times=[]\n    for _ in range(50):\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize(); s.record(); m(x); e.record(); torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    print('min', times[0], 'median', times[25])\nEOF\npython3 /workspace/sweep.py\n"]
