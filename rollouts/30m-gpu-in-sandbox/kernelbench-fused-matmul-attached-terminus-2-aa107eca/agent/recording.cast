[400.055596, "i", "cat > /workspace/test_margin.py << 'EOF'\nimport sys, torch\nsys.path.insert(0, '/opt/task'); sys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom solution import ModelNew\nimport kernelbench.eval as ke\ndevice='cuda'\ntorch.manual_seed(42); ref = Model(*get_init_inputs()).to(device)\ntorch.manual_seed(42); new = ModelNew(*get_init_inputs()).to(device)\ntorch.manual_seed(42)\nseeds=[torch.randint(0,2**32-1,(1,)).item() for _ in range(5)]\nwith torch.no_grad():\n    for s in seeds:\n        ke.set_seed(s); inp=get_inputs()[0].to(device)\n        o=ref(inp); o2=new(inp)\n        ratio=((o-o2).abs()/(1e-4+1e-4*o2.abs())).max().item()\n        print(f'seed {s}: max normalized ratio = {ratio:.4f} (must be < 1)')\nEOF\npython3 /workspace/test_margin.py\n"]
