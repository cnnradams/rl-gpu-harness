[304.495998, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.496288, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
