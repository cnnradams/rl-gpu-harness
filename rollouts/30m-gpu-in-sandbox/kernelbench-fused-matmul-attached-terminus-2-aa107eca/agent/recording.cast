[960.940881, "i", "cat > /workspace/sweep3.py << 'EOF'\nimport torch, triton, sys\nsys.path.insert(0,'/opt/task')\nfrom sweep2 import k1, k2, bench, x, sh, sl, bias, out, M, N, K\nresults=[]\ncombos=[]\nfor kern,name in [(k1,'one'),(k2,'two')]:\n    for BM,BN,BK in [(256,128,32),(256,256,32),(512,128,32),(256,64,32),(128,128,32),(256,128,16),(512,64,32),(128,64,32)]:\n        for w in [4,8,16]:\n            for s in [2,3,4,6]:\n                for GM in [4,8,16]:\n                    if w==16 and BM<512: continue\n                    t = bench(kern,BM,BN,BK,GM,w,s)\n                    if t is not None:\n                        results.append((t,name,BM,BN,BK,GM,w,s))\nresults.sort()\nfor r in results[:15]:\n    print(r)\nEOF\npython3 /workspace/sweep3.py\n"]
