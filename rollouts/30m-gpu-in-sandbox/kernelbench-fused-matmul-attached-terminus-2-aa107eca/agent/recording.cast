[1030.811258, "i", "cat > /workspace/sweep4.py << 'EOF'\nimport torch, triton, triton.language as tl, sys\nsys.path.insert(0,'/opt/task')\nfrom reference import get_inputs\ndevice='cuda'\ntorch.manual_seed(42)\nx = get_inputs()[0].to(device)\nK=4096; N=4096; M=16384\nws = (torch.randn(N,K,device=device)*0.02*1.5).t().contiguous()\nsh = ws.half(); sl = (ws-sh.float()).half()\nbias = torch.randn(N, device=device)*0.02\nxh = x.half(); xl = (x - xh.float()).half()\nout = torch.empty((M,N), device=device)\n\n@triton.jit\ndef k3(XH, XL, SH, SL, Bias, Out, M, N, K, sxm, sxk, ssk, ssn, som, son,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M,BM); num_pid_n = tl.cdiv(N,BN)\n    nig = GROUP_M*num_pid_n\n    gid = pid//nig; fpm = gid*GROUP_M\n    gsm = min(num_pid_m-fpm, GROUP_M)\n    pid_m = fpm + ((pid % nig) % gsm); pid_n = (pid % nig)//gsm\n    rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)\n    XHp = XH + rm[:,None]*sxm + rk[N"]
[1030.811308, "o", "cat > /workspace/sweep4.py << 'EOF'\r\n"]
[1030.811574, "i", "one,:]*sxk\n    XLp = XL + rm[:,None]*sxm + rk[None,:]*sxk\n    SHp = SH + rk[:,None]*ssk + rn[None,:]*ssn\n    SLp = SL + rk[:,None]*ssk + rn[None,:]*ssn\n    acc = tl.zeros((BM,BN), dtype=tl.float32)\n    for _ in range(0, tl.cdiv(K,BK)):\n        xh = tl.load(XHp); xl = tl.load(XLp); h = tl.load(SHp); l = tl.load(SLp)\n        acc = tl.dot(xh, h, acc); acc = tl.dot(xl, h, acc); acc = tl.dot(xh, l, acc)\n        XHp += BK*sxk; XLp += BK*sxk; SHp += BK*ssk; SLp += BK*ssk\n    b = tl.load(Bias+rn); acc = acc + b[None,:]\n    tl.store(Out + rm[:,None]*som + rn[None,:]*son, acc)\n\ndef bench3(BM,BN,BK,GM,w,s):\n    grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n    try:\n        fn = lambda: k3[grid](xh, xl, sh, sl, bias, out, M, N, K,\n            xh.stride(0), xh.stride(1), sh.stride(0), sh.stride(1), out.stride(0), out.stride(1),\n            BM=BM,BN=BN,BK=BK,GROUP_M=GM,num_warps=w,num_stages=s)\n        fn(); torch.cuda.synchronize()\n    except Exception:\n        return None\n    times=[]\n    for _ in range(20):\n        st=t"]
[1030.8117, "i", "orch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        torch.cuda.synchronize(); st.record(); fn(); en.record(); torch.cuda.synchronize()\n        times.append(st.elapsed_time(en))\n    times.sort(); return times[10]\n\nresults=[]\nfor BM,BN,BK in [(128,128,64),(128,256,64),(256,128,64),(256,128,128),(128,128,128),(256,256,64),(128,256,128),(256,128,32),(128,128,32)]:\n    for w in [4,8]:\n        for s in [2,3,4,5,6]:\n            t=bench3(BM,BN,BK,8,w,s)\n            if t: results.append((t,BM,BN,BK,w,s))\nresults.sort()\nfor r in results[:10]: print(r)\n\n# also time the split cost\ndef split():\n    a = x.half(); b = (x - a.float()).half(); return a,b\ntorch.cuda.synchronize()\ntimes=[]\nfor _ in range(20):\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    torch.cuda.synchronize(); st.record(); split(); en.record(); torch.cuda.synchronize()\n    times.append(st.elapsed_time(en))\ntimes.sort(); print('split ms:', times[10])\nEOF\npython3 /workspace/sweep4.py\n"]
