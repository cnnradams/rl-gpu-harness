[?2004hroot@modal:/workspace# cat > /workspace/sweep2.py << 'EOF'
[?2004l[?2004h> import torch, triton, triton.language as tl, sys
[?2004l[?2004h> sys.path.insert(0, '/opt/task')
[?2004l[?2004h> from reference import get_inputs
[?2004l[?2004h> 
[?2004l[?2004h> device='cuda'
[?2004l[?2004h> torch.manual_seed(42)
[?2004l[?2004h> x = get_inputs()[0].to(device)
[?2004l[?2004h> K=4096; N=4096; M=16384
[?2004l[?2004h> ws = (torch.randn(N, K, device=device)*0.02*1.5).t().contiguous()
[?2004l[?2004h> sh = ws.half(); sl = (ws - sh.float()).half()
[?2004l[?2004h> bias = torch.randn(N, device=device)*0.02
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def k1(X, SH, SL, Bias, Out, M, N, K, sxm, sxk, ssk, ssn, som, son,
[?2004l[?2004h>        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     nig = GROUP_M * num_pid_n
[?2004l[?2004h>     gid = pid // nig; fpm = gid * GROUP_M
[?2004l[?2004h>     gsm = min(num_pid_m - fpm, GROUP_M)
[?2004l[?2004h>     pid_m = fpm + ((pid % nig) % gsm); pid_n = (pid % nig) // gsm
[?2004l[?2004h>     rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)
[?2004l[?2004h>     Xp = X + rm[:,None]*sxm + rk[None,:]*sxk
[?2004l[?2004h>     SHp = SH + rk[:,None]*ssk + rn[None,:]*ssn
[?2004l[?2004h>     SLp = SL + rk[:,None]*ssk + rn[None,:]*ssn
[?2004l[?2004h>     acc = tl.zeros((BM,BN), dtype=tl.float32)
[?2004l[?2004h>     for _ in range(0, tl.cdiv(K,BK)):
[?2004l[?2004h>         xx = tl.load(Xp); h = tl.load(SHp); l = tl.load(SLp)
[?2004l[?2004h>         xh = xx.to(tl.float16); xl = (xx - xh.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>         acc = tl.dot(xh, h, acc); acc = tl.dot(xl, h, acc); acc = tl.dot(xh, l, acc)
[?2004l[?2004h>         Xp += BK*sxk; SHp += BK*ssk; SLp += BK*ssk
[?2004l[?2004h>     b = tl.load(Bias+rn); acc = acc + b[None,:]
[?2004l[?2004h>     tl.store(Out + rm[:,None]*som + rn[None,:]*son, acc)
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def k2(X, SH, SL, Bias, Out, M, N, K, sxm, sxk, ssk, ssn, som, son,
[?2004l[?2004h>        BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     num_pid_m = tl.cdiv(M, BM); num_pid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     nig = GROUP_M * num_pid_n
[?2004l[?2004h>     gid = pid // nig; fpm = gid * GROUP_M
[?2004l[?2004h>     gsm = min(num_pid_m - fpm, GROUP_M)
[?2004l[?2004h>     pid_m = fpm + ((pid % nig) % gsm); pid_n = (pid % nig) // gsm
[?2004l[?2004h>     rm = pid_m*BM + tl.arange(0,BM); rn = pid_n*BN + tl.arange(0,BN); rk = tl.arange(0,BK)
[?2004l[?2004h>     Xp = X + rm[:,None]*sxm + rk[None,:]*sxk
[?2004l[?2004h>     SHp = SH + rk[:,None]*ssk + rn[None,:]*ssn
[?2004l[?2004h>     SLp = SL + rk[:,None]*ssk + rn[None,:]*ssn
[?2004l[?2004h>     acc1 = tl.zeros((BM,BN), dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros((BM,BN), dtype=tl.float32)
[?2004l[?2004h>     for _ in range(0, tl.cdiv(K,BK)):
[?2004l[?2004h>         xx = tl.load(Xp); h = tl.load(SHp); l = tl.load(SLp)
[?2004l[?2004h>         xh = xx.to(tl.float16); xl = (xx - xh.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>         acc1 = tl.dot(xh, h, acc1); acc2 = tl.dot(xl, h, acc2); acc1 = tl.dot(xh, l, acc1)
[?2004l[?2004h>         Xp += BK*sxk; SHp += BK*ssk; SLp += BK*ssk
[?2004l[?2004h>     b = tl.load(Bias+rn); acc = acc1 + acc2 + b[None,:]
[?2004l[?2004h>     tl.store(Out + rm[:,None]*som + rn[None,:]*son, acc)
[?2004l[?2004h> 
[?2004l[?2004h> out = torch.empty((M,N), device=device)
[?2004l[?2004h> 
[?2004l[?2004h> def bench(kern, BM,BN,BK,GM,w,s):
