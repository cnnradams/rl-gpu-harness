[?2004l[?2004h>         torch.cuda.synchronize(); st.record(); fn(); en.record(); torch.cuda.synchronize()
[?2004l[?2004h>         times.append(st.elapsed_time(en))
[?2004l[?2004h>     times.sort()
[?2004l[?2004h>     return times[10]
