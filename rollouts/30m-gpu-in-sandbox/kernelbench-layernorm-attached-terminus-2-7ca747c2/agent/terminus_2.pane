[?2004l[?2004h> def _stats_ev(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid_b = tl.program_id(0)
[?2004l[?2004h>     pid_c = tl.program_id(1)
[?2004l[?2004h>     chunk = N // CB
[?2004l[?2004h>     base = pid_b * N + pid_c * chunk
