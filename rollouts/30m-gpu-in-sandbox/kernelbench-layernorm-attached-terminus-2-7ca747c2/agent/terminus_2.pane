[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _stats_kernel(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid_b = tl.program_id(0)
[?2004l[?2004h>     pid_c = tl.program_id(1)
[?2004l[?2004h>     chunk = N // CB
[?2004l[?2004h>     base = pid_b * N + pid_c * chunk
[?2004l[?2004h>     acc = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros([BLOCK], dtype=tl.float32)
[?2004l[?2004h>     for off in range(0, chunk, BLOCK):
[?2004l[?2004h>         idx = off + tl.arange(0, BLOCK)
[?2004l[?2004h>         v = tl.load(x_ptr + base + idx)
[?2004l[?2004h>         acc += v
[?2004l[?2004h>         acc2 += v * v
[?2004l[?2004h>     tl.store(psum_ptr + pid_b * CB + pid_c, tl.sum(acc))
[?2004l[?2004h>     tl.store(psum2_ptr + pid_b * CB + pid_c, tl.sum(acc2))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _combine_kernel(psum_ptr, psum2_ptr, mean_ptr, rstd_ptr, N, eps, CB: tl.constexpr, BLOCK: tl.constexpr):
[?2004l[?2004h>     b = tl.program_id(0)
[?2004l[?2004h>     offs = tl.arange(0, BLOCK)
[?2004l[?2004h>     mask = offs < CB
[?2004l[?2004h>     s = tl.load(psum_ptr + b * CB + offs, mask=mask, other=0.0)
