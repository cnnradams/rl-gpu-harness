[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _norm_rows(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N, B: tl.constexpr, COLS: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):
