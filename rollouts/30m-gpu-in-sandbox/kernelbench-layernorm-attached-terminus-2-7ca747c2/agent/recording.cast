[744.553109, "o", "trial 1: max diff 3.457e-06 PASS\r\n"]
[744.876056, "o", "trial 2: max diff 3.457e-06 PASS\r\n"]
[745.19699, "o", "trial 3: max diff 3.099e-06 PASS\r\n"]
