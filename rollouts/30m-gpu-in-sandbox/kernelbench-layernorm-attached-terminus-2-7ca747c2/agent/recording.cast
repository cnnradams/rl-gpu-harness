[542.645599, "o", "def _stats_ev(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.645848, "o", "    pid_b = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.646052, "o", "    pid_c = tl.program_id(1)\r\n\u001b[?2004l\r"]
[542.64615, "o", "\u001b[?2004h> "]
[542.646274, "o", "    chunk = N // CB\r\n\u001b[?2004l\r"]
[542.646337, "o", "\u001b[?2004h"]
[542.646369, "o", "> "]
[542.646655, "o", "    base = pid_b * N + pid_c * chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.647009, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.647315, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[542.647394, "o", "\u001b[?2004h> "]
[542.647642, "o", "    for off in range(0, chunk, BLOCK):\r\n\u001b[?2004l\r"]
[542.647677, "o", "\u001b[?2004h"]
[542.647777, "o", "> "]
[542.647972, "o", "        idx = off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[542.648059, "o", "\u001b[?2004h> "]
[542.648488, "o", "        v = tl.load(x_ptr + base + idx, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[542.648523, "o", "\u001b[?2004h"]
[542.648536, "o", "> "]
[542.648674, "o", "        acc += v\r\n\u001b[?2004l\r"]
[542.648747, "o", "\u001b[?2004h> "]
[542.648876, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[542.64895, "o", "\u001b[?2004h"]
[542.648978, "o", "> "]
[542.649373, "o", "    tl.store(psum_ptr + pid_b * CB + pid_c, tl.sum(acc))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.649741, "o", "    tl.store(psum2_ptr + pid_b * CB + pid_c, tl.sum(acc2))\r\n\u001b[?2004l\r"]
[542.649815, "o", "\u001b[?2004h"]
[542.649841, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[542.649928, "o", "> "]
[542.649995, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[542.650035, "o", "\u001b[?2004h> "]
[542.650984, "o", "def _norm_rows(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N, B: tl.constexpr, COLS: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.651181, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[542.6513, "o", "\u001b[?2004h> "]
[542.651536, "o", "    base_col = pid * COLS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.651847, "o", "    for off in range(0, COLS, BLOCK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.652156, "o", "        idx = base_col + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[542.652189, "o", "\u001b[?2004h"]
[542.652203, "o", "> "]
[542.652448, "o", "        w = tl.load(w_ptr + idx)\r\n\u001b[?2004l\r"]
[542.652482, "o", "\u001b[?2004h"]
[542.652496, "o", "> "]
[542.652734, "o", "        bb = tl.load(b_ptr + idx)\r\n\u001b[?2004l\r"]
[542.652837, "o", "\u001b[?2004h"]
[542.652938, "o", "> "]
[542.653066, "o", "        for j in tl.static_range(B):\r\n\u001b[?2004l\r"]
[542.653112, "o", "\u001b[?2004h"]
[542.653134, "o", "> "]
[542.653393, "o", "            m = tl.load(mean_ptr + j)\r\n\u001b[?2004l\r"]
[542.65342, "o", "\u001b[?2004h"]
[542.653541, "o", "> "]
[542.653707, "o", "            r = tl.load(rstd_ptr + j)\r\n\u001b[?2004l\r"]
[542.653735, "o", "\u001b[?2004h"]
[542.653748, "o", "> "]
[542.653901, "o", "            a = w * r\r\n\u001b[?2004l\r"]
[542.653927, "o", "\u001b[?2004h"]
[542.653994, "o", "> "]
[542.65414, "o", "            c = bb - m * a\r\n\u001b[?2004l\r"]
[542.654168, "o", "\u001b[?2004h"]
[542.654263, "o", "> "]
[542.654347, "o", "            if EV:\r\n\u001b[?2004l\r"]
[542.654389, "o", "\u001b[?2004h"]
[542.654408, "o", "> "]
[542.654941, "o", "                v = tl.load(x_ptr + j * N + idx, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.655542, "o", "                tl.store(out_ptr + j * N + idx, v * a + c, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.655663, "o", "            else:\r\n\u001b[?2004l\r"]
[542.655688, "o", "\u001b[?2004h"]
[542.655809, "o", "> "]
[542.656019, "o", "                v = tl.load(x_ptr + j * N + idx)\r\n\u001b[?2004l\r"]
[542.656046, "o", "\u001b[?2004h"]
[542.656149, "o", "> "]
[542.656505, "o", "                tl.store(out_ptr + j * N + idx, v * a + c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[542.656609, "o", "\u001b[?2004h> "]
[542.656748, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[542.656774, "o", "\u001b[?2004h"]
[542.65689, "o", "> "]
[542.65702, "o", "B, N = 16, 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.65728, "o", "x = torch.rand(B, N, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.657436, "o", "y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[542.657503, "o", "\u001b[?2004h> "]
[542.657936, "o", "w = torch.rand(N, device=dev); b = torch.rand(N, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.65854, "o", "mean = x.mean(1).contiguous(); rstd = (x.var(1, unbiased=False)+1e-5).rsqrt().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.65871, "o", "out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[542.658864, "o", "\u001b[?2004h> "]
[542.659093, "o", "o1 = torch.zeros(4096, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[542.659129, "o", "\u001b[?2004h"]
[542.659216, "o", "> "]
[542.659326, "o", "def timeit(fn, n=30):\r\n\u001b[?2004l\r"]
[542.659399, "o", "\u001b[?2004h"]
[542.659464, "o", "> "]
[542.659602, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[542.659633, "o", "\u001b[?2004h"]
[542.659745, "o", "> "]
[542.659881, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[542.659987, "o", ">     ts=[]\r\n\u001b[?2004l\r"]
[542.66006, "o", "\u001b[?2004h"]
[542.660084, "o", "> "]
[542.660306, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.660523, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[542.660556, "o", "\u001b[?2004h"]
[542.660569, "o", "> "]
[542.660801, "o", "        clear_l2_cache(device=dev)\r\n\u001b[?2004l\r"]
[542.660827, "o", "\u001b[?2004h"]
[542.660928, "o", "> "]
[542.661313, "o", "        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.661697, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[542.661732, "o", "\u001b[?2004h"]
[542.661746, "o", "> "]
[542.661999, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[542.662029, "o", "\u001b[?2004h"]
[542.66204, "o", "> "]
[542.662238, "o", "    return np.mean(ts)*1000\r\n\u001b[?2004l\r"]
[542.662264, "o", "\u001b[?2004h"]
[542.662352, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[542.66242, "o", "> "]
[542.662446, "o", "tot = B*N\r\n\u001b[?2004l\r"]
[542.662519, "o", "\u001b[?2004h> "]
[542.662725, "o", "print('--- copy ceiling ---')\r\n\u001b[?2004l\r"]
[542.66276, "o", "\u001b[?2004h"]
[542.662775, "o", "> "]
[542.663288, "o", "for BLOCK, IT, wp in itertools.product([4096,8192,16384],[4,8,16],[4,8]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.663449, "o", "    G = tot // (BLOCK*IT)\r\n\u001b[?2004l\r"]
[542.663473, "o", "\u001b[?2004h"]
[542.663563, "o", "> "]
[542.663767, "o", "    if G*(BLOCK*IT) != tot: continue\r\n\u001b[?2004l\r"]
[542.663793, "o", "\u001b[?2004h"]
[542.663818, "o", "> "]
[542.664297, "o", "    t = timeit(lambda: _copy[(G,)](x, y, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r"]
[542.664322, "o", "\u001b[?2004h"]
[542.664416, "o", "> "]
[542.664878, "o", "    print(f'BLOCK={BLOCK} IT={IT} warps={wp}: {t:.1f} us  {537e6/t/1e3:.2f} TB/s')\r\n\u001b[?2004l\r"]
[542.664952, "o", "\u001b[?2004h"]
[542.664975, "o", "> "]
[542.665179, "o", "print('--- read ceiling ---')\r\n\u001b[?2004l\r\u001b[?2004h"]
[542.665249, "o", "> "]
[542.665639, "o", "for BLOCK, IT, wp in itertools.product([8192,16384],[4,8,16],[4,8,16]):\r\n\u001b[?2004l\r"]
[542.665666, "o", "\u001b[?2004h"]
[542.665753, "o", "> "]
[542.665911, "o", "    G = tot // (BLOCK*IT)\r\n\u001b[?2004l\r\u001b[?2004h"]
[542.665936, "o", "> "]
[542.666174, "o", "    if G*(BLOCK*IT) != tot: continue\r\n\u001b[?2004l\r"]
[542.666247, "o", "\u001b[?2004h"]
[542.666275, "o", "> "]
[542.666745, "o", "    t = timeit(lambda: _readk[(G,)](x, o1, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r"]
[542.666782, "o", "\u001b[?2004h"]
[542.666796, "o", "> "]
[542.667375, "o", "    print(f'BLOCK={BLOCK} IT={IT} warps={wp}: {t:.1f} us  {268e6/t/1e3:.2f} TB/s')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.667603, "o", "print('--- stats evict_first ---')\r\n\u001b[?2004l\r"]
[542.667629, "o", "\u001b[?2004h"]
[542.667728, "o", "> "]
[542.668135, "o", "for CB, BS, wp in itertools.product([32,64],[8192,16384],[8,16]):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.668446, "o", "    if N % CB or (N//CB) % BS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.668995, "o", "    ps = torch.zeros(B, CB, device=dev); ps2 = torch.zeros(B, CB, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.669525, "o", "    t = timeit(lambda: _stats_ev[(B,CB)](x, ps, ps2, N, CB=CB, BLOCK=BS, num_warps=wp))\r\n\u001b[?2004l\r"]
[542.669551, "o", "\u001b[?2004h"]
[542.669641, "o", "> "]
[542.669964, "o", "    print(f'CB={CB} BLOCK={BS} warps={wp}: {t:.1f} us')\r\n\u001b[?2004l\r"]
[542.670057, "o", "\u001b[?2004h"]
[542.670114, "o", "> "]
[542.670339, "o", "print('--- norm rows variant ---')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.670911, "o", "for COLS, BS, wp, ev in itertools.product([4096,8192,16384],[1024,2048,4096],[4,8],[False,True]):\r\n\u001b[?2004l\r"]
[542.670941, "o", "\u001b[?2004h"]
[542.670957, "o", "> "]
[542.671278, "o", "    if COLS % BS or N % COLS: continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.672069, "o", "    t = timeit(lambda: _norm_rows[(N//COLS,)](x, w, b, mean, rstd, out, N, B=B, COLS=COLS, BLOCK=BS, EV=ev, num_warps=wp))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[542.672482, "o", "    print(f'COLS={COLS} BLOCK={BS} warps={wp} ev={ev}: {t:.1f} us')\r\n\u001b[?2004l\r"]
[542.672514, "o", "\u001b[?2004h"]
[542.672604, "o", "> EOF\r\n\u001b[?2004l\r"]
[542.67579, "o", "\u001b[?2004hroot@modal:/workspace# "]
