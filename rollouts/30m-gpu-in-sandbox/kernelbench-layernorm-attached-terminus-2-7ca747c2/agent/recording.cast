[740.729093, "o", "> "]
[740.72931, "o", "        self.BS = 8192\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.729543, "o", "        self.COLS = 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.729782, "o", "        self.BN = 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.730236, "o", "        self.ok = (N % self.CB == 0 and (N // self.CB) % self.BS == 0\r\n\u001b[?2004l\r"]
[740.730263, "o", "\u001b[?2004h"]
[740.730357, "o", "> "]
[740.730822, "o", "                   and N % self.COLS == 0 and self.COLS % self.BN == 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.731393, "o", "        self.register_buffer('psum', torch.zeros(4096, self.CB), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.73199, "o", "        self.register_buffer('psum2', torch.zeros(4096, self.CB), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.732457, "o", "        self.register_buffer('mean', torch.zeros(4096), persistent=False)\r\n\u001b[?2004l\r"]
[740.732487, "o", "\u001b[?2004h"]
[740.732599, "o", "> "]
[740.733064, "o", "        self.register_buffer('rstd', torch.zeros(4096), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.733722, "o", "        self.register_buffer('wflat', self.ln.weight.detach().reshape(-1).clone(), persistent=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[740.733841, "o", "> "]
[740.734432, "o", "        self.register_buffer('bflat', self.ln.bias.detach().reshape(-1).clone(), persistent=False)\r\n\u001b[?2004l\r"]
[740.734519, "o", "\u001b[?2004h"]
[740.734552, "o", "> "]
[740.734782, "o", "        self._pw = self.ln.weight\r\n\u001b[?2004l\r"]
[740.734815, "o", "\u001b[?2004h"]
[740.734931, "o", "> "]
[740.735189, "o", "        self._pw_ver = self.ln.weight._version\r\n\u001b[?2004l\r"]
[740.735261, "o", "\u001b[?2004h"]
[740.735324, "o", "> "]
[740.735502, "o", "        self._pb = self.ln.bias\r\n\u001b[?2004l\r"]
[740.735586, "o", "\u001b[?2004h"]
[740.735669, "o", "> "]
[740.735893, "o", "        self._pb_ver = self.ln.bias._version\r\n\u001b[?2004l\r"]
[740.735928, "o", "\u001b[?2004h"]
[740.73594, "o", "> "]
[740.73613, "o", "        self._graph = None\r\n\u001b[?2004l\r"]
[740.736158, "o", "\u001b[?2004h"]
[740.736235, "o", "> "]
[740.736432, "o", "        self._g_in_ptr = None\r\n\u001b[?2004l\r"]
[740.736458, "o", "\u001b[?2004h"]
[740.736565, "o", "> "]
[740.736725, "o", "        self._g_shape = None\r\n\u001b[?2004l\r"]
[740.736753, "o", "\u001b[?2004h"]
[740.736878, "o", "> "]
[740.736986, "o", "        self._g_out = None\r\n\u001b[?2004l\r"]
[740.737076, "o", "\u001b[?2004h> "]
[740.737305, "o", "        self._seen = {}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[740.737456, "o", "\u001b[?2004h> "]
[740.737613, "o", "    def _params_current(self):\r\n\u001b[?2004l\r"]
[740.737673, "o", "\u001b[?2004h"]
[740.737693, "o", "> "]
[740.737928, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.738086, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r"]
[740.738171, "o", "\u001b[?2004h> "]
[740.738906, "o", "        if w is not self._pw or w._version != self._pw_ver or b is not self._pb or b._version != self._pb_ver:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.739126, "o", "            with torch.no_grad():\r\n\u001b[?2004l\r"]
[740.739208, "o", "\u001b[?2004h> "]
[740.739574, "o", "                self.wflat.copy_(w.detach().reshape(-1))\r\n\u001b[?2004l\r"]
[740.739603, "o", "\u001b[?2004h"]
[740.739737, "o", "> "]
[740.740073, "o", "                self.bflat.copy_(b.detach().reshape(-1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.740402, "o", "            self._pw = w; self._pw_ver = w._version\r\n\u001b[?2004l\r"]
[740.740434, "o", "\u001b[?2004h"]
[740.740517, "o", "> "]
[740.740877, "o", "            self._pb = b; self._pb_ver = b._version\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[740.74091, "o", "\u001b[?2004h"]
[740.741048, "o", "> "]
[740.741193, "o", "    def _launch(self, x, out, B):\r\n\u001b[?2004l\r"]
[740.741225, "o", "\u001b[?2004h"]
[740.741237, "o", "> "]
[740.741388, "o", "        N = self.N\r\n\u001b[?2004l\r"]
[740.741416, "o", "\u001b[?2004h"]
[740.741489, "o", "> "]
[740.74164, "o", "        xf = x.view(-1)\r\n\u001b[?2004l\r"]
[740.741669, "o", "\u001b[?2004h"]
[740.741779, "o", "> "]
[740.741907, "o", "        of = out.view(-1)\r\n\u001b[?2004l\r"]
[740.741934, "o", "\u001b[?2004h"]
[740.742061, "o", "> "]
[740.742701, "o", "        _stats_kernel[(B, self.CB)](xf, self.psum, self.psum2, N, CB=self.CB, BLOCK=self.BS, num_warps=16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.743452, "o", "        _combine_kernel[(B,)](self.psum, self.psum2, self.mean, self.rstd, N, self.eps, CB=self.CB, BLOCK=64, num_warps=2)\r\n\u001b[?2004l\r"]
[740.743479, "o", "\u001b[?2004h"]
[740.74359, "o", "> "]
[740.744217, "o", "        _norm_rows_kernel[(N // self.COLS,)](xf, self.wflat, self.bflat, self.mean, self.rstd, of, N,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.744797, "o", "                                             B=B, COLS=self.COLS, BLOCK=self.BN, num_warps=4)\r\n\u001b[?2004l\r"]
[740.744868, "o", "\u001b[?2004h> "]
[740.744893, "o", "\r\n\u001b[?2004l\r"]
[740.744968, "o", "\u001b[?2004h> "]
[740.745331, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[740.745437, "o", "\u001b[?2004h> "]
[740.745663, "o", "        if not self.ok or not x.is_cuda:\r\n\u001b[?2004l\r"]
[740.745693, "o", "\u001b[?2004h"]
[740.745824, "o", "> "]
[740.745949, "o", "            return self.ln(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[740.746031, "o", "> "]
[740.746175, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[740.746237, "o", "\u001b[?2004h"]
[740.746319, "o", "> "]
[740.746509, "o", "        B = x.numel() // self.N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.746817, "o", "        if B > self.psum.shape[0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.747097, "o", "            return self.ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.747384, "o", "        self._params_current()\r\n\u001b[?2004l\r"]
[740.747468, "o", "\u001b[?2004h"]
[740.747489, "o", "> "]
[740.74774, "o", "        key = x.data_ptr()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.748063, "o", "        if self._graph is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.748545, "o", "            if key == self._g_in_ptr and x.shape == self._g_shape:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.748798, "o", "                self._graph.replay()\r\n\u001b[?2004l\r"]
[740.748836, "o", "\u001b[?2004h"]
[740.748848, "o", "> "]
[740.7491, "o", "                return self._g_out\r\n\u001b[?2004l\r"]
[740.749135, "o", "\u001b[?2004h"]
[740.749215, "o", "> "]
[740.749288, "o", "        else:\r\n\u001b[?2004l\r"]
[740.749356, "o", "\u001b[?2004h> "]
[740.749634, "o", "            cnt = self._seen.get(key, 0) + 1\r\n\u001b[?2004l\r"]
[740.749663, "o", "\u001b[?2004h"]
[740.74976, "o", "> "]
[740.749933, "o", "            self._seen[key] = cnt\r\n\u001b[?2004l\r"]
[740.749968, "o", "\u001b[?2004h"]
[740.749983, "o", "> "]
[740.750334, "o", "            if cnt >= 2 and len(self._seen) >= 2:\r\n\u001b[?2004l\r"]
[740.750433, "o", "\u001b[?2004h"]
[740.750496, "o", "> "]
[740.750571, "o", "                try:\r\n\u001b[?2004l\r"]
[740.750671, "o", "\u001b[?2004h> "]
[740.750922, "o", "                    out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[740.751016, "o", "\u001b[?2004h> "]
[740.751364, "o", "                    g = torch.cuda.CUDAGraph()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.751657, "o", "                    with torch.cuda.graph(g):\r\n\u001b[?2004l\r"]
[740.751684, "o", "\u001b[?2004h"]
[740.751821, "o", "> "]
[740.752028, "o", "                        self._launch(x, out, B)\r\n\u001b[?2004l\r"]
[740.752056, "o", "\u001b[?2004h"]
[740.752159, "o", "> "]
[740.752321, "o", "                    self._graph = g\r\n\u001b[?2004l\r"]
[740.752352, "o", "\u001b[?2004h"]
[740.752444, "o", "> "]
[740.752711, "o", "                    self._g_in_ptr = key\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.753003, "o", "                    self._g_shape = x.shape\r\n\u001b[?2004l\r"]
[740.753033, "o", "\u001b[?2004h"]
[740.753172, "o", "> "]
[740.753332, "o", "                    self._g_out = out\r\n\u001b[?2004l\r"]
[740.753363, "o", "\u001b[?2004h"]
[740.753379, "o", "> "]
[740.753596, "o", "                    g.replay()\r\n\u001b[?2004l\r"]
[740.753622, "o", "\u001b[?2004h"]
[740.753715, "o", "> "]
[740.753941, "o", "                    return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.754152, "o", "                except Exception:\r\n\u001b[?2004l\r"]
[740.754185, "o", "\u001b[?2004h"]
[740.754285, "o", "> "]
[740.754485, "o", "                    self._graph = None\r\n\u001b[?2004l\r"]
[740.754519, "o", "\u001b[?2004h"]
[740.754533, "o", "> "]
[740.754792, "o", "                    self._seen = {}\r\n\u001b[?2004l\r"]
[740.754896, "o", "\u001b[?2004h> "]
[740.755095, "o", "        out = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[740.75512, "o", "\u001b[?2004h"]
[740.755241, "o", "> "]
[740.7554, "o", "        self._launch(x, out, B)\r\n\u001b[?2004l\r"]
[740.755426, "o", "\u001b[?2004h"]
[740.755551, "o", "> "]
[740.755618, "o", "        return out\r\n\u001b[?2004l\r"]
[740.755697, "o", "\u001b[?2004h> "]
[740.755759, "o", "EOF\r\n\u001b[?2004l\r"]
[740.759169, "o", "\u001b[?2004h"]
[740.759213, "o", "root@modal:/workspace# "]
[740.759456, "o", "cat > /workspace/test_sol.py << 'EOF'\r\n\u001b[?2004l\r"]
[740.759566, "o", "\u001b[?2004h> "]
[740.759728, "o", "import torch, numpy as np\r\n\u001b[?2004l\r"]
[740.759761, "o", "\u001b[?2004h"]
[740.759896, "o", "> "]
[740.759924, "o", "import importlib.util\r\n\u001b[?2004l\r"]
[740.760058, "o", "\u001b[?2004h> "]
[740.7606, "o", "spec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.761037, "o", "sol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\r\n\u001b[?2004l\r"]
[740.761065, "o", "\u001b[?2004h"]
[740.761207, "o", "> "]
[740.761458, "o", "src = open('/opt/task/reference.py').read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.761685, "o", "ctx = {}; exec(src, ctx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.762337, "o", "Model = ctx['Model']; get_inputs = ctx['get_inputs']; get_init_inputs = ctx['get_init_inputs']\r\n\u001b[?2004l\r\u001b[?2004h"]
[740.76236, "o", "> "]
[740.762546, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[740.762614, "o", "\u001b[?2004h"]
[740.762634, "o", "> "]
[740.762774, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[740.762809, "o", "\u001b[?2004h"]
[740.762902, "o", "> "]
[740.763111, "o", "ref = Model(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[740.763207, "o", "\u001b[?2004h> "]
[740.763386, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.763688, "o", "new = sol.ModelNew(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[740.763716, "o", "\u001b[?2004h"]
[740.763833, "o", "> ok = True\r\n\u001b[?2004l\r"]
[740.763855, "o", "\u001b[?2004h"]
[740.763954, "o", "> "]
[740.764048, "o", "for t in range(5):\r\n\u001b[?2004l\r"]
[740.764083, "o", "\u001b[?2004h"]
[740.764094, "o", "> "]
[740.764294, "o", "    torch.manual_seed(100+t)\r\n\u001b[?2004l\r"]
[740.764366, "o", "\u001b[?2004h> "]
[740.764643, "o", "    x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.764888, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.765131, "o", "        o1 = ref(x); o2 = new(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.765526, "o", "    good = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.766154, "o", "    print(f'trial {t}: max diff {(o1-o2).abs().max().item():.3e}', 'PASS' if good else 'FAIL')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.766352, "o", "    ok = ok and good\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.766678, "o", "# graph path: repeated calls with the SAME tensor\r\n\u001b[?2004l\r"]
[740.766704, "o", "\u001b[?2004h"]
[740.766768, "o", "> "]
[740.766989, "o", "x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.767141, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[740.767164, "o", "\u001b[?2004h"]
[740.76723, "o", "> "]
[740.767337, "o", "    o1 = ref(x)\r\n\u001b[?2004l\r"]
[740.767367, "o", "\u001b[?2004h"]
[740.767432, "o", "> "]
[740.767617, "o", "    for i in range(6):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.767756, "o", "        o2 = new(x)\r\n\u001b[?2004l\r"]
[740.767788, "o", "\u001b[?2004h"]
[740.767809, "o", "> "]
[740.768171, "o", "    good = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[740.768204, "o", "\u001b[?2004h"]
[740.768311, "o", "> "]
[740.768841, "o", "    print('repeated-call (graph) output:', 'PASS' if good else 'FAIL', (o1-o2).abs().max().item())\r\n\u001b[?2004l\r"]
[740.768872, "o", "\u001b[?2004h"]
[740.768977, "o", "> "]
[740.769103, "o", "    ok = ok and good\r\n\u001b[?2004l\r\u001b[?2004h"]
[740.769186, "o", "> "]
[740.769355, "o", "    # param update after capture\r\n\u001b[?2004l\r"]
[740.769437, "o", "\u001b[?2004h"]
[740.769461, "o", "> "]
[740.769615, "o", "    new.ln.weight.mul_(2.0)\r\n\u001b[?2004l\r"]
[740.769647, "o", "\u001b[?2004h"]
[740.769725, "o", "> "]
[740.769953, "o", "    o1b = ref(x); o2b = new(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.770305, "o", "    good = torch.allclose(o1b, o2b, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[740.77035, "o", "\u001b[?2004h"]
[740.770419, "o", "> "]
[740.770741, "o", "    print('param-update:', 'PASS' if good else 'FAIL')\r\n\u001b[?2004l\r"]
[740.770816, "o", "\u001b[?2004h"]
[740.770916, "o", "> "]
[740.771003, "o", "    ok = ok and good\r\n\u001b[?2004l\r\u001b[?2004h"]
[740.771032, "o", "> "]
[740.771262, "o", "    new.ln.weight.div_(2.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.77142, "o", "print('correct:', ok)\r\n\u001b[?2004l\r"]
[740.771455, "o", "\u001b[?2004h"]
[740.771469, "o", "> "]
[740.771869, "o", "from kernelbench.timing import time_execution_with_cuda_event\r\n\u001b[?2004l\r"]
[740.771898, "o", "\u001b[?2004h"]
[740.771981, "o", "> "]
[740.772074, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r"]
[740.772173, "o", "\u001b[?2004h"]
[740.772205, "o", "> "]
[740.77245, "o", "x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[740.772991, "o", "times = time_execution_with_cuda_event(new, [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[740.77304, "o", "\u001b[?2004h"]
[740.773103, "o", "> "]
[740.773486, "o", "print('solution mean ms:', np.mean(times), 'min:', np.min(times))\r\n\u001b[?2004l\r"]
[740.773516, "o", "\u001b[?2004h"]
[740.773617, "o", "> EOF\r\n\u001b[?2004l\r"]
[740.776686, "o", "\u001b[?2004h"]
[740.776722, "o", "root@modal:/workspace# "]
[740.776967, "o", "python3 /workspace/test_sol.py\r\n\u001b[?2004l\r"]
