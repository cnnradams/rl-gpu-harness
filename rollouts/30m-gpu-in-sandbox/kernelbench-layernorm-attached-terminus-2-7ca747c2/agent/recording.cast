[317.421112, "o", "\u001b[?2004h> "]
[317.421581, "o", "        self.register_buffer('wflat', self.ln.weight.reshape(-1).clone(), persistent=False)\r\n\u001b[?2004l\r"]
[317.421649, "o", "\u001b[?2004h"]
[317.421681, "o", "> "]
[317.422129, "o", "        self.register_buffer('bflat', self.ln.bias.reshape(-1).clone(), persistent=False)\r\n\u001b[?2004l\r"]
[317.422183, "o", "\u001b[?2004h"]
[317.422277, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.422447, "o", "    def _sync_params(self):\r\n\u001b[?2004l\r"]
[317.422527, "o", "\u001b[?2004h"]
[317.42259, "o", "> "]
[317.42293, "o", "        self.wflat.copy_(self.ln.weight.detach().reshape(-1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.423338, "o", "        self.bflat.copy_(self.ln.bias.detach().reshape(-1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[317.423412, "o", "\u001b[?2004h> "]
[317.423699, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[317.423772, "o", "\u001b[?2004h> "]
[317.4239, "o", "        if not self.ok:\r\n\u001b[?2004l\r"]
[317.424005, "o", "\u001b[?2004h> "]
[317.424206, "o", "            return self.ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.424366, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[317.4244, "o", "\u001b[?2004h"]
[317.424413, "o", "> "]
[317.424665, "o", "        B = x.numel() // self.N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.42491, "o", "        if B > self.psum.shape[0]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.42509, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[317.425123, "o", "\u001b[?2004h"]
[317.425136, "o", "> "]
[317.425315, "o", "        self._sync_params()\r\n\u001b[?2004l\r"]
[317.42534, "o", "\u001b[?2004h"]
[317.425432, "o", "> "]
[317.425501, "o", "        N = self.N\r\n\u001b[?2004l\r"]
[317.425547, "o", "\u001b[?2004h> "]
[317.425797, "o", "        out = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.425992, "o", "        xf = x.view(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.426146, "o", "        of = out.view(-1)\r\n\u001b[?2004l\r"]
[317.42624, "o", "\u001b[?2004h> "]
[317.426863, "o", "        _stats_kernel[(B, self.CB)](xf, self.psum, self.psum2, N, CB=self.CB, BLOCK=self.BLOCK_S, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.427518, "o", "        _combine_kernel[(B,)](self.psum, self.psum2, self.mean, self.rstd, N, self.eps, CB=self.CB, BLOCK=32, num_warps=1)\r\n\u001b[?2004l\r"]
[317.427545, "o", "\u001b[?2004h"]
[317.427556, "o", "> "]
[317.428355, "o", "        _norm_kernel[(B, self.CN)](xf, self.wflat, self.bflat, self.mean, self.rstd, of, N, CN=self.CN, BLOCK=self.BLOCK_N, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.428531, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[317.428595, "o", "> "]
[317.428656, "o", "EOF\r\n\u001b[?2004l\r"]
[317.431824, "o", "\u001b[?2004hroot@modal:/workspace# "]
[317.432076, "o", "cat > /workspace/test_sol.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.432241, "o", "import torch, numpy as np\r\n\u001b[?2004l\r"]
[317.432324, "o", "\u001b[?2004h> "]
[317.432427, "o", "import importlib.util\r\n\u001b[?2004l\r"]
[317.432499, "o", "\u001b[?2004h> "]
[317.43295, "o", "spec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\r\n\u001b[?2004l\r"]
[317.432976, "o", "\u001b[?2004h"]
[317.43304, "o", "> "]
[317.43342, "o", "sol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\r\n\u001b[?2004l\r"]
[317.433455, "o", "\u001b[?2004h"]
[317.433471, "o", "> "]
[317.433736, "o", "src = open('/opt/task/reference.py').read()\r\n\u001b[?2004l\r"]
[317.43376, "o", "\u001b[?2004h"]
[317.433846, "o", "> "]
[317.433995, "o", "ctx = {}; exec(src, ctx)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.43452, "o", "Model = ctx['Model']; get_inputs = ctx['get_inputs']; get_init_inputs = ctx['get_init_inputs']\r\n\u001b[?2004l\r"]
[317.434547, "o", "\u001b[?2004h"]
[317.434675, "o", "> "]
[317.434747, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r"]
[317.434838, "o", "\u001b[?2004h> "]
[317.434945, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[317.435, "o", "\u001b[?2004h"]
[317.435078, "o", "> "]
[317.435248, "o", "ref = Model(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[317.435324, "o", "\u001b[?2004h> "]
[317.435511, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.43577, "o", "new = sol.ModelNew(*get_init_inputs()).to(dev)\r\n\u001b[?2004l\r"]
[317.435798, "o", "\u001b[?2004h"]
[317.435876, "o", "> "]
[317.435899, "o", "ok = True\r\n\u001b[?2004l\r"]
[317.435977, "o", "\u001b[?2004h> "]
[317.436143, "o", "for t in range(5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.436304, "o", "    torch.manual_seed(100+t)\r\n\u001b[?2004l\r"]
[317.436363, "o", "\u001b[?2004h"]
[317.436383, "o", "> "]
[317.436589, "o", "    x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r\u001b[?2004h"]
[317.436669, "o", "> "]
[317.436835, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.437015, "o", "        o1 = ref(x); o2 = new(x)\r\n\u001b[?2004l\r"]
[317.437124, "o", "\u001b[?2004h> "]
[317.437355, "o", "    md = (o1-o2).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.438, "o", "    print(f'trial {t}: max diff {md:.3e}', 'PASS' if torch.allclose(o1, o2, atol=1e-4, rtol=1e-4) else 'FAIL')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.438342, "o", "    ok = ok and torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[317.438369, "o", "\u001b[?2004h"]
[317.438444, "o", "> "]
[317.438529, "o", "print('correct:', ok)\r\n\u001b[?2004l\r"]
[317.438594, "o", "\u001b[?2004h> "]
[317.43898, "o", "from kernelbench.timing import time_execution_with_cuda_event\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.439164, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.439331, "o", "x = get_inputs()[0].to(dev)\r\n\u001b[?2004l\r"]
[317.439415, "o", "\u001b[?2004h> "]
[317.439884, "o", "times = time_execution_with_cuda_event(new, [x], num_trials=30, verbose=False, device=dev)\r\n\u001b[?2004l\r"]
[317.439913, "o", "\u001b[?2004h"]
[317.439927, "o", "> "]
[317.440314, "o", "print('solution mean ms:', np.mean(times), 'min:', np.min(times))\r\n\u001b[?2004l\r"]
[317.44034, "o", "\u001b[?2004h"]
[317.440432, "o", "> EOF\r\n\u001b[?2004l\r"]
[317.443473, "o", "\u001b[?2004hroot@modal:/workspace# "]
[317.443685, "o", "python3 /workspace/test_sol.py\r\n\u001b[?2004l\r"]
[321.084883, "o", "trial 0: max diff 3.576e-06 PASS\r\n"]
[321.371994, "o", "trial 1: max diff 3.576e-06 PASS\r\n"]
[321.658629, "o", "trial 2: max diff 3.219e-06 PASS\r\n"]
[321.934364, "o", "trial 3: max diff 2.861e-06 PASS\r\n"]
[322.211093, "o", "trial 4: max diff 2.861e-06 PASS\r\n"]
[322.213122, "o", "correct: True\r\n"]
[324.688251, "o", "[Profiling] Using device: cuda NVIDIA H100 80GB HBM3, warm up 3, trials 30\r\n"]
[324.709892, "o", "solution mean ms: 0.34774613281091055 min: 0.34406399726867676\r\n"]
[325.612614, "o", "\u001b[?2004hroot@modal:/workspace# "]
[419.631768, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, numpy as np, itertools\nimport triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\n@triton.jit\ndef _stats_kernel(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CB\n    base = pid_b * N + pid_c * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        acc += v\n        acc2 += v * v\n    tl.store(psum_ptr + pid_b * CB + pid_c, tl.sum(acc))\n    tl.store(psum2_ptr + pid_b * CB + pid_c, tl.sum(acc2))\n\n@triton.jit\ndef _norm_kernel(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N, CN: tl.constexpr, BLOCK: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CN\n    mean = tl.load(mean_ptr + pid_b)\n    rstd = tl.load(rstd_ptr + pid_b)\n    x_base "]
[419.632096, "i", "= pid_b * N + pid_c * chunk\n    w_base = pid_c * chunk\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + x_base + idx)\n        w = tl.load(w_ptr + w_base + idx)\n        bb = tl.load(b_ptr + w_base + idx)\n        a = w * rstd\n        c = bb - mean * a\n        tl.store(out_ptr + x_base + idx, v * a + c)\n\ndev = torch.device('cuda')\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device=dev)\nw = torch.rand(N, device=dev); b = torch.rand(N, device=dev)\nmean = x.mean(1); rstd = (x.var(1, unbiased=False)+1e-5).rsqrt()\nout = torch.empty_like(x)\n\ndef timeit(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        clear_l2_cache(device=dev)\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)\n\nprint('--- stats kernel ---')\nbest_s=None\nfor CB, BS, wp in itert"]
[419.632319, "o", "cat > /workspace/tune.py << 'EOF'\r\n\u001b[?2004l\r"]
[419.632499, "i", "ools.product([8,16,32,64],[4096,8192,16384],[4,8,16]):\n    if N % CB or (N//CB) % BS: continue\n    ps = torch.zeros(B, CB, device=dev); ps2 = torch.zeros(B, CB, device=dev)\n    fn = lambda: _stats_kernel[(B,CB)](x, ps, ps2, N, CB=CB, BLOCK=BS, num_warps=wp)\n    t = timeit(fn)\n    print(f'CB={CB} BLOCK={BS} warps={wp}: {t*1000:.1f} us')\n    if best_s is None or t < best_s[0]: best_s=(t,CB,BS,wp)\nprint('best stats:', best_s)\n\nprint('--- norm kernel ---')\nbest_n=None\nfor CN, BN, wp in itertools.product([8,16,32,64],[4096,8192,16384],[4,8,16]):\n    if N % CN or (N//CN) % BN: continue\n    fn = lambda: _norm_kernel[(B,CN)](x, w, b, mean, rstd, out, N, CN=CN, BLOCK=BN, num_warps=wp)\n    t = timeit(fn)\n    print(f'CN={CN} BLOCK={BN} warps={wp}: {t*1000:.1f} us')\n    if best_n is None or t < best_n[0]: best_n=(t,CN,BN,wp)\nprint('best norm:', best_n)\nEOF\npython3 /workspace/tune.py\n"]
