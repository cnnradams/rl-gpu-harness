[145.514892, "i", "cat > /workspace/bench_ref.py << 'EOF'\nimport torch, numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\nsrc = open('/opt/task/reference.py').read()\nctx = {}\nexec(src, ctx)\nModel = ctx['Model']; get_inputs = ctx['get_inputs']; get_init_inputs = ctx['get_init_inputs']\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nm = Model(*get_init_inputs()).to(dev)\ntorch.manual_seed(0)\nx = get_inputs()[0].to(dev)\ntimes = time_execution_with_cuda_event(m, [x], num_trials=20, verbose=False, device=dev)\nprint('ref LayerNorm mean ms:', np.mean(times), 'min:', np.min(times))\n\n# bandwidth ceiling: clone\nclone = lambda t: t.clone()\ntimes = time_execution_with_cuda_event(clone, [x], num_trials=20, verbose=False, device=dev)\nprint('clone mean ms:', np.mean(times), 'min:', np.min(times))\n\n# functional layer_norm\nimport torch.nn.functional as F\nw = torch.ones(64*256*256, device=dev); b = torch.zeros(64*256*256, device=dev)\nfln = lambda t: F.layer_norm(t, (64,256,256), w, b, 1e-5)\ntimes = time_execution_with_cud"]
[145.515107, "i", "a_event(fln, [x], num_trials=20, verbose=False, device=dev)\nprint('F.layer_norm mean ms:', np.mean(times), 'min:', np.min(times))\nEOF\npython3 /workspace/bench_ref.py\n"]
