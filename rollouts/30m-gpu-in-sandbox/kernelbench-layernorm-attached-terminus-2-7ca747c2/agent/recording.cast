[971.055681, "i", "cat > /workspace/tune4.py << 'EOF'\nimport torch, numpy as np, itertools\nimport triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\n@triton.jit\ndef _norm_rows_cm(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N,\n                  B: tl.constexpr, COLS: tl.constexpr, BLOCK: tl.constexpr, CM: tl.constexpr):\n    pid = tl.program_id(0)\n    base_col = pid * COLS\n    for off in range(0, COLS, BLOCK):\n        idx = base_col + off + tl.arange(0, BLOCK)\n        w = tl.load(w_ptr + idx)\n        bb = tl.load(b_ptr + idx)\n        for j in tl.static_range(B):\n            m = tl.load(mean_ptr + j, cache_modifier='.ca')\n            r = tl.load(rstd_ptr + j, cache_modifier='.ca')\n            a = w * r\n            c = bb - m * a\n            if CM == 1:\n                v = tl.load(x_ptr + j * N + idx, cache_modifier='.cg')\n                tl.store(out_ptr + j * N + idx, v * a + c)\n            elif CM == 2:\n                v = tl.load(x_ptr + j * N + idx, cache_modifier='.cs')\n                tl.store"]
[971.055958, "i", "(out_ptr + j * N + idx, v * a + c, cache_modifier='.cs')\n            else:\n                v = tl.load(x_ptr + j * N + idx)\n                tl.store(out_ptr + j * N + idx, v * a + c)\n\ndev = torch.device('cuda')\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device=dev)\nw = torch.rand(N, device=dev); b = torch.rand(N, device=dev)\nmean = x.mean(1).contiguous(); rstd = (x.var(1, unbiased=False)+1e-5).rsqrt().contiguous()\nout = torch.empty_like(x)\n\ndef timeit(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        clear_l2_cache(device=dev)\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)*1000\n\nprint('--- norm cache modifiers ---', flush=True)\nfor COLS, BS, wp, cm in itertools.product([2048,4096],[2048,4096],[2,4,8],[0,1,2]):\n    if COLS % BS or N % COLS: continue\n    t = timeit(lambda: _norm_rows_cm[("]
[971.056138, "i", "N//COLS,)](x, w, b, mean, rstd, out, N, B=B, COLS=COLS, BLOCK=BS, CM=cm, num_warps=wp))\n    print(f'COLS={COLS} BLOCK={BS} warps={wp} cm={cm}: {t:.1f} us', flush=True)\nEOF\npython3 /workspace/tune4.py 2>&1 | tail -40\n"]
