[317.394536, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _stats_kernel(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CB\n    base = pid_b * N + pid_c * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        acc += v\n        acc2 += v * v\n    s = tl.sum(acc)\n    s2 = tl.sum(acc2)\n    tl.store(psum_ptr + pid_b * CB + pid_c, s)\n    tl.store(psum2_ptr + pid_b * CB + pid_c, s2)\n\n\n@triton.jit\ndef _combine_kernel(psum_ptr, psum2_ptr, mean_ptr, rstd_ptr, N, eps, CB: tl.constexpr, BLOCK: tl.constexpr):\n    b = tl.program_id(0)\n    offs = tl.arange(0, BLOCK)\n    mask = offs < CB\n    s = tl.load(psum_ptr + b * CB + offs, mask=mask, other=0.0)\n    s2 = tl.load(psum2_ptr + b * CB +"]
[317.394824, "i", " offs, mask=mask, other=0.0)\n    total = tl.sum(s)\n    total2 = tl.sum(s2)\n    mean = total / N\n    var = total2 / N - mean * mean\n    var = tl.maximum(var, 0.0)\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(mean_ptr + b, mean)\n    tl.store(rstd_ptr + b, rstd)\n\n\n@triton.jit\ndef _norm_kernel(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N, CN: tl.constexpr, BLOCK: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CN\n    mean = tl.load(mean_ptr + pid_b)\n    rstd = tl.load(rstd_ptr + pid_b)\n    x_base = pid_b * N + pid_c * chunk\n    w_base = pid_c * chunk\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + x_base + idx)\n        w = tl.load(w_ptr + w_base + idx)\n        bb = tl.load(b_ptr + w_base + idx)\n        a = w * rstd\n        c = bb - mean * a\n        tl.store(out_ptr + x_base + idx, v * a + c)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super(ModelNew, self).__ini"]
[317.394847, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[317.395024, "i", "t__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n        self.N = 1\n        for d in self.normalized_shape:\n            self.N *= d\n        self.eps = self.ln.eps\n        self.CB = 32\n        self.CN = 32\n        self.BLOCK_S = 8192\n        self.BLOCK_N = 8192\n        # reduce split factors until they divide N evenly\n        while self.CB > 1 and (self.N % self.CB != 0 or (self.N // self.CB) % self.BLOCK_S != 0):\n            self.CB //= 2\n        while self.CN > 1 and (self.N % self.CN != 0 or (self.N // self.CN) % self.BLOCK_N != 0):\n            self.CN //= 2\n        self.ok = (self.N % self.CB == 0 and (self.N // self.CB) % self.BLOCK_S == 0\n                   and self.N % self.CN == 0 and (self.N // self.CN) % self.BLOCK_N == 0)\n        CB = self.CB\n        # preallocated workspaces (moved with .to(device))\n        self.register_buffer('psum', torch.zeros(4096, CB), persistent=False)\n        self.register_buffer('psum2', torch.z"]
[317.395117, "o", "\u001b[?2004h> "]
[317.395238, "i", "eros(4096, CB), persistent=False)\n        self.register_buffer('mean', torch.zeros(4096), persistent=False)\n        self.register_buffer('rstd', torch.zeros(4096), persistent=False)\n        self.register_buffer('wflat', self.ln.weight.reshape(-1).clone(), persistent=False)\n        self.register_buffer('bflat', self.ln.bias.reshape(-1).clone(), persistent=False)\n\n    def _sync_params(self):\n        self.wflat.copy_(self.ln.weight.detach().reshape(-1))\n        self.bflat.copy_(self.ln.bias.detach().reshape(-1))\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not self.ok:\n            return self.ln(x)\n        x = x.contiguous()\n        B = x.numel() // self.N\n        if B > self.psum.shape[0]:\n            return self.ln(x)\n        self._sync_params()\n        N = self.N\n        out = torch.empty_like(x)\n        xf = x.view(-1)\n        of = out.view(-1)\n        _stats_kernel[(B, self.CB)](xf, self.psum, self.psum2, N, CB=self.CB, BLOCK=self.BLOCK_S, num_warps=8)\n        _combine_kernel[(B,)](se"]
[317.395354, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[317.395417, "i", "lf.psum, self.psum2, self.mean, self.rstd, N, self.eps, CB=self.CB, BLOCK=32, num_warps=1)\n        _norm_kernel[(B, self.CN)](xf, self.wflat, self.bflat, self.mean, self.rstd, of, N, CN=self.CN, BLOCK=self.BLOCK_N, num_warps=8)\n        return out\nEOF\ncat > /workspace/test_sol.py << 'EOF'\nimport torch, numpy as np\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\nsrc = open('/opt/task/reference.py').read()\nctx = {}; exec(src, ctx)\nModel = ctx['Model']; get_inputs = ctx['get_inputs']; get_init_inputs = ctx['get_init_inputs']\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).to(dev)\ntorch.manual_seed(42)\nnew = sol.ModelNew(*get_init_inputs()).to(dev)\nok = True\nfor t in range(5):\n    torch.manual_seed(100+t)\n    x = get_inputs()[0].to(dev)\n    with torch.no_grad():\n        o1 = ref(x); o2 = new(x)\n    md = (o1-o2).abs().max().item()\n    print(f'trial {t}:"]
[317.395445, "i", " max diff {md:.3e}', 'PASS' if torch.allclose(o1, o2, atol=1e-4, rtol=1e-4) else 'FAIL')\n    ok = ok and torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\nprint('correct:', ok)\nfrom kernelbench.timing import time_execution_with_cuda_event\ntorch.manual_seed(0)\nx = get_inputs()[0].to(dev)\ntimes = time_execution_with_cuda_event(new, [x], num_trials=30, verbose=False, device=dev)\nprint('solution mean ms:', np.mean(times), 'min:', np.min(times))\nEOF\npython3 /workspace/test_sol.py\n"]
