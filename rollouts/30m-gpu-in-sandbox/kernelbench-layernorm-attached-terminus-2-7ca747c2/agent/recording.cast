[610.26055, "i", "cat > /workspace/tune3.py << 'EOF'\nimport torch, numpy as np, itertools\nimport triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\n@triton.jit\ndef _copy(x_ptr, y_ptr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid * BLOCK * ITERS\n    for i in range(ITERS):\n        idx = base + i * BLOCK + tl.arange(0, BLOCK)\n        tl.store(y_ptr + idx, tl.load(x_ptr + idx))\n\n@triton.jit\ndef _readk(x_ptr, o_ptr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid * BLOCK * ITERS\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        idx = base + i * BLOCK + tl.arange(0, BLOCK)\n        acc += tl.load(x_ptr + idx)\n    tl.store(o_ptr + pid, tl.sum(acc))\n\n@triton.jit\ndef _stats_ev(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CB\n    base = pid_b * N + pid_c * chunk\n    acc = tl.zeros([BLOCK], "]
[610.260789, "i", "dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        if EV:\n            v = tl.load(x_ptr + base + idx, eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + idx)\n        acc += v\n        acc2 += v * v\n    tl.store(psum_ptr + pid_b * CB + pid_c, tl.sum(acc))\n    tl.store(psum2_ptr + pid_b * CB + pid_c, tl.sum(acc2))\n\ndev = torch.device('cuda')\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device=dev)\ny = torch.empty_like(x)\no1 = torch.zeros(4096, device=dev)\n\ndef timeit(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        clear_l2_cache(device=dev)\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)*1000\n\ntot = B*N\nprint('--- copy ceiling ---', flush=True)\nfor BLOCK, IT,"]
[610.260847, "i", " wp in itertools.product([4096,8192],[8,16],[4,8]):\n    G = tot // (BLOCK*IT)\n    if G*(BLOCK*IT) != tot: continue\n    t = timeit(lambda: _copy[(G,)](x, y, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    print(f'BLOCK={BLOCK} IT={IT} warps={wp}: {t:.1f} us  {537e6/t/1e3:.2f} TB/s', flush=True)\nprint('--- read ceiling ---', flush=True)\nfor BLOCK, IT, wp in itertools.product([8192,16384],[8,16],[8,16]):\n    G = tot // (BLOCK*IT)\n    if G*(BLOCK*IT) != tot: continue\n    t = timeit(lambda: _readk[(G,)](x, o1, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    print(f'BLOCK={BLOCK} IT={IT} warps={wp}: {t:.1f} us  {268e6/t/1e3:.2f} TB/s', flush=True)\nprint('--- stats evict ---', flush=True)\nfor CB, BS, wp, ev in itertools.product([32,64],[8192,16384],[8,16],[False,True]):\n    if N % CB or (N//CB) % BS: continue\n    ps = torch.zeros(B, CB, device=dev); ps2 = torch.zeros(B, CB, device=dev)\n    t = timeit(lambda: _stats_ev[(B,CB)](x, ps, ps2, N, CB=CB, BLOCK=BS, EV=ev, num_warps=wp))\n    print(f'CB={CB} BLOCK={BS} warps={wp} ev={ev}"]
[610.260864, "i", ": {t:.1f} us', flush=True)\nEOF\npython3 /workspace/tune3.py 2>&1 | tail -30\n"]
