[740.707607, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _stats_kernel(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CB\n    base = pid_b * N + pid_c * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx)\n        acc += v\n        acc2 += v * v\n    tl.store(psum_ptr + pid_b * CB + pid_c, tl.sum(acc))\n    tl.store(psum2_ptr + pid_b * CB + pid_c, tl.sum(acc2))\n\n\n@triton.jit\ndef _combine_kernel(psum_ptr, psum2_ptr, mean_ptr, rstd_ptr, N, eps, CB: tl.constexpr, BLOCK: tl.constexpr):\n    b = tl.program_id(0)\n    offs = tl.arange(0, BLOCK)\n    mask = offs < CB\n    s = tl.load(psum_ptr + b * CB + offs, mask=mask, other=0.0)\n    s2 = tl.load(psum2_ptr + b * CB + offs, mask=mask, othe"]
[740.707892, "i", "r=0.0)\n    total = tl.sum(s)\n    total2 = tl.sum(s2)\n    mean = total / N\n    var = total2 / N - mean * mean\n    var = tl.maximum(var, 0.0)\n    rstd = 1.0 / tl.sqrt(var + eps)\n    tl.store(mean_ptr + b, mean)\n    tl.store(rstd_ptr + b, rstd)\n\n\n@triton.jit\ndef _norm_rows_kernel(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N,\n                      B: tl.constexpr, COLS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    base_col = pid * COLS\n    for off in range(0, COLS, BLOCK):\n        idx = base_col + off + tl.arange(0, BLOCK)\n        w = tl.load(w_ptr + idx)\n        bb = tl.load(b_ptr + idx)\n        for j in tl.static_range(B):\n            m = tl.load(mean_ptr + j)\n            r = tl.load(rstd_ptr + j)\n            a = w * r\n            c = bb - m * a\n            v = tl.load(x_ptr + j * N + idx)\n            tl.store(out_ptr + j * N + idx, v * a + c)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super(ModelNew, self).__init__()\n        self.ln = nn.L"]
[740.70799, "i", "ayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n        N = 1\n        for d in self.normalized_shape:\n            N *= d\n        self.N = N\n        self.eps = self.ln.eps\n        # tuned configs for N divisible by large powers of two\n        self.CB = 64\n        self.BS = 8192\n        self.COLS = 4096\n        self.BN = 4096\n        self.ok = (N % self.CB == 0 and (N // self.CB) % self.BS == 0\n                   and N % self.COLS == 0 and self.COLS % self.BN == 0)\n        self.register_buffer('psum', torch.zeros(4096, self.CB), persistent=False)\n        self.register_buffer('psum2', torch.zeros(4096, self.CB), persistent=False)\n        self.register_buffer('mean', torch.zeros(4096), persistent=False)\n        self.register_buffer('rstd', torch.zeros(4096), persistent=False)\n        self.register_buffer('wflat', self.ln.weight.detach().reshape(-1).clone(), persistent=False)\n        self.register_buffer('bflat', self.ln.bias.detach().reshape(-1).clone(), persist"]
[740.70814, "i", "ent=False)\n        self._pw = self.ln.weight\n        self._pw_ver = self.ln.weight._version\n        self._pb = self.ln.bias\n        self._pb_ver = self.ln.bias._version\n        self._graph = None\n        self._g_in_ptr = None\n        self._g_shape = None\n        self._g_out = None\n        self._seen = {}\n\n    def _params_current(self):\n        w = self.ln.weight\n        b = self.ln.bias\n        if w is not self._pw or w._version != self._pw_ver or b is not self._pb or b._version != self._pb_ver:\n            with torch.no_grad():\n                self.wflat.copy_(w.detach().reshape(-1))\n                self.bflat.copy_(b.detach().reshape(-1))\n            self._pw = w; self._pw_ver = w._version\n            self._pb = b; self._pb_ver = b._version\n\n    def _launch(self, x, out, B):\n        N = self.N\n        xf = x.view(-1)\n        of = out.view(-1)\n        _stats_kernel[(B, self.CB)](xf, self.psum, self.psum2, N, CB=self.CB, BLOCK=self.BS, num_warps=16)\n        _combine_kernel[(B,)](self.psum, self.psum2, self.me"]
[740.708241, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[740.708317, "i", "an, self.rstd, N, self.eps, CB=self.CB, BLOCK=64, num_warps=2)\n        _norm_rows_kernel[(N // self.COLS,)](xf, self.wflat, self.bflat, self.mean, self.rstd, of, N,\n                                             B=B, COLS=self.COLS, BLOCK=self.BN, num_warps=4)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not self.ok or not x.is_cuda:\n            return self.ln(x)\n        x = x.contiguous()\n        B = x.numel() // self.N\n        if B > self.psum.shape[0]:\n            return self.ln(x)\n        self._params_current()\n        key = x.data_ptr()\n        if self._graph is not None:\n            if key == self._g_in_ptr and x.shape == self._g_shape:\n                self._graph.replay()\n                return self._g_out\n        else:\n            cnt = self._seen.get(key, 0) + 1\n            self._seen[key] = cnt\n            if cnt >= 2 and len(self._seen) >= 2:\n                try:\n                    out = torch.empty_like(x)\n                    g = torch.cuda.CUDAGraph()\n                    wit"]
[740.708459, "o", "> "]
[740.708575, "i", "h torch.cuda.graph(g):\n                        self._launch(x, out, B)\n                    self._graph = g\n                    self._g_in_ptr = key\n                    self._g_shape = x.shape\n                    self._g_out = out\n                    g.replay()\n                    return out\n                except Exception:\n                    self._graph = None\n                    self._seen = {}\n        out = torch.empty_like(x)\n        self._launch(x, out, B)\n        return out\nEOF\ncat > /workspace/test_sol.py << 'EOF'\nimport torch, numpy as np\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\nsrc = open('/opt/task/reference.py').read()\nctx = {}; exec(src, ctx)\nModel = ctx['Model']; get_inputs = ctx['get_inputs']; get_init_inputs = ctx['get_init_inputs']\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).to(dev)\ntorch.manual_seed(42)\nnew = sol.Model"]
[740.70865, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r"]
[740.708689, "i", "New(*get_init_inputs()).to(dev)\nok = True\nfor t in range(5):\n    torch.manual_seed(100+t)\n    x = get_inputs()[0].to(dev)\n    with torch.no_grad():\n        o1 = ref(x); o2 = new(x)\n    good = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\n    print(f'trial {t}: max diff {(o1-o2).abs().max().item():.3e}', 'PASS' if good else 'FAIL')\n    ok = ok and good\n# graph path: repeated calls with the SAME tensor\nx = get_inputs()[0].to(dev)\nwith torch.no_grad():\n    o1 = ref(x)\n    for i in range(6):\n        o2 = new(x)\n    good = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\n    print('repeated-call (graph) output:', 'PASS' if good else 'FAIL', (o1-o2).abs().max().item())\n    ok = ok and good\n    # param update after capture\n    new.ln.weight.mul_(2.0)\n    o1b = ref(x); o2b = new(x)\n    good = torch.allclose(o1b, o2b, atol=1e-4, rtol=1e-4)\n    print('param-update:', 'PASS' if good else 'FAIL')\n    ok = ok and good\n    new.ln.weight.div_(2.0)\nprint('correct:', ok)\nfrom kernelbench.timing import time_execution_with_cuda_even"]
[740.708701, "o", "\u001b[?2004h"]
[740.708729, "i", "t\ntorch.manual_seed(0)\nx = get_inputs()[0].to(dev)\ntimes = time_execution_with_cuda_event(new, [x], num_trials=30, verbose=False, device=dev)\nprint('solution mean ms:', np.mean(times), 'min:', np.min(times))\nEOF\npython3 /workspace/test_sol.py\n"]
