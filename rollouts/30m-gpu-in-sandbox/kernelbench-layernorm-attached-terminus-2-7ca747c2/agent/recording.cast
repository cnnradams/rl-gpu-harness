[836.24053, "i", "cat > /workspace/test_sol2.py << 'EOF'\nimport torch, numpy as np\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\nsrc = open('/opt/task/reference.py').read()\nctx = {}; exec(src, ctx)\nModel = ctx['Model']; get_inputs = ctx['get_inputs']; get_init_inputs = ctx['get_init_inputs']\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).to(dev)\ntorch.manual_seed(42)\nnew = sol.ModelNew(*get_init_inputs()).to(dev)\nok = True\nfor t in range(5):\n    torch.manual_seed(100+t)\n    x = get_inputs()[0].to(dev)\n    with torch.no_grad():\n        o1 = ref(x); o2 = new(x)\n    good = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\n    print(f'trial {t}:', 'PASS' if good else 'FAIL')\n    ok = ok and good\nx = get_inputs()[0].to(dev)\nwith torch.no_grad():\n    o1 = ref(x)\n    for i in range(6):\n        o2 = new(x)\n    good = torch.allclose(o1, o2, atol=1e-4, rtol=1e-4)\n    print('gr"]
[836.240845, "i", "aph path:', 'PASS' if good else 'FAIL')\n    ok = ok and good\n    # update BOTH models' params identically\n    ref.ln.weight.mul_(2.0); new.ln.weight.mul_(2.0)\n    ref.ln.bias.add_(0.5); new.ln.bias.add_(0.5)\n    o1b = ref(x); o2b = new(x)\n    good = torch.allclose(o1b, o2b, atol=1e-4, rtol=1e-4)\n    print('param-update (both):', 'PASS' if good else 'FAIL', (o1b-o2b).abs().max().item())\n    ok = ok and good\n    # fresh input values into the SAME captured buffer\n    x.copy_(torch.rand_like(x) * 3 - 1)\n    o1c = ref(x); o2c = new(x)\n    good = torch.allclose(o1c, o2c, atol=1e-4, rtol=1e-4)\n    print('in-place input update:', 'PASS' if good else 'FAIL', (o1c-o2c).abs().max().item())\n    ok = ok and good\nprint('correct:', ok)\nEOF\npython3 /workspace/test_sol2.py\n"]
