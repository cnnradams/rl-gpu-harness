[542.637815, "i", "cat > /workspace/tune2.py << 'EOF'\nimport torch, numpy as np, itertools\nimport triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\n@triton.jit\ndef _copy(x_ptr, y_ptr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid * BLOCK * ITERS\n    for i in range(ITERS):\n        idx = base + i * BLOCK + tl.arange(0, BLOCK)\n        tl.store(y_ptr + idx, tl.load(x_ptr + idx))\n\n@triton.jit\ndef _readk(x_ptr, o_ptr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    base = pid * BLOCK * ITERS\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        idx = base + i * BLOCK + tl.arange(0, BLOCK)\n        acc += tl.load(x_ptr + idx)\n    tl.store(o_ptr + pid, tl.sum(acc))\n\n@triton.jit\ndef _stats_ev(x_ptr, psum_ptr, psum2_ptr, N, CB: tl.constexpr, BLOCK: tl.constexpr):\n    pid_b = tl.program_id(0)\n    pid_c = tl.program_id(1)\n    chunk = N // CB\n    base = pid_b * N + pid_c * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n"]
[542.637988, "i", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, chunk, BLOCK):\n        idx = off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + idx, eviction_policy='evict_first')\n        acc += v\n        acc2 += v * v\n    tl.store(psum_ptr + pid_b * CB + pid_c, tl.sum(acc))\n    tl.store(psum2_ptr + pid_b * CB + pid_c, tl.sum(acc2))\n\n@triton.jit\ndef _norm_rows(x_ptr, w_ptr, b_ptr, mean_ptr, rstd_ptr, out_ptr, N, B: tl.constexpr, COLS: tl.constexpr, BLOCK: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    base_col = pid * COLS\n    for off in range(0, COLS, BLOCK):\n        idx = base_col + off + tl.arange(0, BLOCK)\n        w = tl.load(w_ptr + idx)\n        bb = tl.load(b_ptr + idx)\n        for j in tl.static_range(B):\n            m = tl.load(mean_ptr + j)\n            r = tl.load(rstd_ptr + j)\n            a = w * r\n            c = bb - m * a\n            if EV:\n                v = tl.load(x_ptr + j * N + idx, eviction_policy='evict_first')\n                tl.store(out_ptr + j * N + i"]
[542.638213, "i", "dx, v * a + c, eviction_policy='evict_first')\n            else:\n                v = tl.load(x_ptr + j * N + idx)\n                tl.store(out_ptr + j * N + idx, v * a + c)\n\ndev = torch.device('cuda')\nB, N = 16, 64*256*256\nx = torch.rand(B, N, device=dev)\ny = torch.empty_like(x)\nw = torch.rand(N, device=dev); b = torch.rand(N, device=dev)\nmean = x.mean(1).contiguous(); rstd = (x.var(1, unbiased=False)+1e-5).rsqrt().contiguous()\nout = torch.empty_like(x)\no1 = torch.zeros(4096, device=dev)\n\ndef timeit(fn, n=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        clear_l2_cache(device=dev)\n        s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return np.mean(ts)*1000\n\ntot = B*N\nprint('--- copy ceiling ---')\nfor BLOCK, IT, wp in itertools.product([4096,8192,16384],[4,8,16],[4,8]):\n    G = tot // (BLOCK*IT)\n    if G*(BLOCK*IT) != "]
[542.638267, "o", "cat > /workspace/tune2.py << 'EOF'\r\n\u001b[?2004l\r"]
[542.638408, "i", "tot: continue\n    t = timeit(lambda: _copy[(G,)](x, y, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    print(f'BLOCK={BLOCK} IT={IT} warps={wp}: {t:.1f} us  {537e6/t/1e3:.2f} TB/s')\nprint('--- read ceiling ---')\nfor BLOCK, IT, wp in itertools.product([8192,16384],[4,8,16],[4,8,16]):\n    G = tot // (BLOCK*IT)\n    if G*(BLOCK*IT) != tot: continue\n    t = timeit(lambda: _readk[(G,)](x, o1, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    print(f'BLOCK={BLOCK} IT={IT} warps={wp}: {t:.1f} us  {268e6/t/1e3:.2f} TB/s')\nprint('--- stats evict_first ---')\nfor CB, BS, wp in itertools.product([32,64],[8192,16384],[8,16]):\n    if N % CB or (N//CB) % BS: continue\n    ps = torch.zeros(B, CB, device=dev); ps2 = torch.zeros(B, CB, device=dev)\n    t = timeit(lambda: _stats_ev[(B,CB)](x, ps, ps2, N, CB=CB, BLOCK=BS, num_warps=wp))\n    print(f'CB={CB} BLOCK={BS} warps={wp}: {t:.1f} us')\nprint('--- norm rows variant ---')\nfor COLS, BS, wp, ev in itertools.product([4096,8192,16384],[1024,2048,4096],[4,8],[False,True]):\n    if COLS % BS or N %"]
[542.638465, "o", "\u001b[?2004h> "]
[542.638488, "i", " COLS: continue\n    t = timeit(lambda: _norm_rows[(N//COLS,)](x, w, b, mean, rstd, out, N, B=B, COLS=COLS, BLOCK=BS, EV=ev, num_warps=wp))\n    print(f'COLS={COLS} BLOCK={BS} warps={wp} ev={ev}: {t:.1f} us')\nEOF\npython3 /workspace/tune2.py\n"]
