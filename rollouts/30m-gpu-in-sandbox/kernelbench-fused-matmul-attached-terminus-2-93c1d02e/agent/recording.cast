[1690.073749, "i", "cat > /workspace/bench10.py << 'PYEOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\ndef alloc_fn(size: int, alignment: int, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\n@triton.jit\ndef _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    x = tl.load(X + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    tl.store(Hi + offs, hi, mask=mask)\n    tl.store(Lo + offs, lo, mask=mask)\n\n@triton.jit\ndef _gemm_hybrid(A, Wh, Wl, Bias, C, M, N, K,\n                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                 GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROU"]
[1690.074006, "i", "P_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    a_desc = tl.make_tensor_descriptor(A, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    wh_desc = tl.make_tensor_descriptor(Wh, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    wl_desc = tl.make_tensor_descriptor(Wl, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = a_desc.load([off_m, k])\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        w_hi = wh_desc.load([k, off_n])\n        w_lo = wl_desc.load([k, off_n])\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n    bias = tl.load(Bias + off_n + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc)\n\n@triton.jit\ndef _"]
[1690.074086, "i", "gemm(Ah, Al, Wh, Wl, Bias, C, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n          GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    a_desc = tl.make_tensor_descriptor(Ah, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    al_desc = tl.make_tensor_descriptor(Al, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    wh_desc = tl.make_tensor_descriptor(Wh, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    wl_desc = tl.make_tensor_descriptor(Wl, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range("]
[1690.07422, "i", "0, K, BK):\n        a_hi = a_desc.load([off_m, k])\n        a_lo = al_desc.load([off_m, k])\n        w_hi = wh_desc.load([k, off_n])\n        w_lo = wl_desc.load([k, off_n])\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n    bias = tl.load(Bias + off_n + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc)\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\nref = F.linear(x, w, b)\nwt = w.t().contiguous()\n\ndef split_tensor(x):\n    numel = x.numel()\n    hi = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    lo = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    grid = (triton.cdiv(numel, 8192),)\n    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=8192, num_warps=8)\n    return hi, lo\n\nx_hi, x_lo = split_tensor(x)\nw_hi, w_lo = split_tensor(wt)\nou"]
[1690.074258, "i", "t = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nfor (BM,BN,BK,GM,st,wp) in [(128,128,32,8,3,8),(128,128,64,8,3,8),(128,256,32,8,3,8),(128,256,64,8,3,8),(256,128,32,8,3,8),(128,128,32,8,2,8)]:\n    try:\n        def run():\n            grid = (triton.cdiv(16384,BM)*triton.cdiv(4096,BN),)\n            _gemm_hybrid[grid](x, w_hi, w_lo, b, out, 16384, 4096, 4096,\n                               BM=BM, BN=BN, BK=BK, GROUP_M=GM, num_warps=wp, num_stages=st)\n        t = timeit(run)\n        err = (out - ref).abs()\n        thr = 1e-4 + 1e-4 * ref.abs()\n        print('HYB BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: %.3f ms viol %d' % (BM,BN,BK,GM,st"]
[1690.07433, "i", ",wp,t,(err>thr).sum().item()), flush=True)\n    except Exception as e:\n        print('HYB BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: FAILED %s' % (BM,BN,BK,GM,st,wp,str(e)[:60]), flush=True)\n\nfor (BM,BN,BK,GM,st,wp) in [(128,128,32,4,3,8),(128,128,32,16,3,8),(128,128,32,8,3,4),(128,128,32,8,5,8)]:\n    try:\n        def run():\n            grid = (triton.cdiv(16384,BM)*triton.cdiv(4096,BN),)\n            _gemm[grid](x_hi, x_lo, w_hi, w_lo, b, out, 16384, 4096, 4096,\n                        BM=BM, BN=BN, BK=BK, GROUP_M=GM, num_warps=wp, num_stages=st)\n        t = timeit(run)\n        print('PRE BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: %.3f ms' % (BM,BN,BK,GM,st,wp,t), flush=True)\n    except Exception as e:\n        print('PRE BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: FAILED %s' % (BM,BN,BK,GM,st,wp,str(e)[:60]), flush=True)\nPYEOF\npython3 /workspace/bench10.py 2>&1 | grep -E '^(HYB|PRE)'\n"]
