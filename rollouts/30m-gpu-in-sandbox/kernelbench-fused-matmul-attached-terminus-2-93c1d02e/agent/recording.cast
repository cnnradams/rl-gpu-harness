[785.220703, "i", "python3 - << 'EOF'\nimport torch\nprint(torch.__version__, torch.version.cuda)\nx = torch.rand(16384, 4096, device='cuda')\nw = torch.randn(4096, 4096, device='cuda')\nb = torch.randn(4096, device='cuda')\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nprint('mm x@w.T: %.3f' % timeit(lambda: torch.mm(x, w.t())))\nxt = x.t().contiguous()\nprint('mm (w@xt): %.3f' % timeit(lambda: torch.mm(w, xt)))\nprint('addmm: %.3f' % timeit(lambda: torch.addmm(b, x, w.t())))\nimport os\nprint('CUBLAS_WORKSPACE_CONFIG:', os.environ.get('CUBLAS_WORKSPACE_CONFIG'))\nEOF\n"]
