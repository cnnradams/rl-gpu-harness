[613.722967, "o", "def _gemm_fp16x3(Ah, Al, Wh, Wl, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[613.723092, "o", "\u001b[?2004h> "]
[613.723495, "o", "                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[613.723557, "o", "\u001b[?2004h> "]
[613.723897, "o", "                 GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.724147, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.724336, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[613.724425, "o", "\u001b[?2004h> "]
[613.724655, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.724858, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[613.724957, "o", "\u001b[?2004h> "]
[613.725187, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.72564, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[613.725802, "o", "\u001b[?2004h> "]
[613.726079, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[613.726189, "o", "\u001b[?2004h> "]
[613.726418, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[613.726506, "o", "\u001b[?2004h> "]
[613.726756, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[613.726846, "o", "\u001b[?2004h> "]
[613.727103, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[613.727185, "o", "\u001b[?2004h> "]
[613.727413, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.727731, "o", "    Ah_ptr = Ah + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[613.727795, "o", "\u001b[?2004h"]
[613.727815, "o", "> "]
[613.728194, "o", "    Al_ptr = Al + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.728567, "o", "    Wh_ptr = Wh + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.728877, "o", "    Wl_ptr = Wl + rk[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[613.728925, "o", "\u001b[?2004h"]
[613.729, "o", "> "]
[613.729341, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.729605, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.729823, "o", "        a_hi = tl.load(Ah_ptr)\r\n\u001b[?2004l\r"]
[613.729848, "o", "\u001b[?2004h"]
[613.729939, "o", "> "]
[613.730113, "o", "        a_lo = tl.load(Al_ptr)\r\n\u001b[?2004l\r"]
[613.730199, "o", "\u001b[?2004h> "]
[613.730391, "o", "        w_hi = tl.load(Wh_ptr)\r\n\u001b[?2004l\r"]
[613.730486, "o", "\u001b[?2004h> "]
[613.730677, "o", "        w_lo = tl.load(Wl_ptr)\r\n\u001b[?2004l\r"]
[613.730783, "o", "\u001b[?2004h> "]
[613.731061, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.731314, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r"]
[613.731401, "o", "\u001b[?2004h> "]
[613.731639, "o", "        acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r"]
[613.731723, "o", "\u001b[?2004h> "]
[613.73192, "o", "        Ah_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.732137, "o", "        Al_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.732385, "o", "        Wh_ptr += BK * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.73257, "o", "        Wl_ptr += BK * N\r\n\u001b[?2004l\r"]
[613.732668, "o", "\u001b[?2004h> "]
[613.732913, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.733191, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.733515, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r"]
[613.733577, "o", "\u001b[?2004h> "]
[613.733757, "o", "    tl.store(C_ptr, acc)\r\n\u001b[?2004l\r"]
[613.733838, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[613.733903, "o", "\u001b[?2004h"]
[613.733923, "o", "> "]
[613.734068, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[613.734116, "o", "\u001b[?2004h"]
[613.73414, "o", "> "]
[613.734434, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[613.734457, "o", "\u001b[?2004h"]
[613.734595, "o", "> "]
[613.734934, "o", "w = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.735319, "o", "b = torch.randn(4096, device='cuda') * (1/64.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.73548, "o", "ref = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[613.735604, "o", "\u001b[?2004h> "]
[613.73572, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[613.735802, "o", "\u001b[?2004h> "]
[613.736025, "o", "w_hi_t, w_lo_t = split_tensor(wt)\r\n\u001b[?2004l\r"]
[613.736105, "o", "\u001b[?2004h> "]
[613.73635, "o", "x_hi, x_lo = split_tensor(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.736806, "o", "out = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[613.73683, "o", "\u001b[?2004h"]
[613.736974, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.737039, "o", "def run():\r\n\u001b[?2004l\r"]
[613.73711, "o", "\u001b[?2004h> "]
[613.737686, "o", "    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\r\n\u001b[?2004l\r"]
[613.737745, "o", "\u001b[?2004h"]
[613.737762, "o", "> "]
[613.738272, "o", "    _gemm_fp16x3[grid](x_hi, x_lo, w_hi_t, w_lo_t, b, out, 16384, 4096, 4096)\r\n\u001b[?2004l\r"]
[613.738297, "o", "\u001b[?2004h"]
[613.738358, "o", "> \r\n\u001b[?2004l\r"]
[613.738473, "o", "\u001b[?2004h> "]
[613.738593, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r"]
[613.738614, "o", "\u001b[?2004h"]
[613.738671, "o", "> "]
[613.738847, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[613.738972, "o", "\u001b[?2004h> "]
[613.73918, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.739806, "o", "    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.73993, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[613.740037, "o", "> "]
[613.740133, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[613.740221, "o", "\u001b[?2004h> "]
[613.740492, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.740747, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[613.740833, "o", "\u001b[?2004h> "]
[613.741099, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.741403, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.741592, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r"]
[613.74168, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[613.741703, "o", "\u001b[?2004h"]
[613.741766, "o", "> "]
[613.741887, "o", "t = timeit(run)\r\n\u001b[?2004l\r\u001b[?2004h"]
[613.741933, "o", "> "]
[613.742162, "o", "err = (out - ref).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.742366, "o", "thr = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[613.742451, "o", "\u001b[?2004h> "]
[613.74286, "o", "print('gemm: %.3f ms, best: %s' % (t, _gemm_fp16x3.best_config))\r\n\u001b[?2004l\r"]
[613.74295, "o", "\u001b[?2004h> "]
[613.743481, "o", "print('max err %.3e, violates: %d' % (err.max().item(), (err > thr).sum().item()))\r\n\u001b[?2004l\r"]
[613.743501, "o", "\u001b[?2004h"]
[613.743589, "o", "> EOF\r\n\u001b[?2004l\r"]
