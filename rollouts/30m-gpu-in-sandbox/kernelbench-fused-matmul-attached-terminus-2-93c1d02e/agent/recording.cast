[690.925188, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[690.92521, "o", "\u001b[?2004l\r"]
[690.925333, "o", "\u001b[?2004h> "]
[690.925514, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[690.925801, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[690.926213, "o", "w = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[690.926505, "o", "b = torch.randn(4096, device='cuda') * (1/64.0)\r\n\u001b[?2004l\r"]
[690.926613, "o", "\u001b[?2004h> "]
