[613.705352, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\n@triton.jit\ndef _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    x = tl.load(X + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    tl.store(Hi + offs, hi, mask=mask)\n    tl.store(Lo + offs, lo, mask=mask)\n\ndef split_tensor(x):\n    numel = x.numel()\n    hi = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    lo = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    BLOCK = 4096\n    grid = (triton.cdiv(numel, BLOCK),)\n    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=BLOCK, num_warps=4)\n    return hi, lo\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROU"]
[613.705664, "i", "P_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 128, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=16),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=4, num_warps=16),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 128, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 128, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _gemm_fp16x3(Ah, Al, Wh, Wl, Bias, C, M, N, K,\n                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                 GROUP_M: tl."]
[613.705755, "i", "constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ah_ptr = Ah + rm[:, None] * K + rk[None, :]\n    Al_ptr = Al + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rk[:, None] * N + rn[None, :]\n    Wl_ptr = Wl + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a_hi = tl.load(Ah_ptr)\n        a_lo = tl.load(Al_ptr)\n        w_hi = tl.load(Wh_ptr)\n        w_lo = tl.load(Wl_ptr)\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n        Ah_ptr += BK\n        Al_ptr += BK\n        Wh_ptr += BK * N\n        Wl_ptr += BK * N\n    bias = "]
[613.705906, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[613.706005, "i", "tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\nref = F.linear(x, w, b)\nwt = w.t().contiguous()\nw_hi_t, w_lo_t = split_tensor(wt)\nx_hi, x_lo = split_tensor(x)\nout = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\n\ndef run():\n    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\n    _gemm_fp16x3[grid](x_hi, x_lo, w_hi_t, w_lo_t, b, out, 16384, 4096, 4096)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nt = "]
[613.706035, "i", "timeit(run)\nerr = (out - ref).abs()\nthr = 1e-4 + 1e-4 * ref.abs()\nprint('gemm: %.3f ms, best: %s' % (t, _gemm_fp16x3.best_config))\nprint('max err %.3e, violates: %d' % (err.max().item(), (err > thr).sum().item()))\nEOF\npython3 /workspace/bench3.py\n"]
