[1696.167878, "o", "\u001b[01;31m\u001b[KPRE\u001b[m\u001b[K BM=128 BN=128 BK=32 GM=8 st=3 wp=4: 2.345 ms\r\n"]
[1696.473396, "o", "\u001b[01;31m\u001b[KPRE\u001b[m\u001b[K BM=128 BN=128 BK=32 GM=8 st=5 wp=8: 2.934 ms\r\n"]
