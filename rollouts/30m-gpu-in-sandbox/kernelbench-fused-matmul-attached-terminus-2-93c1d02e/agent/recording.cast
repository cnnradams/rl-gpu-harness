[1065.974079, "o", "\u001b[?2004h> "]
[1065.974388, "o", "        w_hi = wh_desc.load([k, off_n])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.974729, "o", "        w_lo = wl_desc.load([k, off_n])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.975, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r"]
[1065.975123, "o", "\u001b[?2004h> "]
[1065.975389, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.97572, "o", "        acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.976143, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BN))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.976356, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1065.976448, "o", "\u001b[?2004h> "]
[1065.976692, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[1065.976734, "o", "\u001b[?2004h"]
[1065.976802, "o", "> \r\n\u001b[?2004l\r"]
[1065.976866, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1065.976933, "o", "\u001b[?2004h> "]
[1065.977256, "o", "_BM, _BN, _BK, _GM = 128, 128, 64, 8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.977305, "o", "\r\n\u001b[?2004l\r"]
[1065.977328, "o", "\u001b[?2004h"]
[1065.97739, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.977483, "o", "> "]
[1065.977697, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.977795, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.977868, "o", "> "]
[1065.978069, "o", "    Optimized reference model.\r\n\u001b[?2004l\r"]
[1065.978092, "o", "\u001b[?2004h"]
[1065.978187, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1065.978207, "o", "> "]
[1065.978681, "o", "    Math: out = (x @ W^T + b) * (1 + s) = x @ (W*(1+s))^T + b*(1+s)\r\n\u001b[?2004l\r"]
[1065.978707, "o", "\u001b[?2004h"]
[1065.978804, "o", "> "]
[1065.97919, "o", "    The (1+s) factor is folded into the weights once.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1065.97928, "o", "\u001b[?2004h> "]
[1065.979807, "o", "    The FP32 GEMM is evaluated with an fp16 error-compensation scheme:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.980329, "o", "    each FP32 operand is split as v = v_hi + v_lo (both fp16), and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.980783, "o", "    x @ w ~= x_hi@w_hi + x_hi@w_lo + x_lo@w_hi accumulated in fp32.\r\n\u001b[?2004l\r"]
[1065.980873, "o", "\u001b[?2004h> "]
[1065.981381, "o", "    This gives ~fp32-level accuracy (error ~2^-22 relative) at fp16\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.981606, "o", "    tensor-core speed on H100.\r\n\u001b[?2004l\r"]
[1065.98163, "o", "\u001b[?2004h"]
[1065.981726, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[1065.98178, "o", "\u001b[?2004h"]
[1065.981828, "o", "> \r\n\u001b[?2004l\r"]
[1065.981878, "o", "\u001b[?2004h"]
[1065.981933, "o", "> "]
[1065.982361, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1065.982453, "o", "\u001b[?2004h> "]
[1065.98272, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[1065.982746, "o", "\u001b[?2004h"]
[1065.982857, "o", "> "]
[1065.983262, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.983566, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1065.98372, "o", "\u001b[?2004h> "]
[1065.983829, "o", "        self._ready = False\r\n\u001b[?2004l\r"]
[1065.983917, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1065.983978, "o", "\u001b[?2004h> "]
[1065.984162, "o", "    def _prepare(self):\r\n\u001b[?2004l\r"]
[1065.984187, "o", "\u001b[?2004h"]
[1065.984262, "o", "> "]
[1065.984533, "o", "        s = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[1065.984614, "o", "\u001b[?2004h> "]
[1065.984865, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.985206, "o", "            self.matmul.weight.mul_(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.985508, "o", "            self.matmul.bias.mul_(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.98593, "o", "            wt = self.matmul.weight.t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.986175, "o", "            self._wt = wt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.98655, "o", "            self._w_hi_t, self._w_lo_t = self._split(wt)\r\n\u001b[?2004l\r"]
[1065.986642, "o", "\u001b[?2004h> "]
[1065.987051, "o", "            self._bias = self.matmul.bias.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.987317, "o", "        self._ready = True\r\n\u001b[?2004l\r"]
[1065.987425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1065.987486, "o", "\u001b[?2004h> "]
[1065.987672, "o", "    @staticmethod\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.98788, "o", "    def _split(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.988069, "o", "        numel = x.numel()\r\n\u001b[?2004l\r"]
[1065.988219, "o", "\u001b[?2004h> "]
[1065.988611, "o", "        hi = torch.empty(x.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1065.988712, "o", "\u001b[?2004h> "]
[1065.989218, "o", "        lo = torch.empty(x.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.989389, "o", "        BLOCK = 8192\r\n\u001b[?2004l\r"]
[1065.98948, "o", "\u001b[?2004h> "]
[1065.989775, "o", "        grid = (triton.cdiv(numel, BLOCK),)\r\n\u001b[?2004l\r"]
[1065.989863, "o", "\u001b[?2004h> "]
[1065.990386, "o", "        _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel,\r\n\u001b[?2004l\r"]
[1065.990473, "o", "\u001b[?2004h> "]
[1065.990873, "o", "                            BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.991042, "o", "        return hi, lo\r\n\u001b[?2004l\r"]
[1065.991134, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1065.991183, "o", "\u001b[?2004h"]
[1065.991246, "o", "> "]
[1065.991385, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1065.991501, "o", "\u001b[?2004h> "]
[1065.99165, "o", "        if not self._ready:\r\n\u001b[?2004l\r"]
[1065.991796, "o", "\u001b[?2004h> "]
[1065.991973, "o", "            self._prepare()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.992204, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.992513, "o", "        N = self._w_hi_t.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.992715, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[1065.992745, "o", "\u001b[?2004h"]
[1065.992852, "o", "> "]
[1065.993038, "o", "        x_hi, x_lo = self._split(x)\r\n\u001b[?2004l\r"]
[1065.993104, "o", "\u001b[?2004h"]
[1065.993128, "o", "> "]
[1065.993605, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1065.993692, "o", "\u001b[?2004h> "]
[1065.994086, "o", "        grid = (triton.cdiv(M, _BM) * triton.cdiv(N, _BN),)\r\n\u001b[?2004l\r"]
[1065.994146, "o", "\u001b[?2004h> "]
[1065.994676, "o", "        _gemm_fp16x3_tma[grid](x_hi, x_lo, self._w_hi_t, self._w_lo_t,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.995033, "o", "                               self._bias, out, M, N, K,\r\n\u001b[?2004l\r"]
[1065.995122, "o", "\u001b[?2004h> "]
[1065.995609, "o", "                               BM=_BM, BN=_BN, BK=_BK, GROUP_M=_GM,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.996042, "o", "                               num_warps=8, num_stages=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.99624, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1065.996383, "o", "EOF\r\n\u001b[?2004l\r"]
[1065.999806, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1066.000614, "o", "cd /workspace && python3 /opt/task/evaluate.py /workspace/solution.py --output /workspace/report_v2.json 2>/dev/null | tail -30\r\n\u001b[?2004l\r"]
[1074.553913, "o", "  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 2.65,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.65,\r\n    \"std\": 0.0711,\r\n    \"min\": 2.57,\r\n    \"max\": 2.73,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 11.4,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.4,\r\n    \"std\": 0.0275,\r\n    \"min\": 11.4,\r\n"]
[1074.554135, "o", "    \"max\": 11.5,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"ff1e82a804249086711880b9614ecc7f3848229baa3822efc8e0d17b0f3f9262\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 4.30188679245283\r\n}\r\n"]
[1074.627101, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1151.929795, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\ndef alloc_fn(size: int, alignment: int, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8, }, num_stages=3, num_warps=8, num_ctas=2),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=2, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=2, num_warps=16),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=2, num_warps=8, num_ctas=2),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 4}, num_stages=3, num_warps=8, num_ctas=2),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 4}, num_stages=4, num_warps=8),\n     "]
[1151.929922, "i", "   triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GROUP_M': 8}, num_stages=2, num_warps=8),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _gemm_tma(Ah, Al, Wh, Wl, Bias, C, M, N, K,\n              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n              GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    a_desc = tl.make_tensor_descriptor(Ah, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    al_desc = tl.make_tensor_descriptor(Al, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    wh_desc = tl.make_tensor_descriptor(Wh, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    wl_desc = tl.make_tensor_descriptor(Wl, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n   "]
[1151.930118, "i", " c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a_hi = a_desc.load([off_m, k])\n        a_lo = al_desc.load([off_m, k])\n        w_hi = wh_desc.load([k, off_n])\n        w_lo = wl_desc.load([k, off_n])\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n    bias = tl.load(Bias + off_n + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc)\n\n@triton.jit\ndef _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    x = tl.load(X + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    tl.store(Hi + offs, hi, mask=mask)\n    tl.store(Lo + offs, lo, mask=mask)\n\ndef split_tensor(x, hi, lo, BLOCK=8192, warps=8):\n    numel = x.numel()\n    grid = (triton.cdiv(numel, BLO"]
[1151.930219, "i", "CK),)\n    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=BLOCK, num_warps=warps)\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\nref = F.linear(x, w, b)\nwt = w.t().contiguous()\nx_hi = torch.empty(x.shape, device='cuda', dtype=torch.float16)\nx_lo = torch.empty(x.shape, device='cuda', dtype=torch.float16)\nw_hi = torch.empty(wt.shape, device='cuda', dtype=torch.float16)\nw_lo = torch.empty(wt.shape, device='cuda', dtype=torch.float16)\nsplit_tensor(x, x_hi, x_lo)\nsplit_tensor(wt, w_hi, w_lo)\nout = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\n\ndef run():\n    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\n    _gemm_tma[grid](x_hi, x_lo, w_hi, w_lo, b, out, 16384, 4096, 4096)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch"]
[1151.930237, "i", ".cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nt = timeit(run)\nerr = (out - ref).abs()\nthr = 1e-4 + 1e-4 * ref.abs()\nprint('gemm: %.3f ms, best: %s' % (t, _gemm_tma.best_config))\nprint('max err %.3e, violates: %d' % (err.max().item(), (err > thr).sum().item()))\nfor BLOCK, warps in [(4096,4),(8192,8),(16384,8),(16384,16),(32768,16)]:\n    print('split BLOCK=%d warps=%d: %.3f ms' % (BLOCK, warps, timeit(lambda: split_tensor(x, x_hi, x_lo, BLOCK, warps))))\nEOF\npython3 /workspace/bench7.py 2>/dev/null | tail -8\n"]
[1151.930371, "o", "cat > /workspace/bench7.py << 'EOF'\r\n\u001b[?2004l\r"]
[1151.930498, "o", "\u001b[?2004h> "]
[1151.93063, "o", "import torch, triton\r\n\u001b[?2004l\r"]
[1151.930701, "o", "\u001b[?2004h> "]
[1151.93091, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[1151.930938, "o", "\u001b[?2004h"]
[1151.931024, "o", "> "]
[1151.931237, "o", "import torch.nn.functional as F\r\n\u001b[?2004l\r"]
[1151.931343, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1151.93142, "o", "\u001b[?2004h> "]
[1151.93178, "o", "def alloc_fn(size: int, alignment: int, stream):\r\n\u001b[?2004l\r"]
[1151.931947, "o", "\u001b[?2004h> "]
[1151.93238, "o", "    return torch.empty(size, device='cuda', dtype=torch.int8)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.932615, "o", "triton.set_allocator(alloc_fn)\r\n\u001b[?2004l\r"]
[1151.932718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.932776, "o", "> "]
[1151.932899, "o", "@triton.autotune(\r\n\u001b[?2004l\r"]
[1151.932997, "o", "\u001b[?2004h> "]
[1151.933086, "o", "    configs=[\r\n\u001b[?2004l\r"]
[1151.93314, "o", "\u001b[?2004h"]
[1151.933201, "o", "> "]
[1151.933841, "o", "        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r"]
[1151.933939, "o", "\u001b[?2004h> "]
[1151.934677, "o", "        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8, }, num_stages=3, num_warps=8, num_ctas=2),\r\n\u001b[?2004l\r"]
[1151.93474, "o", "\u001b[?2004h> "]
[1151.935398, "o", "        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=2, num_warps=8),\r\n\u001b[?2004l\r"]
[1151.935423, "o", "\u001b[?2004h"]
[1151.935523, "o", "> "]
[1151.936155, "o", "        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=2, num_warps=16),\r\n\u001b[?2004l\r"]
[1151.936182, "o", "\u001b[?2004h"]
[1151.936354, "o", "> "]
[1151.93698, "o", "        triton.Config({'BM': 256, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=2, num_warps=8, num_ctas=2),\r\n\u001b[?2004l\r"]
[1151.937103, "o", "\u001b[?2004h> "]
[1151.937912, "o", "        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 4}, num_stages=3, num_warps=8, num_ctas=2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.938005, "o", "> "]
[1151.938673, "o", "        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 4}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.939376, "o", "        triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GROUP_M': 8}, num_stages=2, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.939452, "o", "> "]
[1151.939584, "o", "    ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.93983, "o", "    key=['M', 'N', 'K'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.939856, "o", ")\r\n\u001b[?2004l\r"]
[1151.939969, "o", "\u001b[?2004h> "]
[1151.940089, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.940108, "o", "> "]
[1151.940447, "o", "def _gemm_tma(Ah, Al, Wh, Wl, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[1151.940509, "o", "\u001b[?2004h> "]
[1151.940983, "o", "              BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[1151.941108, "o", "\u001b[?2004h> "]
[1151.941334, "o", "              GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1151.941426, "o", "\u001b[?2004h> "]
[1151.941599, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1151.941746, "o", "\u001b[?2004h> "]
[1151.94188, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1151.942031, "o", "\u001b[?2004h> "]
[1151.942262, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.942474, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1151.942599, "o", "\u001b[?2004h> "]
[1151.942745, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1151.94289, "o", "\u001b[?2004h> "]
[1151.943274, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1151.943388, "o", "\u001b[?2004h> "]
[1151.943772, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.944057, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1151.944205, "o", "\u001b[?2004h> "]
[1151.944328, "o", "    off_m = pid_m * BM\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.944471, "o", "> "]
[1151.944561, "o", "    off_n = pid_n * BN\r\n\u001b[?2004l\r"]
[1151.944587, "o", "\u001b[?2004h"]
[1151.944599, "o", "> "]
[1151.945311, "o", "    a_desc = tl.make_tensor_descriptor(Ah, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.945945, "o", "    al_desc = tl.make_tensor_descriptor(Al, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[1151.945977, "o", "\u001b[?2004h"]
[1151.94611, "o", "> "]
[1151.946662, "o", "    wh_desc = tl.make_tensor_descriptor(Wh, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\r\n\u001b[?2004l\r"]
[1151.946722, "o", "\u001b[?2004h"]
[1151.94679, "o", "> "]
[1151.9474, "o", "    wl_desc = tl.make_tensor_descriptor(Wl, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\r\n\u001b[?2004l\r"]
[1151.947423, "o", "\u001b[?2004h"]
[1151.947554, "o", "> "]
[1151.948164, "o", "    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.948483, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1151.94861, "o", "\u001b[?2004h> "]
[1151.948763, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1151.948811, "o", "\u001b[?2004h"]
[1151.948891, "o", "> "]
[1151.949124, "o", "        a_hi = a_desc.load([off_m, k])\r\n\u001b[?2004l\r"]
[1151.949209, "o", "\u001b[?2004h> "]
[1151.949529, "o", "        a_lo = al_desc.load([off_m, k])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.949811, "o", "        w_hi = wh_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[1151.949836, "o", "\u001b[?2004h"]
[1151.949975, "o", "> "]
[1151.950187, "o", "        w_lo = wl_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[1151.950315, "o", "\u001b[?2004h> "]
[1151.950562, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r"]
[1151.950707, "o", "\u001b[?2004h> "]
[1151.950906, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r"]
[1151.95104, "o", "\u001b[?2004h> "]
[1151.951328, "o", "        acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.951737, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BN))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.951948, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1151.952027, "o", "\u001b[?2004h> "]
[1151.952295, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[1151.952384, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1151.952457, "o", "\u001b[?2004h> "]
[1151.952554, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1151.952637, "o", "\u001b[?2004h"]
[1151.952661, "o", "> "]
[1151.953017, "o", "def _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1151.953151, "o", "\u001b[?2004h> "]
[1151.953343, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.953654, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1151.953679, "o", "\u001b[?2004h"]
[1151.953772, "o", "> "]
[1151.953898, "o", "    mask = offs < numel\r\n\u001b[?2004l\r"]
[1151.954045, "o", "\u001b[?2004h> "]
[1151.954241, "o", "    x = tl.load(X + offs, mask=mask)\r\n\u001b[?2004l\r"]
[1151.954368, "o", "\u001b[?2004h> "]
[1151.954557, "o", "    hi = x.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.954878, "o", "    lo = (x - hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1151.954969, "o", "\u001b[?2004h> "]
[1151.955228, "o", "    tl.store(Hi + offs, hi, mask=mask)\r\n\u001b[?2004l\r"]
[1151.955326, "o", "\u001b[?2004h> "]
[1151.955625, "o", "    tl.store(Lo + offs, lo, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1151.955716, "o", "\u001b[?2004h> "]
[1151.956113, "o", "def split_tensor(x, hi, lo, BLOCK=8192, warps=8):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.956335, "o", "    numel = x.numel()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.956676, "o", "    grid = (triton.cdiv(numel, BLOCK),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.95744, "o", "    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=BLOCK, num_warps=warps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.957464, "o", "> \r\n\u001b[?2004l\r"]
[1151.957521, "o", "\u001b[?2004h"]
[1151.957577, "o", "> "]
[1151.957706, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[1151.95773, "o", "\u001b[?2004h"]
[1151.957861, "o", "> "]
[1151.95814, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.958516, "o", "w = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\r\n\u001b[?2004l\r"]
[1151.958569, "o", "\u001b[?2004h"]
[1151.95863, "o", "> "]
[1151.958915, "o", "b = torch.randn(4096, device='cuda') * (1/64.0)\r\n\u001b[?2004l\r"]
[1151.959042, "o", "\u001b[?2004h> "]
[1151.959186, "o", "ref = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[1151.959206, "o", "\u001b[?2004h"]
[1151.959266, "o", "> "]
[1151.95941, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[1151.959554, "o", "\u001b[?2004h> "]
[1151.959911, "o", "x_hi = torch.empty(x.shape, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1151.959965, "o", "\u001b[?2004h"]
[1151.960022, "o", "> "]
[1151.960428, "o", "x_lo = torch.empty(x.shape, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1151.960496, "o", "\u001b[?2004h> "]
[1151.960975, "o", "w_hi = torch.empty(wt.shape, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.960999, "o", "> "]
[1151.961435, "o", "w_lo = torch.empty(wt.shape, device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1151.961461, "o", "\u001b[?2004h"]
[1151.961594, "o", "> "]
[1151.961701, "o", "split_tensor(x, x_hi, x_lo)\r\n\u001b[?2004l\r"]
[1151.961797, "o", "\u001b[?2004h> "]
[1151.962045, "o", "split_tensor(wt, w_hi, w_lo)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.962525, "o", "out = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1151.962597, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1151.96262, "o", "\u001b[?2004h"]
[1151.962689, "o", "> "]
[1151.962748, "o", "def run():\r\n\u001b[?2004l\r"]
[1151.962814, "o", "\u001b[?2004h> "]
[1151.963405, "o", "    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\r\n\u001b[?2004l\r"]
[1151.963429, "o", "\u001b[?2004h"]
[1151.963515, "o", "> "]
[1151.963923, "o", "    _gemm_tma[grid](x_hi, x_lo, w_hi, w_lo, b, out, 16384, 4096, 4096)\r\n\u001b[?2004l\r"]
[1151.964008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1151.964074, "o", "\u001b[?2004h> "]
[1151.964292, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.964487, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[1151.964513, "o", "\u001b[?2004h"]
[1151.964608, "o", "> "]
[1151.96482, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.965376, "o", "    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1151.965435, "o", "\u001b[?2004h> "]
[1151.965522, "o", "    ts = []\r\n\u001b[?2004l\r"]
[1151.965609, "o", "\u001b[?2004h> "]
[1151.965753, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[1151.965822, "o", "\u001b[?2004h> "]
[1151.966059, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1151.966084, "o", "\u001b[?2004h"]
[1151.966177, "o", "> "]
[1151.966366, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1151.96645, "o", "\u001b[?2004h> "]
[1151.966659, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1151.966786, "o", "\u001b[?2004h> "]
[1151.967058, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1151.967163, "o", "> "]
[1151.967349, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1151.967485, "o", "\u001b[?2004h"]
[1151.967547, "o", "> "]
[1151.96764, "o", "t = timeit(run)\r\n\u001b[?2004l\r"]
[1151.967691, "o", "\u001b[?2004h"]
[1151.967766, "o", "> "]
[1151.967979, "o", "err = (out - ref).abs()\r\n\u001b[?2004l\r"]
[1151.968004, "o", "\u001b[?2004h"]
[1151.968114, "o", "> "]
[1151.968245, "o", "thr = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[1151.968294, "o", "\u001b[?2004h"]
[1151.968319, "o", "> "]
[1151.968726, "o", "print('gemm: %.3f ms, best: %s' % (t, _gemm_tma.best_config))\r\n\u001b[?2004l\r"]
[1151.968823, "o", "\u001b[?2004h> "]
[1151.969394, "o", "print('max err %.3e, violates: %d' % (err.max().item(), (err > thr).sum().item()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.969922, "o", "for BLOCK, warps in [(4096,4),(8192,8),(16384,8),(16384,16),(32768,16)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1151.970692, "o", "    print('split BLOCK=%d warps=%d: %.3f ms' % (BLOCK, warps, timeit(lambda: split_tensor(x, x_hi, x_lo, BLOCK, warps))))\r\n\u001b[?2004l\r"]
[1151.970844, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1151.974072, "o", "\u001b[?2004h"]
[1151.974098, "o", "root@modal:/workspace# "]
[1151.974451, "o", "python3 /workspace/bench7.py 2>/dev/null | tail -8\r\n\u001b[?2004l\r"]
[1154.800791, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1218.535122, "i", "python3 /workspace/bench7.py 2>&1 | tail -12\n"]
[1218.535628, "o", "python3 /workspace/bench7.py 2>&1 | tail -12\r\n\u001b[?2004l\r"]
[1221.407207, "o", "    self.fn.run(\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 733, in run\r\n    kernel = self._do_compile(key, signature, device, constexprs, options, attrs, warmup)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/runtime/jit.py\", line 861, in _do_compile\r\n    kernel = self.compile(src, target=target, options=options.__dict__)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/compiler/compiler.py\", line 320, in compile\r\n    next_module = compile_ir(module, metadata)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/compiler.py\", line 515, in <lambda>\r\n    stages[\"ttgir\"] = lambda src, metadata: self.make_ttgir(src, metadata, options, capability)\r\n  File \"/usr/local/lib/python3.10/dist-packages/triton/backends/nvidia/compiler.py\", line 319, in make_ttgir\r\n    pm.run(mod)\r\nRuntimeError: PassManager::run failed\r\n"]
[1221.491, "o", "\u001b[?2004hroot@modal:/workspace# "]
[1297.775396, "i", "cat > /workspace/bench8.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\ndef alloc_fn(size: int, alignment: int, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\n@triton.jit\ndef _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < numel\n    x = tl.load(X + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    tl.store(Hi + offs, hi, mask=mask)\n    tl.store(Lo + offs, lo, mask=mask)\n\ndef split_tensor(x, hi, lo, BLOCK=8192, warps=8):\n    numel = x.numel()\n    grid = (triton.cdiv(numel, BLOCK),)\n    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=BLOCK, num_warps=warps)\n\n@triton.jit\ndef _gemm_ws(Ah, Al, Wh, Wl, Bias, C, M, N, K,\n             BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n             GROUP_M: tl.constexpr, WS: tl.constexpr):\n    "]
[1297.775706, "i", "pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    a_desc = tl.make_tensor_descriptor(Ah, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    al_desc = tl.make_tensor_descriptor(Al, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    wh_desc = tl.make_tensor_descriptor(Wh, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    wl_desc = tl.make_tensor_descriptor(Wl, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in tl.range(0, K, BK, warp_specialize=WS):\n        a_hi = a_desc.load([off_m, k])\n        a_lo = al_desc.load([off_m, k])\n        w_hi = wh_desc.load("]
[1297.775796, "i", "[k, off_n])\n        w_lo = wl_desc.load([k, off_n])\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n    bias = tl.load(Bias + off_n + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc)\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\nref = F.linear(x, w, b)\nwt = w.t().contiguous()\nx_hi = torch.empty(x.shape, device='cuda', dtype=torch.float16)\nx_lo = torch.empty(x.shape, device='cuda', dtype=torch.float16)\nw_hi = torch.empty(wt.shape, device='cuda', dtype=torch.float16)\nw_lo = torch.empty(wt.shape, device='cuda', dtype=torch.float16)\nsplit_tensor(x, x_hi, x_lo)\nsplit_tensor(wt, w_hi, w_lo)\nout = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch."]
[1297.775936, "i", "cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nfor (BM,BN,BK,GM,ws,st,wp) in [(128,128,64,8,True,3,8),(128,128,64,8,False,3,8),(128,256,64,8,True,3,8),(256,128,64,8,True,3,8),(128,128,64,8,True,4,8)]:\n    try:\n        def run():\n            grid = (triton.cdiv(16384,BM)*triton.cdiv(4096,BN),)\n            _gemm_ws[grid](x_hi, x_lo, w_hi, w_lo, b, out, 16384, 4096, 4096,\n                           BM=BM, BN=BN, BK=BK, GROUP_M=GM, WS=ws, num_warps=wp, num_stages=st)\n        t = timeit(run)\n        err = (out - ref).abs()\n        thr = 1e-4 + 1e-4 * ref.abs()\n        print('BM=%d BN=%d BK=%d ws=%s st=%d: %.3f ms, err %.2e, viol %d' % (BM,BN,BK,ws,st,t,err.max().item(),(err>thr).sum().item()))\n    except Exception as e:\n        print('BM=%d BN=%d BK=%d ws=%s st=%d: FAILED %s' % (BM,BN,BK,ws,st,str(e)[:80]))\nEOF\npython3 /workspace/"]
