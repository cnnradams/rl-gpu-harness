[690.923584, "o", "> "]
[690.923789, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[690.924002, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
