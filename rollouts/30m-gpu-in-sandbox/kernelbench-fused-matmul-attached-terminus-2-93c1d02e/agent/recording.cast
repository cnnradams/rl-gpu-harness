[620.42672, "o", "\u001b[?2004hroot@modal:/workspace# "]
[690.907275, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=16),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _gemm(A, Wt, Bias, C, M, N, K,\n          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n          GROUP_M: tl.constexpr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id"]
[690.907481, "i", " * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    W_ptr = Wt + rk[:, None] * N + rn[None, :]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        w = tl.load(W_ptr)\n        acc = tl.dot(a, w, acc, input_precision=IP)\n        A_ptr += BK\n        W_ptr += BK * N\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, acc)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum"]
[690.907536, "i", "(ts)/len(ts)\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\nref = F.linear(x, w, b)\nwt = w.t().contiguous()\nxh = x.half(); wh = wt.half(); bh = b.half()\nout = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\n\ndef run_fp16():\n    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\n    _gemm[grid](xh, wh, bh, out, 16384, 4096, 4096, IP=None)\n\nt = timeit(run_fp16)\nprint('triton fp16 gemm: %.3f ms, best: %s' % (t, _gemm.best_config))\n\ndef run_tf32():\n    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\n    _gemm[grid](x, wt, b, out, 16384, 4096, 4096, IP='tf32')\n\nt = timeit(run_tf32)\nerr = (out - ref).abs().max().item()\nprint('triton tf32 gemm: %.3f ms, err %.3e, best: %s' % (t, err, _gemm.best_config))\n\ndef run_ieee():\n    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\n"]
[690.907565, "i", "    _gemm[grid](x, wt, b, out, 16384, 4096, 4096, IP='ieee')\n\nt = timeit(run_ieee)\nprint('triton ieee gemm: %.3f ms, best: %s' % (t, _gemm.best_config))\nEOF\npython3 /workspace/bench4.py 2>/dev/null | tail -5\n"]
