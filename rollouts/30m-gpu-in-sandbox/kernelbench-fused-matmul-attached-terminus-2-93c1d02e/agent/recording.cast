[293.045838, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time, os\nimport torch.nn.functional as F\nprint('torch', torch.__version__)\nprint('allow_tf32 matmul:', torch.backends.cuda.matmul.allow_tf32)\nprint('NVIDIA_TF32_OVERRIDE:', os.environ.get('NVIDIA_TF32_OVERRIDE'))\nprint('float32_matmul_precision:', torch.get_float32_matmul_precision())\ntorch.manual_seed(42)\nM=N=K=16384,4096,4096\nx = torch.rand(16384, 4096, device='cuda')\nw = torch.randn(4096, 4096, device='cuda') * 0.0156\nb = torch.randn(4096, device='cuda') * 0.0156\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts=[]\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nref = F.linear(x, w, b)\nprint('fp32 linear: %.3f ms' % timeit(lambda: F.linear(x, w, b)))\n\ntorch.backends.cuda.matmul.allow_tf32 = True\n"]
[293.046085, "i", "out_tf32 = F.linear(x, w, b)\nerr = (out_tf32 - ref).abs().max().item()\nprint('tf32 linear: %.3f ms, max err vs fp32: %.3e' % (timeit(lambda: F.linear(x, w, b)), err))\ntorch.backends.cuda.matmul.allow_tf32 = False\n\nxb = x.bfloat16(); wb = w.bfloat16(); bb = b.bfloat16()\nout_bf = F.linear(xb, wb, bb).float()\nerr = (out_bf - ref).abs().max().item()\nprint('bf16 linear: %.3f ms, max err vs fp32: %.3e' % (timeit(lambda: F.linear(xb, wb, bb)), err))\n\nxh = x.half(); wh = w.half(); bh = b.half()\nout_h = F.linear(xh, wh, bh).float()\nerr = (out_h - ref).abs().max().item()\nprint('fp16 linear: %.3f ms, max err vs fp32: %.3e' % (timeit(lambda: F.linear(xh, wh, bh)), err))\n\ntorch._dynamo.reset()\nf = torch.compile(lambda a: F.linear(a, w, b), mode='max-autotune')\nout_c = f(x)\nerr = (out_c - ref).abs().max().item()\nprint('compiled fp32 linear: %.3f ms, max err: %.3e' % (timeit(lambda: f(x)), err))\nEOF\npython3 /workspace/bench.py\n"]
