[413.202744, "i", "cat > /workspace/bench_triton.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _split_gemm(A, W, Bias, C, M, N, K,\n                sam, sak, swn, swk, scm, scn,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                GROUP_M: tl.constexpr, FOUR: tl.constexpr):\n    pid = tl.progr"]
[413.202987, "i", "am_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * sam + rk[None, :] * sak\n    W_ptr = W + rn[:, None] * swn + rk[None, :] * swk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        w = tl.load(W_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        w_hi = w.to(tl.float16)\n        w_lo = (w - w_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, tl.trans(w_hi), acc)\n        acc = tl.dot(a_hi, tl.trans(w_lo), acc)\n        acc = tl.dot(a_lo, tl.trans(w_hi), acc)\n        if FOUR:\n            acc = tl.dot(a_lo, tl.trans(w_lo), acc)\n        A_pt"]
[413.203086, "i", "r += BK * sak\n        W_ptr += BK * swk\n    bias = tl.load(Bias + rn)\n    acc = acc + bias[None, :]\n    C_ptr = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(C_ptr, acc)\n\ndef split_linear(x, w, bias, four=False):\n    M, K = x.shape\n    N = w.shape[0]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n    _split_gemm[grid](x, w, bias, out, M, N, K,\n                      x.stride(0), x.stride(1), w.stride(0), w.stride(1),\n                      out.stride(0), out.stride(1), FOUR=four)\n    return out\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\n\nref = F.linear(x, w, b)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cu"]
[413.20322, "i", "da.synchronize()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nout = split_linear(x, w, b)\nerr = (out - ref).abs()\nthr = 1e-4 + 1e-4 * ref.abs()\nprint('3-dot: max err %.3e, violates: %d, time %.3f ms' % (err.max().item(), (err > thr).sum().item(), timeit(lambda: split_linear(x, w, b))))\nEOF\npython3 /workspace/bench_triton.py\n"]
