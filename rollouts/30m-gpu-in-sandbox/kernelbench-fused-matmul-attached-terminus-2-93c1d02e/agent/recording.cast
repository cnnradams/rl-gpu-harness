[1690.087688, "o", "\u001b[?2004h> "]
[1690.088058, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.088269, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1690.088421, "o", "\u001b[?2004h> "]
[1690.088611, "o", "        a = a_desc.load([off_m, k])\r\n\u001b[?2004l\r"]
[1690.088663, "o", "\u001b[?2004h"]
[1690.088716, "o", "> "]
[1690.08891, "o", "        a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1690.088934, "o", "\u001b[?2004h"]
[1690.089042, "o", "> "]
[1690.089378, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1690.089404, "o", "\u001b[?2004h"]
[1690.089506, "o", "> "]
[1690.089738, "o", "        w_hi = wh_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[1690.089833, "o", "\u001b[?2004h> "]
[1690.090096, "o", "        w_lo = wl_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[1690.090243, "o", "\u001b[?2004h> "]
[1690.090441, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r"]
[1690.090541, "o", "\u001b[?2004h> "]
[1690.090836, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.091181, "o", "        acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.091537, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[1690.091619, "o", "\u001b[?2004h> "]
[1690.091822, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1690.091931, "o", "\u001b[?2004h> "]
[1690.092237, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1690.092386, "o", "\u001b[?2004h> "]
[1690.092446, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.092511, "o", "> "]
[1690.092796, "o", "def _gemm(Ah, Al, Wh, Wl, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[1690.092889, "o", "\u001b[?2004h> "]
[1690.093368, "o", "          BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.09361, "o", "          GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1690.093713, "o", "\u001b[?2004h> "]
[1690.093923, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.094136, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[1690.094282, "o", "\u001b[?2004h> "]
[1690.094401, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1690.094484, "o", "\u001b[?2004h> "]
[1690.094744, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.09494, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1690.094999, "o", "\u001b[?2004h"]
[1690.09507, "o", "> "]
[1690.095471, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1690.095533, "o", "\u001b[?2004h> "]
[1690.09596, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.096237, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1690.096329, "o", "\u001b[?2004h> "]
[1690.096478, "o", "    off_m = pid_m * BM\r\n\u001b[?2004l\r"]
[1690.096548, "o", "\u001b[?2004h> "]
[1690.096713, "o", "    off_n = pid_n * BN\r\n\u001b[?2004l\r"]
[1690.09681, "o", "\u001b[?2004h> "]
[1690.097426, "o", "    a_desc = tl.make_tensor_descriptor(Ah, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r"]
[1690.097449, "o", "\u001b[?2004h"]
[1690.09758, "o", "> "]
[1690.098198, "o", "    al_desc = tl.make_tensor_descriptor(Al, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.098833, "o", "    wh_desc = tl.make_tensor_descriptor(Wh, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\r\n\u001b[?2004l\r"]
[1690.0989, "o", "\u001b[?2004h> "]
[1690.099624, "o", "    wl_desc = tl.make_tensor_descriptor(Wl, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.100256, "o", "    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\r\n\u001b[?2004l\r"]
[1690.100309, "o", "\u001b[?2004h"]
[1690.100365, "o", "> "]
[1690.100661, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1690.100753, "o", "\u001b[?2004h> "]
[1690.100973, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[1690.100997, "o", "\u001b[?2004h"]
[1690.101126, "o", "> "]
[1690.101355, "o", "        a_hi = a_desc.load([off_m, k])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.101647, "o", "        a_lo = al_desc.load([off_m, k])\r\n\u001b[?2004l\r"]
[1690.101715, "o", "\u001b[?2004h> "]
[1690.102047, "o", "        w_hi = wh_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[1690.102176, "o", "\u001b[?2004h> "]
[1690.102415, "o", "        w_lo = wl_desc.load([k, off_n])\r\n\u001b[?2004l\r"]
[1690.10252, "o", "\u001b[?2004h> "]
[1690.102752, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r"]
[1690.10286, "o", "\u001b[?2004h> "]
[1690.103087, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r"]
[1690.103137, "o", "\u001b[?2004h"]
[1690.103162, "o", "> "]
[1690.103481, "o", "        acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.103884, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BN))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.104156, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.104412, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[1690.104503, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1690.10453, "o", "\u001b[?2004h"]
[1690.104604, "o", "> "]
[1690.104781, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.105088, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[1690.105112, "o", "\u001b[?2004h"]
[1690.105202, "o", "> "]
[1690.10558, "o", "w = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.105897, "o", "b = torch.randn(4096, device='cuda') * (1/64.0)\r\n\u001b[?2004l\r"]
[1690.105921, "o", "\u001b[?2004h"]
[1690.106014, "o", "> "]
[1690.106138, "o", "ref = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[1690.106305, "o", "\u001b[?2004h> "]
[1690.106377, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[1690.106431, "o", "\u001b[?2004h"]
[1690.106494, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.106555, "o", "> "]
[1690.106698, "o", "def split_tensor(x):\r\n\u001b[?2004l\r"]
[1690.10672, "o", "\u001b[?2004h"]
[1690.106783, "o", "> "]
[1690.10691, "o", "    numel = x.numel()\r\n\u001b[?2004l\r"]
[1690.107004, "o", "\u001b[?2004h> "]
[1690.107431, "o", "    hi = torch.empty(x.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1690.107456, "o", "\u001b[?2004h"]
[1690.107568, "o", "> "]
[1690.107971, "o", "    lo = torch.empty(x.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1690.107993, "o", "\u001b[?2004h"]
[1690.108124, "o", "> "]
[1690.108352, "o", "    grid = (triton.cdiv(numel, 8192),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.109027, "o", "    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=8192, num_warps=8)\r\n\u001b[?2004l\r"]
[1690.109115, "o", "\u001b[?2004h> "]
[1690.109286, "o", "    return hi, lo\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1690.109375, "o", "\u001b[?2004h> "]
[1690.109565, "o", "x_hi, x_lo = split_tensor(x)\r\n\u001b[?2004l\r"]
[1690.109652, "o", "\u001b[?2004h> "]
[1690.109842, "o", "w_hi, w_lo = split_tensor(wt)\r\n\u001b[?2004l\r"]
[1690.10994, "o", "\u001b[?2004h> "]
[1690.110373, "o", "out = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1690.110394, "o", "\u001b[?2004h"]
[1690.110467, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.110543, "o", "> "]
[1690.110733, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.110925, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[1690.110999, "o", "\u001b[?2004h> "]
[1690.111262, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.111822, "o", "    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1690.111846, "o", "\u001b[?2004h"]
[1690.111936, "o", "> "]
[1690.112043, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.112261, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.112542, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.112775, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1690.112859, "o", "\u001b[?2004h> "]
[1690.113055, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1690.113138, "o", "\u001b[?2004h> "]
[1690.113353, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1690.113377, "o", "\u001b[?2004h"]
[1690.113465, "o", "> "]
[1690.113599, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r"]
[1690.113689, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1690.113757, "o", "\u001b[?2004h> "]
[1690.114689, "o", "for (BM,BN,BK,GM,st,wp) in [(128,128,32,8,3,8),(128,128,64,8,3,8),(128,256,32,8,3,8),(128,256,64,8,3,8),(256,128,32,8,3,8),(128,128,32,8,2,8)]:\r\n\u001b[?2004l\r"]
[1690.114711, "o", "\u001b[?2004h"]
[1690.114804, "o", "> "]
[1690.114823, "o", "    try:\r\n\u001b[?2004l\r"]
[1690.11493, "o", "\u001b[?2004h> "]
[1690.11503, "o", "        def run():\r\n\u001b[?2004l\r"]
[1690.115084, "o", "\u001b[?2004h"]
[1690.115158, "o", "> "]
[1690.115623, "o", "            grid = (triton.cdiv(16384,BM)*triton.cdiv(4096,BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.116138, "o", "            _gemm_hybrid[grid](x, w_hi, w_lo, b, out, 16384, 4096, 4096,\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.116234, "o", "> "]
[1690.116869, "o", "                               BM=BM, BN=BN, BK=BK, GROUP_M=GM, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.117032, "o", "        t = timeit(run)\r\n\u001b[?2004l\r"]
[1690.11715, "o", "\u001b[?2004h> "]
[1690.117327, "o", "        err = (out - ref).abs()\r\n\u001b[?2004l\r"]
[1690.117408, "o", "\u001b[?2004h> "]
[1690.117708, "o", "        thr = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.117796, "o", "> "]
[1690.118685, "o", "        print('HYB BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: %.3f ms viol %d' % (BM,BN,BK,GM,st,wp,t,(err>thr).sum().item()), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.118897, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.118984, "o", "> "]
[1690.119687, "o", "        print('HYB BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: FAILED %s' % (BM,BN,BK,GM,st,wp,str(e)[:60]), flush=True)\r\n\u001b[?2004l\r"]
[1690.11979, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1690.119841, "o", "> "]
[1690.120535, "o", "for (BM,BN,BK,GM,st,wp) in [(128,128,32,4,3,8),(128,128,32,16,3,8),(128,128,32,8,3,4),(128,128,32,8,5,8)]:\r\n\u001b[?2004l\r"]
[1690.120663, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[1690.120719, "o", "\u001b[?2004h"]
[1690.120795, "o", "> "]
[1690.120972, "o", "        def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.121387, "o", "            grid = (triton.cdiv(16384,BM)*triton.cdiv(4096,BN),)\r\n\u001b[?2004l\r"]
[1690.121413, "o", "\u001b[?2004h"]
[1690.121509, "o", "> "]
[1690.121964, "o", "            _gemm[grid](x_hi, x_lo, w_hi, w_lo, b, out, 16384, 4096, 4096,\r\n\u001b[?2004l\r"]
[1690.121989, "o", "\u001b[?2004h"]
[1690.122128, "o", "> "]
[1690.122744, "o", "                        BM=BM, BN=BN, BK=BK, GROUP_M=GM, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.122924, "o", "        t = timeit(run)\r\n\u001b[?2004l\r"]
[1690.122949, "o", "\u001b[?2004h"]
[1690.123014, "o", "> "]
[1690.12367, "o", "        print('PRE BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: %.3f ms' % (BM,BN,BK,GM,st,wp,t), flush=True)\r\n\u001b[?2004l\r"]
[1690.123823, "o", "\u001b[?2004h> "]
[1690.123937, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[1690.124018, "o", "\u001b[?2004h> "]
[1690.124809, "o", "        print('PRE BM=%d BN=%d BK=%d GM=%d st=%d wp=%d: FAILED %s' % (BM,BN,BK,GM,st,wp,str(e)[:60]), flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1690.124961, "o", "PYEOF\r\n\u001b[?2004l\r"]
[1690.128229, "o", "\u001b[?2004h"]
