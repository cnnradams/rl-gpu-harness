[888.129225, "o", "\u001b[?2004h"]
[888.129265, "o", "> "]
[888.129568, "o", "    bias = tl.load(Bias + off_n + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[888.129659, "o", "\u001b[?2004h> "]
[888.12981, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[888.129892, "o", "\u001b[?2004h> "]
[888.130109, "o", "    c_desc.store([off_m, off_n], acc)\r\n\u001b[?2004l\r"]
[888.130131, "o", "\u001b[?2004h"]
[888.130253, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.13034, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[888.130391, "o", "> "]
[888.130727, "o", "def _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[888.130751, "o", "\u001b[?2004h"]
[888.130839, "o", "> "]
[888.130948, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[888.131, "o", "\u001b[?2004h"]
[888.131062, "o", "> "]
[888.131298, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[888.131378, "o", "\u001b[?2004h> "]
[888.13151, "o", "    mask = offs < numel\r\n\u001b[?2004l\r"]
[888.131597, "o", "\u001b[?2004h> "]
[888.131796, "o", "    x = tl.load(X + offs, mask=mask)\r\n\u001b[?2004l\r"]
[888.131819, "o", "\u001b[?2004h"]
[888.131943, "o", "> "]
[888.132079, "o", "    hi = x.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.132377, "o", "    lo = (x - hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[888.132421, "o", "\u001b[?2004h"]
[888.132442, "o", "> "]
[888.1327, "o", "    tl.store(Hi + offs, hi, mask=mask)\r\n\u001b[?2004l\r"]
[888.132722, "o", "\u001b[?2004h"]
[888.132788, "o", "> "]
[888.133014, "o", "    tl.store(Lo + offs, lo, mask=mask)\r\n\u001b[?2004l\r"]
[888.133103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[888.133125, "o", "\u001b[?2004h"]
[888.133198, "o", "> "]
[888.133359, "o", "def split_tensor(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.133488, "o", "    numel = x.numel()\r\n\u001b[?2004l\r"]
[888.133579, "o", "\u001b[?2004h> "]
[888.133976, "o", "    hi = torch.empty(x.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[888.133999, "o", "\u001b[?2004h"]
[888.134084, "o", "> "]
[888.134448, "o", "    lo = torch.empty(x.shape, device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[888.134473, "o", "\u001b[?2004h"]
[888.134605, "o", "> "]
[888.134666, "o", "    BLOCK = 8192\r\n\u001b[?2004l\r\u001b[?2004h"]
[888.134726, "o", "> "]
[888.13497, "o", "    grid = (triton.cdiv(numel, BLOCK),)\r\n\u001b[?2004l\r"]
[888.134993, "o", "\u001b[?2004h"]
[888.135082, "o", "> "]
[888.135651, "o", "    _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel, BLOCK=BLOCK, num_warps=8)\r\n\u001b[?2004l\r"]
[888.13573, "o", "\u001b[?2004h> "]
[888.135834, "o", "    return hi, lo\r\n\u001b[?2004l\r"]
[888.135969, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.136122, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r"]
[888.136268, "o", "\u001b[?2004h> "]
[888.136452, "o", "x = torch.rand(16384, 4096, device='cuda')\r\n\u001b[?2004l\r"]
[888.136496, "o", "\u001b[?2004h"]
[888.13655, "o", "> "]
[888.136884, "o", "w = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\r\n\u001b[?2004l\r"]
[888.13697, "o", "\u001b[?2004h> "]
[888.13731, "o", "b = torch.randn(4096, device='cuda') * (1/64.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.137464, "o", "ref = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[888.137518, "o", "\u001b[?2004h"]
[888.137573, "o", "> "]
[888.137703, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[888.137796, "o", "\u001b[?2004h> "]
[888.137995, "o", "w_hi_t, w_lo_t = split_tensor(wt)\r\n\u001b[?2004l\r"]
[888.138093, "o", "\u001b[?2004h> "]
[888.138246, "o", "x_hi, x_lo = split_tensor(x)\r\n\u001b[?2004l\r"]
[888.138345, "o", "\u001b[?2004h> "]
[888.138806, "o", "out = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[888.138897, "o", "\u001b[?2004h> "]
[888.138964, "o", "def run():\r\n\u001b[?2004l\r"]
[888.138991, "o", "\u001b[?2004h"]
[888.139048, "o", "> "]
[888.139637, "o", "    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.140101, "o", "    _gemm_tma[grid](x_hi, x_lo, w_hi_t, w_lo_t, b, out, 16384, 4096, 4096)\r\n\u001b[?2004l\r"]
[888.140125, "o", "\u001b[?2004h"]
[888.140216, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[888.140233, "o", "> "]
[888.140385, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r"]
[888.140407, "o", "\u001b[?2004h"]
[888.14048, "o", "> "]
[888.140634, "o", "    for _ in range(5): fn()\r\n\u001b[?2004l\r"]
[888.140678, "o", "\u001b[?2004h"]
[888.140732, "o", "> "]
[888.140895, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[888.141012, "o", "\u001b[?2004h> "]
[888.141495, "o", "    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[888.141593, "o", "\u001b[?2004h> "]
[888.141653, "o", "    ts = []\r\n\u001b[?2004l\r"]
[888.141705, "o", "\u001b[?2004h"]
[888.141728, "o", "> "]
[888.141932, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.14216, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[888.142219, "o", "\u001b[?2004h> "]
[888.142501, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.142763, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[888.142979, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[888.143077, "o", "\u001b[?2004h> "]
[888.143193, "o", "    return sum(ts)/len(ts)\r\n\u001b[?2004l\r"]
[888.143234, "o", "\u001b[?2004h"]
[888.143292, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[888.143344, "o", "> "]
[888.143425, "o", "t = timeit(run)\r\n\u001b[?2004l\r"]
[888.143487, "o", "\u001b[?2004h> "]
[888.143622, "o", "err = (out - ref).abs()\r\n\u001b[?2004l\r"]
[888.143705, "o", "\u001b[?2004h> "]
[888.143842, "o", "thr = 1e-4 + 1e-4 * ref.abs()\r\n\u001b[?2004l\r"]
[888.143948, "o", "\u001b[?2004h> "]
[888.144254, "o", "print('tma gemm: %.3f ms, best: %s' % (t, _gemm_tma.best_config))\r\n\u001b[?2004l\r"]
[888.144344, "o", "\u001b[?2004h> "]
[888.144742, "o", "print('max err %.3e, violates: %d' % (err.max().item(), (err > thr).sum().item()))\r\n\u001b[?2004l\r"]
[888.144762, "o", "\u001b[?2004h"]
[888.144836, "o", "> "]
[888.145108, "o", "print('split: %.3f ms' % timeit(lambda: split_tensor(x)))\r\n\u001b[?2004l\r"]
[888.145158, "o", "\u001b[?2004h> "]
[888.145179, "o", "EOF\r\n\u001b[?2004l\r"]
[888.147984, "o", "\u001b[?2004hroot@modal:/workspace# "]
[888.148282, "o", "python3 /workspace/bench5.py 2>/dev/null | tail -4\r\n\u001b[?2004l\r"]
[892.747874, "o", "tma gemm: 2.454 ms, best: BM: 128, BN: 128, BK: 64, GROUP_M: 8, num_warps: 8, num_ctas: 1, num_stages: 3, maxnreg: None\r\nmax err 5.198e-05, violates: 0\r\nsplit: 0.216 ms\r\n"]
[892.822559, "o", "\u001b[?2004hroot@modal:/workspace# "]
[987.464641, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\ndef alloc_fn(size: int, alignment: int, stream):\n    return torch.empty(size, device='cuda', dtype=torch.int8)\ntriton.set_allocator(alloc_fn)\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 128, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=5, num_warps=8),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.j"]
[987.464721, "i", "it\ndef _gemm_fused(A, Wt, Bias, C, M, N, K,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BM\n    off_n = pid_n * BN\n    a_desc = tl.make_tensor_descriptor(A, shape=[M, K], strides=[K, 1], block_shape=[BM, BK])\n    w_desc = tl.make_tensor_descriptor(Wt, shape=[K, N], strides=[N, 1], block_shape=[BK, BN])\n    c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = a_desc.load([off_m, k])\n        w = w_desc.load([k, off_n])\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n      "]
[987.464885, "i", "  w_hi = w.to(tl.float16)\n        w_lo = (w - w_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n    bias = tl.load(Bias + off_n + tl.arange(0, BN))\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc)\n\ntorch.manual_seed(42)\nx = torch.rand(16384, 4096, device='cuda')\nw = (torch.randn(4096, 4096, device='cuda') * (1/64.0))\nb = torch.randn(4096, device='cuda') * (1/64.0)\nref = F.linear(x, w, b)\nwt = w.t().contiguous()\nout = torch.empty((16384, 4096), device='cuda', dtype=torch.float32)\n\ndef run():\n    grid = lambda meta: (triton.cdiv(16384, meta['BM']) * triton.cdiv(4096, meta['BN']),)\n    _gemm_fused[grid](x, wt, b, out, 16384, 4096, 4096)\n\ndef timeit(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        s.record(); fn(); e."]
[987.464968, "i", "record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\nt = timeit(run)\nerr = (out - ref).abs()\nthr = 1e-4 + 1e-4 * ref.abs()\nprint('fused tma gemm: %.3f ms, best: %s' % (t, _gemm_fused.best_config))\nprint('max err %.3e, violates: %d' % (err.max().item(), (err > thr).sum().item()))\nEOF\npython3 /workspace/bench6.py 2>/dev/null | tail -3\n"]
