[?2004l[?2004h>     c_desc = tl.make_tensor_descriptor(C, shape=[M, N], strides=[N, 1], block_shape=[BM, BN])
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, K, BK):
[?2004l[?2004h>         a_hi = a_desc.load([off_m, k])
