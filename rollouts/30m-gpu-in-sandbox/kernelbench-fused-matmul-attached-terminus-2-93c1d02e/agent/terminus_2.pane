[?2004l[?2004h> _BM, _BN, _BK, _GM = 128, 128, 64, 8
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     """
[?2004l[?2004h>     Optimized reference model.
[?2004l[?2004h> 
[?2004l[?2004h>     Math: out = (x @ W^T + b) * (1 + s) = x @ (W*(1+s))^T + b*(1+s)
[?2004l[?2004h>     The (1+s) factor is folded into the weights once.
[?2004l[?2004h> 
[?2004l[?2004h>     The FP32 GEMM is evaluated with an fp16 error-compensation scheme:
[?2004l[?2004h>     each FP32 operand is split as v = v_hi + v_lo (both fp16), and
[?2004l[?2004h>     x @ w ~= x_hi@w_hi + x_hi@w_lo + x_lo@w_hi accumulated in fp32.
[?2004l[?2004h>     This gives ~fp32-level accuracy (error ~2^-22 relative) at fp16
[?2004l[?2004h>     tensor-core speed on H100.
[?2004l[?2004h>     """
[?2004l[?2004h> 
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super(ModelNew, self).__init__()
[?2004l[?2004h>         self.matmul = nn.Linear(in_features, out_features)
[?2004l[?2004h>         self.scaling_factor = scaling_factor
[?2004l[?2004h>         self._ready = False
[?2004l[?2004h> 
[?2004l[?2004h>     def _prepare(self):
[?2004l[?2004h>         s = 1.0 + float(self.scaling_factor)
[?2004l[?2004h>         with torch.no_grad():
[?2004l[?2004h>             self.matmul.weight.mul_(s)
[?2004l[?2004h>             self.matmul.bias.mul_(s)
[?2004l[?2004h>             wt = self.matmul.weight.t().contiguous()
[?2004l[?2004h>             self._wt = wt
[?2004l[?2004h>             self._w_hi_t, self._w_lo_t = self._split(wt)
[?2004l[?2004h>             self._bias = self.matmul.bias.contiguous()
[?2004l[?2004h>         self._ready = True
[?2004l[?2004h> 
[?2004l[?2004h>     @staticmethod
[?2004l[?2004h>     def _split(x):
[?2004l[?2004h>         numel = x.numel()
[?2004l[?2004h>         hi = torch.empty(x.shape, device=x.device, dtype=torch.float16)
[?2004l[?2004h>         lo = torch.empty(x.shape, device=x.device, dtype=torch.float16)
[?2004l[?2004h>         BLOCK = 8192
[?2004l[?2004h>         grid = (triton.cdiv(numel, BLOCK),)
[?2004l[?2004h>         _split_kernel[grid](x.reshape(-1), hi.reshape(-1), lo.reshape(-1), numel,
[?2004l[?2004h>                             BLOCK=BLOCK, num_warps=8)
[?2004l[?2004h>         return hi, lo
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         if not self._ready:
[?2004l[?2004h>             self._prepare()
[?2004l[?2004h>         M, K = x.shape
[?2004l[?2004h>         N = self._w_hi_t.shape[1]
[?2004l[?2004h>         x = x.contiguous()
[?2004l[?2004h>         x_hi, x_lo = self._split(x)
[?2004l[?2004h>         out = torch.empty((M, N), device=x.device, dtype=torch.float32)
[?2004l[?2004h>         grid = (triton.cdiv(M, _BM) * triton.cdiv(N, _BN),)
[?2004l[?2004h>         _gemm_fp16x3_tma[grid](x_hi, x_lo, self._w_hi_t, self._w_lo_t,
[?2004l[?2004h>                                self._bias, out, M, N, K,
[?2004l[?2004h>                                BM=_BM, BN=_BN, BK=_BK, GROUP_M=_GM,
[?2004l[?2004h>                                num_warps=8, num_stages=3)
[?2004l[?2004h>         return out
