[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     mask = offs < numel
