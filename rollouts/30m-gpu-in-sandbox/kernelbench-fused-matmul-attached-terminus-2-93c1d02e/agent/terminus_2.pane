[?2004l[?2004h>         w_hi = wh_desc.load([k, off_n])
[?2004l[?2004h>         w_lo = wl_desc.load([k, off_n])
[?2004l[?2004h>         acc = tl.dot(a_hi, w_hi, acc)
[?2004l[?2004h>         acc = tl.dot(a_hi, w_lo, acc)
