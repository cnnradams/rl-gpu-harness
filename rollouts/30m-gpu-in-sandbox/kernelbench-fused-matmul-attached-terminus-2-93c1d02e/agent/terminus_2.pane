[?2004l[?2004h>     hi = x.to(tl.float16)
[?2004l[?2004h>     lo = (x - hi.to(tl.float32)).to(tl.float16)
[?2004l[?2004h>     tl.store(Hi + offs, hi, mask=mask)
[?2004l[?2004h>     tl.store(Lo + offs, lo, mask=mask)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _gemm_fp16x3_tma(Ah, Al, Wh, Wl, Bias, C, M, N, K,
[?2004l[?2004h>                      BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
[?2004l[?2004h>                      GROUP_M: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GROUP_M * grid_n
[?2004l[?2004h>     group_id = pid // width
