          "bash",
          "-c",
          "rm -f /tmp/h2o_dump.jsonl; python3 - <<\"EOF\"\nimport json, urllib.request, threading\n\ndef gen(n_tokens, max_new):\n    ids = [(i*37)%50000+10 for i in range(n_tokens)]\n    payload = {\"input_ids\": ids, \"sampling_params\": {\"temperature\": 0.0, \"max_new_tokens\": max_new, \"ignore_eos\": True}}\n    req = urllib.request.Request(\"http://127.0.0.1:30000/generate\", data=json.dumps(payload).encode(), headers={\"Content-Type\": \"application/json\"})\n    resp = json.loads(urllib.request.urlopen(req, timeout=600).read())\n    return resp[\"meta_info\"][\"completion_tokens\"]\n\nprint(\"single:\", gen(3000, 32))\nresults = []\ndef worker():\n    results.append(gen(3000, 24))\nthreads = [threading.Thread(target=worker) for _ in range(8)]\n[t.start() for t in threads]; [t.join() for t in threads]\nprint(\"burst:\", results)\n\nbudget = 600\nsteps = {}\nfor line in open(\"/tmp/h2o_dump.jsonl\"):\n    r = json.loads(line)\n    steps.setdefault(r[\"request_id\"], []).append(r)\nok = True\nfor rid, recs in steps.items():\n    recs.sort(key=lambda r: r[\"step\"])\n    n0 = len(recs[0][\"retained\"])\n    for rec in recs:\n        ret = rec[\"retained\"]\n        assert ret == sorted(ret)\n        assert len(ret) <= budget, (len(ret), budget)\n    last = recs[-1][\"retained\"]\n    recent = 300\n    nonrecent = sum(1 for p in last if p < 3000 - recent)\n    print(rid[:8], \"steps:\", len(recs), \"first retained:\", n0, \"last:\", len(last), \"nonrecent:\", nonrecent)\nprint(\"dump OK\")\nEOF\necho EXIT=$?; tail -3 /tmp/server2.log"
        ],
