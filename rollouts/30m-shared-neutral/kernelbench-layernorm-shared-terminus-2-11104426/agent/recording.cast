[1184.232131, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nR = B\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nw, b = ln.weight, ln.bias\neps = ln.eps\nx2 = x.view(-1, N)\ny2 = torch.empty_like(x2)\n\ndef bench(fn, iters=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef _stats(x_ptr, s_ptr, N, R, BLOCK: tl.constexpr, C: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    base = row * N + c * (N // C)\n    a"]
[1184.232176, "i", "cc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, N // C, BLOCK):\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        acc += v\n        acc2 += v * v\n    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\n    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps,\n           BLOCK: tl.constexpr, C: tl.constexpr, CM: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    idx = tl.arange(0, C)\n    s1 = tl.load(s_ptr + row * C + idx)\n    s2 = tl.load(s_ptr + R * C + row * C + idx)\n    mean = tl.sum(s1, axis=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + c * (N // C)\n    off0 = c * (N // C)\n    for off in range(0, N // C, BLOCK):\n        j = off0 + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        wv = tl.load(w_ptr + j)\n        "]
[1184.232308, "i", "bv = tl.load(b_ptr + j)\n        out = (v - mean) * rstd * wv + bv\n        if CM == 1:\n            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out, cache_modifier='.cs')\n        else:\n            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out)\n\nsbuf = torch.empty(2 * R * 64, device=dev, dtype=torch.float32)\n\nresults = []\nfor C in (16, 32, 64):\n    for BLOCK in (4096, 8192):\n        for wp in (4, 8, 16):\n            for st in (2, 3, 4, 5):\n                def fa():\n                    _apply[(R * C,)](x2, w, b, sbuf, y2, N, R, eps, BLOCK=BLOCK, C=C, CM=0, num_warps=wp, num_stages=st)\n                t = bench(fa)\n                results.append((t, C, BLOCK, wp, st))\n                print(f\"apply C={C} B={BLOCK} w={wp} st={st}: {t:.4f}\", flush=True)\nresults.sort()\nprint('TOP5:', results[:5])\nEOF\n"]
[1184.232359, "o", "cat > /workspace/bench5.py << 'EOF'\r\n\u001b[?2004l\r"]
[1184.232391, "o", "\u001b[?2004h> "]
[1184.232493, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.232552, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.232587, "o", "dev = 'cuda'\r\n\u001b[?2004l\r"]
[1184.232629, "o", "\u001b[?2004h> "]
[1184.232663, "o", "torch.manual_seed(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.232717, "o", "B, F, D1, D2 = 16, 64, 256, 256\r\n\u001b[?2004l\r"]
[1184.232743, "o", "\u001b[?2004h> "]
[1184.232777, "o", "N = F * D1 * D2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.232803, "o", "R = B\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.23283, "o", "> "]
[1184.232887, "o", "x = torch.rand(B, F, D1, D2, device=dev)\r\n\u001b[?2004l\r"]
[1184.232914, "o", "\u001b[?2004h> "]
[1184.232968, "o", "ln = nn.LayerNorm((F, D1, D2)).to(dev)\r\n\u001b[?2004l\r"]
[1184.232994, "o", "\u001b[?2004h> "]
[1184.23303, "o", "w, b = ln.weight, ln.bias\r\n\u001b[?2004l\r"]
[1184.233064, "o", "\u001b[?2004h> "]
[1184.233097, "o", "eps = ln.eps\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.233123, "o", "x2 = x.view(-1, N)\r\n\u001b[?2004l\r"]
[1184.233149, "o", "\u001b[?2004h> "]
[1184.233186, "o", "y2 = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[1184.233214, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1184.23324, "o", "\u001b[?2004h> "]
[1184.233272, "o", "def bench(fn, iters=30):\r\n\u001b[?2004l\r"]
[1184.233299, "o", "\u001b[?2004h> "]
[1184.233334, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[1184.233362, "o", "\u001b[?2004h> "]
[1184.233402, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1184.233428, "o", "\u001b[?2004h> "]
[1184.233546, "o", "    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r"]
[1184.233575, "o", "\u001b[?2004h> "]
[1184.233607, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.23365, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[1184.233676, "o", "\u001b[?2004h> "]
[1184.233713, "o", "        scratch.fill_(42)\r\n\u001b[?2004l\r"]
[1184.23374, "o", "\u001b[?2004h> "]
[1184.233788, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1184.233813, "o", "\u001b[?2004h> "]
[1184.233958, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1184.233988, "o", "\u001b[?2004h> "]
[1184.234074, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1184.234102, "o", "\u001b[?2004h> "]
[1184.234156, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1184.234182, "o", "\u001b[?2004h> "]
[1184.234208, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.234241, "o", "> "]
[1184.234274, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1184.2343, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1184.234334, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.234457, "o", "def _stats(x_ptr, s_ptr, N, R, BLOCK: tl.constexpr, C: tl.constexpr):\r\n\u001b[?2004l\r"]
[1184.234483, "o", "\u001b[?2004h> "]
[1184.234518, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1184.234543, "o", "\u001b[?2004h> "]
[1184.234569, "o", "    row = pid // C\r\n\u001b[?2004l\r"]
[1184.234598, "o", "\u001b[?2004h> "]
[1184.234625, "o", "    c = pid % C\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.23465, "o", "> "]
[1184.234694, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[1184.234719, "o", "\u001b[?2004h> "]
[1184.234788, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1184.234816, "o", "\u001b[?2004h> "]
[1184.234888, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1184.234914, "o", "\u001b[?2004h> "]
[1184.234973, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1184.234999, "o", "\u001b[?2004h> "]
[1184.235095, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1184.235121, "o", "\u001b[?2004h> "]
[1184.235147, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.235185, "o", "> "]
[1184.23521, "o", "        acc2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.235305, "o", "    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[1184.235331, "o", "\u001b[?2004h> "]
[1184.235427, "o", "    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[1184.235456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.235482, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1184.235508, "o", "\u001b[?2004h> "]
[1184.235627, "o", "def _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps,\r\n\u001b[?2004l\r"]
[1184.23566, "o", "\u001b[?2004h> "]
[1184.235754, "o", "           BLOCK: tl.constexpr, C: tl.constexpr, CM: tl.constexpr):\r\n\u001b[?2004l\r"]
[1184.235781, "o", "\u001b[?2004h> "]
[1184.235817, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1184.235845, "o", "\u001b[?2004h> "]
[1184.235872, "o", "    row = pid // C\r\n\u001b[?2004l\r"]
[1184.235899, "o", "\u001b[?2004h> "]
[1184.235924, "o", "    c = pid % C\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.235957, "o", "> "]
[1184.235983, "o", "    idx = tl.arange(0, C)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.236016, "o", "> "]
[1184.236062, "o", "    s1 = tl.load(s_ptr + row * C + idx)\r\n\u001b[?2004l\r"]
[1184.236088, "o", "\u001b[?2004h> "]
[1184.23616, "o", "    s2 = tl.load(s_ptr + R * C + row * C + idx)\r\n\u001b[?2004l\r"]
[1184.236187, "o", "\u001b[?2004h> "]
[1184.236236, "o", "    mean = tl.sum(s1, axis=0) / N\r\n\u001b[?2004l\r"]
[1184.236262, "o", "\u001b[?2004h> "]
[1184.236332, "o", "    var = tl.sum(s2, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1184.23636, "o", "\u001b[?2004h> "]
[1184.236411, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1184.236438, "o", "\u001b[?2004h> "]
[1184.236486, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[1184.236512, "o", "\u001b[?2004h> "]
[1184.236544, "o", "    off0 = c * (N // C)\r\n\u001b[?2004l\r"]
[1184.23657, "o", "\u001b[?2004h> "]
[1184.236635, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1184.236668, "o", "\u001b[?2004h> "]
[1184.236728, "o", "        j = off0 + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1184.236755, "o", "\u001b[?2004h> "]
[1184.236847, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1184.236873, "o", "\u001b[?2004h> "]
[1184.23692, "o", "        wv = tl.load(w_ptr + j)\r\n\u001b[?2004l\r"]
[1184.236945, "o", "\u001b[?2004h> "]
[1184.236991, "o", "        bv = tl.load(b_ptr + j)\r\n\u001b[?2004l\r"]
[1184.237024, "o", "\u001b[?2004h> "]
[1184.237079, "o", "        out = (v - mean) * rstd * wv + bv\r\n\u001b[?2004l\r"]
[1184.237105, "o", "\u001b[?2004h> "]
[1184.237133, "o", "        if CM == 1:\r\n\u001b[?2004l\r"]
[1184.237159, "o", "\u001b[?2004h> "]
[1184.237296, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[1184.237324, "o", "\u001b[?2004h> "]
[1184.23735, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.237376, "o", "> "]
[1184.237467, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out)\r\n\u001b[?2004l\r"]
[1184.237494, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.23752, "o", "> "]
[1184.237619, "o", "sbuf = torch.empty(2 * R * 64, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.237645, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1184.237672, "o", "results = []\r\n\u001b[?2004l\r"]
[1184.237698, "o", "\u001b[?2004h> "]
[1184.237731, "o", "for C in (16, 32, 64):\r\n\u001b[?2004l\r"]
[1184.237765, "o", "\u001b[?2004h> "]
[1184.237803, "o", "    for BLOCK in (4096, 8192):\r\n\u001b[?2004l\r"]
[1184.23783, "o", "\u001b[?2004h> "]
[1184.237872, "o", "        for wp in (4, 8, 16):\r\n\u001b[?2004l\r"]
[1184.237897, "o", "\u001b[?2004h> "]
[1184.23795, "o", "            for st in (2, 3, 4, 5):\r\n\u001b[?2004l\r"]
[1184.237975, "o", "\u001b[?2004h> "]
[1184.238013, "o", "                def fa():\r\n\u001b[?2004l\r"]
[1184.238038, "o", "\u001b[?2004h> "]
[1184.238225, "o", "                    _apply[(R * C,)](x2, w, b, sbuf, y2, N, R, eps, BLOCK=BLOCK, C=C, CM=0, num_warps=wp, num_stages=st)\r\n\u001b[?2004l\r"]
[1184.238254, "o", "\u001b[?2004h> "]
[1184.238295, "o", "                t = bench(fa)\r\n\u001b[?2004l\r"]
[1184.238321, "o", "\u001b[?2004h> "]
[1184.238405, "o", "                results.append((t, C, BLOCK, wp, st))\r\n\u001b[?2004l\r"]
[1184.238431, "o", "\u001b[?2004h> "]
[1184.238566, "o", "                print(f\"apply C={C} B={BLOCK} w={wp} st={st}: {t:.4f}\", flush=True)\r\n\u001b[?2004l\r"]
[1184.238596, "o", "\u001b[?2004h> "]
[1184.238624, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1184.23865, "o", "> "]
[1184.238683, "o", "print('TOP5:', results[:5])\r\n\u001b[?2004l\r"]
[1184.238709, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1184.263283, "o", "\u001b[?2004hroot@modal:/# "]
