[995.609159, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nR = B\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nw, b = ln.weight, ln.bias\neps = ln.eps\nx2 = x.view(-1, N)\ny2 = torch.empty_like(x2)\n\ndef bench(fn, iters=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _stats(x_ptr, s_ptr, N, R, BLOCK: tl.constexpr, C: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    base = row"]
[995.609204, "i", " * N + c * (N // C)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, N // C, BLOCK):\n        if EV:\n            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        acc += v\n        acc2 += v * v\n    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\n    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps, BLOCK: tl.constexpr, C: tl.constexpr, EV: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    idx = tl.arange(0, C)\n    s1 = tl.load(s_ptr + row * C + idx)\n    s2 = tl.load(s_ptr + R * C + row * C + idx)\n    mean = tl.sum(s1, axis=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + c * (N // C)\n    for off in range(0, N // C, BLOCK):\n        i = base + off + tl"]
[995.60923, "i", ".arange(0, BLOCK)\n        j = c * (N // C) + off + tl.arange(0, BLOCK)\n        if EV:\n            v = tl.load(x_ptr + i, eviction_policy='evict_first')\n            wv = tl.load(w_ptr + j, eviction_policy='evict_last')\n            bv = tl.load(b_ptr + j, eviction_policy='evict_last')\n            tl.store(y_ptr + i, (v - mean) * rstd * wv + bv, eviction_policy='evict_first')\n        else:\n            v = tl.load(x_ptr + i)\n            wv = tl.load(w_ptr + j)\n            bv = tl.load(b_ptr + j)\n            tl.store(y_ptr + i, (v - mean) * rstd * wv + bv)\n\ndef run(C, BLOCK, wp1, st1, wp2, st2, EV):\n    stats = torch.empty(2 * R * C, device=dev, dtype=torch.float32)\n    def f_stats():\n        _stats[(R * C,)](x2, stats, N, R, BLOCK=BLOCK, C=C, EV=EV, num_warps=wp1, num_stages=st1)\n    def f_apply():\n        _apply[(R * C,)](x2, w, b, stats, y2, N, R, eps, BLOCK=BLOCK, C=C, EV=EV, num_warps=wp2, num_stages=st2)\n    def f_both():\n        f_stats(); f_apply()\n    return f_stats, f_apply, f_both\n\nfor (C, BLOCK, wp1, s"]
[995.60936, "i", "t1, wp2, st2, EV) in [\n    (16, 8192, 4, 4, 4, 4, False),\n    (16, 8192, 4, 4, 4, 4, True),\n    (16, 8192, 8, 4, 8, 4, True),\n    (16, 8192, 8, 2, 8, 2, True),\n    (8, 8192, 4, 4, 4, 4, True),\n    (8, 8192, 8, 4, 8, 4, True),\n    (8, 16384, 8, 3, 8, 3, True),\n    (16, 16384, 8, 2, 8, 2, True),\n    (32, 8192, 8, 3, 8, 3, True),\n    (16, 8192, 4, 6, 4, 6, True),\n]:\n    fs, fa, fb = run(C, BLOCK, wp1, st1, wp2, st2, EV)\n    ms, _ = bench(fs)\n    ma, _ = bench(fa)\n    mb, mn = bench(fb)\n    print(f\"C={C} B={BLOCK} w={wp1}/{wp2} st={st1}/{st2} EV={int(EV)}: stats {ms:.4f} apply {ma:.4f} both {mb:.4f} (min {mn:.4f})\", flush=True)\nEOF\n"]
