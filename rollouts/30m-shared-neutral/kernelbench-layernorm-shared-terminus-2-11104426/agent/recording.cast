[730.322059, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_stats(x_ptr, s_ptr, N, R, C,\n              BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    base = row * N + c * (N // C)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, N // C, BLOCK):\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        acc += v\n        acc2 += v * v\n    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\n    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\n\n\n@triton.jit\ndef _ln_apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, C, eps,\n              BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    idx = tl.arange(0, C)\n    s1 = tl.load(s_ptr + row * C + idx)\n    s2 = tl.load(s_ptr + R * C + row * C + idx)\n    mean = tl.sum(s1, axis=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n  "]
[730.322107, "i", "  rstd = 1.0 / tl.sqrt(var + eps)\n    base = row * N + c * (N // C)\n    for off in range(0, N // C, BLOCK):\n        i = base + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + i)\n        w = tl.load(w_ptr + i - row * N)\n        b = tl.load(b_ptr + i - row * N)\n        tl.store(y_ptr + i, (v - mean) * rstd * w + b)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        N = 1\n        for s in tuple(normalized_shape):\n            N *= s\n        self._N = N\n        # pick (C, BLOCK): C chunks per row, both kernels sweep N//C elems\n        self._cfg = None\n        for C, BLOCK in ((16, 8192), (8, 8192), (4, 8192), (2, 8192), (1, 8192),\n                         (1, 4096), (1, 2048), (1, 1024)):\n            if N % (C * BLOCK) == 0:\n                self._cfg = (C, BLOCK)\n                break\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if self._cfg is None or not x.is_c"]
[730.322249, "i", "uda or x.dtype != torch.float32:\n            return self.ln(x)\n        N = self._N\n        C, BLOCK = self._cfg\n        x2 = x.contiguous().view(-1, N)\n        R = x2.shape[0]\n        y = torch.empty_like(x2)\n        stats = torch.empty(2 * R * C, device=x.device, dtype=torch.float32)\n        w = self.ln.weight\n        b = self.ln.bias\n        _ln_stats[(R * C,)](x2, stats, N, R, C, BLOCK=BLOCK,\n                            num_warps=4, num_stages=4)\n        _ln_apply[(R * C,)](x2, w, b, stats, y, N, R, C, self.ln.eps,\n                            BLOCK=BLOCK, num_warps=4, num_stages=4)\n        return y.view_as(x)\nEOF\n"]
