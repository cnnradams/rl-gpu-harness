[1324.890183, "o", "\u001b[?2004h> "]
[1324.890225, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[1324.890258, "o", "\u001b[?2004h> "]
[1324.89032, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1324.890352, "o", "\u001b[?2004h> "]
[1324.890419, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1324.890451, "o", "\u001b[?2004h> "]
[1324.890502, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1324.890535, "o", "\u001b[?2004h> "]
[1324.890568, "o", "        if EVP:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.890721, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[1324.890753, "o", "\u001b[?2004h> "]
[1324.890785, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.890888, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1324.890921, "o", "\u001b[?2004h> "]
[1324.890954, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.890986, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[1324.891019, "o", "\u001b[?2004h> "]
[1324.891098, "o", "    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[1324.891131, "o", "\u001b[?2004h> "]
[1324.891219, "o", "    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[1324.89125, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.891283, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[1324.891315, "o", "\u001b[?2004h> "]
[1324.891394, "o", "def _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps,\r\n\u001b[?2004l\r"]
[1324.891432, "o", "\u001b[?2004h> "]
[1324.891566, "o", "           BLOCK: tl.constexpr, C: tl.constexpr, REV: tl.constexpr, CM: tl.constexpr):\r\n\u001b[?2004l\r"]
[1324.891598, "o", "\u001b[?2004h> "]
[1324.89163, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1324.891664, "o", "\u001b[?2004h> "]
[1324.891696, "o", "    c = pid % C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.891728, "o", "    if REV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.891787, "o", "        row = R - 1 - pid // C\r\n\u001b[?2004l\r"]
[1324.891819, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[1324.891851, "o", "\u001b[?2004h> "]
[1324.891884, "o", "        row = pid // C\r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.891916, "o", "> "]
[1324.891949, "o", "    idx = tl.arange(0, C)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.891981, "o", "> "]
[1324.892026, "o", "    s1 = tl.load(s_ptr + row * C + idx)\r\n\u001b[?2004l\r"]
[1324.892058, "o", "\u001b[?2004h> "]
[1324.892124, "o", "    s2 = tl.load(s_ptr + R * C + row * C + idx)\r\n\u001b[?2004l\r"]
[1324.892156, "o", "\u001b[?2004h> "]
[1324.892199, "o", "    mean = tl.sum(s1, axis=0) / N\r\n\u001b[?2004l\r"]
[1324.892231, "o", "\u001b[?2004h> "]
[1324.892293, "o", "    var = tl.sum(s2, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1324.892326, "o", "\u001b[?2004h> "]
[1324.89237, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1324.892406, "o", "\u001b[?2004h> "]
[1324.892449, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[1324.892481, "o", "\u001b[?2004h> "]
[1324.892514, "o", "    off0 = c * (N // C)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.892545, "o", "> "]
[1324.892591, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1324.892624, "o", "\u001b[?2004h> "]
[1324.892684, "o", "        j = off0 + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1324.892717, "o", "\u001b[?2004h> "]
[1324.892803, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1324.892836, "o", "\u001b[?2004h> "]
[1324.892875, "o", "        wv = tl.load(w_ptr + j)\r\n\u001b[?2004l\r"]
[1324.892908, "o", "\u001b[?2004h> "]
[1324.892941, "o", "        bv = tl.load(b_ptr + j)\r\n\u001b[?2004l\r"]
[1324.892972, "o", "\u001b[?2004h> "]
[1324.893033, "o", "        out = (v - mean) * rstd * wv + bv\r\n\u001b[?2004l\r"]
[1324.893066, "o", "\u001b[?2004h> "]
[1324.893098, "o", "        if CM == 1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.893248, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[1324.893279, "o", "\u001b[?2004h> "]
[1324.89331, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.893423, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out)\r\n\u001b[?2004l\r"]
[1324.893456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.893562, "o", "def fwd(Cs, Bs, wps, sts, evp, Ca, Ba, wpa, sta, rev, cm):\r\n\u001b[?2004l\r"]
[1324.893594, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r"]
[1324.893626, "o", "\u001b[?2004h> "]
[1324.893739, "o", "        stats = torch.empty(2 * R * Cs, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1324.893772, "o", "\u001b[?2004h> "]
[1324.893914, "o", "        _stats[(R * Cs,)](x2, stats, N, R, BLOCK=Bs, C=Cs, EVP=evp, num_warps=wps, num_stages=sts)\r\n\u001b[?2004l\r"]
[1324.893948, "o", "\u001b[?2004h> "]
[1324.894129, "o", "        _apply[(R * Ca,)](x2, w, b, stats, y2, N, R, eps, BLOCK=Ba, C=Ca, REV=rev, CM=cm, num_warps=wpa, num_stages=sta)\r\n\u001b[?2004l\r"]
[1324.894168, "o", "\u001b[?2004h>     return f\r\n\u001b[?2004l\r"]
[1324.8942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1324.894233, "o", "cfgs = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.894266, "o", "> "]
[1324.894434, "o", "    dict(Cs=16, Bs=8192, wps=4, sts=4, evp=False, Ca=16, Ba=8192, wpa=4, sta=4, rev=False, cm=0),  # current best\r\n\u001b[?2004l\r"]
[1324.894467, "o", "\u001b[?2004h> "]
[1324.894606, "o", "    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=False, Ca=32, Ba=4096, wpa=8, sta=3, rev=False, cm=0),\r\n\u001b[?2004l\r"]
[1324.894639, "o", "\u001b[?2004h> "]
[1324.894782, "o", "    dict(Cs=32, Bs=8192, wps=8, sts=3, evp=False, Ca=32, Ba=4096, wpa=8, sta=3, rev=False, cm=0),\r\n\u001b[?2004l\r"]
[1324.894814, "o", "\u001b[?2004h> "]
[1324.894956, "o", "    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=True,  Ca=16, Ba=8192, wpa=4, sta=4, rev=True,  cm=0),\r\n\u001b[?2004l\r"]
[1324.89499, "o", "\u001b[?2004h> "]
[1324.895134, "o", "    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=True,  Ca=32, Ba=4096, wpa=8, sta=3, rev=True,  cm=0),\r\n\u001b[?2004l\r"]
[1324.895167, "o", "\u001b[?2004h> "]
[1324.895309, "o", "    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=True,  Ca=32, Ba=4096, wpa=8, sta=3, rev=True,  cm=1),\r\n\u001b[?2004l\r"]
[1324.895342, "o", "\u001b[?2004h> "]
[1324.895492, "o", "    dict(Cs=32, Bs=8192, wps=8, sts=3, evp=True,  Ca=32, Ba=4096, wpa=8, sta=3, rev=True,  cm=0),\r\n\u001b[?2004l\r"]
[1324.895527, "o", "\u001b[?2004h> "]
[1324.895673, "o", "    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=False, Ca=32, Ba=4096, wpa=8, sta=3, rev=False, cm=1),\r\n\u001b[?2004l\r"]
[1324.895705, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.895737, "o", "> for cfg in cfgs:\r\n\u001b[?2004l\r"]
[1324.89577, "o", "\u001b[?2004h> "]
[1324.895802, "o", "    f = fwd(**cfg)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1324.895835, "o", ">     f()\r\n\u001b[?2004l\r\u001b[?2004h"]
