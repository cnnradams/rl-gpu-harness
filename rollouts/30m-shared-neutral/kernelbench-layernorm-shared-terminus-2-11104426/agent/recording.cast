[1684.359589, "i", "cat > /workspace/bench8.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nR = B\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nw, b = ln.weight, ln.bias\neps = ln.eps\nx2 = x.view(-1, N)\ny2 = torch.empty_like(x2)\nref = ln(x).view(-1, N)\n\n@triton.jit\ndef _fused(x_ptr, w_ptr, b_ptr, y_ptr, acc_ptr, cnt_ptr, N, R, eps,\n           BLOCK: tl.constexpr, G: tl.constexpr):\n    pid = tl.program_id(0)\n    ar = tl.arange(0, BLOCK)\n    j = pid * BLOCK + ar\n    for r in range(R):\n        i = r * N + pid * BLOCK + ar\n        v = tl.load(x_ptr + i)\n        s1 = tl.sum(v, axis=0)\n        s2 = tl.sum(v * v, axis=0)\n        tl.atomic_add(acc_ptr + r, s1)\n        tl.atomic_add(acc_ptr + r + R, s2)\n        tl.atomic_add(cnt_ptr + r, 1, sem='release')\n        target = (r + 1) * G\n        n = tl.atomic_add(cnt_ptr + r, 0, sem='acquire')\n        while n < target:\n            n = tl.atomic_add"]
[1684.359639, "i", "(cnt_ptr + r, 0, sem='acquire')\n        mean = tl.load(acc_ptr + r) / N\n        var = tl.load(acc_ptr + r + R) / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        wv = tl.load(w_ptr + j)\n        bv = tl.load(b_ptr + j)\n        tl.store(y_ptr + i, (v - mean) * rstd * wv + bv)\n\ndef bench(fn, iters=40):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nG, BLOCK, WP = 128, 32768, 32\nbuf = torch.zeros(3 * R, device=dev, dtype=torch.float32)\nacc = buf[:2 * R]\ncnt = buf[2 * R:].view(torch.int32)\n\ndef f():\n    buf.zero_()\n    _fused[(G,)](x2, w, b, y2, acc, cnt, N, R, eps, BLOCK=BLOCK, G=G, num_warps="]
[1684.35968, "i", "WP)\n\nf()\ntorch.cuda.synchronize()\nerr = (y2 - ref).abs().max().item()\nt = bench(f)\nprint(f\"fused G={G} BLOCK={BLOCK} w={WP}: t={t:.4f} err={err:.2e}\", flush=True)\nEOF\ngpu sync && gpu refresh sb-usjK6lfioOeY9u4RfkEZ8F && gpu exec sb-usjK6lfioOeY9u4RfkEZ8F -- timeout 90 python3 /workspace/bench8.py\n"]
