[893.58839, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nx = torch.rand(B, F, D1, D2, device=dev)\n\ndef bench(fn, iters=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\ny = torch.empty_like(x)\nmed, mn = bench(lambda: y.copy_(x))\nprint(f\"copy 256MB->256MB: med {med:.4f} min {mn:.4f} ({2*x.numel()*4/med*1e-9:.2f} TB/s)\", flush=True)\n\n# read-only bandwidth: sum reduction per 4M chunk\ns = torch.empty(16*64, device=dev)\nimport torch.sum as _\nmed, mn = bench(lambda: x.view(16*64, -1).sum(dim=1, ou"]
[893.588437, "i", "t=s.view(16,64)) if False else torch.sum(x.view(-1)[:256]))\nprint(f\"tiny read probe: {med:.4f}\")\n\n# full sum reduction\nmed, mn = bench(lambda: x.sum())\nprint(f\"x.sum() (512MB read): med {med:.4f} min {mn:.4f} ({x.numel()*4/med*1e-9:.2f} TB/s)\", flush=True)\nEOF\n"]
