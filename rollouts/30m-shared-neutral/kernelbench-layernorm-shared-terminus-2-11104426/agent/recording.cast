[1107.03626, "o", "\u001b[?2004h> "]
[1107.036403, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1107.036423, "o", "\u001b[?2004h> "]
[1107.036526, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1107.036544, "o", "\u001b[?2004h> "]
[1107.036606, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1107.036632, "o", "\u001b[?2004h> "]
[1107.036653, "o", "    ts.sort()\r\n\u001b[?2004l\r"]
[1107.036674, "o", "\u001b[?2004h> "]
[1107.036712, "o", "    return ts[len(ts)//2]\r\n\u001b[?2004l\r"]
[1107.036725, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1107.036749, "o", "\u001b[?2004h> "]
[1107.036776, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1107.036796, "o", "\u001b[?2004h> "]
[1107.036905, "o", "def _read(x_ptr, s_ptr, N, BLOCK: tl.constexpr, C: tl.constexpr):\r\n\u001b[?2004l\r"]
[1107.036926, "o", "\u001b[?2004h> "]
[1107.036968, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1107.036986, "o", "\u001b[?2004h> "]
[1107.037029, "o", "    base = pid * (N // C)\r\n\u001b[?2004l\r"]
[1107.037049, "o", "\u001b[?2004h> "]
[1107.037123, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1107.037142, "o", "\u001b[?2004h> "]
[1107.037217, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1107.037232, "o", "\u001b[?2004h> "]
[1107.037343, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1107.037363, "o", "> "]
[1107.037389, "o", "        acc += v\r\n\u001b[?2004l\r"]
[1107.03741, "o", "\u001b[?2004h> "]
[1107.037484, "o", "    tl.store(s_ptr + pid, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[1107.037506, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1107.037527, "o", "\u001b[?2004h> "]
[1107.037547, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1107.037561, "o", "\u001b[?2004h> "]
[1107.037709, "o", "def _stats(x_ptr, s_ptr, N, R, BLOCK: tl.constexpr, C: tl.constexpr, EVP: tl.constexpr):\r\n\u001b[?2004l\r"]
[1107.037731, "o", "\u001b[?2004h> "]
[1107.037773, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1107.037794, "o", "\u001b[?2004h> "]
[1107.037829, "o", "    row = pid // C\r\n\u001b[?2004l\r\u001b[?2004h"]
[1107.037848, "o", "> "]
[1107.037871, "o", "    c = pid % C\r\n\u001b[?2004l\r"]
[1107.037892, "o", "\u001b[?2004h> "]
[1107.037945, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[1107.037964, "o", "\u001b[?2004h> "]
[1107.038039, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1107.038061, "o", "\u001b[?2004h> "]
[1107.038135, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1107.038147, "o", "\u001b[?2004h> "]
[1107.038223, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1107.038243, "o", "\u001b[?2004h> "]
[1107.038264, "o", "        if EVP:\r\n\u001b[?2004l\r"]
[1107.038277, "o", "\u001b[?2004h"]
[1107.038292, "o", "> "]
[1107.038441, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[1107.03846, "o", "\u001b[?2004h> "]
[1107.038485, "o", "        else:\r\n\u001b[?2004l\r"]
[1107.038508, "o", "\u001b[?2004h> "]
[1107.03861, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1107.038628, "o", "\u001b[?2004h> "]
[1107.038659, "o", "        acc += v\r\n\u001b[?2004l\r"]
[1107.038679, "o", "\u001b[?2004h> "]
[1107.038715, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[1107.038735, "o", "\u001b[?2004h> "]
[1107.038823, "o", "    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[1107.038836, "o", "\u001b[?2004h> "]
[1107.038945, "o", "    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[1107.038968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1107.038984, "o", "\u001b[?2004h> "]
[1107.039008, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1107.039025, "o", "\u001b[?2004h> "]
[1107.039119, "o", "def _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps,\r\n\u001b[?2004l\r"]
[1107.039139, "o", "\u001b[?2004h> "]
[1107.039283, "o", "           BLOCK: tl.constexpr, C: tl.constexpr, REV: tl.constexpr, CM: tl.constexpr):\r\n\u001b[?2004l\r"]
[1107.039303, "o", "\u001b[?2004h> "]
[1107.039347, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1107.039366, "o", "\u001b[?2004h> "]
[1107.039387, "o", "    if REV:\r\n\u001b[?2004l\r"]
[1107.039403, "o", "\u001b[?2004h> "]
[1107.039457, "o", "        row = R - 1 - pid // C\r\n\u001b[?2004l\r"]
[1107.03948, "o", "\u001b[?2004h> "]
[1107.039496, "o", "    else:\r\n\u001b[?2004l\r"]
[1107.039521, "o", "\u001b[?2004h> "]
[1107.039561, "o", "        row = pid // C\r\n\u001b[?2004l\r"]
[1107.039577, "o", "\u001b[?2004h> "]
[1107.039606, "o", "    c = pid % C\r\n\u001b[?2004l\r"]
[1107.039627, "o", "\u001b[?2004h> "]
[1107.039669, "o", "    idx = tl.arange(0, C)\r\n\u001b[?2004l\r"]
[1107.039687, "o", "\u001b[?2004h> "]
[1107.039752, "o", "    s1 = tl.load(s_ptr + row * C + idx)\r\n\u001b[?2004l\r"]
[1107.039765, "o", "\u001b[?2004h> "]
[1107.03985, "o", "    s2 = tl.load(s_ptr + R * C + row * C + idx)\r\n\u001b[?2004l\r"]
[1107.039864, "o", "\u001b[?2004h> "]
[1107.039925, "o", "    mean = tl.sum(s1, axis=0) / N\r\n\u001b[?2004l\r"]
[1107.039941, "o", "\u001b[?2004h> "]
[1107.04002, "o", "    var = tl.sum(s2, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[1107.040039, "o", "\u001b[?2004h> "]
[1107.040099, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[1107.040118, "o", "\u001b[?2004h> "]
[1107.040179, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[1107.040197, "o", "\u001b[?2004h> "]
[1107.040238, "o", "    off0 = c * (N // C)\r\n\u001b[?2004l\r"]
[1107.040259, "o", "\u001b[?2004h> "]
[1107.040323, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[1107.040341, "o", "\u001b[?2004h> "]
[1107.040415, "o", "        j = off0 + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1107.040436, "o", "\u001b[?2004h> "]
[1107.040534, "o", "        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[1107.040548, "o", "\u001b[?2004h> "]
[1107.040607, "o", "        wv = tl.load(w_ptr + j)\r\n\u001b[?2004l\r"]
[1107.040627, "o", "\u001b[?2004h> "]
[1107.04068, "o", "        bv = tl.load(b_ptr + j)\r\n\u001b[?2004l\r"]
[1107.040699, "o", "\u001b[?2004h> "]
[1107.040767, "o", "        out = (v - mean) * rstd * wv + bv\r\n\u001b[?2004l\r"]
[1107.040787, "o", "\u001b[?2004h> "]
[1107.04082, "o", "        if CM == 1:\r\n\u001b[?2004l\r"]
[1107.040842, "o", "\u001b[?2004h> "]
[1107.040984, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[1107.041006, "o", "\u001b[?2004h> "]
[1107.041041, "o", "        elif CM == 2:\r\n\u001b[?2004l\r"]
[1107.041059, "o", "\u001b[?2004h> "]
[1107.041208, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out, cache_modifier='.wt')\r\n\u001b[?2004l\r"]
[1107.041229, "o", "\u001b[?2004h> "]
[1107.041252, "o", "        else:\r\n\u001b[?2004l\r"]
[1107.041265, "o", "\u001b[?2004h> "]
[1107.04138, "o", "            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out)\r\n\u001b[?2004l\r"]
[1107.041401, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1107.041412, "o", "\u001b[?2004h> "]
[1107.041527, "o", "sbuf = torch.empty(2 * R * 64, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1107.041546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1107.04156, "o", "\u001b[?2004h> "]
[1107.041618, "o", "print('--- pure read BW ---')\r\n\u001b[?2004l\r"]
[1107.041636, "o", "\u001b[?2004h> "]
[1107.041676, "o", "for C in (16, 32, 64):\r\n\u001b[?2004l\r"]
[1107.041696, "o", "\u001b[?2004h> "]
[1107.041746, "o", "    for BLOCK in (4096, 8192):\r\n\u001b[?2004l\r"]
[1107.041767, "o", "\u001b[?2004h> "]
[1107.041809, "o", "        for wp in (4, 8):\r\n\u001b[?2004l\r"]
[1107.041825, "o", "\u001b[?2004h> "]
[1107.041883, "o", "            for st in (2, 3, 4):\r\n\u001b[?2004l\r"]
[1107.041902, "o", "\u001b[?2004h> "]
[1107.042104, "o", "                t = bench(lambda: _read[(R * C,)](x2, sbuf, N * R // R, BLOCK=BLOCK, C=C, num_warps=wp, num_stages=st))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1107.042121, "o", "> "]
[1107.042312, "o", "                print(f\"read C={C} B={BLOCK} w={wp} st={st}: {t:.4f} ({N*R*4/t*1e-9:.2f} TB/s)\", flush=True)\r\n\u001b[?2004l\r"]
[1107.042328, "o", "\u001b[?2004h> "]
[1107.042351, "o", "EOF\r\n\u001b[?2004l\r"]
[1107.069042, "o", "\u001b[?2004hroot@modal:/# "]
