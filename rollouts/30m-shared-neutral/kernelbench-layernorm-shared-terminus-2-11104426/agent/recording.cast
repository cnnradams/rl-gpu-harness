[1115.729343, "o", "read C=64 B=8192 w=8 st=2: 0.1094 (2.45 TB/s)\r\n"]
[1116.475152, "o", "read C=64 B=8192 w=8 st=3: 0.1092 (2.46 TB/s)\r\nread C=64 B=8192 w=8 st=4: 0.1096 (2.45 TB/s)\r\n"]
