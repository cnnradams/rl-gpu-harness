[384.829907, "o", "\u001b[?2004h> "]
[384.829988, "o", "def _ln_stats(x_ptr, w_ptr, b_ptr, s_ptr, N, eps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.83002, "o", "> "]
[384.830121, "o", "              BLOCK: tl.constexpr, C: tl.constexpr, R: tl.constexpr):\r\n\u001b[?2004l\r"]
[384.830156, "o", "\u001b[?2004h> "]
[384.830182, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[384.830208, "o", "\u001b[?2004h> "]
[384.830234, "o", "    row = pid // C\r\n\u001b[?2004l\r"]
[384.830268, "o", "\u001b[?2004h> "]
[384.830297, "o", "    c = pid % C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.830337, "o", "    n0 = c * (N // C)\r\n\u001b[?2004l\r"]
[384.830371, "o", "\u001b[?2004h> "]
[384.830432, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[384.830463, "o", "\u001b[?2004h> "]
[384.830528, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[384.830554, "o", "\u001b[?2004h> "]
[384.830613, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[384.830639, "o", "\u001b[?2004h> "]
[384.830745, "o", "        v = tl.load(x_ptr + row * N + n0 + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[384.830777, "o", "\u001b[?2004h> "]
