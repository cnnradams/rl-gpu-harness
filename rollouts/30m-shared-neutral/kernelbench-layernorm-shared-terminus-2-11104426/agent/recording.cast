[995.612185, "o", "\u001b[?2004h> "]
[995.612254, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[995.612286, "o", "\u001b[?2004h> "]
[995.61235, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[995.612383, "o", "\u001b[?2004h> "]
[995.612437, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[995.612464, "o", "\u001b[?2004h> "]
[995.612491, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.612682, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.612699, "o", "> "]
[995.612732, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.612762, "o", "> "]
[995.612846, "o", "            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\r\n\u001b[?2004l\r"]
[995.612879, "o", "\u001b[?2004h> "]
[995.612912, "o", "        acc += v\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.612945, "o", "        acc2 += v * v\r\n\u001b[?2004l\r"]
[995.612977, "o", "\u001b[?2004h> "]
[995.613057, "o", "    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[995.61309, "o", "\u001b[?2004h> "]
[995.613179, "o", "    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[995.613212, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[995.613245, "o", "> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.613277, "o", "> "]
[995.613447, "o", "def _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps, BLOCK: tl.constexpr, C: tl.constexpr, EV: tl.constexpr):\r\n\u001b[?2004l\r"]
[995.613481, "o", "\u001b[?2004h> "]
[995.613522, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.613554, "o", "> "]
[995.613586, "o", "    row = pid // C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.613619, "o", "    c = pid % C\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.613651, "o", "> "]
[995.613684, "o", "    idx = tl.arange(0, C)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.613757, "o", "    s1 = tl.load(s_ptr + row * C + idx)\r\n\u001b[?2004l\r"]
[995.61379, "o", "\u001b[?2004h> "]
[995.613853, "o", "    s2 = tl.load(s_ptr + R * C + row * C + idx)\r\n\u001b[?2004l\r"]
[995.613886, "o", "\u001b[?2004h> "]
[995.613929, "o", "    mean = tl.sum(s1, axis=0) / N\r\n\u001b[?2004l\r"]
[995.613961, "o", "\u001b[?2004h> "]
[995.614022, "o", "    var = tl.sum(s2, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[995.614054, "o", "\u001b[?2004h> "]
[995.6141, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[995.61413, "o", "\u001b[?2004h> "]
[995.614174, "o", "    base = row * N + c * (N // C)\r\n\u001b[?2004l\r"]
[995.614207, "o", "\u001b[?2004h> "]
[995.614258, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[995.614291, "o", "\u001b[?2004h> "]
[995.61435, "o", "        i = base + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[995.614382, "o", "\u001b[?2004h> "]
[995.614459, "o", "        j = c * (N // C) + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[995.614489, "o", "\u001b[?2004h> "]
[995.614526, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.614629, "o", "            v = tl.load(x_ptr + i, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[995.614661, "o", "\u001b[?2004h> "]
[995.614753, "o", "            wv = tl.load(w_ptr + j, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[995.614785, "o", "\u001b[?2004h> "]
[995.614878, "o", "            bv = tl.load(b_ptr + j, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[995.61491, "o", "\u001b[?2004h> "]
[995.615045, "o", "            tl.store(y_ptr + i, (v - mean) * rstd * wv + bv, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[995.615078, "o", "\u001b[?2004h> "]
[995.61511, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.615163, "o", "            v = tl.load(x_ptr + i)\r\n\u001b[?2004l\r"]
[995.61519, "o", "\u001b[?2004h> "]
[995.61524, "o", "            wv = tl.load(w_ptr + j)\r\n\u001b[?2004l\r"]
[995.615273, "o", "\u001b[?2004h> "]
[995.615317, "o", "            bv = tl.load(b_ptr + j)\r\n\u001b[?2004l\r"]
[995.61535, "o", "\u001b[?2004h> "]
[995.615439, "o", "            tl.store(y_ptr + i, (v - mean) * rstd * wv + bv)\r\n\u001b[?2004l\r"]
[995.615474, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.615568, "o", "def run(C, BLOCK, wp1, st1, wp2, st2, EV):\r\n\u001b[?2004l\r"]
[995.615595, "o", "\u001b[?2004h> "]
[995.615693, "o", "    stats = torch.empty(2 * R * C, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[995.615723, "o", "\u001b[?2004h> "]
[995.615756, "o", "    def f_stats():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.61592, "o", "        _stats[(R * C,)](x2, stats, N, R, BLOCK=BLOCK, C=C, EV=EV, num_warps=wp1, num_stages=st1)\r\n\u001b[?2004l\r"]
[995.615952, "o", "\u001b[?2004h> "]
[995.615985, "o", "    def f_apply():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.616176, "o", "        _apply[(R * C,)](x2, w, b, stats, y2, N, R, eps, BLOCK=BLOCK, C=C, EV=EV, num_warps=wp2, num_stages=st2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.61621, "o", "> "]
[995.616242, "o", "    def f_both():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.616288, "o", "        f_stats(); f_apply()\r\n\u001b[?2004l\r"]
[995.616322, "o", "\u001b[?2004h> "]
[995.616366, "o", "    return f_stats, f_apply, f_both\r\n\u001b[?2004l\r"]
[995.616399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.616478, "o", "for (C, BLOCK, wp1, st1, wp2, st2, EV) in [\r\n\u001b[?2004l\r"]
[995.616516, "o", "\u001b[?2004h> "]
[995.616562, "o", "    (16, 8192, 4, 4, 4, 4, False),\r\n\u001b[?2004l\r"]
[995.616595, "o", "\u001b[?2004h> "]
[995.616636, "o", "    (16, 8192, 4, 4, 4, 4, True),\r\n\u001b[?2004l\r"]
[995.616668, "o", "\u001b[?2004h> "]
[995.61671, "o", "    (16, 8192, 8, 4, 8, 4, True),\r\n\u001b[?2004l\r"]
[995.616742, "o", "\u001b[?2004h> "]
[995.616784, "o", "    (16, 8192, 8, 2, 8, 2, True),\r\n\u001b[?2004l\r"]
[995.616816, "o", "\u001b[?2004h> "]
[995.616856, "o", "    (8, 8192, 4, 4, 4, 4, True),\r\n\u001b[?2004l\r"]
[995.616888, "o", "\u001b[?2004h> "]
[995.616929, "o", "    (8, 8192, 8, 4, 8, 4, True),\r\n\u001b[?2004l\r"]
[995.616962, "o", "\u001b[?2004h> "]
[995.617004, "o", "    (8, 16384, 8, 3, 8, 3, True),\r\n\u001b[?2004l\r"]
[995.617036, "o", "\u001b[?2004h> "]
[995.617079, "o", "    (16, 16384, 8, 2, 8, 2, True),\r\n\u001b[?2004l\r"]
[995.617111, "o", "\u001b[?2004h> "]
[995.617153, "o", "    (32, 8192, 8, 3, 8, 3, True),\r\n\u001b[?2004l\r"]
[995.617186, "o", "\u001b[?2004h> "]
[995.617227, "o", "    (16, 8192, 4, 6, 4, 6, True),\r\n\u001b[?2004l\r"]
[995.61726, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.617293, "o", "> "]
[995.617359, "o", "    fs, fa, fb = run(C, BLOCK, wp1, st1, wp2, st2, EV)\r\n\u001b[?2004l\r"]
[995.617392, "o", "\u001b[?2004h> "]
[995.617425, "o", "    ms, _ = bench(fs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[995.617457, "o", "> "]
[995.617491, "o", "    ma, _ = bench(fa)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.617534, "o", "    mb, mn = bench(fb)\r\n\u001b[?2004l\r"]
[995.617567, "o", "\u001b[?2004h> "]
[995.6178, "o", "    print(f\"C={C} B={BLOCK} w={wp1}/{wp2} st={st1}/{st2} EV={int(EV)}: stats {ms:.4f} apply {ma:.4f} both {mb:.4f} (min {mn:.4f})\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[995.617836, "o", "EOF\r\n\u001b[?2004l\r"]
[995.652398, "o", "\u001b[?2004hroot@modal:/# "]
