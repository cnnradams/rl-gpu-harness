[384.830829, "o", "> "]
[384.830855, "o", "        acc2 += v * v\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.830887, "o", "> "]
[384.830966, "o", "    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[384.830998, "o", "\u001b[?2004h> "]
[384.831089, "o", "    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[384.831115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[384.831141, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[384.831167, "o", "\u001b[?2004h> "]
[384.831258, "o", "def _ln_apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, eps,\r\n\u001b[?2004l\r"]
[384.831289, "o", "\u001b[?2004h> "]
[384.831385, "o", "              BLOCK: tl.constexpr, C: tl.constexpr, R: tl.constexpr):\r\n\u001b[?2004l\r"]
[384.83142, "o", "\u001b[?2004h> "]
[384.831453, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.831485, "o", "> "]
[384.83151, "o", "    row = pid // C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.831587, "o", "    idx = tl.arange(0, C)\r\n\u001b[?2004l\r"]
[384.831612, "o", "\u001b[?2004h> "]
[384.831672, "o", "    s1 = tl.load(s_ptr + row * C + idx)\r\n\u001b[?2004l\r"]
[384.831698, "o", "\u001b[?2004h> "]
[384.831771, "o", "    s2 = tl.load(s_ptr + R * C + row * C + idx)\r\n\u001b[?2004l\r"]
[384.831797, "o", "\u001b[?2004h> "]
[384.831848, "o", "    mean = tl.sum(s1, axis=0) / N\r\n\u001b[?2004l\r"]
[384.831873, "o", "\u001b[?2004h> "]
[384.831965, "o", "    var = tl.sum(s2, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[384.83199, "o", "\u001b[?2004h> "]
[384.832041, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[384.832066, "o", "\u001b[?2004h> "]
[384.832099, "o", "    c = pid % C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.832143, "o", "    n0 = c * (N // C)\r\n\u001b[?2004l\r"]
[384.832168, "o", "\u001b[?2004h> "]
[384.832227, "o", "    for off in range(0, N // C, BLOCK):\r\n\u001b[?2004l\r"]
[384.832253, "o", "\u001b[?2004h> "]
[384.832317, "o", "        i = n0 + off + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[384.83235, "o", "\u001b[?2004h> "]
[384.832403, "o", "        v = tl.load(x_ptr + row * N + i)\r\n\u001b[?2004l\r"]
[384.832434, "o", "\u001b[?2004h> "]
[384.832473, "o", "        w = tl.load(w_ptr + i)\r\n\u001b[?2004l\r"]
[384.832505, "o", "\u001b[?2004h> "]
[384.832543, "o", "        b = tl.load(b_ptr + i)\r\n\u001b[?2004l\r"]
[384.832574, "o", "\u001b[?2004h> "]
[384.832666, "o", "        tl.store(y_ptr + row * N + i, (v - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[384.832693, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[384.832719, "o", "> "]
[384.832773, "o", "def make_triton(C, BLOCK, warps, stages):\r\n\u001b[?2004l\r"]
[384.832799, "o", "\u001b[?2004h> "]
[384.832825, "o", "    def fn(x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.832851, "o", "> "]
[384.832878, "o", "        x2 = x.view(-1, N)\r\n\u001b[?2004l\r"]
[384.832905, "o", "\u001b[?2004h> "]
[384.832946, "o", "        R = x2.shape[0]\r\n\u001b[?2004l\r"]
[384.832973, "o", "\u001b[?2004h> "]
[384.833019, "o", "        y = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[384.833044, "o", "\u001b[?2004h> "]
[384.833153, "o", "        stats = torch.empty(2 * R * C, device=dev, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[384.83318, "o", "\u001b[?2004h> "]
[384.833388, "o", "        _ln_stats[(R * C,)](x2, ln.weight, ln.bias, stats, N, ln.eps, BLOCK=BLOCK, C=C, R=R, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.833423, "o", "> "]
[384.833611, "o", "        _ln_apply[(R * C,)](x2, ln.weight, ln.bias, stats, y, N, ln.eps, BLOCK=BLOCK, C=C, R=R, num_warps=warps, num_stages=stages)\r\n\u001b[?2004l\r"]
[384.833644, "o", "\u001b[?2004h> "]
[384.833678, "o", "        return y.view_as(x)\r\n\u001b[?2004l\r"]
[384.833709, "o", "\u001b[?2004h> "]
[384.833741, "o", "    return fn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[384.833767, "o", "\u001b[?2004h> "]
[384.8338, "o", "def bench(fn, iters=20):\r\n\u001b[?2004l\r"]
[384.833825, "o", "\u001b[?2004h> "]
[384.833871, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[384.833903, "o", "\u001b[?2004h> "]
[384.833944, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[384.833976, "o", "\u001b[?2004h> "]
[384.834086, "o", "    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\r\n\u001b[?2004l\r"]
[384.834112, "o", "\u001b[?2004h> "]
[384.834144, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.834187, "o", "    for _ in range(iters):\r\n\u001b[?2004l\r"]
[384.834213, "o", "\u001b[?2004h> "]
[384.83425, "o", "        scratch.fill_(42)\r\n\u001b[?2004l\r"]
[384.834281, "o", "\u001b[?2004h> "]
[384.834323, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[384.834356, "o", "\u001b[?2004h> "]
[384.834488, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[384.834522, "o", "\u001b[?2004h> "]
[384.834609, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[384.834641, "o", "\u001b[?2004h> "]
[384.834695, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[384.83472, "o", "\u001b[?2004h> "]
[384.834747, "o", "    ts.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.834773, "o", "> "]
[384.834812, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[384.834843, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.834898, "o", "med, mn = bench(lambda: ln(x))\r\n\u001b[?2004l\r"]
[384.834924, "o", "\u001b[?2004h> "]
[384.835016, "o", "print(f\"eager: med {med:.4f} ms min {mn:.4f}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.835048, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.835074, "o", "best = None\r\n\u001b[?2004l\r"]
[384.8351, "o", "\u001b[?2004h> "]
[384.835136, "o", "for C in (16, 32, 64, 128):\r\n\u001b[?2004l\r"]
[384.835163, "o", "\u001b[?2004h> "]
[384.835217, "o", "    for BLOCK in (2048, 4096, 8192):\r\n\u001b[?2004l\r"]
[384.835243, "o", "\u001b[?2004h> "]
[384.835295, "o", "        if BLOCK > N // C: continue\r\n\u001b[?2004l\r"]
[384.835326, "o", "\u001b[?2004h> "]
[384.835361, "o", "        for warps in (4, 8):\r\n\u001b[?2004l\r"]
[384.835392, "o", "\u001b[?2004h> "]
[384.835437, "o", "            for stages in (2, 4):\r\n\u001b[?2004l\r"]
[384.835468, "o", "\u001b[?2004h> "]
[384.835561, "o", "                fn = make_triton(C, BLOCK, warps, stages)\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.835593, "o", "> "]
[384.835618, "o", "                out = fn(x)\r\n\u001b[?2004l\r"]
[384.83565, "o", "\u001b[?2004h> "]
[384.835729, "o", "                err = (out - ref).abs().max().item()\r\n\u001b[?2004l\r"]
[384.835761, "o", "\u001b[?2004h> "]
[384.835814, "o", "                med, mn = bench(fn, 20)\r\n\u001b[?2004l\r"]
[384.835845, "o", "\u001b[?2004h> "]
[384.835885, "o", "                ok = err < 1e-4\r\n\u001b[?2004l\r"]
[384.835917, "o", "\u001b[?2004h> "]
[384.836149, "o", "                print(f\"C={C} BLOCK={BLOCK} w={warps} st={stages}: med {med:.4f} min {mn:.4f} err {err:.2e} {'OK' if ok else 'BAD'}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.836183, "o", "> "]
[384.836262, "o", "                if ok and (best is None or med < best[0]):\r\n\u001b[?2004l\r"]
[384.836288, "o", "\u001b[?2004h> "]
[384.836378, "o", "                    best = (med, C, BLOCK, warps, stages)\r\n\u001b[?2004l\r"]
[384.836404, "o", "\u001b[?2004h> "]
[384.836429, "o", "print('BEST', best)\r\n\u001b[?2004l\r"]
[384.836461, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
