[1202.896907, "o", "64 B=4096 w=16 st=2: 0.2715\r\napply C=64 B=4096 w=16 st=3: 0.2711\r\napply C=64 B=4096 w=16 st=4: 0.2710\r\napply C=64 B=4096 w=16 st=5: 0.2712\r\napply C=64 B=8192 w=4 st=2: 0.2493\r\napply C=64 B=8192 w=4 st=3: 0.2502\r\napply C=64 B=8192 w=4 st=4: 0.2494\r\napply C=64 B=8192 w=4 st=5: 0.2500\r\napply C=64 B=8192 w=8 st=2: 0.3204\r\napply C=64 B=8192 w=8 st=3: 0.3188\r\napply C=64 B=8192 w=8 st=4: 0.3195\r\napply C=64 B=8192 w=8 st=5: 0.3198\r\napply C=64 B=8192 w=16 st=2: 0.3821\r\napply C=64 B=8192 w=16 st=3: 0.3832\r\napply C=64 B=8192 w=16 st=4: 0.3821\r\napply C=64 B=8192 w=16 st=5: 0.3830\r\nTOP5: [(0.23734399676322937, 32, 4096, 8, 3), (0.23827199637889862, 32, 4096, 8, 2), (0.23839999735355377, 32, 4096, 8, 4), (0.23875199258327484, 32, 4096, 8, 5), (0.23980799317359924, 64, 4096, 8, 5)]\r\n"]
