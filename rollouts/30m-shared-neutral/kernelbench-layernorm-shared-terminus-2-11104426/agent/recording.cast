[1115.610945, "o", "read C=64 B=4096 w=4 st=2: 0.1115 (2.41 TB/s)\r\nread C=64 B=4096 w=4 st=3: 0.1129 (2.38 TB/s)\r\nread C=64 B=4096 w=4 st=4: 0.1123 (2.39 TB/s)\r\nread C=64 B=4096 w=8 st=2: 0.1116 (2.41 TB/s)\r\nread C=64 B=4096 w=8 st=3: 0.1120 (2.40 TB/s)\r\nread C=64 B=4096 w=8 st=4: 0.1114 (2.41 TB/s)\r\nread C=64 B=8192 w=4 st=2: 0.1153 (2.33 TB/s)\r\nread C=64 B=8192 w=4 st=3: 0.1152 (2.33 TB/s)\r\n"]
