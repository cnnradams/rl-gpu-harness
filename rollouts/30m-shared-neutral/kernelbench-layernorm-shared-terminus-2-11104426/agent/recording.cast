[1256.546381, "o", "apply C=16 B=4096 w=4 st=2: 0.3413\r\napply C=16 B=4096 w=4 st=3: 0.3414\r\napply C=16 B=4096 w=4 st=4: 0.3409\r\napply C=16 B=4096 w=4 st=5: 0.3416\r\napply C=16 B=4096 w=8 st=2: 0.2767\r\napply C=16 B=4096 w=8 st=3: 0.2760\r\napply C=16 B=4096 w=8 st=4: 0.2758\r\napply C=16 B=4096 w=8 st=5: 0.2757\r\napply C=16 B=4096 w=16 st=2: 0.2521\r\napply C=16 B=4096 w=16 st=3: 0.2522\r\napply C=16 B=4096 w=16 st=4: 0.2523\r\napply C=16 B=4096 w=16 st=5: 0.2525\r\napply C=16 B=8192 w=4 st=2: 0.3483\r\napply C=16 B=8192 w=4 st=3: 0.3480\r\napply C=16 B=8192 w=4 st=4: 0.3524\r\napply C=16 B=8192 w=4 st=5: 0.3488\r\napply C=16 B=8192 w=8 st=2: 0.3008\r\napply C=16 B=8192 w=8 st=3: 0.2994\r\napply C=16 B=8192 w=8 st=4: 0.2959\r\napply C=16 B=8192 w=8 st=5: 0.2961\r\napply C=16 B=8192 w=16 st=2: 0.3386\r\napply C=16 B=8192 w=16 st=3: 0.3382\r\napply C=16 B=8192 w=16 st=4: 0.3391\r\n"]
[1256.619005, "o", "\u001b[?2004hroot@modal:/# "]
[1324.887582, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nR = B\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nw, b = ln.weight, ln.bias\neps = ln.eps\nx2 = x.view(-1, N)\ny2 = torch.empty_like(x2)\nref = ln(x)\n\ndef bench(fn, iters=40):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\n@triton.jit\ndef _stats(x_ptr, s_ptr, N, R, BLOCK: tl.constexpr, C: tl.constexpr, EVP: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    base"]
[1324.887629, "i", " = row * N + c * (N // C)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, N // C, BLOCK):\n        if EVP:\n            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK), eviction_policy='evict_last')\n        else:\n            v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        acc += v\n        acc2 += v * v\n    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\n    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, R, eps,\n           BLOCK: tl.constexpr, C: tl.constexpr, REV: tl.constexpr, CM: tl.constexpr):\n    pid = tl.program_id(0)\n    c = pid % C\n    if REV:\n        row = R - 1 - pid // C\n    else:\n        row = pid // C\n    idx = tl.arange(0, C)\n    s1 = tl.load(s_ptr + row * C + idx)\n    s2 = tl.load(s_ptr + R * C + row * C + idx)\n    mean = tl.sum(s1, axis=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base"]
[1324.88764, "i", " = row * N + c * (N // C)\n    off0 = c * (N // C)\n    for off in range(0, N // C, BLOCK):\n        j = off0 + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + base + off + tl.arange(0, BLOCK))\n        wv = tl.load(w_ptr + j)\n        bv = tl.load(b_ptr + j)\n        out = (v - mean) * rstd * wv + bv\n        if CM == 1:\n            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out, cache_modifier='.cs')\n        else:\n            tl.store(y_ptr + base + off + tl.arange(0, BLOCK), out)\n\ndef fwd(Cs, Bs, wps, sts, evp, Ca, Ba, wpa, sta, rev, cm):\n    def f():\n        stats = torch.empty(2 * R * Cs, device=dev, dtype=torch.float32)\n        _stats[(R * Cs,)](x2, stats, N, R, BLOCK=Bs, C=Cs, EVP=evp, num_warps=wps, num_stages=sts)\n        _apply[(R * Ca,)](x2, w, b, stats, y2, N, R, eps, BLOCK=Ba, C=Ca, REV=rev, CM=cm, num_warps=wpa, num_stages=sta)\n    return f\n\ncfgs = [\n    dict(Cs=16, Bs=8192, wps=4, sts=4, evp=False, Ca=16, Ba=8192, wpa=4, sta=4, rev=False, cm=0),  # current best\n    dict(Cs=16, Bs=8192, w"]
[1324.887812, "i", "ps=8, sts=3, evp=False, Ca=32, Ba=4096, wpa=8, sta=3, rev=False, cm=0),\n    dict(Cs=32, Bs=8192, wps=8, sts=3, evp=False, Ca=32, Ba=4096, wpa=8, sta=3, rev=False, cm=0),\n    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=True,  Ca=16, Ba=8192, wpa=4, sta=4, rev=True,  cm=0),\n    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=True,  Ca=32, Ba=4096, wpa=8, sta=3, rev=True,  cm=0),\n    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=True,  Ca=32, Ba=4096, wpa=8, sta=3, rev=True,  cm=1),\n    dict(Cs=32, Bs=8192, wps=8, sts=3, evp=True,  Ca=32, Ba=4096, wpa=8, sta=3, rev=True,  cm=0),\n    dict(Cs=16, Bs=8192, wps=8, sts=3, evp=False, Ca=32, Ba=4096, wpa=8, sta=3, rev=False, cm=1),\n]\nfor cfg in cfgs:\n    f = fwd(**cfg)\n    f()\n    err = (y2 - ref.view(-1, N)).abs().max().item()\n    t = bench(f)\n    print(f\"{cfg}: t={t:.4f} err={err:.2e}\", flush=True)\nEOF\n"]
