[1399.355326, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nR = B\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nw, b = ln.weight, ln.bias\neps = ln.eps\nx2 = x.view(-1, N)\ny2 = torch.empty_like(x2)\nref = ln(x).view(-1, N)\n\n@triton.jit\ndef _fused(x_ptr, w_ptr, b_ptr, y_ptr, acc_ptr, cnt_ptr, N, R, G, eps,\n           BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    npr = tl.num_programs(0)\n    ar = tl.arange(0, BLOCK)\n    for r in range(R):\n        i = r * N + pid * BLOCK + ar\n        j = pid * BLOCK + ar\n        v = tl.load(x_ptr + i)\n        wv = tl.load(w_ptr + j)\n        bv = tl.load(b_ptr + j)\n        s1 = tl.sum(v, axis=0)\n        s2 = tl.sum(v * v, axis=0)\n        tl.atomic_add(acc_ptr + r, s1)\n        tl.atomic_add(acc_ptr + r + R, s2)\n        # grid sync for this row\n        tl.debug_barrier()\n        if pid == 0:\n            tl.atomic_add(cnt_"]
[1399.355372, "i", "ptr + r, 1)\n            while tl.atomic_add(cnt_ptr + r, 0) < npr:\n                pass\n        tl.debug_barrier()\n        mean = tl.load(acc_ptr + r) / N\n        var = tl.load(acc_ptr + r + R) / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.store(y_ptr + i, (v - mean) * rstd * wv + bv)\n\nprint('placeholder - need sync rethink')\nEOF\necho written\n"]
