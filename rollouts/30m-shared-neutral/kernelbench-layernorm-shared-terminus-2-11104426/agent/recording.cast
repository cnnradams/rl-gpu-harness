[229.891889, "o", "\u001b[?2004hroot@modal:/# "]
[384.829031, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(0)\ndev = 'cuda'\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nref = ln(x)\n\n@triton.jit\ndef _ln_stats(x_ptr, w_ptr, b_ptr, s_ptr, N, eps,\n              BLOCK: tl.constexpr, C: tl.constexpr, R: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // C\n    c = pid % C\n    n0 = c * (N // C)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for off in range(0, N // C, BLOCK):\n        v = tl.load(x_ptr + row * N + n0 + off + tl.arange(0, BLOCK))\n        acc += v\n        acc2 += v * v\n    tl.store(s_ptr + row * C + c, tl.sum(acc, axis=0))\n    tl.store(s_ptr + R * C + row * C + c, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _ln_apply(x_ptr, w_ptr, b_ptr, s_ptr, y_ptr, N, eps,\n              BLOCK: tl.constexpr, C: tl.constexpr, R: tl.constexpr):\n    pid = tl.program_id(0)\n   "]
[384.829207, "i", " row = pid // C\n    idx = tl.arange(0, C)\n    s1 = tl.load(s_ptr + row * C + idx)\n    s2 = tl.load(s_ptr + R * C + row * C + idx)\n    mean = tl.sum(s1, axis=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    c = pid % C\n    n0 = c * (N // C)\n    for off in range(0, N // C, BLOCK):\n        i = n0 + off + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + row * N + i)\n        w = tl.load(w_ptr + i)\n        b = tl.load(b_ptr + i)\n        tl.store(y_ptr + row * N + i, (v - mean) * rstd * w + b)\n\ndef make_triton(C, BLOCK, warps, stages):\n    def fn(x):\n        x2 = x.view(-1, N)\n        R = x2.shape[0]\n        y = torch.empty_like(x2)\n        stats = torch.empty(2 * R * C, device=dev, dtype=torch.float32)\n        _ln_stats[(R * C,)](x2, ln.weight, ln.bias, stats, N, ln.eps, BLOCK=BLOCK, C=C, R=R, num_warps=warps, num_stages=stages)\n        _ln_apply[(R * C,)](x2, ln.weight, ln.bias, stats, y, N, ln.eps, BLOCK=BLOCK, C=C, R=R, num_warps=warps, num_stages=stages)\n        retur"]
[384.829241, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[384.829271, "i", "n y.view_as(x)\n    return fn\n\ndef bench(fn, iters=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2], ts[0]\n\nmed, mn = bench(lambda: ln(x))\nprint(f\"eager: med {med:.4f} ms min {mn:.4f}\", flush=True)\n\nbest = None\nfor C in (16, 32, 64, 128):\n    for BLOCK in (2048, 4096, 8192):\n        if BLOCK > N // C: continue\n        for warps in (4, 8):\n            for stages in (2, 4):\n                fn = make_triton(C, BLOCK, warps, stages)\n                out = fn(x)\n                err = (out - ref).abs().max().item()\n                med, mn = bench(fn, 20)\n                ok = err < 1e-4\n                print(f\""]
[384.829299, "i", "C={C} BLOCK={BLOCK} w={warps} st={stages}: med {med:.4f} min {mn:.4f} err {err:.2e} {'OK' if ok else 'BAD'}\", flush=True)\n                if ok and (best is None or med < best[0]):\n                    best = (med, C, BLOCK, warps, stages)\nprint('BEST', best)\nEOF\n"]
[384.82932, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.829345, "o", "> "]
[384.829379, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h"]
[384.829405, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
