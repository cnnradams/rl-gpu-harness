[1408.234286, "i", "cat > /workspace/bench7b.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ndev = 'cuda'\ntorch.manual_seed(0)\nB, F, D1, D2 = 16, 64, 256, 256\nN = F * D1 * D2\nR = B\nx = torch.rand(B, F, D1, D2, device=dev)\nln = nn.LayerNorm((F, D1, D2)).to(dev)\nw, b = ln.weight, ln.bias\neps = ln.eps\nx2 = x.view(-1, N)\ny2 = torch.empty_like(x2)\nref = ln(x).view(-1, N)\n\n@triton.jit\ndef _fused(x_ptr, w_ptr, b_ptr, y_ptr, acc_ptr, cnt_ptr, N, R, eps,\n           BLOCK: tl.constexpr, G: tl.constexpr):\n    pid = tl.program_id(0)\n    ar = tl.arange(0, BLOCK)\n    for r in range(R):\n        i = r * N + pid * BLOCK + ar\n        j = pid * BLOCK + ar\n        v = tl.load(x_ptr + i)\n        wv = tl.load(w_ptr + j)\n        bv = tl.load(b_ptr + j)\n        s1 = tl.sum(v, axis=0)\n        s2 = tl.sum(v * v, axis=0)\n        tl.atomic_add(acc_ptr + r, s1)\n        tl.atomic_add(acc_ptr + r + R, s2)\n        prev = tl.atomic_add(cnt_ptr + r, 1)\n        target = (r + 1) * G\n        while tl.atomic_add(cnt_ptr + r, 0) < targe"]
[1408.234332, "i", "t:\n            pass\n        mean = tl.load(acc_ptr + r) / N\n        var = tl.load(acc_ptr + r + R) / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        tl.store(y_ptr + i, (v - mean) * rstd * wv + bv)\n\ndef bench(fn, iters=40):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    scratch = torch.empty(32, 1024, 1024, dtype=torch.int64, device=dev)\n    ts = []\n    for _ in range(iters):\n        scratch.fill_(42)\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts.sort()\n    return ts[len(ts)//2]\n\nimport sys\nG = int(sys.argv[1]); BLOCK = int(sys.argv[2]); WP = int(sys.argv[3])\nassert G * BLOCK == N\nacc = torch.zeros(2 * R, device=dev, dtype=torch.float32)\ncnt = torch.zeros(R, device=dev, dtype=torch.int32)\n\ndef f():\n    acc.zero_(); cnt.zero_()\n    _fused[(G,)](x2, w, b, y2, acc, cnt, N, R, eps, BLOCK=BLOCK, G=G, nu"]
[1408.234474, "i", "m_warps=WP)\n\nf()\ntorch.cuda.synchronize()\nerr = (y2 - ref).abs().max().item()\nt = bench(f)\nprint(f\"G={G} BLOCK={BLOCK} w={WP}: t={t:.4f} err={err:.2e}\", flush=True)\nEOF\ngpu sync && gpu refresh sb-usjK6lfioOeY9u4RfkEZ8F\n"]
