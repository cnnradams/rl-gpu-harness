[815.12399, "o", "request ID: a46f0501556340db8670aafc127d7580\r\ncommand: 38cff721e3304400be59bf7288b11332\r\nno_wb BLOCK=4096 warps=4: 183.9 us\r\nno_wb BLOCK=4096 warps=8: 183.8 us\r\nno_wb BLOCK=8192 warps=4: 183.5 us\r\nno_wb BLOCK=8192 warps=8: 183.9 us\r\nwb BLOCK=4096 warps=4: 194.8 us\r\nwb BLOCK=4096 warps=8: 193.8 us\r\nwb BLOCK=8192 warps=4: 194.4 us\r\nwb BLOCK=8192 warps=8: 196.1 us\r\nss BLOCK=4096 warps=4: 193.9 us\r\nss BLOCK=4096 warps=8: 195.8 us\r\nss BLOCK=8192 warps=4: 194.2 us\r\nss BLOCK=8192 warps=8: 197.0 us\r\nflat BLOCK=4096 warps=4: 345.7 us\r\nflat BLOCK=4096 warps=8: 344.3 us\r\nflat BLOCK=8192 warps=4: 345.2 us\r\nflat BLOCK=8192 warps=8: 346.5 us\r\n"]
