[1265.032269, "o", "request ID: 4bd1e9cbc50246febc59bc1d6f77172e\r\ncommand: 31494670aa3f48cea95c299d431004ad\r\nscm=0 xev=0: 290.5 us\r\nscm=0 xev=1: 298.0 us\r\nscm=1 xev=0: 291.8 us\r\nscm=1 xev=1: 298.8 us\r\nscm=2 xev=0: 290.5 us\r\nscm=2 xev=1: 298.0 us\r\nscm=3 xev=0: 290.6 us\r\nscm=3 xev=1: 297.9 us\r\nstats BLOCK=4096 nw=8: 293.6 us\r\nstats BLOCK=8192 nw=8: 290.7 us\r\nstats BLOCK=8192 nw=16: 290.5 us\r\nstats BLOCK=16384 nw=16: 290.4 us\r\nstats BLOCK=16384 nw=32: 290.4 us\r\nstats BLOCK=32768 nw=32: 290.6 us\r\napply BLOCK=2048 nw=4: 292.0 us\r\napply BLOCK=4096 nw=4: 292.1 us\r\napply BLOCK=4096 nw=8: 290.5 us\r\napply BLOCK=8192 nw=8: 292.4 us\r\n"]
