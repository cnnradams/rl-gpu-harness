[1247.970987, "o", "\u001b[?2004h"]
[1247.971025, "o", "> "]
[1247.971062, "o", "    for _ in range(10): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1247.971137, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1247.971175, "o", "\u001b[?2004h> "]
[1247.9713, "o", "    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\r\n\u001b[?2004l\r"]
[1247.971338, "o", "\u001b[?2004h> "]
[1247.971376, "o", "    s.record()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1247.971414, "o", "> "]
