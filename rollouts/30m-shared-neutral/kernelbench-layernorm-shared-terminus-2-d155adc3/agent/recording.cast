[1014.621238, "i", "cat > /tmp/tune3.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nR, D = 16, 64*256*256\nx = torch.rand(R, D, device='cuda')\nw = torch.rand(D, device='cuda')\nb = torch.rand(D, device='cuda')\neps = 1e-5\nout = torch.empty_like(x)\nms = torch.zeros(R, dtype=torch.float64, device='cuda')\nvs = torch.zeros(R, dtype=torch.float64, device='cuda')\n\ndef bench(fn, iters=100):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n@triton.jit\ndef _stats_g(x_ptr, ms_ptr, vs_ptr, D, r0, G, BLOCK: tl.constexpr):\n    row = r0 + tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, eviction_policy='evict_last')\n    s = tl.sum(xx)\n    s2 = tl.sum(xx * xx)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + r"]
[1014.621284, "i", "ow, s2.to(tl.float64))\n\n@triton.jit\ndef _apply_g(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, r0, eps, BLOCK: tl.constexpr):\n    row = r0 + tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, eviction_policy='evict_first')\n    ww = tl.load(w_ptr + offs, eviction_policy='evict_last')\n    bb = tl.load(b_ptr + offs, eviction_policy='evict_last')\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, (xx - mean) * rstd * ww + bb, eviction_policy='evict_first')\n\ndef run_grouped(G, BLOCK, nws, nwa):\n    S = D // BLOCK\n    def f():\n        ms.zero_(); vs.zero_()\n        for r0 in range(0, R, G):\n            _stats_g[(G, S)](x, ms, vs, D, r0, G, BLOCK=BLOCK, num_warps=nws)\n        for r0 in range(0, R, G):\n            _apply_g[(G, S)](x, out, w, b, "]
[1014.621297, "i", "ms, vs, D, r0, eps, BLOCK=BLOCK, num_warps=nwa)\n    return f\n\n# interleaved: stats_g then apply_g (needs per-group zero of ms/vs instead of global zero)\n@triton.jit\ndef _stats_gz(x_ptr, ms_ptr, vs_ptr, D, r0, BLOCK: tl.constexpr):\n    row = r0 + tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, eviction_policy='evict_last')\n    s = tl.sum(xx)\n    s2 = tl.sum(xx * xx)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\ndef run_interleaved(G, BLOCK, nws, nwa):\n    S = D // BLOCK\n    def f():\n        ms.zero_(); vs.zero_()\n        for r0 in range(0, R, G):\n            _stats_gz[(G, S)](x, ms, vs, D, r0, BLOCK=BLOCK, num_warps=nws)\n            _apply_g[(G, S)](x, out, w, b, ms, vs, D, r0, eps, BLOCK=BLOCK, num_warps=nwa)\n    return f\n\n# baseline: all stats then all apply (2 kernels), with eviction hints\n@triton.jit\ndef _stats_all(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):"]
[1014.621306, "i", "\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs)\n    s = tl.sum(xx)\n    s2 = tl.sum(xx * xx)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\n@triton.jit\ndef _apply_all(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, (xx - mean) * rstd * ww + bb)\n\ndef run_all(BLOCKS, nws, BLOCKA, nwa):\n    S1 = D // BLOCKS\n    S2 = D // BLOCKA\n    def f():\n        ms.zero_(); vs.zero_()\n        _stats_all[(R"]
[1014.621408, "i", ", S1)](x, ms, vs, D, BLOCK=BLOCKS, num_warps=nws)\n        _apply_all[(R, S2)](x, out, w, b, ms, vs, D, eps, BLOCK=BLOCKA, num_warps=nwa)\n    return f\n\nprint('baseline 2-kernel:', bench(run_all(8192, 16, 4096, 8))*1000, 'us')\nfor G in [1, 2, 4]:\n    t = bench(run_grouped(G, 8192, 16, 8192, 8))\n    print(f'grouped G={G}: {t*1000:.1f} us')\nfor G in [1, 2, 4]:\n    t = bench(run_interleaved(G, 8192, 16, 8192, 8))\n    print(f'interleaved G={G}: {t*1000:.1f} us')\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/tune3.py /tmp/tune3.py\n"]
