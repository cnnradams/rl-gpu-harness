[918.841812, "i", "cat > /tmp/sol_graph.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _stats_kernel(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0)\n    s = tl.sum(x)\n    s2 = tl.sum(x * x)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\n\n@triton.jit\ndef _apply_kernel(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, S, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = S - 1 - tl.program_id(1)  # reverse order for L2 reuse\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    var = ex2 - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    x = tl.load(x_ptr + row.to(tl.int6"]
[918.841856, "i", "4) * D + offs, mask=mask)\n    w = tl.load(w_ptr + offs, mask=mask, other=0.0)\n    b = tl.load(b_ptr + offs, mask=mask, other=0.0)\n    y = (x - mean) * rstd * w + b\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, y, mask=mask)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\n        self._graphs = {}\n        self._bufs = {}\n\n    def _get_bufs(self, R, D, device):\n        key = (R, D, device)\n        if key not in self._bufs:\n            self._bufs[key] = (\n                torch.zeros(R, dtype=torch.float64, device=device),\n                torch.zeros(R, dtype=torch.float64, device=device),\n                torch.empty(R * D, dtype=torch.float32, device=device),\n            )\n        return self._bufs[key]\n\n    def _launch(self, x2, out, w, b, ms, vs, R, D, S, eps, BLOCK):\n        grid = (R, S)\n        ms.zero_(); vs.zero_()\n   "]
[918.84188, "i", "     _stats_kernel[grid](x2, ms, vs, D, BLOCK=BLOCK, num_warps=16)\n        _apply_kernel[grid](x2, out, w, b, ms, vs, D, S, eps, BLOCK=BLOCK, num_warps=8)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        D = 1\n        for s in self.normalized_shape:\n            D *= s\n        R = x.numel() // D\n        BLOCK = 8192\n        S = triton.cdiv(D, BLOCK)\n        eps = self.ln.eps\n        w = self.ln.weight.view(-1)\n        b = self.ln.bias.view(-1)\n        ms, vs, outflat = self._get_bufs(R, D, x.device)\n        x2 = x.view(R * D)\n        key = (x.data_ptr(), x.shape, R, D)\n        g = self._graphs.get(key)\n        if g is None:\n            # eager once to warm/compile, then capture\n            self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)\n            torch.cuda.synchronize()\n            try:\n                gr = torch.cuda.CUDAGraph()\n                with torch.cuda.graph(gr):\n                    self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)\n                self._graph"]
[918.841892, "i", "s[key] = (gr, outflat)\n                gr.replay()\n            except Exception:\n                self._graphs[key] = (None, outflat)\n                self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)\n        else:\n            gr, _ = g\n            if gr is not None:\n                gr.replay()\n            else:\n                self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)\n        return outflat.view(x.shape)\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/sol_graph.py /tmp/sol_graph.py\n"]
