[936.360795, "o", "trial 0: max_diff=2.861e-06 pass=True\r\ntrial 1: max_diff=3.576e-06 pass=True\r\ntrial 2: max_diff=3.457e-06 pass=True\r\ntrial 3: max_diff=2.980e-06 pass=True\r\ntrial 4: max_diff=2.861e-06 pass=True\r\nCORRECT\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: cuda:0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\nTrial 1: 0.291 ms\r\nTrial 2: 0.291 ms\r\nTrial 3: 0.291 ms\r\nTrial 4: 0.291 ms\r\nTrial 5: 0.291 ms\r\nTrial 6: 0.292 ms\r\nTrial 7: 0.292 ms\r\nTrial 8: 0.291 ms\r\nTrial 9: 0.291 ms\r\nTrial 10: 0.291 ms\r\nTrial 11: 0.291 ms\r\nTrial 12: 0.289 ms\r\nTrial 13: 0.289 ms\r\nTrial 14: 0.29 ms\r\nTrial 15: 0.291 ms\r\nTrial 16: 0.291 ms\r\nTrial 17: 0.292 ms\r\nTrial 18: 0.291 ms\r\nTrial 19: 0.291 ms\r\nTrial 20: 0.291 ms\r\nSTATS {'mean': 0.291, 'std': 0.000793, 'min': 0.289, 'max': 0.292, 'num_trials': 20, 'hardware': 'NVIDIA H100 80GB HBM3', 'device': 'cuda:0'}\r\n"]
