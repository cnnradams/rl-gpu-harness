[463.088288, "i", "cat > /tmp/dbg.py << 'EOF'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef _stats_kernel(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0).to(tl.float32)\n    s = tl.sum(x)\n    s2 = tl.sum(x * x)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\ntorch.manual_seed(0)\nR, D = 16, 64*256*256\nx = torch.rand(R, D, device='cuda')\nms = torch.zeros(R, dtype=torch.float64, device='cuda')\nvs = torch.zeros(R, dtype=torch.float64, device='cuda')\nBLOCK = 16384\ngrid = (R, triton.cdiv(D, BLOCK))\n_stats_kernel[grid](x, ms, vs, D, BLOCK=BLOCK)\ntorch.cuda.synchronize()\nmean_t = x.double().mean(1)\nvar_t = x.double().var(1, unbiased=False)\nmean_k = ms / D\nvar_k = vs / D - mean_k**2\nprint('mean diff', (mean_t - mean_k).abs().max().item())\nprint('var diff', (var_t - var_k).abs().max()"]
[463.088336, "i", ".item())\nprint('var min', var_k.min().item())\nprint('ms', ms[:4])\nprint('vs sample', (vs/D)[:4])\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/dbg.py /tmp/dbg.py\n"]
