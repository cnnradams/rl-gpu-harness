[796.419065, "o", "\u001b[?2004h> "]
[796.419119, "o", "        grid = (R * S,)\r\n\u001b[?2004l\r"]
[796.419138, "o", "\u001b[?2004h> "]
[796.419375, "o", "        f = lambda: _apply_flat[grid](x, out, w, b, ms, vs, D, S, eps, BLOCK=BLOCK, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
