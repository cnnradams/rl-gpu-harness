[639.903695, "o", "request ID: 5c4af662d09e44bda22e64f8d50bca22\r\ncommand: 519b6dff3d5f42449988caf6d0a21898\r\n--- stats kernel (fp64 atomics) ---\r\nBLOCK=2048 warps=4: 117.0 us\r\nBLOCK=2048 warps=8: 116.6 us\r\nBLOCK=2048 warps=16: 151.2 us\r\nBLOCK=2048 warps=32: 321.7 us\r\nBLOCK=4096 warps=4: 97.3 us\r\nBLOCK=4096 warps=8: 97.4 us\r\nBLOCK=4096 warps=16: 108.1 us\r\nBLOCK=4096 warps=32: 172.8 us\r\nBLOCK=8192 warps=4: 93.8 us\r\nBLOCK=8192 warps=8: 93.1 us\r\nBLOCK=8192 warps=16: 92.9 us\r\nBLOCK=8192 warps=32: 106.1 us\r\nBLOCK=16384 warps=4: 93.9 us\r\nBLOCK=16384 warps=8: 93.9 us\r\nBLOCK=16384 warps=16: 92.9 us\r\nBLOCK=16384 warps=32: 92.7 us\r\nBLOCK=32768 warps=4: 94.7 us\r\nBLOCK=32768 warps=8: 93.9 us\r\nBLOCK=32768 warps=16: 93.0 us\r\nBLOCK=32768 warps=32: 92.6 us\r\n--- stats kernel (fp32 atomics) ---\r\nBLOCK=4096 warps=8: 98.0 us\r\nBLOCK=4096 warps=16: 107.1 us\r\nBLOCK=4096 warps=32: 172.6 us\r\nBLOCK=8192 warps=8: 93.0 us\r\nBLOCK=8192 warps=16: 92.9 us\r\nBLOCK=8192 warps=32: 106.2 us\r\nBLOCK=16384 warps=8: 93.8 us\r\nBLOCK=16384 warps=16: 92.8 us\r\nBLOCK=16384 wa"]
