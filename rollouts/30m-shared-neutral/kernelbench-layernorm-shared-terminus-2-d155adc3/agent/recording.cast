[619.540031, "i", "cat > /tmp/tune1.py << 'EOF'\nimport torch, triton, triton.language as tl, itertools, time\n\ntorch.manual_seed(0)\nR, D = 16, 64*256*256\nx = torch.rand(R, D, device='cuda')\nw = torch.rand(D, device='cuda')\nb = torch.rand(D, device='cuda')\neps = 1e-5\n\n@triton.jit\ndef _stats(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0)\n    s = tl.sum(xx)\n    s2 = tl.sum(xx * xx)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\n@triton.jit\ndef _stats32(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0)\n    s = tl.sum(xx)\n    s2 = tl.sum(xx * xx)\n    tl.atomic_add(ms_ptr + row, s)\n    tl.atomic_add(vs_ptr "]
[619.540078, "i", "+ row, s2)\n\n@triton.jit\ndef _apply(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    var = ex2 - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask)\n    ww = tl.load(w_ptr + offs, mask=mask, other=0.0)\n    bb = tl.load(b_ptr + offs, mask=mask, other=0.0)\n    y = (xx - mean) * rstd * ww + bb\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, y, mask=mask)\n\nout = torch.empty_like(x)\n\ndef bench(fn, iters=200):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nprint('--- stats kernel (fp6"]
[619.540228, "i", "4 atomics) ---')\nfor BLOCK in [2048, 4096, 8192, 16384, 32768]:\n    for nw in [4, 8, 16, 32]:\n        ms = torch.zeros(R, dtype=torch.float64, device='cuda')\n        vs = torch.zeros(R, dtype=torch.float64, device='cuda')\n        grid = (R, triton.cdiv(D, BLOCK))\n        def f():\n            ms.zero_(); vs.zero_()\n            _stats[grid](x, ms, vs, D, BLOCK=BLOCK, num_warps=nw)\n        t = bench(f)\n        print(f'BLOCK={BLOCK} warps={nw}: {t*1000:.1f} us')\n\nprint('--- stats kernel (fp32 atomics) ---')\nfor BLOCK in [4096, 8192, 16384]:\n    for nw in [8, 16, 32]:\n        ms = torch.zeros(R, dtype=torch.float32, device='cuda')\n        vs = torch.zeros(R, dtype=torch.float32, device='cuda')\n        grid = (R, triton.cdiv(D, BLOCK))\n        def f():\n            ms.zero_(); vs.zero_()\n            _stats32[grid](x, ms, vs, D, BLOCK=BLOCK, num_warps=nw)\n        t = bench(f)\n        print(f'BLOCK={BLOCK} warps={nw}: {t*1000:.1f} us')\n\nprint('--- apply kernel ---')\nms = torch.full((R,), 0.5, dtype=torch.float64, devi"]
[619.540245, "o", "cat > /tmp/tune1.py << 'EOF'\r\n\u001b[?2004l\r"]
[619.54026, "i", "ce='cuda')\nvs = torch.full((R,), 0.3333, dtype=torch.float64, device='cuda')\nfor BLOCK in [2048, 4096, 8192, 16384]:\n    for nw in [4, 8, 16, 32]:\n        grid = (R, triton.cdiv(D, BLOCK))\n        def f():\n            _apply[grid](x, out, w, b, ms, vs, D, eps, BLOCK=BLOCK, num_warps=nw)\n        t = bench(f)\n        print(f'BLOCK={BLOCK} warps={nw}: {t*1000:.1f} us')\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/tune1.py /tmp/tune1.py\n"]
