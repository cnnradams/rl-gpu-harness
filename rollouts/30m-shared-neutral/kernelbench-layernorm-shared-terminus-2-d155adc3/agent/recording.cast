[478.010219, "o", "mean diff 5.637247668666134e-09\r\nvar diff 5.928288887568911e-09\r\nvar min 0.08322031267435437\r\nms tensor([2097731.8301, 2097459.6538, 2096713.9492, 2096990.6123],\r\n       device='cuda:0', dtype=torch.float64)\r\nvs sample tensor([0.3334, 0.3335, 0.3332, 0.3333], device='cuda:0', dtype=torch.float64)\r\n"]
