[796.407327, "i", "cat > /tmp/tune2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nR, D = 16, 64*256*256\nx = torch.rand(R, D, device='cuda')\nw = torch.rand(D, device='cuda')\nb = torch.rand(D, device='cuda')\neps = 1e-5\nout = torch.empty_like(x)\nms = torch.full((R,), 0.5, dtype=torch.float64, device='cuda')\nvs = torch.full((R,), 0.3333, dtype=torch.float64, device='cuda')\n\ndef bench(fn, iters=200):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n@triton.jit\ndef _apply_nowb(x_ptr, out_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 "]
[796.407371, "i", "- mean * mean + eps)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask)\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, (xx - mean) * rstd, mask=mask)\n\n@triton.jit\ndef _apply_wb(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask)\n    ww = tl.load(w_ptr + offs, mask=mask, other=0.0)\n    bb = tl.load(b_ptr + offs, mask=mask, other=0.0)\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, (xx - mean) * rstd * ww + bb, mask=mask)\n\n@triton.jit\ndef _apply_ss(x_ptr, out_ptr, s_ptr, sh_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange"]
[796.407387, "i", "(0, BLOCK)\n    mask = offs < D\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask)\n    sc = tl.load(s_ptr + offs, mask=mask, other=0.0)\n    sh = tl.load(sh_ptr + offs, mask=mask, other=0.0)\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, xx * (sc * rstd) + (sh - mean * rstd * sc) , mask=mask)\n\nfor name, kern, args in [\n    ('no_wb', _apply_nowb, (x, out, ms, vs, D, eps)),\n    ('wb', _apply_wb, (x, out, w, b, ms, vs, D, eps)),\n    ('ss', _apply_ss, (x, out, w, b, ms, vs, D, eps)),\n]:\n    for BLOCK in [4096, 8192]:\n        for nw in [4, 8]:\n            grid = (R, triton.cdiv(D, BLOCK))\n            f = lambda: kern[grid](*args, BLOCK=BLOCK, num_warps=nw)\n            t = bench(f)\n            print(f'{name} BLOCK={BLOCK} warps={nw}: {t*1000:.1f} us')\n\n# 1D flat variant treating (row,chunk) as single grid dim\n@triton"]
[796.407541, "i", ".jit\ndef _apply_flat(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, S, eps, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // S\n    i = pid % S\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\n    base = row.to(tl.int64) * D\n    xx = tl.load(x_ptr + base + offs)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    tl.store(out_ptr + base + offs, (xx - mean) * rstd * ww + bb)\n\nfor BLOCK in [4096, 8192]:\n    for nw in [4, 8]:\n        S = D // BLOCK\n        grid = (R * S,)\n        f = lambda: _apply_flat[grid](x, out, w, b, ms, vs, D, S, eps, BLOCK=BLOCK, num_warps=nw)\n        t = bench(f)\n        print(f'flat BLOCK={BLOCK} warps={nw}: {t*1000:.1f} us')\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/tune2.py /tmp/tune2.py\n"]
