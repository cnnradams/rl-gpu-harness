[1014.628896, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1014.628917, "o", "> "]
[1014.629135, "o", "# interleaved: stats_g then apply_g (needs per-group zero of ms/vs instead of global zero)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1014.629163, "o", "> "]
[1014.629185, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1014.629205, "o", "\u001b[?2004h> "]
[1014.629363, "o", "def _stats_gz(x_ptr, ms_ptr, vs_ptr, D, r0, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1014.62939, "o", "\u001b[?2004h> "]
[1014.629464, "o", "    row = r0 + tl.program_id(0)\r\n\u001b[?2004l\r"]
[1014.629491, "o", "\u001b[?2004h> "]
[1014.629551, "o", "    i = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1014.62958, "o", "\u001b[?2004h> "]
[1014.629676, "o", "    offs = i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1014.6297, "o", "\u001b[?2004h> "]
[1014.629901, "o", "    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[1014.629925, "o", "\u001b[?2004h> "]
[1014.629973, "o", "    s = tl.sum(xx)\r\n\u001b[?2004l\r"]
[1014.630002, "o", "\u001b[?2004h> "]
[1014.630062, "o", "    s2 = tl.sum(xx * xx)\r\n\u001b[?2004l\r"]
[1014.630083, "o", "\u001b[?2004h> "]
[1014.630203, "o", "    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\r\n\u001b[?2004l\r"]
[1014.630225, "o", "\u001b[?2004h> "]
[1014.630347, "o", "    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\r\n\u001b[?2004l\r"]
[1014.630377, "o", "\u001b[?2004h> \r\n"]
[1014.630407, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1014.630506, "o", "def run_interleaved(G, BLOCK, nws, nwa):\r\n\u001b[?2004l\r"]
[1014.630527, "o", "\u001b[?2004h> "]
[1014.630579, "o", "    S = D // BLOCK\r\n\u001b[?2004l\r"]
[1014.630599, "o", "\u001b[?2004h> "]
[1014.630639, "o", "    def f():\r\n\u001b[?2004l\r"]
[1014.630659, "o", "\u001b[?2004h> "]
[1014.630745, "o", "        ms.zero_(); vs.zero_()\r\n\u001b[?2004l\r"]
[1014.630766, "o", "\u001b[?2004h> "]
[1014.630852, "o", "        for r0 in range(0, R, G):\r\n\u001b[?2004l\r"]
[1014.63087, "o", "\u001b[?2004h> "]
[1014.631057, "o", "            _stats_gz[(G, S)](x, ms, vs, D, r0, BLOCK=BLOCK, num_warps=nws)\r\n\u001b[?2004l\r"]
[1014.631078, "o", "\u001b[?2004h> "]
[1014.631286, "o", "            _apply_g[(G, S)](x, out, w, b, ms, vs, D, r0, eps, BLOCK=BLOCK, num_warps=nwa)\r\n\u001b[?2004l\r"]
[1014.631316, "o", "\u001b[?2004h> "]
[1014.631346, "o", "    return f\r\n\u001b[?2004l\r"]
[1014.631372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1014.631393, "o", "\u001b[?2004h> "]
[1014.631567, "o", "# baseline: all stats then all apply (2 kernels), with eviction hints\r\n\u001b[?2004l\r"]
[1014.631598, "o", "\u001b[?2004h> "]
[1014.631627, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1014.631657, "o", "\u001b[?2004h> "]
[1014.631805, "o", "def _stats_all(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1014.631835, "o", "\u001b[?2004h> "]
[1014.631895, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1014.631926, "o", "\u001b[?2004h> "]
[1014.631983, "o", "    i = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1014.632003, "o", "\u001b[?2004h> "]
[1014.63211, "o", "    offs = i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1014.632133, "o", "\u001b[?2004h> "]
[1014.632262, "o", "    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs)\r\n\u001b[?2004l\r"]
[1014.632283, "o", "\u001b[?2004h> "]
[1014.632336, "o", "    s = tl.sum(xx)\r\n\u001b[?2004l\r"]
[1014.632356, "o", "\u001b[?2004h> "]
[1014.632423, "o", "    s2 = tl.sum(xx * xx)\r\n\u001b[?2004l\r"]
[1014.632443, "o", "\u001b[?2004h> "]
[1014.632565, "o", "    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\r\n\u001b[?2004l\r"]
[1014.632596, "o", "\u001b[?2004h> "]
[1014.632716, "o", "    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\r\n\u001b[?2004l\r"]
[1014.632738, "o", "\u001b[?2004h> \r\n"]
[1014.632763, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1014.632804, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1014.632824, "o", "\u001b[?2004h> "]
[1014.63305, "o", "def _apply_all(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[1014.633074, "o", "\u001b[?2004h> "]
[1014.63314, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1014.633161, "o", "\u001b[?2004h> "]
[1014.633225, "o", "    i = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1014.633251, "o", "\u001b[?2004h> "]
[1014.633358, "o", "    offs = i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1014.633379, "o", "\u001b[?2004h"]
[1014.633409, "o", "> "]
[1014.633443, "o", "    inv_d = 1.0 / D\r\n\u001b[?2004l\r"]
[1014.633473, "o", "\u001b[?2004h> "]
[1014.633604, "o", "    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\r\n\u001b[?2004l\r"]
[1014.633635, "o", "\u001b[?2004h> "]
[1014.63377, "o", "    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\r\n\u001b[?2004l\r"]
[1014.633791, "o", "\u001b[?2004h> "]
[1014.633912, "o", "    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\r\n\u001b[?2004l\r"]
[1014.633932, "o", "\u001b[?2004h> "]
[1014.634065, "o", "    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs)\r\n\u001b[?2004l\r"]
[1014.634086, "o", "\u001b[?2004h> "]
[1014.634166, "o", "    ww = tl.load(w_ptr + offs)\r\n\u001b[?2004l\r"]
[1014.634186, "o", "\u001b[?2004h> "]
[1014.634265, "o", "    bb = tl.load(b_ptr + offs)\r\n\u001b[?2004l\r"]
[1014.634295, "o", "\u001b[?2004h> "]
[1014.634478, "o", "    tl.store(out_ptr + row.to(tl.int64) * D + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r"]
[1014.634499, "o", "\u001b[?2004h> \r\n"]
[1014.634529, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1014.634561, "o", "> "]
[1014.634627, "o", "def run_all(BLOCKS, nws, BLOCKA, nwa):\r\n\u001b[?2004l\r"]
[1014.634657, "o", "\u001b[?2004h> "]
[1014.634712, "o", "    S1 = D // BLOCKS\r\n\u001b[?2004l\r"]
[1014.634732, "o", "\u001b[?2004h> "]
[1014.634789, "o", "    S2 = D // BLOCKA\r\n\u001b[?2004l\r"]
[1014.634817, "o", "\u001b[?2004h> "]
[1014.634849, "o", "    def f():\r\n\u001b[?2004l\r"]
[1014.63487, "o", "\u001b[?2004h> "]
[1014.63495, "o", "        ms.zero_(); vs.zero_()\r\n\u001b[?2004l\r"]
[1014.63497, "o", "\u001b[?2004h> "]
[1014.635138, "o", "        _stats_all[(R, S1)](x, ms, vs, D, BLOCK=BLOCKS, num_warps=nws)\r\n\u001b[?2004l\r"]
[1014.635159, "o", "\u001b[?2004h> "]
[1014.635363, "o", "        _apply_all[(R, S2)](x, out, w, b, ms, vs, D, eps, BLOCK=BLOCKA, num_warps=nwa)\r\n\u001b[?2004l\r"]
[1014.635385, "o", "\u001b[?2004h> "]
[1014.635422, "o", "    return f\r\n\u001b[?2004l\r"]
[1014.635442, "o", "\u001b[?2004h> \r\n"]
[1014.635463, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1014.635489, "o", "> "]
[1014.635648, "o", "print('baseline 2-kernel:', bench(run_all(8192, 16, 4096, 8))*1000, 'us')\r\n\u001b[?2004l\r"]
[1014.635676, "o", "\u001b[?2004h> "]
[1014.635732, "o", "for G in [1, 2, 4]:\r\n\u001b[?2004l\r"]
[1014.635753, "o", "\u001b[?2004h> "]
[1014.635872, "o", "    t = bench(run_grouped(G, 8192, 16, 8192, 8))\r\n\u001b[?2004l\r"]
[1014.635893, "o", "\u001b[?2004h> "]
[1014.636003, "o", "    print(f'grouped G={G}: {t*1000:.1f} us')\r\n\u001b[?2004l\r"]
[1014.636033, "o", "\u001b[?2004h> "]
[1014.636081, "o", "for G in [1, 2, 4]:\r\n\u001b[?2004l\r"]
[1014.636111, "o", "\u001b[?2004h> "]
[1014.636231, "o", "    t = bench(run_interleaved(G, 8192, 16, 8192, 8))\r\n\u001b[?2004l\r"]
[1014.636252, "o", "\u001b[?2004h> "]
[1014.636377, "o", "    print(f'interleaved G={G}: {t*1000:.1f} us')\r\n\u001b[?2004l\r"]
[1014.636402, "o", "\u001b[?2004h> "]
[1014.636434, "o", "EOF\r\n\u001b[?2004l\r"]
