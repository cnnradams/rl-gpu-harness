[412.218832, "o", "trial 0: max_diff=nan pass=False\r\ntrial 1: max_diff=nan pass=False\r\ntrial 2: max_diff=nan pass=False\r\ntrial 3: max_diff=nan pass=False\r\ntrial 4: max_diff=nan pass=False\r\nINCORRECT\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: cuda:0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\nTrial 1: 0.308 ms\r\nTrial 2: 0.299 ms\r\nTrial 3: 0.302 ms\r\nTrial 4: 0.301 ms\r\nTrial 5: 0.302 ms\r\nTrial 6: 0.302 ms\r\nTrial 7: 0.302 ms\r\nTrial 8: 0.301 ms\r\nTrial 9: 0.302 ms\r\nTrial 10: 0.302 ms\r\nTrial 11: 0.303 ms\r\nTrial 12: 0.3 ms\r\nTrial 13: 0.302 ms\r\nTrial 14: 0.301 ms\r\nTrial 15: 0.303 ms\r\nTrial 16: 0.301 ms\r\nTrial 17: 0.302 ms\r\nTrial 18: 0.301 ms\r\nTrial 19: 0.303 ms\r\nTrial 20: 0.301 ms\r\nSTATS {'mean': 0.302, 'std': 0.00164, 'min': 0.299, 'max': 0.308, 'num_trials': 20, 'hardware': 'NVIDIA H100 80GB HBM3', 'device': 'cuda:0'}\r\n"]
