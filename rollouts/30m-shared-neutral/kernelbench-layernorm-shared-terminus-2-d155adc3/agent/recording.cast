[538.219332, "i", "cat > /workspace/sol_triton.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _stats_kernel(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0).to(tl.float32)\n    s = tl.sum(x)\n    s2 = tl.sum(x * x)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\n\n@triton.jit\ndef _apply_kernel(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < D\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    var = ex2 - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask"]
[538.219375, "i", "=mask).to(tl.float32)\n    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)\n    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)\n    y = (x - mean) * rstd * w + b\n    tl.store(out_ptr + row.to(tl.int64) * D + offs, y, mask=mask)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        D = 1\n        for s in self.normalized_shape:\n            D *= s\n        R = x.numel() // D\n        x2 = x.view(R, D)\n        w = self.ln.weight.view(-1)\n        b = self.ln.bias.view(-1)\n        ms = torch.zeros(R, dtype=torch.float64, device=x.device)\n        vs = torch.zeros(R, dtype=torch.float64, device=x.device)\n        out = torch.empty_like(x2)\n        BLOCK = 16384\n        grid = (R, triton.cdiv(D, BLOCK))\n        _stats_kernel[grid](x2, ms, vs, D, BLOCK=BLO"]
[538.219393, "i", "CK)\n        _apply_kernel[grid](x2, out, w, b, ms, vs, D, self.ln.eps, BLOCK=BLOCK)\n        return out.view(x.shape)\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /workspace/sol_triton.py /tmp/sol_triton.py\n"]
