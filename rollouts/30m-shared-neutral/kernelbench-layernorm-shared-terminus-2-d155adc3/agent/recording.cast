[700.420103, "i", "cat > /tmp/bw.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ndef bench(fn, iters=200):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\nx = torch.rand(16*64*256*256, device='cuda')\nout = torch.empty_like(x)\n\nt = bench(lambda: out.copy_(x))\nprint(f'torch copy_: {t*1000:.1f} us, {2*x.numel()*4/t/1e9:.2f} TB/s')\n\nt = bench(lambda: torch.add(x, 1.0, out=out))\nprint(f'torch add out: {t*1000:.1f} us, {2*x.numel()*4/t/1e9:.2f} TB/s')\n\nt = bench(lambda: x.sum())\nprint(f'torch sum: {t*1000:.1f} us, {x.numel()*4/t/1e9:.2f} TB/s')\n\n@triton.jit\ndef _copy(x_ptr, o_ptr, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid.to(tl.int64) * BLOCK + tl.arange(0, BLOCK)\n    v = tl.load(x_ptr + offs)\n    tl.store(o_ptr + offs, v)\n\nN = x.numel()\nfor BLOCK in [4096, 8192, 16384]:\n    for nw in [4, 8]:\n        grid = ("]
[700.420261, "i", "triton.cdiv(N, BLOCK),)\n        f = lambda: _copy[grid](x, out, N, BLOCK=BLOCK, num_warps=nw)\n        t = bench(f)\n        print(f'triton copy BLOCK={BLOCK} warps={nw}: {t*1000:.1f} us, {2*N*4/t/1e9:.2f} TB/s')\n\n# grid-stride persistent copy\n@triton.jit\ndef _copy_gs(x_ptr, o_ptr, N, BLOCK: tl.constexpr, NPROG: tl.constexpr):\n    pid = tl.program_id(0)\n    for start in tl.range(pid * BLOCK, N, NPROG * BLOCK):\n        offs = start + tl.arange(0, BLOCK)\n        v = tl.load(x_ptr + offs)\n        tl.store(o_ptr + offs, v)\n\nfor NPROG in [592, 1184, 2368]:\n    BLOCK = 4096\n    grid = (NPROG,)\n    f = lambda: _copy_gs[grid](x, out, N, BLOCK=BLOCK, NPROG=NPROG, num_warps=8)\n    t = bench(f)\n    print(f'triton copy gs NPROG={NPROG}: {t*1000:.1f} us, {2*N*4/t/1e9:.2f} TB/s')\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/bw.py /tmp/bw.py\n"]
