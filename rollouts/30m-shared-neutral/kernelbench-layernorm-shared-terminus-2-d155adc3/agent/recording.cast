[1247.969498, "i", "cat > /tmp/tune4.py << 'EOF'\nimport torch, triton, triton.language as tl\n\ntorch.manual_seed(0)\nR, D = 16, 64*256*256\nx = torch.rand(R, D, device='cuda')\nw = torch.rand(D, device='cuda')\nb = torch.rand(D, device='cuda')\neps = 1e-5\nout = torch.empty_like(x)\nms = torch.zeros(R, dtype=torch.float64, device='cuda')\nvs = torch.zeros(R, dtype=torch.float64, device='cuda')\n\ndef bench(fn, iters=100):\n    for _ in range(10): fn()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(True); e = torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): fn()\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e) / iters\n\n@triton.jit\ndef _stats(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(x_ptr + row.to(tl.int64) * D + offs)\n    s = tl.sum(xx)\n    s2 = tl.sum(xx * xx)\n    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\n    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\n\n@triton.jit\ndef _app"]
[1247.96954, "i", "ly_cm(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr, SCM: tl.constexpr, XEV: tl.constexpr):\n    row = tl.program_id(0)\n    i = tl.program_id(1)\n    offs = i * BLOCK + tl.arange(0, BLOCK)\n    inv_d = 1.0 / D\n    mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)\n    ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)\n    rstd = 1.0 / tl.sqrt(ex2 - mean * mean + eps)\n    if XEV == 1:\n        xx = tl.load(x_ptr + row.to(tl.int64) * D + offs, eviction_policy='evict_first')\n    else:\n        xx = tl.load(x_ptr + row.to(tl.int64) * D + offs)\n    ww = tl.load(w_ptr + offs)\n    bb = tl.load(b_ptr + offs)\n    y = (xx - mean) * rstd * ww + bb\n    if SCM == 1:\n        tl.store(out_ptr + row.to(tl.int64) * D + offs, y, cache_modifier='.cs')\n    elif SCM == 2:\n        tl.store(out_ptr + row.to(tl.int64) * D + offs, y, cache_modifier='.wt')\n    elif SCM == 3:\n        tl.store(out_ptr + row.to(tl.int64) * D + offs, y, cache_modifier='.cg')\n    else:\n        tl.store(out_ptr + row.to(tl.int64)"]
[1247.969555, "i", " * D + offs, y)\n\ndef run_pair(BLOCKS, nws, BLOCKA, nwa, scm, xev):\n    S1 = D // BLOCKS\n    S2 = D // BLOCKA\n    def f():\n        ms.zero_(); vs.zero_()\n        _stats[(R, S1)](x, ms, vs, D, BLOCK=BLOCKS, num_warps=nws)\n        _apply_cm[(R, S2)](x, out, w, b, ms, vs, D, eps, BLOCK=BLOCKA, num_warps=nwa, SCM=scm, XEV=xev)\n    return f\n\nfor scm in [0, 1, 2, 3]:\n    for xev in [0, 1]:\n        t = bench(run_pair(8192, 16, 4096, 8, scm, xev))\n        print(f'scm={scm} xev={xev}: {t*1000:.1f} us')\n\nfor bs, nws in [(4096, 8), (8192, 8), (8192, 16), (16384, 16), (16384, 32), (32768, 32)]:\n    t = bench(run_pair(bs, nws, 4096, 8, 0, 0))\n    print(f'stats BLOCK={bs} nw={nws}: {t*1000:.1f} us')\n\nfor ba, nwa in [(2048, 4), (4096, 4), (4096, 8), (8192, 8)]:\n    t = bench(run_pair(8192, 16, ba, nwa, 0, 0))\n    print(f'apply BLOCK={ba} nw={nwa}: {t*1000:.1f} us')\nEOF\ngpu push sb-kNWQEs50bKBcXLxfbofzM6 /tmp/tune4.py /tmp/tune4.py\n"]
[1247.969712, "o", "cat > /tmp/tune4.py << 'EOF'\r\n\u001b[?2004l\r"]
[1247.969767, "o", "\u001b[?2004h> "]
