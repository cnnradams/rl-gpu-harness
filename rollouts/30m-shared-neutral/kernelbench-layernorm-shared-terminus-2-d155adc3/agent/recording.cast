[274.683194, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.683232, "o", "> "]
[274.683377, "o", "def _stats_kernel(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.683393, "o", "> "]
[274.683461, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[274.683499, "o", "\u001b[?2004h> "]
[274.683549, "o", "    i = tl.program_id(1)\r\n\u001b[?2004l\r"]
[274.683588, "o", "\u001b[?2004h> "]
[274.683674, "o", "    offs = i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[274.683705, "o", "\u001b[?2004h> "]
[274.683763, "o", "    mask = offs < D\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.683801, "o", "> "]
[274.683995, "o", "    x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.68403, "o", "> "]
[274.684067, "o", "    s = tl.sum(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.684104, "o", "> "]
[274.684142, "o", "    s2 = tl.sum(x * x)\r\n\u001b[?2004l\r"]
[274.684178, "o", "\u001b[?2004h> "]
[274.684291, "o", "    tl.atomic_add(ms_ptr + row, s.to(tl.float64))\r\n\u001b[?2004l\r"]
[274.684329, "o", "\u001b[?2004h> "]
[274.684432, "o", "    tl.atomic_add(vs_ptr + row, s2.to(tl.float64))\r\n\u001b[?2004l\r"]
[274.684463, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[274.684501, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[274.684531, "o", "> "]
[274.684562, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[274.684793, "o", "def _apply_kernel(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, eps, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[274.684834, "o", "\u001b[?2004h> "]
[274.684873, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[274.6849, "o", "\u001b[?2004h> "]
[274.684959, "o", "    i = tl.program_id(1)\r\n\u001b[?2004l\r"]
[274.685007, "o", "\u001b[?2004h> "]
[274.6851, "o", "    offs = i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[274.685138, "o", "\u001b[?2004h> "]
[274.685176, "o", "    mask = offs < D\r\n\u001b[?2004l\r"]
[274.685214, "o", "\u001b[?2004h> "]
[274.68532, "o", "    mean = tl.load(ms_ptr + row).to(tl.float32)\r\n\u001b[?2004l\r"]
[274.68536, "o", "\u001b[?2004h"]
[274.685398, "o", "> "]
[274.685488, "o", "    var = tl.load(vs_ptr + row).to(tl.float32) - mean * mean\r\n\u001b[?2004l\r"]
[274.685521, "o", "\u001b[?2004h> "]
[274.685598, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[274.685629, "o", "\u001b[?2004h> "]
[274.68581, "o", "    x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask).to(tl.float32)\r\n\u001b[?2004l\r"]
[274.685849, "o", "\u001b[?2004h> "]
[274.685985, "o", "    w = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[274.686016, "o", "\u001b[?2004h> "]
[274.686164, "o", "    b = tl.load(b_ptr + offs, mask=mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[274.686203, "o", "\u001b[?2004h> "]
[274.686275, "o", "    y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[274.686306, "o", "\u001b[?2004h> "]
[274.686453, "o", "    tl.store(out_ptr + row.to(tl.int64) * D + offs, y, mask=mask)\r\n\u001b[?2004l\r"]
[274.686482, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[274.68652, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[274.686554, "o", "\u001b[?2004h> "]
[274.686606, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[274.686644, "o", "\u001b[?2004h> "]
[274.686748, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[274.686785, "o", "\u001b[?2004h> "]
[274.686838, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[274.686876, "o", "\u001b[?2004h> "]
[274.686992, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[274.687024, "o", "\u001b[?2004h> "]
[274.687181, "o", "        self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)\r\n\u001b[?2004l\r"]
[274.687219, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[274.687265, "o", "> "]
[274.687375, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[274.687407, "o", "\u001b[?2004h> "]
[274.687444, "o", "        D = 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.687481, "o", "> "]
[274.687551, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[274.687588, "o", "\u001b[?2004h> "]
[274.687618, "o", "            D *= s\r\n\u001b[?2004l\r"]
[274.687652, "o", "\u001b[?2004h> "]
[274.687712, "o", "        R = x.numel() // D\r\n\u001b[?2004l\r"]
[274.687744, "o", "\u001b[?2004h> "]
[274.687801, "o", "        x2 = x.view(R, D)\r\n\u001b[?2004l\r"]
[274.687832, "o", "\u001b[?2004h> "]
[274.687918, "o", "        w = self.ln.weight.view(-1)\r\n\u001b[?2004l\r"]
[274.687947, "o", "\u001b[?2004h> "]
[274.688021, "o", "        b = self.ln.bias.view(-1)\r\n\u001b[?2004l\r"]
[274.688052, "o", "\u001b[?2004h> "]
[274.688201, "o", "        ms = torch.zeros(R, dtype=torch.float64, device=x.device)\r\n\u001b[?2004l\r"]
[274.688239, "o", "\u001b[?2004h> "]
[274.688385, "o", "        vs = torch.zeros(R, dtype=torch.float64, device=x.device)\r\n\u001b[?2004l\r"]
[274.688416, "o", "\u001b[?2004h> "]
[274.688493, "o", "        out = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[274.688525, "o", "\u001b[?2004h> "]
[274.688574, "o", "        BLOCK = 16384\r\n\u001b[?2004l\r"]
[274.688605, "o", "\u001b[?2004h> "]
[274.688699, "o", "        grid = (R, triton.cdiv(D, BLOCK))\r\n\u001b[?2004l\r"]
[274.688731, "o", "\u001b[?2004h> "]
[274.688858, "o", "        _stats_kernel[grid](x2, ms, vs, D, BLOCK=BLOCK)\r\n\u001b[?2004l\r"]
[274.688897, "o", "\u001b[?2004h> "]
[274.689093, "o", "        _apply_kernel[grid](x2, out, w, b, ms, vs, D, self.ln.eps, BLOCK=BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.689125, "o", "> "]
[274.689193, "o", "        return out.view(x.shape)\r\n\u001b[?2004l\r"]
[274.689224, "o", "\u001b[?2004h> EOF\r\n"]
[274.68926, "o", "\u001b[?2004l\r"]
[274.696254, "o", "\u001b[?2004hroot@modal:/# "]
[275.161351, "i", "cat > /workspace/bench_one.py << 'EOF'\nimport sys, importlib, torch\nsys.path.insert(0, '/opt/task')\nsys.path.insert(0, '/workspace')\nfrom reference import Model, get_inputs, get_init_inputs\nimport kernelbench.timing as kt\n\nmodname = sys.argv[1]\nclsname = sys.argv[2] if len(sys.argv) > 2 else 'ModelNew'\nmod = importlib.import_module(modname)\nModelNew = getattr(mod, clsname)\n\ndevice = torch.device('cuda:0')\ntorch.cuda.set_device(device)\ninit_inputs = [x.to(device) if isinstance(x, torch.Tensor) else x for x in get_init_inputs()]\nref = Model(*init_inputs).to(device)\nnew = ModelNew(*init_inputs).to(device)\nnew.ln.weight.data.copy_(ref.ln.weight.data)\nnew.ln.bias.data.copy_(ref.ln.bias.data)\n\nok = True\nfor t in range(5):\n    torch.manual_seed(100 + t)\n    x = torch.rand(16, 64, 256, 256, device=device)\n    with torch.no_grad():\n        y_ref = ref(x)\n        y_new = new(x)\n    md = (y_ref - y_new).abs().max().item()\n    passed = torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4)\n    ok &= passed\n    print(f'trial "]
[275.161392, "i", "{t}: max_diff={md:.3e} pass={passed}')\nprint('CORRECT' if ok else 'INCORRECT')\n\ntorch.manual_seed(42)\ninputs = [x.to(device) for x in get_inputs()]\nfn = kt.get_timing_function('cuda_event')\nwith torch.no_grad():\n    times = fn(new, inputs, num_trials=20, verbose=True, device=device)\nprint('STATS', kt.get_timing_stats(times, device=device))\nEOF\n"]
[275.161608, "o", "cat > /workspace/bench_one.py << 'EOF'\r\n\u001b[?2004l\r"]
