[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, normalized_shape: tuple):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.normalized_shape = tuple(normalized_shape)
[?2004l[?2004h>         self.ln = nn.LayerNorm(normalized_shape=self.normalized_shape)
[?2004l[?2004h>         self._graphs = {}
[?2004l[?2004h>         self._bufs = {}
[?2004l[?2004h> 
[?2004l[?2004h>     def _get_bufs(self, R, D, device):
[?2004l[?2004h>         key = (R, D, device)
[?2004l[?2004h>         if key not in self._bufs:
[?2004l[?2004h>             self._bufs[key] = (
[?2004l[?2004h>                 torch.zeros(R, dtype=torch.float64, device=device),
[?2004l[?2004h>                 torch.zeros(R, dtype=torch.float64, device=device),
[?2004l[?2004h>                 torch.empty(R * D, dtype=torch.float32, device=device),
[?2004l[?2004h>             )
[?2004l[?2004h>         return self._bufs[key]
[?2004l[?2004h> 
[?2004l[?2004h>     def _launch(self, x2, out, w, b, ms, vs, R, D, S, eps, BLOCK):
[?2004l[?2004h>         grid = (R, S)
[?2004l[?2004h>         ms.zero_(); vs.zero_()
[?2004l[?2004h>         _stats_kernel[grid](x2, ms, vs, D, BLOCK=BLOCK, num_warps=16)
[?2004l[?2004h>         _apply_kernel[grid](x2, out, w, b, ms, vs, D, S, eps, BLOCK=BLOCK, num_warps=8)
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x: torch.Tensor) -> torch.Tensor:
[?2004l[?2004h>         D = 1
[?2004l[?2004h>         for s in self.normalized_shape:
[?2004l[?2004h>             D *= s
[?2004l[?2004h>         R = x.numel() // D
[?2004l[?2004h>         BLOCK = 8192
[?2004l[?2004h>         S = triton.cdiv(D, BLOCK)
[?2004l[?2004h>         eps = self.ln.eps
[?2004l[?2004h>         w = self.ln.weight.view(-1)
[?2004l[?2004h>         b = self.ln.bias.view(-1)
[?2004l[?2004h>         ms, vs, outflat = self._get_bufs(R, D, x.device)
[?2004l[?2004h>         x2 = x.view(R * D)
[?2004l[?2004h>         key = (x.data_ptr(), x.shape, R, D)
[?2004l[?2004h>         g = self._graphs.get(key)
[?2004l[?2004h>         if g is None:
[?2004l[?2004h>             # eager once to warm/compile, then capture
[?2004l[?2004h>             self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)
[?2004l[?2004h>             torch.cuda.synchronize()
[?2004l[?2004h>             try:
[?2004l[?2004h>                 gr = torch.cuda.CUDAGraph()
[?2004l[?2004h>                 with torch.cuda.graph(gr):
[?2004l[?2004h>                     self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)
[?2004l[?2004h>                 self._graphs[key] = (gr, outflat)
[?2004l[?2004h>                 gr.replay()
[?2004l[?2004h>             except Exception:
[?2004l[?2004h>                 self._graphs[key] = (None, outflat)
[?2004l[?2004h>                 self._launch(x2, outflat, w, b, ms, vs, R, D, S, eps, BLOCK)
[?2004l[?2004h>         else:
