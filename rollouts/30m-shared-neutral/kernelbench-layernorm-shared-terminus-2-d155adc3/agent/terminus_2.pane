[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _stats_kernel(x_ptr, ms_ptr, vs_ptr, D, BLOCK: tl.constexpr):
[?2004l[?2004h>     row = tl.program_id(0)
[?2004l[?2004h>     i = tl.program_id(1)
[?2004l[?2004h>     offs = i * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     mask = offs < D
[?2004l[?2004h>     x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask, other=0.0)
[?2004l[?2004h>     s = tl.sum(x)
[?2004l[?2004h>     s2 = tl.sum(x * x)
[?2004l[?2004h>     tl.atomic_add(ms_ptr + row, s.to(tl.float64))
[?2004l[?2004h>     tl.atomic_add(vs_ptr + row, s2.to(tl.float64))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _apply_kernel(x_ptr, out_ptr, w_ptr, b_ptr, ms_ptr, vs_ptr, D, S, eps, BLOCK: tl.constexpr):
[?2004l[?2004h>     row = tl.program_id(0)
[?2004l[?2004h>     i = S - 1 - tl.program_id(1)  # reverse order for L2 reuse
[?2004l[?2004h>     offs = i * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     mask = offs < D
[?2004l[?2004h>     inv_d = 1.0 / D
[?2004l[?2004h>     mean = (tl.load(ms_ptr + row) * inv_d).to(tl.float32)
[?2004l[?2004h>     ex2 = (tl.load(vs_ptr + row) * inv_d).to(tl.float32)
[?2004l[?2004h>     var = ex2 - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     x = tl.load(x_ptr + row.to(tl.int64) * D + offs, mask=mask)
[?2004l[?2004h>     w = tl.load(w_ptr + offs, mask=mask, other=0.0)
[?2004l[?2004h>     b = tl.load(b_ptr + offs, mask=mask, other=0.0)
[?2004l[?2004h>     y = (x - mean) * rstd * w + b
[?2004l[?2004h>     tl.store(out_ptr + row.to(tl.int64) * D + offs, y, mask=mask)
