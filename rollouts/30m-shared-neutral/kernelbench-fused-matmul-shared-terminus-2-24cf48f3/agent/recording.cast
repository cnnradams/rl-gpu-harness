[1599.134362, "i", "cat > /workspace/v6.py << 'EOF'\nimport torch, triton, torch.nn as nn, torch.nn.functional as F\nimport triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\n@triton.jit\ndef _split_v1(x_ptr, a3_ptr, M, K, sa, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < K\n    x = tl.load(x_ptr + row * K + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    base = a3_ptr + row * sa\n    tl.store(base + offs, hi, mask=mask)\n    tl.store(base + K + offs, hi, mask=mask)\n    tl.store(base + 2 * K + offs, lo, mask=mask)\n\n@triton.jit\ndef _split_v2(x_ptr, a3_ptr, M, K, sa, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    nblk = tl.cdiv(K, BLOCK)\n    row = pid // nblk\n    col = pid % nblk\n    offs = col * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < K\n    x = tl.load(x_ptr + row * K + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.floa"]
[1599.134417, "i", "t16)\n    base = a3_ptr + row * sa\n    tl.store(base + offs, hi, mask=mask)\n    tl.store(base + K + offs, hi, mask=mask)\n    tl.store(base + 2 * K + offs, lo, mask=mask)\n\n@triton.jit\ndef _gemm_tma(\n    a_desc, b_desc, bias_ptr, c_desc,\n    M, N, K,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BLOCK_K)):\n        a = a_desc.load([off_m, k * BLOCK_K])\n        b = b_desc.load([k * BLOCK_K, off_n])\n        acc = tl.dot(a, b, acc)\n    rn = off_n + tl.arange(0, BLOCK_N)\n    bias = tl.load(bias_ptr + rn, mask=rn < N"]
[1599.13443, "i", ", other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc.to(tl.float32))\n\nin_features, out_features = 4096, 4096\nbatch = 16384\nx = torch.rand(batch, in_features, device='cuda')\nw = torch.randn(out_features, in_features, device='cuda') * 0.02\nbias = torch.randn(out_features, device='cuda')\nw_hi = w.half(); w_lo = (w - w_hi.float()).half()\nB3 = torch.cat([w_hi.t(), w_lo.t(), w_hi.t()], dim=0).contiguous()\nM, K = x.shape; N = w.shape[0]; K3 = 3*K\nA3 = torch.empty((M, K3), device='cuda', dtype=torch.float16)\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ndef clear_l2():\n    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    dd.fill_(42); del dd\n\ndef time_fn(fn, trials=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    times = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn"]
[1599.134437, "i", "(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times), min(times)\n\nfor blk in [1024, 2048, 4096, 8192]:\n    for nw in [4, 8]:\n        g = (triton.cdiv(K, blk), M)\n        print(f'split_v1 blk={blk} nw={nw}:', time_fn(lambda: _split_v1[g](x, A3, M, K, A3.stride(0), BLOCK=blk, num_warps=nw)))\nfor blk in [2048, 4096]:\n    g = (M * triton.cdiv(K, blk),)\n    print(f'split_v2 blk={blk}:', time_fn(lambda: _split_v2[g](x, A3, M, K, A3.stride(0), BLOCK=blk, num_warps=8)))\n\nconfigs = [\n    (128,256,64,8,8,4),\n    (128,256,64,8,8,5),\n    (128,256,64,4,8,4),\n    (128,256,64,16,8,4),\n    (128,256,32,8,8,4),\n    (256,256,32,8,8,3),\n    (256,256,64,8,8,2),\n]\nfor cfg in configs:\n    bm, bn, bk, gm, nw, ns = cfg\n    try:\n        a_desc = TensorDescriptor(A3, A3.shape, A3.stride(), [bm, bk])\n        b_desc = TensorDescriptor(B3, B3.shape, B3.stride(), [bk, bn])\n        c_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\n     "]
[1599.134445, "i", "   grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n        def run():\n            _gemm_tma[grid](a_desc, b_desc, bias, c_desc, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\n        print(f'gemm cfg {cfg}:', time_fn(run))\n    except Exception as ex:\n        print(f'gemm cfg {cfg}: FAIL {type(ex).__name__}')\nEOF\ngpu run -- bash -c \"python3 /workspace/v6.py > /workspace/v6_out.txt 2>&1; echo done\"\n"]
