[1386.363399, "o", "\u001b[?2004h> "]
[1386.363451, "o", "        grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[1386.363477, "o", "\u001b[?2004h> "]
[1386.363502, "o", "        def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1386.36366, "o", "            _gemm_tma[grid](a_desc, b_desc, b, c_desc, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1386.363688, "o", "\u001b[?2004h> "]
[1386.36371, "o", "        t = time_fn(run)\r\n\u001b[?2004l\r\u001b[?2004h> "]
