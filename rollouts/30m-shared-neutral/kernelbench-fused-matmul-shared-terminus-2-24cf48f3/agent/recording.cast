[1493.462753, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[1493.462788, "o", "\u001b[?2004h> "]
[1493.462835, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1493.462857, "o", "\u001b[?2004h> "]
[1493.462927, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1493.462951, "o", "\u001b[?2004h> "]
[1493.463016, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1493.46304, "o", "\u001b[?2004h> "]
[1493.463098, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1493.463122, "o", "\u001b[?2004h> "]
[1493.463179, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1493.463205, "o", "\u001b[?2004h> "]
[1493.463344, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1493.463369, "o", "\u001b[?2004h> "]
[1493.463496, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1493.463521, "o", "\u001b[?2004h> "]
[1493.463601, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1493.463625, "o", "\u001b[?2004h> "]
[1493.463682, "o", "    off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[1493.463707, "o", "\u001b[?2004h> "]
[1493.463764, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[1493.463798, "o", "\u001b[?2004h> "]
[1493.463924, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1493.463954, "o", "\u001b[?2004h> "]
[1493.464041, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[1493.46407, "o", "\u001b[?2004h> "]
[1493.464162, "o", "        a = a_desc.load([off_m, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[1493.464199, "o", "\u001b[?2004h> "]
[1493.46429, "o", "        b = b_desc.load([k * BLOCK_K, off_n])\r\n\u001b[?2004l\r"]
[1493.464312, "o", "\u001b[?2004h> "]
[1493.464388, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r"]
[1493.464415, "o", "\u001b[?2004h> "]
[1493.464495, "o", "    rn = off_n + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1493.46452, "o", "\u001b[?2004h> "]
[1493.46467, "o", "    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[1493.464695, "o", "\u001b[?2004h> "]
[1493.464754, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1493.464784, "o", "\u001b[?2004h> "]
[1493.464895, "o", "    c_desc.store([off_m, off_n], acc.to(tl.float32))\r\n\u001b[?2004l\r"]
[1493.464919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h"]
[1493.46494, "o", "> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[1493.464975, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1493.464999, "o", "\u001b[?2004h> "]
[1493.465034, "o", "def _gemm_masked(\r\n\u001b[?2004l\r"]
[1493.46506, "o", "\u001b[?2004h> "]
[1493.46513, "o", "    a_ptr, b_ptr, bias_ptr, c_ptr,\r\n\u001b[?2004l\r"]
[1493.465151, "o", "\u001b[?2004h> "]
[1493.465179, "o", "    M, N, K,\r\n\u001b[?2004l\r"]
[1493.465204, "o", "\u001b[?2004h> "]
[1493.465261, "o", "    sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[1493.465285, "o", "\u001b[?2004h> "]
[1493.465354, "o", "    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[1493.46538, "o", "\u001b[?2004h> "]
[1493.465424, "o", "    GROUP_M: tl.constexpr, EVEN_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[1493.465449, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[1493.465474, "o", "\u001b[?2004h> "]
[1493.465503, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.465529, "o", "> "]
[1493.465556, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1493.465599, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1493.465623, "o", "\u001b[?2004h> "]
[1493.465647, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1493.465672, "o", "\u001b[?2004h> "]
[1493.465697, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1493.465724, "o", "\u001b[?2004h> "]
[1493.465785, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n"]
[1493.465811, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1493.465865, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1493.465889, "o", "\u001b[?2004h> "]
[1493.465925, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1493.46595, "o", "\u001b[?2004h> "]
[1493.465995, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[1493.46602, "o", "\u001b[?2004h> "]
[1493.466064, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1493.466089, "o", "\u001b[?2004h> "]
[1493.466116, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[1493.466141, "o", "\u001b[?2004h> "]
[1493.466195, "o", "    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1493.46622, "o", "\u001b[?2004h> "]
[1493.46628, "o", "    b_ptrs = b_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1493.466303, "o", "\u001b[?2004h> "]
[1493.466358, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1493.466383, "o", "\u001b[?2004h> "]
[1493.466422, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[1493.466446, "o", "\u001b[?2004h> "]
[1493.46647, "o", "        if EVEN_K:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1493.466512, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[1493.466536, "o", "\u001b[?2004h> "]
[1493.466563, "o", "            b = tl.load(b_ptrs)\r\n\u001b[?2004l\r"]
[1493.466588, "o", "\u001b[?2004h> "]
[1493.466612, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1493.466649, "o", "            krem = K - k * BLOCK_K\r\n\u001b[?2004l\r"]
[1493.466673, "o", "\u001b[?2004h> "]
[1493.466738, "o", "            a = tl.load(a_ptrs, mask=rk[None, :] < krem, other=0.0)\r\n\u001b[?2004l\r"]
[1493.466762, "o", "\u001b[?2004h> "]
[1493.466833, "o", "            b = tl.load(b_ptrs, mask=rk[:, None] < krem, other=0.0)\r\n\u001b[?2004l\r"]
[1493.466857, "o", "\u001b[?2004h> "]
[1493.466885, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r"]
[1493.466909, "o", "\u001b[?2004h> "]
[1493.466937, "o", "        a_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r"]
[1493.466965, "o", "\u001b[?2004h> "]
[1493.46699, "o", "        b_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[1493.467014, "o", "\u001b[?2004h> "]
[1493.467081, "o", "    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[1493.467105, "o", "\u001b[?2004h> "]
[1493.467131, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1493.467155, "o", "\u001b[?2004h> "]
[1493.46721, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[1493.467234, "o", "\u001b[?2004h> "]
[1493.46728, "o", "    mask = (rm[:, None] < M) & (rn[None, :] < N)\r\n\u001b[?2004l\r"]
[1493.467304, "o", "\u001b[?2004h> "]
[1493.467336, "o", "    tl.store(c_ptrs, acc, mask=mask)\r\n\u001b[?2004l\r"]
[1493.467361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.467386, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1493.467421, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1493.467445, "o", "\u001b[?2004h> "]
[1493.467513, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.467537, "o", "> "]
[1493.467562, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.467586, "o", "> "]
[1493.467627, "o", "        lin = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1493.467651, "o", "\u001b[?2004h> "]
[1493.467686, "o", "        s = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r"]
[1493.46771, "o", "\u001b[?2004h> "]
[1493.467738, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[1493.467762, "o", "\u001b[?2004h> "]
[1493.467793, "o", "            lin.weight.mul_(s)\r\n\u001b[?2004l\r"]
[1493.467818, "o", "\u001b[?2004h> "]
[1493.467843, "o", "            lin.bias.mul_(s)\r\n\u001b[?2004l\r"]
[1493.467873, "o", "\u001b[?2004h> "]
[1493.467898, "o", "        self.weight = lin.weight\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.467923, "o", "> "]
[1493.467945, "o", "        self.bias = lin.bias\r\n\u001b[?2004l\r"]
[1493.467971, "o", "\u001b[?2004h> "]
[1493.467996, "o", "        self._b3 = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[1493.468021, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1493.468051, "o", "    def _prep(self, device):\r\n\u001b[?2004l\r"]
[1493.468076, "o", "\u001b[?2004h> "]
[1493.468104, "o", "        w = self.weight.detach()\r\n\u001b[?2004l\r"]
[1493.468128, "o", "\u001b[?2004h> "]
[1493.468152, "o", "        w_hi = w.half()\r\n\u001b[?2004l\r"]
[1493.468178, "o", "\u001b[?2004h> "]
[1493.468219, "o", "        w_lo = (w - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[1493.468244, "o", "\u001b[?2004h> "]
[1493.46832, "o", "        self._b3 = torch.cat([w_hi.t(), w_lo.t(), w_hi.t()], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[1493.468343, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.468367, "o", "> "]
[1493.468393, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.468418, "o", "> "]
[1493.468496, "o", "        if x.is_cuda and x.dtype == torch.float32 and x.dim() == 2 and x.is_contiguous():\r\n\u001b[?2004l\r"]
[1493.468525, "o", "\u001b[?2004h> "]
[1493.468549, "o", "            M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.468574, "o", "> "]
[1493.468599, "o", "            N = self.weight.shape[0]\r\n\u001b[?2004l\r"]
[1493.468628, "o", "\u001b[?2004h> "]
[1493.468685, "o", "            if self._b3 is None or self._b3.device != x.device:\r\n\u001b[?2004l\r"]
[1493.468709, "o", "\u001b[?2004h> "]
[1493.468742, "o", "                self._prep(x.device)\r\n\u001b[?2004l\r"]
[1493.468769, "o", "\u001b[?2004h> "]
[1493.468796, "o", "            b3 = self._b3\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.46882, "o", "> "]
[1493.468845, "o", "            bias = self.bias\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.468869, "o", "> "]
[1493.468892, "o", "            K3 = 3 * K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1493.468978, "o", "            a3 = torch.empty((M, K3), device=x.device, dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1493.469002, "o", "\u001b[?2004h> "]
[1493.46905, "o", "            grid_split = (triton.cdiv(K, 2048), M)\r\n\u001b[?2004l\r"]
[1493.469075, "o", "\u001b[?2004h> "]
[1493.469167, "o", "            _split_cat_kernel[grid_split](x, a3, M, K, a3.stride(0), BLOCK=2048, num_warps=8)\r\n\u001b[?2004l\r"]
[1493.469192, "o", "\u001b[?2004h> "]
[1493.469265, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1493.469289, "o", "\u001b[?2004h> "]
[1493.46936, "o", "            if _HAS_TD and M % 128 == 0 and K % 64 == 0 and N % 256 == 0:\r\n\u001b[?2004l\r"]
[1493.469385, "o", "\u001b[?2004h> "]
[1493.469445, "o", "                bm, bn, bk, gm, nw, ns = 128, 256, 64, 8, 8, 4\r\n\u001b[?2004l\r"]
[1493.469469, "o", "\u001b[?2004h> "]
[1493.469545, "o", "                a_desc = TensorDescriptor(a3, a3.shape, a3.stride(), [bm, bk])\r\n\u001b[?2004l\r"]
[1493.469569, "o", "\u001b[?2004h> "]
[1493.469647, "o", "                b_desc = TensorDescriptor(b3, b3.shape, b3.stride(), [bk, bn])\r\n\u001b[?2004l\r"]
[1493.469672, "o", "\u001b[?2004h> "]
[1493.469755, "o", "                c_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\r\n\u001b[?2004l\r"]
[1493.469789, "o", "\u001b[?2004h> "]
[1493.469847, "o", "                grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[1493.469871, "o", "\u001b[?2004h> "]
[1493.46994, "o", "                _gemm_tma[grid](a_desc, b_desc, bias, c_desc, M, N, K3,\r\n\u001b[?2004l\r"]
[1493.469968, "o", "\u001b[?2004h> "]
[1493.470042, "o", "                                BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm,\r\n\u001b[?2004l\r"]
[1493.470067, "o", "\u001b[?2004h> "]
[1493.470131, "o", "                                num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1493.470155, "o", "\u001b[?2004h> "]
[1493.470181, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.470205, "o", "> "]
[1493.47026, "o", "                bm, bn, bk, gm, nw, ns = 128, 128, 64, 8, 8, 3\r\n\u001b[?2004l\r"]
[1493.470284, "o", "\u001b[?2004h> "]
[1493.470347, "o", "                grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[1493.470375, "o", "\u001b[?2004h> "]
[1493.470434, "o", "                _gemm_masked[grid](a3, b3, bias, out, M, N, K3,\r\n\u001b[?2004l\r"]
[1493.470459, "o", "\u001b[?2004h> "]
[1493.470517, "o", "                                   a3.stride(0), a3.stride(1),\r\n\u001b[?2004l\r"]
[1493.470545, "o", "\u001b[?2004h> "]
[1493.470601, "o", "                                   b3.stride(0), b3.stride(1),\r\n\u001b[?2004l\r"]
[1493.470627, "o", "\u001b[?2004h> "]
[1493.470687, "o", "                                   out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[1493.470715, "o", "\u001b[?2004h> "]
[1493.470797, "o", "                                   BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm,\r\n\u001b[?2004l\r"]
[1493.470821, "o", "\u001b[?2004h> "]
[1493.470876, "o", "                                   EVEN_K=(K3 % bk == 0),\r\n\u001b[?2004l\r"]
[1493.470901, "o", "\u001b[?2004h> "]
[1493.47096, "o", "                                   num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1493.470986, "o", "\u001b[?2004h> "]
[1493.471006, "o", "            return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[1493.47103, "o", "> "]
[1493.471075, "o", "        return F.linear(x, self.weight, self.bias)\r\n\u001b[?2004l\r"]
[1493.471099, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1493.495374, "o", "\u001b[?2004hroot@modal:/# "]
