[209.933461, "o", "\u001b[?2004h> "]
[209.933489, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.933533, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[209.933562, "o", "\u001b[?2004h> "]
[209.933594, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.933617, "o", "> "]
[209.933642, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[209.93367, "o", "\u001b[?2004h> "]
[209.933696, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[209.93372, "o", "\u001b[?2004h> "]
[209.933789, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[209.933813, "o", "\u001b[?2004h> "]
[209.933864, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[209.933892, "o", "\u001b[?2004h> "]
[209.933929, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[209.933957, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[209.933984, "o", "\u001b[?2004h> "]
[209.934029, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[209.934057, "o", "\u001b[?2004h> "]
[209.934102, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[209.934129, "o", "\u001b[?2004h> "]
[209.934156, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[209.934188, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[209.934216, "o", "\u001b[?2004h> "]
[209.934266, "o", "    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[209.934295, "o", "\u001b[?2004h> "]
[209.934353, "o", "    b_ptrs = b_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[209.934381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.934464, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.934526, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[209.934555, "o", "\u001b[?2004h> "]
[209.934581, "o", "        a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[209.934606, "o", "\u001b[?2004h> "]
[209.934635, "o", "        b = tl.load(b_ptrs)\r\n\u001b[?2004l\r"]
[209.93466, "o", "\u001b[?2004h> "]
[209.934701, "o", "        acc = tl.dot(a, b, acc, input_precision=IP)\r\n\u001b[?2004l\r"]
[209.934726, "o", "\u001b[?2004h> "]
[209.934759, "o", "        a_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.934788, "o", "> "]
[209.934815, "o", "        b_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[209.934842, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[209.93487, "o", "\u001b[?2004h> "]
[209.93493, "o", "    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[209.934958, "o", "\u001b[?2004h> "]
[209.934985, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[209.935012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[209.935039, "o", "\u001b[?2004h> "]
[209.93509, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[209.935118, "o", "\u001b[?2004h> "]
[209.935163, "o", "    mask = (rm[:, None] < M) & (rn[None, :] < N)\r\n\u001b[?2004l\r"]
[209.935192, "o", "\u001b[?2004h> "]
[209.93523, "o", "    tl.store(c_ptrs, acc, mask=mask)\r\n\u001b[?2004l\r"]
[209.935258, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.935287, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
