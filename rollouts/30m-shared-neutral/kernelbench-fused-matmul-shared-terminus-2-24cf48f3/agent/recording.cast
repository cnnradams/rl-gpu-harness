[1386.363106, "o", "\u001b[?2004h> "]
[1386.363181, "o", "        a_desc = TensorDescriptor(A3, A3.shape, A3.stride(), [bm, bk])\r\n\u001b[?2004l\r"]
[1386.363206, "o", "\u001b[?2004h> "]
[1386.36327, "o", "        b_desc = TensorDescriptor(B3, B3.shape, B3.stride(), [bk, bn])\r\n\u001b[?2004l\r"]
[1386.363294, "o", "\u001b[?2004h> "]
