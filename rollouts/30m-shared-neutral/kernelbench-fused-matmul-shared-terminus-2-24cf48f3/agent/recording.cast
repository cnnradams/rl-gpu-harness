[1558.705616, "o", "{\r\n    \"compiled\": true,\r\n    \"correctness\": true,\r\n    \"metadata\": {\r\n        \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n        \"device\": \"0\",\r\n        \"correctness_trials\": \"(5 / 5)\"\r\n    },\r\n    \"runtime\": 2.5,\r\n    \"runtime_stats\": {\r\n        \"mean\": 2.5,\r\n        \"std\": 0.247,\r\n        \"min\": 2.39,\r\n        \"max\": 3.55,\r\n        \"num_trials\": 20\r\n    },\r\n    \"ref_runtime\": 11.8,\r\n    \"ref_runtime_stats\": {\r\n        \"mean\": 11.8,\r\n        \"std\": 1.89,\r\n        \"min\": 11.4,\r\n        \"max\": 20.1,\r\n        \"num_trials\": 20\r\n    },\r\n    \"solution_sha256\": \"a527df5b90009a36be3cf6b73c6dc413d26c292f029ea0a49a8923a86e8bcf94\",\r\n    \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n    \"timing_unit\": \"milliseconds\",\r\n    \"correct_trials\": 5,\r\n    \"perf_trials\": 20,\r\n    \"speedup\": 4.720000000000001\r\n}\r\n"]
