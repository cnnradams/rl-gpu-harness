[210.765534, "i", "cat > /workspace/bench.py << 'EOF'\nimport sys, torch, triton\nsys.path.insert(0, '/workspace')\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom solution import _gemm_bias_kernel\n\nin_features, out_features, scaling = 4096, 4096, 0.5\nbatch = 16384\n\nclass Model(nn.Module):\n    def __init__(self, i, o, s):\n        super().__init__()\n        self.matmul = nn.Linear(i, o)\n        self.scaling_factor = s\n    def forward(self, x):\n        x = self.matmul(x)\n        ox = x.clone().detach()\n        x = x * self.scaling_factor\n        return x + ox\n\ntorch.manual_seed(42)\nref = Model(in_features, out_features, scaling).cuda()\ntorch.manual_seed(42)\nfrom solution import ModelNew\nnew = ModelNew(in_features, out_features, scaling).cuda()\n\nx = torch.rand(batch, in_features, device='cuda')\nwith torch.no_grad():\n    r = ref(x)\n    o = new(x)\ndiff = (r - o).abs()\ntol = 1e-4 + 1e-4 * r.abs()\nprint('max abs diff:', diff.max().item())\nprint('max rel to tol:', (diff / tol).max().item())\nprint('allclose:', torch.allclose(r, "]
[210.76558, "i", "o, atol=1e-4, rtol=1e-4))\nprint('ref scale (abs mean/max):', r.abs().mean().item(), r.abs().max().item())\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef time_fn(fn, trials=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    times = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times), min(times)\n\nwith torch.no_grad():\n    mean, mn = time_fn(lambda: ref(x))\nprint(f'ref eager: mean {mean:.3f} ms  min {mn:.3f} ms')\n\nwt = new._w_t if new._w_t is not None else None\nnew._prep(); wt = new._w_t\nbias = new.bias\nM, K = x.shape; N = wt.shape[1]\n\nconfigs = [\n    (128,128,32,8,8,3),\n    (128,256,32,8,8,3),\n    (256,128,32,8,8,3),\n    (128,128,64,8,8,3"]
[210.765616, "i", "),\n    (128,256,64,8,8,4),\n    (256,128,64,8,8,4),\n    (128,64,64,8,8,4),\n    (64,128,64,8,8,4),\n    (64,256,64,8,8,4),\n    (256,64,64,8,8,4),\n    (64,256,32,8,4,4),\n    (256,64,32,8,4,4),\n]\nfor cfg in configs:\n    bm, bn, bk, gm, nw, ns = cfg\n    out = torch.empty((M, N), device='cuda', dtype=torch.float32)\n    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n    def run():\n        _gemm_bias_kernel[grid](x, wt, bias, out, M, N, K,\n            x.stride(0), x.stride(1), wt.stride(0), wt.stride(1),\n            out.stride(0), out.stride(1),\n            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm,\n            IP='tf32x3', num_warps=nw, num_stages=ns)\n    try:\n        mean, mn = time_fn(run)\n        print(f'cfg {cfg}: mean {mean:.3f} ms  min {mn:.3f} ms')\n    except Exception as ex:\n        print(f'cfg {cfg}: FAIL {ex}')\n\n# also check full model forward timing\nwith torch.no_grad():\n    mean, mn = time_fn(lambda: new(x))\nprint(f'ModelNew forward: mean {mean:.3f} ms  min {mn:.3f} ms')\nEOF\ngpu run -- python3 /wo"]
[210.765736, "i", "rkspace/bench.py\n"]
