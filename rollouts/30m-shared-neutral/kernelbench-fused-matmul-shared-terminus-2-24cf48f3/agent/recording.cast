[1599.139188, "o", "\u001b[?2004h> "]
[1599.139261, "o", "    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1599.13929, "o", "\u001b[?2004h> "]
[1599.139315, "o", "    dd.fill_(42); del dd\r\n\u001b[?2004l\r\u001b[?2004h"]
[1599.139344, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1599.139384, "o", "def time_fn(fn, trials=20):\r\n\u001b[?2004l\r"]
[1599.139414, "o", "\u001b[?2004h> "]
[1599.139442, "o", "    for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1599.13949, "o", "        fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1599.13952, "o", "\u001b[?2004h>     times = []\r\n\u001b[?2004l\r"]
[1599.139549, "o", "\u001b[?2004h> "]
