[525.379516, "i", "cat > /workspace/diag.py << 'EOF'\nimport torch, torch.nn as nn, torch.nn.functional as F\nprint('allow_tf32 default:', torch.backends.cuda.matmul.allow_tf32)\nprint('fp32_precision:', getattr(torch.backends.cuda.matmul, 'fp32_precision', 'n/a'))\n\nin_features, out_features, scaling = 4096, 4096, 0.5\nbatch = 16384\n\ntorch.manual_seed(42)\nlin = nn.Linear(in_features, out_features).cuda()\nx = torch.rand(batch, in_features, device='cuda')\n\ndef clear_l2():\n    d = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef time_fn(fn, trials=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    times = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times), min(times)\n\nwith torch.no_grad("]
[525.379575, "i", "):\n    print('F.linear fp32:', time_fn(lambda: F.linear(x, lin.weight, lin.bias)))\n    torch.backends.cuda.matmul.allow_tf32 = True\n    print('F.linear tf32:', time_fn(lambda: F.linear(x, lin.weight, lin.bias)))\n    torch.backends.cuda.matmul.allow_tf32 = False\n    def full_ref():\n        y = F.linear(x, lin.weight, lin.bias)\n        oy = y.clone().detach()\n        return y * scaling + oy\n    print('full ref (fused ops):', time_fn(full_ref))\n    y = F.linear(x, lin.weight, lin.bias)\n    print('elemwise only:', time_fn(lambda: y * scaling + y))\n    print('clone only:', time_fn(lambda: y.clone()))\n    # fp16/bf16 matmul timing for reference\n    xh = x.half(); wh = lin.weight.half()\n    print('F.linear fp16:', time_fn(lambda: F.linear(xh, wh)))\n    xb = x.bfloat16(); wb = lin.weight.bfloat16()\n    print('F.linear bf16:', time_fn(lambda: F.linear(xb, wb)))\nEOF\ngpu run -- bash -c \"python3 /workspace/diag.py > /workspace/diag_out.txt 2>&1; echo done\"\n"]
