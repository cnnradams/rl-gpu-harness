[850.272229, "o", "\u001b[?2004h> "]
[850.27232, "o", "    tl.store(hi_ptr + offs, hi, mask=mask)\r\n\u001b[?2004l\r"]
[850.272344, "o", "\u001b[?2004h> "]
[850.272439, "o", "    tl.store(lo_ptr + offs, lo, mask=mask)\r\n\u001b[?2004l\r"]
[850.272469, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r(\u001b[?2004h"]
[850.272497, "o", "> "]
[850.272527, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.272551, "o", "> "]
[850.272576, "o", "def _gemm_v2(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.27272, "o", "    ahi_ptr, alo_ptr, bhi_ptr, blo_ptr, bias_ptr, c_ptr,\r\n\u001b[?2004l\r"]
[850.272748, "o", "\u001b[?2004h> "]
[850.272775, "o", "    M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.272799, "o", "> "]
[850.272862, "o", "    sam, sak, sbk, sbn, scm, scn,\r\n\u001b[?2004l\r"]
[850.27289, "o", "\u001b[?2004h> "]
[850.273051, "o", "    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[850.273079, "o", "\u001b[?2004h> "]
[850.273128, "o", "    GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r"]
[850.273152, "o", "\u001b[?2004h> ):\r\n\u001b[?2004l\r"]
[850.273176, "o", "\u001b[?2004h> "]
[850.27323, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[850.273254, "o", "\u001b[?2004h> "]
[850.273322, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[850.273351, "o", "\u001b[?2004h> "]
[850.273419, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[850.273446, "o", "\u001b[?2004h> "]
[850.273497, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\rstride(0), whi"]
[850.273525, "o", "\u001b[?2004h> "]
[850.273581, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[850.273609, "o", "\u001b[?2004h> "]
[850.273756, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[850.273778, "o", "\u001b[?2004h> "]
[850.273891, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[850.273915, "o", "\u001b[?2004h> "]
[850.274002, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[850.274031, "o", "\u001b[?2004h> "]
[850.274121, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[850.274143, "o", "\u001b[?2004h> "]
[850.274194, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[850.274222, "o", "\u001b[?2004h> "]
[850.274247, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.274275, "o", "> "]
[850.274325, "o", "    ahi_ptrs = ahi_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[850.274348, "o", "\u001b[?2004h> "]
[850.274411, "o", "    alo_ptrs = alo_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[850.274436, "o", "\u001b[?2004h> "]
[850.274501, "o", "    bhi_ptrs = bhi_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[850.274529, "o", "\u001b[?2004h> "]
[850.274584, "o", "    blo_ptrs = blo_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[850.274607, "o", "\u001b[?2004h> "]
[850.274662, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[850.27469, "o", "\u001b[?2004h> "]
[850.274726, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[850.274754, "o", "\u001b[?2004h> "]
[850.274781, "o", "        ahi = tl.load(ahi_ptrs)\r\n\u001b[?2004l\r"]
[850.274808, "o", "\u001b[?2004h> "]
[850.274832, "o", "        alo = tl.load(alo_ptrs)\r\n\u001b[?2004l\r"]
[850.274856, "o", "\u001b[?2004h> "]
[850.274884, "o", "        bhi = tl.load(bhi_ptrs)\r\n\u001b[?2004l\r"]
[850.274909, "o", "\u001b[?2004h> "]
[850.274933, "o", "        blo = tl.load(blo_ptrs)\r\n\u001b[?2004l\r"]
[850.274958, "o", "\u001b[?2004h> "]
[850.274991, "o", "        acc = tl.dot(ahi, bhi, acc)\r\n\u001b[?2004l\r"]
[850.27502, "o", "\u001b[?2004h> "]
[850.275046, "o", "        acc = tl.dot(ahi, blo, acc)\r\n\u001b[?2004l\r"]
[850.27507, "o", "\u001b[?2004h> "]
[850.275098, "o", "        acc = tl.dot(alo, bhi, acc)\r\n\u001b[?2004l\r"]
[850.275125, "o", "\u001b[?2004h> "]
[850.275152, "o", "        ahi_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r"]
[850.275177, "o", "\u001b[?2004h> "]
[850.275205, "o", "        alo_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r"]
[850.275233, "o", "\u001b[?2004h> "]
[850.27526, "o", "        bhi_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[850.275284, "o", "\u001b[?2004h> "]
[850.275312, "o", "        blo_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[850.275335, "o", "\u001b[?2004h> "]
[850.27541, "o", "    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r"]
[850.275434, "o", "\u001b[?2004h> "]
[850.275466, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[850.275496, "o", "\u001b[?2004h> "]
[850.275543, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[850.275571, "o", "\u001b[?2004h> "]
[850.275614, "o", "    mask = (rm[:, None] < M) & (rn[None, :] < N)\r\n\u001b[?2004l\r"]
[850.275643, "o", "\u001b[?2004h> "]
[850.275671, "o", "    tl.store(c_ptrs, acc, mask=mask)\r\n\u001b[?2004l\r"]
[850.275699, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[850.275723, "o", "> "]
[850.275761, "o", "in_features, out_features, scaling = 4096, 4096, 0.5\r\n\u001b[?2004l\r"]
[850.275787, "o", "\u001b[?2004h> "]
[850.275816, "o", "batch = 16384\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[850.275841, "o", "\u001b[?2004h> "]
[850.27587, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.275924, "o", "lin = nn.Linear(in_features, out_features).cuda()\r\n\u001b[?2004l\r"]
[850.275952, "o", "\u001b[?2004h> "]
[850.27598, "o", "w = lin.weight * 1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.276008, "o", "> b = lin.bias * 1.5\r\n\u001b[?2004l\r"]
[850.276034, "o", "\u001b[?2004h> "]
[850.276078, "o", "x = torch.rand(batch, in_features, device='cuda')\r\n\u001b[?2004l\r"]
[850.276103, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[850.276128, "o", "> "]
[850.276174, "o", "w_hi = w.half(); w_lo = (w - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[850.276203, "o", "\u001b[?2004h> "]
[850.276253, "o", "whi_t = w_hi.t().contiguous(); wlo_t = w_lo.t().contiguous()\r\n\u001b[?2004l\r"]
[850.276281, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[850.276303, "o", "> "]
[850.276327, "o", "ref = F.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.276388, "o", "x_hi = x.half(); x_lo = (x - x_hi.float()).half()\r\n\u001b[?2004l\r"]
[850.276413, "o", "\u001b[?2004h> "]
[850.276441, "o", "M, K = x.shape; N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.276469, "o", "> "]
[850.276526, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[850.276554, "o", "\u001b[?2004h> "]
[850.276648, "o", "_gemm_v2[(triton.cdiv(M,128)*triton.cdiv(N,128),)](x_hi, x_lo, whi_t, wlo_t, b, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.276676, "o", "> "]
[850.276767, "o", "    x_hi.stride(0), x_hi.stride(1), whi_t.stride(0), whi_t.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[850.276791, "o", "\u001b[?2004h> "]
[850.276869, "o", "    BLOCK_M=128, BLOCK_N=128, BLOCK_K=64, GROUP_M=8, num_warps=8, num_stages=3)\r\n\u001b[?2004l\r"]
[850.276898, "o", "\u001b[?2004h> "]
[850.276926, "o", "d = (ref - out).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.276957, "o", "tol = 1e-4 + 1e-4*ref.abs()\r\n\u001b[?2004l\r"]
[850.276984, "o", "\u001b[?2004h> "]
[850.277054, "o", "print('v2 max diff:', d.max().item(), 'rel to tol:', (d/tol).max().item())\r\n\u001b[?2004l\r"]
[850.277081, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[850.277105, "o", "> def clear_l2():\r\n\u001b[?2004l\r"]
[850.277133, "o", "\u001b[?2004h> "]
[850.277203, "o", "    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[850.277231, "o", "\u001b[?2004h> "]
[850.277259, "o", "    dd.fill_(42); del dd\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[850.277282, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[850.277313, "o", "def time_fn(fn, trials=20):\r\n\u001b[?2004l\r"]
[850.277341, "o", "\u001b[?2004h> "]
[850.277365, "o", "    for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.277415, "o", "        fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[850.277438, "o", "\u001b[?2004h> "]
[850.277466, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.277501, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r"]
[850.277529, "o", "\u001b[?2004h> "]
[850.277557, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[850.277585, "o", "\u001b[?2004h> "]
[850.277667, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[850.277696, "o", "\u001b[?2004h> "]
[850.277724, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.277762, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[850.277791, "o", "\u001b[?2004h> "]
[850.277817, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[850.277841, "o", "\u001b[?2004h> "]
[850.277876, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[850.2779, "o", "\u001b[?2004h> "]
[850.277928, "o", "    times = times[1:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.277952, "o", "> "]
[850.277982, "o", "    return sum(times)/len(times), min(times)\r\n\u001b[?2004l\r"]
[850.278011, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.278038, "o", "n_elem = M*K\r\n\u001b[?2004l\r"]
[850.278066, "o", "\u001b[?2004h> "]
[850.278094, "o", "def presplit():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.278186, "o", "    _split_kernel[(triton.cdiv(n_elem, 4096),)](x, x_hi, x_lo, n_elem, BLOCK=4096, num_warps=8)\r\n\u001b[?2004l\r"]
[850.27821, "o", "\u001b[?2004h> "]
[850.278245, "o", "print('presplit:', time_fn(presplit))\r\n\u001b[?2004l\r"]
[850.278268, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[850.278296, "o", "> configs = [\r\n\u001b[?2004l\r"]
[850.278319, "o", "\u001b[?2004h> "]
[850.278347, "o", "    (128,128,64,8,8,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.27838, "o", "    (128,128,64,8,8,4),\r\n\u001b[?2004l\r"]
[850.278408, "o", "\u001b[?2004h> "]
[850.278432, "o", "    (128,128,32,8,8,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.278456, "o", "> "]
[850.278489, "o", "    (128,128,32,8,8,5),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.278521, "o", "    (128,256,64,8,8,3),\r\n\u001b[?2004l\r"]
[850.278545, "o", "\u001b[?2004h> "]
[850.278574, "o", "    (256,128,64,8,8,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.278606, "o", "    (128,256,32,8,8,4),\r\n\u001b[?2004l\r"]
[850.278629, "o", "\u001b[?2004h> "]
[850.278657, "o", "    (256,128,32,8,8,4),\r\n\u001b[?2004l\r"]
[850.278682, "o", "\u001b[?2004h> "]
[850.278707, "o", "    (128,128,64,8,4,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.278736, "o", "    (128,128,128,8,8,2),\r\n\u001b[?2004l\r"]
[850.278764, "o", "\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[850.278786, "o", "\u001b[?2004h> best=None\r\n\u001b[?2004l\r"]
[850.278814, "o", "\u001b[?2004h> "]
[850.278842, "o", "for cfg in configs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.278879, "o", "    bm, bn, bk, gm, nw, ns = cfg\r\n\u001b[?2004l\r"]
[850.278903, "o", "\u001b[?2004h> "]
[850.278954, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[850.278982, "o", "\u001b[?2004h> "]
[850.279006, "o", "    def run():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.279078, "o", "        _gemm_v2[grid](x_hi, x_lo, whi_t, wlo_t, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[850.279102, "o", "\u001b[?2004h> "]
[850.279183, "o", "            x_hi.stride(0), x_hi.stride(1), whi_t.stride(0), whi_t.stride(1),\r\n\u001b[?2004l\r"]
[850.279209, "o", "\u001b[?2004h> "]
[850.279242, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[850.27927, "o", "\u001b[?2004h> "]
[850.279354, "o", "            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[850.279376, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[850.279404, "o", "\u001b[?2004h> "]
[850.279429, "o", "        t = time_fn(run)\r\n\u001b[?2004l\r"]
[850.279452, "o", "\u001b[?2004h> "]
[850.279514, "o", "        print(f'v2 cfg {cfg}: mean {t[0]:.3f} min {t[1]:.3f}')\r\n\u001b[?2004l\r"]
[850.279544, "o", "\u001b[?2004h> "]
[850.279595, "o", "        if best is None or t[0] < best[0]: best=(t[0],cfg)\r\n\u001b[?2004l\r"]
[850.279622, "o", "\u001b[?2004h> "]
[850.279649, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[850.279678, "o", "\u001b[?2004h> "]
[850.279721, "o", "        print(f'v2 cfg {cfg}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r"]
[850.279745, "o", "\u001b[?2004h> "]
[850.279773, "o", "print('BEST v2:', best)\r\n\u001b[?2004l\r"]
[850.279797, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[850.279821, "o", "def full():\r\n\u001b[?2004l\r\u001b[?2004h"]
[850.279846, "o", ">     presplit()\r\n\u001b[?2004l\r"]
[850.279874, "o", "\u001b[?2004h> "]
[850.279901, "o", "    bm,bn,bk,gm,nw,ns = best[1]\r\n\u001b[?2004l\r"]
[850.279929, "o", "\u001b[?2004h> "]
[850.279975, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[850.280003, "o", "\u001b[?2004h> "]
[850.28006, "o", "    _gemm_v2[grid](x_hi, x_lo, whi_t, wlo_t, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[850.280087, "o", "\u001b[?2004h> "]
[850.280155, "o", "        x_hi.stride(0), x_hi.stride(1), whi_t.stride(0), whi_t.stride(1),\r\n\u001b[?2004l\r"]
[850.280183, "o", "\u001b[?2004h> "]
[850.280221, "o", "        out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[850.280249, "o", "\u001b[?2004h> "]
[850.280328, "o", "        BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[850.280356, "o", "\u001b[?2004h> "]
[850.280401, "o", "print('full v2 (presplit+gemm):', time_fn(full))\r\n\u001b[?2004l\r"]
[850.280428, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[850.282218, "o", "\u001b[?2004hroot@modal:/# "]
[850.282268, "o", "gpu run -- python3 /workspace/v2.py\r\n\u001b[?2004l\r"]
