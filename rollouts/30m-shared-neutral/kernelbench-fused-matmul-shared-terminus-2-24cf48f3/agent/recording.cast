[1260.207072, "o", "\u001b[?2004h> "]
[1260.207099, "o", "    GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.207135, "o", "):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.207169, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1260.207192, "o", "\u001b[?2004h> "]
[1260.207229, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1260.207251, "o", "\u001b[?2004h> "]
[1260.207283, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1260.20731, "o", "\u001b[?2004h> "]
[1260.207335, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1260.207355, "o", "\u001b[?2004h> "]
[1260.207389, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1260.207411, "o", "\u001b[?2004h> "]
[1260.20749, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.207512, "o", "> "]
[1260.207567, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.207592, "o", "> "]
[1260.207628, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1260.207653, "o", "\u001b[?2004h> "]
[1260.207704, "o", "    rm = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[1260.207725, "o", "\u001b[?2004h> "]
[1260.207778, "o", "    rn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1260.207805, "o", "\u001b[?2004h> "]
[1260.207834, "o", "    rk = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[1260.207859, "o", "\u001b[?2004h> "]
[1260.20792, "o", "    a_ptrs = a_ptr + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[1260.207946, "o", "\u001b[?2004h> "]
[1260.208002, "o", "    b_ptrs = b_ptr + rk[:, None] * sbk + rn[None, :] * sbn\r\n\u001b[?2004l\r"]
[1260.208028, "o", "\u001b[?2004h> "]
[1260.208085, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1260.208106, "o", "\u001b[?2004h> "]
[1260.208159, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r"]
[1260.208248, "o", "\u001b[?2004h>         a = tl.load(a_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.208294, "o", "        b = tl.load(b_ptrs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.208327, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r"]
[1260.208349, "o", "\u001b[?2004h> "]
[1260.208385, "o", "        a_ptrs += BLOCK_K * sak\r\n\u001b[?2004l\r"]
[1260.208407, "o", "\u001b[?2004h> "]
[1260.208438, "o", "        b_ptrs += BLOCK_K * sbk\r\n\u001b[?2004l\r"]
[1260.20846, "o", "\u001b[?2004h> "]
[1260.208545, "o", "    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.208586, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r"]
[1260.208612, "o", "\u001b[?2004h> "]
[1260.208674, "o", "    c_ptrs = c_ptr + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.208738, "o", "    mask = (rm[:, None] < M) & (rn[None, :] < N)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.208763, "o", "> "]
[1260.208798, "o", "    tl.store(c_ptrs, acc, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.208826, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.208892, "o", "in_features, out_features, scaling = 4096, 4096, 0.5\r\n\u001b[?2004l\r"]
[1260.208914, "o", "\u001b[?2004h> "]
[1260.208935, "o", "batch = 16384\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.208958, "o", "> "]
[1260.208984, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.209007, "o", "> "]
[1260.209051, "o", "lin = nn.Linear(in_features, out_features).cuda()\r\n\u001b[?2004l\r"]
[1260.209078, "o", "\u001b[?2004h> "]
[1260.209103, "o", "w = lin.weight * 1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.209129, "o", "> "]
[1260.209157, "o", "b = (lin.bias * 1.5).contiguous()\r\n\u001b[?2004l\r"]
[1260.209178, "o", "\u001b[?2004h> "]
[1260.209234, "o", "x = torch.rand(batch, in_features, device='cuda')\r\n\u001b[?2004l\r"]
[1260.209255, "o", "\u001b[?2004h> "]
[1260.209287, "o", "ref = F.linear(x, w, b)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1260.209308, "o", "\u001b[?2004h> "]
[1260.209373, "o", "w_hi = w.half(); w_lo = (w - w_hi.float()).half()\r\n\u001b[?2004l\r"]
[1260.209395, "o", "\u001b[?2004h> "]
[1260.209484, "o", "B3 = torch.cat([w_hi.t(), w_lo.t(), w_hi.t()], dim=0).contiguous()  # (3K, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.20954, "o", "M, K = x.shape; N = w.shape[0]; K3 = 3*K\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.209567, "o", "> "]
[1260.209625, "o", "A3 = torch.empty((M, K3), device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.209646, "o", "> "]
[1260.209709, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1260.209735, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.20976, "o", "> "]
[1260.20979, "o", "grid_split = (triton.cdiv(K, 1024), M)\r\n\u001b[?2004l\r"]
[1260.209815, "o", "\u001b[?2004h> "]
[1260.209886, "o", "_split_cat_kernel[grid_split](x, A3, M, K, A3.stride(0), BLOCK=1024)\r\n\u001b[?2004l\r"]
[1260.209909, "o", "\u001b[?2004h> "]
[1260.209993, "o", "_gemm_std[(triton.cdiv(M,128)*triton.cdiv(N,256),)](A3, B3, b, out, M, N, K3,\r\n\u001b[?2004l\r"]
[1260.210016, "o", "\u001b[?2004h> "]
[1260.210108, "o", "    A3.stride(0), A3.stride(1), B3.stride(0), B3.stride(1), out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[1260.210145, "o", "\u001b[?2004h> "]
[1260.210222, "o", "    BLOCK_M=128, BLOCK_N=256, BLOCK_K=64, GROUP_M=8, num_warps=8, num_stages=4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.21025, "o", "> "]
[1260.210275, "o", "d = (ref - out).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.210311, "o", "tol = 1e-4 + 1e-4*ref.abs()\r\n\u001b[?2004l\r"]
[1260.210339, "o", "\u001b[?2004h> "]
[1260.210411, "o", "print('v4 max diff:', d.max().item(), 'rel to tol:', (d/tol).max().item())\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.21044, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.210467, "o", "def clear_l2():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.210489, "o", "> "]
[1260.210557, "o", "    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1260.210581, "o", "\u001b[?2004h> "]
[1260.210607, "o", "    dd.fill_(42); del dd\r\n\u001b[?2004l\r"]
[1260.210629, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.210651, "o", "> "]
[1260.210681, "o", "def time_fn(fn, trials=20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.210708, "o", "> "]
[1260.21073, "o", "    for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.210754, "o", "> "]
[1260.210784, "o", "        fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1260.21081, "o", "\u001b[?2004h>     times = []\r\n\u001b[?2004l\r"]
[1260.210831, "o", "\u001b[?2004h> "]
[1260.210869, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.210892, "o", "> "]
[1260.210917, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1260.21094, "o", "\u001b[?2004h> "]
[1260.21104, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211066, "o", "> "]
[1260.211088, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.211136, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1260.211163, "o", "\u001b[?2004h> "]
[1260.2112, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1260.211223, "o", "\u001b[?2004h> "]
[1260.211259, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1260.211281, "o", "\u001b[?2004h> "]
[1260.211314, "o", "    times = times[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.211367, "o", "    return sum(times)/len(times), min(times)\r\n\u001b[?2004l\r"]
[1260.211393, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211418, "o", "> "]
[1260.211462, "o", "# ceiling: cublas fp16 gemm same shape (fp16 out)\r\n\u001b[?2004l\r"]
[1260.21149, "o", "\u001b[?2004h> "]
[1260.211548, "o", "A3c = torch.rand((M, K3), device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211574, "o", "> "]
[1260.211632, "o", "print('cublas fp16 (M,3K)@(3K,N):', time_fn(lambda: A3c @ B3))\r\n\u001b[?2004l\r"]
[1260.211659, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.211684, "o", "configs = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211707, "o", "> "]
[1260.211732, "o", "    (128,256,64,8,8,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211753, "o", "> "]
[1260.211777, "o", "    (128,256,64,8,8,5),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211802, "o", "> "]
[1260.211827, "o", "    (128,256,64,8,4,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211852, "o", "> "]
[1260.211873, "o", "    (256,128,64,8,8,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211898, "o", "> "]
[1260.211923, "o", "    (128,256,32,8,8,6),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.211949, "o", "> "]
[1260.211974, "o", "    (64,256,64,8,4,4),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.212, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.212026, "o", "best=None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.212052, "o", "for cfg in configs:\r\n\u001b[?2004l\r"]
[1260.212073, "o", "\u001b[?2004h> "]
[1260.212109, "o", "    bm, bn, bk, gm, nw, ns = cfg\r\n\u001b[?2004l\r"]
[1260.212136, "o", "\u001b[?2004h> "]
[1260.212203, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.212228, "o", ">     def run():\r\n\u001b[?2004l\r"]
[1260.212259, "o", "\u001b[?2004h> "]
[1260.21231, "o", "        _gemm_std[grid](A3, B3, b, out, M, N, K3,\r\n\u001b[?2004l\r"]
[1260.212335, "o", "\u001b[?2004h> "]
[1260.212405, "o", "            A3.stride(0), A3.stride(1), B3.stride(0), B3.stride(1),\r\n\u001b[?2004l\r"]
[1260.21243, "o", "\u001b[?2004h> "]
[1260.212475, "o", "            out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[1260.212499, "o", "\u001b[?2004h> "]
[1260.21259, "o", "            BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1260.212616, "o", ">     try:\r\n\u001b[?2004l\r"]
[1260.212638, "o", "\u001b[?2004h> "]
[1260.212668, "o", "        t = time_fn(run)\r\n\u001b[?2004l\r"]
[1260.212692, "o", "\u001b[?2004h> "]
[1260.212759, "o", "        print(f'v4 cfg {cfg}: mean {t[0]:.3f} min {t[1]:.3f}')\r\n\u001b[?2004l\r"]
[1260.212786, "o", "\u001b[?2004h> "]
[1260.212843, "o", "        if best is None or t[0] < best[0]: best=(t[0],cfg)\r\n\u001b[?2004l\r"]
[1260.212869, "o", "\u001b[?2004h> "]
[1260.212897, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1260.212918, "o", "\u001b[?2004h> "]
[1260.212985, "o", "        print(f'v4 cfg {cfg}: FAIL {type(ex).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1260.213028, "o", "print('BEST v4:', best)\r\n\u001b[?2004l\r"]
[1260.213053, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1260.335968, "o", "\u001b[?2004hroot@modal:/# gpu run -- bash -c \"python3 /workspace/v4.py > /workspace/v4_out.txt 2>&1; echo done\"\r\n\u001b[?2004l\r"]
