[1715.857717, "o", "\u001b[?2004h> "]
[1715.857746, "o", "M, K = x.shape; N = w.shape[0]\r\n\u001b[?2004l\r"]
[1715.857776, "o", "\u001b[?2004h> "]
[1715.857834, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1715.857861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.857888, "o", "> def clear_l2():\r\n\u001b[?2004l\r"]
[1715.857918, "o", "\u001b[?2004h> "]
[1715.857991, "o", "    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[1715.858015, "o", "\u001b[?2004h> "]
[1715.85804, "o", "    dd.fill_(42); del dd\r\n\u001b[?2004l\r"]
[1715.858065, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.858093, "o", "> "]
[1715.858118, "o", "def time_fn(fn, trials=20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.858143, "o", "> "]
[1715.858166, "o", "    for _ in range(3):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1715.858224, "o", "        fn(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1715.858251, "o", "\u001b[?2004h> "]
[1715.85828, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1715.858312, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r"]
[1715.858339, "o", "\u001b[?2004h> "]
[1715.858371, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1715.8584, "o", "\u001b[?2004h> "]
[1715.858489, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[1715.858516, "o", "\u001b[?2004h> "]
[1715.858541, "o", "        clear_l2()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.858565, "o", "> "]
[1715.858594, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[1715.858622, "o", "\u001b[?2004h> "]
[1715.858652, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1715.858676, "o", "\u001b[?2004h> "]
[1715.858717, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1715.858747, "o", "\u001b[?2004h> "]
[1715.858772, "o", "    times = times[1:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1715.858832, "o", "    return sum(times)/len(times), min(times)\r\n\u001b[?2004l\r"]
[1715.858857, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.858883, "o", "> configs = [\r\n\u001b[?2004l\r"]
[1715.858907, "o", "\u001b[?2004h> "]
[1715.858936, "o", "    (128,256,64,8,8,3),\r\n\u001b[?2004l\r"]
[1715.858961, "o", "\u001b[?2004h> "]
[1715.858987, "o", "    (128,128,64,8,8,3),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1715.859027, "o", "    (128,256,32,8,8,4),\r\n\u001b[?2004l\r"]
[1715.859052, "o", "\u001b[?2004h> "]
[1715.859079, "o", "    (128,128,32,8,8,4),\r\n\u001b[?2004l\r"]
[1715.859103, "o", "\u001b[?2004h> "]
[1715.859128, "o", "    (128,128,64,8,8,4),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.859153, "o", "> "]
[1715.859178, "o", "    (256,128,64,8,8,3),\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.859199, "o", "> ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.859223, "o", "> best=None\r\n\u001b[?2004l\r"]
[1715.859248, "o", "\u001b[?2004h> "]
[1715.859273, "o", "for cfg in configs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.859307, "o", "> "]
[1715.859334, "o", "    bm, bn, bk, gm, nw, ns = cfg\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.85936, "o", ">     try:\r\n\u001b[?2004l\r"]
[1715.859385, "o", "\u001b[?2004h> "]
[1715.859453, "o", "        x_desc = TensorDescriptor(x, x.shape, x.stride(), [bm, bk])\r\n\u001b[?2004l\r"]
[1715.859478, "o", "\u001b[?2004h> "]
[1715.859556, "o", "        bhi_desc = TensorDescriptor(Bhi, Bhi.shape, Bhi.stride(), [bk, bn])\r\n\u001b[?2004l\r"]
[1715.859584, "o", "\u001b[?2004h> "]
[1715.859659, "o", "        blo_desc = TensorDescriptor(Blo, Blo.shape, Blo.stride(), [bk, bn])\r\n\u001b[?2004l\r"]
[1715.85969, "o", "\u001b[?2004h> "]
[1715.859759, "o", "        c_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\r\n\u001b[?2004l\r"]
[1715.859784, "o", "\u001b[?2004h> "]
[1715.859842, "o", "        grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[1715.859872, "o", "\u001b[?2004h> "]
[1715.8599, "o", "        def run():\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.859924, "o", "> "]
[1715.859992, "o", "            _gemm_fused[grid](x_desc, bhi_desc, blo_desc, b, c_desc, M, N, K,\r\n\u001b[?2004l\r"]
[1715.860018, "o", "\u001b[?2004h> "]
[1715.860112, "o", "                BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1715.860137, "o", "\u001b[?2004h> "]
[1715.860195, "o", "        run(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.860224, "o", "> "]
[1715.86028, "o", "        d = (ref - out).abs(); tol = 1e-4 + 1e-4*ref.abs()\r\n\u001b[?2004l\r"]
[1715.860319, "o", "\u001b[?2004h> "]
[1715.860344, "o", "        rel = (d/tol).max().item()\r\n\u001b[?2004l\r"]
[1715.860365, "o", "\u001b[?2004h> "]
[1715.860396, "o", "        t = time_fn(run)\r\n\u001b[?2004l\r"]
[1715.860427, "o", "\u001b[?2004h> "]
[1715.860502, "o", "        print(f'v7 cfg {cfg}: mean {t[0]:.3f} min {t[1]:.3f} rel {rel:.3f}')\r\n\u001b[?2004l\r"]
[1715.860529, "o", "\u001b[?2004h> "]
[1715.860588, "o", "        if best is None or t[0] < best[0]: best=(t[0],cfg)\r\n\u001b[?2004l\r"]
[1715.860615, "o", "\u001b[?2004h> "]
[1715.860642, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1715.860671, "o", "\u001b[?2004h> "]
[1715.860734, "o", "        print(f'v7 cfg {cfg}: FAIL {type(ex).__name__}: {ex}')\r\n\u001b[?2004l\r"]
[1715.860762, "o", "\u001b[?2004h> "]
[1715.860788, "o", "print('BEST v7:', best)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1715.860814, "o", "> EOF\r\n\u001b[?2004l\r"]
[1715.92138, "o", "\u001b[?2004hroot@modal:/# gpu run -- bash -c \"python3 /workspace/v7.py > /workspace/v7_out.txt 2>&1; echo done\"\r\n\u001b[?2004l\r"]
