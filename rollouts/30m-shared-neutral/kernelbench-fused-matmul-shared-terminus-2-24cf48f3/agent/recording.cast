[209.935529, "o", "\u001b[?2004h> "]
[209.935594, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[209.93562, "o", "\u001b[?2004h> "]
[209.935647, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[209.935673, "o", "\u001b[?2004h> "]
[209.935723, "o", "        lin = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[209.935751, "o", "\u001b[?2004h> "]
[209.935787, "o", "        s = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r"]
[209.935813, "o", "\u001b[?2004h> "]
[209.935839, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[209.935865, "o", "\u001b[?2004h> "]
[209.935897, "o", "            lin.weight.mul_(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.935925, "o", "> "]
[209.93595, "o", "            lin.bias.mul_(s)\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.935976, "o", "> "]
[209.936001, "o", "        self.weight = lin.weight\r\n\u001b[?2004l\r"]
[209.936026, "o", "\u001b[?2004h> "]
[209.936051, "o", "        self.bias = lin.bias\r\n\u001b[?2004l\r"]
[209.936074, "o", "\u001b[?2004h> "]
[209.9361, "o", "        self._w_t = None\r\n\u001b[?2004l\r"]
[209.936126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[209.936152, "o", "\u001b[?2004h> "]
[209.9362, "o", "    def _prep(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.936271, "o", "        self._w_t = self.weight.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[209.936299, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.936339, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[209.936367, "o", "> "]
[209.936433, "o", "        if x.is_cuda and x.dtype == torch.float32 and x.dim() == 2:\r\n\u001b[?2004l\r"]
[209.936459, "o", "\u001b[?2004h> "]
[209.936524, "o", "            if self._w_t is None or self._w_t.device != x.device:\r\n\u001b[?2004l\r"]
[209.93655, "o", "\u001b[?2004h> "]
[209.936575, "o", "                self._prep()\r\n\u001b[?2004l\r"]
[209.9366, "o", "\u001b[?2004h> "]
[209.93663, "o", "            M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.936685, "o", "            N = self._w_t.shape[1]\r\n\u001b[?2004l\r"]
[209.936711, "o", "\u001b[?2004h> "]
[209.936786, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[209.936812, "o", "\u001b[?2004h> "]
[209.936862, "o", "            bm, bn, bk, gm, nw, ns = _BEST_CONFIG\r\n\u001b[?2004l\r"]
[209.936888, "o", "\u001b[?2004h> "]
[209.93695, "o", "            grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[209.936976, "o", "\u001b[?2004h> "]
[209.937011, "o", "            _gemm_bias_kernel[grid](\r\n\u001b[?2004l\r"]
[209.937039, "o", "\u001b[?2004h> "]
[209.937081, "o", "                x, self._w_t, self.bias, out,\r\n\u001b[?2004l\r"]
[209.937106, "o", "\u001b[?2004h> "]
[209.937133, "o", "                M, N, K,\r\n\u001b[?2004l\r"]
[209.937158, "o", "\u001b[?2004h> "]
[209.937203, "o", "                x.stride(0), x.stride(1),\r\n\u001b[?2004l\r"]
[209.937233, "o", "\u001b[?2004h> "]
[209.937285, "o", "                self._w_t.stride(0), self._w_t.stride(1),\r\n\u001b[?2004l\r"]
[209.937313, "o", "\u001b[?2004h> "]
[209.937355, "o", "                out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[209.937381, "o", "\u001b[?2004h> "]
[209.937444, "o", "                BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm,\r\n\u001b[?2004l\r"]
[209.937469, "o", "\u001b[?2004h> "]
[209.93753, "o", "                IP=\"tf32x3\", num_warps=nw, num_stages=ns,\r\n\u001b[?2004l\r"]
[209.937557, "o", "\u001b[?2004h> "]
[209.937585, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[209.93761, "o", "            return out\r\n\u001b[?2004l\r"]
