[1386.355385, "i", "cat > /workspace/v5.py << 'EOF'\nimport torch, triton, torch.nn as nn, torch.nn.functional as F\nimport triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\n@triton.jit\ndef _split_cat_kernel(x_ptr, a3_ptr, M, K, sa, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < K\n    x = tl.load(x_ptr + row * K + offs, mask=mask)\n    hi = x.to(tl.float16)\n    lo = (x - hi.to(tl.float32)).to(tl.float16)\n    base = a3_ptr + row * sa\n    tl.store(base + offs, hi, mask=mask)\n    tl.store(base + K + offs, hi, mask=mask)\n    tl.store(base + 2 * K + offs, lo, mask=mask)\n\n@triton.jit\ndef _gemm_tma(\n    a_desc, b_desc, bias_ptr, c_desc,\n    M, N, K,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = t"]
[1386.355434, "i", "l.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BLOCK_K)):\n        a = a_desc.load([off_m, k * BLOCK_K])\n        b = b_desc.load([k * BLOCK_K, off_n])\n        acc = tl.dot(a, b, acc)\n    rn = off_n + tl.arange(0, BLOCK_N)\n    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc.to(tl.float32))\n\nin_features, out_features, scaling = 4096, 4096, 0.5\nbatch = 16384\ntorch.manual_seed(42)\nlin = nn.Linear(in_features, out_features).cuda()\nw = lin.weight * 1.5\nb = (lin.bias * 1.5).contiguous()\nx = torch.rand(batch, in_features, device='cuda')\nref = F.linear(x, w, b)\n\nw_hi = w.half(); w_lo = (w - w_hi.float()).half()\nB3 = torch.cat([w_hi.t(), w_lo.t(), w_hi.t()], dim=0).contiguous()\nM, K = x.shape; N = w"]
[1386.355541, "i", ".shape[0]; K3 = 3*K\nA3 = torch.empty((M, K3), device='cuda', dtype=torch.float16)\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ngrid_split = (triton.cdiv(K, 2048), M)\n_split_cat_kernel[grid_split](x, A3, M, K, A3.stride(0), BLOCK=2048, num_warps=8)\n\ndef clear_l2():\n    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    dd.fill_(42); del dd\n\ndef time_fn(fn, trials=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    times = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times), min(times)\n\ndef split_only():\n    _split_cat_kernel[grid_split](x, A3, M, K, A3.stride(0), BLOCK=2048, num_warps=8)\nprint('split+cat v5:', time_fn(split_only))\n\n# correctness of tma kernel\nbm, bn, bk "]
[1386.355577, "o", "cat > /workspace/v5.py << 'EOF'\r\n\u001b[?2004l\r"]
[1386.355599, "i", "= 128, 256, 64\na_desc = TensorDescriptor(A3, A3.shape, A3.stride(), [bm, bk])\nb_desc = TensorDescriptor(B3, B3.shape, B3.stride(), [bk, bn])\nc_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\ngrid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n_gemm_tma[grid](a_desc, b_desc, b, c_desc, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, num_warps=8, num_stages=4)\nd = (ref - out).abs()\ntol = 1e-4 + 1e-4*ref.abs()\nprint('v5 tma max diff:', d.max().item(), 'rel:', (d/tol).max().item())\n\nconfigs = [\n    (128,256,64,8,8,4),\n    (128,256,64,8,8,3),\n    (256,128,64,8,8,3),\n    (128,128,64,8,8,4),\n    (128,256,128,8,8,2),\n    (256,128,128,8,8,2),\n    (128,512,64,8,8,2),\n    (256,256,64,8,8,2),\n]\nbest=None\nfor cfg in configs:\n    bm, bn, bk, gm, nw, ns = cfg\n    try:\n        a_desc = TensorDescriptor(A3, A3.shape, A3.stride(), [bm, bk])\n        b_desc = TensorDescriptor(B3, B3.shape, B3.stride(), [bk, bn])\n        c_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\n        grid = (trito"]
[1386.355627, "o", "\u001b[?2004h> "]
[1386.355654, "i", "n.cdiv(M, bm) * triton.cdiv(N, bn),)\n        def run():\n            _gemm_tma[grid](a_desc, b_desc, b, c_desc, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\n        t = time_fn(run)\n        print(f'v5 tma cfg {cfg}: mean {t[0]:.3f} min {t[1]:.3f}')\n        if best is None or t[0] < best[0]: best=(t[0],cfg)\n    except Exception as ex:\n        print(f'v5 tma cfg {cfg}: FAIL {type(ex).__name__}: {ex}')\nprint('BEST v5:', best)\n\nbm,bn,bk,gm,nw,ns = best[1]\na_desc = TensorDescriptor(A3, A3.shape, A3.stride(), [bm, bk])\nb_desc = TensorDescriptor(B3, B3.shape, B3.stride(), [bk, bn])\nc_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\ndef full():\n    split_only()\n    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n    _gemm_tma[grid](a_desc, b_desc, b, c_desc, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\nprint('full v5:', time_fn(full))\nEOF\ngpu run -- bash -c \"python3 /workspace/v5.py > /workspace/v5_out.txt 2>&1; echo d"]
[1386.355678, "i", "one\"\n"]
