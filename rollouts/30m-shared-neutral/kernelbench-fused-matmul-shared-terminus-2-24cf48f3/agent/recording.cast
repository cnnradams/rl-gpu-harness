[1386.364498, "o", "> "]
[1386.364545, "o", "    grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\r\n\u001b[?2004l\r"]
[1386.364576, "o", "\u001b[?2004h> "]
[1386.364709, "o", "    _gemm_tma[grid](a_desc, b_desc, b, c_desc, M, N, K3, BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[1386.364735, "o", "\u001b[?2004h> "]
[1386.364767, "o", "print('full v5:', time_fn(full))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1386.364792, "o", "EOF\r\n\u001b[?2004l\r"]
