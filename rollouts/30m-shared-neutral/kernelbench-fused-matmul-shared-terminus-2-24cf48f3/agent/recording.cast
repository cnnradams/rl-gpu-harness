[1599.138794, "o", "\u001b[?2004h> "]
[1599.138858, "o", "B3 = torch.cat([w_hi.t(), w_lo.t(), w_hi.t()], dim=0).contiguous()\r\n\u001b[?2004l\r"]
[1599.138885, "o", "\u001b[?2004h> "]
[1599.138924, "o", "M, K = x.shape; N = w.shape[0]; K3 = 3*K\r\n\u001b[?2004l\r"]
[1599.138953, "o", "\u001b[?2004h> "]
[1599.139018, "o", "A3 = torch.empty((M, K3), device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[1599.139045, "o", "\u001b[?2004h> "]
[1599.139105, "o", "out = torch.empty((M, N), device='cuda', dtype=torch.float32)\r\n\u001b[?2004l\r"]
[1599.139134, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
