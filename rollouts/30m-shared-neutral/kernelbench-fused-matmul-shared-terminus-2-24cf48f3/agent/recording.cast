[1386.364328, "o", "\u001b[?2004h> "]
[1386.364398, "o", "c_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\r\n\u001b[?2004l\r"]
[1386.364425, "o", "\u001b[?2004h> def full():\r\n\u001b[?2004l\r"]
[1386.364449, "o", "\u001b[?2004h> "]
