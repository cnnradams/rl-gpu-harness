[1198.269341, "o", "v3 max diff: 1099.8074951171875 rel to tol: 10870475.0\r\nsplit+cat: (0.22933389481745267, 0.22867199778556824)\r\nv3 cfg (128, 128, 64, 8, 8, 3): mean 3.080 min 3.026\r\nv3 cfg (128, 256, 64, 8, 8, 3): mean 2.415 min 2.404\r\nv3 cfg (256, 128, 64, 8, 8, 3): mean 2.434 min 2.346\r\nv3 cfg (128, 256, 64, 8, 8, 4): mean 2.197 min 2.189\r\nv3 cfg (128, 128, 128, 8, 8, 3): mean 2.879 min 2.726\r\nv3 cfg (128, 256, 128, 8, 8, 2): mean 3.362 min 3.343\r\nv3 cfg (256, 128, 128, 8, 8, 2): mean 3.856 min 3.720\r\nv3 cfg (128, 128, 64, 8, 4, 4): mean 2.528 min 2.505\r\nBEST v3: (2.196892625407169, (128, 256, 64, 8, 8, 4))\r\nfull v3: (2.722132218511481, 2.693311929702759)\r\n"]
