[1386.364157, "o", "> "]
[1386.364223, "o", "a_desc = TensorDescriptor(A3, A3.shape, A3.stride(), [bm, bk])\r\n\u001b[?2004l\r"]
[1386.36425, "o", "\u001b[?2004h> "]
