[1599.137171, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1599.137201, "o", "\u001b[?2004h> "]
[1599.137226, "o", "    grid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1599.137255, "o", "\u001b[?2004h> "]
[1599.137279, "o", "    grid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1599.137308, "o", "\u001b[?2004h> "]
[1599.137336, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1599.137377, "o", "    group_id = pid // width\r\n\u001b[?2004l\r"]
[1599.137407, "o", "\u001b[?2004h> "]
[1599.137465, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1599.137494, "o", "\u001b[?2004h> "]
[1599.137539, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1599.137568, "o", "\u001b[?2004h> "]
[1599.137595, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[1599.13762, "o", "\u001b[?2004h> "]
[1599.137649, "o", "    off_m = pid_m * BLOCK_M\r\n\u001b[?2004l\r"]
[1599.137676, "o", "\u001b[?2004h> "]
[1599.137708, "o", "    off_n = pid_n * BLOCK_N\r\n\u001b[?2004l\r"]
[1599.137734, "o", "\u001b[?2004h> "]
[1599.13778, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1599.13781, "o", "\u001b[?2004h> "]
[1599.137848, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1599.137877, "o", "> "]
[1599.137912, "o", "        a = a_desc.load([off_m, k * BLOCK_K])\r\n\u001b[?2004l\r"]
[1599.137941, "o", "\u001b[?2004h> "]
[1599.137985, "o", "        b = b_desc.load([k * BLOCK_K, off_n])\r\n\u001b[?2004l\r"]
[1599.138012, "o", "\u001b[?2004h> "]
[1599.138037, "o", "        acc = tl.dot(a, b, acc)\r\n\u001b[?2004l\r"]
[1599.138067, "o", "\u001b[?2004h> "]
[1599.138102, "o", "    rn = off_n + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1599.138129, "o", "\u001b[?2004h> "]
[1599.138209, "o", "    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1599.138233, "o", "> "]
[1599.138261, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1599.138331, "o", "    c_desc.store([off_m, off_n], acc.to(tl.float32))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1599.13836, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1599.138411, "o", "in_features, out_features = 4096, 4096\r\n\u001b[?2004l\r"]
[1599.13844, "o", "\u001b[?2004h> "]
[1599.138469, "o", "batch = 16384\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1599.138523, "o", "x = torch.rand(batch, in_features, device='cuda')\r\n\u001b[?2004l\r"]
[1599.138553, "o", "\u001b[?2004h> "]
[1599.138614, "o", "w = torch.randn(out_features, in_features, device='cuda') * 0.02\r\n\u001b[?2004l\r"]
[1599.138643, "o", "\u001b[?2004h> "]
