[1715.854588, "i", "cat > /workspace/v7.py << 'EOF'\nimport torch, triton, torch.nn as nn, torch.nn.functional as F\nimport triton.language as tl\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\n@triton.jit\ndef _gemm_fused(\n    x_desc, bhi_desc, blo_desc, bias_ptr, c_desc,\n    M, N, K,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BLOCK_K)):\n        a = x_desc.load([off_m, k * BLOCK_K])\n        bhi = bhi_desc.load([k * BLOCK_K, off_n])\n        blo = blo_desc.load([k * BLOCK_K, off_n])\n        a_hi = a.to(tl.float16)\n "]
[1715.854634, "i", "       a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, bhi, acc)\n        acc = tl.dot(a_hi, blo, acc)\n        acc = tl.dot(a_lo, bhi, acc)\n    rn = off_n + tl.arange(0, BLOCK_N)\n    bias = tl.load(bias_ptr + rn, mask=rn < N, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    c_desc.store([off_m, off_n], acc.to(tl.float32))\n\nin_features, out_features = 4096, 4096\nbatch = 16384\ntorch.manual_seed(42)\nlin = nn.Linear(in_features, out_features).cuda()\nw = lin.weight * 1.5\nb = lin.bias.contiguous()\nx = torch.rand(batch, in_features, device='cuda')\nref = F.linear(x, w, b)\nw_hi = w.half(); w_lo = (w - w_hi.float()).half()\nBhi = w_hi.t().contiguous(); Blo = w_lo.t().contiguous()\nM, K = x.shape; N = w.shape[0]\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\ndef clear_l2():\n    dd = torch.empty((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    dd.fill_(42); del dd\n\ndef time_fn(fn, trials=20):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    times "]
[1715.854651, "i", "= []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2()\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times = times[1:]\n    return sum(times)/len(times), min(times)\n\nconfigs = [\n    (128,256,64,8,8,3),\n    (128,128,64,8,8,3),\n    (128,256,32,8,8,4),\n    (128,128,32,8,8,4),\n    (128,128,64,8,8,4),\n    (256,128,64,8,8,3),\n]\nbest=None\nfor cfg in configs:\n    bm, bn, bk, gm, nw, ns = cfg\n    try:\n        x_desc = TensorDescriptor(x, x.shape, x.stride(), [bm, bk])\n        bhi_desc = TensorDescriptor(Bhi, Bhi.shape, Bhi.stride(), [bk, bn])\n        blo_desc = TensorDescriptor(Blo, Blo.shape, Blo.stride(), [bk, bn])\n        c_desc = TensorDescriptor(out, out.shape, out.stride(), [bm, bn])\n        grid = (triton.cdiv(M, bm) * triton.cdiv(N, bn),)\n        def run():\n            _gemm_fused[grid](x_desc, bhi_desc, blo_desc, b, c_desc, "]
[1715.854658, "i", "M, N, K,\n                BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, num_warps=nw, num_stages=ns)\n        run(); torch.cuda.synchronize()\n        d = (ref - out).abs(); tol = 1e-4 + 1e-4*ref.abs()\n        rel = (d/tol).max().item()\n        t = time_fn(run)\n        print(f'v7 cfg {cfg}: mean {t[0]:.3f} min {t[1]:.3f} rel {rel:.3f}')\n        if best is None or t[0] < best[0]: best=(t[0],cfg)\n    except Exception as ex:\n        print(f'v7 cfg {cfg}: FAIL {type(ex).__name__}: {ex}')\nprint('BEST v7:', best)\nEOF\ngpu run -- bash -c \"python3 /workspace/v7.py > /workspace/v7_out.txt 2>&1; echo done\"\n"]
