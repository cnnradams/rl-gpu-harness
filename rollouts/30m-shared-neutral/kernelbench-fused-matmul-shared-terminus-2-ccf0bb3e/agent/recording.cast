[255.928064, "o", "ref       : (11.397184371948242, 11.384703636169434)\r\ncublas32  : (10.770879745483398, 10.764991760253906)\r\nfail 128 128 64 8 3 tf32x3 dynamic_func() missing 2 required positional arguments: 'NW' and 'NS'\r\nfail 128 128 64 8 4 tf32x3 dynamic_func() missing 2 required positional arguments: 'NW' and 'NS'\r\nfail 128 256 64 8 3 tf32x3 dynamic_func() missing 2 required positional arguments: 'NW' and 'NS'\r\nfail 64 256 64 8 4 tf32x3 dynamic_func() missing 2 required positional arguments: 'NW' and 'NS'\r\nfail 128 64 64 4 4 tf32x3 dynamic_func() missing 2 required positional arguments: 'NW' and 'NS'\r\nfail 128 128 32 8 4 tf32x3 dynamic_func() missing 2 required positional arguments: 'NW' and 'NS'\r\n"]
