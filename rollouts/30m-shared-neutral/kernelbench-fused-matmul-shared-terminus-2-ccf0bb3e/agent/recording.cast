[168.511405, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nSF = 0.5\n\nlin = nn.Linear(K, N).cuda()\nx = torch.rand(M, K, device='cuda')\n\ndef ref():\n    y = lin(x)\n    o = y.clone().detach()\n    return y * SF + o\n\nscratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        scratch.random_()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = sorted(ts)\n    return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _k(A, B, Bias, C, M, N, K,\n       sam, sak, sbn, sbk, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n       GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexp"]
[168.511454, "i", "r, NW: tl.constexpr, NS: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    group_id = pid // width\n    group_size = min(grid_m - group_id * GM, GM)\n    pid_m = group_id * GM + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        b = tl.load(Bp)\n        acc = tl.dot(a, b, acc, input_precision=IP)\n        Ap += BK * sak\n        Bp += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = (acc + bias[None, :]) * SCALE\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\ndef tri(x, w, b, BM, BN, BK, GM, ip, nw, ns):\n    M, K = x.shape\n    N = w.shape[0]\n    out = torch.empty((M, N), device=x.device, dtype=tor"]
[168.51157, "i", "ch.float32)\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    _k[grid](x, w, b, out, M, N, K,\n             x.stride(0), x.stride(1), w.stride(0), w.stride(1),\n             out.stride(0), out.stride(1),\n             BM, BN, BK, GM, 1.0+SF, ip, num_warps=nw, num_stages=ns)\n    return out\n\nref_out = ref()\n\nprint('ref       :', timeit(ref))\nprint('cublas32  :', timeit(lambda: torch.nn.functional.linear(x, lin.weight, lin.bias)))\nfor (bm, bn, bk, gm, nw, ns) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(64,256,64,8,8,4),(128,64,64,8,4,4),(128,128,32,8,8,4)]:\n    for ip in ['tf32x3']:\n        try:\n            o = tri(x, lin.weight, lin.bias, bm, bn, bk, gm, ip, nw, ns)\n            o = o * 1.0\n            d = (o - ref_out).abs().max().item()\n            t = timeit(lambda: tri(x, lin.weight, lin.bias, bm, bn, bk, gm, ip, nw, ns))\n            ok = torch.allclose(ref_out, o, atol=1e-4, rtol=1e-4)\n            print(f'triton {ip} BM{bm} BN{bn} BK{bk} nw{nw} ns{ns}: {t} maxdiff={d:.2e} ok={ok}')\n  "]
[168.51158, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.511625, "i", "      except Exception as ex:\n            print('fail', bm, bn, bk, nw, ns, ip, ex)\nEOF\n"]
[168.511644, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r"]
[168.511674, "o", "\u001b[?2004h> "]
[168.511696, "o", "import torch.nn as nn\r\n\u001b[?2004l\r"]
[168.511718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.511763, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.511808, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.511833, "o", "> SF = 0.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.51186, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.511896, "o", "lin = nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[168.511927, "o", "\u001b[?2004h> "]
[168.511955, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[168.511975, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[168.511996, "o", "> def ref():\r\n\u001b[?2004l\r"]
[168.512024, "o", "\u001b[?2004h> "]
[168.512048, "o", "    y = lin(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.51208, "o", "    o = y.clone().detach()\r\n\u001b[?2004l\r"]
[168.512108, "o", "\u001b[?2004h> "]
[168.512131, "o", "    return y * SF + o\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[168.512158, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[168.512252, "o", "scratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.512266, "o", "\r\n\u001b[?2004l\r"]
[168.5123, "o", "\u001b[?2004h> "]
[168.512324, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.512362, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[168.51237, "o", "\u001b[?2004h"]
[168.512381, "o", "> "]
[168.512448, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.512501, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.512532, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[168.512562, "o", "\u001b[?2004h> "]
[168.512592, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[168.512621, "o", "\u001b[?2004h> "]
[168.512645, "o", "        scratch.random_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.512747, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.512778, "o", "> "]
[168.512834, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.512859, "o", "> "]
[168.512887, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[168.51291, "o", "\u001b[?2004h> "]
[168.512933, "o", "    ts = sorted(ts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.512963, "o", "> "]
[168.512989, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.513017, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.513048, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.513083, "o", "def _k(A, B, Bias, C, M, N, K,\r\n\u001b[?2004l\r"]
[168.513109, "o", "\u001b[?2004h> "]
[168.513144, "o", "       sam, sak, sbn, sbk, scm, scn,\r\n\u001b[?2004l\r"]
[168.513171, "o", "\u001b[?2004h> "]
[168.513232, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[168.513257, "o", "\u001b[?2004h> "]
[168.513355, "o", "       GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr, NW: tl.constexpr, NS: tl.constexpr):\r\n\u001b[?2004l\r"]
[168.513384, "o", "\u001b[?2004h> "]
[168.513408, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.513434, "o", "> "]
[168.513462, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[168.513491, "o", "\u001b[?2004h> "]
[168.513515, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.513545, "o", "    width = GM * grid_n\r\n\u001b[?2004l\r"]
[168.513572, "o", "\u001b[?2004h> "]
[168.513603, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.513631, "o", "> "]
[168.513662, "o", "    group_size = min(grid_m - group_id * GM, GM)\r\n\u001b[?2004l\r"]
[168.51369, "o", "\u001b[?2004h> "]
[168.51373, "o", "    pid_m = group_id * GM + (pid % group_size)\r\n\u001b[?2004l\r"]
[168.513758, "o", "\u001b[?2004h> "]
[168.513791, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[168.513818, "o", "\u001b[?2004h> "]
[168.51385, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[168.513877, "o", "\u001b[?2004h> "]
[168.513909, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[168.513935, "o", "\u001b[?2004h> "]
[168.513961, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.513989, "o", "> "]
[168.514026, "o", "    Ap = A + rm[:, None] * sam + rk[None, :] * sak\r\n\u001b[?2004l\r"]
[168.51405, "o", "\u001b[?2004h> "]
[168.514098, "o", "    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\r\n\u001b[?2004l\r"]
[168.514125, "o", "\u001b[?2004h> "]
[168.514166, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[168.514194, "o", "\u001b[?2004h> "]
[168.514229, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[168.514258, "o", "\u001b[?2004h> "]
[168.514288, "o", "        a = tl.load(Ap)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.514315, "o", "        b = tl.load(Bp)\r\n\u001b[?2004l\r"]
[168.514339, "o", "\u001b[?2004h> "]
[168.514387, "o", "        acc = tl.dot(a, b, acc, input_precision=IP)"]
[168.514416, "o", "\r\n\u001b[?2004l\r"]
[168.51444, "o", "\u001b[?2004h> "]
[168.514469, "o", "        Ap += BK * sak\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.514498, "o", "        Bp += BK * sbk\r\n\u001b[?2004l\r"]
[168.514526, "o", "\u001b[?2004h> "]
[168.514553, "o", "    bias = tl.load(Bias + rn)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.514581, "o", "> "]
[168.514609, "o", "    acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r"]
[168.514635, "o", "\u001b[?2004h> "]
[168.514673, "o", "    Cp = C + rm[:, None] * scm + rn[None, :] * scn\r\n\u001b[?2004l\r"]
[168.514697, "o", "\u001b[?2004h> "]
[168.514724, "o", "    tl.store(Cp, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.514753, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.514798, "o", "def tri(x, w, b, BM, BN, BK, GM, ip, nw, ns):\r\n\u001b[?2004l\r"]
[168.514825, "o", "\u001b[?2004h> "]
[168.514852, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.51488, "o", "    N = w.shape[0]\r\n\u001b[?2004l\r"]
[168.514909, "o", "\u001b[?2004h> "]
[168.514966, "o", "    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[168.514996, "o", "\u001b[?2004h> "]
[168.515038, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[168.515066, "o", "\u001b[?2004h> "]
[168.515094, "o", "    _k[grid](x, w, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[168.515121, "o", "\u001b[?2004h> "]
[168.515179, "o", "             x.stride(0), x.stride(1), w.stride(0), w.stride(1),\r\n\u001b[?2004l\r"]
[168.515208, "o", "\u001b[?2004h> "]
[168.515248, "o", "             out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[168.515276, "o", "\u001b[?2004h> "]
[168.515339, "o", "             BM, BN, BK, GM, 1.0+SF, ip, num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[168.515363, "o", "\u001b[?2004h> "]
[168.515391, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[168.515415, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[168.515444, "o", "ref_out = ref()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[168.515468, "o", "\u001b[?2004h> "]
[168.515495, "o", "print('ref       :', timeit(ref))\r\n\u001b[?2004l\r"]
[168.515522, "o", "\u001b[?2004h> "]
[168.515606, "o", "print('cublas32  :', timeit(lambda: torch.nn.functional.linear(x, lin.weight, lin.bias)))\r\n\u001b[?2004l\r"]
[168.515631, "o", "\u001b[?2004h> "]
[168.515782, "o", "for (bm, bn, bk, gm, nw, ns) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(64,256,64,8,8,4),(128,64,64,8,4,4),(128,128,32,8,8,4)]:\r\n\u001b[?2004l\r"]
[168.515808, "o", "\u001b[?2004h> "]
[168.515836, "o", "    for ip in ['tf32x3']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.515865, "o", ">         try:\r\n\u001b[?2004l\r"]
[168.515893, "o", "\u001b[?2004h> "]
[168.515956, "o", "            o = tri(x, lin.weight, lin.bias, bm, bn, bk, gm, ip, nw, ns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[168.515983, "o", "> "]
[168.516011, "o", "            o = o * 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.516067, "o", "            d = (o - ref_out).abs().max().item()\r\n\u001b[?2004l\r"]
[168.516095, "o", "\u001b[?2004h> "]
[168.516178, "o", "            t = timeit(lambda: tri(x, lin.weight, lin.bias, bm, bn, bk, gm, ip, nw, ns))\r\n\u001b[?2004l\r"]
[168.516206, "o", "\u001b[?2004h> "]
[168.516267, "o", "            ok = torch.allclose(ref_out, o, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[168.516296, "o", "\u001b[?2004h> "]
[168.516399, "o", "            print(f'triton {ip} BM{bm} BN{bn} BK{bk} nw{nw} ns{ns}: {t} maxdiff={d:.2e} ok={ok}')\r\n\u001b[?2004l\r"]
[168.516426, "o", "\u001b[?2004h> "]
[168.516454, "o", "        except Exception as ex:\r\n\u001b[?2004l\r"]
[168.516478, "o", "\u001b[?2004h> "]
[168.516527, "o", "            print('fail', bm, bn, bk, nw, ns, ip, ex)\r\n\u001b[?2004l\r"]
[168.516555, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[168.565527, "o", "\u001b[?2004hroot@modal:/# "]
