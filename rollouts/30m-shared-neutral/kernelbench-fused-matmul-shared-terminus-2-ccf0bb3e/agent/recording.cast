[327.833179, "o", "ref       : (11.39907169342041, 11.389056205749512)\r\ncublas32  : (10.773823738098145, 10.763999938964844)\r\ntriton tf32x3 BM128 BN128 BK64 nw8 ns3: (5.737792015075684, 5.73203182220459) maxdiff=8.70e-06 ok=True\r\nfail 128 128 64 8 4 tf32x3 out of resource: shared memory, Required: 262144, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nfail 128 256 64 8 3 tf32x3 out of resource: shared memory, Required: 327680, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\nfail 64 256 64 8 4 tf32x3 out of resource: shared memory, Required: 376832, Hardware limit: 232448. Reducing block sizes or `num_stages` may help.\r\ntriton tf32x3 BM128 BN64 BK64 nw4 ns4: (13.678175926208496, 13.586591720581055) maxdiff=8.70e-06 ok=True\r\ntriton tf32x3 BM128 BN128 BK32 nw8 ns4: (6.879487991333008, 6.818336009979248) maxdiff=9.06e-06 ok=True\r\n"]
[328.892113, "o", "\u001b[?2004hroot@modal:/# "]
[389.785027, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nSF = 0.5\nlin = nn.Linear(K, N).cuda()\nx = torch.rand(M, K, device='cuda')\n\ndef ref(xx):\n    y = torch.nn.functional.linear(xx, lin.weight, lin.bias)\n    return y * SF + y\n\nscratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        scratch.random_()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = sorted(ts)\n    return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _k(A, B, Bias, C, M, N, K,\n       sam, sak, sbn, sbk, scm, scn,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n       GM: tl.constexpr, SCALE: tl.const"]
[389.785076, "i", "expr, IP: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GM * grid_n\n    group_id = pid // width\n    group_size = min(grid_m - group_id * GM, GM)\n    pid_m = group_id * GM + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ap = A + rm[:, None] * sam + rk[None, :] * sak\n    Bp = B + rn[None, :] * sbn + rk[:, None] * sbk\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(Ap)\n        b = tl.load(Bp)\n        acc = tl.dot(a, b, acc, input_precision=IP)\n        Ap += BK * sak\n        Bp += BK * sbk\n    bias = tl.load(Bias + rn)\n    acc = (acc + bias[None, :]) * SCALE\n    Cp = C + rm[:, None] * scm + rn[None, :] * scn\n    tl.store(Cp, acc)\n\ndef tri(x, w, b, BM, BN, BK, GM, ip, nw, ns):\n    M, K = x.shape\n    N = w.shape[0]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n   "]
[389.785104, "i", " grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    _k[grid](x, w, b, out, M, N, K,\n             x.stride(0), x.stride(1), w.stride(0), w.stride(1),\n             out.stride(0), out.stride(1),\n             BM, BN, BK, GM, 1.0+SF, ip, num_warps=nw, num_stages=ns)\n    return out\n\ncfgs = [\n (128,128,64,8,8,2),(128,128,64,8,8,3),(128,128,64,8,8,5),\n (128,128,128,8,8,2),(128,128,128,8,8,3),\n (256,128,64,8,8,2),(256,128,64,8,8,3),\n (64,128,64,8,4,4),(64,128,128,8,4,3),\n (128,256,64,8,8,2),(128,64,128,8,4,3),\n (128,128,64,4,8,3),(128,128,64,16,8,3),(128,128,64,1,8,3),\n]\nfor (bm,bn,bk,gm,nw,ns) in cfgs:\n    try:\n        o = tri(x, lin.weight, lin.bias, bm,bn,bk,gm,'tf32x3',nw,ns)\n        d = (o - ref(x)).abs().max().item()\n        t = timeit(lambda: tri(x, lin.weight, lin.bias, bm,bn,bk,gm,'tf32x3',nw,ns))\n        print(f'BM{bm} BN{bn} BK{bk} GM{gm} nw{nw} ns{ns}: med={t[0]:.3f} min={t[1]:.3f} maxdiff={d:.2e}')\n    except Exception as ex:\n        print('fail', bm,bn,bk,gm,nw,ns, str(ex)[:80])\nEOF\n"]
