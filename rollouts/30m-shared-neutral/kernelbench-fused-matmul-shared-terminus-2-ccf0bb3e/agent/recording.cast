[541.671824, "o", "M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> SF = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.671869, "o", "lin = nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.671902, "o", "W, B = lin.weight, lin.bias\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[541.671938, "o", "\u001b[?2004h> "]
[541.672015, "o", "scratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.672053, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.672093, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.672134, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.672182, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[541.672222, "o", "\u001b[?2004h> "]
[541.672268, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.672308, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.672352, "o", "    for _ in range(n):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.672464, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h>         scratch.random_()\r\n\u001b[?2004l\r"]
[541.672497, "o", "\u001b[?2004h> "]
[541.67258, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.672608, "o", "> "]
[541.672673, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.672702, "o", "> "]
[541.672733, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[541.672758, "o", "\u001b[?2004h> "]
[541.672782, "o", "    ts = sorted(ts)\r\n\u001b[?2004l\r"]
[541.67281, "o", "\u001b[?2004h> "]
[541.672844, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[541.672875, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[541.672902, "o", "> "]
[541.672941, "o", "# robustness: error over many random inputs\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.672975, "o", "> "]
[541.673006, "o", "from bench import tri\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.673071, "o", "xs = [torch.rand(M, K, device='cuda') for _ in range(8)]\r\n\u001b[?2004l\r"]
[541.673102, "o", "\u001b[?2004h> "]
[541.673127, "o", "worst = 0.0; worst_rel = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.673159, "o", "> for xx in xs:\r\n\u001b[?2004l\r"]
[541.673184, "o", "\u001b[?2004h> "]
[541.673236, "o", "    y = torch.nn.functional.linear(xx, W, B)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.673272, "o", "> "]
[541.673302, "o", "    r = y * (1.0 + SF)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.673368, "o", "    o = tri(xx, W, B, 128, 128, 64, 8, 'tf32x3', 8, 3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.673398, "o", "> "]
[541.673428, "o", "    d = (o - r).abs()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.673464, "o", "    thr = 1e-4 + 1e-4 * r.abs()\r\n\u001b[?2004l\r"]
[541.673483, "o", "\u001b[?2004h> "]
[541.673531, "o", "    margin = (d / thr).max().item()\r\n\u001b[?2004l\r"]
[541.673556, "o", "\u001b[?2004h> "]
[541.67364, "o", "    worst = max(worst, d.max().item()); worst_rel = max(worst_rel, margin)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.673666, "o", "> "]
[541.673753, "o", "print(f'tf32x3 worst maxdiff={worst:.3e}, worst ratio-to-threshold={worst_rel:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.673779, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.673817, "o", "# TMA persistent kernel\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.673842, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[541.67387, "o", "\u001b[?2004h> "]
[541.673931, "o", "def _tma_k(a_desc, b_desc, c_desc, bias_ptr, M, N, K,\r\n\u001b[?2004l\r"]
[541.673956, "o", "\u001b[?2004h> "]
[541.674025, "o", "           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.674055, "o", "> "]
[541.67414, "o", "           GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr, NSM: tl.constexpr):\r\n\u001b[?2004l\r"]
[541.674166, "o", "\u001b[?2004h> "]
[541.674192, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[541.674222, "o", "\u001b[?2004h> "]
[541.674246, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[541.674282, "o", "\u001b[?2004h> "]
[541.674328, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[541.674355, "o", "\u001b[?2004h> "]
[541.674384, "o", "    k_tiles = tl.cdiv(K, BK)\r\n\u001b[?2004l\r"]
[541.67441, "o", "\u001b[?2004h> "]
[541.674438, "o", "    num_tiles = grid_m * grid_n\r\n\u001b[?2004l\r"]
[541.674463, "o", "\u001b[?2004h> "]
[541.674494, "o", "    num_pid_in_group = GM * grid_n\r\n\u001b[?2004l\r"]
[541.67452, "o", "\u001b[?2004h> "]
[541.67459, "o", "    for tile_id in tl.range(start_pid, num_tiles, NSM, flatten=True):\r\n\u001b[?2004l\r"]
[541.674619, "o", "\u001b[?2004h> "]
[541.674662, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[541.674691, "o", "\u001b[?2004h> "]
[541.67472, "o", "        first_pid_m = group_id * GM\r\n\u001b[?2004l\r"]
[541.674746, "o", "\u001b[?2004h> "]
[541.674795, "o", "        group_size_m = min(grid_m - first_pid_m, GM)\r\n\u001b[?2004l\r"]
[541.674821, "o", "\u001b[?2004h> "]
[541.674875, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.674903, "o", "> "]
[541.674956, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[541.674983, "o", "\u001b[?2004h> "]
[541.675013, "o", "        offs_am = pid_m * BM\r\n\u001b[?2004l\r"]
[541.67504, "o", "\u001b[?2004h> "]
[541.675068, "o", "        offs_bn = pid_n * BN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.675136, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[541.675162, "o", "\u001b[?2004h> "]
[541.675192, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[541.67522, "o", "\u001b[?2004h> "]
[541.675244, "o", "            offs_k = ki * BK\r\n\u001b[?2004l\r"]
[541.67528, "o", "\u001b[?2004h> "]
[541.67532, "o", "            a = a_desc.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[541.675345, "o", "\u001b[?2004h> "]
[541.675393, "o", "            b = b_desc.load([offs_bn, offs_k])\r\n\u001b[?2004l\r"]
[541.675419, "o", "\u001b[?2004h> "]
[541.675479, "o", "            acc = tl.dot(a, b.T, acc, input_precision=IP)\r\n\u001b[?2004l\r"]
[541.675505, "o", "\u001b[?2004h> "]
[541.675565, "o", "        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[541.675595, "o", "\u001b[?2004h> "]
[541.675631, "o", "        acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r"]
[541.675663, "o", "\u001b[?2004h> "]
[541.675701, "o", "        c_desc.store([offs_am, offs_bn], acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.675729, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[541.675754, "o", "> "]
[541.675801, "o", "def tri_tma(x, w, b, BM, BN, BK, GM, ip, nw, ns):\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.675827, "o", "> "]
[541.675855, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.675884, "o", "    N = w.shape[0]\r\n\u001b[?2004l\r"]
[541.675909, "o", "\u001b[?2004h> "]
[541.675981, "o", "    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.676012, "o", "> "]
[541.676093, "o", "    a_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(x, [BM, BK])\r\n\u001b[?2004l\r"]
[541.676119, "o", "\u001b[?2004h> "]
[541.676202, "o", "    b_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(w, [BN, BK])\r\n\u001b[?2004l\r"]
[541.676232, "o", "\u001b[?2004h> "]
[541.676321, "o", "    c_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(out, [BM, BN])\r\n\u001b[?2004l\r"]
[541.676354, "o", "\u001b[?2004h> "]
[541.676421, "o", "    NSM = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r"]
[541.676451, "o", "\u001b[?2004h> "]
[541.676511, "o", "    grid = (min(NSM, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r"]
[541.676536, "o", "\u001b[?2004h> "]
[541.676587, "o", "    _tma_k[grid](a_desc, b_desc, c_desc, b, M, N, K,\r\n\u001b[?2004l\r"]
[541.676617, "o", "\u001b[?2004h> "]
[541.676661, "o", "                 BM, BN, BK, GM, 1.0+SF, ip, NSM,\r\n\u001b[?2004l\r"]
[541.676687, "o", "\u001b[?2004h> "]
[541.67673, "o", "                 num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[541.676755, "o", "\u001b[?2004h> "]
[541.67678, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.676805, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.67683, "o", "x = xs[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.676858, "o", "> "]
[541.676906, "o", "y = torch.nn.functional.linear(x, W, B); r = y * 1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.676934, "o", "> "]
[541.677086, "o", "for (bm,bn,bk,gm,nw,ns) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,128,8,8,2),(128,256,128,8,8,3)]:\r\n\u001b[?2004l\r"]
[541.677116, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[541.677142, "o", "\u001b[?2004h> "]
[541.677198, "o", "        o = tri_tma(x, W, B, bm,bn,bk,gm,'tf32x3',nw,ns)\r\n\u001b[?2004l\r"]
[541.677224, "o", "\u001b[?2004h> "]
[541.677266, "o", "        d = (o - r).abs().max().item()\r\n\u001b[?2004l\r"]
[541.677297, "o", "\u001b[?2004h> "]
[541.677364, "o", "        t = timeit(lambda: tri_tma(x, W, B, bm,bn,bk,gm,'tf32x3',nw,ns))\r\n\u001b[?2004l\r"]
[541.677393, "o", "\u001b[?2004h> "]
[541.677506, "o", "        print(f'TMA BM{bm} BN{bn} BK{bk} GM{gm} nw{nw} ns{ns}: med={t[0]:.3f} min={t[1]:.3f} maxdiff={d:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.677537, "o", "> "]
[541.677569, "o", "    except Exception as ex:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.677638, "o", "        print('fail', bm,bn,bk,gm,nw,ns, str(ex)[:100])\r\n\u001b[?2004l\r\u001b[?2004h"]
[541.677663, "o", "> EOF\r\n\u001b[?2004l\r"]
[541.679321, "o", "\u001b[?2004hroot@modal:/# "]
[542.170456, "i", "gpu push sb-UUDaWpzQf1v1VYYDuNJEzV /workspace/bench3.py /root/bench3.py && gpu exec sb-UUDaWpzQf1v1VYYDuNJEzV -- python3 /root/bench3.py\n"]
[542.170779, "o", "gpu push sb-UUDaWpzQf1v1VYYDuNJEzV /workspace/bench3.py /root/bench3.py && gpu exec sb-UUDaWpzQf1v1VYYDuNJEzV -- python3 /root/bench3.py\r\n\u001b[?2004l\r"]
[543.253498, "o", "{\r\n  \"bytes\": 3764,\r\n  \"sha256\": \"22caec4d5ed70142419ee810166d2aaafb07b315a96f98886dd235cb860a6fc6\"\r\n}\r\n"]
[543.432864, "o", "request ID: 31e908517e664d429c673e5b8ca34fdc\r\n"]
