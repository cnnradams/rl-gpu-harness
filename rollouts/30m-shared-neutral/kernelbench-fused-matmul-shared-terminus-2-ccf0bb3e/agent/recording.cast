[748.627749, "o", "import torch\r\nimport torch.nn as nn\r\nimport triton\r\nimport triton.language as tl\r\n\r\n\r\n@triton.jit\r\ndef _fused_linear_kernel(\r\n    A, B, Bias, C, M, N, K,\r\n    sam, sak, sbn, sbk, scm, scn,\r\n    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n    GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr,\r\n):\r\n    pid = tl.program_id(0)\r\n    grid_m = tl.cdiv(M, BM)\r\n    grid_n = tl.cdiv(N, BN)\r\n    width = GM * grid_n\r\n    group_id = pid // width\r\n    group_size = min(grid_m - group_id * GM, GM)\r\n    pid_m = group_id * GM + (pid % group_size)\r\n"]
[748.628447, "o", "\u001b[?2004hroot@modal:/# "]
