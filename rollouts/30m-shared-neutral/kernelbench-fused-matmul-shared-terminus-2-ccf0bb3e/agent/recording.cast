[618.243891, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\nfrom triton.tools.tensor_descriptor import TensorDescriptor\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nSF = 0.5\nlin = nn.Linear(K, N).cuda()\nW, B = lin.weight, lin.bias\nx = torch.rand(M, K, device='cuda')\ny = torch.nn.functional.linear(x, W, B); r = y * 1.5\n\nscratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        scratch.random_()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = sorted(ts)\n    return ts[len(ts)//2], ts[0]\n\n@triton.jit\ndef _tma_p(a_desc, b_desc, bias_ptr, C, M, N, K, scm, scn,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n "]
[618.244051, "i", "          GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr,\n           NSM: tl.constexpr, WS: tl.constexpr):\n    start_pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    k_tiles = tl.cdiv(K, BK)\n    num_tiles = grid_m * grid_n\n    num_pid_in_group = GM * grid_n\n    for tile_id in tl.range(start_pid, num_tiles, NSM, flatten=True, warp_specialize=WS):\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GM\n        group_size_m = min(grid_m - first_pid_m, GM)\n        pid_m = first_pid_m + (tile_id % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        offs_am = pid_m * BM\n        offs_bn = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for ki in range(k_tiles):\n            offs_k = ki * BK\n            a = a_desc.load([offs_am, offs_k])\n            b = b_desc.load([offs_bn, offs_k])\n            acc = tl.dot(a, b.T, acc, input_precision=IP)\n        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, "]
[618.244101, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.244143, "i", "BN))\n        acc = (acc + bias[None, :]) * SCALE\n        rm = offs_am + tl.arange(0, BM)\n        rn = offs_bn + tl.arange(0, BN)\n        tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\n\ndef tri_tma(x, w, b, out, BM, BN, BK, GM, ip, nw, ns, ws):\n    M, K = x.shape\n    N = w.shape[0]\n    a_desc = TensorDescriptor.from_tensor(x, [BM, BK])\n    b_desc = TensorDescriptor.from_tensor(w, [BN, BK])\n    NSM = torch.cuda.get_device_properties(0).multi_processor_count\n    grid = (min(NSM, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\n    _tma_p[grid](a_desc, b_desc, b, out, M, N, K,\n                 out.stride(0), out.stride(1),\n                 BM, BN, BK, GM, 1.0+SF, ip, NSM, ws,\n                 num_warps=nw, num_stages=ns)\n    return out\n\nout = torch.empty((M, N), device='cuda')\nfor (bm,bn,bk,gm,nw,ns,ws) in [\n    (128,128,64,8,8,2,False),(128,128,64,8,8,3,False),\n    (128,128,64,8,8,3,True),(128,128,64,8,8,2,True),\n    (128,256,64,8,8,3,True),(128,128,64,8,4,3,True),\n]:\n    try:\n        o = tri_tma(x, W, B, ou"]
[618.244167, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r"]
[618.244195, "i", "t, bm,bn,bk,gm,'tf32x3',nw,ns,ws)\n        d = (o - r).abs().max().item()\n        t = timeit(lambda: tri_tma(x, W, B, out, bm,bn,bk,gm,'tf32x3',nw,ns,ws))\n        print(f'TMAP BM{bm} BN{bn} BK{bk} GM{gm} nw{nw} ns{ns} ws{ws}: med={t[0]:.3f} min={t[1]:.3f} maxdiff={d:.2e}')\n    except Exception as ex:\n        print('fail', bm,bn,bk,gm,nw,ns,ws, str(ex)[:100])\nEOF\n"]
[618.244219, "o", "\u001b[?2004h> "]
[618.244253, "o", "from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r"]
[618.244279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.24431, "o", "> "]
[618.244343, "o", "torch.manual_seed(42)\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.24437, "o", "> M, K, N = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[618.244398, "o", "\u001b[?2004h> "]
[618.24445, "o", "SF = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> lin = nn.Linear(K, N).cuda()\r\n\u001b[?2004l\r"]
[618.244476, "o", "\u001b[?2004h> "]
[618.244505, "o", "W, B = lin.weight, lin.bias\r\n\u001b[?2004l\r"]
[618.24453, "o", "\u001b[?2004h> "]
[618.244577, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.244643, "o", "y = torch.nn.functional.linear(x, W, B); r = y * 1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.244654, "o", "> \r\n\u001b[?2004l\r"]
[618.244681, "o", "\u001b[?2004h> "]
[618.244747, "o", "scratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\r\n\u001b[?2004l\r"]
[618.244773, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.244799, "o", "> "]
[618.244824, "o", "def timeit(fn, n=20):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.244855, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[618.244879, "o", "\u001b[?2004h> "]
[618.244906, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[618.244935, "o", "\u001b[?2004h> "]
[618.244959, "o", "    torch.cuda.empty_cache()\r\n\u001b[?2004l\r"]
[618.244981, "o", "\u001b[?2004h>     ts = []\r\n\u001b[?2004l\r"]
[618.245006, "o", "\u001b[?2004h> "]
[618.245035, "o", "    for _ in range(n):\r\n\u001b[?2004l\r"]
[618.245063, "o", "\u001b[?2004h> "]
[618.245093, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.245119, "o", "> "]
[618.245147, "o", "        scratch.random_()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.245244, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.245273, "o", "> "]
[618.245328, "o", "        s.record(); fn(); e.record(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[618.245357, "o", "\u001b[?2004h> "]
[618.24539, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[618.245419, "o", "\u001b[?2004h> "]
[618.245448, "o", "    ts = sorted(ts)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.245484, "o", "    return ts[len(ts)//2], ts[0]\r\n\u001b[?2004l\r"]
[618.245508, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.245536, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[618.24556, "o", "\u001b[?2004h> "]
[618.245613, "o", "def _tma_p(a_desc, b_desc, bias_ptr, C, M, N, K, scm, scn,\r\n\u001b[?2004l\r"]
[618.245637, "o", "\u001b[?2004h> "]
[618.245699, "o", "           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r"]
[618.245723, "o", "\u001b[?2004h> "]
[618.24579, "o", "           GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr,\r\n\u001b[?2004l\r"]
[618.245814, "o", "\u001b[?2004h> "]
[618.245859, "o", "           NSM: tl.constexpr, WS: tl.constexpr):\r\n\u001b[?2004l\r"]
[618.245887, "o", "\u001b[?2004h> "]
[618.245914, "o", "    start_pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[618.245942, "o", "\u001b[?2004h> "]
[618.245971, "o", "    grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r"]
[618.245995, "o", "\u001b[?2004h> "]
[618.246021, "o", "    grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.246057, "o", "    k_tiles = tl.cdiv(K, BK)\r\n\u001b[?2004l\r"]
[618.246085, "o", "\u001b[?2004h> "]
[618.246113, "o", "    num_tiles = grid_m * grid_n\r\n\u001b[?2004l\r"]
[618.246137, "o", "\u001b[?2004h> "]
[618.246164, "o", "    num_pid_in_group = GM * grid_n\r\n\u001b[?2004l\r"]
[618.246187, "o", "\u001b[?2004h> "]
[618.246276, "o", "    for tile_id in tl.range(start_pid, num_tiles, NSM, flatten=True, warp_specialize=WS):\r\n\u001b[?2004l\r"]
[618.246307, "o", "\u001b[?2004h> "]
[618.246349, "o", "        group_id = tile_id // num_pid_in_group\r\n\u001b[?2004l\r"]
[618.246378, "o", "\u001b[?2004h> "]
[618.246406, "o", "        first_pid_m = group_id * GM\r\n\u001b[?2004l\r"]
[618.24643, "o", "\u001b[?2004h> "]
[618.24648, "o", "        group_size_m = min(grid_m - first_pid_m, GM)\r\n\u001b[?2004l\r"]
[618.246509, "o", "\u001b[?2004h> "]
[618.246556, "o", "        pid_m = first_pid_m + (tile_id % group_size_m)\r\n\u001b[?2004l\r"]
[618.24658, "o", "\u001b[?2004h> "]
[618.246638, "o", "        pid_n = (tile_id % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[618.246661, "o", "\u001b[?2004h> "]
[618.24669, "o", "        offs_am = pid_m * BM\r\n\u001b[?2004l\r"]
[618.246719, "o", "\u001b[?2004h> "]
[618.246747, "o", "        offs_bn = pid_n * BN\r\n\u001b[?2004l\r\u001b[?2004h"]
[618.246771, "o", "> "]
[618.24682, "o", "        acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[618.246849, "o", "\u001b[?2004h> "]
[618.246876, "o", "        for ki in range(k_tiles):\r\n\u001b[?2004l\r"]
[618.2469, "o", "\u001b[?2004h> "]
[618.246928, "o", "            offs_k = ki * BK\r\n\u001b[?2004l\r"]
[618.246951, "o", "\u001b[?2004h> "]
[618.246991, "o", "            a = a_desc.load([offs_am, offs_k])\r\n\u001b[?2004l\r"]
[618.247019, "o", "\u001b[?2004h> "]
[618.247057, "o", "            b = b_desc.load([offs_bn, offs_k])\r\n\u001b[?2004l\r"]
[618.247085, "o", "\u001b[?2004h> "]
[618.247136, "o", "            acc = tl.dot(a, b.T, acc, input_precision=IP)\r\n\u001b[?2004l\r"]
[618.247163, "o", "\u001b[?2004h> "]
[618.247218, "o", "        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\r\n\u001b[?2004l\r"]
[618.247241, "o", "\u001b[?2004h> "]
[618.247282, "o", "        acc = (acc + bias[None, :]) * SCALE\r\n\u001b[?2004l\r"]
[618.24731, "o", "\u001b[?2004h> "]
[618.247347, "o", "        rm = offs_am + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[618.247375, "o", "\u001b[?2004h> "]
[618.247408, "o", "        rn = offs_bn + tl.arange(0, BN)\r\n\u001b[?2004l\r"]
[618.247431, "o", "\u001b[?2004h> "]
[618.247494, "o", "        tl.store(C + rm[:, None] * scm + rn[None, :] * scn, acc)\r\n\u001b[?2004l\r"]
[618.247517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[618.24754, "o", "> "]
[618.247591, "o", "def tri_tma(x, w, b, out, BM, BN, BK, GM, ip, nw, ns, ws):\r\n\u001b[?2004l\r"]
[618.247618, "o", "\u001b[?2004h> "]
[618.247646, "o", "    M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[618.247674, "o", "    N = w.shape[0]\r\n\u001b[?2004l\r"]
[618.247698, "o", "\u001b[?2004h> "]
[618.247741, "o", "    a_desc = TensorDescriptor.from_tensor(x, [BM, BK])\r\n\u001b[?2004l\r"]
[618.247768, "o", "\u001b[?2004h> "]
[618.247816, "o", "    b_desc = TensorDescriptor.from_tensor(w, [BN, BK])\r\n\u001b[?2004l\r"]
[618.247843, "o", "\u001b[?2004h> "]
[618.247904, "o", "    NSM = torch.cuda.get_device_properties(0).multi_processor_count\r\n\u001b[?2004l\r"]
[618.247928, "o", "\u001b[?2004h> "]
[618.247989, "o", "    grid = (min(NSM, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\r\n\u001b[?2004l\r"]
[618.248017, "o", "\u001b[?2004h> "]
[618.24806, "o", "    _tma_p[grid](a_desc, b_desc, b, out, M, N, K,\r\n\u001b[?2004l\r"]
[618.248088, "o", "\u001b[?2004h> "]
[618.248127, "o", "                 out.stride(0), out.stride(1),\r\n\u001b[?2004l\r"]
[618.248156, "o", "\u001b[?2004h> "]
[618.248201, "o", "                 BM, BN, BK, GM, 1.0+SF, ip, NSM, ws,\r\n\u001b[?2004l\r"]
[618.248224, "o", "\u001b[?2004h> "]
[618.248267, "o", "                 num_warps=nw, num_stages=ns)\r\n\u001b[?2004l\r"]
[618.248296, "o", "\u001b[?2004h> "]
[618.248322, "o", "    return out\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[618.248352, "o", "\u001b[?2004h> "]
[618.248386, "o", "out = torch.empty((M, N), device='cuda')\r\n\u001b[?2004l\r"]
[618.248414, "o", "\u001b[?2004h> "]
[618.248436, "o", "for (bm,bn,bk,gm,nw,ns,ws) in [\r\n\u001b[?2004l\r"]
[618.24846, "o", "\u001b[?2004h> "]
[618.248512, "o", "    (128,128,64,8,8,2,False),(128,128,64,8,8,3,False),\r\n\u001b[?2004l\r"]
[618.248536, "o", "\u001b[?2004h> "]
[618.248585, "o", "    (128,128,64,8,8,3,True),(128,128,64,8,8,2,True),\r\n\u001b[?2004l\r"]
[618.248613, "o", "\u001b[?2004h> "]
[618.248658, "o", "    (128,256,64,8,8,3,True),(128,128,64,8,4,3,True),\r\n\u001b[?2004l\r"]
[618.248686, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r"]
[618.248713, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r"]
[618.248741, "o", "\u001b[?2004h> "]
[618.248791, "o", "        o = tri_tma(x, W, B, out, bm,bn,bk,gm,'tf32x3',nw,ns,ws)\r\n\u001b[?2004l\r"]
[618.248818, "o", "\u001b[?2004h> "]
[618.248849, "o", "        d = (o - r).abs().max().item()\r\n\u001b[?2004l\r"]
[618.248877, "o", "\u001b[?2004h> "]
[618.248951, "o", "        t = timeit(lambda: tri_tma(x, W, B, out, bm,bn,bk,gm,'tf32x3',nw,ns,ws))\r\n\u001b[?2004l\r"]
[618.248978, "o", "\u001b[?2004h"]
[618.249004, "o", "> "]
[618.249107, "o", "        print(f'TMAP BM{bm} BN{bn} BK{bk} GM{gm} nw{nw} ns{ns} ws{ws}: med={t[0]:.3f} min={t[1]:.3f} maxdiff={d:.2e}')\r\n\u001b[?2004l\r"]
[618.249134, "o", "\u001b[?2004h> "]
[618.249162, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[618.24919, "o", "\u001b[?2004h> "]
[618.24924, "o", "        print('fail', bm,bn,bk,gm,nw,ns,ws, str(ex)[:100])\r\n\u001b[?2004l\r"]
[618.249264, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[618.250912, "o", "\u001b[?2004hroot@modal:/# "]
