[541.671313, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn as nn\n\ntorch.manual_seed(42)\nM, K, N = 16384, 4096, 4096\nSF = 0.5\nlin = nn.Linear(K, N).cuda()\nW, B = lin.weight, lin.bias\n\nscratch = torch.empty(256*1024*1024, dtype=torch.int8, device='cuda')\n\ndef timeit(fn, n=20):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    torch.cuda.empty_cache()\n    ts = []\n    for _ in range(n):\n        torch.cuda.synchronize()\n        scratch.random_()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = sorted(ts)\n    return ts[len(ts)//2], ts[0]\n\n# robustness: error over many random inputs\nfrom bench import tri\nxs = [torch.rand(M, K, device='cuda') for _ in range(8)]\nworst = 0.0; worst_rel = 0.0\nfor xx in xs:\n    y = torch.nn.functional.linear(xx, W, B)\n    r = y * (1.0 + SF)\n    o = tri(xx, W, B, 128, 128, 64, 8, 'tf32x3', 8, "]
[541.671365, "i", "3)\n    d = (o - r).abs()\n    thr = 1e-4 + 1e-4 * r.abs()\n    margin = (d / thr).max().item()\n    worst = max(worst, d.max().item()); worst_rel = max(worst_rel, margin)\nprint(f'tf32x3 worst maxdiff={worst:.3e}, worst ratio-to-threshold={worst_rel:.4f}')\n\n# TMA persistent kernel\n@triton.jit\ndef _tma_k(a_desc, b_desc, c_desc, bias_ptr, M, N, K,\n           BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n           GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr, NSM: tl.constexpr):\n    start_pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    k_tiles = tl.cdiv(K, BK)\n    num_tiles = grid_m * grid_n\n    num_pid_in_group = GM * grid_n\n    for tile_id in tl.range(start_pid, num_tiles, NSM, flatten=True):\n        group_id = tile_id // num_pid_in_group\n        first_pid_m = group_id * GM\n        group_size_m = min(grid_m - first_pid_m, GM)\n        pid_m = first_pid_m + (tile_id % group_size_m)\n        pid_n = (tile_id % num_pid_in_group) // group_size_m\n        offs_am = pi"]
[541.671384, "i", "d_m * BM\n        offs_bn = pid_n * BN\n        acc = tl.zeros((BM, BN), dtype=tl.float32)\n        for ki in range(k_tiles):\n            offs_k = ki * BK\n            a = a_desc.load([offs_am, offs_k])\n            b = b_desc.load([offs_bn, offs_k])\n            acc = tl.dot(a, b.T, acc, input_precision=IP)\n        bias = tl.load(bias_ptr + offs_bn + tl.arange(0, BN))\n        acc = (acc + bias[None, :]) * SCALE\n        c_desc.store([offs_am, offs_bn], acc)\n\ndef tri_tma(x, w, b, BM, BN, BK, GM, ip, nw, ns):\n    M, K = x.shape\n    N = w.shape[0]\n    out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n    a_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(x, [BM, BK])\n    b_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(w, [BN, BK])\n    c_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(out, [BM, BN])\n    NSM = torch.cuda.get_device_properties(0).multi_processor_count\n    grid = (min(NSM, triton.cdiv(M, BM) * triton.cdiv(N, BN)),)\n    _tma_k[grid](a_"]
[541.671411, "i", "desc, b_desc, c_desc, b, M, N, K,\n                 BM, BN, BK, GM, 1.0+SF, ip, NSM,\n                 num_warps=nw, num_stages=ns)\n    return out\n\nx = xs[0]\ny = torch.nn.functional.linear(x, W, B); r = y * 1.5\nfor (bm,bn,bk,gm,nw,ns) in [(128,128,64,8,8,3),(128,128,64,8,8,4),(128,256,64,8,8,3),(256,128,64,8,8,3),(128,128,128,8,8,2),(128,256,128,8,8,3)]:\n    try:\n        o = tri_tma(x, W, B, bm,bn,bk,gm,'tf32x3',nw,ns)\n        d = (o - r).abs().max().item()\n        t = timeit(lambda: tri_tma(x, W, B, bm,bn,bk,gm,'tf32x3',nw,ns))\n        print(f'TMA BM{bm} BN{bn} BK{bk} GM{gm} nw{nw} ns{ns}: med={t[0]:.3f} min={t[1]:.3f} maxdiff={d:.2e}')\n    except Exception as ex:\n        print('fail', bm,bn,bk,gm,nw,ns, str(ex)[:100])\nEOF\n"]
[541.671625, "o", "cat > /workspace/bench3.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[541.671691, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
