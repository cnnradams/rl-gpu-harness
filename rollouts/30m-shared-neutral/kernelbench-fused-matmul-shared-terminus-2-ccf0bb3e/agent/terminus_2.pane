[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _fused_linear_kernel(
[?2004l[?2004h>     A, B, Bias, C, M, N, K,
[?2004l[?2004h>     sam, sak, sbn, sbk, scm, scn,
[?2004l[?2004h>     BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
[?2004l[?2004h>     GM: tl.constexpr, SCALE: tl.constexpr, IP: tl.constexpr,
[?2004l[?2004h> ):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BM)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BN)
[?2004l[?2004h>     width = GM * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = min(grid_m - group_id * GM, GM)
[?2004l[?2004h>     pid_m = group_id * GM + (pid % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h>     rm = pid_m * BM + tl.arange(0, BM)
[?2004l[?2004h>     rn = pid_n * BN + tl.arange(0, BN)
[?2004l[?2004h>     rk = tl.arange(0, BK)
[?2004l[?2004h>     Ap = A + rm[:, None] * sam + rk[None, :] * sak
[?2004l[?2004h>     Bp = B + rn[None, :] * sbn + rk[:, None] * sbk
[?2004l[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)
[?2004l[?2004h>     for k in range(0, K, BK):
[?2004l[?2004h>         a = tl.load(Ap)
[?2004l[?2004h>         b = tl.load(Bp)
[?2004l[?2004h>         acc = tl.dot(a, b, acc, input_precision=IP)
[?2004l[?2004h>         Ap += BK * sak
[?2004l[?2004h>         Bp += BK * sbk
[?2004l[?2004h>     bias = tl.load(Bias + rn)
[?2004l[?2004h>     acc = (acc + bias[None, :]) * SCALE
[?2004l[?2004h>     Cp = C + rm[:, None] * scm + rn[None, :] * scn
[?2004l[?2004h>     tl.store(Cp, acc)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _fused_linear(x, w, b, scale):
[?2004l[?2004h>     M, K = x.shape
[?2004l[?2004h>     N = w.shape[0]
[?2004l[?2004h>     out = torch.empty((M, N), device=x.device, dtype=torch.float32)
[?2004l[?2004h>     BM, BN, BK, GM = 128, 128, 64, 8
[?2004l[?2004h>     grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
[?2004l[?2004h>     _fused_linear_kernel[grid](
[?2004l[?2004h>         x, w, b, out, M, N, K,
[?2004l[?2004h>         x.stride(0), x.stride(1), w.stride(0), w.stride(1),
[?2004l[?2004h>         out.stride(0), out.stride(1),
[?2004l[?2004h>         BM, BN, BK, GM, scale, "tf32x3",
[?2004l[?2004h>         num_warps=8, num_stages=3,
[?2004l[?2004h>     )
[?2004l[?2004h>     return out
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     """
[?2004l[?2004h>     Fused implementation of matmul + scaling + residual.
[?2004l[?2004h>     y = (x @ W^T + b) * s + (x @ W^T + b) = (1 + s) * (x @ W^T + b)
[?2004l[?2004h>     Computed in one fused GEMM kernel with 3xTF32 precision (near-FP32 accuracy
[?2004l[?2004h>     at tensor-core throughput).
[?2004l[?2004h>     """
[?2004l[?2004h>     def __init__(self, in_features, out_features, scaling_factor):
[?2004l[?2004h>         super(ModelNew, self).__init__()
[?2004l[?2004h>         self.matmul = nn.Linear(in_features, out_features)
[?2004l[?2004h>         self.scaling_factor = scaling_factor
[?2004l[?2004h> 
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         return _fused_linear(
[?2004l[?2004h>             x, self.matmul.weight, self.matmul.bias,
[?2004l[?2004h>             1.0 + self.scaling_factor,
[?2004l[?2004h>         )
