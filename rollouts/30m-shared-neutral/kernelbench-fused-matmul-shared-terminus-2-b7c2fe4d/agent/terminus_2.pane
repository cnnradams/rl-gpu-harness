[?2004h> @triton.jit
[?2004l[?2004h> def _split_fp16_mm(
[?2004l[?2004h>     xh_ptr, xl_ptr, bh_ptr, bl_ptr, bias_ptr, out_ptr,
[?2004l[?2004h>     M, N, K,
[?2004l[?2004h>     BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
[?2004l[?2004h>     GROUP_M: tl.constexpr,
[?2004l[?2004h> ):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     grid_m = tl.cdiv(M, BLOCK_M)
[?2004l[?2004h>     grid_n = tl.cdiv(N, BLOCK_N)
[?2004l[?2004h>     width = GROUP_M * grid_n
[?2004l[?2004h>     group_id = pid // width
[?2004l[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)
[?2004l[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)
[?2004l[?2004h>     pid_n = (pid % width) // group_size
[?2004l[?2004h> 
[?2004l[?2004h>     offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
[?2004l[?2004h>     offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
[?2004l[?2004h>     offs_k = tl.arange(0, BLOCK_K)
[?2004l[?2004h>     m_mask = offs_m < M
[?2004l[?2004h>     n_mask = offs_n < N
[?2004l[?2004h> 
[?2004l[?2004h>     xh_ptrs = xh_ptr + offs_m[:, None] * K + offs_k[None, :]
[?2004l[?2004h>     xl_ptrs = xl_ptr + offs_m[:, None] * K + offs_k[None, :]
