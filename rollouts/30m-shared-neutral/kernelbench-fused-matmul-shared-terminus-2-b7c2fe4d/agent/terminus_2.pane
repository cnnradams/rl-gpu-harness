[?2004l[?2004h>     for k in range(0, tl.cdiv(K, BLOCK_K)):
[?2004l[?2004h>         k_rem = K - k * BLOCK_K
[?2004l[?2004h>         ka = offs_k[None, :] < k_rem
[?2004l[?2004h>         kb = offs_k[:, None] < k_rem
[?2004l[?2004h>         xh = tl.load(xh_ptrs, mask=m_mask[:, None] & ka, other=0.0)
