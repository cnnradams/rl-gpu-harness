[789.588669, "i", "vice=x.device, dtype=torch.float32)\n        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 128, 128, 64, 8\n        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\n        _split_fp16_mm[grid](\n            xh, xl, bh, bl, self.bias, out,\n            M, N, K,\n            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\n            num_warps=8, num_stages=3,\n        )\n        return out\nPYEOF\nwc -l /workspace/solution.py\n"]
[789.588882, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rself, in_features, out_features, scaling_factor):\r\n        super().__init__()\r\n        lin = nn.Linear(in_features, out_features)\r\n        with torch.no_grad():\r\n            s = 1.0 + float(scaling_factor)\r\n            w = (lin.weight.detach() * s).t().contiguous()  # (K, N) fp32\r\n            b = (lin.bias.detach() * s).contiguous()        # (N,) fp32\r\n            wh = w.half()\r\n            wl = (w - wh.float()).half()\r\n        # store fp16 data as int16 so .to(dtype=fp32) does not upcast them\r\n        self.register_buffer(\"bh_i16\", wh.view(torch.int16))\r\n        self.register_buffer(\"bl_i16\", wl.view(torch.int16))\r\n        self.register_buffer(\"bias\", b)\r\n        self.in_features = in_features\r\n        self.out_features = out_features\r\n\r\n    def forward(self, x):\r\n        x = x.contiguous()\r\n        M, K = x.shape\r\n        N = self.out_features\r\n        bh = self.bh_i16.view(torch.float16)\r\n        bl = self.bl_i16.view(torch.float16)\r\n        xh = x.half()\r\n        xl = (x - xh.float())"]
[789.588907, "o", ".half()\r\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 128, 128, 64, 8\r\n        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\r\n        _split_fp16_mm[grid](\r\n            xh, xl, bh, bl, self.bias, out,\r\n            M, N, K,\r\n            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\r\n            num_warps=8, num_stages=3,\r\n        )\r\n        return out\r\nPYEOF\r\nwc -l /workspace/solution.py\r\n"]
