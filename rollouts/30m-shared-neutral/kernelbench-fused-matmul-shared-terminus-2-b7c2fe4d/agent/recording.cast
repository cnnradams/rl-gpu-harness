[1350.734338, "i", "gpu exec sb-rwssvdSdCzYL6Smd8IBUJS -- python3 -c \"\nimport torch, importlib.util, numpy as np\ndef load(p,n):\n    spec=importlib.util.spec_from_file_location(n,p); m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); return m\nref=load('/opt/task/reference.py','r'); sol=load('/workspace/solution2.py','s')\ntorch.manual_seed(42); m_ref=ref.Model(4096,4096,0.5).cuda()\ntorch.manual_seed(42); m_new=sol.ModelNew(4096,4096,0.5).cuda()\nok=True\nfor t in range(8):\n    torch.manual_seed(2000+t); x=torch.rand(16384,4096,device='cuda')\n    with torch.no_grad(): r=m_ref(x); o=m_new(x)\n    p=bool(torch.allclose(r,o,atol=1e-4,rtol=1e-4)); ok=ok and p\n    print(t, (r-o).abs().max().item(), p)\nprint('PASS' if ok else 'FAIL')\nfrom kernelbench.timing import get_timing_function\ntorch.manual_seed(42); x=torch.rand(16384,4096,device='cuda')\ntf=get_timing_function('cuda_event')\nts=tf(m_new,[x],num_trials=20,device=torch.device('cuda:0'))\nprint('new mean ms:', float(np.mean(ts)))\n\"\n"]
