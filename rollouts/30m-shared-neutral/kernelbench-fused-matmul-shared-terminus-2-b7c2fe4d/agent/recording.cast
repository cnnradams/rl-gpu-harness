[1335.735095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h>     offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h>     offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r\u001b[?2004h>     m_mask = offs_m < M\r\n\u001b[?2004l\r\u001b[?2004h>     n_mask = offs_n < N\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     x_ptrs = x_ptr + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735199, "o", "    bh_ptrs = bh_ptr + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h>     bl_ptrs = bl_ptr + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735244, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735278, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h>         k_rem = K - k * BLOCK_K\r\n\u001b[?2004l\r"]
[1335.735314, "o", "\u001b[?2004h>         ka = offs_k[None, :] < k_rem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735367, "o", "        kb = offs_k[:, None] < k_rem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735413, "o", "        x = tl.load(x_ptrs, mask=m_mask[:, None] & ka, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735447, "o", "        xh = x.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735484, "o", "        xl = (x - xh.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735536, "o", "        bh = tl.load(bh_ptrs, mask=kb & n_mask[None, :], other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735586, "o", "        bl = tl.load(bl_ptrs, mask=kb & n_mask[None, :], other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.735622, "o", ">         acc = tl.dot(xh, bl, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735655, "o", "        acc = tl.dot(xl, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735688, "o", "        acc = tl.dot(xh, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735728, "o", "        x_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735764, "o", "        bh_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r\u001b[?2004h>         bl_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[1335.735803, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735862, "o", "    bias = tl.load(bias_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h>     acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.735919, "o", "> "]
[1335.735953, "o", "    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.735992, "o", "    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736028, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736074, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736107, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736141, "o", "        lin = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736175, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736209, "o", "            s = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.73625, "o", "            w = (lin.weight.detach() * s).t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736287, "o", "            b = (lin.bias.detach() * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.73632, "o", "            wh = w.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736354, "o", "            wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.73639, "o", "        self.register_buffer(\"bh_i16\", wh.view(torch.int16))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.736426, "o", "> "]
[1335.736465, "o", "        self.register_buffer(\"bl_i16\", wl.view(torch.int16))\r\n\u001b[?2004l\r\u001b[?2004h>         self.register_buffer(\"bias\", b)\r\n\u001b[?2004l\r"]
[1335.736504, "o", "\u001b[?2004h>         self.in_features = in_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736536, "o", "        self.out_features = out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736567, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736603, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.73664, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h>         M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736673, "o", "        N = self.out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736709, "o", "        bh = self.bh_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736745, "o", "        bl = self.bl_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736783, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736834, "o", "        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 128, 128, 64, 8\r\n\u001b[?2004l\r\u001b[?2004h"]
[1335.736863, "o", "> "]
[1335.736901, "o", "        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736932, "o", "        _fused_split_mm[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.736977, "o", "            x, bh, bl, self.bias, out,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.737008, "o", "            M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.737043, "o", "            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1335.737081, "o", "            num_warps=8, num_stages=3,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[1335.73713, "o", "\u001b[?2004h>         return out\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
