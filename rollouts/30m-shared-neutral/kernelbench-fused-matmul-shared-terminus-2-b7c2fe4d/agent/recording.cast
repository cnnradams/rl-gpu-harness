[1721.683606, "o", "        acc = tl.dot(xh, bh, acc)\r\n\u001b[?2004l\r"]
[1721.683624, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1721.683631, "o", "\u001b[?2004h> "]
[1721.683693, "o", "    offs_m = off_m + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.683753, "o", "    offs_n = off_n + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r\u001b[?2004h>     m_mask = offs_m < M\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.6838, "o", "    n_mask = offs_n < N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.683817, "o", "    bias = tl.load(bias_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.683907, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h>     out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684, "o", "    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684048, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684088, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684114, "o", "        lin = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684159, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684231, "o", "            s = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684301, "o", "            w = (lin.weight.detach() * s).t().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h>             b = (lin.bias.detach() * s).contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684314, "o", "            wh = w.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684402, "o", "            wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h>         self.register_buffer(\"bh_i16\", wh.view(torch.int16))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684521, "o", "        self.register_buffer(\"bl_i16\", wl.view(torch.int16))\r\n\u001b[?2004l\r\u001b[?2004h>         self.register_buffer(\"bias\", b)\r\n\u001b[?2004l\r\u001b[?2004h>         self.in_features = in_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684541, "o", "        self.out_features = out_features\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684612, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.684659, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h>         N = self.out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.68473, "o", "        bh = self.bh_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h>         bl = self.bl_i16.view(torch.float16)\r\n\u001b[?2004l\r"]
[1721.684802, "o", "\u001b[?2004h>         out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.68493, "o", "        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 256, 128, 64, 8\r\n\u001b[?2004l\r\u001b[?2004h>         from triton.tools.tensor_descriptor import TensorDescriptor\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685036, "o", "        x_desc = TensorDescriptor.from_tensor(x, [BLOCK_M, BLOCK_K])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685052, "o", "        bh_desc = TensorDescriptor.from_tensor(bh, [BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685128, "o", "        bl_desc = TensorDescriptor.from_tensor(bl, [BLOCK_K, BLOCK_N])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685198, "o", "        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\r\n\u001b[?2004l\r\u001b[?2004h>         _tma_split_mm[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685324, "o", "            x_desc, bh_desc, bl_desc, self.bias, out,\r\n\u001b[?2004l\r\u001b[?2004h>             M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h>             BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685403, "o", "            num_warps=8, num_stages=4,\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.685524, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[1721.687892, "o", "\u001b[?2004hroot@modal:/# "]
