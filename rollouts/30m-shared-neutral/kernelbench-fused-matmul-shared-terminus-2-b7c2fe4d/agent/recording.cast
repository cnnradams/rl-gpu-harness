[1422.741114, "o", "    (256,256,64,8,16,2),\r\n\u001b[?2004l\r\u001b[?2004h> ]"]
[1422.741128, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741163, "o", "tf = get_timing_function('cuda_event')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.74119, "o", "class Fn:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741217, "o", "    def __init__(self, cfg): self.cfg = cfg\r\n\u001b[?2004l\r\u001b[?2004h"]
[1422.741245, "o", ">     def __call__(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741281, "o", "        BM,BN,BK,GM,w,s = self.cfg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741324, "o", "        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741375, "o", "        s2._fused_split_mm[grid](x, bh, bl, bias, out, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741422, "o", "            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741454, "o", "            num_warps=w, num_stages=s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741481, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741504, "o", "for cfg in configs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741528, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741553, "o", "        f = Fn(cfg)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741575, "o", "        f(x); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741625, "o", "        ts = tf(f, [x], num_trials=10, device=torch.device('cuda:0'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741656, "o", "        mean = float(np.mean(ts))\r\n\u001b[?2004l\r"]
[1422.741682, "o", "\u001b[?2004h> "]
[1422.741719, "o", "        print(cfg, f'{mean:.3f} ms', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741741, "o", "        results.append((mean, cfg))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741763, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741818, "o", "        print(cfg, 'FAIL', str(e)[:80], flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741843, "o", "results.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741873, "o", "print('BEST:', results[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1422.741896, "o", "PYEOF\r\n\u001b[?2004l\r"]
