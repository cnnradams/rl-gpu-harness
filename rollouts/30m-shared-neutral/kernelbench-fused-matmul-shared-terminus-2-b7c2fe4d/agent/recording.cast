[1422.739908, "i", "cat > /workspace/tune.py <<'PYEOF'\nimport torch, importlib.util, numpy as np, itertools, sys\nspec = importlib.util.spec_from_file_location('s2', '/workspace/solution2.py')\ns2 = importlib.util.module_from_spec(spec); spec.loader.exec_module(s2)\nfrom kernelbench.timing import get_timing_function\n\ntorch.manual_seed(42)\nm = s2.ModelNew(4096, 4096, 0.5).cuda()\nx = torch.rand(16384, 4096, device='cuda')\nbh = m.bh_i16.view(torch.float16); bl = m.bl_i16.view(torch.float16)\nbias = m.bias\nM, K = x.shape; N = 4096\nout = torch.empty((M, N), device='cuda', dtype=torch.float32)\n\nimport triton\nresults = []\nconfigs = [\n    (128,128,64,8,8,3),\n    (128,256,64,8,8,3),\n    (256,128,64,8,8,3),\n    (128,128,32,8,8,4),\n    (128,128,128,8,8,3),\n    (128,256,32,8,8,4),\n    (128,256,32,8,8,3),\n    (256,128,32,8,8,4),\n    (128,64,64,8,8,4),\n    (256,64,64,8,8,4),\n    (128,256,64,8,16,2),\n    (256,256,32,8,8,2),\n    (128,128,64,8,4,3),\n    (128,128,64,8,16,3),\n    (64,256,64,8,8,4),\n    (256,256,64,8,16,2),\n]\ntf = get_timing_function('"]
[1422.739978, "i", "cuda_event')\nclass Fn:\n    def __init__(self, cfg): self.cfg = cfg\n    def __call__(self, x):\n        BM,BN,BK,GM,w,s = self.cfg\n        grid = (triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n        s2._fused_split_mm[grid](x, bh, bl, bias, out, M, N, K,\n            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,\n            num_warps=w, num_stages=s)\n        return out\nfor cfg in configs:\n    try:\n        f = Fn(cfg)\n        f(x); torch.cuda.synchronize()\n        ts = tf(f, [x], num_trials=10, device=torch.device('cuda:0'))\n        mean = float(np.mean(ts))\n        print(cfg, f'{mean:.3f} ms', flush=True)\n        results.append((mean, cfg))\n    except Exception as e:\n        print(cfg, 'FAIL', str(e)[:80], flush=True)\nresults.sort()\nprint('BEST:', results[0])\nPYEOF\ngpu push sb-rwssvdSdCzYL6Smd8IBUJS /workspace/tune.py /workspace/tune.py\n"]
