[1721.682255, "i", "cat > /workspace/solution3.py <<'PYEOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _tma_split_mm(\n    x_desc, bh_desc, bl_desc, bias_ptr, out_ptr,\n    M, N, K,\n    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n    GROUP_M: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BLOCK_M)\n    grid_n = tl.cdiv(N, BLOCK_N)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    off_m = pid_m * BLOCK_M\n    off_n = pid_n * BLOCK_N\n\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, tl.cdiv(K, BLOCK_K)):\n        off_k = k * BLOCK_K\n        x = x_desc.load([off_m, off_k])\n        xh = x.to(tl.float16)\n        xl = (x - xh.to(tl.float32)).to(tl.float16)\n        bh = bh_desc.load([off_k, off_n])\n        bl = bl_desc.load([off_k, off_n])\n       "]
[1721.682606, "o", "cat > /workspace/solution3.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def _tma_split_mm(\r\n\u001b[?2004l\r\u001b[?2004h>     x_desc, bh_desc, bl_desc, bias_ptr, out_ptr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.682651, "i", " acc = tl.dot(xh, bl, acc)\n        acc = tl.dot(xl, bh, acc)\n        acc = tl.dot(xh, bh, acc)\n\n    offs_m = off_m + tl.arange(0, BLOCK_M)\n    offs_n = off_n + tl.arange(0, BLOCK_N)\n    m_mask = offs_m < M\n    n_mask = offs_n < N\n    bias = tl.load(bias_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\n    acc = acc + bias[None, :]\n    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scaling_factor):\n        super().__init__()\n        lin = nn.Linear(in_features, out_features)\n        with torch.no_grad():\n            s = 1.0 + float(scaling_factor)\n            w = (lin.weight.detach() * s).t().contiguous()\n            b = (lin.bias.detach() * s).contiguous()\n            wh = w.half()\n            wl = (w - wh.float()).half()\n        self.register_buffer(\"bh_i16\", wh.view(torch.int16))\n        self.register_buffer(\"bl_i16\", wl.view(torch.int16))\n       "]
[1721.682672, "o", "    M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h>     BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.682686, "i", " self.register_buffer(\"bias\", b)\n        self.in_features = in_features\n        self.out_features = out_features\n\n    def forward(self, x):\n        x = x.contiguous()\n        M, K = x.shape\n        N = self.out_features\n        bh = self.bh_i16.view(torch.float16)\n        bl = self.bl_i16.view(torch.float16)\n        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 256, 128, 64, 8\n        from triton.tools.tensor_descriptor import TensorDescriptor\n        x_desc = TensorDescriptor.from_tensor(x, [BLOCK_M, BLOCK_K])\n        bh_desc = TensorDescriptor.from_tensor(bh, [BLOCK_K, BLOCK_N])\n        bl_desc = TensorDescriptor.from_tensor(bl, [BLOCK_K, BLOCK_N])\n        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\n        _tma_split_mm[grid](\n            x_desc, bh_desc, bl_desc, self.bias, out,\n            M, N, K,\n            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\n            num_warps=8, num_stages=4,\n        )\n "]
[1721.682699, "o", "    GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h> ):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1721.682711, "i", "       return out\nPYEOF\ngpu push sb-rwssvdSdCzYL6Smd8IBUJS /workspace/solution3.py /workspace/solution3.py\n"]
