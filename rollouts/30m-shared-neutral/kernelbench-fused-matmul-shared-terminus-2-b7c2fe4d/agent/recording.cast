[789.589887, "o", "    xl_ptrs = xl_ptr + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.58993, "o", "    bh_ptrs = bh_ptr + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.58998, "o", "    bl_ptrs = bl_ptr + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[789.590015, "o", "\u001b[?2004h> "]
[789.59005, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590088, "o", "    for k in range(0, tl.cdiv(K, BLOCK_K)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.59012, "o", "        k_rem = K - k * BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590167, "o", "        ka = offs_k[None, :] < k_rem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590198, "o", "        kb = offs_k[:, None] < k_rem\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590249, "o", "        xh = tl.load(xh_ptrs, mask=m_mask[:, None] & ka, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590299, "o", "        xl = tl.load(xl_ptrs, mask=m_mask[:, None] & ka, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590349, "o", "        bh = tl.load(bh_ptrs, mask=kb & n_mask[None, :], other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.5904, "o", "        bl = tl.load(bl_ptrs, mask=kb & n_mask[None, :], other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.590436, "o", ">         acc = tl.dot(xh, bl, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590473, "o", "        acc = tl.dot(xl, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590509, "o", "        acc = tl.dot(xh, bh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590546, "o", "        xh_ptrs += BLOCK_K\r\n\u001b[?2004l\r\u001b[?2004h>         xl_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[789.590583, "o", "\u001b[?2004h>         bh_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[789.59062, "o", "\u001b[?2004h>         bl_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[789.590656, "o", "\u001b[?2004h> "]
[789.590693, "o", "    bias = tl.load(bias_ptr + offs_n, mask=n_mask, other=0.0).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590727, "o", "    acc = acc + bias[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590764, "o", "    out_ptrs = out_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.5908, "o", "    tl.store(out_ptrs, acc, mask=m_mask[:, None] & n_mask[None, :])\r\n\u001b[?2004l\r"]
[789.590835, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.59087, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590904, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590935, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.590974, "o", "        lin = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591009, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591045, "o", "            s = 1.0 + float(scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591084, "o", "            w = (lin.weight.detach() * s).t().contiguous()  # (K, N) fp32\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.591121, "o", "> "]
[789.591147, "o", "            b = (lin.bias.detach() * s).contiguous()        # (N,) fp32\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591188, "o", "            wh = w.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.59122, "o", "            wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591256, "o", "        # store fp16 data as int16 so .to(dtype=fp32) does not upcast them\r\n\u001b[?2004l\r"]
[789.591286, "o", "\u001b[?2004h> "]
[789.591318, "o", "        self.register_buffer(\"bh_i16\", wh.view(torch.int16))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591361, "o", "        self.register_buffer(\"bl_i16\", wl.view(torch.int16))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591391, "o", "        self.register_buffer(\"bias\", b)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591429, "o", "        self.in_features = in_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.59146, "o", "        self.out_features = out_features\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.591495, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591532, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.591563, "o", ">         M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591598, "o", "        N = self.out_features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591628, "o", "        bh = self.bh_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591659, "o", "        bl = self.bl_i16.view(torch.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591689, "o", "        xh = x.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591722, "o", "        xl = (x - xh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591773, "o", "        out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.591809, "o", "> "]
[789.591838, "o", "        BLOCK_M, BLOCK_N, BLOCK_K, GROUP_M = 128, 128, 64, 8\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591875, "o", "        grid = (triton.cdiv(M, BLOCK_M) * triton.cdiv(N, BLOCK_N),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591907, "o", "        _split_fp16_mm[grid](\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.591938, "o", "            xh, xl, bh, bl, self.bias, out,\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.591975, "o", ">             M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.592024, "o", "            BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N, BLOCK_K=BLOCK_K, GROUP_M=GROUP_M,\r\n\u001b[?2004l\r\u001b[?2004h"]
[789.592061, "o", ">             num_warps=8, num_stages=3,\r\n\u001b[?2004l\r"]
[789.592094, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[789.59213, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[789.595546, "o", "\u001b[?2004hroot@modal:/# "]
[789.595598, "o", "wc -l /workspace/solution.py\r\n\u001b[?2004l\r"]
[789.597199, "o", "91 /workspace/solution.py\r\n"]
[789.597419, "o", "\u001b[?2004hroot@modal:/# "]
[789.967687, "i", "cat > /workspace/test_local.py <<'PYEOF'\nimport torch, importlib.util, sys\n\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\nref = load('/opt/task/reference.py', 'refmod')\nsol = load('/workspace/solution.py', 'solmod')\n\ntorch.manual_seed(42)\nm_ref = ref.Model(4096, 4096, 0.5).cuda()\ntorch.manual_seed(42)\nm_new = sol.ModelNew(4096, 4096, 0.5).cuda()\n\nok = True\nfor trial in range(8):\n    torch.manual_seed(1000 + trial)\n    x = torch.rand(16384, 4096, device='cuda')\n    with torch.no_grad():\n        r = m_ref(x)\n        o = m_new(x)\n    d = (r - o).abs()\n    tol = 1e-4 + 1e-4 * r.abs()\n    passed = bool(torch.allclose(r, o, atol=1e-4, rtol=1e-4))\n    print(f'trial {trial}: max_diff={d.max().item():.3e} mean_diff={d.mean().item():.3e} allclose={passed}')\n    ok = ok and passed\nprint('ALL PASS' if ok else 'FAIL')\n\nfrom kernelbench.timing import get_timing_function\ntorch.manual_seed(42"]
[789.9678, "i", ")\nx = torch.rand(16384, 4096, device='cuda')\ntiming_fn = get_timing_function('cuda_event')\nfor name, m in [('ref', m_ref), ('new', m_new)]:\n    times = timing_fn(m, [x], num_trials=20, verbose=False, device=torch.device('cuda:0'))\n    import numpy as np\n    print(name, 'mean ms:', float(np.mean(times)), 'min:', float(np.min(times)))\nPYEOF\ngpu sync\n"]
[789.967933, "o", "cat > /workspace/test_local.py <<'PYEOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
