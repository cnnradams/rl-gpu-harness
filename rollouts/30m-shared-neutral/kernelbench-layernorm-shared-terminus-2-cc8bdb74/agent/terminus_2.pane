[32m[K137[m[K[36m[K-[m[K    # NOTE: we can make this more adaptive based on device
[32m[K138[m[K[36m[K-[m[K    # L2 cache sizes: A100=40MB, H100=50MB, H200=90MB, RTX4090=72MB, L40S=48MB, Blackwell≈192MB → overwrite >200MB to fully thrash L2
