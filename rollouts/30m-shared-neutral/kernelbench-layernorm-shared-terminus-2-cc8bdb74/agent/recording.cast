[614.974427, "o", "ps=4 P=128 blocks=2048: mean=306.1us min=304.1 max=308.4\r\nBLOCK=4096 SPLIT=8 warps=8 P=128 blocks=2048: mean=297.0us min=295.2 max=298.0\r\nBLOCK=4096 SPLIT=8 warps=16 P=128 blocks=2048: mean=296.0us min=295.1 max=296.8\r\nBLOCK=4096 SPLIT=4 warps=4 P=256 blocks=4096: mean=297.7us min=296.9 max=298.5\r\nBLOCK=4096 SPLIT=4 warps=8 P=256 blocks=4096: mean=294.3us min=293.3 max=295.7\r\nBLOCK=4096 SPLIT=4 warps=16 P=256 blocks=4096: mean=295.7us min=294.2 max=297.5\r\nBLOCK=8192 SPLIT=4 warps=4 P=128 blocks=2048: mean=293.9us min=291.7 max=295.6\r\nBLOCK=8192 SPLIT=4 warps=8 P=128 blocks=2048: mean=304.2us min=302.8 max=305.4\r\nBLOCK=8192 SPLIT=4 warps=16 P=128 blocks=2048: mean=311.4us min=310.1 max=312.7\r\nBLOCK=8192 SPLIT=2 warps=4 P=256 blocks=4096: mean=298.7us min=297.9 max=299.9\r\nBLOCK=8192 SPLIT=2 warps=8 P=256 blocks=4096: mean=294.5us min=293.5 max=295.5\r\nBLOCK=8192 SPLIT=2 warps=16 P=256 blocks=4096: mean=294.9us min=293.3 max=296.4\r\nBLOCK=16384 SPLIT=2 warps=4 P=128 blocks=2048: mean=1648.2us min=1645.1 max=1649.9"]
[614.974567, "o", "\r\nBLOCK=16384 SPLIT=2 warps=8 P=128 blocks=2048: mean=295.1us min=293.6 max=296.4\r\nBLOCK=16384 SPLIT=2 warps=16 P=128 blocks=2048: mean=326.7us min=325.5 max=328.0\r\n\u001b[?2004hroot@modal:/# "]
[723.509391, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _stats_h(X, S1, S2, N, P, BLOCK: tl.constexpr, SPLIT: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0)\n    part = tl.program_id(1)\n    base = X + row.to(tl.int64) * N + part * (SPLIT * BLOCK)\n    cols = tl.arange(0, BLOCK)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(SPLIT):\n        if EV:\n            x = tl.load(base + i * BLOCK + cols, eviction_policy='evict_last')\n        else:\n            x = tl.load(base + i * BLOCK + cols)\n        acc += x\n        acc2 += x * x\n    tl.store(S1 + row * P + part, tl.sum(acc, axis=0))\n    tl.store(S2 + row * P + part, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply_h(X, Y, W, B, S1, S2, N, P, eps,\n             BLOCK: tl.constexpr, SPLIT: tl.constexpr, PB: tl.constexpr, REV: tl.constexpr, EV: tl.constexpr):\n    row = tl.program_id(0)\n    part = tl.program_id(1)\n    if REV:\n        part = P - "]
[723.509442, "i", "1 - part\n    parts = tl.arange(0, PB)\n    pmask = parts < P\n    s1 = tl.load(S1 + row * P + parts, mask=pmask, other=0.0)\n    s2 = tl.load(S2 + row * P + parts, mask=pmask, other=0.0)\n    mean = tl.sum(s1, axis=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + part * (SPLIT * BLOCK)\n    cols = tl.arange(0, BLOCK)\n    wbase = part * (SPLIT * BLOCK) + cols\n    for i in range(SPLIT):\n        off = i * BLOCK\n        if EV:\n            x = tl.load(X + base + off + cols, eviction_policy='evict_first')\n            w = tl.load(W + wbase + off)\n            b = tl.load(B + wbase + off)\n            tl.store(Y + base + off + cols, (x - mean) * rstd * w + b, cache_modifier='.cs')\n        else:\n            x = tl.load(X + base + off + cols)\n            w = tl.load(W + wbase + off)\n            b = tl.load(B + wbase + off)\n            tl.store(Y + base + off + cols, (x - mean) * rstd * w + b)\n\n@triton.jit\ndef _fused(X, Y, W, B, BUF, N, Bsz, P, Pf, eps,"]
[723.509449, "i", "\n           BLOCK: tl.constexpr, SPLIT: tl.constexpr, MIR: tl.constexpr):\n    row = tl.program_id(0)\n    part = tl.program_id(1)\n    chunk = SPLIT * BLOCK\n    rowoff = row.to(tl.int64) * N\n    cols = tl.arange(0, BLOCK)\n    base = X + rowoff + part * chunk\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(SPLIT):\n        x = tl.load(base + i * BLOCK + cols, eviction_policy='evict_last')\n        acc += x\n        acc2 += x * x\n    tl.atomic_add(BUF + row, tl.sum(acc, axis=0))\n    tl.atomic_add(BUF + Bsz + row, tl.sum(acc2, axis=0))\n    tl.atomic_add(BUF + 2 * Bsz + row, 1.0, sem='release')\n    cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\n    while cnt < Pf:\n        cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\n    s1 = tl.load(BUF + row, volatile=True)\n    s2 = tl.load(BUF + Bsz + row, volatile=True)\n    mean = s1 / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    if MIR:\n        part2 = P - 1 - part\n    else:\n       "]
[723.509455, "i", " part2 = part\n    base2 = rowoff + part2 * chunk\n    wbase = part2 * chunk + cols\n    for i in range(SPLIT):\n        off = i * BLOCK\n        x = tl.load(X + base2 + off + cols, eviction_policy='evict_first')\n        w = tl.load(W + wbase + off)\n        b = tl.load(B + wbase + off)\n        tl.store(Y + base2 + off + cols, (x - mean) * rstd * w + b, cache_modifier='.cs')\n\nB, N = 16, 64*256*256\neps = 1e-5\nx = torch.rand(B, N, device='cuda')\nw = torch.rand(N, device='cuda')\nbias = torch.rand(N, device='cuda')\nref = torch.nn.functional.layer_norm(x, (N,), w, bias, eps)\ndummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n\ndef run(fn, tag):\n    fn()\n    torch.cuda.synchronize()\n    times = []\n    for t in range(12):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        if t >= 2: times.append(s.elapsed_time(e))\n    times.sort()\n "]
[723.509611, "i", "   print(f\"{tag}: mean={sum(times)/len(times)*1000:.1f}us min={times[0]*1000:.1f} max={times[-1]*1000:.1f}\", flush=True)\n\ndef twopass(BLOCK, SPLIT, nw, REV, EV):\n    chunk = BLOCK*SPLIT\n    P = N // chunk\n    PB = triton.next_power_of_2(P)\n    y = torch.empty_like(x)\n    s1 = torch.empty(B*P, device='cuda')\n    s2 = torch.empty(B*P, device='cuda')\n    def fn():\n        _stats_h[(B,P)](x, s1, s2, N, P, BLOCK=BLOCK, SPLIT=SPLIT, EV=EV, num_warps=nw)\n        _apply_h[(B,P)](x, y, w, bias, s1, s2, N, P, eps, BLOCK=BLOCK, SPLIT=SPLIT, PB=PB, REV=REV, EV=EV, num_warps=nw)\n    fn()\n    err = (y-ref).abs().max().item()\n    assert err < 1e-4, err\n    return fn\n\ndef fused(BLOCK, SPLIT, nw, MIR):\n    chunk = BLOCK*SPLIT\n    P = N // chunk\n    y = torch.empty_like(x)\n    def fn():\n        buf = torch.zeros(3*B, device='cuda')\n        _fused[(B,P)](x, y, w, bias, buf, N, B, P, float(P), eps, BLOCK=BLOCK, SPLIT=SPLIT, MIR=MIR, num_warps=nw)\n    fn()\n    err = (y-ref).abs().max().item()\n    assert err < 1e-4, err\n    return"]
[723.509656, "i", " fn\n\nrun(twopass(2048, 8, 16, False, False), 'A two-pass 2048/8/16 plain')\nrun(twopass(2048, 8, 16, False, True), 'C two-pass evict hints')\nrun(twopass(2048, 8, 16, True, True), 'B two-pass evict+rev')\nrun(twopass(2048, 16, 16, True, True), 'B2 two-pass evict+rev 2048/16/16')\nrun(fused(2048, 16, 16, False), 'D fused 2048/16/16')\nrun(fused(2048, 16, 16, True), 'E fused mirror')\nrun(fused(2048, 8, 16, True), 'F fused mirror 2048/8/16 (1024 blocks)')\nrun(fused(2048, 128, 8, False), 'G fused 2048/128/8 (256 blocks)')\nEOF\n"]
