[527.159061, "o", "    err = (y-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[527.159085, "o", "\u001b[?2004h> "]
[527.15913, "o", "    assert err < 1e-4, (BLOCK, SPLIT, nw, err)\r\n\u001b[?2004l\r"]
[527.159153, "o", "\u001b[?2004h> "]
[527.159235, "o", "    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.159263, "o", "> "]
[527.159299, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.159326, "o", "    for t in range(12):\r\n\u001b[?2004l\r"]
[527.159353, "o", "\u001b[?2004h> "]
[527.159382, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[527.159405, "o", "\u001b[?2004h> "]
[527.159431, "o", "        dummy.fill_(42)\r\n\u001b[?2004l\r"]
[527.159459, "o", "\u001b[?2004h> "]
[527.159556, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[527.159593, "o", "\u001b[?2004h> "]
[527.159623, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[527.159649, "o", "\u001b[?2004h> "]
[527.159675, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.159749, "o", "        if t >= 2: times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.159771, "o", "> "]
[527.159799, "o", "    times.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.159867, "o", "    return sum(times)/len(times), times[0], times[-1]\r\n\u001b[?2004l\r"]
[527.159895, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.16006, "o", "for (BLOCK, SPLIT) in [(2048,16),(2048,8),(2048,32),(1024,32),(1024,64),(1024,16),(512,64),(512,32),(4096,8),(4096,4),(8192,4),(8192,2),(16384,2)]:\r\n\u001b[?2004l\r"]
[527.160091, "o", "\u001b[?2004h> "]
[527.160118, "o", "    for nw in [4, 8, 16]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.16018, "o", "        if BLOCK//32 < nw and nw > 16: continue\r\n\u001b[?2004l\r"]
[527.160208, "o", "\u001b[?2004h> "]
[527.160238, "o", "        r = bench(BLOCK, SPLIT, nw)\r\n\u001b[?2004l\r"]
[527.160264, "o", "\u001b[?2004h> "]
[527.160479, "o", "        if r: print(f\"BLOCK={BLOCK} SPLIT={SPLIT} warps={nw} P={N//(BLOCK*SPLIT)} blocks={16*(N//(BLOCK*SPLIT))}: mean={r[0]*1000:.1f}us min={r[1]*1000:.1f} max={r[2]*1000:.1f}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[527.160513, "o", "> EOF\r\n\u001b[?2004l\r"]
