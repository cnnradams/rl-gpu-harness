[284.78968, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_fused_kernel(X, Y, W, B, BUF, N, Bsz, P, Pf, eps,\n                     BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    row = tl.program_id(0)\n    part = tl.program_id(1)\n    chunk = SPLIT * BLOCK\n    rowoff = row.to(tl.int64) * N\n    base = X + rowoff + part * chunk\n    cols = tl.arange(0, BLOCK)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(SPLIT):\n        x = tl.load(base + i * BLOCK + cols)\n        acc += x\n        acc2 += x * x\n    tl.atomic_add(BUF + row, tl.sum(acc, axis=0))\n    tl.atomic_add(BUF + Bsz + row, tl.sum(acc2, axis=0))\n    tl.atomic_add(BUF + 2 * Bsz + row, 1.0)\n    cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\n    while cnt < Pf:\n        cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\n    s1 = tl.load(BUF + row, volatile=True)\n    s2 = tl.load(BUF + Bsz + row, volatile=True)\n    mean ="]
[284.78973, "i", " s1 / N\n    var = s2 / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    ybase = Y + rowoff + part * chunk\n    wbase = part * chunk + cols\n    for i in range(SPLIT):\n        off = i * BLOCK\n        x = tl.load(base + off + cols)\n        w = tl.load(W + wbase + off)\n        b = tl.load(B + wbase + off)\n        tl.store(ybase + off + cols, (x - mean) * rstd * w + b)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.normalized_shape = tuple(normalized_shape)\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        n = 1\n        for d in self.normalized_shape:\n            n *= d\n        self.N = n\n        self.BLOCK = 2048\n        self.SPLIT = 128\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        n = self.N\n        chunk = self.BLOCK * self.SPLIT\n        if (not x.is_cuda) or x.dtype != torch.float32 or n % chunk != 0:\n            return self.ln(x)\n        x = x.contiguous()\n        batch = x.numel() // n\n   "]
[284.789864, "i", "     P = n // chunk\n        y = torch.empty_like(x)\n        buf = torch.zeros(3 * batch, device=x.device, dtype=torch.float32)\n        _ln_fused_kernel[(batch, P)](\n            x, y, self.ln.weight, self.ln.bias, buf, n, batch, P, float(P),\n            self.ln.eps, BLOCK=self.BLOCK, SPLIT=self.SPLIT, num_warps=8)\n        return y\nEOF\n"]
