[527.158823, "o", "        _stats[(B,P)](x, s1, s2, N, P, BLOCK=BLOCK, SPLIT=SPLIT, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.158954, "o", "        _apply[(B,P)](x, y, w, bias, s1, s2, N, P, eps, BLOCK=BLOCK, SPLIT=SPLIT, PB=PB, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
