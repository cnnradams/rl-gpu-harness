[723.513001, "o", "    s1 = tl.load(S1 + row * P + parts, mask=pmask, other=0.0)\r\n\u001b[?2004l\r"]
[723.513018, "o", "\u001b[?2004h> "]
[723.513168, "o", "    s2 = tl.load(S2 + row * P + parts, mask=pmask, other=0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.513208, "o", "> "]
[723.513269, "o", "    mean = tl.sum(s1, axis=0) / N\r\n\u001b[?2004l\r"]
[723.513308, "o", "\u001b[?2004h> "]
[723.513391, "o", "    var = tl.sum(s2, axis=0) / N - mean * mean\r\n\u001b[?2004l\r"]
[723.51343, "o", "\u001b[?2004h> "]
[723.513494, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[723.513533, "o", "\u001b[?2004h> "]
[723.513644, "o", "    base = row.to(tl.int64) * N + part * (SPLIT * BLOCK)\r\n\u001b[?2004l\r"]
[723.513685, "o", "\u001b[?2004h> "]
[723.513744, "o", "    cols = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.513783, "o", "> "]
[723.513855, "o", "    wbase = part * (SPLIT * BLOCK) + cols\r\n\u001b[?2004l\r"]
[723.513898, "o", "\u001b[?2004h> "]
[723.513936, "o", "    for i in range(SPLIT):\r\n\u001b[?2004l\r"]
[723.513975, "o", "\u001b[?2004h> "]
[723.514013, "o", "        off = i * BLOCK\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.514051, "o", "> "]
[723.514098, "o", "        if EV:\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.514136, "o", "> "]
[723.514221, "o", "            x = tl.load(X + base + off + cols, eviction_policy='evict_first')\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.514261, "o", "> "]
[723.514281, "o", "            w = tl.load(W + wbase + off)\r\n\u001b[?2004l\r"]
[723.514321, "o", "\u001b[?2004h> "]
[723.514359, "o", "            b = tl.load(B + wbase + off)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.514462, "o", "            tl.store(Y + base + off + cols, (x - mean) * rstd * w + b, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[723.514501, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.514563, "o", "            x = tl.load(X + base + off + cols)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.514603, "o", "> "]
[723.514641, "o", "            w = tl.load(W + wbase + off)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.514679, "o", "            b = tl.load(B + wbase + off)\r\n\u001b[?2004l\r"]
[723.514718, "o", "\u001b[?2004h> "]
[723.514781, "o", "            tl.store(Y + base + off + cols, (x - mean) * rstd * w + b)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.514821, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.51486, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.5149, "o", "def _fused(X, Y, W, B, BUF, N, Bsz, P, Pf, eps,\r\n\u001b[?2004l\r"]
[723.51494, "o", "\u001b[?2004h> "]
[723.515007, "o", "           BLOCK: tl.constexpr, SPLIT: tl.constexpr, MIR: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.515047, "o", ">     row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[723.51509, "o", "\u001b[?2004h> "]
[723.51513, "o", "    part = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515176, "o", "    chunk = SPLIT * BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515216, "o", "    rowoff = row.to(tl.int64) * N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515254, "o", "    cols = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[723.515293, "o", "\u001b[?2004h> "]
[723.515332, "o", "    base = X + rowoff + part * chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515384, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[723.515424, "o", "\u001b[?2004h> "]
[723.515463, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515505, "o", "    for i in range(SPLIT):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515595, "o", "        x = tl.load(base + i * BLOCK + cols, eviction_policy='evict_last')\r\n\u001b[?2004l\r"]
[723.515634, "o", "\u001b[?2004h>         acc += x\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.515674, "o", ">         acc2 += x * x\r\n\u001b[?2004l\r"]
[723.515716, "o", "\u001b[?2004h> "]
[723.515755, "o", "    tl.atomic_add(BUF + row, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.515824, "o", "    tl.atomic_add(BUF + Bsz + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r"]
[723.515863, "o", "\u001b[?2004h> "]
[723.515902, "o", "    tl.atomic_add(BUF + 2 * Bsz + row, 1.0, sem='release')\r\n\u001b[?2004l\r"]
[723.515941, "o", "\u001b[?2004h> "]
[723.515978, "o", "    cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\r\n\u001b[?2004l\r"]
[723.516017, "o", "\u001b[?2004h>     while cnt < Pf:\r\n\u001b[?2004l\r"]
[723.516057, "o", "\u001b[?2004h> "]
[723.516096, "o", "        cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\r\n\u001b[?2004l\r"]
[723.516135, "o", "\u001b[?2004h> "]
[723.51618, "o", "    s1 = tl.load(BUF + row, volatile=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.516219, "o", "> "]
[723.516256, "o", "    s2 = tl.load(BUF + Bsz + row, volatile=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.516295, "o", "    mean = s1 / N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.516335, "o", "    var = s2 / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.516373, "o", "> "]
[723.516412, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h>     if MIR:\r\n\u001b[?2004l\r"]
[723.516451, "o", "\u001b[?2004h> "]
[723.51649, "o", "        part2 = P - 1 - part\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[723.516529, "o", "\u001b[?2004h> "]
[723.516567, "o", "        part2 = part\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.516606, "o", "    base2 = rowoff + part2 * chunk\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.516649, "o", ">     wbase = part2 * chunk + cols\r\n\u001b[?2004l\r"]
[723.516688, "o", "\u001b[?2004h> "]
[723.516727, "o", "    for i in range(SPLIT):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.516767, "o", "        off = i * BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.516843, "o", "        x = tl.load(X + base2 + off + cols, eviction_policy='evict_first')\r\n\u001b[?2004l\r"]
[723.516887, "o", "\u001b[?2004h> "]
[723.516926, "o", "        w = tl.load(W + wbase + off)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.516966, "o", "        b = tl.load(B + wbase + off)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.517005, "o", "> "]
[723.517074, "o", "        tl.store(Y + base2 + off + cols, (x - mean) * rstd * w + b, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[723.517113, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517153, "o", "B, N = 16, 64*256*256\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517199, "o", "eps = 1e-5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517237, "o", "x = torch.rand(B, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517284, "o", "w = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[723.517323, "o", "\u001b[?2004h> "]
[723.517362, "o", "bias = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517428, "o", "ref = torch.nn.functional.layer_norm(x, (N,), w, bias, eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.517467, "o", "> "]
[723.517518, "o", "dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\r\n\u001b[?2004l\r"]
[723.517557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517597, "o", "def run(fn, tag):\r\n\u001b[?2004l\r\u001b[?2004h>     fn()\r\n"]
[723.517637, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[723.517675, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517714, "o", "    times = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517753, "o", "    for t in range(12):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.517792, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.517832, "o", ">         dummy.fill_(42)\r\n\u001b[?2004l\r"]
[723.51787, "o", "\u001b[?2004h> "]
[723.517946, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r"]
[723.517987, "o", "\u001b[?2004h> "]
[723.518024, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.518063, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.518101, "o", "> "]
[723.518141, "o", "        if t >= 2: times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.518185, "o", "    times.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.518324, "o", "    print(f\"{tag}: mean={sum(times)/len(times)*1000:.1f}us min={times[0]*1000:.1f} max={times[-1]*1000:.1f}\", flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.518366, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.518405, "o", "def twopass(BLOCK, SPLIT, nw, REV, EV):\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.518445, "o", ">     chunk = BLOCK*SPLIT\r\n\u001b[?2004l\r"]
[723.518485, "o", "\u001b[?2004h>     P = N // chunk\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.518526, "o", "> "]
[723.518566, "o", "    PB = triton.next_power_of_2(P)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.518605, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.518653, "o", "    s1 = torch.empty(B*P, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.518692, "o", "> "]
[723.518712, "o", "    s2 = torch.empty(B*P, device='cuda')\r\n\u001b[?2004l\r"]
[723.518753, "o", "\u001b[?2004h>     def fn():\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.518792, "o", "> "]
[723.518859, "o", "        _stats_h[(B,P)](x, s1, s2, N, P, BLOCK=BLOCK, SPLIT=SPLIT, EV=EV, num_warps=nw)\r\n\u001b[?2004l\r"]
[723.518901, "o", "\u001b[?2004h> "]
[723.519019, "o", "        _apply_h[(B,P)](x, y, w, bias, s1, s2, N, P, eps, BLOCK=BLOCK, SPLIT=SPLIT, PB=PB, REV=REV, EV=EV, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.519066, "o", ">     fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.519104, "o", "    err = (y-ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.519142, "o", ">     assert err < 1e-4, err\r\n\u001b[?2004l\r"]
[723.519193, "o", "\u001b[?2004h>     return fn\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.519232, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.519271, "o", "def fused(BLOCK, SPLIT, nw, MIR):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.51931, "o", "    chunk = BLOCK*SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.51935, "o", "    P = N // chunk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.519388, "o", "    y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[723.519428, "o", "\u001b[?2004h>     def fn():\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.519466, "o", "> "]
[723.519508, "o", "        buf = torch.zeros(3*B, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.519631, "o", "        _fused[(B,P)](x, y, w, bias, buf, N, B, P, float(P), eps, BLOCK=BLOCK, SPLIT=SPLIT, MIR=MIR, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.51967, "o", ">     fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.519719, "o", "    err = (y-ref).abs().max().item()\r\n\u001b[?2004l\r"]
[723.519759, "o", "\u001b[?2004h>     assert err < 1e-4, err\r\n"]
[723.519797, "o", "\u001b[?2004l\r\u001b[?2004h>     return fn\r\n\u001b[?2004l\r"]
[723.519835, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.519917, "o", "run(twopass(2048, 8, 16, False, False), 'A two-pass 2048/8/16 plain')\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.519956, "o", "> "]
[723.520004, "o", "run(twopass(2048, 8, 16, False, True), 'C two-pass evict hints')\r\n\u001b[?2004l\r\u001b[?2004h"]
[723.520043, "o", "> "]
[723.520082, "o", "run(twopass(2048, 8, 16, True, True), 'B two-pass evict+rev')\r\n\u001b[?2004l\r"]
[723.520121, "o", "\u001b[?2004h> "]
[723.520191, "o", "run(twopass(2048, 16, 16, True, True), 'B2 two-pass evict+rev 2048/16/16')\r\n\u001b[?2004l\r"]
[723.52023, "o", "\u001b[?2004h> "]
[723.520268, "o", "run(fused(2048, 16, 16, False), 'D fused 2048/16/16')\r\n\u001b[?2004l\r"]
[723.520311, "o", "\u001b[?2004h> "]
[723.52035, "o", "run(fused(2048, 16, 16, True), 'E fused mirror')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[723.520436, "o", "run(fused(2048, 8, 16, True), 'F fused mirror 2048/8/16 (1024 blocks)')\r\n\u001b[?2004l\r"]
[723.520475, "o", "\u001b[?2004h> "]
[723.520528, "o", "run(fused(2048, 128, 8, False), 'G fused 2048/128/8 (256 blocks)')\r\n\u001b[?2004l\r"]
[723.520567, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
