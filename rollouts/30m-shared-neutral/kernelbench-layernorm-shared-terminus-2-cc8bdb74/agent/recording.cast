[519.403179, "o", "grep -n -A 20 \"def clear_l2_cache\" /usr/local/lib/python3.10/dist-packages/kernelbench/timing.py\r\n\u001b[?2004l\r"]
[519.404242, "o", "\u001b[32m\u001b[K126\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef clear_l2_cache\u001b[m\u001b[K(device: torch.device | str = \"cuda\"):\r\n\u001b[32m\u001b[K127\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K128\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Clear L2 Cache line by thrashing with a large tensor\r\n\u001b[32m\u001b[K129\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Acknowledge GPU mode reference kernel repo:\r\n\u001b[32m\u001b[K130\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    https://github.com/gpu-mode/reference-kernels/commit/7c15075a39286e88939d99d3f3a60be88b8e6223#diff-3a30a71cbf8db2badd224f4d92f9a2546925a5b522632a31d353526b7a5f3338R158-R163\r\n\u001b[32m\u001b[K131\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K132\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # don't reserve space for persisting lines\r\n\u001b[32m\u001b[K133\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # cp.cuda.runtime.cudaDeviceSetLimit(cp.cuda.runtime.cudaLimitPersistingL2CacheSize, 0)\r\n\u001b[32m\u001b[K134\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \r\n\u001b[32m\u001b[K135\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # Thrash L2 cache by creating a larger dummy tensor, effectively flushing the cache\r\n\u001b[32m\u001b[K136\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # 32 * 1024 * 1024 * 8B = 256MB \r\n\u001b[32m\u001b[K137\u001b[m\u001b[K\u001b[3"]
[519.404285, "o", "6m\u001b[K-\u001b[m\u001b[K    # NOTE: we can make this more adaptive based on device\r\n\u001b[32m\u001b[K138\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # L2 cache sizes: A100=40MB, H100=50MB, H200=90MB, RTX4090=72MB, L40S=48MB, Blackwell≈192MB → overwrite >200MB to fully thrash L2\r\n\u001b[32m\u001b[K139\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    dummy = torch.empty((32, 1024, 1024), dtype=torch.int64, device=device)\r\n\u001b[32m\u001b[K140\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    # write to tensor with inplace fill\r\n\u001b[32m\u001b[K141\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    dummy.fill_(42) \r\n\u001b[32m\u001b[K142\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    del dummy\r\n\u001b[32m\u001b[K143\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K144\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[Kdef clear_l2_cache\u001b[m\u001b[K_triton(cache=None, device: str = \"cuda\"):\r\n\u001b[32m\u001b[K145\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K146\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Thrash the cache by making a large dummy tensor, using triton runtime's functionality\r\n\u001b[32m\u001b[K147\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K148\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    from triton import runtime as triton_runtime\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    with torch.cuda.device(device)"]
[519.404314, "o", ":\r\n\u001b[32m\u001b[K150\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        cache = triton_runtime.driver.active.get_empty_cache_for_benchmark()\r\n\u001b[32m\u001b[K151\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        # this effectively thrashes L2 cache under the hood too\r\n\u001b[32m\u001b[K152\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        triton_runtime.driver.active.clear_cache(cache)\r\n\u001b[32m\u001b[K153\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K154\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K155\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[Kdef get_timing_function(\r\n\u001b[32m\u001b[K156\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    method: str = \"cuda_event\", # by default \r\n\u001b[32m\u001b[K157\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K) -> callable:\r\n\u001b[32m\u001b[K158\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    \"\"\"\r\n\u001b[32m\u001b[K159\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Get timing function by method name.\r\n\u001b[32m\u001b[K160\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K\r\n\u001b[32m\u001b[K161\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K    Available methods:\r\n\u001b[32m\u001b[K162\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        - \"cuda_event\": torch.cuda.event timing (default, explicit trial control)\r\n\u001b[32m\u001b[K163\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K        - \"do_bench\": Use triton's do_bench (adaptive trial count based on time budget)\r\n\u001b[32m\u001b[K164\u001b[m\u001b[K\u001b[36m\u001b[K-\u001b[m\u001b[K"]
[519.404339, "o", "        - \"do_bench_impl\": Mirrors Triton's do_bench implementation (explicit control)\r\n"]
[519.404454, "o", "\u001b[?2004hroot@modal:/# "]
[527.155242, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, sys\nimport triton\nimport triton.language as tl\n\n@triton.jit\ndef _stats(X, S1, S2, N, P, BLOCK: tl.constexpr, SPLIT: tl.constexpr):\n    row = tl.program_id(0)\n    part = tl.program_id(1)\n    base = X + row.to(tl.int64) * N + part * (SPLIT * BLOCK)\n    cols = tl.arange(0, BLOCK)\n    acc = tl.zeros([BLOCK], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(SPLIT):\n        x = tl.load(base + i * BLOCK + cols)\n        acc += x\n        acc2 += x * x\n    tl.store(S1 + row * P + part, tl.sum(acc, axis=0))\n    tl.store(S2 + row * P + part, tl.sum(acc2, axis=0))\n\n@triton.jit\ndef _apply(X, Y, W, B, S1, S2, N, P, eps,\n           BLOCK: tl.constexpr, SPLIT: tl.constexpr, PB: tl.constexpr):\n    row = tl.program_id(0)\n    part = tl.program_id(1)\n    parts = tl.arange(0, PB)\n    pmask = parts < P\n    s1 = tl.load(S1 + row * P + parts, mask=pmask, other=0.0)\n    s2 = tl.load(S2 + row * P + parts, mask=pmask, other=0.0)\n    mean = tl.sum(s1, axi"]
[527.155305, "i", "s=0) / N\n    var = tl.sum(s2, axis=0) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = row.to(tl.int64) * N + part * (SPLIT * BLOCK)\n    cols = tl.arange(0, BLOCK)\n    wbase = part * (SPLIT * BLOCK) + cols\n    for i in range(SPLIT):\n        off = i * BLOCK\n        x = tl.load(X + base + off + cols)\n        w = tl.load(W + wbase + off)\n        b = tl.load(B + wbase + off)\n        tl.store(Y + base + off + cols, (x - mean) * rstd * w + b)\n\nB, N = 16, 64*256*256\neps = 1e-5\nx = torch.rand(B, N, device='cuda')\nw = torch.rand(N, device='cuda')\nbias = torch.rand(N, device='cuda')\nref = torch.nn.functional.layer_norm(x, (N,), w, bias, eps)\n\ndef bench(BLOCK, SPLIT, nw):\n    chunk = BLOCK*SPLIT\n    if N % chunk: return None\n    P = N // chunk\n    PB = triton.next_power_of_2(P)\n    y = torch.empty_like(x)\n    s1 = torch.empty(B*P, device='cuda')\n    s2 = torch.empty(B*P, device='cuda')\n    def fn():\n        _stats[(B,P)](x, s1, s2, N, P, BLOCK=BLOCK, SPLIT=SPLIT, num_warps=nw)\n        _apply[(B,P)](x, y,"]
[527.155313, "i", " w, bias, s1, s2, N, P, eps, BLOCK=BLOCK, SPLIT=SPLIT, PB=PB, num_warps=nw)\n    fn()\n    err = (y-ref).abs().max().item()\n    assert err < 1e-4, (BLOCK, SPLIT, nw, err)\n    dummy = torch.empty((32,1024,1024), dtype=torch.int64, device='cuda')\n    times = []\n    for t in range(12):\n        torch.cuda.synchronize()\n        dummy.fill_(42)\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        if t >= 2: times.append(s.elapsed_time(e))\n    times.sort()\n    return sum(times)/len(times), times[0], times[-1]\n\nfor (BLOCK, SPLIT) in [(2048,16),(2048,8),(2048,32),(1024,32),(1024,64),(1024,16),(512,64),(512,32),(4096,8),(4096,4),(8192,4),(8192,2),(16384,2)]:\n    for nw in [4, 8, 16]:\n        if BLOCK//32 < nw and nw > 16: continue\n        r = bench(BLOCK, SPLIT, nw)\n        if r: print(f\"BLOCK={BLOCK} SPLIT={SPLIT} warps={nw} P={N//(BLOCK*SPLIT)} blocks={16*(N//(BLOCK*SPLIT))}: mean={r[0]*1000:.1f}us min={r"]
[527.155449, "i", "[1]*1000:.1f} max={r[2]*1000:.1f}\", flush=True)\nEOF\n"]
[527.155478, "o", "cat > /workspace/sweep.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, sys\r\n\u001b[?2004l\r"]
