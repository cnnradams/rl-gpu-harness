[527.158331, "o", "\u001b[?2004h> "]
[527.158356, "o", "    chunk = BLOCK*SPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[527.158401, "o", "    if N % chunk: return None\r\n\u001b[?2004l\r\u001b[?2004h"]
