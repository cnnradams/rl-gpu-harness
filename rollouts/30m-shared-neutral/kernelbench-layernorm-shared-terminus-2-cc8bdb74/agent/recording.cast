[284.790008, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.790029, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.790051, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[284.790071, "o", "\u001b[?2004h> "]
[284.790142, "o", "def _ln_fused_kernel(X, Y, W, B, BUF, N, Bsz, P, Pf, eps,\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.790157, "o", "> "]
[284.790229, "o", "                     BLOCK: tl.constexpr, SPLIT: tl.constexpr):\r\n\u001b[?2004l\r"]
[284.790244, "o", "\u001b[?2004h> "]
[284.790276, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[284.790301, "o", "\u001b[?2004h> "]
[284.790331, "o", "    part = tl.program_id(1)\r\n\u001b[?2004l\r"]
[284.790357, "o", "\u001b[?2004h> "]
[284.79038, "o", "    chunk = SPLIT * BLOCK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.790422, "o", "    rowoff = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[284.790448, "o", "\u001b[?2004h> "]
[284.79048, "o", "    base = X + rowoff + part * chunk\r\n\u001b[?2004l\r"]
[284.790505, "o", "\u001b[?2004h> "]
[284.790532, "o", "    cols = tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[284.790561, "o", "\u001b[?2004h> "]
[284.790599, "o", "    acc = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[284.790625, "o", "\u001b[?2004h> "]
[284.790665, "o", "    acc2 = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[284.790687, "o", "\u001b[?2004h> "]
[284.790712, "o", "    for i in range(SPLIT):\r\n\u001b[?2004l\r"]
[284.790737, "o", "\u001b[?2004h> "]
[284.790778, "o", "        x = tl.load(base + i * BLOCK + cols)\r\n\u001b[?2004l\r"]
[284.790804, "o", "\u001b[?2004h> "]
[284.790826, "o", "        acc += x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.790858, "o", "        acc2 += x * x\r\n\u001b[?2004l\r"]
[284.790878, "o", "\u001b[?2004h> "]
[284.790928, "o", "    tl.atomic_add(BUF + row, tl.sum(acc, axis=0))\r\n\u001b[?2004l\r"]
[284.790949, "o", "\u001b[?2004h> "]
[284.791022, "o", "    tl.atomic_add(BUF + Bsz + row, tl.sum(acc2, axis=0))\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.791044, "o", "> "]
[284.79108, "o", "    tl.atomic_add(BUF + 2 * Bsz + row, 1.0)\r\n\u001b[?2004l\r"]
[284.791104, "o", "\u001b[?2004h> "]
[284.791156, "o", "    cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\r\n\u001b[?2004l\r"]
[284.791181, "o", "\u001b[?2004h> "]
[284.791206, "o", "    while cnt < Pf:\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.791238, "o", "> "]
[284.791283, "o", "        cnt = tl.load(BUF + 2 * Bsz + row, volatile=True)\r\n\u001b[?2004l\r"]
[284.791305, "o", "\u001b[?2004h> "]
[284.791347, "o", "    s1 = tl.load(BUF + row, volatile=True)\r\n\u001b[?2004l\r"]
[284.79137, "o", "\u001b[?2004h> "]
[284.791415, "o", "    s2 = tl.load(BUF + Bsz + row, volatile=True)\r\n\u001b[?2004l\r"]
[284.791439, "o", "\u001b[?2004h> "]
[284.791462, "o", "    mean = s1 / N\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.791485, "o", "> "]
[284.791505, "o", "    var = s2 / N - mean * mean\r\n\u001b[?2004l\r"]
[284.791529, "o", "\u001b[?2004h> "]
[284.791561, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[284.791585, "o", "\u001b[?2004h> "]
[284.791619, "o", "    ybase = Y + rowoff + part * chunk\r\n\u001b[?2004l\r"]
[284.791644, "o", "\u001b[?2004h> "]
[284.79167, "o", "    wbase = part * chunk + cols\r\n\u001b[?2004l\r"]
[284.791694, "o", "\u001b[?2004h> "]
[284.791718, "o", "    for i in range(SPLIT):\r\n\u001b[?2004l\r"]
[284.791741, "o", "\u001b[?2004h> "]
[284.791765, "o", "        off = i * BLOCK\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.79179, "o", "> "]
[284.791817, "o", "        x = tl.load(base + off + cols)\r\n\u001b[?2004l\r"]
[284.791839, "o", "\u001b[?2004h> "]
[284.791884, "o", "        w = tl.load(W + wbase + off)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.791908, "o", "> "]
[284.791937, "o", "        b = tl.load(B + wbase + off)\r\n\u001b[?2004l\r"]
[284.791961, "o", "\u001b[?2004h> "]
[284.792022, "o", "        tl.store(ybase + off + cols, (x - mean) * rstd * w + b)\r\n\u001b[?2004l\r"]
[284.792043, "o", "\u001b[?2004h> \r\n"]
[284.792068, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.792103, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[284.792127, "o", "\u001b[?2004h> "]
[284.792171, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[284.792196, "o", "\u001b[?2004h> "]
[284.792217, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[284.792242, "o", "\u001b[?2004h> "]
[284.792301, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[284.792324, "o", "\u001b[?2004h> "]
[284.792388, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[284.792412, "o", "\u001b[?2004h> "]
[284.792435, "o", "        n = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.792487, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[284.79251, "o", "\u001b[?2004h> "]
[284.792534, "o", "            n *= d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.79256, "o", "        self.N = n\r\n\u001b[?2004l\r"]
[284.792584, "o", "\u001b[?2004h> "]
[284.792608, "o", "        self.BLOCK = 2048\r\n\u001b[?2004l\r"]
[284.792631, "o", "\u001b[?2004h> "]
[284.792655, "o", "        self.SPLIT = 128\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.792679, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.792752, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.792782, "o", "        n = self.N\r\n\u001b[?2004l\r"]
[284.792805, "o", "\u001b[?2004h> "]
[284.792842, "o", "        chunk = self.BLOCK * self.SPLIT\r\n\u001b[?2004l\r"]
[284.792866, "o", "\u001b[?2004h> "]
[284.792938, "o", "        if (not x.is_cuda) or x.dtype != torch.float32 or n % chunk != 0:\r\n\u001b[?2004l\r"]
[284.792958, "o", "\u001b[?2004h> "]
[284.792987, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[284.793011, "o", "\u001b[?2004h> "]
[284.793036, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[284.793059, "o", "\u001b[?2004h> "]
[284.793088, "o", "        batch = x.numel() // n\r\n\u001b[?2004l\r"]
[284.793112, "o", "\u001b[?2004h> "]
[284.793135, "o", "        P = n // chunk\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.793159, "o", "> "]
[284.793179, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r"]
[284.793199, "o", "\u001b[?2004h> "]
[284.793286, "o", "        buf = torch.zeros(3 * batch, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.793311, "o", "> "]
[284.793339, "o", "        _ln_fused_kernel[(batch, P)](\r\n\u001b[?2004l\r"]
[284.793363, "o", "\u001b[?2004h> "]
[284.793439, "o", "            x, y, self.ln.weight, self.ln.bias, buf, n, batch, P, float(P),\r\n\u001b[?2004l\r"]
[284.793463, "o", "\u001b[?2004h> "]
[284.793537, "o", "            self.ln.eps, BLOCK=self.BLOCK, SPLIT=self.SPLIT, num_warps=8)\r\n\u001b[?2004l\r"]
[284.793561, "o", "\u001b[?2004h> "]
[284.793585, "o", "        return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.793608, "o", "EOF\r\n\u001b[?2004l\r"]
[284.79473, "o", "\u001b[?2004hroot@modal:/# "]
