[502.753519, "o", "            a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[502.753544, "o", "\u001b[?2004h> "]
[502.753636, "o", "            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[502.75367, "o", "\u001b[?2004h> "]
[502.753724, "o", "            wh = tl.load(wh_ptrs)\r\n\u001b[?2004l\r"]
[502.75375, "o", "\u001b[?2004h> "]
[502.753808, "o", "            wl = tl.load(wl_ptrs)\r\n\u001b[?2004l\r"]
[502.753835, "o", "\u001b[?2004h> "]
[502.753895, "o", "            acc = tl.dot(a_hi, wh, acc)\r\n\u001b[?2004l\r"]
[502.753921, "o", "\u001b[?2004h> "]
[502.75398, "o", "            acc = tl.dot(a_hi, wl, acc)\r\n\u001b[?2004l\r"]
[502.754004, "o", "\u001b[?2004h> "]
[502.754066, "o", "            acc = tl.dot(a_lo, wh, acc)\r\n\u001b[?2004l\r"]
[502.754091, "o", "\u001b[?2004h> "]
[502.754136, "o", "            a_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[502.75416, "o", "\u001b[?2004h> "]
[502.754213, "o", "            wh_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[502.754238, "o", "\u001b[?2004h> "]
[502.754296, "o", "            wl_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[502.754322, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.754396, "o", "        bias = tl.load(b_ptr + offs_n)\r\n\u001b[?2004l\r"]
[502.754428, "o", "\u001b[?2004h> "]
[502.754493, "o", "        acc = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r"]
[502.754525, "o", "\u001b[?2004h> "]
[502.754615, "o", "        c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[502.754647, "o", "\u001b[?2004h> "]
[502.754681, "o", "        tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[502.754718, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.754743, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.754801, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[502.754836, "o", "\u001b[?2004h> "]
[502.754931, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h"]
[502.754959, "o", "> "]
[502.755016, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[502.75504, "o", "\u001b[?2004h> "]
[502.755133, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[502.755157, "o", "\u001b[?2004h> "]
[502.755228, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[502.75526, "o", "\u001b[?2004h> "]
[502.755295, "o", "        self._w_hi = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[502.75532, "o", "> "]
[502.755352, "o", "        self._w_lo = None\r\n\u001b[?2004l\r"]
[502.755386, "o", "\u001b[?2004h> "]
[502.75542, "o", "        self._w_key = None\r\n\u001b[?2004l\r"]
[502.755454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[502.755493, "o", "\u001b[?2004h> "]
[502.75552, "o", "    def _get_wsplit(self, w):\r\n\u001b[?2004l\r\u001b[?2004h"]
[502.755555, "o", "> "]
[502.755646, "o", "        key = (w.data_ptr(), w._version, w.device.index)\r\n\u001b[?2004l\r"]
[502.755669, "o", "\u001b[?2004h> "]
[502.755717, "o", "        if self._w_key != key:\r\n\u001b[?2004l\r"]
[502.755749, "o", "\u001b[?2004h> "]
[502.755809, "o", "            wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[502.755843, "o", "\u001b[?2004h> "]
[502.755889, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[502.755921, "o", "\u001b[?2004h> "]
[502.75601, "o", "            wl = (wt - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[502.756042, "o", "\u001b[?2004h> "]
[502.75607, "o", "            self._w_hi = wh\r\n\u001b[?2004l\r"]
[502.756102, "o", "\u001b[?2004h> "]
[502.756135, "o", "            self._w_lo = wl\r\n\u001b[?2004l\r"]
[502.756166, "o", "\u001b[?2004h> "]
[502.756208, "o", "            self._w_key = key\r\n\u001b[?2004l\r"]
[502.75624, "o", "\u001b[?2004h> "]
[502.75629, "o", "        return self._w_hi, self._w_lo\r\n\u001b[?2004l\r"]
[502.756321, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.756373, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[502.756402, "o", "\u001b[?2004h> "]
[502.756449, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[502.75648, "o", "\u001b[?2004h> "]
[502.756511, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[502.756543, "o", "\u001b[?2004h> "]
[502.756575, "o", "        if (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.756615, "o", "            _HAS_TRITON\r\n\u001b[?2004l\r"]
[502.756647, "o", "\u001b[?2004h> "]
[502.756682, "o", "            and x.is_cuda\r\n\u001b[?2004l\r"]
[502.756715, "o", "\u001b[?2004h> "]
[502.756768, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[502.756799, "o", "\u001b[?2004h> "]
[502.756854, "o", "            and w.dtype == torch.float32\r\n\u001b[?2004l\r"]
[502.756885, "o", "\u001b[?2004h> "]
[502.756917, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r"]
[502.756949, "o", "\u001b[?2004h> "]
[502.757006, "o", "            and x.shape[1] == w.shape[1]\r\n\u001b[?2004l\r"]
[502.757038, "o", "\u001b[?2004h> "]
[502.757082, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[502.757112, "o", "\u001b[?2004h> "]
[502.757162, "o", "            and x.shape[0] % 64 == 0\r\n\u001b[?2004l\r"]
[502.757194, "o", "\u001b[?2004h> "]
[502.757241, "o", "            and w.shape[0] % 64 == 0\r\n\u001b[?2004l\r"]
[502.757269, "o", "\u001b[?2004h> "]
[502.757321, "o", "            and w.shape[1] % 32 == 0\r\n\u001b[?2004l\r"]
[502.757352, "o", "\u001b[?2004h>         ):\r\n\u001b[?2004l\r"]
[502.757384, "o", "\u001b[?2004h> "]
[502.757418, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[502.757456, "o", "\u001b[?2004h> "]
[502.757487, "o", "            N = w.shape[0]\r\n\u001b[?2004l\r"]
[502.75752, "o", "\u001b[?2004h> "]
[502.757577, "o", "            wh, wl = self._get_wsplit(w)\r\n\u001b[?2004l\r"]
[502.757607, "o", "\u001b[?2004h> "]
[502.757718, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[502.757751, "o", "\u001b[?2004h> "]
[502.757823, "o", "            scale = float(1.0 + self.scaling_factor)\r\n\u001b[?2004l\r"]
[502.757852, "o", "\u001b[?2004h> "]
[502.757899, "o", "            grid = lambda META: (\r\n\u001b[?2004l\r"]
[502.757931, "o", "\u001b[?2004h> "]
[502.758022, "o", "                (M // META['BLOCK_M']) * (N // META['BLOCK_N']),\r\n\u001b[?2004l\r"]
[502.758052, "o", "\u001b[?2004h> "]
[502.758084, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.758159, "o", "            _linear_scaled_kernel[grid](\r\n\u001b[?2004l\r"]
[502.75819, "o", "\u001b[?2004h> "]
[502.758236, "o", "                x, wh, wl, b, out,\r\n\u001b[?2004l\r"]
[502.758253, "o", "\u001b[?2004h> "]
[502.758298, "o", "                M, N, K,\r\n\u001b[?2004l\r"]
[502.758326, "o", "\u001b[?2004h> "]
[502.758358, "o", "                scale,\r\n\u001b[?2004l\r"]
[502.758391, "o", "\u001b[?2004h> "]
[502.758423, "o", "            )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[502.758465, "o", "            return out\r\n\u001b[?2004l\r"]
[502.758496, "o", "\u001b[?2004h> "]
[502.758535, "o", "        t = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[502.758567, "o", "\u001b[?2004h> "]
[502.758627, "o", "        return t * self.scaling_factor + t\r\n\u001b[?2004l\r"]
[502.758659, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[502.785949, "o", "\u001b[?2004hroot@modal:/# "]
