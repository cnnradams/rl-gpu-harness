[551.696587, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 5\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 5\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(2 / 2)\"\r\n  },\r\n  \"runtime\": 2.69,\r\n  \"runtime_stats\": {\r\n    \"mean\": 2.69,\r\n    \"std\": 0.00419,\r\n    \"min\": 2.69,\r\n    \"max\": 2.7,\r\n    \"num_trials\": 5\r\n  },\r\n  \"ref_runtime\": 11.3,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 11.3,\r\n    \"std\": 0.0042,\r\n    \"min\": 11.3,\r\n    \"max\": 11.3,\r\n    \"num_trials\": 5\r\n  },\r\n  \"solution_sha256\": \"74415846ee56f9ae0d287f82c192d75aa260e1c26f6f30dfa75f8e163479b763\",\r\n  \"reference_sha256\": \"333bf992fd77297a4c43f4287b44662dcc43c8036be69d486b28e7a9db7bffd5\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 2,\r\n  \"perf_trials\": 5,\r\n  \"speedup\": 4.200743494423792\r\n}\r\n"]
