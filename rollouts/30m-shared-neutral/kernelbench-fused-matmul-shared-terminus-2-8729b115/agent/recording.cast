[641.134078, "o", "\u001b[?2004h> "]
[641.13429, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[641.134316, "o", "\u001b[?2004h> "]
[641.134485, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[641.134521, "o", "\u001b[?2004h> "]
[641.13467, "o", "    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[641.134702, "o", "\u001b[?2004h> "]
[641.134872, "o", "    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r4"]
[641.134905, "o", "\u001b[?2004h> "]
