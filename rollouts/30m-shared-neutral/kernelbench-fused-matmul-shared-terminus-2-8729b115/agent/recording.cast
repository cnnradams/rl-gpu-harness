[1626.520525, "i", "cat > /workspace/bench7.py << 'EOF'\nimport torch, math\nimport triton\nimport triton.language as tl\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nbound = 1.0 / math.sqrt(K)\nw = (torch.rand(N, K, device='cuda') * 2 - 1) * bound\nb = (torch.rand(N, device='cuda') * 2 - 1) * bound\nscale = 1.5\nref = torch.nn.functional.linear(x, w, b) * scale\nwt = w.t().contiguous()\nwh = wt.to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\nout = torch.empty((M, N), device='cuda')\n\n@triton.jit\ndef kern(a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\n         BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pi"]
[1626.520568, "i", "d % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in range(0, K, BLOCK_K):\n        a = tl.load(a_ptrs)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        whl = tl.load(wh_ptrs)\n        wll = tl.load(wl_ptrs)\n        acc = tl.dot(a_lo, whl, acc)\n        acc = tl.dot(a_hi, wll, acc)\n        acc = tl.dot(a_hi, whl, acc)\n        a_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K * N\n        wl_ptrs += BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\ndef clear_l2():\n    d = torch.empt"]
[1626.520575, "i", "y((32, 1024, 1024), dtype=torch.int64, device='cuda')\n    d.fill_(42)\n    del d\n\ndef time_eval(fn, trials=30):\n    times = []\n    for _ in range(5):\n        fn()\n    torch.cuda.synchronize()\n    for _ in range(trials):\n        clear_l2()\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record()\n        fn()\n        e.record()\n        torch.cuda.synchronize()\n        times.append(s.elapsed_time(e))\n    times.sort()\n    return sum(times)/len(times), times[0], times[-1]\n\nprint('=== cold-L2 eval-like timing ===')\nfor bm,bn,bk,s,wp,gm in [\n    (256,128,32,5,8,8),(256,128,32,4,8,8),(128,128,32,4,8,8),\n    (256,128,32,5,8,4),(256,128,32,5,8,16),(256,128,32,5,8,64),\n    (128,256,32,4,8,8),(128,128,64,3,8,8),(256,128,64,3,8,8),\n    (512,128,32,3,8,8),(256,256,32,4,8,8),(128,128,32,4,8,64),\n]:\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        kern[grid](x, wh, wl, b, out, M, N, K, scale,\n                   BLOCK_M=bm, BLOCK_N=bn, BLOC"]
[1626.520586, "i", "K_K=bk, GROUP_M=gm,\n                   num_stages=s, num_warps=wp)\n    try:\n        f(); torch.cuda.synchronize()\n        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4)\n        mn, lo, hi = time_eval(f)\n        print(f'bm{bm} bn{bn} bk{bk} s{s} w{wp} gm{gm}: mean {mn:.3f} min {lo:.3f} max {hi:.3f}')\n    except Exception as ex:\n        print(f'bm{bm} bn{bn} bk{bk} s{s} w{wp} gm{gm}: FAIL {type(ex).__name__}: {str(ex)[:40]}')\nEOF\n"]
