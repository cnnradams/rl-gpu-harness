[811.109118, "o", "\u001b[?2004h"]
[811.109145, "o", "> "]
[811.109251, "o", "        yy = torch.addmm(yy, ah0, wt0, beta=1.0)\r\n\u001b[?2004l\r"]
[811.109277, "o", "\u001b[?2004h> "]
[811.109399, "o", "        yy = torch.addmm(yy, ah0, wt0, beta=1.0)\r\n\u001b[?2004l\r"]
[811.109422, "o", "\u001b[?2004h> "]
[811.109493, "o", "        return yy * scale\r\n\u001b[?2004l\r"]
[811.10952, "o", "\u001b[?2004h> "]
[811.109631, "o", "    t = do_bench(f_addmm, warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[811.109661, "o", "\u001b[?2004h> "]
[811.109764, "o", "    print(f'addmm x3: {t:.3f} ms')\r\n\u001b[?2004l\r"]
[811.109788, "o", "\u001b[?2004h> "]
[811.10984, "o", "except Exception as e:\r\n\u001b[?2004l\r"]
[811.109864, "o", "\u001b[?2004h> "]
[811.109955, "o", "    print('addmm mixed FAIL:', e)\r\n\u001b[?2004l\r"]
[811.109982, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[811.110021, "o", "\u001b[?2004h> "]
[811.110078, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[811.110105, "o", "\u001b[?2004h> "]
[811.110172, "o", "wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[811.110198, "o", "\u001b[?2004h> "]
[811.110302, "o", "wl = (wt - wh.float()).to(torch.float16)\r\n\u001b[?2004l\r"]
[811.110332, "o", "\u001b[?2004h> "]
[811.110469, "o", "wint = torch.stack([wh, wl], dim=2).reshape(K, 2*N).contiguous()\r\n\u001b[?2004l\r"]
[811.110507, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[811.110536, "o", "\u001b[?2004h> "]
[811.110562, "o", "# interleaved split kernel for A\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.110587, "o", "> "]
[811.110614, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.110704, "o", "def split_kernel(x_ptr, o_ptr, L, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r"]
[811.11073, "o", "\u001b[?2004h> "]
[811.110766, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[811.110794, "o", "\u001b[?2004h> "]
[811.110863, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[811.110888, "o", "\u001b[?2004h> "]
[811.110914, "o", "    m = offs < L\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.11094, "o", "> "]
[811.110993, "o", "    v = tl.load(x_ptr + offs, mask=m)\r\n\u001b[?2004l\r"]
[811.111018, "o", "\u001b[?2004h> "]
[811.111058, "o", "    hi = v.to(tl.float16)\r\n\u001b[?2004l\r"]
[811.111078, "o", "\u001b[?2004h> "]
[811.111155, "o", "    lo = (v - hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[811.11118, "o", "\u001b[?2004h> "]
[811.111223, "o", "    j = tl.interleave(hi, lo)\r\n\u001b[?2004l\r"]
[811.111249, "o", "\u001b[?2004h> "]
[811.111326, "o", "    offs2 = pid * (2*BLOCK) + tl.arange(0, 2*BLOCK)\r\n\u001b[?2004l\r"]
[811.11135, "o", "\u001b[?2004h> "]
[811.111424, "o", "    tl.store(o_ptr + offs2, j, mask=offs2 < 2*L)\r\n\u001b[?2004l\r"]
[811.111451, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.111476, "o", "> "]
[811.111569, "o", "xint = torch.empty((M, 2*K), device='cuda', dtype=torch.float16)\r\n\u001b[?2004l\r"]
[811.111595, "o", "\u001b[?2004h> L = M*K\r\n\u001b[?2004l\r"]
[811.111619, "o", "\u001b[?2004h> "]
[811.11168, "o", "grid_split = (triton.cdiv(L, 4096),)\r\n\u001b[?2004l\r"]
[811.111708, "o", "\u001b[?2004h> "]
[811.111778, "o", "split_kernel[grid_split](x, xint, L, BLOCK=4096)\r\n\u001b[?2004l\r"]
[811.111802, "o", "\u001b[?2004h> "]
[811.11184, "o", "torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[811.111863, "o", "\u001b[?2004h> "]
[811.111889, "o", "# verify\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.111981, "o", "chk = xint[:, 0::2].float() + xint[:, 1::2].float()\r\n\u001b[?2004l\r"]
[811.112007, "o", "\u001b[?2004h> "]
[811.112109, "o", "print('split ok:', torch.allclose(chk, x, atol=1e-6, rtol=1e-6))\r\n\u001b[?2004l\r"]
[811.112135, "o", "\u001b[?2004h> "]
[811.112273, "o", "t = do_bench(lambda: split_kernel[grid_split](x, xint, L, BLOCK=4096), warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[811.112299, "o", "\u001b[?2004h> "]
[811.112349, "o", "print(f'split kernel: {t:.3f} ms')\r\n\u001b[?2004l\r"]
[811.112376, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.112403, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[811.112427, "o", "\u001b[?2004h> "]
[811.112522, "o", "def kern_f(ai_ptr, wi_ptr, b_ptr, c_ptr, M, N, K, scale,\r\n\u001b[?2004l\r"]
[811.112548, "o", "\u001b[?2004h> "]
[811.112719, "o", "           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.112747, "o", "> "]
[811.112773, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[811.112799, "o", "\u001b[?2004h> "]
[811.112858, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[811.112883, "o", "\u001b[?2004h> "]
[811.112935, "o", "    num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[811.11296, "o", "\u001b[?2004h> "]
[811.113024, "o", "    num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[811.113055, "o", "\u001b[?2004h> "]
[811.113114, "o", "    group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[811.11314, "o", "\u001b[?2004h> "]
[811.11319, "o", "    first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[811.113215, "o", "\u001b[?2004h> "]
[811.113301, "o", "    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[811.113324, "o", "\u001b[?2004h> "]
[811.113428, "o", "    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r"]
[811.113451, "o", "\u001b[?2004h> "]
[811.113533, "o", "    pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[811.113555, "o", "\u001b[?2004h> "]
[811.113638, "o", "    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[811.11366, "o", "\u001b[?2004h> "]
[811.113742, "o", "    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[811.113773, "o", "\u001b[?2004h> "]
[811.113818, "o", "    offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[811.113845, "o", "\u001b[?2004h> "]
[811.113884, "o", "    offs_r = tl.arange(0, 2)\r\n\u001b[?2004l\r"]
[811.113909, "o", "\u001b[?2004h> "]
[811.114073, "o", "    a_ptrs = ai_ptr + offs_m[:, None, None] * (2*K) + offs_k[None, :, None] * 2 + offs_r[None, None, :]\r\n\u001b[?2004l\r"]
[811.114099, "o", "\u001b[?2004h> "]
[811.114257, "o", "    w_ptrs = wi_ptr + offs_k[:, None, None] * (2*N) + offs_n[None, :, None] * 2 + offs_r[None, None, :]\r\n\u001b[?2004l\r"]
[811.11428, "o", "\u001b[?2004h> "]
[811.114367, "o", "    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[811.114393, "o", "\u001b[?2004h> "]
[811.114443, "o", "    for _ in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r"]
[811.11447, "o", "\u001b[?2004h> "]
[811.11451, "o", "        a3 = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[811.114533, "o", "\u001b[?2004h> "]
[811.114588, "o", "        a_hi, a_lo = tl.split(a3)\r\n\u001b[?2004l\r"]
[811.114615, "o", "\u001b[?2004h> "]
[811.114653, "o", "        w3 = tl.load(w_ptrs)\r\n\u001b[?2004l\r"]
[811.114676, "o", "\u001b[?2004h> "]
[811.114727, "o", "        w_hi, w_lo = tl.split(w3)\r\n\u001b[?2004l\r"]
[811.114752, "o", "\u001b[?2004h> "]
[811.114809, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r"]
[811.114831, "o", "\u001b[?2004h> "]
[811.114889, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r"]
[811.114912, "o", "\u001b[?2004h> "]
[811.11497, "o", "        acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r"]
[811.114999, "o", "\u001b[?2004h> "]
[811.115036, "o", "        a_ptrs += 2*BLOCK_K\r\n\u001b[?2004l\r"]
[811.115099, "o", "\u001b[?2004h> "]
[811.115146, "o", "        w_ptrs += 2*BLOCK_K * N\r\n\u001b[?2004l\r"]
[811.115172, "o", "\u001b[?2004h> "]
[811.115224, "o", "    bias = tl.load(b_ptr + offs_n)\r\n\u001b[?2004l\r"]
[811.115251, "o", "\u001b[?2004h> "]
[811.115306, "o", "    acc = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r"]
[811.115329, "o", "\u001b[?2004h> "]
[811.11542, "o", "    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[811.115444, "o", "\u001b[?2004h> "]
[811.115482, "o", "    tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[811.115511, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[811.115537, "o", "\u001b[?2004h> "]
[811.115588, "o", "out = torch.empty((M, N), device='cuda')\r\n\u001b[?2004l\r"]
[811.115613, "o", "\u001b[?2004h> "]
[811.11568, "o", "print('=== Variant F: interleaved fp16 ===')\r\n\u001b[?2004l\r"]
[811.115706, "o", "\u001b[?2004h> "]
[811.115732, "o", "for bm,bn,bk,s,wp in [\r\n\u001b[?2004l\r"]
[811.115758, "o", "\u001b[?2004h> "]
[811.115874, "o", "    (128,128,64,3,8),(128,128,64,4,8),(128,256,64,3,8),(256,128,64,3,8),\r\n\u001b[?2004l\r"]
[811.115897, "o", "\u001b[?2004h> "]
[811.116009, "o", "    (128,256,32,4,8),(256,128,32,4,8),(128,128,32,4,8),(64,256,64,4,4),\r\n\u001b[?2004l\r"]
[811.116035, "o", "\u001b[?2004h> "]
[811.116154, "o", "    (128,256,64,4,8),(128,128,128,3,8),(128,256,128,2,8),(256,256,64,3,8),\r\n\u001b[?2004l\r"]
[811.11618, "o", "\u001b[?2004h> ]:\r\n\u001b[?2004l\r"]
[811.116206, "o", "\u001b[?2004h> "]
[811.11625, "o", "    grid = ((M//bm)*(N//bn),)\r\n\u001b[?2004l\r"]
[811.116266, "o", "\u001b[?2004h> "]
[811.116299, "o", "    def f():\r\n\u001b[?2004l\r"]
[811.116325, "o", "\u001b[?2004h> "]
[811.116407, "o", "        split_kernel[grid_split](x, xint, L, BLOCK=4096)\r\n\u001b[?2004l\r"]
[811.116433, "o", "\u001b[?2004h> "]
[811.116518, "o", "        kern_f[grid](xint, wint, b, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[811.116544, "o", "\u001b[?2004h> "]
[811.116645, "o", "                     BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\r\n\u001b[?2004l\r"]
[811.116679, "o", "\u001b[?2004h> "]
[811.116754, "o", "                     num_stages=s, num_warps=wp)\r\n\u001b[?2004l\r"]
[811.116778, "o", "\u001b[?2004h> "]
[811.116804, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.11687, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[811.116895, "o", "\u001b[?2004h> "]
[811.117008, "o", "        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4), 'mismatch'\r\n\u001b[?2004l\r"]
[811.117034, "o", "\u001b[?2004h> "]
[811.117102, "o", "        t = do_bench(f, warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[811.117125, "o", "\u001b[?2004h> "]
[811.117244, "o", "        print(f'F bm{bm} bn{bn} bk{bk} s{s} w{wp}: {t:.3f} ms (incl split)')\r\n\u001b[?2004l\r"]
[811.117274, "o", "\u001b[?2004h> "]
[811.117308, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[811.117332, "o", "\u001b[?2004h> "]
[811.117467, "o", "        print(f'F bm{bm} bn{bn} bk{bk} s{s} w{wp}: FAIL {type(e).__name__}: {e}'[:80])\r\n\u001b[?2004l\r"]
[811.117491, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[811.117517, "o", "> "]
[811.117595, "o", "# kernel-only timing for best F configs (exclude split)\r\n\u001b[?2004l\r"]
[811.117623, "o", "\u001b[?2004h> "]
[811.117666, "o", "print('=== F kernel-only ===')\r\n\u001b[?2004l\r"]
[811.11769, "o", "\u001b[?2004h> "]
[811.117894, "o", "for bm,bn,bk,s,wp in [(128,128,64,3,8),(128,128,64,4,8),(128,256,64,3,8),(256,128,64,3,8),(128,128,32,4,8),(128,256,64,4,8)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[811.117912, "o", "> "]
[811.117954, "o", "    grid = ((M//bm)*(N//bn),)\r\n\u001b[?2004l\r"]
[811.11798, "o", "\u001b[?2004h> "]
[811.118007, "o", "    def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.118106, "o", "        kern_f[grid](xint, wint, b, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[811.118132, "o", "\u001b[?2004h> "]
[811.118234, "o", "                     BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\r\n\u001b[?2004l\r"]
[811.118259, "o", "\u001b[?2004h> "]
[811.118331, "o", "                     num_stages=s, num_warps=wp)\r\n\u001b[?2004l\r"]
[811.118355, "o", "\u001b[?2004h> "]
[811.118381, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[811.118445, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[811.118471, "o", "\u001b[?2004h> "]
[811.118535, "o", "        t = do_bench(f, warmup=25, rep=100)\r\n\u001b[?2004l\r"]
[811.118558, "o", "\u001b[?2004h> "]
[811.118714, "o", "        print(f'Fk bm{bm} bn{bn} bk{bk} s{s} w{wp}: {t:.3f} ms ({3*2*M*N*K/t*1e-9:.0f} TFLOPS)')\r\n\u001b[?2004l\r"]
[811.118739, "o", "\u001b[?2004h> "]
[811.118777, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[811.118801, "o", "\u001b[?2004h> "]
[811.118937, "o", "        print(f'Fk bm{bm} bn{bn} bk{bk} s{s} w{wp}: FAIL {type(e).__name__}'[:60])\r\n\u001b[?2004l\r"]
[811.118963, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[811.182254, "o", "\u001b[?2004hroot@modal:/# "]
