[1227.885613, "i", "cat > /workspace/bench5.py << 'EOF'\nimport torch, math\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nbound = 1.0 / math.sqrt(K)\nw = (torch.rand(N, K, device='cuda') * 2 - 1) * bound\nb = (torch.rand(N, device='cuda') * 2 - 1) * bound\nscale = 1.5\nref = torch.nn.functional.linear(x, w, b) * scale\nwt = w.t().contiguous()\nwh = wt.to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\nout = torch.empty((M, N), device='cuda')\n\n@triton.jit\ndef kern(a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\n         BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n         GROUP_M: tl.constexpr, ND: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pi"]
[1227.885754, "i", "d_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in range(0, K, BLOCK_K):\n        a = tl.load(a_ptrs)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        whl = tl.load(wh_ptrs)\n        wll = tl.load(wl_ptrs)\n        acc = tl.dot(a_lo, whl, acc)\n        acc = tl.dot(a_hi, wll, acc)\n        if ND == 3:\n            acc = tl.dot(a_hi, whl, acc)\n        a_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K * N\n        wl_ptrs += BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, No"]
[1227.885791, "i", "ne] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\nprint('=== head-to-head, 3 reps each ===')\nfor nd in [2, 3]:\n    for bm,bn,bk,s,wp,gm in [\n        (128,128,32,4,8,8),(128,128,64,3,8,8),(256,128,32,4,8,8),\n        (256,128,32,5,8,8),(128,128,32,4,8,4),(128,128,32,4,8,16),\n        (128,128,32,4,4,8),(64,128,32,4,4,8),(64,256,32,4,4,8),\n        (128,128,32,3,8,8),(64,128,64,4,4,8),(128,64,32,4,4,8),\n    ]:\n        grid = ((M//bm)*(N//bn),)\n        def f():\n            kern[grid](x, wh, wl, b, out, M, N, K, scale,\n                       BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm, ND=nd,\n                       num_stages=s, num_warps=wp)\n        try:\n            f(); torch.cuda.synchronize()\n            if nd == 3:\n                assert torch.allclose(out, ref, atol=1e-5, rtol=1e-5)\n            ts = [do_bench(f, warmup=25, rep=100) for _ in range(3)]\n            print(f'nd{nd} bm{bm} bn{bn} bk{bk} s{s} w{wp} gm{gm}: {min(ts):.3f} ms')\n        except Exception as e:\n            print(f'nd{nd} bm{bm} bn{bn"]
[1227.885811, "i", "} bk{bk} s{s} w{wp} gm{gm}: FAIL {type(e).__name__}: {str(e)[:40]}')\nEOF\n"]
