[811.105317, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nscale = 1.5\nref = torch.nn.functional.linear(x, w, b) * scale\n\n# calibration: pure fp16 mm\nah0 = x.half()\nwt0 = w.t().contiguous().half()\nt = do_bench(lambda: torch.mm(ah0, wt0), warmup=25, rep=100)\nprint(f'torch fp16 mm: {t:.3f} ms ({2*M*N*K/t*1e-9:.0f} TFLOPS)')\n\n# mixed addmm test\ntry:\n    y = torch.addmm(b, ah0, wt0)\n    print('addmm mixed ok, dtype', y.dtype)\n    y2 = torch.addmm(y, ah0, wt0, beta=1.0)\n    def f_addmm():\n        yy = torch.addmm(b, ah0, wt0)\n        yy = torch.addmm(yy, ah0, wt0, beta=1.0)\n        yy = torch.addmm(yy, ah0, wt0, beta=1.0)\n        return yy * scale\n    t = do_bench(f_addmm, warmup=25, rep=100)\n    print(f'addmm x3: {t:.3f} ms')\nexcept Exception as e:\n    print('addmm mixed FAIL:', e)\n\nwt = w.t().contiguous()\nwh = wt"]
[811.105381, "i", ".to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\nwint = torch.stack([wh, wl], dim=2).reshape(K, 2*N).contiguous()\n\n# interleaved split kernel for A\n@triton.jit\ndef split_kernel(x_ptr, o_ptr, L, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    m = offs < L\n    v = tl.load(x_ptr + offs, mask=m)\n    hi = v.to(tl.float16)\n    lo = (v - hi.to(tl.float32)).to(tl.float16)\n    j = tl.interleave(hi, lo)\n    offs2 = pid * (2*BLOCK) + tl.arange(0, 2*BLOCK)\n    tl.store(o_ptr + offs2, j, mask=offs2 < 2*L)\n\nxint = torch.empty((M, 2*K), device='cuda', dtype=torch.float16)\nL = M*K\ngrid_split = (triton.cdiv(L, 4096),)\nsplit_kernel[grid_split](x, xint, L, BLOCK=4096)\ntorch.cuda.synchronize()\n# verify\nchk = xint[:, 0::2].float() + xint[:, 1::2].float()\nprint('split ok:', torch.allclose(chk, x, atol=1e-6, rtol=1e-6))\nt = do_bench(lambda: split_kernel[grid_split](x, xint, L, BLOCK=4096), warmup=25, rep=100)\nprint(f'split kernel: {t:.3f} ms')\n\n@triton.jit\ndef kern_f(ai_p"]
[811.105506, "i", "tr, wi_ptr, b_ptr, c_ptr, M, N, K, scale,\n           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    offs_r = tl.arange(0, 2)\n    a_ptrs = ai_ptr + offs_m[:, None, None] * (2*K) + offs_k[None, :, None] * 2 + offs_r[None, None, :]\n    w_ptrs = wi_ptr + offs_k[:, None, None] * (2*N) + offs_n[None, :, None] * 2 + offs_r[None, None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in range(0, K, BLOCK_K):\n        a3 ="]
[811.105522, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[811.105571, "i", " tl.load(a_ptrs)\n        a_hi, a_lo = tl.split(a3)\n        w3 = tl.load(w_ptrs)\n        w_hi, w_lo = tl.split(w3)\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n        a_ptrs += 2*BLOCK_K\n        w_ptrs += 2*BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\nout = torch.empty((M, N), device='cuda')\nprint('=== Variant F: interleaved fp16 ===')\nfor bm,bn,bk,s,wp in [\n    (128,128,64,3,8),(128,128,64,4,8),(128,256,64,3,8),(256,128,64,3,8),\n    (128,256,32,4,8),(256,128,32,4,8),(128,128,32,4,8),(64,256,64,4,4),\n    (128,256,64,4,8),(128,128,128,3,8),(128,256,128,2,8),(256,256,64,3,8),\n]:\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        split_kernel[grid_split](x, xint, L, BLOCK=4096)\n        kern_f[grid](xint, wint, b, out, M, N, K, scale,\n                     BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                  "]
