[1412.724201, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, math\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nbound = 1.0 / math.sqrt(K)\nw = (torch.rand(N, K, device='cuda') * 2 - 1) * bound\nb = (torch.rand(N, device='cuda') * 2 - 1) * bound\nscale = 1.5\nref = torch.nn.functional.linear(x, w, b) * scale\nwt = w.t().contiguous()\nwh = wt.to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\nout = torch.empty((M, N), device='cuda')\n\n@triton.jit\ndef kern_tma(a_desc, wh_desc, wl_desc, b_ptr, c_ptr, M, N, K, scale,\n             BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % nu"]
[1412.724387, "i", "m_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    om = pid_m * BLOCK_M\n    on = pid_n * BLOCK_N\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k in range(0, K, BLOCK_K):\n        a = a_desc.load([om, k])\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        whl = wh_desc.load([k, on])\n        wll = wl_desc.load([k, on])\n        acc = tl.dot(a_lo, whl, acc)\n        acc = tl.dot(a_hi, wll, acc)\n        acc = tl.dot(a_hi, whl, acc)\n    offs_m = om + tl.arange(0, BLOCK_M)\n    offs_n = on + tl.arange(0, BLOCK_N)\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\nprint('=== TMA 2-dot ===')\nfor bm,bn,bk,s,wp in [\n    (128,128,64,3,8),(128,128,64,4,8),(128,256,64,3,8),(256,128,64,3,8),\n    (128,128,32,4,8),(256,128,32,4,8),(128,256,32,4,8),(128,256,64,4,8),\n    (256,128,64,4,8),(128,128,128,3,8),(128,256,128,3,8)"]
[1412.724425, "i", ",(256,256,64,3,8),\n    (128,512,64,3,8),(256,256,128,2,8),(128,256,128,2,8),\n]:\n    try:\n        a_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(x, [bm, bk])\n        wh_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(wh, [bk, bn])\n        wl_desc = triton.tools.tensor_descriptor.TensorDescriptor.from_tensor(wl, [bk, bn])\n    except Exception as e:\n        print('desc creation fail', e)\n        break\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        kern_tma[grid](a_desc, wh_desc, wl_desc, b, out, M, N, K, scale,\n                       BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                       num_stages=s, num_warps=wp)\n    try:\n        f(); torch.cuda.synchronize()\n        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4), 'mismatch'\n        ts = [do_bench(f, warmup=25, rep=100) for _ in range(2)]\n        print(f'TMA bm{bm} bn{bn} bk{bk} s{s} w{wp}: {min(ts):.3f} ms')\n    except Exception as e:\n        print(f'TMA bm{bm} bn{bn} bk{bk} s{s} w{wp}: FAIL {"]
