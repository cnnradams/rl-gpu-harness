[1516.757385, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    @triton.jit\n    def _linear_scaled_kernel(\n        a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr,\n        M, N, K,\n        scale,\n        BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n        GROUP_M: tl.constexpr,\n    ):\n        pid = tl.program_id(0)\n        num_pid_m = tl.cdiv(M, BLOCK_M)\n        num_pid_n = tl.cdiv(N, BLOCK_N)\n        num_pid_in_group = GROUP_M * num_pid_n\n        group_id = pid // num_pid_in_group\n        first_pid_m = group_id * GROUP_M\n        group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n        pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n        pid_n = (pid % num_pid_in_group) // group_size_m\n\n        offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n        offs_n = pid_n * BLOCK_N + tl.arange(0, BL"]
[1516.757454, "i", "OCK_N)\n        offs_k = tl.arange(0, BLOCK_K)\n\n        a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\n        wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n        wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\n\n        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n        for _ in range(0, K, BLOCK_K):\n            a = tl.load(a_ptrs)\n            a_hi = a.to(tl.float16)\n            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n            whl = tl.load(wh_ptrs)\n            wll = tl.load(wl_ptrs)\n            acc = tl.dot(a_lo, whl, acc)\n            acc = tl.dot(a_hi, wll, acc)\n            acc = tl.dot(a_hi, whl, acc)\n            a_ptrs += BLOCK_K\n            wh_ptrs += BLOCK_K * N\n            wl_ptrs += BLOCK_K * N\n\n        bias = tl.load(b_ptr + offs_n)\n        acc = (acc + bias[None, :]) * scale\n        c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n        tl.store(c_ptrs, acc)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, in_features, out_features, scalin"]
[1516.757464, "i", "g_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._w_hi = None\n        self._w_lo = None\n        self._w_key = None\n\n    def _get_wsplit(self, w):\n        key = (w.data_ptr(), w._version, w.device.index)\n        if self._w_key != key:\n            wt = w.detach().t().contiguous()\n            wh = wt.to(torch.float16)\n            wl = (wt - wh.to(torch.float32)).to(torch.float16)\n            self._w_hi = wh\n            self._w_lo = wl\n            self._w_key = key\n        return self._w_hi, self._w_lo\n\n    def forward(self, x):\n        w = self.matmul.weight\n        b = self.matmul.bias\n        if (\n            _HAS_TRITON\n            and x.is_cuda\n            and x.dtype == torch.float32\n            and w.dtype == torch.float32\n            and x.dim() == 2\n            and x.shape[1] == w.shape[1]\n            and x.is_contiguous()\n            and x.shape[0] % 256 == 0\n            and w.shape[0]"]
[1516.757624, "i", " % 128 == 0\n            and w.shape[1] % 32 == 0\n        ):\n            M, K = x.shape\n            N = w.shape[0]\n            wh, wl = self._get_wsplit(w)\n            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n            scale = float(1.0 + self.scaling_factor)\n            grid = ((M // 256) * (N // 128),)\n            _linear_scaled_kernel[grid](\n                x, wh, wl, b, out,\n                M, N, K,\n                scale,\n                BLOCK_M=256, BLOCK_N=128, BLOCK_K=32, GROUP_M=8,\n                num_stages=5, num_warps=8,\n            )\n            return out\n        t = F.linear(x, w, b)\n        return t * self.scaling_factor + t\nEOF\n"]
