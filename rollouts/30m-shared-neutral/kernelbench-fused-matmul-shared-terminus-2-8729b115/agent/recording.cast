[1034.356724, "i", "cat > /workspace/bench3.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\nprint('triton', triton.__version__)\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nscale = 1.5\nref = torch.nn.functional.linear(x, w, b) * scale\n\nwt = w.t().contiguous()\nwh = wt.to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\n\n@triton.jit\ndef kern_ws(a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\n            BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\n            GROUP_M: tl.constexpr, WS: tl.constexpr, ND: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m"]
[1034.356885, "i", ")\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in tl.range(0, K, BLOCK_K, warp_specialize=WS):\n        a = tl.load(a_ptrs)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        whl = tl.load(wh_ptrs)\n        wll = tl.load(wl_ptrs)\n        acc = tl.dot(a_hi, whl, acc)\n        if ND == 3:\n            acc = tl.dot(a_hi, wll, acc)\n            acc = tl.dot(a_lo, whl, acc)\n        else:\n            acc = tl.dot(a_lo, whl, acc)\n        a_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K * N\n        wl_ptrs += BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * sca"]
[1034.356915, "i", "le\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\nout = torch.empty((M, N), device='cuda')\nprint('=== A+WS (3 dots) ===')\nfor bm,bn,bk,s,wp,ws in [\n    (128,128,64,3,8,True),(128,128,64,4,8,True),(128,256,64,3,8,True),\n    (256,128,64,3,8,True),(128,256,64,4,8,True),(256,128,64,4,8,True),\n    (128,128,32,5,8,False),(128,128,32,6,8,False),(256,128,32,5,8,False),\n    (128,256,32,5,8,False),(256,128,32,3,8,True),(128,128,64,3,4,True),\n    (256,256,64,2,8,True),(128,256,128,2,8,True),(256,128,128,2,8,True),\n]:\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        kern_ws[grid](x, wh, wl, b, out, M, N, K, scale,\n                      BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8, WS=ws, ND=3,\n                      num_stages=s, num_warps=wp)\n    try:\n        f(); torch.cuda.synchronize()\n        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4), 'mismatch'\n        t = do_bench(f, warmup=25, rep=100)\n        print(f'WS bm{bm} bn{bn} bk{bk} s{s} w{wp} ws{ws}: {t:.3f} ms ({3*2*"]
[1034.356935, "i", "M*N*K/t*1e-9:.0f} TFLOPS)')\n    except Exception as e:\n        print(f'WS bm{bm} bn{bn} bk{bk} s{s} w{wp} ws{ws}: FAIL {type(e).__name__}: {str(e)[:60]}')\n\nprint('=== 2-dot accuracy check ===')\ngrid = ((M//128)*(N//128),)\ndef f2():\n    kern_ws[grid](x, wh, wl, b, out, M, N, K, scale,\n                  BLOCK_M=128, BLOCK_N=128, BLOCK_K=64, GROUP_M=8, WS=False, ND=2,\n                  num_stages=3, num_warps=8)\nf2(); torch.cuda.synchronize()\ndiff = (out - ref).abs()\ntol = 1e-4 + 1e-4*ref.abs()\nprint('2dot max diff', diff.max().item(), 'max ratio diff/tol', (diff/tol).max().item())\nt = do_bench(f2, warmup=25, rep=100)\nprint(f'2dot time: {t:.3f} ms')\nEOF\n"]
