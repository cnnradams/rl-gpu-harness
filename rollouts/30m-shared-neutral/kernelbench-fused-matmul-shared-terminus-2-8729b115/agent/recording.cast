[1128.314836, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nM, N, K = 16384, 4096, 4096\n\n@triton.jit\ndef kern2(a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\n          BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = wl_ptr + offs_k[:"]
[1128.314879, "i", ", None] * N + offs_n[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in range(0, K, BLOCK_K):\n        a = tl.load(a_ptrs)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        whl = tl.load(wh_ptrs)\n        wll = tl.load(wl_ptrs)\n        acc = tl.dot(a_hi, whl, acc)\n        acc = tl.dot(a_hi, wll, acc)\n        acc = tl.dot(a_lo, whl, acc)\n        a_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K * N\n        wl_ptrs += BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\n# accuracy stress: eval-like inputs (torch.rand) across seeds, eval-like weights (kaiming uniform)\nimport math\nworst = 0.0\nfor seed in range(20):\n    g = torch.Generator(device='cuda').manual_seed(seed)\n    x = torch.rand(M, K, device='cuda', generator=g)\n    bound = 1.0 / math.sqrt(K)\n    w = (torch.rand(N, K, device='cuda', generator=g) * 2 - 1) * bound\n    b "]
[1128.314887, "i", "= (torch.rand(N, device='cuda', generator=g) * 2 - 1) * bound\n    scale = 1.5\n    wt = w.t().contiguous()\n    wh = wt.to(torch.float16)\n    wl = (wt - wh.float()).to(torch.float16)\n    out = torch.empty((M, N), device='cuda')\n    kern2[(M//128)*(N//128),](x, wh, wl, b, out, M, N, K, scale,\n        BLOCK_M=128, BLOCK_N=128, BLOCK_K=64, GROUP_M=8, num_stages=3, num_warps=8)\n    ref = torch.nn.functional.linear(x, w, b) * scale\n    diff = (out - ref).abs()\n    tol = 1e-4 + 1e-4*ref.abs()\n    ratio = (diff/tol).max().item()\n    worst = max(worst, ratio)\n    ok = torch.allclose(out, ref, atol=1e-4, rtol=1e-4)\n    if seed % 5 == 0 or not ok:\n        print(f'seed {seed}: ratio {ratio:.4f} pass {ok}')\nprint('worst ratio over 20 seeds:', worst)\n\n# config sweep for 2-dot\nx = torch.rand(M, K, device='cuda')\nbound = 1.0 / math.sqrt(K)\nw = (torch.rand(N, K, device='cuda') * 2 - 1) * bound\nb = (torch.rand(N, device='cuda') * 2 - 1) * bound\nscale = 1.5\nref = torch.nn.functional.linear(x, w, b) * scale\nwt = w.t().contiguous("]
[1128.314894, "i", ")\nwh = wt.to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\nout = torch.empty((M, N), device='cuda')\nprint('=== 2-dot config sweep ===')\nfor bm,bn,bk,s,wp in [\n    (128,128,64,3,8),(128,128,64,4,8),(128,128,64,5,8),(256,128,64,3,8),\n    (128,256,64,3,8),(128,256,32,4,8),(256,128,32,4,8),(128,128,32,4,8),\n    (128,128,32,5,8),(256,128,32,5,8),(128,256,32,5,8),(256,256,32,4,8),\n    (128,256,64,4,8),(256,128,64,4,8),(256,256,64,3,8),(128,512,32,3,8),\n    (256,256,32,3,8),(128,128,128,3,8),(256,128,128,2,8),\n]:\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        kern2[grid](x, wh, wl, b, out, M, N, K, scale,\n                    BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                    num_stages=s, num_warps=wp)\n    try:\n        f(); torch.cuda.synchronize()\n        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4), 'mismatch'\n        t = do_bench(f, warmup=25, rep=100)\n        print(f'2d bm{bm} bn{bn} bk{bk} s{s} w{wp}: {t:.3f} ms ({3*2*M*N*K/t*1e-9:.0f} fp16-TFLOPS)')\n    except Exception a"]
[1128.315078, "i", "s e:\n        print(f'2d bm{bm} bn{bn} bk{bk} s{s} w{wp}: FAIL {type(e).__name__}: {str(e)[:50]}')\nEOF\n"]
