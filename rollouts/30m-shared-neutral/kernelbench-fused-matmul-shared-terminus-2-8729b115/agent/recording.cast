[1321.858669, "o", "> "]
[1321.858706, "o", "        key=['M', 'N', 'K'],\r\n\u001b[?2004l\r"]
[1321.858734, "o", "\u001b[?2004h> "]
[1321.85876, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1321.858788, "o", "    @triton.jit\r\n\u001b[?2004l\r"]
[1321.858812, "o", "\u001b[?2004h> "]
[1321.858863, "o", "    def _linear_scaled_kernel(\r\n\u001b[?2004l\r"]
[1321.858886, "o", "\u001b[?2004h> "]
[1321.858958, "o", "        a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr,\r\n\u001b[?2004l\r"]
[1321.858985, "o", "\u001b[?2004h> "]
[1321.85901, "o", "        M, N, K,\r\n\u001b[?2004l\r"]
[1321.859036, "o", "\u001b[?2004h> "]
[1321.859064, "o", "        scale,\r\n\u001b[?2004l\r"]
[1321.859089, "o", "\u001b[?2004h> "]
[1321.859209, "o", "        BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,\r\n\u001b[?2004l\r"]
[1321.859235, "o", "\u001b[?2004h> "]
[1321.859284, "o", "        GROUP_M: tl.constexpr,\r\n\u001b[?2004l\r"]
[1321.859317, "o", "\u001b[?2004h>     ):\r\n\u001b[?2004l\r"]
[1321.859342, "o", "\u001b[?2004h> "]
[1321.859393, "o", "        pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[1321.859419, "o", "\u001b[?2004h> "]
[1321.859481, "o", "        num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[1321.859506, "o", "\u001b[?2004h> "]
[1321.859566, "o", "        num_pid_n = tl.cdiv(N, BLOCK_N)\r\n\u001b[?2004l\r"]
[1321.859591, "o", "\u001b[?2004h> "]
[1321.859663, "o", "        num_pid_in_group = GROUP_M * num_pid_n\r\n\u001b[?2004l\r"]
[1321.859688, "o", "\u001b[?2004h> "]
[1321.859752, "o", "        group_id = pid // num_pid_in_group\r\n\u001b[?2004l\r"]
[1321.859778, "o", "\u001b[?2004h> "]
[1321.859838, "o", "        first_pid_m = group_id * GROUP_M\r\n\u001b[?2004l\r"]
[1321.859864, "o", "\u001b[?2004h> "]
[1321.859958, "o", "        group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\r\n\u001b[?2004l\r"]
[1321.859985, "o", "\u001b[?2004h> "]
[1321.860109, "o", "        pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.860134, "o", "> "]
[1321.860216, "o", "        pid_n = (pid % num_pid_in_group) // group_size_m\r\n\u001b[?2004l\r"]
[1321.860238, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.860264, "o", "> "]
[1321.860349, "o", "        offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\r\n\u001b[?2004l\r"]
[1321.860374, "o", "\u001b[?2004h> "]
[1321.86047, "o", "        offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\r\n\u001b[?2004l\r"]
[1321.860494, "o", "\u001b[?2004h> "]
[1321.860552, "o", "        offs_k = tl.arange(0, BLOCK_K)\r\n\u001b[?2004l\r"]
[1321.860578, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1321.860601, "o", "\u001b[?2004h> "]
[1321.860714, "o", "        a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\r\n\u001b[?2004l\r"]
[1321.860738, "o", "\u001b[?2004h> "]
[1321.860837, "o", "        wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1321.860862, "o", "\u001b[?2004h> "]
[1321.860964, "o", "        wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1321.860991, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1321.861101, "o", "        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[1321.861126, "o", "\u001b[?2004h> "]
[1321.861184, "o", "        for _ in range(0, K, BLOCK_K):\r\n\u001b[?2004l\r"]
[1321.861209, "o", "\u001b[?2004h> "]
[1321.861254, "o", "            a = tl.load(a_ptrs)\r\n\u001b[?2004l\r"]
[1321.86128, "o", "\u001b[?2004h> "]
[1321.861331, "o", "            a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r"]
[1321.861365, "o", "\u001b[?2004h> "]
[1321.86145, "o", "            a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r"]
[1321.861474, "o", "\u001b[?2004h> "]
[1321.861528, "o", "            whl = tl.load(wh_ptrs)\r\n\u001b[?2004l\r"]
[1321.861554, "o", "\u001b[?2004h> "]
[1321.861607, "o", "            wll = tl.load(wl_ptrs)\r\n\u001b[?2004l\r"]
[1321.861634, "o", "\u001b[?2004h> "]
[1321.861696, "o", "            acc = tl.dot(a_lo, whl, acc)\r\n\u001b[?2004l\r"]
[1321.861722, "o", "\u001b[?2004h> "]
[1321.861786, "o", "            acc = tl.dot(a_hi, wll, acc)\r\n\u001b[?2004l\r"]
[1321.861811, "o", "\u001b[?2004h> "]
[1321.861875, "o", "            acc = tl.dot(a_hi, whl, acc)\r\n\u001b[?2004l\r"]
[1321.8619, "o", "\u001b[?2004h> "]
[1321.861949, "o", "            a_ptrs += BLOCK_K\r\n\u001b[?2004l\r"]
[1321.861977, "o", "\u001b[?2004h> "]
[1321.862025, "o", "            wh_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[1321.86205, "o", "\u001b[?2004h> "]
[1321.862101, "o", "            wl_ptrs += BLOCK_K * N\r\n\u001b[?2004l\r"]
[1321.862126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.862152, "o", "> "]
[1321.862205, "o", "        bias = tl.load(b_ptr + offs_n)\r\n\u001b[?2004l\r"]
[1321.86223, "o", "\u001b[?2004h> "]
[1321.862314, "o", "        acc = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.862342, "o", "> "]
[1321.862437, "o", "        c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\r\n\u001b[?2004l\r"]
[1321.862473, "o", "\u001b[?2004h> "]
[1321.862517, "o", "        tl.store(c_ptrs, acc)\r\n\u001b[?2004l\r"]
[1321.86255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1321.862579, "o", "\u001b[?2004h> "]
[1321.862622, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[1321.862647, "o", "\u001b[?2004h> "]
[1321.862753, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r"]
[1321.862778, "o", "\u001b[?2004h> "]
[1321.862846, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[1321.862871, "o", "\u001b[?2004h> "]
[1321.862964, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r"]
[1321.862992, "o", "\u001b[?2004h> "]
[1321.863058, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[1321.863082, "o", "\u001b[?2004h> "]
[1321.863125, "o", "        self._w_hi = None\r\n\u001b[?2004l\r"]
[1321.863153, "o", "\u001b[?2004h> "]
[1321.863191, "o", "        self._w_lo = None\r\n\u001b[?2004l\r"]
[1321.863219, "o", "\u001b[?2004h> "]
[1321.863248, "o", "        self._w_key = None\r\n\u001b[?2004l\r"]
[1321.863279, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1321.863337, "o", "    def _get_wsplit(self, w):\r\n\u001b[?2004l\r"]
[1321.863367, "o", "\u001b[?2004h> "]
[1321.863458, "o", "        key = (w.data_ptr(), w._version, w.device.index)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.863483, "o", "> "]
[1321.863528, "o", "        if self._w_key != key:\r\n\u001b[?2004l\r"]
[1321.863552, "o", "\u001b[?2004h> "]
[1321.863625, "o", "            wt = w.detach().t().contiguous()\r\n\u001b[?2004l\r"]
[1321.86365, "o", "\u001b[?2004h> "]
[1321.863715, "o", "            wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[1321.86374, "o", "\u001b[?2004h> "]
[1321.863841, "o", "            wl = (wt - wh.to(torch.float32)).to(torch.float16)\r\n\u001b[?2004l\r"]
[1321.863867, "o", "\u001b[?2004h> "]
[1321.863909, "o", "            self._w_hi = wh\r\n\u001b[?2004l\r"]
[1321.863938, "o", "\u001b[?2004h> "]
[1321.863976, "o", "            self._w_lo = wl\r\n\u001b[?2004l\r"]
[1321.864006, "o", "\u001b[?2004h> "]
[1321.864047, "o", "            self._w_key = key\r\n\u001b[?2004l\r"]
[1321.864075, "o", "\u001b[?2004h> "]
[1321.864126, "o", "        return self._w_hi, self._w_lo\r\n\u001b[?2004l\r"]
[1321.86415, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1321.864174, "o", "\u001b[?2004h> "]
[1321.864209, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[1321.864233, "o", "\u001b[?2004h> "]
[1321.864283, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r"]
[1321.864311, "o", "\u001b[?2004h> "]
[1321.864352, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r"]
[1321.864379, "o", "\u001b[?2004h> "]
[1321.864394, "o", "        if (\r\n\u001b[?2004l\r"]
[1321.864425, "o", "\u001b[?2004h> "]
[1321.864461, "o", "            _HAS_TRITON\r\n\u001b[?2004l\r"]
[1321.864488, "o", "\u001b[?2004h> "]
[1321.864525, "o", "            and x.is_cuda\r\n\u001b[?2004l\r"]
[1321.864547, "o", "\u001b[?2004h> "]
[1321.864615, "o", "            and x.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1321.864644, "o", "\u001b[?2004h> "]
[1321.864714, "o", "            and w.dtype == torch.float32\r\n\u001b[?2004l\r"]
[1321.864742, "o", "\u001b[?2004h> "]
[1321.864785, "o", "            and x.dim() == 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.864813, "o", "> "]
[1321.86487, "o", "            and x.shape[1] == w.shape[1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.864897, "o", "> "]
[1321.86494, "o", "            and x.is_contiguous()\r\n\u001b[?2004l\r"]
[1321.864965, "o", "\u001b[?2004h> "]
[1321.865018, "o", "            and x.shape[0] % 64 == 0\r\n\u001b[?2004l\r"]
[1321.865044, "o", "\u001b[?2004h> "]
[1321.865098, "o", "            and w.shape[0] % 64 == 0\r\n\u001b[?2004l\r"]
[1321.86512, "o", "\u001b[?2004h> "]
[1321.865179, "o", "            and w.shape[1] % 32 == 0\r\n\u001b[?2004l\r"]
[1321.865203, "o", "\u001b[?2004h> "]
[1321.865228, "o", "        ):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.865252, "o", "> "]
[1321.865286, "o", "            M, K = x.shape\r\n\u001b[?2004l\r"]
[1321.865309, "o", "\u001b[?2004h> "]
[1321.865353, "o", "            N = w.shape[0]\r\n\u001b[?2004l\r"]
[1321.865378, "o", "\u001b[?2004h> "]
[1321.86545, "o", "            wh, wl = self._get_wsplit(w)\r\n\u001b[?2004l\r"]
[1321.865479, "o", "\u001b[?2004h> "]
[1321.865595, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1321.865622, "o", "> "]
[1321.865699, "o", "            scale = float(1.0 + self.scaling_factor)\r\n\u001b[?2004l\r"]
[1321.865724, "o", "\u001b[?2004h> "]
[1321.865774, "o", "            grid = lambda META: (\r\n\u001b[?2004l\r"]
[1321.865798, "o", "\u001b[?2004h> "]
[1321.865903, "o", "                (M // META['BLOCK_M']) * (N // META['BLOCK_N']),\r\n\u001b[?2004l\r"]
[1321.865926, "o", "\u001b[?2004h> "]
[1321.865952, "o", "            )\r\n\u001b[?2004l\r"]
[1321.865977, "o", "\u001b[?2004h> "]
[1321.866035, "o", "            _linear_scaled_kernel[grid](\r\n\u001b[?2004l\r"]
[1321.866059, "o", "\u001b[?2004h> "]
[1321.866116, "o", "                x, wh, wl, b, out,\r\n\u001b[?2004l\r"]
[1321.866141, "o", "\u001b[?2004h> "]
[1321.866178, "o", "                M, N, K,\r\n\u001b[?2004l\r"]
[1321.866207, "o", "\u001b[?2004h> "]
[1321.866235, "o", "                scale,\r\n\u001b[?2004l\r"]
[1321.866261, "o", "\u001b[?2004h> "]
[1321.866287, "o", "            )\r\n\u001b[?2004l\r"]
[1321.866313, "o", "\u001b[?2004h> "]
[1321.866347, "o", "            return out\r\n\u001b[?2004l\r"]
[1321.866372, "o", "\u001b[?2004h> "]
[1321.866418, "o", "        t = F.linear(x, w, b)\r\n\u001b[?2004l\r"]
[1321.866448, "o", "\u001b[?2004h> "]
[1321.866517, "o", "        return t * self.scaling_factor + t\r\n\u001b[?2004l\r"]
[1321.866542, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1321.892421, "o", "\u001b[?2004hroot@modal:/# "]
