[1626.526749, "o", "\u001b[?2004h> "]
[1626.526789, "o", "        e.record()\r\n\u001b[?2004l\r"]
[1626.52681, "o", "\u001b[?2004h> "]
[1626.526869, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1626.526886, "o", "\u001b[?2004h> "]
[1626.526961, "o", "        times.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[1626.526982, "o", "\u001b[?2004h> "]
[1626.527013, "o", "    times.sort()\r\n\u001b[?2004l\r"]
[1626.527036, "o", "\u001b[?2004h> "]
[1626.527134, "o", "    return sum(times)/len(times), times[0], times[-1]\r\n\u001b[?2004l\r"]
[1626.527154, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1626.527169, "o", "\u001b[?2004h> "]
[1626.527254, "o", "print('=== cold-L2 eval-like timing ===')\r\n\u001b[?2004l\r"]
[1626.527274, "o", "\u001b[?2004h> "]
[1626.527322, "o", "for bm,bn,bk,s,wp,gm in [\r\n\u001b[?2004l\r"]
[1626.527338, "o", "\u001b[?2004h> "]
[1626.527453, "o", "    (256,128,32,5,8,8),(256,128,32,4,8,8),(128,128,32,4,8,8),\r\n\u001b[?2004l\r"]
[1626.527464, "o", "\u001b[?2004h"]
[1626.527481, "o", "> "]
[1626.527589, "o", "    (256,128,32,5,8,4),(256,128,32,5,8,16),(256,128,32,5,8,64),\r\n\u001b[?2004l\r"]
[1626.52761, "o", "\u001b[?2004h> "]
[1626.527723, "o", "    (128,256,32,4,8,8),(128,128,64,3,8,8),(256,128,64,3,8,8),\r\n\u001b[?2004l\r"]
[1626.52774, "o", "\u001b[?2004h> "]
[1626.527857, "o", "    (512,128,32,3,8,8),(256,256,32,4,8,8),(128,128,32,4,8,64),\r\n\u001b[?2004l\r"]
[1626.527874, "o", "\u001b[?2004h> ]:"]
[1626.527894, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[1626.527915, "o", "> "]
[1626.527971, "o", "    grid = ((M//bm)*(N//bn),)\r\n\u001b[?2004l\r"]
[1626.52799, "o", "\u001b[?2004h> "]
[1626.528012, "o", "    def f():\r\n"]
[1626.528033, "o", "\u001b[?2004l\r\u001b[?2004h"]
[1626.52805, "o", "> "]
[1626.528157, "o", "        kern[grid](x, wh, wl, b, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1626.528178, "o", "\u001b[?2004h> "]
[1626.528293, "o", "                   BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=gm,\r\n\u001b[?2004l\r"]
[1626.528314, "o", "\u001b[?2004h> "]
[1626.528398, "o", "                   num_stages=s, num_warps=wp)\r\n\u001b[?2004l\r"]
[1626.528415, "o", "\u001b[?2004h"]
[1626.528436, "o", ">     try:\r\n\u001b[?2004l\r"]
[1626.528452, "o", "\u001b[?2004h> "]
[1626.528523, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1626.528545, "o", "\u001b[?2004h> "]
[1626.528655, "o", "        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1626.528678, "o", "\u001b[?2004h"]
[1626.528695, "o", "> "]
[1626.528744, "o", "        mn, lo, hi = time_eval(f)\r\n\u001b[?2004l\r"]
[1626.528765, "o", "\u001b[?2004h> "]
[1626.52894, "o", "        print(f'bm{bm} bn{bn} bk{bk} s{s} w{wp} gm{gm}: mean {mn:.3f} min {lo:.3f} max {hi:.3f}')\r\n\u001b[?2004l\r"]
[1626.528957, "o", "\u001b[?2004h> "]
[1626.529015, "o", "    except Exception as ex:\r\n\u001b[?2004l\r"]
[1626.529035, "o", "\u001b[?2004h> "]
[1626.529227, "o", "        print(f'bm{bm} bn{bn} bk{bk} s{s} w{wp} gm{gm}: FAIL {type(ex).__name__}: {str(ex)[:40]}')\r\n\u001b[?2004l\r"]
[1626.529244, "o", "\u001b[?2004h"]
