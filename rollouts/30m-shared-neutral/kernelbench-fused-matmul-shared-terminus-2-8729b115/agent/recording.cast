[1128.319948, "o", "    w = (torch.rand(N, K, device='cuda', generator=g) * 2 - 1) * bound\r\n\u001b[?2004l\r"]
[1128.319978, "o", "\u001b[?2004h> "]
[1128.320085, "o", "    b = (torch.rand(N, device='cuda', generator=g) * 2 - 1) * bound\r\n\u001b[?2004l\r"]
[1128.320118, "o", "\u001b[?2004h> "]
[1128.320146, "o", "    scale = 1.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[1128.320177, "o", "> "]
[1128.320211, "o", "    wt = w.t().contiguous()\r\n\u001b[?2004l\r"]
[1128.320241, "o", "\u001b[?2004h> "]
[1128.320281, "o", "    wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[1128.320313, "o", "\u001b[?2004h> "]
[1128.320381, "o", "    wl = (wt - wh.float()).to(torch.float16)\r\n\u001b[?2004l\r"]
[1128.320413, "o", "\u001b[?2004h> "]
[1128.320479, "o", "    out = torch.empty((M, N), device='cuda')\r\n\u001b[?2004l\r"]
[1128.320509, "o", "\u001b[?2004h> "]
[1128.320613, "o", "    kern2[(M//128)*(N//128),](x, wh, wl, b, out, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1128.320645, "o", "\u001b[?2004h> "]
[1128.320788, "o", "        BLOCK_M=128, BLOCK_N=128, BLOCK_K=64, GROUP_M=8, num_stages=3, num_warps=8)\r\n\u001b[?2004l\r"]
[1128.320819, "o", "\u001b[?2004h> "]
[1128.320902, "o", "    ref = torch.nn.functional.linear(x, w, b) * scale\r\n\u001b[?2004l\r"]
[1128.320927, "o", "\u001b[?2004h> "]
[1128.320974, "o", "    diff = (out - ref).abs()\r\n\u001b[?2004l\r"]
[1128.321004, "o", "\u001b[?2004h> "]
[1128.321052, "o", "    tol = 1e-4 + 1e-4*ref.abs()\r\n\u001b[?2004l\r"]
[1128.321082, "o", "\u001b[?2004h> "]
[1128.321137, "o", "    ratio = (diff/tol).max().item()\r\n\u001b[?2004l\r"]
[1128.321168, "o", "\u001b[?2004h> "]
[1128.32121, "o", "    worst = max(worst, ratio)\r\n\u001b[?2004l\r"]
[1128.321239, "o", "\u001b[?2004h> "]
[1128.321326, "o", "    ok = torch.allclose(out, ref, atol=1e-4, rtol=1e-4)\r\n\u001b[?2004l\r"]
[1128.321358, "o", "\u001b[?2004h> "]
[1128.321402, "o", "    if seed % 5 == 0 or not ok:\r\n\u001b[?2004l\r"]
[1128.321431, "o", "\u001b[?2004h> "]
[1128.321524, "o", "        print(f'seed {seed}: ratio {ratio:.4f} pass {ok}')\r\n\u001b[?2004l\r"]
