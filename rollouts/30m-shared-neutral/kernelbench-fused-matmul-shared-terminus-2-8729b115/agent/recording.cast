[641.130766, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch\nimport triton\nimport triton.language as tl\nfrom triton.testing import do_bench\n\nM, N, K = 16384, 4096, 4096\nx = torch.rand(M, K, device='cuda')\nw = torch.rand(N, K, device='cuda')\nb = torch.rand(N, device='cuda')\nscale = 1.5\n\nwt = w.t().contiguous()\nwh = wt.to(torch.float16)\nwl = (wt - wh.float()).to(torch.float16)\n\n@triton.jit\ndef kern_a(a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\n           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N "]
[641.130815, "i", "+ tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    a_ptrs = a_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in range(0, K, BLOCK_K):\n        a = tl.load(a_ptrs)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        whl = tl.load(wh_ptrs)\n        wll = tl.load(wl_ptrs)\n        acc = tl.dot(a_hi, whl, acc)\n        acc = tl.dot(a_hi, wll, acc)\n        acc = tl.dot(a_lo, whl, acc)\n        a_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K * N\n        wl_ptrs += BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\n@triton.jit\ndef kern_b(ah_ptr, al_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\n           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl."]
[641.130944, "i", "constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    num_pid_m = tl.cdiv(M, BLOCK_M)\n    num_pid_n = tl.cdiv(N, BLOCK_N)\n    num_pid_in_group = GROUP_M * num_pid_n\n    group_id = pid // num_pid_in_group\n    first_pid_m = group_id * GROUP_M\n    group_size_m = min(num_pid_m - first_pid_m, GROUP_M)\n    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)\n    pid_n = (pid % num_pid_in_group) // group_size_m\n    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    offs_k = tl.arange(0, BLOCK_K)\n    ah_ptrs = ah_ptr + offs_m[:, None] * K + offs_k[None, :]\n    al_ptrs = al_ptr + offs_m[:, None] * K + offs_k[None, :]\n    wh_ptrs = wh_ptr + offs_k[:, None] * N + offs_n[None, :]\n    wl_ptrs = wl_ptr + offs_k[:, None] * N + offs_n[None, :]\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for _ in range(0, K, BLOCK_K):\n        a_hi = tl.load(ah_ptrs)\n        a_lo = tl.load(al_ptrs)\n        whl = tl.load(wh_ptrs)\n        wll = tl.load"]
[641.130962, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r"]
[641.130975, "i", "(wl_ptrs)\n        acc = tl.dot(a_hi, whl, acc)\n        acc = tl.dot(a_hi, wll, acc)\n        acc = tl.dot(a_lo, whl, acc)\n        ah_ptrs += BLOCK_K\n        al_ptrs += BLOCK_K\n        wh_ptrs += BLOCK_K * N\n        wl_ptrs += BLOCK_K * N\n    bias = tl.load(b_ptr + offs_n)\n    acc = (acc + bias[None, :]) * scale\n    c_ptrs = c_ptr + offs_m[:, None] * N + offs_n[None, :]\n    tl.store(c_ptrs, acc)\n\nout = torch.empty((M, N), device='cuda')\nref = (torch.nn.functional.linear(x, w, b)) * scale\n\nconfigs = []\nfor bm, bn, bk, s, wp in [\n    (128,128,64,3,8),(128,256,64,3,8),(256,128,64,3,8),(128,128,64,4,8),\n    (128,256,32,4,8),(256,128,32,4,8),(128,128,128,3,8),(64,256,64,4,4),\n    (128,256,64,4,8),(256,128,64,4,8),(128,64,64,4,4),(256,256,32,3,8),\n    (128,256,128,2,8),(64,128,128,4,4),(128,128,256,2,8),\n]:\n    configs.append((bm,bn,bk,s,wp))\n\nprint('=== Variant A: convert-in-loop ===')\nbest = None\nfor bm,bn,bk,s,wp in configs:\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        kern_a[grid](x, wh, wl, b, out, M, N, K"]
[641.131023, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[641.131054, "i", ", scale,\n                     BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                     num_stages=s, num_warps=wp)\n    try:\n        f(); torch.cuda.synchronize()\n        assert torch.allclose(out, ref, atol=1e-4, rtol=1e-4), 'mismatch'\n        t = do_bench(f, warmup=25, rep=100)\n        fl = 3*2*M*N*K/t*1e-9\n        print(f'A bm{bm} bn{bn} bk{bk} s{s} w{wp}: {t:.3f} ms  ({fl:.0f} fp16-TFLOPS)')\n    except Exception as e:\n        print(f'A bm{bm} bn{bn} bk{bk} s{s} w{wp}: FAIL {type(e).__name__}')\n\nprint('=== Variant B: pre-split A ===')\ndef presplit():\n    ah = x.to(torch.float16)\n    al = (x - ah.float()).to(torch.float16)\n    return ah, al\nfor bm,bn,bk,s,wp in configs:\n    grid = ((M//bm)*(N//bn),)\n    def f():\n        ah, al = presplit()\n        kern_b[grid](ah, al, wh, wl, b, out, M, N, K, scale,\n                     BLOCK_M=bm, BLOCK_N=bn, BLOCK_K=bk, GROUP_M=8,\n                     num_stages=s, num_warps=wp)\n    try:\n        f(); torch.cuda.synchronize()\n        assert torch.allclose(out, re"]
[641.131068, "o", "\u001b[?2004h> "]
[641.131097, "i", "f, atol=1e-4, rtol=1e-4), 'mismatch'\n        t = do_bench(f, warmup=25, rep=100)\n        print(f'B bm{bm} bn{bn} bk{bk} s{s} w{wp}: {t:.3f} ms (incl presplit)')\n    except Exception as e:\n        print(f'B bm{bm} bn{bn} bk{bk} s{s} w{wp}: FAIL {type(e).__name__}')\nEOF\n"]
[641.131111, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.131179, "o", "import triton.language as tl\r\n\u001b[?2004l\r"]
[641.131209, "o", "\u001b[?2004h> "]
[641.131345, "o", "from triton.testing import do_bench\r\n\u001b[?2004l\r\u001b[?2004h"]
[641.131383, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[641.131485, "o", "M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\rch.c"]
[641.131511, "o", "\u001b[?2004h> "]
[641.131624, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[641.131653, "o", "\u001b[?2004h> "]
[641.131739, "o", "w = torch.rand(N, K, device='cuda')\r\n\u001b[?2004l\r"]
[641.131778, "o", "\u001b[?2004h> "]
[641.131879, "o", "b = torch.rand(N, device='cuda')\r\n\u001b[?2004l\r"]
[641.131915, "o", "\u001b[?2004h> "]
[641.131941, "o", "scale = 1.5\r\n\u001b[?2004l\r"]
[641.131969, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[641.131985, "o", "> "]
[641.132057, "o", "wt = w.t().contiguous()\r\n\u001b[?2004l\r "]
[641.132085, "o", "\u001b[?2004h> "]
[641.132162, "o", "wh = wt.to(torch.float16)\r\n\u001b[?2004l\r"]
[641.132194, "o", "\u001b[?2004h> "]
[641.132313, "o", "wl = (wt - wh.float()).to(torch.float16)\r\n\u001b[?2004l\r"]
[641.132346, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[641.132401, "o", "@triton.jit\r\n\u001b[?2004l\r3"]
[641.132433, "o", "\u001b[?2004h> "]
[641.13263, "o", "def kern_a(a_ptr, wh_ptr, wl_ptr, b_ptr, c_ptr, M, N, K, scale,\r\n\u001b[?2004l\r"]
[641.132694, "o", "\u001b[?2004h> "]
[641.132992, "o", "           BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[641.133031, "o", "\u001b[?2004h> "]
[641.133097, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[641.13313, "o", "\u001b[?2004h> "]
[641.133241, "o", "    num_pid_m = tl.cdiv(M, BLOCK_M)\r\n\u001b[?2004l\r"]
[641.13328, "o", "\u001b[?2004h> "]
