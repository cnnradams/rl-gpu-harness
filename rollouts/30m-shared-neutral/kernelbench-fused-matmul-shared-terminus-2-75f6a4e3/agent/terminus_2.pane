[?2004lself, in_features, out_features, scaling_factor):
        super().__init__()
        self.matmul = nn.Linear(in_features, out_features)
        self.scaling_factor = scaling_factor
        self._wh = None
        self._wl = None
        self._b = None

    def _prepare(self, device):
        with torch.no_grad():
            w = self.matmul.weight.detach()
            wt = w.t().contiguous()
            wh = wt.half()
            wl = (wt - wh.float()).half()
            self._wh = wh
            self._wl = wl
            self._b = self.matmul.bias.detach().clone()

    def forward(self, x):
        if self._wh is None or self._wh.device != x.device:
            self._prepare(x.device)
        x = x.contiguous()
        M, K = x.shape
        N = self._wh.shape[1]
        scale = 1.0 + float(self.scaling_factor)

        xh = torch.empty((M, K), dtype=torch.float16, device=x.device)
        xl = torch.empty((M, K), dtype=torch.float16, device=x.device)
        numel = x.numel()
        SB = 8192
        _split_fp16[(triton.cdiv(numel, SB),)](x, xh, xl, numel, BLOCK=SB, num_warps=8)

        y = torch.empty((M, N), dtype=torch.float32, device=x.device)
        BM, BN, BK, GM = 128, 256, 64, 8
        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)
        _gemm3_fp16[grid](
            xh, xl, self._wh, self._wl, self._b, y,
            M, N, K, scale,
            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,
            num_warps=8, num_stages=4,
        )
        return y
