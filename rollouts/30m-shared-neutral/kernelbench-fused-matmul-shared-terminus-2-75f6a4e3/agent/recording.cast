[242.660547, "o", "        N = self._wh.shape[1]\r\n\u001b[?2004l\r"]
[242.660584, "o", "\u001b[?2004h> "]
[242.660686, "o", "        scale = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r"]
[242.660724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[242.660739, "o", "\u001b[?2004h"]
[242.66079, "o", "> "]
[242.660911, "o", "        xh = torch.empty((M, K), dtype=torch.float16, device=x.device)\r\n\u001b[?2004l\r"]
[242.660932, "o", "\u001b[?2004h> "]
[242.661102, "o", "        xl = torch.empty((M, K), dtype=torch.float16, device=x.device)\r\n\u001b[?2004l\r"]
[242.66114, "o", "\u001b[?2004h> "]
[242.661188, "o", "        numel = x.numel()\r\n\u001b[?2004l\r"]
[242.661227, "o", "\u001b[?2004h> "]
[242.661264, "o", "        SB = 8192\r\n\u001b[?2004l\r"]
[242.661303, "o", "\u001b[?2004h> "]
[242.661494, "o", "        _split_fp16[(triton.cdiv(numel, SB),)](x, xh, xl, numel, BLOCK=SB, num_warps=8)\r\n\u001b[?2004l\r"]
[242.661511, "o", "\u001b[?2004h"]
[242.661563, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.661719, "o", "        y = torch.empty((M, N), dtype=torch.float32, device=x.device)\r\n\u001b[?2004l\r"]
[242.661755, "o", "\u001b[?2004h> "]
[242.661841, "o", "        BM, BN, BK, GM = 128, 256, 64, 8\r\n\u001b[?2004l\r"]
[242.661879, "o", "\u001b[?2004h> "]
[242.661998, "o", "        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r"]
[242.662035, "o", "\u001b[?2004h> "]
[242.662087, "o", "        _gemm3_fp16[grid](\r\n\u001b[?2004l\r"]
[242.662123, "o", "\u001b[?2004h> "]
[242.662231, "o", "            xh, xl, self._wh, self._wl, self._b, y,\r\n\u001b[?2004l\r"]
[242.662269, "o", "\u001b[?2004h> "]
[242.662328, "o", "            M, N, K, scale,\r\n\u001b[?2004l\r"]
[242.662365, "o", "\u001b[?2004h> "]
[242.662506, "o", "            BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM,\r\n\u001b[?2004l\r"]
[242.662543, "o", "\u001b[?2004h> "]
[242.662621, "o", "            num_warps=8, num_stages=4,\r\n\u001b[?2004l\r"]
[242.662658, "o", "\u001b[?2004h> "]
[242.662696, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[242.662744, "o", "        return y\r\n\u001b[?2004l\r"]
[242.662781, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
