[692.625454, "i", "cat > /workspace/tune.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import get_inputs, get_init_inputs\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\nimport triton\n\ntorch.manual_seed(42)\ninit = get_init_inputs()\nm = sol.ModelNew(*init).cuda()\ntorch.manual_seed(42)\nx = get_inputs()[0].cuda()\nwith torch.no_grad():\n    m._prepare(x.device)\n    M, K = x.shape\n    N = m._wh.shape[1]\n    xh = torch.empty((M, K), dtype=torch.float16, device=x.device)\n    xl = torch.empty((M, K), dtype=torch.float16, device=x.device)\n    numel = x.numel()\n    SB = 8192\n    sol._split_fp16[(triton.cdiv(numel, SB),)](x, xh, xl, numel, BLOCK=SB, num_warps=8)\n    torch.cuda.synchronize()\n\n    def bench(BM, BN, BK, GM, W, S):\n        y = torch.empty((M, N), dtype=torch.float32, device=x.device)\n        grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n        def run():\n       "]
[692.625504, "i", "     sol._gemm3_fp16[grid](xh, xl, m._wh, m._wl, m._b, y, M, N, K, 1.5,\n                BLOCK_M=BM, BLOCK_N=BN, BLOCK_K=BK, GROUP_M=GM, num_warps=W, num_stages=S)\n        for _ in range(3): run()\n        torch.cuda.synchronize()\n        ts = []\n        for _ in range(20):\n            s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n            s.record(); run(); e.record(); torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n        return sum(ts)/len(ts)\n\n    cfgs = [\n        (128,256,64,8,8,2),\n        (128,256,64,8,8,3),\n        (256,128,64,8,8,2),\n        (128,128,64,8,8,3),\n        (128,128,64,8,4,3),\n        (128,256,32,8,8,3),\n        (256,256,32,8,8,2),\n        (128,256,32,8,8,4),\n        (64,256,64,8,4,3),\n        (256,64,64,8,4,3),\n        (128,64,64,8,4,3),\n        (256,256,64,8,8,2),\n    ]\n    for c in cfgs:\n        try:\n            t = bench(*c)\n            print(c, f'{t:.3f} ms')\n        except Exception as ex:\n            print(c, 'FAIL', str(ex)["]
