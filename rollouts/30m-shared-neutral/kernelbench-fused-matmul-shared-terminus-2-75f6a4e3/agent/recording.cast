[243.06319, "i", "cat > /workspace/test.py << 'EOF'\nimport torch, time\nimport importlib.util\nspec = importlib.util.spec_from_file_location('solution', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\nimport sys; sys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\n\ntorch.manual_seed(42)\ninit = get_init_inputs()\nref = Model(*init).cuda()\nnew = sol.ModelNew(*init).cuda()\n\nfor trial in range(5):\n    torch.manual_seed(42 + trial)\n    x = get_inputs()[0].cuda()\n    with torch.no_grad():\n        y_ref = ref(x)\n        y_new = new(x)\n    ok = torch.allclose(y_ref, y_new, atol=1e-4, rtol=1e-4)\n    diff = (y_ref - y_new).abs().max().item()\n    print(f'trial {trial}: ok={ok} maxdiff={diff:.3e}')\n\n# timing\ndef bench(m, x, n=20):\n    with torch.no_grad():\n        for _ in range(3):\n            m(x); torch.cuda.synchronize()\n        ts = []\n        for _ in range(n):\n            torch.cuda.synchronize()\n            s = torch.cuda.Event(enable_timing=True"]
[243.063239, "i", "); e = torch.cuda.Event(enable_timing=True)\n            s.record(); m(x); e.record(); torch.cuda.synchronize()\n            ts.append(s.elapsed_time(e))\n    return sum(ts)/len(ts)\n\ntorch.manual_seed(42)\nx = get_inputs()[0].cuda()\nprint('ref ms:', bench(ref, x))\nprint('new ms:', bench(new, x))\nEOF\necho written\n"]
