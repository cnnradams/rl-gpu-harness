[954.818372, "o", "\u001b[?2004h> "]
[954.818538, "o", "                for bn in (4096, 2048, 1024, 512, 256, 128, 64, 32, 16):\r\n\u001b[?2004l\r"]
[954.818576, "o", "\u001b[?2004h> "]
[954.818689, "o", "                    if bn <= chunk and chunk % bn == 0:\r\n\u001b[?2004l\r"]
[954.818728, "o", "\u001b[?2004h> "]
[954.818819, "o", "                        cfg = (nsplit, bn)\r\n\u001b[?2004l\r"]
[954.818857, "o", "\u001b[?2004h> "]
