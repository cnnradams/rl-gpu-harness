[765.654127, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, time, sys\nsys.path.insert(0, '/workspace')\nfrom solution import ModelNew\n\ntorch.manual_seed(0)\nM = ModelNew((64, 256, 256)).cuda()\nx = torch.rand(16, 64, 256, 256, device='cuda')\nref = torch.nn.functional.layer_norm(x, (64,256,256), M.ln.weight, M.ln.bias, 1e-5)\nout = M(x)\nerr = (out - ref).abs().max().item()\nprint('max err', err)\n\n# timing with L2 flush, like evaluator\nfrom kernelbench.timing import clear_l2_cache\nfor _ in range(3):\n    M(x); torch.cuda.synchronize()\ntimes = []\nfor _ in range(20):\n    torch.cuda.synchronize()\n    clear_l2_cache()\n    s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n    s.record(); M(x); e.record(); torch.cuda.synchronize()\n    times.append(s.elapsed_time(e))\ntimes = times[1:]\nprint('mean ms', sum(times)/len(times), 'min', min(times))\nEOF\ngpu push sb-NQ6igq6b09yFTJtVjOpHDE /workspace/bench.py /workspace/bench.py\n"]
