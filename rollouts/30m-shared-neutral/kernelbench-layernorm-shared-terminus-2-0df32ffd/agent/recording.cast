[130.516319, "o", "[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n[Profiling] Using timing method: cuda_event\r\n[Profiling] Using device: 0 NVIDIA H100 80GB HBM3, warm up 3, trials 20\r\n{\r\n  \"compiled\": true,\r\n  \"correctness\": true,\r\n  \"metadata\": {\r\n    \"hardware\": \"NVIDIA H100 80GB HBM3\",\r\n    \"device\": \"0\",\r\n    \"correctness_trials\": \"(5 / 5)\"\r\n  },\r\n  \"runtime\": 8.22,\r\n  \"runtime_stats\": {\r\n    \"mean\": 8.22,\r\n    \"std\": 0.00437,\r\n    \"min\": 8.22,\r\n    \"max\": 8.24,\r\n    \"num_trials\": 20\r\n  },\r\n  \"ref_runtime\": 8.08,\r\n  \"ref_runtime_stats\": {\r\n    \"mean\": 8.08,\r\n    \"std\": 0.00315,\r\n    \"min\": 8.07,\r\n    \"max\": 8.08,\r\n    \"num_trials\": 20\r\n  },\r\n  \"solution_sha256\": \"f8321e6d0071850e8d7918aaf0f64bcd4eb5a6deb66448ccf07e750d015d77fd\",\r\n  \"reference_sha256\": \"8d975d7cee6946513dcfb6ba84c971e53a890f9d9c6f0a4fb828904941f25975\",\r\n  \"timing_unit\": \"milliseconds\",\r\n  \"correct_trials\": 5,\r\n  \"perf_trials\": 20,\r\n  \"speedup\": 0.9829683698296836\r\n}\r\n"]
