[874.509328, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport torch.nn.functional as F\nfrom kernelbench.timing import clear_l2_cache\n\n@triton.jit\ndef _stats_kernel(X, PART, N: tl.constexpr, NSPLIT: tl.constexpr, BLOCK_N: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NSPLIT\n    part = pid % NSPLIT\n    CHUNK: tl.constexpr = N // NSPLIT\n    base = X + row * N + part * CHUNK\n    cols = tl.arange(0, BLOCK_N)\n    acc = tl.zeros([BLOCK_N], dtype=tl.float32)\n    acc2 = tl.zeros([BLOCK_N], dtype=tl.float32)\n    for i in range(0, CHUNK, BLOCK_N):\n        x = tl.load(base + i + cols, eviction_policy='evict_first')\n        acc += x\n        acc2 += x * x\n    s = tl.sum(acc, axis=0)\n    s2 = tl.sum(acc2, axis=0)\n    tl.store(PART + pid * 2 + 0, s)\n    tl.store(PART + pid * 2 + 1, s2)\n\n@triton.jit\ndef _apply_kernel(X, Y, W, B, PART, N: tl.constexpr, NSPLIT: tl.constexpr, BLOCK_N: tl.constexpr, EPS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // NSPLIT\n    part = pid % NSPLIT"]
[874.509376, "i", "\n    CHUNK: tl.constexpr = N // NSPLIT\n    offs = tl.arange(0, NSPLIT)\n    ps = tl.load(PART + (row * NSPLIT + offs) * 2 + 0)\n    ps2 = tl.load(PART + (row * NSPLIT + offs) * 2 + 1)\n    mean = tl.sum(ps, axis=0) / N\n    var = tl.sum(ps2, axis=0) / N - mean * mean\n    rstd = tl.rsqrt(var + EPS)\n    x_base = X + row * N + part * CHUNK\n    y_base = Y + row * N + part * CHUNK\n    wb_base = part * CHUNK\n    cols = tl.arange(0, BLOCK_N)\n    for i in range(0, CHUNK, BLOCK_N):\n        x = tl.load(x_base + i + cols, eviction_policy='evict_first')\n        w = tl.load(W + wb_base + i + cols)\n        b = tl.load(B + wb_base + i + cols)\n        y = (x - mean) * rstd * w + b\n        tl.store(y_base + i + cols, y, eviction_policy='evict_first')\n\ndef run_split(x, w, b, NSPLIT, BLOCK_N, warps):\n    M, N = 16, 64*256*256\n    y = torch.empty_like(x)\n    part = torch.empty(M*NSPLIT*2, device=x.device, dtype=torch.float32)\n    _stats_kernel[(M*NSPLIT,)](x, part, N, NSPLIT, BLOCK_N, num_warps=warps)\n    _apply_kernel[(M*NSPLIT,)]("]
[874.509389, "i", "x, y, w, b, part, N, NSPLIT, BLOCK_N, 1e-5, num_warps=warps)\n    return y\n\ndef bench(fn):\n    for _ in range(3):\n        fn(); torch.cuda.synchronize()\n    ts = []\n    for _ in range(20):\n        torch.cuda.synchronize(); clear_l2_cache()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        s.record(); fn(); e.record(); torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    ts = ts[1:]\n    return sum(ts)/len(ts), min(ts)\n\nx = torch.rand(16, 64, 256, 256, device='cuda')\nw = torch.randn(64, 256, 256, device='cuda')\nb = torch.randn(64, 256, 256, device='cuda')\nref = F.layer_norm(x, (64,256,256), w, b, 1e-5)\n\nfor nsplit in [4, 8, 16, 32]:\n    for bn in [4096, 8192, 16384]:\n        for wp in [8, 16, 32]:\n            if bn // (wp*32) < 1: continue\n            try:\n                y = run_split(x, w, b, nsplit, bn, wp)\n                err = (y-ref).abs().max().item()\n                mean, mn = bench(lambda: run_split(x, w, b, nsplit, bn, wp))\n                p"]
[874.5095, "i", "rint(f'NSPLIT={nsplit} BN={bn} W={wp}: err={err:.2e} mean={mean:.4f}ms min={mn:.4f}ms')\n            except Exception as ex:\n                print(f'NSPLIT={nsplit} BN={bn} W={wp}: FAIL {type(ex).__name__}')\nEOF\ngpu push sb-NQ6igq6b09yFTJtVjOpHDE /workspace/bench2.py /workspace/bench2.py\n"]
[874.509552, "o", "cat > /workspace/bench2.py << 'EOF'\r\n\u001b[?2004l\r"]
[874.509636, "o", "rint(f'NSPLIT={nsplit} BN={bn} W={wp}: err={err:.2e} mean={mean:.4f}ms min={mn:.4f}ms')\r\n            except"]
[874.509662, "o", " Exception as ex:\r\n                print(f'NSPLIT={nsplit} BN={bn} W={wp}: FAIL {type(ex).__name__"]
[874.509681, "o", "}')\r\nEOF\r\ngpu push sb-NQ6igq6b09yFTJtVjOpHDE "]
[874.509701, "o", "/workspace/bench2.py /workspace/bench2.py\r\n"]
