[954.820221, "o", "\u001b[?2004h> "]
[954.820352, "o", "        if w.dtype != torch.float32 or not w.is_contiguous():\r\n\u001b[?2004l\r"]
[954.820393, "o", "\u001b[?2004h> "]
[954.820472, "o", "            w = w.float().contiguous()\r\n\u001b[?2004l\r"]
[954.820511, "o", "\u001b[?2004h> "]
