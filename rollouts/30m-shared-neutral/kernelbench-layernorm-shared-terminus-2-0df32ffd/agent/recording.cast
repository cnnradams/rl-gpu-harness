[755.648152, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_kernel(\n    X, Y, W, B,\n    N: tl.constexpr,\n    BLOCK_N: tl.constexpr,\n    ROWS_PER_PROG: tl.constexpr,\n    EPS: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    row = pid * ROWS_PER_PROG\n    cols = tl.arange(0, BLOCK_N)\n    for r in range(ROWS_PER_PROG):\n        x_base = X + row * N + cols\n        y_base = Y + row * N + cols\n        acc = tl.zeros([BLOCK_N], dtype=tl.float32)\n        acc2 = tl.zeros([BLOCK_N], dtype=tl.float32)\n        for i in range(0, N, BLOCK_N):\n            x = tl.load(x_base + i, eviction_policy='evict_first')\n            acc += x\n            acc2 += x * x\n        mean = tl.sum(acc, axis=0) / N\n        var = tl.sum(acc2, axis=0) / N - mean * mean\n        rstd = tl.rsqrt(var + EPS)\n        for i in range(0, N, BLOCK_N):\n            x = tl.load(x_base + i, eviction_policy='evict_first')\n            w = tl.load(W + i + cols)\n            b = tl.load(B + i"]
[755.648195, "i", " + cols)\n            y = (x - mean) * rstd * w + b\n            tl.store(y_base + i, y, eviction_policy='evict_first')\n        row += 1\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not x.is_cuda:\n            return self.ln(x)\n        x = x.contiguous()\n        N = 1\n        for s in self.normalized_shape:\n            N *= s\n        M = x.numel() // N\n        y = torch.empty_like(x)\n        w = self.ln.weight\n        b = self.ln.bias\n        BLOCK_N = 8192\n        ROWS_PER_PROG = 1\n        grid = (M // ROWS_PER_PROG,)\n        _ln_kernel[grid](\n            x, y, w, b,\n            N,\n            BLOCK_N=BLOCK_N,\n            ROWS_PER_PROG=ROWS_PER_PROG,\n            EPS=1e-5,\n            num_warps=32,\n        )\n        return y\nEOF\ngpu push sb-NQ6igq6b09yFTJtVjOpHDE /wo"]
[755.648207, "i", "rkspace/solution.py /workspace/solution.py\n"]
