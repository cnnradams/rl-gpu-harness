[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_stats_kernel(X, PART, N: tl.constexpr, NSPLIT: tl.constexpr, BLOCK_N: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     row = pid // NSPLIT
[?2004l[?2004h>     part = pid % NSPLIT
[?2004l[?2004h>     CHUNK: tl.constexpr = N // NSPLIT
[?2004l[?2004h>     base = X + row * N + part * CHUNK
[?2004l[?2004h>     cols = tl.arange(0, BLOCK_N)
[?2004l[?2004h>     acc = tl.zeros([BLOCK_N], dtype=tl.float32)
[?2004l[?2004h>     acc2 = tl.zeros([BLOCK_N], dtype=tl.float32)
[?2004l[?2004h>     for i in range(0, CHUNK, BLOCK_N):
[?2004l[?2004h>         x = tl.load(base + i + cols, eviction_policy='evict_first')
[?2004l[?2004h>         acc += x
[?2004l[?2004h>         acc2 += x * x
[?2004l[?2004h>     tl.store(PART + pid * 2 + 0, tl.sum(acc, axis=0))
[?2004l[?2004h>     tl.store(PART + pid * 2 + 1, tl.sum(acc2, axis=0))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_apply_kernel(X, Y, W, B, PART, N: tl.constexpr, NSPLIT: tl.constexpr, BLOCK_N: tl.constexpr, EPS: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     row = pid // NSPLIT
[?2004l[?2004h>     part = pid % NSPLIT
[?2004l[?2004h>     CHUNK: tl.constexpr = N // NSPLIT
[?2004l[?2004h>     offs = tl.arange(0, NSPLIT)
[?2004l[?2004h>     ps = tl.load(PART + (row * NSPLIT + offs) * 2 + 0)
[?2004l[?2004h>     ps2 = tl.load(PART + (row * NSPLIT + offs) * 2 + 1)
[?2004l[?2004h>     mean = tl.sum(ps, axis=0) / N
[?2004l[?2004h>     var = tl.sum(ps2, axis=0) / N - mean * mean
[?2004l[?2004h>     rstd = tl.rsqrt(var + EPS)
[?2004l[?2004h>     x_base = X + row * N + part * CHUNK
[?2004l[?2004h>     y_base = Y + row * N + part * CHUNK
[?2004l[?2004h>     wb_base = part * CHUNK
[?2004l[?2004h>     cols = tl.arange(0, BLOCK_N)
[?2004l[?2004h>     for i in range(0, CHUNK, BLOCK_N):
[?2004l[?2004h>         x = tl.load(x_base + i + cols, eviction_policy='evict_first')
[?2004l[?2004h>         w = tl.load(W + wb_base + i + cols)
[?2004l[?2004h>         b = tl.load(B + wb_base + i + cols)
[?2004l[?2004h>         y = (x - mean) * rstd * w + b
[?2004l[?2004h>         tl.store(y_base + i + cols, y, eviction_policy='evict_first')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, normalized_shape: tuple):
[?2004l[?2004h>         super().__init__()
