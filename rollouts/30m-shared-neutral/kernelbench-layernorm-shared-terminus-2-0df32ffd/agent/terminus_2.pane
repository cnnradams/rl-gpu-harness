[?2004l[?2004h>         for s in self.normalized_shape:
[?2004l[?2004h>             N *= s
[?2004l[?2004h>         self.N = N
[?2004l[?2004h>         # choose config
[?2004l[?2004h>         cfg = None
[?2004l[?2004h>         if N % 16 == 0:
[?2004l[?2004h>             for nsplit in (16, 8, 4, 2, 1):
[?2004l[?2004h>                 if N % nsplit != 0:
[?2004l[?2004h>                     continue
[?2004l[?2004h>                 chunk = N // nsplit
[?2004l[?2004h>                 for bn in (4096, 2048, 1024, 512, 256, 128, 64, 32, 16):
[?2004l[?2004h>                     if bn <= chunk and chunk % bn == 0:
[?2004l[?2004h>                         cfg = (nsplit, bn)
