[430.734488, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _ln_partial(X, PS, PSQ, N, NSPLIT, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row.to(tl.int64) * N\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(X + base + offs, mask=mask, other=0.0)\n    tl.store(PS + row * NSPLIT + pid, tl.sum(x))\n    tl.store(PSQ + row * NSPLIT + pid, tl.sum(x * x))\n\n@triton.jit\ndef _ln_apply(X, PS, PSQ, W, B, Y, N, NSPLIT, eps, BLOCK: tl.constexpr, NPOW: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row.to(tl.int64) * N\n    offs2 = tl.arange(0, NPOW)\n    mask2 = offs2 < NSPLIT\n    ps = tl.load(PS + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    psq = tl.load(PSQ + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(psq) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var "]
[430.734844, "i", "+ eps)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(X + base + offs, mask=mask, other=0.0)\n    w = tl.load(W + offs, mask=mask, other=0.0)\n    b = tl.load(B + offs, mask=mask, other=0.0)\n    tl.store(Y + base + offs, (x - mean) * rstd * w + b, mask=mask)\n\ndev = 'cuda'\nx = torch.rand(16, 64, 256, 256, device=dev)\nM, N = 16, 64*256*256\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\neps = 1e-5\nx2 = x.view(M, N)\n\ndef run(BLOCK, warps):\n    y2 = torch.empty_like(x2)\n    NSPLIT = triton.cdiv(N, BLOCK)\n    ps = torch.empty((M, NSPLIT), device=dev)\n    psq = torch.empty((M, NSPLIT), device=dev)\n    def fn(xx):\n        _ln_partial[(NSPLIT, M)](xx, ps, psq, N, NSPLIT, BLOCK=BLOCK, num_warps=warps)\n        _ln_apply[(NSPLIT, M)](xx, ps, psq, w, b, y2, N, NSPLIT, eps, BLOCK=BLOCK, NPOW=triton.next_power_of_2(NSPLIT), num_warps=warps)\n        return y2\n    times = time_execution_with_cuda_event(fn, [x2], num_warmup=3, num_trials=20, verbose=False, device=dev)\n    return np."]
