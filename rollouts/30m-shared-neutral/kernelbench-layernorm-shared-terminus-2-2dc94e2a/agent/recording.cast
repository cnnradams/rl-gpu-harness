[693.020952, "i", "cat >> /workspace/micro2.py << 'PYEOF'\n\n@triton.jit\ndef _ln_apply_l2(X, PS, PSQ, W, B, Y, N: tl.constexpr, M: tl.constexpr, NSPLIT, eps, BLOCK: tl.constexpr, NPOW: tl.constexpr):\n    pid = tl.program_id(0)\n    chunk = pid // M\n    row = pid % M\n    base = row.to(tl.int64) * N\n    offs2 = tl.arange(0, NPOW)\n    mask2 = offs2 < NSPLIT\n    ps = tl.load(PS + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    psq = tl.load(PSQ + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(psq) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = chunk * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + base + offs)\n    w = tl.load(W + offs)\n    b = tl.load(B + offs)\n    tl.store(Y + base + offs, (x - mean) * rstd * w + b)\nPYEOF\n"]
