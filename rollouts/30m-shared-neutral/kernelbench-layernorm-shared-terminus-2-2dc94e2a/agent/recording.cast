[582.088982, "i", "cat > /workspace/micro.py << 'EOF'\nimport torch, triton, triton.language as tl\nimport numpy as np\nfrom kernelbench.timing import time_execution_with_cuda_event\n\n@triton.jit\ndef _copy(X, Y, N, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid.to(tl.int64) * BLOCK + tl.arange(0, BLOCK)\n    tl.store(Y + offs, tl.load(X + offs))\n\n@triton.jit\ndef _ln_partial_nm(X, PS, PSQ, N: tl.constexpr, NSPLIT, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row.to(tl.int64) * N\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + base + offs)\n    tl.store(PS + row * NSPLIT + pid, tl.sum(x))\n    tl.store(PSQ + row * NSPLIT + pid, tl.sum(x * x))\n\n@triton.jit\ndef _ln_apply_nm(X, PS, PSQ, W, B, Y, N: tl.constexpr, NSPLIT, eps, BLOCK: tl.constexpr, NPOW: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row.to(tl.int64) * N\n    offs2 = tl.arange(0, NPOW)\n    mask2 = offs2 < NSPLIT\n    ps = tl.load(PS + row * NSPLIT + offs2, mask=mask2, ot"]
[582.089149, "i", "her=0.0)\n    psq = tl.load(PSQ + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(psq) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + base + offs)\n    w = tl.load(W + offs)\n    b = tl.load(B + offs)\n    tl.store(Y + base + offs, (x - mean) * rstd * w + b)\n\ndev='cuda'\nM,N = 16, 64*256*256\nx2 = torch.rand(M, N, device=dev)\ny2 = torch.empty_like(x2)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\neps=1e-5\n\ndef t(fn, *args, **kw):\n    times = time_execution_with_cuda_event(fn, list(args), num_warmup=3, num_trials=20, verbose=False, device=dev)\n    return np.mean(times[1:])\n\n# bandwidth reference: copy 268MB -> 268MB (536MB traffic)\nNB = (M*N) // 4096\ndef fcopy(xx):\n    _copy[(NB,)](xx.reshape(-1), y2.reshape(-1), M*N, BLOCK=4096, num_warps=8)\n    return y2\ntc = t(fcopy, x2)\nprint(f'copy only: {tc:.4f} ms  -> {2*M*N*4/tc/1e9:.2f} GB/ms eff')\n\nfor BLOCK in [2048, 4096, 8192]:\n    for warps in ["]
[582.089214, "i", "4, 8, 16]:\n        NSPLIT = N // BLOCK\n        ps = torch.empty((M, NSPLIT), device=dev)\n        psq = torch.empty((M, NSPLIT), device=dev)\n        NPOW = triton.next_power_of_2(NSPLIT)\n        def fn(xx):\n            _ln_partial_nm[(NSPLIT, M)](xx, ps, psq, N, NSPLIT, BLOCK=BLOCK, num_warps=warps)\n            _ln_apply_nm[(NSPLIT, M)](xx, ps, psq, w, b, y2, N, NSPLIT, eps, BLOCK=BLOCK, NPOW=NPOW, num_warps=warps)\n            return y2\n        tm = t(fn, x2)\n        print(f'nomask BLOCK={BLOCK:6d} warps={warps:3d}: {tm:.4f} ms')\n\n# partial only / apply only at best config\nBLOCK, warps = 4096, 8\nNSPLIT = N // BLOCK\nps = torch.empty((M, NSPLIT), device=dev); psq = torch.empty((M, NSPLIT), device=dev)\nNPOW = triton.next_power_of_2(NSPLIT)\ndef fpart(xx):\n    _ln_partial_nm[(NSPLIT, M)](xx, ps, psq, N, NSPLIT, BLOCK=BLOCK, num_warps=warps)\n    return ps\ndef fapp(xx):\n    _ln_apply_nm[(NSPLIT, M)](xx, ps, psq, w, b, y2, N, NSPLIT, eps, BLOCK=BLOCK, NPOW=NPOW, num_warps=warps)\n    return y2\nprint(f'partial only: {t("]
[582.089253, "i", "fpart, x2):.4f} ms')\nprint(f'apply only:   {t(fapp, x2):.4f} ms')\nEOF\nB64=$(base64 -w0 /workspace/micro.py); gpu exec sb-TriUhE2CT5PxiiP0HoHDgl -- bash -c \"echo $B64 | base64 -d > /tmp/micro.py && python3 /tmp/micro.py\"\n"]
