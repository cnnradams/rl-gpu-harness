[175.911287, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _ln_partial(X, PS, PSQ, N, NSPLIT, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row.to(tl.int64) * N\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(X + base + offs, mask=mask, other=0.0)\n    s = tl.sum(x)\n    sq = tl.sum(x * x)\n    tl.store(PS + row * NSPLIT + pid, s)\n    tl.store(PSQ + row * NSPLIT + pid, sq)\n\n\n@triton.jit\ndef _ln_apply(X, PS, PSQ, W, B, Y, N, NSPLIT, eps, BLOCK: tl.constexpr, NPOW: tl.constexpr):\n    pid = tl.program_id(0)\n    row = tl.program_id(1)\n    base = row.to(tl.int64) * N\n    offs2 = tl.arange(0, NPOW)\n    mask2 = offs2 < NSPLIT\n    ps = tl.load(PS + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    psq = tl.load(PSQ + row * NSPLIT + offs2, mask=mask2, other=0.0)\n    mean = tl.sum(ps) / N\n    var = tl.sum(psq) / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = pi"]
[175.911469, "i", "d * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < N\n    x = tl.load(X + base + offs, mask=mask, other=0.0)\n    w = tl.load(W + offs, mask=mask, other=0.0)\n    b = tl.load(B + offs, mask=mask, other=0.0)\n    y = (x - mean) * rstd * w + b\n    tl.store(Y + base + offs, y, mask=mask)\n\n\n_BLOCK = 4096\n_WARPS = 16\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super(ModelNew, self).__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n        self.eps = self.ln.eps\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if not x.is_cuda or x.dtype != torch.float32:\n            return self.ln(x)\n        x = x.contiguous()\n        N = 1\n        for s in self.normalized_shape:\n            N *= s\n        M = x.numel() // N\n        x2 = x.view(M, N)\n        y2 = torch.empty_like(x2)\n        w = self.ln.weight.reshape(-1)\n        b = self.ln.bias.reshape(-1)\n        BLOCK = _BLOCK\n        NSPLIT ="]
[175.911508, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.91154, "i", " triton.cdiv(N, BLOCK)\n        ps = torch.empty((M, NSPLIT), device=x.device, dtype=torch.float32)\n        psq = torch.empty((M, NSPLIT), device=x.device, dtype=torch.float32)\n        _ln_partial[(NSPLIT, M)](x2, ps, psq, N, NSPLIT, BLOCK=BLOCK, num_warps=_WARPS)\n        _ln_apply[(NSPLIT, M)](x2, ps, psq, w, b, y2, N, NSPLIT, self.eps,\n                               BLOCK=BLOCK, NPOW=triton.next_power_of_2(NSPLIT), num_warps=_WARPS)\n        return y2.view(x.shape)\nEOF\n"]
[175.911564, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.911597, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.911627, "o", "import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.911674, "o", "import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.911695, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.911718, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.911756, "o", "> @triton.jit\r\n"]
[175.91178, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.911867, "o", "def _ln_partial(X, PS, PSQ, N, NSPLIT, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.911904, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[175.911931, "o", "\u001b[?2004h> "]
[175.911963, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r"]
[175.911993, "o", "\u001b[?2004h> "]
[175.912021, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[175.91206, "o", "\u001b[?2004h> "]
[175.912089, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[175.912115, "o", "\u001b[?2004h> "]
[175.912144, "o", "    mask = offs < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.912174, "o", "> "]
[175.912215, "o", "    x = tl.load(X + base + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[175.912248, "o", "\u001b[?2004h> "]
[175.912273, "o", "    s = tl.sum(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.912299, "o", "    sq = tl.sum(x * x)\r\n\u001b[?2004l\r"]
[175.912327, "o", "\u001b[?2004h> "]
[175.912366, "o", "    tl.store(PS + row * NSPLIT + pid, s)\r\n\u001b[?2004l\r"]
[175.912395, "o", "\u001b[?2004h> "]
[175.912438, "o", "    tl.store(PSQ + row * NSPLIT + pid, sq)\r\n\u001b[?2004l\r"]
[175.912474, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.912505, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.912535, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.912636, "o", "def _ln_apply(X, PS, PSQ, W, B, Y, N, NSPLIT, eps, BLOCK: tl.constexpr, NPOW: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.912662, "o", "> "]
[175.91269, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.912716, "o", "> "]
[175.912747, "o", "    row = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.912792, "o", "    base = row.to(tl.int64) * N\r\n\u001b[?2004l\r"]
[175.912816, "o", "\u001b[?2004h> "]
[175.912849, "o", "    offs2 = tl.arange(0, NPOW)\r\n\u001b[?2004l\r"]
[175.912879, "o", "\u001b[?2004h> "]
[175.912911, "o", "    mask2 = offs2 < NSPLIT\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.912993, "o", "    ps = tl.load(PS + row * NSPLIT + offs2, mask=mask2, other=0.0)\r\n\u001b[?2004l\r"]
[175.913018, "o", "\u001b[?2004h> "]
[175.913088, "o", "    psq = tl.load(PSQ + row * NSPLIT + offs2, mask=mask2, other=0.0)\r\n\u001b[?2004l\r"]
[175.913117, "o", "\u001b[?2004h> "]
[175.913146, "o", "    mean = tl.sum(ps) / N\r\n\u001b[?2004l\r"]
[175.913171, "o", "\u001b[?2004h> "]
[175.913201, "o", "    var = tl.sum(psq) / N - mean * mean\r\n\u001b[?2004l\r"]
[175.913227, "o", "\u001b[?2004h> "]
[175.913264, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r"]
[175.913289, "o", "\u001b[?2004h> "]
[175.913338, "o", "    offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[175.913367, "o", "\u001b[?2004h> "]
[175.913391, "o", "    mask = offs < N\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.913416, "o", "> "]
[175.913468, "o", "    x = tl.load(X + base + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[175.913495, "o", "\u001b[?2004h> "]
[175.913538, "o", "    w = tl.load(W + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[175.913563, "o", "\u001b[?2004h> "]
[175.913612, "o", "    b = tl.load(B + offs, mask=mask, other=0.0)\r\n\u001b[?2004l\r"]
[175.913641, "o", "\u001b[?2004h> "]
[175.913669, "o", "    y = (x - mean) * rstd * w + b\r\n\u001b[?2004l\r"]
[175.913698, "o", "\u001b[?2004h> "]
[175.913747, "o", "    tl.store(Y + base + offs, y, mask=mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.913779, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.91381, "o", "\u001b[?2004h> "]
[175.913834, "o", "_BLOCK = 4096\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.913864, "o", "_WARPS = 16\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.913891, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.913914, "o", "\u001b[?2004h> "]
[175.913939, "o", "class ModelNew(nn.Module):\r\n"]
[175.913968, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.914018, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r"]
[175.914047, "o", "\u001b[?2004h> "]
[175.914084, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[175.91411, "o", "\u001b[?2004h> "]
[175.914178, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r"]
[175.914205, "o", "\u001b[?2004h> "]
[175.914259, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[175.914284, "o", "\u001b[?2004h> "]
[175.914315, "o", "        self.eps = self.ln.eps\r\n\u001b[?2004l\r"]
[175.914343, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.914368, "o", "\u001b[?2004h> "]
[175.914415, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[175.91444, "o", "\u001b[?2004h> "]
[175.914501, "o", "        if not x.is_cuda or x.dtype != torch.float32:\r\n\u001b[?2004l\r"]
[175.91453, "o", "\u001b[?2004h> "]
[175.914556, "o", "            return self.ln(x)\r\n"]
[175.914584, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[175.914613, "o", "        x = x.contiguous()\r\n\u001b[?2004l\r"]
[175.914639, "o", "\u001b[?2004h> "]
[175.914669, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.914712, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[175.914737, "o", "\u001b[?2004h> "]
[175.914764, "o", "            N *= s\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.914789, "o", "> "]
[175.914814, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.914844, "o", "> "]
[175.914869, "o", "        x2 = x.view(M, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.914918, "o", "        y2 = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[175.914946, "o", "\u001b[?2004h> "]
[175.914982, "o", "        w = self.ln.weight.reshape(-1)\r\n\u001b[?2004l\r"]
[175.915009, "o", "\u001b[?2004h> "]
[175.915045, "o", "        b = self.ln.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[175.91507, "o", "\u001b[?2004h> "]
[175.915098, "o", "        BLOCK = _BLOCK\r\n\u001b[?2004l\r"]
[175.915123, "o", "\u001b[?2004h> "]
[175.915149, "o", "        NSPLIT = triton.cdiv(N, BLOCK)\r\n\u001b[?2004l\r"]
[175.915177, "o", "\u001b[?2004h> "]
[175.915254, "o", "        ps = torch.empty((M, NSPLIT), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[175.915282, "o", "\u001b[?2004h> "]
[175.915359, "o", "        psq = torch.empty((M, NSPLIT), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[175.915385, "o", "\u001b[?2004h> "]
[175.915482, "o", "        _ln_partial[(NSPLIT, M)](x2, ps, psq, N, NSPLIT, BLOCK=BLOCK, num_warps=_WARPS)\r\n\u001b[?2004l\r"]
[175.915509, "o", "\u001b[?2004h> "]
[175.915584, "o", "        _ln_apply[(NSPLIT, M)](x2, ps, psq, w, b, y2, N, NSPLIT, self.eps,\r\n\u001b[?2004l\r"]
[175.915615, "o", "\u001b[?2004h> "]
[175.915717, "o", "                               BLOCK=BLOCK, NPOW=triton.next_power_of_2(NSPLIT), num_warps=_WARPS)\r\n\u001b[?2004l\r"]
[175.915751, "o", "\u001b[?2004h> "]
[175.915779, "o", "        return y2.view(x.shape)\r\n\u001b[?2004l\r"]
[175.915804, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[175.918085, "o", "\u001b[?2004hroot@modal:/# "]
[176.011752, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/workspace')\nimport importlib\nimport solution\nimportlib.reload(solution)\n\ntorch.manual_seed(0)\ndev = 'cuda'\nx = torch.rand(16, 64, 256, 256, device=dev)\nref = torch.nn.LayerNorm((64, 256, 256)).to(dev)\nnew = solution.ModelNew((64, 256, 256)).to(dev)\n\nwith torch.no_grad():\n    out_ref = ref(x)\n    out_new = new(x)\nprint('max diff:', (out_ref - out_new).abs().max().item())\nprint('allclose:', torch.allclose(out_ref, out_new, atol=1e-4, rtol=1e-4))\n\ndef time_fn(fn, args, num_warmup=3, num_trials=20):\n    from kernelbench.timing import time_execution_with_cuda_event\n    times = time_execution_with_cuda_event(fn, args, num_warmup=num_warmup, num_trials=num_trials, verbose=False, device=dev)\n    import numpy as np\n    times = times[1:]\n    return np.mean(times)\n\nwith torch.no_grad():\n    t_ref = time_fn(ref, [x])\n    t_new = time_fn(new, [x])\nprint(f'ref: {t_ref:.4f} ms   new: {t_new:.4f} ms   speedup: {t_ref/t_new:.2f}x')\nEOF\n"]
