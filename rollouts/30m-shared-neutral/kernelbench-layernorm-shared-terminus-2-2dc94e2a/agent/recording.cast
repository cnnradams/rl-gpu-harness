[62.572488, "o", "ompile_cache(\r\n330:def build_compile_cache_with_capturing(\r\n370:def _process_input_tensor(input, device, backend=\"cuda\", precision=torch.float32):\r\n394:def eval_kernel_against_ref(\r\n399:    num_perf_trials: int = 10,\r\n401:    timing_method: str = \"cuda_event\", # see timing.py\r\n421:    num_perf_trials: run the evalutation many times to take the average\r\n628:                    num_trials=num_perf_trials,\r\n674:            num_trials=num_perf_trials,\r\n702:def register_and_format_exception(\r\n727:def run_and_check_correctness(\r\n801:                # now we will return the tolerance from get_tolerance_for_precision\r\n802:                tolerance = get_tolerance_for_precision(precision)\r\n804:                if not torch.allclose(\r\n805:                    output, output_new, atol=tolerance, rtol=tolerance\r\n851:def check_metadata_serializable(metadata: dict):\r\n880:def check_metadata_serializable_all_types(metadata: dict):\r\n886:    def convert_to_serializable(obj):\r\n"]
