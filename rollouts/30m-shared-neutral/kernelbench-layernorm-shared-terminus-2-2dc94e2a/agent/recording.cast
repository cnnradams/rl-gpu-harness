[760.19166, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[760.191684, "o", "\u001b[?2004h> "]
[760.191744, "o", "    def __init__(self, normalized_shape: tuple):"]
[760.191774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[760.191825, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[760.191917, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[760.191941, "o", "> "]
[760.191987, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r"]
[760.192011, "o", "\u001b[?2004h> "]
[760.192039, "o", "        self.eps = self.ln.eps\r\n\u001b[?2004l\r"]
[760.192064, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[760.192088, "o", "> "]
[760.192135, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[760.192159, "o", "\u001b[?2004h> "]
[760.192187, "o", "        N = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[760.192229, "o", "        for s in self.normalized_shape:\r\n\u001b[?2004l\r"]
[760.192257, "o", "\u001b[?2004h> "]
[760.192334, "o", "            N *= s\r\n\u001b[?2004l\r"]
[760.192361, "o", "\u001b[?2004h> "]
[760.19246, "o", "        if (not x.is_cuda) or x.dtype != torch.float32 or (N % _BLOCK) != 0 or not x.is_contiguous():\r\n\u001b[?2004l\r"]
[760.192488, "o", "\u001b[?2004h> "]
[760.192515, "o", "            return self.ln(x)\r\n\u001b[?2004l\r"]
[760.192543, "o", "\u001b[?2004h> "]
[760.19257, "o", "        M = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h"]
[760.192597, "o", "> "]
[760.192624, "o", "        x2 = x.view(M, N)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[760.19266, "o", "        y2 = torch.empty_like(x2)\r\n\u001b[?2004l\r"]
[760.192687, "o", "\u001b[?2004h> "]
[760.192719, "o", "        w = self.ln.weight.reshape(-1)\r\n\u001b[?2004l\r"]
[760.192745, "o", "\u001b[?2004h> "]
[760.192776, "o", "        b = self.ln.bias.reshape(-1)\r\n\u001b[?2004l\r"]
[760.192803, "o", "\u001b[?2004h> "]
[760.192831, "o", "        NSPLIT = N // _BLOCK\r\n\u001b[?2004l\r"]
[760.192858, "o", "\u001b[?2004h> "]
[760.192924, "o", "        ps = torch.empty((M, NSPLIT), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[760.192951, "o", "\u001b[?2004h> "]
[760.193023, "o", "        psq = torch.empty((M, NSPLIT), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[760.19305, "o", "\u001b[?2004h> "]
[760.193134, "o", "        _ln_partial[(NSPLIT, M)](x2, ps, psq, N, NSPLIT, BLOCK=_BLOCK, num_warps=_WARPS)\r\n\u001b[?2004l\r"]
[760.193163, "o", "\u001b[?2004h> "]
[760.193237, "o", "        _ln_apply[(NSPLIT * M,)](x2, ps, psq, w, b, y2, N, M, NSPLIT, self.eps,\r\n\u001b[?2004l\r"]
[760.193265, "o", "\u001b[?2004h> "]
[760.193365, "o", "                                 BLOCK=_BLOCK, NPOW=triton.next_power_of_2(NSPLIT), num_warps=_WARPS)\r\n\u001b[?2004l\r"]
[760.19339, "o", "\u001b[?2004h> "]
[760.193418, "o", "        return y2.view(x.shape)\r\n\u001b[?2004l\r"]
[760.193439, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[760.194837, "o", "\u001b[?2004hroot@modal:/# "]
