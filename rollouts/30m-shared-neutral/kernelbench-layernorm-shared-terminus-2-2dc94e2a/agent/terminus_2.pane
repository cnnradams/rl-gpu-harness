[?2004l[?2004h> _WARPS = 8
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> class ModelNew(nn.Module):
[?2004l[?2004h>     def __init__(self, normalized_shape: tuple):
[?2004l[?2004h>         super(ModelNew, self).__init__()
[?2004l[?2004h>         self.ln = nn.LayerNorm(normalized_shape=normalized_shape)
[?2004l[?2004h>         self.normalized_shape = tuple(normalized_shape)
[?2004l[?2004h>         self.eps = self.ln.eps
[?2004l[?2004h> 
