[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> import triton
[?2004l[?2004h> import triton.language as tl
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_partial(X, PS, PSQ, N: tl.constexpr, NSPLIT, BLOCK: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     row = tl.program_id(1)
[?2004l[?2004h>     base = row.to(tl.int64) * N
[?2004l[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     x = tl.load(X + base + offs)
