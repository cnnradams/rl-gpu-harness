[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> @triton.jit
[?2004l[?2004h> def _ln_apply(X, PS, PSQ, W, B, Y, N: tl.constexpr, M: tl.constexpr, NSPLIT, eps, BLOCK: tl.constexpr, NPOW: tl.constexpr):
[?2004l[?2004h>     pid = tl.program_id(0)
[?2004l[?2004h>     chunk = pid // M
[?2004l[?2004h>     row = pid % M
[?2004l[?2004h>     base = row.to(tl.int64) * N
[?2004l[?2004h>     offs2 = tl.arange(0, NPOW)
[?2004l[?2004h>     mask2 = offs2 < NSPLIT
[?2004l[?2004h>     ps = tl.load(PS + row * NSPLIT + offs2, mask=mask2, other=0.0)
[?2004l[?2004h>     psq = tl.load(PSQ + row * NSPLIT + offs2, mask=mask2, other=0.0)
[?2004l[?2004h>     mean = tl.sum(ps) / N
[?2004l[?2004h>     var = tl.sum(psq) / N - mean * mean
[?2004l[?2004h>     rstd = 1.0 / tl.sqrt(var + eps)
[?2004l[?2004h>     offs = chunk * BLOCK + tl.arange(0, BLOCK)
[?2004l[?2004h>     x = tl.load(X + base + offs)
