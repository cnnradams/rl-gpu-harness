dev = 'cuda'
x = torch.rand(16, 64, 256, 256, device=dev)
M, N = 16, 64*256*256
w = torch.rand(N, device=dev)
b = torch.rand(N, device=dev)
eps = 1e-5
x2 = x.view(M, N)

def run(BLOCK, warps):
    y2 = torch.empty_like(x2)
    NSPLIT = triton.cdiv(N, BLOCK)
    ps = torch.empty((M, NSPLIT), device=dev)
    psq = torch.empty((M, NSPLIT), device=dev)
    def fn(xx):
        _ln_partial[(NSPLIT, M)](xx, ps, psq, N, NSPLIT, BLOCK=BLOCK, num_warps=warps)
        _ln_apply[(NSPLIT, M)](xx, ps, psq, w, b, y2, N, NSPLIT, eps, BLOCK=BLOCK, NPOW=triton.next_power_of_2(NSPLIT), num_warps=warps)
        return y2
    times = time_execution_with_cuda_event(fn, [x2], num_warmup=3, num_trials=20, verbose=False, device=dev)
    return np.mean(times[1:])

for BLOCK in [2048, 4096, 8192, 16384]:
    for warps in [4, 8, 16, 32]:
        t = run(BLOCK, warps)
        print(f'BLOCK={BLOCK:6d} warps={warps:3d}: {t:.4f} ms')
