[1255.284135, "o", "        acc = tl.dot(ah, wl_, acc)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1255.284146, "o", "> "]
[1255.284175, "o", "        A_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284212, "o", "    bb = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284244, "o", "    c = (acc + bb[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284286, "o", "    tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1255.284301, "o", "\u001b[?2004h> "]
[1255.284328, "o", "out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
