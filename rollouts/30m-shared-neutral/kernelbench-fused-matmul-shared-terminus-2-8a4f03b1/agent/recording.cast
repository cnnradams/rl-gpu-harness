[563.129664, "o", "# ---------------- kernel C: all splits precomputed, pure fp16 loads ----------\r\n\u001b[?2004l\r\u001b[?2004h> @triton.autotune(configs=[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.12973, "o", "    triton.Config({'BM':128,'BN':128,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.129793, "o", "    triton.Config({'BM':128,'BN':256,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h"]
[563.129829, "o", "> "]
[563.129871, "o", "    triton.Config({'BM':256,'BN':128,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.129926, "o", "    triton.Config({'BM':128,'BN':128,'BK':128,'GROUP_M':8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.129991, "o", "    triton.Config({'BM':256,'BN':256,'BK':32,'GROUP_M':8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.13005, "o", "    triton.Config({'BM':128,'BN':256,'BK':32,'GROUP_M':8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130123, "o", "    triton.Config({'BM':64,'BN':256,'BK':128,'GROUP_M':8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130161, "o", "], key=['M','N','K'])\r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[563.130198, "o", "> def kC(Ah, Al, Wh, Wl, Bias, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[563.130214, "o", "\u001b[?2004h> "]
[563.130269, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130285, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[563.130317, "o", "\u001b[?2004h> "]
[563.13035, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h>     width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[563.130388, "o", "\u001b[?2004h>     group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130437, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130475, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[563.130508, "o", "\u001b[?2004h>     pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r"]
[563.130544, "o", "\u001b[?2004h>     rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[563.130579, "o", "\u001b[?2004h>     rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.13062, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130651, "o", "    Ah_ptr = Ah + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130688, "o", "    Al_ptr = Al + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130727, "o", "    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130767, "o", "    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130797, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[563.130814, "o", "\u001b[?2004h> "]
[563.130854, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r"]
[563.130901, "o", "\u001b[?2004h>         ah = tl.load(Ah_ptr); al = tl.load(Al_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130939, "o", "        wh = tl.load(Wh_ptr); wl = tl.load(Wl_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.130975, "o", "        acc = tl.dot(ah, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131008, "o", "        acc = tl.dot(al, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131044, "o", "        acc = tl.dot(ah, wl, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131059, "o", "        Ah_ptr += BK; Al_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\r\n\u001b[?2004l\r"]
[563.131094, "o", "\u001b[?2004h>     bb = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r"]
[563.13111, "o", "\u001b[?2004h> "]
[563.131147, "o", "    c = (acc + bb[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131184, "o", "    tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[563.13122, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_B():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131252, "o", "    wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r"]
[563.131269, "o", "\u001b[?2004h> "]
[563.131302, "o", "    out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131359, "o", "    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131398, "o", "    def f():\r\n\u001b[?2004l\r"]
[563.131435, "o", "\u001b[?2004h>         kB[grid](x, wh, wl, bias, out, M, N, K, scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131479, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h>     return f\r\n\u001b[?2004l\r"]
[563.131513, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_C():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131545, "o", "    xh = x.half(); xl = (x - xh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131578, "o", "    wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131615, "o", "    out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131647, "o", "    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r"]
[563.131668, "o", "\u001b[?2004h>     def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131717, "o", "        kC[grid](xh, xl, wh, wl, bias, out, M, N, K, scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131751, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h>     return f\r\n\u001b[?2004l\r"]
[563.13178, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_C_full():\r\n\u001b[?2004l\r\u001b[?2004h"]
[563.131817, "o", ">     # includes the split pass for x in timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.131857, "o", "    wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[563.131897, "o", ">     out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r"]
[563.131932, "o", "\u001b[?2004h> "]
[563.131967, "o", "    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132004, "o", "    def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.13204, "o", "        xh = x.half(); xl = (x - xh.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132081, "o", "        kC[grid](xh, xl, wh, wl, bias, out, M, N, K, scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132117, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h>     return f\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[563.132154, "o", "> def run_fp16():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132189, "o", "    xh = x.half(); wh = w.half()\r\n\u001b[?2004l\r\u001b[?2004h>     def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132228, "o", "        return torch.mm(xh, wh.t())\r\n\u001b[?2004l\r\u001b[?2004h>     return f\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[563.132245, "o", "\u001b[?2004h> "]
[563.132313, "o", "for name, mk in [('B', run_B), ('C', run_C), ('C+xsplit', run_C_full), ('fp16mm(nocheck)', run_fp16)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132349, "o", "    f = mk()\r\n\u001b[?2004l\r\u001b[?2004h>     o = f()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.13239, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132422, "o", "    if name != 'fp16mm(nocheck)':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132472, "o", "        err = (o - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132506, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h>         err = float('nan')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132552, "o", "    t = triton.testing.do_bench(f, warmup=25, rep=100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132587, "o", "    print(f'{name}: {t:.3f} ms  max_err={err:.3e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132604, "o", "    if name == 'B':\r\n\u001b[?2004l\r"]
[563.132628, "o", "\u001b[?2004h> "]
[563.13266, "o", "        print('  best B:', kB.best_config)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132695, "o", "    if name == 'C':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[563.132725, "o", "        print('  best C:', kC.best_config)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
