[814.37518, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.37522, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375251, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r"]
[814.375294, "o", "\u001b[?2004h>         self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375324, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r"]
[814.375353, "o", "\u001b[?2004h>         self._w_hi = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375382, "o", "        self._w_lo = None\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[814.375409, "o", "\u001b[?2004h>     def _splits(self, w):\r\n\u001b[?2004l\r"]
[814.375436, "o", "\u001b[?2004h> "]
[814.375462, "o", "        if (self._w_hi is None or self._w_hi.device != w.device\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.3755, "o", "                or self._w_hi.dtype != torch.float16):\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.375532, "o", ">             with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.375558, "o", "> "]
[814.375586, "o", "                wc = w.detach().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375614, "o", "                self._w_hi = wc.half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375652, "o", "                self._w_lo = (wc - self._w_hi.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375679, "o", "        return self._w_hi, self._w_lo\r\n\u001b[?2004l\r"]
[814.375705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375732, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375758, "o", "        scale = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375784, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375811, "o", "        b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375838, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375862, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375911, "o", "        if (x.is_cuda and x.dtype == torch.float32 and w.dtype == torch.float32\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.375937, "o", "> "]
[814.375965, "o", "                and M % 256 == 0 and N % 128 == 0 and K % 64 == 0):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.375994, "o", "            x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.376048, "o", "            w_hi, w_lo = self._splits(w)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.376074, "o", "> "]
[814.376098, "o", "            b = b.detach().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.376138, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.376165, "o", "> "]
[814.376208, "o", "            grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.376257, "o", "            _split_gemm[grid](x, w_hi, w_lo, b, out, M, N, K, scale)\r\n\u001b[?2004l\r\u001b[?2004h"]
[814.376286, "o", ">             return out\r\n\u001b[?2004l\r"]
[814.376312, "o", "\u001b[?2004h> "]
[814.376341, "o", "        return torch.addmm(b * scale, x, w.t() * scale)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[814.378793, "o", "\u001b[?2004hroot@modal:/# "]
