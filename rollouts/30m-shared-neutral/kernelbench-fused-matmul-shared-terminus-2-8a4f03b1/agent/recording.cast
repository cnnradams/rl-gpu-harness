[1255.284467, "o", "    (256,128,32,3,8,8), (256,128,32,4,8,8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284518, "o", "    (128,256,32,3,8,8), (128,256,32,4,8,8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284537, "o", "    (256,64,64,3,8,8), (256,64,64,4,8,8),\r\n\u001b[?2004l\r"]
[1255.284548, "o", "\u001b[?2004h> "]
[1255.28458, "o", "    (64,256,64,3,8,8), (128,128,64,3,8,8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284619, "o", "    (256,128,64,2,8,8), (256,128,128,3,8,8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
