[963.692611, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r"]
[963.692625, "o", "\u001b[?2004h> "]
[963.692667, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.692677, "o", "> "]
[963.692708, "o", "    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.692719, "o", "> "]
[963.692753, "o", "    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.692763, "o", "> "]
[963.692796, "o", "    acc1 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.692829, "o", "    acc2 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r"]
[963.692838, "o", "\u001b[?2004h"]
[963.692853, "o", "> "]
[963.692884, "o", "    acc3 = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.692922, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.692947, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.692976, "o", "        wh_ = tl.load(Wh_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693006, "o", "        wl_ = tl.load(Wl_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693037, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693082, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693114, "o", "        acc1 = tl.dot(ah, wh_, acc1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693141, "o", "        acc2 = tl.dot(al, wh_, acc2)\r\n\u001b[?2004l\r"]
[963.693151, "o", "\u001b[?2004h> "]
[963.693172, "o", "        acc3 = tl.dot(ah, wl_, acc3)\r\n\u001b[?2004l\r"]
[963.693183, "o", "\u001b[?2004h> "]
[963.693212, "o", "        A_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\r\n\u001b[?2004l\r"]
[963.693221, "o", "\u001b[?2004h> "]
[963.693238, "o", "    acc = acc1 + acc2 + acc3\r\n\u001b[?2004l\r"]
[963.693248, "o", "\u001b[?2004h> "]
[963.693275, "o", "    bb = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.693285, "o", "> "]
[963.693305, "o", "    c = (acc + bb[None, :]) * scale\r\n\u001b[?2004l\r"]
[963.693314, "o", "\u001b[?2004h> "]
[963.693343, "o", "    tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\u001b[?2004l\r"]
[963.693353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693391, "o", "out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[963.693403, "o", "\u001b[?2004h> "]
[963.693417, "o", "configs = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.693425, "o", "> "]
[963.693453, "o", "    (256, 128, 64, 3, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693484, "o", "    (256, 128, 64, 4, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693516, "o", "    (256, 256, 64, 3, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.69353, "o", "> "]
[963.69354, "o", "    (128, 256, 64, 4, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693573, "o", "    (256, 128, 64, 3, 8, 2),\r\n\u001b[?2004l\r"]
[963.693585, "o", "\u001b[?2004h> "]
[963.693604, "o", "    (128, 256, 64, 3, 8, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693635, "o", "    (256, 128, 128, 3, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693705, "o", "    (128, 128, 64, 4, 8, 1),\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693717, "o", "for (BM, BN, BK, ns, nw, nc) in configs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.69375, "o", "> "]
[963.693764, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693786, "o", "    def f():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693823, "o", "        kD[grid](x, wh, wl, bias, out, M, N, K, scale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693873, "o", "                 BM=BM, BN=BN, BK=BK, GROUP_M=8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693917, "o", "                 num_stages=ns, num_warps=nw, num_ctas=nc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693953, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.693985, "o", "        o = f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.694021, "o", "        err = (o - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.694069, "o", "        t = triton.testing.do_bench(f, warmup=25, rep=100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[963.694115, "o", "        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw} c{nc}: {t:.3f} ms err={err:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[963.694119, "o", "> "]
[963.694143, "o", "    except Exception as e:\r\n\u001b[?2004l\r"]
[963.694149, "o", "\u001b[?2004h> "]
[963.694217, "o", "        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw} c{nc}: FAILED {type(e).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[963.69597, "o", "\u001b[?2004hroot@modal:/# "]
