[1268.451073, "o", "BM256 BN128 BK64 s3 w8 g8: 2.796 ms err=4.63e-05\r\nBM256 BN128 BK64 s3 w8 g4: 2.946 ms err=4.63e-05\r\nBM256 BN128 BK64 s3 w8 g16: 2.957 ms err=4.63e-05\r\nBM256 BN128 BK32 s3 w8 g8: 3.199 ms err=4.63e-05\r\nBM256 BN128 BK32 s4 w8 g8: 3.142 ms err=4.63e-05\r\nBM128 BN256 BK32 s3 w8 g8: 3.101 ms err=4.63e-05\r\nBM128 BN256 BK32 s4 w8 g8: 3.091 ms err=4.63e-05\r\nBM256 BN64 BK64 s3 w8 g8: 3.794 ms err=4.63e-05\r\nBM256 BN64 BK64 s4 w8 g8: FAILED OutOfResources\r\nBM64 BN256 BK64 s3 w8 g8: 14.091 ms err=4.63e-05\r\nBM128 BN128 BK64 s3 w8 g8: 3.053 ms err=4.63e-05\r\nBM256 BN128 BK64 s2 w8 g8: 3.514 ms err=4.63e-05\r\nBM256 BN128 BK128 s3 w8 g8: FAILED OutOfResources\r\nBEST: (2.7964758411530526, (256, 128, 64, 3, 8, 8))\r\n"]
