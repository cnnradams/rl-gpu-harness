[731.393494, "i", "cat > /workspace/bench2.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nM, N, K = 16384, 4096, 4096\nscale = 1.5\n\n@triton.jit\ndef split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    offs = pid * BLOCK + tl.arange(0, BLOCK)\n    x = tl.load(X + offs)\n    h = x.to(tl.float16)\n    l = (x - h.to(tl.float32)).to(tl.float16)\n    tl.store(Hi + offs, h)\n    tl.store(Lo + offs, l)\n\ndef split_x(x):\n    xh = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    xl = torch.empty(x.shape, device=x.device, dtype=torch.float16)\n    n = x.numel()\n    split_kernel[(n // 4096,)](x, xh, xl, n, BLOCK=4096)\n    return xh, xl\n\n@triton.autotune(configs=[\n    triton.Config({'BM':128,'BN':256,'BK':32,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':64,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':256,'BN':256,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':128,'GROUP_M':8}, num_stages=3, n"]
[731.3943, "o", "cat > /workspace/bench2.py << 'EOF'\r\n"]
[731.394484, "i", "um_warps=8),\n    triton.Config({'BM':256,'BN':128,'BK':128,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':128,'BK':128,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':256,'BN':256,'BK':32,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':64,'BN':256,'BK':128,'GROUP_M':8}, num_stages=4, num_warps=4),\n], key=['M','N','K'])\n@triton.jit\ndef kC(Ah, Al, Wh, Wl, Bias, C, M, N, K, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ah_ptr = Ah + rm[:, None] * K + rk[None, :]\n    Al_ptr = Al + rm[:, None] * K + rk[None, :]"]
[731.394519, "o", "\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> scale = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def split_kernel(X, Hi, Lo, numel, BLOCK: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     offs = pid * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h>     x = tl.load(X + offs)\r\n\u001b[?2004l\r\u001b[?2004h>     h = x.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h>     l = (x - h.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(Hi + offs, h)\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(Lo + offs, l)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def split_x(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.394547, "i", "\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(Ah_ptr); al = tl.load(Al_ptr)\n        wh = tl.load(Wh_ptr); wl = tl.load(Wl_ptr)\n        acc = tl.dot(ah, wh, acc)\n        acc = tl.dot(al, wh, acc)\n        acc = tl.dot(ah, wl, acc)\n        Ah_ptr += BK; Al_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\n    bb = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bb[None, :]) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\n@triton.autotune(configs=[\n    triton.Config({'BM':256,'BN':128,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':256,'BN':128,'BK':64,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':256,'BN':128,'BK':128,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':64,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':256,'BN':256,'BK':64,'GROUP_M':8}, num_stages=3, num"]
