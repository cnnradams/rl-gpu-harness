[814.372567, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _split_gemm(A, Wh, Wl, Bias, C, M, N, K, scale,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid"]
[814.372821, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r"]
[814.372846, "i", " % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        wh = tl.load(Wh_ptr)\n        wl = tl.load(Wl_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, wh, acc)\n        acc = tl.dot(a_lo, wh, acc)\n        acc = tl.dot(a_hi, wl, acc)\n        A_ptr += BK\n        Wh_ptr += BK\n        Wl_ptr += BK\n    bias = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bias[None, :]) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\n\nclass ModelNew(nn.Module):\n    \"\"\"out = (x @ W^T + b) * (1 + scaling_factor).\n\n    GEMM is computed on tensor cores with the Ootomo-style fp16-split\n    trick: x = x_hi + x_lo and W = W_hi + W_lo ("]
[814.372857, "o", "\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[814.374725, "i", "exact decomposition),\n    out ~= x_hi@W_hi + x_lo@W_hi + x_hi@W_lo accumulated in fp32.\n    The dropped x_lo@W_lo term is O(2^-22) relative, well below fp32\n    matmul rounding noise. The residual add + scale are folded into\n    the epilogue ((acc + b) * (1 + scaling_factor)).\n    \"\"\"\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n        self._w_hi = None\n        self._w_lo = None\n\n    def _splits(self, w):\n        if (self._w_hi is None or self._w_hi.device != w.device\n                or self._w_hi.dtype != torch.float16):\n            with torch.no_grad():\n                wc = w.detach().contiguous()\n                self._w_hi = wc.half()\n                self._w_lo = (wc - self._w_hi.float()).half()\n        return self._w_hi, self._w_lo\n\n    def forward(self, x):\n        scale = 1.0 + float(self.scaling_factor)\n        w = self.matmul.weight\n  "]
[814.374892, "o", "import torch.nn as nn\r\n\u001b[?2004l\r % width) // group_size\r\n\r\n    rm = pid_m * BM + tl.arange(0, BM)\r\n    rn = pid_n * BN + tl.arange(0, BN)\r\n    rk = tl.arange(0, BK)\r\n    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\r\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\r\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n    for k in range(0, K, BK):\r\n        a = tl.load(A_ptr)\r\n        wh = tl.load(Wh_ptr)\r\n        wl = tl.load(Wl_ptr)\r\n        a_hi = a.to(tl.float16)\r\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n        acc = tl.dot(a_hi, wh, acc)\r\n        acc = tl.dot(a_lo, wh, acc)\r\n        acc = tl.dot(a_hi, wl, acc)\r\n        A_ptr += BK\r\n        Wh_ptr += BK\r\n        Wl_ptr += BK\r\n    bias = tl.load(Bias + rn).to(tl.float32)\r\n    c = (acc + bias[None, :]) * scale\r\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\r\n\r\nclass ModelNew(nn.Module):\r\n    \"\"\"out = (x @ W^T + b) * (1 + scaling_factor).\r\n\r\n    GEMM is computed on tensor cores with the Ootomo-styl"]
[814.374933, "i", "      b = self.matmul.bias\n        M, K = x.shape\n        N = w.shape[0]\n        if (x.is_cuda and x.dtype == torch.float32 and w.dtype == torch.float32\n                and M % 256 == 0 and N % 128 == 0 and K % 64 == 0):\n            x = x.contiguous()\n            w_hi, w_lo = self._splits(w)\n            b = b.detach().contiguous()\n            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n            grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n            _split_gemm[grid](x, w_hi, w_lo, b, out, M, N, K, scale)\n            return out\n        return torch.addmm(b * scale, x, w.t() * scale)\nEOF\n"]
[814.374963, "o", "e fp16-split\r\n    trick: x = x_hi + x_lo and W = W_hi + W_lo (\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.autotune(\r\n\u001b[?2004l\r\u001b[?2004h>     configs=[\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 256, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 128, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h>     key=['M', 'N', 'K'],\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def _split_gemm(A, Wh, Wl, Bias, C, M, N, K, scale,\r\n\u001b[?2004l\r\u001b[?2004h>                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?20"]
[814.375007, "o", "04h>                 GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h>     grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h>     width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h>     group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h>     pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h>     rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h>     rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h>     A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h>     Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h>     Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h>     acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h>     for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004"]
[814.375046, "o", "h>         a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h>         wh = tl.load(Wh_ptr)\r\n\u001b[?2004l\r\u001b[?2004h>         wl = tl.load(Wl_ptr)\r\n\u001b[?2004l\r\u001b[?2004h>         a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h>         a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h>         acc = tl.dot(a_hi, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h>         acc = tl.dot(a_lo, wh, acc)\r\n\u001b[?2004l\r\u001b[?2004h>         acc = tl.dot(a_hi, wl, acc)\r\n\u001b[?2004l\r\u001b[?2004h>         A_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h>         Wh_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h>         Wl_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h>     bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h>     c = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"out = (x @ W^T + b) * (1 + scaling_factor).\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     GEMM is computed on tensor cores with the Ootomo-style fp16-split\r\n\u001b[?2004l\r\u001b[?"]
