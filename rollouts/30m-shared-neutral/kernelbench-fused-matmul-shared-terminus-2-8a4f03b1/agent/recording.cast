[1336.28961, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1336.289635, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1336.290175, "o", "        scale = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h>         w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h>         b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h>         M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h>         N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h>         if (x.is_cuda and x.dtype == torch.float32 and w.dtype == torch.float32\r\n\u001b[?2004l\r\u001b[?2004h>                 and M % 256 == 0 and N % 128 == 0 and K % 64 == 0):\r\n\u001b[?2004l\r\u001b[?2004h>             x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h>             w_hi, w_lo = self._splits(w)\r\n\u001b[?2004l\r\u001b[?2004h>             b = b.detach().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h>             out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h>             grid = (triton.cdiv(M, 256) * triton.cdiv(N, 128),)\r\n\u001b[?2004l\r\u001b[?2004h>             _split_gemm[grid](x, w_hi, w_lo, b, out, M, N, K, scale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1336.290321, "o", "                              BM=256, BN=128, BK=64, GROUP_M=8,\r\n\u001b[?2004l\r\u001b[?2004h>                               num_stages=3, num_warps=8)\r\n\u001b[?2004l\r\u001b[?2004h>             return out\r\n\u001b[?2004l\r\u001b[?2004h>         return torch.addmm(b * scale, x, w.t() * scale)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
