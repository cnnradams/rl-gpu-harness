[327.642471, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport triton\nimport triton.language as tl\n\n\n@triton.autotune(\n    configs=[\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_stages=4, num_warps=8),\n        triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\n        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=4),\n    ],\n    key=['M', 'N', 'K'],\n)\n@triton.jit\ndef _split_gemm(A, W, Bias, C, M, N, K, scale,\n                BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\n                GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM)\n    grid_n = tl.cdiv(N, BN)\n  "]
[327.643245, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import triton\r\n\u001b[?2004l\r\u001b[?2004h> import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.autotune(\r\n\u001b[?2004l\r\u001b[?2004h>     configs=[\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 128, 'BN': 128, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 128, 'BN': 256, 'BK': 32, 'GROUP_M': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 256, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 128, 'BN': 128, 'BK': 32, 'GROUP_M': 8}, num_stages=4, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h>         triton.Config({'BM': 64, 'BN': 256, 'BK': 64, 'GROUP_M': 8}, num_stages=3, num_warps=8),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.643707, "i", "  width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    W_ptr = W + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        w = tl.load(W_ptr)\n        a_hi = a.to(tl.float16)\n        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\n        w_hi = w.to(tl.float16)\n        w_lo = (w - w_hi.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(a_hi, w_hi, acc)\n        acc = tl.dot(a_lo, w_hi, acc)\n        acc = tl.dot(a_hi, w_lo, acc)\n        A_ptr += BK\n        W_ptr += BK\n    bias = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bias[None, :]) * scale\n    C_ptr = C + rm[:, None] * N + rn[None, :]\n    tl.store(C_ptr, c)\n\n"]
[327.643781, "o", "        triton.Config({'BM': 128, 'BN': 64, 'BK': 64, 'GROUP_M': 8}, num_stages=4, num_warps=4),\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h>     key=['M', 'N', 'K'],\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> def _split_gemm(A, W, Bias, C, M, N, K, scale,\r\n\u001b[?2004l\r\u001b[?2004h>                 BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h>                 GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h>     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h>     grid_m = tl.cdiv(M, BM)\r\n\u001b[?2004l\r\u001b[?2004h>     grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h>     width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h>     group_id = pid // width\r\n\u001b[?2004l\r"]
[327.64382, "i", "\nclass ModelNew(nn.Module):\n    \"\"\"out = (x @ W^T + b) * (1 + scaling_factor) computed with an\n    fp16-split tensor-core GEMM (fp32-level accuracy).\"\"\"\n\n    def __init__(self, in_features, out_features, scaling_factor):\n        super(ModelNew, self).__init__()\n        self.matmul = nn.Linear(in_features, out_features)\n        self.scaling_factor = scaling_factor\n\n    def forward(self, x):\n        scale = 1.0 + float(self.scaling_factor)\n        w = self.matmul.weight\n        b = self.matmul.bias\n        M, K = x.shape\n        N = w.shape[0]\n        if (x.is_cuda and x.dtype == torch.float32\n                and M % 256 == 0 and N % 256 == 0 and K % 64 == 0):\n            x = x.contiguous()\n            w = w.contiguous()\n            b = b.contiguous()\n            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\n            grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n            _split_gemm[grid](x, w, b, out, M, N, K, scale)\n            return out\n        return"]
[327.643868, "o", "\u001b[?2004h>     group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h>     pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[327.643906, "i", " torch.addmm(b * scale, x, w.t() * scale)\nEOF\n"]
[327.643939, "o", "\u001b[?2004h>     pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.64397, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h>     rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644003, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644053, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h>     W_ptr = W + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[327.644071, "o", "\u001b[?2004h> "]
[327.644101, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644132, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644158, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644212, "o", "        w = tl.load(W_ptr)\r\n\u001b[?2004l\r\u001b[?2004h>         a_hi = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644253, "o", "        a_lo = (a - a_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644285, "o", "        w_hi = w.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644326, "o", "        w_lo = (w - w_hi.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644342, "o", "        acc = tl.dot(a_hi, w_hi, acc)\r\n\u001b[?2004l\r"]
[327.644376, "o", "\u001b[?2004h>         acc = tl.dot(a_lo, w_hi, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644418, "o", "        acc = tl.dot(a_hi, w_lo, acc)\r\n\u001b[?2004l\r\u001b[?2004h>         A_ptr += BK\r\n\u001b[?2004l\r"]
[327.644449, "o", "\u001b[?2004h>         W_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644484, "o", "    bias = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644518, "o", "    c = (acc + bias[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644561, "o", "    C_ptr = C + rm[:, None] * N + rn[None, :]\r\n\u001b[?2004l\r\u001b[?2004h>     tl.store(C_ptr, c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[327.644614, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.64467, "o", "    \"\"\"out = (x @ W^T + b) * (1 + scaling_factor) computed with an\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644713, "o", "    fp16-split tensor-core GEMM (fp32-level accuracy).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644778, "o", "    def __init__(self, in_features, out_features, scaling_factor):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644794, "o", "        super(ModelNew, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644839, "o", "        self.matmul = nn.Linear(in_features, out_features)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644871, "o", "        self.scaling_factor = scaling_factor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[327.644908, "o", "\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.64495, "o", "        scale = 1.0 + float(self.scaling_factor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.644985, "o", "        w = self.matmul.weight\r\n\u001b[?2004l\r\u001b[?2004h>         b = self.matmul.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.64502, "o", "        M, K = x.shape\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645048, "o", "        N = w.shape[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645081, "o", "        if (x.is_cuda and x.dtype == torch.float32\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645125, "o", "                and M % 256 == 0 and N % 256 == 0 and K % 64 == 0):\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.645155, "o", ">             x = x.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645197, "o", "            w = w.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645231, "o", "            b = b.contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645262, "o", "            out = torch.empty((M, N), device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645322, "o", "            grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r"]
[327.645351, "o", "\u001b[?2004h> "]
[327.645388, "o", "            _split_gemm[grid](x, w, b, out, M, N, K, scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645422, "o", "            return out\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.645457, "o", "        return torch.addmm(b * scale, x, w.t() * scale)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
