[1038.482795, "i", "cat > /workspace/bench4.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nM, N, K = 16384, 4096, 4096\nscale = 1.5\nbound = 1/64\ntorch.manual_seed(123)\nw = ((torch.rand(N, K, device='cuda') * 2 - 1) * bound)\nbias = ((torch.rand(N, device='cuda') * 2 - 1) * bound)\nx = torch.rand(M, K, device='cuda')\nref = (torch.nn.functional.linear(x, w, bias)) * scale\n\nwh = w.half(); wl = (w - wh.float()).half()\nqh = (wh.float() * 2048.0 + wl.float()).half()\nbs = (bias * scale).contiguous()\nwl32 = wl.float().contiguous()\nwh32 = wh.float().contiguous()\n\n@triton.jit\ndef kB(A, Wh, Wl, Bias, C, M, N, K, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n  "]
[1038.482946, "i", "  rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        wh_ = tl.load(Wh_ptr)\n        wl_ = tl.load(Wl_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah, wh_, acc)\n        acc = tl.dot(al, wh_, acc)\n        acc = tl.dot(ah, wl_, acc)\n        A_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\n    bb = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bb[None, :]) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\n@triton.jit\ndef kE(A, Qh, Wl, Wl32, Wh32, BiasS, C, M, N, K, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width"]
[1038.482955, "i", "\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    Qh_ptr = Qh + rn[None, :] * K + rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        qh_ = tl.load(Qh_ptr)\n        wl_ = tl.load(Wl_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        ph = (ah.float() * 2048.0 + al.float()).to(tl.float16)\n        acc = tl.dot(ph, qh_, acc)\n        acc = tl.dot(ah, wl_, acc)\n        A_ptr += BK; Qh_ptr += BK; Wl_ptr += BK\n    acc = acc * (1.0 / 2048.0)\n    a_ = tl.load(A + rm[:, None] * K + rk[None, :])\n    w32 = tl.load(Wl32 + rn[None, :] * K + rk[:, None])\n    lolo = tl.sum(a_[:, :, None] * w32[None, :, :], 1"]
[1038.482961, "i", ")\n    c = (acc - lolo + tl.load(BiasS + rn)[None, :].to(tl.float32)) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\n@triton.jit\ndef k1(A, Wh, C, M, N, K,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        wh_ = tl.load(Wh_ptr)\n        acc = tl.dot(a.to(tl.float16), wh_, acc)\n        A_ptr += BK; Wh_ptr += BK\n    tl.store(C + rm[:, None] * N + rn[None, :], acc)\n\nout = to"]
[1038.482966, "i", "rch.empty(M, N, device='cuda')\n\nprint('--- 1-dot (lower bound per dot) ---')\nfor (BM, BN, BK, ns, nw) in [(128,128,64,4,8), (128,256,64,4,8), (256,128,64,3,8), (128,256,64,3,8)]:\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        k1[grid](x, wh, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_stages=ns, num_warps=nw)\n        return out\n    try:\n        f(); torch.cuda.synchronize()\n        t = triton.testing.do_bench(f, warmup=25, rep=100)\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw}: {t:.3f} ms')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw}: FAILED {type(e).__name__}')\n\nprint('--- 3-dot kB ---')\nfor (BM, BN, BK, ns, nw) in [(256,128,64,3,8), (128,256,64,4,8), (128,128,64,4,8)]:\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        kB[grid](x, wh, wl, bias, out, M, N, K, scale, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_stages=ns, num_warps=nw)\n        return out\n    try:\n        o = f(); torch.cuda.synchronize()\n        err = (o - re"]
[1038.482977, "i", "f).abs().max().item()\n        t = triton.testing.do_bench(f, warmup=25, rep=100)\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw}: {t:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw}: FAILED {type(e).__name__}')\n\nprint('--- 2-dot exact kE ---')\nfor (BM, BN, BK, ns, nw) in [(256,128,64,3,8), (128,256,64,4,8), (128,128,64,4,8), (128,128,64,3,8), (128,256,64,3,8)]:\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f():\n        kE[grid](x, qh, wl, wl32, wh32, bs, out, M, N, K, scale, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_stages=ns, num_warps=nw)\n        return out\n    try:\n        o = f(); torch.cuda.synchronize()\n        err = (o - ref).abs().max().item()\n        t = triton.testing.do_bench(f, warmup=25, rep=100)\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw}: {t:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw}: FAILED {type(e).__name__} {e}')\nEOF\ngpu push sb-EcFwpRfsMncuRRV6OJvZKW /workspace/bench4."]
[1038.483177, "o", "cat > /workspace/bench4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r\u001b[?2004h> scale = 1.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.483244, "i", "py /workspace/bench4.py && gpu exec sb-EcFwpRfsMncuRRV6OJvZKW -- python3 /workspace/bench4.py\n"]
[1038.483264, "o", "bound = 1/64\r\n\u001b[?2004l\r\u001b[?2004h> torch.manual_seed(123)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.483328, "o", "w = ((torch.rand(N, K, device='cuda') * 2 - 1) * bound)\r\n\u001b[?2004l\r"]
[1038.483377, "o", "\u001b[?2004h> "]
[1038.483447, "o", "bias = ((torch.rand(N, device='cuda') * 2 - 1) * bound)\r\n\u001b[?2004l\r"]
[1038.483484, "o", "\u001b[?2004h> "]
[1038.483516, "o", "x = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r"]
[1038.483555, "o", "\u001b[?2004h> "]
[1038.483608, "o", "ref = (torch.nn.functional.linear(x, w, bias)) * scale\r\n\u001b[?2004l\r"]
[1038.483646, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.483698, "o", "wh = w.half(); wl = (w - wh.float()).half()\r\n\u001b[?2004l\r"]
[1038.483736, "o", "\u001b[?2004h> "]
[1038.483787, "o", "qh = (wh.float() * 2048.0 + wl.float()).half()\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.483826, "o", "> bs = (bias * scale).contiguous()\r\n\u001b[?2004l\r"]
[1038.483863, "o", "\u001b[?2004h> "]
[1038.483901, "o", "wl32 = wl.float().contiguous()\r\n\u001b[?2004l\r"]
[1038.48394, "o", "\u001b[?2004h> wh32 = wh.float().contiguous()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rc"]
[1038.483976, "o", "\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1038.484012, "o", "\u001b[?2004h> "]
[1038.484048, "o", "def kB(A, Wh, Wl, Bias, C, M, N, K, scale,\r\n\u001b[?2004l\r"]
[1038.484083, "o", "\u001b[?2004h> "]
[1038.484182, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r"]
[1038.484224, "o", "\u001b[?2004h> "]
[1038.48426, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.484327, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r"]
[1038.484372, "o", "\u001b[?2004h> "]
[1038.484409, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.484444, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.484559, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r"]
[1038.484577, "o", "\u001b[?2004h> "]
[1038.484653, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r"]
[1038.484688, "o", "\u001b[?2004h> "]
[1038.484727, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\rh"]
[1038.484764, "o", "\u001b[?2004h> "]
[1038.484804, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r"]
[1038.48484, "o", "\u001b[?2004h> "]
[1038.484876, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\ri\u001b[?2004h> "]
[1038.48492, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\ra"]
[1038.484955, "o", "\u001b[?2004h> "]
[1038.485002, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r"]
[1038.485038, "o", "\u001b[?2004h> "]
[1038.485083, "o", "    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[1038.485119, "o", "\u001b[?2004h> "]
[1038.485171, "o", "    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.485206, "o", "> "]
[1038.485248, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n"]
[1038.485284, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1038.485321, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\rt e\u001b[?2004h> "]
[1038.485371, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r \u001b[?2004h> "]
[1038.485407, "o", "        wh_ = tl.load(Wh_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.485451, "o", "        wl_ = tl.load(Wl_ptr)\r\n\u001b[?2004l\r8"]
[1038.485905, "o", "\u001b[?2004h> "]
[1038.486019, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h>         al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486066, "o", "        acc = tl.dot(ah, wh_, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486113, "o", "        acc = tl.dot(al, wh_, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486168, "o", "        acc = tl.dot(ah, wl_, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486223, "o", "        A_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48628, "o", "    bb = tl.load(Bias + rn).to(tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48632, "o", "    c = (acc + bb[None, :]) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48639, "o", "    tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1038.486405, "o", "t\u001b[?2004h> "]
[1038.486425, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.486436, "o", "> "]
[1038.486498, "o", "def kE(A, Qh, Wl, Wl32, Wh32, BiasS, C, M, N, K, scale,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486603, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486643, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486716, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486757, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r"]
[1038.486794, "o", "\u001b[?2004h> "]
[1038.486822, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486909, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486952, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.486988, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487019, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487054, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487082, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487119, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48716, "o", "    Qh_ptr = Qh + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487196, "o", "    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487239, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487267, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487295, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487321, "o", "        qh_ = tl.load(Qh_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48736, "o", "        wl_ = tl.load(Wl_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487414, "o", "        ah = a.to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487433, "o", "        al = (a - ah.to(tl.float32)).to(tl.float16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48747, "o", "        ph = (ah.float() * 2048.0 + al.float()).to(tl.float16)\r\n\u001b[?2004l\r"]
[1038.487482, "o", "\u001b[?2004h> "]
[1038.487516, "o", "        acc = tl.dot(ph, qh_, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487546, "o", "        acc = tl.dot(ah, wl_, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487587, "o", "        A_ptr += BK; Qh_ptr += BK; Wl_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487615, "o", "    acc = acc * (1.0 / 2048.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487657, "o", "    a_ = tl.load(A + rm[:, None] * K + rk[None, :])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.4877, "o", "    w32 = tl.load(Wl32 + rn[None, :] * K + rk[:, None])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487744, "o", "    lolo = tl.sum(a_[:, :, None] * w32[None, :, :], 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487797, "o", "    c = (acc - lolo + tl.load(BiasS + rn)[None, :].to(tl.float32)) * scale\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487839, "o", "    tl.store(C + rm[:, None] * N + rn[None, :], c)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1038.487853, "o", "\u001b[?2004h> @triton.jit\r\n"]
[1038.487865, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[1038.487892, "o", "def k1(A, Wh, C, M, N, K,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48795, "o", "       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.487976, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488018, "o", "    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488045, "o", "    width = GROUP_M * grid_n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488074, "o", "    group_id = pid // width\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488126, "o", "    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488166, "o", "    pid_m = group_id * GROUP_M + (pid % group_size)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488201, "o", "    pid_n = (pid % width) // group_size\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488233, "o", "    rm = pid_m * BM + tl.arange(0, BM)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488268, "o", "    rn = pid_n * BN + tl.arange(0, BN)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488293, "o", "    rk = tl.arange(0, BK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488331, "o", "    A_ptr = A + rm[:, None] * K + rk[None, :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488376, "o", "    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\r\n\u001b[?2004l\r"]
[1038.488386, "o", "\u001b[?2004h> "]
[1038.488425, "o", "    acc = tl.zeros((BM, BN), dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488451, "o", "    for k in range(0, K, BK):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488478, "o", "        a = tl.load(A_ptr)\r\n\u001b[?2004l\r"]
[1038.488499, "o", "\u001b[?2004h> "]
[1038.48852, "o", "        wh_ = tl.load(Wh_ptr)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.48856, "o", "        acc = tl.dot(a.to(tl.float16), wh_, acc)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488592, "o", "        A_ptr += BK; Wh_ptr += BK\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488634, "o", "    tl.store(C + rm[:, None] * N + rn[None, :], acc)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1038.488644, "o", "\u001b[?2004h> "]
[1038.488679, "o", "out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1038.48869, "o", "\u001b[?2004h> "]
[1038.488723, "o", "print('--- 1-dot (lower bound per dot) ---')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488794, "o", "for (BM, BN, BK, ns, nw) in [(128,128,64,4,8), (128,256,64,4,8), (256,128,64,3,8), (128,256,64,3,8)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488836, "o", "    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488848, "o", "    def f():\r\n\u001b[?2004l\r"]
[1038.488858, "o", "\u001b[?2004h> "]
[1038.488924, "o", "        k1[grid](x, wh, out, M, N, K, BM=BM, BN=BN, BK=BK, GROUP_M=8, num_stages=ns, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1038.488946, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[1038.488958, "o", ">     try:\r\n\u001b[?2004l\r"]
[1038.488971, "o", "\u001b[?2004h> "]
[1038.489, "o", "        f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
