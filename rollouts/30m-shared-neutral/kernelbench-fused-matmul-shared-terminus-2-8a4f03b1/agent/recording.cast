[731.400421, "o", "def runB():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400457, "o", "    out = torch.empty(M, N, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400519, "o", "    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400537, "o", "> "]
[731.400546, "o", "    def f(x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400557, "o", "> "]
[731.400596, "o", "        kB[grid](x, wh, wl, bs, out, M, N, K, scale)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400623, "o", "        return out\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400655, "o", ">     return f\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400676, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400701, "o", "w, bias = setup()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400728, "o", "torch.manual_seed(999)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400744, "o", "> "]
[731.400768, "o", "x0 = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.40078, "o", "> "]
[731.400818, "o", "ref0 = (torch.nn.functional.linear(x0, w, bias)) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400829, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400874, "o", "for name, mk in [('C+fusedsplit', runC), ('B', runB)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.4009, "o", "    f = mk()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.400934, "o", "    o = f(x0); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.400947, "o", "> "]
[731.400978, "o", "    err = (o - ref0).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401033, "o", "    t = triton.testing.do_bench(lambda: f(x0), warmup=25, rep=100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401078, "o", "    print(f'{name}: {t:.3f} ms  max_err={err:.3e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401135, "o", "    print('  best:', (kC if name.startswith('C') else kB).best_config)\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.401148, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401186, "o", "# error stability across inputs for winner\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401215, "o", "f = runC()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401227, "o", "worst = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.401237, "o", "> "]
[731.401261, "o", "for i in range(10):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401292, "o", "    torch.manual_seed(2000 + i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401331, "o", "    xi = torch.rand(M, K, device='cuda')\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.401345, "o", "> "]
[731.401382, "o", "    refi = (torch.nn.functional.linear(xi, w, bias)) * scale\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.401395, "o", "> "]
[731.401427, "o", "    oi = f(xi); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401466, "o", "    e = (oi - refi).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[731.401481, "o", "> "]
[731.401504, "o", "    worst = max(worst, e)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401548, "o", "print(f'C worst err over 10 inputs: {worst:.3e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[731.401561, "o", "EOF\r\n\u001b[?2004l\r"]
[731.403768, "o", "\u001b[?2004hroot@modal:/# "]
