[731.3949, "i", "div(N, meta['BN']),)\n    def f(x):\n        kB[grid](x, wh, wl, bs, out, M, N, K, scale)\n        return out\n    return f\n\nw, bias = setup()\ntorch.manual_seed(999)\nx0 = torch.rand(M, K, device='cuda')\nref0 = (torch.nn.functional.linear(x0, w, bias)) * scale\n\nfor name, mk in [('C+fusedsplit', runC), ('B', runB)]:\n    f = mk()\n    o = f(x0); torch.cuda.synchronize()\n    err = (o - ref0).abs().max().item()\n    t = triton.testing.do_bench(lambda: f(x0), warmup=25, rep=100)\n    print(f'{name}: {t:.3f} ms  max_err={err:.3e}')\n    print('  best:', (kC if name.startswith('C') else kB).best_config)\n\n# error stability across inputs for winner\nf = runC()\nworst = 0.0\nfor i in range(10):\n    torch.manual_seed(2000 + i)\n    xi = torch.rand(M, K, device='cuda')\n    refi = (torch.nn.functional.linear(xi, w, bias)) * scale\n    oi = f(xi); torch.cuda.synchronize()\n    e = (oi - refi).abs().max().item()\n    worst = max(worst, e)\nprint(f'C worst err over 10 inputs: {worst:.3e}')\nEOF\n"]
