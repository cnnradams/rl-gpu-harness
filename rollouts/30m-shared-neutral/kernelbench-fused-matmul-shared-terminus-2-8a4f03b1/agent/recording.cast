[563.126225, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nM, N, K = 16384, 4096, 4096\ntorch.manual_seed(42)\nx = torch.rand(M, K, device='cuda')\nbound = 1/64\nw = (torch.rand(N, K, device='cuda') * 2 - 1) * bound\nbias = (torch.rand(N, device='cuda') * 2 - 1) * bound\nscale = 1.5\n\nref = (torch.nn.functional.linear(x, w, bias)) * scale\n\n# ---------------- kernel B: split x in-kernel, W splits precomputed fp16 ----------\n@triton.autotune(configs=[\n    triton.Config({'BM':128,'BN':128,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':32,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':256,'BN':128,'BK':32,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':128,'BK':32,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':256,'BN':256,'BK':32,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':256,'BN':1"]
[563.126354, "i", "28,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n], key=['M','N','K'])\n@triton.jit\ndef kB(A, Wh, Wl, Bias, C, M, N, K, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        wh = tl.load(Wh_ptr)\n        wl = tl.load(Wl_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah,"]
[563.1264, "i", " wh, acc)\n        acc = tl.dot(al, wh, acc)\n        acc = tl.dot(ah, wl, acc)\n        A_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\n    bb = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bb[None, :]) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\n# ---------------- kernel C: all splits precomputed, pure fp16 loads ----------\n@triton.autotune(configs=[\n    triton.Config({'BM':128,'BN':128,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':256,'BN':128,'BK':64,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':128,'BK':128,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':256,'BN':256,'BK':32,'GROUP_M':8}, num_stages=3, num_warps=8),\n    triton.Config({'BM':128,'BN':256,'BK':32,'GROUP_M':8}, num_stages=4, num_warps=8),\n    triton.Config({'BM':64,'BN':256,'BK':128,'GROUP_M':8}, num_stages=4, num_warps=8),\n], key=['M','N','K'])\n@triton.jit\ndef kC(Ah, Al, W"]
[563.126442, "i", "h, Wl, Bias, C, M, N, K, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    Ah_ptr = Ah + rm[:, None] * K + rk[None, :]\n    Al_ptr = Al + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rn[None, :] * K + rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        ah = tl.load(Ah_ptr); al = tl.load(Al_ptr)\n        wh = tl.load(Wh_ptr); wl = tl.load(Wl_ptr)\n        acc = tl.dot(ah, wh, acc)\n        acc = tl.dot(al, wh, acc)\n        acc = tl.dot(ah, wl, acc)\n        Ah_ptr += BK; Al_ptr += BK;"]
[563.126693, "i", " Wh_ptr += BK; Wl_ptr += BK\n    bb = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bb[None, :]) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\n\ndef run_B():\n    wh = w.half(); wl = (w - wh.float()).half()\n    out = torch.empty(M, N, device='cuda')\n    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n    def f():\n        kB[grid](x, wh, wl, bias, out, M, N, K, scale)\n        return out\n    return f\n\ndef run_C():\n    xh = x.half(); xl = (x - xh.float()).half()\n    wh = w.half(); wl = (w - wh.float()).half()\n    out = torch.empty(M, N, device='cuda')\n    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN']),)\n    def f():\n        kC[grid](xh, xl, wh, wl, bias, out, M, N, K, scale)\n        return out\n    return f\n\ndef run_C_full():\n    # includes the split pass for x in timing\n    wh = w.half(); wl = (w - wh.float()).half()\n    out = torch.empty(M, N, device='cuda')\n    grid = lambda meta: (triton.cdiv(M, meta['BM']) * triton.cdiv(N, meta['BN'])"]
[563.12671, "o", "cat > /workspace/bench.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> M, N, K = 16384, 4096, 4096\r\n\u001b[?2004l\r"]
[563.126719, "i", ",)\n    def f():\n        xh = x.half(); xl = (x - xh.float()).half()\n        kC[grid](xh, xl, wh, wl, bias, out, M, N, K, scale)\n        return out\n    return f\n\ndef run_fp16():\n    xh = x.half(); wh = w.half()\n    def f():\n        return torch.mm(xh, wh.t())\n    return f\n\nfor name, mk in [('B', run_B), ('C', run_C), ('C+xsplit', run_C_full), ('fp16mm(nocheck)', run_fp16)]:\n    f = mk()\n    o = f()\n    torch.cuda.synchronize()\n    if name != 'fp16mm(nocheck)':\n        err = (o - ref).abs().max().item()\n    else:\n        err = float('nan')\n    t = triton.testing.do_bench(f, warmup=25, rep=100)\n    print(f'{name}: {t:.3f} ms  max_err={err:.3e}')\n    if name == 'B':\n        print('  best B:', kB.best_config)\n    if name == 'C':\n        print('  best C:', kC.best_config)\nEOF\n"]
