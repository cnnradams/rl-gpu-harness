[1255.284819, "o", "> "]
[1255.28483, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.28487, "o", "        o = f(); torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284905, "o", "        err = (o - ref).abs().max().item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284951, "o", "        t = triton.testing.do_bench(f, warmup=25, rep=100)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.284991, "o", "        res.append((t, (BM,BN,BK,ns,nw,gm)))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.28505, "o", "        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw} g{gm}: {t:.3f} ms err={err:.2e}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.285081, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.285141, "o", "        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw} g{gm}: FAILED {type(e).__name__}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.285154, "o", "res.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.285189, "o", "print('BEST:', res[0] if res else None)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1255.285199, "o", "EOF\r\n\u001b[?2004l\r"]
