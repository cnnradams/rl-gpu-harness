[1255.28257, "i", "cat > /workspace/bench6.py << 'EOF'\nimport torch, triton, triton.language as tl\n\nM, N, K = 16384, 4096, 4096\nscale = 1.5\nbound = 1/64\ntorch.manual_seed(123)\nw = ((torch.rand(N, K, device='cuda') * 2 - 1) * bound)\nbias = ((torch.rand(N, device='cuda') * 2 - 1) * bound)\nx = torch.rand(M, K, device='cuda')\nref = (torch.nn.functional.linear(x, w, bias)) * scale\nwh = w.half(); wl = (w - wh.float()).half()\n\n@triton.jit\ndef kB(A, Wh, Wl, Bias, C, M, N, K, scale,\n       BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_M: tl.constexpr):\n    pid = tl.program_id(0)\n    grid_m = tl.cdiv(M, BM); grid_n = tl.cdiv(N, BN)\n    width = GROUP_M * grid_n\n    group_id = pid // width\n    group_size = tl.minimum(grid_m - group_id * GROUP_M, GROUP_M)\n    pid_m = group_id * GROUP_M + (pid % group_size)\n    pid_n = (pid % width) // group_size\n    rm = pid_m * BM + tl.arange(0, BM)\n    rn = pid_n * BN + tl.arange(0, BN)\n    rk = tl.arange(0, BK)\n    A_ptr = A + rm[:, None] * K + rk[None, :]\n    Wh_ptr = Wh + rn[None, :] * K "]
[1255.282678, "i", "+ rk[:, None]\n    Wl_ptr = Wl + rn[None, :] * K + rk[:, None]\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k in range(0, K, BK):\n        a = tl.load(A_ptr)\n        wh_ = tl.load(Wh_ptr)\n        wl_ = tl.load(Wl_ptr)\n        ah = a.to(tl.float16)\n        al = (a - ah.to(tl.float32)).to(tl.float16)\n        acc = tl.dot(ah, wh_, acc)\n        acc = tl.dot(al, wh_, acc)\n        acc = tl.dot(ah, wl_, acc)\n        A_ptr += BK; Wh_ptr += BK; Wl_ptr += BK\n    bb = tl.load(Bias + rn).to(tl.float32)\n    c = (acc + bb[None, :]) * scale\n    tl.store(C + rm[:, None] * N + rn[None, :], c)\n\nout = torch.empty(M, N, device='cuda')\nres = []\nfor (BM, BN, BK, ns, nw, gm) in [\n    (256,128,64,3,8,8), (256,128,64,3,8,4), (256,128,64,3,8,16),\n    (256,128,32,3,8,8), (256,128,32,4,8,8),\n    (128,256,32,3,8,8), (128,256,32,4,8,8),\n    (256,64,64,3,8,8), (256,64,64,4,8,8),\n    (64,256,64,3,8,8), (128,128,64,3,8,8),\n    (256,128,64,2,8,8), (256,128,128,3,8,8),\n]:\n    grid = (triton.cdiv(M, BM) * triton.cdiv(N, BN),)\n    def f("]
[1255.282686, "i", "):\n        kB[grid](x, wh, wl, bias, out, M, N, K, scale, BM=BM, BN=BN, BK=BK, GROUP_M=gm, num_stages=ns, num_warps=nw)\n        return out\n    try:\n        o = f(); torch.cuda.synchronize()\n        err = (o - ref).abs().max().item()\n        t = triton.testing.do_bench(f, warmup=25, rep=100)\n        res.append((t, (BM,BN,BK,ns,nw,gm)))\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw} g{gm}: {t:.3f} ms err={err:.2e}')\n    except Exception as e:\n        print(f'BM{BM} BN{BN} BK{BK} s{ns} w{nw} g{gm}: FAILED {type(e).__name__}')\nres.sort()\nprint('BEST:', res[0] if res else None)\nEOF\ngpu push sb-EcFwpRfsMncuRRV6OJvZKW /workspace/bench6.py /workspace/bench6.py && gpu exec sb-EcFwpRfsMncuRRV6OJvZKW -- bash -c 'python3 /workspace/bench6.py 2>&1 | tail -20'\n"]
