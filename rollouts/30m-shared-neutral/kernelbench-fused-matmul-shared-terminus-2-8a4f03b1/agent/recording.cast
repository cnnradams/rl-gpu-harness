[1255.284708, "o", "> "]
[1255.284794, "o", "        kB[grid](x, wh, wl, bias, out, M, N, K, scale, BM=BM, BN=BN, BK=BK, GROUP_M=gm, num_stages=ns, num_warps=nw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
