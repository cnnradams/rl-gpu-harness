[587.384087, "o", "B: 2.884 ms  max_err=4.888e-05\r\n  best B: BM: 256, BN: 128, BK: 64, GROUP_M: 8, num_warps: 8, num_ctas: 1, num_stages: 3, maxnreg: None\r\nC: 2.712 ms  max_err=4.828e-05\r\n  best C: BM: 128, BN: 256, BK: 32, GROUP_M: 8, num_warps: 8, num_ctas: 1, num_stages: 4, maxnreg: None\r\nC+xsplit: 3.345 ms  max_err=4.828e-05\r\nfp16mm(nocheck): 0.828 ms  max_err=nan\r\n"]
