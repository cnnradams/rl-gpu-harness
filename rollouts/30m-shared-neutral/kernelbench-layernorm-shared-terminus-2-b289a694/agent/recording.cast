[1514.18647, "i", "cat > /workspace/edge.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_init_inputs\nimport importlib.util\nspec = importlib.util.spec_from_file_location('sol', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\ndev = torch.device('cuda')\ntorch.manual_seed(0)\nref = Model(*get_init_inputs()).to(dev)\nnew = sol.ModelNew(*get_init_inputs()).to(dev)\nwith torch.no_grad():\n    # normal\n    x = torch.rand(16, 64, 256, 256, device=dev)\n    o1, o2 = ref(x), new(x)\n    print('contig ok:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4))\n    # non-contiguous\n    xt = x.transpose(1, 2).transpose(1, 2)\n    o1, o2 = ref(xt), new(xt)\n    print('transposed-but-contig ok:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4))\n    xnc = torch.rand(16, 64, 256, 512, device=dev)[..., ::2]\n    o1, o2 = ref(xnc), new(xnc)\n    print('noncontig ok:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4))\n    # different batch\n    xb = torch.rand(4, 64, 256, 256,"]
[1514.186527, "i", " device=dev)\n    o1, o2 = ref(xb), new(xb)\n    print('batch4 ok:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4))\n    # state dict load\n    sd = ref.state_dict()\n    new.load_state_dict(sd)\n    new.ln.weight.data.normal_(); new.ln.bias.data.normal_()\n    ref2 = Model(*get_init_inputs()).to(dev)\n    ref2.ln.weight.data.copy_(new.ln.weight.data); ref2.ln.bias.data.copy_(new.ln.bias.data)\n    o1, o2 = ref2(x), new(x)\n    print('custom weights ok:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4), (o1-o2).abs().max().item())\nEOF\ngpu run -- python3 /workspace/edge.py\n"]
