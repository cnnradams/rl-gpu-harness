[1294.411478, "o", "\u001b[?2004h> "]
[1294.411544, "o", "    m1 = tl.load(M + r0 + 1); rstd1 = tl.load(R + r0 + 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.411569, "o", "> "]
[1294.411599, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.411622, "o", "> "]
[1294.411645, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r"]
[1294.411672, "o", "\u001b[?2004h> "]
[1294.411723, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1294.411751, "o", "\u001b[?2004h> "]
[1294.411782, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.411806, "o", "> "]
[1294.411832, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[1294.411859, "o", "\u001b[?2004h> "]
[1294.411899, "o", "        x0 = tl.load(X + r0 * N + offs)\r\n\u001b[?2004l\r"]
[1294.411921, "o", "\u001b[?2004h> "]
[1294.411966, "o", "        x1 = tl.load(X + (r0+1) * N + offs)\r\n\u001b[?2004l\r"]
[1294.411996, "o", "\u001b[?2004h> "]
[1294.412062, "o", "        tl.store(Y + r0 * N + offs, (x0 - m0) * rstd0 * ww + bb)\r\n\u001b[?2004l\r"]
[1294.412088, "o", "\u001b[?2004h> "]
[1294.412156, "o", "        tl.store(Y + (r0+1) * N + offs, (x1 - m1) * rstd1 * ww + bb)\r\n\u001b[?2004l\r"]
[1294.412182, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.412205, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1294.412228, "o", "\u001b[?2004h> "]
[1294.412314, "o", "def apply_cs(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.412342, "o", "> "]
[1294.412364, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.412411, "o", "    blk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1294.412438, "o", "\u001b[?2004h> "]
[1294.412465, "o", "    mean = tl.load(M + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.41251, "o", "    rstd = tl.load(R + row)\r\n\u001b[?2004l\r"]
[1294.412537, "o", "\u001b[?2004h> "]
[1294.412568, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.412591, "o", "> "]
[1294.412619, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.412689, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[1294.412716, "o", "\u001b[?2004h> "]
[1294.412779, "o", "        xx = tl.load(X + row * N + offs, cache_modifier='.cg')\r\n\u001b[?2004l\r"]
[1294.412802, "o", "\u001b[?2004h> "]
[1294.412855, "o", "        ww = tl.load(W + offs, cache_modifier='.cg')\r\n\u001b[?2004l\r"]
[1294.412882, "o", "\u001b[?2004h> "]
[1294.412939, "o", "        bb = tl.load(B + offs, cache_modifier='.cg')\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.412962, "o", "> "]
[1294.413049, "o", "        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb, cache_modifier='.cs')\r\n\u001b[?2004l\r"]
[1294.41308, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.413113, "o", "gb = 544e6/1e9\r\n\u001b[?2004l\r"]
[1294.413135, "o", "\u001b[?2004h> "]
[1294.413232, "o", "for BLOCK, IT, wp, ns in [(8192,4,4,2),(8192,4,4,3),(8192,2,4,2),(4096,4,4,2),(8192,8,4,2)]:\r\n\u001b[?2004l\r"]
[1294.413258, "o", "\u001b[?2004h> "]
[1294.413288, "o", "    BPR = N // (BLOCK*IT)\r\n\u001b[?2004l\r"]
[1294.413313, "o", "\u001b[?2004h> "]
[1294.41345, "o", "    t = timeit(lambda: apply2rows[(rows//2, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.413569, "o", "    print(f'2rows B={BLOCK}x{IT} w={wp} ns={ns}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\r\n\u001b[?2004l\r"]
[1294.413597, "o", "\u001b[?2004h> "]
[1294.413649, "o", "for BLOCK, IT, wp, ns in [(8192,4,4,2),(8192,4,4,3)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.413676, "o", "> "]
[1294.413699, "o", "    BPR = N // (BLOCK*IT)\r\n\u001b[?2004l\r"]
[1294.413726, "o", "\u001b[?2004h> "]
[1294.413849, "o", "    t = timeit(lambda: apply_cs[(rows, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\r\n\u001b[?2004l\r"]
[1294.41388, "o", "\u001b[?2004h> "]
[1294.413971, "o", "    print(f'cs B={BLOCK}x{IT} w={wp} ns={ns}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\r\n\u001b[?2004l\r"]
[1294.414, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[1294.457845, "o", "\u001b[?2004hroot@modal:/# "]
