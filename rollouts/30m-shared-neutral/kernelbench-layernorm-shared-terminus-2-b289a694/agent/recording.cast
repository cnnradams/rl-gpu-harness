[538.683861, "o", "\u001b[?2004h> "]
[538.683899, "o", "        tl.store(Y + row * N + offs, xx + ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.683938, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[538.683975, "o", "\u001b[?2004h> "]
[538.684069, "o", "def norm_orig(X, W, B, Y, M, R, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.684117, "o", ">     pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.684156, "o", ">     row = pid // BLOCKS\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.684194, "o", ">     blk = pid % BLOCKS\r\n\u001b[?2004l\r"]
[538.684233, "o", "\u001b[?2004h> "]
[538.68427, "o", "    mean = tl.load(M + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684319, "o", "    rstd = tl.load(R + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684359, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684398, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.684417, "o", "> "]
[538.684468, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[538.684507, "o", "\u001b[?2004h> "]
[538.684546, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684587, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684625, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[538.684664, "o", "\u001b[?2004h> "]
[538.684714, "o", "        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r"]
[538.684754, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684792, "o", "@triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.684883, "o", "def norm_fma(X, W, B, Y, M, R, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r"]
[538.684922, "o", "\u001b[?2004h> "]
[538.684962, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.685002, "o", "    row = pid // BLOCKS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.68504, "o", "    blk = pid % BLOCKS\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.68508, "o", "    mean = tl.load(M + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.68512, "o", "    rstd = tl.load(R + row)\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.685161, "o", ">     mr = -mean * rstd\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.6852, "o", "> "]
[538.685221, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.685256, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.685301, "o", "> "]
[538.685342, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.685394, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r"]
[538.685441, "o", "\u001b[?2004h>         ww = tl.load(W + offs)\r\n\u001b[?2004l\r"]
[538.685484, "o", "\u001b[?2004h> "]
[538.685522, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.685565, "o", "        A = rstd * ww\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.685604, "o", "        D = tl.math.fma(mr, ww, bb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.685642, "o", "> "]
[538.685682, "o", "        tl.store(Y + row * N + offs, tl.math.fma(xx, A, D))\r\n\u001b[?2004l\r"]
[538.68572, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[538.68576, "o", "> "]
[538.68586, "o", "for BLOCK, IT, wp in [(4096,8,8),(8192,8,8),(8192,4,8),(4096,16,8),(8192,8,4),(8192,16,8),(16384,8,8),(8192,8,16)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.685907, "o", "    BLOCKS = N // (BLOCK*IT)\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.685946, "o", ">     grid = (rows*BLOCKS,)\r\n\u001b[?2004l\r"]
[538.685985, "o", "\u001b[?2004h> "]
[538.686085, "o", "    t0 = timeit(lambda: copy3[grid](x, w, b, y, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[538.686221, "o", "    t1 = timeit(lambda: norm_orig[grid](x, w, b, y, mean, rstd, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r"]
[538.686237, "o", "\u001b[?2004h> "]
[538.68637, "o", "    t2 = timeit(lambda: norm_fma[grid](x, w, b, y, mean, rstd, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r"]
[538.68641, "o", "\u001b[?2004h>     gb = 256e6/1e9\r\n\u001b[?2004l\r\u001b[?2004h"]
[538.68645, "o", "> "]
[538.686574, "o", "    print(f'B={BLOCK}x{IT} w={wp}: copy3 {t0[0]:.4f} ({gb/t0[0]*1e3:.0f}GB/s) orig {t1[0]:.4f} fma {t2[0]:.4f} ({gb/t2[0]*1e3:.0f}GB/s)')\r\n\u001b[?2004l\r"]
[538.686614, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[538.763584, "o", "\u001b[?2004hroot@modal:/# "]
[539.011082, "i", "gpu sync && gpu run -- python3 /workspace/sweep2.py\n"]
[539.011256, "o", "gpu sync && gpu run -- python3 /workspace/sweep2.py\r\n\u001b[?2004l\r"]
[542.377397, "o", "{\r\n  \"box\": null,\r\n  \"committed\": [\r\n    \"agent\"\r\n  ],\r\n  \"reloaded\": [\r\n    \"agent\"\r\n  ]\r\n}\r\n"]
[542.554001, "o", "request ID: 38d6657323294d8ca872907a40a2ca47\r\n"]
[549.748149, "o", "box: sb-sgBx3lwlQiJ6BRsYwIvOQb\r\ncommand: 001df06d969c4a058013d90ed61c867b\r\n"]
[559.565211, "o", "B=4096x8 w=8: copy3 0.3039 (842GB/s) orig 0.2816 fma 0.2794 (916GB/s)\r\nB=8192x8 w=8: copy3 0.2814 (910GB/s) orig 0.2393 fma 0.2604 (983GB/s)\r\nB=8192x4 w=8: copy3 0.3082 (831GB/s) orig 0.2897 fma 0.2898 (883GB/s)\r\nB=4096x16 w=8: copy3 0.2722 (940GB/s) orig 0.2591 fma 0.2579 (993GB/s)\r\nB=8192x8 w=4: copy3 0.2320 (1103GB/s) orig 0.2230 fma 0.2264 (1131GB/s)\r\nB=8192x16 w=8: copy3 0.2527 (1013GB/s) orig 0.2366 fma 0.2290 (1118GB/s)\r\nB=16384x8 w=8: copy3 0.2354 (1088GB/s) orig 0.2247 fma 0.2465 (1038GB/s)\r\nB=8192x8 w=16: copy3 0.2935 (872GB/s) orig 0.2871 fma 0.2887 (887GB/s)\r\n"]
[567.442502, "o", "\u001b[?2004hroot@modal:/# "]
[644.412403, "i", "cat > /workspace/sweep3.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\nmean = torch.rand(rows, device=dev)\nrstd = torch.rand(rows, device=dev)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\n@triton.jit\ndef apply_1d(X, W, B, Y, M, R, N, ROWM: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    # ROWM = blocks per row; pid = row*ROWM + blk  (row-major) or use col-major via swap\n  "]
[644.412446, "i", "  pid = tl.program_id(0)\n    row = pid // ROWM\n    blk = pid % ROWM\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n@triton.jit\ndef apply_2d(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)  # fastest varying\n    blk = tl.program_id(1)\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n@triton.jit\ndef apply_2d_swz(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr, G: tl.constexpr):\n  "]
[644.412453, "i", "  # group rows in supergroups to mix\n    pid = tl.program_id(0)\n    numblk = tl.num_programs(1)\n    # swizzle: process G blocks of columns at a time across all rows\n    grp = pid // G\n    rem = pid % G\n    row = rem % 16\n    blk = grp * 16 + rem // 16  # not exact; simplified below\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\nfor BLOCK, IT, wp in [(8192,8,4),(8192,8,8),(8192,16,8),(16384,8,8),(4096,16,4)]:\n    BPR = N // (BLOCK*IT)\n    t1 = timeit(lambda: apply_1d[(rows*BPR,)](x, w, b, y, mean, rstd, N, ROWM=BPR, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    t2 = timeit(lambda: apply_2d[(rows, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    gb = 544e6/1e9\n    print(f'B={BLOCK}x{IT} w={wp}: 1d {t1"]
[644.412461, "i", "[0]:.4f} ({gb/t1[0]*1e3:.0f}GB/s)  2d-rowfast {t2[0]:.4f} ({gb/t2[0]*1e3:.0f}GB/s)')\nEOF\n"]
