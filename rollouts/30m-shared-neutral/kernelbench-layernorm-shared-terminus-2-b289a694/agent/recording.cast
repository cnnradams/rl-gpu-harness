[889.406799, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406857, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.406899, "o", "> "]
[889.406972, "o", "        if (not _HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.407016, "o", "> "]
[889.407057, "o", "                or not x.is_contiguous() \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.40714, "o", "                or tuple(x.shape[-self._nd:]) != self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.407182, "o", ">             return self.ln(x)\r\n\u001b[?2004l\r"]
[889.407223, "o", "\u001b[?2004h>         N = self._n\r\n\u001b[?2004l\r"]
[889.407264, "o", "\u001b[?2004h>         BLOCK = 8192\r\n\u001b[?2004l\r"]
[889.407307, "o", "\u001b[?2004h>         ITERS = 4\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.407349, "o", "> "]
[889.407399, "o", "        if N % (BLOCK * ITERS) != 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.407442, "o", "            return self.ln(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.407484, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.407522, "o", "        BPR = N // (BLOCK * ITERS)\r\n\u001b[?2004l\r"]
[889.407564, "o", "\u001b[?2004h> "]
[889.407604, "o", "        key = (rows, x.device.index)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.407645, "o", "        buf = self._bufs.get(key)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.407686, "o", ">         if buf is None:\r\n\u001b[?2004l\r"]
[889.407727, "o", "\u001b[?2004h> "]
[889.407789, "o", "            ps = torch.empty(rows * BPR, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[889.407831, "o", "\u001b[?2004h> "]
[889.4079, "o", "            pss = torch.empty(rows * BPR, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r"]
[889.407942, "o", "\u001b[?2004h>             buf = (ps, pss)\r\n\u001b[?2004l\r"]
[889.407982, "o", "\u001b[?2004h> "]
[889.408023, "o", "            self._bufs[key] = buf\r\n\u001b[?2004l\r\u001b[?2004h> "]
