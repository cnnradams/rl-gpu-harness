[1098.473495, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.473536, "o", "> "]
[1098.473579, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.47362, "o", "        s += xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.47366, "o", "        ss += xx * xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.473702, "o", "    tl.store(PS + row * BPR + blk, tl.sum(s))\r\n\u001b[?2004l\r"]
[1098.473742, "o", "\u001b[?2004h> "]
[1098.473789, "o", "    tl.store(PSS + row * BPR + blk, tl.sum(ss))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.473831, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> @triton.jit\r\n\u001b[?2004l\r"]
[1098.473872, "o", "\u001b[?2004h> "]
[1098.473977, "o", "def apply_k(X, W, B, Y, PS, PSS, N, eps, BPR: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474023, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474064, "o", "    blk = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.474104, "o", ">     poffs = tl.arange(0, BPR)\r\n\u001b[?2004l\r"]
[1098.474145, "o", "\u001b[?2004h> "]
[1098.474186, "o", "    s = tl.sum(tl.load(PS + row * BPR + poffs))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.474228, "o", "> "]
[1098.474269, "o", "    ss = tl.sum(tl.load(PSS + row * BPR + poffs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474309, "o", "    mean = s / N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474349, "o", "    var = ss / N - mean * mean\r\n\u001b[?2004l\r"]
[1098.47439, "o", "\u001b[?2004h> "]
[1098.474431, "o", "    rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474473, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474514, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.474556, "o", "> "]
[1098.4746, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.47465, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.474693, "o", ">         ww = tl.load(W + offs)\r\n\u001b[?2004l\r"]
[1098.474734, "o", "\u001b[?2004h> "]
[1098.474776, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474859, "o", "        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474903, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.474996, "o", "# stats tuning: it must match BPR of apply. BPR = 128 with BLOCK=8192,ITERS=4.\r\n\u001b[?2004l\r"]
[1098.475041, "o", "\u001b[?2004h> "]
[1098.475103, "o", "# We can choose different stats blocking; BPR_stats can differ from apply BPR!\r\n\u001b[?2004l\r"]
[1098.475142, "o", "\u001b[?2004h> "]
[1098.475224, "o", "# apply sums over BPR partials; any BPR works (pow2 for arange). Try BPR 32,64,128,256.\r\n\u001b[?2004l\r"]
[1098.475267, "o", "\u001b[?2004h> gb = 256e6/1e9\r\n\u001b[?2004l\r"]
[1098.47531, "o", "\u001b[?2004h> best = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.475572, "o", "for BLOCK, IT, wp, ns in [(8192,4,4,2),(8192,4,4,3),(8192,4,4,4),(8192,4,8,2),(8192,4,8,3),(16384,2,4,2),(16384,2,8,2),(4096,8,4,2),(4096,8,4,3),(4096,16,4,2),(8192,8,4,2),(8192,8,4,3),(32768,1,4,2),(16384,4,8,2),(2048,16,4,2)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.475615, "o", "    BPR = N // (BLOCK*IT)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.475658, "o", "> "]
[1098.4757, "o", "    ps = torch.empty(rows*BPR, device=dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.475744, "o", "    pss = torch.empty(rows*BPR, device=dev)\r\n\u001b[?2004l\r"]
[1098.475791, "o", "\u001b[?2004h> "]
[1098.475915, "o", "    t = timeit(lambda: stats_k[(rows, BPR)](x, ps, pss, N, BPR=BPR, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.476058, "o", "    print(f'stats B={BLOCK}x{IT} w={wp} ns={ns} BPR={BPR}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.476126, "o", "    best.append((t[0], BLOCK, IT, wp, ns, BPR))\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.476166, "o", "> best.sort()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1098.476212, "o", "print('best stats:', best[:3])\r\n\u001b[?2004l\r\u001b[?2004h"]
[1098.476254, "o", "> EOF\r\n\u001b[?2004l\r"]
[1098.63124, "o", "\u001b[?2004hroot@modal:/# "]
[1098.816557, "i", "gpu sync && gpu run -- python3 /workspace/sweep6.py\n"]
[1098.816728, "o", "gpu sync && gpu run -- python3 /workspace/sweep6.py\r\n\u001b[?2004l\r"]
