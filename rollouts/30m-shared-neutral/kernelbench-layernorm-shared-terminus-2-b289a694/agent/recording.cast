[889.403291, "i", "cat > /workspace/solution.py << 'EOF'\nimport torch\nimport torch.nn as nn\n\ntry:\n    import triton\n    import triton.language as tl\n    _HAS_TRITON = True\nexcept Exception:\n    _HAS_TRITON = False\n\n\nif _HAS_TRITON:\n    @triton.jit\n    def _ln_stats(X, PS, PSS, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n        row = tl.program_id(0)\n        blk = tl.program_id(1)\n        base = blk * (BLOCK * ITERS)\n        s = tl.zeros([BLOCK], dtype=tl.float32)\n        ss = tl.zeros([BLOCK], dtype=tl.float32)\n        for i in range(ITERS):\n            offs = base + i * BLOCK + tl.arange(0, BLOCK)\n            xx = tl.load(X + row * N + offs)\n            s += xx\n            ss += xx * xx\n        BPR = tl.num_programs(1)\n        tl.store(PS + row * BPR + blk, tl.sum(s))\n        tl.store(PSS + row * BPR + blk, tl.sum(ss))\n\n    @triton.jit\n    def _ln_apply(X, W, B, Y, PS, PSS, N, eps,\n                  BLOCK: tl.constexpr, ITERS: tl.constexpr):\n        row = tl.program_id(0)\n        blk = tl.program_id(1)\n        BPR = tl.num_"]
[889.403353, "i", "programs(1)\n        poffs = tl.arange(0, BPR)\n        s = tl.sum(tl.load(PS + row * BPR + poffs))\n        ss = tl.sum(tl.load(PSS + row * BPR + poffs))\n        mean = s / N\n        var = ss / N - mean * mean\n        rstd = 1.0 / tl.sqrt(var + eps)\n        base = blk * (BLOCK * ITERS)\n        for i in range(ITERS):\n            offs = base + i * BLOCK + tl.arange(0, BLOCK)\n            xx = tl.load(X + row * N + offs)\n            ww = tl.load(W + offs)\n            bb = tl.load(B + offs)\n            tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n\nclass ModelNew(nn.Module):\n    def __init__(self, normalized_shape: tuple):\n        super().__init__()\n        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\n        self.normalized_shape = tuple(normalized_shape)\n        n = 1\n        for d in self.normalized_shape:\n            n *= d\n        self._n = n\n        self._nd = len(self.normalized_shape)\n        self._bufs = {}\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        if (not _"]
[889.403368, "i", "HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 \\\n                or not x.is_contiguous() \\\n                or tuple(x.shape[-self._nd:]) != self.normalized_shape:\n            return self.ln(x)\n        N = self._n\n        BLOCK = 8192\n        ITERS = 4\n        if N % (BLOCK * ITERS) != 0:\n            return self.ln(x)\n        rows = x.numel() // N\n        BPR = N // (BLOCK * ITERS)\n        key = (rows, x.device.index)\n        buf = self._bufs.get(key)\n        if buf is None:\n            ps = torch.empty(rows * BPR, device=x.device, dtype=torch.float32)\n            pss = torch.empty(rows * BPR, device=x.device, dtype=torch.float32)\n            buf = (ps, pss)\n            self._bufs[key] = buf\n        ps, pss = buf\n        y = torch.empty_like(x)\n        w = self.ln.weight\n        b = self.ln.bias\n        grid = (rows, BPR)\n        _ln_stats[grid](x, ps, pss, N, BLOCK=BLOCK, ITERS=ITERS,\n                        num_warps=4, num_stages=2)\n        _ln_apply[grid](x, w, b, y, ps, pss, N, self.ln.eps,\n "]
[889.403373, "i", "                       BLOCK=BLOCK, ITERS=ITERS, num_warps=4, num_stages=2)\n        return y\nEOF\n"]
[889.403507, "o", "cat > /workspace/solution.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.403535, "o", "import torch\r\n\u001b[?2004l\r"]
[889.403554, "o", "\u001b[?2004h> "]
[889.403595, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[889.403629, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.403667, "o", "> "]
[889.403704, "o", "    import triton\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.403738, "o", "    import triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
