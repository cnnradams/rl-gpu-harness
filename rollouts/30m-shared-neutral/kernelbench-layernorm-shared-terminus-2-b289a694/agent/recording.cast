[726.181576, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[726.181603, "o", "\u001b[?2004h> "]
[726.181629, "o", "def timeit(fn, trials=30):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.181673, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r"]
[726.181698, "o", "\u001b[?2004h> "]
[726.181727, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.181749, "o", "> "]
[726.181771, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.181814, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r"]
[726.181835, "o", "\u001b[?2004h> "]
[726.181867, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[726.181892, "o", "\u001b[?2004h> "]
[726.181993, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.182046, "o", "        clear_l2_cache(dev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.182099, "o", "        s.record(); fn(); e.record()\r\n\u001b[?2004l\r"]
[726.182126, "o", "\u001b[?2004h> "]
[726.182158, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[726.182178, "o", "\u001b[?2004h> "]
[726.182217, "o", "        ts.append(s.elapsed_time(e))\r\n\u001b[?2004l\r"]
[726.182238, "o", "\u001b[?2004h> "]
[726.182267, "o", "    t = torch.tensor(ts)\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.182292, "o", "> "]
[726.182336, "o", "    return t.mean().item(), t.min().item()\r\n\u001b[?2004l\r"]
[726.182358, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.18238, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[726.182405, "o", "\u001b[?2004h> "]
[726.182488, "o", "def stats2d(X, PS, PSS, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r"]
[726.182515, "o", "\u001b[?2004h> "]
[726.182541, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[726.182562, "o", "\u001b[?2004h> "]
[726.182582, "o", "    blk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[726.182612, "o", "\u001b[?2004h> "]
[726.182644, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r"]
[726.182667, "o", "\u001b[?2004h> "]
[726.182713, "o", "    s = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[726.182735, "o", "\u001b[?2004h> "]
[726.182784, "o", "    ss = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.182806, "o", "> "]
[726.18283, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r"]
[726.182856, "o", "\u001b[?2004h> "]
[726.182915, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[726.18294, "o", "\u001b[?2004h> "]
[726.183003, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.183061, "o", "        s += xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.183113, "o", "        ss += xx * xx\r\n\u001b[?2004l\r\u001b[?2004h>     BPR = tl.num_programs(1)\r\n\u001b[?2004l\r"]
[726.183138, "o", "\u001b[?2004h> "]
[726.18319, "o", "    tl.store(PS + row * BPR + blk, tl.sum(s))\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.18322, "o", "> "]
[726.183262, "o", "    tl.store(PSS + row * BPR + blk, tl.sum(ss))\r\n\u001b[?2004l\r"]
[726.183287, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.183314, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[726.183336, "o", "\u001b[?2004h> "]
[726.183426, "o", "def stats2d_v(X, PS, PSS, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.183464, "o", "    row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[726.183494, "o", "\u001b[?2004h> "]
[726.18352, "o", "    blk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[726.183544, "o", "\u001b[?2004h> "]
[726.183567, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r"]
[726.183592, "o", "\u001b[?2004h> "]
[726.183637, "o", "    s = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[726.183658, "o", "\u001b[?2004h> "]
[726.183703, "o", "    ss = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r"]
[726.183724, "o", "\u001b[?2004h> "]
[726.183749, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r"]
[726.183774, "o", "\u001b[?2004h> "]
[726.183829, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[726.183851, "o", "\u001b[?2004h> "]
[726.183891, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r"]
[726.183913, "o", "\u001b[?2004h> "]
[726.183933, "o", "        s += xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.18399, "o", "        ss = tl.math.fma(xx, xx, ss)\r\n\u001b[?2004l\r"]
[726.184012, "o", "\u001b[?2004h> "]
[726.184045, "o", "    BPR = tl.num_programs(1)\r\n\u001b[?2004l\r"]
[726.184067, "o", "\u001b[?2004h> "]
[726.184115, "o", "    tl.store(PS + row * BPR + blk, tl.sum(s))\r\n\u001b[?2004l\r"]
[726.184136, "o", "\u001b[?2004h> "]
[726.184187, "o", "    tl.store(PSS + row * BPR + blk, tl.sum(ss))\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.184213, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.184393, "o", "for BLOCK, IT, wp in [(4096,2,16),(4096,4,8),(8192,2,4),(8192,4,4),(8192,4,8),(8192,8,4),(8192,8,8),(16384,4,8),(4096,8,4),(2048,8,4),(4096,16,4)]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.184446, "o", "    BPR = N // (BLOCK*IT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.184507, "o", "    ps = torch.empty(rows*BPR, device=dev)\r\n\u001b[?2004l\r"]
[726.184534, "o", "\u001b[?2004h> "]
[726.184575, "o", "    pss = torch.empty(rows*BPR, device=dev)\r\n\u001b[?2004l\r"]
[726.1846, "o", "\u001b[?2004h> "]
[726.184698, "o", "    t1 = timeit(lambda: stats2d[(rows, BPR)](x, ps, pss, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r"]
[726.184722, "o", "\u001b[?2004h> "]
[726.184823, "o", "    t2 = timeit(lambda: stats2d_v[(rows, BPR)](x, ps, pss, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r"]
[726.18485, "o", "\u001b[?2004h> "]
[726.184871, "o", "    gb = 256e6/1e9\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.185033, "o", "    print(f'B={BLOCK}x{IT} w={wp}: stats {t1[0]:.4f} ({gb/t1[0]*1e3:.0f}GB/s)  fma {t2[0]:.4f} ({gb/t2[0]*1e3:.0f}GB/s)')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
