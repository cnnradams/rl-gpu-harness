[466.974366, "i", "cat > /workspace/bwtest.py << 'EOF'\nimport torch, time\ndev = torch.device('cuda')\nx = torch.rand(256*1024*1024, device=dev)  # 1GB\ny = torch.empty_like(x)\n# sustained copy\nfor _ in range(3): y.copy_(x)\ntorch.cuda.synchronize()\nt0 = time.perf_counter()\nfor _ in range(50): y.copy_(x)\ntorch.cuda.synchronize()\ndt = (time.perf_counter()-t0)/50\nprint(f'1GB copy: {dt*1e3:.3f} ms -> {2*x.numel()*4/dt/1e9:.0f} GB/s')\nt0 = time.perf_counter()\nfor _ in range(50): s = torch.sum(x)\ntorch.cuda.synchronize()\ndt = (time.perf_counter()-t0)/50\nprint(f'1GB sum: {dt*1e3:.3f} ms -> {x.numel()*4/dt/1e9:.0f} GB/s')\n# small copy like eval conditions (cold L2 not needed here, just back-to-back)\nxx = torch.rand(16, 64, 256, 256, device=dev)\nyy = torch.empty_like(xx)\nt0 = time.perf_counter()\nfor _ in range(200): yy.copy_(xx)\ntorch.cuda.synchronize()\ndt = (time.perf_counter()-t0)/200\nprint(f'64MB copy back-to-back: {dt*1e3:.4f} ms -> {2*xx.numel()*4/dt/1e9:.0f} GB/s')\nEOF\n"]
