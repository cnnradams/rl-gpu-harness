[375.531843, "i", "cat > /workspace/sweep.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\nprint('copy y=x:', timeit(lambda: y.copy_(x)))\n\n@triton.jit\ndef stats1(X, PS, PSS, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    offs = blk * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + row"]
[375.531887, "i", " * N + offs)\n    tl.store(PS + row * BLOCKS + blk, tl.sum(xx))\n    tl.store(PSS + row * BLOCKS + blk, tl.sum(xx * xx))\n\n@triton.jit\ndef stats2(X, PS, PSS, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    base = blk * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        s += xx\n        ss += xx * xx\n    tl.store(PS + row * BLOCKS + blk, tl.sum(s))\n    tl.store(PSS + row * BLOCKS + blk, tl.sum(ss))\n\n@triton.jit\ndef apply1(X, W, B, Y, PS, PSS, N, eps, BLOCKS: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    poffs = tl.arange(0, BLOCKS)\n    s = tl.sum(tl.load(PS + row * BLOCKS + poffs))\n    ss = tl.sum(tl.load(PSS + row * BLOCKS + poffs))\n    mean = s / N\n    var = ss / N - m"]
[375.531912, "i", "ean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    offs = blk * BLOCK + tl.arange(0, BLOCK)\n    xx = tl.load(X + row * N + offs)\n    ww = tl.load(W + offs)\n    bb = tl.load(B + offs)\n    tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n@triton.jit\ndef apply2(X, W, B, Y, PS, PSS, N, eps, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    poffs = tl.arange(0, BLOCKS)\n    s = tl.sum(tl.load(PS + row * BLOCKS + poffs))\n    ss = tl.sum(tl.load(PSS + row * BLOCKS + poffs))\n    mean = s / N\n    var = ss / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\nfor BLOCK in [2048, 4096, 8192, 16384]:\n    for wp in [4, 8, 16]:\n        if BLO"]
[375.531949, "i", "CK // 32 < wp * 32: continue\n        BLOCKS = N // BLOCK\n        ps = torch.empty(rows * BLOCKS, device=dev)\n        pss = torch.empty(rows * BLOCKS, device=dev)\n        grid = (rows * BLOCKS,)\n        t1 = timeit(lambda: stats1[grid](x, ps, pss, N, BLOCKS=BLOCKS, BLOCK=BLOCK, num_warps=wp))\n        t2 = timeit(lambda: apply1[grid](x, w, b, y, ps, pss, N, 1e-5, BLOCKS=BLOCKS, BLOCK=BLOCK, num_warps=wp))\n        print(f'v1 BLOCK={BLOCK} w={wp}: stats {t1[0]:.4f}/{t1[1]:.4f} apply {t2[0]:.4f}/{t2[1]:.4f} total {t1[0]+t2[0]:.4f}')\n\nfor BLOCK in [4096, 8192]:\n    for IT in [2, 4, 8]:\n        for wp in [8, 16]:\n            BLOCKS = N // (BLOCK * IT)\n            ps = torch.empty(rows * BLOCKS, device=dev)\n            pss = torch.empty(rows * BLOCKS, device=dev)\n            grid = (rows * BLOCKS,)\n            t1 = timeit(lambda: stats2[grid](x, ps, pss, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n            t2 = timeit(lambda: apply2[grid](x, w, b, y, ps, pss, N, 1e-5, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS="]
[375.53212, "i", "IT, num_warps=wp))\n            print(f'v2 BLOCK={BLOCK}x{IT} w={wp}: stats {t1[0]:.4f}/{t1[1]:.4f} apply {t2[0]:.4f}/{t2[1]:.4f} total {t1[0]+t2[0]:.4f}')\nEOF\n"]
