[957.876507, "o", "\u001b[?2004h> "]
[957.876554, "o", "            offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[957.876595, "o", "\u001b[?2004h> "]
[957.876629, "o", "            xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.876673, "o", ">             s += xx\r\n\u001b[?2004l\r"]
[957.876717, "o", "\u001b[?2004h>             ss += xx * xx\r\n\u001b[?2004l\r"]
[957.876758, "o", "\u001b[?2004h> "]
[957.876801, "o", "        tl.store(PS + row * BPR + blk, tl.sum(s))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.876868, "o", "        tl.store(PSS + row * BPR + blk, tl.sum(ss))\r\n\u001b[?2004l\r"]
[957.876904, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.876939, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.877019, "o", "    def _ln_apply(X, W, B, Y, PS, PSS, N, eps, BPR: tl.constexpr,\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.877037, "o", "> "]
[957.877099, "o", "                  BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r"]
[957.877143, "o", "\u001b[?2004h>         row = tl.program_id(0)\r\n\u001b[?2004l\r"]
[957.877195, "o", "\u001b[?2004h> "]
[957.877237, "o", "        blk = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.87728, "o", "        poffs = tl.arange(0, BPR)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.877341, "o", "        s = tl.sum(tl.load(PS + row * BPR + poffs))\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.877381, "o", "> "]
[957.877416, "o", "        ss = tl.sum(tl.load(PSS + row * BPR + poffs))\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.87745, "o", ">         mean = s / N\r\n\u001b[?2004l\r"]
[957.877486, "o", "\u001b[?2004h> "]
[957.877522, "o", "        var = ss / N - mean * mean\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.877574, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.877615, "o", "> "]
[957.87764, "o", "        base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.877687, "o", "        for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.877728, "o", "> "]
[957.877773, "o", "            offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.877835, "o", "            xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.877859, "o", "> "]
[957.877897, "o", "            ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.877938, "o", "            bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[957.87798, "o", "\u001b[?2004h> "]
[957.878047, "o", "            tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878088, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878136, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r"]
[957.878179, "o", "\u001b[?2004h> "]
[957.878219, "o", "    def __init__(self, normalized_shape: tuple):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878261, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878341, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.878382, "o", "> "]
[957.878424, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878465, "o", "        n = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878507, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r"]
[957.878548, "o", "\u001b[?2004h>             n *= d\r\n\u001b[?2004l\r"]
[957.878589, "o", "\u001b[?2004h>         self._n = n\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.878632, "o", "> "]
[957.878652, "o", "        self._nd = len(self.normalized_shape)\r\n\u001b[?2004l\r"]
[957.878694, "o", "\u001b[?2004h>         self._bufs = {}\r\n\u001b[?2004l\r"]
[957.878734, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.878796, "o", "    def forward(self, x: torch.Tensor) -> torch.Tensor:\r\n\u001b[?2004l\r"]
[957.878841, "o", "\u001b[?2004h> "]
[957.878906, "o", "        if (not _HAS_TRITON) or (not x.is_cuda) or x.dtype != torch.float32 \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.878946, "o", "> "]
[957.878989, "o", "                or not x.is_contiguous() \\\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879079, "o", "                or tuple(x.shape[-self._nd:]) != self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879126, "o", "            return self.ln(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879175, "o", ">         N = self._n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879213, "o", "        BLOCK = 8192\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879253, "o", ">         ITERS = 4\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879306, "o", "        if N % (BLOCK * ITERS) != 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879348, "o", ">             return self.ln(x)\r\n\u001b[?2004l\r"]
[957.879384, "o", "\u001b[?2004h> "]
[957.879426, "o", "        rows = x.numel() // N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879462, "o", "        BPR = N // (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879504, "o", "> "]
[957.879539, "o", "        key = (rows, x.device.index)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879582, "o", "        buf = self._bufs.get(key)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879623, "o", "        if buf is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879664, "o", "> "]
[957.879725, "o", "            ps = torch.empty(rows * BPR, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879768, "o", "> "]
[957.879829, "o", "            pss = torch.empty(rows * BPR, device=x.device, dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.879869, "o", ">             buf = (ps, pss)\r\n\u001b[?2004l\r"]
[957.879909, "o", "\u001b[?2004h> "]
[957.879952, "o", "            self._bufs[key] = buf\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.879987, "o", "        ps, pss = buf\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.880022, "o", "> "]
[957.880062, "o", "        y = torch.empty_like(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.880104, "o", "        w = self.ln.weight\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.880144, "o", "        b = self.ln.bias\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.880193, "o", "        grid = (rows, BPR)\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.880233, "o", "> "]
[957.880291, "o", "        _ln_stats[grid](x, ps, pss, N, BPR=BPR, BLOCK=BLOCK, ITERS=ITERS,\r\n\u001b[?2004l\r\u001b[?2004h"]
[957.880327, "o", "> "]
[957.88036, "o", "                        num_warps=4, num_stages=2)\r\n\u001b[?2004l\r"]
[957.8804, "o", "\u001b[?2004h> "]
[957.880456, "o", "        _ln_apply[grid](x, w, b, y, ps, pss, N, self.ln.eps, BPR=BPR,\r\n\u001b[?2004l\r"]
[957.880498, "o", "\u001b[?2004h> "]
[957.880566, "o", "                        BLOCK=BLOCK, ITERS=ITERS, num_warps=4, num_stages=2)\r\n\u001b[?2004l\r"]
[957.880611, "o", "\u001b[?2004h>         return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[957.880651, "o", "EOF\r\n\u001b[?2004l\r"]
