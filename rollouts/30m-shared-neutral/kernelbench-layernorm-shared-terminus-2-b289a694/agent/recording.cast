[538.68143, "i", "cat > /workspace/sweep2.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\nmean = torch.rand(rows, device=dev)\nrstd = torch.rand(rows, device=dev)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\n@triton.jit\ndef copy3(X, W, B, Y, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    base = blk * (BLOCK "]
[538.681488, "i", "* ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, xx + ww + bb)\n\n@triton.jit\ndef norm_orig(X, W, B, Y, M, R, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n@triton.jit\ndef norm_fma(X, W, B, Y, M, R, N, BLOCKS: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    pid = tl.program_id(0)\n    row = pid // BLOCKS\n    blk = pid % BLOCKS\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    mr = -m"]
[538.681627, "i", "ean * rstd\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        A = rstd * ww\n        D = tl.math.fma(mr, ww, bb)\n        tl.store(Y + row * N + offs, tl.math.fma(xx, A, D))\n\nfor BLOCK, IT, wp in [(4096,8,8),(8192,8,8),(8192,4,8),(4096,16,8),(8192,8,4),(8192,16,8),(16384,8,8),(8192,8,16)]:\n    BLOCKS = N // (BLOCK*IT)\n    grid = (rows*BLOCKS,)\n    t0 = timeit(lambda: copy3[grid](x, w, b, y, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    t1 = timeit(lambda: norm_orig[grid](x, w, b, y, mean, rstd, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    t2 = timeit(lambda: norm_fma[grid](x, w, b, y, mean, rstd, N, BLOCKS=BLOCKS, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    gb = 256e6/1e9\n    print(f'B={BLOCK}x{IT} w={wp}: copy3 {t0[0]:.4f} ({gb/t0[0]*1e3:.0f}GB/s) orig {t1[0]:.4f} fma {t2[0]:.4f} ({gb/t2[0]*1e3:.0f}GB/s)')\nEOF\n"]
