[827.36152, "o", "B=8192x8 w=4 ns=1: 0.2087 (2606GB/s) min 0.2044\r\nB=8192x8 w=4 ns=2: 0.2054 (2648GB/s) min 0.2038\r\nB=8192x8 w=4 ns=3: 0.2055 (2647GB/s) min 0.2046\r\nB=8192x8 w=4 ns=4: 0.2056 (2646GB/s) min 0.2039\r\nB=8192x8 w=8 ns=2: 0.2073 (2625GB/s) min 0.2064\r\nB=8192x8 w=8 ns=3: 0.2073 (2624GB/s) min 0.2064\r\nB=8192x4 w=4 ns=2: 0.2042 (2664GB/s) min 0.2035\r\nB=8192x4 w=4 ns=4: 0.2043 (2663GB/s) min 0.2028\r\nB=4096x8 w=4 ns=2: 0.2098 (2593GB/s) min 0.2074\r\nB=4096x8 w=4 ns=4: 0.2096 (2595GB/s) min 0.2084\r\nB=16384x4 w=4 ns=2: 0.2046 (2659GB/s) min 0.2032\r\nB=8192x16 w=4 ns=2: 0.2086 (2607GB/s) min 0.2067\r\nB=8192x16 w=4 ns=3: 0.2085 (2609GB/s) min 0.2063\r\nB=16384x8 w=4 ns=2: 0.2181 (2494GB/s) min 0.2161\r\nev B=8192x8 w=4 ns=2: 0.2104 (2586GB/s) min 0.2091\r\nev B=8192x8 w=4 ns=3: 0.2105 (2584GB/s) min 0.2094\r\nev B=8192x8 w=8 ns=3: 0.2115 (2572GB/s) min 0.2098\r\nev B=8192x16 w=4 ns=3: 0.2117 (2570GB/s) min 0.2107\r\n"]
