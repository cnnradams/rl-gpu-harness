[248.980187, "i", "cat > /workspace/bench.py << 'EOF'\nimport torch, sys\nsys.path.insert(0, '/opt/task')\nfrom reference import Model, get_inputs, get_init_inputs\nfrom kernelbench.timing import time_execution_with_cuda_event\nimport importlib.util\nspec = importlib.util.spec_from_file_location('sol', '/workspace/solution.py')\nsol = importlib.util.module_from_spec(spec); spec.loader.exec_module(sol)\n\ndev = torch.device('cuda')\ntorch.manual_seed(42)\nref = Model(*get_init_inputs()).to(dev)\nnew = sol.ModelNew(*get_init_inputs()).to(dev)\nx = get_inputs()[0].to(dev)\nwith torch.no_grad():\n    o1 = ref(x); o2 = new(x)\nprint('allclose:', torch.allclose(o1, o2, atol=1e-4, rtol=1e-4), 'maxdiff', (o1-o2).abs().max().item())\nfor name, m in [('ref', ref), ('new', new)]:\n    with torch.no_grad():\n        t = time_execution_with_cuda_event(m, [x], num_warmup=3, num_trials=50, discard_first=1, verbose=False, device=dev)\n    t = torch.tensor(t)\n    print(f'{name}: mean {t.mean():.4f} ms  min {t.min():.4f}  max {t.max():.4f}')\nEOF\n"]
