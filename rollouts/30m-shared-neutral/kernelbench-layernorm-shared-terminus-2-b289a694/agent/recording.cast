[1205.286247, "o", "gpu exec sb-9euu7SNwOJHL9f9Tf1dZA1 -- bash -c 'which nvcc; nvcc --version | tail -2; ls /usr/local/cuda/bin 2>/dev/null | head'\r\n\u001b[?2004l\r"]
[1205.430598, "o", "request ID: 905b50b7ec4c4d30bb5c750b6dea77aa\r\n"]
[1207.160976, "o", "command: edfe880d5fab44a598b13fea9773b4fd\r\n"]
[1207.454543, "o", "/usr/local/cuda/bin/nvcc\r\nCuda compilation tools, release 12.8, V12.8.93\r\nBuild cuda_12.8.r12.8/compiler.35583870_0\r\n__nvcc_device_query\r\nbin2c\r\ncompute-sanitizer\r\ncrt\r\ncu++filt\r\ncuda-gdb\r\ncuda-gdb-minimal\r\ncuda-gdb-python3.10-tui\r\ncuda-gdb-python3.11-tui\r\ncuda-gdb-python3.12-tui\r\n"]
[1207.774562, "o", "\u001b[?2004hroot@modal:/# "]
[1294.409251, "i", "cat > /workspace/sweep7.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\nmean = torch.rand(rows, device=dev)\nrstd = torch.rand(rows, device=dev)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\n@triton.jit\ndef apply2rows(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    rpair = tl.program_id(0)  # 8 pairs\n    blk = tl.program_id(1)\n    r0 = rpair * 2\n    m0 = tl.load(M + r0"]
[1294.409296, "i", "); rstd0 = tl.load(R + r0)\n    m1 = tl.load(M + r0 + 1); rstd1 = tl.load(R + r0 + 1)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        x0 = tl.load(X + r0 * N + offs)\n        x1 = tl.load(X + (r0+1) * N + offs)\n        tl.store(Y + r0 * N + offs, (x0 - m0) * rstd0 * ww + bb)\n        tl.store(Y + (r0+1) * N + offs, (x1 - m1) * rstd1 * ww + bb)\n\n@triton.jit\ndef apply_cs(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs, cache_modifier='.cg')\n        ww = tl.load(W + offs, cache_modifier='.cg')\n        bb = tl.load(B + offs, cache_modifier='.cg')\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww +"]
[1294.409304, "i", " bb, cache_modifier='.cs')\n\ngb = 544e6/1e9\nfor BLOCK, IT, wp, ns in [(8192,4,4,2),(8192,4,4,3),(8192,2,4,2),(4096,4,4,2),(8192,8,4,2)]:\n    BPR = N // (BLOCK*IT)\n    t = timeit(lambda: apply2rows[(rows//2, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\n    print(f'2rows B={BLOCK}x{IT} w={wp} ns={ns}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\nfor BLOCK, IT, wp, ns in [(8192,4,4,2),(8192,4,4,3)]:\n    BPR = N // (BLOCK*IT)\n    t = timeit(lambda: apply_cs[(rows, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\n    print(f'cs B={BLOCK}x{IT} w={wp} ns={ns}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\nEOF\n"]
[1294.409651, "o", "cat > /workspace/sweep7.py << 'EOF'\r\n\u001b[?2004l\r"]
