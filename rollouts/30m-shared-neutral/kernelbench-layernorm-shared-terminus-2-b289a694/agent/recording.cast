[744.39226, "o", "B=4096x2 w=16: stats 0.1036 (2472GB/s)  fma 0.1001 (2558GB/s)\r\nB=4096x4 w=8: stats 0.1015 (2523GB/s)  fma 0.1014 (2525GB/s)\r\nB=8192x2 w=4: stats 0.1023 (2503GB/s)  fma 0.1026 (2495GB/s)\r\nB=8192x4 w=4: stats 0.1008 (2540GB/s)  fma 0.1046 (2447GB/s)\r\nB=8192x4 w=8: stats 0.1024 (2500GB/s)  fma 0.1032 (2480GB/s)\r\nB=8192x8 w=4: stats 0.1009 (2536GB/s)  fma 0.1047 (2445GB/s)\r\nB=8192x8 w=8: stats 0.1009 (2538GB/s)  fma 0.1027 (2493GB/s)\r\nB=16384x4 w=8: stats 0.1010 (2535GB/s)  fma 0.1099 (2330GB/s)\r\nB=4096x8 w=4: stats 0.1016 (2521GB/s)  fma 0.1056 (2423GB/s)\r\nB=2048x8 w=4: stats 0.1028 (2490GB/s)  fma 0.1032 (2481GB/s)\r\nB=4096x16 w=4: stats 0.1018 (2515GB/s)  fma 0.1042 (2456GB/s)\r\n"]
