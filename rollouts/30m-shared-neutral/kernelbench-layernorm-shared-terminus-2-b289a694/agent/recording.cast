[1294.410373, "o", "> "]
[1294.410399, "o", "    for _ in range(3): fn()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.410447, "o", "    torch.cuda.synchronize()\r\n\u001b[?2004l\r"]
[1294.410474, "o", "\u001b[?2004h> "]
[1294.410497, "o", "    ts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.410539, "o", "    for _ in range(trials):\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.410567, "o", "> "]
[1294.410598, "o", "        torch.cuda.synchronize()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.410722, "o", "        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[1294.410755, "o", "> "]
