[889.404195, "o", "\u001b[?2004h> "]
[889.404236, "o", "        base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404291, "o", "        s = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.404335, "o", "> "]
[889.404383, "o", "        ss = tl.zeros([BLOCK], dtype=tl.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404425, "o", "        for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.404467, "o", "> "]
[889.404505, "o", "            offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.404545, "o", "> "]
[889.404586, "o", "            xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404633, "o", "            s += xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404673, "o", "            ss += xx * xx\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404713, "o", "        BPR = tl.num_programs(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.404755, "o", "> "]
[889.404797, "o", "        tl.store(PS + row * BPR + blk, tl.sum(s))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.40486, "o", "        tl.store(PSS + row * BPR + blk, tl.sum(ss))\r\n\u001b[?2004l\r"]
[889.404903, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404945, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404985, "o", "    def _ln_apply(X, W, B, Y, PS, PSS, N, eps,\r\n\u001b[?2004l\r"]
[889.405028, "o", "\u001b[?2004h> "]
[889.405069, "o", "                  BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r"]
[889.405112, "o", "\u001b[?2004h> "]
[889.405153, "o", "        row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405195, "o", "        blk = tl.program_id(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405236, "o", "        BPR = tl.num_programs(1)\r\n\u001b[?2004l\r"]
[889.405277, "o", "\u001b[?2004h> "]
[889.405317, "o", "        poffs = tl.arange(0, BPR)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405397, "o", "        s = tl.sum(tl.load(PS + row * BPR + poffs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405465, "o", "        ss = tl.sum(tl.load(PSS + row * BPR + poffs))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405506, "o", "        mean = s / N\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405547, "o", "        var = ss / N - mean * mean\r\n\u001b[?2004l\r"]
[889.405588, "o", "\u001b[?2004h> "]
[889.405629, "o", "        rstd = 1.0 / tl.sqrt(var + eps)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405671, "o", "        base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r"]
[889.405712, "o", "\u001b[?2004h> "]
[889.405753, "o", "        for i in range(ITERS):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405809, "o", "            offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[889.405852, "o", "\u001b[?2004h> "]
[889.405894, "o", "            xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.405934, "o", "            ww = tl.load(W + offs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.405976, "o", "> "]
[889.405998, "o", "            bb = tl.load(B + offs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406097, "o", "            tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[889.406139, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406183, "o", "class ModelNew(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
