[808.645512, "i", "cat > /workspace/sweep5.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\nmean = torch.rand(rows, device=dev)\nrstd = torch.rand(rows, device=dev)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\n@triton.jit\ndef apply_a(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n  "]
[808.645563, "i", "  base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n@triton.jit\ndef apply_ev(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    mean = tl.load(M + row)\n    rstd = tl.load(R + row)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs, eviction_policy='evict_first')\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb, eviction_policy='evict_first')\n\ngb = 544e6/1e9\nfor BLOCK, IT, wp, ns in [(8192,8,4,1),(8192,8,4,2),(8192,8,4,3),(8192,8,4,4),(8192,8,8,2),(8192,8,8,3),(8192,4,4,2),(8192,4,4,4),(4096,8,4,2),(4096,8,4,4),(16384,4,4,2),(8192,16,4"]
[808.64567, "i", ",2),(8192,16,4,3),(16384,8,4,2)]:\n    BPR = N // (BLOCK*IT)\n    t = timeit(lambda: apply_a[(rows, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\n    print(f'B={BLOCK}x{IT} w={wp} ns={ns}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\n\nfor BLOCK, IT, wp, ns in [(8192,8,4,2),(8192,8,4,3),(8192,8,8,3),(8192,16,4,3)]:\n    BPR = N // (BLOCK*IT)\n    t = timeit(lambda: apply_ev[(rows, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\n    print(f'ev B={BLOCK}x{IT} w={wp} ns={ns}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\nEOF\n"]
