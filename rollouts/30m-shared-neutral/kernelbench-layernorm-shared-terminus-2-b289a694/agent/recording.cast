[889.403849, "o", ">     _HAS_TRITON = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.403891, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.403931, "o", "if _HAS_TRITON:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.403973, "o", "    @triton.jit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404064, "o", "    def _ln_stats(X, PS, PSS, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.404113, "o", "        row = tl.program_id(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
