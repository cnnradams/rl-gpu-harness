[644.416134, "o", "        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r"]
[644.41616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[644.416188, "o", "> @triton.jit\r\n\u001b[?2004l\r"]
[644.416219, "o", "\u001b[?2004h> "]
[644.416316, "o", "def apply_2d_swz(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr, G: tl.constexpr):\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.416343, "o", "> "]
[644.416376, "o", "    # group rows in supergroups to mix\r\n\u001b[?2004l\r"]
[644.416406, "o", "\u001b[?2004h> "]
[644.416435, "o", "    pid = tl.program_id(0)\r\n\u001b[?2004l\r"]
[644.41646, "o", "\u001b[?2004h> "]
[644.416486, "o", "    numblk = tl.num_programs(1)\r\n\u001b[?2004l\r"]
[644.416513, "o", "\u001b[?2004h> "]
[644.416589, "o", "    # swizzle: process G blocks of columns at a time across all rows\r\n\u001b[?2004l\r"]
[644.416614, "o", "\u001b[?2004h> "]
[644.41664, "o", "    grp = pid // G\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.416673, "o", "    rem = pid % G\r\n\u001b[?2004l\r"]
[644.416698, "o", "\u001b[?2004h> "]
[644.416723, "o", "    row = rem % 16\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.416748, "o", "> "]
[644.416813, "o", "    blk = grp * 16 + rem // 16  # not exact; simplified below\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.416844, "o", "> "]
[644.41687, "o", "    mean = tl.load(M + row)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.416908, "o", "    rstd = tl.load(R + row)\r\n\u001b[?2004l\r"]
[644.416932, "o", "\u001b[?2004h> "]
[644.416967, "o", "    base = blk * (BLOCK * ITERS)\r\n\u001b[?2004l\r"]
[644.416993, "o", "\u001b[?2004h> "]
[644.417019, "o", "    for i in range(ITERS):\r\n\u001b[?2004l\r"]
[644.417045, "o", "\u001b[?2004h> "]
[644.417102, "o", "        offs = base + i * BLOCK + tl.arange(0, BLOCK)\r\n\u001b[?2004l\r"]
[644.417134, "o", "\u001b[?2004h> "]
[644.417167, "o", "        xx = tl.load(X + row * N + offs)\r\n\u001b[?2004l\r"]
[644.417191, "o", "\u001b[?2004h> "]
[644.417223, "o", "        ww = tl.load(W + offs)\r\n\u001b[?2004l\r"]
[644.417248, "o", "\u001b[?2004h> "]
[644.417278, "o", "        bb = tl.load(B + offs)\r\n\u001b[?2004l\r"]
[644.417303, "o", "\u001b[?2004h> "]
[644.417373, "o", "        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\r\n\u001b[?2004l\r"]
[644.417399, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[644.417425, "o", "> "]
[644.417507, "o", "for BLOCK, IT, wp in [(8192,8,4),(8192,8,8),(8192,16,8),(16384,8,8),(4096,16,4)]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.417544, "o", "> "]
[644.417569, "o", "    BPR = N // (BLOCK*IT)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.417718, "o", "    t1 = timeit(lambda: apply_1d[(rows*BPR,)](x, w, b, y, mean, rstd, N, ROWM=BPR, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r\u001b[?2004h"]
[644.417747, "o", "> "]
[644.417862, "o", "    t2 = timeit(lambda: apply_2d[(rows, BPR)](x, w, b, y, mean, rstd, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[644.417893, "o", "    gb = 544e6/1e9\r\n\u001b[?2004l\r"]
[644.417919, "o", "\u001b[?2004h> "]
[644.418057, "o", "    print(f'B={BLOCK}x{IT} w={wp}: 1d {t1[0]:.4f} ({gb/t1[0]*1e3:.0f}GB/s)  2d-rowfast {t2[0]:.4f} ({gb/t2[0]*1e3:.0f}GB/s)')\r\n\u001b[?2004l\r"]
[644.418082, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[644.459395, "o", "\u001b[?2004hroot@modal:/# "]
[644.754678, "i", "gpu sync && gpu run -- python3 /workspace/sweep3.py\n"]
[644.754878, "o", "gpu sync && gpu run -- python3 /workspace/sweep3.py\r\n\u001b[?2004l\r"]
[648.602933, "o", "{\r\n  \"box\": null,\r\n  \"committed\": [\r\n    \"agent\"\r\n  ],\r\n  \"reloaded\": [\r\n    \"agent\"\r\n  ]\r\n}\r\n"]
[648.801833, "o", "request ID: 8d35c71cf6db4a6298fc98e567cade05\r\n"]
[653.935712, "o", "box: sb-UrYSt675PaX606FcWxTZqW\r\ncommand: 6ac77954f9434fdbabead5f06a11dcac\r\n"]
[661.896861, "o", "B=8192x8 w=4: 1d 0.2261 (2406GB/s)  2d-rowfast 0.2085 (2609GB/s)\r\nB=8192x8 w=8: 1d 0.2422 (2246GB/s)  2d-rowfast 0.2107 (2582GB/s)\r\nB=8192x16 w=8: 1d 0.2363 (2302GB/s)  2d-rowfast 0.2258 (2409GB/s)\r\nB=16384x8 w=8: 1d 0.2243 (2425GB/s)  2d-rowfast 0.2096 (2596GB/s)\r\nB=4096x16 w=4: 1d 0.2330 (2334GB/s)  2d-rowfast 0.2322 (2343GB/s)\r\n"]
[667.903149, "o", "\u001b[?2004hroot@modal:/# "]
[726.181036, "i", "cat > /workspace/sweep4.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\n@triton.jit\ndef stats2d(X, PS, PSS, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    base = blk * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.l"]
[726.181074, "i", "oad(X + row * N + offs)\n        s += xx\n        ss += xx * xx\n    BPR = tl.num_programs(1)\n    tl.store(PS + row * BPR + blk, tl.sum(s))\n    tl.store(PSS + row * BPR + blk, tl.sum(ss))\n\n@triton.jit\ndef stats2d_v(X, PS, PSS, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    base = blk * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.float32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        s += xx\n        ss = tl.math.fma(xx, xx, ss)\n    BPR = tl.num_programs(1)\n    tl.store(PS + row * BPR + blk, tl.sum(s))\n    tl.store(PSS + row * BPR + blk, tl.sum(ss))\n\nfor BLOCK, IT, wp in [(4096,2,16),(4096,4,8),(8192,2,4),(8192,4,4),(8192,4,8),(8192,8,4),(8192,8,8),(16384,4,8),(4096,8,4),(2048,8,4),(4096,16,4)]:\n    BPR = N // (BLOCK*IT)\n    ps = torch.empty(rows*BPR, device=dev)\n    pss = torch.empty(rows*BPR, device=dev)\n    t1 = timeit(la"]
[726.18109, "i", "mbda: stats2d[(rows, BPR)](x, ps, pss, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    t2 = timeit(lambda: stats2d_v[(rows, BPR)](x, ps, pss, N, BLOCK=BLOCK, ITERS=IT, num_warps=wp))\n    gb = 256e6/1e9\n    print(f'B={BLOCK}x{IT} w={wp}: stats {t1[0]:.4f} ({gb/t1[0]*1e3:.0f}GB/s)  fma {t2[0]:.4f} ({gb/t2[0]*1e3:.0f}GB/s)')\nEOF\n"]
[726.181205, "o", "cat > /workspace/sweep4.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[726.181247, "o", "> "]
[726.181283, "o", "import torch, triton, triton.language as tl\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.18136, "o", "from kernelbench.timing import clear_l2_cache\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[726.18139, "o", "> "]
[726.18142, "o", "dev = torch.device('cuda')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[726.181443, "o", "N = 64*256*256\r\n\u001b[?2004l\r"]
[726.181464, "o", "\u001b[?2004h> "]
