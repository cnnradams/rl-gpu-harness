[1294.411071, "o", "    return t.mean().item(), t.min().item()\r\n\u001b[?2004l\r"]
[1294.411098, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1294.41112, "o", "@triton.jit\r\n\u001b[?2004l\r"]
[1294.411142, "o", "\u001b[?2004h> "]
[1294.411227, "o", "def apply2rows(X, W, B, Y, M, R, N, BLOCK: tl.constexpr, ITERS: tl.constexpr):\r\n\u001b[?2004l\r"]
[1294.411255, "o", "\u001b[?2004h> "]
[1294.411289, "o", "    rpair = tl.program_id(0)  # 8 pairs\r\n\u001b[?2004l\r"]
[1294.411312, "o", "\u001b[?2004h> "]
[1294.411336, "o", "    blk = tl.program_id(1)\r\n\u001b[?2004l\r"]
[1294.411362, "o", "\u001b[?2004h> "]
[1294.411389, "o", "    r0 = rpair * 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
