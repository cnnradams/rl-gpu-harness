[889.408541, "o", "> "]
[889.408602, "o", "                        BLOCK=BLOCK, ITERS=ITERS, num_warps=4, num_stages=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.408644, "o", ">         return y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.408692, "o", "EOF\r\n\u001b[?2004l\r"]
