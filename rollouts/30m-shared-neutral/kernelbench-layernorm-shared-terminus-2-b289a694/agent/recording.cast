[1098.471431, "i", "cat > /workspace/sweep6.py << 'EOF'\nimport torch, triton, triton.language as tl\nfrom kernelbench.timing import clear_l2_cache\n\ndev = torch.device('cuda')\nN = 64*256*256\nrows = 16\nx = torch.rand(rows, N, device=dev)\nw = torch.rand(N, device=dev)\nb = torch.rand(N, device=dev)\ny = torch.empty_like(x)\n\ndef timeit(fn, trials=30):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    ts = []\n    for _ in range(trials):\n        torch.cuda.synchronize()\n        s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)\n        clear_l2_cache(dev)\n        s.record(); fn(); e.record()\n        torch.cuda.synchronize()\n        ts.append(s.elapsed_time(e))\n    t = torch.tensor(ts)\n    return t.mean().item(), t.min().item()\n\n@triton.jit\ndef stats_k(X, PS, PSS, N, BPR: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    base = blk * (BLOCK * ITERS)\n    s = tl.zeros([BLOCK], dtype=tl.float32)\n    ss = tl.zeros([BLOCK], dtype=tl.floa"]
[1098.471488, "i", "t32)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        s += xx\n        ss += xx * xx\n    tl.store(PS + row * BPR + blk, tl.sum(s))\n    tl.store(PSS + row * BPR + blk, tl.sum(ss))\n\n@triton.jit\ndef apply_k(X, W, B, Y, PS, PSS, N, eps, BPR: tl.constexpr, BLOCK: tl.constexpr, ITERS: tl.constexpr):\n    row = tl.program_id(0)\n    blk = tl.program_id(1)\n    poffs = tl.arange(0, BPR)\n    s = tl.sum(tl.load(PS + row * BPR + poffs))\n    ss = tl.sum(tl.load(PSS + row * BPR + poffs))\n    mean = s / N\n    var = ss / N - mean * mean\n    rstd = 1.0 / tl.sqrt(var + eps)\n    base = blk * (BLOCK * ITERS)\n    for i in range(ITERS):\n        offs = base + i * BLOCK + tl.arange(0, BLOCK)\n        xx = tl.load(X + row * N + offs)\n        ww = tl.load(W + offs)\n        bb = tl.load(B + offs)\n        tl.store(Y + row * N + offs, (xx - mean) * rstd * ww + bb)\n\n# stats tuning: it must match BPR of apply. BPR = 128 with BLOCK=8192,ITERS=4.\n# We can choose dif"]
[1098.471618, "i", "ferent stats blocking; BPR_stats can differ from apply BPR!\n# apply sums over BPR partials; any BPR works (pow2 for arange). Try BPR 32,64,128,256.\ngb = 256e6/1e9\nbest = []\nfor BLOCK, IT, wp, ns in [(8192,4,4,2),(8192,4,4,3),(8192,4,4,4),(8192,4,8,2),(8192,4,8,3),(16384,2,4,2),(16384,2,8,2),(4096,8,4,2),(4096,8,4,3),(4096,16,4,2),(8192,8,4,2),(8192,8,4,3),(32768,1,4,2),(16384,4,8,2),(2048,16,4,2)]:\n    BPR = N // (BLOCK*IT)\n    ps = torch.empty(rows*BPR, device=dev)\n    pss = torch.empty(rows*BPR, device=dev)\n    t = timeit(lambda: stats_k[(rows, BPR)](x, ps, pss, N, BPR=BPR, BLOCK=BLOCK, ITERS=IT, num_warps=wp, num_stages=ns))\n    print(f'stats B={BLOCK}x{IT} w={wp} ns={ns} BPR={BPR}: {t[0]:.4f} ({gb/t[0]*1e3:.0f}GB/s) min {t[1]:.4f}')\n    best.append((t[0], BLOCK, IT, wp, ns, BPR))\nbest.sort()\nprint('best stats:', best[:3])\nEOF\n"]
