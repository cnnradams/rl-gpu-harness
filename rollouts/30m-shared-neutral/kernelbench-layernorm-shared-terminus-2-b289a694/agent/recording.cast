[889.406335, "o", "\u001b[?2004h> "]
[889.406394, "o", "        self.ln = nn.LayerNorm(normalized_shape=normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.406437, "o", "> "]
[889.406481, "o", "        self.normalized_shape = tuple(normalized_shape)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406525, "o", "        n = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406569, "o", "        for d in self.normalized_shape:\r\n\u001b[?2004l\r\u001b[?2004h"]
[889.406611, "o", ">             n *= d\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406653, "o", "        self._n = n\r\n\u001b[?2004l\r\u001b[?2004h> "]
[889.406713, "o", "        self._nd = len(self.normalized_shape)\r\n\u001b[?2004l\r"]
